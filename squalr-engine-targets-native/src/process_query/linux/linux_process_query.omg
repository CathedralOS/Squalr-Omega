        false -> done(linux_process_query)
    }

    state put(linux_process_query: &mut LinuxProcessQuery, byte: u8) {
        LinuxProcessQuery::path_set(linux_process_query, linux_process_query.path_len, byte);
        linux_process_query.path_len = ((linux_process_query.path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done(linux_process_query) }
    }

    state done(linux_process_query: &mut LinuxProcessQuery) {
    }
}

// Bounded accessors for the fixed tables: positions arrive as ordinary args
// (computed expressions allowed); the internal guard discharges the index
// proof, and out-of-range reads yield 0 — a byte that cannot match a live
// query. Writes out of range are dropped (unreachable by construction).
machine LinuxProcessQuery::dir_at(linux_process_query: &mut LinuxProcessQuery, position: u64) -> U8Result {
    transition position < 4096 {
        true -> hit(linux_process_query, position)
        false -> miss(linux_process_query)
    }
    state hit(linux_process_query: &mut LinuxProcessQuery, position: u64) -> U8Result { U8Result { v: linux_process_query.dir_buf[position] } }
    state miss(linux_process_query: &mut LinuxProcessQuery) -> U8Result { U8Result { v: 0 } }
}

