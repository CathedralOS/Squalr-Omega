        this.io_len = 0;
        this.io_pos = 0;
        transition { _ -> fdinfo_line(this) }
    }

    state fdinfo_line(this: &mut LinuxProcessQuery) -> BoolResult {
        let _scratch_r: U8Result = LinuxProcessQuery::stream_next(&mut this);
        this.scratch = _scratch_r.v as i32;
        transition _scratch_r.v == 0 {
            true -> fdinfo_check(this)
            false -> fd_next(this)
        }
    }

    // Parse "ino:\t<decimal>" — the socket inode the readlink target carries.
    state fdinfo_check(this: &mut LinuxProcessQuery) -> BoolResult {
        let _u51: BoolResult = LinuxProcessQuery::rec_has_prefix(&mut this, "ino:");
        transition _u51.v {
            true -> fdinfo_parse(this)
            false -> fdinfo_line(this)
        }
    }

    state fdinfo_parse(this: &mut LinuxProcessQuery) -> BoolResult {
        this.j = 4;
        this.inode = 0;
        this.found = false;
        transition { _ -> fdinfo_ws(this) }
    }

    state fdinfo_ws(this: &mut LinuxProcessQuery) -> BoolResult {
        let _u52: U8Result = LinuxProcessQuery::rec_at(&mut this, this.j);
        let _u53: U8Result = LinuxProcessQuery::rec_at(&mut this, this.j);
        transition this.j < this.rec_len && (_u52.v == 9 || _u53.v == 32) {
            true -> fdinfo_ws_step(this)
            false -> fdinfo_digits(this)
        }
    }

    state fdinfo_ws_step(this: &mut LinuxProcessQuery) -> BoolResult {
        this.j = ((this.j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> fdinfo_ws(this) }
    }

    state fdinfo_digits(this: &mut LinuxProcessQuery) -> BoolResult {
