// Element read on a caller-bounded slice param — the requires clause
// discharges the slice index; the caller proves position < s.len.
machine LinuxProcessQuery::byte_at(this: &mut LinuxProcessQuery, s: &[u8], position: u64) -> U8Result
requires
    position < s.len;
{
    s[position] as u64
}

// Element write on a caller-bounded output slice — the requires clause
// discharges the slice index.
machine LinuxProcessQuery::emit_into(this: &mut LinuxProcessQuery, out: &mut [ProcessInfo], index: u64, info: ProcessInfo)
requires
    index < out.len;
{
    out[index] = info;
}

// Boundary `i32` results (fd returns carry -1 on failure) cannot ride a
// numeric domain; the wrapper record keeps them legal as structural results.
data FdResult { v: i32 }
