// Element read on a caller-bounded slice param — the requires clause
// discharges the slice index; the caller proves position < s.len.
machine LinuxProcessQuery::byte_at(&mut self, s: &[u8], position: u64) -> u8
requires
    position < s.len;
{
    s[position]
}

// Element write on a caller-bounded output slice — the requires clause
// discharges the slice index.
machine LinuxProcessQuery::emit_into(&mut self, out: &mut [ProcessInfo], index: u64, info: ProcessInfo)
requires
    index < out.len;
{
    out[index] = info;
}
