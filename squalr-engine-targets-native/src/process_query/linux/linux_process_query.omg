    LinuxProcessQuery::path_push(linux_process_query, 101);
    LinuxProcessQuery::path_push(linux_process_query, 110);
    LinuxProcessQuery::path_push(linux_process_query, 118);
    LinuxProcessQuery::path_push(linux_process_query, 105);
    LinuxProcessQuery::path_push(linux_process_query, 114);
    LinuxProcessQuery::path_push(linux_process_query, 111);
    LinuxProcessQuery::path_push(linux_process_query, 110);
