    state fdinfo_take(this: &mut LinuxProcessQuery) -> BoolResult {
        this.inode = ((((this.inode as u64 in Wrapping) * (10 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (((this.ch as u64 in Wrapping) - (48 as u64 in Wrapping)) as u64 as u64 in Wrapping)) as u64;
        this.found = true;
        this.j = ((this.j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> fdinfo_digits(this) }
    }

    state fdinfo_done(this: &mut LinuxProcessQuery) -> BoolResult {
        transition { _ -> fdinfo_close(this) }
