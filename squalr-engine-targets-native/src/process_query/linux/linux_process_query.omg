module src::process_query::linux::linux_process_query;

use omega_language_std::filesystem_host;
use omega::language::core::service;
use squalr_engine_api::src::structures::memory::bitness::Bitness;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::processes::process_info::ProcessInfo;
use squalr_engine_targets::src::process_query::process_query_error::ProcessQueryError;
use squalr_engine_targets::src::process_query::process_query_options::ProcessNameSearch;
use squalr_engine_targets::src::process_query::process_query_options::ProcessQueryLimit;
use squalr_engine_targets::src::process_query::process_query_options::ProcessQueryOptions;
use squalr_engine_targets::src::process_query::process_query_options::RequiredProcessId;
use squalr_engine_targets::src::target_providers::OpenedProcessResult;
use squalr_engine_targets::src::target_providers::ProcessListOutcome;
use squalr_engine_targets::src::target_providers::ProcessQueryOutcome;
use src::proc_paths::ProcName;

// Port of process_query/linux/linux_process_query.rs.
//
//   open_process (handle = pid, exactly as upstream), close_process
//   (upstream's unconditional Ok), the ELF-header target-architecture read of
//   /proc/<pid>/exe with upstream's host fallback, is_process_alive as the
//   procfs existence check standing in for upstream's kill(pid, 0), and
//   start/stop_monitoring as upstream's unconditional Ok (the process
//   monitor's death-watch thread is a session-events item; the Linux impl
//   performs no work at registration).
//
//   get_processes is sysinfo's /proc sweep: sysinfo refreshes the full
//   process list once (numeric dirents under /proc, name = comm between the
//   first ' ' and the LAST ')' of /proc/<pid>/stat, entries whose stat read
//   or parse fails are absent) and upstream then filter_maps that snapshot
//   in this exact order: required_process_id -> name contains-filter (ASCII
//   case fold unless match_case) -> is_process_windowed (always computed,
//   then require_windowed drops) -> fetch_icons -> take(limit).
//   The port is two-phase for the same reason: phase 1 collects numeric
//   dirents into a bounded pid table (16384 entries; overflow sets
//   `truncated` — a bounded-table marker, like the caller's `out` capacity),
//   phase 2 materializes each pid exactly as upstream's filter_map.
//   Iteration order is readdir order; upstream's HashMap order is
//   unspecified, so no ordering guarantee is dropped. A pid that dies
//   between phases is skipped (upstream would carry it stale — the snapshot
//   delta is the recorded translation). fetch_icons is accepted but a no-op:
//   ProcessInfo drops upstream's icon field (GUI payload, unported), so the
//   desktop-entry lookup would produce nothing observable.
//
//   is_process_windowed mirrors upstream: empty inode snapshot -> false;
//   process_has_display_environment scans NUL-separated /proc/<pid>/environ
//   entries for key == "DISPLAY" or "WAYLAND_DISPLAY" with a non-empty value;
//   then every /proc/<pid>/fd entry is classified. Upstream reads each fd's
//   symlink target for the "socket:[inode]" prefix; there is no
//   readlink-style op on the raw filesystem seam, so the port uses the
//   equivalent kernel-visible discriminator: opening an fd symlink for a
//   socket fails with ENXIO (-6) for every sockfs type, while pipes, files
//   and anon_inode fds either open or fail with a different errno — and the
//   socket inode itself is read from /proc/<pid>/fdinfo/<fd> `ino:`, which
//   is the same number the readlink target carries. display_server_socket_
//   inodes -> true; process_has_display_environment && connected_stream_
//   socket_inodes -> true.
//
//   /proc/net/unix snapshot: per line split_whitespace, skip when fewer than
//   seven columns or when the Inode column (index 6, decimal) fails to parse;
//   Type (index 4) == "0001" && St (index 5) == "03" -> connected set
//   (string equality upstream — the kernel's fixed four/two-digit forms
//   parse identically, so the port parses decimal); Path (index 7, when
//   present) containing "/wayland-" or "/tmp/.X11-unix/" -> display set.
//   Both tables are bounded (256 display / 2048 connected inodes) and
//   deduplicate like upstream's HashSet — overflow is a named failure, not a
//   silent subset.
pub data LinuxProcessQuery {
    host: Service<FilesystemHost>;
    proc_fd: i32;
    exe_fd: i32;
    header: [u8; 1];
    count: i64;
    scratch: i32;
    name: ProcName;
    bitness: Bitness;

    // get_processes sweep state.
    dir_buf: [u8; 4096];
    dir_total: u64;
    dir_off: u64;
    dir_pos: i64;
    reclen: u64;
    pid_tab: [u32; 16384];
    pid_count: u64;
    pid_at: u64;
    emitted: u64;
    truncated: bool;
    limit: u64;
    require_windowed: bool;
    match_case: bool;
    req_pid: u32;
    req_pid_set: bool;
    needle: [u8; 256];
    needle_len: u64;
    have_search: bool;

    // Unix-socket inode snapshot for is_process_windowed.
    disp_inodes: [u64; 256];
    disp_count: u64;
    conn_inodes: [u64; 2048];
    conn_count: u64;
    snap_overflow: bool;

    // Per-candidate registers.
    c_pid: u32;
    c_name: [u8; 256];
    c_name_len: u64;
    c_windowed: bool;
    c_has_env: bool;
    inode: u64;
    num: u64;
    found: bool;

    // Generic record stream (environ NUL entries, fdinfo and net/unix
    // lines) sharing one rolling buffer — all uses are strictly sequential.
    io_fd: i32;
    io_delim: u8;
    io_buf: [u8; 4096];
    io_len: u64;
    io_pos: u64;
    rec: [u8; 256];
    rec_len: u64;
    rec_skip: bool;

    // "<pid>/<leaf>" names longer than ProcName's four-byte leaf cap
    // ("environ", "fdinfo/<fd>"): assembled byte-wise, opened via open_at's
    // trusted plain-name surface.
    path_buf: [u8; 64];
    path_len: u64;
    stat_buf: [u8; 2048];
    stat_len: i64;
    probe_fd: i32;
    fd_fd: i32;

    // Token/cursor registers.
    i: u64;
    j: u64;
    k: u64;
    tok_start: u64;
    tok_end: u64;
    tok_count: u64;
    col4: u64;
    col5: u64;
    col6_ok: bool;
    col7_start: u64;
    col7_end: u64;
    ch: u8;
}

pub linux_x86_64 machine LinuxProcessQuery::open_process(
    &mut self,
    process_info: &ProcessInfo
) -> OpenedProcessResult
reaches FilesystemHost
invokes FilesystemHost;
{
    // read_process_executable_bytes -> ELF EI_CLASS at offset 4 (also the
    // process-existence probe: an unreadable exe means the process is gone or
    // unreadable — upstream falls back to the host architecture either way).
    let pid: u32 = process_info.get_process_id_raw();
    self.name = ProcName::for_process(pid, 101, 120, 101, 0, 3);
    self.proc_fd = self.host.open("/proc", 65536);
    transition self.proc_fd >= 0 {
        true -> open_exe(process_info)
        false -> fallback(process_info)
    }

    state open_exe(&mut self, process_info: &ProcessInfo) -> OpenedProcessResult {
        transition self.name.len <= 48 {
            true -> open_exe_at(process_info, self.name.len)
            false -> open_exe_at(process_info, 48)
        }
    }

    state open_exe_at(&mut self, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        transition name_len <= self.name.bytes.len {
            true -> open_exe_do(process_info, name_len)
            false -> close_fallback(process_info)
        }
    }

    state open_exe_do(&mut self, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        self.exe_fd = self.host.open_at(self.proc_fd, self.name.bytes[0..name_len], 0);
        transition self.exe_fd >= 0 {
            true -> read_class(process_info)
            false -> close_fallback(process_info)
        }
    }

    state read_class(&mut self, process_info: &ProcessInfo) -> OpenedProcessResult {
        self.count = self.host.read_at(self.exe_fd, self.header[0..1], 1, 4);
        self.scratch = self.host.close(self.exe_fd);
        self.scratch = self.host.close(self.proc_fd);
        transition self.count == 1 && self.header[0] == 1 {
            true -> arch32(process_info)
            false -> arch64_or_fallback(process_info)
        }
    }

    state arch32(&mut self, process_info: &ProcessInfo) -> OpenedProcessResult {
        self.bitness = Bitness::Bit32;
        transition { _ -> opened(process_info) }
    }

    state arch64_or_fallback(&mut self, process_info: &ProcessInfo) -> OpenedProcessResult {
        transition self.count == 1 && self.header[0] == 2 {
            true -> arch64(process_info)
            false -> host_fallback(process_info)
        }
    }

    state arch64(&mut self, process_info: &ProcessInfo) -> OpenedProcessResult {
        self.bitness = Bitness::Bit64;
        transition { _ -> opened(process_info) }
    }

    // TargetArchitecture::unknown(host_pointer_width, Little): on linux_x86_64
    // the host is Bit64.
    state host_fallback(&mut self, process_info: &ProcessInfo) -> OpenedProcessResult {
        self.bitness = Bitness::Bit64;
        transition { _ -> opened(process_info) }
    }

    state close_fallback(&mut self, process_info: &ProcessInfo) -> OpenedProcessResult {
        self.scratch = self.host.close(self.proc_fd);
        transition { _ -> host_fallback(process_info) }
    }

    state fallback(&mut self, process_info: &ProcessInfo) -> OpenedProcessResult {
        transition { _ -> host_fallback(process_info) }
    }

    state opened(&mut self, process_info: &ProcessInfo) -> OpenedProcessResult {
        // Upstream: handle = process_id as u64; icon None; name from the query.
        transition process_info.name_len <= process_info.name.len {
            true -> opened_with_len(process_info, process_info.name_len)
            false -> opened_with_len(process_info, 256)
        }
    }

    state opened_with_len(&mut self, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        transition name_len <= 256 {
            true -> opened_build(process_info, name_len)
            false -> opened_build(process_info, 256)
        }
    }

    state opened_build(&mut self, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        let pid: u32 = process_info.get_process_id_raw();
        OpenedProcessResult::Opened {
            info: OpenedProcessInfo::new(
                pid,
                process_info.name[0..name_len],
                pid as u64,
                self.bitness
            )
        }
    }
}

pub linux_x86_64 machine LinuxProcessQuery::close_process(
    &mut self,
    handle: u64
) -> ProcessQueryOutcome
{
    // Upstream: `Ok(())` for any handle — there is no descriptor custody.
    ProcessQueryOutcome::Succeeded
}

pub linux_x86_64 machine LinuxProcessQuery::is_process_alive(
    &mut self,
    process_id: u32
) -> bool
reaches FilesystemHost
invokes FilesystemHost;
{
    // Upstream uses kill(pid, 0) (ESRCH => dead); procfs existence is the same
    // signal for this package's scope: /proc/<pid> present iff the pid lives.
    self.name = ProcName::for_pid(process_id);
    self.proc_fd = self.host.open("/proc", 65536);
    transition self.proc_fd >= 0 {
        true -> probe()
        false -> dead()
    }

    state probe(&mut self) -> bool {
        transition self.name.len <= 48 {
            true -> probe_at(self.name.len)
            false -> probe_at(48)
        }
    }

    state probe_at(&mut self, name_len: u64) -> bool {
        transition name_len <= self.name.bytes.len {
            true -> probe_do(name_len)
            false -> dead()
        }
    }

    state probe_do(&mut self, name_len: u64) -> bool {
        self.exe_fd = self.host.open_at(self.proc_fd, self.name.bytes[0..name_len], 65536);
        self.scratch = self.host.close(self.proc_fd);
        transition self.exe_fd >= 0 {
            true -> alive()
            false -> dead()
        }
    }

    state alive(&mut self) -> bool {
        self.scratch = self.host.close(self.exe_fd);
        transition { _ -> yes() }
    }

    state yes(&mut self) -> bool {
        true
    }

    state dead(&mut self) -> bool {
        false
    }
}

pub linux_x86_64 machine LinuxProcessQuery::start_monitoring(
    &mut self,
    process_id: u32
) -> ProcessQueryOutcome
{
    // Upstream Linux: unconditional Ok(()) — the monitor is inert on Linux
    // (Windows spins a wait thread; the trait's pid argument describes the
    // watch target and is unused here, as upstream's no-arg impl confirms).
    ProcessQueryOutcome::Succeeded
}

pub linux_x86_64 machine LinuxProcessQuery::stop_monitoring(
    &mut self
) -> ProcessQueryOutcome
{
    ProcessQueryOutcome::Succeeded
}

pub linux_x86_64 machine LinuxProcessQuery::get_processes(
    &mut self,
    options: ProcessQueryOptions,
    out: &mut [ProcessInfo]
) -> ProcessListOutcome
reaches FilesystemHost
invokes FilesystemHost;
{
    self.emitted = 0;
    self.truncated = false;
    self.pid_count = 0;
    self.pid_at = 0;
    self.dir_total = 0;
    self.dir_off = 0;
    self.dir_pos = 0;
    self.disp_count = 0;
    self.conn_count = 0;
    self.snap_overflow = false;
    self.req_pid = 0;
    self.req_pid_set = false;
    self.needle_len = 0;
    self.have_search = false;
    self.require_windowed = options.require_windowed;
    self.match_case = options.match_case;
    self.limit = 18446744073709551615;
    transition options.required_process_id {
        RequiredProcessId::Any -> opt_pid_none(options, out)
        RequiredProcessId::Required { process_id } -> opt_pid_set(options, process_id, out)
    }

    state opt_pid_none(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition { _ -> opt_pid_done(options, out) }
    }

    state opt_pid_set(&mut self, options: ProcessQueryOptions, pid: u32, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.req_pid = pid;
        self.req_pid_set = true;
        transition { _ -> opt_pid_done(options, out) }
    }

    state opt_pid_done(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition options.limit {
            ProcessQueryLimit::Unlimited -> opt_limit_done(options, out)
            ProcessQueryLimit::Limited { limit } -> opt_limit_set(options, limit, out)
        }
    }

    state opt_limit_set(&mut self, options: ProcessQueryOptions, limit: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.limit = limit;
        transition { _ -> opt_limit_done(options, out) }
    }

    state opt_limit_done(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition options.search_name {
            ProcessNameSearch::Any -> needle_done(options, out)
            ProcessNameSearch::Named { name, name_len } -> needle_copy(options, name, name_len, 0, out)
        }
    }

    // Pre-fold the search term once (upstream folds it per comparison).
    state needle_copy(&mut self, options: ProcessQueryOptions, name: [u8; 256], name_len: u64, pos: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition pos < name_len && pos < name.len {
            true -> needle_store(options, name, name_len, pos, out)
            false -> needle_finish(options, name_len, out)
        }
    }

    // Upstream folds the filter only on the case-insensitive path.
    state needle_store(&mut self, options: ProcessQueryOptions, name: [u8; 256], name_len: u64, pos: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.match_case {
            true -> needle_store_raw(options, name, name_len, pos, out)
            false -> needle_store_folded(options, name, name_len, pos, out)
        }
    }

    state needle_store_raw(&mut self, options: ProcessQueryOptions, name: [u8; 256], name_len: u64, pos: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.needle_put(pos, name[pos]);
        transition { _ -> needle_copy(options, name, name_len, ((pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, out) }
    }

    state needle_store_folded(&mut self, options: ProcessQueryOptions, name: [u8; 256], name_len: u64, pos: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.needle_put(pos, self.lowered(name[pos]));
        transition { _ -> needle_copy(options, name, name_len, ((pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, out) }
    }

    state needle_finish(&mut self, options: ProcessQueryOptions, name_len: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition name_len <= 256 {
            true -> needle_have(options, name_len, out)
            false -> needle_have(options, 256, out)
        }
    }

    state needle_have(&mut self, options: ProcessQueryOptions, name_len: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.needle_len = name_len;
        self.have_search = true;
        transition { _ -> needle_done(options, out) }
    }

    // The unix-socket snapshot is collected BEFORE the sweep, as upstream.
    state needle_done(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.collect_socket_snapshot() {
            true -> open_proc(options, out)
            false -> failed(options, out)
        }
    }

    state open_proc(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.proc_fd = self.host.open("/proc", 65536);
        transition self.proc_fd >= 0 {
            true -> dir_fill(options, out)
            false -> listed_empty(options, out)
        }
    }

    // Unreadable /proc: upstream's sysinfo refresh yields an empty map —
    // an empty list is the faithful observable result, not an error.
    state listed_empty(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        ProcessListOutcome::Listed { count: 0, truncated: false }
    }

    // Phase 1: getdents64 walk collecting numeric directory names.
    state dir_fill(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.count = self.host.read_dir(self.proc_fd, &mut self.dir_buf, 4096, &mut self.dir_pos);
        transition self.count > 0 {
            true -> dir_take(options, out)
            false -> dir_nonpositive(options, out)
        }
    }

    state dir_take(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.dir_total = self.count as u64;
        self.dir_off = 0;
        transition { _ -> dir_walk(options, out) }
    }

    // A mid-walk read error ends collection with what was seen — upstream's
    // iterator swallows per-entry errors the same way.
    state dir_nonpositive(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.count == 0 {
            true -> phase_b(options, out)
            false -> phase_b(options, out)
        }
    }

    state dir_walk(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.dir_off < self.dir_total {
            true -> dir_header(options, out)
            false -> dir_fill(options, out)
        }
    }

    state dir_header(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition ((self.dir_off as u64 in Wrapping) + (19 as u64 in Wrapping)) as u64 <= self.dir_total {
            true -> dir_reclen(options, out)
            false -> phase_b(options, out)
        }
    }

    state dir_reclen(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.reclen = ((((self.dir_at(((self.dir_off as u64 in Wrapping) + (17 as u64 in Wrapping)) as u64) as u64 in Wrapping) * (256 as u64 in Wrapping)) as u64) | (self.dir_at(((self.dir_off as u64 in Wrapping) + (16 as u64 in Wrapping)) as u64) as u64));
        transition self.reclen > 0 && ((self.dir_off as u64 in Wrapping) + (self.reclen as u64 in Wrapping)) as u64 <= self.dir_total {
            true -> dir_dtype(options, out)
            false -> phase_b(options, out)
        }
    }

    // file_type().is_dir(): DT_DIR (4) only; procfs always supplies d_type
    // (DT_UNKNOWN = 0 does not occur there), matching upstream's stat check
    // for every record that matters.
    state dir_dtype(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.dir_at(((self.dir_off as u64 in Wrapping) + (18 as u64 in Wrapping)) as u64) == 4 {
            true -> dir_pid_scan(options, out, 19)
            false -> dir_next(options, out)
        }
    }

    // Scan the NUL-terminated name: all decimal digits => a pid dirent.
    state dir_pid_scan(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo], pos: u64) -> ProcessListOutcome {
        self.j = pos;
        self.num = 0;
        self.found = true;
        transition { _ -> dir_pid_step(options, out) }
    }

    state dir_pid_step(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.i = ((self.dir_off as u64 in Wrapping) + (self.j as u64 in Wrapping)) as u64;
        transition self.j < self.reclen && self.i < self.dir_total {
            true -> dir_pid_byte(options, out)
            false -> dir_pid_done(options, out)
        }
    }

    state dir_pid_byte(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.ch = self.dir_at(self.i);
        transition self.ch == 0 {
            true -> dir_pid_done(options, out)
            false -> dir_pid_digit(options, out)
        }
    }

    state dir_pid_digit(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.ch >= 48 && self.ch <= 57 {
            true -> dir_pid_take(options, out)
            false -> dir_pid_not(options, out)
        }
    }

    state dir_pid_take(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.num = ((((self.num as u64 in Wrapping) * (10 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (((self.ch as u64 in Wrapping) - (48 as u64 in Wrapping)) as u64 as u64 in Wrapping)) as u64;
        self.j = ((self.j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> dir_pid_step(options, out) }
    }

    state dir_pid_not(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.found = false;
        transition { _ -> dir_pid_done(options, out) }
    }

    // sysinfo parses the name as usize; `as u32` keeps the same truncation.
    // A zero-length name is impossible (reclen covers the NUL at minimum) but
    // an all-empty scan is treated as non-numeric anyway.
    state dir_pid_done(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.found && self.j > 19 {
            true -> dir_pid_store(options, out)
            false -> dir_next(options, out)
        }
    }

    state dir_pid_store(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.pid_count < 16384 {
            true -> dir_pid_put(options, out)
            false -> dir_pid_overflow(options, out)
        }
    }

    state dir_pid_put(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.pid_set(self.pid_count, ((self.num as u32 in Trapping) as u32));
        self.pid_count = ((self.pid_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> dir_next(options, out) }
    }

    state dir_pid_overflow(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.truncated = true;
        transition { _ -> phase_b(options, out) }
    }

    state dir_next(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.dir_off = ((self.dir_off as u64 in Wrapping) + (self.reclen as u64 in Wrapping)) as u64;
        transition { _ -> dir_walk(options, out) }
    }

    // Phase 2: materialize each snapshot pid through upstream's filter order.
    state phase_b(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.pid_at < self.pid_count {
            true -> b_load(options, out)
            false -> sweep_done(options, out)
        }
    }

    state b_load(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.c_pid = self.pid_at(self.pid_at);
        self.pid_at = ((self.pid_at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> b_req(options, out) }
    }

    state b_req(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.req_pid_set && self.c_pid != self.req_pid {
            true -> phase_b(options, out)
            false -> b_name(options, out)
        }
    }

    state b_name(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.read_process_name() {
            true -> b_match(options, out)
            false -> phase_b(options, out)
        }
    }

    state b_match(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.name_matches() {
            true -> b_windowed(options, out)
            false -> phase_b(options, out)
        }
    }

    // is_process_windowed is computed for every surviving candidate even when
    // require_windowed is false — the field rides out on ProcessInfo either
    // way, exactly as upstream.
    state b_windowed(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.c_windowed = self.is_windowed();
        transition { _ -> b_req_windowed(options, out) }
    }

    state b_req_windowed(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.require_windowed && self.c_windowed == false {
            true -> phase_b(options, out)
            false -> b_limit(options, out)
        }
    }

    // take(limit): hitting the cap is the enumeration's normal end.
    state b_limit(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.emitted >= self.limit {
            true -> sweep_done(options, out)
            false -> b_capacity(options, out)
        }
    }

    state b_capacity(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.emitted < out.len {
            true -> b_emit_fields(options, out)
            false -> b_full(options, out)
        }
    }

    // Upstream collects into a growable Vec; a full `out` ends the sweep and
    // marks the outcome truncated — the port's bounded translation.
    state b_full(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.truncated = true;
        transition { _ -> sweep_done(options, out) }
    }

    // ProcessInfo::new_named owns the bounded name copy + name_len.
    state b_emit_fields(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition self.c_name_len <= self.c_name.len {
            true -> b_emit_write(options, out)
            false -> b_emitted(options, out)
        }
    }

    state b_emit_write(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.emit_into(out, self.emitted, ProcessInfo::new_named(self.c_pid, self.c_name[0..self.c_name_len], self.c_windowed));
        transition { _ -> b_emitted(options, out) }
    }

    state b_emitted(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.emitted = ((self.emitted as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> phase_b(options, out) }
    }

    state sweep_done(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        self.scratch = self.host.close(self.proc_fd);
        transition { _ -> listed(options, out) }
    }

    state listed(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        ProcessListOutcome::Listed { count: self.emitted, truncated: self.truncated }
    }

    state failed(&mut self, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        ProcessListOutcome::Failed { error: ProcessQueryError::internal() }
    }
}

// The per-call snapshot of /proc/net/unix inode sets. Returns false only on
// a bounded-table overflow (a named failure — the sets cannot be silently
// partial, or windowed detection would lie). An unreadable file yields the
// empty snapshot, exactly as upstream's Err -> default().
machine LinuxProcessQuery::collect_socket_snapshot(&mut self) -> bool
reaches FilesystemHost
invokes FilesystemHost;
{
    self.io_fd = self.host.open("/proc/net/unix", 0);
    transition self.io_fd >= 0 {
        true -> stream()
        false -> empty_ok()
    }

    state stream(&mut self) -> bool {
        self.io_delim = 10;
        self.io_len = 0;
        self.io_pos = 0;
        transition { _ -> next_line() }
    }

    state next_line(&mut self) -> bool {
        self.scratch = self.stream_next();
        transition self.scratch == 0 {
            true -> parse_line()
            false -> ended()
        }
    }

    state parse_line(&mut self) -> bool {
        self.scratch = self.unix_record();
        transition self.scratch == 2 {
            true -> overflow()
            false -> next_line()
        }
    }

    // A mid-stream read error mirrors upstream's fs::read_to_string Err:
    // the snapshot reverts to empty.
    state ended(&mut self) -> bool {
        self.scratch = self.host.close(self.io_fd);
        transition self.snap_overflow {
            true -> no()
            false -> yes()
        }
    }

    state overflow(&mut self) -> bool {
        self.scratch = self.host.close(self.io_fd);
        transition { _ -> no() }
    }

    state empty_ok(&mut self) -> bool {
        true
    }

    state yes(&mut self) -> bool {
        true
    }

    state no(&mut self) -> bool {
        false
    }
}

// Parse one /proc/net/unix line from `rec`: whitespace-split columns 4,5,6
// (and 7 when present) exactly as upstream's parse_proc_net_unix_socket_
// snapshot. Returns 0 handled, 1 skipped, 2 table overflow.
machine LinuxProcessQuery::unix_record(&mut self) -> i32 {
    self.tok_count = 0;
    self.i = 0;
    self.col4 = 0;
    self.col5 = 0;
    self.col6_ok = false;
    transition { _ -> skip_ws() }

    state skip_ws(&mut self) -> i32 {
        transition self.i < self.rec_len && self.rec_at(self.i) == 32 {
            true -> ws_step()
            false -> tok_begin()
        }
    }

    state ws_step(&mut self) -> i32 {
        self.i = ((self.i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> skip_ws() }
    }

    state tok_begin(&mut self) -> i32 {
        transition self.i < self.rec_len {
            true -> tok_mark()
            false -> columns_done()
        }
    }

    state tok_mark(&mut self) -> i32 {
        self.tok_start = self.i;
        transition { _ -> tok_scan() }
    }

    state tok_scan(&mut self) -> i32 {
        transition self.i < self.rec_len && self.rec_at(self.i) != 32 {
            true -> tok_step()
            false -> tok_done()
        }
    }

    state tok_step(&mut self) -> i32 {
        self.i = ((self.i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> tok_scan() }
    }

    state tok_done(&mut self) -> i32 {
        self.tok_end = self.i;
        transition self.tok_count == 4 {
            true -> take_col4()
            false -> col_dispatch()
        }
    }

    state col_dispatch(&mut self) -> i32 {
        transition self.tok_count == 5 {
            true -> take_col5()
            false -> col_next()
        }
    }

    state col_next(&mut self) -> i32 {
        transition self.tok_count == 6 {
            true -> take_col6()
            false -> col_path()
        }
    }

    state col_path(&mut self) -> i32 {
        transition self.tok_count == 7 {
            true -> take_col7()
            false -> tok_advance()
        }
    }

    state take_col4(&mut self) -> i32 {
        transition self.dec_token() {
            true -> col4_set()
            false -> tok_advance()
        }
    }

    state col4_set(&mut self) -> i32 {
        self.col4 = self.num;
        transition { _ -> tok_advance() }
    }

    state take_col5(&mut self) -> i32 {
        transition self.dec_token() {
            true -> col5_set()
            false -> tok_advance()
        }
    }

    state col5_set(&mut self) -> i32 {
        self.col5 = self.num;
        transition { _ -> tok_advance() }
    }

    state take_col6(&mut self) -> i32 {
        transition self.dec_token() {
            true -> col6_set()
            false -> bad_line()
        }
    }

    state col6_set(&mut self) -> i32 {
        self.inode = self.num;
        self.col6_ok = true;
        transition { _ -> tok_advance() }
    }

    state take_col7(&mut self) -> i32 {
        self.col7_start = self.tok_start;
        self.col7_end = self.tok_end;
        transition { _ -> tok_advance() }
    }

    state tok_advance(&mut self) -> i32 {
        self.tok_count = ((self.tok_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> skip_ws() }
    }

    state bad_line(&mut self) -> i32 {
        self.tok_count = 0;
        transition { _ -> skipped() }
    }

    state columns_done(&mut self) -> i32 {
        transition self.tok_count >= 7 && self.col6_ok {
            true -> maybe_insert()
            false -> skipped()
        }
    }

    // Upstream: type=="0001" && st=="03" -> connected set; display path ->
    // display set. Both are optional insertions off the same line.
    state maybe_insert(&mut self) -> i32 {
        transition self.col4 == 1 && self.col5 == 3 {
            true -> insert_conn()
            false -> check_path()
        }
    }

    state insert_conn(&mut self) -> i32 {
        transition self.inode_in_conn() {
            true -> check_path()
            false -> conn_push()
        }
    }

    state conn_push(&mut self) -> i32 {
        transition self.conn_count < 2048 {
            true -> conn_store()
            false -> over()
        }
    }

    state conn_store(&mut self) -> i32 {
        self.conn_set(self.conn_count, self.inode);
        self.conn_count = ((self.conn_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> check_path() }
    }

    state check_path(&mut self) -> i32 {
        transition self.tok_count >= 8 {
            true -> path_wayland()
            false -> handled()
        }
    }

    state path_wayland(&mut self) -> i32 {
        transition self.token_has("/wayland-", self.col7_start, self.col7_end) {
            true -> insert_disp()
            false -> path_x11()
        }
    }

    state path_x11(&mut self) -> i32 {
        transition self.token_has("/tmp/.X11-unix/", self.col7_start, self.col7_end) {
            true -> insert_disp()
            false -> handled()
        }
    }

    state insert_disp(&mut self) -> i32 {
        transition self.inode_in_disp() {
            true -> handled()
            false -> disp_push()
        }
    }

    state disp_push(&mut self) -> i32 {
        transition self.disp_count < 256 {
            true -> disp_store()
            false -> over()
        }
    }

    state disp_store(&mut self) -> i32 {
        self.disp_set(self.disp_count, self.inode);
        self.disp_count = ((self.disp_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> handled() }
    }

    state over(&mut self) -> i32 {
        self.snap_overflow = true;
        2
    }

    state handled(&mut self) -> i32 {
        0
    }

    state skipped(&mut self) -> i32 {
        1
    }
}

// Shared rolling-buffer record reader: returns 0 with `rec` holding one
// io_delim-terminated record, 1 at EOF, 2 on read error. Records longer than
// 255 bytes drain but truncate (rec_skip) — bounded-buffer translation.
machine LinuxProcessQuery::stream_next(&mut self) -> i32
reaches FilesystemHost
invokes FilesystemHost;
{
    self.rec_len = 0;
    self.rec_skip = false;
    transition { _ -> pump() }

    state pump(&mut self) -> i32 {
        transition self.io_pos < self.io_len {
            true -> take()
            false -> fill()
        }
    }

    state take(&mut self) -> i32 {
        self.ch = self.io_at(self.io_pos);
        self.io_pos = ((self.io_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition self.ch == self.io_delim {
            true -> have()
            false -> store()
        }
    }

    state store(&mut self) -> i32 {
        transition self.rec_len < 256 {
            true -> put()
            false -> skip_rest()
        }
    }

    state put(&mut self) -> i32 {
        self.rec_set(self.rec_len, self.ch);
        self.rec_len = ((self.rec_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> pump() }
    }

    state skip_rest(&mut self) -> i32 {
        self.rec_skip = true;
        transition { _ -> pump() }
    }

    state have(&mut self) -> i32 {
        0
    }

    state fill(&mut self) -> i32 {
        self.count = self.host.read(self.io_fd, &mut self.io_buf, 4096);
        transition self.count > 0 {
            true -> filled()
            false -> fill_done()
        }
    }

    state filled(&mut self) -> i32 {
        self.io_len = self.count as u64;
        self.io_pos = 0;
        transition { _ -> pump() }
    }

    state fill_done(&mut self) -> i32 {
        transition self.count == 0 {
            true -> eof()
            false -> err()
        }
    }

    state eof(&mut self) -> i32 {
        transition self.rec_len > 0 {
            true -> have()
            false -> at_eof()
        }
    }

    state at_eof(&mut self) -> i32 {
        1
    }

    state err(&mut self) -> i32 {
        2
    }
}

// rec[0..prefix.len] == prefix (and rec_len > prefix.len is checked by the
// caller when a non-empty value is required).
machine LinuxProcessQuery::rec_has_prefix(&mut self, prefix: &[u8]) -> bool {
    self.j = 0;
    transition { _ -> scan(prefix) }

    state scan(&mut self, prefix: &[u8]) -> bool {
        transition self.j < prefix.len && self.j < self.rec_len {
            true -> cmp(prefix)
            false -> verdict(prefix)
        }
    }

    state cmp(&mut self, prefix: &[u8]) -> bool {
        transition self.rec_at(self.j) == self.byte_at(prefix, self.j) {
            true -> step(prefix)
            false -> miss()
        }
    }

    state step(&mut self, prefix: &[u8]) -> bool {
        self.j = ((self.j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> scan(prefix) }
    }

    state verdict(&mut self, prefix: &[u8]) -> bool {
        self.j == prefix.len
    }

    state miss(&mut self) -> bool {
        false
    }
}

// rec[start..end] contains `pat` (substring scan for the display paths).
machine LinuxProcessQuery::token_has(&mut self, pat: &[u8], start: u64, end: u64) -> bool {
    transition { _ -> entry(pat, start, end) }

    // Empty pattern matches immediately (upstream contains("")).
    state entry(&mut self, pat: &[u8], start: u64, end: u64) -> bool {
        transition pat.len > 0 {
            true -> begin(pat, start, end)
            false -> hit()
        }
    }

    state begin(&mut self, pat: &[u8], start: u64, end: u64) -> bool {
        self.i = start;
        transition { _ -> window(pat, start, end) }
    }

    state window(&mut self, pat: &[u8], start: u64, end: u64) -> bool {
        self.k = 0;
        transition self.i < end {
            true -> align(pat, start, end)
            false -> miss()
        }
    }

    state align(&mut self, pat: &[u8], start: u64, end: u64) -> bool {
        transition 0 < pat.len {
            true -> align_do(pat, start, end)
            false -> miss()
        }
    }

    state align_do(&mut self, pat: &[u8], start: u64, end: u64) -> bool {
        transition self.rec_at(self.i) == self.byte_at(pat, 0) {
            true -> match_scan(pat, start, end)
            false -> advance(pat, start, end)
        }
    }

    state match_scan(&mut self, pat: &[u8], start: u64, end: u64) -> bool {
        transition self.k < pat.len && (((self.i as u64 in Wrapping) + (self.k as u64 in Wrapping)) as u64) < end {
            true -> match_cmp(pat, start, end)
            false -> match_verdict(pat)
        }
    }

    state match_cmp(&mut self, pat: &[u8], start: u64, end: u64) -> bool {
        transition self.rec_at(((self.i as u64 in Wrapping) + (self.k as u64 in Wrapping)) as u64) == self.byte_at(pat, self.k) {
            true -> match_step(pat, start, end)
            false -> advance(pat, start, end)
        }
    }

    state match_step(&mut self, pat: &[u8], start: u64, end: u64) -> bool {
        self.k = ((self.k as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> match_scan(pat, start, end) }
    }

    state match_verdict(&mut self, pat: &[u8]) -> bool {
        self.k == pat.len
    }

    state advance(&mut self, pat: &[u8], start: u64, end: u64) -> bool {
        self.i = ((self.i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> window(pat, start, end) }
    }

    state hit(&mut self) -> bool {
        true
    }

    state miss(&mut self) -> bool {
        false
    }
}

// Parse rec[tok_start..tok_end] as decimal (upstream's u64 parse).
machine LinuxProcessQuery::dec_token(&mut self) -> bool {
    self.num = 0;
    self.found = false;
    self.j = self.tok_start;
    transition { _ -> scan() }

    state scan(&mut self) -> bool {
        transition self.j < self.tok_end {
            true -> digit()
            false -> verdict()
        }
    }

    state digit(&mut self) -> bool {
        self.ch = self.rec_at(self.j);
        transition self.ch >= 48 && self.ch <= 57 {
            true -> take()
            false -> miss()
        }
    }

    state take(&mut self) -> bool {
        self.num = ((((self.num as u64 in Wrapping) * (10 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (((self.ch as u64 in Wrapping) - (48 as u64 in Wrapping)) as u64 as u64 in Wrapping)) as u64;
        self.found = true;
        self.j = ((self.j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> scan() }
    }

    state miss(&mut self) -> bool {
        false
    }

    state verdict(&mut self) -> bool {
        self.found
    }
}

machine LinuxProcessQuery::inode_in_disp(&mut self) -> bool {
    self.i = 0;
    transition { _ -> scan() }

    state scan(&mut self) -> bool {
        transition self.i < self.disp_count {
            true -> cmp()
            false -> miss()
        }
    }

    state cmp(&mut self) -> bool {
        transition self.disp_at(self.i) == self.inode {
            true -> hit()
            false -> step()
        }
    }

    state step(&mut self) -> bool {
        self.i = ((self.i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> scan() }
    }

    state hit(&mut self) -> bool {
        true
    }

    state miss(&mut self) -> bool {
        false
    }
}

machine LinuxProcessQuery::inode_in_conn(&mut self) -> bool {
    self.i = 0;
    transition { _ -> scan() }

    state scan(&mut self) -> bool {
        transition self.i < self.conn_count {
            true -> cmp()
            false -> miss()
        }
    }

    state cmp(&mut self) -> bool {
        transition self.conn_at(self.i) == self.inode {
            true -> hit()
            false -> step()
        }
    }

    state step(&mut self) -> bool {
        self.i = ((self.i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> scan() }
    }

    state hit(&mut self) -> bool {
        true
    }

    state miss(&mut self) -> bool {
        false
    }
}

// sysinfo's comm extraction: name sits between the first ' ' and the last
// ')' of /proc/<pid>/stat (leading '(' stripped). A failed open/read/parse
// drops the process, exactly as upstream.
machine LinuxProcessQuery::read_process_name(&mut self) -> bool
reaches FilesystemHost
invokes FilesystemHost;
{
    self.name = ProcName::for_process(self.c_pid, 115, 116, 97, 116, 4);
    transition self.name.len <= 48 {
        true -> open_stat(self.name.len)
        false -> open_stat(48)
    }

    state open_stat(&mut self, name_len: u64) -> bool {
        transition name_len <= self.name.bytes.len {
            true -> open_stat_do(name_len)
            false -> miss()
        }
    }

    state open_stat_do(&mut self, name_len: u64) -> bool {
        self.probe_fd = self.host.open_at(self.proc_fd, self.name.bytes[0..name_len], 0);
        transition self.probe_fd >= 0 {
            true -> fill()
            false -> miss()
        }
    }

    state fill(&mut self) -> bool {
        self.stat_len = self.host.read(self.probe_fd, &mut self.stat_buf, 2048);
        self.scratch = self.host.close(self.probe_fd);
        transition self.stat_len > 0 {
            true -> find_space()
            false -> miss()
        }
    }

    state find_space(&mut self) -> bool {
        self.i = 0;
        transition { _ -> space_scan() }
    }

    state space_scan(&mut self) -> bool {
        transition self.i < ((self.stat_len as u64 in Trapping) as u64) && self.i < 2048 {
            true -> space_cmp()
            false -> miss()
        }
    }

    state space_cmp(&mut self) -> bool {
        transition self.stat_at(self.i) == 32 {
            true -> expect_paren()
            false -> space_step()
        }
    }

    state space_step(&mut self) -> bool {
        self.i = ((self.i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> space_scan() }
    }

    state expect_paren(&mut self) -> bool {
        self.j = ((self.i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition self.j < 2048 && self.j < ((self.stat_len as u64 in Trapping) as u64) && self.stat_at(self.j) == 40 {
            true -> find_rparen()
            false -> miss()
        }
    }

    // Last ')' in the buffer — comm itself may contain ')' characters.
    state find_rparen(&mut self) -> bool {
        self.k = ((self.i as u64 in Wrapping) + (2 as u64 in Wrapping)) as u64;
        self.tok_end = 0;
        transition { _ -> rparen_scan() }
    }

    state rparen_scan(&mut self) -> bool {
        transition self.k < 2048 && self.k < ((self.stat_len as u64 in Trapping) as u64) {
            true -> rparen_cmp()
            false -> rparen_done()
        }
    }

    state rparen_cmp(&mut self) -> bool {
        transition self.stat_at(self.k) == 41 {
            true -> rparen_mark()
            false -> rparen_step()
        }
    }

    state rparen_mark(&mut self) -> bool {
        self.tok_end = self.k;
        transition { _ -> rparen_step() }
    }

    state rparen_step(&mut self) -> bool {
        self.k = ((self.k as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> rparen_scan() }
    }

    state rparen_done(&mut self) -> bool {
        transition self.tok_end > self.j && ((self.tok_end as u64 in Wrapping) - (self.j as u64 in Wrapping)) as u64 <= 256 {
            true -> copy_name()
            false -> miss()
        }
    }

    state copy_name(&mut self) -> bool {
        self.k = 0;
        transition { _ -> copy_step() }
    }

    state copy_step(&mut self) -> bool {
        transition self.k < ((self.tok_end as u64 in Wrapping) - (self.j as u64 in Wrapping)) as u64 {
            true -> copy_byte()
            false -> hit()
        }
    }

    state copy_byte(&mut self) -> bool {
        self.c_name_set(self.k, self.stat_at(((self.j as u64 in Wrapping) + (self.k as u64 in Wrapping)) as u64));
        self.k = ((self.k as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> copy_step() }
    }

    state hit(&mut self) -> bool {
        self.c_name_len = ((self.tok_end as u64 in Wrapping) - (self.j as u64 in Wrapping)) as u64;
        transition { _ -> yes() }
    }

    state yes(&mut self) -> bool {
        true
    }

    state miss(&mut self) -> bool {
        false
    }
}

// process_name_matches_filter: contains() over the ASCII-lowercased pair
// unless match_case (the needle was folded once at sweep entry; the
// candidate folds per byte here).
machine LinuxProcessQuery::name_matches(&mut self) -> bool {
    transition self.have_search {
        true -> haystack_check()
        false -> yes()
    }

    state haystack_check(&mut self) -> bool {
        transition self.needle_len <= self.c_name_len {
            true -> window(0)
            false -> no()
        }
    }

    state window(&mut self, start: u64) -> bool {
        transition ((start as u64 in Wrapping) + (self.needle_len as u64 in Wrapping)) as u64 <= self.c_name_len {
            true -> align(start)
            false -> no()
        }
    }

    state align(&mut self, start: u64) -> bool {
        self.k = 0;
        transition { _ -> cmp(start) }
    }

    state cmp(&mut self, start: u64) -> bool {
        transition self.k < self.needle_len {
            true -> byte_cmp(start)
            false -> yes()
        }
    }

    state byte_cmp(&mut self, start: u64) -> bool {
        self.ch = self.c_name_at(((start as u64 in Wrapping) + (self.k as u64 in Wrapping)) as u64);
        transition self.match_case {
            true -> exact_cmp(start)
            false -> fold_cmp(start)
        }
    }

    state exact_cmp(&mut self, start: u64) -> bool {
        transition self.ch == self.needle_at(self.k) {
            true -> step(start)
            false -> window_next(start)
        }
    }

    state fold_cmp(&mut self, start: u64) -> bool {
        transition self.lowered(self.ch) == self.needle_at(self.k) {
            true -> step(start)
            false -> window_next(start)
        }
    }

    state step(&mut self, start: u64) -> bool {
        self.k = ((self.k as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> cmp(start) }
    }

    state window_next(&mut self, start: u64) -> bool {
        transition { _ -> window(((start as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state yes(&mut self) -> bool {
        true
    }

    state no(&mut self) -> bool {
        false
    }
}

machine LinuxProcessQuery::lowered(&mut self, byte: u8) -> u8 {
    transition byte >= 65 && byte <= 90 {
        true -> fold(byte)
        false -> same(byte)
    }

    state fold(&mut self, byte: u8) -> u8 {
        ((byte as u8 in Wrapping) + (32 as u8 in Wrapping)) as u8
    }

    state same(&mut self, byte: u8) -> u8 {
        byte
    }
}

// is_process_windowed for the candidate in c_pid.
machine LinuxProcessQuery::is_windowed(&mut self) -> bool
reaches FilesystemHost
invokes FilesystemHost;
{
    transition self.disp_count == 0 && self.conn_count == 0 {
        true -> no()
        false -> env()
    }

    // process_has_display_environment runs once before the fd walk.
    state env(&mut self) -> bool {
        self.c_has_env = self.has_display_env();
        transition { _ -> open_fd_dir() }
    }

    state open_fd_dir(&mut self) -> bool {
        self.name = ProcName::for_process(self.c_pid, 102, 100, 0, 0, 2);
        transition self.name.len <= 48 {
            true -> open_fd_at(self.name.len)
            false -> open_fd_at(48)
        }
    }

    state open_fd_at(&mut self, name_len: u64) -> bool {
        transition name_len <= self.name.bytes.len {
            true -> open_fd_do(name_len)
            false -> no()
        }
    }

    state open_fd_do(&mut self, name_len: u64) -> bool {
        self.fd_fd = self.host.open_at(self.proc_fd, self.name.bytes[0..name_len], 65536);
        transition self.fd_fd >= 0 {
            true -> fd_fill()
            false -> no()
        }
    }

    state fd_fill(&mut self) -> bool {
        self.dir_pos = 0;
        self.dir_total = 0;
        self.dir_off = 0;
        transition { _ -> fd_read() }
    }

    state fd_read(&mut self) -> bool {
        self.count = self.host.read_dir(self.fd_fd, &mut self.dir_buf, 4096, &mut self.dir_pos);
        transition self.count > 0 {
            true -> fd_take()
            false -> fd_done()
        }
    }

    state fd_take(&mut self) -> bool {
        self.dir_total = self.count as u64;
        self.dir_off = 0;
        transition { _ -> fd_walk() }
    }

    state fd_done(&mut self) -> bool {
        self.scratch = self.host.close(self.fd_fd);
        transition { _ -> no() }
    }

    state fd_walk(&mut self) -> bool {
        transition self.dir_off < self.dir_total {
            true -> fd_header()
            false -> fd_read()
        }
    }

    state fd_header(&mut self) -> bool {
        transition ((self.dir_off as u64 in Wrapping) + (19 as u64 in Wrapping)) as u64 <= self.dir_total {
            true -> fd_reclen()
            false -> fd_done()
        }
    }

    state fd_reclen(&mut self) -> bool {
        self.reclen = ((((self.dir_at(((self.dir_off as u64 in Wrapping) + (17 as u64 in Wrapping)) as u64) as u64 in Wrapping) * (256 as u64 in Wrapping)) as u64) | (self.dir_at(((self.dir_off as u64 in Wrapping) + (16 as u64 in Wrapping)) as u64) as u64));
        transition self.reclen > 0 && ((self.dir_off as u64 in Wrapping) + (self.reclen as u64 in Wrapping)) as u64 <= self.dir_total {
            true -> fd_name()
            false -> fd_done()
        }
    }

    // Copy the entry name to `rec` for the probe open.
    state fd_name(&mut self) -> bool {
        self.j = 19;
        self.rec_len = 0;
        transition { _ -> fd_name_step() }
    }

    state fd_name_step(&mut self) -> bool {
        self.i = ((self.dir_off as u64 in Wrapping) + (self.j as u64 in Wrapping)) as u64;
        transition self.j < self.reclen && self.i < self.dir_total {
            true -> fd_name_byte()
            false -> fd_probe()
        }
    }

    state fd_name_byte(&mut self) -> bool {
        self.ch = self.dir_at(self.i);
        transition self.ch == 0 {
            true -> fd_probe()
            false -> fd_name_store()
        }
    }

    state fd_name_store(&mut self) -> bool {
        transition self.rec_len < 255 {
            true -> fd_name_put()
            false -> fd_next()
        }
    }

    state fd_name_put(&mut self) -> bool {
        self.rec_set(self.rec_len, self.ch);
        self.rec_len = ((self.rec_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        self.j = ((self.j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> fd_name_step() }
    }

    // Upstream: fs::read_link(entry) -> "socket:[inode]" target. The port's
    // discriminator: opening an fd symlink for a socket fails ENXIO (-6),
    // for every sockfs type; other fds open or fail differently, and any
    // error other than ENXIO skips the entry like upstream's readlink Err.
    state fd_probe(&mut self) -> bool {
        transition self.rec_len > 0 {
            true -> fd_open()
            false -> fd_next()
        }
    }

    state fd_open(&mut self) -> bool {
        transition self.rec_len <= self.rec.len {
            true -> fd_open_do()
            false -> fd_next()
        }
    }

    state fd_open_do(&mut self) -> bool {
        self.probe_fd = self.host.open_at(self.fd_fd, self.rec[0..self.rec_len], 0);
        transition self.probe_fd >= 0 {
            true -> fd_not_socket()
            false -> fd_err()
        }
    }

    state fd_not_socket(&mut self) -> bool {
        self.scratch = self.host.close(self.probe_fd);
        transition { _ -> fd_next() }
    }

    state fd_err(&mut self) -> bool {
        transition self.probe_fd == -6 {
            true -> fdinfo_path()
            false -> fd_next()
        }
    }

    // "<pid>/fdinfo/<fdname>" — the fd name is already in rec.
    state fdinfo_path(&mut self) -> bool {
        self.path_reset();
        self.path_put_pid();
        self.path_push(47);
        self.path_push(102);
        self.path_push(100);
        self.path_push(105);
        self.path_push(110);
        self.path_push(102);
        self.path_push(111);
        self.path_push(47);
        transition { _ -> fdinfo_name() }
    }

    state fdinfo_name(&mut self) -> bool {
        self.j = 0;
        transition { _ -> fdinfo_name_step() }
    }

    state fdinfo_name_step(&mut self) -> bool {
        transition self.j < self.rec_len {
            true -> fdinfo_name_byte()
            false -> fdinfo_open()
        }
    }

    state fdinfo_name_byte(&mut self) -> bool {
        self.ch = self.rec_at(self.j);
        self.path_push(self.ch);
        self.j = ((self.j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> fdinfo_name_step() }
    }

    state fdinfo_open(&mut self) -> bool {
        transition self.path_len <= self.path_buf.len {
            true -> fdinfo_open_do()
            false -> fd_next()
        }
    }

    state fdinfo_open_do(&mut self) -> bool {
        self.io_fd = self.host.open_at(self.proc_fd, self.path_buf[0..self.path_len], 0);
        transition self.io_fd >= 0 {
            true -> fdinfo_stream()
            false -> fd_next()
        }
    }

    state fdinfo_stream(&mut self) -> bool {
        self.io_delim = 10;
        self.io_len = 0;
        self.io_pos = 0;
        transition { _ -> fdinfo_line() }
    }

    state fdinfo_line(&mut self) -> bool {
        self.scratch = self.stream_next();
        transition self.scratch == 0 {
            true -> fdinfo_check()
            false -> fd_next()
        }
    }

    // Parse "ino:\t<decimal>" — the socket inode the readlink target carries.
    state fdinfo_check(&mut self) -> bool {
        transition self.rec_has_prefix("ino:") {
            true -> fdinfo_parse()
            false -> fdinfo_line()
        }
    }

    state fdinfo_parse(&mut self) -> bool {
        self.j = 4;
        self.inode = 0;
        self.found = false;
        transition { _ -> fdinfo_ws() }
    }

    state fdinfo_ws(&mut self) -> bool {
        transition self.j < self.rec_len && (self.rec_at(self.j) == 9 || self.rec_at(self.j) == 32) {
            true -> fdinfo_ws_step()
            false -> fdinfo_digits()
        }
    }

    state fdinfo_ws_step(&mut self) -> bool {
        self.j = ((self.j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> fdinfo_ws() }
    }

    state fdinfo_digits(&mut self) -> bool {
        transition self.j < self.rec_len {
            true -> fdinfo_digit()
            false -> fdinfo_done()
        }
    }

    state fdinfo_digit(&mut self) -> bool {
        self.ch = self.rec_at(self.j);
        transition self.ch >= 48 && self.ch <= 57 {
            true -> fdinfo_take()
            false -> fdinfo_done()
        }
    }

    state fdinfo_take(&mut self) -> bool {
        self.inode = ((((self.inode as u64 in Wrapping) * (10 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (((self.ch as u64 in Wrapping) - (48 as u64 in Wrapping)) as u64 as u64 in Wrapping)) as u64;
        self.found = true;
        self.j = ((self.j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> fdinfo_digits() }
    }

    state fdinfo_done(&mut self) -> bool {
        transition { _ -> fdinfo_close() }
    }

    state fdinfo_close(&mut self) -> bool {
        self.scratch = self.host.close(self.io_fd);
        transition self.found {
            true -> fd_membership()
            false -> fd_next()
        }
    }

    state fd_membership(&mut self) -> bool {
        transition self.inode_in_disp() {
            true -> fd_hit()
            false -> fd_conn()
        }
    }

    state fd_conn(&mut self) -> bool {
        transition self.c_has_env && self.inode_in_conn() {
            true -> fd_hit()
            false -> fd_next()
        }
    }

    state fd_hit(&mut self) -> bool {
        self.scratch = self.host.close(self.fd_fd);
        transition { _ -> yes() }
    }

    state fd_next(&mut self) -> bool {
        self.dir_off = ((self.dir_off as u64 in Wrapping) + (self.reclen as u64 in Wrapping)) as u64;
        transition { _ -> fd_walk() }
    }

    state yes(&mut self) -> bool {
        true
    }

    state no(&mut self) -> bool {
        false
    }
}

// process_has_display_environment: NUL-separated environ entries, matching
// key == "DISPLAY" or "WAYLAND_DISPLAY" with a non-empty value.
machine LinuxProcessQuery::has_display_env(&mut self) -> bool
reaches FilesystemHost
invokes FilesystemHost;
{
    self.path_reset();
    self.path_put_pid();
    self.path_push(47);
    self.path_push(101);
    self.path_push(110);
    self.path_push(118);
    self.path_push(105);
    self.path_push(114);
    self.path_push(111);
    self.path_push(110);
    transition { _ -> open_env() }

    state open_env(&mut self) -> bool {
        transition self.path_len <= self.path_buf.len {
            true -> open_env_do()
            false -> no()
        }
    }

    state open_env_do(&mut self) -> bool {
        self.io_fd = self.host.open_at(self.proc_fd, self.path_buf[0..self.path_len], 0);
        transition self.io_fd >= 0 {
            true -> stream()
            false -> no()
        }
    }

    state stream(&mut self) -> bool {
        self.io_delim = 0;
        self.io_len = 0;
        self.io_pos = 0;
        transition { _ -> next_entry() }
    }

    state next_entry(&mut self) -> bool {
        self.scratch = self.stream_next();
        transition self.scratch == 0 {
            true -> check_entry()
            false -> close_no()
        }
    }

    // Entry matches when key (before the first '=') is exactly DISPLAY or
    // WAYLAND_DISPLAY and a non-empty value follows it.
    state check_entry(&mut self) -> bool {
        transition self.rec_len > 8 && self.rec_has_prefix("DISPLAY=") {
            true -> close_yes()
            false -> check_wayland()
        }
    }

    state check_wayland(&mut self) -> bool {
        transition self.rec_len > 16 && self.rec_has_prefix("WAYLAND_DISPLAY=") {
            true -> close_yes()
            false -> next_entry()
        }
    }

    state close_yes(&mut self) -> bool {
        self.scratch = self.host.close(self.io_fd);
        transition { _ -> yes() }
    }

    state close_no(&mut self) -> bool {
        self.scratch = self.host.close(self.io_fd);
        transition { _ -> no() }
    }

    state yes(&mut self) -> bool {
        true
    }

    state no(&mut self) -> bool {
        false
    }
}

// "<pid>" decimal into path_buf (ProcName::for_pid's emission, without the
// four-byte leaf cap).
machine LinuxProcessQuery::path_reset(&mut self) {
    self.path_len = 0;
}

machine LinuxProcessQuery::path_put_pid(&mut self) {
    self.name = ProcName::for_pid(self.c_pid);
    self.j = 0;
    transition { _ -> copy() }

    state copy(&mut self) {
        transition self.j < self.name.len && self.j < 48 {
            true -> put()
            false -> done()
        }
    }

    state put(&mut self) {
        transition self.path_len < 64 && self.j < 48 {
            true -> byte()
            false -> done()
        }
    }

    state byte(&mut self) {
        self.path_set(self.path_len, self.name.bytes[self.j]);
        self.path_len = ((self.path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        self.j = ((self.j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> copy() }
    }

    state done(&mut self) {
    }
}

machine LinuxProcessQuery::path_push(&mut self, byte: u8) {
    transition self.path_len < 64 {
        true -> put(byte)
        false -> done()
    }

    state put(&mut self, byte: u8) {
        self.path_set(self.path_len, byte);
        self.path_len = ((self.path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done() }
    }

    state done(&mut self) {
    }
}

// Bounded accessors for the fixed tables: positions arrive as ordinary args
// (computed expressions allowed); the internal guard discharges the index
// proof, and out-of-range reads yield 0 — a byte that cannot match a live
// query. Writes out of range are dropped (unreachable by construction).
machine LinuxProcessQuery::dir_at(&mut self, position: u64) -> u8 {
    transition position < 4096 {
        true -> hit(position)
        false -> miss()
    }
    state hit(&mut self, position: u64) -> u8 { self.dir_buf[position] }
    state miss(&mut self) -> u8 { 0 }
}

machine LinuxProcessQuery::io_at(&mut self, position: u64) -> u8 {
    transition position < 4096 {
        true -> hit(position)
        false -> miss()
    }
    state hit(&mut self, position: u64) -> u8 { self.io_buf[position] }
    state miss(&mut self) -> u8 { 0 }
}

machine LinuxProcessQuery::stat_at(&mut self, position: u64) -> u8 {
    transition position < 2048 {
        true -> hit(position)
        false -> miss()
    }
    state hit(&mut self, position: u64) -> u8 { self.stat_buf[position] }
    state miss(&mut self) -> u8 { 0 }
}

machine LinuxProcessQuery::rec_at(&mut self, position: u64) -> u8 {
    transition position < 256 {
        true -> hit(position)
        false -> miss()
    }
    state hit(&mut self, position: u64) -> u8 { self.rec[position] }
    state miss(&mut self) -> u8 { 0 }
}

machine LinuxProcessQuery::rec_set(&mut self, position: u64, byte: u8) {
    transition position < 256 {
        true -> put(position, byte)
        false -> skip()
    }
    state put(&mut self, position: u64, byte: u8) { self.rec[position] = byte; }
    state skip(&mut self) {
    }
}

machine LinuxProcessQuery::c_name_at(&mut self, position: u64) -> u8 {
    transition position < 256 {
        true -> hit(position)
        false -> miss()
    }
    state hit(&mut self, position: u64) -> u8 { self.c_name[position] }
    state miss(&mut self) -> u8 { 0 }
}

machine LinuxProcessQuery::c_name_set(&mut self, position: u64, byte: u8) {
    transition position < 256 {
        true -> put(position, byte)
        false -> skip()
