module src::process_query::linux::linux_process_query;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::memory::bitness::Bitness;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::processes::target_architecture::TargetArchitecture;
use squalr_engine_api::src::structures::processes::process_info::ProcessInfo;
use squalr_engine_targets::src::process_query::process_query_error::ProcessQueryError;
use squalr_engine_targets::src::process_query::process_query_options::ProcessNameSearch;
use squalr_engine_targets::src::process_query::process_query_options::ProcessQueryLimit;
use squalr_engine_targets::src::process_query::process_query_options::ProcessQueryOptions;
use squalr_engine_targets::src::process_query::process_query_options::RequiredProcessId;
use squalr_engine_targets::src::target_providers::OpenedProcessResult;
use squalr_engine_targets::src::target_providers::ProcessAliveResult;
use squalr_engine_targets::src::target_providers::ProcessListOutcome;
use squalr_engine_targets::src::target_providers::ProcessQueryOutcome;
use src::memory_queryer::linux::linux_memory_queryer::U64Result;
use src::memory_queryer::linux::linux_memory_queryer::U8Result;
use src::memory_queryer::linux::linux_memory_queryer::U32Result;
use src::memory_queryer::linux::linux_memory_queryer::BoolResult;
use src::proc_paths::ProcName;

// Port of process_query/linux/linux_process_query.rs.
//
//   open_process (handle = pid, exactly as upstream), close_process
//   (upstream's unconditional Ok), the ELF-header target-architecture read of
//   /proc/<pid>/exe with upstream's host fallback, is_process_alive as the
//   procfs existence check standing in for upstream's kill(pid, 0), and
//   start/stop_monitoring as upstream's unconditional Ok (the process
//   monitor's death-watch thread is a session-events item; the Linux impl
//   performs no work at registration).
//
//   get_processes is sysinfo's /proc sweep: sysinfo refreshes the full
//   process list once (numeric dirents under /proc, name = comm between the
//   first ' ' and the LAST ')' of /proc/<pid>/stat, entries whose stat read
//   or parse fails are absent) and upstream then filter_maps that snapshot
//   in this exact order: required_process_id -> name contains-filter (ASCII
//   case fold unless match_case) -> is_process_windowed(always computed,
//   then require_windowed drops) -> fetch_icons -> take(limit).
//   The port is two-phase for the same reason: phase 1 collects numeric
//   dirents into a bounded pid table (16384 entries; overflow sets
//   `truncated` — a bounded-table marker, like the caller's `out` capacity),
//   phase 2 materializes each pid exactly as upstream's filter_map.
//   Iteration order is readdir order; upstream's HashMap order is
//   unspecified, so no ordering guarantee is dropped. A pid that dies
//   between phases is skipped (upstream would carry it stale — the snapshot
//   delta is the recorded translation). fetch_icons is accepted but a no-op:
//   ProcessInfo drops upstream's icon field (GUI payload, unported), so the
//   desktop-entry lookup would produce nothing observable.
//
//   is_process_windowed mirrors upstream: empty inode snapshot -> false;
//   process_has_display_environment scans NUL-separated /proc/<pid>/environ
//   entries for key == "DISPLAY" or "WAYLAND_DISPLAY" with a non-empty value;
//   then every /proc/<pid>/fd entry is classified. Upstream reads each fd's
//   symlink target for the "socket:[inode]" prefix; there is no
//   readlink-style op on the raw filesystem seam, so the port uses the
//   equivalent kernel-visible discriminator: opening an fd symlink for a
//   socket fails with ENXIO (-6) for every sockfs type, while pipes, files
//   and anon_inode fds either open or fail with a different errno — and the
//   socket inode itself is read from /proc/<pid>/fdinfo/<fd> `ino:`, which
//   is the same number the readlink target carries. display_server_socket_
//   inodes -> true; process_has_display_environment && connected_stream_
//   socket_inodes -> true.
//
//   /proc/net/unix snapshot: per line split_whitespace, skip when fewer than
//   seven columns or when the Inode column (index 6, decimal) fails to parse;
//   Type (index 4) == "0001" && St (index 5) == "03" -> connected set
//   (string equality upstream — the kernel's fixed four/two-digit forms
//   parse identically, so the port parses decimal); Path (index 7, when
//   present) containing "/wayland-" or "/tmp/.X11-unix/" -> display set.
//   Both tables are bounded (256 display / 2048 connected inodes) and
//   deduplicate like upstream's HashSet — overflow is a named failure, not a
//   silent subset.
pub data LinuxProcessQuery {
    proc_fd: i32;
    exe_fd: i32;
    header: [u8; 1];
    count: i64;
    scratch: i32;
    name: ProcName;
    // Upstream stores `bitness` here. Copy-multiplicity case values cannot
    // currently be written into fields (unconsumed structural result), so the
    // two architecture paths carry a scalar tag and `opened_build` selects the
    // `Bitness`/`TargetArchitecture` pair at the literal.
    bitness_tag: u8;

    // get_processes sweep state.
    dir_buf: [u8; 4096];
    dir_total: u64;
    dir_off: u64;
    dir_pos: i64;
    reclen: u64;
    pid_tab: [u32; 16384];
    pid_count: u64;
    pid_at: u64;
    emitted: u64;
    truncated: bool;
    limit: u64;
    require_windowed: bool;
    match_case: bool;
    req_pid: u32;
    req_pid_set: bool;
    needle: [u8; 256];
    needle_len: u64;
    have_search: bool;

    // Unix-socket inode snapshot for is_process_windowed.
    disp_inodes: [u64; 256];
    disp_count: u64;
    conn_inodes: [u64; 2048];
    conn_count: u64;
    snap_overflow: bool;

    // Per-candidate registers.
    c_pid: u32;
    c_name: [u8; 256];
    c_name_len: u64;
    c_windowed: bool;
    c_has_env: bool;
    inode: u64;
    num: u64;
    found: bool;

    // Generic record stream (environ NUL entries, fdinfo and net/unix
    // lines) sharing one rolling buffer — all uses are strictly sequential.
    io_fd: i32;
    io_delim: u8;
    io_buf: [u8; 4096];
    io_len: u64;
    io_pos: u64;
    rec: [u8; 256];
    rec_len: u64;
    rec_skip: bool;

    // "<pid>/<leaf>" names longer than ProcName's four-byte leaf cap
    // ("environ", "fdinfo/<fd>"): assembled byte-wise, opened via open_at's
    // trusted plain-name surface.
    path_buf: [u8; 64];
    path_len: u64;
    stat_buf: [u8; 2048];
    stat_len: i64;
    probe_fd: i32;
    fd_fd: i32;

    // Token/cursor registers.
    i: u64;
    j: u64;
    k: u64;
    tok_start: u64;
    tok_end: u64;
    tok_count: u64;
    col4: u64;
    col5: u64;
    col6_ok: bool;
    col7_start: u64;
    col7_end: u64;
    ch: u8;
}

pub linux_x86_64 machine LinuxProcessQuery::open_process(
    this: &mut LinuxProcessQuery,
    process_info: &ProcessInfo
) -> OpenedProcessResult
reaches FilesystemHost
invokes FilesystemHost;
{
    // read_process_executable_bytes -> ELF EI_CLASS at offset 4 (also the
    // process-existence probe: an unreadable exe means the process is gone or
    // unreadable — upstream falls back to the host architecture either way).
    transition { _ -> entry(this, process_info) }

    state entry(this: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        let pid: u32 = ProcessInfo::get_process_id_raw(&process_info);
        this.name = ProcName::for_process(pid, 101, 120, 101, 0, 3);
        let _proc_fd_r: i32 = FilesystemHost::open("/proc", 65536);
        this.proc_fd = _proc_fd_r;
        transition _proc_fd_r >= 0 {
            true -> open_exe(this, process_info)
            _ -> fallback(this, process_info)
        }
    }

    state open_exe(this: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        transition this.name.len <= 48 {
            true -> open_exe_at(this, process_info, this.name.len)
            false -> open_exe_at(this, process_info, 48)
        }
    }

    state open_exe_at(this: &mut LinuxProcessQuery, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        transition name_len <= this.name.bytes.len {
            true -> open_exe_do(this, process_info, name_len)
            false -> close_fallback(this, process_info)
        }
    }

    state open_exe_do(this: &mut LinuxProcessQuery, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        let procfd: i32 = this.proc_fd;
        let _exe_fd_r: i32 = FilesystemHost::open_at(procfd, this.name.bytes[0..48], 0);
        this.exe_fd = _exe_fd_r;
        transition _exe_fd_r >= 0 {
            true -> read_class(this, process_info)
            false -> close_fallback(this, process_info)
        }
    }

    state read_class(this: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        let exefd: i32 = this.exe_fd;
        let _count_r: i64 = FilesystemHost::read_at(exefd, &mut this.header, 1, 4);
        this.count = _count_r;
        let _u1: i32 = FilesystemHost::close(this.exe_fd);
        this.scratch = _u1;
        let _u2: i32 = FilesystemHost::close(this.proc_fd);
        this.scratch = _u2;
        transition _count_r == 1 && this.header[0] == 1 {
            true -> arch32(this, process_info)
            false -> arch64_or_fallback(this, process_info)
        }
    }

    state arch32(this: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        this.bitness_tag = 1;
        transition { _ -> opened(this, process_info) }
    }

    state arch64_or_fallback(this: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        transition this.count == 1 && this.header[0] == 2 {
            true -> arch64(this, process_info)
            false -> host_fallback(this, process_info)
        }
    }

    state arch64(this: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        this.bitness_tag = 0;
        transition { _ -> opened(this, process_info) }
    }

    // TargetArchitecture::unknown(host_pointer_width, Little): on linux_x86_64
    // the host is Bit64.
    state host_fallback(this: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        this.bitness_tag = 0;
        transition { _ -> opened(this, process_info) }
    }

    state close_fallback(this: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        let _u3: i32 = FilesystemHost::close(this.proc_fd);
        this.scratch = _u3;
        transition { _ -> host_fallback(this, process_info) }
    }

    state fallback(this: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        transition { _ -> host_fallback(this, process_info) }
    }

    state opened(this: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        // Upstream: handle = process_id as u64; icon None; name from the query.
        transition process_info.name_len <= process_info.name.len {
            true -> opened_with_len(this, process_info, process_info.name_len)
            false -> opened_with_len(this, process_info, 256)
        }
    }

    state opened_with_len(this: &mut LinuxProcessQuery, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        transition name_len <= 256 {
            true -> opened_build(this, process_info, name_len)
            false -> opened_build(this, process_info, 256)
        }
    }

    state opened_build(this: &mut LinuxProcessQuery, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        transition this.bitness_tag == 1 {
            true -> opened_build32(this, process_info, name_len)
            false -> opened_build64(this, process_info, name_len)
        }
    }

    // Result literals are written inline: `OpenedProcessInfo::new` is a call,
    // and nested calls inside a result literal are not admitted. `name` is the
    // bounded-256 array carried whole (upstream `set_name` leaves the same
    // zero-filled tail); `target_architecture` mirrors
    // `TargetArchitecture::default_for_bitness` — X86 for 32, X64 for 64.
    state opened_build32(this: &mut LinuxProcessQuery, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        let pid: u32 = ProcessInfo::get_process_id_raw(&process_info);
        OpenedProcessResult {
            outcome: ProcessQueryOutcome::Succeeded,
            info: OpenedProcessInfo {
                process_id: pid,
                name: process_info.name,
                name_len: name_len,
                handle: pid as u64,
                bitness: Bitness::Bit32,
                target_architecture: TargetArchitecture::X86
            }
        }
    }

    state opened_build64(this: &mut LinuxProcessQuery, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        let pid: u32 = ProcessInfo::get_process_id_raw(&process_info);
        OpenedProcessResult {
            outcome: ProcessQueryOutcome::Succeeded,
            info: OpenedProcessInfo {
                process_id: pid,
                name: process_info.name,
                name_len: name_len,
                handle: pid as u64,
                bitness: Bitness::Bit64,
                target_architecture: TargetArchitecture::X64
            }
        }
    }
}

pub linux_x86_64 machine LinuxProcessQuery::close_process(
    this: &mut LinuxProcessQuery,
    handle: u64
) -> ProcessQueryOutcome
{
    // Upstream: `Ok(())` for any handle — there is no descriptor custody.
    ProcessQueryOutcome::Succeeded
}

pub linux_x86_64 machine LinuxProcessQuery::is_process_alive(
    this: &mut LinuxProcessQuery,
    process_id: u32
) -> ProcessAliveResult
reaches FilesystemHost
invokes FilesystemHost;
{
    // Upstream uses kill(pid, 0) (ESRCH => dead); procfs existence is the same
    // signal for this package's scope: /proc/<pid> present iff the pid lives.
    this.name = ProcName::for_pid(process_id);
    let _proc_fd_r: i32 = FilesystemHost::open("/proc", 65536);
    this.proc_fd = _proc_fd_r;
    transition _proc_fd_r >= 0 {
        true -> probe(this)
        false -> dead(this)
    }

    state probe(this: &mut LinuxProcessQuery) -> ProcessAliveResult {
        transition this.name.len <= 48 {
            true -> probe_at(this, this.name.len)
            false -> probe_at(this, 48)
        }
    }

    state probe_at(this: &mut LinuxProcessQuery, name_len: u64) -> ProcessAliveResult {
        transition name_len <= this.name.bytes.len {
            true -> probe_do(this, name_len)
            false -> dead(this)
        }
    }

    state probe_do(this: &mut LinuxProcessQuery, name_len: u64) -> ProcessAliveResult {
        let procfd: i32 = this.proc_fd;
        let _exe_fd_r: i32 = FilesystemHost::open_at(procfd, this.name.bytes[0..48], 65536);
        this.exe_fd = _exe_fd_r;
        let _u5: i32 = FilesystemHost::close(this.proc_fd);
        this.scratch = _u5;
        transition _exe_fd_r >= 0 {
            true -> alive(this)
            false -> dead(this)
        }
    }

    state alive(this: &mut LinuxProcessQuery) -> ProcessAliveResult {
        let _u6: i32 = FilesystemHost::close(this.exe_fd);
        this.scratch = _u6;
        transition { _ -> yes(this) }
    }

    state yes(this: &mut LinuxProcessQuery) -> ProcessAliveResult {
        ProcessAliveResult::Alive
    }

    state dead(this: &mut LinuxProcessQuery) -> ProcessAliveResult {
        ProcessAliveResult::Dead
    }
}

pub linux_x86_64 machine LinuxProcessQuery::start_monitoring(
    this: &mut LinuxProcessQuery,
    process_id: u32
) -> ProcessQueryOutcome
{
    // Upstream Linux: unconditional Ok(()) — the monitor is inert on Linux
    // (Windows spins a wait thread; the trait's pid argument describes the
    // watch target and is unused here, as upstream's no-arg impl confirms).
    ProcessQueryOutcome::Succeeded
}

pub linux_x86_64 machine LinuxProcessQuery::stop_monitoring(
    this: &mut LinuxProcessQuery) -> ProcessQueryOutcome
{
    ProcessQueryOutcome::Succeeded
}

pub linux_x86_64 machine LinuxProcessQuery::get_processes(
    this: &mut LinuxProcessQuery,
    options: ProcessQueryOptions,
    out: &mut [ProcessInfo]
) -> ProcessListOutcome
reaches FilesystemHost
invokes FilesystemHost;
crashes Trap
{
    this.emitted = 0;
    this.truncated = false;
    this.pid_count = 0;
    this.pid_at = 0;
    this.dir_total = 0;
    this.dir_off = 0;
    this.dir_pos = 0;
    this.disp_count = 0;
    this.conn_count = 0;
    this.snap_overflow = false;
    this.req_pid = 0;
    this.req_pid_set = false;
    this.needle_len = 0;
    this.have_search = false;
    this.require_windowed = options.require_windowed;
    this.match_case = options.match_case;
    this.limit = 18446744073709551615;
    transition options.required_process_id {
        RequiredProcessId::Any -> opt_pid_none(this, options, out)
        RequiredProcessId::Required { process_id } -> opt_pid_set(this, options, process_id, out)
    }

    state opt_pid_none(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition { _ -> opt_pid_done(this, options, out) }
    }

    state opt_pid_set(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, pid: u32, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        this.req_pid = pid;
        this.req_pid_set = true;
        transition { _ -> opt_pid_done(this, options, out) }
    }

    state opt_pid_done(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition options.limit {
            ProcessQueryLimit::Unlimited -> opt_limit_done(this, options, out)
            ProcessQueryLimit::Limited { limit } -> opt_limit_set(this, options, limit, out)
        }
    }

    state opt_limit_set(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, limit: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        this.limit = limit;
        transition { _ -> opt_limit_done(this, options, out) }
    }

    state opt_limit_done(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition options.search_name {
            ProcessNameSearch::Any -> needle_done(this, options, out)
            ProcessNameSearch::Named { name, name_len } -> needle_copy(this, options, name, name_len, 0, out)
        }
    }

    // Pre-fold the search term once (upstream folds it per comparison).
    state needle_copy(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, name: [u8; 256], name_len: u64, pos: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition pos < name_len && pos < name.len {
            true -> needle_store(this, options, name, name_len, pos, out)
            false -> needle_finish(this, options, name_len, out)
        }
    }

    // Upstream folds the filter only on the case-insensitive path.
    state needle_store(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, name: [u8; 256], name_len: u64, pos: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition this.match_case {
            true -> needle_store_raw(this, options, name, name_len, pos, out)
            false -> needle_store_folded(this, options, name, name_len, pos, out)
        }
    }

    state needle_store_raw(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, name: [u8; 256], name_len: u64, pos: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        LinuxProcessQuery::needle_put(&mut this, pos, name[pos]);
        transition { _ -> needle_copy(this, options, name, name_len, ((pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, out) }
    }

    state needle_store_folded(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, name: [u8; 256], name_len: u64, pos: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        let folded_byte: U8Result = LinuxProcessQuery::lowered(&mut this, name[pos]);
        let folded_byte_v: u8 = folded_byte.v;
        LinuxProcessQuery::needle_put(&mut this, pos, folded_byte_v);
        transition { _ -> needle_copy(this, options, name, name_len, ((pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, out) }
    }

    state needle_finish(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, name_len: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition name_len <= 256 {
            true -> needle_have(this, options, name_len, out)
            false -> needle_have(this, options, 256, out)
        }
    }

    state needle_have(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, name_len: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        this.needle_len = name_len;
        this.have_search = true;
        transition { _ -> needle_done(this, options, out) }
    }

    // The unix-socket snapshot is collected BEFORE the sweep, as upstream.
    state needle_done(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        let _u7: BoolResult = LinuxProcessQuery::collect_socket_snapshot(&mut this);
        transition _u7.v {
            true -> open_proc(this, options, out)
            false -> failed(this, options, out)
        }
    }

    state open_proc(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        let _proc_fd_r: i32 = FilesystemHost::open("/proc", 65536);
        this.proc_fd = _proc_fd_r;
        transition _proc_fd_r >= 0 {
            true -> dir_fill(this, options, out)
            false -> listed_empty(this, options, out)
        }
    }

    // Unreadable /proc: upstream's sysinfo refresh yields an empty map —
    // an empty list is the faithful observable result, not an error.
    state listed_empty(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        ProcessListOutcome::Listed { count: 0, truncated: false }
    }

    // Phase 1: getdents64 walk collecting numeric directory names.
    state dir_fill(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        let procfd: i32 = this.proc_fd;
        let _count_r: i64 = FilesystemHost::read_dir(procfd, &mut this.dir_buf, 4096, &mut this.dir_pos);
        this.count = _count_r;
        transition _count_r > 0 {
            true -> dir_take(this, options, out)
            false -> dir_nonpositive(this, options, out)
        }
    }

    state dir_take(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        this.dir_total = ((this.count as u64 in Wrapping) as u64);
        this.dir_off = 0;
        transition { _ -> dir_walk(this, options, out) }
    }

    // A mid-walk read error ends collection with what was seen — upstream's
    // iterator swallows per-entry errors the same way.
    state dir_nonpositive(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition this.count == 0 {
            true -> phase_b(this, options, out)
            false -> phase_b(this, options, out)
        }
    }

    state dir_walk(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition this.dir_off < this.dir_total {
            true -> dir_header(this, options, out)
            false -> dir_fill(this, options, out)
        }
    }

    state dir_header(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition ((this.dir_off as u64 in Wrapping) + (19 as u64 in Wrapping)) as u64 <= this.dir_total {
            true -> dir_reclen(this, options, out)
            false -> phase_b(this, options, out)
        }
    }

    state dir_reclen(this: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        let _u8: U8Result = LinuxProcessQuery::dir_at(&mut this, ((this.dir_off as u64 in Wrapping) + (17 as u64 in Wrapping)) as u64);
        let _u9: U8Result = LinuxProcessQuery::dir_at(&mut this, ((this.dir_off as u64 in Wrapping) + (16 as u64 in Wrapping)) as u64);
        this.reclen = ((((_u8.v as u64 in Wrapping) * (256 as u64 in Wrapping)) as u64) | (_u9.v as u64));
        transition this.reclen > 0 && ((this.dir_off as u64 in Wrapping) + (this.reclen as u64 in Wrapping)) as u64 <= this.dir_total {
            true -> dir_dtype(this, options, out)
            false -> phase_b(this, options, out)
        }
    }

    // file_type().is_dir(): DT_DIR (4) only; procfs always supplies d_type
