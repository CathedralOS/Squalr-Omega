machine LinuxProcessQuery::path_set(&mut self, position: u64, byte: u8) {
    transition position < 64 {
        true -> put(position, byte)
        false -> skip()
    }
    state put(&mut self, position: u64, byte: u8) { self.path_buf[position] = byte; }
    state skip(&mut self) {
    }
}

machine LinuxProcessQuery::pid_at(&mut self, index: u64) -> u32 {
    transition index < 16384 {
        true -> hit(index)
        false -> miss()
    }
    state hit(&mut self, index: u64) -> u32 { self.pid_tab[index] }
