// The per-call snapshot of /proc/net/unix inode sets. Returns false only on
// a bounded-table overflow (a named failure — the sets cannot be silently
// partial, or windowed detection would lie). An unreadable file yields the
// empty snapshot, exactly as upstream's Err -> default().
machine LinuxProcessQuery::collect_socket_snapshot(linux_process_query: &mut LinuxProcessQuery) -> BoolResult
reaches FilesystemHost
invokes FilesystemHost;
{
    let _io_fd_r: i32 = FilesystemHost::open("/proc/net/unix", 0);
    linux_process_query.io_fd = _io_fd_r;
    transition _io_fd_r >= 0 {
        true -> stream(linux_process_query)
        false -> empty_ok(linux_process_query)
    }

    state stream(linux_process_query: &mut LinuxProcessQuery) -> BoolResult {
        linux_process_query.io_delim = 10;
        linux_process_query.io_len = 0;
        linux_process_query.io_pos = 0;
        transition { _ -> next_line(linux_process_query) }
    }

    state next_line(linux_process_query: &mut LinuxProcessQuery) -> BoolResult {
        let _scratch_r: U8Result = LinuxProcessQuery::stream_next(linux_process_query);
        linux_process_query.scratch = _scratch_r.v as i32;
        transition _scratch_r.v == 0 {
            true -> parse_line(linux_process_query)
            false -> ended(linux_process_query)
        }
    }

    state parse_line(linux_process_query: &mut LinuxProcessQuery) -> BoolResult {
        let _scratch_r: U8Result = LinuxProcessQuery::unix_record(linux_process_query);
        linux_process_query.scratch = _scratch_r.v as i32;
        transition _scratch_r.v == 2 {
            true -> overflow(linux_process_query)
            false -> next_line(linux_process_query)
        }
    }

    // A mid-stream read error mirrors upstream's fs::read_to_string Err:
    // the snapshot reverts to empty.
    state ended(linux_process_query: &mut LinuxProcessQuery) -> BoolResult {
        let _u16: i32 = FilesystemHost::close(linux_process_query.io_fd);
        linux_process_query.scratch = _u16;
        transition linux_process_query.snap_overflow {
            true -> no(linux_process_query)
            false -> yes(linux_process_query)
        }
    }

    state overflow(linux_process_query: &mut LinuxProcessQuery) -> BoolResult {
        let _u17: i32 = FilesystemHost::close(linux_process_query.io_fd);
        linux_process_query.scratch = _u17;
        transition { _ -> no(linux_process_query) }
    }

    state empty_ok(linux_process_query: &mut LinuxProcessQuery) -> BoolResult { BoolResult { v: true } }

    state yes(linux_process_query: &mut LinuxProcessQuery) -> BoolResult { BoolResult { v: true } }

    state no(linux_process_query: &mut LinuxProcessQuery) -> BoolResult { BoolResult { v: false } }
}

