machine LinuxProcessQuery::needle_put(&mut self, position: u64, byte: u8) {
    transition position < 256 {
        true -> put(position, byte)
        false -> skip()
    }
    state put(&mut self, position: u64, byte: u8) { self.needle[position] = byte; }
    state skip(&mut self) {
    }
}

machine LinuxProcessQuery::path_at(&mut self, position: u64) -> u8 {
    transition position < 64 {
        true -> hit(position)
        false -> miss()
    }
    state hit(&mut self, position: u64) -> u8 { self.path_buf[position] }
    state miss(&mut self) -> u8 { 0 }
