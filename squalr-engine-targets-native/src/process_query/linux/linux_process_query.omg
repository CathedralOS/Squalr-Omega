// process_has_display_environment: NUL-separated environ entries, matching
// key == "DISPLAY" or "WAYLAND_DISPLAY" with a non-empty value.
machine LinuxProcessQuery::has_display_env(this: &mut LinuxProcessQuery) -> BoolResult
reaches FilesystemHost
invokes FilesystemHost;
{
    LinuxProcessQuery::path_reset(&mut this);
    LinuxProcessQuery::path_put_pid(&mut this);
    LinuxProcessQuery::path_push(&mut this, 47);
    LinuxProcessQuery::path_push(&mut this, 101);
    LinuxProcessQuery::path_push(&mut this, 110);
    LinuxProcessQuery::path_push(&mut this, 118);
    LinuxProcessQuery::path_push(&mut this, 105);
    LinuxProcessQuery::path_push(&mut this, 114);
    LinuxProcessQuery::path_push(&mut this, 111);
    LinuxProcessQuery::path_push(&mut this, 110);
    transition { _ -> open_env(this) }

    state open_env(this: &mut LinuxProcessQuery) -> BoolResult {
        transition this.path_len <= this.path_buf.len {
            true -> open_env_do(this)
            false -> no(this)
        }
    }

    state open_env_do(this: &mut LinuxProcessQuery) -> BoolResult {
        let procfd: i32 = this.proc_fd;
        let _io_fd_r: FdResult = LinuxProcessQuery::host_open_at(&mut this, procfd, &this.path_buf, this.path_len);
        this.io_fd = _io_fd_r.v;
        transition _io_fd_r.v >= 0 {
            true -> stream(this)
            false -> no(this)
        }
    }

    state stream(this: &mut LinuxProcessQuery) -> BoolResult {
        this.io_delim = 0;
        this.io_len = 0;
        this.io_pos = 0;
        transition { _ -> next_entry(this) }
    }

    state next_entry(this: &mut LinuxProcessQuery) -> BoolResult {
        let _scratch_r: U8Result = LinuxProcessQuery::stream_next(&mut this);
        this.scratch = _scratch_r.v as i32;
        transition _scratch_r.v == 0 {
            true -> check_entry(this)
            false -> close_no(this)
        }
    }

    // Entry matches when key (before the first '=') is exactly DISPLAY or
    // WAYLAND_DISPLAY and a non-empty value follows it.
    state check_entry(this: &mut LinuxProcessQuery) -> BoolResult {
        let _u58: BoolResult = LinuxProcessQuery::rec_has_prefix(&mut this, "DISPLAY=");
        transition this.rec_len > 8 && _u58.v {
            true -> close_yes(this)
            false -> check_wayland(this)
        }
    }

    state check_wayland(this: &mut LinuxProcessQuery) -> BoolResult {
        let _u59: BoolResult = LinuxProcessQuery::rec_has_prefix(&mut this, "WAYLAND_DISPLAY=");
        transition this.rec_len > 16 && _u59.v {
            true -> close_yes(this)
            false -> next_entry(this)
        }
    }

    state close_yes(this: &mut LinuxProcessQuery) -> BoolResult {
        let _u60: i32 = FilesystemHost::close(this.io_fd);
        this.scratch = _u60;
        transition { _ -> yes(this) }
    }

    state close_no(this: &mut LinuxProcessQuery) -> BoolResult {
        let _u61: i32 = FilesystemHost::close(this.io_fd);
        this.scratch = _u61;
        transition { _ -> no(this) }
    }

    state yes(this: &mut LinuxProcessQuery) -> BoolResult { BoolResult { v: true } }

    state no(this: &mut LinuxProcessQuery) -> BoolResult { BoolResult { v: false } }
}

// "<pid>" decimal into path_buf (ProcName::for_pid's emission, without the
// four-byte leaf cap).
machine LinuxProcessQuery::path_reset(this: &mut LinuxProcessQuery) {
    this.path_len = 0;
}

machine LinuxProcessQuery::path_put_pid(this: &mut LinuxProcessQuery) {
    this.name = ProcName::for_pid(this.c_pid);
    this.j = 0;
    transition { _ -> copy(this) }

    state copy(this: &mut LinuxProcessQuery) {
        transition this.j < this.name.len && this.j < 48 {
            true -> put(this)
            false -> done(this)
        }
    }

    state put(this: &mut LinuxProcessQuery) {
        transition this.path_len < 64 && this.j < 48 {
            true -> byte(this)
            false -> done(this)
        }
    }

    state byte(this: &mut LinuxProcessQuery) {
        let ji: u64 = this.j;
        let b: u8 = ProcName::byte_at(&mut this.name, ji) as u8;
        LinuxProcessQuery::path_set(&mut this, this.path_len, b as u8);
        this.path_len = ((this.path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        this.j = ((this.j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> copy(this) }
    }

    state done(this: &mut LinuxProcessQuery) {
    }
}

machine LinuxProcessQuery::path_push(this: &mut LinuxProcessQuery, byte: u8) {
    transition this.path_len < 64 {
        true -> put(this, byte)
        false -> done(this)
    }

    state put(this: &mut LinuxProcessQuery, byte: u8) {
        LinuxProcessQuery::path_set(&mut this, this.path_len, byte);
        this.path_len = ((this.path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done(this) }
    }

    state done(this: &mut LinuxProcessQuery) {
    }
}

// Bounded accessors for the fixed tables: positions arrive as ordinary args
// (computed expressions allowed); the internal guard discharges the index
// proof, and out-of-range reads yield 0 — a byte that cannot match a live
// query. Writes out of range are dropped (unreachable by construction).
machine LinuxProcessQuery::dir_at(this: &mut LinuxProcessQuery, position: u64) -> U8Result {
    transition position < 4096 {
        true -> hit(this, position)
        false -> miss(this)
    }
    state hit(this: &mut LinuxProcessQuery, position: u64) -> U8Result { U8Result { v: this.dir_buf[position] } }
    state miss(this: &mut LinuxProcessQuery) -> U8Result { U8Result { v: 0 } }
}

machine LinuxProcessQuery::io_at(this: &mut LinuxProcessQuery, position: u64) -> U8Result {
