            true -> fdinfo_digit(this)
            false -> fdinfo_done(this)
        }
    }

    state fdinfo_digit(this: &mut LinuxProcessQuery) -> BoolResult {
        let _ch_r: U8Result = LinuxProcessQuery::rec_at(&mut this, this.j);
        this.ch = _ch_r.v;
        transition _ch_r.v >= 48 && _ch_r.v <= 57 {
