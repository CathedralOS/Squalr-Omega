module src::process_query::linux::linux_process_query;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::memory::bitness::Bitness;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::processes::target_architecture::TargetArchitecture;
use squalr_engine_api::src::structures::processes::process_info::ProcessInfo;
use squalr_engine_targets::src::process_query::process_query_error::ProcessQueryError;
use squalr_engine_targets::src::process_query::process_query_options::ProcessNameSearch;
use squalr_engine_targets::src::process_query::process_query_options::ProcessQueryLimit;
use squalr_engine_targets::src::process_query::process_query_options::ProcessQueryOptions;
use squalr_engine_targets::src::process_query::process_query_options::RequiredProcessId;
use squalr_engine_targets::src::target_providers::OpenedProcessResult;
use squalr_engine_targets::src::target_providers::ProcessAliveResult;
use squalr_engine_targets::src::target_providers::ProcessListOutcome;
use squalr_engine_targets::src::target_providers::ProcessQueryOutcome;
use src::memory_queryer::linux::linux_memory_queryer::U64Result;
use src::memory_queryer::linux::linux_memory_queryer::U8Result;
use src::memory_queryer::linux::linux_memory_queryer::U32Result;
use src::memory_queryer::linux::linux_memory_queryer::BoolResult;
use src::proc_paths::ProcName;

// Port of process_query/linux/linux_process_query.rs.
//
//   open_process (handle = pid, exactly as upstream), close_process
//   (upstream's unconditional Ok), the ELF-header target-architecture read of
//   /proc/<pid>/exe with upstream's host fallback, is_process_alive as the
//   procfs existence check standing in for upstream's kill(pid, 0), and
//   start/stop_monitoring as upstream's unconditional Ok (the process
//   monitor's death-watch thread is a session-events item; the Linux impl
//   performs no work at registration).
//
//   get_processes is sysinfo's /proc sweep: sysinfo refreshes the full
//   process list once (numeric dirents under /proc, name = comm between the
//   first ' ' and the LAST ')' of /proc/<pid>/stat, entries whose stat read
//   or parse fails are absent) and upstream then filter_maps that snapshot
//   in this exact order: required_process_id -> name contains-filter (ASCII
//   case fold unless match_case) -> is_process_windowed(always computed,
//   then require_windowed drops) -> fetch_icons -> take(limit).
//   The port is two-phase for the same reason: phase 1 collects numeric
//   dirents into a bounded pid table (16384 entries; overflow sets
//   `truncated` — a bounded-table marker, like the caller's `out` capacity),
//   phase 2 materializes each pid exactly as upstream's filter_map.
//   Iteration order is readdir order; upstream's HashMap order is
//   unspecified, so no ordering guarantee is dropped. A pid that dies
//   between phases is skipped (upstream would carry it stale — the snapshot
//   delta is the recorded translation). fetch_icons is accepted but a no-op:
//   ProcessInfo drops upstream's icon field (GUI payload, unported), so the
//   desktop-entry lookup would produce nothing observable.
//
//   is_process_windowed mirrors upstream: empty inode snapshot -> false;
//   process_has_display_environment scans NUL-separated /proc/<pid>/environ
//   entries for key == "DISPLAY" or "WAYLAND_DISPLAY" with a non-empty value;
//   then every /proc/<pid>/fd entry is classified. Upstream reads each fd's
//   symlink target for the "socket:[inode]" prefix; there is no
//   readlink-style op on the raw filesystem seam, so the port uses the
//   equivalent kernel-visible discriminator: opening an fd symlink for a
//   socket fails with ENXIO (-6) for every sockfs type, while pipes, files
//   and anon_inode fds either open or fail with a different errno — and the
//   socket inode itself is read from /proc/<pid>/fdinfo/<fd> `ino:`, which
//   is the same number the readlink target carries. display_server_socket_
//   inodes -> true; process_has_display_environment && connected_stream_
//   socket_inodes -> true.
//
//   /proc/net/unix snapshot: per line split_whitespace, skip when fewer than
//   seven columns or when the Inode column (index 6, decimal) fails to parse;
//   Type (index 4) == "0001" && St (index 5) == "03" -> connected set
//   (string equality upstream — the kernel's fixed four/two-digit forms
//   parse identically, so the port parses decimal); Path (index 7, when
//   present) containing "/wayland-" or "/tmp/.X11-unix/" -> display set.
//   Both tables are bounded (256 display / 2048 connected inodes) and
//   deduplicate like upstream's HashSet — overflow is a named failure, not a
//   silent subset.
pub data LinuxProcessQuery {
    proc_fd: i32;
    exe_fd: i32;
    header: [u8; 1];
    count: i64;
    scratch: i32;
    name: ProcName;
    // Upstream stores `bitness` here. Copy-multiplicity case values cannot
    // currently be written into fields (unconsumed structural result), so the
    // two architecture paths carry a scalar tag and `opened_build` selects the
    // `Bitness`/`TargetArchitecture` pair at the literal.
    bitness_tag: u8;

    // get_processes sweep state.
    dir_buf: [u8; 4096];
    dir_total: u64;
    dir_off: u64;
    dir_pos: i64;
    reclen: u64;
    pid_tab: [u32; 16384];
    pid_count: u64;
    pid_at: u64;
    emitted: u64;
    truncated: bool;
    limit: u64;
    require_windowed: bool;
    match_case: bool;
    req_pid: u32;
    req_pid_set: bool;
    needle: [u8; 256];
    needle_len: u64;
    have_search: bool;

    // Unix-socket inode snapshot for is_process_windowed.
    disp_inodes: [u64; 256];
    disp_count: u64;
    conn_inodes: [u64; 2048];
    conn_count: u64;
    snap_overflow: bool;

    // Per-candidate registers.
    c_pid: u32;
    c_name: [u8; 256];
    c_name_len: u64;
    c_windowed: bool;
    c_has_env: bool;
    inode: u64;
    num: u64;
    found: bool;

    // Generic record stream (environ NUL entries, fdinfo and net/unix
    // lines) sharing one rolling buffer — all uses are strictly sequential.
    io_fd: i32;
    io_delim: u8;
    io_buf: [u8; 4096];
    io_len: u64;
    io_pos: u64;
    rec: [u8; 256];
    rec_len: u64;
    rec_skip: bool;

    // "<pid>/<leaf>" names longer than ProcName's four-byte leaf cap
    // ("environ", "fdinfo/<fd>"): assembled byte-wise, opened via open_at's
    // trusted plain-name surface.
    path_buf: [u8; 64];
    path_len: u64;
    stat_buf: [u8; 2048];
    stat_len: i64;
    probe_fd: i32;
    fd_fd: i32;

    // Token/cursor registers.
    i: u64;
    j: u64;
    k: u64;
    tok_start: u64;
    tok_end: u64;
    tok_count: u64;
    col4: u64;
    col5: u64;
    col6_ok: bool;
    col7_start: u64;
    col7_end: u64;
    ch: u8;
}

pub linux_x86_64 machine LinuxProcessQuery::open_process(
    linux_process_query: &mut LinuxProcessQuery,
    process_info: &ProcessInfo
) -> OpenedProcessResult
reaches FilesystemHost
invokes FilesystemHost;
{
    // read_process_executable_bytes -> ELF EI_CLASS at offset 4 (also the
    // process-existence probe: an unreadable exe means the process is gone or
    // unreadable — upstream falls back to the host architecture either way).
    transition { _ -> entry(linux_process_query, process_info) }

    state entry(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        let pid: u32 = ProcessInfo::get_process_id_raw(process_info);
        linux_process_query.name = ProcName::for_process(pid, 101, 120, 101, 0, 3);
        let _proc_fd_r: i32 = FilesystemHost::open("/proc", 65536);
        linux_process_query.proc_fd = _proc_fd_r;
        transition _proc_fd_r >= 0 {
            true -> open_exe(linux_process_query, process_info)
            _ -> fallback(linux_process_query, process_info)
        }
    }

    state open_exe(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        transition linux_process_query.name.len <= 48 {
            true -> open_exe_at(linux_process_query, process_info, linux_process_query.name.len)
            false -> open_exe_at(linux_process_query, process_info, 48)
        }
    }

    state open_exe_at(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        transition name_len <= linux_process_query.name.bytes.len {
            true -> open_exe_do(linux_process_query, process_info, name_len)
            false -> close_fallback(linux_process_query, process_info)
        }
    }

    state open_exe_do(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        let procfd: i32 = linux_process_query.proc_fd;
        let _exe_fd_r: i32 = FilesystemHost::open_at(procfd, linux_process_query.name.bytes[0..48], 0);
        linux_process_query.exe_fd = _exe_fd_r;
        transition _exe_fd_r >= 0 {
            true -> read_class(linux_process_query, process_info)
            false -> close_fallback(linux_process_query, process_info)
        }
    }

    state read_class(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        let exefd: i32 = linux_process_query.exe_fd;
        let _count_r: i64 = FilesystemHost::read_at(exefd, &mut linux_process_query.header, 1, 4);
        linux_process_query.count = _count_r;
        let _u1: i32 = FilesystemHost::close(linux_process_query.exe_fd);
        linux_process_query.scratch = _u1;
        let _u2: i32 = FilesystemHost::close(linux_process_query.proc_fd);
        linux_process_query.scratch = _u2;
        transition _count_r == 1 && linux_process_query.header[0] == 1 {
            true -> arch32(linux_process_query, process_info)
            false -> arch64_or_fallback(linux_process_query, process_info)
        }
    }

    state arch32(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        linux_process_query.bitness_tag = 1;
        transition { _ -> opened(linux_process_query, process_info) }
    }

    state arch64_or_fallback(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        transition linux_process_query.count == 1 && linux_process_query.header[0] == 2 {
            true -> arch64(linux_process_query, process_info)
            false -> host_fallback(linux_process_query, process_info)
        }
    }

    state arch64(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        linux_process_query.bitness_tag = 0;
        transition { _ -> opened(linux_process_query, process_info) }
    }

    // TargetArchitecture::unknown(host_pointer_width, Little): on linux_x86_64
    // the host is Bit64.
    state host_fallback(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        linux_process_query.bitness_tag = 0;
        transition { _ -> opened(linux_process_query, process_info) }
    }

    state close_fallback(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        let _u3: i32 = FilesystemHost::close(linux_process_query.proc_fd);
        linux_process_query.scratch = _u3;
        transition { _ -> host_fallback(linux_process_query, process_info) }
    }

    state fallback(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        transition { _ -> host_fallback(linux_process_query, process_info) }
    }

    state opened(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo) -> OpenedProcessResult {
        // Upstream: handle = process_id as u64; icon None; name from the query.
        transition process_info.name_len <= process_info.name.len {
            true -> opened_with_len(linux_process_query, process_info, process_info.name_len)
            false -> opened_with_len(linux_process_query, process_info, 256)
        }
    }

    state opened_with_len(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        transition name_len <= 256 {
            true -> opened_build(linux_process_query, process_info, name_len)
            false -> opened_build(linux_process_query, process_info, 256)
        }
    }

    state opened_build(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        transition linux_process_query.bitness_tag == 1 {
            true -> opened_build32(linux_process_query, process_info, name_len)
            false -> opened_build64(linux_process_query, process_info, name_len)
        }
    }

    // Result literals are written inline: `OpenedProcessInfo::new` is a call,
    // and nested calls inside a result literal are not admitted. `name` is the
    // bounded-256 array carried whole (upstream `set_name` leaves the same
    // zero-filled tail); `target_architecture` mirrors
    // `TargetArchitecture::default_for_bitness` — X86 for 32, X64 for 64.
    state opened_build32(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        let pid: u32 = ProcessInfo::get_process_id_raw(process_info);
        OpenedProcessResult {
            outcome: ProcessQueryOutcome::Succeeded,
            info: OpenedProcessInfo {
                process_id: pid,
                name: process_info.name,
                name_len: name_len,
                handle: pid as u64,
                bitness: Bitness::Bit32,
                target_architecture: TargetArchitecture::X86
            }
        }
    }

    state opened_build64(linux_process_query: &mut LinuxProcessQuery, process_info: &ProcessInfo, name_len: u64) -> OpenedProcessResult {
        let pid: u32 = ProcessInfo::get_process_id_raw(process_info);
        OpenedProcessResult {
            outcome: ProcessQueryOutcome::Succeeded,
            info: OpenedProcessInfo {
                process_id: pid,
                name: process_info.name,
                name_len: name_len,
                handle: pid as u64,
                bitness: Bitness::Bit64,
                target_architecture: TargetArchitecture::X64
            }
        }
    }
}

pub linux_x86_64 machine LinuxProcessQuery::close_process(
    linux_process_query: &mut LinuxProcessQuery,
    handle: u64
) -> ProcessQueryOutcome
{
    // Upstream: `Ok(())` for any handle — there is no descriptor custody.
    ProcessQueryOutcome::Succeeded
}

pub linux_x86_64 machine LinuxProcessQuery::is_process_alive(
    linux_process_query: &mut LinuxProcessQuery,
    process_id: u32
) -> ProcessAliveResult
reaches FilesystemHost
invokes FilesystemHost;
{
    // Upstream uses kill(pid, 0) (ESRCH => dead); procfs existence is the same
    // signal for this package's scope: /proc/<pid> present iff the pid lives.
    linux_process_query.name = ProcName::for_pid(process_id);
    let _proc_fd_r: i32 = FilesystemHost::open("/proc", 65536);
    linux_process_query.proc_fd = _proc_fd_r;
    transition _proc_fd_r >= 0 {
        true -> probe(linux_process_query)
        false -> dead(linux_process_query)
    }

    state probe(linux_process_query: &mut LinuxProcessQuery) -> ProcessAliveResult {
        transition linux_process_query.name.len <= 48 {
            true -> probe_at(linux_process_query, linux_process_query.name.len)
            false -> probe_at(linux_process_query, 48)
        }
    }

    state probe_at(linux_process_query: &mut LinuxProcessQuery, name_len: u64) -> ProcessAliveResult {
        transition name_len <= linux_process_query.name.bytes.len {
            true -> probe_do(linux_process_query, name_len)
            false -> dead(linux_process_query)
        }
    }

    state probe_do(linux_process_query: &mut LinuxProcessQuery, name_len: u64) -> ProcessAliveResult {
        let procfd: i32 = linux_process_query.proc_fd;
        let _exe_fd_r: i32 = FilesystemHost::open_at(procfd, linux_process_query.name.bytes[0..48], 65536);
        linux_process_query.exe_fd = _exe_fd_r;
        let _u5: i32 = FilesystemHost::close(linux_process_query.proc_fd);
        linux_process_query.scratch = _u5;
        transition _exe_fd_r >= 0 {
            true -> alive(linux_process_query)
            false -> dead(linux_process_query)
        }
    }

    state alive(linux_process_query: &mut LinuxProcessQuery) -> ProcessAliveResult {
        let _u6: i32 = FilesystemHost::close(linux_process_query.exe_fd);
        linux_process_query.scratch = _u6;
        transition { _ -> yes(linux_process_query) }
    }

    state yes(linux_process_query: &mut LinuxProcessQuery) -> ProcessAliveResult {
        ProcessAliveResult::Alive
    }

    state dead(linux_process_query: &mut LinuxProcessQuery) -> ProcessAliveResult {
        ProcessAliveResult::Dead
    }
}

pub linux_x86_64 machine LinuxProcessQuery::start_monitoring(
    linux_process_query: &mut LinuxProcessQuery,
    process_id: u32
) -> ProcessQueryOutcome
{
    // Upstream Linux: unconditional Ok(()) — the monitor is inert on Linux
    // (Windows spins a wait thread; the trait's pid argument describes the
    // watch target and is unused here, as upstream's no-arg impl confirms).
    ProcessQueryOutcome::Succeeded
}

pub linux_x86_64 machine LinuxProcessQuery::stop_monitoring(
    linux_process_query: &mut LinuxProcessQuery
) -> ProcessQueryOutcome
{
    ProcessQueryOutcome::Succeeded
}

pub linux_x86_64 machine LinuxProcessQuery::get_processes(
    linux_process_query: &mut LinuxProcessQuery,
    options: ProcessQueryOptions,
    out: &mut [ProcessInfo]
) -> ProcessListOutcome
reaches FilesystemHost
invokes FilesystemHost;
crashes Trap
{
    linux_process_query.emitted = 0;
    linux_process_query.truncated = false;
    linux_process_query.pid_count = 0;
    linux_process_query.pid_at = 0;
    linux_process_query.dir_total = 0;
    linux_process_query.dir_off = 0;
    linux_process_query.dir_pos = 0;
    linux_process_query.disp_count = 0;
    linux_process_query.conn_count = 0;
    linux_process_query.snap_overflow = false;
    linux_process_query.req_pid = 0;
    linux_process_query.req_pid_set = false;
    linux_process_query.needle_len = 0;
    linux_process_query.have_search = false;
    linux_process_query.require_windowed = options.require_windowed;
    linux_process_query.match_case = options.match_case;
    linux_process_query.limit = 18446744073709551615;
    transition options.required_process_id {
        RequiredProcessId::Any -> opt_pid_none(linux_process_query, options, out)
        RequiredProcessId::Required { process_id } -> opt_pid_set(linux_process_query, options, process_id, out)
    }

    state opt_pid_none(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition { _ -> opt_pid_done(linux_process_query, options, out) }
    }

    state opt_pid_set(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, pid: u32, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        linux_process_query.req_pid = pid;
        linux_process_query.req_pid_set = true;
        transition { _ -> opt_pid_done(linux_process_query, options, out) }
    }

    state opt_pid_done(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition options.limit {
            ProcessQueryLimit::Unlimited -> opt_limit_done(linux_process_query, options, out)
            ProcessQueryLimit::Limited { limit } -> opt_limit_set(linux_process_query, options, limit, out)
        }
    }

    state opt_limit_set(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, limit: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        linux_process_query.limit = limit;
        transition { _ -> opt_limit_done(linux_process_query, options, out) }
    }

    state opt_limit_done(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition options.search_name {
            ProcessNameSearch::Any -> needle_done(linux_process_query, options, out)
            ProcessNameSearch::Named { name, name_len } -> needle_copy(linux_process_query, options, name, name_len, 0, out)
        }
    }

    // Pre-fold the search term once (upstream folds it per comparison).
    state needle_copy(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, name: [u8; 256], name_len: u64, pos: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition pos < name_len && pos < name.len {
            true -> needle_store(linux_process_query, options, name, name_len, pos, out)
            false -> needle_finish(linux_process_query, options, name_len, out)
        }
    }

    // Upstream folds the filter only on the case-insensitive path.
    state needle_store(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, name: [u8; 256], name_len: u64, pos: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition linux_process_query.match_case {
            true -> needle_store_raw(linux_process_query, options, name, name_len, pos, out)
            false -> needle_store_folded(linux_process_query, options, name, name_len, pos, out)
        }
    }

    state needle_store_raw(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, name: [u8; 256], name_len: u64, pos: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        LinuxProcessQuery::needle_put(linux_process_query, pos, name[pos]);
        transition { _ -> needle_copy(linux_process_query, options, name, name_len, ((pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, out) }
    }

    state needle_store_folded(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, name: [u8; 256], name_len: u64, pos: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        let folded_byte: U8Result = LinuxProcessQuery::lowered(linux_process_query, name[pos]);
        let folded_byte_v: u8 = folded_byte.v;
        LinuxProcessQuery::needle_put(linux_process_query, pos, folded_byte_v);
        transition { _ -> needle_copy(linux_process_query, options, name, name_len, ((pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, out) }
    }

    state needle_finish(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, name_len: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        transition name_len <= 256 {
            true -> needle_have(linux_process_query, options, name_len, out)
            false -> needle_have(linux_process_query, options, 256, out)
        }
    }

    state needle_have(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, name_len: u64, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        linux_process_query.needle_len = name_len;
        linux_process_query.have_search = true;
        transition { _ -> needle_done(linux_process_query, options, out) }
    }

    // The unix-socket snapshot is collected BEFORE the sweep, as upstream.
    state needle_done(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        let _u7: BoolResult = LinuxProcessQuery::collect_socket_snapshot(linux_process_query);
        transition _u7.v {
            true -> open_proc(linux_process_query, options, out)
            false -> failed(linux_process_query, options, out)
        }
    }

    state open_proc(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        let _proc_fd_r: i32 = FilesystemHost::open("/proc", 65536);
        linux_process_query.proc_fd = _proc_fd_r;
        transition _proc_fd_r >= 0 {
            true -> dir_fill(linux_process_query, options, out)
            false -> listed_empty(linux_process_query, options, out)
        }
    }

    // Unreadable /proc: upstream's sysinfo refresh yields an empty map —
    // an empty list is the faithful observable result, not an error.
    state listed_empty(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        ProcessListOutcome::Listed { count: 0, truncated: false }
    }

    // Phase 1: getdents64 walk collecting numeric directory names.
    state dir_fill(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
        let procfd: i32 = linux_process_query.proc_fd;
        let _count_r: i64 = FilesystemHost::read_dir(procfd, &mut linux_process_query.dir_buf, 4096, &mut linux_process_query.dir_pos);
        linux_process_query.count = _count_r;
        transition _count_r > 0 {
            true -> dir_take(linux_process_query, options, out)
            false -> dir_nonpositive(linux_process_query, options, out)
        }
    }

    state dir_take(linux_process_query: &mut LinuxProcessQuery, options: ProcessQueryOptions, out: &mut [ProcessInfo]) -> ProcessListOutcome {
