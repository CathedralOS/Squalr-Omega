module src::process_query::process_queryer;

use omega_language_std::filesystem_host;
use omega::language::core::service;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::processes::process_info::ProcessInfo;
use squalr_engine_targets::src::process_query::process_query_error::ProcessQueryError;
use squalr_engine_targets::src::process_query::process_query_options::ProcessQueryOptions;
use squalr_engine_targets::src::target_providers::OpenedProcessResult;
use squalr_engine_targets::src::target_providers::ProcessListOutcome;
use squalr_engine_targets::src::target_providers::ProcessQueryOutcome;
use src::process_query::linux::linux_process_query::LinuxProcessQuery;
use src::proc_paths::ProcName;

// Port of process_query/process_queryer.rs — the `ProcessQuery` facade that
// upstream routes through `ProcessQueryImpl` (the per-OS alias). Here the
// selected OS provider is a field: `data ProcessQuery { linux: LinuxProcessQuery }`
// is the compile-time routing. Where upstream's impls are statics, Omega
// providers carry the filesystem service (the /proc mechanism) as instance
// state, so the facade forwards on a `&mut` receiver.

pub data ProcessQuery {
    linux: LinuxProcessQuery;
}

pub linux_x86_64 machine ProcessQuery::open_process(
    &mut self,
    process_info: &ProcessInfo
) -> OpenedProcessResult
reaches FilesystemHost
invokes FilesystemHost;
{
    self.linux.open_process(process_info)
}

pub linux_x86_64 machine ProcessQuery::close_process(
    &mut self,
    handle: u64
) -> ProcessQueryOutcome
{
    self.linux.close_process(handle)
}

pub linux_x86_64 machine ProcessQuery::is_process_alive(
    &mut self,
    process_id: u32
) -> bool
reaches FilesystemHost
invokes FilesystemHost;
{
    self.linux.is_process_alive(process_id)
}

// Upstream facade forwards ProcessQueryImpl::start_monitoring/stop_monitoring
// verbatim; the Linux impl is the same unconditional Ok.
pub linux_x86_64 machine ProcessQuery::start_monitoring(
    &mut self,
    process_id: u32
) -> ProcessQueryOutcome
{
    self.linux.start_monitoring(process_id)
}

pub linux_x86_64 machine ProcessQuery::stop_monitoring(&mut self) -> ProcessQueryOutcome {
    self.linux.stop_monitoring()
}

pub linux_x86_64 machine ProcessQuery::get_processes(
    &mut self,
    options: ProcessQueryOptions,
    out: &mut [ProcessInfo]
) -> ProcessListOutcome
reaches FilesystemHost
invokes FilesystemHost;
{
    self.linux.get_processes(options, out)
}
