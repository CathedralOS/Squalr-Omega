use {omega}/language/core/filesystem_authority.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_api}/src/structures/processes/process_info.omg;
use {squalr_engine_targets}/src/process_query/process_query_error.omg;
use {squalr_engine_targets}/src/process_query/process_query_options.omg;
use {squalr_engine_targets}/src/target_providers.omg;
use src/process_query/linux/linux_process_query.omg;
use src/proc_paths.omg;

// Port of process_query/process_queryer.rs — the `ProcessQuery` facade that
// upstream routes through `ProcessQueryImpl` (the per-OS alias). Here the
// selected OS provider is a field: `data ProcessQuery { linux: LinuxProcessQuery }`
// is the compile-time routing. Where upstream's impls are statics, Omega
// providers carry the filesystem service (the /proc mechanism) as instance
// state, so the facade forwards on a `&mut` receiver.

public data ProcessQuery {
    linux: |linux_process_query|::LinuxProcessQuery;
}

public linux_x86_64 machine ProcessQuery::open_process(
    this: &mut ProcessQuery,
    process_info: &|process_info|::ProcessInfo
) -> |target_providers|::OpenedProcessResult
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let hoist1: |target_providers|::OpenedProcessResult = |linux_process_query|::LinuxProcessQuery::open_process(&mut this.linux, process_info);
    (hoist1)
}

public linux_x86_64 machine ProcessQuery::close_process(
    this: &mut ProcessQuery,
    handle: u64
) -> |target_providers|::ProcessQueryOutcome
{
    let hoist2: |target_providers|::ProcessQueryOutcome = |linux_process_query|::LinuxProcessQuery::close_process(&mut this.linux, handle);
    (hoist2)
}

public linux_x86_64 machine ProcessQuery::is_process_alive(
    this: &mut ProcessQuery,
    process_id: u32
) -> |target_providers|::ProcessAliveResult
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let hoist3: |target_providers|::ProcessAliveResult = |linux_process_query|::LinuxProcessQuery::is_process_alive(&mut this.linux, process_id);
    (hoist3)
}


// Upstream facade forwards ProcessQueryImpl::start_monitoring/stop_monitoring
// verbatim; the Linux impl is the same unconditional Ok.
public linux_x86_64 machine ProcessQuery::start_monitoring(
    this: &mut ProcessQuery,
    process_id: u32
) -> |target_providers|::ProcessQueryOutcome
{
    let hoist4: |target_providers|::ProcessQueryOutcome = |linux_process_query|::LinuxProcessQuery::start_monitoring(&mut this.linux, process_id);
    (hoist4)
}

public linux_x86_64 machine ProcessQuery::stop_monitoring(this: &mut ProcessQuery) -> |target_providers|::ProcessQueryOutcome {
    let hoist5: |target_providers|::ProcessQueryOutcome = |linux_process_query|::LinuxProcessQuery::stop_monitoring(&mut this.linux);
    (hoist5)
}

public linux_x86_64 machine ProcessQuery::get_processes(
    this: &mut ProcessQuery,
    options: |process_query_options|::ProcessQueryOptions,
    out: &mut [|process_info|::ProcessInfo]
) -> |target_providers|::ProcessListOutcome
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
crashes Trap
{
    let hoist6: |target_providers|::ProcessListOutcome = |linux_process_query|::LinuxProcessQuery::get_processes(&mut this.linux, options, &mut out);
    (hoist6)
}


