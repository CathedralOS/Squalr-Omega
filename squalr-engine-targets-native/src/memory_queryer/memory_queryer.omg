module src::memory_queryer::memory_queryer;

use omega_language_std::filesystem_host;
use omega::language::core::binding;
use squalr_engine_api::src::plugins::memory_view::page_retrieval_mode::PageRetrievalMode;
use squalr_engine_api::src::structures::memory::normalized_region;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_targets::src::target_providers::AddressWritable;
use squalr_engine_targets::src::target_providers::MemoryBoundsOpen;
use squalr_engine_targets::src::target_providers::MemoryBoundsStep;
use src::memory_queryer::linux::linux_memory_queryer::LinuxMemoryQueryer;
use src::memory_queryer::normalized_module::AddressModuleResult;
use src::memory_queryer::normalized_module::ModuleStreamStep;
use src::memory_queryer::normalized_module::NormalizedModule;
use src::memory_queryer::normalized_module::ResolvedModuleAddress;

// Port of memory_queryer/memory_queryer.rs — the MemoryQueryer facade whose
// upstream statics route to the OnceLock'd MemoryQueryerImpl. The impl is a
// field here (services ride through data).
//
// Upstream get_memory_page_bounds(mode) returns a materialized
// Vec<NormalizedRegion>; Omega expresses the identical stream as
// open_memory_page_bounds / next_memory_page_bounds / close_memory_bounds on
// the provider-owned enumeration — callers enumerate serially.
//
// Mode mapping is verbatim from upstream:
//   FromUserMode     -> (required empty, excluded empty, types NONE|PRIVATE|IMAGE,
//                        [0, max_usermode), Exclude)
//   FromSettings     -> the runtime QuerySettings filters; QuerySettings is
//                        unported, so this resolves to the upstream DEFAULT
//                        settings rows: required=WRITE (the empty-required
//                        fallback), excluded=empty, types=NONE|PRIVATE|IMAGE
//                        |MAPPED, [0, max_usermode), Exclude. Deviation is
//                        confined to settings-driven non-default filters.
//   FromModules      -> module base regions from get_modules (the module
//                        stream drained as regions).
//   FromNonModules   -> the usermode stream minus pages whose base is a
//                        module base address.
//   FromVirtualModules -> upstream returns an empty Vec; the stream
//                        equivalent is an enumeration whose first step is
//                        Finished.
// The module materialization itself rides the provider stream (open_modules
// / next_module) where upstream returns Vec<NormalizedModule>; resolve and
// address lookups re-derive it, matching upstream call order.
pub data MemoryQueryer {
    linux: LinuxMemoryQueryer;
}

pub linux_x86_64 machine MemoryQueryer::open_memory_page_bounds(
    this: &mut MemoryQueryer,
    process_info: &OpenedProcessInfo,
    mode_tag: u8
) -> MemoryBoundsOpen
reaches FilesystemHost
invokes FilesystemHost;
{
    transition { _ -> dispatch(this, mode_tag, process_info) }

    state dispatch(this: &mut MemoryQueryer, mode_tag: u8, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        transition mode_tag == 0 {
            true -> usermode(this, process_info)
            false -> dispatch_1(this, mode_tag, process_info)
        }
    }

    state dispatch_1(this: &mut MemoryQueryer, mode_tag: u8, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        transition mode_tag == 1 {
            true -> settings(this, process_info)
            false -> dispatch_2(this, mode_tag, process_info)
        }
    }

    state dispatch_2(this: &mut MemoryQueryer, mode_tag: u8, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        transition mode_tag == 2 {
            true -> modules(this, process_info)
            false -> dispatch_3(this, mode_tag, process_info)
        }
    }

    state dispatch_3(this: &mut MemoryQueryer, mode_tag: u8, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        transition mode_tag == 3 {
            true -> non_modules(this, process_info)
            false -> empty_stream(this)
        }
    }

    state usermode(this: &mut MemoryQueryer, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        let required_bits: u32 = 0;
        let excluded_bits: u32 = 0;
        let allowed_bits: u32 = 7;
        let maximum: u64 = LinuxMemoryQueryer::get_max_usermode_address(&this.linux, process_info);
        let hoist1: MemoryBoundsOpen = LinuxMemoryQueryer::open_virtual_pages(&mut this.linux, process_info,
            required_bits,
            excluded_bits,
            allowed_bits,
            0,
            maximum,
            0);
        (hoist1)
    }

    state settings(this: &mut MemoryQueryer, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        let required_bits: u32 = 2;
        let excluded_bits: u32 = 0;
        let allowed_bits: u32 = 15;
        let maximum: u64 = LinuxMemoryQueryer::get_max_usermode_address(&this.linux, process_info);
        let hoist2: MemoryBoundsOpen = LinuxMemoryQueryer::open_virtual_pages(&mut this.linux, process_info,
            required_bits,
            excluded_bits,
            allowed_bits,
            0,
            maximum,
            0);
        (hoist2)
    }

    state modules(this: &mut MemoryQueryer, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        let hoist3: MemoryBoundsOpen = LinuxMemoryQueryer::open_module_regions(&mut this.linux, process_info);
        (hoist3)
    }

    state non_modules(this: &mut MemoryQueryer, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        let hoist4: MemoryBoundsOpen = LinuxMemoryQueryer::open_nonmodule_pages(&mut this.linux, process_info);
        (hoist4)
    }

    state empty_stream(this: &mut MemoryQueryer) -> MemoryBoundsOpen {
        LinuxMemoryQueryer::open_suppressed(&mut this.linux);
        MemoryBoundsOpen::Opened
    }
}

pub linux_x86_64 machine MemoryQueryer::next_memory_page_bounds(
    this: &mut MemoryQueryer,
    region: &mut normalized_region::NormalizedRegion
) -> MemoryBoundsStep
reaches FilesystemHost
invokes FilesystemHost;
{
    let hoist5: MemoryBoundsStep = LinuxMemoryQueryer::next_virtual_page(&mut this.linux, &mut region);
    (hoist5)
}

pub linux_x86_64 machine MemoryQueryer::close_memory_page_bounds(
    this: &mut MemoryQueryer)
reaches FilesystemHost
invokes FilesystemHost;
{
    let hoist6: MemoryBoundsOpen = LinuxMemoryQueryer::close_enumeration(&mut this.linux);
    (hoist6)
}

pub linux_x86_64 machine MemoryQueryer::is_address_writable(
    this: &mut MemoryQueryer,
    process_info: &OpenedProcessInfo,
    address: u64
) -> AddressWritable
reaches FilesystemHost
invokes FilesystemHost;
{
    let hoist7: AddressWritable = LinuxMemoryQueryer::is_address_writable(&mut this.linux, process_info, address);
    (hoist7)
}

// Upstream's get_modules / resolve_module / resolve_module_address /
// address_to_module — Vec materialization becomes the provider stream;
// resolve/lookup calls re-derive the table, matching upstream's observable
// results (upstream takes the modules Vec by argument; the port owns it).
pub linux_x86_64 machine MemoryQueryer::open_modules(
    this: &mut MemoryQueryer,
    process_info: &OpenedProcessInfo
) -> MemoryBoundsOpen
reaches FilesystemHost
invokes FilesystemHost;
{
    let hoist8: MemoryBoundsOpen = LinuxMemoryQueryer::open_modules(&mut this.linux, process_info);
    (hoist8)
}

pub linux_x86_64 machine MemoryQueryer::next_module(
    this: &mut MemoryQueryer,
    module: &mut NormalizedModule
) -> ModuleStreamStep
{
    let hoist9: ModuleStreamStep = LinuxMemoryQueryer::next_module(&mut this.linux, &mut module);
    (hoist9)
}

pub linux_x86_64 machine MemoryQueryer::resolve_module(
    this: &mut MemoryQueryer,
    process_info: &OpenedProcessInfo,
    identifier: &[u8]
) -> u64
reaches FilesystemHost
invokes FilesystemHost;
{
    let hoist10: u64 = LinuxMemoryQueryer::resolve_module(&mut this.linux, process_info, identifier);
    (hoist10)
}

pub linux_x86_64 machine MemoryQueryer::resolve_module_address(
    this: &mut MemoryQueryer,
    process_info: &OpenedProcessInfo,
    identifier: &[u8],
    offset: u64
) -> ResolvedModuleAddress
reaches FilesystemHost
invokes FilesystemHost;
{
    let hoist11: ResolvedModuleAddress = LinuxMemoryQueryer::resolve_module_address(&mut this.linux, process_info, identifier, offset);
    (hoist11)
}

pub linux_x86_64 machine MemoryQueryer::address_to_module(
    this: &mut MemoryQueryer,
    process_info: &OpenedProcessInfo,
    address: u64,
    module: &mut NormalizedModule
) -> AddressModuleResult
reaches FilesystemHost
invokes FilesystemHost;
{
    let hoist12: AddressModuleResult = LinuxMemoryQueryer::address_to_module(&mut this.linux, process_info, address, &mut module);
    (hoist12)
}
