use {omega}/language/core/filesystem_authority.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/plugins/memory_view/page_retrieval_mode.omg;
use {squalr_engine_api}/src/structures/memory/normalized_region.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_targets}/src/target_providers.omg;
use src/memory_queryer/linux/linux_memory_queryer.omg;
use src/memory_queryer/normalized_module.omg;

// Port of memory_queryer/memory_queryer.rs — the MemoryQueryer facade whose
// upstream statics route to the OnceLock'd MemoryQueryerImpl. The impl is a
// field here (services ride through data).
//
// Upstream get_memory_page_bounds(mode) returns a materialized
// Vec<NormalizedRegion>; Omega expresses the identical stream as
// open_memory_page_bounds / next_memory_page_bounds / close_memory_bounds on
// the provider-owned enumeration — callers enumerate serially.
//
// Mode mapping is verbatim from upstream:
//   FromUserMode     -> (required empty, excluded empty, types NONE|PRIVATE|IMAGE,
//                        [0, max_usermode), Exclude)
//   FromSettings     -> the runtime QuerySettings filters; QuerySettings is
//                        unported, so this resolves to the upstream DEFAULT
//                        settings rows: required=WRITE (the empty-required
//                        fallback), excluded=empty, types=NONE|PRIVATE|IMAGE
//                        |MAPPED, [0, max_usermode), Exclude. Deviation is
//                        confined to settings-driven non-default filters.
//   FromModules      -> module base regions from get_modules (the module
//                        stream drained as regions).
//   FromNonModules   -> the usermode stream minus pages whose base is a
//                        module base address.
//   FromVirtualModules -> upstream returns an empty Vec; the stream
//                        equivalent is an enumeration whose first step is
//                        Finished.
// The module materialization itself rides the provider stream (open_modules
// / next_module) where upstream returns Vec<NormalizedModule>; resolve and
// address lookups re-derive it, matching upstream call order.
public data MemoryQueryer {
    linux: |linux_memory_queryer|::LinuxMemoryQueryer;
}

public linux_x86_64 machine MemoryQueryer::open_memory_page_bounds(
    this: &mut MemoryQueryer,
    process_info: &|opened_process_info|::OpenedProcessInfo,
    mode_tag: u8
) -> |target_providers|::MemoryBoundsOpen
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    transition { _ -> dispatch(this, mode_tag, process_info) }

    machine dispatch(this: &mut MemoryQueryer, mode_tag: u8, process_info: &|opened_process_info|::OpenedProcessInfo) -> |target_providers|::MemoryBoundsOpen {
        transition mode_tag == 0 {
            true -> usermode(this, process_info)
            false -> dispatch_1(this, mode_tag, process_info)
        }
    }

    machine dispatch_1(this: &mut MemoryQueryer, mode_tag: u8, process_info: &|opened_process_info|::OpenedProcessInfo) -> |target_providers|::MemoryBoundsOpen {
        transition mode_tag == 1 {
            true -> settings(this, process_info)
            false -> dispatch_2(this, mode_tag, process_info)
        }
    }

    machine dispatch_2(this: &mut MemoryQueryer, mode_tag: u8, process_info: &|opened_process_info|::OpenedProcessInfo) -> |target_providers|::MemoryBoundsOpen {
        transition mode_tag == 2 {
            true -> modules(this, process_info)
            false -> dispatch_3(this, mode_tag, process_info)
        }
    }

    machine dispatch_3(this: &mut MemoryQueryer, mode_tag: u8, process_info: &|opened_process_info|::OpenedProcessInfo) -> |target_providers|::MemoryBoundsOpen {
        transition mode_tag == 3 {
            true -> non_modules(this, process_info)
            false -> empty_stream(this)
        }
    }

    machine usermode(this: &mut MemoryQueryer, process_info: &|opened_process_info|::OpenedProcessInfo) -> |target_providers|::MemoryBoundsOpen {
        let required_bits: u32 = 0;
        let excluded_bits: u32 = 0;
        let allowed_bits: u32 = 7;
        let maximum: u64 = |linux_memory_queryer|::LinuxMemoryQueryer::get_max_usermode_address(&this.linux, process_info);
        let hoist1: |target_providers|::MemoryBoundsOpen = |linux_memory_queryer|::LinuxMemoryQueryer::open_virtual_pages(&mut this.linux, process_info,
            required_bits,
            excluded_bits,
            allowed_bits,
            0,
            maximum,
            0);
        (hoist1)
    }

    machine settings(this: &mut MemoryQueryer, process_info: &|opened_process_info|::OpenedProcessInfo) -> |target_providers|::MemoryBoundsOpen {
        let required_bits: u32 = 2;
        let excluded_bits: u32 = 0;
        let allowed_bits: u32 = 15;
        let maximum: u64 = |linux_memory_queryer|::LinuxMemoryQueryer::get_max_usermode_address(&this.linux, process_info);
        let hoist2: |target_providers|::MemoryBoundsOpen = |linux_memory_queryer|::LinuxMemoryQueryer::open_virtual_pages(&mut this.linux, process_info,
            required_bits,
            excluded_bits,
            allowed_bits,
            0,
            maximum,
            0);
        (hoist2)
    }

    machine modules(this: &mut MemoryQueryer, process_info: &|opened_process_info|::OpenedProcessInfo) -> |target_providers|::MemoryBoundsOpen {
        let hoist3: |target_providers|::MemoryBoundsOpen = |linux_memory_queryer|::LinuxMemoryQueryer::open_module_regions(&mut this.linux, process_info);
        (hoist3)
    }

    machine non_modules(this: &mut MemoryQueryer, process_info: &|opened_process_info|::OpenedProcessInfo) -> |target_providers|::MemoryBoundsOpen {
        let hoist4: |target_providers|::MemoryBoundsOpen = |linux_memory_queryer|::LinuxMemoryQueryer::open_nonmodule_pages(&mut this.linux, process_info);
        (hoist4)
    }

    machine empty_stream(this: &mut MemoryQueryer) -> |target_providers|::MemoryBoundsOpen {
        |linux_memory_queryer|::LinuxMemoryQueryer::open_suppressed(&mut this.linux);
        |target_providers|::MemoryBoundsOpen::Opened
    }
}

public linux_x86_64 machine MemoryQueryer::next_memory_page_bounds(
    this: &mut MemoryQueryer,
    region: &mut |normalized_region|::NormalizedRegion
) -> |target_providers|::MemoryBoundsStep
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let hoist5: |target_providers|::MemoryBoundsStep = |linux_memory_queryer|::LinuxMemoryQueryer::next_virtual_page(&mut this.linux, &mut region);
    (hoist5)
}

public linux_x86_64 machine MemoryQueryer::close_memory_page_bounds(
    this: &mut MemoryQueryer)
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    |linux_memory_queryer|::LinuxMemoryQueryer::close_enumeration(&mut this.linux);
}

public linux_x86_64 machine MemoryQueryer::is_address_writable(
    this: &mut MemoryQueryer,
    process_info: &|opened_process_info|::OpenedProcessInfo,
    address: u64
) -> |target_providers|::AddressWritable
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let hoist7: |target_providers|::AddressWritable = |linux_memory_queryer|::LinuxMemoryQueryer::is_address_writable(&mut this.linux, process_info, address);
    (hoist7)
}

// Upstream's get_modules / resolve_module / resolve_module_address /
// address_to_module — Vec materialization becomes the provider stream;
// resolve/lookup calls re-derive the table, matching upstream's observable
// results (upstream takes the modules Vec by argument; the port owns it).
public linux_x86_64 machine MemoryQueryer::open_modules(
    this: &mut MemoryQueryer,
    process_info: &|opened_process_info|::OpenedProcessInfo
) -> |target_providers|::MemoryBoundsOpen
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let hoist8: |target_providers|::MemoryBoundsOpen = |linux_memory_queryer|::LinuxMemoryQueryer::open_modules(&mut this.linux, process_info);
    (hoist8)
}

public linux_x86_64 machine MemoryQueryer::next_module(
    this: &mut MemoryQueryer,
    module: &mut |normalized_module|::NormalizedModule
) -> |normalized_module|::ModuleStreamStep
{
    let hoist9: |normalized_module|::ModuleStreamStep = |linux_memory_queryer|::LinuxMemoryQueryer::next_module(&mut this.linux, &mut module);
    (hoist9)
}

