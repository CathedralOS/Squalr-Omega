module src::memory_queryer::memory_protection_enum;

// Port of memory_queryer/memory_protection_enum.rs — a bitflags! bitfield.
// The third-party `bitflags` crate's role here is plain u32 bit ops, so it is
// routed to an ordinary data wrapper (per the port contract this is not a
// silently-dropped dependency).
pub data MemoryProtectionEnum [copy] {
    bits: u32;
}

pub machine MemoryProtectionEnum::empty() -> MemoryProtectionEnum {
    MemoryProtectionEnum { bits: 0 }
}

// Upstream bit constants: NONE=0x0 READ=0x1 WRITE=0x2 EXECUTE=0x4 COPY_ON_WRITE=0x8.
pub machine MemoryProtectionEnum::none() -> MemoryProtectionEnum {
    MemoryProtectionEnum { bits: 0 }
}

pub machine MemoryProtectionEnum::read() -> MemoryProtectionEnum {
    MemoryProtectionEnum { bits: 1 }
}

pub machine MemoryProtectionEnum::write() -> MemoryProtectionEnum {
    MemoryProtectionEnum { bits: 2 }
}

pub machine MemoryProtectionEnum::execute() -> MemoryProtectionEnum {
    MemoryProtectionEnum { bits: 4 }
}

pub machine MemoryProtectionEnum::copy_on_write() -> MemoryProtectionEnum {
    MemoryProtectionEnum { bits: 8 }
}

pub machine MemoryProtectionEnum::contains(&self, other: MemoryProtectionEnum) -> bool {
    (self.bits & other.bits) == other.bits
}

pub machine MemoryProtectionEnum::union(&self, other: MemoryProtectionEnum) -> MemoryProtectionEnum {
    MemoryProtectionEnum { bits: self.bits | other.bits }
}

pub machine MemoryProtectionEnum::bits(&self) -> u32 {
    self.bits
}

pub machine MemoryProtectionEnum::is_empty(&self) -> bool {
    self.bits == 0
}
