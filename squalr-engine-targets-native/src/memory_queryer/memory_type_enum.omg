module src::memory_queryer::memory_type_enum;

// Port of memory_queryer/memory_type_enum.rs — bitflags u32: NONE=0x1
// PRIVATE=0x2 IMAGE=0x4 MAPPED=0x8.
pub data MemoryTypeEnum [copy] {
    bits: u32;
}

pub machine MemoryTypeEnum::empty() -> MemoryTypeEnum {
    MemoryTypeEnum { bits: 0 }
}

pub machine MemoryTypeEnum::none() -> MemoryTypeEnum {
    MemoryTypeEnum { bits: 1 }
}

pub machine MemoryTypeEnum::private() -> MemoryTypeEnum {
    MemoryTypeEnum { bits: 2 }
}

pub machine MemoryTypeEnum::image() -> MemoryTypeEnum {
    MemoryTypeEnum { bits: 4 }
}

pub machine MemoryTypeEnum::mapped() -> MemoryTypeEnum {
    MemoryTypeEnum { bits: 8 }
}

pub machine MemoryTypeEnum::contains(&self, other: MemoryTypeEnum) -> bool {
    (self.bits & other.bits) == other.bits
}

pub machine MemoryTypeEnum::union(&self, other: MemoryTypeEnum) -> MemoryTypeEnum {
    MemoryTypeEnum { bits: self.bits | other.bits }
}

pub machine MemoryTypeEnum::bits(&self) -> u32 {
    self.bits
}

pub machine MemoryTypeEnum::is_empty(&self) -> bool {
    self.bits == 0
}
