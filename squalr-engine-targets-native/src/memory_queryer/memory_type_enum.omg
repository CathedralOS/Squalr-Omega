module src::memory_queryer::memory_type_enum;

// Port of memory_queryer/memory_type_enum.rs — bitflags u32: NONE=0x1
// PRIVATE=0x2 IMAGE=0x4 MAPPED=0x8.
public data MemoryTypeEnum [copy] {
    bits: u32;
}

public machine MemoryTypeEnum::empty() -> MemoryTypeEnum {
    MemoryTypeEnum { bits: 0 }
}

public machine MemoryTypeEnum::none() -> MemoryTypeEnum {
    MemoryTypeEnum { bits: 1 }
}

public machine MemoryTypeEnum::private() -> MemoryTypeEnum {
    MemoryTypeEnum { bits: 2 }
}

public machine MemoryTypeEnum::image() -> MemoryTypeEnum {
    MemoryTypeEnum { bits: 4 }
}

public machine MemoryTypeEnum::mapped() -> MemoryTypeEnum {
    MemoryTypeEnum { bits: 8 }
}

public machine MemoryTypeEnum::contains(this: &MemoryTypeEnum, other: MemoryTypeEnum) -> u64
ensures 0 <= result && result < 2;
{
    transition (this.bits & other.bits) == other.bits {
        true -> (1)
        false -> (0)
    }
}

public machine MemoryTypeEnum::union(this: &MemoryTypeEnum, other: MemoryTypeEnum) -> MemoryTypeEnum {
    MemoryTypeEnum { bits: this.bits | other.bits }
}

public machine MemoryTypeEnum::bits(this: &MemoryTypeEnum) -> u32 {
    this.bits
}

public machine MemoryTypeEnum::is_empty(this: &MemoryTypeEnum) -> u64
ensures 0 <= result && result < 2;
{
    transition this.bits == 0 {
        true -> (1)
        false -> (0)
    }
}
