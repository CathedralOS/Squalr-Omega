module src::memory_queryer::linux::linux_memory_queryer;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::memory::bitness::Bitness;
use squalr_engine_api::src::structures::memory::normalized_region;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_targets::src::target_providers::AddressWritable;
use squalr_engine_targets::src::target_providers::MemoryBoundsOpen;
use squalr_engine_targets::src::target_providers::MemoryBoundsStep;
use src::memory_queryer::memory_queryer_trait::MemoryQueryerTrait;
use src::memory_queryer::normalized_module::AddressModuleResult;
use src::memory_queryer::normalized_module::ModuleAddressDisplay;
use src::memory_queryer::normalized_module::ModuleStreamStep;
use src::memory_queryer::normalized_module::NormalizedModule;
use src::memory_queryer::normalized_module::ResolvedModuleAddress;
use src::proc_paths::ProcName;

// Port of memory_queryer/linux/linux_memory_queryer.rs, streaming.
// Upstream parses the whole of /proc/<pid>/maps into a Vec<NormalizedRegion>
// per call; Omega has no growable Vec, so the equivalent object is a
// provider-owned enumeration: open_virtual_pages stores the filter set,
// next_virtual_page yields one NormalizedRegion per maps line that passes the
// same filters (in the same ascending kernel order), and close_enumeration
// releases the descriptor. One enumeration is live per instance; upstream's
// Vec permits independent collections, so this is a recorded translation
// (callers enumerate serially — same contract PORTING.md demands).
//
// Line grammar (identical to upstream's split): "<hex>-<hex> <4 perms>
// <hex offset> <dev> <inode> [pathname]"; a line is a region when end > start.
// Permission bits match MemoryProtectionEnum: r=READ w=WRITE x=EXECUTE
// p=COPY_ON_WRITE. Type: empty pathname -> NONE; pathname + 'p' -> PRIVATE
// unless the path is absolute and 'x' set -> IMAGE; otherwise MAPPED.
pub data LinuxMemoryQueryer {

    // /proc dirfd + open maps fd + the rolling parse buffer.
    proc_fd: i32;
    maps_fd: i32;
    buffer: [u8; 4096];
    buffered: u64;
    io_buf: [u8; 4096];
    cursor: u64;
    at_eof: bool;

    // Filter set captured at open (upstream's get_virtual_pages args).
    required_bits: u32;
    excluded_bits: u32;
    allowed_bits: u32;
    range_start: u64;
    range_end: u64;
    bounds_handling: u8;
    suppress_all: bool;

    // Per-line parse registers.
    line_start: u64;
    line_end: u64;
    region_start: u64;
    region_end: u64;
    line_perms: u32;
    line_type: u32;
    tok_index: u64;
    pathname_len: u64;
    emit_base: u64;
    src_index: u64;
    emit_size: u64;
    scan_pos: u64;
    io_count: i64;
    scratch: i32;
    name: ProcName;
    // is_address_writable's private scan state.
    walk_region: normalized_region::NormalizedRegion;
    write_hit: bool;

    // Module aggregation — upstream's get_modules materializes a
    // Vec<NormalizedModule> in two passes over one parse of maps; with no
    // growable Vec the port keeps a bounded provider-owned table (512
    // entries, 32KiB deduplicated path slab) built by two sweeps of one open
    // maps fd: pass 1 collects the deduplicated executable+absolute path
    // set, seek(0) rewinds the same descriptor, pass 2 merges min(start) /
    // max(end) for every region whose normalized path is in the set. A maps
    // file mutating between sweeps can shift the merged bounds — recorded
    // translation (upstream's single snapshot cannot change mid-build).
    scan_kind: u8;          // 0 region lines, 1 module pass A, 2 module pass B
    mod_count: u64;
    mod_lo: [u64; 512];
    mod_hi: [u64; 512];
    mod_off: [u64; 512];
    mod_len: [u64; 512];
    mod_hash: [u64; 512];
    mod_paths: [u8; 32768];
    mod_paths_len: u64;
    mod_emit: u64;
    mod_mark: [u8; 512];
    mod_modules_out: bool;  // next_virtual_page emits module base.v regions
    non_modules: bool;      // emit filter: drop bases inside the module set
    canon: [u8; 4096];      // canonical (space-collapsed, (deleted)-stripped) path
    canon_len: u64;
    hash: u64;
    found_index: u64;
    sel_index: u64;
    id_lo: u64;
    id_hi: u64;
    byte_pos: u64;
    ident_lo: u64;
    ident_hi: u64;
    have_sel: bool;
    space_run: bool;
    k_index: u64;
    cmp_i: u64;
    cmp_j: u64;
    byte: u8;
    peer_byte: u8;
}

pub linux_x86_64 machine LinuxMemoryQueryer::open_virtual_pages(
    this: &mut LinuxMemoryQueryer,
    process_info: &OpenedProcessInfo,
    required_bits: u32,
    excluded_bits: u32,
    allowed_bits: u32,
    start_address: u64,
    end_address: u64,
    bounds_tag: u8
) -> MemoryBoundsOpen
satisfies MemoryQueryerTrait<LinuxMemoryQueryer>::open_virtual_pages
reaches FilesystemHost
invokes FilesystemHost;
{
    this.required_bits = required_bits;
    this.excluded_bits = excluded_bits;
    this.allowed_bits = allowed_bits;
    this.range_start = start_address;
    this.range_end = end_address;
    this.bounds_handling = bounds_tag;
    this.buffered = 0;
    this.cursor = 0;
    this.at_eof = false;
    this.suppress_all = false;
    this.maps_fd = -1;
    this.scan_kind = 0;
    this.mod_modules_out = false;
    this.non_modules = false;
    transition start_address >= end_address {
        true -> empty_open(this)
        false -> open_proc(this, process_info)
    }

    state open_proc(this: &mut LinuxMemoryQueryer, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        let _proc_fd_r: i32 = FilesystemHost::open("/proc", 65536);
        this.proc_fd = _proc_fd_r;
        transition _proc_fd_r >= 0 {
            true -> open_maps(this, process_info)
            false -> fail(this)
        }
    }

    state open_maps(this: &mut LinuxMemoryQueryer, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        let pid: u32 = OpenedProcessInfo::get_process_id_raw(&process_info);
        this.name = ProcName::for_process(pid, 109, 97, 112, 115, 4);
        transition this.name.len <= 48 {
            true -> open_maps_at(this, process_info, this.name.len)
            false -> open_maps_at(this, process_info, 48)
        }
    }

    state open_maps_at(this: &mut LinuxMemoryQueryer, process_info: &OpenedProcessInfo, name_len: u64) -> MemoryBoundsOpen {
        let procfd: i32 = this.proc_fd;
        let _maps_fd_r: i32 = FilesystemHost::open_at(procfd, this.name.bytes[0..48], 0);
        this.maps_fd = _maps_fd_r;
        let _u1: i32 = FilesystemHost::close(this.proc_fd);
        this.scratch = _u1;
        transition _maps_fd_r >= 0 {
            true -> opened(this)
            false -> fail(this)
        }
    }

    state opened(this: &mut LinuxMemoryQueryer) -> MemoryBoundsOpen {
        MemoryBoundsOpen::Opened
    }

    // start >= end: upstream returns an empty Vec — an enumeration whose
    // first step is Finished.
    state empty_open(this: &mut LinuxMemoryQueryer) -> MemoryBoundsOpen {
        MemoryBoundsOpen::Opened
    }

    state fail(this: &mut LinuxMemoryQueryer) -> MemoryBoundsOpen {
        MemoryBoundsOpen::Failed
    }
}

// FromVirtualModules' empty Vec and any other deliberately-empty stream.
pub linux_x86_64 machine LinuxMemoryQueryer::open_suppressed(this: &mut LinuxMemoryQueryer) {
    this.maps_fd = -1;
    this.suppress_all = true;
    this.scan_kind = 0;
    this.mod_modules_out = false;
    this.non_modules = false;
}

pub linux_x86_64 machine LinuxMemoryQueryer::close_enumeration(
    this: &mut LinuxMemoryQueryer)
satisfies MemoryQueryerTrait<LinuxMemoryQueryer>::close_enumeration
reaches FilesystemHost
invokes FilesystemHost;
{
    transition { _ -> top(this) }

    state top(this: &mut LinuxMemoryQueryer) {
        transition this.maps_fd >= 0 {
            true -> close_it(this)
            _ -> noop(this)
        }
    }

    state close_it(this: &mut LinuxMemoryQueryer) {
        let _u2: i32 = FilesystemHost::close(this.maps_fd);
        this.scratch = _u2;
        this.maps_fd = -1;
        transition { _ -> noop(this) }
    }
    state noop(this: &mut LinuxMemoryQueryer) {
    }
}

pub linux_x86_64 machine LinuxMemoryQueryer::next_virtual_page(
    this: &mut LinuxMemoryQueryer,
    region: &mut normalized_region::NormalizedRegion
) -> MemoryBoundsStep
satisfies MemoryQueryerTrait<LinuxMemoryQueryer>::next_virtual_page
reaches FilesystemHost
invokes FilesystemHost;
{
    transition { _ -> top(this, region) }

    state top(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition this.mod_modules_out {
            true -> module_emit(this, region)
            _ -> entry_guard(this, region)
        }
    }

    // FromModules: the module table drains as NormalizedRegion rows —
    // upstream's get_modules().into_iter().map(into_base_region).
    state module_emit(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let hoist1: MemoryBoundsStep = LinuxMemoryQueryer::next_module_region(&mut this, &mut region);
        (hoist1)
    }

    state entry_guard(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition this.suppress_all || this.maps_fd < 0 {
            true -> finished(this, region)
            false -> ensure_line(this, region)
        }
    }

    state finished(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        MemoryBoundsStep::Finished
    }

    state failed(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        LinuxMemoryQueryer::close_enumeration(&mut this);
        MemoryBoundsStep::Failed
    }

    // Ensure buffer[cursor:] holds a full line (or is at EOF with a tail).
    state ensure_line(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition this.at_eof {
            true -> eof_tail(this, region)
            false -> scan_newline(this, region)
        }
    }

    state eof_tail(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition this.cursor < this.buffered {
            true -> emit_line(this, region)
            false -> finish_close(this, region)
        }
    }

    // Module pass A reaches EOF inside the same call: rewind the open
    // descriptor and run pass B (upstream's second pass over its parsed
    // Vec). Any other enumeration mode closes as before.
    state finish_close(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition this.scan_kind == 1 {
            true -> rewind_pass_b(this, region)
            false -> finish_close_do(this, region)
        }
    }

    state rewind_pass_b(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let mapsfd: i32 = this.maps_fd;
        let procfd: i32 = FilesystemHost::open("/proc", 65536);
        let newfd: i32 = FilesystemHost::open_at(procfd, this.name.bytes[0..48], 0);
        let c1: i32 = FilesystemHost::close(mapsfd);
        let c2: i32 = FilesystemHost::close(procfd);
        transition newfd >= 0 {
            true -> rewind_store(this, region, newfd)
            false -> failed(this, region)
        }
    }

    state rewind_store(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion, newfd: i32) -> MemoryBoundsStep {
        this.maps_fd = newfd;
        transition { _ -> pass_b_reset(this, region) }
    }

    state pass_b_reset(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.scan_kind = 2;
        this.buffered = 0;
        this.cursor = 0;
        this.at_eof = false;
        transition { _ -> ensure_line(this, region) }
    }

    state finish_close_do(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        LinuxMemoryQueryer::close_enumeration(&mut this);
        transition { _ -> finished(this, region) }
    }

    state scan_newline(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.scan_pos = this.cursor;
        transition { _ -> scan_step(this, region) }
    }

    state scan_step(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition this.scan_pos < this.buffered {
            true -> scan_byte(this, region)
            false -> need_fill(this, region)
        }
    }

    state scan_byte(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u3: U8Result = LinuxMemoryQueryer::buf_byte_at(&mut this, this.scan_pos);
        transition _u3.v == 10 {
            true -> have_line(this, region)
            false -> scan_advance(this, region)
        }
    }

    state scan_advance(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.scan_pos = ((this.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> scan_step(this, region) }
    }

    state have_line(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.line_start = this.cursor;
        this.line_end = this.scan_pos;
        transition { _ -> parse_line(this, region) }
    }

    // No newline in the window: compact the tail to the front, refill, or
    // fail if a single line exceeds the buffer.
    state need_fill(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition this.cursor > 0 {
            true -> compact(this, region)
            false -> grow_or_fail(this, region)
        }
    }

    state compact(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.tok_index = 0;
        transition { _ -> compact_step(this, region) }
    }

    state compact_step(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let consumed: u64 =
            ((this.cursor as u64 in Saturating) + (this.tok_index as u64 in Saturating)) as u64;
        transition consumed < this.buffered {
            true -> compact_byte(this, region)
            false -> compact_done(this, region)
        }
    }

    state compact_byte(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.src_index = ((this.cursor as u64 in Wrapping) + (this.tok_index as u64 in Wrapping)) as u64;
        transition this.tok_index < 4096 {
            true -> compact_src(this, region)
            false -> failed(this, region)
        }
    }

    state compact_src(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition this.src_index < 4096 {
            true -> compact_move(this, region)
            false -> failed(this, region)
        }
    }

    state compact_move(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let moved_byte: U8Result = LinuxMemoryQueryer::buf_byte_at(&mut this, this.src_index);
        let moved_byte_v: u8 = moved_byte.v;
        LinuxMemoryQueryer::buf_put(&mut this, this.tok_index, moved_byte_v);
        this.tok_index = ((this.tok_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> compact_step(this, region) }
    }

    state compact_done(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.buffered = this.tok_index;
        this.cursor = 0;
        transition { _ -> refill(this, region) }
    }

    state grow_or_fail(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition this.buffered < 4096 {
            true -> refill(this, region)
            false -> failed(this, region)
        }
    }

    state refill(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition this.buffered <= 4096 {
            true -> refill_do(this, region)
            false -> failed(this, region)
        }
    }

    state refill_do(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let mapsfd: i32 = this.maps_fd;
        let want: u64 = (((4096 as u64 in Wrapping) - (this.buffered as u64 in Wrapping)) as u64);
        let got: i64 = FilesystemHost::read(mapsfd, &mut this.io_buf, want);
        this.io_count = got;
        transition got > 0 && this.buffered < 4096 {
            true -> refill_copy(this, region, this.buffered, 0)
            false -> empty_or_eof(this, region)
        }
    }

    state refill_copy(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion, dst: u64, src: u64) -> MemoryBoundsStep
    requires 0 <= dst && dst < 4096 && 0 <= src && src < 4096;
    {
        transition ((src as i64 in Wrapping) as i64) < this.io_count {
            true -> refill_byte(this, region, dst, src)
            false -> refilled(this, region)
        }
    }

    state refill_byte(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion, dst: u64, src: u64) -> MemoryBoundsStep
    requires 0 <= dst && dst < 4096 && 0 <= src && src < 4096;
    {
        this.buffer[dst] = this.io_buf[src];
        transition dst < 4095 && src < 4095 {
            true -> refill_copy(this, region, dst + 1, src + 1)
            false -> refilled(this, region)
        }
    }

    state refilled(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.buffered = ((this.buffered as u64 in Wrapping) + (this.io_count as u64 in Wrapping)) as u64;
        transition { _ -> scan_newline(this, region) }
    }

    state empty_or_eof(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition this.io_count == 0 {
            true -> mark_eof(this, region)
            false -> failed(this, region)
        }
    }

    state mark_eof(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.at_eof = true;
        transition this.cursor < this.buffered {
            true -> emit_line(this, region)
            false -> finish_close(this, region)
        }
    }

    state emit_line(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        // Tail line without a trailing newline.
        this.line_start = this.cursor;
        this.line_end = this.buffered;
        transition { _ -> parse_line(this, region) }
    }

    // <hex>-<hex> <4 perms> then skip 3 whitespace-separated tokens, then the
    // optional pathname — identical fields to upstream's split_whitespace.
    state parse_line(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.scan_pos = this.line_start;
        this.region_start = 0;
        this.region_end = 0;
        this.line_perms = 0;
        this.line_type = 0;
        this.pathname_len = 0;
        transition { _ -> hex_start(this, region) }
    }

    state hex_start(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u4: U8Result = LinuxMemoryQueryer::hex_digit_at(&mut this, this.scan_pos);
        transition _u4.v != 16 {
            true -> hex_start_step(this, region)
            false -> consume_line(this, region)
        }
    }

    state hex_start_step(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u5: U8Result = LinuxMemoryQueryer::hex_digit_at(&mut this, this.scan_pos);
        transition _u5.v != 16 {
            true -> hex_start_take(this, region)
            false -> dash_or_fail(this, region)
        }
    }

    state hex_start_take(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u6: U8Result = LinuxMemoryQueryer::hex_digit_at(&mut this, this.scan_pos);
        this.region_start = ((((this.region_start as u64 in Wrapping) * (16 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (_u6.v as u64 in Wrapping)) as u64;
        this.scan_pos = ((this.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_start_step(this, region) }
    }

    state dash_or_fail(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u7: U8Result = LinuxMemoryQueryer::buf_byte_at(&mut this, this.scan_pos);
        transition _u7.v == 45 {
            true -> start_end_hex(this, region)
            false -> consume_line(this, region)
        }
    }

    state start_end_hex(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.scan_pos = ((this.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_end_step(this, region) }
    }

    state hex_end_step(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u8: U8Result = LinuxMemoryQueryer::hex_digit_at(&mut this, this.scan_pos);
        transition _u8.v != 16 {
            true -> hex_end_take(this, region)
            false -> space_then_perms(this, region)
        }
    }

    state hex_end_take(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u9: U8Result = LinuxMemoryQueryer::hex_digit_at(&mut this, this.scan_pos);
        this.region_end = ((((this.region_end as u64 in Wrapping) * (16 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (_u9.v as u64 in Wrapping)) as u64;
        this.scan_pos = ((this.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_end_step(this, region) }
    }

    // Upstream keeps the line only when end > start.
    state space_then_perms(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition this.region_end > this.region_start {
            true -> skip_space(this, region)
            false -> consume_line(this, region)
        }
    }

    state skip_space(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u10: U8Result = LinuxMemoryQueryer::buf_byte_at(&mut this, this.scan_pos);
        transition _u10.v == 32 && this.scan_pos < this.line_end {
            true -> skip_space_step(this, region)
            false -> read_perms(this, region)
        }
    }

    state skip_space_step(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.scan_pos = ((this.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> skip_space(this, region) }
    }

    state read_perms(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        // r w x p are at scan_pos..scan_pos+4 in maps; '-' is 45.
        this.line_perms = 0;
        transition { _ -> perm_r(this, region) }
    }

    state perm_r(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u11: U8Result = LinuxMemoryQueryer::buf_byte_at(&mut this, this.scan_pos);
        transition _u11.v == 114 {
            true -> perm_r_set(this, region)
            false -> perm_w(this, region)
        }
    }

    state perm_r_set(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.line_perms = this.line_perms | 1;
        transition { _ -> perm_w(this, region) }
    }

    state perm_w(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u12: U8Result = LinuxMemoryQueryer::buf_byte_at(&mut this, ((this.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64);
        transition _u12.v == 119 {
            true -> perm_w_set(this, region)
            false -> perm_x(this, region)
        }
    }

    state perm_w_set(this: &mut LinuxMemoryQueryer, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        this.line_perms = this.line_perms | 2;
        transition { _ -> perm_x(this, region) }
    }

