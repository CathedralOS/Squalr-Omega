// Element read on a caller-bounded slice param — the requires clause
// discharges the slice index; the caller proves position < s.len.
machine LinuxMemoryQueryer::byte_at(&mut self, s: &[u8], position: u64) -> U8Result
requires
    position < s.len;
{
    s[position] as u64
}
