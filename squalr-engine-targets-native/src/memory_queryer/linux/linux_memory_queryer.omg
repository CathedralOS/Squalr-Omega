// cursor := line_end + 1 (past the newline) — or EOF-tail, which empties the
// window so the next ensure_line hits finish_close.
machine LinuxMemoryQueryer::consume_line_position(this: &mut LinuxMemoryQueryer) {
    transition this.line_end < this.buffered {
        true -> step_past(this)
        false -> drain(this)
    }
    state step_past(this: &mut LinuxMemoryQueryer) {
        this.cursor = ((this.line_end as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> noop(this) }
    }
    state drain(this: &mut LinuxMemoryQueryer) {
        this.cursor = this.buffered;
        transition { _ -> noop(this) }
    }
    state noop(this: &mut LinuxMemoryQueryer) {
    }
}


// Guarded buffer access: all positions are proof-checked against the fixed
// window before indexing. Out-of-window reads yield 0 (a byte that never
// matches a maps-field classifier) and writes are dropped — unreachable on a
// well-formed line because callers bound positions by line_end <= buffered.
// Structural machines may not return plain primitives (result signature
// rejects unrestricted scalar results), so table reads answer through this
// Linear wrapper and callers read `.v`.
pub data U64Result { v: u64 }
pub data U8Result { v: u8 }
pub data U32Result { v: u32 }
pub data BoolResult { v: bool }

machine LinuxMemoryQueryer::buf_byte_at(this: &mut LinuxMemoryQueryer, position: u64) -> U8Result {
    transition position < 4096 {
        true -> buf_get(this, position)
        false -> buf_miss(this)
    }
    state buf_get(this: &mut LinuxMemoryQueryer, position: u64) -> U8Result { U8Result { v: this.buffer[position] } }
    state buf_miss(this: &mut LinuxMemoryQueryer) -> U8Result { U8Result { v: 0 } }
}


// 16 when the byte isn't a hex digit or is out of window bounds.
machine LinuxMemoryQueryer::hex_digit_at(this: &mut LinuxMemoryQueryer, position: u64) -> U8Result {
    transition position >= this.line_end || position >= 4096 {
        true -> out(this)
        false -> check(this, position)
    }
    state out(this: &mut LinuxMemoryQueryer) -> U8Result { U8Result { v: 16 } }
    // Hex nibble lookup: literal cases instead of ASCII subtraction — a
    // checked `u64 [0..17]` result cannot carry the byte's proven range into
    // an exact-arithmetic terminal, so the table makes each case's value
    // explicit (and the out-of-class arm -> 16, the upstream error nibble).
    state check(this: &mut LinuxMemoryQueryer, position: u64) -> U8Result {
        let _b: u8 = this.buffer[position];
        transition _b {
            48 -> (U8Result { v: 0 })
            49 -> (U8Result { v: 1 })
            50 -> (U8Result { v: 2 })
            51 -> (U8Result { v: 3 })
            52 -> (U8Result { v: 4 })
            53 -> (U8Result { v: 5 })
            54 -> (U8Result { v: 6 })
            55 -> (U8Result { v: 7 })
            56 -> (U8Result { v: 8 })
            57 -> (U8Result { v: 9 })
            97 -> (U8Result { v: 10 })
            98 -> (U8Result { v: 11 })
            99 -> (U8Result { v: 12 })
            100 -> (U8Result { v: 13 })
            101 -> (U8Result { v: 14 })
            102 -> (U8Result { v: 15 })
            65 -> (U8Result { v: 10 })
            66 -> (U8Result { v: 11 })
            67 -> (U8Result { v: 12 })
            68 -> (U8Result { v: 13 })
            69 -> (U8Result { v: 14 })
            70 -> (U8Result { v: 15 })
            _ -> (U8Result { v: 16 })
        }
    }
}

// get_all_virtual_pages -> the unfiltered stream upstream's get_virtual_pages
// produces when all bits pass: empty protection sets, all types, [0, max).
pub linux_x86_64 machine LinuxMemoryQueryer::get_all_virtual_pages(
    this: &mut LinuxMemoryQueryer,
    process_info: &OpenedProcessInfo
) -> MemoryBoundsOpen
satisfies MemoryQueryerTrait<LinuxMemoryQueryer>::get_all_virtual_pages
reaches FilesystemHost
invokes FilesystemHost;
{
    transition { _ -> start(this, process_info) }

    state start(this: &mut LinuxMemoryQueryer, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        let req_bits: u32 = 0;
        let exc_bits: u32 = 0;
        let alw_bits: u32 = 15;
        let maximum: u64 = LinuxMemoryQueryer::get_maximum_address(&this, process_info);
        let hoist2: MemoryBoundsOpen = LinuxMemoryQueryer::open_virtual_pages(&mut this, process_info,
            req_bits,
            exc_bits,
            alw_bits,
            0,
            maximum,
            0);
        (hoist2)
    }
}

pub linux_x86_64 machine LinuxMemoryQueryer::is_address_writable(
    this: &mut LinuxMemoryQueryer,
    process_info: &OpenedProcessInfo,
    address: u64
) -> AddressWritable
satisfies MemoryQueryerTrait<LinuxMemoryQueryer>::is_address_writable
reaches FilesystemHost
invokes FilesystemHost;
{
    // Upstream: `any()` over a freshly parsed maps Vec — a containing region
    // with WRITE. Same predicate here via a private WRITE-required
    // enumeration; first containing hit wins. This reuses the provider's
    // single parse state — no other enumeration may be live during the call.
    transition { _ -> start(this, process_info, address) }

    state start(this: &mut LinuxMemoryQueryer, process_info: &OpenedProcessInfo, address: u64) -> AddressWritable {
        let maximum: u64 = LinuxMemoryQueryer::get_maximum_address(&this, process_info);
        let req_bits: u32 = 2;
        let exc_bits: u32 = 0;
        let alw_bits: u32 = 15;
        let open: MemoryBoundsOpen = LinuxMemoryQueryer::open_virtual_pages(&mut this, process_info,
            req_bits,
            exc_bits,
            alw_bits,
            0,
            maximum,
            0);
        let open_ok: bool = MemoryBoundsOpen::is_opened(&open);
        transition open_ok {
            true -> begin(this, address)
            _ -> done(this)
        }
    }

    state begin(this: &mut LinuxMemoryQueryer, address: u64) -> AddressWritable {
        this.write_hit = false;
        transition { _ -> pull(this, address) }
    }

    state pull(this: &mut LinuxMemoryQueryer, address: u64) -> AddressWritable {
        set_base_address(this.walk_region, 0);
        set_region_size(this.walk_region, 0);
        let step: MemoryBoundsStep = LinuxMemoryQueryer::next_virtual_page(&mut this, &mut this.walk_region);
        let step_is_region: bool = MemoryBoundsStep::is_region(&step);
        transition step_is_region {
            true -> check(this, address)
            _ -> finish(this)
        }
    }

    state check(this: &mut LinuxMemoryQueryer, address: u64) -> AddressWritable {
        let _w_base: u64 = get_base_address(this.walk_region);
        let _w_size: u64 = get_region_size(this.walk_region);
        let _w_end: u64 = ((_w_base as u64 in Saturating) + (_w_size as u64 in Saturating)) as u64;
        transition _w_base <= address && address < _w_end {
            true -> hit(this)
            false -> pull(this, address)
        }
    }

    state hit(this: &mut LinuxMemoryQueryer) -> AddressWritable {
        LinuxMemoryQueryer::close_enumeration(&mut this);
        transition { _ -> yielded(this) }
    }

    state yielded(this: &mut LinuxMemoryQueryer) -> AddressWritable {
        AddressWritable::Writable
    }

    state finish(this: &mut LinuxMemoryQueryer) -> AddressWritable {
        transition { _ -> done(this) }
    }

    state done(this: &mut LinuxMemoryQueryer) -> AddressWritable {
        AddressWritable::NotWritable
    }
}

pub linux_x86_64 machine LinuxMemoryQueryer::get_maximum_address(
    this: &LinuxMemoryQueryer,
    process_info: &OpenedProcessInfo
) -> u64
satisfies MemoryQueryerTrait<LinuxMemoryQueryer>::get_maximum_address
{
