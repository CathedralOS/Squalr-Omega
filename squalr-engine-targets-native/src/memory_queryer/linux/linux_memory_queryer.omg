    }

    state type_private(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_type = 2;
        transition { _ -> apply_filters(region) }
    }

    state type_mapped(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_type = 8;
        transition { _ -> apply_filters(region) }
    }

    // Upstream's matches_protection_filters + matches_type_filters, exactly:
    // READ is unconditionally required; a non-empty required set needs any
    // overlap ((perms & required) != 0); a non-empty excluded set needs no
    // overlap; an empty allowed-type set admits every type.
    state apply_filters(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition (self.line_perms & 1) != 0 && (self.required_bits == 0 || (self.line_perms & self.required_bits) != 0) && (self.excluded_bits == 0 || (self.line_perms & self.excluded_bits) == 0) && (self.allowed_bits == 0 || (self.line_type & self.allowed_bits) != 0) {
            true -> filter_bounds(region)
