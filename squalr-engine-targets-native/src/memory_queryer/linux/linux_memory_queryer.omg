machine LinuxMemoryQueryer::buf_put(&mut self, position: u64, byte: u8) {
    transition position < 4096 {
        true -> put(position, byte)
        false -> skip()
    }
    state put(&mut self, position: u64, byte: u8) { self.buffer[position] = byte; }
    state skip(&mut self) {
    }
