    }

    state mod_a_store(&mut self, region: &mut normalized_region::NormalizedRegion, m: u64 [0..512]) -> MemoryBoundsStep {
        self.mod_off[m] = self.mod_paths_len;
        self.mod_len[m] = self.canon_len;
        self.mod_hash[m] = self.hash;
        self.mod_lo[m] = 18446744073709551615;
        self.mod_hi[m] = 0;
        self.mod_mark[m] = 0;
        self.k_index = 0;
        transition { _ -> mod_slab(region) }
    }

    state mod_slab(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.k_index < self.canon_len {
            true -> mod_slab_byte(region)
            false -> mod_slab_done(region)
        }
    }

    state mod_slab_byte(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let ki: u64 = self.k_index;
        let c: U8Result = self.canon_at(ki);
        self.mod_path_set(((self.mod_paths_len as u64 in Wrapping) + (ki as u64 in Wrapping)) as u64, c.v);
        self.k_index = ((self.k_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> mod_slab(region) }
    }

    state mod_slab_done(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.mod_paths_len = ((self.mod_paths_len as u64 in Wrapping) + (self.canon_len as u64 in Wrapping)) as u64;
        self.mod_count = ((self.mod_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> consume_line(region) }
    }

    // Pass B: upstream merges min(start) / max(end) for every region whose
    // normalized pathname is in the collected set — any permissions.
    state mod_pass_b(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.canon_path();
        transition self.canon_len > 0 {
            true -> mod_b_find(region)
            false -> consume_line(region)
        }
    }

    state mod_b_find(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.hash_path();
        let _u20: BoolResult = self.table_find();
        transition _u20.v {
            true -> mod_b_merge(region)
            false -> consume_line(region)
        }
    }

    state mod_b_merge(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u21: U64Result = self.mod_lo_at(self.found_index);
        transition self.region_start < _u21.v {
            true -> mod_b_lo(region)
            false -> mod_b_hi(region)
        }
    }

    state mod_b_lo(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.mod_lo_put(self.found_index, self.region_start);
        transition { _ -> mod_b_hi(region) }
    }

    state mod_b_hi(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u22: U64Result = self.mod_hi_at(self.found_index);
        transition self.region_end > _u22.v {
            true -> mod_b_hi_set(region)
            false -> consume_line(region)
        }
    }

    state mod_b_hi_set(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.mod_hi_put(self.found_index, self.region_end);
        transition { _ -> consume_line(region) }
    }

    state type_none(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_type = 1;
        transition { _ -> apply_filters(region) }
    }

    // 'p' + non-absolute -> PRIVATE; absolute path + 'x' -> IMAGE; else MAPPED.
    // Absolute => first pathname byte '/'; upstream: is_image checks
    // pathname + executable bit; shared object guard '.so' is not in this
    // maps-line view (upstream uses the same perms/path rule in this file).
    state type_from_perms(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let _u23: U8Result = self.buf_byte_at(self.scan_pos);
        transition (self.line_perms & 4) != 0 && _u23.v == 47 {
            true -> type_image(region)
            false -> type_private_or_mapped(region)
        }
    }

    state type_image(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_type = 4;
        transition { _ -> apply_filters(region) }
    }

    state type_private_or_mapped(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition (self.line_perms & 8) != 0 {
            true -> type_private(region)
            false -> type_mapped(region)
