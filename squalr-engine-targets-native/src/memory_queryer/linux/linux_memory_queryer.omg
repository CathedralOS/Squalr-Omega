    // Pass A: upstream is_module_region — executable bit (perms[2] == 'x')
    // && absolute pathname. The canonicalized path is the dedupe key.
    state mod_pass_a(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition (self.line_perms & 4) != 0 {
            true -> mod_a_canon(region)
            false -> consume_line(region)
        }
    }

    state mod_a_canon(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.canon_path();
        let _u18: U8Result = self.canon_at(0);
        transition self.canon_len > 0 && _u18.v == 47 {
            true -> mod_a_insert(region)
            false -> consume_line(region)
        }
    }

    state mod_a_insert(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.hash_path();
        let _u19: BoolResult = self.table_find();
        transition _u19.v {
            true -> consume_line(region)
            false -> mod_a_room(region)
        }
    }

    // Bounded-table overflow is a named failure — a silently partial path
    // set would produce a silently partial module list.
    state mod_a_room(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let m: u64 = self.mod_count;
        transition m < 512 && ((self.mod_paths_len as u64 in Wrapping) + (self.canon_len as u64 in Wrapping)) as u64 <= 32768 {
            true -> mod_a_store(region, m)
            _ -> failed(region)
