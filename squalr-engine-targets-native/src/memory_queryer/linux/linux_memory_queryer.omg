    state filter_bounds(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.region_end <= self.range_start || self.region_start >= self.range_end {
            true -> consume_line(region)
            false -> apply_bounds_handling(region)
        }
    }

    state apply_bounds_handling(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
