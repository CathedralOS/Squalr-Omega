    state hit(&mut self) -> u64 {
        let _r: U64Result = self.mod_lo_at(self.sel_index);
        _r.v
    }

    state miss(&mut self) -> u64 {
        0
    }
}

// Case-insensitive compare: the selected module's basename (id_lo..id_hi in
// the slab) against identifier[ident_lo..ident_hi].
machine LinuxMemoryQueryer::name_eq(&mut self, identifier: &[u8]) -> BoolResult {
    transition ((self.id_hi as u64 in Wrapping) - (self.id_lo as u64 in Wrapping)) as u64 == ((self.ident_hi as u64 in Wrapping) - (self.ident_lo as u64 in Wrapping)) as u64 {
        true -> begin(identifier)
        false -> miss()
    }

    state begin(&mut self, identifier: &[u8]) -> BoolResult {
        self.cmp_i = 0;
        transition { _ -> scan(identifier) }
    }

    state scan(&mut self, identifier: &[u8]) -> BoolResult {
        transition (((self.id_lo as u64 in Wrapping) + (self.cmp_i as u64 in Wrapping)) as u64) < self.id_hi {
            true -> byte_cmp(identifier)
            false -> hit()
        }
    }

    state byte_cmp(&mut self, identifier: &[u8]) -> BoolResult {
        self.byte_pos = ((self.ident_lo as u64 in Wrapping) + (self.cmp_i as u64 in Wrapping)) as u64;
        let _u62: U8Result = self.mod_path_at(((self.id_lo as u64 in Wrapping) + (self.cmp_i as u64 in Wrapping)) as u64);
        self.byte = _u62.v;
        let _u63: U8Result = self.lower_fold(self.byte);
        self.byte = _u63.v;
        transition self.byte_pos < identifier.len {
            true -> ident_cmp(identifier)
            false -> miss()
        }
    }

    state ident_cmp(&mut self, identifier: &[u8]) -> BoolResult {
        let _peer_byte_r: U8Result = self.byte_at(identifier, self.byte_pos);
        self.peer_byte = _peer_byte_r.v;
        let _u64: U8Result = self.lower_fold(self.peer_byte);
        self.peer_byte = _u64.v;
        transition self.byte == self.peer_byte {
            true -> step(identifier)
            false -> miss()
        }
    }

    state step(&mut self, identifier: &[u8]) -> BoolResult {
        self.cmp_i = ((self.cmp_i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> scan(identifier) }
    }

    state hit(&mut self) -> BoolResult { BoolResult { v: true } }

    state miss(&mut self) -> BoolResult { BoolResult { v: false } }
}

machine LinuxMemoryQueryer::is_space(&mut self, byte: u8) -> BoolResult {
    BoolResult { v: byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 11 || byte == 12 }
}

machine LinuxMemoryQueryer::lower_fold(&mut self, byte: u8) -> U8Result {
    transition byte >= 65 && byte <= 90 {
        true -> fold(byte)
        false -> same(byte)
    }

    state fold(&mut self, byte: u8) -> U8Result {
        U8Result { v: ((byte as u8 in Wrapping) + (32 as u8 in Wrapping)) as u8 }
    }

    state same(&mut self, byte: u8) -> U8Result {
        U8Result { v: byte }
    }
}

// resolve_module_address = resolve_module(...).checked_add(offset): only a
// u64 overflow is Unresolvable — an unknown module resolves to `offset`
// itself (base 0), exactly as upstream.
pub linux_x86_64 machine LinuxMemoryQueryer::resolve_module_address(
    &mut self,
    process_info: &OpenedProcessInfo,
    identifier: &[u8],
    offset: u64
) -> ResolvedModuleAddress
satisfies MemoryQueryerTrait::resolve_module_address
reaches FilesystemHost
invokes FilesystemHost;
{
    transition { _ -> start(process_info, identifier, offset) }

    state start(&mut self, process_info: &OpenedProcessInfo, identifier: &[u8], offset: u64) -> ResolvedModuleAddress {
        let base: u64 = self.resolve_module(process_info, identifier);
        let sum: u64 = ((base as u64 in Wrapping) + (offset as u64 in Wrapping)) as u64;
        transition sum < base {
            true -> unresolvable()
            _ -> resolved(sum)
        }
    }

    state resolved(&mut self, address: u64) -> ResolvedModuleAddress {
        ResolvedModuleAddress::Resolved { address: address }
    }

    state unresolvable(&mut self) -> ResolvedModuleAddress {
        ResolvedModuleAddress::Unresolvable
    }
}

// Upstream address_to_module: the first (base-sorted) module containing the
// address; Hit carries address - base and fills `module` with the entry.
pub linux_x86_64 machine LinuxMemoryQueryer::address_to_module(
    &mut self,
    process_info: &OpenedProcessInfo,
    address: u64,
    module: &mut NormalizedModule
) -> AddressModuleResult
satisfies MemoryQueryerTrait::address_to_module
reaches FilesystemHost
invokes FilesystemHost;
{
    transition { _ -> start(process_info, address, module) }

    state start(&mut self, process_info: &OpenedProcessInfo, address: u64, module: &mut NormalizedModule) -> AddressModuleResult {
        let open: MemoryBoundsOpen = self.open_modules(process_info);
        transition open {
            MemoryBoundsOpen::Opened -> scan(address, module)
            _ -> miss()
        }
    }

    state scan(&mut self, address: u64, module: &mut NormalizedModule) -> AddressModuleResult {
        let _u65: BoolResult = self.emit_min();
        transition _u65.v {
            true -> contains(address, module)
            false -> miss()
        }
    }

    state contains(&mut self, address: u64, module: &mut NormalizedModule) -> AddressModuleResult {
        self.mod_mark_put(self.sel_index);
        self.mod_emit = ((self.mod_emit as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        // contains_address is end-inclusive upstream: [base, base+size] —
        // the merged hi is base+size, so the bound is <= not <.
        let _u66: U64Result = self.mod_lo_at(self.sel_index);
        let _u67: U64Result = self.mod_hi_at(self.sel_index);
        transition _u66.v <= address && address <= _u67.v {
            true -> hit(address, module)
            false -> scan(address, module)
        }
    }

    state hit(&mut self, address: u64, module: &mut NormalizedModule) -> AddressModuleResult {
        self.fill_module(&mut module);
        let sel: u64 = self.sel_index;
        let lo: U64Result = self.mod_lo_at(sel);
        let offset: u64 = ((address as u64 in Wrapping) - (lo.v as u64 in Wrapping)) as u64;
        AddressModuleResult::Hit { offset: offset }
    }

    state miss(&mut self) -> AddressModuleResult {
        AddressModuleResult::Miss
    }
}

// Bounded accessors for the module tables: positions arrive as ordinary args
// (computed expressions allowed); the internal guard discharges the index
// proof. Out-of-range reads yield a sentinel that cannot match a live query
// (mark→1 "used", lo→u64::MAX, hi→0, off→slab end, len/hash→0, path byte→0);
// writes out of range are dropped (unreachable by construction).
machine LinuxMemoryQueryer::mod_lo_at(&mut self, index: u64) -> U64Result {
    transition index < 512 {
        true -> hit(index)
        false -> miss()
    }
    state hit(&mut self, index: u64) -> U64Result { U64Result { v: self.mod_lo[index] } }
    state miss(&mut self) -> U64Result { U64Result { v: 18446744073709551615 } }
}

machine LinuxMemoryQueryer::mod_hi_at(&mut self, index: u64) -> U64Result {
    transition index < 512 {
        true -> hit(index)
        false -> miss()
    }
    state hit(&mut self, index: u64) -> U64Result { U64Result { v: self.mod_hi[index] } }
    state miss(&mut self) -> U64Result { U64Result { v: 0 } }
}

machine LinuxMemoryQueryer::mod_off_at(&mut self, index: u64) -> U64Result {
    transition index < 512 {
        true -> hit(index)
        false -> miss()
    }
    state hit(&mut self, index: u64) -> U64Result { U64Result { v: self.mod_off[index] } }
    state miss(&mut self) -> U64Result { U64Result { v: 32768 } }
}

machine LinuxMemoryQueryer::mod_len_at(&mut self, index: u64) -> U64Result {
    transition index < 512 {
        true -> hit(index)
        false -> miss()
    }
    state hit(&mut self, index: u64) -> U64Result { U64Result { v: self.mod_len[index] } }
    state miss(&mut self) -> U64Result { U64Result { v: 0 } }
}

machine LinuxMemoryQueryer::mod_hash_at(&mut self, index: u64) -> U64Result {
    transition index < 512 {
        true -> hit(index)
        false -> miss()
    }
    state hit(&mut self, index: u64) -> U64Result { U64Result { v: self.mod_hash[index] } }
    state miss(&mut self) -> U64Result { U64Result { v: 0 } }
}

machine LinuxMemoryQueryer::mod_mark_at(&mut self, index: u64) -> U8Result {
    transition index < 512 {
        true -> hit(index)
        false -> miss()
    }
    state hit(&mut self, index: u64) -> U8Result { U8Result { v: self.mod_mark[index] } }
    state miss(&mut self) -> U8Result { U8Result { v: 1 } }
}

machine LinuxMemoryQueryer::mod_mark_put(&mut self, index: u64) {
    transition index < 512 {
        true -> put(index)
        false -> skip()
    }
    state put(&mut self, index: u64) { self.mod_mark[index] = 1; }
    state skip(&mut self) {
    }
}

machine LinuxMemoryQueryer::mod_lo_put(&mut self, index: u64, value: u64) {
    transition index < 512 {
        true -> put(index, value)
        false -> skip()
    }
    state put(&mut self, index: u64, value: u64) { self.mod_lo[index] = value; }
    state skip(&mut self) {
    }
}

machine LinuxMemoryQueryer::mod_hi_put(&mut self, index: u64, value: u64) {
    transition index < 512 {
        true -> put(index, value)
        false -> skip()
    }
    state put(&mut self, index: u64, value: u64) { self.mod_hi[index] = value; }
    state skip(&mut self) {
    }
}

machine LinuxMemoryQueryer::mod_path_at(&mut self, position: u64) -> U8Result {
    transition position < 32768 {
        true -> hit(position)
        false -> miss()
    }
    state hit(&mut self, position: u64) -> U8Result { U8Result { v: self.mod_paths[position] } }
    state miss(&mut self) -> U8Result { U8Result { v: 0 } }
}

machine LinuxMemoryQueryer::mod_path_set(&mut self, position: u64, byte: u8) {
    transition position < 32768 {
        true -> put(position, byte)
        false -> skip()
    }
    state put(&mut self, position: u64, byte: u8) { self.mod_paths[position] = byte; }
    state skip(&mut self) {
    }
