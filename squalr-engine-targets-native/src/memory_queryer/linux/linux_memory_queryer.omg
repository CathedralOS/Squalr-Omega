module src::memory_queryer::linux::linux_memory_queryer;
use omega::language::core::binding;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::memory::bitness::Bitness;
use squalr_engine_api::src::structures::memory::normalized_region;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_targets::src::target_providers::MemoryBoundsOpen;
use squalr_engine_targets::src::target_providers::MemoryBoundsStep;
use src::memory_queryer::memory_protection_enum::MemoryProtectionEnum;
use src::memory_queryer::memory_queryer_trait::MemoryQueryerTrait;
use src::memory_queryer::memory_type_enum::MemoryTypeEnum;
use src::memory_queryer::normalized_module::AddressModuleResult;
use src::memory_queryer::normalized_module::ModuleAddressDisplay;
use src::memory_queryer::normalized_module::ModuleStreamStep;
use src::memory_queryer::normalized_module::NormalizedModule;
use src::memory_queryer::normalized_module::ResolvedModuleAddress;
use src::memory_queryer::region_bounds_handling::RegionBoundsHandling;
use src::proc_paths::ProcName;

// Port of memory_queryer/linux/linux_memory_queryer.rs, streaming.
// Upstream parses the whole of /proc/<pid>/maps into a Vec<NormalizedRegion>
// per call; Omega has no growable Vec, so the equivalent object is a
// provider-owned enumeration: open_virtual_pages stores the filter set,
// next_virtual_page yields one NormalizedRegion per maps line that passes the
// same filters (in the same ascending kernel order), and close_enumeration
// releases the descriptor. One enumeration is live per instance; upstream's
// Vec permits independent collections, so this is a recorded translation
// (callers enumerate serially — same contract PORTING.md demands).
//
// Line grammar (identical to upstream's split): "<hex>-<hex> <4 perms>
// <hex offset> <dev> <inode> [pathname]"; a line is a region when end > start.
// Permission bits match MemoryProtectionEnum: r=READ w=WRITE x=EXECUTE
// p=COPY_ON_WRITE. Type: empty pathname -> NONE; pathname + 'p' -> PRIVATE
// unless the path is absolute and 'x' set -> IMAGE; otherwise MAPPED.
pub data LinuxMemoryQueryer {
    host: Binding<FilesystemHost>;

    // /proc dirfd + open maps fd + the rolling parse buffer.
    proc_fd: i32;
    maps_fd: i32;
    buffer: [u8; 4096];
    buffered: u64;
    cursor: u64;
    at_eof: bool;

    // Filter set captured at open (upstream's get_virtual_pages args).
    required_bits: u32;
    excluded_bits: u32;
    allowed_bits: u32;
    range_start: u64;
    range_end: u64;
    bounds_handling: RegionBoundsHandling;
    suppress_all: bool;

    // Per-line parse registers.
    line_start: u64;
    line_end: u64;
    region_start: u64;
    region_end: u64;
    line_perms: u32;
    line_type: u32;
    tok_index: u64;
    pathname_len: u64;
    emit_base: u64;
    src_index: u64;
    emit_size: u64;
    scan_pos: u64;
    io_count: i64;
    scratch: i32;
    name: ProcName;
    // is_address_writable's private scan state.
    walk_region: normalized_region::NormalizedRegion;
    write_hit: bool;

    // Module aggregation — upstream's get_modules materializes a
    // Vec<NormalizedModule> in two passes over one parse of maps; with no
    // growable Vec the port keeps a bounded provider-owned table (512
    // entries, 32KiB deduplicated path slab) built by two sweeps of one open
    // maps fd: pass 1 collects the deduplicated executable+absolute path
    // set, seek(0) rewinds the same descriptor, pass 2 merges min(start) /
    // max(end) for every region whose normalized path is in the set. A maps
    // file mutating between sweeps can shift the merged bounds — recorded
    // translation (upstream's single snapshot cannot change mid-build).
    scan_kind: u8;          // 0 region lines, 1 module pass A, 2 module pass B
    mod_count: u64;
    mod_lo: [u64; 512];
    mod_hi: [u64; 512];
    mod_off: [u64; 512];
    mod_len: [u64; 512];
    mod_hash: [u64; 512];
    mod_paths: [u8; 32768];
    mod_paths_len: u64;
    mod_emit: u64;
    mod_mark: [u8; 512];
    mod_modules_out: bool;  // next_virtual_page emits module base regions
    non_modules: bool;      // emit filter: drop bases inside the module set
    canon: [u8; 4096];      // canonical (space-collapsed, (deleted)-stripped) path
    canon_len: u64;
    hash: u64;
    found_index: u64;
    sel_index: u64;
    id_lo: u64;
    id_hi: u64;
    byte_pos: u64;
    ident_lo: u64;
    ident_hi: u64;
    have_sel: bool;
    space_run: bool;
    k_index: u64;
    cmp_i: u64;
    cmp_j: u64;
    byte: u8;
    peer_byte: u8;
}

pub linux_x86_64 machine LinuxMemoryQueryer::open_virtual_pages(
    &mut self,
    process_info: &OpenedProcessInfo,
    required_protection: MemoryProtectionEnum,
    excluded_protection: MemoryProtectionEnum,
    allowed_types: MemoryTypeEnum,
    start_address: u64,
    end_address: u64,
    region_bounds_handling: RegionBoundsHandling
) -> MemoryBoundsOpen
satisfies MemoryQueryerTrait::open_virtual_pages
reaches FilesystemHost
invokes FilesystemHost;
{
    self.required_bits = required_protection.bits();
    self.excluded_bits = excluded_protection.bits();
    self.allowed_bits = allowed_types.bits();
    self.range_start = start_address;
    self.range_end = end_address;
    self.bounds_handling = region_bounds_handling;
    self.buffered = 0;
    self.cursor = 0;
    self.at_eof = false;
    self.suppress_all = false;
    self.maps_fd = -1;
    self.scan_kind = 0;
    self.mod_modules_out = false;
    self.non_modules = false;
    transition start_address >= end_address {
        true -> empty_open()
        false -> open_proc(process_info)
    }

    state open_proc(&mut self, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        self.proc_fd = self.host.open("/proc", 65536);
        transition self.proc_fd >= 0 {
            true -> open_maps(process_info)
            false -> fail()
        }
    }

    state open_maps(&mut self, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        let pid: u32 = process_info.get_process_id_raw();
        self.name = ProcName::for_process(pid, 109, 97, 112, 115, 4);
        transition self.name.len <= 48 {
            true -> open_maps_at(process_info, self.name.len)
            false -> open_maps_at(process_info, 48)
        }
    }

    state open_maps_at(&mut self, process_info: &OpenedProcessInfo, name_len: u64) -> MemoryBoundsOpen {
        self.maps_fd = self.host.open_at(self.proc_fd, self.name.bytes[0..name_len], 0);
        self.scratch = self.host.close(self.proc_fd);
        transition self.maps_fd >= 0 {
            true -> opened()
            false -> fail()
        }
    }

    state opened(&mut self) -> MemoryBoundsOpen {
        MemoryBoundsOpen::Opened
    }

    // start >= end: upstream returns an empty Vec — an enumeration whose
    // first step is Finished.
    state empty_open(&mut self) -> MemoryBoundsOpen {
        MemoryBoundsOpen::Opened
    }

    state fail(&mut self) -> MemoryBoundsOpen {
        MemoryBoundsOpen::Failed
    }
}

// FromVirtualModules' empty Vec and any other deliberately-empty stream.
pub linux_x86_64 machine LinuxMemoryQueryer::open_suppressed(&mut self) {
    self.maps_fd = -1;
    self.suppress_all = true;
    self.scan_kind = 0;
    self.mod_modules_out = false;
    self.non_modules = false;
}

pub linux_x86_64 machine LinuxMemoryQueryer::close_enumeration(
    &mut self
)
satisfies MemoryQueryerTrait::close_enumeration
reaches FilesystemHost
invokes FilesystemHost;
{
    transition self.maps_fd >= 0 {
        true -> close_it()
        false -> noop()
    }
    state close_it(&mut self) {
        self.scratch = self.host.close(self.maps_fd);
        self.maps_fd = -1;
        transition { _ -> noop() }
    }
    state noop(&mut self) {
    }
}

pub linux_x86_64 machine LinuxMemoryQueryer::next_virtual_page(
    &mut self,
    region: &mut normalized_region::NormalizedRegion
) -> MemoryBoundsStep
satisfies MemoryQueryerTrait::next_virtual_page
reaches FilesystemHost
invokes FilesystemHost;
{
    transition self.mod_modules_out {
        true -> module_emit(region)
        false -> entry_guard(region)
    }

    // FromModules: the module table drains as NormalizedRegion rows —
    // upstream's get_modules().into_iter().map(into_base_region).
    state module_emit(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.next_module_region(region)
    }

    state entry_guard(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.suppress_all || self.maps_fd < 0 {
            true -> finished(region)
            false -> ensure_line(region)
        }
    }

    state finished(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        MemoryBoundsStep::Finished
    }

    state failed(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.close_enumeration();
        MemoryBoundsStep::Failed
    }

    // Ensure buffer[cursor:] holds a full line (or is at EOF with a tail).
    state ensure_line(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.at_eof {
            true -> eof_tail(region)
            false -> scan_newline(region)
        }
    }

    state eof_tail(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.cursor < self.buffered {
            true -> emit_line(region)
            false -> finish_close(region)
        }
    }

    // Module pass A reaches EOF inside the same call: rewind the open
    // descriptor and run pass B (upstream's second pass over its parsed
    // Vec). Any other enumeration mode closes as before.
    state finish_close(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.scan_kind == 1 {
            true -> rewind_pass_b(region)
            false -> finish_close_do(region)
        }
    }

    state rewind_pass_b(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.io_count = self.host.seek(self.maps_fd, 0, 0);
        transition self.io_count >= 0 {
            true -> pass_b_reset(region)
            false -> failed(region)
        }
    }

    state pass_b_reset(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.scan_kind = 2;
        self.buffered = 0;
        self.cursor = 0;
        self.at_eof = false;
        transition { _ -> ensure_line(region) }
    }

    state finish_close_do(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.close_enumeration();
        transition { _ -> finished(region) }
    }

    state scan_newline(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.scan_pos = self.cursor;
        transition { _ -> scan_step(region) }
    }

    state scan_step(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.scan_pos < self.buffered {
            true -> scan_byte(region)
            false -> need_fill(region)
        }
    }

    state scan_byte(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.buf_byte_at(self.scan_pos) == 10 {
            true -> have_line(region)
            false -> scan_advance(region)
        }
    }

    state scan_advance(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.scan_pos = ((self.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> scan_step(region) }
    }

    state have_line(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_start = self.cursor;
        self.line_end = self.scan_pos;
        transition { _ -> parse_line(region) }
    }

    // No newline in the window: compact the tail to the front, refill, or
    // fail if a single line exceeds the buffer.
    state need_fill(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.cursor > 0 {
            true -> compact(region)
            false -> grow_or_fail(region)
        }
    }

    state compact(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.tok_index = 0;
        transition { _ -> compact_step(region) }
    }

    state compact_step(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        let consumed: u64 =
            ((self.cursor as u64 in Saturating) + (self.tok_index as u64 in Saturating)) as u64;
        transition consumed < self.buffered {
            true -> compact_byte(region)
            false -> compact_done(region)
        }
    }

    state compact_byte(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.src_index = ((self.cursor as u64 in Wrapping) + (self.tok_index as u64 in Wrapping)) as u64;
        transition self.tok_index < 4096 {
            true -> compact_src(region)
            false -> failed(region)
        }
    }

    state compact_src(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.src_index < 4096 {
            true -> compact_move(region)
            false -> failed(region)
        }
    }

    state compact_move(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.buf_put(self.tok_index, self.buf_byte_at(self.src_index));
        self.tok_index = ((self.tok_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> compact_step(region) }
    }

    state compact_done(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.buffered = self.tok_index;
        self.cursor = 0;
        transition { _ -> refill(region) }
    }

    state grow_or_fail(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.buffered < 4096 {
            true -> refill(region)
            false -> failed(region)
        }
    }

    state refill(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.buffered <= 4096 {
            true -> refill_do(region)
            false -> failed(region)
        }
    }

    state refill_do(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.io_count = self.host.read(self.maps_fd, self.buffer[self.buffered..4096], ((4096 as u64 in Wrapping) - (self.buffered as u64 in Wrapping)) as u64);
        transition self.io_count > 0 {
            true -> refilled(region)
            false -> empty_or_eof(region)
        }
    }

    state refilled(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.buffered = ((self.buffered as u64 in Wrapping) + (self.io_count as u64 as u64 in Wrapping)) as u64;
        transition { _ -> scan_newline(region) }
    }

    state empty_or_eof(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.io_count == 0 {
            true -> mark_eof(region)
            false -> failed(region)
        }
    }

    state mark_eof(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.at_eof = true;
        transition self.cursor < self.buffered {
            true -> emit_line(region)
            false -> finish_close(region)
        }
    }

    state emit_line(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        // Tail line without a trailing newline.
        self.line_start = self.cursor;
        self.line_end = self.buffered;
        transition { _ -> parse_line(region) }
    }

    // <hex>-<hex> <4 perms> then skip 3 whitespace-separated tokens, then the
    // optional pathname — identical fields to upstream's split_whitespace.
    state parse_line(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.scan_pos = self.line_start;
        self.region_start = 0;
        self.region_end = 0;
        self.line_perms = 0;
        self.line_type = 0;
        self.pathname_len = 0;
        transition { _ -> hex_start(region) }
    }

    state hex_start(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.hex_digit_at(self.scan_pos) != 16 {
            true -> hex_start_step(region)
            false -> consume_line(region)
        }
    }

    state hex_start_step(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.hex_digit_at(self.scan_pos) != 16 {
            true -> hex_start_take(region)
            false -> dash_or_fail(region)
        }
    }

    state hex_start_take(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.region_start = ((((self.region_start as u64 in Wrapping) * (16 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (self.hex_digit_at(self.scan_pos) as u64 in Wrapping)) as u64;
        self.scan_pos = ((self.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_start_step(region) }
    }

    state dash_or_fail(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.buf_byte_at(self.scan_pos) == 45 {
            true -> start_end_hex(region)
            false -> consume_line(region)
        }
    }

    state start_end_hex(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.scan_pos = ((self.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_end_step(region) }
    }

    state hex_end_step(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.hex_digit_at(self.scan_pos) != 16 {
            true -> hex_end_take(region)
            false -> space_then_perms(region)
        }
    }

    state hex_end_take(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.region_end = ((((self.region_end as u64 in Wrapping) * (16 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (self.hex_digit_at(self.scan_pos) as u64 in Wrapping)) as u64;
        self.scan_pos = ((self.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_end_step(region) }
    }

    // Upstream keeps the line only when end > start.
    state space_then_perms(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.region_end > self.region_start {
            true -> skip_space(region)
            false -> consume_line(region)
        }
    }

    state skip_space(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.buf_byte_at(self.scan_pos) == 32 && self.scan_pos < self.line_end {
            true -> skip_space_step(region)
            false -> read_perms(region)
        }
    }

    state skip_space_step(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.scan_pos = ((self.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> skip_space(region) }
    }

    state read_perms(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        // r w x p are at scan_pos..scan_pos+4 in maps; '-' is 45.
        self.line_perms = 0;
        transition { _ -> perm_r(region) }
    }

    state perm_r(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.buf_byte_at(self.scan_pos) == 114 {
            true -> perm_r_set(region)
            false -> perm_w(region)
        }
    }

    state perm_r_set(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_perms = self.line_perms | 1;
        transition { _ -> perm_w(region) }
    }

    state perm_w(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.buf_byte_at(((self.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) == 119 {
            true -> perm_w_set(region)
            false -> perm_x(region)
        }
    }

    state perm_w_set(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_perms = self.line_perms | 2;
        transition { _ -> perm_x(region) }
    }

    state perm_x(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.buf_byte_at(((self.scan_pos as u64 in Wrapping) + (2 as u64 in Wrapping)) as u64) == 120 {
            true -> perm_x_set(region)
            false -> perm_p(region)
        }
    }

    state perm_x_set(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_perms = self.line_perms | 4;
        transition { _ -> perm_p(region) }
    }

    state perm_p(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.buf_byte_at(((self.scan_pos as u64 in Wrapping) + (3 as u64 in Wrapping)) as u64) == 112 {
            true -> perm_p_set(region)
            false -> after_perms(region)
        }
    }

    state perm_p_set(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_perms = self.line_perms | 8;
        transition { _ -> after_perms(region) }
    }

    state after_perms(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.scan_pos = ((self.scan_pos as u64 in Wrapping) + (4 as u64 in Wrapping)) as u64;
        self.tok_index = 0;
        transition { _ -> skip_token(region) }
    }

    // Skip 3 tokens: offset, dev, inode.
    state skip_token(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.tok_index < 3 {
            true -> skip_token_ws(region)
            false -> pathname_seek(region)
        }
    }

    state skip_token_ws(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.buf_byte_at(self.scan_pos) == 32 && self.scan_pos < self.line_end {
            true -> skip_token_ws_step(region)
            false -> skip_token_body(region)
        }
    }

    state skip_token_ws_step(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.scan_pos = ((self.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> skip_token_ws(region) }
    }

    state skip_token_body(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.buf_byte_at(self.scan_pos) != 32 && self.scan_pos < self.line_end {
            true -> skip_token_body_step(region)
            false -> token_done(region)
        }
    }

    state skip_token_body_step(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.scan_pos = ((self.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> skip_token_body(region) }
    }

    state token_done(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.tok_index = ((self.tok_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> skip_token(region) }
    }

    state pathname_seek(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.buf_byte_at(self.scan_pos) == 32 && self.scan_pos < self.line_end {
            true -> pathname_seek_step(region)
            false -> classify_type(region)
        }
    }

    state pathname_seek_step(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.scan_pos = ((self.scan_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> pathname_seek(region) }
    }

    // pathname is everything from scan_pos to line_end (may be empty).
    state classify_type(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.pathname_len = ((self.line_end as u64 in Wrapping) - (self.scan_pos as u64 in Wrapping)) as u64;
        transition self.scan_kind == 0 {
            true -> type_check(region)
            false -> module_line(region)
        }
    }

    state type_check(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.pathname_len == 0 {
            true -> type_none(region)
            false -> type_from_perms(region)
        }
    }

    // Module aggregation tails — no region is emitted in scan_kind != 0;
    // the line feeds the module table and the same call keeps draining.
    state module_line(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.scan_kind == 1 {
            true -> mod_pass_a(region)
            false -> mod_pass_b(region)
        }
    }

    // Pass A: upstream is_module_region — executable bit (perms[2] == 'x')
    // && absolute pathname. The canonicalized path is the dedupe key.
    state mod_pass_a(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition (self.line_perms & 4) != 0 {
            true -> mod_a_canon(region)
            false -> consume_line(region)
        }
    }

    state mod_a_canon(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.canon_path();
        transition self.canon_len > 0 && self.canon_at(0) == 47 {
            true -> mod_a_insert(region)
            false -> consume_line(region)
        }
    }

    state mod_a_insert(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.hash_path();
        transition self.table_find() {
            true -> consume_line(region)
            false -> mod_a_room(region)
        }
    }

    // Bounded-table overflow is a named failure — a silently partial path
    // set would produce a silently partial module list.
    state mod_a_room(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.mod_count < 512 && ((self.mod_paths_len as u64 in Wrapping) + (self.canon_len as u64 in Wrapping)) as u64 <= 32768 {
            true -> mod_a_store(region)
            false -> failed(region)
        }
    }

    state mod_a_store(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.mod_off[self.mod_count] = self.mod_paths_len;
        self.mod_len[self.mod_count] = self.canon_len;
        self.mod_hash[self.mod_count] = self.hash;
        self.mod_lo[self.mod_count] = 18446744073709551615;
        self.mod_hi[self.mod_count] = 0;
        self.mod_mark[self.mod_count] = 0;
        self.k_index = 0;
        transition { _ -> mod_slab(region) }
    }

    state mod_slab(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.k_index < self.canon_len {
            true -> mod_slab_byte(region)
            false -> mod_slab_done(region)
        }
    }

    state mod_slab_byte(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.mod_path_set(((self.mod_paths_len as u64 in Wrapping) + (self.k_index as u64 in Wrapping)) as u64, self.canon_at(self.k_index));
        self.k_index = ((self.k_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> mod_slab(region) }
    }

    state mod_slab_done(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.mod_paths_len = ((self.mod_paths_len as u64 in Wrapping) + (self.canon_len as u64 in Wrapping)) as u64;
        self.mod_count = ((self.mod_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> consume_line(region) }
    }

    // Pass B: upstream merges min(start) / max(end) for every region whose
    // normalized pathname is in the collected set — any permissions.
    state mod_pass_b(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.canon_path();
        transition self.canon_len > 0 {
            true -> mod_b_find(region)
            false -> consume_line(region)
        }
    }

    state mod_b_find(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.hash_path();
        transition self.table_find() {
            true -> mod_b_merge(region)
            false -> consume_line(region)
        }
    }

    state mod_b_merge(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.region_start < self.mod_lo_at(self.found_index) {
            true -> mod_b_lo(region)
            false -> mod_b_hi(region)
        }
    }

    state mod_b_lo(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.mod_lo_put(self.found_index, self.region_start);
        transition { _ -> mod_b_hi(region) }
    }

    state mod_b_hi(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.region_end > self.mod_hi_at(self.found_index) {
            true -> mod_b_hi_set(region)
            false -> consume_line(region)
        }
    }

    state mod_b_hi_set(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.mod_hi_put(self.found_index, self.region_end);
        transition { _ -> consume_line(region) }
    }

    state type_none(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_type = 1;
        transition { _ -> apply_filters(region) }
    }

    // 'p' + non-absolute -> PRIVATE; absolute path + 'x' -> IMAGE; else MAPPED.
    // Absolute => first pathname byte '/'; upstream: is_image checks
    // pathname + executable bit; shared object guard '.so' is not in this
    // maps-line view (upstream uses the same perms/path rule in this file).
    state type_from_perms(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition (self.line_perms & 4) != 0 && self.buf_byte_at(self.scan_pos) == 47 {
            true -> type_image(region)
            false -> type_private_or_mapped(region)
        }
    }

    state type_image(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_type = 4;
        transition { _ -> apply_filters(region) }
    }

    state type_private_or_mapped(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition (self.line_perms & 8) != 0 {
            true -> type_private(region)
            false -> type_mapped(region)
        }
    }

    state type_private(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_type = 2;
        transition { _ -> apply_filters(region) }
    }

    state type_mapped(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.line_type = 8;
        transition { _ -> apply_filters(region) }
    }

    // Upstream's matches_protection_filters + matches_type_filters, exactly:
    // READ is unconditionally required; a non-empty required set needs any
    // overlap ((perms & required) != 0); a non-empty excluded set needs no
    // overlap; an empty allowed-type set admits every type.
    state apply_filters(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition (self.line_perms & 1) != 0 && (self.required_bits == 0 || (self.line_perms & self.required_bits) != 0) && (self.excluded_bits == 0 || (self.line_perms & self.excluded_bits) == 0) && (self.allowed_bits == 0 || (self.line_type & self.allowed_bits) != 0) {
            true -> filter_bounds(region)
            false -> consume_line(region)
        }
    }

    state filter_bounds(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.region_end <= self.range_start || self.region_start >= self.range_end {
            true -> consume_line(region)
            false -> apply_bounds_handling(region)
        }
    }

    state apply_bounds_handling(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.bounds_handling {
            RegionBoundsHandling::Exclude -> bounds_exclude(region)
            RegionBoundsHandling::Include -> emit(region)
            RegionBoundsHandling::Resize -> bounds_resize(region)
        }
    }

    // Region overlaps but isn't fully inside -> dropped.
    state bounds_exclude(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.region_start >= self.range_start && self.region_end <= self.range_end {
            true -> emit(region)
            false -> consume_line(region)
        }
    }

    state bounds_resize(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.region_start < self.range_start {
            true -> resize_base(region)
            false -> resize_end_check(region)
        }
    }

    state resize_base(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.region_start = self.range_start;
        transition { _ -> resize_end_check(region) }
    }

    state resize_end_check(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.region_end > self.range_end {
            true -> resize_end(region)
            false -> emit(region)
        }
    }

    state resize_end(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.region_end = self.range_end;
        transition { _ -> emit(region) }
    }

    state emit(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.emit_base = self.region_start;
        self.emit_size = ((self.region_end as u64 in Wrapping) - (self.region_start as u64 in Wrapping)) as u64;
        transition self.non_modules {
            true -> module_base_check(region)
            false -> emit_write(region)
        }
    }

    // FromNonModules: upstream drops every page whose (post-bounds) base
    // address is in the module base-address set.
    state module_base_check(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        transition self.base_in_modules() {
            true -> consume_line(region)
            false -> emit_write(region)
        }
    }

    state emit_write(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        region.set_base_address(self.emit_base);
        region.set_region_size(self.emit_size);
        transition { _ -> consume_line_region(region) }
    }

    state consume_line_region(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.consume_line_position();
        transition { _ -> region_ready(region) }
    }

    state region_ready(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        MemoryBoundsStep::Region
    }

    state consume_line(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.consume_line_position();
        transition { _ -> ensure_line(region) }
    }
}

// cursor := line_end + 1 (past the newline) — or EOF-tail, which empties the
// window so the next ensure_line hits finish_close.
machine LinuxMemoryQueryer::consume_line_position(&mut self) {
    transition self.line_end < self.buffered {
        true -> step_past()
        false -> drain()
    }
    state step_past(&mut self) {
        self.cursor = ((self.line_end as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> noop() }
    }
    state drain(&mut self) {
        self.cursor = self.buffered;
        transition { _ -> noop() }
    }
    state noop(&mut self) {
    }
}


// Guarded buffer access: all positions are proof-checked against the fixed
// window before indexing. Out-of-window reads yield 0 (a byte that never
// matches a maps-field classifier) and writes are dropped — unreachable on a
// well-formed line because callers bound positions by line_end <= buffered.
machine LinuxMemoryQueryer::buf_byte_at(&mut self, position: u64) -> u8 {
    transition position < 4096 {
        true -> buf_get(position)
        false -> buf_miss()
    }
    state buf_get(&mut self, position: u64) -> u8 { self.buffer[position] }
    state buf_miss(&mut self) -> u8 { 0 }
}


// 16 when the byte isn't a hex digit or is out of window bounds.
machine LinuxMemoryQueryer::hex_digit_at(&mut self, position: u64) -> u64 {
    transition position >= self.line_end || position >= 4096 {
        true -> out()
        false -> check(position)
    }
    state out(&self) -> u64 {
        16
    }
    state check(&self, position: u64) -> u64 {
        transition self.buffer[position] >= 48 && self.buffer[position] <= 57 {
            true -> digit(position)
            false -> alpha(position)
        }
    }
    state digit(&self, position: u64) -> u64 {
        ((self.buffer[position] as u64 in Wrapping) - (48 as u64 in Wrapping)) as u64
    }
    state alpha(&self, position: u64) -> u64 {
        transition self.buffer[position] >= 97 && self.buffer[position] <= 102 {
            true -> lower(position)
            false -> upper(position)
        }
    }
    state lower(&self, position: u64) -> u64 {
        ((self.buffer[position] as u64 in Wrapping) - (87 as u64 in Wrapping)) as u64
    }
    state upper(&self, position: u64) -> u64 {
        transition self.buffer[position] >= 65 && self.buffer[position] <= 70 {
            true -> upper_val(position)
            false -> out()
        }
    }
    state upper_val(&self, position: u64) -> u64 {
        ((self.buffer[position] as u64 in Wrapping) - (55 as u64 in Wrapping)) as u64
    }
}

// get_all_virtual_pages -> the unfiltered stream upstream's get_virtual_pages
// produces when all bits pass: empty protection sets, all types, [0, max).
pub linux_x86_64 machine LinuxMemoryQueryer::get_all_virtual_pages(
    &mut self,
    process_info: &OpenedProcessInfo
) -> MemoryBoundsOpen
satisfies MemoryQueryerTrait::get_all_virtual_pages
reaches FilesystemHost
invokes FilesystemHost;
{
    let required: MemoryProtectionEnum = MemoryProtectionEnum::empty();
    let excluded: MemoryProtectionEnum = MemoryProtectionEnum::none();
    let t_none: MemoryTypeEnum = MemoryTypeEnum::none();
    let t_private: MemoryTypeEnum = MemoryTypeEnum::private();
    let t_image: MemoryTypeEnum = MemoryTypeEnum::image();
    let t_mapped: MemoryTypeEnum = MemoryTypeEnum::mapped();
    let allowed_np: MemoryTypeEnum = t_none.union(t_private);
    let allowed_npi: MemoryTypeEnum = allowed_np.union(t_image);
    let allowed: MemoryTypeEnum = allowed_npi.union(t_mapped);
    let maximum: u64 = self.get_maximum_address(process_info);
    self.open_virtual_pages(
        process_info,
        required,
        excluded,
        allowed,
        0,
        maximum,
        RegionBoundsHandling::Exclude
    )
}

pub linux_x86_64 machine LinuxMemoryQueryer::is_address_writable(
    &mut self,
    process_info: &OpenedProcessInfo,
    address: u64
) -> bool
satisfies MemoryQueryerTrait::is_address_writable
reaches FilesystemHost
invokes FilesystemHost;
{
    // Upstream: `any()` over a freshly parsed maps Vec — a containing region
    // with WRITE. Same predicate here via a private WRITE-required
    // enumeration; first containing hit wins. This reuses the provider's
    // single parse state — no other enumeration may be live during the call.
    let maximum: u64 = self.get_maximum_address(process_info);
    let required: MemoryProtectionEnum = MemoryProtectionEnum::write();
    let excluded: MemoryProtectionEnum = MemoryProtectionEnum::none();
    let t_none: MemoryTypeEnum = MemoryTypeEnum::none();
    let t_private: MemoryTypeEnum = MemoryTypeEnum::private();
    let t_image: MemoryTypeEnum = MemoryTypeEnum::image();
    let t_mapped: MemoryTypeEnum = MemoryTypeEnum::mapped();
    let allowed_np: MemoryTypeEnum = t_none.union(t_private);
    let allowed_npi: MemoryTypeEnum = allowed_np.union(t_image);
    let allowed: MemoryTypeEnum = allowed_npi.union(t_mapped);
    let open: MemoryBoundsOpen = self.open_virtual_pages(
        process_info,
        required,
        excluded,
        allowed,
        0,
        maximum,
        RegionBoundsHandling::Exclude
    );
    transition open {
        MemoryBoundsOpen::Opened -> begin(address)
        MemoryBoundsOpen::Failed -> done()
    }

    state begin(&mut self, address: u64) -> bool {
        self.write_hit = false;
        transition { _ -> pull(address) }
    }

    state pull(&mut self, address: u64) -> bool {
        self.walk_region.set_base_address(0);
        self.walk_region.set_region_size(0);
        let step: MemoryBoundsStep = self.next_virtual_page(&mut self.walk_region);
        transition step {
            MemoryBoundsStep::Region -> check(address)
            MemoryBoundsStep::Finished -> finish()
            MemoryBoundsStep::Failed -> finish()
        }
    }

    state check(&mut self, address: u64) -> bool {
        transition self.walk_region.get_base_address() <= address && address < self.walk_region.get_end_address() {
            true -> hit()
            false -> pull(address)
        }
    }

    state hit(&mut self) -> bool {
        self.close_enumeration();
        transition { _ -> yielded() }
    }

    state yielded(&mut self) -> bool {
        true
    }

    state finish(&mut self) -> bool {
        transition { _ -> done() }
    }

    state done(&mut self) -> bool {
        false
    }
}

pub linux_x86_64 machine LinuxMemoryQueryer::get_maximum_address(
    &self,
    process_info: &OpenedProcessInfo
) -> u64
satisfies MemoryQueryerTrait::get_maximum_address
{
    transition process_info.get_bitness() {
        Bitness::Bit32 -> (4294967295)
        Bitness::Bit64 -> (140737488355327)
    }
}

pub linux_x86_64 machine LinuxMemoryQueryer::get_min_usermode_address(
    &self,
    process_info: &OpenedProcessInfo
) -> u64
satisfies MemoryQueryerTrait::get_min_usermode_address
{
    0
}

pub linux_x86_64 machine LinuxMemoryQueryer::get_max_usermode_address(
    &self,
    process_info: &OpenedProcessInfo
) -> u64
satisfies MemoryQueryerTrait::get_max_usermode_address
{
    self.get_maximum_address(process_info)
}

// The "/proc" dirfd + "<pid>/maps" open shared by the module passes —
// identical to open_virtual_pages' preamble, minus the filter capture.
machine LinuxMemoryQueryer::acquire_maps(
    &mut self,
    process_info: &OpenedProcessInfo
) -> bool
reaches FilesystemHost
invokes FilesystemHost;
{
    self.buffered = 0;
    self.cursor = 0;
    self.at_eof = false;
    self.suppress_all = false;
    self.maps_fd = -1;
    transition { _ -> open_proc(process_info) }

    state open_proc(&mut self, process_info: &OpenedProcessInfo) -> bool {
        self.proc_fd = self.host.open("/proc", 65536);
        transition self.proc_fd >= 0 {
            true -> open_maps(process_info)
            false -> miss()
        }
    }

    state open_maps(&mut self, process_info: &OpenedProcessInfo) -> bool {
        let pid: u32 = process_info.get_process_id_raw();
        self.name = ProcName::for_process(pid, 109, 97, 112, 115, 4);
        transition self.name.len <= 48 {
            true -> open_maps_at(self.name.len)
            false -> open_maps_at(48)
        }
    }

    state open_maps_at(&mut self, name_len: u64) -> bool {
        self.maps_fd = self.host.open_at(self.proc_fd, self.name.bytes[0..name_len], 0);
        self.scratch = self.host.close(self.proc_fd);
        transition self.maps_fd >= 0 {
            true -> yes()
            false -> miss()
        }
    }

    state yes(&mut self) -> bool {
        true
    }

    state miss(&mut self) -> bool {
        false
    }
}

// Upstream get_modules: parse_proc_maps -> build_modules_from_regions. The
// stream form is a drained two-pass scan (pass A collects the path set, the
// fd rewinds, pass B merges bounds); each next_module then emits the next
// lowest-base entry — the upstream Vec's sort_by_key(base) order. A maps
// open failure yields upstream's empty Vec: an empty stream, not an error.
// Bounded-table overflow during pass A is the named failure path.
pub linux_x86_64 machine LinuxMemoryQueryer::open_modules(
    &mut self,
    process_info: &OpenedProcessInfo
) -> MemoryBoundsOpen
satisfies MemoryQueryerTrait::open_modules
reaches FilesystemHost
invokes FilesystemHost;
{
    self.mod_count = 0;
    self.mod_paths_len = 0;
    self.mod_emit = 0;
    self.mod_modules_out = false;
    self.non_modules = false;
    self.scan_kind = 1;
    transition self.acquire_maps(process_info) {
        true -> drain()
        false -> suppressed()
    }

    state drain(&mut self) -> MemoryBoundsOpen {
        let step: MemoryBoundsStep = self.next_virtual_page(&mut self.walk_region);
        transition step {
            MemoryBoundsStep::Region -> drain()
            MemoryBoundsStep::Finished -> built()
            MemoryBoundsStep::Failed -> failed()
        }
    }

    state built(&mut self) -> MemoryBoundsOpen {
        self.scan_kind = 0;
        MemoryBoundsOpen::Opened
    }

    state suppressed(&mut self) -> MemoryBoundsOpen {
        self.suppress_all = true;
        self.scan_kind = 0;
        self.mod_count = 0;
        MemoryBoundsOpen::Opened
    }

    state failed(&mut self) -> MemoryBoundsOpen {
        self.scan_kind = 0;
        MemoryBoundsOpen::Failed
    }
}

// FromModules: the module stream drained as bare base regions.
pub linux_x86_64 machine LinuxMemoryQueryer::open_module_regions(
    &mut self,
    process_info: &OpenedProcessInfo
) -> MemoryBoundsOpen
reaches FilesystemHost
invokes FilesystemHost;
{
    let open: MemoryBoundsOpen = self.open_modules(process_info);
    transition open {
        MemoryBoundsOpen::Opened -> out_mode()
        MemoryBoundsOpen::Failed -> fail()
    }

    state out_mode(&mut self) -> MemoryBoundsOpen {
        self.mod_modules_out = true;
        MemoryBoundsOpen::Opened
    }

    state fail(&mut self) -> MemoryBoundsOpen {
        MemoryBoundsOpen::Failed
    }
}

// FromNonModules: build the module base set, then run the usermode page
// enumeration with the base-exclusion filter on (upstream's exact filter:
// required/excluded empty, types NONE|PRIVATE|IMAGE, [0, max_usermode),
// bounds Exclude). An unreadable maps file yields an empty set upstream —
// the port proceeds with an empty table, so every usermode page passes.
pub linux_x86_64 machine LinuxMemoryQueryer::open_nonmodule_pages(
    &mut self,
    process_info: &OpenedProcessInfo
) -> MemoryBoundsOpen
reaches FilesystemHost
invokes FilesystemHost;
{
    self.mod_count = 0;
    self.mod_paths_len = 0;
    self.mod_emit = 0;
    self.mod_modules_out = false;
    self.non_modules = false;
    self.scan_kind = 1;
    transition self.acquire_maps(process_info) {
        true -> drain(process_info)
        false -> pages_open(process_info)
    }

    state drain(&mut self, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        let step: MemoryBoundsStep = self.next_virtual_page(&mut self.walk_region);
        transition step {
            MemoryBoundsStep::Region -> drain(process_info)
            MemoryBoundsStep::Finished -> pages_open(process_info)
            MemoryBoundsStep::Failed -> fail()
        }
    }

    state pages_open(&mut self, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        self.scan_kind = 0;
        let required: MemoryProtectionEnum = MemoryProtectionEnum::empty();
        let excluded: MemoryProtectionEnum = MemoryProtectionEnum::empty();
        let type_none: MemoryTypeEnum = MemoryTypeEnum::none();
        let type_private: MemoryTypeEnum = MemoryTypeEnum::private();
        let type_image: MemoryTypeEnum = MemoryTypeEnum::image();
        let allowed_partial: MemoryTypeEnum = type_none.union(type_private);
        let allowed: MemoryTypeEnum = allowed_partial.union(type_image);
        let maximum: u64 = self.get_max_usermode_address(process_info);
        let open: MemoryBoundsOpen = self.open_virtual_pages(
            process_info,
            required,
            excluded,
            allowed,
            0,
            maximum,
            RegionBoundsHandling::Exclude
        );
        transition open {
            MemoryBoundsOpen::Opened -> on()
            MemoryBoundsOpen::Failed -> fail()
        }
    }

    state on(&mut self) -> MemoryBoundsOpen {
        self.non_modules = true;
        MemoryBoundsOpen::Opened
    }

    state fail(&mut self) -> MemoryBoundsOpen {
        MemoryBoundsOpen::Failed
    }
}

// Selection-min over unmarked entries — the upstream sort_by_key(base) drain
// (entries with hi <= lo never materialize upstream: their size is 0).
machine LinuxMemoryQueryer::emit_min(&mut self) -> bool {
    transition self.mod_emit < self.mod_count {
        true -> scan()
        false -> miss()
    }

    state scan(&mut self) -> bool {
        self.k_index = 0;
        self.have_sel = false;
        transition { _ -> step() }
    }

    state step(&mut self) -> bool {
        transition self.k_index < self.mod_count {
            true -> consider()
            false -> verdict()
        }
    }

    state consider(&mut self) -> bool {
        transition self.mod_mark_at(self.k_index) == 0 && self.mod_lo_at(self.k_index) < self.mod_hi_at(self.k_index) {
            true -> candidate()
            false -> advance()
        }
    }

    state candidate(&mut self) -> bool {
        transition self.have_sel == false || self.mod_lo_at(self.k_index) < self.mod_lo_at(self.sel_index) {
            true -> take()
            false -> advance()
        }
    }

    state take(&mut self) -> bool {
        self.sel_index = self.k_index;
        self.have_sel = true;
        transition { _ -> advance() }
    }

    state advance(&mut self) -> bool {
        self.k_index = ((self.k_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> step() }
    }

    state verdict(&mut self) -> bool {
        self.have_sel
    }

    state miss(&mut self) -> bool {
        false
    }
}

// Basename bounds for the selected entry — upstream's Path::file_name with
// the full-path fallback (a name that's all separators, or no separator,
// yields the whole path).
machine LinuxMemoryQueryer::module_name_bounds(&mut self) {
    self.emit_base = self.mod_off_at(self.sel_index);
    self.emit_size = ((self.emit_base as u64 in Wrapping) + (self.mod_len_at(self.sel_index) as u64 in Wrapping)) as u64;
    transition { _ -> trim_slash() }

    // file_name ignores trailing separators.
    state trim_slash(&mut self) {
        transition self.emit_size > self.emit_base && self.mod_path_at(((self.emit_size as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64) == 47 {
            true -> trim_step()
            false -> scan_back()
        }
    }

    state trim_step(&mut self) {
        self.emit_size = ((self.emit_size as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        transition { _ -> trim_slash() }
    }

    state scan_back(&mut self) {
        self.k_index = self.emit_size;
        transition { _ -> back_step() }
    }

    state back_step(&mut self) {
        transition self.k_index > self.emit_base {
            true -> back_byte()
            false -> whole()
        }
    }

    state back_byte(&mut self) {
        self.k_index = ((self.k_index as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        transition self.mod_path_at(self.k_index) == 47 {
            true -> named()
            false -> back_step()
        }
    }

    state named(&mut self) {
        self.id_lo = ((self.k_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        self.id_hi = self.emit_size;
        transition { _ -> done() }
    }

    state whole(&mut self) {
        transition self.emit_size > self.emit_base {
            true -> bounded()
            false -> fallback()
        }
    }

    state bounded(&mut self) {
        self.id_lo = self.emit_base;
        self.id_hi = self.emit_size;
        transition { _ -> done() }
    }

    state fallback(&mut self) {
        self.id_lo = self.mod_off_at(self.sel_index);
        self.id_hi = ((self.id_lo as u64 in Wrapping) + (self.mod_len_at(self.sel_index) as u64 in Wrapping)) as u64;
        transition { _ -> done() }
    }

    state done(&mut self) {
    }
}

// Upstream resolve compares module_name().trim(): an ASCII-whitespace trim
// (space/tab/LF/CR) applied to the selected name bounds at compare time.
machine LinuxMemoryQueryer::ws_trim_bounds(&mut self) {
    transition { _ -> ws_front() }

    state ws_front(&mut self) {
        self.byte = self.mod_path_at(self.id_lo);
        transition self.id_lo < self.id_hi && self.is_ws(self.byte) {
            true -> ws_front_step()
            false -> ws_back()
        }
    }

    state ws_front_step(&mut self) {
        self.id_lo = ((self.id_lo as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> ws_front() }
    }

    state ws_back(&mut self) {
        self.byte = self.mod_path_at(((self.id_hi as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64);
        transition self.id_hi > self.id_lo && self.is_ws(self.byte) {
            true -> ws_back_step()
            false -> done()
        }
    }

    state ws_back_step(&mut self) {
        self.id_hi = ((self.id_hi as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        transition { _ -> ws_back() }
    }

    state done(&mut self) {
    }
}

machine LinuxMemoryQueryer::is_ws(&mut self, byte: u8) -> bool {
    byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 11 || byte == 12
}

// Write the selected table entry's basename + merged region into `module`
// (upstream NormalizedModule::new(name, lo, hi - lo)). set_module_name owns
// the bounded copy into the fixed name buffer.
machine LinuxMemoryQueryer::fill_module(&mut self, module: &mut NormalizedModule) {
    self.module_name_bounds();
    transition { _ -> bounds_ok(module) }

    state bounds_ok(&mut self, module: &mut NormalizedModule) {
        transition self.id_lo <= self.id_hi && self.id_hi <= self.mod_paths.len {
            true -> fill(module)
            false -> done()
        }
    }

    state fill(&mut self, module: &mut NormalizedModule) {
        module.set_module_name(self.mod_paths[self.id_lo..self.id_hi]);
        module.set_base_address(self.mod_lo_at(self.sel_index));
        module.set_region_size(((self.mod_hi_at(self.sel_index) as u64 in Wrapping) - (self.mod_lo_at(self.sel_index) as u64 in Wrapping)) as u64);
        module.set_module_address_display(ModuleAddressDisplay::ModuleRelative);
        transition { _ -> done() }
    }

    state done(&mut self) {
    }
}

// The get_modules stream: each call yields the next lowest-base module.
pub linux_x86_64 machine LinuxMemoryQueryer::next_module(
    &mut self,
    module: &mut NormalizedModule
) -> ModuleStreamStep
satisfies MemoryQueryerTrait::next_module
{
    transition self.emit_min() {
        true -> emit(module)
        false -> fin()
    }

    state emit(&mut self, module: &mut NormalizedModule) -> ModuleStreamStep {
        self.mod_mark_put(self.sel_index);
        self.mod_emit = ((self.mod_emit as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        self.fill_module(module);
        transition { _ -> yielded() }
    }

    state yielded(&mut self) -> ModuleStreamStep {
        ModuleStreamStep::Module
    }

    state fin(&mut self) -> ModuleStreamStep {
        ModuleStreamStep::Finished
    }
}

// One module entry as a bare NormalizedRegion (FromModules' drain).
machine LinuxMemoryQueryer::next_module_region(
    &mut self,
    region: &mut normalized_region::NormalizedRegion
) -> MemoryBoundsStep {
    transition self.emit_min() {
        true -> emit(region)
        false -> fin()
    }

    state emit(&mut self, region: &mut normalized_region::NormalizedRegion) -> MemoryBoundsStep {
        self.mod_mark_put(self.sel_index);
        self.mod_emit = ((self.mod_emit as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        region.set_base_address(self.mod_lo_at(self.sel_index));
        region.set_region_size(((self.mod_hi_at(self.sel_index) as u64 in Wrapping) - (self.mod_lo_at(self.sel_index) as u64 in Wrapping)) as u64);
        transition { _ -> yielded() }
    }

    state yielded(&mut self) -> MemoryBoundsStep {
        MemoryBoundsStep::Region
    }

    state fin(&mut self) -> MemoryBoundsStep {
        MemoryBoundsStep::Finished
    }
}

// FromNonModules' emit filter: emit_base equals a module base address.
machine LinuxMemoryQueryer::base_in_modules(&mut self) -> bool {
    self.k_index = 0;
    transition { _ -> scan() }

    state scan(&mut self) -> bool {
        transition self.k_index < self.mod_count {
            true -> cmp()
            false -> miss()
        }
    }

    state cmp(&mut self) -> bool {
        transition self.mod_lo_at(self.k_index) < self.mod_hi_at(self.k_index) && self.mod_lo_at(self.k_index) == self.emit_base {
            true -> hit()
            false -> step()
        }
    }

    state step(&mut self) -> bool {
        self.k_index = ((self.k_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> scan() }
    }

    state hit(&mut self) -> bool {
        true
    }

    state miss(&mut self) -> bool {
        false
    }
}

// The canonical module key for the current line's pathname: collapse every
// run of spaces/tabs to one space (upstream's split_whitespace + join(" "))
// and strip a trailing " (deleted)" (upstream's normalize_module_path).
machine LinuxMemoryQueryer::canon_path(&mut self) {
    self.canon_len = 0;
    self.space_run = false;
    self.k_index = 0;
    transition { _ -> step() }

    state step(&mut self) {
        transition self.k_index < self.pathname_len {
            true -> canon_byte()
            false -> strip()
        }
    }

    state canon_byte(&mut self) {
        self.byte = self.buf_byte_at(((self.scan_pos as u64 in Wrapping) + (self.k_index as u64 in Wrapping)) as u64);
        transition self.byte == 32 || self.byte == 9 {
            true -> space()
            false -> put()
        }
    }

    state space(&mut self) {
        transition self.space_run {
            true -> adv()
            false -> space_put()
        }
    }

    state space_put(&mut self) {
        transition self.canon_len < 4096 {
            true -> space_store()
            false -> adv()
        }
    }

    state space_store(&mut self) {
        self.canon_set(self.canon_len, 32);
        self.canon_len = ((self.canon_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        self.space_run = true;
        transition { _ -> adv() }
    }

    state put(&mut self) {
        transition self.canon_len < 4096 {
            true -> byte_store()
            false -> adv()
        }
    }

    state byte_store(&mut self) {
        self.canon_set(self.canon_len, self.byte);
        self.canon_len = ((self.canon_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        self.space_run = false;
        transition { _ -> adv() }
    }

    state adv(&mut self) {
        self.k_index = ((self.k_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> step() }
    }

    // " (deleted)" — 32,100,101,108,101,116,101,100,41, plus its leading
    // space at index canon_len - 10.
    state strip(&mut self) {
        transition self.canon_len >= 10 && self.canon_at(((self.canon_len as u64 in Wrapping) - (10 as u64 in Wrapping)) as u64) == 32 && self.canon_at(((self.canon_len as u64 in Wrapping) - (9 as u64 in Wrapping)) as u64) == 100 && self.canon_at(((self.canon_len as u64 in Wrapping) - (8 as u64 in Wrapping)) as u64) == 101 && self.canon_at(((self.canon_len as u64 in Wrapping) - (7 as u64 in Wrapping)) as u64) == 108 && self.canon_at(((self.canon_len as u64 in Wrapping) - (6 as u64 in Wrapping)) as u64) == 101 && self.canon_at(((self.canon_len as u64 in Wrapping) - (5 as u64 in Wrapping)) as u64) == 116 && self.canon_at(((self.canon_len as u64 in Wrapping) - (4 as u64 in Wrapping)) as u64) == 101 && self.canon_at(((self.canon_len as u64 in Wrapping) - (3 as u64 in Wrapping)) as u64) == 100 && self.canon_at(((self.canon_len as u64 in Wrapping) - (2 as u64 in Wrapping)) as u64) == 41 && self.canon_at(((self.canon_len as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64) == 41 {
            true -> strip_do()
            false -> done()
        }
    }

    state strip_do(&mut self) {
        self.canon_len = ((self.canon_len as u64 in Wrapping) - (10 as u64 in Wrapping)) as u64;
        transition { _ -> done() }
    }

    state done(&mut self) {
    }
}

// Dedupe hash over the canonical key (any uniform hash — byte equality is
// still the authority; the hash only prunes compares).
machine LinuxMemoryQueryer::hash_path(&mut self) {
    self.hash = 5381;
    self.k_index = 0;
    transition { _ -> step() }

    state step(&mut self) {
        transition self.k_index < self.canon_len {
            true -> mix()
            false -> done()
        }
    }

    state mix(&mut self) {
        self.hash = ((((self.hash as u64 in Wrapping) * (65599 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (self.canon_at(self.k_index) as u64 in Wrapping)) as u64;
        self.k_index = ((self.k_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> step() }
    }

    state done(&mut self) {
    }
}

// Table lookup for the current canon+hash: linear scan, byte-equal compare.
machine LinuxMemoryQueryer::table_find(&mut self) -> bool {
    self.k_index = 0;
    transition { _ -> scan() }

    state scan(&mut self) -> bool {
        transition self.k_index < self.mod_count {
            true -> hash_cmp()
            false -> miss()
        }
    }

    state hash_cmp(&mut self) -> bool {
        transition self.mod_hash_at(self.k_index) == self.hash && self.mod_len_at(self.k_index) == self.canon_len {
            true -> byte_cmp()
            false -> advance()
        }
    }

    state byte_cmp(&mut self) -> bool {
        self.cmp_j = 0;
        transition { _ -> byte_scan() }
    }

    state byte_scan(&mut self) -> bool {
        transition self.cmp_j < self.canon_len {
            true -> byte_eq()
            false -> hit()
        }
    }

    state byte_eq(&mut self) -> bool {
        transition self.mod_path_at(((self.mod_off_at(self.k_index) as u64 in Wrapping) + (self.cmp_j as u64 in Wrapping)) as u64) == self.canon_at(self.cmp_j) {
            true -> byte_step()
            false -> advance()
        }
    }

    state byte_step(&mut self) -> bool {
        self.cmp_j = ((self.cmp_j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> byte_scan() }
    }

    state hit(&mut self) -> bool {
        self.found_index = self.k_index;
        transition { _ -> yes() }
    }

    state advance(&mut self) -> bool {
        self.k_index = ((self.k_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> scan() }
    }

    state yes(&mut self) -> bool {
        true
    }

    state miss(&mut self) -> bool {
        false
    }
}

// Upstream resolve_module: identifier.trim(), then the first module (in the
// upstream Vec's base-sorted order) whose trimmed name equals the identifier
// case-insensitively; unresolved -> 0.
pub linux_x86_64 machine LinuxMemoryQueryer::resolve_module(
    &mut self,
    process_info: &OpenedProcessInfo,
    identifier: &[u8]
) -> u64
satisfies MemoryQueryerTrait::resolve_module
reaches FilesystemHost
invokes FilesystemHost;
{
    self.ident_lo = 0;
    self.ident_hi = identifier.len;
    transition { _ -> trim_front(process_info, identifier) }

    state trim_front(&mut self, process_info: &OpenedProcessInfo, identifier: &[u8]) -> u64 {
        transition self.ident_lo < self.ident_hi && self.ident_lo < identifier.len {
            true -> tf_cmp(process_info, identifier)
            false -> trim_back(process_info, identifier)
        }
    }

    state tf_cmp(&mut self, process_info: &OpenedProcessInfo, identifier: &[u8]) -> u64 {
        self.byte = self.byte_at(identifier, self.ident_lo);
        transition self.is_space(self.byte) {
            true -> trim_front_step(process_info, identifier)
            false -> trim_back(process_info, identifier)
        }
    }

    state trim_front_step(&mut self, process_info: &OpenedProcessInfo, identifier: &[u8]) -> u64 {
        self.ident_lo = ((self.ident_lo as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> trim_front(process_info, identifier) }
    }

    state trim_back(&mut self, process_info: &OpenedProcessInfo, identifier: &[u8]) -> u64 {
        self.byte_pos = ((self.ident_hi as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        transition self.ident_hi > self.ident_lo && self.byte_pos < identifier.len {
            true -> tb_cmp(process_info, identifier)
            false -> non_empty(process_info, identifier)
        }
    }

    state tb_cmp(&mut self, process_info: &OpenedProcessInfo, identifier: &[u8]) -> u64 {
        self.byte = self.byte_at(identifier, self.byte_pos);
        transition self.is_space(self.byte) {
            true -> trim_back_step(process_info, identifier)
            false -> non_empty(process_info, identifier)
        }
    }

    state trim_back_step(&mut self, process_info: &OpenedProcessInfo, identifier: &[u8]) -> u64 {
        self.ident_hi = ((self.ident_hi as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        transition { _ -> trim_back(process_info, identifier) }
    }

    state non_empty(&mut self, process_info: &OpenedProcessInfo, identifier: &[u8]) -> u64 {
        transition self.ident_lo < self.ident_hi {
            true -> build(process_info, identifier)
            false -> miss()
        }
    }

    state build(&mut self, process_info: &OpenedProcessInfo, identifier: &[u8]) -> u64 {
        let open: MemoryBoundsOpen = self.open_modules(process_info);
        transition open {
            MemoryBoundsOpen::Opened -> scan(identifier)
            MemoryBoundsOpen::Failed -> miss()
        }
    }

    state scan(&mut self, identifier: &[u8]) -> u64 {
        transition self.emit_min() {
            true -> compare(identifier)
            false -> miss()
        }
    }

    state compare(&mut self, identifier: &[u8]) -> u64 {
        self.mod_mark_put(self.sel_index);
        self.mod_emit = ((self.mod_emit as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        self.module_name_bounds();
        self.ws_trim_bounds();
        transition self.name_eq(identifier) {
            true -> hit()
            false -> scan(identifier)
        }
    }

    state hit(&mut self) -> u64 {
        self.mod_lo_at(self.sel_index)
    }

    state miss(&mut self) -> u64 {
        0
    }
}

// Case-insensitive compare: the selected module's basename (id_lo..id_hi in
// the slab) against identifier[ident_lo..ident_hi].
machine LinuxMemoryQueryer::name_eq(&mut self, identifier: &[u8]) -> bool {
    transition ((self.id_hi as u64 in Wrapping) - (self.id_lo as u64 in Wrapping)) as u64 == ((self.ident_hi as u64 in Wrapping) - (self.ident_lo as u64 in Wrapping)) as u64 {
        true -> begin(identifier)
        false -> miss()
    }

    state begin(&mut self, identifier: &[u8]) -> bool {
        self.cmp_i = 0;
        transition { _ -> scan(identifier) }
    }

    state scan(&mut self, identifier: &[u8]) -> bool {
        transition (((self.id_lo as u64 in Wrapping) + (self.cmp_i as u64 in Wrapping)) as u64) < self.id_hi {
            true -> byte_cmp(identifier)
            false -> hit()
        }
    }

    state byte_cmp(&mut self, identifier: &[u8]) -> bool {
        self.byte_pos = ((self.ident_lo as u64 in Wrapping) + (self.cmp_i as u64 in Wrapping)) as u64;
        self.byte = self.mod_path_at(((self.id_lo as u64 in Wrapping) + (self.cmp_i as u64 in Wrapping)) as u64);
        self.byte = self.lower_fold(self.byte);
        transition self.byte_pos < identifier.len {
            true -> ident_cmp(identifier)
            false -> miss()
        }
    }

    state ident_cmp(&mut self, identifier: &[u8]) -> bool {
        self.peer_byte = self.byte_at(identifier, self.byte_pos);
        self.peer_byte = self.lower_fold(self.peer_byte);
        transition self.byte == self.peer_byte {
            true -> step(identifier)
            false -> miss()
        }
    }

    state step(&mut self, identifier: &[u8]) -> bool {
        self.cmp_i = ((self.cmp_i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> scan(identifier) }
    }

    state hit(&mut self) -> bool {
        true
    }

    state miss(&mut self) -> bool {
        false
    }
}

machine LinuxMemoryQueryer::is_space(&mut self, byte: u8) -> bool {
    byte == 32 || byte == 9 || byte == 10 || byte == 13 || byte == 11 || byte == 12
}

machine LinuxMemoryQueryer::lower_fold(&mut self, byte: u8) -> u8 {
    transition byte >= 65 && byte <= 90 {
        true -> fold(byte)
        false -> same(byte)
    }

    state fold(&mut self, byte: u8) -> u8 {
        ((byte as u8 in Wrapping) + (32 as u8 in Wrapping)) as u8
    }

    state same(&mut self, byte: u8) -> u8 {
        byte
    }
}

// resolve_module_address = resolve_module(...).checked_add(offset): only a
// u64 overflow is Unresolvable — an unknown module resolves to `offset`
// itself (base 0), exactly as upstream.
pub linux_x86_64 machine LinuxMemoryQueryer::resolve_module_address(
    &mut self,
    process_info: &OpenedProcessInfo,
    identifier: &[u8],
    offset: u64
) -> ResolvedModuleAddress
satisfies MemoryQueryerTrait::resolve_module_address
reaches FilesystemHost
invokes FilesystemHost;
{
    let base: u64 = self.resolve_module(process_info, identifier);
    let sum: u64 = ((base as u64 in Wrapping) + (offset as u64 in Wrapping)) as u64;
    transition sum < base {
        true -> unresolvable()
        false -> resolved(sum)
    }

    state resolved(&mut self, address: u64) -> ResolvedModuleAddress {
        ResolvedModuleAddress::Resolved { address: address }
    }

    state unresolvable(&mut self) -> ResolvedModuleAddress {
        ResolvedModuleAddress::Unresolvable
    }
}

// Upstream address_to_module: the first (base-sorted) module containing the
// address; Hit carries address - base and fills `module` with the entry.
pub linux_x86_64 machine LinuxMemoryQueryer::address_to_module(
    &mut self,
    process_info: &OpenedProcessInfo,
    address: u64,
    module: &mut NormalizedModule
) -> AddressModuleResult
satisfies MemoryQueryerTrait::address_to_module
reaches FilesystemHost
invokes FilesystemHost;
{
    let open: MemoryBoundsOpen = self.open_modules(process_info);
    transition open {
        MemoryBoundsOpen::Opened -> scan(address, module)
        MemoryBoundsOpen::Failed -> miss()
    }

    state scan(&mut self, address: u64, module: &mut NormalizedModule) -> AddressModuleResult {
        transition self.emit_min() {
            true -> contains(address, module)
            false -> miss()
        }
    }

    state contains(&mut self, address: u64, module: &mut NormalizedModule) -> AddressModuleResult {
        self.mod_mark_put(self.sel_index);
        self.mod_emit = ((self.mod_emit as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        // contains_address is end-inclusive upstream: [base, base+size] —
        // the merged hi is base+size, so the bound is <= not <.
        transition self.mod_lo_at(self.sel_index) <= address && address <= self.mod_hi_at(self.sel_index) {
            true -> hit(address, module)
            false -> scan(address, module)
        }
    }

    state hit(&mut self, address: u64, module: &mut NormalizedModule) -> AddressModuleResult {
        self.fill_module(module);
        let offset: u64 = ((address as u64 in Wrapping) - (self.mod_lo_at(self.sel_index) as u64 in Wrapping)) as u64;
        AddressModuleResult::Hit { offset: offset }
    }

    state miss(&mut self) -> AddressModuleResult {
        AddressModuleResult::Miss
    }
}

// Bounded accessors for the module tables: positions arrive as ordinary args
// (computed expressions allowed); the internal guard discharges the index
// proof. Out-of-range reads yield a sentinel that cannot match a live query
// (mark→1 "used", lo→u64::MAX, hi→0, off→slab end, len/hash→0, path byte→0);
// writes out of range are dropped (unreachable by construction).
machine LinuxMemoryQueryer::mod_lo_at(&mut self, index: u64) -> u64 {
    transition index < 512 {
        true -> hit(index)
        false -> miss()
    }
    state hit(&mut self, index: u64) -> u64 { self.mod_lo[index] }
    state miss(&mut self) -> u64 { 18446744073709551615 }
}

machine LinuxMemoryQueryer::mod_hi_at(&mut self, index: u64) -> u64 {
    transition index < 512 {
        true -> hit(index)
        false -> miss()
    }
    state hit(&mut self, index: u64) -> u64 { self.mod_hi[index] }
    state miss(&mut self) -> u64 { 0 }
}

machine LinuxMemoryQueryer::mod_off_at(&mut self, index: u64) -> u64 {
    transition index < 512 {
        true -> hit(index)
        false -> miss()
    }
    state hit(&mut self, index: u64) -> u64 { self.mod_off[index] }
    state miss(&mut self) -> u64 { 32768 }
