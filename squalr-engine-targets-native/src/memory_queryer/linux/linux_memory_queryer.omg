    this: &mut LinuxMemoryQueryer,
    process_info: &OpenedProcessInfo
) -> MemoryBoundsOpen
satisfies MemoryQueryerTrait<LinuxMemoryQueryer>::open_modules
reaches FilesystemHost
invokes FilesystemHost;
{
    transition { _ -> start(this, process_info) }

    state start(this: &mut LinuxMemoryQueryer, process_info: &OpenedProcessInfo) -> MemoryBoundsOpen {
        this.mod_count = 0;
        this.mod_paths_len = 0;
        this.mod_emit = 0;
        this.mod_modules_out = false;
        this.non_modules = false;
        this.scan_kind = 1;
        let ok: BoolResult = LinuxMemoryQueryer::acquire_maps(&mut this, process_info);
        transition ok.v {
            true -> drain(this)
            _ -> suppressed(this)
        }
    }

    state drain(this: &mut LinuxMemoryQueryer) -> MemoryBoundsOpen {
        let step: MemoryBoundsStep = LinuxMemoryQueryer::next_virtual_page(&mut this, &mut this.walk_region);
        // Three-way kind dispatch — union scrutinees are admitted on
        // params, not locals, so the split rides a hop state.
        transition {
            _ -> step_kind(this, step)
        }
    }

    state step_kind(this: &mut LinuxMemoryQueryer, step: MemoryBoundsStep) -> MemoryBoundsOpen {
        transition step {
            MemoryBoundsStep::Region -> drain(this)
            MemoryBoundsStep::Finished -> built(this)
            _ -> failed(this)
        }
    }

    state built(this: &mut LinuxMemoryQueryer) -> MemoryBoundsOpen {
        this.scan_kind = 0;
        MemoryBoundsOpen::Opened
    }

    state suppressed(this: &mut LinuxMemoryQueryer) -> MemoryBoundsOpen {
        this.suppress_all = true;
        this.scan_kind = 0;
        this.mod_count = 0;
        MemoryBoundsOpen::Opened
    }

    state failed(this: &mut LinuxMemoryQueryer) -> MemoryBoundsOpen {
        this.scan_kind = 0;
        MemoryBoundsOpen::Failed
    }
}

// FromModules: the module stream drained as bare base regions.
