use {omega}/language/core/filesystem_authority.omg;
use {squalr_engine_api}/src/structures/memory/normalized_region.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_targets}/src/target_providers.omg;
use src/memory_queryer/normalized_module.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;

// Crate-internal contract for the per-OS memory query impl (upstream's
// `MemoryQueryerImpl` type alias stands in for a trait — the iface is the
// Linux impl's own op set). The provider owns the enumeration state; callers
// pull NormalizedRegion values until MemoryBoundsStep::Finished.
public trait MemoryQueryerTrait<Provider> {
    machine open_virtual_pages(
        provider: &mut Provider,
        process_info: &|opened_process_info|::OpenedProcessInfo,
        required_bits: u32,
        excluded_bits: u32,
        allowed_bits: u32,
        start_address: u64,
        end_address: u64,
        bounds_tag: u8
    ) -> |target_providers|::MemoryBoundsOpen
    reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
    invokes |posix_filesystem_host|::PosixFilesystemHost;

    machine next_virtual_page(
        provider: &mut Provider,
        region: &mut |normalized_region|::NormalizedRegion
    ) -> |target_providers|::MemoryBoundsStep
    reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
    invokes |posix_filesystem_host|::PosixFilesystemHost;

    machine close_enumeration(provider: &mut Provider)
    reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
    invokes |posix_filesystem_host|::PosixFilesystemHost;

    machine get_all_virtual_pages(
        provider: &mut Provider,
        process_info: &|opened_process_info|::OpenedProcessInfo
    ) -> |target_providers|::MemoryBoundsOpen
    reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
    invokes |posix_filesystem_host|::PosixFilesystemHost;

    machine is_address_writable(
        provider: &mut Provider,
        process_info: &|opened_process_info|::OpenedProcessInfo,
        address: u64
    ) -> |target_providers|::AddressWritable
    reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
    invokes |posix_filesystem_host|::PosixFilesystemHost;

    machine get_maximum_address(provider: &Provider, process_info: &|opened_process_info|::OpenedProcessInfo) -> u64;
    machine get_min_usermode_address(provider: &Provider, process_info: &|opened_process_info|::OpenedProcessInfo) -> u64;
    machine get_max_usermode_address(provider: &Provider, process_info: &|opened_process_info|::OpenedProcessInfo) -> u64;

    // The module surface (upstream's get_modules / address_to_module /
    // resolve_module / resolve_module_address): the Vec<NormalizedModule>
    // materialization becomes a provider stream (open_modules/next_module);
    // the lookups take process_info + identifier/address because the port
    // owns the table rather than accepting it by argument.
    machine open_modules(
        provider: &mut Provider,
        process_info: &|opened_process_info|::OpenedProcessInfo
    ) -> |target_providers|::MemoryBoundsOpen
    reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
    invokes |posix_filesystem_host|::PosixFilesystemHost;

    machine next_module(
        provider: &mut Provider,
        module: &mut |normalized_module|::NormalizedModule
    ) -> |normalized_module|::ModuleStreamStep;

    machine resolve_module(
        provider: &mut Provider,
        process_info: &|opened_process_info|::OpenedProcessInfo,
        identifier: &[u8]
    ) -> u64
    reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
    invokes |posix_filesystem_host|::PosixFilesystemHost;

    machine resolve_module_address(
        provider: &mut Provider,
        process_info: &|opened_process_info|::OpenedProcessInfo,
        identifier: &[u8],
        offset: u64
    ) -> |normalized_module|::ResolvedModuleAddress
    reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
    invokes |posix_filesystem_host|::PosixFilesystemHost;

    machine address_to_module(
        provider: &mut Provider,
        process_info: &|opened_process_info|::OpenedProcessInfo,
        address: u64,
        module: &mut |normalized_module|::NormalizedModule
    ) -> |normalized_module|::AddressModuleResult
    reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
    invokes |posix_filesystem_host|::PosixFilesystemHost;
}
