module src::memory_queryer::memory_queryer_trait;

use squalr_engine_api::src::structures::memory::normalized_region;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_targets::src::target_providers::MemoryBoundsOpen;
use squalr_engine_targets::src::target_providers::MemoryBoundsStep;
use omega_language_std::filesystem_host;
use src::memory_queryer::memory_protection_enum::MemoryProtectionEnum;
use src::memory_queryer::memory_type_enum::MemoryTypeEnum;
use src::memory_queryer::region_bounds_handling::RegionBoundsHandling;

// Crate-internal contract for the per-OS memory query impl (upstream's
// `MemoryQueryerImpl` type alias stands in for a trait — the iface is the
// Linux impl's own op set). The provider owns the enumeration state; callers
// pull NormalizedRegion values until MemoryBoundsStep::Finished.
pub trait MemoryQueryerTrait {
    machine open_virtual_pages(
        &mut self,
        process_info: &OpenedProcessInfo,
        required_protection: MemoryProtectionEnum,
        excluded_protection: MemoryProtectionEnum,
        allowed_types: MemoryTypeEnum,
        start_address: u64,
        end_address: u64,
        region_bounds_handling: RegionBoundsHandling
    ) -> MemoryBoundsOpen
    reaches FilesystemHost
    invokes FilesystemHost;

    machine next_virtual_page(
        &mut self,
        region: &mut normalized_region::NormalizedRegion
    ) -> MemoryBoundsStep
    reaches FilesystemHost
    invokes FilesystemHost;

    machine close_enumeration(&mut self)
    reaches FilesystemHost
    invokes FilesystemHost;

    machine get_all_virtual_pages(
        &mut self,
        process_info: &OpenedProcessInfo
    ) -> MemoryBoundsOpen
    reaches FilesystemHost
    invokes FilesystemHost;

    machine is_address_writable(
        &mut self,
        process_info: &OpenedProcessInfo,
        address: u64
    ) -> bool
    reaches FilesystemHost
    invokes FilesystemHost;

    machine get_maximum_address(&self, process_info: &OpenedProcessInfo) -> u64;
    machine get_min_usermode_address(&self, process_info: &OpenedProcessInfo) -> u64;
    machine get_max_usermode_address(&self, process_info: &OpenedProcessInfo) -> u64;
}
