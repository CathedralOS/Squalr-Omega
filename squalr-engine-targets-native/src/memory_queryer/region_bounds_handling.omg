module src::memory_queryer::region_bounds_handling;

// Port of memory_queryer/region_bounds_handling.rs.
pub data RegionBoundsHandling [copy] {
    case Exclude;
    case Include;
    case Resize;
}

pub machine RegionBoundsHandling::tag(this: &RegionBoundsHandling) -> u64
ensures 0 <= result && result < 3;
{
    transition this {
        RegionBoundsHandling::Exclude -> (0)
        RegionBoundsHandling::Include -> (1)
        _ -> (2)
    }
}
