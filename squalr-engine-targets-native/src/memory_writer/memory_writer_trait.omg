module src::memory_writer::memory_writer_trait;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_targets::src::target_providers::MemoryWriteResult;

// Port of memory_writer/memory_writer_trait.rs. Upstream returns bool; the
// short-write count stays observable here for the same partial-write reason.
pub trait MemoryWriterTrait {
    machine write_bytes(
        &mut self,
        process_info: &OpenedProcessInfo,
        address: u64,
        values: &[u8]
    ) -> MemoryWriteResult
    reaches FilesystemHost
    invokes FilesystemHost;
}
