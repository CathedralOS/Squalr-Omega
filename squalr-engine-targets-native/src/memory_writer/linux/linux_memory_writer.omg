module src::memory_writer::linux::linux_memory_writer;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_targets::src::target_providers::MemoryWriteResult;
use src::memory_writer::memory_writer_trait::MemoryWriterTrait;
use src::proc_paths::ProcName;

// Port of memory_writer/linux/linux_memory_writer.rs. Upstream writes through
// process_vm_writev (with a fallback /proc/pid/mem write); Omega's positioned
// write on /proc/<pid>/mem opened O_RDWR is the same kernel mechanism. Partial
// writes surface their count rather than collapsing to false.
pub data LinuxMemoryWriter {
    proc_fd: i32;
    mem_fd: i32;
    count: i64;
    expected: u64;
    scratch: i32;
    name: ProcName;
}

pub linux_x86_64 machine LinuxMemoryWriter::write_bytes(
    linux_memory_writer: &mut LinuxMemoryWriter,
    process_info: &OpenedProcessInfo,
    address: u64,
    values: &[u8]
) -> MemoryWriteResult
satisfies MemoryWriterTrait::write_bytes
reaches FilesystemHost
invokes FilesystemHost;
{
    linux_memory_writer.expected = values.len;
    transition values.len == 0 {
        true -> MemoryWriteResult::Complete { count: 0 }
        false -> open_proc(linux_memory_writer, process_info, address, values)
    }

    state open_proc(
        linux_memory_writer: &mut LinuxMemoryWriter,
        process_info: &OpenedProcessInfo,
        address: u64,
        values: &[u8]
    ) -> MemoryWriteResult {
        let _proc_fd_r: i32 = FilesystemHost::open("/proc", 65536);
        linux_memory_writer.proc_fd = _proc_fd_r;
        transition _proc_fd_r >= 0 {
            true -> open_mem(linux_memory_writer, process_info, address, values)
            false -> failed(linux_memory_writer)
        }
    }

    state open_mem(
        linux_memory_writer: &mut LinuxMemoryWriter,
        process_info: &OpenedProcessInfo,
        address: u64,
        values: &[u8]
    ) -> MemoryWriteResult {
        let pid: u32 = OpenedProcessInfo::get_process_id_raw(process_info);
        linux_memory_writer.name = ProcName::for_process(pid, 109, 101, 109, 0, 3);
        transition linux_memory_writer.name.len <= 48 {
            true -> open_mem_at(linux_memory_writer, address, values, linux_memory_writer.name.len)
            false -> open_mem_at(linux_memory_writer, address, values, 48)
        }
    }

    state open_mem_at(linux_memory_writer: &mut LinuxMemoryWriter, address: u64, values: &[u8], name_len: u64) -> MemoryWriteResult {
        let procfd: i32 = linux_memory_writer.proc_fd;
        let _mem_fd_r: i32 = FilesystemHost::open_at(procfd, linux_memory_writer.name.bytes[0..48], 2);
        linux_memory_writer.mem_fd = _mem_fd_r;
        transition _mem_fd_r >= 0 {
            true -> write(linux_memory_writer, address, values)
            false -> close_proc_failed(linux_memory_writer)
        }
    }

    state write(linux_memory_writer: &mut LinuxMemoryWriter, address: u64, values: &[u8]) -> MemoryWriteResult {
        let memfd: i32 = linux_memory_writer.mem_fd;
        let off: i64 = ((address as i64 in Wrapping) as i64);
        let _count_r: i64 = FilesystemHost::write_at(memfd, values, off);
        linux_memory_writer.count = _count_r;
        let _u1: i32 = FilesystemHost::close(linux_memory_writer.mem_fd);
        linux_memory_writer.scratch = _u1;
        let _u2: i32 = FilesystemHost::close(linux_memory_writer.proc_fd);
        linux_memory_writer.scratch = _u2;
        transition _count_r < 0 {
            true -> failed(linux_memory_writer)
            false -> classify(linux_memory_writer)
        }
    }

    state classify(linux_memory_writer: &mut LinuxMemoryWriter) -> MemoryWriteResult {
        transition ((linux_memory_writer.count as u64 in Wrapping) as u64) == linux_memory_writer.expected {
            true -> MemoryWriteResult::Complete { count: ((linux_memory_writer.count as u64 in Wrapping) as u64) }
            false -> MemoryWriteResult::Partial { count: ((linux_memory_writer.count as u64 in Wrapping) as u64) }
        }
    }

    state close_proc_failed(linux_memory_writer: &mut LinuxMemoryWriter) -> MemoryWriteResult {
        let _u3: i32 = FilesystemHost::close(linux_memory_writer.proc_fd);
        linux_memory_writer.scratch = _u3;
        transition { _ -> failed(linux_memory_writer) }
    }

    state failed(linux_memory_writer: &mut LinuxMemoryWriter) -> MemoryWriteResult {
        MemoryWriteResult::Failed
    }
}
