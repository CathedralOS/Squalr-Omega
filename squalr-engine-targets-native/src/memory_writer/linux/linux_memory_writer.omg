module src::memory_writer::linux::linux_memory_writer;

use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;
use omega_language_std::filesystem_host;
use omega_language_std::posix_filesystem_host;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_targets::src::target_providers::MemoryWriteResult;
use src::memory_writer::memory_writer_trait::MemoryWriterTrait;
use src::proc_paths::ProcName;

// Port of memory_writer/linux/linux_memory_writer.rs. Upstream writes through
// process_vm_writev (with a fallback /proc/pid/mem write); Omega's positioned
// write on /proc/<pid>/mem opened O_RDWR is the same kernel mechanism. Partial
// writes surface their count rather than collapsing to false.
public data LinuxMemoryWriter {
    proc_fd: i32;
    mem_fd: i32;
    count: i64;
    expected: u64;
    scratch: i32;
    name: ProcName;
}

public linux_x86_64 machine LinuxMemoryWriter::write_bytes(
    this: &mut LinuxMemoryWriter,
    process_info: &OpenedProcessInfo,
    address: u64,
    values: &[u8]
) -> MemoryWriteResult
satisfies MemoryWriterTrait<LinuxMemoryWriter>::write_bytes
reaches PosixFilesystemHost + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation + DirectoryEnumeration + FilesystemNamespaceMutation
invokes PosixFilesystemHost;
{
    this.expected = values.len;
    transition values.len == 0 {
        true -> MemoryWriteResult::Complete { count: 0 }
        false -> open_proc(this, process_info, address, values)
    }

    machine open_proc(
        this: &mut LinuxMemoryWriter,
        process_info: &OpenedProcessInfo,
        address: u64,
        values: &[u8]
    ) -> MemoryWriteResult {
        let _proc_fd_r: i32 = PosixFilesystemHost::open("/proc", 65536);
        this.proc_fd = _proc_fd_r;
        transition _proc_fd_r >= 0 {
            true -> open_mem(this, process_info, address, values)
            false -> failed(this)
        }
    }

    machine open_mem(
        this: &mut LinuxMemoryWriter,
        process_info: &OpenedProcessInfo,
        address: u64,
        values: &[u8]
    ) -> MemoryWriteResult {
        let pid: u32 = OpenedProcessInfo::get_process_id_raw(&process_info);
        this.name = ProcName::for_process(pid, 109, 101, 109, 0, 3);
        transition this.name.len <= 48 {
            true -> open_mem_at(this, address, values, this.name.len)
            false -> open_mem_at(this, address, values, 48)
        }
    }

    machine open_mem_at(this: &mut LinuxMemoryWriter, address: u64, values: &[u8], name_len: u64) -> MemoryWriteResult {
        let procfd: i32 = this.proc_fd;
        let _mem_fd_r: i32 = PosixFilesystemHost::open_at(procfd, this.name.bytes[0..48], 2);
        this.mem_fd = _mem_fd_r;
        transition _mem_fd_r >= 0 {
            true -> write(this, address, values)
            false -> close_proc_failed(this)
        }
    }

    machine write(this: &mut LinuxMemoryWriter, address: u64, values: &[u8]) -> MemoryWriteResult {
        let memfd: i32 = this.mem_fd;
        let off: i64 = narrow_u64_to_i64_wrapping(address);
        let _count_r: i64 = PosixFilesystemHost::write_at(memfd, values, off);
        this.count = _count_r;
        let _u1: i32 = PosixFilesystemHost::close(this.mem_fd);
        this.scratch = _u1;
        let _u2: i32 = PosixFilesystemHost::close(this.proc_fd);
        this.scratch = _u2;
        transition _count_r < 0 {
            true -> failed(this)
            false -> classify(this)
        }
    }

    machine classify(this: &mut LinuxMemoryWriter) -> MemoryWriteResult {
        transition narrow_i64_to_u64_wrapping(this.count) == this.expected {
            true -> MemoryWriteResult::Complete { count: narrow_i64_to_u64_wrapping(this.count) }
            false -> MemoryWriteResult::Partial { count: narrow_i64_to_u64_wrapping(this.count) }
        }
    }

    machine close_proc_failed(this: &mut LinuxMemoryWriter) -> MemoryWriteResult {
        let _u3: i32 = PosixFilesystemHost::close(this.proc_fd);
        this.scratch = _u3;
        transition { _ -> failed(this) }
    }

    machine failed(this: &mut LinuxMemoryWriter) -> MemoryWriteResult {
        MemoryWriteResult::Failed
    }
}
