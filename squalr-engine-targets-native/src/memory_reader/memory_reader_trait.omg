module src::memory_reader::memory_reader_trait;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_targets::src::target_providers::MemoryReadResult;

// Port of memory_reader/memory_reader_trait.rs — the crate-local read contract.
// `read` (into DataValue) and `read_struct` (into ValuedStruct) await the
// engine-api DataValue/ValuedStruct port owned by the scan items; read_bytes is
// the complete primitive both upstream ops delegate to. Upstream's bool return
// is widened to MemoryReadResult so short reads stay observable.
pub trait MemoryReaderTrait {
    machine read_bytes(
        &mut self,
        process_info: &OpenedProcessInfo,
        address: u64,
        values: &mut [u8]
    ) -> MemoryReadResult
    reaches FilesystemHost
    invokes FilesystemHost;
}
