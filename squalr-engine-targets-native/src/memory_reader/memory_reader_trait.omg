module src::memory_reader::memory_reader_trait;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::data_values::data_value::DataValue;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::structs::valued_struct::ValuedStruct;
use squalr_engine_api::src::structures::structs::valued_struct::ValuedStructPool;
use squalr_engine_targets::src::target_providers::MemoryReadResult;

// Port of memory_reader/memory_reader_trait.rs — the crate-local read contract.
// `read` (into DataValue) and `read_struct` (into ValuedStruct) delegate to
// read_bytes, the complete primitive. Upstream's bool return is widened to
// MemoryReadResult so short reads stay observable. Named deviations:
//   - Upstream allocates `vec![0u8; size]` scratch per call; there is no heap
//     growable Vec in this pin, so the caller supplies a `scratch` window
//     covering `get_size_in_bytes` bytes.
//   - `read_struct` takes the flat `ValuedStructPool` arena that replaces
//     upstream's `Box<ValuedStruct>` recursion for nested fields.
pub trait MemoryReaderTrait {
    machine read(
        &mut self,
        process_info: &OpenedProcessInfo,
        address: u64,
        data_value: &mut DataValue,
        scratch: &mut [u8]
    ) -> MemoryReadResult
    reaches FilesystemHost
    invokes FilesystemHost;

    machine read_struct(
        &mut self,
        process_info: &OpenedProcessInfo,
        address: u64,
        valued_struct: &mut ValuedStruct,
        pool: &mut ValuedStructPool,
        scratch: &mut [u8]
    ) -> MemoryReadResult
    reaches FilesystemHost
    invokes FilesystemHost;

    machine read_bytes(
        &mut self,
        process_info: &OpenedProcessInfo,
        address: u64,
        values: &mut [u8]
    ) -> MemoryReadResult
    reaches FilesystemHost
    invokes FilesystemHost;
}
