use {omega}/language/core/filesystem_authority.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/structures/data_values/data_value.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_api}/src/structures/structs/valued_struct.omg;
use {squalr_engine_targets}/src/target_providers.omg;
use src/memory_reader/memory_reader_trait.omg;
use src/proc_paths.omg;

// Port of memory_reader/linux/linux_memory_reader.rs. Upstream issues one
// process_vm_readv per read and returns bool; Omega's raw boundary for the same
// mechanism is a positioned pread on /proc/<pid>/mem — the descriptor is scoped
// to the call (mirroring process_vm_readv's per-call nature; the provider keeps
// upstream's pid-as-handle convention rather than inventing fd custody). The
// read's byte count stays observable as Complete/Partial so short reads —
// pages disappearing mid-range — are not collapsed to an opaque false.
// The service fields are ZII-established like upstream's unit struct `new()`;
// `expected`/`mem_fd`/`proc_fd`/`count`/`scratch` are per-call storage (the
// no-captured-locals lowering rule).
public data LinuxMemoryReader {
    proc_fd: i32;
    mem_fd: i32;
    count: i64;
    expected: u64;
    scratch: i32;
    name: |proc_paths|::ProcName;
}

public linux_x86_64 machine LinuxMemoryReader::read_bytes(
    this: &mut LinuxMemoryReader,
    process_info: &|opened_process_info|::OpenedProcessInfo,
    address: u64,
    values: &mut [u8]
) -> |target_providers|::MemoryReadResult
satisfies |memory_reader_trait|::MemoryReaderTrait<LinuxMemoryReader>::read_bytes
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    this.expected = values.len;
    transition values.len == 0 {
        true -> |target_providers|::MemoryReadResult::Complete { count: 0 }
        false -> open_proc(this, process_info, address, values)
    }

    machine open_proc(
        this: &mut LinuxMemoryReader,
        process_info: &|opened_process_info|::OpenedProcessInfo,
        address: u64,
        values: &mut [u8]
    ) -> |target_providers|::MemoryReadResult {
        let _proc_fd_r: i32 = |posix_filesystem_host|::PosixFilesystemHost::open("/proc", 65536);
        this.proc_fd = _proc_fd_r;
        transition _proc_fd_r >= 0 {
            true -> open_mem(this, process_info, address, values)
            false -> failed(this)
        }
    }

    machine open_mem(
        this: &mut LinuxMemoryReader,
        process_info: &|opened_process_info|::OpenedProcessInfo,
        address: u64,
        values: &mut [u8]
    ) -> |target_providers|::MemoryReadResult {
        let pid: u32 = |opened_process_info|::OpenedProcessInfo::get_process_id_raw(&process_info);
        this.name = |proc_paths|::ProcName::for_process(pid, 109, 101, 109, 0, 3);
        transition this.name.len <= 48 {
            true -> open_mem_at(this, address, values, this.name.len)
            false -> open_mem_at(this, address, values, 48)
        }
    }

    machine open_mem_at(this: &mut LinuxMemoryReader, address: u64, values: &mut [u8], name_len: u64) -> |target_providers|::MemoryReadResult {
        let procfd: i32 = this.proc_fd;
        let _mem_fd_r: i32 = |posix_filesystem_host|::PosixFilesystemHost::open_at(procfd, this.name.bytes[0..48], 0);
        this.mem_fd = _mem_fd_r;
        transition _mem_fd_r >= 0 {
            true -> read(this, address, values)
            false -> close_proc_failed(this)
        }
    }

    machine read(this: &mut LinuxMemoryReader, address: u64, values: &mut [u8]) -> |target_providers|::MemoryReadResult {
        let memfd: i32 = this.mem_fd;
        let want: u64 = this.expected;
        let off: i64 = |numeric_conversion|::narrow_u64_to_i64_wrapping(address);
        let _count_r: i64 = |posix_filesystem_host|::PosixFilesystemHost::read_at(memfd, values, want, off);
        this.count = _count_r;
        let _u1: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(this.mem_fd);
        this.scratch = _u1;
        let _u2: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(this.proc_fd);
        this.scratch = _u2;
        transition _count_r < 0 {
            true -> failed(this)
            false -> classify(this)
        }
    }

    machine classify(this: &mut LinuxMemoryReader) -> |target_providers|::MemoryReadResult {
        transition |numeric_conversion|::narrow_i64_to_u64_wrapping(this.count) == this.expected {
            true -> |target_providers|::MemoryReadResult::Complete { count: |numeric_conversion|::narrow_i64_to_u64_wrapping(this.count) }
            false -> |target_providers|::MemoryReadResult::Partial { count: |numeric_conversion|::narrow_i64_to_u64_wrapping(this.count) }
        }
    }

    machine close_proc_failed(this: &mut LinuxMemoryReader) -> |target_providers|::MemoryReadResult {
        let _u3: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(this.proc_fd);
        this.scratch = _u3;
        transition { _ -> failed(this) }
    }

    machine failed(this: &mut LinuxMemoryReader) -> |target_providers|::MemoryReadResult {
        |target_providers|::MemoryReadResult::Failed
    }
}

// Upstream `read`: scratch vec sized to the value, one positioned read, then
// `copy_from_bytes` installs the bytes. The scratch is caller-supplied (no
// heap growable Vec in this pin) and must cover `data_value` size bytes;
// upstream's `read_succeeded`-only return is widened to MemoryReadResult, and
// a refused copy maps to Failed.
public linux_x86_64 machine LinuxMemoryReader::read(
    this: &mut LinuxMemoryReader,
    process_info: &|opened_process_info|::OpenedProcessInfo,
    address: u64,
    data_value: &mut |data_value|::DataValue,
    scratch: &mut [u8]
) -> |target_providers|::MemoryReadResult
satisfies |memory_reader_trait|::MemoryReaderTrait<LinuxMemoryReader>::read
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let size: u64 = |data_value|::DataValue::get_size_in_bytes(&data_value);
    transition {
        size == 0 -> |target_providers|::MemoryReadResult::Complete { count: 0 }
        size > scratch.len -> failed(this)
        _ -> issue(this, process_info, address, data_value, scratch, size)
    }

    machine issue(
        this: &mut LinuxMemoryReader,
        process_info: &|opened_process_info|::OpenedProcessInfo,
        address: u64,
        data_value: &mut |data_value|::DataValue,
        scratch: &mut [u8],
        size: u64
    ) -> |target_providers|::MemoryReadResult {
        // `_ ->` above carries no negation dominance, so the slice bound is
        // re-proven here and the window is formed at the transition argument.
        transition size <= scratch.len && size > 0 {
            true -> read_slice(this, process_info, address, data_value, &mut scratch[0..size], size)
            false -> failed(this)
            _ -> failed(this)
        }
    }

    machine read_slice(
        this: &mut LinuxMemoryReader,
        process_info: &|opened_process_info|::OpenedProcessInfo,
        address: u64,
        data_value: &mut |data_value|::DataValue,
        window: &mut [u8],
        size: u64
    ) -> |target_providers|::MemoryReadResult {
        let read_result: |target_providers|::MemoryReadResult = LinuxMemoryReader::read_bytes(&mut this, process_info, address, window);
        let read_complete: bool = |target_providers|::MemoryReadResult::is_complete(&read_result);
        transition read_complete {
            true -> check_size(this, data_value, window, size, read_result)
            _ -> (read_result)
        }
    }

    machine check_size(
        this: &mut LinuxMemoryReader,
        data_value: &mut |data_value|::DataValue,
        window: &[u8],
        size: u64,
        read_result: |target_providers|::MemoryReadResult
    ) -> |target_providers|::MemoryReadResult {
        transition size <= window.len && size > 0 {
            true -> copy_in(this, data_value, &window[0..size], read_result)
            _ -> (|target_providers|::MemoryReadResult::Failed)
        }
    }

    machine copy_in(
        this: &mut LinuxMemoryReader,
        data_value: &mut |data_value|::DataValue,
        window: &[u8],
        read_result: |target_providers|::MemoryReadResult
    ) -> |target_providers|::MemoryReadResult {
        let copied: bool = |data_value|::DataValue::copy_from_bytes(&mut data_value, window);
        transition copied {
            true -> arm_result_198_0(read_result, copied)
            false -> (|target_providers|::MemoryReadResult::Failed)
        }
    }

    machine failed(this: &mut LinuxMemoryReader) -> |target_providers|::MemoryReadResult {
        |target_providers|::MemoryReadResult::Failed
    }
    machine arm_result_198_0(read_result: |target_providers|::MemoryReadResult, copied: bool) -> |target_providers|::MemoryReadResult
    {
        (read_result)
    }
}

// Upstream `read_struct`: same scratch-then-copy shape, returning the
// `copy_from_bytes` verdict itself on a successful read. `pool` is the flat
// arena the ValuedStruct's nested-field indices address into — upstream's
// `Box<ValuedStruct>` recursion needs no such parameter.
public linux_x86_64 machine LinuxMemoryReader::read_struct(
    this: &mut LinuxMemoryReader,
    process_info: &|opened_process_info|::OpenedProcessInfo,
    address: u64,
    valued_struct: &mut |valued_struct|::ValuedStruct,
    pool: &mut |valued_struct|::ValuedStructPool,
    scratch: &mut [u8]
) -> |target_providers|::MemoryReadResult
satisfies |memory_reader_trait|::MemoryReaderTrait<LinuxMemoryReader>::read_struct
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let size: u64 = |valued_struct|::ValuedStruct::get_size_in_bytes(&valued_struct, pool);
    transition {
        size == 0 -> |target_providers|::MemoryReadResult::Complete { count: 0 }
        size > scratch.len -> failed(this)
        _ -> issue(this, process_info, address, valued_struct, pool, scratch, size)
    }

    machine issue(
        this: &mut LinuxMemoryReader,
        process_info: &|opened_process_info|::OpenedProcessInfo,
        address: u64,
        valued_struct: &mut |valued_struct|::ValuedStruct,
        pool: &mut |valued_struct|::ValuedStructPool,
        scratch: &mut [u8],
        size: u64
    ) -> |target_providers|::MemoryReadResult {
        transition size <= scratch.len && size > 0 {
            true -> read_slice(this, process_info, address, valued_struct, pool, &mut scratch[0..size], size)
            false -> failed(this)
            _ -> failed(this)
        }
    }

    machine read_slice(
        this: &mut LinuxMemoryReader,
        process_info: &|opened_process_info|::OpenedProcessInfo,
        address: u64,
        valued_struct: &mut |valued_struct|::ValuedStruct,
        pool: &mut |valued_struct|::ValuedStructPool,
        window: &mut [u8],
        size: u64
    ) -> |target_providers|::MemoryReadResult {
        let read_result: |target_providers|::MemoryReadResult = LinuxMemoryReader::read_bytes(&mut this, process_info, address, window);
        let read_complete: bool = |target_providers|::MemoryReadResult::is_complete(&read_result);
        transition read_complete {
            true -> check_size(this, valued_struct, pool, window, size, read_result)
            _ -> (read_result)
        }
    }

    machine check_size(
        this: &mut LinuxMemoryReader,
        valued_struct: &mut |valued_struct|::ValuedStruct,
        pool: &mut |valued_struct|::ValuedStructPool,
        window: &[u8],
        size: u64,
        read_result: |target_providers|::MemoryReadResult
    ) -> |target_providers|::MemoryReadResult {
        transition size <= window.len && size > 0 {
            true -> copy_in(this, valued_struct, pool, &window[0..size], read_result)
            _ -> (|target_providers|::MemoryReadResult::Failed)
        }
    }

    machine copy_in(
        this: &mut LinuxMemoryReader,
        valued_struct: &mut |valued_struct|::ValuedStruct,
        pool: &mut |valued_struct|::ValuedStructPool,
        window: &[u8],
        read_result: |target_providers|::MemoryReadResult
    ) -> |target_providers|::MemoryReadResult {
        let copied: bool = |valued_struct|::ValuedStruct::copy_from_bytes(&mut valued_struct, pool, window);
        transition copied {
            true -> arm_result_288_0(read_result, copied)
            false -> (|target_providers|::MemoryReadResult::Failed)
        }
    }

    machine failed(this: &mut LinuxMemoryReader) -> |target_providers|::MemoryReadResult {
        |target_providers|::MemoryReadResult::Failed
    }
    machine arm_result_288_0(read_result: |target_providers|::MemoryReadResult, copied: bool) -> |target_providers|::MemoryReadResult
    {
        (read_result)
    }
}
