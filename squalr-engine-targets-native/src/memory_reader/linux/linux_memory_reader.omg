module src::memory_reader::linux::linux_memory_reader;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::data_values::data_value::DataValue;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::structs::valued_struct::ValuedStruct;
use squalr_engine_api::src::structures::structs::valued_struct::ValuedStructPool;
use squalr_engine_targets::src::target_providers::MemoryReadResult;
use src::memory_reader::memory_reader_trait::MemoryReaderTrait;
use src::proc_paths::ProcName;

// Port of memory_reader/linux/linux_memory_reader.rs. Upstream issues one
// process_vm_readv per read and returns bool; Omega's raw boundary for the same
// mechanism is a positioned pread on /proc/<pid>/mem — the descriptor is scoped
// to the call (mirroring process_vm_readv's per-call nature; the provider keeps
// upstream's pid-as-handle convention rather than inventing fd custody). The
// read's byte count stays observable as Complete/Partial so short reads —
// pages disappearing mid-range — are not collapsed to an opaque false.
// The service fields are ZII-established like upstream's unit struct `new()`;
// `expected`/`mem_fd`/`proc_fd`/`count`/`scratch` are per-call storage (the
// no-captured-locals lowering rule).
pub data LinuxMemoryReader {
    proc_fd: i32;
    mem_fd: i32;
    count: i64;
    expected: u64;
    scratch: i32;
    name: ProcName;
}

pub linux_x86_64 machine LinuxMemoryReader::read_bytes(
    linux_memory_reader: &mut LinuxMemoryReader,
    process_info: &OpenedProcessInfo,
    address: u64,
    values: &mut [u8]
) -> MemoryReadResult
satisfies MemoryReaderTrait::read_bytes
reaches FilesystemHost
invokes FilesystemHost;
{
    linux_memory_reader.expected = values.len;
    transition values.len == 0 {
        true -> MemoryReadResult::Complete { count: 0 }
        false -> open_proc(linux_memory_reader, process_info, address, values)
    }

    state open_proc(
        linux_memory_reader: &mut LinuxMemoryReader,
        process_info: &OpenedProcessInfo,
        address: u64,
        values: &mut [u8]
    ) -> MemoryReadResult {
        let _proc_fd_r: i32 = FilesystemHost::open("/proc", 65536);
        linux_memory_reader.proc_fd = _proc_fd_r;
        transition _proc_fd_r >= 0 {
            true -> open_mem(linux_memory_reader, process_info, address, values)
            false -> failed(linux_memory_reader)
        }
    }

    state open_mem(
        linux_memory_reader: &mut LinuxMemoryReader,
        process_info: &OpenedProcessInfo,
        address: u64,
        values: &mut [u8]
    ) -> MemoryReadResult {
        let pid: u32 = OpenedProcessInfo::get_process_id_raw(process_info);
        linux_memory_reader.name = ProcName::for_process(pid, 109, 101, 109, 0, 3);
        transition linux_memory_reader.name.len <= 48 {
            true -> open_mem_at(linux_memory_reader, address, values, linux_memory_reader.name.len)
            false -> open_mem_at(linux_memory_reader, address, values, 48)
        }
    }

    state open_mem_at(linux_memory_reader: &mut LinuxMemoryReader, address: u64, values: &mut [u8], name_len: u64) -> MemoryReadResult {
        let procfd: i32 = linux_memory_reader.proc_fd;
        let _mem_fd_r: i32 = FilesystemHost::open_at(procfd, linux_memory_reader.name.bytes[0..48], 0);
        linux_memory_reader.mem_fd = _mem_fd_r;
        transition _mem_fd_r >= 0 {
            true -> read(linux_memory_reader, address, values)
            false -> close_proc_failed(linux_memory_reader)
        }
    }

    state read(linux_memory_reader: &mut LinuxMemoryReader, address: u64, values: &mut [u8]) -> MemoryReadResult {
        let memfd: i32 = linux_memory_reader.mem_fd;
        let want: u64 = linux_memory_reader.expected;
        let off: i64 = ((address as i64 in Wrapping) as i64);
        let _count_r: i64 = FilesystemHost::read_at(memfd, values, want, off);
        linux_memory_reader.count = _count_r;
        let _u1: i32 = FilesystemHost::close(linux_memory_reader.mem_fd);
        linux_memory_reader.scratch = _u1;
        let _u2: i32 = FilesystemHost::close(linux_memory_reader.proc_fd);
        linux_memory_reader.scratch = _u2;
        transition _count_r < 0 {
            true -> failed(linux_memory_reader)
            false -> classify(linux_memory_reader)
        }
    }

    state classify(linux_memory_reader: &mut LinuxMemoryReader) -> MemoryReadResult {
        transition ((linux_memory_reader.count as u64 in Wrapping) as u64) == linux_memory_reader.expected {
            true -> MemoryReadResult::Complete { count: ((linux_memory_reader.count as u64 in Wrapping) as u64) }
            false -> MemoryReadResult::Partial { count: ((linux_memory_reader.count as u64 in Wrapping) as u64) }
        }
    }

    state close_proc_failed(linux_memory_reader: &mut LinuxMemoryReader) -> MemoryReadResult {
        let _u3: i32 = FilesystemHost::close(linux_memory_reader.proc_fd);
        linux_memory_reader.scratch = _u3;
        transition { _ -> failed(linux_memory_reader) }
    }

    state failed(linux_memory_reader: &mut LinuxMemoryReader) -> MemoryReadResult {
        MemoryReadResult::Failed
    }
}

// Upstream `read`: scratch vec sized to the value, one positioned read, then
// `copy_from_bytes` installs the bytes. The scratch is caller-supplied (no
// heap growable Vec in this pin) and must cover `data_value` size bytes;
// upstream's `read_succeeded`-only return is widened to MemoryReadResult, and
// a refused copy maps to Failed.
pub linux_x86_64 machine LinuxMemoryReader::read(
    linux_memory_reader: &mut LinuxMemoryReader,
    process_info: &OpenedProcessInfo,
    address: u64,
    data_value: &mut DataValue,
    scratch: &mut [u8]
) -> MemoryReadResult
satisfies MemoryReaderTrait::read
reaches FilesystemHost
invokes FilesystemHost;
{
    let size: u64 = DataValue::get_size_in_bytes(data_value);
    transition {
        size == 0 -> MemoryReadResult::Complete { count: 0 }
        size > scratch.len -> failed(linux_memory_reader)
        _ -> issue(linux_memory_reader, process_info, address, data_value, scratch, size)
    }

    state issue(
        linux_memory_reader: &mut LinuxMemoryReader,
        process_info: &OpenedProcessInfo,
        address: u64,
        data_value: &mut DataValue,
        scratch: &mut [u8],
        size: u64
    ) -> MemoryReadResult {
        // `_ ->` above carries no negation dominance, so the slice bound is
        // re-proven here and the window is formed at the transition argument.
        transition size <= scratch.len && size > 0 {
            true -> read_slice(linux_memory_reader, process_info, address, data_value, &mut scratch[0..size], size)
            false -> failed(linux_memory_reader)
            _ -> failed(linux_memory_reader)
        }
    }

    state read_slice(
        linux_memory_reader: &mut LinuxMemoryReader,
        process_info: &OpenedProcessInfo,
        address: u64,
        data_value: &mut DataValue,
        window: &mut [u8],
        size: u64
    ) -> MemoryReadResult {
        let read_result: MemoryReadResult = LinuxMemoryReader::read_bytes(linux_memory_reader, 
            process_info, address, window);
        let read_complete: bool = MemoryReadResult::is_complete(&read_result);
        transition read_complete {
            true -> check_size(linux_memory_reader, data_value, window, size, read_result)
            _ -> (read_result)
        }
    }

    state check_size(
        linux_memory_reader: &mut LinuxMemoryReader,
        data_value: &mut DataValue,
        window: &[u8],
        size: u64,
        read_result: MemoryReadResult
    ) -> MemoryReadResult {
        transition size <= window.len && size > 0 {
            true -> copy_in(linux_memory_reader, data_value, &window[0..size], read_result)
            _ -> (MemoryReadResult::Failed)
        }
    }

    state copy_in(
        linux_memory_reader: &mut LinuxMemoryReader,
        data_value: &mut DataValue,
        window: &[u8],
        read_result: MemoryReadResult
    ) -> MemoryReadResult {
        let copied: bool = DataValue::copy_from_bytes(data_value, window);
        transition copied {
            true -> arm_result_198_0(read_result, copied)
            false -> (MemoryReadResult::Failed)
        }
    }

    state failed(linux_memory_reader: &mut LinuxMemoryReader) -> MemoryReadResult {
        MemoryReadResult::Failed
    }
    state arm_result_198_0(read_result: MemoryReadResult, copied: bool) -> MemoryReadResult
    {
        (read_result)
    }
}

// Upstream `read_struct`: same scratch-then-copy shape, returning the
// `copy_from_bytes` verdict itself on a successful read. `pool` is the flat
// arena the ValuedStruct's nested-field indices address into — upstream's
// `Box<ValuedStruct>` recursion needs no such parameter.
pub linux_x86_64 machine LinuxMemoryReader::read_struct(
    linux_memory_reader: &mut LinuxMemoryReader,
    process_info: &OpenedProcessInfo,
    address: u64,
    valued_struct: &mut ValuedStruct,
    pool: &mut ValuedStructPool,
    scratch: &mut [u8]
) -> MemoryReadResult
satisfies MemoryReaderTrait::read_struct
reaches FilesystemHost
invokes FilesystemHost;
{
    let size: u64 = ValuedStruct::get_size_in_bytes(valued_struct, pool);
    transition {
        size == 0 -> MemoryReadResult::Complete { count: 0 }
        size > scratch.len -> failed(linux_memory_reader)
        _ -> issue(linux_memory_reader, process_info, address, valued_struct, pool, scratch, size)
    }

    state issue(
        linux_memory_reader: &mut LinuxMemoryReader,
        process_info: &OpenedProcessInfo,
        address: u64,
        valued_struct: &mut ValuedStruct,
        pool: &mut ValuedStructPool,
        scratch: &mut [u8],
        size: u64
    ) -> MemoryReadResult {
        transition size <= scratch.len && size > 0 {
            true -> read_slice(linux_memory_reader, process_info, address, valued_struct, pool, &mut scratch[0..size], size)
            false -> failed(linux_memory_reader)
            _ -> failed(linux_memory_reader)
        }
    }

    state read_slice(
        linux_memory_reader: &mut LinuxMemoryReader,
        process_info: &OpenedProcessInfo,
        address: u64,
        valued_struct: &mut ValuedStruct,
        pool: &mut ValuedStructPool,
        window: &mut [u8],
        size: u64
    ) -> MemoryReadResult {
        let read_result: MemoryReadResult = LinuxMemoryReader::read_bytes(linux_memory_reader, 
            process_info, address, window);
        let read_complete: bool = MemoryReadResult::is_complete(&read_result);
        transition read_complete {
            true -> check_size(linux_memory_reader, valued_struct, pool, window, size, read_result)
            _ -> (read_result)
        }
    }

    state check_size(
        linux_memory_reader: &mut LinuxMemoryReader,
        valued_struct: &mut ValuedStruct,
        pool: &mut ValuedStructPool,
        window: &[u8],
        size: u64,
        read_result: MemoryReadResult
    ) -> MemoryReadResult {
        transition size <= window.len && size > 0 {
            true -> copy_in(linux_memory_reader, valued_struct, pool, &window[0..size], read_result)
            _ -> (MemoryReadResult::Failed)
        }
    }

    state copy_in(
        linux_memory_reader: &mut LinuxMemoryReader,
        valued_struct: &mut ValuedStruct,
        pool: &mut ValuedStructPool,
        window: &[u8],
        read_result: MemoryReadResult
    ) -> MemoryReadResult {
        let copied: bool = ValuedStruct::copy_from_bytes(valued_struct, pool, window);
        transition copied {
            true -> arm_result_288_0(read_result, copied)
            false -> (MemoryReadResult::Failed)
        }
    }

    state failed(linux_memory_reader: &mut LinuxMemoryReader) -> MemoryReadResult {
        MemoryReadResult::Failed
    }
    state arm_result_288_0(read_result: MemoryReadResult, copied: bool) -> MemoryReadResult
    {
        (read_result)
    }
}
