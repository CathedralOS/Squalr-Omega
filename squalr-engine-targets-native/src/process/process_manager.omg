use {omega}/language/core/filesystem_authority.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_targets}/src/target_providers.omg;
use src/process_query/process_queryer.omg;

// Port of process/process_manager.rs. Upstream fields:
//   opened_process: Arc<RwLock<Option<OpenedProcessInfo>>> — here a plain
//     OptionalProcess case (the lock only exists for the death-monitor thread);
//   event_emitter: Arc<dyn Fn(EngineEvent)> — the EngineEvent/ProcessChangedEvent
//     event bus is owned by a later item (session events), so emissions are
//     absent; the state transitions themselves are preserved.
//   The death-monitor thread (listen_for_open_process_death) awaits an Omega
//   thread surface — recorded as a dependency, not simulated.
// is_process_alive survives verbatim through the query facade.
public data OptionalOpenedProcess [copy] {
    case Invalid;
    case None;
    case Opened(info: |opened_process_info|::OpenedProcessInfo);
}

public data ProcessManager {
    opened_process: OptionalOpenedProcess;
    query: |process_queryer|::ProcessQuery;
}

public machine ProcessManager::set_opened_process(
    this: &mut ProcessManager,
    process_info: |opened_process_info|::OpenedProcessInfo
) {
    this.opened_process = OptionalOpenedProcess::Opened { info: process_info };
}

public machine ProcessManager::clear_opened_process(this: &mut ProcessManager) {
    this.opened_process = OptionalOpenedProcess::None;
}

public machine ProcessManager::get_opened_process(this: &mut ProcessManager) -> OptionalOpenedProcess {
    this.opened_process
}

public linux_x86_64 machine ProcessManager::is_process_alive(
    this: &mut ProcessManager,
    process_id: u32
) -> |target_providers|::ProcessAliveResult
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let hoist1: |target_providers|::ProcessAliveResult = |process_queryer|::ProcessQuery::is_process_alive(&mut this.query, process_id);
    (hoist1)
}
