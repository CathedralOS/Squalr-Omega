module src::process::process_manager;
use omega::language::core::binding;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use src::process_query::process_queryer::ProcessQuery;

// Port of process/process_manager.rs. Upstream fields:
//   opened_process: Arc<RwLock<Option<OpenedProcessInfo>>> — here a plain
//     OptionalProcess case (the lock only exists for the death-monitor thread);
//   event_emitter: Arc<dyn Fn(EngineEvent)> — the EngineEvent/ProcessChangedEvent
//     event bus is owned by a later item (session events), so emissions are
//     absent; the state transitions themselves are preserved.
//   The death-monitor thread (listen_for_open_process_death) awaits an Omega
//   thread surface — recorded as a dependency, not simulated.
// is_process_alive survives verbatim through the query facade.
pub data OptionalOpenedProcess [copy] {
    case Invalid;
    case None;
    case Opened(info: OpenedProcessInfo);
}

pub data ProcessManager {
    opened_process: OptionalOpenedProcess;
    query: ProcessQuery;
}

pub machine ProcessManager::set_opened_process(
    &mut self,
    process_info: OpenedProcessInfo
) {
    self.opened_process = OptionalOpenedProcess::Opened { info: process_info };
}

pub machine ProcessManager::clear_opened_process(&mut self) {
    self.opened_process = OptionalOpenedProcess::None;
}

pub machine ProcessManager::get_opened_process(&mut self) -> OptionalOpenedProcess {
    self.opened_process
}

pub linux_x86_64 machine ProcessManager::is_process_alive(
    &mut self,
    process_id: u32
) -> bool
reaches FilesystemHost
invokes FilesystemHost;
{
    self.query.is_process_alive(process_id)
}
