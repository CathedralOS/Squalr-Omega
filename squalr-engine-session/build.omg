// Package boundary and internal edges mirror upstream squalr-engine-session/Cargo.toml.
machine build(builder: &mut Build) {
    Build::package(builder, "squalr_engine_session");
    Build::depend(builder, Source::Path { location: "../squalr-engine-api" });
    Build::depend(builder, Source::Path { location: "../squalr-engine-projects" });
    Build::depend(builder, Source::Path { location: "../squalr-engine-targets" });
    Build::depend(builder, Source::Path { location: "../squalr-engine-targets-native" });
    Build::depend(builder, Source::Path { location: "../plugins/squalr-plugin-builtins" });
    Build::depend(builder, Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "438173f7da3e27c24bf4ac710714039937367cee",
        selection: PackageSelection::Named { package: "omega_language_std" }
    });
}
