// Package boundary and internal edges mirror upstream squalr-engine-session/Cargo.toml.
machine build(builder: &mut Build) {
    builder.package("squalr-engine-session");
    builder.depend(Source::Path { location: "../squalr-engine-api" });
    builder.depend(Source::Path { location: "../squalr-engine-projects" });
    builder.depend(Source::Path { location: "../squalr-engine-targets" });
    builder.depend(Source::Path { location: "../squalr-engine-targets-native" });
    builder.depend(Source::Path { location: "../plugins/squalr-plugin-builtins" });
    builder.depend(Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "c28a21fee02a4165f5bd0a21ad092880d63cb78d",
        selection: PackageSelection::Named { package: "omega-language-std" }
    });
}
