module src::patches::patch_service;

use squalr_engine_api::src::structures::memory::normalized_region::NormalizedRegion;
use squalr_engine_api::src::structures::patches::patch_descriptor::PatchDescriptor;
use squalr_engine_api::src::structures::patches::patch_kind::PatchKind;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_targets::src::target_providers::MemoryReadResult;
use squalr_engine_targets::src::target_providers::MemoryWriteResult;
use squalr_engine_targets_native::src::memory_queryer::normalized_module::ResolvedModuleAddress;
use src::os::engine_os_provider::EngineOsProviders;

// Port of squalr-engine-session/src/patches/patch_service.rs — the applied-
// patch table behind the Patches command domain: {process scope key,
// patch-N id allocator, patches_by_id}. Named deviations:
//
// - `patches_by_id: HashMap<String, PatchDescriptor>` becomes a bounded
//   64-slot insertion-order table — the wire's `PatchListResponse` bound is
//   [PatchDescriptor; 64], so the store and the list surface share one
//   bound. A full table refuses the apply rather than evicting silently.
// - The `Mutex<PatchServiceState>` guard maps onto the single-owner session
//   field; `lock_state()`'s poison-error arm has no correspondent.
// - `next_patch_id: AtomicU64` becomes a plain u64 bump in the `Wrapping`
//   domain — the id is a tag; wrap is upstream's fetch_add semantics.
// - `resolve_absolute_address` routes through the provider's
//   `resolve_module_address` (identifier + offset); upstream's separate
//   not-loaded vs overflow error arms collapse into the resolver's
//   `Unresolvable` case.
// - `clear_if_process_changed` fires from upstream's ProcessChanged event
//   hook; headless calls it inline at the process open/close transition
//   (the event bus is the bindings leg). Every public op still runs
//   `ensure_process_scope` first, matching upstream's second check.
// - `Option<PatchDescriptor>` returns flatten to `Found(patch)/Miss`;
//   `Result<PatchDescriptor, String>` becomes `PatchServiceResult` with a
//   bounded error-text carrier. Upstream's format! interpolation is kept —
//   `put`/`put_hex16`/`put_decimal`/`put_kind` build the same messages.
// - `write_code_bytes_checked` and public `find_active_overlap` belong to
//   the debugger leg's breakpoint path; the overlap helpers they share are
//   ported here already.
// - `list_patches` sorts by (base_address, patch_id) like upstream's
//   `sort_by`; insertion sort keeps the bounded table ordered in place.

pub data PatchServiceError {
    message: [u8; 256];
    message_len: u64;
}

pub machine PatchServiceError::empty() -> PatchServiceError {
    PatchServiceError { message_len: 0 }
}

// Bounded append — upstream's format! pieces. Overrun truncates at the
// 256-byte carrier; status messages are diagnostic text, never patch data.
pub machine PatchServiceError::put(patch_service_error: &mut PatchServiceError, bytes: &[u8]) {
    transition { _ -> copy(patch_service_error, bytes, 0) }
    state copy(patch_service_error: &mut PatchServiceError, bytes: &[u8], position: u64) {
        transition position < bytes.len && patch_service_error.message_len < 256 {
            true -> store(patch_service_error, bytes, position)
            _ -> done(patch_service_error)
        }
    }
    state store(patch_service_error: &mut PatchServiceError, bytes: &[u8], position: u64)
        requires position < bytes.len && patch_service_error.message_len < 256
    {
        let target: u64 = patch_service_error.message_len;
        patch_service_error.message[target] = bytes[position];
        patch_service_error.message_len = ((target as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition {
            _ -> copy(patch_service_error, bytes, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state done(patch_service_error: &mut PatchServiceError) {}
}

// Upstream `{:X}` — minimal-width uppercase hex.
pub machine PatchServiceError::put_hex16(patch_service_error: &mut PatchServiceError, value: u64) {
    transition value == 0 {
        true -> emit_zero(patch_service_error)
        _ -> measure(patch_service_error, value, 0)
    }
    state emit_zero(patch_service_error: &mut PatchServiceError) {
        PatchServiceError::put(patch_service_error, "0");
        transition { _ -> done(patch_service_error) }
    }
    // Count the significant nibbles so emission stays MSB-first.
    state measure(patch_service_error: &mut PatchServiceError, value: u64, width: u64)
        requires width < 17
    {
        transition width < 16 {
            true -> probe(patch_service_error, value, width)
            _ -> emit(patch_service_error, value, width, 0)
        }
    }
    state probe(patch_service_error: &mut PatchServiceError, value: u64, width: u64)
        requires width < 16
    {
        let shift: u64 = (((width as u64 in Wrapping) * (4 as u64 in Wrapping)) as u64);
        let shifted: u64 = (((value as u64 in Wrapping) >> (shift as u64 in Wrapping)) != 0) as u64;
        let next_width: u64 = ((width as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition shifted == 1 && next_width < 17 {
            true -> measure(patch_service_error, value, next_width)
            _ -> emit(patch_service_error, value, width, 0)
        }
    }
    state emit(patch_service_error: &mut PatchServiceError, value: u64, width: u64, position: u64)
        requires width < 17
    {
        transition position < width && position < 16 && patch_service_error.message_len < 256 {
            true -> emit_digit(patch_service_error, value, width, position)
            _ -> done(patch_service_error)
        }
    }
    state emit_digit(patch_service_error: &mut PatchServiceError, value: u64, width: u64, position: u64)
        requires position < width && position < 16 && width < 17
    {
        // `width <= 16 && width > position` — subtraction stays in range.
        let shift_base: u64 = ((width as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        let shift: u64 = (((((shift_base as u64 in Wrapping) - (position as u64 in Wrapping)) as u64 in Wrapping) * (4 as u64 in Wrapping)) as u64);
        let digit: u64 = (((((value as u64 in Wrapping) >> (shift as u64 in Wrapping)) % (16 as u64 in Wrapping))) as u64);
        let target: u64 = patch_service_error.message_len;
        patch_service_error.message[target] = hex_digit(digit);
        patch_service_error.message_len = ((target as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition {
            _ -> emit(patch_service_error, value, width, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state done(patch_service_error: &mut PatchServiceError) {}
}

// Decimal append for the patch-id tail and interpolated counts — u64,
// minimal width, divisor-forward so no index is ever computed.
pub machine PatchServiceError::put_decimal(patch_service_error: &mut PatchServiceError, value: u64) {
    transition value == 0 {
        true -> emit_zero(patch_service_error, value)
        _ -> measure(patch_service_error, value, 1)
    }
    state emit_zero(patch_service_error: &mut PatchServiceError, value: u64) {
        PatchServiceError::put(patch_service_error, "0");
        transition { _ -> done(patch_service_error) }
    }
    // `divisor` grows to the largest 10^k <= value (10^19 is the u64 cap).
    state measure(patch_service_error: &mut PatchServiceError, value: u64, divisor: u64) {
        transition divisor <= value / 10 && divisor < 10000000000000000000 {
            true -> measure(patch_service_error, value, ((divisor as u64 in Wrapping) * (10 as u64 in Wrapping)) as u64)
            _ -> emit(patch_service_error, value, divisor)
        }
    }
    state emit(patch_service_error: &mut PatchServiceError, value: u64, divisor: u64) {
        transition divisor != 0 && patch_service_error.message_len < 256 {
            true -> digit(patch_service_error, value, divisor)
            _ -> done(patch_service_error)
        }
    }
    state digit(patch_service_error: &mut PatchServiceError, value: u64, divisor: u64)
        requires divisor != 0
    {
        let quotient: u64 = value / divisor;
        let digit: u64 = quotient % 10;
        transition digit < 10 && patch_service_error.message_len < 256 {
            true -> store(patch_service_error, value, divisor, digit)
            _ -> done(patch_service_error)
        }
    }
    state store(patch_service_error: &mut PatchServiceError, value: u64, divisor: u64, digit: u64)
        requires divisor != 0 && digit < 10 && patch_service_error.message_len < 256
    {
        let target: u64 = patch_service_error.message_len;
        patch_service_error.message[target] = ((((48 as u64 in Wrapping) + (digit as u64 in Wrapping)) as u64) as u8);
        patch_service_error.message_len = ((target as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let next_divisor: u64 = divisor / 10;
        transition { _ -> emit(patch_service_error, value, next_divisor) }
    }
    state done(patch_service_error: &mut PatchServiceError) {}
}

machine hex_digit(digit: u64) -> u8 {
    transition digit < 10 {
        true -> ((((48 as u64 in Wrapping) + (digit as u64 in Wrapping)) as u64) as u8)
        _ -> upper(digit)
    }
    // The `% 16` inputs keep digit in 0-15; `digit >= 16` is unreachable —
    // the arm returns '?' rather than widen the contract to a masked char.
    state upper(digit: u64) -> u8 {
        transition digit < 16 {
            true -> (hex_digit_upper(digit))
            _ -> (63)
        }
    }
}

machine hex_digit_upper(digit: u64) -> u8
    requires digit >= 10 && digit < 16
{
    ((((55 as u64 in Wrapping) + ((digit as u64 in Wrapping) - (10 as u64 in Wrapping))) as u64) as u8)
}

// Upstream `{:?}` on PatchKind — the Debug spelling is the variant name.
pub machine PatchServiceError::put_kind(patch_service_error: &mut PatchServiceError, kind: PatchKind) {
    transition kind {
        PatchKind::Code -> emit(patch_service_error, "Code")
        PatchKind::NoOperation -> emit(patch_service_error, "NoOperation")
        PatchKind::SoftwareBreakpoint -> emit(patch_service_error, "SoftwareBreakpoint")
        PatchKind::Generic -> emit(patch_service_error, "Generic")
    }
    state emit(patch_service_error: &mut PatchServiceError, name: &[u8]) {
        PatchServiceError::put(patch_service_error, name);
        transition { _ -> done(patch_service_error) }
    }
    state done(patch_service_error: &mut PatchServiceError) {}
}

pub machine PatchServiceError::get_message(patch_service_error: &PatchServiceError) -> &[u8] {
    transition patch_service_error.message_len <= 256 {
        true -> (&patch_service_error.message[0 .. patch_service_error.message_len])
        _ -> (&patch_service_error.message)
    }
}

// `Result<PatchDescriptor, String>` — upstream's Ok descriptor / Err text.
pub data PatchServiceResult {
    case Ok(patch: PatchDescriptor);
    case Err(error: PatchServiceError);
}

// `Result<u64, String>` for the resolve stage.
pub data PatchAddressResult {
    case Resolved(address: u64);
    case Err(error: PatchServiceError);
}

// `Result<Option<PatchDescriptor>, String>` — lock errors gone headless.
pub data PatchOverlapOutcome {
    case Found(patch: PatchDescriptor);
    case Miss;
}

// The patch store. `process_key_*` pairs carry upstream's Option
// PatchProcessKey { process_id: u32, process_handle: u64 }.
pub data PatchService {
    next_patch_number: u64;
    has_process_key: bool;
    process_key_id: u64;
    process_key_handle: u64;
    patches: [PatchDescriptor; 64];
    patch_count: u64;
}

pub machine PatchService::new() -> PatchService {
    PatchService {
        next_patch_number: 1,
        has_process_key: false,
        process_key_id: 0,
        process_key_handle: 0,
        patch_count: 0,
    }
}

pub machine PatchService::default() -> PatchService {
    (PatchService::new())
}

pub machine PatchService::get_patch_count(patch_service: &PatchService) -> u64 {
    patch_service.patch_count
}

pub machine PatchService::get_patch_at(patch_service: &PatchService, position: u64) -> &PatchDescriptor
    requires position < 64
{
    &patch_service.patches[position]
}

// The list executor copies the sorted table out; the `&` returned by
// get_patch_at loans through two `&mut` hops and cannot feed clone's
// shared receiver, so the by-value variant lives beside it.
pub machine PatchService::clone_patch_at(patch_service: &PatchService, position: u64) -> PatchDescriptor
    requires position < 64
{
    PatchDescriptor::clone(&patch_service.patches[position])
}

// Upstream `clear` — drops the scope key and the whole table.
pub machine PatchService::clear(patch_service: &mut PatchService) {
    patch_service.has_process_key = false;
    patch_service.patch_count = 0;
}

// Upstream `clear_if_process_changed` — rekeys and empties the table when
// the opened process (or its absence) no longer matches the stored key.
pub machine PatchService::clear_if_process_changed(patch_service: &mut PatchService, has_opened: bool, process_id: u64, handle: u64) {
    transition patch_service.has_process_key != has_opened || patch_service.process_key_id != process_id || patch_service.process_key_handle != handle {
        true -> rekey(patch_service, has_opened, process_id, handle)
        _ -> done(patch_service)
    }
    state rekey(patch_service: &mut PatchService, has_opened: bool, process_id: u64, handle: u64) {
        patch_service.has_process_key = has_opened;
        patch_service.process_key_id = process_id;
        patch_service.process_key_handle = handle;
        patch_service.patch_count = 0;
        transition { _ -> done(patch_service) }
    }
    state done(patch_service: &mut PatchService) {}
}

// Upstream `ensure_process_scope` — same key test driven from the op's
// opened process, matching upstream's in-lock call order.
machine PatchService::ensure_process_scope(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo) {
    let process_id: u64 = OpenedProcessInfo::get_process_id_raw(opened_process_info) as u64;
    let handle: u64 = OpenedProcessInfo::get_handle(opened_process_info);
    PatchService::clear_if_process_changed(patch_service, true, process_id, handle);
}

machine is_whitespace_byte(byte: u8) -> bool {
    (byte == 32 || byte == 9 || byte == 10 || byte == 13)
}

// Upstream `module_name.trim().is_empty()` — whitespace-only names still
// mean an absolute address.
machine is_span_blank(value: &[u8]) -> bool {
    transition { _ -> scan(value, 0) }
    state scan(value: &[u8], position: u64) -> bool {
        transition position < value.len {
            true -> check(value, position)
            false -> (true)
        }
    }
    state check(value: &[u8], position: u64) -> bool
        requires position < value.len
    {
        transition is_whitespace_byte(value[position]) {
            true -> scan(value, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// `HashMap::values().find(pred)` — returns the first matching slot
// position, or `patch_count` as the none-found sentinel (upstream Option).
machine PatchService::find_active_overlap_position(patch_service: &PatchService, region: &NormalizedRegion) -> u64 {
    transition { _ -> scan(patch_service, region, 0) }
    state scan(patch_service: &PatchService, region: &NormalizedRegion, position: u64) -> u64 {
        transition position < patch_service.patch_count && position < 64 {
            true -> probe(patch_service, region, position)
            _ -> (patch_service.patch_count)
        }
    }
    state probe(patch_service: &PatchService, region: &NormalizedRegion, position: u64) -> u64
        requires position < patch_service.patch_count && position < 64
    {
        transition PatchDescriptor::get_is_active(&patch_service.patches[position]) && regions_overlap(PatchDescriptor::get_region(&patch_service.patches[position]), region) {
            true -> (position)
            _ -> scan(patch_service, region, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

machine PatchService::find_active_overlap_with_kind_position(patch_service: &PatchService, region: &NormalizedRegion, kind: PatchKind) -> u64 {
    transition { _ -> scan(patch_service, region, kind, 0) }
    state scan(patch_service: &PatchService, region: &NormalizedRegion, kind: PatchKind, position: u64) -> u64 {
        transition position < patch_service.patch_count && position < 64 {
            true -> probe(patch_service, region, kind, position)
            _ -> (patch_service.patch_count)
        }
    }
    state probe(patch_service: &PatchService, region: &NormalizedRegion, kind: PatchKind, position: u64) -> u64
        requires position < patch_service.patch_count && position < 64
    {
        transition PatchDescriptor::get_is_active(&patch_service.patches[position]) && patch_kind_is(PatchDescriptor::get_kind(&patch_service.patches[position]), kind) && regions_overlap(PatchDescriptor::get_region(&patch_service.patches[position]), region) {
            true -> (position)
            _ -> scan(patch_service, region, kind, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// `find(|d| d.get_patch_id() == patch_id)` — bounded id spans compare
// byte-exact like upstream's String ==.
machine PatchService::find_position_by_patch_id(patch_service: &PatchService, patch_id: &[u8]) -> u64 {
    transition { _ -> scan(patch_service, patch_id, 0) }
    state scan(patch_service: &PatchService, patch_id: &[u8], position: u64) -> u64 {
        transition position < patch_service.patch_count && position < 64 {
            true -> probe(patch_service, patch_id, position)
            _ -> (patch_service.patch_count)
        }
    }
    state probe(patch_service: &PatchService, patch_id: &[u8], position: u64) -> u64
        requires position < patch_service.patch_count && position < 64
    {
        transition spans_equal(PatchDescriptor::get_patch_id(&patch_service.patches[position]), patch_id) {
            true -> (position)
            _ -> scan(patch_service, patch_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// `find(|active && region contains address)` for restore-at-address.
machine PatchService::find_active_containing_position(patch_service: &PatchService, address: u64) -> u64 {
    transition { _ -> scan(patch_service, address, 0) }
    state scan(patch_service: &PatchService, address: u64, position: u64) -> u64 {
        transition position < patch_service.patch_count && position < 64 {
            true -> probe(patch_service, address, position)
            _ -> (patch_service.patch_count)
        }
    }
    state probe(patch_service: &PatchService, address: u64, position: u64) -> u64
        requires position < patch_service.patch_count && position < 64
    {
        transition PatchDescriptor::get_is_active(&patch_service.patches[position]) && region_contains(PatchDescriptor::get_region(&patch_service.patches[position]), address) {
            true -> (position)
            _ -> scan(patch_service, address, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

machine regions_overlap(left: &NormalizedRegion, right: &NormalizedRegion) -> bool {
    (NormalizedRegion::get_base_address(left) < NormalizedRegion::get_end_address(right) && NormalizedRegion::get_base_address(right) < NormalizedRegion::get_end_address(left))
}

machine region_contains(region: &NormalizedRegion, address: u64) -> bool {
    (address >= NormalizedRegion::get_base_address(region) && address < NormalizedRegion::get_end_address(region))
}

machine patch_kind_is(left: PatchKind, right: PatchKind) -> bool {
    transition left {
        PatchKind::Code -> match_code(right)
        PatchKind::NoOperation -> match_no_operation(right)
        PatchKind::SoftwareBreakpoint -> match_software_breakpoint(right)
        PatchKind::Generic -> match_generic(right)
    }
    state match_code(right: PatchKind) -> bool {
        transition right {
            PatchKind::Code -> (true)
            _ -> (false)
        }
    }
    state match_no_operation(right: PatchKind) -> bool {
        transition right {
            PatchKind::NoOperation -> (true)
            _ -> (false)
        }
    }
    state match_software_breakpoint(right: PatchKind) -> bool {
        transition right {
            PatchKind::SoftwareBreakpoint -> (true)
            _ -> (false)
        }
    }
    state match_generic(right: PatchKind) -> bool {
        transition right {
            PatchKind::Generic -> (true)
            _ -> (false)
        }
    }
}

machine spans_equal(left: &[u8], right: &[u8]) -> bool {
    transition left.len == right.len {
        true -> compare(left, right, 0)
        _ -> (false)
    }
    state compare(left: &[u8], right: &[u8], position: u64) -> bool {
        transition position < left.len && position < right.len {
            true -> check(left, right, position)
            false -> (true)
        }
    }
    state check(left: &[u8], right: &[u8], position: u64) -> bool
        requires position < left.len && position < right.len
    {
        transition left[position] == right[position] {
            true -> compare(left, right, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// upstream `format!("patch-{}", n)` — writes "patch-N" into `out` and
// returns the live length. Counter grows in Wrapping like fetch_add.
machine write_patch_id(out: &mut [u8; 256], number: u64) -> u64 {
    out[0] = 112;
    out[1] = 97;
    out[2] = 116;
    out[3] = 99;
    out[4] = 104;
    out[5] = 45;
    (((6 as u64 in Wrapping) + (write_decimal(out, 6, number) as u64 in Wrapping)) as u64)
}

// Minimal-width decimal into `out` starting at `position` — digits are
// collected into a scratch then written forward so no index is computed.
machine write_decimal(out: &mut [u8; 256], position: u64, value: u64) -> u64
    requires position < 256
{
    transition value == 0 {
        true -> write_zero(out, position)
        _ -> measure(out, value, position, 1)
    }
    state write_zero(out: &mut [u8; 256], position: u64) -> u64
        requires position < 256
    {
        out[position] = 48;
        (1)
    }
    // `divisor` = largest 10^k <= value; 10^19 is the u64 ceiling.
    state measure(out: &mut [u8; 256], value: u64, position: u64, divisor: u64) -> u64
        requires position < 256
    {
        transition divisor <= value / 10 && divisor < 10000000000000000000 {
            true -> grow(out, value, position, divisor)
            _ -> emit(out, value, position, divisor, 0)
        }
    }
    state grow(out: &mut [u8; 256], value: u64, position: u64, divisor: u64) -> u64
        requires position < 256 && divisor < 10000000000000000000
    {
        transition {
            _ -> measure(out, value, position, ((divisor as u64 in Wrapping) * (10 as u64 in Wrapping)) as u64)
        }
    }
    state emit(out: &mut [u8; 256], value: u64, write_at: u64, divisor: u64, written: u64) -> u64
        requires write_at < 256
    {
        transition divisor != 0 && write_at < 256 {
            true -> digit(out, value, write_at, divisor, written)
            _ -> (written)
        }
    }
    state digit(out: &mut [u8; 256], value: u64, write_at: u64, divisor: u64, written: u64) -> u64
        requires write_at < 256 && divisor != 0
    {
        let quotient: u64 = value / divisor;
        let digit: u64 = quotient % 10;
        transition digit < 10 {
            true -> store(out, value, write_at, divisor, digit, written)
            _ -> (written)
        }
    }
    state store(out: &mut [u8; 256], value: u64, write_at: u64, divisor: u64, digit: u64, written: u64) -> u64
        requires write_at < 256 && divisor != 0 && digit < 10
    {
        out[write_at] = ((((48 as u64 in Wrapping) + (digit as u64 in Wrapping)) as u64) as u8);
        let next_divisor: u64 = divisor / 10;
        let next_at: u64 = ((write_at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next_at < 256 {
            true -> emit(out, value, next_at, next_divisor, ((written as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (((written as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// Upstream `resolve_absolute_address`: a blank module name means `address`
// is already absolute; a named module resolves identifier+offset through
// the provider. `Unresolvable` carries upstream's not-loaded arm (the
// overflow arm shares it — the resolver's own arithmetic decides).
machine PatchService::resolve_absolute_address(
    patch_service: &mut PatchService,
    opened_process_info: &OpenedProcessInfo,
    providers: &mut EngineOsProviders,
    address: u64,
    module_name: &[u8]
) -> PatchAddressResult
reaches FilesystemHost
invokes FilesystemHost;
{
    transition is_span_blank(module_name) {
        true -> (PatchAddressResult::Resolved { address: address })
        _ -> resolve_module(patch_service, opened_process_info, providers, address, module_name)
    }
    state resolve_module(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, address: u64, module_name: &[u8]) -> PatchAddressResult {
        let resolved: ResolvedModuleAddress = EngineOsProviders::resolve_module_address(providers, opened_process_info, module_name, address);
        transition resolved {
            ResolvedModuleAddress::Resolved { address } -> (PatchAddressResult::Resolved { address: address })
            _ -> not_loaded(patch_service, module_name)
        }
    }
    state not_loaded(patch_service: &mut PatchService, module_name: &[u8]) -> PatchAddressResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Module '");
        PatchServiceError::put(&mut error, module_name);
        PatchServiceError::put(&mut error, "' is not loaded in the opened process.");
        (PatchAddressResult::Err { error: error })
    }
}

// Upstream `apply_patch` — empty-payload refuse, module/absolute resolve,
// scope, active-overlap refuse, original-bytes read, patched write,
// id allocation, insert, clone back as the Ok payload.
pub machine PatchService::apply_patch(
    patch_service: &mut PatchService,
    opened_process_info: &OpenedProcessInfo,
    providers: &mut EngineOsProviders,
    address: u64,
    module_name: &[u8],
    patched_bytes: &[u8],
    kind: PatchKind,
    has_label: bool,
    label: &[u8]
) -> PatchServiceResult
reaches FilesystemHost
invokes FilesystemHost;
{
    transition patched_bytes.len == 0 {
        true -> fail(patch_service, "Patch bytes cannot be empty.")
        _ -> bounded(patch_service, opened_process_info, providers, address, module_name, patched_bytes, kind, has_label, label)
    }
    state fail(patch_service: &mut PatchService, text: &[u8]) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, text);
        (PatchServiceResult::Err { error: error })
    }
    // The 256-byte descriptor carrier refuses an oversized payload —
    // upstream's Vec is unbounded; truncating a patch stream is wrong data.
    state bounded(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, address: u64, module_name: &[u8], patched_bytes: &[u8], kind: PatchKind, has_label: bool, label: &[u8]) -> PatchServiceResult {
        transition patched_bytes.len < 257 {
            true -> resolve(patch_service, opened_process_info, providers, address, module_name, patched_bytes, kind, has_label, label)
            _ -> fail(patch_service, "Patch bytes exceed the 256-byte carrier.")
        }
    }
    state resolve(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, address: u64, module_name: &[u8], patched_bytes: &[u8], kind: PatchKind, has_label: bool, label: &[u8]) -> PatchServiceResult {
        let resolved: PatchAddressResult = PatchService::resolve_absolute_address(patch_service, opened_process_info, providers, address, module_name);
        transition resolved {
            PatchAddressResult::Resolved { address } -> overlap(patch_service, opened_process_info, providers, address, module_name, patched_bytes, kind, has_label, label)
            PatchAddressResult::Err { error } -> (PatchServiceResult::Err { error: error })
        }
    }
    state overlap(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, absolute_address: u64, module_name: &[u8], patched_bytes: &[u8], kind: PatchKind, has_label: bool, label: &[u8]) -> PatchServiceResult
    {
        PatchService::ensure_process_scope(patch_service, opened_process_info);
        let patch_region: NormalizedRegion = NormalizedRegion::new(absolute_address, patched_bytes.len);
        let overlapping_position: u64 = PatchService::find_active_overlap_position(patch_service, &patch_region);
        transition overlapping_position < patch_service.patch_count && overlapping_position < 64 {
            true -> fail_overlap(patch_service, overlapping_position, &patch_region)
            _ -> read_original(patch_service, opened_process_info, providers, absolute_address, module_name, patched_bytes, kind, has_label, label)
        }
    }
    state fail_overlap(patch_service: &mut PatchService, overlapping_position: u64, patch_region: &NormalizedRegion) -> PatchServiceResult
        requires overlapping_position < patch_service.patch_count && overlapping_position < 64
    {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Patch range 0x");
        PatchServiceError::put_hex16(&mut error, NormalizedRegion::get_base_address(patch_region));
        PatchServiceError::put(&mut error, "-0x");
        PatchServiceError::put_hex16(&mut error, NormalizedRegion::get_end_address(patch_region));
        PatchServiceError::put(&mut error, " overlaps active patch '");
        PatchServiceError::put(&mut error, PatchDescriptor::get_patch_id(&patch_service.patches[overlapping_position]));
        PatchServiceError::put(&mut error, "'.");
        (PatchServiceResult::Err { error: error })
    }
    state read_original(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, absolute_address: u64, module_name: &[u8], patched_bytes: &[u8], kind: PatchKind, has_label: bool, label: &[u8]) -> PatchServiceResult {
        let patched_len: u64 = patched_bytes.len;
        transition patched_len < 257 {
            true -> read_apply(patch_service, opened_process_info, providers, absolute_address, module_name, patched_bytes, kind, has_label, label, patched_len)
            _ -> fail(patch_service, "Patch bytes exceed the 256-byte carrier.")
        }
    }
    state read_apply(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, absolute_address: u64, module_name: &[u8], patched_bytes: &[u8], kind: PatchKind, has_label: bool, label: &[u8], patched_len: u64) -> PatchServiceResult
        requires patched_len < 257
    {
        let mut original_buffer: [u8; 256] ;
        let read_result: MemoryReadResult = EngineOsProviders::read_bytes(providers, opened_process_info, absolute_address, &mut original_buffer[0 .. patched_len]);
        transition MemoryReadResult::is_complete(&read_result) {
            true -> write_patch(patch_service, opened_process_info, providers, absolute_address, module_name, patched_bytes, kind, has_label, label, &original_buffer[0 .. patched_len])
            _ -> fail_read_original(patch_service, absolute_address)
        }
    }
    state fail_read_original(patch_service: &mut PatchService, absolute_address: u64) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Failed to read original bytes at 0x");
        PatchServiceError::put_hex16(&mut error, absolute_address);
        PatchServiceError::put(&mut error, ".");
        (PatchServiceResult::Err { error: error })
    }
    state write_patch(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, absolute_address: u64, module_name: &[u8], patched_bytes: &[u8], kind: PatchKind, has_label: bool, label: &[u8], original_bytes: &[u8]) -> PatchServiceResult
    {
        let write_result: MemoryWriteResult = EngineOsProviders::write_bytes(providers, opened_process_info, absolute_address, patched_bytes);
        transition MemoryWriteResult::is_complete(&write_result) {
            true -> insert(patch_service, absolute_address, module_name, patched_bytes, kind, has_label, label, original_bytes)
            _ -> fail_write_patch(patch_service, absolute_address)
        }
    }
    state fail_write_patch(patch_service: &mut PatchService, absolute_address: u64) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Failed to write patch bytes at 0x");
        PatchServiceError::put_hex16(&mut error, absolute_address);
        PatchServiceError::put(&mut error, ".");
        (PatchServiceResult::Err { error: error })
    }
    state insert(patch_service: &mut PatchService, absolute_address: u64, module_name: &[u8], patched_bytes: &[u8], kind: PatchKind, has_label: bool, label: &[u8], original_bytes: &[u8]) -> PatchServiceResult
    {
        transition patch_service.patch_count < 64 {
            true -> allocate(patch_service, absolute_address, module_name, patched_bytes, kind, has_label, label, original_bytes)
            _ -> fail(patch_service, "Patch table is full (64 active entries).")
        }
    }
    state allocate(patch_service: &mut PatchService, absolute_address: u64, module_name: &[u8], patched_bytes: &[u8], kind: PatchKind, has_label: bool, label: &[u8], original_bytes: &[u8]) -> PatchServiceResult
        requires patch_service.patch_count < 64
    {
        let mut id_buffer: [u8; 256] ;
        let id_length: u64 = write_patch_id(&mut id_buffer, patch_service.next_patch_number);
        patch_service.next_patch_number = ((patch_service.next_patch_number as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition id_length < 257 {
            true -> fill(patch_service, absolute_address, module_name, patched_bytes, kind, has_label, label, original_bytes, &id_buffer, id_length)
            _ -> fail(patch_service, "Patch id overflowed the carrier.")
        }
    }
    state fill(patch_service: &mut PatchService, absolute_address: u64, module_name: &[u8], patched_bytes: &[u8], kind: PatchKind, has_label: bool, label: &[u8], original_bytes: &[u8], id_buffer: &[u8; 256], id_length: u64) -> PatchServiceResult
        requires patch_service.patch_count < 64 && id_length < 257
    {
        let patch_region: NormalizedRegion = NormalizedRegion::new(absolute_address, patched_bytes.len);
        let mut descriptor: PatchDescriptor = PatchDescriptor::new(&id_buffer[0 .. id_length], "", &patch_region, kind, true);
        PatchDescriptor::set_module_name(&mut descriptor, module_name);
        _ = PatchDescriptor::set_original_bytes(&mut descriptor, original_bytes);
        _ = PatchDescriptor::set_patched_bytes(&mut descriptor, patched_bytes);
        transition has_label {
            true -> label_gate(patch_service, descriptor, label)
            _ -> commit_gate(patch_service, descriptor)
        }
    }
    // `self.patch_count` facts do not cross the state boundary — each
    // guarded hop re-dominates the count bound for the callee's requires.
    state label_gate(patch_service: &mut PatchService, descriptor: PatchDescriptor, label: &[u8]) -> PatchServiceResult {
        transition patch_service.patch_count < 64 {
            true -> with_label(patch_service, descriptor, label)
            _ -> fail(patch_service, "Patch table is full (64 active entries).")
        }
    }
    state commit_gate(patch_service: &mut PatchService, descriptor: PatchDescriptor) -> PatchServiceResult {
        transition patch_service.patch_count < 64 {
            true -> commit(patch_service, descriptor)
            _ -> fail(patch_service, "Patch table is full (64 active entries).")
        }
    }
    state with_label(patch_service: &mut PatchService, descriptor: PatchDescriptor, label: &[u8]) -> PatchServiceResult
        requires patch_service.patch_count < 64
    {
        let mut labelled: PatchDescriptor = descriptor;
        PatchDescriptor::set_label(&mut labelled, label);
        transition patch_service.patch_count < 64 {
            true -> commit(patch_service, labelled)
            _ -> fail(patch_service, "Patch table is full (64 active entries).")
        }
    }
    state commit(patch_service: &mut PatchService, descriptor: PatchDescriptor) -> PatchServiceResult
        requires patch_service.patch_count < 64
    {
        let target: u64 = patch_service.patch_count;
        PatchDescriptor::clone_from(&mut patch_service.patches[target], &descriptor);
        patch_service.patch_count = ((target as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (PatchServiceResult::Ok { patch: PatchDescriptor::clone(&patch_service.patches[target]) })
    }
}

// Upstream `restore_patch` — scope, id lookup, active check, current-bytes
// equality (skipped for NoOperation kind), original-bytes write, deactivate.
pub machine PatchService::restore_patch(
    patch_service: &mut PatchService,
    opened_process_info: &OpenedProcessInfo,
    providers: &mut EngineOsProviders,
    patch_id: &[u8]
) -> PatchServiceResult
reaches FilesystemHost
invokes FilesystemHost;
{
    PatchService::ensure_process_scope(patch_service, opened_process_info);
    let position: u64 = PatchService::find_position_by_patch_id(patch_service, patch_id);
    transition position < patch_service.patch_count && position < 64 {
        true -> found(patch_service, opened_process_info, providers, position, patch_id)
        _ -> fail_missing(patch_service, patch_id)
    }
    state fail_missing(patch_service: &mut PatchService, patch_id: &[u8]) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Patch '");
        PatchServiceError::put(&mut error, patch_id);
        PatchServiceError::put(&mut error, "' does not exist.");
        (PatchServiceResult::Err { error: error })
    }
    state found(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64, patch_id: &[u8]) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        transition PatchDescriptor::get_is_active(&patch_service.patches[position]) {
            true -> sized(patch_service, opened_process_info, providers, position, patch_id)
            _ -> fail_inactive(patch_service, patch_id)
        }
    }
    state fail_inactive(patch_service: &mut PatchService, patch_id: &[u8]) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Patch '");
        PatchServiceError::put(&mut error, patch_id);
        PatchServiceError::put(&mut error, "' is already inactive.");
        (PatchServiceResult::Err { error: error })
    }
    state sized(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64, patch_id: &[u8]) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        let patch_region: &NormalizedRegion = PatchDescriptor::get_region(&patch_service.patches[position]);
        let patch_address: u64 = NormalizedRegion::get_base_address(patch_region);
        let patched_len: u64 = PatchDescriptor::get_patched_bytes(&patch_service.patches[position]).len;
        transition patched_len < 257 {
            true -> read_current(patch_service, opened_process_info, providers, position, patch_id, patch_address, patched_len)
            _ -> fail_carrier(patch_service, patch_id)
        }
    }
    state fail_carrier(patch_service: &mut PatchService, patch_id: &[u8]) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Patch '");
        PatchServiceError::put(&mut error, patch_id);
        PatchServiceError::put(&mut error, "' payload exceeds the 256-byte carrier.");
        (PatchServiceResult::Err { error: error })
    }
    // Upstream's read of `patched_bytes.len` live bytes at the patch base.
    state read_current(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64, patch_id: &[u8], patch_address: u64, patched_len: u64) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64 && patched_len < 257
    {
        let mut current_buffer: [u8; 256] ;
        let read_result: MemoryReadResult = EngineOsProviders::read_bytes(providers, opened_process_info, patch_address, &mut current_buffer[0 .. patched_len]);
        transition MemoryReadResult::is_complete(&read_result) {
            true -> compare_or_write(patch_service, opened_process_info, providers, position, patch_id, patch_address, patched_len, &current_buffer[0 .. patched_len])
            _ -> fail_read_patched(patch_service, patch_address)
        }
    }
    state fail_read_patched(patch_service: &mut PatchService, patch_address: u64) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Failed to read patched bytes at 0x");
        PatchServiceError::put_hex16(&mut error, patch_address);
        PatchServiceError::put(&mut error, ".");
        (PatchServiceResult::Err { error: error })
    }
    // Upstream skips current-vs-recorded equality for NoOperation patches.
    state compare_or_write(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64, patch_id: &[u8], patch_address: u64, patched_len: u64, current_bytes: &[u8]) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        transition patch_kind_is(PatchDescriptor::get_kind(&patch_service.patches[position]), PatchKind::NoOperation) {
            true -> write_original(patch_service, opened_process_info, providers, position, patch_id, patch_address)
            _ -> compare(patch_service, opened_process_info, providers, position, patch_id, patch_address, current_bytes)
        }
    }
    state compare(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64, patch_id: &[u8], patch_address: u64, current_bytes: &[u8]) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        transition spans_equal(current_bytes, PatchDescriptor::get_patched_bytes(&patch_service.patches[position])) {
            true -> write_original(patch_service, opened_process_info, providers, position, patch_id, patch_address)
            _ -> fail_mismatch(patch_service, patch_id)
        }
    }
    state fail_mismatch(patch_service: &mut PatchService, patch_id: &[u8]) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Patch '");
        PatchServiceError::put(&mut error, patch_id);
        PatchServiceError::put(&mut error, "' cannot be restored because target bytes no longer match the recorded patch bytes.");
        (PatchServiceResult::Err { error: error })
    }
    state write_original(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64, patch_id: &[u8], patch_address: u64) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        // Two receiver borrows: providers (&mut param) and the patch
        // record's original_bytes (&self field) — disjoint places.
        let original_bytes: &[u8] = PatchDescriptor::get_original_bytes(&patch_service.patches[position]);
        let write_result: MemoryWriteResult = EngineOsProviders::write_bytes(providers, opened_process_info, patch_address, original_bytes);
        transition MemoryWriteResult::is_complete(&write_result) {
            true -> deactivate(patch_service, position)
            _ -> fail_restore_write(patch_service, patch_address)
        }
    }
    state fail_restore_write(patch_service: &mut PatchService, patch_address: u64) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Failed to restore original bytes at 0x");
        PatchServiceError::put_hex16(&mut error, patch_address);
        PatchServiceError::put(&mut error, ".");
        (PatchServiceResult::Err { error: error })
    }
    state deactivate(patch_service: &mut PatchService, position: u64) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        PatchDescriptor::set_is_active(&mut patch_service.patches[position], false);
        (PatchServiceResult::Ok { patch: PatchDescriptor::clone(&patch_service.patches[position]) })
    }
}

// Upstream `restore_patch_at_address` — resolve, find the active patch
// containing the address, expected-kind check when supplied, restore.
pub machine PatchService::restore_patch_at_address(
    patch_service: &mut PatchService,
    opened_process_info: &OpenedProcessInfo,
    providers: &mut EngineOsProviders,
    address: u64,
    module_name: &[u8],
    has_expected_kind: bool,
    expected_kind: PatchKind
) -> PatchServiceResult
reaches FilesystemHost
invokes FilesystemHost;
{
    let resolved: PatchAddressResult = PatchService::resolve_absolute_address(patch_service, opened_process_info, providers, address, module_name);
    transition resolved {
        PatchAddressResult::Resolved { address } -> scoped(patch_service, opened_process_info, providers, address, has_expected_kind, expected_kind, address)
        PatchAddressResult::Err { error } -> (PatchServiceResult::Err { error: error })
    }
    state scoped(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, absolute_address: u64, has_expected_kind: bool, expected_kind: PatchKind, address: u64) -> PatchServiceResult {
        PatchService::ensure_process_scope(patch_service, opened_process_info);
        let position: u64 = PatchService::find_active_containing_position(patch_service, absolute_address);
        transition position < patch_service.patch_count && position < 64 {
            true -> kind_check(patch_service, opened_process_info, providers, position, absolute_address, has_expected_kind, expected_kind)
            _ -> fail_no_containing(patch_service, absolute_address, address)
        }
    }
    state fail_no_containing(patch_service: &mut PatchService, absolute_address: u64, address: u64) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "No active patch contains address 0x");
        PatchServiceError::put_hex16(&mut error, absolute_address);
        PatchServiceError::put(&mut error, ".");
        (PatchServiceResult::Err { error: error })
    }
    state kind_check(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64, absolute_address: u64, has_expected_kind: bool, expected_kind: PatchKind) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        transition has_expected_kind {
            true -> check(patch_service, opened_process_info, providers, position, absolute_address, expected_kind)
            _ -> delegate(patch_service, opened_process_info, providers, position)
        }
    }
    state check(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64, absolute_address: u64, expected_kind: PatchKind) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        transition patch_kind_is(PatchDescriptor::get_kind(&patch_service.patches[position]), expected_kind) {
            true -> delegate(patch_service, opened_process_info, providers, position)
            _ -> fail_kind(patch_service, position, absolute_address, expected_kind)
        }
    }
    state fail_kind(patch_service: &mut PatchService, position: u64, absolute_address: u64, expected_kind: PatchKind) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Active patch '");
        PatchServiceError::put(&mut error, PatchDescriptor::get_patch_id(&patch_service.patches[position]));
        PatchServiceError::put(&mut error, "' at 0x");
        PatchServiceError::put_hex16(&mut error, absolute_address);
        PatchServiceError::put(&mut error, " has kind ");
        PatchServiceError::put_kind(&mut error, PatchDescriptor::get_kind(&patch_service.patches[position]));
        PatchServiceError::put(&mut error, ", not ");
        PatchServiceError::put_kind(&mut error, expected_kind);
        PatchServiceError::put(&mut error, ".");
        (PatchServiceResult::Err { error: error })
    }
    state delegate(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        // Inline `restore_patch` on the found position — the id lookup
        // already ran; go straight at the active-check stage.
        transition PatchDescriptor::get_is_active(&patch_service.patches[position]) {
            true -> sized(patch_service, opened_process_info, providers, position)
            _ -> fail(patch_service, "Patch table changed mid-operation.")
        }
    }
    state fail(patch_service: &mut PatchService, text: &[u8]) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, text);
        (PatchServiceResult::Err { error: error })
    }
    state sized(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        let patch_region: &NormalizedRegion = PatchDescriptor::get_region(&patch_service.patches[position]);
        let patch_address: u64 = NormalizedRegion::get_base_address(patch_region);
        let patched_len: u64 = PatchDescriptor::get_patched_bytes(&patch_service.patches[position]).len;
        transition patched_len < 257 {
            true -> read_current(patch_service, opened_process_info, providers, position, patch_address, patched_len)
            _ -> fail(patch_service, "Recorded patch payload exceeds the 256-byte carrier.")
        }
    }
    state read_current(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64, patch_address: u64, patched_len: u64) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64 && patched_len < 257
    {
        let mut current_buffer: [u8; 256] ;
        let read_result: MemoryReadResult = EngineOsProviders::read_bytes(providers, opened_process_info, patch_address, &mut current_buffer[0 .. patched_len]);
        transition MemoryReadResult::is_complete(&read_result) {
            true -> compare_or_write(patch_service, opened_process_info, providers, position, patch_address, &current_buffer[0 .. patched_len])
            _ -> fail_read(patch_service, patch_address)
        }
    }
    state fail_read(patch_service: &mut PatchService, patch_address: u64) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Failed to read patched bytes at 0x");
        PatchServiceError::put_hex16(&mut error, patch_address);
        PatchServiceError::put(&mut error, ".");
        (PatchServiceResult::Err { error: error })
    }
    state compare_or_write(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64, patch_address: u64, current_bytes: &[u8]) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        transition patch_kind_is(PatchDescriptor::get_kind(&patch_service.patches[position]), PatchKind::NoOperation) {
            true -> write_original(patch_service, opened_process_info, providers, position, patch_address)
            _ -> compare(patch_service, opened_process_info, providers, position, patch_address, current_bytes)
        }
    }
    state compare(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64, patch_address: u64, current_bytes: &[u8]) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        transition spans_equal(current_bytes, PatchDescriptor::get_patched_bytes(&patch_service.patches[position])) {
            true -> write_original(patch_service, opened_process_info, providers, position, patch_address)
            _ -> fail_mismatch(patch_service, position)
        }
    }
    state fail_mismatch(patch_service: &mut PatchService, position: u64) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Patch '");
        PatchServiceError::put(&mut error, PatchDescriptor::get_patch_id(&patch_service.patches[position]));
        PatchServiceError::put(&mut error, "' cannot be restored because target bytes no longer match the recorded patch bytes.");
        (PatchServiceResult::Err { error: error })
    }
    state write_original(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo, providers: &mut EngineOsProviders, position: u64, patch_address: u64) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        let original_bytes: &[u8] = PatchDescriptor::get_original_bytes(&patch_service.patches[position]);
        let write_result: MemoryWriteResult = EngineOsProviders::write_bytes(providers, opened_process_info, patch_address, original_bytes);
        transition MemoryWriteResult::is_complete(&write_result) {
            true -> deactivate(patch_service, position)
            _ -> fail_write(patch_service, patch_address)
        }
    }
    state fail_write(patch_service: &mut PatchService, patch_address: u64) -> PatchServiceResult {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "Failed to restore original bytes at 0x");
        PatchServiceError::put_hex16(&mut error, patch_address);
        PatchServiceError::put(&mut error, ".");
        (PatchServiceResult::Err { error: error })
    }
    state deactivate(patch_service: &mut PatchService, position: u64) -> PatchServiceResult
        requires position < patch_service.patch_count && position < 64
    {
        PatchDescriptor::set_is_active(&mut patch_service.patches[position], false);
        (PatchServiceResult::Ok { patch: PatchDescriptor::clone(&patch_service.patches[position]) })
    }
}

// Upstream `list_patches` — scope check then sort by
// (base_address, patch_id); the executor reads the ordered table via
// get_patch_count/get_patch_at (upstream collects a cloned Vec).
pub machine PatchService::list_patches(patch_service: &mut PatchService, opened_process_info: &OpenedProcessInfo) {
    PatchService::ensure_process_scope(patch_service, opened_process_info);
    PatchService::sort_patches(patch_service);
}

// `sort_by(|a,b| base then patch_id)` — insertion sort over the bounded
// table; lexicographic id order matches upstream's String::cmp. Element
// exchange clones through temporaries (same shape as the catalog sorter).
machine PatchService::sort_patches(patch_service: &mut PatchService) {
    transition {
        _ -> outer(patch_service, 1)
    }
    state outer(patch_service: &mut PatchService, position: u64) {
        transition position < patch_service.patch_count && position < 64 {
            true -> walk(patch_service, position, position)
            false -> done(patch_service)
        }
    }
    state walk(patch_service: &mut PatchService, position: u64, cursor: u64)
        requires position < 64 && cursor < 64
    {
        transition cursor > 0 {
            true -> probe(patch_service, position, cursor)
            false -> outer(patch_service, position + 1)
        }
    }
    state probe(patch_service: &mut PatchService, position: u64, cursor: u64)
        requires position < 64 && 0 < cursor && cursor < 64
    {
        let prior: u64 = cursor - 1;
        // `prior` needs the dominated bound spelled — arithmetic actuals are
        // not normalized into a callee's requires.
        transition prior < 64 {
            true -> compare(patch_service, position, cursor, prior)
            _ -> outer(patch_service, position + 1)
        }
    }
    state compare(patch_service: &mut PatchService, position: u64, cursor: u64, prior: u64)
        requires position < 64 && cursor < 64 && prior < 64
    {
        transition cursor < patch_service.patch_count && prior < patch_service.patch_count {
            true -> decide(patch_service, position, cursor, prior)
            false -> outer(patch_service, position + 1)
        }
    }
    state decide(patch_service: &mut PatchService, position: u64, cursor: u64, prior: u64)
        requires position < 64 && cursor < 64 && prior < 64
    {
        transition PatchService::patch_before(patch_service, cursor, prior) {
            true -> swap_patches(patch_service, position, cursor, prior)
            false -> outer(patch_service, position + 1)
            _ -> outer(patch_service, position + 1)
        }
    }
    state swap_patches(patch_service: &mut PatchService, position: u64, cursor: u64, prior: u64)
        requires position < 64 && cursor < 64 && prior < 64
    {
        let prior_copy: PatchDescriptor = PatchDescriptor::clone(&patch_service.patches[prior]);
        let cursor_copy: PatchDescriptor = PatchDescriptor::clone(&patch_service.patches[cursor]);
        PatchDescriptor::clone_from(&mut patch_service.patches[cursor], &prior_copy);
        PatchDescriptor::clone_from(&mut patch_service.patches[prior], &cursor_copy);
        transition {
            _ -> walk(patch_service, position, prior)
        }
    }
    state done(patch_service: &mut PatchService) {
    }
}

// `a.base < b.base || (equal && a.patch_id < b.patch_id)` — the insertion
// sort's strict ordering at adjacent positions.
machine PatchService::patch_before(patch_service: &PatchService, left: u64, right: u64) -> bool
    requires left < 64 && right < 64
{
    let left_region: &NormalizedRegion = PatchDescriptor::get_region(&patch_service.patches[left]);
    let right_region: &NormalizedRegion = PatchDescriptor::get_region(&patch_service.patches[right]);
    transition NormalizedRegion::get_base_address(left_region) < NormalizedRegion::get_base_address(right_region) {
        true -> (true)
        _ -> compare_base_equal(patch_service, left, right)
    }
    state compare_base_equal(patch_service: &PatchService, left: u64, right: u64) -> bool
        requires left < 64 && right < 64
    {
        let left_region: &NormalizedRegion = PatchDescriptor::get_region(&patch_service.patches[left]);
        let right_region: &NormalizedRegion = PatchDescriptor::get_region(&patch_service.patches[right]);
        transition NormalizedRegion::get_base_address(left_region) == NormalizedRegion::get_base_address(right_region) {
            true -> compare_ids(patch_service, left, right)
            _ -> (false)
        }
    }
    state compare_ids(patch_service: &PatchService, left: u64, right: u64) -> bool
        requires left < 64 && right < 64
    {
        (span_lex_less(PatchDescriptor::get_patch_id(&patch_service.patches[left]), PatchDescriptor::get_patch_id(&patch_service.patches[right])))
    }
}

// `String::cmp` — lexicographic byte order, shorter wins on prefix-equal.
machine span_lex_less(left: &[u8], right: &[u8]) -> bool {
    transition {
        _ -> scan(left, right, 0)
    }
    state scan(left: &[u8], right: &[u8], position: u64) -> bool {
        transition position < left.len && position < right.len {
            true -> check(left, right, position)
            _ -> finish(left, right, position)
        }
    }
    state check(left: &[u8], right: &[u8], position: u64) -> bool
        requires position < left.len && position < right.len
    {
        transition left[position] == right[position] {
            true -> scan(left, right, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> decide(left[position], right[position])
        }
    }
    state decide(left_byte: u8, right_byte: u8) -> bool {
        (left_byte < right_byte)
    }
    state finish(left: &[u8], right: &[u8], position: u64) -> bool {
        transition position < left.len {
            true -> (false)
            _ -> (position < right.len)
        }
    }
}
