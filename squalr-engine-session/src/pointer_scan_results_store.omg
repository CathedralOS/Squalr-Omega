module src::pointer_scan_results_store;

use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_address_space::PointerScanAddressSpace;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_candidate::PointerScanCandidate;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_level::PointerScanLevel;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_level_candidates::PointerScanLevelCandidates;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_node::PointerScanNode;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_results::MaterializedPageKeyEntry;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_results::PointerScanModuleName;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_results::PointerScanResults;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_target_descriptor::PointerScanTargetDescriptor;

// Port of the engine-side `Arc<RwLock<Option<PointerScanResults>>>` store —
// upstream owns growable Vecs; the port's `PointerScanResults` borrows
// caller extents, so the store owns bounded backing arenas and reassembles
// a borrowed view per access (upstream's read()/write() guard window).
//
// Bounds (named deviations; upstream is unbounded):
//   targets 64, module names 32, levels 8 (covers max_depth <= 8),
//   4096 static + 4096 heap candidates, 512 materialized nodes,
//   512 node-id slab entries, 64 page-key cache rows.
// Scans exceeding a bound degrade the way the extents already do upstream
// under a cap (builder reports what fits; materialized overflow sets the
// persisted flag) — no results are silently invented.
pub data PointerScanResultsStore {
    has_results: bool;
    session_id: u64;
    target_descriptor: PointerScanTargetDescriptor;
    address_space: PointerScanAddressSpace;
    pointer_size: PointerScanPointerSize;
    max_depth: u64;
    offset_radius: u64;
    root_node_count: u64;
    total_node_count: u64;
    total_static_node_count: u64;
    total_heap_node_count: u64;
    materialized_nodes_overflowed: bool;
    target_addresses: [u64; 64];
    target_address_count: u64;
    module_names: [PointerScanModuleName; 32];
    module_name_count: u64;
    levels: [PointerScanLevel; 8];
    level_count: u64;
    // Per-level arena windows — rebuilt into borrowed `level_candidates`
    // entries on each assemble. The builder fills windows contiguously in
    // level order; `commit_level_windows` records each level's
    // (start, count) so later accessors re-slice the same arenas.
    level_static_starts: [u64; 8];
    level_static_counts: [u64; 8];
    level_heap_starts: [u64; 8];
    level_heap_counts: [u64; 8];
    static_candidate_arena: [PointerScanCandidate; 4096];
    static_candidate_arena_count: u64;
    heap_candidate_arena: [PointerScanCandidate; 4096];
    heap_candidate_arena_count: u64;
    materialized_nodes: [PointerScanNode; 512];
    materialized_node_count: u64;
    materialized_node_id_slab: [u64; 512];
    materialized_node_id_slab_count: u64;
    page_key_cache: [MaterializedPageKeyEntry; 64];
    page_key_cache_count: u64;
    next_materialized_node_id: u64;
}

pub machine PointerScanResultsStore::empty() -> PointerScanResultsStore {
    PointerScanResultsStore {
        has_results: false,
        target_address_count: 0,
        module_name_count: 0,
        level_count: 0,
        static_candidate_arena_count: 0,
        heap_candidate_arena_count: 0,
        materialized_node_count: 0,
        materialized_node_id_slab_count: 0,
        page_key_cache_count: 0,
        // Upstream allocates materialized node ids from 1.
        next_materialized_node_id: 1,
    }
}

// Upstream `*pointer_scan_results_guard = None`.
pub machine PointerScanResultsStore::clear(this: &mut PointerScanResultsStore) {
    this.has_results = false;
    this.target_address_count = 0;
    this.module_name_count = 0;
    this.level_count = 0;
    this.static_candidate_arena_count = 0;
    this.heap_candidate_arena_count = 0;
    this.materialized_node_count = 0;
    this.materialized_node_id_slab_count = 0;
    this.page_key_cache_count = 0;
    this.next_materialized_node_id = 1;
}

pub machine PointerScanResultsStore::has_results(this: &PointerScanResultsStore) -> bool {
    this.has_results
}

// The scan header — written by the start/validate executors once
// `execute_scan`/`validate_scan` returns its assembled view (the arenas
// themselves are already this store's fields).
pub machine PointerScanResultsStore::commit_header(
    this: &mut PointerScanResultsStore,
    session_id: u64,
    target_descriptor: PointerScanTargetDescriptor,
    address_space: PointerScanAddressSpace,
    pointer_size: PointerScanPointerSize,
    max_depth: u64,
    offset_radius: u64,
    root_node_count: u64,
    total_node_count: u64,
    total_static_node_count: u64,
    total_heap_node_count: u64,
    target_address_count: u64,
    module_name_count: u64,
    level_count: u64,
    materialized_node_count: u64,
    materialized_node_id_slab_count: u64,
    page_key_cache_count: u64,
    next_materialized_node_id: u64,
    materialized_nodes_overflowed: bool
) {
    this.has_results = true;
    this.session_id = session_id;
    this.target_descriptor = target_descriptor;
    this.address_space = address_space;
    this.pointer_size = pointer_size;
    this.max_depth = max_depth;
    this.offset_radius = offset_radius;
    this.root_node_count = root_node_count;
    this.total_node_count = total_node_count;
    this.total_static_node_count = total_static_node_count;
    this.total_heap_node_count = total_heap_node_count;
    this.target_address_count = target_address_count;
    this.module_name_count = module_name_count;
    this.level_count = level_count;
    this.static_candidate_arena_count = 0;
    this.heap_candidate_arena_count = 0;
    this.materialized_node_count = materialized_node_count;
    this.materialized_node_id_slab_count = materialized_node_id_slab_count;
    this.page_key_cache_count = page_key_cache_count;
    this.next_materialized_node_id = next_materialized_node_id;
    this.materialized_nodes_overflowed = materialized_nodes_overflowed;
}

// Records each level's (start, count) arena windows after a scan — the
// builder packs candidates contiguously in level order, so a level's window
// starts where the previous level's ended. Callers capture the per-level
// node counts off the `level_candidates` array `execute_scan` filled and
// pass them here (borrowed views cannot survive a state transition).
pub machine PointerScanResultsStore::commit_level_windows(
    this: &mut PointerScanResultsStore,
    level_static_counts: &[u64; 8],
    level_heap_counts: &[u64; 8],
    level_count: u64
) {
    transition { _ -> walk(this, level_static_counts, level_heap_counts, level_count, 0, 0, 0) }

    state walk(
        this: &mut PointerScanResultsStore,
        level_static_counts: &[u64; 8],
        level_heap_counts: &[u64; 8],
        level_count: u64,
        level_index: u64,
        static_cursor: u64,
        heap_cursor: u64
    ) {
        transition level_index < level_count && level_index < 8 {
            true -> record(this, level_static_counts, level_heap_counts, level_count, level_index, static_cursor, heap_cursor)
            false -> done(this, static_cursor, heap_cursor)
            _ -> done(this, static_cursor, heap_cursor)
        }
    }
    state record(
        this: &mut PointerScanResultsStore,
        level_static_counts: &[u64; 8],
        level_heap_counts: &[u64; 8],
        level_count: u64,
        level_index: u64,
        static_cursor: u64,
        heap_cursor: u64
    )
    requires 0 <= level_index && level_index < 8;
    {
        let static_count: u64 = level_static_counts[level_index];
        let heap_count: u64 = level_heap_counts[level_index];
        this.level_static_starts[level_index] = static_cursor;
        this.level_static_counts[level_index] = static_count;
        this.level_heap_starts[level_index] = heap_cursor;
        this.level_heap_counts[level_index] = heap_count;
        transition { _ -> walk(this, 
            level_static_counts,
            level_heap_counts,
            level_count,
            ((level_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64,
            ((static_cursor as u64 in Wrapping) + (static_count as u64 in Wrapping)) as u64,
            ((heap_cursor as u64 in Wrapping) + (heap_count as u64 in Wrapping)) as u64) }
    }
    state done(this: &mut PointerScanResultsStore, static_cursor: u64, heap_cursor: u64) {
        this.static_candidate_arena_count = static_cursor;
        this.heap_candidate_arena_count = heap_cursor;
    }
}

// Write-back of the scalar fields a view mutates — upstream mutates the
// stored record in place; the port's view copies scalars, so executors
// commit the counters/flags back after each access window. Scalar params,
// not the view itself: a `&PointerScanResults` argument would alias the
// `&mut self` the store arenas still carry.
pub machine PointerScanResultsStore::commit_view_scalars(
    this: &mut PointerScanResultsStore,
    root_node_count: u64,
    total_node_count: u64,
    total_static_node_count: u64,
    total_heap_node_count: u64,
    materialized_node_count: u64,
    materialized_node_id_slab_count: u64,
    page_key_cache_count: u64,
    next_materialized_node_id: u64,
    materialized_nodes_overflowed: bool
) {
    this.root_node_count = root_node_count;
    this.total_node_count = total_node_count;
    this.total_static_node_count = total_static_node_count;
    this.total_heap_node_count = total_heap_node_count;
    this.materialized_node_count = materialized_node_count;
    this.materialized_node_id_slab_count = materialized_node_id_slab_count;
    this.page_key_cache_count = page_key_cache_count;
    this.next_materialized_node_id = next_materialized_node_id;
    this.materialized_nodes_overflowed = materialized_nodes_overflowed;
}

pub machine PointerScanResultsStore::get_session_id(this: &PointerScanResultsStore) -> u64 {
    this.session_id
}

pub machine PointerScanResultsStore::get_root_node_count(this: &PointerScanResultsStore) -> u64 {
    this.root_node_count
}

pub machine PointerScanResultsStore::get_total_node_count(this: &PointerScanResultsStore) -> u64 {
    this.total_node_count
}

pub machine PointerScanResultsStore::get_total_static_node_count(this: &PointerScanResultsStore) -> u64 {
    this.total_static_node_count
}

pub machine PointerScanResultsStore::get_total_heap_node_count(this: &PointerScanResultsStore) -> u64 {
    this.total_heap_node_count
}

pub machine PointerScanResultsStore::get_level_count(this: &PointerScanResultsStore) -> u64 {
    this.level_count
}

pub machine PointerScanResultsStore::get_level(this: &PointerScanResultsStore, level_index: u64) -> PointerScanLevel {
    transition level_index < this.level_count && level_index < 8 {
        true -> arm_result_259_0(this, level_index)
        _ -> (PointerScanLevel::new(0, 0, 0, 0))
    }
    state arm_result_259_0(this: &PointerScanResultsStore, level_index: u64) -> PointerScanLevel
    
    requires level_index < this.level_count && level_index < 8;
{
        (this.levels[level_index])
    }
}

// Arena extents as one disjoint-borrow bundle — a single `&mut self` call
// mints the whole set (per-field accessors would need seven overlapping
// `&mut` borrows of the same record, which no borrow checker admits). The
// lifetime names match `PointerScanResults`/`execute_scan`'s so callers can
// hand fields straight through.
pub data PointerScanResultsArenas<'ext, 'sh, 's, 'h> {
    target_addresses: &'ext mut [u64];
    module_names: &'ext mut [PointerScanModuleName];
    levels: &'sh mut [PointerScanLevel];
    static_candidate_arena: &'s mut [PointerScanCandidate];
    heap_candidate_arena: &'h mut [PointerScanCandidate];
    materialized_nodes: &'ext mut [PointerScanNode];
    materialized_node_id_slab: &'ext mut [u64];
    page_key_cache: &'ext mut [MaterializedPageKeyEntry];
}

pub machine PointerScanResultsStore::borrow_arenas_mut<'ext, 'sh, 's, 'h>(
    this: &mut PointerScanResultsStore) -> PointerScanResultsArenas<'ext, 'sh, 's, 'h> {
    PointerScanResultsArenas {
        target_addresses: &mut this.target_addresses,
        module_names: &mut this.module_names,
        levels: &mut this.levels,
        static_candidate_arena: &mut this.static_candidate_arena,
        heap_candidate_arena: &mut this.heap_candidate_arena,
        materialized_nodes: &mut this.materialized_nodes,
        materialized_node_id_slab: &mut this.materialized_node_id_slab,
        page_key_cache: &mut this.page_key_cache,
    }
}

// Validation output is written into caller-owned arenas (upstream hands the
// freshly built `PointerScanResults` its own Vecs — the prior results stay
// readable under their session id). The single-slot store folds that to:
// validate writes a separate arena set, then this commits the contents over
// the stored arenas — the stored results become the validated ones and the
// pre-validation entry is dropped (bounded-store deviation; upstream keeps
// both keyed by distinct session ids).
pub data PointerScanValidationArenas {
    target_addresses: [u64; 64];
    target_address_count: u64;
    module_names: [PointerScanModuleName; 32];
    module_name_count: u64;
    levels: [PointerScanLevel; 8];
    level_count: u64;
    static_candidate_arena: [PointerScanCandidate; 4096];
    heap_candidate_arena: [PointerScanCandidate; 4096];
    materialized_nodes: [PointerScanNode; 512];
    materialized_node_id_slab: [u64; 512];
    page_key_cache: [MaterializedPageKeyEntry; 64];
}

// One disjoint-borrow bundle for the validation arenas — same reason as
// `PointerScanResultsArenas`: per-field accessors cannot produce nine live
// `&mut` borrows of one record.
pub data PointerScanValidationArenaViews<'ext> {
    target_addresses: &'ext mut [u64];
    module_names: &'ext mut [PointerScanModuleName];
    levels: &'ext mut [PointerScanLevel];
    static_candidate_arena: &'ext mut [PointerScanCandidate];
    heap_candidate_arena: &'ext mut [PointerScanCandidate];
    materialized_nodes: &'ext mut [PointerScanNode];
    materialized_node_id_slab: &'ext mut [u64];
    page_key_cache: &'ext mut [MaterializedPageKeyEntry];
}

pub machine PointerScanValidationArenas::borrow_views_mut<'ext>(
    this: &mut PointerScanValidationArenas) -> PointerScanValidationArenaViews<'ext> {
    PointerScanValidationArenaViews {
        target_addresses: &mut this.target_addresses,
        module_names: &mut this.module_names,
        levels: &mut this.levels,
        static_candidate_arena: &mut this.static_candidate_arena,
        heap_candidate_arena: &mut this.heap_candidate_arena,
        materialized_nodes: &mut this.materialized_nodes,
        materialized_node_id_slab: &mut this.materialized_node_id_slab,
        page_key_cache: &mut this.page_key_cache,
    }
}

pub machine PointerScanValidationArenas::empty() -> PointerScanValidationArenas {
    PointerScanValidationArenas {
        target_address_count: 0,
        module_name_count: 0,
        level_count: 0,
    }
}

pub machine PointerScanValidationArenas::borrow_target_addresses_mut(this: &mut PointerScanValidationArenas) -> &mut [u64] {
    &mut this.target_addresses
}
pub machine PointerScanValidationArenas::borrow_module_names_mut(this: &mut PointerScanValidationArenas) -> &mut [PointerScanModuleName] {
    &mut this.module_names
}
pub machine PointerScanValidationArenas::borrow_levels_mut(this: &mut PointerScanValidationArenas) -> &mut [PointerScanLevel] {
    &mut this.levels
}
pub machine PointerScanValidationArenas::borrow_static_candidate_arena_mut(this: &mut PointerScanValidationArenas) -> &mut [PointerScanCandidate] {
    &mut this.static_candidate_arena
}
pub machine PointerScanValidationArenas::borrow_heap_candidate_arena_mut(this: &mut PointerScanValidationArenas) -> &mut [PointerScanCandidate] {
    &mut this.heap_candidate_arena
}
pub machine PointerScanValidationArenas::borrow_materialized_nodes_mut(this: &mut PointerScanValidationArenas) -> &mut [PointerScanNode] {
    &mut this.materialized_nodes
}
pub machine PointerScanValidationArenas::borrow_materialized_node_id_slab_mut(this: &mut PointerScanValidationArenas) -> &mut [u64] {
    &mut this.materialized_node_id_slab
}
pub machine PointerScanValidationArenas::borrow_page_key_cache_mut(this: &mut PointerScanValidationArenas) -> &mut [MaterializedPageKeyEntry] {
    &mut this.page_key_cache
}

// Commits the validated arena contents into the stored arenas — element
// copies bounded by the validated counts upstream's builder reports.
pub machine PointerScanResultsStore::commit_validated_arenas(
    this: &mut PointerScanResultsStore,
    arenas: &PointerScanValidationArenas,
    target_address_count: u64,
    module_name_count: u64,
    level_count: u64,
    materialized_node_count: u64,
    materialized_node_id_slab_count: u64,
    page_key_cache_count: u64
) {
    transition { _ -> targets(this, arenas, target_address_count, module_name_count, level_count, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, 0) }

    state targets(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, target_address_count: u64, module_name_count: u64, level_count: u64, materialized_node_count: u64, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64) {
        transition position < target_address_count && position < 64 {
            true -> target(this, arenas, target_address_count, module_name_count, level_count, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, position)
            false -> names(this, arenas, module_name_count, level_count, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, 0)
        }
    }
    state target(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, target_address_count: u64, module_name_count: u64, level_count: u64, materialized_node_count: u64, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64)
    requires 0 <= position && position < 64;
    {
        this.target_addresses[position] = arenas.target_addresses[position];
        transition { _ -> targets(this, arenas, target_address_count, module_name_count, level_count, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, position + 1) }
    }
    state names(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, module_name_count: u64, level_count: u64, materialized_node_count: u64, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64) {
        transition position < module_name_count && position < 32 {
            true -> name(this, arenas, module_name_count, level_count, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, position)
            false -> levels(this, arenas, level_count, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, 0)
        }
    }
    state name(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, module_name_count: u64, level_count: u64, materialized_node_count: u64, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64)
    requires 0 <= position && position < 32;
    {
        PointerScanModuleName::clone_from(&mut this.module_names[position], &arenas.module_names[position]);
        transition { _ -> names(this, arenas, module_name_count, level_count, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, position + 1) }
    }
    state levels(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, level_count: u64, materialized_node_count: u64, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64) {
        transition position < level_count && position < 8 {
            true -> level(this, arenas, level_count, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, position)
            false -> statics(this, arenas, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, 0)
        }
    }
    state level(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, level_count: u64, materialized_node_count: u64, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64)
    requires 0 <= position && position < 8;
    {
        this.levels[position] = arenas.levels[position];
        transition { _ -> levels(this, arenas, level_count, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, position + 1) }
    }
    // statics/heaps bounded by the arena counts commit_level_windows set.
    state statics(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, materialized_node_count: u64, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64) {
        transition position < this.static_candidate_arena_count && position < 4096 {
            true -> static_one(this, arenas, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, position)
            false -> heaps(this, arenas, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, 0)
        }
    }
    state static_one(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, materialized_node_count: u64, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64)
    requires 0 <= position && position < 4096;
    {
        this.static_candidate_arena[position] = arenas.static_candidate_arena[position];
        transition { _ -> statics(this, arenas, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, position + 1) }
    }
    state heaps(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, materialized_node_count: u64, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64) {
        transition position < this.heap_candidate_arena_count && position < 4096 {
            true -> heap_one(this, arenas, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, position)
            false -> nodes(this, arenas, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, 0)
        }
    }
    state heap_one(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, materialized_node_count: u64, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64)
    requires 0 <= position && position < 4096;
    {
        this.heap_candidate_arena[position] = arenas.heap_candidate_arena[position];
        transition { _ -> heaps(this, arenas, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, position + 1) }
    }
    state nodes(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, materialized_node_count: u64, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64) {
        transition position < materialized_node_count && position < 512 {
            true -> node(this, arenas, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, position)
            false -> ids(this, arenas, materialized_node_id_slab_count, page_key_cache_count, 0)
        }
    }
    state node(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, materialized_node_count: u64, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64)
    requires 0 <= position && position < 512;
    {
        this.materialized_nodes[position] = arenas.materialized_nodes[position];
        transition { _ -> nodes(this, arenas, materialized_node_count, materialized_node_id_slab_count, page_key_cache_count, position + 1) }
    }
    state ids(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64) {
        transition position < materialized_node_id_slab_count && position < 512 {
            true -> id(this, arenas, materialized_node_id_slab_count, page_key_cache_count, position)
            false -> keys(this, arenas, page_key_cache_count, 0)
        }
    }
    state id(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, materialized_node_id_slab_count: u64, page_key_cache_count: u64, position: u64)
    requires 0 <= position && position < 512;
    {
        this.materialized_node_id_slab[position] = arenas.materialized_node_id_slab[position];
        transition { _ -> ids(this, arenas, materialized_node_id_slab_count, page_key_cache_count, position + 1) }
    }
    state keys(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, page_key_cache_count: u64, position: u64) {
        transition position < page_key_cache_count && position < 64 {
            true -> key(this, arenas, page_key_cache_count, position)
            false -> done(this)
        }
    }
    state key(this: &mut PointerScanResultsStore, arenas: &PointerScanValidationArenas, page_key_cache_count: u64, position: u64)
    requires 0 <= position && position < 64;
    {
        this.page_key_cache[position] = arenas.page_key_cache[position];
        transition { _ -> keys(this, arenas, page_key_cache_count, position + 1) }
    }
    state done(this: &mut PointerScanResultsStore) {
    }
}

// Reassembles the borrowed `PointerScanResults` view upstream callers hold
// through the store guard. `level_candidates_view` is caller storage —
// its elements are rebuilt per access from the recorded arena windows.
pub machine PointerScanResultsStore::assemble_results_view<'ext, 'sh, 's, 'h>(
    this: &mut PointerScanResultsStore,
    level_candidates_view: &'ext mut [PointerScanLevelCandidates<'s, 'h>; 8]
) -> PointerScanResults<'ext, 'sh, 's, 'h> {
    transition { _ -> fill_windows(this, level_candidates_view, 0) }

    state fill_windows(
        this: &mut PointerScanResultsStore,
        level_candidates_view: &'ext mut [PointerScanLevelCandidates<'s, 'h>; 8],
        level_index: u64
    ) -> PointerScanResults<'ext, 'sh, 's, 'h> {
        transition level_index < this.level_count && level_index < 8 {
            true -> fill_window(this, level_candidates_view, level_index)
            false -> build(this, level_candidates_view)
            _ -> build(this, level_candidates_view)
        }
    }
    state fill_window(
        this: &mut PointerScanResultsStore,
        level_candidates_view: &'ext mut [PointerScanLevelCandidates<'s, 'h>; 8],
        level_index: u64
    ) -> PointerScanResults<'ext, 'sh, 's, 'h>
    requires 0 <= level_index && level_index < 8;
    {
        let static_start: u64 = this.level_static_starts[level_index];
        let static_count: u64 = this.level_static_counts[level_index];
        let heap_start: u64 = this.level_heap_starts[level_index];
        let heap_count: u64 = this.level_heap_counts[level_index];
        let depth: u64 = PointerScanLevel::get_depth(&this.levels[level_index]);
        // Recorded windows are committed from executor counts bounded by
        // the arenas; the guard degrades a corrupt record to an empty
        // window instead of an unchecked subslice.
        transition static_start < 4096 && static_count <= 4096 && heap_start < 4096 && heap_count <= 4096 {
            true -> fill_window_checked(this, level_candidates_view, level_index, depth, static_start, static_count, heap_start, heap_count)
            false -> fill_window_checked(this, level_candidates_view, level_index, depth, 4095, 0, 4095, 0)
            _ -> fill_window_checked(this, level_candidates_view, level_index, depth, 4095, 0, 4095, 0)
        }
    }
    state fill_window_checked(
        this: &mut PointerScanResultsStore,
        level_candidates_view: &'ext mut [PointerScanLevelCandidates<'s, 'h>; 8],
        level_index: u64,
        depth: u64,
        static_start: u64,
        static_count: u64,
        heap_start: u64,
        heap_count: u64
    ) -> PointerScanResults<'ext, 'sh, 's, 'h>
    requires 0 <= level_index && level_index < 8 && 0 <= static_start && static_start < 4096 && 0 <= static_count && static_count < 4097 && 0 <= heap_start && heap_start < 4096 && 0 <= heap_count && heap_count < 4097;
    {
        let static_end: u64 = static_start + static_count;
        let heap_end: u64 = heap_start + heap_count;
        transition static_start <= static_end && static_end <= 4096 && heap_start <= heap_end && heap_end <= 4096 {
            true -> fill_window_write(this, level_candidates_view, level_index, depth,
                static_start,
                static_count,
                heap_start,
                heap_count)
            false -> fill_window_write(this, level_candidates_view, level_index, depth,
                0,
                0,
                0,
                0)
            _ -> fill_window_write(this, level_candidates_view, level_index, depth,
                0,
                0,
                0,
                0)
        }
    }
    state fill_window_write(
        this: &mut PointerScanResultsStore,
        level_candidates_view: &'ext mut [PointerScanLevelCandidates<'s, 'h>; 8],
        level_index: u64,
        depth: u64,
        static_start: u64,
        static_count: u64,
        heap_start: u64,
        heap_count: u64
    ) -> PointerScanResults<'ext, 'sh, 's, 'h>
    requires 0 <= level_index && level_index < 8 && static_start < 4097 && heap_start < 4097;
    {
        // Alias rule: `&this.<arena>` loans may not cross a `&mut this` state
        // boundary, so the windows are produced inside this state. The wider
        // `[start..4096]` slice is observationally identical —
        // `get_static_candidates`/`get_heap_candidates` re-slice by the
        // record's count field — and `start <= 4096` is provable from
        // `start < 4097` where `start + count` was not.
        let static_window: &[PointerScanCandidate] = &this.static_candidate_arena[static_start..4096];
        let heap_window: &[PointerScanCandidate] = &this.heap_candidate_arena[heap_start..4096];
        level_candidates_view[level_index] = PointerScanLevelCandidates::new_presorted(
            depth,
            static_window,
            static_count,
            heap_window,
            heap_count);
        transition { _ -> fill_windows(this, level_candidates_view, level_index + 1) }
    }
    state build(
        this: &mut PointerScanResultsStore,
        level_candidates_view: &'ext mut [PointerScanLevelCandidates<'s, 'h>; 8]
    ) -> PointerScanResults<'ext, 'sh, 's, 'h> {
        // PointerScanResults::new re-sorts/dedups target addresses and
        // recomputes root/total counts — idempotent on already-scanned
        // data; the persisted overflow flag is restored after.
        let cloned_descriptor: PointerScanTargetDescriptor = PointerScanTargetDescriptor::clone(&this.target_descriptor);
        let mut pointer_scan_results: PointerScanResults<'ext, 'sh, 's, 'h> = PointerScanResults::new(
            this.session_id,
            cloned_descriptor,
            &mut this.target_addresses,
            this.target_address_count,
            this.address_space,
            this.pointer_size,
            this.max_depth,
            this.offset_radius,
            &mut this.module_names,
            this.module_name_count,
            &this.levels,
            this.level_count,
            level_candidates_view,
            this.level_count,
            this.total_static_node_count,
            this.total_heap_node_count,
            &mut this.materialized_nodes,
            &mut this.materialized_node_id_slab,
            &mut this.page_key_cache);
        PointerScanResults::restore_materialization_state(&mut pointer_scan_results, this.materialized_node_count,
            this.materialized_node_id_slab_count,
            this.page_key_cache_count,
            this.next_materialized_node_id,
            this.materialized_nodes_overflowed);
        transition { _ -> (pointer_scan_results) }
    }
}
