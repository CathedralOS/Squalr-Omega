// Upstream `list_sessions` product — both collected pages + a sort surface
// (insertion sort by trace_session_id; records by (id, instruction_address)).
pub data DebuggerTraceListOutcome {
    trace_sessions: [DebuggerTraceSessionDescriptor; 16];
    trace_session_count: u64;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

pub machine DebuggerTraceListOutcome::new() -> DebuggerTraceListOutcome {
    DebuggerTraceListOutcome {
        trace_session_count: 0,
        instruction_record_count: 0,
    }
}

pub machine DebuggerTraceListOutcome::add_trace_session(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, trace_session: &DebuggerTraceSessionDescriptor) -> bool {
    transition debugger_trace_list_outcome.trace_session_count < 16 {
        true -> store(debugger_trace_list_outcome, trace_session)
        _ -> (false)
    }
    state store(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, trace_session: &DebuggerTraceSessionDescriptor) -> bool {
        DebuggerTraceSessionDescriptor::clone_from(&mut debugger_trace_list_outcome.trace_sessions[debugger_trace_list_outcome.trace_session_count], trace_session);
        debugger_trace_list_outcome.trace_session_count = ((debugger_trace_list_outcome.trace_session_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

pub machine DebuggerTraceListOutcome::add_instruction_record(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
    transition debugger_trace_list_outcome.instruction_record_count < 16 {
        true -> store(debugger_trace_list_outcome, instruction_record)
        _ -> (false)
    }
    state store(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
        DebuggerTraceInstructionRecord::clone_from(&mut debugger_trace_list_outcome.instruction_records[debugger_trace_list_outcome.instruction_record_count], instruction_record);
        debugger_trace_list_outcome.instruction_record_count = ((debugger_trace_list_outcome.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

// Insertion sort over collected sessions by trace_session_id (ascending).
pub machine DebuggerTraceListOutcome::sort_trace_sessions(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome) {
    transition { _ -> scan(debugger_trace_list_outcome, 1) }
    state scan(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, position: u64) {
        transition position < debugger_trace_list_outcome.trace_session_count && position < 16 {
            true -> sift(debugger_trace_list_outcome, position)
            _ -> (debugger_trace_list_outcome)
        }
    }
    state sift(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, position: u64)
        requires position < 16
    {
        // Move element left while its id < the previous slot's id.
        transition position > 0 {
            true -> compare(debugger_trace_list_outcome, position)
            _ -> advance(debugger_trace_list_outcome, position)
        }
    }
    state compare(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, position: u64)
        requires position < 16
    {
        let previous: u64 = position - 1;
        transition previous < 16 {
            true -> test(debugger_trace_list_outcome, position, previous)
            _ -> advance(debugger_trace_list_outcome, position)
        }
    }
    state test(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, position: u64, previous: u64)
        requires position < 16 && previous < 16
    {
        let left_id: &[u8] = DebuggerTraceSessionDescriptor::get_trace_session_id(&debugger_trace_list_outcome.trace_sessions[position]);
        let right_id: &[u8] = DebuggerTraceSessionDescriptor::get_trace_session_id(&debugger_trace_list_outcome.trace_sessions[previous]);
        let swap: bool = DebuggerService::span_less(left_id, right_id);
        transition swap {
            true -> swap_slots(debugger_trace_list_outcome, position, previous)
            _ -> advance(debugger_trace_list_outcome, position)
        }
    }
    state swap_slots(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, position: u64, previous: u64)
        requires position < 16 && previous < 16
    {
        let moved: DebuggerTraceSessionDescriptor = DebuggerTraceSessionDescriptor::clone(&debugger_trace_list_outcome.trace_sessions[position]);
        let displaced: DebuggerTraceSessionDescriptor = DebuggerTraceSessionDescriptor::clone(&debugger_trace_list_outcome.trace_sessions[previous]);
        DebuggerTraceSessionDescriptor::clone_from(&mut debugger_trace_list_outcome.trace_sessions[position], &displaced);
        DebuggerTraceSessionDescriptor::clone_from(&mut debugger_trace_list_outcome.trace_sessions[previous], &moved);
        transition { _ -> sift(debugger_trace_list_outcome, previous) }
    }
    state advance(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, position: u64)
        requires position < 16
    {
        transition { _ -> scan(debugger_trace_list_outcome, position + 1) }
    }
}

// Insertion sort over collected records by (trace_session_id,
// instruction_address) — upstream's two-key comparator.
pub machine DebuggerTraceListOutcome::sort_instruction_records(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome) {
    transition { _ -> scan(debugger_trace_list_outcome, 1) }
    state scan(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, position: u64) {
        transition position < debugger_trace_list_outcome.instruction_record_count && position < 16 {
            true -> sift(debugger_trace_list_outcome, position)
            _ -> (debugger_trace_list_outcome)
        }
    }
    state sift(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, position: u64)
        requires position < 16
    {
        transition position > 0 {
            true -> compare(debugger_trace_list_outcome, position)
            _ -> advance(debugger_trace_list_outcome, position)
        }
    }
    state compare(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, position: u64)
        requires position < 16
    {
        let previous: u64 = position - 1;
        transition previous < 16 {
            true -> test(debugger_trace_list_outcome, position, previous)
            _ -> advance(debugger_trace_list_outcome, position)
        }
    }
    state test(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, position: u64, previous: u64)
        requires position < 16 && previous < 16
    {
        let left_id: &[u8] = DebuggerTraceInstructionRecord::get_trace_session_id(&debugger_trace_list_outcome.instruction_records[position]);
        let right_id: &[u8] = DebuggerTraceInstructionRecord::get_trace_session_id(&debugger_trace_list_outcome.instruction_records[previous]);
        let id_less: bool = DebuggerService::span_less(left_id, right_id);
        let id_equal: bool = DebuggerService::span_equals(left_id, right_id);
        let address_less: bool = debugger_trace_list_outcome.instruction_records[position].instruction_address
            < debugger_trace_list_outcome.instruction_records[previous].instruction_address;
        let swap: bool = id_less || (id_equal && address_less);
        transition swap {
            true -> swap_slots(debugger_trace_list_outcome, position, previous)
            _ -> advance(debugger_trace_list_outcome, position)
        }
    }
    state swap_slots(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, position: u64, previous: u64)
        requires position < 16 && previous < 16
    {
        let moved: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord::clone(&debugger_trace_list_outcome.instruction_records[position]);
        let displaced: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord::clone(&debugger_trace_list_outcome.instruction_records[previous]);
        DebuggerTraceInstructionRecord::clone_from(&mut debugger_trace_list_outcome.instruction_records[position], &displaced);
        DebuggerTraceInstructionRecord::clone_from(&mut debugger_trace_list_outcome.instruction_records[previous], &moved);
        transition { _ -> sift(debugger_trace_list_outcome, previous) }
    }
    state advance(debugger_trace_list_outcome: &mut DebuggerTraceListOutcome, position: u64)
        requires position < 16
    {
        transition { _ -> scan(debugger_trace_list_outcome, position + 1) }
    }
}

// Upstream `list_breakpoints` product — a bounded page of descriptors plus
// the error carrier; the executor merges patch-derived software-breakpoint
// descriptors into this page (upstream merges into the same `Vec`).
pub data DebuggerBreakpointListOutcome {
    succeeded: bool;
    breakpoints: [DebuggerBreakpointDescriptor; 32];
    breakpoint_count: u64;
    has_error_message: bool;
    error_message: [u8; 256];
    error_message_len: u64;
}

pub machine DebuggerBreakpointListOutcome::new() -> DebuggerBreakpointListOutcome {
    DebuggerBreakpointListOutcome {
        succeeded: false,
        breakpoint_count: 0,
        has_error_message: false,
        error_message_len: 0,
    }
}

pub machine DebuggerBreakpointListOutcome::set_error(debugger_breakpoint_list_outcome: &mut DebuggerBreakpointListOutcome, message: &[u8]) {
    debugger_breakpoint_list_outcome.has_error_message = true;
    transition { _ -> copy(debugger_breakpoint_list_outcome, message, 0) }
    state copy(debugger_breakpoint_list_outcome: &mut DebuggerBreakpointListOutcome, message: &[u8], position: u64) {
        transition position < message.len && position < 256 {
            true -> store(debugger_breakpoint_list_outcome, message, position)
            _ -> (debugger_breakpoint_list_outcome)
        }
    }
    state store(debugger_breakpoint_list_outcome: &mut DebuggerBreakpointListOutcome, message: &[u8], position: u64)
        requires position < 256
    {
        debugger_breakpoint_list_outcome.error_message[position] = message[position];
        debugger_breakpoint_list_outcome.error_message_len = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> copy(debugger_breakpoint_list_outcome, message, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

pub machine DebuggerBreakpointListOutcome::get_error_message(debugger_breakpoint_list_outcome: &DebuggerBreakpointListOutcome) -> &[u8] {
    transition debugger_breakpoint_list_outcome.has_error_message && debugger_breakpoint_list_outcome.error_message_len <= 256 {
        true -> (&debugger_breakpoint_list_outcome.error_message[0..debugger_breakpoint_list_outcome.error_message_len])
        _ -> (&debugger_breakpoint_list_outcome.error_message[0..0])
    }
}

pub machine DebuggerBreakpointListOutcome::add_breakpoint(debugger_breakpoint_list_outcome: &mut DebuggerBreakpointListOutcome, breakpoint: &DebuggerBreakpointDescriptor) -> bool {
    transition debugger_breakpoint_list_outcome.breakpoint_count < 32 {
        true -> store(debugger_breakpoint_list_outcome, breakpoint)
        _ -> (false)
    }
    state store(debugger_breakpoint_list_outcome: &mut DebuggerBreakpointListOutcome, breakpoint: &DebuggerBreakpointDescriptor) -> bool {
        DebuggerBreakpointDescriptor::clone_from(&mut debugger_breakpoint_list_outcome.breakpoints[debugger_breakpoint_list_outcome.breakpoint_count], breakpoint);
        debugger_breakpoint_list_outcome.breakpoint_count = ((debugger_breakpoint_list_outcome.breakpoint_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

// Insertion sort on the merged page by (address, breakpoint_id) — upstream's
// `sort_by(address.cmp.then(id.cmp))`; ids compare lexicographic bytes.
pub machine DebuggerBreakpointListOutcome::sort_breakpoints(debugger_breakpoint_list_outcome: &mut DebuggerBreakpointListOutcome) {
    transition { _ -> scan(debugger_breakpoint_list_outcome, 1) }
    state scan(debugger_breakpoint_list_outcome: &mut DebuggerBreakpointListOutcome, position: u64) {
        transition position < debugger_breakpoint_list_outcome.breakpoint_count && position < 32 {
            true -> sift(debugger_breakpoint_list_outcome, position, position)
            _ -> (debugger_breakpoint_list_outcome)
        }
    }
    // Insertion sift: `current` walks the element down while the previous
    // slot compares greater; `scan_position` resumes the outer pass.
    state sift(debugger_breakpoint_list_outcome: &mut DebuggerBreakpointListOutcome, current: u64, scan_position: u64)
        requires current < 32 && scan_position < 32
    {
        let previous: u64 = ((current as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        transition current > 0 && previous < 32 {
            true -> compare(debugger_breakpoint_list_outcome, current, previous, scan_position)
            _ -> advance(debugger_breakpoint_list_outcome, scan_position)
        }
    }
    state compare(debugger_breakpoint_list_outcome: &mut DebuggerBreakpointListOutcome, current: u64, previous: u64, scan_position: u64)
        requires current < 32 && previous < 32 && scan_position < 32
    {
        transition DebuggerBreakpointListOutcome::less_at(debugger_breakpoint_list_outcome, current, previous) {
            true -> swap_slots(debugger_breakpoint_list_outcome, current, previous, scan_position)
            _ -> advance(debugger_breakpoint_list_outcome, scan_position)
        }
    }
    state swap_slots(debugger_breakpoint_list_outcome: &mut DebuggerBreakpointListOutcome, position: u64, previous: u64, scan_position: u64)
        requires position < 32 && previous < 32 && scan_position < 32
    {
        let moved: DebuggerBreakpointDescriptor = DebuggerBreakpointDescriptor::clone(&debugger_breakpoint_list_outcome.breakpoints[position]);
        let displaced: DebuggerBreakpointDescriptor = DebuggerBreakpointDescriptor::clone(&debugger_breakpoint_list_outcome.breakpoints[previous]);
        DebuggerBreakpointDescriptor::clone_from(&mut debugger_breakpoint_list_outcome.breakpoints[position], &displaced);
        DebuggerBreakpointDescriptor::clone_from(&mut debugger_breakpoint_list_outcome.breakpoints[previous], &moved);
        transition { _ -> sift(debugger_breakpoint_list_outcome, previous, scan_position) }
    }
    state advance(debugger_breakpoint_list_outcome: &mut DebuggerBreakpointListOutcome, position: u64)
        requires position < 32
    {
        transition { _ -> scan(debugger_breakpoint_list_outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

machine DebuggerBreakpointListOutcome::less_at(debugger_breakpoint_list_outcome: &DebuggerBreakpointListOutcome, left: u64, right: u64) -> bool
    requires left < 32 && right < 32
{
    transition debugger_breakpoint_list_outcome.breakpoints[left].address == debugger_breakpoint_list_outcome.breakpoints[right].address {
        true -> ids(debugger_breakpoint_list_outcome, left, right, 0)
        _ -> (debugger_breakpoint_list_outcome.breakpoints[left].address < debugger_breakpoint_list_outcome.breakpoints[right].address)
    }
    state ids(debugger_breakpoint_list_outcome: &DebuggerBreakpointListOutcome, left: u64, right: u64, position: u64) -> bool
        requires left < 32 && right < 32
    {
        let left_len: u64 = DebuggerBreakpointDescriptor::get_breakpoint_id_len(&debugger_breakpoint_list_outcome.breakpoints[left]);
        let right_len: u64 = DebuggerBreakpointDescriptor::get_breakpoint_id_len(&debugger_breakpoint_list_outcome.breakpoints[right]);
        transition position < left_len && position < right_len && position < 256 {
            true -> bytes(debugger_breakpoint_list_outcome, left, right, position)
            _ -> (left_len < right_len)
        }
    }
    state bytes(debugger_breakpoint_list_outcome: &DebuggerBreakpointListOutcome, left: u64, right: u64, position: u64) -> bool
        requires left < 32 && right < 32 && position < 256
    {
        let left_byte: u8 = DebuggerBreakpointDescriptor::get_breakpoint_id_byte(&debugger_breakpoint_list_outcome.breakpoints[left], position);
        let right_byte: u8 = DebuggerBreakpointDescriptor::get_breakpoint_id_byte(&debugger_breakpoint_list_outcome.breakpoints[right], position);
        transition left_byte == right_byte {
            true -> ids(debugger_breakpoint_list_outcome, left, right, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (left_byte < right_byte)
        }
    }
}

pub data DebuggerService {
    // Upstream `active_session: Option<CachedDebuggerSession>` — the dyn
    // session object itself is absent headless; the bookkeeping fields it
    // carried (process identity, plugin id, last-known session state) are
    // the real port surface.
    has_cached_session: bool;
    cached_process_id: u32;
    cached_process_name: [u8; 256];
    cached_process_name_len: u64;
    cached_process_handle: u64;
    cached_plugin_id: [u8; 256];
    cached_plugin_id_len: u64;
    cached_session_state: DebuggerSessionState;
    // Upstream `DebuggerTraceSessionStore` — the sessions map bounded at 16;
    // its breakpoint->session map collapses into a session scan.
    trace_sessions: [DebuggerTraceSessionState; 16];
    trace_session_count: u64;
    next_trace_session_number: u64;
}

pub machine DebuggerService::new() -> DebuggerService {
    DebuggerService {
        has_cached_session: false,
        cached_process_id: 0,
        cached_process_name_len: 0,
        cached_process_handle: 0,
        cached_plugin_id_len: 0,
        cached_session_state: DebuggerSessionState::Detached,
        trace_session_count: 0,
        next_trace_session_number: 1,
    }
}

// Byte-span equality over two slices.
pub machine DebuggerService::span_equals(left: &[u8], right: &[u8]) -> bool {
    transition left.len == right.len {
        true -> compare(left, right, 0)
        _ -> (false)
    }
    state compare(left: &[u8], right: &[u8], position: u64) -> bool {
        transition position < left.len && position < right.len {
            true -> check(left, right, position)
            _ -> (true)
        }
    }
    state check(left: &[u8], right: &[u8], position: u64) -> bool
        requires position < left.len && position < right.len
    {
        transition left[position] == right[position] {
            true -> compare(left, right, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// Lexicographic compare for the upstream `sort_by(id)` orderings.
pub machine DebuggerService::span_less(left: &[u8], right: &[u8]) -> bool {
    transition { _ -> compare(left, right, 0) }
    state compare(left: &[u8], right: &[u8], position: u64) -> bool {
        transition position < left.len && position < right.len {
            true -> check(left, right, position)
            _ -> (position < right.len)
        }
    }
    state check(left: &[u8], right: &[u8], position: u64) -> bool
        requires position < left.len && position < right.len
    {
        transition left[position] == right[position] {
            true -> compare(left, right, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (left[position] < right[position])
        }
    }
}

// Writes `source` into `target` at `offset`; refuses nothing (bounded by
// both ends) and returns the bytes written's tail position.
pub machine DebuggerService::copy_span_prefix(source: &[u8], target: &mut [u8; 256], offset: u64) {
    transition { _ -> copy(source, target, offset, 0) }
    state copy(source: &[u8], target: &mut [u8; 256], offset: u64, position: u64) {
        let target_position: u64 = ((offset as u64 in Wrapping) + (position as u64 in Wrapping)) as u64;
        transition position < source.len && target_position < 256 {
            true -> store(source, target, offset, position, target_position)
            _ -> done(source, target, offset)
        }
    }
    state store(source: &[u8], target: &mut [u8; 256], offset: u64, position: u64, target_position: u64)
        requires position < source.len && target_position < 256
    {
        target[target_position] = source[position];
        transition { _ -> copy(source, target, offset, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state done(source: &[u8], target: &mut [u8; 256], offset: u64) {}
}

// "Debugger trace session '<id>' does not exist." / "... is stopped." —
// composed into `target`; returns the message length.
pub machine DebuggerService::compose_session_error(target: &mut [u8; 256], trace_session_id: &[u8], suffix: &[u8]) -> u64 {
    DebuggerService::copy_span_prefix("Debugger trace session '", target, 0);
    DebuggerService::copy_span_prefix(trace_session_id, target, 23);
    DebuggerService::copy_span_prefix(suffix, target, 23 + trace_session_id.len);
    (23 + trace_session_id.len + suffix.len)
}

// Uppercase minimal-width hex for the default trace labels ({:X} payload).
// Measure-then-emit (MSB-first, shifts off the u64 width) — the tail-only
// runtime forbids result-feeding recursion, and exact arithmetic is a proof
// obligation, so every index rides the Wrapping domain.
pub machine DebuggerService::format_hex_upper(value: u64, target: &mut [u8; 256], offset: u64) -> u64 {
    transition value == 0 {
        true -> emit_zero(target, offset)
        _ -> measure(value, target, offset, 0)
    }
    state emit_zero(target: &mut [u8; 256], offset: u64) -> u64 {
        transition offset < 256 {
            true -> store_zero(target, offset)
            _ -> (0)
        }
    }
    state store_zero(target: &mut [u8; 256], offset: u64)
        requires offset < 256
    {
        target[offset] = 48;
        (1)
    }
    // Count the significant nibbles so emission stays MSB-first.
    state measure(value: u64, target: &mut [u8; 256], offset: u64, width: u64) -> u64
        requires width < 17
    {
        let shift: u64 = (((width as u64 in Wrapping) * (4 as u64 in Wrapping)) as u64);
        let shifted: u64 = (((value as u64 in Wrapping) >> (shift as u64 in Wrapping)) != 0) as u64;
        let next_width: u64 = ((width as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition shifted == 1 && next_width < 17 {
            true -> measure(value, target, offset, next_width)
            _ -> emit(value, target, offset, width, 0)
        }
    }
    state emit(value: u64, target: &mut [u8; 256], offset: u64, width: u64, position: u64) -> u64
        requires width < 17
    {
        let target_position: u64 = ((offset as u64 in Wrapping) + (position as u64 in Wrapping)) as u64;
        transition position < width && position < 16 && target_position < 256 {
            true -> emit_digit(value, target, offset, width, position, target_position)
            _ -> (position)
        }
    }
    state emit_digit(value: u64, target: &mut [u8; 256], offset: u64, width: u64, position: u64, target_position: u64) -> u64
        requires position < width && position < 16 && width < 17 && target_position < 256
    {
        // `width <= 16 && width > position` — subtraction stays in range.
        let shift_base: u64 = ((width as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        let shift: u64 = (((((shift_base as u64 in Wrapping) - (position as u64 in Wrapping)) as u64 in Wrapping) * (4 as u64 in Wrapping)) as u64);
        let digit: u64 = (((((value as u64 in Wrapping) >> (shift as u64 in Wrapping)) % (16 as u64 in Wrapping))) as u64);
        target[target_position] = debugger_hex_digit_upper(digit);
        transition {
            _ -> emit(value, target, offset, width, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// 0-15 -> '0'-'9' / 'A'-'F' for the trace-label hex payloads.
machine debugger_hex_digit_upper(digit: u64) -> u8 {
    transition digit < 10 {
        true -> ((((48 as u64 in Wrapping) + (digit as u64 in Wrapping)) as u64) as u8)
        _ -> upper(digit)
    }
    // Callers only produce digit in 0-15; `digit >= 16` is unreachable —
    // the arm returns '?' rather than widen the contract to a masked char.
    state upper(digit: u64) -> u8 {
        transition digit >= 10 && digit < 16 {
            true -> (alpha(digit))
            _ -> (63)
        }
    }
    state alpha(digit: u64) -> u8
        requires digit >= 10 && digit < 16
    {
        ((((55 as u64 in Wrapping) + ((digit as u64 in Wrapping) - (10 as u64 in Wrapping))) as u64) as u8)
    }
}

// Minimal-width decimal — the "trace-N" allocator's N. Divisor-forward
// measure-then-emit (no index arithmetic, tail-only runtime).
pub machine DebuggerService::format_decimal(value: u64, target: &mut [u8; 256], offset: u64) -> u64 {
    transition value == 0 {
        true -> emit_zero(target, offset, value)
        _ -> measure(value, target, offset, 1)
    }
    state emit_zero(target: &mut [u8; 256], offset: u64, value: u64) -> u64 {
        transition offset < 256 {
            true -> store_zero(target, offset, value)
            _ -> (0)
        }
    }
    state store_zero(target: &mut [u8; 256], offset: u64, value: u64)
        requires offset < 256
    {
        target[offset] = 48;
        (1)
    }
    // `divisor` grows to the largest 10^k <= value (10^19 is the u64 cap).
    state measure(value: u64, target: &mut [u8; 256], offset: u64, divisor: u64) -> u64 {
        transition divisor <= value / 10 && divisor < 10000000000000000000 {
            true -> measure(value, target, offset, ((divisor as u64 in Wrapping) * (10 as u64 in Wrapping)) as u64)
            _ -> emit(value, target, offset, divisor, 0)
        }
    }
    state emit(value: u64, target: &mut [u8; 256], offset: u64, divisor: u64, count: u64) -> u64 {
        let target_position: u64 = ((offset as u64 in Wrapping) + (count as u64 in Wrapping)) as u64;
        transition divisor != 0 && target_position < 256 {
            true -> digit(value, target, offset, divisor, count, target_position)
            _ -> (count)
        }
    }
    state digit(value: u64, target: &mut [u8; 256], offset: u64, divisor: u64, count: u64, target_position: u64) -> u64
        requires divisor != 0 && target_position < 256
    {
        let quotient: u64 = value / divisor;
        let digit_value: u64 = quotient % 10;
        transition digit_value < 10 {
            true -> store(value, target, offset, divisor, count, target_position, digit_value)
            _ -> (count)
        }
    }
    state store(value: u64, target: &mut [u8; 256], offset: u64, divisor: u64, count: u64, target_position: u64, digit_value: u64) -> u64
        requires divisor != 0 && target_position < 256 && digit_value < 10
    {
        target[target_position] = ((((48 as u64 in Wrapping) + (digit_value as u64 in Wrapping)) as u64) as u8);
        let next_divisor: u64 = divisor / 10;
        transition {
            _ -> emit(value, target, offset, next_divisor, ((count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// "trace-N" into `target` — upstream's format!("trace-{}", fetch_add(1))
// product; the caller bumps `next_trace_session_number` (Wrapping domain).
pub machine DebuggerService::format_trace_session_id(trace_session_number: u64, target: &mut [u8; 256]) -> u64 {
    DebuggerService::copy_span_prefix("trace-", target, 0);
    let digits: u64 = DebuggerService::format_decimal(trace_session_number, target, 6);
    (((6 as u64 in Wrapping) + (digits as u64 in Wrapping)) as u64)
}

// Default upstream label: "{cli_label} data|instruction trace at 0x{address:X}".
pub machine DebuggerService::compose_default_trace_label(access: &DebuggerDataBreakpointAccess, address: u64, instruction_directed: bool, target: &mut [u8; 256]) -> u64 {
    let cli_label: &[u8] = DebuggerDataBreakpointAccess::get_cli_label(access);
    DebuggerService::copy_span_prefix(cli_label, target, 0);
    transition instruction_directed {
        true -> instruction(cli_label, target, address)
        _ -> data(cli_label, target, address)
    }
    state instruction(cli_label: &[u8], target: &mut [u8; 256], address: u64) -> u64 {
        DebuggerService::copy_span_prefix(" instruction trace at 0x", target, cli_label.len);
        let tail: u64 = ((cli_label.len as u64 in Wrapping) + (25 as u64 in Wrapping)) as u64;
        let hex: u64 = DebuggerService::format_hex_upper(address, target, tail);
        (((tail as u64 in Wrapping) + (hex as u64 in Wrapping)) as u64)
    }
    state data(cli_label: &[u8], target: &mut [u8; 256], address: u64) -> u64 {
        DebuggerService::copy_span_prefix(" data trace at 0x", target, cli_label.len);
        let tail: u64 = ((cli_label.len as u64 in Wrapping) + (18 as u64 in Wrapping)) as u64;
        let hex: u64 = DebuggerService::format_hex_upper(address, target, tail);
        (((tail as u64 in Wrapping) + (hex as u64 in Wrapping)) as u64)
    }
}

// --- cached-session bookkeeping ------------------------------------------

// Upstream `CachedDebuggerSession::matches` — process id + handle + name.
pub machine DebuggerService::cached_matches(debugger_service: &DebuggerService, process_info: &OpenedProcessInfo) -> bool {
    transition debugger_service.has_cached_session
        && debugger_service.cached_process_id == process_info.process_id
        && debugger_service.cached_process_handle == OpenedProcessInfo::get_handle(process_info)
        && debugger_service.cached_process_name_len == OpenedProcessInfo::get_name_len(process_info) {
        true -> names(debugger_service, process_info, 0)
        _ -> (false)
    }
    state names(debugger_service: &DebuggerService, process_info: &OpenedProcessInfo, position: u64) -> bool {
        transition position < debugger_service.cached_process_name_len && position < 256 {
            true -> byte(debugger_service, process_info, position)
            _ -> (true)
        }
    }
    state byte(debugger_service: &DebuggerService, process_info: &OpenedProcessInfo, position: u64) -> bool
        requires position < 256
    {
        transition debugger_service.cached_process_name[position] == OpenedProcessInfo::get_name_byte(process_info, position) {
            true -> names(debugger_service, process_info, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// Upstream `get_matching_cached_session`'s plugin filter — a requested id
// must equal the cached one when present.
pub machine DebuggerService::cached_plugin_matches(debugger_service: &DebuggerService, has_requested_plugin_id: bool, requested_plugin_id: &[u8]) -> bool {
    transition has_requested_plugin_id {
        false -> (true)
        _ -> length(debugger_service, requested_plugin_id)
    }
    state length(debugger_service: &DebuggerService, requested_plugin_id: &[u8]) -> bool {
        transition debugger_service.cached_plugin_id_len == requested_plugin_id.len {
            true -> bytes(debugger_service, requested_plugin_id, 0)
            _ -> (false)
        }
    }
    state bytes(debugger_service: &DebuggerService, requested_plugin_id: &[u8], position: u64) -> bool {
        transition position < debugger_service.cached_plugin_id_len && position < 256 && position < requested_plugin_id.len {
            true -> check(debugger_service, requested_plugin_id, position)
            _ -> (true)
        }
    }
    state check(debugger_service: &DebuggerService, requested_plugin_id: &[u8], position: u64) -> bool
        requires position < 256 && position < requested_plugin_id.len
    {
        transition debugger_service.cached_plugin_id[position] == requested_plugin_id[position] {
            true -> bytes(debugger_service, requested_plugin_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// --- session operations ---------------------------------------------------

// Upstream `attach`. A cached-session hit returns the cached status; the
// miss falls through to `find_debugger_plugin_package` — the plugin-host
// surface — so absent a backend the upstream Err surfaces verbatim.
pub machine DebuggerService::attach(
    debugger_service: &mut DebuggerService,
    process_info: &OpenedProcessInfo,
    has_requested_plugin_id: bool,
    requested_plugin_id: &[u8],
    events: &mut PendingEngineEvents
) -> DebuggerOperationOutcome {
    let outcome: DebuggerOperationOutcome = DebuggerOperationOutcome::new();
    let cache_hit: bool = DebuggerService::cached_matches(debugger_service, process_info)
        && DebuggerService::cached_plugin_matches(debugger_service, has_requested_plugin_id, requested_plugin_id);
    transition cache_hit {
        true -> cached(debugger_service, events, outcome)
        _ -> absent(outcome)
    }

    state cached(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents, mut outcome: DebuggerOperationOutcome) -> DebuggerOperationOutcome {
        outcome.succeeded = true;
        outcome.session_state = debugger_service.cached_session_state;
        transition { _ -> fill_id(debugger_service, events, outcome, 0) }
    }

    state fill_id(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents, mut outcome: DebuggerOperationOutcome, position: u64) -> DebuggerOperationOutcome {
        transition position < debugger_service.cached_plugin_id_len && position < 256 {
            true -> put_id(debugger_service, events, outcome, position)
            _ -> emit(debugger_service, events, outcome)
        }
    }

    state put_id(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents, mut outcome: DebuggerOperationOutcome, position: u64) -> DebuggerOperationOutcome
        requires position < 256
    {
        let byte: u8 = debugger_service.cached_plugin_id[position];
        outcome.active_plugin_id[position] = byte;
        outcome.active_plugin_id_len = position + 1;
        outcome.has_active_plugin_id = true;
        transition { _ -> fill_id(debugger_service, events, outcome, position + 1) }
    }

    state emit(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents, mut outcome: DebuggerOperationOutcome) -> DebuggerOperationOutcome {
        let mut event: DebuggerSessionStateChangedEvent = DebuggerSessionStateChangedEvent::new(outcome.session_state);
        transition outcome.has_active_plugin_id {
            true -> fill_plugin(debugger_service, events, outcome, event)
            _ -> push(debugger_service, events, outcome, event)
        }
    }

    state fill_plugin(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents, mut outcome: DebuggerOperationOutcome, mut event: DebuggerSessionStateChangedEvent) -> DebuggerOperationOutcome {
        let plugin_id: &[u8] = DebuggerOperationOutcome::get_active_plugin_id(&outcome);
        DebuggerSessionStateChangedEvent::set_active_plugin_id(&mut event, plugin_id);
        transition { _ -> push(debugger_service, events, outcome, event) }
    }

    state push(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents, outcome: DebuggerOperationOutcome, event: DebuggerSessionStateChangedEvent) -> DebuggerOperationOutcome {
        let engine_event: EngineEvent = DebuggerSessionStateChangedEvent::to_engine_event(&event);
        _ = PendingEngineEvents::push(events, &engine_event);
        (outcome)
    }

    // `find_debugger_plugin_package` absent -> upstream Err verbatim; the
    // create_session + cache-store leg behind it is the deferred
    // plugin-host surface — nothing populates the cache fields until then.
    state absent(outcome: DebuggerOperationOutcome) -> DebuggerOperationOutcome {
        let mut outcome_failed: DebuggerOperationOutcome = outcome;
        DebuggerOperationOutcome::set_error(&mut outcome_failed, "No enabled debugger plugin can attach to the opened process.");
        (outcome_failed)
    }
}

// Upstream `detach`: take the cached session, plugin-detach (absent call
// site), clear the trace store, emit Detached.
pub machine DebuggerService::detach(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents) -> DebuggerOperationOutcome {
    let outcome: DebuggerOperationOutcome = DebuggerOperationOutcome::new();
    transition debugger_service.has_cached_session {
        true -> taken(debugger_service, events, outcome)
        _ -> no_session(outcome)
    }

    state taken(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents, mut outcome: DebuggerOperationOutcome) -> DebuggerOperationOutcome {
        debugger_service.has_cached_session = false;
        debugger_service.cached_plugin_id_len = 0;
        debugger_service.cached_process_name_len = 0;
        debugger_service.cached_session_state = DebuggerSessionState::Detached;
        DebuggerService::clear_trace_sessions(debugger_service);
        outcome.succeeded = true;
        outcome.session_state = DebuggerSessionState::Detached;
        let event: DebuggerSessionStateChangedEvent = DebuggerSessionStateChangedEvent::new(DebuggerSessionState::Detached);
        let engine_event: EngineEvent = DebuggerSessionStateChangedEvent::to_engine_event(&event);
        _ = PendingEngineEvents::push(events, &engine_event);
        (outcome)
    }

    state no_session(outcome: DebuggerOperationOutcome) -> DebuggerOperationOutcome {
        let mut outcome_failed: DebuggerOperationOutcome = outcome;
        DebuggerOperationOutcome::set_error(&mut outcome_failed, "No active debugger session.");
        (outcome_failed)
    }
}

// Upstream `pause`/`resume` — the `get_cached_session` guard ("No active
// debugger session.") then the absent plugin call site.
pub machine DebuggerService::pause(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents) -> DebuggerOperationOutcome {
    let mut outcome: DebuggerOperationOutcome = DebuggerOperationOutcome::new();
    DebuggerOperationOutcome::set_error(&mut outcome, "No active debugger session.");
    (outcome)
}

pub machine DebuggerService::resume(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents) -> DebuggerOperationOutcome {
    let mut outcome: DebuggerOperationOutcome = DebuggerOperationOutcome::new();
    DebuggerOperationOutcome::set_error(&mut outcome, "No active debugger session.");
    (outcome)
}

// Upstream `set_breakpoint`/`remove_breakpoint`/`set_breakpoint_enabled`/
// `read_registers`/`write_register` — all begin with the same
// `get_cached_session` guard; their plugin call sites are the deferred
// plugin-host surface.
pub machine DebuggerService::set_breakpoint(debugger_service: &mut DebuggerService, address: u64, kind: DebuggerBreakpointKind, has_label: bool, label: &[u8]) -> DebuggerBreakpointOutcome {
    let mut outcome: DebuggerBreakpointOutcome = DebuggerBreakpointOutcome::new();
    DebuggerBreakpointOutcome::set_error(&mut outcome, "No active debugger session.");
    (outcome)
}

pub machine DebuggerService::remove_breakpoint(debugger_service: &mut DebuggerService, breakpoint_id: &[u8]) -> DebuggerVoidOutcome {
    let mut outcome: DebuggerVoidOutcome = DebuggerVoidOutcome::new();
    DebuggerVoidOutcome::set_error(&mut outcome, "No active debugger session.");
    (outcome)
}

pub machine DebuggerService::set_breakpoint_enabled(debugger_service: &mut DebuggerService, breakpoint_id: &[u8], is_enabled: bool) -> DebuggerVoidOutcome {
    let mut outcome: DebuggerVoidOutcome = DebuggerVoidOutcome::new();
    DebuggerVoidOutcome::set_error(&mut outcome, "No active debugger session.");
    (outcome)
}

pub machine DebuggerService::read_registers(debugger_service: &mut DebuggerService) -> DebuggerRegisterOutcome {
    let mut outcome: DebuggerRegisterOutcome = DebuggerRegisterOutcome::new();
    DebuggerRegisterOutcome::set_error(&mut outcome, "No active debugger session.");
    (outcome)
}

pub machine DebuggerService::write_register(debugger_service: &mut DebuggerService, register_name: &[u8], value: u64) -> DebuggerRegisterOutcome {
    let mut outcome: DebuggerRegisterOutcome = DebuggerRegisterOutcome::new();
    DebuggerRegisterOutcome::set_error(&mut outcome, "No active debugger session.");
    (outcome)
}

// Upstream `get_active_session_state_for_process` — a cache match returns
// the last-known state (the absent backend's live read is deferred).
pub machine DebuggerService::get_active_session_state_for_process(debugger_service: &DebuggerService, process_info: &OpenedProcessInfo) -> DebuggerSessionState {
    transition DebuggerService::cached_matches(debugger_service, process_info) {
        true -> (debugger_service.cached_session_state)
        _ -> (DebuggerSessionState::Detached)
    }
}

// Upstream `get_active_plugin_id_for_process` — writes the cached id into
// `plugin_id_out`; returns its length (0 = no matching session).
pub machine DebuggerService::get_active_plugin_id_for_process(debugger_service: &DebuggerService, process_info: &OpenedProcessInfo, plugin_id_out: &mut [u8; 256]) -> u64 {
    transition DebuggerService::cached_matches(debugger_service, process_info) {
        true -> copy(debugger_service, plugin_id_out, 0)
        _ -> (0)
    }
    state copy(debugger_service: &DebuggerService, plugin_id_out: &mut [u8; 256], position: u64) -> u64 {
        transition position < debugger_service.cached_plugin_id_len && position < 256 {
            true -> put(debugger_service, plugin_id_out, position)
            _ -> (debugger_service.cached_plugin_id_len)
        }
    }
    state put(debugger_service: &DebuggerService, plugin_id_out: &mut [u8; 256], position: u64) -> u64
        requires position < 256
    {
        plugin_id_out[position] = debugger_service.cached_plugin_id[position];
        transition { _ -> copy(debugger_service, plugin_id_out, position + 1) }
    }
}

// Upstream `clear_active_session` — the process-change hook body: clear
// bookkeeping + trace store + emit Detached.
pub machine DebuggerService::clear_active_session(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents) {
    transition debugger_service.has_cached_session {
        true -> clear(debugger_service, events)
        _ -> done(debugger_service, events)
    }
    state done(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents) {}
    state clear(debugger_service: &mut DebuggerService, events: &mut PendingEngineEvents) {
        debugger_service.has_cached_session = false;
        debugger_service.cached_plugin_id_len = 0;
        debugger_service.cached_process_name_len = 0;
        debugger_service.cached_session_state = DebuggerSessionState::Detached;
        DebuggerService::clear_trace_sessions(debugger_service);
        let event: DebuggerSessionStateChangedEvent = DebuggerSessionStateChangedEvent::new(DebuggerSessionState::Detached);
        let engine_event: EngineEvent = DebuggerSessionStateChangedEvent::to_engine_event(&event);
        _ = PendingEngineEvents::push(events, &engine_event);
    }
}

// --- trace session store ---------------------------------------------------

// Position of a live session by id, or 16 (absent) — replaces the
// HashMap lookup; bounded linear scan over the insertion-order table.
pub machine DebuggerService::find_trace_session_position(debugger_service: &DebuggerService, trace_session_id: &[u8]) -> u64 {
    transition { _ -> scan(debugger_service, trace_session_id, 0) }
    state scan(debugger_service: &DebuggerService, trace_session_id: &[u8], position: u64) -> u64 {
        transition position < debugger_service.trace_session_count && position < 16 {
            true -> check(debugger_service, trace_session_id, position)
            _ -> (16)
        }
    }
    state check(debugger_service: &DebuggerService, trace_session_id: &[u8], position: u64) -> u64
        requires position < 16
    {
        transition debugger_service.trace_sessions[position].in_use
            && debugger_service.trace_sessions[position].descriptor.trace_session_id_len == trace_session_id.len {
            true -> bytes(debugger_service, trace_session_id, position, 0)
            _ -> scan(debugger_service, trace_session_id, position + 1)
        }
    }
    state bytes(debugger_service: &DebuggerService, trace_session_id: &[u8], position: u64, index: u64) -> u64
        requires position < 16
    {
        transition index < trace_session_id.len && index < 64 {
            true -> byte(debugger_service, trace_session_id, position, index)
            _ -> (position)
        }
    }
    state byte(debugger_service: &DebuggerService, trace_session_id: &[u8], position: u64, index: u64) -> u64
        requires position < 16 && index < 64
    {
        transition debugger_service.trace_sessions[position].descriptor.trace_session_id[index] == trace_session_id[index] {
            true -> bytes(debugger_service, trace_session_id, position, index + 1)
            _ -> (16)
        }
    }
}

// Same scan keyed on the stored breakpoint id — the collapsed
// breakpoint->session map.
pub machine DebuggerService::find_trace_session_by_breakpoint_id(debugger_service: &DebuggerService, breakpoint_id: &[u8]) -> u64 {
    transition { _ -> scan(debugger_service, breakpoint_id, 0) }
    state scan(debugger_service: &DebuggerService, breakpoint_id: &[u8], position: u64) -> u64 {
        transition position < debugger_service.trace_session_count && position < 16 {
            true -> check(debugger_service, breakpoint_id, position)
            _ -> (16)
        }
    }
    state check(debugger_service: &DebuggerService, breakpoint_id: &[u8], position: u64) -> u64
        requires position < 16
    {
        transition debugger_service.trace_sessions[position].in_use
            && debugger_service.trace_sessions[position].descriptor.breakpoint.breakpoint_id_len == breakpoint_id.len {
            true -> bytes(debugger_service, breakpoint_id, position, 0)
            _ -> scan(debugger_service, breakpoint_id, position + 1)
        }
    }
    state bytes(debugger_service: &DebuggerService, breakpoint_id: &[u8], position: u64, index: u64) -> u64
        requires position < 16
    {
        transition index < breakpoint_id.len && index < 256 {
            true -> byte(debugger_service, breakpoint_id, position, index)
            _ -> (position)
        }
    }
    state byte(debugger_service: &DebuggerService, breakpoint_id: &[u8], position: u64, index: u64) -> u64
        requires position < 16 && index < 256
    {
        transition debugger_service.trace_sessions[position].descriptor.breakpoint.breakpoint_id[index] == breakpoint_id[index] {
            true -> bytes(debugger_service, breakpoint_id, position, index + 1)
            _ -> (16)
        }
    }
}

// Upstream `insert_session` — append into the bounded table.
pub machine DebuggerService::insert_trace_session(debugger_service: &mut DebuggerService, descriptor: &DebuggerTraceSessionDescriptor) -> bool {
    transition debugger_service.trace_session_count < 16 {
        true -> store(debugger_service, descriptor)
        _ -> (false)
    }
    state store(debugger_service: &mut DebuggerService, descriptor: &DebuggerTraceSessionDescriptor) -> bool {
        debugger_service.trace_sessions[debugger_service.trace_session_count].in_use = true;
        DebuggerTraceSessionDescriptor::clone_from(&mut debugger_service.trace_sessions[debugger_service.trace_session_count].descriptor, descriptor);
        debugger_service.trace_sessions[debugger_service.trace_session_count].instruction_record_count = 0;
        debugger_service.trace_session_count = ((debugger_service.trace_session_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

// Upstream `start_trace_session` — the `get_cached_session` guard surfaces
// "No active debugger session." absent a backend; the post-guard flow
// (id alloc, default label, store insert, emit) is the real port behind it.
pub machine DebuggerService::start_trace_session(
    debugger_service: &mut DebuggerService,
    address: u64,
    size_in_bytes: u8,
    access: DebuggerDataBreakpointAccess,
    has_label: bool,
    label: &[u8],
    events: &mut PendingEngineEvents
) -> DebuggerTraceOutcome {
    let outcome: DebuggerTraceOutcome = DebuggerTraceOutcome::new();
    transition debugger_service.has_cached_session {
        true -> create(debugger_service, address, size_in_bytes, access, has_label, label, events, outcome)
        _ -> no_session(outcome)
    }

    state no_session(outcome: DebuggerTraceOutcome) -> DebuggerTraceOutcome {
        let mut outcome_failed: DebuggerTraceOutcome = outcome;
        DebuggerTraceOutcome::set_error(&mut outcome_failed, "No active debugger session.");
        (outcome_failed)
    }

    state create(debugger_service: &mut DebuggerService, address: u64, size_in_bytes: u8, access: DebuggerDataBreakpointAccess, has_label: bool, label: &[u8], events: &mut PendingEngineEvents, mut outcome: DebuggerTraceOutcome) -> DebuggerTraceOutcome {
        let mut trace_session_id: [u8; 256];
        let id_len: u64 = DebuggerService::format_trace_session_id(debugger_service.next_trace_session_number, &mut trace_session_id);
        debugger_service.next_trace_session_number = ((debugger_service.next_trace_session_number as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let mut descriptor: DebuggerTraceSessionDescriptor = DebuggerTraceSessionDescriptor::new(address, size_in_bytes as u64, access, true);
        transition id_len <= 64 {
            true -> with_id(debugger_service, outcome, descriptor, &trace_session_id[0..id_len], has_label, label, access, address, events)
            _ -> (outcome)
        }
    }

    state with_id(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, mut descriptor: DebuggerTraceSessionDescriptor, trace_session_id: &[u8], has_label: bool, label: &[u8], access: DebuggerDataBreakpointAccess, address: u64, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
        DebuggerTraceSessionDescriptor::set_trace_session_id(&mut descriptor, trace_session_id);
        transition has_label {
            true -> with_label(debugger_service, outcome, descriptor, label, events)
            _ -> default_label(debugger_service, outcome, descriptor, access, address, events, label)
        }
    }

    state with_label(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, mut descriptor: DebuggerTraceSessionDescriptor, label: &[u8], events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
        DebuggerTraceSessionDescriptor::set_label(&mut descriptor, label);
        transition { _ -> commit(debugger_service, outcome, descriptor, events) }
    }

    state default_label(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, mut descriptor: DebuggerTraceSessionDescriptor, access: DebuggerDataBreakpointAccess, address: u64, events: &mut PendingEngineEvents, label: &[u8]) -> DebuggerTraceOutcome {
        let mut formatted: [u8; 256];
        let formatted_len: u64 = DebuggerService::compose_default_trace_label(&access, address, false, &mut formatted);
        transition formatted_len <= 256 {
            true -> apply_label(debugger_service, outcome, descriptor, &formatted[0..formatted_len], events)
            _ -> commit(debugger_service, outcome, descriptor, events)
        }
    }

    state apply_label(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, mut descriptor: DebuggerTraceSessionDescriptor, label: &[u8], events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
        DebuggerTraceSessionDescriptor::set_label(&mut descriptor, label);
        transition { _ -> commit(debugger_service, outcome, descriptor, events) }
    }

    // Plugin `set_breakpoint` + resume are the deferred call sites; the
    // insert + `emit_trace_session_updated` half is the real port.
    state commit(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, descriptor: DebuggerTraceSessionDescriptor, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
        _ = DebuggerService::insert_trace_session(debugger_service, &descriptor);
        outcome.succeeded = true;
        outcome.has_trace_session = true;
        DebuggerTraceSessionDescriptor::clone_from(&mut outcome.trace_session, &descriptor);
        let event: DebuggerTraceSessionUpdatedEvent = DebuggerTraceSessionUpdatedEvent::new(descriptor);
        let engine_event: EngineEvent = DebuggerTraceSessionUpdatedEvent::to_engine_event(&event);
        _ = PendingEngineEvents::push(events, &engine_event);
        (outcome)
    }
}

// Upstream `start_instruction_trace_session` — same flow on
// `new_for_instruction` + the instruction-directed default label.
pub machine DebuggerService::start_instruction_trace_session(
    debugger_service: &mut DebuggerService,
    instruction_address: u64,
    access: DebuggerDataBreakpointAccess,
    has_label: bool,
    label: &[u8],
    events: &mut PendingEngineEvents
) -> DebuggerTraceOutcome {
    let outcome: DebuggerTraceOutcome = DebuggerTraceOutcome::new();
    transition debugger_service.has_cached_session {
        true -> create(debugger_service, instruction_address, access, has_label, label, events, outcome)
        _ -> no_session(outcome)
    }

    state no_session(outcome: DebuggerTraceOutcome) -> DebuggerTraceOutcome {
        let mut outcome_failed: DebuggerTraceOutcome = outcome;
        DebuggerTraceOutcome::set_error(&mut outcome_failed, "No active debugger session.");
        (outcome_failed)
    }

    state create(debugger_service: &mut DebuggerService, instruction_address: u64, access: DebuggerDataBreakpointAccess, has_label: bool, label: &[u8], events: &mut PendingEngineEvents, mut outcome: DebuggerTraceOutcome) -> DebuggerTraceOutcome {
        let mut trace_session_id: [u8; 256];
        let id_len: u64 = DebuggerService::format_trace_session_id(debugger_service.next_trace_session_number, &mut trace_session_id);
        debugger_service.next_trace_session_number = ((debugger_service.next_trace_session_number as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let mut descriptor: DebuggerTraceSessionDescriptor = DebuggerTraceSessionDescriptor::new_for_instruction(instruction_address, access, true);
        transition id_len <= 64 {
            true -> with_id(debugger_service, outcome, descriptor, &trace_session_id[0..id_len], has_label, label, access, instruction_address, events)
            _ -> (outcome)
        }
    }

    state with_id(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, mut descriptor: DebuggerTraceSessionDescriptor, trace_session_id: &[u8], has_label: bool, label: &[u8], access: DebuggerDataBreakpointAccess, instruction_address: u64, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
        DebuggerTraceSessionDescriptor::set_trace_session_id(&mut descriptor, trace_session_id);
        transition has_label {
            true -> with_label(debugger_service, outcome, descriptor, label, events)
            _ -> default_label(debugger_service, outcome, descriptor, access, instruction_address, events, label)
        }
    }

    state with_label(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, mut descriptor: DebuggerTraceSessionDescriptor, label: &[u8], events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
        DebuggerTraceSessionDescriptor::set_label(&mut descriptor, label);
        transition { _ -> commit(debugger_service, outcome, descriptor, events) }
    }

    state default_label(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, mut descriptor: DebuggerTraceSessionDescriptor, access: DebuggerDataBreakpointAccess, instruction_address: u64, events: &mut PendingEngineEvents, label: &[u8]) -> DebuggerTraceOutcome {
        let mut formatted: [u8; 256];
        let formatted_len: u64 = DebuggerService::compose_default_trace_label(&access, instruction_address, true, &mut formatted);
        transition formatted_len <= 256 {
            true -> apply_label(debugger_service, outcome, descriptor, &formatted[0..formatted_len], events)
            _ -> commit(debugger_service, outcome, descriptor, events)
        }
    }

    state apply_label(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, mut descriptor: DebuggerTraceSessionDescriptor, label: &[u8], events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
        DebuggerTraceSessionDescriptor::set_label(&mut descriptor, label);
        transition { _ -> commit(debugger_service, outcome, descriptor, events) }
    }

    state commit(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, descriptor: DebuggerTraceSessionDescriptor, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
        _ = DebuggerService::insert_trace_session(debugger_service, &descriptor);
        outcome.succeeded = true;
        outcome.has_trace_session = true;
        DebuggerTraceSessionDescriptor::clone_from(&mut outcome.trace_session, &descriptor);
        let event: DebuggerTraceSessionUpdatedEvent = DebuggerTraceSessionUpdatedEvent::new(descriptor);
        let engine_event: EngineEvent = DebuggerTraceSessionUpdatedEvent::to_engine_event(&event);
        _ = PendingEngineEvents::push(events, &engine_event);
        (outcome)
    }
}

// Upstream `stop_trace_session`: find the backing breakpoint id (missing
// -> "...does not exist."), best-effort `remove_breakpoint` (upstream logs
// a warn and continues — the port absorbs it), then store removal + emit.
pub machine DebuggerService::stop_trace_session(debugger_service: &mut DebuggerService, trace_session_id: &[u8], events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
    let outcome: DebuggerTraceOutcome = DebuggerTraceOutcome::new();
    let position: u64 = DebuggerService::find_trace_session_position(debugger_service, trace_session_id);
    transition position < 16 {
        true -> remove(debugger_service, outcome, position, events)
        _ -> absent(outcome, trace_session_id)
    }

    state absent(outcome: DebuggerTraceOutcome, trace_session_id: &[u8]) -> DebuggerTraceOutcome {
        let mut outcome_failed: DebuggerTraceOutcome = outcome;
        let mut message: [u8; 256];
        let message_len: u64 = DebuggerService::compose_session_error(&mut message, trace_session_id, "' does not exist.");
        transition message_len <= 256 {
            true -> fill(outcome_failed, &message[0..message_len])
            _ -> (outcome_failed)
        }
    }
    state fill(mut outcome: DebuggerTraceOutcome, message: &[u8]) -> DebuggerTraceOutcome {
        DebuggerTraceOutcome::set_error(&mut outcome, message);
        (outcome)
    }

    // The store-side stop: mark the breakpoint disabled + the session
    // inactive, keep collected records, then compact the table.
    state remove(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome
        requires position < 16
    {
        DebuggerTraceSessionDescriptor::set_is_active(&mut debugger_service.trace_sessions[position].descriptor, false);
        let mut breakpoint: DebuggerBreakpointDescriptor = DebuggerTraceSessionDescriptor::get_breakpoint(&debugger_service.trace_sessions[position].descriptor).clone();
        DebuggerBreakpointDescriptor::set_is_enabled(&mut breakpoint, false);
        DebuggerTraceSessionDescriptor::set_breakpoint(&mut debugger_service.trace_sessions[position].descriptor, breakpoint);
        outcome.succeeded = true;
        outcome.has_trace_session = true;
        DebuggerTraceSessionDescriptor::clone_from(&mut outcome.trace_session, &debugger_service.trace_sessions[position].descriptor);
        transition { _ -> drain(debugger_service, outcome, position, events, 0) }
    }

    state drain(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, events: &mut PendingEngineEvents, index: u64) -> DebuggerTraceOutcome
        requires position < 16
    {
        transition index < debugger_service.trace_sessions[position].instruction_record_count && index < 16 {
            true -> copy_record(debugger_service, outcome, position, index, events)
            _ -> shift(debugger_service, outcome, position, events)
        }
    }

    state copy_record(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, index: u64, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome
        requires position < 16 && index < 16
    {
        let record: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord::clone(&debugger_service.trace_sessions[position].instruction_records[index]);
        _ = DebuggerTraceOutcome::add_instruction_record(&mut outcome, &record);
        transition { _ -> drain(debugger_service, outcome, position, events, index + 1) }
    }

    // Slot compaction: shift trailing sessions over the removed slot
    // (insertion-order table, same idiom as the plugin order tables).
    state shift(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome
        requires position < 16
    {
        let next: u64 = position + 1;
        transition next < debugger_service.trace_session_count && next < 16 {
            true -> move_slot(debugger_service, outcome, position, next, events)
            _ -> finish(debugger_service, outcome, position, events)
        }
    }

    state move_slot(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, next: u64, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome
        requires position < 16 && next < 16
    {
        let in_use: bool = debugger_service.trace_sessions[next].in_use;
        let record_count: u64 = debugger_service.trace_sessions[next].instruction_record_count;
        let descriptor: DebuggerTraceSessionDescriptor = DebuggerTraceSessionDescriptor::clone(&debugger_service.trace_sessions[next].descriptor);
        debugger_service.trace_sessions[position].in_use = in_use;
        debugger_service.trace_sessions[position].instruction_record_count = record_count;
        DebuggerTraceSessionDescriptor::clone_from(&mut debugger_service.trace_sessions[position].descriptor, &descriptor);
        transition { _ -> copy_records(debugger_service, outcome, position, next, events, 0) }
    }

    state copy_records(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, next: u64, events: &mut PendingEngineEvents, index: u64) -> DebuggerTraceOutcome
        requires position < 16 && next < 16
    {
        transition index < debugger_service.trace_sessions[position].instruction_record_count && index < 16 {
            true -> move_record(debugger_service, outcome, position, next, index, events)
            _ -> shifted(debugger_service, outcome, position, next, events)
        }
    }

    state move_record(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, next: u64, index: u64, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome
        requires position < 16 && next < 16 && index < 16
    {
        let record: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord::clone(&debugger_service.trace_sessions[next].instruction_records[index]);
        DebuggerTraceInstructionRecord::clone_from(&mut debugger_service.trace_sessions[position].instruction_records[index], &record);
        transition { _ -> copy_records(debugger_service, outcome, position, next, events, index + 1) }
    }

    state shifted(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, next: u64, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome
        requires position < 16 && next < 16
    {
        debugger_service.trace_sessions[next].in_use = false;
        debugger_service.trace_sessions[next].instruction_record_count = 0;
        transition { _ -> shift(debugger_service, outcome, next, events) }
    }

    state finish(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
        transition debugger_service.trace_session_count > 0 {
            true -> decrement(debugger_service, outcome, events)
            _ -> emit(debugger_service, outcome, events)
        }
    }

    state decrement(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
        debugger_service.trace_session_count = debugger_service.trace_session_count - 1;
        transition { _ -> emit(debugger_service, outcome, events) }
    }

    state emit(debugger_service: &mut DebuggerService, outcome: DebuggerTraceOutcome, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
        let event: DebuggerTraceSessionUpdatedEvent = DebuggerTraceSessionUpdatedEvent::new(DebuggerTraceSessionDescriptor::clone(&outcome.trace_session));
        let engine_event: EngineEvent = DebuggerTraceSessionUpdatedEvent::to_engine_event(&event);
        _ = PendingEngineEvents::push(events, &engine_event);
        (outcome)
    }
}

// Upstream `set_trace_session_collection_enabled` — pause/resume share it.
pub machine DebuggerService::set_trace_session_collection_enabled(debugger_service: &mut DebuggerService, trace_session_id: &[u8], is_enabled: bool, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
    let outcome: DebuggerTraceOutcome = DebuggerTraceOutcome::new();
    let position: u64 = DebuggerService::find_trace_session_position(debugger_service, trace_session_id);
    transition position < 16 {
        true -> found(debugger_service, outcome, position, is_enabled, events)
        _ -> absent(outcome, trace_session_id)
    }

    state absent(outcome: DebuggerTraceOutcome, trace_session_id: &[u8]) -> DebuggerTraceOutcome {
        let mut outcome_failed: DebuggerTraceOutcome = outcome;
        let mut message: [u8; 256];
        let message_len: u64 = DebuggerService::compose_session_error(&mut message, trace_session_id, "' does not exist.");
        transition message_len <= 256 {
            true -> fill(outcome_failed, &message[0..message_len])
            _ -> (outcome_failed)
        }
    }
    state fill(mut outcome: DebuggerTraceOutcome, message: &[u8]) -> DebuggerTraceOutcome {
        DebuggerTraceOutcome::set_error(&mut outcome, message);
        (outcome)
    }

    state found(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, is_enabled: bool, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome
        requires position < 16
    {
        transition debugger_service.trace_sessions[position].descriptor.is_active {
            true -> apply(debugger_service, outcome, position, is_enabled, events)
            _ -> stopped(debugger_service, outcome, position, events)
        }
    }

    state stopped(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome
        requires position < 16
    {
        let session_id: &[u8] = DebuggerTraceSessionDescriptor::get_trace_session_id(&debugger_service.trace_sessions[position].descriptor);
        let mut message: [u8; 256];
        let message_len: u64 = DebuggerService::compose_session_error(&mut message, session_id, "' is stopped.");
        transition message_len <= 256 {
            true -> fill_stopped(outcome, &message[0..message_len])
            _ -> (outcome)
        }
    }
    state fill_stopped(mut outcome: DebuggerTraceOutcome, message: &[u8]) -> DebuggerTraceOutcome {
        DebuggerTraceOutcome::set_error(&mut outcome, message);
        (outcome)
    }

    state apply(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, is_enabled: bool, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome
        requires position < 16
    {
        let mut breakpoint: DebuggerBreakpointDescriptor = DebuggerTraceSessionDescriptor::get_breakpoint(&debugger_service.trace_sessions[position].descriptor).clone();
        DebuggerBreakpointDescriptor::set_is_enabled(&mut breakpoint, is_enabled);
        DebuggerTraceSessionDescriptor::set_breakpoint(&mut debugger_service.trace_sessions[position].descriptor, breakpoint);
        outcome.succeeded = true;
        outcome.has_trace_session = true;
        DebuggerTraceSessionDescriptor::clone_from(&mut outcome.trace_session, &debugger_service.trace_sessions[position].descriptor);
        transition { _ -> drain(debugger_service, outcome, position, events, 0) }
    }

    state drain(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, events: &mut PendingEngineEvents, index: u64) -> DebuggerTraceOutcome
        requires position < 16
    {
        transition index < debugger_service.trace_sessions[position].instruction_record_count && index < 16 {
            true -> copy_record(debugger_service, outcome, position, index, events)
            _ -> emit(debugger_service, outcome, events)
        }
    }

    state copy_record(debugger_service: &mut DebuggerService, mut outcome: DebuggerTraceOutcome, position: u64, index: u64, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome
        requires position < 16 && index < 16
    {
        let record: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord::clone(&debugger_service.trace_sessions[position].instruction_records[index]);
        _ = DebuggerTraceOutcome::add_instruction_record(&mut outcome, &record);
        transition { _ -> drain(debugger_service, outcome, position, events, index + 1) }
    }

    state emit(debugger_service: &mut DebuggerService, outcome: DebuggerTraceOutcome, events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
        let event: DebuggerTraceSessionUpdatedEvent = DebuggerTraceSessionUpdatedEvent::new(DebuggerTraceSessionDescriptor::clone(&outcome.trace_session));
        let engine_event: EngineEvent = DebuggerTraceSessionUpdatedEvent::to_engine_event(&event);
        _ = PendingEngineEvents::push(events, &engine_event);
        (outcome)
    }
}

// Upstream `list_breakpoints` — the live session's descriptors come from the
// backend's `list_breakpoints` (plugin-host surface); with no session the
// upstream Err surfaces verbatim and the executor absorbs it into an empty
// page before the patch merge.
pub machine DebuggerService::list_breakpoints(debugger_service: &DebuggerService) -> DebuggerBreakpointListOutcome {
    let mut outcome: DebuggerBreakpointListOutcome = DebuggerBreakpointListOutcome::new();
    DebuggerBreakpointListOutcome::set_error(&mut outcome, "No active debugger session.");
    (outcome)
}

// Upstream `pause_trace_session`/`resume_trace_session`.
pub machine DebuggerService::pause_trace_session(debugger_service: &mut DebuggerService, trace_session_id: &[u8], events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
    DebuggerService::set_trace_session_collection_enabled(debugger_service, trace_session_id, false, events)
}

pub machine DebuggerService::resume_trace_session(debugger_service: &mut DebuggerService, trace_session_id: &[u8], events: &mut PendingEngineEvents) -> DebuggerTraceOutcome {
    DebuggerService::set_trace_session_collection_enabled(debugger_service, trace_session_id, true, events)
}

// Upstream `list_sessions` — collect both pages then sort (sessions by id;
// records by (id, instruction_address)).
pub machine DebuggerService::list_trace_sessions(debugger_service: &DebuggerService) -> DebuggerTraceListOutcome {
    let outcome: DebuggerTraceListOutcome = DebuggerTraceListOutcome::new();
    transition { _ -> collect(debugger_service, outcome, 0) }

    state collect(debugger_service: &DebuggerService, mut outcome: DebuggerTraceListOutcome, position: u64) -> DebuggerTraceListOutcome {
        transition position < debugger_service.trace_session_count && position < 16 {
            true -> put(debugger_service, outcome, position)
            _ -> collect_records(debugger_service, outcome, 0, 0)
        }
    }

    state put(debugger_service: &DebuggerService, mut outcome: DebuggerTraceListOutcome, position: u64) -> DebuggerTraceListOutcome
        requires position < 16
    {
        let descriptor: DebuggerTraceSessionDescriptor = DebuggerTraceSessionDescriptor::clone(&debugger_service.trace_sessions[position].descriptor);
        _ = DebuggerTraceListOutcome::add_trace_session(&mut outcome, &descriptor);
        transition { _ -> collect(debugger_service, outcome, position + 1) }
    }

    state collect_records(debugger_service: &DebuggerService, mut outcome: DebuggerTraceListOutcome, position: u64, index: u64) -> DebuggerTraceListOutcome {
        transition position < debugger_service.trace_session_count && position < 16 {
            true -> drain(debugger_service, outcome, position, index)
            _ -> sort(debugger_service, outcome)
        }
    }

    state drain(debugger_service: &DebuggerService, mut outcome: DebuggerTraceListOutcome, position: u64, index: u64) -> DebuggerTraceListOutcome
        requires position < 16
    {
        transition index < debugger_service.trace_sessions[position].instruction_record_count && index < 16 {
            true -> copy_record(debugger_service, outcome, position, index)
            _ -> collect_records(debugger_service, outcome, position + 1, 0)
        }
    }

    state copy_record(debugger_service: &DebuggerService, mut outcome: DebuggerTraceListOutcome, position: u64, index: u64) -> DebuggerTraceListOutcome
        requires position < 16 && index < 16
    {
        let record: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord::clone(&debugger_service.trace_sessions[position].instruction_records[index]);
        _ = DebuggerTraceListOutcome::add_instruction_record(&mut outcome, &record);
        transition { _ -> drain(debugger_service, outcome, position, index + 1) }
    }

    state sort(debugger_service: &DebuggerService, mut outcome: DebuggerTraceListOutcome) -> DebuggerTraceListOutcome {
        DebuggerTraceListOutcome::sort_trace_sessions(&mut outcome);
        DebuggerTraceListOutcome::sort_instruction_records(&mut outcome);
        (outcome)
    }
}

// Upstream `clear` on the trace store.
pub machine DebuggerService::clear_trace_sessions(debugger_service: &mut DebuggerService) {
    debugger_service.trace_session_count = 0;
    transition { _ -> wipe(debugger_service, 0) }
    state wipe(debugger_service: &mut DebuggerService, position: u64) {
        transition position < 16 {
            true -> clear_one(debugger_service, position)
            _ -> (debugger_service)
        }
    }
    state clear_one(debugger_service: &mut DebuggerService, position: u64)
        requires position < 16
    {
        debugger_service.trace_sessions[position].in_use = false;
        debugger_service.trace_sessions[position].instruction_record_count = 0;
        transition { _ -> wipe(debugger_service, position + 1) }
    }
}

// Upstream `record_trace_event` (the sink's store half) — dedupe by
// (instruction_address, instruction_bytes) for address-directed sessions or
// accessed_address for instruction-directed ones; insert on miss. The
// disassembly enrichment + session-state emit sides are plugin-host.
pub machine DebuggerService::record_trace_event(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent) -> bool {
    transition trace_event.has_breakpoint {
        false -> (false)
        _ -> lookup(debugger_service, trace_event)
    }

    state lookup(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent) -> bool {
        let breakpoint: &DebuggerBreakpointDescriptor = DebuggerTraceEvent::get_breakpoint(trace_event);
        let breakpoint_id: &[u8] = DebuggerBreakpointDescriptor::get_breakpoint_id(breakpoint);
        let position: u64 = DebuggerService::find_trace_session_by_breakpoint_id(debugger_service, breakpoint_id);
        transition position < 16 {
            true -> found(debugger_service, trace_event, position)
            _ -> (false)
        }
    }

    state found(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64) -> bool
        requires position < 16
    {
        transition debugger_service.trace_sessions[position].descriptor.is_active
            && debugger_service.trace_sessions[position].descriptor.breakpoint.is_enabled {
            true -> kind(debugger_service, trace_event, position)
            _ -> (false)
        }
    }

    state kind(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64) -> bool
        requires position < 16
    {
        transition debugger_service.trace_sessions[position].descriptor.target_kind {
            DebuggerTraceTargetKind::Instruction -> instruction(debugger_service, trace_event, position)
            _ -> address(debugger_service, trace_event, position)
        }
    }

    // Instruction-directed: an unresolved accessed address drops the hit.
    state instruction(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64) -> bool
        requires position < 16
    {
        transition trace_event.has_accessed_address {
            false -> (false)
            _ -> match_instruction(debugger_service, trace_event, position, 0)
        }
    }

    state match_instruction(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64, index: u64) -> bool
        requires position < 16
    {
        transition index < debugger_service.trace_sessions[position].instruction_record_count && index < 16 {
            true -> check_instruction(debugger_service, trace_event, position, index)
            _ -> insert(debugger_service, trace_event, position)
        }
    }

    state check_instruction(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64, index: u64) -> bool
        requires position < 16 && index < 16
    {
        transition debugger_service.trace_sessions[position].instruction_records[index].has_accessed_address
            && debugger_service.trace_sessions[position].instruction_records[index].accessed_address == trace_event.accessed_address {
            true -> hit(debugger_service, trace_event, position, index)
            _ -> match_instruction(debugger_service, trace_event, position, index + 1)
        }
    }

    // Address-directed: dedupe on (instruction_address, instruction_bytes).
    state address(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64) -> bool
        requires position < 16
    {
        transition { _ -> match_address(debugger_service, trace_event, position, 0) }
    }

    state match_address(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64, index: u64) -> bool
        requires position < 16
    {
        transition index < debugger_service.trace_sessions[position].instruction_record_count && index < 16 {
            true -> check_address(debugger_service, trace_event, position, index)
            _ -> insert(debugger_service, trace_event, position)
        }
    }

    state check_address(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64, index: u64) -> bool
        requires position < 16 && index < 16
    {
        let address_match: bool = debugger_service.trace_sessions[position].instruction_records[index].has_instruction_address
            && debugger_service.trace_sessions[position].instruction_records[index].instruction_address == trace_event.instruction_address;
        transition address_match
            && debugger_service.trace_sessions[position].instruction_records[index].instruction_bytes_len == trace_event.instruction_bytes_len {
            true -> bytes_match(debugger_service, trace_event, position, index, 0)
            _ -> match_address(debugger_service, trace_event, position, index + 1)
        }
    }

    state bytes_match(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64, index: u64, byte_index: u64) -> bool
        requires position < 16 && index < 16
    {
        transition byte_index < trace_event.instruction_bytes_len && byte_index < 32 {
            true -> byte_check(debugger_service, trace_event, position, index, byte_index)
            _ -> hit(debugger_service, trace_event, position, index)
        }
    }

    state byte_check(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64, index: u64, byte_index: u64) -> bool
        requires position < 16 && index < 16 && byte_index < 32
    {
        let record: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord::clone(&debugger_service.trace_sessions[position].instruction_records[index]);
        transition record.instruction_bytes[byte_index] == trace_event.instruction_bytes[byte_index] {
            true -> bytes_match(debugger_service, trace_event, position, index, ((byte_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> match_address(debugger_service, trace_event, position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    state hit(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64, index: u64) -> bool
        requires position < 16 && index < 16
    {
        DebuggerTraceInstructionRecord::record_hit(&mut debugger_service.trace_sessions[position].instruction_records[index], trace_event);
        (true)
    }

    state insert(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64) -> bool
        requires position < 16
    {
        transition debugger_service.trace_sessions[position].instruction_record_count < 16 {
            true -> store_record(debugger_service, trace_event, position)
            _ -> (false)
        }
    }

    state store_record(debugger_service: &mut DebuggerService, trace_event: &DebuggerTraceEvent, position: u64) -> bool
        requires position < 16
    {
        let mut record: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord::new(trace_event);
        let session_id: &[u8] = DebuggerTraceSessionDescriptor::get_trace_session_id(&debugger_service.trace_sessions[position].descriptor);
        DebuggerTraceInstructionRecord::set_trace_session_id(&mut record, session_id);
        let count: u64 = debugger_service.trace_sessions[position].instruction_record_count;
        transition count < 16 {
            true -> write_record(debugger_service, position, count, record)
            _ -> (false)
        }
    }

    state write_record(debugger_service: &mut DebuggerService, position: u64, count: u64, record: DebuggerTraceInstructionRecord) -> bool
        requires position < 16 && count < 16
    {
        DebuggerTraceInstructionRecord::clone_from(&mut debugger_service.trace_sessions[position].instruction_records[count], &record);
        debugger_service.trace_sessions[position].instruction_record_count = ((count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}
