// Port of debugger/debugger_service.rs (upstream rev
// 568aa7589b68b2fd4621cc66c6dde23fa14c7f50).
//
// Named deviations (documented per AGENTS.md):
// - The dyn `DebuggerSession` plugin backend has no headless correspondent
//   (plugin-host surface, deferred to the plugin-host leg — same precedent as
//   the patches leg's `find_instruction_set`). Every plugin call site
//   (`attach` after the plugin lookup, `pause`/`resume`, breakpoint and
//   register ops) is unreachable absent a backend, so the port surfaces the
//   upstream pre-call guards verbatim: "No enabled debugger plugin can attach
//   to the opened process." / "No active debugger session." The cached-session
//   bookkeeping (process identity match, plugin id, last-known state), the
//   bounded trace session store, the trace-id allocator, default-label
//   formatting, dedupe/aggregate record logic, and event emission are real
//   ported code — they run unchanged once a backend exists.
// - `HashMap` stores become bounded insertion-order tables: 16 trace
//   sessions x 16 instruction records each (the wire bound the api response
//   pages carry). The breakpoint->session map collapses into a session scan
//   over the 16 slots (descriptors already carry their breakpoint ids).
// - `RwLock`/`Mutex`/`AtomicU64` disappear into the single-owner session
//   field; the id counter uses the Wrapping-domain bump.
// - Event emission pushes onto `PendingEngineEvents` (the headless
//   subscriber queue used by `notify_registry_changed`); upstream's dyn
//   Fn emitter is that queue's consumer side.
// - The disassembly/register-lookup enrichment of `create_trace_event_sink`
//   is deferred to the plugin-host leg (it calls instruction-set plugin
//   surfaces); `record_trace_event` keeps the store bookkeeping real.
// - `Vec` payloads fold into bounded result records carrying `succeeded` +
//   a verbatim bounded error span — the upstream `Result<_, String>` shape.

// Internal store slot — upstream `DebuggerTraceSessionState` {descriptor,
// instruction_records}.
pub data DebuggerTraceSessionState {
    in_use: bool;
    descriptor: DebuggerTraceSessionDescriptor;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

pub machine DebuggerTraceSessionState::new() -> DebuggerTraceSessionState {
    DebuggerTraceSessionState {
        in_use: false,
        descriptor: DebuggerTraceSessionDescriptor::new(0, 0, DebuggerDataBreakpointAccess::Read, false),
        instruction_record_count: 0,
    }
}

// Upstream `Result<(descriptor, records), String>`.
pub data DebuggerTraceOutcome {
    succeeded: bool;
    has_trace_session: bool;
    trace_session: DebuggerTraceSessionDescriptor;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
    has_error_message: bool;
    error_message: [u8; 256];
    error_message_len: u64;
}

pub machine DebuggerTraceOutcome::new() -> DebuggerTraceOutcome {
    DebuggerTraceOutcome {
        succeeded: false,
        has_trace_session: false,
        trace_session: DebuggerTraceSessionDescriptor::new(0, 0, DebuggerDataBreakpointAccess::Read, false),
        instruction_record_count: 0,
        has_error_message: false,
        error_message_len: 0,
    }
}

pub machine DebuggerTraceOutcome::set_error(debugger_trace_outcome: &mut DebuggerTraceOutcome, message: &[u8]) {
    debugger_trace_outcome.has_error_message = true;
    transition { _ -> copy(debugger_trace_outcome, message, 0) }
    state copy(debugger_trace_outcome: &mut DebuggerTraceOutcome, message: &[u8], position: u64) {
        transition position < message.len && position < 256 {
            true -> store(debugger_trace_outcome, message, position)
            _ -> (debugger_trace_outcome)
        }
    }
    state store(debugger_trace_outcome: &mut DebuggerTraceOutcome, message: &[u8], position: u64)
        requires position < 256
    {
        debugger_trace_outcome.error_message[position] = message[position];
        debugger_trace_outcome.error_message_len = position + 1;
        transition { _ -> copy(debugger_trace_outcome, message, position + 1) }
    }
}

pub machine DebuggerTraceOutcome::get_error_message(debugger_trace_outcome: &DebuggerTraceOutcome) -> &[u8] {
    transition debugger_trace_outcome.has_error_message && debugger_trace_outcome.error_message_len <= 256 {
        true -> (&debugger_trace_outcome.error_message[0..debugger_trace_outcome.error_message_len])
        _ -> (&debugger_trace_outcome.error_message[0..0])
    }
}

pub machine DebuggerTraceOutcome::add_instruction_record(debugger_trace_outcome: &mut DebuggerTraceOutcome, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
    transition debugger_trace_outcome.instruction_record_count < 16 {
        true -> store(debugger_trace_outcome, instruction_record)
        _ -> (false)
    }
    state store(debugger_trace_outcome: &mut DebuggerTraceOutcome, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
        DebuggerTraceInstructionRecord::clone_from(&mut debugger_trace_outcome.instruction_records[debugger_trace_outcome.instruction_record_count], instruction_record);
        debugger_trace_outcome.instruction_record_count = ((debugger_trace_outcome.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

