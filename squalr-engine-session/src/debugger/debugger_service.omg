}

pub machine DebuggerOperationOutcome::set_error(&mut self, message: &[u8]) {
    self.has_error_message = true;
    self.error_message_len = BoundedByteCopy::copy(&mut self.error_message[0..256], message);
}

pub machine DebuggerOperationOutcome::get_error_message(&self) -> &[u8] {
    transition self.has_error_message && self.error_message_len <= 256 {
        true -> (&self.error_message[0..self.error_message_len])
        _ -> (&self.error_message[0..0])
    }
}

pub machine DebuggerOperationOutcome::set_active_plugin_id(&mut self, plugin_id: &[u8]) {
    self.has_active_plugin_id = true;
    self.active_plugin_id_len = BoundedByteCopy::copy(&mut self.active_plugin_id[0..256], plugin_id);
}

pub machine DebuggerOperationOutcome::get_active_plugin_id(&self) -> &[u8] {
    bounded_slice(&self.active_plugin_id[0..256], self.active_plugin_id_len)
}

