use {squalr_engine_api}/src/events/engine_event.omg;
use {squalr_engine_api}/src/events/scan_results/scan_results_event.omg;
use {squalr_engine_api}/src/events/registry/registry_event.omg;
use {squalr_engine_api}/src/events/plugins/plugins_event.omg;
use {squalr_engine_api}/src/events/debugger/debugger_event.omg;
use {squalr_engine_api}/src/events/logging/logging_event.omg;
use {squalr_engine_api}/src/events/process/process_event.omg;
use {squalr_engine_api}/src/events/project/project_event.omg;
use {squalr_engine_api}/src/events/project_items/project_items_event.omg;
use {squalr_engine_api}/src/events/trackable_task/trackable_task_event.omg;
use src/pending_engine_events.omg;

// Upstream's event-listener surface is a `HashMap<TypeId, Vec<Box<dyn
// Fn(&dyn Any)>>>` — each subscriber registers under the concrete event
// type it wants (`subscribe_to_event::<T>`), and dispatch downcasts the
// `EngineEvent` arm into the typed leaf before invoking the callbacks.
// Omega has no TypeId map and no stored closures, so the port makes the
// subscription contract value-shaped: every leaf event type owns a bit in
// a 64-bit interest mask; a subscriber registers the bits of the leaf
// events it wants and receives a bounded queue. `route_engine_event`
// computes the event's leaf bit and enqueues it for every matching
// subscriber — the same dispatch semantics with masks standing in for
// TypeIds and per-subscriber queues standing in for callback invocations.
public data EventSubscriberTable {
    interest_masks: [u64; 16];
    queues: [|pending_engine_events|::PendingEngineEvents; 16];
    active: [bool; 16];
    subscriber_count: u64;
}

public machine EventSubscriberTable::new() -> EventSubscriberTable {
    EventSubscriberTable {
        subscriber_count: 0,
    }
}

// Upstream `subscribe_to_event::<T>` — returns the subscriber slot index.
public machine EventSubscriberTable::subscribe(this: &mut EventSubscriberTable, interest_mask: u64) -> u64 {
    transition this.subscriber_count < 16 {
        true -> claim(this, interest_mask)
        false -> (16)
        _ -> (16)
    }
    machine claim(this: &mut EventSubscriberTable, interest_mask: u64) -> u64 {
        let position: u64 = this.subscriber_count;
        this.interest_masks[position] = interest_mask;
        _ = subscriber_queue_clear(&mut this.queues[position]);
        this.active[position] = true;
        this.subscriber_count = position + 1;
        position
    }
}

// The leaf-event interest bit for an `EngineEvent` value — one bit per
// concrete leaf type, matching upstream's `TypeId` registration keys.
public machine engine_event_interest_mask(event: &|engine_event|::EngineEvent) -> u64 {
    transition event {
        |engine_event|::EngineEvent::ScanResults { event } -> mask_of_scan_results(event)
        |engine_event|::EngineEvent::Registry { event } -> mask_of_registry(event)
        |engine_event|::EngineEvent::Plugins { event } -> mask_of_plugins(event)
        |engine_event|::EngineEvent::Debugger { event } -> mask_of_debugger(event)
        |engine_event|::EngineEvent::Logging { event } -> mask_of_logging(event)
        |engine_event|::EngineEvent::Process { event } -> mask_of_process(event)
        |engine_event|::EngineEvent::Project { event } -> mask_of_project(event)
        |engine_event|::EngineEvent::ProjectItems { event } -> mask_of_project_items(event)
        |engine_event|::EngineEvent::TrackableTask { event } -> mask_of_trackable_task(event)
        _ -> (0)
    }
    machine mask_of_scan_results( event: &|scan_results_event|::ScanResultsEvent) -> u64 {
        transition event {
            |scan_results_event|::ScanResultsEvent::ScanResultsUpdated { scan_results_updated_event } -> (1)
            _ -> (0)
        }
    }
    machine mask_of_registry( event: &|registry_event|::RegistryEvent) -> u64 {
        transition event {
            |registry_event|::RegistryEvent::Changed { registry_changed_event } -> (2)
            _ -> (0)
        }
    }
    machine mask_of_plugins( event: &|plugins_event|::PluginsEvent) -> u64 {
        transition event {
            |plugins_event|::PluginsEvent::PluginsChanged { plugins_changed_event } -> (4)
            _ -> (0)
        }
    }
    machine mask_of_debugger( event: &|debugger_event|::DebuggerEvent) -> u64 {
        transition event {
            |debugger_event|::DebuggerEvent::SessionStateChanged { debugger_session_state_changed_event } -> (8)
            |debugger_event|::DebuggerEvent::TraceRecorded { debugger_trace_recorded_event } -> (16)
            |debugger_event|::DebuggerEvent::TraceSessionUpdated { debugger_trace_session_updated_event } -> (32)
            _ -> (0)
        }
    }
    machine mask_of_logging( event: &|logging_event|::LoggingEvent) -> u64 {
        transition event {
            |logging_event|::LoggingEvent::LogRecorded { log_recorded_event } -> (64)
            _ -> (0)
        }
    }
    machine mask_of_process( event: &|process_event|::ProcessEvent) -> u64 {
        transition event {
            |process_event|::ProcessEvent::ProcessChanged { process_changed_event } -> (128)
            _ -> (0)
        }
    }
    machine mask_of_project( event: &|project_event|::ProjectEvent) -> u64 {
        transition event {
            |project_event|::ProjectEvent::ProjectCatalogChanged { project_catalog_changed_event } -> (256)
            |project_event|::ProjectEvent::ProjectClosed { project_closed_event } -> (512)
            |project_event|::ProjectEvent::ProjectCreated { project_created_event } -> (1024)
            |project_event|::ProjectEvent::ProjectDeleted { project_deleted_event } -> (2048)
            _ -> (0)
        }
    }
    machine mask_of_project_items( event: &|project_items_event|::ProjectItemsEvent) -> u64 {
        transition event {
            |project_items_event|::ProjectItemsEvent::ProjectItemsChanged { project_items_changed_event } -> (4096)
            _ -> (0)
        }
    }
    machine mask_of_trackable_task( event: &|trackable_task_event|::TrackableTaskEvent) -> u64 {
        transition event {
            |trackable_task_event|::TrackableTaskEvent::ProgressChanged { progress_changed_event } -> (8192)
            _ -> (0)
        }
    }
}

// Upstream `dispatch_engine_event_by_variant` — pushes the event onto
// every active subscriber queue whose interest mask covers the leaf bit.
public machine EventSubscriberTable::route_engine_event(this: &mut EventSubscriberTable, event: &|engine_event|::EngineEvent) {
    let interest_mask: u64 = engine_event_interest_mask(event);
    transition { _ -> walk(this, event, interest_mask, 0) }
    machine walk(this: &mut EventSubscriberTable, event: &|engine_event|::EngineEvent, interest_mask: u64, position: u64) {
        transition position < this.subscriber_count && position < 16 {
            true -> check(this, event, interest_mask, position)
            false -> done(this)
        }
    }
    machine check(this: &mut EventSubscriberTable, event: &|engine_event|::EngineEvent, interest_mask: u64, position: u64) {
        transition this.active[position] && (interest_mask & this.interest_masks[position]) != 0 {
            true -> deliver(this, event, interest_mask, position)
            false -> walk(this, event, interest_mask, position + 1)
        }
    }
    machine deliver(this: &mut EventSubscriberTable, event: &|engine_event|::EngineEvent, interest_mask: u64, position: u64) {
        _ = subscriber_queue_push(&mut this.queues[position], event);
        transition { _ -> walk(this, event, interest_mask, position + 1) }
    }
    machine done(this: &mut EventSubscriberTable) {
    }
}

// Subscriber-side drains: upstream the callback receives the event; here
// the subscriber pulls queued events and clears.
public machine EventSubscriberTable::get_queued_event_count(this: &EventSubscriberTable, subscriber_position: u64) -> u64 {
    transition subscriber_position < this.subscriber_count && subscriber_position < 16 {
        true -> count_at(this, subscriber_position)
        _ -> (0)
    }
    machine count_at(this: &EventSubscriberTable, subscriber_position: u64) -> u64
        requires subscriber_position < 16;
    {
        let count: u64 = subscriber_queue_count(&this.queues[subscriber_position]);
        (count)
    }
}

public machine EventSubscriberTable::get_queued_event(this: &EventSubscriberTable, subscriber_position: u64, event_position: u64) -> |engine_event|::EngineEvent {
    transition subscriber_position < this.subscriber_count && subscriber_position < 16 {
        true -> event_at(this, subscriber_position, event_position)
        _ -> (|engine_event|::EngineEvent::default())
    }
    machine event_at(this: &EventSubscriberTable, subscriber_position: u64, event_position: u64) -> |engine_event|::EngineEvent
        requires subscriber_position < 16;
    {
        let event: |engine_event|::EngineEvent = subscriber_queue_get(&this.queues[subscriber_position], event_position);
        (event)
    }
}

// Indexed-element machine calls are not recognized as calls by the
// checker, so queue operations route through free helpers taking the
// element as a `&mut`/`&` argument.
machine subscriber_queue_push(queue: &mut |pending_engine_events|::PendingEngineEvents, event: &|engine_event|::EngineEvent) -> bool {
    let pushed: bool = |pending_engine_events|::PendingEngineEvents::push(queue, event);
    (pushed)
}

machine subscriber_queue_clear(queue: &mut |pending_engine_events|::PendingEngineEvents) -> bool {
    |pending_engine_events|::PendingEngineEvents::clear(queue);
    (true)
}

machine subscriber_queue_count(queue: &|pending_engine_events|::PendingEngineEvents) -> u64 {
    let count: u64 = |pending_engine_events|::PendingEngineEvents::get_count(queue);
    (count)
}

machine subscriber_queue_get(queue: &|pending_engine_events|::PendingEngineEvents, event_position: u64) -> |engine_event|::EngineEvent {
    let event: |engine_event|::EngineEvent = |pending_engine_events|::PendingEngineEvents::get(queue, event_position);
    (event)
}

public machine EventSubscriberTable::clear_queued_events(this: &mut EventSubscriberTable, subscriber_position: u64) {
    transition subscriber_position < this.subscriber_count && subscriber_position < 16 {
        true -> clear_at(this, subscriber_position)
        false -> done(this)
        _ -> done(this)
    }
    machine clear_at(this: &mut EventSubscriberTable, subscriber_position: u64) {
        |pending_engine_events|::PendingEngineEvents::clear(&mut this.queues[subscriber_position]);
        transition { _ -> done(this) }
    }
    machine done(this: &mut EventSubscriberTable) {
    }
}
