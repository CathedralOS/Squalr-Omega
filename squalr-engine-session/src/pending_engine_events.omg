module src::pending_engine_events;

use squalr_engine_api::src::events::engine_event::EngineEvent;

// Headless stand-in for upstream's `EngineApiPrivilegedBindings` channel:
// upstream pushes each emitted `EngineEvent` to GUI/socket subscribers
// (fire-and-forget, log on error); the port queues events on the privileged
// state so headless consumers (CLI, tests) can drain what fired. The
// 64-entry bound follows the package's bounded-collections convention —
// `push` refuses when full rather than dropping (upstream's channel is
// unbounded, but an un-drained queue that size signals a dead consumer).
pub data PendingEngineEvents {
    events: [EngineEvent; 64];
    event_count: u64;
}

pub machine PendingEngineEvents::new() -> PendingEngineEvents {
    PendingEngineEvents {
        event_count: 0,
    }
}

pub machine PendingEngineEvents::get_count(pending_engine_events: &PendingEngineEvents) -> u64 {
    pending_engine_events.event_count
}

pub machine PendingEngineEvents::get(pending_engine_events: &PendingEngineEvents, position: u64) -> EngineEvent {
    transition position < pending_engine_events.event_count && position < 64 {
        true -> clone_at(pending_engine_events, position)
        false -> (EngineEvent::default())
        _ -> (EngineEvent::default())
    }
    state clone_at(pending_engine_events: &PendingEngineEvents, position: u64) -> EngineEvent {
        EngineEvent::clone(&pending_engine_events.events[position])
    }
}

pub machine PendingEngineEvents::push(pending_engine_events: &mut PendingEngineEvents, event: &EngineEvent) -> bool {
    transition pending_engine_events.event_count < 64 {
        true -> store(pending_engine_events, event)
        false -> (false)
        _ -> (false)
    }
    state store(pending_engine_events: &mut PendingEngineEvents, event: &EngineEvent) -> bool {
        EngineEvent::clone_from(&mut pending_engine_events.events[pending_engine_events.event_count], event);
        pending_engine_events.event_count = pending_engine_events.event_count + 1;
        true
    }
}

// Drains the queue — consumers read count + each event, then clear. One
// upstream channel `take` is the same dequeue.
pub machine PendingEngineEvents::clear(pending_engine_events: &mut PendingEngineEvents) {
    pending_engine_events.event_count = 0;
}
