module src::pending_engine_events;

use squalr_engine_api::src::events::engine_event::EngineEvent;

// Headless stand-in for upstream's `EngineApiPrivilegedBindings` channel:
// upstream pushes each emitted `EngineEvent` to GUI/socket subscribers
// (fire-and-forget, log on error); the port queues events on the privileged
// state so headless consumers (CLI, tests) can drain what fired. The
// 64-entry bound follows the package's bounded-collections convention —
// `push` refuses when full rather than dropping (upstream's channel is
// unbounded, but an un-drained queue that size signals a dead consumer).
pub data PendingEngineEvents {
    events: [EngineEvent; 64];
    event_count: u64;
}

pub machine PendingEngineEvents::new() -> PendingEngineEvents {
    PendingEngineEvents {
        event_count: 0,
    }
}

pub machine PendingEngineEvents::get_count(this: &PendingEngineEvents) -> u64 {
    this.event_count
}

pub machine PendingEngineEvents::get(this: &PendingEngineEvents, position: u64) -> EngineEvent {
    transition position < this.event_count && position < 64 {
        true -> clone_at(this, position)
        false -> (EngineEvent::default())
        _ -> (EngineEvent::default())
    }
    state clone_at(this: &PendingEngineEvents, position: u64) -> EngineEvent {
        let hoist1: EngineEvent = EngineEvent::clone(&this.events[position]);
        (hoist1)
    }
}

pub machine PendingEngineEvents::push(this: &mut PendingEngineEvents, event: &EngineEvent) -> bool {
    transition this.event_count < 64 {
        true -> store(this, event)
        false -> (false)
        _ -> (false)
    }
    state store(this: &mut PendingEngineEvents, event: &EngineEvent) -> bool {
        EngineEvent::clone_from(&mut this.events[this.event_count], event);
        this.event_count = this.event_count + 1;
        true
    }
}

// Drains the queue — consumers read count + each event, then clear. One
// upstream channel `take` is the same dequeue.
pub machine PendingEngineEvents::clear(this: &mut PendingEngineEvents) {
    this.event_count = 0;
}
