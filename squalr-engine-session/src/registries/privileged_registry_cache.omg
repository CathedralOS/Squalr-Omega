module src::registries::privileged_registry_cache;

use squalr_engine_api::src::plugins::plugin_metadata::PluginMetadata;
use squalr_engine_api::src::registries::symbols::data_type_descriptor::DataTypeDescriptor;
use squalr_engine_api::src::registries::symbols::privileged_registry_catalog::PrivilegedRegistryCatalog;
use squalr_engine_api::src::registries::symbols::struct_layout_descriptor::StructLayoutDescriptor;
use squalr_engine_api::src::registries::symbols::symbol_registry::SymbolRegistry;
use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use squalr_engine_api::src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use squalr_engine_api::src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;
use src::plugins::plugin_registry::PluginRegistry;

// Port of registries/privileged_registry_cache.rs — the unprivileged
// side's cache of privileged-owned registry state. Upstream seeds
// `built_in_symbol_registry` from get_builtin_plugin_packages() by
// dyn-dispatching `as_data_type_plugin().contributed_data_types()` —
// port-side the PluginRegistry materializes the same 10 descriptors
// from package constants (contributed_data_type_descriptor), and the
// dyn DataType operations (validate/deanonymize/anonymize/compare)
// remain the deferred residual named in the registry leg.
pub data PrivilegedRegistryCache {
    has_latest_privileged_registry_catalog: bool;
    latest_privileged_registry_catalog: PrivilegedRegistryCatalog;
    built_in_symbol_registry: SymbolRegistry;
}

pub machine PrivilegedRegistryCache::default() -> PrivilegedRegistryCache {
    (PrivilegedRegistryCache {
        has_latest_privileged_registry_catalog: false,
        latest_privileged_registry_catalog: PrivilegedRegistryCatalog::default(),
        built_in_symbol_registry: SymbolRegistry::new(),
    })
}

// Upstream `create_builtin_symbol_registry` — the base registry (21
// builtin descriptors seeded by SymbolRegistry::new) plus every DataType-
// capable builtin package's contributed descriptors.
pub machine PrivilegedRegistryCache::new() -> PrivilegedRegistryCache {
    let mut cache: PrivilegedRegistryCache = PrivilegedRegistryCache::default();
    PrivilegedRegistryCache::seed_builtins(&mut cache);
    (cache)
}

pub machine PrivilegedRegistryCache::seed_builtins(privileged_registry_cache: &mut PrivilegedRegistryCache) {
    let plugin_registry: PluginRegistry = PluginRegistry::new();
    transition { _ -> seed_package(privileged_registry_cache, &plugin_registry, 0) }
    state seed_package(privileged_registry_cache: &mut PrivilegedRegistryCache, plugin_registry: &PluginRegistry, plugin_position: u64) {
        transition plugin_position < PluginRegistry::get_plugin_count(plugin_registry) && plugin_position < 8 {
            true -> seed_types(privileged_registry_cache, plugin_registry, plugin_position, 0)
            false -> finish(privileged_registry_cache)
        }
    }
    state seed_types(privileged_registry_cache: &mut PrivilegedRegistryCache, plugin_registry: &PluginRegistry, plugin_position: u64, index: u64) {
        transition index < PluginRegistry::contributed_data_type_count(plugin_registry, plugin_position) && index < 16 {
            true -> materialize(privileged_registry_cache, plugin_registry, plugin_position, index)
            false -> seed_package(privileged_registry_cache, plugin_registry, ((plugin_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state materialize(privileged_registry_cache: &mut PrivilegedRegistryCache, plugin_registry: &PluginRegistry, plugin_position: u64, index: u64) {
        let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
        transition PluginRegistry::contributed_data_type_descriptor(plugin_registry, plugin_position, index, &mut descriptor) {
            true -> register(privileged_registry_cache, plugin_registry, plugin_position, index, &descriptor)
            false -> seed_types(privileged_registry_cache, plugin_registry, plugin_position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state register(privileged_registry_cache: &mut PrivilegedRegistryCache, plugin_registry: &PluginRegistry, plugin_position: u64, index: u64, descriptor: &DataTypeDescriptor) {
        _ = SymbolRegistry::register_data_type_descriptor(&mut privileged_registry_cache.built_in_symbol_registry, descriptor);
        transition { _ -> seed_types(privileged_registry_cache, plugin_registry, plugin_position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(privileged_registry_cache: &mut PrivilegedRegistryCache) {
    }
}

pub machine PrivilegedRegistryCache::apply_registry_catalog(privileged_registry_cache: &mut PrivilegedRegistryCache, privileged_registry_catalog: &PrivilegedRegistryCatalog) {
    PrivilegedRegistryCatalog::clone_from(&mut privileged_registry_cache.latest_privileged_registry_catalog, privileged_registry_catalog);
    privileged_registry_cache.has_latest_privileged_registry_catalog = true;
}

pub machine PrivilegedRegistryCache::get_has_registry_catalog(privileged_registry_cache: &PrivilegedRegistryCache) -> bool {
    privileged_registry_cache.has_latest_privileged_registry_catalog
}

pub machine PrivilegedRegistryCache::get_registry_catalog(privileged_registry_cache: &PrivilegedRegistryCache) -> &PrivilegedRegistryCatalog {
    (&privileged_registry_cache.latest_privileged_registry_catalog)
}

// Upstream `get_generation` — the catalog's generation, 0 when absent.
pub machine PrivilegedRegistryCache::get_generation(privileged_registry_cache: &PrivilegedRegistryCache) -> u64 {
    transition privileged_registry_cache.has_latest_privileged_registry_catalog {
        true -> (PrivilegedRegistryCatalog::get_generation(&privileged_registry_cache.latest_privileged_registry_catalog))
        false -> (0)
    }
}

// Upstream `get_registered_data_type_refs` — descriptor-at-position
// access over whichever table is authoritative (catalog when present,
// else the builtin registry), the same Vec<DataTypeRef> iteration
// upstream callers perform.
pub machine PrivilegedRegistryCache::get_registered_data_type_descriptor_count(privileged_registry_cache: &PrivilegedRegistryCache) -> u64 {
    transition privileged_registry_cache.has_latest_privileged_registry_catalog {
        true -> (PrivilegedRegistryCatalog::get_data_type_descriptor_count(&privileged_registry_cache.latest_privileged_registry_catalog))
        false -> (SymbolRegistry::get_data_type_descriptor_count(&privileged_registry_cache.built_in_symbol_registry))
    }
}

pub machine PrivilegedRegistryCache::get_registered_data_type_descriptor_at(privileged_registry_cache: &PrivilegedRegistryCache, position: u64, out_descriptor: &mut DataTypeDescriptor) -> bool {
    transition privileged_registry_cache.has_latest_privileged_registry_catalog {
        true -> catalog(privileged_registry_cache, position, out_descriptor)
        false -> builtin(privileged_registry_cache, position, out_descriptor)
    }
    state catalog(privileged_registry_cache: &PrivilegedRegistryCache, position: u64, out_descriptor: &mut DataTypeDescriptor) -> bool {
        transition position < PrivilegedRegistryCatalog::get_data_type_descriptor_count(&privileged_registry_cache.latest_privileged_registry_catalog) && position < 128 {
            true -> read(privileged_registry_cache, position, out_descriptor)
            false -> (false)
        }
    }
    state read(privileged_registry_cache: &PrivilegedRegistryCache, position: u64, out_descriptor: &mut DataTypeDescriptor) -> bool
        requires position < 128;
    {
        DataTypeDescriptor::clone_from(out_descriptor, &privileged_registry_cache.latest_privileged_registry_catalog.data_type_descriptors[position]);
        (true)
    }
    state builtin(privileged_registry_cache: &PrivilegedRegistryCache, position: u64, out_descriptor: &mut DataTypeDescriptor) -> bool {
        (SymbolRegistry::get_registered_data_type_descriptor_at(&privileged_registry_cache.built_in_symbol_registry, position, out_descriptor))
    }
}

// Upstream `find_data_type_descriptor` — catalog first, builtin fallback.
pub machine PrivilegedRegistryCache::find_data_type_descriptor(privileged_registry_cache: &PrivilegedRegistryCache, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor) -> bool {
    transition privileged_registry_cache.has_latest_privileged_registry_catalog {
        true -> in_catalog(privileged_registry_cache, data_type_id, out_descriptor)
        false -> in_builtin(privileged_registry_cache, data_type_id, out_descriptor)
    }
    state in_catalog(privileged_registry_cache: &PrivilegedRegistryCache, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor) -> bool {
        transition PrivilegedRegistryCatalog::find_data_type_descriptor(&privileged_registry_cache.latest_privileged_registry_catalog, data_type_id, out_descriptor) {
            true -> (true)
            false -> in_builtin(privileged_registry_cache, data_type_id, out_descriptor)
        }
    }
    state in_builtin(privileged_registry_cache: &PrivilegedRegistryCache, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor) -> bool {
        (SymbolRegistry::find_data_type_descriptor(&privileged_registry_cache.built_in_symbol_registry, data_type_id, out_descriptor))
    }
}

pub machine PrivilegedRegistryCache::is_registered_data_type_ref(privileged_registry_cache: &PrivilegedRegistryCache, data_type_ref: &DataTypeRef) -> bool {
    let mut scratch: DataTypeDescriptor = DataTypeDescriptor::default();
    (PrivilegedRegistryCache::find_data_type_descriptor(privileged_registry_cache, DataTypeRef::get_data_type_id(data_type_ref), &mut scratch))
}

// Upstream `get_supported_anonymous_value_string_formats` — the
// descriptor's format table on a hit; empty count on a miss mirrors
// upstream's builtin-registry fallback only being needed when the
// catalog ALSO misses (builtin is always consulted second).
pub machine PrivilegedRegistryCache::get_supported_anonymous_value_string_format_count(privileged_registry_cache: &PrivilegedRegistryCache, data_type_id: &[u8]) -> u64 {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
    transition PrivilegedRegistryCache::find_data_type_descriptor(privileged_registry_cache, data_type_id, &mut descriptor) {
        true -> (DataTypeDescriptor::get_supported_format_count(&descriptor))
        false -> (0)
    }
}

pub machine PrivilegedRegistryCache::get_supported_anonymous_value_string_format(privileged_registry_cache: &PrivilegedRegistryCache, data_type_id: &[u8], position: u64) -> AnonymousValueStringFormat {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
    transition PrivilegedRegistryCache::find_data_type_descriptor(privileged_registry_cache, data_type_id, &mut descriptor) {
        true -> format_of(privileged_registry_cache, &descriptor, position)
        false -> (AnonymousValueStringFormat::default())
    }
    state format_of(privileged_registry_cache: &PrivilegedRegistryCache, descriptor: &DataTypeDescriptor, position: u64) -> AnonymousValueStringFormat {
        transition position < DataTypeDescriptor::get_supported_format_count(descriptor) && position < 8 {
            true -> format_at(privileged_registry_cache, descriptor, position)
            false -> (AnonymousValueStringFormat::default())
        }
    }
    state format_at(privileged_registry_cache: &PrivilegedRegistryCache, descriptor: &DataTypeDescriptor, position: u64) -> AnonymousValueStringFormat
        requires position < 8;
    {
        (descriptor.supported_anonymous_value_string_formats[position])
    }
}

pub machine PrivilegedRegistryCache::get_default_anonymous_value_string_format(privileged_registry_cache: &PrivilegedRegistryCache, data_type_id: &[u8]) -> AnonymousValueStringFormat {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
    transition PrivilegedRegistryCache::find_data_type_descriptor(privileged_registry_cache, data_type_id, &mut descriptor) {
        true -> (DataTypeDescriptor::get_default_anonymous_value_string_format(&descriptor))
        false -> (AnonymousValueStringFormat::default())
    }
}

pub machine PrivilegedRegistryCache::get_unit_size_in_bytes(privileged_registry_cache: &PrivilegedRegistryCache, data_type_id: &[u8]) -> u64 {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
    transition PrivilegedRegistryCache::find_data_type_descriptor(privileged_registry_cache, data_type_id, &mut descriptor) {
        true -> (DataTypeDescriptor::get_unit_size_in_bytes(&descriptor))
        false -> (0)
    }
}

// Upstream `resolve_struct_layout_definition` — catalog layout hit,
// then the builtin registry's symbolic-struct table.
pub machine PrivilegedRegistryCache::resolve_struct_layout_definition(privileged_registry_cache: &PrivilegedRegistryCache, symbolic_struct_id: &[u8], out: &mut SymbolicStructDefinition) -> bool {
    transition privileged_registry_cache.has_latest_privileged_registry_catalog {
        true -> in_catalog(privileged_registry_cache, symbolic_struct_id, out)
        false -> in_builtin(privileged_registry_cache, symbolic_struct_id, out)
    }
    state in_catalog(privileged_registry_cache: &PrivilegedRegistryCache, symbolic_struct_id: &[u8], out: &mut SymbolicStructDefinition) -> bool {
        let mut descriptor: StructLayoutDescriptor = StructLayoutDescriptor::default();
        transition PrivilegedRegistryCatalog::find_struct_layout_descriptor(&privileged_registry_cache.latest_privileged_registry_catalog, symbolic_struct_id, &mut descriptor) {
            true -> read(privileged_registry_cache, &descriptor, out)
            false -> in_builtin(privileged_registry_cache, symbolic_struct_id, out)
        }
    }
    state read(privileged_registry_cache: &PrivilegedRegistryCache, descriptor: &StructLayoutDescriptor, out: &mut SymbolicStructDefinition) -> bool {
        SymbolicStructDefinition::clone_from(out, StructLayoutDescriptor::get_struct_layout_definition(descriptor));
        (true)
    }
    state in_builtin(privileged_registry_cache: &PrivilegedRegistryCache, symbolic_struct_id: &[u8], out: &mut SymbolicStructDefinition) -> bool {
        (SymbolRegistry::get_symbolic_struct_definition(&privileged_registry_cache.built_in_symbol_registry, symbolic_struct_id, out))
    }
}
