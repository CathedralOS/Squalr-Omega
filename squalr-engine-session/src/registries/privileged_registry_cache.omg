use {squalr_engine_api}/src/plugins/plugin_metadata.omg;
use {squalr_engine_api}/src/registries/symbols/data_type_descriptor.omg;
use {squalr_engine_api}/src/registries/symbols/privileged_registry_catalog.omg;
use {squalr_engine_api}/src/registries/symbols/struct_layout_descriptor.omg;
use {squalr_engine_api}/src/registries/symbols/symbol_registry.omg;
use {squalr_engine_api}/src/structures/data_types/data_type_ref.omg;
use {squalr_engine_api}/src/structures/data_values/anonymous_value_string_format.omg;
use {squalr_engine_api}/src/structures/structs/symbolic_struct_definition.omg;
use src/plugins/plugin_registry.omg;

// Port of registries/privileged_registry_cache.rs — the unprivileged
// side's cache of privileged-owned registry state. Upstream seeds
// `built_in_symbol_registry` from get_builtin_plugin_packages() by
// dyn-dispatching `as_data_type_plugin().contributed_data_types()` —
// port-side the PluginRegistry materializes the same 10 descriptors
// from package constants (contributed_data_type_descriptor), and the
// dyn DataType operations (validate/deanonymize/anonymize/compare)
// remain the deferred residual named in the registry leg.
public data PrivilegedRegistryCache {
    has_latest_privileged_registry_catalog: bool;
    latest_privileged_registry_catalog: |privileged_registry_catalog|::PrivilegedRegistryCatalog;
    built_in_symbol_registry: |symbol_registry|::SymbolRegistry;
}

public machine PrivilegedRegistryCache::default() -> PrivilegedRegistryCache {
    (PrivilegedRegistryCache {
        has_latest_privileged_registry_catalog: false,
        latest_privileged_registry_catalog: |privileged_registry_catalog|::PrivilegedRegistryCatalog::default(),
        built_in_symbol_registry: |symbol_registry|::SymbolRegistry::new(),
    })
}

// Upstream `create_builtin_symbol_registry` — the base registry (21
// builtin descriptors seeded by SymbolRegistry::new) plus every DataType-
// capable builtin package's contributed descriptors.
public machine PrivilegedRegistryCache::new() -> PrivilegedRegistryCache {
    let mut cache: PrivilegedRegistryCache = PrivilegedRegistryCache::default();
    PrivilegedRegistryCache::seed_builtins(&mut cache);
    (cache)
}

public machine PrivilegedRegistryCache::seed_builtins(this: &mut PrivilegedRegistryCache) {
    let plugin_registry: |plugin_registry|::PluginRegistry = |plugin_registry|::PluginRegistry::new();
    transition { _ -> seed_package(this, &plugin_registry, 0) }
    machine seed_package(this: &mut PrivilegedRegistryCache, plugin_registry: &|plugin_registry|::PluginRegistry, plugin_position: u64) {
        let hoist1: u64 = |plugin_registry|::PluginRegistry::get_plugin_count(&plugin_registry);
        transition plugin_position < hoist1 && plugin_position < 8 {
            true -> seed_types(this, plugin_registry, plugin_position, 0)
            false -> finish(this)
        }
    }
    machine seed_types(this: &mut PrivilegedRegistryCache, plugin_registry: &|plugin_registry|::PluginRegistry, plugin_position: u64, index: u64) {
        let hoist2: u64 = |plugin_registry|::PluginRegistry::contributed_data_type_count(&plugin_registry, plugin_position);
        transition index < hoist2 && index < 16 {
            true -> materialize(this, plugin_registry, plugin_position, index)
            false -> seed_package(this, plugin_registry, ((plugin_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    machine materialize(this: &mut PrivilegedRegistryCache, plugin_registry: &|plugin_registry|::PluginRegistry, plugin_position: u64, index: u64) {
        let mut descriptor: |data_type_descriptor|::DataTypeDescriptor = |data_type_descriptor|::DataTypeDescriptor::default();
        let hoist3: bool = |plugin_registry|::PluginRegistry::contributed_data_type_descriptor(&plugin_registry, plugin_position, index, &mut descriptor);
        transition hoist3 {
            true -> register(this, plugin_registry, plugin_position, index, &descriptor)
            false -> seed_types(this, plugin_registry, plugin_position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    machine register(this: &mut PrivilegedRegistryCache, plugin_registry: &|plugin_registry|::PluginRegistry, plugin_position: u64, index: u64, descriptor: &|data_type_descriptor|::DataTypeDescriptor) {
        _ = |symbol_registry|::SymbolRegistry::register_data_type_descriptor(&mut this.built_in_symbol_registry, descriptor);
        transition { _ -> seed_types(this, plugin_registry, plugin_position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    machine finish(this: &mut PrivilegedRegistryCache) {
    }
}

public machine PrivilegedRegistryCache::apply_registry_catalog(this: &mut PrivilegedRegistryCache, privileged_registry_catalog: &|privileged_registry_catalog|::PrivilegedRegistryCatalog) {
    |privileged_registry_catalog|::PrivilegedRegistryCatalog::clone_from(&mut this.latest_privileged_registry_catalog, privileged_registry_catalog);
    this.has_latest_privileged_registry_catalog = true;
}

public machine PrivilegedRegistryCache::get_has_registry_catalog(this: &PrivilegedRegistryCache) -> bool {
    this.has_latest_privileged_registry_catalog
}

public machine PrivilegedRegistryCache::get_registry_catalog(this: &PrivilegedRegistryCache) -> &|privileged_registry_catalog|::PrivilegedRegistryCatalog {
    (&this.latest_privileged_registry_catalog)
}

// Upstream `get_generation` — the catalog's generation, 0 when absent.
public machine PrivilegedRegistryCache::get_generation(this: &PrivilegedRegistryCache) -> u64 {
    let hoist12: u64 = |privileged_registry_catalog|::PrivilegedRegistryCatalog::get_generation(&this.latest_privileged_registry_catalog);
    transition this.has_latest_privileged_registry_catalog {
        true -> (hoist12)
        false -> (0)
    }
}

// Upstream `get_registered_data_type_refs` — descriptor-at-position
// access over whichever table is authoritative (catalog when present,
// else the builtin registry), the same Vec<DataTypeRef> iteration
// upstream callers perform.
public machine PrivilegedRegistryCache::get_registered_data_type_descriptor_count(this: &PrivilegedRegistryCache) -> u64 {
    let hoist14: u64 = |symbol_registry|::SymbolRegistry::get_data_type_descriptor_count(&this.built_in_symbol_registry);
    let hoist13: u64 = |privileged_registry_catalog|::PrivilegedRegistryCatalog::get_data_type_descriptor_count(&this.latest_privileged_registry_catalog);
    transition this.has_latest_privileged_registry_catalog {
        true -> (hoist13)
        false -> (hoist14)
    }
}

public machine PrivilegedRegistryCache::get_registered_data_type_descriptor_at(this: &PrivilegedRegistryCache, position: u64, out_descriptor: &mut |data_type_descriptor|::DataTypeDescriptor) -> bool {
    transition this.has_latest_privileged_registry_catalog {
        true -> catalog(this, position, out_descriptor)
        false -> builtin(this, position, out_descriptor)
    }
    machine catalog(this: &PrivilegedRegistryCache, position: u64, out_descriptor: &mut |data_type_descriptor|::DataTypeDescriptor) -> bool {
        let hoist4: u64 = |privileged_registry_catalog|::PrivilegedRegistryCatalog::get_data_type_descriptor_count(&this.latest_privileged_registry_catalog);
        transition position < hoist4 && position < 128 {
            true -> read(this, position, out_descriptor)
            false -> (false)
        }
    }
    machine read(this: &PrivilegedRegistryCache, position: u64, out_descriptor: &mut |data_type_descriptor|::DataTypeDescriptor) -> bool
        requires position < 128;
    {
        |data_type_descriptor|::DataTypeDescriptor::clone_from(&mut out_descriptor, &this.latest_privileged_registry_catalog.data_type_descriptors[position]);
        (true)
    }
    machine builtin(this: &PrivilegedRegistryCache, position: u64, out_descriptor: &mut |data_type_descriptor|::DataTypeDescriptor) -> bool {
        let hoist15: bool = |symbol_registry|::SymbolRegistry::get_registered_data_type_descriptor_at(&this.built_in_symbol_registry, position, out_descriptor);
        (hoist15)
    }
}

// Upstream `find_data_type_descriptor` — catalog first, builtin fallback.
public machine PrivilegedRegistryCache::find_data_type_descriptor(this: &PrivilegedRegistryCache, data_type_id: &[u8], out_descriptor: &mut |data_type_descriptor|::DataTypeDescriptor) -> bool {
    transition this.has_latest_privileged_registry_catalog {
        true -> in_catalog(this, data_type_id, out_descriptor)
        false -> in_builtin(this, data_type_id, out_descriptor)
    }
    machine in_catalog(this: &PrivilegedRegistryCache, data_type_id: &[u8], out_descriptor: &mut |data_type_descriptor|::DataTypeDescriptor) -> bool {
        let hoist5: bool = |privileged_registry_catalog|::PrivilegedRegistryCatalog::find_data_type_descriptor(&this.latest_privileged_registry_catalog, data_type_id, out_descriptor);
        transition hoist5 {
            true -> (true)
            false -> in_builtin(this, data_type_id, out_descriptor)
        }
    }
    machine in_builtin(this: &PrivilegedRegistryCache, data_type_id: &[u8], out_descriptor: &mut |data_type_descriptor|::DataTypeDescriptor) -> bool {
        let hoist16: bool = |symbol_registry|::SymbolRegistry::find_data_type_descriptor(&this.built_in_symbol_registry, data_type_id, out_descriptor);
        (hoist16)
    }
}

public machine PrivilegedRegistryCache::is_registered_data_type_ref(this: &PrivilegedRegistryCache, data_type_ref: &|data_type_ref|::DataTypeRef) -> bool {
    let mut scratch: |data_type_descriptor|::DataTypeDescriptor = |data_type_descriptor|::DataTypeDescriptor::default();
    let hoist17: bool = PrivilegedRegistryCache::find_data_type_descriptor(&this, |data_type_ref|::DataTypeRef::get_data_type_id(&data_type_ref), &mut scratch);
    (hoist17)
}

// Upstream `get_supported_anonymous_value_string_formats` — the
// descriptor's format table on a hit; empty count on a miss mirrors
// upstream's builtin-registry fallback only being needed when the
// catalog ALSO misses (builtin is always consulted second).
public machine PrivilegedRegistryCache::get_supported_anonymous_value_string_format_count(this: &PrivilegedRegistryCache, data_type_id: &[u8]) -> u64 {
    let mut descriptor: |data_type_descriptor|::DataTypeDescriptor = |data_type_descriptor|::DataTypeDescriptor::default();
    let hoist18: u64 = |data_type_descriptor|::DataTypeDescriptor::get_supported_format_count(&descriptor);
    let hoist6: bool = PrivilegedRegistryCache::find_data_type_descriptor(&this, data_type_id, &mut descriptor);
    transition hoist6 {
        true -> (hoist18)
        false -> (0)
    }
}

public machine PrivilegedRegistryCache::get_supported_anonymous_value_string_format(this: &PrivilegedRegistryCache, data_type_id: &[u8], position: u64) -> |anonymous_value_string_format|::AnonymousValueStringFormat {
    let mut descriptor: |data_type_descriptor|::DataTypeDescriptor = |data_type_descriptor|::DataTypeDescriptor::default();
    let hoist7: bool = PrivilegedRegistryCache::find_data_type_descriptor(&this, data_type_id, &mut descriptor);
    transition hoist7 {
        true -> format_of(this, &descriptor, position)
        false -> (|anonymous_value_string_format|::AnonymousValueStringFormat::default())
    }
    machine format_of(this: &PrivilegedRegistryCache, descriptor: &|data_type_descriptor|::DataTypeDescriptor, position: u64) -> |anonymous_value_string_format|::AnonymousValueStringFormat {
        let hoist8: u64 = |data_type_descriptor|::DataTypeDescriptor::get_supported_format_count(&descriptor);
        transition position < hoist8 && position < 8 {
            true -> format_at(this, descriptor, position)
            false -> (|anonymous_value_string_format|::AnonymousValueStringFormat::default())
        }
    }
    machine format_at(this: &PrivilegedRegistryCache, descriptor: &|data_type_descriptor|::DataTypeDescriptor, position: u64) -> |anonymous_value_string_format|::AnonymousValueStringFormat
        requires position < 8;
    {
        (descriptor.supported_anonymous_value_string_formats[position])
    }
}

public machine PrivilegedRegistryCache::get_default_anonymous_value_string_format(this: &PrivilegedRegistryCache, data_type_id: &[u8]) -> |anonymous_value_string_format|::AnonymousValueStringFormat {
    let mut descriptor: |data_type_descriptor|::DataTypeDescriptor = |data_type_descriptor|::DataTypeDescriptor::default();
    let hoist19: |anonymous_value_string_format|::AnonymousValueStringFormat = |data_type_descriptor|::DataTypeDescriptor::get_default_anonymous_value_string_format(&descriptor);
    let hoist9: bool = PrivilegedRegistryCache::find_data_type_descriptor(&this, data_type_id, &mut descriptor);
    transition hoist9 {
        true -> (hoist19)
        false -> (|anonymous_value_string_format|::AnonymousValueStringFormat::default())
    }
}

public machine PrivilegedRegistryCache::get_unit_size_in_bytes(this: &PrivilegedRegistryCache, data_type_id: &[u8]) -> u64 {
    let mut descriptor: |data_type_descriptor|::DataTypeDescriptor = |data_type_descriptor|::DataTypeDescriptor::default();
    let hoist20: u64 = |data_type_descriptor|::DataTypeDescriptor::get_unit_size_in_bytes(&descriptor);
    let hoist10: bool = PrivilegedRegistryCache::find_data_type_descriptor(&this, data_type_id, &mut descriptor);
    transition hoist10 {
        true -> (hoist20)
        false -> (0)
    }
}

// Upstream `resolve_struct_layout_definition` — catalog layout hit,
// then the builtin registry's symbolic-struct table.
public machine PrivilegedRegistryCache::resolve_struct_layout_definition(this: &PrivilegedRegistryCache, symbolic_struct_id: &[u8], out: &mut |symbolic_struct_definition|::SymbolicStructDefinition) -> bool {
    transition this.has_latest_privileged_registry_catalog {
        true -> in_catalog(this, symbolic_struct_id, out)
        false -> in_builtin(this, symbolic_struct_id, out)
    }
    machine in_catalog(this: &PrivilegedRegistryCache, symbolic_struct_id: &[u8], out: &mut |symbolic_struct_definition|::SymbolicStructDefinition) -> bool {
        let mut descriptor: |struct_layout_descriptor|::StructLayoutDescriptor = |struct_layout_descriptor|::StructLayoutDescriptor::default();
        let hoist11: bool = |privileged_registry_catalog|::PrivilegedRegistryCatalog::find_struct_layout_descriptor(&this.latest_privileged_registry_catalog, symbolic_struct_id, &mut descriptor);
        transition hoist11 {
            true -> read(this, &descriptor, out)
            false -> in_builtin(this, symbolic_struct_id, out)
        }
    }
    machine read(this: &PrivilegedRegistryCache, descriptor: &|struct_layout_descriptor|::StructLayoutDescriptor, out: &mut |symbolic_struct_definition|::SymbolicStructDefinition) -> bool {
        |symbolic_struct_definition|::SymbolicStructDefinition::clone_from(&mut out, |struct_layout_descriptor|::StructLayoutDescriptor::get_struct_layout_definition(descriptor));
        (true)
    }
    machine in_builtin(this: &PrivilegedRegistryCache, symbolic_struct_id: &[u8], out: &mut |symbolic_struct_definition|::SymbolicStructDefinition) -> bool {
        let hoist21: bool = |symbol_registry|::SymbolRegistry::get_symbolic_struct_definition(&this.built_in_symbol_registry, symbolic_struct_id, out);
        (hoist21)
    }
}
