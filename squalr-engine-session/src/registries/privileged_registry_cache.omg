module src::registries::privileged_registry_cache;

use squalr_engine_api::src::plugins::plugin_metadata::PluginMetadata;
use squalr_engine_api::src::registries::symbols::data_type_descriptor::DataTypeDescriptor;
use squalr_engine_api::src::registries::symbols::privileged_registry_catalog::PrivilegedRegistryCatalog;
use squalr_engine_api::src::registries::symbols::struct_layout_descriptor::StructLayoutDescriptor;
use squalr_engine_api::src::registries::symbols::symbol_registry::SymbolRegistry;
use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use squalr_engine_api::src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use squalr_engine_api::src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;
use src::plugins::plugin_registry::PluginRegistry;

// Port of registries/privileged_registry_cache.rs — the unprivileged
// side's cache of privileged-owned registry state. Upstream seeds
// `built_in_symbol_registry` from get_builtin_plugin_packages() by
// dyn-dispatching `as_data_type_plugin().contributed_data_types()` —
// port-side the PluginRegistry materializes the same 10 descriptors
// from package constants (contributed_data_type_descriptor), and the
// dyn DataType operations (validate/deanonymize/anonymize/compare)
// remain the deferred residual named in the registry leg.
pub data PrivilegedRegistryCache {
    has_latest_privileged_registry_catalog: bool;
    latest_privileged_registry_catalog: PrivilegedRegistryCatalog;
    built_in_symbol_registry: SymbolRegistry;
}

pub machine PrivilegedRegistryCache::default() -> PrivilegedRegistryCache {
    (PrivilegedRegistryCache {
        has_latest_privileged_registry_catalog: false,
        latest_privileged_registry_catalog: PrivilegedRegistryCatalog::default(),
        built_in_symbol_registry: SymbolRegistry::new(),
    })
}

// Upstream `create_builtin_symbol_registry` — the base registry (21
// builtin descriptors seeded by SymbolRegistry::new) plus every DataType-
// capable builtin package's contributed descriptors.
pub machine PrivilegedRegistryCache::new() -> PrivilegedRegistryCache {
    let mut cache: PrivilegedRegistryCache = PrivilegedRegistryCache::default();
    PrivilegedRegistryCache::seed_builtins(&mut cache);
    (cache)
}

pub machine PrivilegedRegistryCache::seed_builtins(this: &mut PrivilegedRegistryCache) {
    let plugin_registry: PluginRegistry = PluginRegistry::new();
    transition { _ -> seed_package(this, &plugin_registry, 0) }
    state seed_package(this: &mut PrivilegedRegistryCache, plugin_registry: &PluginRegistry, plugin_position: u64) {
        let hoist1: u64 = PluginRegistry::get_plugin_count(&plugin_registry);
        transition plugin_position < hoist1 && plugin_position < 8 {
            true -> seed_types(this, plugin_registry, plugin_position, 0)
            false -> finish(this)
        }
    }
    state seed_types(this: &mut PrivilegedRegistryCache, plugin_registry: &PluginRegistry, plugin_position: u64, index: u64) {
        let hoist2: u64 = PluginRegistry::contributed_data_type_count(&plugin_registry, plugin_position);
        transition index < hoist2 && index < 16 {
            true -> materialize(this, plugin_registry, plugin_position, index)
            false -> seed_package(this, plugin_registry, ((plugin_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state materialize(this: &mut PrivilegedRegistryCache, plugin_registry: &PluginRegistry, plugin_position: u64, index: u64) {
        let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
        let hoist3: bool = PluginRegistry::contributed_data_type_descriptor(&plugin_registry, plugin_position, index, &mut descriptor);
        transition hoist3 {
            true -> register(this, plugin_registry, plugin_position, index, &descriptor)
            false -> seed_types(this, plugin_registry, plugin_position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state register(this: &mut PrivilegedRegistryCache, plugin_registry: &PluginRegistry, plugin_position: u64, index: u64, descriptor: &DataTypeDescriptor) {
        _ = SymbolRegistry::register_data_type_descriptor(&mut this.built_in_symbol_registry, descriptor);
        transition { _ -> seed_types(this, plugin_registry, plugin_position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(this: &mut PrivilegedRegistryCache) {
    }
}

pub machine PrivilegedRegistryCache::apply_registry_catalog(this: &mut PrivilegedRegistryCache, privileged_registry_catalog: &PrivilegedRegistryCatalog) {
    PrivilegedRegistryCatalog::clone_from(&mut this.latest_privileged_registry_catalog, privileged_registry_catalog);
    this.has_latest_privileged_registry_catalog = true;
}

pub machine PrivilegedRegistryCache::get_has_registry_catalog(this: &PrivilegedRegistryCache) -> bool {
    this.has_latest_privileged_registry_catalog
}

pub machine PrivilegedRegistryCache::get_registry_catalog(this: &PrivilegedRegistryCache) -> &PrivilegedRegistryCatalog {
    (&this.latest_privileged_registry_catalog)
}

// Upstream `get_generation` — the catalog's generation, 0 when absent.
pub machine PrivilegedRegistryCache::get_generation(this: &PrivilegedRegistryCache) -> u64 {
    let hoist12: u64 = PrivilegedRegistryCatalog::get_generation(&this.latest_privileged_registry_catalog);
    transition this.has_latest_privileged_registry_catalog {
        true -> (hoist12)
        false -> (0)
    }
}

// Upstream `get_registered_data_type_refs` — descriptor-at-position
// access over whichever table is authoritative (catalog when present,
// else the builtin registry), the same Vec<DataTypeRef> iteration
// upstream callers perform.
pub machine PrivilegedRegistryCache::get_registered_data_type_descriptor_count(this: &PrivilegedRegistryCache) -> u64 {
    let hoist14: u64 = SymbolRegistry::get_data_type_descriptor_count(&this.built_in_symbol_registry);
    let hoist13: u64 = PrivilegedRegistryCatalog::get_data_type_descriptor_count(&this.latest_privileged_registry_catalog);
    transition this.has_latest_privileged_registry_catalog {
        true -> (hoist13)
        false -> (hoist14)
    }
}

pub machine PrivilegedRegistryCache::get_registered_data_type_descriptor_at(this: &PrivilegedRegistryCache, position: u64, out_descriptor: &mut DataTypeDescriptor) -> bool {
    transition this.has_latest_privileged_registry_catalog {
        true -> catalog(this, position, out_descriptor)
        false -> builtin(this, position, out_descriptor)
    }
    state catalog(this: &PrivilegedRegistryCache, position: u64, out_descriptor: &mut DataTypeDescriptor) -> bool {
        let hoist4: u64 = PrivilegedRegistryCatalog::get_data_type_descriptor_count(&this.latest_privileged_registry_catalog);
        transition position < hoist4 && position < 128 {
            true -> read(this, position, out_descriptor)
            false -> (false)
        }
    }
    state read(this: &PrivilegedRegistryCache, position: u64, out_descriptor: &mut DataTypeDescriptor) -> bool
        requires position < 128;
    {
        DataTypeDescriptor::clone_from(&mut out_descriptor, &this.latest_privileged_registry_catalog.data_type_descriptors[position]);
        (true)
    }
    state builtin(this: &PrivilegedRegistryCache, position: u64, out_descriptor: &mut DataTypeDescriptor) -> bool {
        let hoist15: bool = SymbolRegistry::get_registered_data_type_descriptor_at(&this.built_in_symbol_registry, position, out_descriptor);
        (hoist15)
    }
}

// Upstream `find_data_type_descriptor` — catalog first, builtin fallback.
pub machine PrivilegedRegistryCache::find_data_type_descriptor(this: &PrivilegedRegistryCache, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor) -> bool {
    transition this.has_latest_privileged_registry_catalog {
        true -> in_catalog(this, data_type_id, out_descriptor)
        false -> in_builtin(this, data_type_id, out_descriptor)
    }
    state in_catalog(this: &PrivilegedRegistryCache, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor) -> bool {
        let hoist5: bool = PrivilegedRegistryCatalog::find_data_type_descriptor(&this.latest_privileged_registry_catalog, data_type_id, out_descriptor);
        transition hoist5 {
            true -> (true)
            false -> in_builtin(this, data_type_id, out_descriptor)
        }
    }
    state in_builtin(this: &PrivilegedRegistryCache, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor) -> bool {
        let hoist16: bool = SymbolRegistry::find_data_type_descriptor(&this.built_in_symbol_registry, data_type_id, out_descriptor);
        (hoist16)
    }
}

pub machine PrivilegedRegistryCache::is_registered_data_type_ref(this: &PrivilegedRegistryCache, data_type_ref: &DataTypeRef) -> bool {
    let mut scratch: DataTypeDescriptor = DataTypeDescriptor::default();
    let hoist17: bool = PrivilegedRegistryCache::find_data_type_descriptor(&this, DataTypeRef::get_data_type_id(&data_type_ref), &mut scratch) &mut scratch);
    (hoist17)
}

// Upstream `get_supported_anonymous_value_string_formats` — the
// descriptor's format table on a hit; empty count on a miss mirrors
// upstream's builtin-registry fallback only being needed when the
// catalog ALSO misses (builtin is always consulted second).
pub machine PrivilegedRegistryCache::get_supported_anonymous_value_string_format_count(this: &PrivilegedRegistryCache, data_type_id: &[u8]) -> u64 {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
    let hoist18: u64 = DataTypeDescriptor::get_supported_format_count(&descriptor);
    let hoist6: bool = PrivilegedRegistryCache::find_data_type_descriptor(&this, data_type_id, &mut descriptor);
    transition hoist6 {
        true -> (hoist18)
        false -> (0)
    }
}

pub machine PrivilegedRegistryCache::get_supported_anonymous_value_string_format(this: &PrivilegedRegistryCache, data_type_id: &[u8], position: u64) -> AnonymousValueStringFormat {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
    let hoist7: bool = PrivilegedRegistryCache::find_data_type_descriptor(&this, data_type_id, &mut descriptor);
    transition hoist7 {
        true -> format_of(this, &descriptor, position)
        false -> (AnonymousValueStringFormat::default())
    }
    state format_of(this: &PrivilegedRegistryCache, descriptor: &DataTypeDescriptor, position: u64) -> AnonymousValueStringFormat {
        let hoist8: u64 = DataTypeDescriptor::get_supported_format_count(&descriptor);
        transition position < hoist8 && position < 8 {
            true -> format_at(this, descriptor, position)
            false -> (AnonymousValueStringFormat::default())
        }
    }
    state format_at(this: &PrivilegedRegistryCache, descriptor: &DataTypeDescriptor, position: u64) -> AnonymousValueStringFormat
        requires position < 8;
    {
        (descriptor.supported_anonymous_value_string_formats[position])
    }
}

pub machine PrivilegedRegistryCache::get_default_anonymous_value_string_format(this: &PrivilegedRegistryCache, data_type_id: &[u8]) -> AnonymousValueStringFormat {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
    let hoist19: AnonymousValueStringFormat = DataTypeDescriptor::get_default_anonymous_value_string_format(&descriptor);
    let hoist9: bool = PrivilegedRegistryCache::find_data_type_descriptor(&this, data_type_id, &mut descriptor);
    transition hoist9 {
        true -> (hoist19)
        false -> (AnonymousValueStringFormat::default())
    }
}

pub machine PrivilegedRegistryCache::get_unit_size_in_bytes(this: &PrivilegedRegistryCache, data_type_id: &[u8]) -> u64 {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
    let hoist20: u64 = DataTypeDescriptor::get_unit_size_in_bytes(&descriptor);
    let hoist10: bool = PrivilegedRegistryCache::find_data_type_descriptor(&this, data_type_id, &mut descriptor);
    transition hoist10 {
        true -> (hoist20)
        false -> (0)
    }
}

// Upstream `resolve_struct_layout_definition` — catalog layout hit,
// then the builtin registry's symbolic-struct table.
pub machine PrivilegedRegistryCache::resolve_struct_layout_definition(this: &PrivilegedRegistryCache, symbolic_struct_id: &[u8], out: &mut SymbolicStructDefinition) -> bool {
    transition this.has_latest_privileged_registry_catalog {
        true -> in_catalog(this, symbolic_struct_id, out)
        false -> in_builtin(this, symbolic_struct_id, out)
    }
    state in_catalog(this: &PrivilegedRegistryCache, symbolic_struct_id: &[u8], out: &mut SymbolicStructDefinition) -> bool {
        let mut descriptor: StructLayoutDescriptor = StructLayoutDescriptor::default();
        let hoist11: bool = PrivilegedRegistryCatalog::find_struct_layout_descriptor(&this.latest_privileged_registry_catalog, symbolic_struct_id, &mut descriptor);
        transition hoist11 {
            true -> read(this, &descriptor, out)
            false -> in_builtin(this, symbolic_struct_id, out)
        }
    }
    state read(this: &PrivilegedRegistryCache, descriptor: &StructLayoutDescriptor, out: &mut SymbolicStructDefinition) -> bool {
        SymbolicStructDefinition::clone_from(&mut out, StructLayoutDescriptor::get_struct_layout_definition(descriptor));
        (true)
    }
    state in_builtin(this: &PrivilegedRegistryCache, symbolic_struct_id: &[u8], out: &mut SymbolicStructDefinition) -> bool {
        let hoist21: bool = SymbolRegistry::get_symbolic_struct_definition(&this.built_in_symbol_registry, symbolic_struct_id, out);
        (hoist21)
    }
}
