reaches FilesystemHost
invokes FilesystemHost;
{
    PatchService::apply_patch(&mut engine_privileged_state.patch_service, opened_process_info, &mut engine_privileged_state.os_providers, address, module_name, patched_bytes, kind, has_label, label)
}

