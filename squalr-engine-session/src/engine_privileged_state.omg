public machine EnginePrivilegedState::set_project_symbol_catalog(this: &mut EnginePrivilegedState, project_symbol_catalog: &|project_symbol_catalog|::ProjectSymbolCatalog) -> bool {
    let did_change: bool = |symbol_registry|::SymbolRegistry::set_project_symbol_catalog(&mut this.symbol_registry, project_symbol_catalog);
    let hoist2: bool = EnginePrivilegedState::finish_symbol_registry_mutation(&mut this, did_change);
