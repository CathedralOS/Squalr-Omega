// Port of engine_privileged_state.rs for the headless command leg. Upstream
// holds `Arc<RwLock<...>>` fields behind a singleton; the port keeps the same
// fields as plain values owned by `SqualrEngine` — the synchronous dispatch
// model makes the locks no-ops.
//
// Field parity notes: `freeze_list_registry` carries the real registry now
// that the freeze/set_property executor leg landed — the periodic
// freezer-task thread is the remaining deferred surface (see
// tasks/snapshot_scan_result_freeze_task.omg). `supplied_memory_source` is
// the sanctioned test adapter standing in for the opened process's live
// reader — the CLI leg exercises scans over it because no real target
// exists to attach to.
pub data EnginePrivilegedState {
    has_opened_process: bool;
    opened_process: OpenedProcessInfo;
    // Upstream `os_providers` (the session-wide provider registry behind
    // `get_os_providers`). The concrete provider records are ZII-established
    // like upstream's unit-struct `new`, so zero-init is the construction.
    os_providers: EngineOsProviders;
    // Upstream `task_manager` (sessions/trackable_task_manager.rs): the
    // running-task table upstream keeps beside `process_manager`.
    task_manager: TrackableTaskManager;
    snapshot: Snapshot;
    freeze_list_registry: FreezeListRegistry;
    scan_settings: ScanSettings;
    // Upstream `GeneralSettingsConfig`/`MemorySettingsConfig` static
    // Arc<RwLock> singletons, mapped to session fields: the headless port
    // has no statics. Upstream mutates them through its JSON store
    // (persistence leg is deferred); the read-lock failure arm on its
    // `get_full_config().read()` is unreachable here by construction.
    general_settings: GeneralSettings;
    memory_settings: MemorySettings;
    supplied_memory_source: SuppliedMemorySource;
    // Upstream `Arc<RwLock<Option<PointerScanResults>>>` + the
    // `AtomicU64` session-id allocator, and the fixture-side module table
    // upstream reads through the OS memory-query provider.
    pointer_scan_results_store: PointerScanResultsStore;
    next_pointer_scan_results_id: u64;
    supplied_modules: [NormalizedModule; 8];
    supplied_module_count: u64;
    // Upstream's `engine_bindings` dispatch channel, headless shape:
    // events queue here for consumers to drain (see
    // pending_engine_events.omg for the deviation rationale).
    pending_engine_events: PendingEngineEvents;
    // Upstream keeps the symbol registry inside `Arc<Registries>`
    // (`registries.get_symbol_registry()`); the port lifts the one
    // registry the session owns onto the record directly. Upstream's
    // `symbol_registry_mutation_guard: Mutex<()>` drops — a session-owned
    // record is already single-writer (the mutation wrappers below carry
    // upstream's change-then-notify contract).
    symbol_registry: SymbolRegistry;
    // Upstream `symbol_registry_generation: AtomicU64` (starts at 1,
    // bumps on every accepted registry mutation).
    symbol_registry_generation: u64;
    // Upstream `PatchService` (the `Mutex<PatchServiceState>` inside maps
    // onto the field itself). `clear_if_process_changed` fires from
    // upstream's ProcessChanged event hook; headless calls it inline at the
    // open/close setters below — the patch table follows the opened process.
    patch_service: PatchService;
    // Upstream `plugin_registry: PluginRegistry` — the bounded-metadata port
    // (seed table + flags + order + data-type ownership; see
    // src/plugins/plugin_registry.omg for the dropped dyn surfaces).
    plugin_registry: PluginRegistry;
}

// Entry-plan variant of `new`: only the non-zero-initialized scalar is
// written (union field stores are unavailable in the entry unit plan; the
// remaining fields' zero cases already match `new`, see the case-order
// notes on Bitness/MemoryReadMode/TargetArchitecture).
pub machine EnginePrivilegedState::init(&mut self) {
    self.scan_settings.results_page_size = 22;
    self.memory_settings.memory_type_none = true;
    self.memory_settings.memory_type_private = true;
    self.memory_settings.memory_type_image = true;
    self.memory_settings.memory_type_mapped = true;
    self.memory_settings.end_address = 18446744073709551615;
    // Zero-init leaves the registry tables empty — the builtin seed must
    // run to match `new` (upstream `SymbolRegistry::new` seeds them).
    self.symbol_registry = SymbolRegistry::new();
    self.symbol_registry_generation = 1;
    // PatchService::new is plain record init whose non-zero field is the
    // id counter — entry plan can write it directly.
    self.patch_service.next_patch_number = 1;
    self.patch_service.has_process_key = false;
    self.patch_service.patch_count = 0;
    // PluginRegistry::new seeds the 7 builtin packages + the ownership
    // table — mirrors the symbol-registry seed call above.
    self.plugin_registry = PluginRegistry::new();
}

pub machine EnginePrivilegedState::new() -> EnginePrivilegedState {
    EnginePrivilegedState {
        has_opened_process: false,
        opened_process: OpenedProcessInfo::new(0, "", 0, 0, Bitness::Bit64),
        snapshot: Snapshot::new(),
        freeze_list_registry: FreezeListRegistry::new(),
        scan_settings: ScanSettings::default(),
        general_settings: GeneralSettings::default(),
        memory_settings: MemorySettings::default(),
        supplied_memory_source: SuppliedMemorySource::empty(),
        task_manager: TrackableTaskManager::new(),
        pointer_scan_results_store: PointerScanResultsStore::empty(),
        next_pointer_scan_results_id: 0,
        supplied_module_count: 0,
        pending_engine_events: PendingEngineEvents::new(),
        symbol_registry: SymbolRegistry::new(),
        symbol_registry_generation: 1,
        patch_service: PatchService::new(),
        plugin_registry: PluginRegistry::new(),
    }
}

pub machine EnginePrivilegedState::has_opened_process(&self) -> bool {
    self.has_opened_process
}

pub machine EnginePrivilegedState::get_opened_process(&self) -> OpenedProcessInfo {
    self.opened_process
}

// Test-side open: the adapter's equivalent of `open_process` completing
// successfully. `scan new` requires an opened process upstream.
pub machine EnginePrivilegedState::set_opened_process(&mut self, opened_process: OpenedProcessInfo) {
    self.opened_process = opened_process;
    self.has_opened_process = true;
    // Upstream's ProcessChanged event → PatchService::clear_if_process_changed.
    self.patch_service.clear_if_process_changed(
        true,
        self.opened_process.get_process_id_raw() as u64,
        self.opened_process.get_handle());
}

// Fixture form of `set_opened_process` for entry contexts that cannot move
// the aggregate across a call boundary (same constraint as
// `make_fixture_source`). Union and array fields keep their zero-initialized
// values — Bitness leads with Bit64 — so scalar stores alone match
// `OpenedProcessInfo::new(id, "", id, Bit64)`.
pub machine EnginePrivilegedState::set_opened_process_fixture(&mut self, process_id: u32) {
    self.opened_process.process_id = process_id;
    self.opened_process.handle = process_id as u64;
    self.has_opened_process = true;
    self.patch_service.clear_if_process_changed(true, process_id as u64, process_id as u64);
}

// One zeroed supplied region — the fixture form of `supply_memory` for
// harnesses that cannot move the aggregate across a call boundary.
pub machine EnginePrivilegedState::make_fixture_source(
    base_address: u64,
    element_count: u64
) -> SuppliedMemorySource {
    SuppliedMemorySource::of_region(
        SuppliedRegion::of_window(
            base_address, ElementWindow::of_length(element_count), 8))
}

pub machine EnginePrivilegedState::clear_opened_process(&mut self) {
    self.has_opened_process = false;
    self.patch_service.clear_if_process_changed(false, 0, 0);
}

