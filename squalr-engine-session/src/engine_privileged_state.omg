public machine EnginePrivilegedState::allocate_pointer_scan_results_id(this: &mut EnginePrivilegedState) -> u64 {
    this.next_pointer_scan_results_id = ((this.next_pointer_scan_results_id as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    this.next_pointer_scan_results_id
}

