module src::engine_privileged_state;

use squalr_engine_api::src::structures::memory::bitness::Bitness;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::settings::scan_settings::ScanSettings;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use src::os::supplied_memory_source::SuppliedMemorySource;
use src::os::supplied_memory_source::SuppliedRegion;
use squalr_engine_api::src::structures::snapshots::element_window::ElementWindow;

// Port of engine_privileged_state.rs for the headless command leg. Upstream
// holds `Arc<RwLock<...>>` fields behind a singleton; the port keeps the same
// fields as plain values owned by `SqualrEngine` — the synchronous dispatch
// model makes the locks no-ops.
//
// Field parity notes: `freeze_list_registry` becomes `freeze_list_count` —
// the list/freezer task pipeline (FreezeRequest executors, TaskHandle
// registry) is a later leg, and CLI-COMMANDS only needs the scan settings
// flag it feeds. `supplied_memory_source` is the sanctioned test adapter
// standing in for the opened process's live reader — the CLI leg exercises
// scans over it because no real target exists to attach to.
pub data EnginePrivilegedState {
    has_opened_process: bool;
    opened_process: OpenedProcessInfo;
    snapshot: Snapshot;
    freeze_list_count: u64;
    scan_settings: ScanSettings;
    supplied_memory_source: SuppliedMemorySource;
}

// Entry-plan variant of `new`: only the non-zero-initialized scalar is
// written (union field stores are unavailable in the entry unit plan; the
// remaining fields' zero cases already match `new`, see the case-order
// notes on Bitness/MemoryReadMode/TargetArchitecture).
pub machine EnginePrivilegedState::init(&mut self) {
    self.scan_settings.results_page_size = 22;
}

pub machine EnginePrivilegedState::new() -> EnginePrivilegedState {
    EnginePrivilegedState {
        has_opened_process: false,
        opened_process: OpenedProcessInfo::new(0, "", 0, Bitness::Bit64),
        snapshot: Snapshot::new(),
        freeze_list_count: 0,
        scan_settings: ScanSettings::default(),
        supplied_memory_source: SuppliedMemorySource::empty(),
    }
}

pub machine EnginePrivilegedState::has_opened_process(&self) -> bool {
    self.has_opened_process
}

pub machine EnginePrivilegedState::get_opened_process(&self) -> OpenedProcessInfo {
    self.opened_process
}

// Test-side open: the adapter's equivalent of `open_process` completing
// successfully. `scan new` requires an opened process upstream.
pub machine EnginePrivilegedState::set_opened_process(&mut self, opened_process: OpenedProcessInfo) {
    self.opened_process = opened_process;
    self.has_opened_process = true;
}

// Fixture form of `set_opened_process` for entry contexts that cannot move
// the aggregate across a call boundary (same constraint as
// `make_fixture_source`). Union and array fields keep their zero-initialized
// values — Bitness leads with Bit64 — so scalar stores alone match
// `OpenedProcessInfo::new(id, "", id, Bit64)`.
pub machine EnginePrivilegedState::set_opened_process_fixture(&mut self, process_id: u32) {
    self.opened_process.process_id = process_id;
    self.opened_process.handle = process_id as u64;
    self.has_opened_process = true;
}

// One zeroed supplied region — the fixture form of `supply_memory` for
// harnesses that cannot move the aggregate across a call boundary.
pub machine EnginePrivilegedState::make_fixture_source(
    base_address: u64,
    element_count: u64
) -> SuppliedMemorySource {
    SuppliedMemorySource::of_region(
        SuppliedRegion::of_window(
            base_address, ElementWindow::of_length(element_count), 8))
}

pub machine EnginePrivilegedState::clear_opened_process(&mut self) {
    self.has_opened_process = false;
}

pub machine EnginePrivilegedState::get_snapshot(&self) -> Snapshot {
    Snapshot::clone(&self.snapshot)
}

// Borrowed access for scan-time reads — the snapshot stays owned here.
pub machine EnginePrivilegedState::borrow_snapshot(&self) -> &Snapshot {
    &self.snapshot
}

pub machine EnginePrivilegedState::borrow_snapshot_mut(&mut self) -> &mut Snapshot {
    &mut self.snapshot
}

pub machine EnginePrivilegedState::set_snapshot(&mut self, snapshot: Snapshot) {
    self.snapshot.clone_from(&snapshot);
}

pub machine EnginePrivilegedState::get_scan_settings(&self) -> ScanSettings {
    self.scan_settings
}

pub machine EnginePrivilegedState::get_scan_settings_ref(&self) -> &ScanSettings {
    &self.scan_settings
}

pub machine EnginePrivilegedState::set_scan_settings(&mut self, scan_settings: ScanSettings) {
    self.scan_settings = scan_settings;
}

pub machine EnginePrivilegedState::get_supplied_memory_source(&self) -> &SuppliedMemorySource {
    &self.supplied_memory_source
}

pub machine EnginePrivilegedState::borrow_supplied_memory_source_mut(&mut self) -> &mut SuppliedMemorySource {
    &mut self.supplied_memory_source
}

pub machine EnginePrivilegedState::get_freeze_list_count(&self) -> u64 {
    self.freeze_list_count
}

// Upstream's `freeze_list_registry.write().clear()` — the freeze-list leg
// replaces this count-only stand-in with the real registry.
pub machine EnginePrivilegedState::clear_freeze_list(&mut self) {
    self.freeze_list_count = 0;
}

// Install the adapter's supplied regions (the CLI's captured target).
pub machine EnginePrivilegedState::set_supplied_memory_source(&mut self, source: SuppliedMemorySource) {
    self.supplied_memory_source.clone_from(&source);
}

// Fixture form for entry contexts that cannot move the aggregate: one
// zeroed `element_count`-wide u64 region at `base_address`, same input as
// `make_fixture_source`. The remaining region rows and element bytes stay
// zero-initialized, which is also what the fixture's scan constraint
// expects.
//
// ENTRY-PLAN DEVIATION: `regions[i]` admits only one member level, so the
// window's `elements.element_count` is unreachable from here and stays 0
// until the toolchain admits deeper paths — the region reports a 0-byte
// extent. Named toolchain gap (see tools/native_probe_resume.md).
pub machine EnginePrivilegedState::set_supplied_memory_fixture(&mut self, base_address: u64, element_count: u64) {
    self.supplied_memory_source.region_count = 1;
    self.supplied_memory_source.regions[0].base_address = base_address;
    self.supplied_memory_source.regions[0].element_stride_bytes = 8;
}
