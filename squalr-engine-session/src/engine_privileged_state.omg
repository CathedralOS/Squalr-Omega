pub machine EnginePrivilegedState::get_freeze_list_count(engine_privileged_state: &EnginePrivilegedState) -> u64 {
    FreezeListRegistry::get_frozen_count(&engine_privileged_state.freeze_list_registry)
}

pub machine EnginePrivilegedState::get_freeze_list_registry(engine_privileged_state: &EnginePrivilegedState) -> &FreezeListRegistry {
    &engine_privileged_state.freeze_list_registry
}

pub machine EnginePrivilegedState::borrow_freeze_list_registry_mut(engine_privileged_state: &mut EnginePrivilegedState) -> &mut FreezeListRegistry {
    &mut engine_privileged_state.freeze_list_registry
}

// Upstream's `freeze_list_registry.write().clear()`.
pub machine EnginePrivilegedState::clear_freeze_list(engine_privileged_state: &mut EnginePrivilegedState) {
    FreezeListRegistry::clear(&mut engine_privileged_state.freeze_list_registry);
}

// Upstream `emit_event` — pushes onto the pending queue instead of the
// bindings channel. The bool is the refusal surface (queue full); upstream
// only logs dispatch errors, so callers may discard it.
pub machine EnginePrivilegedState::emit_event(engine_privileged_state: &mut EnginePrivilegedState, event: &EngineEvent) -> bool {
    PendingEngineEvents::push(&mut engine_privileged_state.pending_engine_events, event)
}

pub machine EnginePrivilegedState::get_pending_event_count(engine_privileged_state: &EnginePrivilegedState) -> u64 {
    PendingEngineEvents::get_count(&engine_privileged_state.pending_engine_events)
}

pub machine EnginePrivilegedState::get_pending_event(engine_privileged_state: &EnginePrivilegedState, position: u64) -> EngineEvent {
    PendingEngineEvents::get(&engine_privileged_state.pending_engine_events, position)
}

// Headless drain: read each pending event then clear — the consumer side
// of upstream's subscriber receive.
pub machine EnginePrivilegedState::drain_pending_events(engine_privileged_state: &mut EnginePrivilegedState) {
    PendingEngineEvents::clear(&mut engine_privileged_state.pending_engine_events);
}

// Install the adapter's supplied regions (the CLI's captured target).
pub machine EnginePrivilegedState::set_supplied_memory_source(engine_privileged_state: &mut EnginePrivilegedState, source: SuppliedMemorySource) {
    SuppliedMemorySource::clone_from(&mut engine_privileged_state.supplied_memory_source, &source);
}

// Fixture form for entry contexts that cannot move the aggregate: one
// zeroed `element_count`-wide u64 region at `base_address`, same input as
// `make_fixture_source`. The element bytes stay zero-initialized, which is
// also what the fixture's scan constraint expects.
pub machine EnginePrivilegedState::set_supplied_memory_fixture(engine_privileged_state: &mut EnginePrivilegedState, base_address: u64, element_count: u64) {
    engine_privileged_state.supplied_memory_source.region_count = 1;
    engine_privileged_state.supplied_memory_source.regions[0].base_address = base_address;
    SuppliedRegion::set_element_count(&mut engine_privileged_state.supplied_memory_source.regions[0], element_count);
    engine_privileged_state.supplied_memory_source.regions[0].element_stride_bytes = 8;
}

// Fixture seed: write one u64 element into the supplied region's element
// window — what `set_supplied_memory_fixture` leaves zero. Flat setter,
// same shape as `set_element_count`.
pub machine EnginePrivilegedState::seed_supplied_element(engine_privileged_state: &mut EnginePrivilegedState, element_index: u64, element_value: u64) {
    SuppliedRegion::set_element(&mut engine_privileged_state.supplied_memory_source.regions[0], element_index, element_value);
}

// Fixture leg for the canary: seeds one whole-region filter collection per
// requested data type — what `element_scan`'s initialize leg produces on a
// first scan over an all-match fixture — so results exist for the
// delete/list exercise while the element-scan request itself stays behind
// the union-construction wall (union values mint no unit plan in entry
// closures). Upstream seeds via `Snapshot::initialize_scan_results` from
// the scan plan's data-type set — same machine, fixture call site.
pub machine EnginePrivilegedState::initialize_scan_results_fixture(engine_privileged_state: &mut EnginePrivilegedState) {
    let mut data_type_refs: DataTypeRefSet = DataTypeRefSet::empty();
    let data_type_ref: DataTypeRef = DataTypeRef::new("u64");
    _ = DataTypeRefSet::push(&mut data_type_refs, &data_type_ref);
    Snapshot::initialize_all_scan_results(&mut engine_privileged_state.snapshot, data_type_refs, MemoryAlignment::Alignment8);
}

// Supplied-snapshot adapter for the tombstone leg: writes one region's
// bounds + element window and marks deleted global result index 3
// directly — the state-machine mutators (`insert`/`count_in_range`)
// mint no result signature as callees in entry closures, so the seeded
// fixture writes the layout the upstream `delete_scan_results` row loop
// leaves behind (8-result region, index 3 tombstoned = address 4120).
pub machine EnginePrivilegedState::seed_scan_snapshot_fixture(engine_privileged_state: &mut EnginePrivilegedState) {
    SnapshotRegion::set_base_address(&mut engine_privileged_state.snapshot.regions[0], 4096);
    SnapshotRegion::set_region_size(&mut engine_privileged_state.snapshot.regions[0], 64);
    SnapshotRegion::set_current_element_count(&mut engine_privileged_state.snapshot.regions[0], 8);
    engine_privileged_state.snapshot.region_count = 1;
}

pub machine EnginePrivilegedState::seed_deleted_index_fixture(engine_privileged_state: &mut EnginePrivilegedState) {
    Snapshot::seed_deleted_scan_result_index(&mut engine_privileged_state.snapshot, 3);
}

// Upstream `allocate_pointer_scan_results_id`: AtomicU64 fetch_add — ids
// start at 1 and never reuse.
pub machine EnginePrivilegedState::allocate_pointer_scan_results_id(engine_privileged_state: &mut EnginePrivilegedState) -> u64 {
    engine_privileged_state.next_pointer_scan_results_id = ((engine_privileged_state.next_pointer_scan_results_id as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    engine_privileged_state.next_pointer_scan_results_id
}

// Upstream `get_pointer_scan_results()` — the store stands in for the
// Arc<RwLock<Option<...>>>; `has_results` plays Option::is_some.
pub machine EnginePrivilegedState::borrow_pointer_scan_results_store(
    engine_privileged_state: &mut EnginePrivilegedState
) -> &mut PointerScanResultsStore {
    &mut engine_privileged_state.pointer_scan_results_store
}

// The fixture module table — upstream `get_modules(&process_info)` reads
// the OS provider for the opened process; the supplied-adapter path
// carries the caller-installed list (EmulatorMemory-equivalent behavior).
pub machine EnginePrivilegedState::get_supplied_modules(engine_privileged_state: &EnginePrivilegedState) -> &[NormalizedModule] {
    transition engine_privileged_state.supplied_module_count <= 8 {
        true -> arm_result_235_0(engine_privileged_state)
        _ -> (&engine_privileged_state.supplied_modules[0..0])
    }
    state arm_result_235_0(engine_privileged_state: &EnginePrivilegedState) -> &[NormalizedModule]
    
    requires engine_privileged_state.supplied_module_count <= 8;
{
        (&engine_privileged_state.supplied_modules[0..engine_privileged_state.supplied_module_count])
    }
}

// Copies the live modules into caller storage — the pointer-scan
// executors need a `modules` slice that can outlive the store's mutable
// arena borrows, which a shared `&self` return cannot do (borrow
// discipline rejects overlapping shared/mutable borrows of the record).
pub machine EnginePrivilegedState::copy_supplied_modules(
    engine_privileged_state: &mut EnginePrivilegedState,
    out_modules: &mut [NormalizedModule; 8]
) -> u64
ensures 0 <= result && result < 9;
{
    transition { _ -> copy(engine_privileged_state, out_modules, 0) }
    state copy(engine_privileged_state: &mut EnginePrivilegedState, out_modules: &mut [NormalizedModule; 8], position: u64) -> u64
    requires position < 9;
    {
        transition position < engine_privileged_state.supplied_module_count && position < 8 {
            true -> store(engine_privileged_state, out_modules, position)
            false -> (position)
            _ -> (position)
        }
    }
    state store(engine_privileged_state: &mut EnginePrivilegedState, out_modules: &mut [NormalizedModule; 8], position: u64) -> u64
    requires 0 <= position && position < 8;
    {
        NormalizedModule::clone_from(&mut out_modules[position], &engine_privileged_state.supplied_modules[position]);
        // `next` is bound + dominated so the `< 9` requires on `copy`
        // discharges verbatim — arithmetic actuals are not normalized.
        let next: u64 = position + 1;
        transition next < 9 {
            true -> copy(engine_privileged_state, out_modules, next)
            _ -> (position)
        }
    }
}

pub machine EnginePrivilegedState::get_supplied_module_count(engine_privileged_state: &EnginePrivilegedState) -> u64 {
    engine_privileged_state.supplied_module_count
}

pub machine EnginePrivilegedState::push_supplied_module(
    engine_privileged_state: &mut EnginePrivilegedState,
    module_name: &[u8],
    base_address: u64,
    module_size: u64
) -> bool {
    transition engine_privileged_state.supplied_module_count < 8 {
        true -> store(engine_privileged_state, module_name, base_address, module_size)
        false -> (false)
    }
    state store(engine_privileged_state: &mut EnginePrivilegedState, module_name: &[u8], base_address: u64, module_size: u64) -> bool {
        let index: u64 = engine_privileged_state.supplied_module_count;
        transition index < 8 {
            true -> apply(engine_privileged_state, module_name, base_address, module_size, index)
            false -> (false)
            _ -> (false)
        }
    }
    state apply(engine_privileged_state: &mut EnginePrivilegedState, module_name: &[u8], base_address: u64, module_size: u64, index: u64) -> bool
    requires 0 <= index && index < 8;
    {
        engine_privileged_state.supplied_modules[index] = NormalizedModule::new(module_name, base_address, module_size);
        engine_privileged_state.supplied_module_count = engine_privileged_state.supplied_module_count + 1;
        true
    }
}

// ── Symbol registry (upstream engine_privileged_state.rs registry surface) ──

// Upstream `registries.get_symbol_registry()` — the session-owned symbol
// + descriptor tables (see the field comment for the Arc<Registries>
// deviation).
pub machine EnginePrivilegedState::get_symbol_registry(engine_privileged_state: &EnginePrivilegedState) -> &SymbolRegistry {
    (&engine_privileged_state.symbol_registry)
}

pub machine EnginePrivilegedState::borrow_symbol_registry_mut(engine_privileged_state: &mut EnginePrivilegedState) -> &mut SymbolRegistry {
    (&mut engine_privileged_state.symbol_registry)
}

// Upstream `get_registry_generation` — the catalog's generation tag.
pub machine EnginePrivilegedState::get_registry_generation(engine_privileged_state: &EnginePrivilegedState) -> u64 {
    (engine_privileged_state.symbol_registry_generation)
}

// Upstream `notify_registry_changed`: bump the generation and emit
// `RegistryChangedEvent` (headless: pushed onto the pending queue —
// upstream's subscriber dispatch is the bindings leg).
pub machine EnginePrivilegedState::notify_registry_changed(engine_privileged_state: &mut EnginePrivilegedState) {
    // Upstream `fetch_add(1, Relaxed)` wraps at the u64 boundary — the
    // generation tag's overflow domain is therefore Wrapping, not exact.
    let next_generation: u64 = ((engine_privileged_state.symbol_registry_generation as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    engine_privileged_state.symbol_registry_generation = next_generation;
    let event: RegistryChangedEvent = RegistryChangedEvent::new(next_generation);
    let engine_event: EngineEvent = RegistryChangedEvent::to_engine_event(&event);
    _ = EnginePrivilegedState::emit_event(engine_privileged_state, &engine_event);
}

// Upstream `get_privileged_registry_catalog`: the registry's sorted
// catalog stamped with the current generation. Upstream additionally
// filters each descriptor through `plugin_registry.is_data_type_enabled`;
// the port has no plugin registry, and upstream answers true for ids no
// plugin owns — so the headless result matches the plugin-free case.
// (Named residual: the plugin-enabled filter joins with the Plugins
// domain.)
pub machine EnginePrivilegedState::get_privileged_registry_catalog(engine_privileged_state: &EnginePrivilegedState) -> PrivilegedRegistryCatalog {
    (SymbolRegistry::create_registry_catalog(&engine_privileged_state.symbol_registry, engine_privileged_state.symbol_registry_generation))
}

// The tail of upstream's `mutate_symbol_registry` — the guard's
// change-then-notify contract (the Mutex itself drops, see the field
// comment): emit only when the mutation landed.
machine EnginePrivilegedState::finish_symbol_registry_mutation(engine_privileged_state: &mut EnginePrivilegedState, did_change: bool) -> bool {
    transition did_change {
        true -> notify(engine_privileged_state)
        _ -> (false)
    }
    state notify(engine_privileged_state: &mut EnginePrivilegedState) -> bool {
        EnginePrivilegedState::notify_registry_changed(engine_privileged_state);
        (true)
    }
}

// Upstream `set_project_symbol_catalog` — install the project-authored
// symbol catalog under the mutation contract.
pub machine EnginePrivilegedState::set_project_symbol_catalog(engine_privileged_state: &mut EnginePrivilegedState, project_symbol_catalog: &ProjectSymbolCatalog) -> bool {
    let did_change: bool = SymbolRegistry::set_project_symbol_catalog(&mut engine_privileged_state.symbol_registry, project_symbol_catalog);
    (EnginePrivilegedState::finish_symbol_registry_mutation(engine_privileged_state, did_change))
}

// Upstream `register_symbol_data_type_descriptor`.
pub machine EnginePrivilegedState::register_symbol_data_type_descriptor(engine_privileged_state: &mut EnginePrivilegedState, data_type_descriptor: &DataTypeDescriptor) -> bool {
    let did_change: bool = SymbolRegistry::register_data_type_descriptor(&mut engine_privileged_state.symbol_registry, data_type_descriptor);
    (EnginePrivilegedState::finish_symbol_registry_mutation(engine_privileged_state, did_change))
}

// Upstream `unregister_symbol_data_type_descriptor`.
pub machine EnginePrivilegedState::unregister_symbol_data_type_descriptor(engine_privileged_state: &mut EnginePrivilegedState, data_type_id: &[u8]) -> bool {
    let did_change: bool = SymbolRegistry::unregister_data_type_descriptor(&mut engine_privileged_state.symbol_registry, data_type_id);
    (EnginePrivilegedState::finish_symbol_registry_mutation(engine_privileged_state, did_change))
}

// Upstream `register_struct_layout_descriptor` — registers the
// descriptor's definition under its layout id.
pub machine EnginePrivilegedState::register_struct_layout_descriptor(engine_privileged_state: &mut EnginePrivilegedState, struct_layout_descriptor: &StructLayoutDescriptor) -> bool {
    let did_change: bool = SymbolRegistry::register_symbolic_struct(&mut engine_privileged_state.symbol_registry, 
        StructLayoutDescriptor::get_struct_layout_id(struct_layout_descriptor),
        StructLayoutDescriptor::get_struct_layout_definition(struct_layout_descriptor));
    (EnginePrivilegedState::finish_symbol_registry_mutation(engine_privileged_state, did_change))
}

// Upstream `unregister_struct_layout_descriptor`.
pub machine EnginePrivilegedState::unregister_struct_layout_descriptor(engine_privileged_state: &mut EnginePrivilegedState, symbolic_struct_id: &[u8]) -> bool {
    let did_change: bool = SymbolRegistry::unregister_symbolic_struct(&mut engine_privileged_state.symbol_registry, symbolic_struct_id);
    (EnginePrivilegedState::finish_symbol_registry_mutation(engine_privileged_state, did_change))
}
