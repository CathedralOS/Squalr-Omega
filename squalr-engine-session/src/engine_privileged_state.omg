// Fixture form for entry contexts that cannot move the aggregate: one
// zeroed `element_count`-wide u64 region at `base_address`, same input as
// `make_fixture_source`. The element bytes stay zero-initialized, which is
// also what the fixture's scan constraint expects.
public machine EnginePrivilegedState::set_supplied_memory_fixture(this: &mut EnginePrivilegedState, base_address: u64, element_count: u64) {
    this.supplied_memory_source.region_count = 1;
    this.supplied_memory_source.regions[0].base_address = base_address;
    |supplied_memory_source|::SuppliedRegion::set_element_count(&mut this.supplied_memory_source.regions[0], element_count);
    this.supplied_memory_source.regions[0].element_stride_bytes = 8;
}

// Fixture seed: write one u64 element into the supplied region's element
// window — what `set_supplied_memory_fixture` leaves zero. Flat setter,
// same shape as `set_element_count`.
public machine EnginePrivilegedState::seed_supplied_element(this: &mut EnginePrivilegedState, element_index: u64, element_value: u64) {
    |supplied_memory_source|::SuppliedRegion::set_element(&mut this.supplied_memory_source.regions[0], element_index, element_value);
}

// Fixture leg for the canary: seeds one whole-region filter collection per
// requested data type — what `element_scan`'s initialize leg produces on a
// first scan over an all-match fixture — so results exist for the
// delete/list exercise while the element-scan request itself stays behind
// the union-construction wall (union values mint no unit plan in entry
// closures). Upstream seeds via `Snapshot::initialize_scan_results` from
// the scan plan's data-type set — same machine, fixture call site.
public machine EnginePrivilegedState::initialize_scan_results_fixture(this: &mut EnginePrivilegedState) {
    let mut data_type_refs: |snapshot_region|::DataTypeRefSet = |snapshot_region|::DataTypeRefSet::empty();
    let data_type_ref: |data_type_ref|::DataTypeRef = |data_type_ref|::DataTypeRef::new("u64");
    _ = |snapshot_region|::DataTypeRefSet::push(&mut data_type_refs, &data_type_ref);
    |snapshot|::Snapshot::initialize_all_scan_results(&mut this.snapshot, data_type_refs, |memory_alignment|::MemoryAlignment::Alignment8);
}

// Supplied-snapshot adapter for the tombstone leg: writes one region's
// bounds + element window and marks deleted global result index 3
// directly — the state-machine mutators (`insert`/`count_in_range`)
// mint no result signature as callees in entry closures, so the seeded
// fixture writes the layout the upstream `delete_scan_results` row loop
// leaves behind (8-result region, index 3 tombstoned = address 4120).
public machine EnginePrivilegedState::seed_scan_snapshot_fixture(this: &mut EnginePrivilegedState) {
    |snapshot_region|::SnapshotRegion::set_base_address(&mut this.snapshot.regions[0], 4096);
    |snapshot_region|::SnapshotRegion::set_region_size(&mut this.snapshot.regions[0], 64);
    |snapshot_region|::SnapshotRegion::set_current_element_count(&mut this.snapshot.regions[0], 8);
    this.snapshot.region_count = 1;
}

public machine EnginePrivilegedState::seed_deleted_index_fixture(this: &mut EnginePrivilegedState) {
    |snapshot|::Snapshot::seed_deleted_scan_result_index(&mut this.snapshot, 3);
}

