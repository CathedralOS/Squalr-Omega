// The fixture module table — upstream `get_modules(&process_info)` reads
// the OS provider for the opened process; the supplied-adapter path
// carries the caller-installed list (EmulatorMemory-equivalent behavior).
public machine EnginePrivilegedState::get_supplied_modules(this: &EnginePrivilegedState) -> &[|normalized_module|::NormalizedModule] {
    transition this.supplied_module_count <= 8 {
        true -> arm_result_235_0(this)
        _ -> (&this.supplied_modules[0..0])
    }
    machine arm_result_235_0(this: &EnginePrivilegedState) -> &[|normalized_module|::NormalizedModule]
    
    requires this.supplied_module_count <= 8;
{
        (&this.supplied_modules[0..this.supplied_module_count])
    }
}

// Copies the live modules into caller storage — the pointer-scan
// executors need a `modules` slice that can outlive the store's mutable
// arena borrows, which a shared `&self` return cannot do (borrow
// discipline rejects overlapping shared/mutable borrows of the record).
public machine EnginePrivilegedState::copy_supplied_modules(
    this: &mut EnginePrivilegedState,
    out_modules: &mut [|normalized_module|::NormalizedModule; 8]
) -> u64
ensures 0 <= result && result < 9;
{
    transition { _ -> copy(this, out_modules, 0) }
    machine copy(this: &mut EnginePrivilegedState, out_modules: &mut [|normalized_module|::NormalizedModule; 8], position: u64) -> u64
    requires position < 9;
    {
        transition position < this.supplied_module_count && position < 8 {
            true -> store(this, out_modules, position)
            false -> (position)
            _ -> (position)
        }
    }
    machine store(this: &mut EnginePrivilegedState, out_modules: &mut [|normalized_module|::NormalizedModule; 8], position: u64) -> u64
    requires 0 <= position && position < 8;
    {
        |normalized_module|::NormalizedModule::clone_from(&mut out_modules[position], &this.supplied_modules[position]);
        // `next` is bound + dominated so the `< 9` requires on `copy`
        // discharges verbatim — arithmetic actuals are not normalized.
        let next: u64 = position + 1;
        transition next < 9 {
            true -> copy(this, out_modules, next)
            _ -> (position)
        }
    }
}

public machine EnginePrivilegedState::get_supplied_module_count(this: &EnginePrivilegedState) -> u64 {
    this.supplied_module_count
}

public machine EnginePrivilegedState::push_supplied_module(
    this: &mut EnginePrivilegedState,
    module_name: &[u8],
    base_address: u64,
    module_size: u64
) -> bool {
    transition this.supplied_module_count < 8 {
        true -> store(this, module_name, base_address, module_size)
        false -> (false)
    }
    machine store(this: &mut EnginePrivilegedState, module_name: &[u8], base_address: u64, module_size: u64) -> bool {
        let index: u64 = this.supplied_module_count;
        transition index < 8 {
            true -> apply(this, module_name, base_address, module_size, index)
            false -> (false)
            _ -> (false)
        }
    }
    machine apply(this: &mut EnginePrivilegedState, module_name: &[u8], base_address: u64, module_size: u64, index: u64) -> bool
    requires 0 <= index && index < 8;
    {
        this.supplied_modules[index] = |normalized_module|::NormalizedModule::new(module_name, base_address, module_size);
        this.supplied_module_count = this.supplied_module_count + 1;
        true
    }
}

