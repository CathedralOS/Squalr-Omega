// Upstream `emit_event` — pushes onto the pending queue instead of the
// bindings channel. The bool is the refusal surface (queue full); upstream
// only logs dispatch errors, so callers may discard it.
pub machine EnginePrivilegedState::emit_event(&mut self, event: &EngineEvent) -> bool {
    self.pending_engine_events.push(event)
}

pub machine EnginePrivilegedState::get_pending_event_count(&self) -> u64 {
    self.pending_engine_events.get_count()
}

pub machine EnginePrivilegedState::get_pending_event(&self, position: u64) -> EngineEvent {
    self.pending_engine_events.get(position)
}

// Headless drain: read each pending event then clear — the consumer side
// of upstream's subscriber receive.
pub machine EnginePrivilegedState::drain_pending_events(&mut self) {
    self.pending_engine_events.clear();
}

// Install the adapter's supplied regions (the CLI's captured target).
pub machine EnginePrivilegedState::set_supplied_memory_source(&mut self, source: SuppliedMemorySource) {
    self.supplied_memory_source.clone_from(&source);
}

// Fixture form for entry contexts that cannot move the aggregate: one
// zeroed `element_count`-wide u64 region at `base_address`, same input as
// `make_fixture_source`. The element bytes stay zero-initialized, which is
// also what the fixture's scan constraint expects.
pub machine EnginePrivilegedState::set_supplied_memory_fixture(&mut self, base_address: u64, element_count: u64) {
    self.supplied_memory_source.region_count = 1;
    self.supplied_memory_source.regions[0].base_address = base_address;
    self.supplied_memory_source.regions[0].set_element_count(element_count);
    self.supplied_memory_source.regions[0].element_stride_bytes = 8;
}

// Fixture seed: write one u64 element into the supplied region's element
// window — what `set_supplied_memory_fixture` leaves zero. Flat setter,
// same shape as `set_element_count`.
pub machine EnginePrivilegedState::seed_supplied_element(&mut self, element_index: u64, element_value: u64) {
    self.supplied_memory_source.regions[0].set_element(element_index, element_value);
}

// Fixture leg for the canary: seeds one whole-region filter collection per
// requested data type — what `element_scan`'s initialize leg produces on a
// first scan over an all-match fixture — so results exist for the
// delete/list exercise while the element-scan request itself stays behind
// the union-construction wall (union values mint no unit plan in entry
// closures). Upstream seeds via `Snapshot::initialize_scan_results` from
// the scan plan's data-type set — same machine, fixture call site.
pub machine EnginePrivilegedState::initialize_scan_results_fixture(&mut self) {
    let mut data_type_refs: DataTypeRefSet = DataTypeRefSet::empty();
    let data_type_ref: DataTypeRef = DataTypeRef::new("u64");
    _ = data_type_refs.push(&data_type_ref);
    self.snapshot.initialize_all_scan_results(data_type_refs, MemoryAlignment::Alignment8);
}

// Supplied-snapshot adapter for the tombstone leg: writes one region's
// bounds + element window and marks deleted global result index 3
// directly — the state-machine mutators (`insert`/`count_in_range`)
// mint no result signature as callees in entry closures, so the seeded
// fixture writes the layout the upstream `delete_scan_results` row loop
// leaves behind (8-result region, index 3 tombstoned = address 4120).
pub machine EnginePrivilegedState::seed_scan_snapshot_fixture(&mut self) {
    self.snapshot.regions[0].set_base_address(4096);
    self.snapshot.regions[0].set_region_size(64);
    self.snapshot.regions[0].set_current_element_count(8);
    self.snapshot.region_count = 1;
}

pub machine EnginePrivilegedState::seed_deleted_index_fixture(&mut self) {
    self.snapshot.seed_deleted_scan_result_index(3);
}

// Upstream `allocate_pointer_scan_results_id`: AtomicU64 fetch_add — ids
// start at 1 and never reuse.
pub machine EnginePrivilegedState::allocate_pointer_scan_results_id(&mut self) -> u64 {
    self.next_pointer_scan_results_id = ((self.next_pointer_scan_results_id as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    self.next_pointer_scan_results_id
}

// Upstream `get_pointer_scan_results()` — the store stands in for the
// Arc<RwLock<Option<...>>>; `has_results` plays Option::is_some.
pub machine EnginePrivilegedState::borrow_pointer_scan_results_store(
    &mut self
) -> &mut PointerScanResultsStore {
    &mut self.pointer_scan_results_store
}

// The fixture module table — upstream `get_modules(&process_info)` reads
// the OS provider for the opened process; the supplied-adapter path
// carries the caller-installed list (EmulatorMemory-equivalent behavior).
pub machine EnginePrivilegedState::get_supplied_modules(&self) -> &[NormalizedModule] {
    transition self.supplied_module_count <= 8 {
        true -> arm_result_235_0()
        _ -> (&self.supplied_modules[0..0])
    }
    state arm_result_235_0(&self) -> &[NormalizedModule]
    
    requires self.supplied_module_count <= 8;
{
        (&self.supplied_modules[0..self.supplied_module_count])
    }
}

// Copies the live modules into caller storage — the pointer-scan
// executors need a `modules` slice that can outlive the store's mutable
// arena borrows, which a shared `&self` return cannot do (borrow
// discipline rejects overlapping shared/mutable borrows of the record).
pub machine EnginePrivilegedState::copy_supplied_modules(
    &mut self,
    out_modules: &mut [NormalizedModule; 8]
) -> u64
ensures 0 <= result && result < 9;
{
    transition { _ -> copy(out_modules, 0) }
    state copy(&mut self, out_modules: &mut [NormalizedModule; 8], position: u64) -> u64
    requires 0 <= position && position < 9;
    {
        transition position < self.supplied_module_count && position < 8 {
            true -> store(out_modules, position)
            false -> (position)
            _ -> (position)
        }
    }
    state store(&mut self, out_modules: &mut [NormalizedModule; 8], position: u64) -> u64
    requires 0 <= position && position < 8;
    {
        out_modules[position].clone_from(&self.supplied_modules[position]);
        transition { _ -> copy(out_modules, position + 1) }
    }
}

pub machine EnginePrivilegedState::get_supplied_module_count(&self) -> u64 {
    self.supplied_module_count
}

pub machine EnginePrivilegedState::push_supplied_module(
    &mut self,
    module_name: &[u8],
    base_address: u64,
    module_size: u64
) -> bool {
    transition self.supplied_module_count < 8 {
        true -> store(module_name, base_address, module_size)
        false -> (false)
    }
    state store(&mut self, module_name: &[u8], base_address: u64, module_size: u64) -> bool {
        let index: u64 = self.supplied_module_count;
        transition index < 8 {
            true -> apply(module_name, base_address, module_size, index)
            false -> (false)
            _ -> (false)
        }
    }
    state apply(&mut self, module_name: &[u8], base_address: u64, module_size: u64, index: u64) -> bool
    requires 0 <= index && index < 8;
    {
        self.supplied_modules[index] = NormalizedModule::new(module_name, base_address, module_size);
        self.supplied_module_count = self.supplied_module_count + 1;
        true
    }
}

// ── Symbol registry (upstream engine_privileged_state.rs registry surface) ──

// Upstream `registries.get_symbol_registry()` — the session-owned symbol
// + descriptor tables (see the field comment for the Arc<Registries>
// deviation).
pub machine EnginePrivilegedState::get_symbol_registry(&self) -> &SymbolRegistry {
    (&self.symbol_registry)
}

pub machine EnginePrivilegedState::borrow_symbol_registry_mut(&mut self) -> &mut SymbolRegistry {
    (&mut self.symbol_registry)
}

// Upstream `get_registry_generation` — the catalog's generation tag.
pub machine EnginePrivilegedState::get_registry_generation(&self) -> u64 {
    (self.symbol_registry_generation)
}

// Upstream `notify_registry_changed`: bump the generation and emit
// `RegistryChangedEvent` (headless: pushed onto the pending queue —
// upstream's subscriber dispatch is the bindings leg).
pub machine EnginePrivilegedState::notify_registry_changed(&mut self) {
    // Upstream `fetch_add(1, Relaxed)` wraps at the u64 boundary — the
    // generation tag's overflow domain is therefore Wrapping, not exact.
    let next_generation: u64 = ((self.symbol_registry_generation as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    self.symbol_registry_generation = next_generation;
    let event: RegistryChangedEvent = RegistryChangedEvent::new(next_generation);
    let engine_event: EngineEvent = event.to_engine_event();
    _ = self.emit_event(&engine_event);
}

// Upstream `get_privileged_registry_catalog`: the registry's sorted
// catalog stamped with the current generation. Upstream additionally
// filters each descriptor through `plugin_registry.is_data_type_enabled`;
// the port has no plugin registry, and upstream answers true for ids no
// plugin owns — so the headless result matches the plugin-free case.
// (Named residual: the plugin-enabled filter joins with the Plugins
// domain.)
pub machine EnginePrivilegedState::get_privileged_registry_catalog(&self) -> PrivilegedRegistryCatalog {
    (self.symbol_registry.create_registry_catalog(self.symbol_registry_generation))
}

// The tail of upstream's `mutate_symbol_registry` — the guard's
// change-then-notify contract (the Mutex itself drops, see the field
// comment): emit only when the mutation landed.
machine EnginePrivilegedState::finish_symbol_registry_mutation(&mut self, did_change: bool) -> bool {
    transition did_change {
        true -> notify()
        _ -> (false)
    }
    state notify(&mut self) -> bool {
        self.notify_registry_changed();
        (true)
    }
}

// Upstream `set_project_symbol_catalog` — install the project-authored
// symbol catalog under the mutation contract.
pub machine EnginePrivilegedState::set_project_symbol_catalog(&mut self, project_symbol_catalog: &ProjectSymbolCatalog) -> bool {
    let did_change: bool = self.symbol_registry.set_project_symbol_catalog(project_symbol_catalog);
    (self.finish_symbol_registry_mutation(did_change))
}

// Upstream `register_symbol_data_type_descriptor`.
pub machine EnginePrivilegedState::register_symbol_data_type_descriptor(&mut self, data_type_descriptor: &DataTypeDescriptor) -> bool {
    let did_change: bool = self.symbol_registry.register_data_type_descriptor(data_type_descriptor);
    (self.finish_symbol_registry_mutation(did_change))
}

// Upstream `unregister_symbol_data_type_descriptor`.
pub machine EnginePrivilegedState::unregister_symbol_data_type_descriptor(&mut self, data_type_id: &[u8]) -> bool {
    let did_change: bool = self.symbol_registry.unregister_data_type_descriptor(data_type_id);
    (self.finish_symbol_registry_mutation(did_change))
}

// Upstream `register_struct_layout_descriptor` — registers the
// descriptor's definition under its layout id.
pub machine EnginePrivilegedState::register_struct_layout_descriptor(&mut self, struct_layout_descriptor: &StructLayoutDescriptor) -> bool {
    let did_change: bool = self.symbol_registry.register_symbolic_struct(
        struct_layout_descriptor.get_struct_layout_id(),
        struct_layout_descriptor.get_struct_layout_definition());
    (self.finish_symbol_registry_mutation(did_change))
}

// Upstream `unregister_struct_layout_descriptor`.
pub machine EnginePrivilegedState::unregister_struct_layout_descriptor(&mut self, symbolic_struct_id: &[u8]) -> bool {
    let did_change: bool = self.symbol_registry.unregister_symbolic_struct(symbolic_struct_id);
    (self.finish_symbol_registry_mutation(did_change))
}
