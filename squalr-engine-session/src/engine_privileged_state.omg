// Upstream `notify_registry_changed`: bump the generation and emit
// `RegistryChangedEvent` (headless: pushed onto the pending queue —
// upstream's subscriber dispatch is the bindings leg).
public machine EnginePrivilegedState::notify_registry_changed(this: &mut EnginePrivilegedState) {
    // Upstream `fetch_add(1, Relaxed)` wraps at the u64 boundary — the
    // generation tag's overflow domain is therefore Wrapping, not exact.
    let next_generation: u64 = ((this.symbol_registry_generation as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    this.symbol_registry_generation = next_generation;
    let event: |registry_changed_event|::RegistryChangedEvent = |registry_changed_event|::RegistryChangedEvent::new(next_generation);
    let engine_event: |engine_event|::EngineEvent = |registry_changed_event|::RegistryChangedEvent::to_engine_event(&event);
    _ = EnginePrivilegedState::emit_event(&mut this, &engine_event);
}

// Upstream `get_privileged_registry_catalog`: the registry's sorted
// catalog stamped with the current generation. Upstream additionally
// filters each descriptor through `plugin_registry.is_data_type_enabled`;
// the port has no plugin registry, and upstream answers true for ids no
// plugin owns — so the headless result matches the plugin-free case.
// (Named residual: the plugin-enabled filter joins with the Plugins
// domain.)
public machine EnginePrivilegedState::get_privileged_registry_catalog(this: &EnginePrivilegedState) -> |privileged_registry_catalog|::PrivilegedRegistryCatalog {
    let hoist1: |privileged_registry_catalog|::PrivilegedRegistryCatalog = |symbol_registry|::SymbolRegistry::create_registry_catalog(&this.symbol_registry, this.symbol_registry_generation);
    (hoist1)
}

// The tail of upstream's `mutate_symbol_registry` — the guard's
// change-then-notify contract (the Mutex itself drops, see the field
// comment): emit only when the mutation landed.
machine EnginePrivilegedState::finish_symbol_registry_mutation(this: &mut EnginePrivilegedState, did_change: bool) -> bool {
    transition did_change {
        true -> notify(this)
        _ -> (false)
    }
    machine notify(this: &mut EnginePrivilegedState) -> bool {
        EnginePrivilegedState::notify_registry_changed(&mut this);
        (true)
    }
}

