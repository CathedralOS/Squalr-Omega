// Port of engine_privileged_state.rs for the headless command leg. Upstream
// holds `Arc<RwLock<...>>` fields behind a singleton; the port keeps the same
// fields as plain values owned by `SqualrEngine` — the synchronous dispatch
// model makes the locks no-ops.
//
// Field parity notes: `freeze_list_registry` carries the real registry now
// that the freeze/set_property executor leg landed — the periodic
// freezer-task thread is the remaining deferred surface (see
// tasks/snapshot_scan_result_freeze_task.omg). `supplied_memory_source` is
// the sanctioned test adapter standing in for the opened process's live
// reader — the CLI leg exercises scans over it because no real target
// exists to attach to.
public data EnginePrivilegedState {
    has_opened_process: bool;
    opened_process: |opened_process_info|::OpenedProcessInfo;
    // Upstream `os_providers` (the session-wide provider registry behind
    // `get_os_providers`). The concrete provider records are ZII-established
    // like upstream's unit-struct `new`, so zero-init is the construction.
    os_providers: |engine_os_provider|::EngineOsProviders;
    // Upstream `task_manager` (sessions/trackable_task_manager.rs): the
    // running-task table upstream keeps beside `process_manager`.
    task_manager: |trackable_task_manager|::TrackableTaskManager;
    snapshot: |snapshot|::Snapshot;
    freeze_list_registry: |freeze_list_registry|::FreezeListRegistry;
    scan_settings: |scan_settings|::ScanSettings;
    // Upstream `GeneralSettingsConfig`/`MemorySettingsConfig` static
    // Arc<RwLock> singletons, mapped to session fields: the headless port
    // has no statics. Upstream mutates them through its JSON store
    // (persistence leg is deferred); the read-lock failure arm on its
    // `get_full_config().read()` is unreachable here by construction.
    general_settings: |general_settings|::GeneralSettings;
    memory_settings: |memory_settings|::MemorySettings;
    supplied_memory_source: |supplied_memory_source|::SuppliedMemorySource;
    // Upstream `Arc<RwLock<Option<PointerScanResults>>>` + the
    // `AtomicU64` session-id allocator, and the fixture-side module table
    // upstream reads through the OS memory-query provider.
    pointer_scan_results_store: |pointer_scan_results_store|::PointerScanResultsStore;
    next_pointer_scan_results_id: u64;
    supplied_modules: [|normalized_module|::NormalizedModule; 8];
    supplied_module_count: u64;
    // Upstream's `engine_bindings` dispatch channel, headless shape:
    // events queue here for consumers to drain (see
    // pending_engine_events.omg for the deviation rationale).
    pending_engine_events: |pending_engine_events|::PendingEngineEvents;
    // Upstream keeps the symbol registry inside `Arc<Registries>`
    // (`registries.get_symbol_registry()`); the port lifts the one
    // registry the session owns onto the record directly. Upstream's
    // `symbol_registry_mutation_guard: Mutex<()>` drops — a session-owned
    // record is already single-writer (the mutation wrappers below carry
    // upstream's change-then-notify contract).
    symbol_registry: |symbol_registry|::SymbolRegistry;
    // Upstream `symbol_registry_generation: AtomicU64` (starts at 1,
    // bumps on every accepted registry mutation).
    symbol_registry_generation: u64;
    // Upstream `PatchService` (the `Mutex<PatchServiceState>` inside maps
    // onto the field itself). `clear_if_process_changed` fires from
    // upstream's ProcessChanged event hook; headless calls it inline at the
    // open/close setters below — the patch table follows the opened process.
    patch_service: |patch_service|::PatchService;
    // Upstream `plugin_registry: PluginRegistry` — the bounded-metadata port
    // (seed table + flags + order + data-type ownership; see
    // src/plugins/plugin_registry.omg for the dropped dyn surfaces).
    plugin_registry: |plugin_registry|::PluginRegistry;
    // Upstream `DebuggerService` — the bounded port carries the
    // cached-session bookkeeping + trace-session store; its dyn plugin
    // backend is the deferred plugin-host surface (see
    // src/debugger/debugger_service.omg). `clear_active_session` fires
    // from upstream's ProcessChanged event hook; headless calls it inline
    // at the open/close setters below, alongside patch_service.
    debugger_service: |debugger_service|::DebuggerService;
}

// Entry-plan variant of `new`: only the non-zero-initialized scalar is
// written (union field stores are unavailable in the entry unit plan; the
// remaining fields' zero cases already match `new`, see the case-order
// notes on Bitness/MemoryReadMode/TargetArchitecture).
public machine EnginePrivilegedState::init(this: &mut EnginePrivilegedState) {
    this.scan_settings.results_page_size = 22;
    this.memory_settings.memory_type_none = true;
    this.memory_settings.memory_type_private = true;
    this.memory_settings.memory_type_image = true;
    this.memory_settings.memory_type_mapped = true;
    this.memory_settings.end_address = 18446744073709551615;
    // Zero-init leaves the registry tables empty — the builtin seed must
    // run to match `new` (upstream `SymbolRegistry::new` seeds them).
    this.symbol_registry = |symbol_registry|::SymbolRegistry::new();
    this.symbol_registry_generation = 1;
    // PatchService::new is plain record init whose non-zero field is the
    // id counter — entry plan can write it directly.
    this.patch_service.next_patch_number = 1;
    this.patch_service.has_process_key = false;
    this.patch_service.patch_count = 0;
    // PluginRegistry::new seeds the 7 builtin packages + the ownership
    // table — mirrors the symbol-registry seed call above.
    this.plugin_registry = |plugin_registry|::PluginRegistry::new();
    // DebuggerService::new's only non-zero field is the trace-id counter.
    this.debugger_service.next_trace_session_number = 1;
}

public machine EnginePrivilegedState::new() -> EnginePrivilegedState {
    EnginePrivilegedState {
        has_opened_process: false,
        opened_process: |opened_process_info|::OpenedProcessInfo::new(0, "", 0, 0, |bitness|::Bitness::Bit64),
        snapshot: |snapshot|::Snapshot::new(),
        freeze_list_registry: |freeze_list_registry|::FreezeListRegistry::new(),
        scan_settings: |scan_settings|::ScanSettings::default(),
        general_settings: |general_settings|::GeneralSettings::default(),
        memory_settings: |memory_settings|::MemorySettings::default(),
        supplied_memory_source: |supplied_memory_source|::SuppliedMemorySource::empty(),
        task_manager: |trackable_task_manager|::TrackableTaskManager::new(),
        pointer_scan_results_store: |pointer_scan_results_store|::PointerScanResultsStore::empty(),
        next_pointer_scan_results_id: 0,
        supplied_module_count: 0,
        pending_engine_events: |pending_engine_events|::PendingEngineEvents::new(),
        symbol_registry: |symbol_registry|::SymbolRegistry::new(),
        symbol_registry_generation: 1,
        patch_service: |patch_service|::PatchService::new(),
        plugin_registry: |plugin_registry|::PluginRegistry::new(),
        debugger_service: |debugger_service|::DebuggerService::new(),
    }
}

public machine EnginePrivilegedState::has_opened_process(this: &EnginePrivilegedState) -> bool {
    this.has_opened_process
}

public machine EnginePrivilegedState::get_opened_process(this: &EnginePrivilegedState) -> |opened_process_info|::OpenedProcessInfo {
    this.opened_process
}

// Test-side open: the adapter's equivalent of `open_process` completing
// successfully. `scan new` requires an opened process upstream.
public machine EnginePrivilegedState::set_opened_process(this: &mut EnginePrivilegedState, opened_process: |opened_process_info|::OpenedProcessInfo) {
    this.opened_process = opened_process;
    this.has_opened_process = true;
    // Upstream's ProcessChanged event → PatchService::clear_if_process_changed.
    |patch_service|::PatchService::clear_if_process_changed(&mut this.patch_service, true,
        |opened_process_info|::OpenedProcessInfo::get_process_id_raw(&this.opened_process) as u64,
        |opened_process_info|::OpenedProcessInfo::get_handle(&this.opened_process));
    // Upstream's ProcessChanged event also reaches the debugger service's
    // clear hook; disjoint field borrows into the event queue.
    |debugger_service|::DebuggerService::clear_active_session(&mut this.debugger_service, &mut this.pending_engine_events);
}

// Fixture form of `set_opened_process` for entry contexts that cannot move
// the aggregate across a call boundary (same constraint as
// `make_fixture_source`). Union and array fields keep their zero-initialized
// values — Bitness leads with Bit64 — so scalar stores alone match
// `OpenedProcessInfo::new(id, "", id, Bit64)`.
public machine EnginePrivilegedState::set_opened_process_fixture(this: &mut EnginePrivilegedState, process_id: u32) {
    this.opened_process.process_id = process_id;
    this.opened_process.handle = process_id as u64;
    this.has_opened_process = true;
    |patch_service|::PatchService::clear_if_process_changed(&mut this.patch_service, true, process_id as u64, process_id as u64);
    |debugger_service|::DebuggerService::clear_active_session(&mut this.debugger_service, &mut this.pending_engine_events);
}

// One zeroed supplied region — the fixture form of `supply_memory` for
// harnesses that cannot move the aggregate across a call boundary.
public machine EnginePrivilegedState::make_fixture_source(
    base_address: u64,
    element_count: u64
) -> |supplied_memory_source|::SuppliedMemorySource {
    |supplied_memory_source|::SuppliedMemorySource::of_region(
        |supplied_memory_source|::SuppliedRegion::of_window(
            base_address, |element_window|::ElementWindow::of_length(element_count), 8))
}

public machine EnginePrivilegedState::clear_opened_process(this: &mut EnginePrivilegedState) {
    this.has_opened_process = false;
    |patch_service|::PatchService::clear_if_process_changed(&mut this.patch_service, false, 0, 0);
    |debugger_service|::DebuggerService::clear_active_session(&mut this.debugger_service, &mut this.pending_engine_events);
}

