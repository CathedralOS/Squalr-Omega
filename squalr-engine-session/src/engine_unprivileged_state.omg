// Upstream `get_icon_id` — descriptor icon or empty.
pub machine EngineUnprivilegedState::get_icon_id(
    this: &EngineUnprivilegedState,
    data_type_ref: &DataTypeRef,
    out_icon_id: &mut [u8; 256],
