) -> AnonymousValueStringFormat {
    let hoist40: AnonymousValueStringFormat = PrivilegedRegistryCache::get_supported_anonymous_value_string_format(&this.privileged_registry_cache, DataTypeRef::get_data_type_id(&data_type_ref), position)ef), position);
    (hoist40)
