pub machine EngineUnprivilegedState::get_privileged_registry_catalog(
    this: &EngineUnprivilegedState,
    out_catalog: &mut PrivilegedRegistryCatalog
) -> bool {
    let hoist1: bool = PrivilegedRegistryCache::get_has_registry_catalog(&this.privileged_registry_cache);
    transition hoist1 {
        true -> copy(this, out_catalog)
        false -> (false)
        _ -> (false)
    }
    state copy(this: &EngineUnprivilegedState, out_catalog: &mut PrivilegedRegistryCatalog) -> bool {
        PrivilegedRegistryCatalog::clone_from(&mut out_catalog, PrivilegedRegistryCache::get_registry_catalog(&this.privileged_registry_cache))rivileged_registry_cache));
        (true)
    }
}

// Upstream `get_registered_data_type_refs` — count + indexed accessor pairs
// (bounded, no Vec). Position indexes the merged catalog-first view.
pub machine EngineUnprivilegedState::get_registered_data_type_ref_count(this: &EngineUnprivilegedState) -> u64 {
    let hoist36: u64 = PrivilegedRegistryCache::get_registered_data_type_descriptor_count(&this.privileged_registry_cache);
    (hoist36)
}

pub machine EngineUnprivilegedState::get_registered_data_type_ref_at(
    this: &EngineUnprivilegedState,
    position: u64,
    out_data_type_ref: &mut DataTypeRef
) -> bool {
    transition position < 128 {
        true -> probe(this, position, out_data_type_ref)
        false -> (false)
        _ -> (false)
    }
    state probe(this: &EngineUnprivilegedState, position: u64, out_data_type_ref: &mut DataTypeRef) -> bool
        requires position < 128;
    {
        let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
        let hoist2: bool = PrivilegedRegistryCache::get_registered_data_type_descriptor_at(&this.privileged_registry_cache, position, &mut descriptor);
        transition hoist2 {
            true -> fill(this, position, &descriptor, out_data_type_ref)
            false -> (false)
        }
    }
    state fill(this: &EngineUnprivilegedState, position: u64, descriptor: &DataTypeDescriptor, out_data_type_ref: &mut DataTypeRef) -> bool {
        DataTypeRef::set_data_type_id(&mut out_data_type_ref, DataTypeDescriptor::get_data_type_id(descriptor));
        (true)
    }
}

