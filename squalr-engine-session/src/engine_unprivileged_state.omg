// Upstream `resolve_supported_anonymous_value_string_format`: preferred when
// empty-or-supported, else the default when supported, else the first
// supported, else preferred.
pub machine EngineUnprivilegedState::resolve_supported_anonymous_value_string_format(
    this: &EngineUnprivilegedState,
    data_type_ref: &DataTypeRef,
    preferred_format: AnonymousValueStringFormat
) -> AnonymousValueStringFormat {
    let count: u64 = EngineUnprivilegedState::get_supported_anonymous_value_string_format_count(&this, data_type_ref);
    transition count == 0 {
        true -> (preferred_format)
        false -> contains_preferred(this, data_type_ref, preferred_format, count, 0)
        _ -> (preferred_format)
    }
    state contains_preferred(this: &EngineUnprivilegedState,
        data_type_ref: &DataTypeRef,
        preferred_format: AnonymousValueStringFormat,
        count: u64,
        position: u64
    ) -> AnonymousValueStringFormat

    {
        transition position < count && position < 8 {
            true -> compare_at(this, data_type_ref, preferred_format, count, position)
            false -> fallback(this, data_type_ref, preferred_format, count)
        }
    }
    state compare_at(this: &EngineUnprivilegedState,
        data_type_ref: &DataTypeRef,
        preferred_format: AnonymousValueStringFormat,
        count: u64,
        position: u64
    ) -> AnonymousValueStringFormat
        requires position < count && position < 8;
    {
        let format: AnonymousValueStringFormat = EngineUnprivilegedState::get_supported_anonymous_value_string_format_at(&this, data_type_ref, position);
        let hoist4: u64 = AnonymousValueStringFormat::get_tag(&preferred_format);
        let hoist3: u64 = AnonymousValueStringFormat::get_tag(&format);
        transition hoist3 == hoist4 {
            true -> (preferred_format)
            false -> contains_preferred(this, data_type_ref, preferred_format, count, position + 1)
        }
    }
    state fallback(this: &EngineUnprivilegedState,
        data_type_ref: &DataTypeRef,
        preferred_format: AnonymousValueStringFormat,
        count: u64
    ) -> AnonymousValueStringFormat {
        let default_format: AnonymousValueStringFormat = EngineUnprivilegedState::get_default_anonymous_value_string_format(&this, data_type_ref);
        transition { _ -> contains_default(this, data_type_ref, preferred_format, default_format, count, 0) }
    }
    state contains_default(this: &EngineUnprivilegedState,
        data_type_ref: &DataTypeRef,
        preferred_format: AnonymousValueStringFormat,
        default_format: AnonymousValueStringFormat,
        count: u64,
        position: u64
    ) -> AnonymousValueStringFormat

    {
        transition position < count && position < 8 {
            true -> compare_default_at(this, data_type_ref, preferred_format, default_format, count, position)
            false -> first_or_preferred(this, data_type_ref, preferred_format, count)
        }
    }
    state compare_default_at(this: &EngineUnprivilegedState,
        data_type_ref: &DataTypeRef,
        preferred_format: AnonymousValueStringFormat,
        default_format: AnonymousValueStringFormat,
        count: u64,
        position: u64
    ) -> AnonymousValueStringFormat
        requires position < count && position < 8;
    {
        let format: AnonymousValueStringFormat = EngineUnprivilegedState::get_supported_anonymous_value_string_format_at(&this, data_type_ref, position);
        let hoist6: u64 = AnonymousValueStringFormat::get_tag(&default_format);
        let hoist5: u64 = AnonymousValueStringFormat::get_tag(&format);
        transition hoist5 == hoist6 {
            true -> (default_format)
            false -> contains_default(this, data_type_ref, preferred_format, default_format, count, position + 1)
        }
    }
    state first_or_preferred(this: &EngineUnprivilegedState,
        data_type_ref: &DataTypeRef,
        preferred_format: AnonymousValueStringFormat,
        count: u64
    ) -> AnonymousValueStringFormat {
        let hoist29: AnonymousValueStringFormat = EngineUnprivilegedState::get_supported_anonymous_value_string_format_at(&this, data_type_ref, 0);
        transition count > 0 {
            true -> (hoist29)
            false -> (preferred_format)
        }
    }
}

// Upstream `normalize_anonymous_value_string_format` — rewrites the
// string's format to the resolved supported one; false when already right.
pub machine EngineUnprivilegedState::normalize_anonymous_value_string_format(
    this: &EngineUnprivilegedState,
    data_type_ref: &DataTypeRef,
    anonymous_value_string: &mut AnonymousValueString
) -> bool {
    let current_format: AnonymousValueStringFormat = AnonymousValueString::get_anonymous_value_string_format(&anonymous_value_string);
    let resolved_format: AnonymousValueStringFormat = EngineUnprivilegedState::resolve_supported_anonymous_value_string_format(&this, data_type_ref,
        current_format);
    let hoist8: u64 = AnonymousValueStringFormat::get_tag(&current_format);
    let hoist7: u64 = AnonymousValueStringFormat::get_tag(&resolved_format);
    transition hoist7 == hoist8 {
        true -> (false)
        false -> apply(this, anonymous_value_string, resolved_format)
        _ -> (false)
    }
    state apply(this: &EngineUnprivilegedState, anonymous_value_string: &mut AnonymousValueString, resolved_format: AnonymousValueStringFormat) -> bool {
        AnonymousValueString::set_anonymous_value_string_format(&mut anonymous_value_string, resolved_format);
        (true)
    }
}

// Upstream `validate_value_string` — the dyn data-type impl validates the
// text. The port routes through the numeric deanonymizer (the constraint
// builder's documented convention for the absent per-type impls): a string
// that deanonymizes for this type validates.
pub machine EngineUnprivilegedState::validate_value_string(
    this: &EngineUnprivilegedState,
    data_type_ref: &DataTypeRef,
    anonymous_value_string: &AnonymousValueString
) -> bool {
    let hoist9: bool = PrivilegedRegistryCache::is_registered_data_type_ref(&this.privileged_registry_cache, data_type_ref);
    transition hoist9 {
        true -> probe(this, data_type_ref, anonymous_value_string)
        false -> (false)
        _ -> (false)
    }
    state probe(this: &EngineUnprivilegedState, data_type_ref: &DataTypeRef, anonymous_value_string: &AnonymousValueString) -> bool {
        let mut out_bytes: [u8; 4096];
        let parser: PrimitiveDataTypeNumeric = PrimitiveDataTypeNumeric {};
        let big_endian: bool = DataTypeRef::is_big_endian(&data_type_ref);
        let unit_size: u64 = DataTypeRef::get_unit_size_in_bytes(&data_type_ref);
        let signed: bool = DataTypeRef::is_signed(&data_type_ref);
        let result: DeanonymizeResult = PrimitiveDataTypeNumeric::deanonymize(&parser, anonymous_value_string,
            big_endian,
            unit_size,
            signed,
            &mut out_bytes);
        transition result {
            DeanonymizeResult::Bytes { count } -> (count > 0)
            _ -> (false)
        }
    }
}

// Upstream `validate_scan_constraint` — builds a constraint; success means
// the build yields a constraint.
pub machine EngineUnprivilegedState::validate_scan_constraint(
    this: &EngineUnprivilegedState,
    data_type_ref: &DataTypeRef,
    scan_compare_type: ScanCompareType,
    anonymous_value_string: &AnonymousValueString
) -> bool {
    let builder: ScanConstraintBuilder = ScanConstraintBuilder::new(FloatingPointTolerance::default());
    let anonymous_scan_constraint: AnonymousScanConstraint = AnonymousScanConstraint::new(
        scan_compare_type,
        AnonymousValueString::clone(anonymous_value_string));
    let build: ScanConstraintBuild = ScanConstraintBuilder::build(&builder, &anonymous_scan_constraint, data_type_ref);
    transition build {
        ScanConstraintBuild::Built { value } -> (true)
        ScanConstraintBuild::BuiltPattern { value } -> (true)
        _ -> (false)
    }
}

pub machine EngineUnprivilegedState::validate_scan_constraint_with_hex_pattern_matching(
    this: &EngineUnprivilegedState,
    data_type_ref: &DataTypeRef,
    scan_compare_type: ScanCompareType,
    anonymous_value_string: &AnonymousValueString,
    use_hex_pattern_matching: bool
) -> bool {
    let builder: ScanConstraintBuilder = ScanConstraintBuilder::new(FloatingPointTolerance::default());
    let anonymous_scan_constraint: AnonymousScanConstraint = AnonymousScanConstraint::new(
        scan_compare_type,
        AnonymousValueString::clone(anonymous_value_string));
    let matched_constraint: AnonymousScanConstraint = AnonymousScanConstraint::with_hex_pattern_matching(
        &anonymous_scan_constraint,
        use_hex_pattern_matching);
    let build: ScanConstraintBuild = ScanConstraintBuilder::build(&builder, &matched_constraint, data_type_ref);
    transition build {
        ScanConstraintBuild::Built { value } -> (true)
        ScanConstraintBuild::BuiltPattern { value } -> (true)
        _ -> (false)
    }
}

// Upstream `deanonymize_value_string` — numeric-route port (see
// `validate_value_string` for the convention); non-deanonymizing inputs and
// unregistered types land on `NotRegistered`.
pub machine EngineUnprivilegedState::deanonymize_value_string(
    this: &EngineUnprivilegedState,
    data_type_ref: &DataTypeRef,
    anonymous_value_string: &AnonymousValueString,
    out_operation: &[u8; 64],
    out_operation_len: &mut u64
) -> DeanonymizeValueOutcome {
    out_operation_len = 0;
    let hoist10: bool = PrivilegedRegistryCache::is_registered_data_type_ref(&this.privileged_registry_cache, data_type_ref);
    transition hoist10 {
        true -> parse(this, data_type_ref, anonymous_value_string)
        false -> refuse(this, data_type_ref)
        _ -> refuse(this, data_type_ref)
    }
    state parse(this: &EngineUnprivilegedState, data_type_ref: &DataTypeRef, anonymous_value_string: &AnonymousValueString) -> DeanonymizeValueOutcome {
        let mut out_bytes: [u8; 4096];
        let parser: PrimitiveDataTypeNumeric = PrimitiveDataTypeNumeric {};
        let big_endian: bool = DataTypeRef::is_big_endian(&data_type_ref);
        let unit_size: u64 = DataTypeRef::get_unit_size_in_bytes(&data_type_ref);
        let signed: bool = DataTypeRef::is_signed(&data_type_ref);
        let result: DeanonymizeResult = PrimitiveDataTypeNumeric::deanonymize(&parser, anonymous_value_string,
            big_endian,
            unit_size,
            signed,
            &mut out_bytes);
        transition result {
            DeanonymizeResult::Bytes { count } -> wrap_gate(this, data_type_ref, &out_bytes, count)
            _ -> refuse(this, data_type_ref)
        }
    }
    state wrap_gate(this: &EngineUnprivilegedState, data_type_ref: &DataTypeRef, out_bytes: &[u8; 4096], count: u64) -> DeanonymizeValueOutcome {
        // An over-long producer payload cannot happen upstream (the buffer is
        // the type ceiling); refusing keeps the bound honest at the slice.
        transition count <= 4096 {
            true -> wrap(this, data_type_ref, &out_bytes, count)
            _ -> refuse(this, data_type_ref)
        }
    }
    state wrap(this: &EngineUnprivilegedState, data_type_ref: &DataTypeRef, out_bytes: &[u8; 4096], count: u64) -> DeanonymizeValueOutcome
        requires count <= 4096;
    {
        let data_value: DataValue = DataTypeRef::new(data_type_ref, &out_bytes[0..count]);
        (DeanonymizeValueOutcome::Value { data_value: data_value })
    }
    state refuse(this: &EngineUnprivilegedState, data_type_ref: &DataTypeRef) -> DeanonymizeValueOutcome {
        let mut data_type_id: [u8; 128];
        let data_type_id_len: u64 = copy_bounded(DataTypeRef::get_data_type_id(&data_type_ref), &mut data_type_id);
        let mut operation: [u8; 64];
        let operation_len: u64 = copy_bounded("deanonymize_value", &mut operation);
        (DeanonymizeValueOutcome::NotRegistered {
            operation: operation,
            operation_len: operation_len,
            data_type_id: data_type_id,
            data_type_id_len: data_type_id_len
        })
    }
}

// Upstream `anonymize_value` — numeric-route port.
pub machine EngineUnprivilegedState::anonymize_value(
    this: &EngineUnprivilegedState,
    data_value: &DataValue,
    anonymous_value_string_format: AnonymousValueStringFormat
) -> AnonymizeValueOutcome {
    let data_type_ref: DataTypeRef = DataValue::get_data_type_ref(&data_value);
    let hoist11: bool = PrivilegedRegistryCache::is_registered_data_type_ref(&this.privileged_registry_cache, &data_type_ref);
    transition hoist11 {
        true -> render(this, &data_type_ref, data_value, anonymous_value_string_format)
        false -> refuse(this, &data_type_ref)
        _ -> refuse(this, &data_type_ref)
    }
    state render(this: &EngineUnprivilegedState,
        data_type_ref: &DataTypeRef,
        data_value: &DataValue,
        anonymous_value_string_format: AnonymousValueStringFormat
    ) -> AnonymizeValueOutcome {
        let mut out_text: [u8; 4096];
        let parser: PrimitiveDataTypeNumeric = PrimitiveDataTypeNumeric {};
        let value_bytes: &[u8] = DataValue::get_value_bytes(&data_value);
        let unit_size: u64 = DataTypeRef::get_unit_size_in_bytes(&data_type_ref);
        let signed: bool = DataTypeRef::is_signed(&data_type_ref);
        let big_endian: bool = DataTypeRef::is_big_endian(&data_type_ref);
        let result: AnonymizeResult = PrimitiveDataTypeNumeric::anonymize(&parser, value_bytes,
            unit_size,
            signed,
            big_endian,
            anonymous_value_string_format,
            &mut out_text);
        transition result {
            AnonymizeResult::Text { value } -> (AnonymizeValueOutcome::Value { anonymous_value_string: value })
            _ -> refuse(this, data_type_ref)
        }
    }
    state refuse(this: &EngineUnprivilegedState, data_type_ref: &DataTypeRef) -> AnonymizeValueOutcome {
        let mut data_type_id: [u8; 128];
        let data_type_id_len: u64 = copy_bounded(DataTypeRef::get_data_type_id(&data_type_ref), &mut data_type_id);
        let mut operation: [u8; 64];
        let operation_len: u64 = copy_bounded("anonymize_value", &mut operation);
        (AnonymizeValueOutcome::NotRegistered {
            operation: operation,
            operation_len: operation_len,
            data_type_id: data_type_id,
            data_type_id_len: data_type_id_len
        })
    }
}

// Upstream `anonymize_value_to_supported_formats` — renders the value in
// every supported format; bounded [8].
pub machine EngineUnprivilegedState::anonymize_value_to_supported_formats(
    this: &EngineUnprivilegedState,
    data_value: &DataValue,
    out_values: &mut [AnonymousValueString; 8]
) -> u64 {
    let data_type_ref: DataTypeRef = DataValue::get_data_type_ref(&data_value);
    let count: u64 = EngineUnprivilegedState::get_supported_anonymous_value_string_format_count(&this, &data_type_ref);
    transition { _ -> walk(this, &data_type_ref, data_value, out_values, count, 0, 0) }
    state walk(this: &EngineUnprivilegedState,
        data_type_ref: &DataTypeRef,
        data_value: &DataValue,
        out_values: &mut [AnonymousValueString; 8],
        count: u64,
        position: u64,
        accepted: u64
    ) -> u64
    {
        transition position < count && position < 8 && accepted < 8 {
            true -> render_at(this, data_type_ref, data_value, out_values, count, position, accepted)
            false -> (accepted)
        }
    }
    state render_at(this: &EngineUnprivilegedState,
        data_type_ref: &DataTypeRef,
        data_value: &DataValue,
        out_values: &mut [AnonymousValueString; 8],
        count: u64,
        position: u64,
        accepted: u64
    ) -> u64
        requires position < count && position < 8 && accepted < 8;
    {
        let format: AnonymousValueStringFormat = EngineUnprivilegedState::get_supported_anonymous_value_string_format_at(&this, data_type_ref, position);
        let mut out_text: [u8; 4096];
        let parser: PrimitiveDataTypeNumeric = PrimitiveDataTypeNumeric {};
        let value_bytes: &[u8] = DataValue::get_value_bytes(&data_value);
        let unit_size: u64 = DataTypeRef::get_unit_size_in_bytes(&data_type_ref);
        let signed: bool = DataTypeRef::is_signed(&data_type_ref);
        let big_endian: bool = DataTypeRef::is_big_endian(&data_type_ref);
        let result: AnonymizeResult = PrimitiveDataTypeNumeric::anonymize(&parser, value_bytes,
            unit_size,
            signed,
            big_endian,
            format,
            &mut out_text);
        transition result {
            AnonymizeResult::Text { value } -> store(this, data_type_ref, data_value, out_values, value, count, position, accepted)
            _ -> skip(this, data_type_ref, data_value, out_values, count, position, accepted)
        }
    }
    state store(this: &EngineUnprivilegedState,
        data_type_ref: &DataTypeRef,
        data_value: &DataValue,
        out_values: &mut [AnonymousValueString; 8],
        anonymous_value_string: &AnonymousValueString,
        count: u64,
        position: u64,
        accepted: u64
    ) -> u64
        requires position < count && position < 8 && accepted < 8;
    {
        out_values[accepted] = AnonymousValueString::clone(anonymous_value_string);
        let next_accepted: u64 = accepted + 1;
        let next_position: u64 = position + 1;
        transition { _ -> walk(this, data_type_ref, data_value, out_values, count, next_position, next_accepted) }
    }
    state skip(this: &EngineUnprivilegedState,
        data_type_ref: &DataTypeRef,
        data_value: &DataValue,
        out_values: &mut [AnonymousValueString; 8],
        count: u64,
        position: u64,
        accepted: u64
    ) -> u64
        requires position < count && position < 8 && accepted < 8;
    {
        let next_position: u64 = position + 1;
        transition { _ -> walk(this, data_type_ref, data_value, out_values, count, next_position, accepted) }
    }
}

// Upstream `supports_scalar_integer_values` — dyn type impl; the port's
// honest reduction is the descriptor's signedness (floating-point types and
// unregistered ids report false, matching upstream's `is_some_and` shape
// for the dominant numeric family).
pub machine EngineUnprivilegedState::supports_scalar_integer_values(
    this: &EngineUnprivilegedState,
    data_type_ref: &DataTypeRef
) -> bool {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
    let hoist12: bool = PrivilegedRegistryCache::find_data_type_descriptor(&this.privileged_registry_cache, DataTypeRef::get_data_type_id(&data_type_ref), &mut descriptor);
    transition hoist12 {
        true -> check(this, &descriptor)
        false -> (false)
        _ -> (false)
    }
    state check(this: &EngineUnprivilegedState, descriptor: &DataTypeDescriptor) -> bool {
        (DataTypeDescriptor::get_is_signed(&descriptor) && !DataTypeDescriptor::get_is_floating_point(&descriptor))
    }
}

// Upstream `read_scalar_integer_value` — dyn per-type reader reduced to the
// numeric deanonymize of the rendered bytes is not what upstream does
// (upstream reads the DataValue's stored bytes directly). The port reads
// the stored value bytes little-endian into u64 magnitude + sign — the
// i128 read's honest reduction, documented.
pub machine EngineUnprivilegedState::read_scalar_integer_value(
    this: &EngineUnprivilegedState,
    data_value: &DataValue
) -> ScalarIntegerReadOutcome {
    let data_type_ref: DataTypeRef = DataValue::get_data_type_ref(&data_value);
    let hoist13: bool = PrivilegedRegistryCache::is_registered_data_type_ref(&this.privileged_registry_cache, &data_type_ref);
    transition hoist13 {
        true -> read(this, &data_type_ref, data_value)
        false -> refuse(this, &data_type_ref)
        _ -> refuse(this, &data_type_ref)
    }
    state read(this: &EngineUnprivilegedState, data_type_ref: &DataTypeRef, data_value: &DataValue) -> ScalarIntegerReadOutcome {
        let hoist15: u64 = DataTypeRef::get_unit_size_in_bytes(&data_type_ref);
        let hoist14: u64 = DataTypeRef::get_unit_size_in_bytes(&data_type_ref);
        transition hoist14 >= 1 && hoist15 <= 8 {
            true -> assemble(this, data_type_ref, data_value)
            false -> (ScalarIntegerReadOutcome::Absent)
        }
    }
    state assemble(this: &EngineUnprivilegedState, data_type_ref: &DataTypeRef, data_value: &DataValue) -> ScalarIntegerReadOutcome {
        let mut value: u64 = 0;
        let mut position: u64 = 0;
        let size: u64 = DataTypeRef::get_unit_size_in_bytes(&data_type_ref);
        let hoist16: bool = DataTypeRef::is_big_endian(&data_type_ref);
        transition hoist16 {
            true -> be(this, data_value, size, 0, value)
            false -> le(this, data_value, size, 0, value)
        }
    }
    state le(this: &EngineUnprivilegedState, data_value: &DataValue, size: u64, position: u64, value: u64) -> ScalarIntegerReadOutcome

    {
        let bytes: &[u8] = DataValue::get_value_bytes(&data_value);
        transition position < size && position < bytes.len && position < 8 {
            true -> le_byte(this, data_value, bytes, size, position, value)
            false -> finish_le(this, data_value, size, value)
        }
    }
    state le_byte(this: &EngineUnprivilegedState, data_value: &DataValue, bytes: &[u8], size: u64, position: u64, value: u64) -> ScalarIntegerReadOutcome
        requires position < bytes.len && position < size && position < 8;
    {
        let byte_value: u64 = bytes[position] as u64;
        let shift: u64 = position * 8;
        let next_value: u64 = value | (byte_value << shift);
        let next_position: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> le(this, data_value, size, next_position, next_value) }
    }
    state be(this: &EngineUnprivilegedState, data_value: &DataValue, size: u64, position: u64, value: u64) -> ScalarIntegerReadOutcome

    {
        let bytes: &[u8] = DataValue::get_value_bytes(&data_value);
        transition position < size && position < bytes.len && position < 8 {
            true -> be_byte(this, data_value, bytes, size, position, value)
            false -> finish_be(this, data_value, size, value)
        }
    }
    state be_byte(this: &EngineUnprivilegedState, data_value: &DataValue, bytes: &[u8], size: u64, position: u64, value: u64) -> ScalarIntegerReadOutcome
        requires position < bytes.len && position < size && position < 8;
    {
        let byte_value: u64 = bytes[position] as u64;
        let next_value: u64 = (((value as u64 in Wrapping) << 8) | (byte_value as u64 in Wrapping)) as u64;
        let next_position: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> be(this, data_value, size, next_position, next_value) }
    }
    state finish_le(this: &EngineUnprivilegedState, data_value: &DataValue, size: u64, value: u64) -> ScalarIntegerReadOutcome {
        // Sign-extend when the type is signed and the top bit is set.
        let sign_bit: u64 = 128;
        let hoist17: bool = is_signed(DataValue::get_data_type_ref(&data_value));
        transition hoist17 && size > 0 && size < 8
            && (value >> ((size * 8) - 1)) & 1 == 1 {
            true -> negative(this, value, size)
            false -> positive(this, value, size)
            _ -> positive(this, value, size)
        }
    }
    state finish_be(this: &EngineUnprivilegedState, data_value: &DataValue, size: u64, value: u64) -> ScalarIntegerReadOutcome {
        let hoist18: bool = is_signed(DataValue::get_data_type_ref(&data_value));
        transition hoist18 && size > 0 && size < 8
            && (value >> ((size * 8) - 1)) & 1 == 1 {
            true -> negative(this, value, size)
            false -> positive(this, value, size)
            _ -> positive(this, value, size)
        }
    }
    state negative(this: &EngineUnprivilegedState, value: u64, size: u64) -> ScalarIntegerReadOutcome {
        // Two's-complement magnitude for the stored width — wrapping negate.
        let magnitude: u64 = ((0 as u64 in Wrapping) - (value as u64 in Wrapping)) as u64;
        (ScalarIntegerReadOutcome::Value { magnitude: magnitude, negative: true })
    }
    state positive(this: &EngineUnprivilegedState, value: u64, size: u64) -> ScalarIntegerReadOutcome {
        (ScalarIntegerReadOutcome::Value { magnitude: value, negative: false })
    }
    state refuse(this: &EngineUnprivilegedState, data_type_ref: &DataTypeRef) -> ScalarIntegerReadOutcome {
        let mut data_type_id: [u8; 128];
        let data_type_id_len: u64 = copy_bounded(DataTypeRef::get_data_type_id(&data_type_ref), &mut data_type_id);
        let mut operation: [u8; 64];
        let operation_len: u64 = copy_bounded("read_scalar_integer_value", &mut operation);
        (ScalarIntegerReadOutcome::NotRegistered {
            operation: operation,
            operation_len: operation_len,
            data_type_id: data_type_id,
            data_type_id_len: data_type_id_len
        })
    }
}

pub machine EngineUnprivilegedState::get_unit_size_in_bytes(
    this: &EngineUnprivilegedState,
    data_type_ref: &DataTypeRef
) -> u64 {
    let hoist41: u64 = PrivilegedRegistryCache::get_unit_size_in_bytes(&this.privileged_registry_cache, DataTypeRef::get_data_type_id(&data_type_ref))ata_type_ref));
    (hoist41)
}

pub machine EngineUnprivilegedState::get_data_type_descriptor(
    this: &EngineUnprivilegedState,
    data_type_ref: &DataTypeRef,
