// ==== Virtual snapshots ====

// Upstream `set_virtual_snapshot_queries` — find-or-create the snapshot,
// then store the interval and query set.
pub machine EngineUnprivilegedState::set_virtual_snapshot_queries(
    this: &mut EngineUnprivilegedState,
    virtual_snapshot_id: &[u8],
    refresh_interval_millis: u64,
    queries: &[VirtualSnapshotQuery; 16],
    query_count: u64
) -> bool {
    transition { _ -> find(this, virtual_snapshot_id, refresh_interval_millis, queries, query_count, 0) }
    state find(
        this: &mut EngineUnprivilegedState,
        virtual_snapshot_id: &[u8],
        refresh_interval_millis: u64,
        queries: &[VirtualSnapshotQuery; 16],
        query_count: u64,
        position: u64
    ) -> bool

    {
        transition position < this.virtual_snapshot_count && position < 8 {
            true -> compare(this, virtual_snapshot_id, refresh_interval_millis, queries, query_count, position)
            false -> insert(this, virtual_snapshot_id, refresh_interval_millis, queries, query_count)
        }
    }
    state compare(
        this: &mut EngineUnprivilegedState,
        virtual_snapshot_id: &[u8],
        refresh_interval_millis: u64,
        queries: &[VirtualSnapshotQuery; 16],
        query_count: u64,
        position: u64
    ) -> bool
        requires position < this.virtual_snapshot_count && position < 8;
    {
        let hoist22: bool = key_equals(&this.virtual_snapshot_keys[position], this.virtual_snapshot_key_lens[position], virtual_snapshot_id);
        transition hoist22 {
            true -> store(this, position, refresh_interval_millis, queries, query_count)
            false -> find(this, virtual_snapshot_id, refresh_interval_millis, queries, query_count, position + 1)
        }
    }
    state store(
        this: &mut EngineUnprivilegedState,
        position: u64,
        refresh_interval_millis: u64,
        queries: &[VirtualSnapshotQuery; 16],
        query_count: u64
    ) -> bool
        requires position < 8;
    {
        VirtualSnapshot::set_refresh_interval(&mut this.virtual_snapshot_values[position], refresh_interval_millis);
        _ = snapshot_set_queries(&mut this.virtual_snapshot_values[position], queries, query_count);
        (true)
    }
    state insert(
        this: &mut EngineUnprivilegedState,
        virtual_snapshot_id: &[u8],
        refresh_interval_millis: u64,
        queries: &[VirtualSnapshotQuery; 16],
        query_count: u64
    ) -> bool {
        transition this.virtual_snapshot_count < 8 {
            true -> write(this, virtual_snapshot_id, refresh_interval_millis, queries, query_count)
            false -> (false)
        }
    }
    state write(
        this: &mut EngineUnprivilegedState,
        virtual_snapshot_id: &[u8],
        refresh_interval_millis: u64,
        queries: &[VirtualSnapshotQuery; 16],
        query_count: u64
    ) -> bool
        requires this.virtual_snapshot_count < 8;
    {
        let slot: u64 = this.virtual_snapshot_count;
        let written: u64 = copy_key64(virtual_snapshot_id, &mut this.virtual_snapshot_keys[slot]);
        this.virtual_snapshot_key_lens[slot] = written;
        this.virtual_snapshot_values[slot] = VirtualSnapshot::new(refresh_interval_millis);
        _ = snapshot_set_queries(&mut this.virtual_snapshot_values[slot], queries, query_count);
        this.virtual_snapshot_count = this.virtual_snapshot_count + 1;
        (true)
    }
}

// Upstream `get_virtual_snapshot` — clones the snapshot out.
pub machine EngineUnprivilegedState::get_virtual_snapshot(
    this: &EngineUnprivilegedState,
    virtual_snapshot_id: &[u8],
    out_snapshot: &mut VirtualSnapshot
) -> bool {
    transition { _ -> find(this, virtual_snapshot_id, out_snapshot, 0) }
    state find(this: &EngineUnprivilegedState, virtual_snapshot_id: &[u8], out_snapshot: &mut VirtualSnapshot, position: u64) -> bool

    {
        transition position < this.virtual_snapshot_count && position < 8 {
            true -> compare(this, virtual_snapshot_id, out_snapshot, position)
            false -> (false)
        }
    }
    state compare(this: &EngineUnprivilegedState, virtual_snapshot_id: &[u8], out_snapshot: &mut VirtualSnapshot, position: u64) -> bool
        requires position < this.virtual_snapshot_count && position < 8;
    {
        let hoist23: bool = key_equals(&this.virtual_snapshot_keys[position], this.virtual_snapshot_key_lens[position], virtual_snapshot_id);
        transition hoist23 {
            true -> copy(this, position, out_snapshot)
            false -> find(this, virtual_snapshot_id, out_snapshot, position + 1)
        }
    }
    state copy(this: &EngineUnprivilegedState, position: u64, out_snapshot: &mut VirtualSnapshot) -> bool
        requires position < 8;
    {
        VirtualSnapshot::copy_from(&mut out_snapshot, &this.virtual_snapshot_values[position]);
        (true)
    }
}

// Upstream `request_virtual_snapshot_refresh` — `force=false`.
pub machine EngineUnprivilegedState::request_virtual_snapshot_refresh(
    this: &mut EngineUnprivilegedState,
    virtual_snapshot_id: &[u8],
    now_millis: u64,
    out_materializer: &mut VirtualSnapshotMaterializer,
    out_refresh_query_version: &mut u64
) -> bool {
    let hoist32: bool = EngineUnprivilegedState::request_virtual_snapshot_refresh_with_mode(&mut this, virtual_snapshot_id, now_millis, false, out_materializer, out_refresh_query_version);
    (hoist32)
}

// Upstream `force_virtual_snapshot_refresh` — `force=true`.
pub machine EngineUnprivilegedState::force_virtual_snapshot_refresh(
    this: &mut EngineUnprivilegedState,
    virtual_snapshot_id: &[u8],
    now_millis: u64,
    out_materializer: &mut VirtualSnapshotMaterializer,
    out_refresh_query_version: &mut u64
) -> bool {
    let hoist33: bool = EngineUnprivilegedState::request_virtual_snapshot_refresh_with_mode(&mut this, virtual_snapshot_id, now_millis, true, out_materializer, out_refresh_query_version);
    (hoist33)
}

// Upstream `request_virtual_snapshot_refresh_with_mode` — decides and marks
// the refresh in the snapshot under the caller's clock, then hands a
// prepared materializer back; the caller pumps it and feeds the results to
// `finish_virtual_snapshot_refresh` (the spawned thread's apply path).
pub machine EngineUnprivilegedState::request_virtual_snapshot_refresh_with_mode(
    this: &mut EngineUnprivilegedState,
    virtual_snapshot_id: &[u8],
    now_millis: u64,
    force_refresh: bool,
    out_materializer: &mut VirtualSnapshotMaterializer,
    out_refresh_query_version: &mut u64
) -> bool {
    transition { _ -> find(this, virtual_snapshot_id, now_millis, force_refresh, out_materializer, out_refresh_query_version, 0) }
    state find(
        this: &mut EngineUnprivilegedState,
        virtual_snapshot_id: &[u8],
        now_millis: u64,
        force_refresh: bool,
        out_materializer: &mut VirtualSnapshotMaterializer,
        out_refresh_query_version: &mut u64,
        position: u64
    ) -> bool

    {
        transition position < this.virtual_snapshot_count && position < 8 {
            true -> compare(this, virtual_snapshot_id, now_millis, force_refresh, out_materializer, out_refresh_query_version, position)
            false -> (false)
        }
    }
    state compare(
        this: &mut EngineUnprivilegedState,
        virtual_snapshot_id: &[u8],
        now_millis: u64,
        force_refresh: bool,
        out_materializer: &mut VirtualSnapshotMaterializer,
        out_refresh_query_version: &mut u64,
        position: u64
    ) -> bool
        requires position < this.virtual_snapshot_count && position < 8;
    {
        let hoist24: bool = key_equals(&this.virtual_snapshot_keys[position], this.virtual_snapshot_key_lens[position], virtual_snapshot_id);
        transition hoist24 {
            true -> decide(this, position, now_millis, force_refresh, out_materializer, out_refresh_query_version)
            false -> find(this, virtual_snapshot_id, now_millis, force_refresh, out_materializer, out_refresh_query_version, position + 1)
        }
    }
    state decide(
        this: &mut EngineUnprivilegedState,
        position: u64,
        now_millis: u64,
        force_refresh: bool,
        out_materializer: &mut VirtualSnapshotMaterializer,
        out_refresh_query_version: &mut u64
    ) -> bool
        requires position < 8;
    {
        transition force_refresh {
            true -> force(this, position, now_millis, out_materializer, out_refresh_query_version)
            false -> decide_should(this, position, now_millis, out_materializer, out_refresh_query_version)
        }
    }
    state force(
        this: &mut EngineUnprivilegedState,
        position: u64,
        now_millis: u64,
        out_materializer: &mut VirtualSnapshotMaterializer,
        out_refresh_query_version: &mut u64
    ) -> bool
        requires position < 8;
    {
        VirtualSnapshot::mark_dirty(&mut this.virtual_snapshot_values[position]);
        let hoist25: bool = VirtualSnapshot::can_force_refresh(&this.virtual_snapshot_values[position]);
        transition hoist25 {
            true -> start(this, position, now_millis, out_materializer, out_refresh_query_version)
            false -> (false)
        }
    }
    state decide_should(
        this: &mut EngineUnprivilegedState,
        position: u64,
        now_millis: u64,
        out_materializer: &mut VirtualSnapshotMaterializer,
        out_refresh_query_version: &mut u64
    ) -> bool
        requires position < 8;
    {
        let hoist26: bool = VirtualSnapshot::should_refresh(&this.virtual_snapshot_values[position], now_millis);
        transition hoist26 {
            true -> start(this, position, now_millis, out_materializer, out_refresh_query_version)
            false -> (false)
        }
    }
    state start(
        this: &mut EngineUnprivilegedState,
        position: u64,
        now_millis: u64,
        out_materializer: &mut VirtualSnapshotMaterializer,
        out_refresh_query_version: &mut u64
    ) -> bool
        requires position < 8;
    {
        out_refresh_query_version = VirtualSnapshot::mark_refresh_started(&mut this.virtual_snapshot_values[position], now_millis);
        _ = VirtualSnapshotMaterializer::begin(&mut out_materializer, &this.virtual_snapshot_values[position]);
        (true)
    }
}

// Upstream's spawned-thread tail — applies the materializer's results under
// the version taken at `start` (a newer `set_queries` drops the stale
// results exactly as upstream's `apply_refresh_results` version check).
pub machine EngineUnprivilegedState::finish_virtual_snapshot_refresh(
    this: &mut EngineUnprivilegedState,
    virtual_snapshot_id: &[u8],
    refresh_query_version: u64,
    materializer: &VirtualSnapshotMaterializer,
    now_millis: u64
) -> bool {
    transition { _ -> find(this, virtual_snapshot_id, refresh_query_version, materializer, now_millis, 0) }
    state find(
        this: &mut EngineUnprivilegedState,
        virtual_snapshot_id: &[u8],
        refresh_query_version: u64,
        materializer: &VirtualSnapshotMaterializer,
        now_millis: u64,
        position: u64
    ) -> bool

    {
        transition position < this.virtual_snapshot_count && position < 8 {
            true -> compare(this, virtual_snapshot_id, refresh_query_version, materializer, now_millis, position)
            false -> (false)
        }
    }
    state compare(
        this: &mut EngineUnprivilegedState,
        virtual_snapshot_id: &[u8],
        refresh_query_version: u64,
        materializer: &VirtualSnapshotMaterializer,
        now_millis: u64,
        position: u64
    ) -> bool
        requires position < this.virtual_snapshot_count && position < 8;
    {
        let hoist27: bool = key_equals(&this.virtual_snapshot_keys[position], this.virtual_snapshot_key_lens[position], virtual_snapshot_id);
        transition hoist27 {
            true -> apply(this, position, refresh_query_version, materializer, now_millis)
            false -> find(this, virtual_snapshot_id, refresh_query_version, materializer, now_millis, position + 1)
        }
    }
    state apply(
        this: &mut EngineUnprivilegedState,
        position: u64,
        refresh_query_version: u64,
        materializer: &VirtualSnapshotMaterializer,
        now_millis: u64
    ) -> bool
        requires position < 8;
    {
        let mut result_ids: [[u8; 128]; 16];
        let mut result_id_lens: [u64; 16];
        let mut query_results: [VirtualSnapshotQueryResult; 16];
        let count: u64 = VirtualSnapshotMaterializer::get_result_count(&materializer);
        _ = copy_result_ids(VirtualSnapshotMaterializer::get_result_ids(&materializer), VirtualSnapshotMaterializer::get_result_id_lens(&materializer), &mut result_ids, &mut result_id_lens);
        _ = copy_results(VirtualSnapshotMaterializer::get_results(&materializer), &mut query_results);
        _ = snapshot_apply_refresh_results(
            &mut this.virtual_snapshot_values[position],
            refresh_query_version,
            &result_ids,
            &result_id_lens,
            &query_results,
            count,
            now_millis);
        (true)
    }
}

// ==== Event listeners ====

// Upstream `listen_for_engine_event<E>` — the typed registration collapses
// to the leaf-interest mask (each leaf event type owns one bit; see
// `engine_event_interest_mask` in event_subscriber_table.omg).
pub machine EngineUnprivilegedState::subscribe_engine_events(
    this: &mut EngineUnprivilegedState,
    interest_mask: u64
) -> u64 {
    let hoist44: u64 = EventSubscriberTable::subscribe(&mut this.event_subscribers, interest_mask);
    (hoist44)
}

// Upstream's TypeId-keyed dispatch — the subscriber drains its queue.
pub machine EngineUnprivilegedState::get_subscriber_event_count(
    this: &EngineUnprivilegedState,
    subscriber_index: u64
) -> u64 {
    let hoist45: u64 = EventSubscriberTable::get_queued_event_count(&this.event_subscribers, subscriber_index);
    (hoist45)
}

pub machine EngineUnprivilegedState::get_subscriber_event(
    this: &EngineUnprivilegedState,
    subscriber_index: u64,
    position: u64,
    out_event: &mut EngineEvent
) -> bool {
    let queued_event: EngineEvent = EventSubscriberTable::get_queued_event(&this.event_subscribers, subscriber_index, position);
    EngineEvent::clone_from(&mut out_event, &queued_event);
    (true)
}

pub machine EngineUnprivilegedState::clear_subscriber_events(
    this: &mut EngineUnprivilegedState,
    subscriber_index: u64
) {
    EventSubscriberTable::clear_queued_events(&mut this.event_subscribers, subscriber_index);
}

// ==== Middleware + listener registration ====

// Upstream `register_command_invocation_middleware` — the callback becomes
// a kind tag; `run_invocation_middleware` interprets kinds.
pub machine EngineUnprivilegedState::register_command_invocation_middleware(
    this: &mut EngineUnprivilegedState,
    middleware_kind: u64
) -> bool {
    transition this.invocation_middleware_count < 16 {
        true -> store(this, middleware_kind)
        false -> (false)
        _ -> (false)
    }
    state store(this: &mut EngineUnprivilegedState, middleware_kind: u64) -> bool {
        this.invocation_middleware_kinds[this.invocation_middleware_count] = middleware_kind;
        this.invocation_middleware_count = this.invocation_middleware_count + 1;
        (true)
    }
}

pub machine EngineUnprivilegedState::register_command_response_middleware(
    this: &mut EngineUnprivilegedState,
    middleware_kind: u64
) -> bool {
    transition this.response_middleware_count < 16 {
        true -> store(this, middleware_kind)
        false -> (false)
        _ -> (false)
    }
    state store(this: &mut EngineUnprivilegedState, middleware_kind: u64) -> bool {
        this.response_middleware_kinds[this.response_middleware_count] = middleware_kind;
        this.response_middleware_count = this.response_middleware_count + 1;
        (true)
    }
}

pub machine EngineUnprivilegedState::listen_for_command_response(
    this: &mut EngineUnprivilegedState,
    listener_kind: u64
) -> bool {
    transition this.response_listener_count < 16 {
        true -> store(this, listener_kind)
        false -> (false)
        _ -> (false)
    }
    state store(this: &mut EngineUnprivilegedState, listener_kind: u64) -> bool {
        this.response_listener_kinds[this.response_listener_count] = listener_kind;
        this.response_listener_count = this.response_listener_count + 1;
        (true)
    }
}

// ==== Command invocation pipeline ====

// Upstream `create_command_invocation` — the `fetch_add(1) + 1` allocator.
pub machine EngineUnprivilegedState::create_command_invocation(
    this: &mut EngineUnprivilegedState,
    source: CommandInvocationSource,
    command: EngineCommand
) -> CommandInvocation {
    let invocation_id: u64 = ((this.next_command_invocation_id as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    this.next_command_invocation_id = invocation_id;
    CommandInvocation::new(invocation_id, source, command)
}

// Upstream `prepare_command_invocation` — runs the middleware table over
// the invocation. `ReplaceCommand` rebuilds through the consuming builder
// (upstream `invocation.replace_command(command)`); `Reject`/`Respond`
// short-circuit exactly as upstream's early returns. Values flow by-value
// through the walk — there is no union clone machinery.
pub machine EngineUnprivilegedState::prepare_command_invocation(
    this: &mut EngineUnprivilegedState,
    command_invocation: CommandInvocation
) -> CommandDispatchPlan {
    transition { _ -> walk(this, command_invocation, 0) }
    state walk(this: &mut EngineUnprivilegedState, command_invocation: CommandInvocation, position: u64) -> CommandDispatchPlan

    {
        transition position < this.invocation_middleware_count && position < 16 {
            true -> run_at(this, command_invocation, position)
            false -> (CommandDispatchPlan::Dispatch { invocation: command_invocation })
        }
    }
    state run_at(this: &mut EngineUnprivilegedState, command_invocation: CommandInvocation, position: u64) -> CommandDispatchPlan
        requires position < this.invocation_middleware_count && position < 16;
    {
        let middleware_kind: u64 = this.invocation_middleware_kinds[position];
        let plan: CommandDispatchPlan = EngineUnprivilegedState::run_invocation_middleware(&this, middleware_kind, command_invocation);
        transition plan {
            CommandDispatchPlan::Dispatch { invocation } -> next(this, invocation, position)
            CommandDispatchPlan::Respond { invocation, response } -> (plan)
            CommandDispatchPlan::Reject { invocation, reason, reason_len } -> (plan)
            _ -> (plan)
        }
    }
    state next(this: &mut EngineUnprivilegedState, command_invocation: CommandInvocation, position: u64) -> CommandDispatchPlan
        requires position < this.invocation_middleware_count && position < 16;
    {
        let next_position: u64 = position + 1;
        transition { _ -> walk(this, command_invocation, next_position) }
    }
}

// Kind-tag invocation-middleware dispatch — receives the invocation by
// value and returns the plan it implies. The recorded kinds are the ported
// consumer hooks; until a consumer leg registers a concrete kind, every
// kind continues like upstream middleware returning `Continue`.
pub machine EngineUnprivilegedState::run_invocation_middleware(
    this: &EngineUnprivilegedState,
    middleware_kind: u64,
    command_invocation: CommandInvocation
) -> CommandDispatchPlan {
    (CommandDispatchPlan::Dispatch { invocation: command_invocation })
}

// Upstream `publish_command_response` — response middleware may replace or
// suppress; listeners observe the accepted outcome before it reaches the
// caller's callback. `ResponseMiddlewareStep` is the port-local carrier
// replacing upstream's middleware union inside the walk (the api's
// `CommandResponseDecision` stays the wire shape for concrete kinds).
pub data ResponseMiddlewareStep {
    case Continue(response: EngineCommandResponse);
    case Suppressed(reason: [u8; 256], reason_len: u64);
}

pub machine EngineUnprivilegedState::publish_command_response(
    this: &mut EngineUnprivilegedState,
    command_invocation: &CommandInvocation,
    response: EngineCommandResponse
) -> CommandPublicationResult {
    transition { _ -> walk_middleware(this, command_invocation, response, 0) }
    state walk_middleware(
        this: &mut EngineUnprivilegedState,
        command_invocation: &CommandInvocation,
        response: EngineCommandResponse,
        position: u64
    ) -> CommandPublicationResult

    {
        transition position < this.response_middleware_count && position < 16 {
            true -> run_at(this, command_invocation, response, position)
            false -> deliver(this, command_invocation, response)
        }
    }
    state deliver(
        this: &mut EngineUnprivilegedState,
        command_invocation: &CommandInvocation,
        response: EngineCommandResponse
    ) -> CommandPublicationResult {
        // Upstream runs response listeners over the accepted outcome before
        // returning it — observers see (&invocation, &response).
        EngineUnprivilegedState::run_response_listeners(&mut this, command_invocation, &response);
        (CommandPublicationResult::Delivered { response: response })
    }
    state run_at(
        this: &mut EngineUnprivilegedState,
        command_invocation: &CommandInvocation,
        response: EngineCommandResponse,
        position: u64
    ) -> CommandPublicationResult
        requires position < this.response_middleware_count && position < 16;
    {
        let middleware_kind: u64 = this.response_middleware_kinds[position];
        let step: ResponseMiddlewareStep = EngineUnprivilegedState::run_response_middleware(&this, middleware_kind, command_invocation, response);
        transition step {
            ResponseMiddlewareStep::Continue { response } -> next_middleware(this, command_invocation, response, position)
            ResponseMiddlewareStep::Suppressed { reason, reason_len } -> suppress(this, reason, reason_len, response)
            _ -> suppress_empty(this)
        }
    }
    state next_middleware(
        this: &mut EngineUnprivilegedState,
        command_invocation: &CommandInvocation,
        response: EngineCommandResponse,
        position: u64
    ) -> CommandPublicationResult
        requires position < this.response_middleware_count && position < 16;
    {
        let next_position: u64 = position + 1;
        transition { _ -> walk_middleware(this, command_invocation, response, next_position) }
    }
    state suppress(this: &mut EngineUnprivilegedState, reason: [u8; 256], reason_len: u64, response: EngineCommandResponse) -> CommandPublicationResult {
        let hoist48: LogRecordedEvent = LogRecordedEvent::clone(&record);
        // Upstream logs a warn on suppression before returning None.
        let mut record: LogRecordedEvent = LogRecordedEvent::default();
        _ = LogDispatcher::log(&mut this.log_dispatcher, LogLevel::Warn, "squalr::unprivileged", "command response suppressed", &mut record);
        let engine_event: EngineEvent = EngineEvent::Logging {
            event: LoggingEvent::LogRecorded { log_recorded_event: hoist48 },
        };
        EventSubscriberTable::route_engine_event(&mut this.event_subscribers, &engine_event);
        (CommandPublicationResult::Suppressed { reason: reason, reason_len: reason_len })
    }
    state suppress_empty(this: &mut EngineUnprivilegedState) -> CommandPublicationResult {
        let mut reason: [u8; 256];
        _ = zero_reason(&mut reason);
        (CommandPublicationResult::Suppressed { reason: reason, reason_len: 0 })
    }
}

// Kind-tag response-middleware dispatch — sees the invocation + response by
// ref, hands the (possibly replaced) response back by value. No concrete
// kinds yet: everything continues, same as upstream middleware returning
// `Continue`.
pub machine EngineUnprivilegedState::run_response_middleware(
    this: &EngineUnprivilegedState,
    middleware_kind: u64,
    command_invocation: &CommandInvocation,
    response: EngineCommandResponse
) -> ResponseMiddlewareStep {
    (ResponseMiddlewareStep::Continue { response: response })
}

// Upstream's listener fan-out — kind-tagged listeners observe refs; the
// walk is a no-op until consumer kinds register, matching an empty
// `command_response_listeners` table.
pub machine EngineUnprivilegedState::run_response_listeners(
    this: &mut EngineUnprivilegedState,
    command_invocation: &CommandInvocation,
    response: &EngineCommandResponse
) {
    transition { _ -> walk(this, command_invocation, response, 0) }
    state walk(this: &mut EngineUnprivilegedState, command_invocation: &CommandInvocation, response: &EngineCommandResponse, position: u64)

    {
        transition position < this.response_listener_count && position < 16 {
            true -> run_at(this, command_invocation, response, position)
            false -> done(this)
        }
    }
    state run_at(this: &mut EngineUnprivilegedState, command_invocation: &CommandInvocation, response: &EngineCommandResponse, position: u64)
        requires position < this.response_listener_count && position < 16;
    {
        EngineUnprivilegedState::run_response_listener(&mut this, this.response_listener_kinds[position], command_invocation, response);
        let next_position: u64 = position + 1;
        transition { _ -> walk(this, command_invocation, response, next_position) }
    }
    state done(this: &mut EngineUnprivilegedState) {
    }
}

// Kind-dispatch for one listener — observer semantics (unit). Concrete
// kinds land with the consumers that register them; kind 0 and unhandled
// kinds are the upstream "no listeners registered" case.
pub machine EngineUnprivilegedState::run_response_listener(
    this: &mut EngineUnprivilegedState,
    listener_kind: u64,
    command_invocation: &CommandInvocation,
    response: &EngineCommandResponse
) {
}

// Upstream `log::warn!("Command invocation {} rejected before dispatch:
// {}", ...)` — the reason text is the middleware's own bounded message.
pub machine EngineUnprivilegedState::log_rejected_invocation(
    this: &mut EngineUnprivilegedState,
    command_invocation: &CommandInvocation,
    reason: [u8; 256],
    reason_len: u64
) {
    transition reason_len <= 256 {
        true -> write(this, command_invocation, reason, reason_len)
        _ -> write_empty(this, command_invocation)
    }
    state write(this: &mut EngineUnprivilegedState, command_invocation: &CommandInvocation, reason: [u8; 256], reason_len: u64)
        requires reason_len <= 256;
    {
        let hoist49: LogRecordedEvent = LogRecordedEvent::clone(&record);
        let reason_slice: &[u8] = reason[0..reason_len];
        let mut record: LogRecordedEvent = LogRecordedEvent::default();
        _ = LogDispatcher::log(&mut this.log_dispatcher, LogLevel::Warn, "squalr::unprivileged", reason_slice, &mut record);
        let engine_event: EngineEvent = EngineEvent::Logging {
            event: LoggingEvent::LogRecorded { log_recorded_event: hoist49 },
        };
        EventSubscriberTable::route_engine_event(&mut this.event_subscribers, &engine_event);
    }
    state write_empty(this: &mut EngineUnprivilegedState, command_invocation: &CommandInvocation) {
        let hoist50: LogRecordedEvent = LogRecordedEvent::clone(&record);
        let mut record: LogRecordedEvent = LogRecordedEvent::default();
        _ = LogDispatcher::log(&mut this.log_dispatcher, LogLevel::Warn, "squalr::unprivileged", "command invocation rejected before dispatch", &mut record);
        let engine_event: EngineEvent = EngineEvent::Logging {
            event: LoggingEvent::LogRecorded { log_recorded_event: hoist50 },
        };
        EventSubscriberTable::route_engine_event(&mut this.event_subscribers, &engine_event);
    }
}

// Upstream `log::error!("... produced a mismatched synthetic response")` —
// a Respond plan whose response is not the dispatched arm's type.
pub machine EngineUnprivilegedState::log_mismatched_invocation_response(
    this: &mut EngineUnprivilegedState,
    command_invocation: &CommandInvocation
) {
    let hoist51: LogRecordedEvent = LogRecordedEvent::clone(&record);
    let mut record: LogRecordedEvent = LogRecordedEvent::default();
    _ = LogDispatcher::log(&mut this.log_dispatcher, LogLevel::Error, "squalr::unprivileged", "command invocation produced a mismatched synthetic response", &mut record);
    let engine_event: EngineEvent = EngineEvent::Logging {
        event: LoggingEvent::LogRecorded { log_recorded_event: hoist51 },
    };
    EventSubscriberTable::route_engine_event(&mut this.event_subscribers, &engine_event);
}

// ==== Event routing ====
// ==== Event routing ====

// Upstream `route_engine_event` — the dispatcher-thread body, pumped
// synchronously: a stale catalog logs an error (upstream logs the failure
// and still dispatches), then the event broadcasts to subscribers. The
// Logging arm also lands in the log history — upstream's `log!` macro
// routed it back through the dispatcher's own log4rs appender.
pub machine EngineUnprivilegedState::route_engine_event(
    this: &mut EngineUnprivilegedState,
    engine_event_envelope: &EngineEventEnvelope
) -> bool {
    let expected_generation: u64 = EngineEventEnvelope::get_registry_generation(&engine_event_envelope);
    let catalog_current: bool = !EngineUnprivilegedState::get_needs_privileged_registry_refresh(&this, expected_generation);
    transition catalog_current {
        true -> dispatch(this, engine_event_envelope)
        false -> log_stale(this, engine_event_envelope)
    }
    state log_stale(this: &mut EngineUnprivilegedState, engine_event_envelope: &EngineEventEnvelope) -> bool {
        let hoist52: LogRecordedEvent = LogRecordedEvent::clone(&record);
        let mut record: LogRecordedEvent = LogRecordedEvent::default();
        _ = LogDispatcher::log(&mut this.log_dispatcher, LogLevel::Error, "squalr::unprivileged", "failed to refresh privileged registry cache before dispatching engine event", &mut record);
        let engine_event: EngineEvent = EngineEvent::Logging {
            event: LoggingEvent::LogRecorded { log_recorded_event: hoist52 },
        };
        EventSubscriberTable::route_engine_event(&mut this.event_subscribers, &engine_event);
        transition { _ -> dispatch(this, engine_event_envelope) }
    }
    state dispatch(this: &mut EngineUnprivilegedState, engine_event_envelope: &EngineEventEnvelope) -> bool {
        let engine_event: &EngineEvent = EngineEventEnvelope::get_engine_event(&engine_event_envelope);
        _ = EventSubscriberTable::route_engine_event(&mut this.event_subscribers, engine_event);
        transition engine_event {
            EngineEvent::Logging { event } -> log(this, event)
            _ -> (true)
        }
    }
    state log(this: &mut EngineUnprivilegedState, event: &LoggingEvent) -> bool {
        transition event {
            LoggingEvent::LogRecorded { log_recorded_event } -> record(this, log_recorded_event)
            _ -> (true)
        }
    }
    state record(this: &mut EngineUnprivilegedState, event: &LogRecordedEvent) -> bool {
        _ = LogDispatcher::append_record(&mut this.log_dispatcher, event);
        (true)
    }
}

// Upstream `install_project_event_emitter` — the emitter is not stored (no
// closures); the project notify paths thread `&mut self.event_subscribers`
// directly at every call site, which the project_manager wrappers below
// encode.
pub machine EngineUnprivilegedState::notify_project_items_changed(this: &mut EngineUnprivilegedState) {
    ProjectManager::notify_project_items_changed(&mut this.project_manager, &mut this.event_subscribers);
}

pub machine EngineUnprivilegedState::notify_project_created(this: &mut EngineUnprivilegedState, project_info: &ProjectInfo) {
    ProjectManager::notify_project_created(&mut this.project_manager, project_info, &mut this.event_subscribers);
}

pub machine EngineUnprivilegedState::notify_project_deleted(this: &mut EngineUnprivilegedState, project_info: &ProjectInfo) {
    ProjectManager::notify_project_deleted(&mut this.project_manager, project_info, &mut this.event_subscribers);
}

pub machine EngineUnprivilegedState::notify_project_closed(this: &mut EngineUnprivilegedState) {
    ProjectManager::notify_project_closed(&mut this.project_manager, &mut this.event_subscribers);
}

pub machine EngineUnprivilegedState::watch_projects_root(this: &mut EngineUnprivilegedState, root_path: &[u8]) {
    ProjectManager::watch_projects_root(&mut this.project_manager, root_path);
}

// Upstream `watch_opened_project` passes the opened project's directory
// path (empty + false when no project is open).
pub machine EngineUnprivilegedState::watch_opened_project(this: &mut EngineUnprivilegedState, project_path: &[u8], has_project_path: bool) {
    ProjectManager::watch_opened_project(&mut this.project_manager, project_path, has_project_path);
}

pub machine EngineUnprivilegedState::set_project_file_system_watch_enabled(this: &mut EngineUnprivilegedState, enabled: bool) {
    ProjectManager::set_project_file_system_watch_enabled(&mut this.project_manager, enabled);
}

// ==== Privileged registry sync (caller-pumped) ====

// Upstream `ensure_privileged_registry_catalog_current`'s staleness check —
// the synchronous fetch+wait collapses to a predicate the composition root
// drives: dispatch a RegistryGetMetadataRequest, then
// `apply_privileged_registry_catalog` on the response.
pub machine EngineUnprivilegedState::get_needs_privileged_registry_refresh(
    this: &EngineUnprivilegedState,
    expected_generation: u64
) -> bool {
    (PrivilegedRegistryCache::get_generation(&this.privileged_registry_cache) < expected_generation)
}

pub machine EngineUnprivilegedState::apply_privileged_registry_catalog(
    this: &mut EngineUnprivilegedState,
    privileged_registry_catalog: &PrivilegedRegistryCatalog
) {
    PrivilegedRegistryCache::apply_registry_catalog(&mut this.privileged_registry_cache, privileged_registry_catalog);
}

// ==== Free helpers ====

// Bounded byte copy for [u8;128] destinations (data_type_id payloads).
machine copy_bounded(source: &[u8], destination: &mut [u8; 128]) -> u64 {
    transition { _ -> walk(source, destination, 0) }
    state walk(source: &[u8], destination: &mut [u8; 128], position: u64) -> u64

    {
        transition position < source.len && position < 128 {
            true -> step(source, destination, position)
            false -> (position)
        }
    }
    state step(source: &[u8], destination: &mut [u8; 128], position: u64) -> u64
        requires position < source.len && position < 128;
    {
        destination[position] = source[position];
        let next_position: u64 = position + 1;
        transition { _ -> walk(source, destination, next_position) }
    }
}

// Bounded byte copy for [u8;256] destinations (icon ids).
machine copy_icon_bytes(source: &[u8], destination: &mut [u8; 256]) -> u64 {
    transition { _ -> walk(source, destination, 0) }
    state walk(source: &[u8], destination: &mut [u8; 256], position: u64) -> u64

    {
        transition position < source.len && position < 256 {
            true -> step(source, destination, position)
            false -> (position)
        }
    }
    state step(source: &[u8], destination: &mut [u8; 256], position: u64) -> u64
        requires position < source.len && position < 256;
    {
        destination[position] = source[position];
        let next_position: u64 = position + 1;
        transition { _ -> walk(source, destination, next_position) }
    }
}

// Bounded byte copy for [u8;64] destinations (snapshot keys).
machine copy_key64(source: &[u8], destination: &mut [u8; 64]) -> u64 {
    transition { _ -> walk(source, destination, 0) }
    state walk(source: &[u8], destination: &mut [u8; 64], position: u64) -> u64

    {
        transition position < source.len && position < 64 {
            true -> step(source, destination, position)
            false -> (position)
        }
    }
    state step(source: &[u8], destination: &mut [u8; 64], position: u64) -> u64
        requires position < source.len && position < 64;
    {
        destination[position] = source[position];
        let next_position: u64 = position + 1;
        transition { _ -> walk(source, destination, next_position) }
    }
}

// Key equality — stored key bytes + len against a caller slice.
machine key_equals(stored: &[u8; 64], stored_len: u64, candidate: &[u8]) -> bool {
    transition stored_len == candidate.len && stored_len <= 64 {
        true -> walk(stored, candidate, 0)
        false -> (false)
        _ -> (false)
    }
    state walk(stored: &[u8; 64], candidate: &[u8], position: u64) -> bool

    {
        transition position < candidate.len && position < 64 {
            true -> compare(stored, candidate, position)
            false -> (true)
        }
    }
    state compare(stored: &[u8; 64], candidate: &[u8], position: u64) -> bool
        requires position < candidate.len && position < 64;
    {
        transition stored[position] == candidate[position] {
            true -> walk(stored, candidate, position + 1)
            false -> (false)
        }
    }
}

// Copies the materializer's result-id parallel tables for the snapshot's
// apply call (bounded [128] ids).
machine copy_result_ids(
    source_ids: &[[u8; 128]; 16],
    source_lens: &[u64; 16],
    out_ids: &mut [[u8; 128]; 16],
    out_lens: &mut [u64; 16]
) -> bool {
    transition { _ -> walk(source_ids, source_lens, out_ids, out_lens, 0) }
    state walk(
        source_ids: &[[u8; 128]; 16],
        source_lens: &[u64; 16],
        out_ids: &mut [[u8; 128]; 16],
        out_lens: &mut [u64; 16],
        position: u64
    ) -> bool
    {
        transition position < 16 {
            true -> step(source_ids, source_lens, out_ids, out_lens, position)
            false -> (true)
        }
    }
    state step(
        source_ids: &[[u8; 128]; 16],
        source_lens: &[u64; 16],
        out_ids: &mut [[u8; 128]; 16],
        out_lens: &mut [u64; 16],
        position: u64
    ) -> bool
        requires position < 16;
    {
        out_ids[position] = source_ids[position];
        out_lens[position] = source_lens[position];
        let next_position: u64 = position + 1;
        transition { _ -> walk(source_ids, source_lens, out_ids, out_lens, next_position) }
    }
}

// Copies the materializer's bounded result table for the snapshot apply.
machine copy_results(
    source_results: &[VirtualSnapshotQueryResult; 16],
    out_results: &mut [VirtualSnapshotQueryResult; 16]
) -> bool {
    transition { _ -> walk(source_results, out_results, 0) }
    state walk(
        source_results: &[VirtualSnapshotQueryResult; 16],
        out_results: &mut [VirtualSnapshotQueryResult; 16],
        position: u64
    ) -> bool
    {
        transition position < 16 {
            true -> step(source_results, out_results, position)
            false -> (true)
        }
    }
    state step(
        source_results: &[VirtualSnapshotQueryResult; 16],
        out_results: &mut [VirtualSnapshotQueryResult; 16],
        position: u64
    ) -> bool
        requires position < 16;
    {
        clone_from(out_results[position], &source_results[position]);
        let next_position: u64 = position + 1;
        transition { _ -> walk(source_results, out_results, next_position) }
    }
}

// Zero-fills a suppression reason — uninit-then-element-write is the
// definite-init idiom the checker accepts for bounded arrays.
machine zero_reason(out: &mut [u8; 256]) -> bool {
    transition { _ -> walk(out, 0) }
    state walk(out: &mut [u8; 256], position: u64) -> bool
    {
        transition position < 256 {
            true -> write(out, position)
            false -> (true)
        }
    }
    state write(out: &mut [u8; 256], position: u64) -> bool
        requires position < 256;
    {
        out[position] = 0;
        let next_position: u64 = position + 1;
        transition { _ -> walk(out, next_position) }
    }
}

// Indexed-element receivers do not parse under `_ =` — element helpers.
machine snapshot_set_queries(
    snapshot: &mut VirtualSnapshot,
    queries: &[VirtualSnapshotQuery; 16],
    query_count: u64
) -> bool {
    let hoist46: bool = set_queries(snapshot, queries, query_count);
    (hoist46)
}

machine snapshot_apply_refresh_results(
    snapshot: &mut VirtualSnapshot,
    refresh_query_version: u64,
    result_ids: &[[u8; 128]; 16],
    result_id_lens: &[u64; 16],
    query_results: &[VirtualSnapshotQueryResult; 16],
    query_result_count: u64,
    now_millis: u64
) -> bool {
    let hoist47: bool = apply_refresh_results(snapshot, refresh_query_version,
        result_ids,
        result_id_lens,
        query_results,
        query_result_count,
        now_millis);
    (hoist47)
}
