// Port of engine_unprivileged_state.rs — the session-side engine surface:
// project manager, plugin registry, privileged-registry cache, virtual
// snapshots, command-invocation middleware, response publication, and
// engine-event routing.
//
// Upstream collaborators that have no Omega counterpart are folded per the
// epic's documented substitutions:
//  - `Arc<RwLock<dyn EngineApiUnprivilegedBindings>>` — bindings cannot be
//    stored (no user dyn traits). The dispatch hop lives at the composition
//    root: `prepare_*_dispatch` yields a `CommandDispatchPlan` the caller
//    executes through `EngineApiUnprivilegedBindings` (the standalone
//    bindings record satisfies the boundary trait in squalr-engine).
//  - `Box<dyn Fn>` middleware / listener tables — bounded kind-tag tables;
//    `run_invocation_middleware`/`run_response_middleware`/`run_response_
//    listener` dispatch on the kind. Kind 0 is the absent-slot sentinel
//    (Continue/observe-nothing); real kinds land with their consumers.
//  - `HashMap<TypeId, Vec<Box<dyn Fn(&dyn Any)>>>` event listeners —
//    `EventSubscriberTable` (interest-bit masks + per-subscriber queues).
//  - `HashMap<String, VirtualSnapshot>` — bounded 8-slot key/value tables.
//  - spawned threads (event dispatcher, snapshot materialization,
//    catalog refresh) — synchronous caller-pumped seams:
//    `route_engine_event`, `prepare_virtual_snapshot_refresh` +
//    `finish_virtual_snapshot_refresh`, `needs_privileged_registry_refresh`
//    + `apply_privileged_registry_catalog`. `Instant`/`Duration` arrive as
//    `now_millis`/`refresh_interval_millis` u64 parameters.
//  - `i128` scalar reads — `read_scalar_integer_value` widens to u64+sign.
//  - `log::error!`/`log::warn!` — routed into `log_dispatcher` history.

// Upstream's local `CommandDispatchPlan` enum — middleware may answer or
// refuse an invocation before it reaches the bindings. Union payloads are
// consumed by value at the scrutinee (invocation ownership transfers).
pub data CommandDispatchPlan {
    case Dispatch(invocation: CommandInvocation);
    case Respond(invocation: CommandInvocation, response: EngineCommandResponse);
    case Reject(invocation: CommandInvocation, reason: [u8; 256], reason_len: u64);
}

// Upstream `Option<EngineCommandResponse>` from publish — `None` means a
// middleware suppressed the response.
pub data CommandPublicationResult {
    case Delivered(response: EngineCommandResponse);
    case Suppressed(reason: [u8; 256], reason_len: u64);
}

// Deanonymize carrier — upstream `Result<DataValue, SymbolRegistryError>`.
// `SymbolRegistryError` is unported; the failure arm carries the operation
// and data type id, matching upstream's `data_type_not_registered` payload.
pub data DeanonymizeValueOutcome {
    case Value(data_value: DataValue);
    case NotRegistered(operation: [u8; 64], operation_len: u64, data_type_id: [u8; 128], data_type_id_len: u64);
}

// Anonymize carrier — upstream `Result<AnonymousValueString,
// SymbolRegistryError>`, same flattening.
pub data AnonymizeValueOutcome {
    case Value(anonymous_value_string: AnonymousValueString);
    case NotRegistered(operation: [u8; 64], operation_len: u64, data_type_id: [u8; 128], data_type_id_len: u64);
}

// Scalar-integer read carrier — upstream `Result<Option<i128>,
// SymbolRegistryError>`: three-valued (error / absent / value). The value
// widens to u64 magnitude + sign flag (i128 absent).
pub data ScalarIntegerReadOutcome {
    case Absent;
    case Value(magnitude: u64, negative: bool);
    case NotRegistered(operation: [u8; 64], operation_len: u64, data_type_id: [u8; 128], data_type_id_len: u64);
}

// Upstream `EngineUnprivilegedStateOptions` — flattened to fields.
pub data EngineUnprivilegedStateOptions {
    enable_console_logging: bool;
}

pub machine EngineUnprivilegedStateOptions::default() -> EngineUnprivilegedStateOptions {
    EngineUnprivilegedStateOptions { enable_console_logging: true }
}

pub data EngineUnprivilegedState {
    // `AtomicU64` — the session is single-owner, plain u64.
    next_command_invocation_id: u64;
    // Kind-tag middleware tables (upstream `Vec<Box<dyn Fn>>`).
    invocation_middleware_kinds: [u64; 16];
    invocation_middleware_count: u64;
    response_middleware_kinds: [u64; 16];
    response_middleware_count: u64;
    response_listener_kinds: [u64; 16];
    response_listener_count: u64;
    // Upstream `event_listeners` TypeId map.
    event_subscribers: EventSubscriberTable;
    // Upstream `file_system_logger`.
    log_dispatcher: LogDispatcher;
    project_manager: ProjectManager;
    plugin_registry: PluginRegistry;
    privileged_registry_cache: PrivilegedRegistryCache;
    // Upstream `HashMap<String, VirtualSnapshot>` — bounded 8-slot tables.
    virtual_snapshot_keys: [[u8; 64]; 8];
    virtual_snapshot_key_lens: [u64; 8];
    virtual_snapshot_values: [VirtualSnapshot; 8];
    virtual_snapshot_count: u64;
}

pub machine EngineUnprivilegedState::new() -> EngineUnprivilegedState {
    let mut state: EngineUnprivilegedState = EngineUnprivilegedState::new_with_options(
        EngineUnprivilegedStateOptions::default());
    state
}

pub machine EngineUnprivilegedState::new_with_options(
    options: EngineUnprivilegedStateOptions
) -> EngineUnprivilegedState {
    let mut state: EngineUnprivilegedState = EngineUnprivilegedState {
        next_command_invocation_id: 0,
        invocation_middleware_count: 0,
        response_middleware_count: 0,
        response_listener_count: 0,
        event_subscribers: EventSubscriberTable::new(),
        log_dispatcher: LogDispatcher::new_with_options(options.enable_console_logging),
        project_manager: ProjectManager::new(),
        plugin_registry: PluginRegistry::new(),
        privileged_registry_cache: PrivilegedRegistryCache::new(),
        virtual_snapshot_count: 0,
    };
    state.seed_virtual_snapshot_keys();
    state
}

// Entry-context initializer — `SqualrEngine` construction happens inside
// the host entry plan where a structural local or call-source assignment
// cannot bind, so the same default shape `new_with_options` produces is
// written field-wise here (mirroring `EnginePrivilegedState::init`).
pub machine EngineUnprivilegedState::init(this: &mut EngineUnprivilegedState) {
    this.next_command_invocation_id = 0;
    this.invocation_middleware_count = 0;
    this.response_middleware_count = 0;
    this.response_listener_count = 0;
    this.event_subscribers = EventSubscriberTable::new();
    this.log_dispatcher = LogDispatcher::new_with_options(true);
    this.project_manager = ProjectManager::new();
    this.plugin_registry = PluginRegistry::new();
    this.privileged_registry_cache = PrivilegedRegistryCache::new();
    this.virtual_snapshot_count = 0;
    EngineUnprivilegedState::seed_virtual_snapshot_keys(&mut this);
}

machine EngineUnprivilegedState::seed_virtual_snapshot_keys(this: &mut EngineUnprivilegedState) {
    transition { _ -> walk(this, 0) }
    state walk(this: &mut EngineUnprivilegedState, position: u64)

    {
        transition position < 8 {
            true -> clear(this, position)
            false -> done(this)
        }
    }
    state clear(this: &mut EngineUnprivilegedState, position: u64)
        requires position < 8;
    {
        this.virtual_snapshot_key_lens[position] = 0;
        transition { _ -> walk(this, position + 1) }
    }
    state done(this: &mut EngineUnprivilegedState) {
    }
}

// Upstream `initialize` — starts the event dispatcher and refreshes the
// privileged registry catalog. Both are caller-pumped hops in the port:
// `route_engine_event` is the dispatcher body, and the catalog refresh is
// `needs_privileged_registry_refresh` + `apply_privileged_registry_catalog`
// driven by the composition root. This machine is the upstream lifecycle
// hook's honest remainder: mark the cache stale so the first
// `needs_privileged_registry_refresh(expected > 0)` holds, which it already
// does on a fresh cache (generation 0). Kept as a no-op body is a
// placeholder — instead it returns whether a catalog sync is owed.
pub machine EngineUnprivilegedState::initialize(this: &mut EngineUnprivilegedState) -> bool {
    let hoist28: bool = EngineUnprivilegedState::get_needs_privileged_registry_refresh(&this, 1);
    (hoist28)
}

