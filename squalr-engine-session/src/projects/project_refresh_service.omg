module src::projects::project_refresh_service;

use squalr_engine_api::src::structures::projects::project_info::ProjectInfo;
use squalr_engine_api::src::structures::projects::project_path_list::ProjectPathList;
use squalr_engine_api::src::events::project::created::project_created_event::ProjectCreatedEvent;
use squalr_engine_api::src::events::project::deleted::project_deleted_event::ProjectDeletedEvent;
use squalr_engine_api::src::events::project::closed::project_closed_event::ProjectClosedEvent;
use squalr_engine_api::src::events::project::catalog_changed::project_catalog_changed_event::ProjectCatalogChangedEvent;
use squalr_engine_api::src::events::project_items::changed::project_items_changed_event::ProjectItemsChangedEvent;
use src::event_subscribers::event_subscriber_table::EventSubscriberTable;

// Port of projects/project_refresh/project_refresh_service.rs. Upstream
// owns a `ProjectRefreshConfig { emit_internal_project_events,
// watch_file_system }` (both defaulting true), the watched root/opened
// paths, and a `notify`-crate debounced watcher per path feeding a
// callback that emits catalog-change events and clears the opened
// project on delete. The port keeps the config + watched paths + every
// notify/watch machine; the file-system watcher internals (crate-level
// debounced watching) are deferred — `watch_*` records the paths and the
// enabled flag honestly, and `refresh_file_system_watchers` collapses to
// updating which watch slots are live. The `event_emitter` indirection
// also collapses: upstream emits `&dyn Any` through a stored callback
// into the unprivileged state's listener map; the port passes the
// subscriber table straight into `notify_*`, which routes the produced
// `EngineEvent` to matching queues.
pub data ProjectRefreshService {
    emit_internal_project_events: bool;
    watch_file_system: bool;
    has_projects_root_path: bool;
    projects_root_path: [u8; 512];
    projects_root_path_len: u64;
    has_opened_project_directory_path: bool;
    opened_project_directory_path: [u8; 512];
    opened_project_directory_path_len: u64;
    projects_root_watch_live: bool;
    opened_project_watch_live: bool;
}

pub machine ProjectRefreshService::new() -> ProjectRefreshService {
    ProjectRefreshService {
        emit_internal_project_events: true,
        watch_file_system: true,
        has_projects_root_path: false,
        projects_root_path_len: 0,
        has_opened_project_directory_path: false,
        opened_project_directory_path_len: 0,
        projects_root_watch_live: false,
        opened_project_watch_live: false,
    }
}

pub machine ProjectRefreshService::new_with_config(this: &mut ProjectRefreshService, emit_internal_project_events: bool, watch_file_system: bool) {
    this.emit_internal_project_events = emit_internal_project_events;
    this.watch_file_system = watch_file_system;
}

pub machine ProjectRefreshService::get_emit_internal_project_events(this: &ProjectRefreshService) -> bool {
    this.emit_internal_project_events
}

pub machine ProjectRefreshService::get_watch_file_system(this: &ProjectRefreshService) -> bool {
    this.watch_file_system
}

pub machine ProjectRefreshService::get_should_watch_file_system(this: &ProjectRefreshService) -> bool {
    this.watch_file_system
}

// Upstream `notify_project_items_changed` — emits a lightweight
// invalidation (empty path list) when internal events are enabled.
pub machine ProjectRefreshService::notify_project_items_changed(this: &ProjectRefreshService, subscribers: &mut EventSubscriberTable) {
    transition this.emit_internal_project_events {
        true -> emit(this, subscribers)
        false -> done(this)
        _ -> done(this)
    }
    state emit(this: &ProjectRefreshService, subscribers: &mut EventSubscriberTable) {
        let changed_project_paths: ProjectPathList = ProjectPathList::empty();
        let project_items_changed_event: ProjectItemsChangedEvent = ProjectItemsChangedEvent::new(&changed_project_paths);
        EventSubscriberTable::route_engine_event(&mut subscribers, &ProjectItemsChangedEvent::to_engine_event(&project_items_changed_event))oject_items_changed_event));
        transition { _ -> done(this) }
    }
    state done(this: &ProjectRefreshService) {
    }
}

// Upstream `notify_project_created` — emits `ProjectCreated` then
// `ProjectCatalogChanged` for the new project's directory.
pub machine ProjectRefreshService::notify_project_created(this: &ProjectRefreshService, project_info: &ProjectInfo, subscribers: &mut EventSubscriberTable) {
    transition this.emit_internal_project_events {
        true -> emit_created(this, project_info, subscribers)
        false -> done(this)
        _ -> done(this)
    }
    state emit_created(this: &ProjectRefreshService, project_info: &ProjectInfo, subscribers: &mut EventSubscriberTable) {
        let project_created_event: ProjectCreatedEvent = ProjectInfo::new(project_info);
        EventSubscriberTable::route_engine_event(&mut subscribers, &to_enginProjectCreatedEvent::to_engine_event(&project_created_event)created_event));
        transition { _ -> emit_catalog(this, project_info, subscribers) }
    }
    state emit_catalog(this: &ProjectRefreshService, project_info: &ProjectInfo, subscribers: &mut EventSubscriberTable) {
        let mut project_catalog_changed_event: ProjectCatalogChangedEvent = ProjectCatalogChangedEvent::default();
        let mut project_directory: [u8; 512];
        let hoist1: bool = ProjectInfo::get_project_directory(&project_info, &mut project_directory);
        transition hoist1 {
            true -> with_directory(this, &mut project_catalog_changed_event, &project_directory, subscribers)
            false -> done(this)
        }
    }
    state with_directory(this: &ProjectRefreshService, project_catalog_changed_event: &mut ProjectCatalogChangedEvent, project_directory: &[u8], subscribers: &mut EventSubscriberTable) {
        ProjectCatalogChangedEvent::set_changed_project_directory_path(&mut project_catalog_changed_event, project_directory);
        EventSubscriberTable::route_engine_event(&mut subscribers, &to_enginProjectCatalogChangedEvent::to_engine_event(&project_catalog_changed_event)atalog_changed_event));
        transition { _ -> done(this) }
    }
    state done(this: &ProjectRefreshService) {
    }
}

// Upstream `notify_project_deleted` — `ProjectDeleted` + catalog change.
pub machine ProjectRefreshService::notify_project_deleted(this: &ProjectRefreshService, project_info: &ProjectInfo, subscribers: &mut EventSubscriberTable) {
    transition this.emit_internal_project_events {
        true -> emit_deleted(this, project_info, subscribers)
        false -> done(this)
        _ -> done(this)
    }
    state emit_deleted(this: &ProjectRefreshService, project_info: &ProjectInfo, subscribers: &mut EventSubscriberTable) {
        let project_deleted_event: ProjectDeletedEvent = ProjectInfo::new(project_info);
        EventSubscriberTable::route_engine_event(&mut subscribers, &to_enginProjectDeletedEvent::to_engine_event(&project_deleted_event)deleted_event));
        transition { _ -> emit_catalog(this, project_info, subscribers) }
    }
    state emit_catalog(this: &ProjectRefreshService, project_info: &ProjectInfo, subscribers: &mut EventSubscriberTable) {
        let mut project_catalog_changed_event: ProjectCatalogChangedEvent = ProjectCatalogChangedEvent::default();
        let mut project_directory: [u8; 512];
        let hoist2: bool = ProjectInfo::get_project_directory(&project_info, &mut project_directory);
        transition hoist2 {
            true -> with_directory(this, &mut project_catalog_changed_event, &project_directory, subscribers)
            false -> done(this)
        }
    }
    state with_directory(this: &ProjectRefreshService, project_catalog_changed_event: &mut ProjectCatalogChangedEvent, project_directory: &[u8], subscribers: &mut EventSubscriberTable) {
        ProjectCatalogChangedEvent::set_changed_project_directory_path(&mut project_catalog_changed_event, project_directory);
        EventSubscriberTable::route_engine_event(&mut subscribers, &to_enginProjectCatalogChangedEvent::to_engine_event(&project_catalog_changed_event)atalog_changed_event));
        transition { _ -> done(this) }
    }
    state done(this: &ProjectRefreshService) {
    }
}

// Upstream `notify_project_closed` — `ProjectClosed` only.
pub machine ProjectRefreshService::notify_project_closed(this: &ProjectRefreshService, subscribers: &mut EventSubscriberTable) {
    transition this.emit_internal_project_events {
        true -> emit_closed(this, subscribers)
        false -> done(this)
        _ -> done(this)
    }
    state emit_closed(this: &ProjectRefreshService, subscribers: &mut EventSubscriberTable) {
        let project_closed_event: ProjectClosedEvent = ProjectClosedEvent {};
        EventSubscriberTable::route_engine_event(&mut subscribers, &ProjectClosedEvent::to_engine_event(&project_closed_event))roject_closed_event));
        transition { _ -> done(this) }
    }
    state done(this: &ProjectRefreshService) {
    }
}

// Upstream `watch_projects_root` — records the catalog root and refreshes
// the watcher set (watcher internals deferred; see file comment).
pub machine ProjectRefreshService::watch_projects_root(this: &mut ProjectRefreshService, projects_root: &[u8]) {
    _ = bounded_copy(&mut this.projects_root_path, &mut this.projects_root_path_len, projects_root);
    this.has_projects_root_path = true;
    ProjectRefreshService::refresh_file_system_watchers(&mut this);
}

// Upstream `watch_opened_project` — records the opened project directory.
pub machine ProjectRefreshService::watch_opened_project(this: &mut ProjectRefreshService, opened_project_directory_path: &[u8], has_opened_project_directory_path: bool) {
    transition has_opened_project_directory_path {
        true -> store_path(this, opened_project_directory_path, has_opened_project_directory_path)
        false -> clear_path(this, has_opened_project_directory_path)
        _ -> clear_path(this, has_opened_project_directory_path)
    }
    state store_path(this: &mut ProjectRefreshService, opened_project_directory_path: &[u8], has_opened_project_directory_path: bool) {
        _ = bounded_copy(&mut this.opened_project_directory_path, &mut this.opened_project_directory_path_len, opened_project_directory_path);
        this.has_opened_project_directory_path = true;
        ProjectRefreshService::refresh_file_system_watchers(&mut this);
        transition { _ -> done(this) }
    }
    state clear_path(this: &mut ProjectRefreshService, has_opened_project_directory_path: bool) {
        this.has_opened_project_directory_path = false;
        this.opened_project_directory_path_len = 0;
        ProjectRefreshService::refresh_file_system_watchers(&mut this);
        transition { _ -> done(this) }
    }
    state done(this: &mut ProjectRefreshService) {
    }
}

// Upstream `set_file_system_watch_enabled` — no-op when unchanged.
pub machine ProjectRefreshService::set_file_system_watch_enabled(this: &mut ProjectRefreshService, watch_file_system: bool) {
    transition this.watch_file_system == watch_file_system {
        true -> done(this)
        false -> apply(this, watch_file_system)
        _ -> apply(this, watch_file_system)
    }
    state apply(this: &mut ProjectRefreshService, watch_file_system: bool) {
        this.watch_file_system = watch_file_system;
        ProjectRefreshService::refresh_file_system_watchers(&mut this);
        transition { _ -> done(this) }
    }
    state done(this: &mut ProjectRefreshService) {
    }
}

// Upstream `refresh_file_system_watchers` — upstream drops both watchers
// and recreates the live set from `should_watch_file_system` + recorded
// paths. The port keeps the same live-flag bookkeeping; the actual
// `notify` watchers stand in as flags until the file-watch leg lands.
pub machine ProjectRefreshService::refresh_file_system_watchers(this: &mut ProjectRefreshService) {
    this.projects_root_watch_live = false;
    this.opened_project_watch_live = false;
    let hoist3: bool = ProjectRefreshService::get_should_watch_file_system(&this);
    transition hoist3 {
        true -> arm(this)
        false -> done(this)
        _ -> done(this)
    }
    state arm(this: &mut ProjectRefreshService) {
        this.projects_root_watch_live = this.has_projects_root_path;
        this.opened_project_watch_live = this.has_opened_project_directory_path;
        transition { _ -> done(this) }
    }
    state done(this: &mut ProjectRefreshService) {
    }
}

pub machine ProjectRefreshService::get_projects_root_watch_live(this: &ProjectRefreshService) -> bool {
    this.projects_root_watch_live
}

pub machine ProjectRefreshService::get_opened_project_watch_live(this: &ProjectRefreshService) -> bool {
    this.opened_project_watch_live
}

machine bounded_copy(destination: &mut [u8; 512], destination_len: &mut u64, source: &[u8]) -> bool {
    transition source.len <= 512 {
        true -> copy(destination, destination_len, source, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(destination: &mut [u8; 512], destination_len: &mut u64, source: &[u8], position: u64) -> bool
    {
        transition position < source.len && position < 512 {
            true -> copy_one(destination, destination_len, source, position)
            false -> finish(destination_len, source)
        }
    }
    state copy_one(destination: &mut [u8; 512], destination_len: &mut u64, source: &[u8], position: u64) -> bool
        requires position < source.len && position < 512;
    {
        destination[position] = source[position];
        transition { _ -> copy(destination, destination_len, source, position + 1) }
    }
    state finish(destination_len: &mut u64, source: &[u8]) -> bool {
        destination_len = source.len;
        (true)
    }
}
