use {squalr_engine_api}/src/structures/projects/project.omg;
use {squalr_engine_api}/src/structures/projects/project_info.omg;
use src/projects/project_refresh_service.omg;
use src/event_subscribers/event_subscriber_table.omg;

// Port of projects/project_manager.rs. Upstream:
//
//     pub struct ProjectManager {
//         opened_project: Arc<RwLock<Option<Project>>>,
//         project_refresh_service: Arc<ProjectRefreshService>,
//     }
//
// — a shared optional project plus the refresh service, exposing the
// `ProjectContext` trait surface (opened-project access, notify_*,
// watch_*, file-system-watch toggle) plus `set_event_emitter` wiring.
// The port keeps the record and every delegate concretely (the
// `ProjectContext` trait itself is not ported — trait objects are
// unavailable; consumers call these machines directly). `Arc<RwLock>`
// collapses to plain fields — the manager lives on the unprivileged
// state under one owner. `set_event_emitter` collapses into passing the
// subscriber table into `notify_*` directly.
public data ProjectManager {
    has_opened_project: bool;
    opened_project: |project|::Project;
    project_refresh_service: |project_refresh_service|::ProjectRefreshService;
}

public machine ProjectManager::new() -> ProjectManager {
    ProjectManager {
        has_opened_project: false,
        opened_project: |project|::Project::default(),
        project_refresh_service: |project_refresh_service|::ProjectRefreshService::new(),
    }
}

// Upstream `new_with_options` — the refresh service honors the engine
// options' emit/watch flags.
public machine ProjectManager::new_with_options(emit_internal_project_events: bool, watch_file_system: bool) -> ProjectManager {
    let mut refresh_service: |project_refresh_service|::ProjectRefreshService = |project_refresh_service|::ProjectRefreshService::new();
    |project_refresh_service|::ProjectRefreshService::new_with_config(&mut refresh_service, emit_internal_project_events, watch_file_system);
    ProjectManager {
        has_opened_project: false,
        opened_project: |project|::Project::default(),
        project_refresh_service: refresh_service,
    }
}

// Upstream `ProjectContext::get_opened_project` — `&Option<Project>`.
public machine ProjectManager::get_has_opened_project(this: &ProjectManager) -> bool {
    this.has_opened_project
}

public machine ProjectManager::get_opened_project(this: &ProjectManager) -> &|project|::Project {
    (&this.opened_project)
}

public machine ProjectManager::borrow_opened_project_mut(this: &mut ProjectManager) -> &mut |project|::Project {
    (&mut this.opened_project)
}

// Upstream `set_opened_project` — used by open/close executors.
public machine ProjectManager::set_opened_project(this: &mut ProjectManager, project: &|project|::Project) {
    |project|::Project::copy_from(&mut this.opened_project, project);
    this.has_opened_project = true;
}

public machine ProjectManager::clear_opened_project(this: &mut ProjectManager) {
    this.has_opened_project = false;
}

public machine ProjectManager::get_project_refresh_service(this: &ProjectManager) -> &|project_refresh_service|::ProjectRefreshService {
    (&this.project_refresh_service)
}

public machine ProjectManager::borrow_project_refresh_service_mut(this: &mut ProjectManager) -> &mut |project_refresh_service|::ProjectRefreshService {
    (&mut this.project_refresh_service)
}

// `ProjectContext` notify delegates — route through the refresh service,
// which drops them when internal events are disabled.
public machine ProjectManager::notify_project_items_changed(this: &ProjectManager, subscribers: &mut |event_subscriber_table|::EventSubscriberTable) {
    |project_refresh_service|::ProjectRefreshService::notify_project_items_changed(&this.project_refresh_service, subscribers);
}

public machine ProjectManager::notify_project_created(this: &ProjectManager, project_info: &|project_info|::ProjectInfo, subscribers: &mut |event_subscriber_table|::EventSubscriberTable) {
    |project_refresh_service|::ProjectRefreshService::notify_project_created(&this.project_refresh_service, project_info, subscribers);
}

public machine ProjectManager::notify_project_deleted(this: &ProjectManager, project_info: &|project_info|::ProjectInfo, subscribers: &mut |event_subscriber_table|::EventSubscriberTable) {
    |project_refresh_service|::ProjectRefreshService::notify_project_deleted(&this.project_refresh_service, project_info, subscribers);
}

public machine ProjectManager::notify_project_closed(this: &ProjectManager, subscribers: &mut |event_subscriber_table|::EventSubscriberTable) {
    |project_refresh_service|::ProjectRefreshService::notify_project_closed(&this.project_refresh_service, subscribers);
}

// `ProjectContext` watch delegates.
public machine ProjectManager::watch_projects_root(this: &mut ProjectManager, projects_root: &[u8]) {
    |project_refresh_service|::ProjectRefreshService::watch_projects_root(&mut this.project_refresh_service, projects_root);
}

public machine ProjectManager::watch_opened_project(this: &mut ProjectManager, opened_project_directory_path: &[u8], has_opened_project_directory_path: bool) {
    |project_refresh_service|::ProjectRefreshService::watch_opened_project(&mut this.project_refresh_service, opened_project_directory_path, has_opened_project_directory_path);
}

public machine ProjectManager::set_project_file_system_watch_enabled(this: &mut ProjectManager, watch_file_system: bool) {
    |project_refresh_service|::ProjectRefreshService::set_file_system_watch_enabled(&mut this.project_refresh_service, watch_file_system);
}
