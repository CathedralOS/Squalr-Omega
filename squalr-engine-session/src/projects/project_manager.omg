module src::projects::project_manager;

use squalr_engine_api::src::structures::projects::project::Project;
use squalr_engine_api::src::structures::projects::project_info::ProjectInfo;
use src::projects::project_refresh_service::ProjectRefreshService;
use src::event_subscribers::event_subscriber_table::EventSubscriberTable;

// Port of projects/project_manager.rs. Upstream:
//
//     pub struct ProjectManager {
//         opened_project: Arc<RwLock<Option<Project>>>,
//         project_refresh_service: Arc<ProjectRefreshService>,
//     }
//
// — a shared optional project plus the refresh service, exposing the
// `ProjectContext` trait surface (opened-project access, notify_*,
// watch_*, file-system-watch toggle) plus `set_event_emitter` wiring.
// The port keeps the record and every delegate concretely (the
// `ProjectContext` trait itself is not ported — trait objects are
// unavailable; consumers call these machines directly). `Arc<RwLock>`
// collapses to plain fields — the manager lives on the unprivileged
// state under one owner. `set_event_emitter` collapses into passing the
// subscriber table into `notify_*` directly.
pub data ProjectManager {
    has_opened_project: bool;
    opened_project: Project;
    project_refresh_service: ProjectRefreshService;
}

pub machine ProjectManager::new() -> ProjectManager {
    ProjectManager {
        has_opened_project: false,
        opened_project: Project::default(),
        project_refresh_service: ProjectRefreshService::new(),
    }
}

// Upstream `new_with_options` — the refresh service honors the engine
// options' emit/watch flags.
pub machine ProjectManager::new_with_options(emit_internal_project_events: bool, watch_file_system: bool) -> ProjectManager {
    let mut refresh_service: ProjectRefreshService = ProjectRefreshService::new();
    refresh_service.new_with_config(emit_internal_project_events, watch_file_system);
    ProjectManager {
        has_opened_project: false,
        opened_project: Project::default(),
        project_refresh_service: refresh_service,
    }
}

// Upstream `ProjectContext::get_opened_project` — `&Option<Project>`.
pub machine ProjectManager::get_has_opened_project(&self) -> bool {
    self.has_opened_project
}

pub machine ProjectManager::get_opened_project(&self) -> &Project {
    (&self.opened_project)
}

pub machine ProjectManager::borrow_opened_project_mut(&mut self) -> &mut Project {
    (&mut self.opened_project)
}

// Upstream `set_opened_project` — used by open/close executors.
pub machine ProjectManager::set_opened_project(&mut self, project: &Project) {
    self.opened_project.copy_from(project);
    self.has_opened_project = true;
}

pub machine ProjectManager::clear_opened_project(&mut self) {
    self.has_opened_project = false;
}

pub machine ProjectManager::get_project_refresh_service(&self) -> &ProjectRefreshService {
    (&self.project_refresh_service)
}

pub machine ProjectManager::borrow_project_refresh_service_mut(&mut self) -> &mut ProjectRefreshService {
    (&mut self.project_refresh_service)
}

// `ProjectContext` notify delegates — route through the refresh service,
// which drops them when internal events are disabled.
pub machine ProjectManager::notify_project_items_changed(&self, subscribers: &mut EventSubscriberTable) {
    self.project_refresh_service.notify_project_items_changed(subscribers);
}

pub machine ProjectManager::notify_project_created(&self, project_info: &ProjectInfo, subscribers: &mut EventSubscriberTable) {
    self.project_refresh_service.notify_project_created(project_info, subscribers);
}

pub machine ProjectManager::notify_project_deleted(&self, project_info: &ProjectInfo, subscribers: &mut EventSubscriberTable) {
    self.project_refresh_service.notify_project_deleted(project_info, subscribers);
}

pub machine ProjectManager::notify_project_closed(&self, subscribers: &mut EventSubscriberTable) {
    self.project_refresh_service.notify_project_closed(subscribers);
}

// `ProjectContext` watch delegates.
pub machine ProjectManager::watch_projects_root(&mut self, projects_root: &[u8]) {
    self.project_refresh_service.watch_projects_root(projects_root);
}

pub machine ProjectManager::watch_opened_project(&mut self, opened_project_directory_path: &[u8], has_opened_project_directory_path: bool) {
    self.project_refresh_service.watch_opened_project(opened_project_directory_path, has_opened_project_directory_path);
}

pub machine ProjectManager::set_project_file_system_watch_enabled(&mut self, watch_file_system: bool) {
    self.project_refresh_service.set_file_system_watch_enabled(watch_file_system);
}
