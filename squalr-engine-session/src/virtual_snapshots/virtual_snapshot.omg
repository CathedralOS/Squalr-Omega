module src::virtual_snapshots::virtual_snapshot;

use src::virtual_snapshots::virtual_snapshot_query::VirtualSnapshotQuery;
use src::virtual_snapshots::virtual_snapshot_query_result::VirtualSnapshotQueryResult;

// Port of virtual_snapshots/virtual_snapshot.rs. `Vec<VirtualSnapshotQuery>`
// and `HashMap<String, VirtualSnapshotQueryResult>` become bounded tables
// (16 queries / 16 results — snapshot watch lists are UI-scale; refuse on
// overflow, documented). `Duration`/`Instant` become caller-supplied
// `*_millis` values — Omega has no clock trait here; the composition root
// feeds `now_millis`. `Option<u64>` timestamps carry has_ flags.
pub data VirtualSnapshot {
    queries: [VirtualSnapshotQuery; 16];
    query_count: u64;
    query_result_ids: [[u8; 128]; 16];
    query_result_id_lens: [u64; 16];
    query_results: [VirtualSnapshotQueryResult; 16];
    query_result_count: u64;
    refresh_interval_millis: u64;
    query_version: u64;
    has_last_applied_query_version: bool;
    last_applied_query_version: u64;
    has_last_refresh_started_millis: bool;
    last_refresh_started_millis: u64;
    has_last_refresh_completed_millis: bool;
    last_refresh_completed_millis: u64;
    is_refresh_in_progress: bool;
    has_refresh_in_progress_query_version: bool;
    refresh_in_progress_query_version: u64;
    generation: u64;
}

pub machine VirtualSnapshot::new(refresh_interval_millis: u64) -> VirtualSnapshot {
    VirtualSnapshot {
        query_count: 0,
        query_result_count: 0,
        refresh_interval_millis: refresh_interval_millis,
        query_version: 0,
        has_last_applied_query_version: false,
        last_applied_query_version: 0,
        has_last_refresh_started_millis: false,
        last_refresh_started_millis: 0,
        has_last_refresh_completed_millis: false,
        last_refresh_completed_millis: 0,
        is_refresh_in_progress: false,
        has_refresh_in_progress_query_version: false,
        refresh_in_progress_query_version: 0,
        generation: 0,
    }
}

pub machine VirtualSnapshot::get_query_count(&self) -> u64 {
    self.query_count
}

pub machine VirtualSnapshot::copy_query(&self, position: u64, out_query: &mut VirtualSnapshotQuery) -> bool {
    transition position < self.query_count && position < 16 {
        true -> read(position, out_query)
        false -> (false)
        _ -> (false)
    }
    state read(&self, position: u64, out_query: &mut VirtualSnapshotQuery) -> bool
        requires position < 16;
    {
        out_query.clone_from(&self.queries[position]);
        (true)
    }
}

pub machine VirtualSnapshot::get_generation(&self) -> u64 {
    self.generation
}

pub machine VirtualSnapshot::get_has_last_refresh_completed_millis(&self) -> bool {
    self.has_last_refresh_completed_millis
}

pub machine VirtualSnapshot::get_last_refresh_completed_millis(&self) -> u64 {
    self.last_refresh_completed_millis
}

pub machine VirtualSnapshot::get_is_refresh_in_progress(&self) -> bool {
    self.is_refresh_in_progress
}

pub machine VirtualSnapshot::set_refresh_interval(&mut self, refresh_interval_millis: u64) {
    self.refresh_interval_millis = refresh_interval_millis;
}

// Result table reads — position-indexed like the project's tables; the
// query id keys live in the parallel `*_ids`/`*_id_lens` arrays.
pub machine VirtualSnapshot::get_query_result_count(&self) -> u64 {
    self.query_result_count
}

pub machine VirtualSnapshot::find_query_result_position(&self, query_id: &[u8]) -> u64 {
    transition { _ -> walk(query_id, 0) }
    state walk(&self, query_id: &[u8], position: u64) -> u64 {
        transition position < self.query_result_count && position < 16 {
            true -> compare(query_id, position)
            false -> (16)
        }
    }
    state compare(&self, query_id: &[u8], position: u64) -> u64 {
        transition self.query_result_id_lens[position] == query_id.len && query_id.len <= 128 {
            true -> probe(query_id, position, 0)
            false -> walk(query_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state probe(&self, query_id: &[u8], position: u64, index: u64) -> u64

    {
        transition index < query_id.len && index < 128 {
            true -> check_char(query_id, position, index)
            false -> (position)
        }
    }
    state check_char(&self, query_id: &[u8], position: u64, index: u64) -> u64
        requires index < query_id.len && index < 128;
    {
        transition self.query_result_ids[position][index] == query_id[index] {
            true -> probe(query_id, position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> walk(query_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

pub machine VirtualSnapshot::copy_query_result(&self, position: u64, out_result: &mut VirtualSnapshotQueryResult) -> bool {
    transition position < self.query_result_count && position < 16 {
        true -> read(position, out_result)
        false -> (false)
        _ -> (false)
    }
    state read(&self, position: u64, out_result: &mut VirtualSnapshotQueryResult) -> bool
        requires position < 16;
    {
        out_result.clone_from(&self.query_results[position]);
        (true)
    }
}

// Upstream `set_queries` — equal lists are a no-op; otherwise the query
// list is replaced, the version bumps, and results keyed by ids that left
// the list are retained/dropped (upstream `retain`).
pub machine VirtualSnapshot::set_queries(&mut self, queries: &[VirtualSnapshotQuery; 16], query_count: u64) -> bool {
    transition query_count <= 16 {
        true -> check_equal(queries, query_count)
        false -> (false)
        _ -> (false)
    }
    state check_equal(&mut self, queries: &[VirtualSnapshotQuery; 16], query_count: u64) -> bool {
        transition query_count == self.query_count {
            true -> compare_each(queries, query_count, 0)
            false -> replace(queries, query_count)
        }
    }
    state compare_each(&mut self, queries: &[VirtualSnapshotQuery; 16], query_count: u64, position: u64) -> bool
    {
        transition position < query_count && position < 16 {
            true -> compare_one(queries, query_count, position)
            false -> (true)
        }
    }
    state compare_one(&mut self, queries: &[VirtualSnapshotQuery; 16], query_count: u64, position: u64) -> bool
        requires position < query_count && position < 16;
    {
        transition self.queries[position].equals(&queries[position]) {
            true -> compare_each(queries, query_count, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> replace(queries, query_count)
        }
    }
    state replace(&mut self, queries: &[VirtualSnapshotQuery; 16], query_count: u64) -> bool {
        transition { _ -> fill(queries, query_count, 0) }
    }
    state fill(&mut self, queries: &[VirtualSnapshotQuery; 16], query_count: u64, position: u64) -> bool
    {
        transition position < query_count && position < 16 {
            true -> fill_one(queries, query_count, position)
            false -> finish_fill(query_count)
        }
    }
    state fill_one(&mut self, queries: &[VirtualSnapshotQuery; 16], query_count: u64, position: u64) -> bool
        requires position < query_count && position < 16;
    {
        self.queries[position].clone_from(&queries[position]);
        transition { _ -> fill(queries, query_count, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_fill(&mut self, query_count: u64) -> bool {
        self.query_count = query_count;
        self.query_version = ((self.query_version as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> retain_results(0, 0) }
    }
    // Rebuild the result table keeping only ids still present in the new
    // query list (upstream `retain` against the active id set).
    // `kept_count <= source_position` is the walk invariant (upstream's
    // retain shape); the table bound rides `kept_count < 16` at the keep.
    state retain_results(&mut self, source_position: u64, kept_count: u64) -> bool
    {
        // kept_count saturates the 16-slot table — finishing early on a full
        // keep table is upstream-equivalent (no source can be kept past it).
        transition source_position < self.query_result_count && source_position < 16 && kept_count < 16 {
            true -> check_keep(source_position, kept_count)
            false -> finish_retain(kept_count)
        }
    }
    state check_keep(&mut self, source_position: u64, kept_count: u64) -> bool
        requires source_position < 16 && kept_count < 16;
    {
        let mut kept_query_id: [u8; 128];
        let mut kept_query_id_len: u64 = 0;
        copy_result_id(&self.query_result_ids[source_position], self.query_result_id_lens[source_position], &mut kept_query_id, &mut kept_query_id_len);
        transition { _ -> probe_queries(&kept_query_id, kept_query_id_len, source_position, kept_count, 0) }
    }
    state probe_queries(&mut self, kept_query_id: &[u8; 128], kept_query_id_len: u64, source_position: u64, kept_count: u64, query_position: u64) -> bool
        requires source_position < 16 && kept_count < 16;
    {
        transition query_position < self.query_count && query_position < 16 {
            true -> compare_query(kept_query_id, kept_query_id_len, source_position, kept_count, query_position)
            false -> drop_one(source_position, kept_count)
        }
    }
    state compare_query(&mut self, kept_query_id: &[u8; 128], kept_query_id_len: u64, source_position: u64, kept_count: u64, query_position: u64) -> bool
        requires source_position < 16 && kept_count < 16;
    {
        let mut active_query_id: [u8; 128];
        let mut active_query_id_len: u64 = 0;
        self.queries[query_position].copy_query_id_into(&mut active_query_id, &mut active_query_id_len);
        transition active_query_id_len == kept_query_id_len && kept_query_id_len <= 128 {
            true -> bytes_match(kept_query_id, kept_query_id_len, &active_query_id, source_position, kept_count, query_position, 0)
            false -> probe_queries(kept_query_id, kept_query_id_len, source_position, kept_count, ((query_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state bytes_match(&mut self, kept_query_id: &[u8; 128], kept_query_id_len: u64, active_query_id: &[u8; 128], source_position: u64, kept_count: u64, query_position: u64, index: u64) -> bool
        requires source_position < 16 && kept_count < 16;
    {
        transition index < kept_query_id_len && index < 128 {
            true -> match_char(kept_query_id, kept_query_id_len, active_query_id, source_position, kept_count, query_position, index)
            false -> keep_one(source_position, kept_count)
        }
    }
    state match_char(&mut self, kept_query_id: &[u8; 128], kept_query_id_len: u64, active_query_id: &[u8; 128], source_position: u64, kept_count: u64, query_position: u64, index: u64) -> bool
        requires index < kept_query_id_len && index < 128 && source_position < 16 && kept_count < 16;
    {
        transition kept_query_id[index] == active_query_id[index] {
            true -> bytes_match(kept_query_id, kept_query_id_len, active_query_id, source_position, kept_count, query_position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> probe_queries(kept_query_id, kept_query_id_len, source_position, kept_count, ((query_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state keep_one(&mut self, source_position: u64, kept_count: u64) -> bool
        requires source_position < 16 && kept_count < 16;
    {
        // `kept_count <= source_position` by the walk invariant, so the
        // clone-down never reads a slot already overwritten.
        let kept_result: VirtualSnapshotQueryResult = self.query_results[source_position].clone();
        self.query_results[kept_count].clone_from(&kept_result);
        self.query_result_ids[kept_count] = self.query_result_ids[source_position];
        self.query_result_id_lens[kept_count] = self.query_result_id_lens[source_position];
        transition { _ -> retain_results(((source_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, ((kept_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state drop_one(&mut self, source_position: u64, kept_count: u64) -> bool
        requires source_position < 16;
    {
        transition { _ -> retain_results(((source_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, kept_count) }
    }
    state finish_retain(&mut self, kept_count: u64) -> bool {
        self.query_result_count = kept_count;
        (true)
    }
}

// Upstream `should_refresh` — now is caller-supplied millis.
pub machine VirtualSnapshot::should_refresh(&self, now_millis: u64) -> bool {
    transition self.query_count == 0 || self.is_refresh_in_progress {
        true -> (false)
        false -> check_version(now_millis)
        _ -> (false)
    }
    state check_version(&self, now_millis: u64) -> bool {
        transition !self.has_last_applied_query_version || self.last_applied_query_version != self.query_version {
            true -> (true)
            false -> check_elapsed(now_millis)
        }
    }
    state check_elapsed(&self, now_millis: u64) -> bool {
        transition self.has_last_refresh_completed_millis {
            true -> elapsed(now_millis)
            false -> (true)
        }
    }
    state elapsed(&self, now_millis: u64) -> bool {
        transition now_millis >= self.last_refresh_completed_millis && now_millis - self.last_refresh_completed_millis >= self.refresh_interval_millis {
            true -> (true)
            false -> (false)
        }
    }
}

pub machine VirtualSnapshot::can_force_refresh(&self) -> bool {
    transition self.query_count > 0 && !self.is_refresh_in_progress {
        true -> (true)
        false -> (false)
        _ -> (false)
    }
}

pub machine VirtualSnapshot::mark_dirty(&mut self) {
    self.query_version = ((self.query_version as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
}

pub machine VirtualSnapshot::mark_refresh_started(&mut self, now_millis: u64) -> u64 {
    self.last_refresh_started_millis = now_millis;
    self.has_last_refresh_started_millis = true;
    self.is_refresh_in_progress = true;
    self.refresh_in_progress_query_version = self.query_version;
    self.has_refresh_in_progress_query_version = true;
    self.query_version
}

pub machine VirtualSnapshot::get_refresh_in_progress_query_version(&self) -> u64 {
    self.refresh_in_progress_query_version
}

// Upstream `apply_refresh_results` — version-mismatch applies are dropped
// (a stale refresh racing newer queries). Results arrive via the parallel
// id/result tables the materializer fills.
pub machine VirtualSnapshot::apply_refresh_results(&mut self, refresh_query_version: u64, result_ids: &[[u8; 128]; 16], result_id_lens: &[u64; 16], query_results: &[VirtualSnapshotQueryResult; 16], query_result_count: u64, now_millis: u64) -> bool {
    transition !self.has_refresh_in_progress_query_version || self.refresh_in_progress_query_version != refresh_query_version {
        true -> (false)
        false -> apply(refresh_query_version, result_ids, result_id_lens, query_results, query_result_count, now_millis)
        _ -> (false)
    }
    state apply(&mut self, refresh_query_version: u64, result_ids: &[[u8; 128]; 16], result_id_lens: &[u64; 16], query_results: &[VirtualSnapshotQueryResult; 16], query_result_count: u64, now_millis: u64) -> bool {
        transition { _ -> fill(result_ids, result_id_lens, query_results, query_result_count, now_millis, refresh_query_version, 0) }
    }
    state fill(&mut self, result_ids: &[[u8; 128]; 16], result_id_lens: &[u64; 16], query_results: &[VirtualSnapshotQueryResult; 16], query_result_count: u64, now_millis: u64, refresh_query_version: u64, position: u64) -> bool

    {
        transition position < query_result_count && position < 16 {
            true -> fill_one(result_ids, result_id_lens, query_results, query_result_count, now_millis, refresh_query_version, position)
            false -> finish(query_result_count, now_millis, refresh_query_version)
        }
    }
    state fill_one(&mut self, result_ids: &[[u8; 128]; 16], result_id_lens: &[u64; 16], query_results: &[VirtualSnapshotQueryResult; 16], query_result_count: u64, now_millis: u64, refresh_query_version: u64, position: u64) -> bool
        requires position < query_result_count && position < 16;
    {
        self.query_result_ids[position] = result_ids[position];
        self.query_result_id_lens[position] = result_id_lens[position];
        self.query_results[position].clone_from(&query_results[position]);
        transition { _ -> fill(result_ids, result_id_lens, query_results, query_result_count, now_millis, refresh_query_version, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(&mut self, query_result_count: u64, now_millis: u64, refresh_query_version: u64) -> bool {
        self.query_result_count = query_result_count;
        self.last_applied_query_version = refresh_query_version;
        self.has_last_applied_query_version = true;
        self.last_refresh_completed_millis = now_millis;
        self.has_last_refresh_completed_millis = true;
        self.is_refresh_in_progress = false;
        self.has_refresh_in_progress_query_version = false;
        self.generation = ((self.generation as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine VirtualSnapshot::cancel_refresh_if_version_matches(&mut self, refresh_query_version: u64) {
    transition self.has_refresh_in_progress_query_version && self.refresh_in_progress_query_version == refresh_query_version {
        true -> cancel()
        false -> done()
        _ -> done()
    }
    state cancel(&mut self) {
        self.is_refresh_in_progress = false;
        self.has_refresh_in_progress_query_version = false;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

// Inserts or replaces a result keyed by query id — the materializer's
// per-query insert.
pub machine VirtualSnapshot::set_query_result(&mut self, query_id: &[u8], query_result: &VirtualSnapshotQueryResult) -> bool {
    transition { _ -> find(query_id, query_result, 0) }
    state find(&mut self, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, position: u64) -> bool {
        transition position < self.query_result_count && position < 16 {
            true -> compare(query_id, query_result, position)
            false -> insert(query_id, query_result)
        }
    }
    state compare(&mut self, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, position: u64) -> bool
        requires position < 16;
    {
        transition self.query_result_id_lens[position] == query_id.len && query_id.len <= 128 {
            true -> probe(query_id, query_result, position, 0)
            false -> find(query_id, query_result, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state probe(&mut self, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, position: u64, index: u64) -> bool
        requires position < 16;
    {
        transition index < query_id.len && index < 128 {
            true -> check_char(query_id, query_result, position, index)
            false -> overwrite(query_id, query_result, position)
        }
    }
    state check_char(&mut self, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, position: u64, index: u64) -> bool
        requires index < query_id.len && index < 128 && position < 16;
    {
        transition self.query_result_ids[position][index] == query_id[index] {
            true -> probe(query_id, query_result, position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> find(query_id, query_result, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state overwrite(&mut self, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, position: u64) -> bool
        requires position < 16;
    {
        self.query_results[position].clone_from(query_result);
        (true)
    }
    state insert(&mut self, query_id: &[u8], query_result: &VirtualSnapshotQueryResult) -> bool {
        transition self.query_result_count < 16 && query_id.len <= 128 {
            true -> store(query_id, query_result, 0)
            false -> (false)
        }
    }
    state store(&mut self, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, index: u64) -> bool
        requires self.query_result_count < 16;
    {
        transition index < query_id.len && index < 128 {
            true -> store_char(query_id, query_result, index)
            false -> store_finish(query_id, query_result)
        }
    }
    state store_char(&mut self, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, index: u64) -> bool
        requires index < query_id.len && index < 128 && self.query_result_count < 16;
    {
        self.query_result_ids[self.query_result_count][index] = query_id[index];
        transition { _ -> store(query_id, query_result, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state store_finish(&mut self, query_id: &[u8], query_result: &VirtualSnapshotQueryResult) -> bool
        requires self.query_result_count < 16;
    {
        self.query_result_id_lens[self.query_result_count] = query_id.len;
        self.query_results[self.query_result_count].clone_from(query_result);
        self.query_result_count = ((self.query_result_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

machine copy_result_id(source: &[u8; 128], source_len: u64, destination: &mut [u8; 128], destination_len: &mut u64) {
    transition { _ -> copy(source, source_len, destination, destination_len, 0) }
    state copy(source: &[u8; 128], source_len: u64, destination: &mut [u8; 128], destination_len: &mut u64, position: u64) {
        transition position < source_len && position < 128 {
            true -> copy_one(source, source_len, destination, destination_len, position)
            false -> finish(source_len, destination_len)
        }
    }
    state copy_one(source: &[u8; 128], source_len: u64, destination: &mut [u8; 128], destination_len: &mut u64, position: u64) {
        destination[position] = source[position];
        transition { _ -> copy(source, source_len, destination, destination_len, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(source_len: u64, destination_len: &mut u64) {
        destination_len = source_len;
        transition { _ -> done() }
    }
    state done() {
    }
}

// Explicit copy — the synthesized `clone_from` selection does not emit a
// resolved occurrence on this record shape (large nested record arrays),
// so upstream's `Clone` derive is ported as a field-wise copy.
pub machine VirtualSnapshot::copy_from(&mut self, source: &VirtualSnapshot) {
    self.query_count = source.query_count;
    self.query_result_count = source.query_result_count;
    self.refresh_interval_millis = source.refresh_interval_millis;
    self.query_version = source.query_version;
    self.has_last_applied_query_version = source.has_last_applied_query_version;
    self.last_applied_query_version = source.last_applied_query_version;
    self.has_last_refresh_started_millis = source.has_last_refresh_started_millis;
    self.last_refresh_started_millis = source.last_refresh_started_millis;
    self.has_last_refresh_completed_millis = source.has_last_refresh_completed_millis;
    self.last_refresh_completed_millis = source.last_refresh_completed_millis;
    self.is_refresh_in_progress = source.is_refresh_in_progress;
    self.has_refresh_in_progress_query_version = source.has_refresh_in_progress_query_version;
    self.refresh_in_progress_query_version = source.refresh_in_progress_query_version;
    self.generation = source.generation;
    transition { _ -> copy_queries(source, 0) }
    state copy_queries(&mut self, source: &VirtualSnapshot, position: u64) {
        transition position < 16 {
            true -> copy_query_at(source, position)
            _ -> copy_result_ids(source, 0)
        }
    }
    state copy_query_at(&mut self, source: &VirtualSnapshot, position: u64)
        requires position < 16;
    {
        self.queries[position].clone_from(&source.queries[position]);
        let next_position: u64 = position + 1;
        transition { _ -> copy_queries(source, next_position) }
    }
    state copy_result_ids(&mut self, source: &VirtualSnapshot, position: u64) {
        transition position < 16 {
            true -> copy_result_id_at(source, position)
            _ -> copy_results(source, 0)
        }
    }
    state copy_result_id_at(&mut self, source: &VirtualSnapshot, position: u64)
        requires position < 16;
    {
        copy_result_id(&source.query_result_ids[position], source.query_result_id_lens[position], &mut self.query_result_ids[position], &mut self.query_result_id_lens[position]);
        let next_position: u64 = position + 1;
        transition { _ -> copy_result_ids(source, next_position) }
    }
    state copy_results(&mut self, source: &VirtualSnapshot, position: u64) {
        transition position < 16 {
            true -> copy_result_at(source, position)
            _ -> done()
        }
    }
    state copy_result_at(&mut self, source: &VirtualSnapshot, position: u64)
        requires position < 16;
    {
        self.query_results[position].clone_from(&source.query_results[position]);
        let next_position: u64 = position + 1;
        transition { _ -> copy_results(source, next_position) }
    }
    state done(&mut self) {
    }
}
