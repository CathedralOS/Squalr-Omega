module src::virtual_snapshots::virtual_snapshot;

use src::virtual_snapshots::virtual_snapshot_query::VirtualSnapshotQuery;
use src::virtual_snapshots::virtual_snapshot_query_result::VirtualSnapshotQueryResult;

// Port of virtual_snapshots/virtual_snapshot.rs. `Vec<VirtualSnapshotQuery>`
// and `HashMap<String, VirtualSnapshotQueryResult>` become bounded tables
// (16 queries / 16 results — snapshot watch lists are UI-scale; refuse on
// overflow, documented). `Duration`/`Instant` become caller-supplied
// `*_millis` values — Omega has no clock trait here; the composition root
// feeds `now_millis`. `Option<u64>` timestamps carry has_ flags.
pub data VirtualSnapshot {
    queries: [VirtualSnapshotQuery; 16];
    query_count: u64;
    query_result_ids: [[u8; 128]; 16];
    query_result_id_lens: [u64; 16];
    query_results: [VirtualSnapshotQueryResult; 16];
    query_result_count: u64;
    refresh_interval_millis: u64;
    query_version: u64;
    has_last_applied_query_version: bool;
    last_applied_query_version: u64;
    has_last_refresh_started_millis: bool;
    last_refresh_started_millis: u64;
    has_last_refresh_completed_millis: bool;
    last_refresh_completed_millis: u64;
    is_refresh_in_progress: bool;
    has_refresh_in_progress_query_version: bool;
    refresh_in_progress_query_version: u64;
    generation: u64;
}

pub machine VirtualSnapshot::new(refresh_interval_millis: u64) -> VirtualSnapshot {
    VirtualSnapshot {
        query_count: 0,
        query_result_count: 0,
        refresh_interval_millis: refresh_interval_millis,
        query_version: 0,
        has_last_applied_query_version: false,
        last_applied_query_version: 0,
        has_last_refresh_started_millis: false,
        last_refresh_started_millis: 0,
        has_last_refresh_completed_millis: false,
        last_refresh_completed_millis: 0,
        is_refresh_in_progress: false,
        has_refresh_in_progress_query_version: false,
        refresh_in_progress_query_version: 0,
        generation: 0,
    }
}

pub machine VirtualSnapshot::get_query_count(this: &VirtualSnapshot) -> u64 {
    this.query_count
}

pub machine VirtualSnapshot::copy_query(this: &VirtualSnapshot, position: u64, out_query: &mut VirtualSnapshotQuery) -> bool {
    transition position < this.query_count && position < 16 {
        true -> read(this, position, out_query)
        false -> (false)
        _ -> (false)
    }
    state read(this: &VirtualSnapshot, position: u64, out_query: &mut VirtualSnapshotQuery) -> bool
        requires position < 16;
    {
        VirtualSnapshotQuery::clone_from(&mut out_query, &this.queries[position]);
        (true)
    }
}

pub machine VirtualSnapshot::get_generation(this: &VirtualSnapshot) -> u64 {
    this.generation
}

pub machine VirtualSnapshot::get_has_last_refresh_completed_millis(this: &VirtualSnapshot) -> bool {
    this.has_last_refresh_completed_millis
}

pub machine VirtualSnapshot::get_last_refresh_completed_millis(this: &VirtualSnapshot) -> u64 {
    this.last_refresh_completed_millis
}

pub machine VirtualSnapshot::get_is_refresh_in_progress(this: &VirtualSnapshot) -> bool {
    this.is_refresh_in_progress
}

pub machine VirtualSnapshot::set_refresh_interval(this: &mut VirtualSnapshot, refresh_interval_millis: u64) {
    this.refresh_interval_millis = refresh_interval_millis;
}

// Result table reads — position-indexed like the project's tables; the
// query id keys live in the parallel `*_ids`/`*_id_lens` arrays.
pub machine VirtualSnapshot::get_query_result_count(this: &VirtualSnapshot) -> u64 {
    this.query_result_count
}

pub machine VirtualSnapshot::find_query_result_position(this: &VirtualSnapshot, query_id: &[u8]) -> u64 {
    transition { _ -> walk(this, query_id, 0) }
    state walk(this: &VirtualSnapshot, query_id: &[u8], position: u64) -> u64 {
        transition position < this.query_result_count && position < 16 {
            true -> compare(this, query_id, position)
            false -> (16)
        }
    }
    state compare(this: &VirtualSnapshot, query_id: &[u8], position: u64) -> u64 {
        transition this.query_result_id_lens[position] == query_id.len && query_id.len <= 128 {
            true -> probe(this, query_id, position, 0)
            false -> walk(this, query_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state probe(this: &VirtualSnapshot, query_id: &[u8], position: u64, index: u64) -> u64

    {
        transition index < query_id.len && index < 128 {
            true -> check_char(this, query_id, position, index)
            false -> (position)
        }
    }
    state check_char(this: &VirtualSnapshot, query_id: &[u8], position: u64, index: u64) -> u64
        requires index < query_id.len && index < 128;
    {
        transition this.query_result_ids[position][index] == query_id[index] {
            true -> probe(this, query_id, position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> walk(this, query_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

pub machine VirtualSnapshot::copy_query_result(this: &VirtualSnapshot, position: u64, out_result: &mut VirtualSnapshotQueryResult) -> bool {
    transition position < this.query_result_count && position < 16 {
        true -> read(this, position, out_result)
        false -> (false)
        _ -> (false)
    }
    state read(this: &VirtualSnapshot, position: u64, out_result: &mut VirtualSnapshotQueryResult) -> bool
        requires position < 16;
    {
        VirtualSnapshotQueryResult::clone_from(&mut out_result, &this.query_results[position]);
        (true)
    }
}

// Upstream `set_queries` — equal lists are a no-op; otherwise the query
// list is replaced, the version bumps, and results keyed by ids that left
// the list are retained/dropped (upstream `retain`).
pub machine VirtualSnapshot::set_queries(this: &mut VirtualSnapshot, queries: &[VirtualSnapshotQuery; 16], query_count: u64) -> bool {
    transition query_count <= 16 {
        true -> check_equal(this, queries, query_count)
        false -> (false)
        _ -> (false)
    }
    state check_equal(this: &mut VirtualSnapshot, queries: &[VirtualSnapshotQuery; 16], query_count: u64) -> bool {
        transition query_count == this.query_count {
            true -> compare_each(this, queries, query_count, 0)
            false -> replace(this, queries, query_count)
        }
    }
    state compare_each(this: &mut VirtualSnapshot, queries: &[VirtualSnapshotQuery; 16], query_count: u64, position: u64) -> bool
    {
        transition position < query_count && position < 16 {
            true -> compare_one(this, queries, query_count, position)
            false -> (true)
        }
    }
    state compare_one(this: &mut VirtualSnapshot, queries: &[VirtualSnapshotQuery; 16], query_count: u64, position: u64) -> bool
        requires position < query_count && position < 16;
    {
        let hoist1: bool = VirtualSnapshotQuery::equals(&this.queries[position], &queries[position]);
        transition hoist1 {
            true -> compare_each(this, queries, query_count, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> replace(this, queries, query_count)
        }
    }
    state replace(this: &mut VirtualSnapshot, queries: &[VirtualSnapshotQuery; 16], query_count: u64) -> bool {
        transition { _ -> fill(this, queries, query_count, 0) }
    }
    state fill(this: &mut VirtualSnapshot, queries: &[VirtualSnapshotQuery; 16], query_count: u64, position: u64) -> bool
    {
        transition position < query_count && position < 16 {
            true -> fill_one(this, queries, query_count, position)
            false -> finish_fill(this, query_count)
        }
    }
    state fill_one(this: &mut VirtualSnapshot, queries: &[VirtualSnapshotQuery; 16], query_count: u64, position: u64) -> bool
        requires position < query_count && position < 16;
    {
        VirtualSnapshotQuery::clone_from(&mut this.queries[position], &queries[position]);
        transition { _ -> fill(this, queries, query_count, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_fill(this: &mut VirtualSnapshot, query_count: u64) -> bool {
        this.query_count = query_count;
        this.query_version = ((this.query_version as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> retain_results(this, 0, 0) }
    }
    // Rebuild the result table keeping only ids still present in the new
    // query list (upstream `retain` against the active id set).
    // `kept_count <= source_position` is the walk invariant (upstream's
    // retain shape); the table bound rides `kept_count < 16` at the keep.
    state retain_results(this: &mut VirtualSnapshot, source_position: u64, kept_count: u64) -> bool
    {
        // kept_count saturates the 16-slot table — finishing early on a full
        // keep table is upstream-equivalent (no source can be kept past it).
        transition source_position < this.query_result_count && source_position < 16 && kept_count < 16 {
            true -> check_keep(this, source_position, kept_count)
            false -> finish_retain(this, kept_count)
        }
    }
    state check_keep(this: &mut VirtualSnapshot, source_position: u64, kept_count: u64) -> bool
        requires source_position < 16 && kept_count < 16;
    {
        let mut kept_query_id: [u8; 128];
        let mut kept_query_id_len: u64 = 0;
        copy_result_id(&this.query_result_ids[source_position], this.query_result_id_lens[source_position], &mut kept_query_id, &mut kept_query_id_len);
        transition { _ -> probe_queries(this, &kept_query_id, kept_query_id_len, source_position, kept_count, 0, query_count) }
    }
    state probe_queries(this: &mut VirtualSnapshot, kept_query_id: &[u8; 128], kept_query_id_len: u64, source_position: u64, kept_count: u64, query_position: u64, query_count: u64) -> bool
        requires source_position < 16 && kept_count < 16;
    {
        transition query_position < this.query_count && query_position < 16 {
            true -> compare_query(this, kept_query_id, kept_query_id_len, source_position, kept_count, query_position, queries)
            false -> drop_one(this, source_position, kept_count)
        }
    }
    state compare_query(this: &mut VirtualSnapshot, kept_query_id: &[u8; 128], kept_query_id_len: u64, source_position: u64, kept_count: u64, query_position: u64, queries: &[VirtualSnapshotQuery; 16]) -> bool
        requires source_position < 16 && kept_count < 16;
    {
        let mut active_query_id: [u8; 128];
        let mut active_query_id_len: u64 = 0;
        VirtualSnapshotQuery::copy_query_id_into(&this.queries[query_position], &mut active_query_id, &mut active_query_id_len);
        transition active_query_id_len == kept_query_id_len && kept_query_id_len <= 128 {
            true -> bytes_match(this, kept_query_id, kept_query_id_len, &active_query_id, source_position, kept_count, query_position, 0)
            false -> probe_queries(this, kept_query_id, kept_query_id_len, source_position, kept_count, ((query_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, query_count)
        }
    }
    state bytes_match(this: &mut VirtualSnapshot, kept_query_id: &[u8; 128], kept_query_id_len: u64, active_query_id: &[u8; 128], source_position: u64, kept_count: u64, query_position: u64, index: u64) -> bool
        requires source_position < 16 && kept_count < 16;
    {
        transition index < kept_query_id_len && index < 128 {
            true -> match_char(this, kept_query_id, kept_query_id_len, active_query_id, source_position, kept_count, query_position, index)
            false -> keep_one(this, source_position, kept_count)
        }
    }
    state match_char(this: &mut VirtualSnapshot, kept_query_id: &[u8; 128], kept_query_id_len: u64, active_query_id: &[u8; 128], source_position: u64, kept_count: u64, query_position: u64, index: u64) -> bool
        requires index < kept_query_id_len && index < 128 && source_position < 16 && kept_count < 16;
    {
        transition kept_query_id[index] == active_query_id[index] {
            true -> bytes_match(this, kept_query_id, kept_query_id_len, active_query_id, source_position, kept_count, query_position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> probe_queries(this, kept_query_id, kept_query_id_len, source_position, kept_count, ((query_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, query_count)
        }
    }
    state keep_one(this: &mut VirtualSnapshot, source_position: u64, kept_count: u64) -> bool
        requires source_position < 16 && kept_count < 16;
    {
        // `kept_count <= source_position` by the walk invariant, so the
        // clone-down never reads a slot already overwritten.
        let kept_result: VirtualSnapshotQueryResult = VirtualSnapshotQueryResult::clone(&this.query_results[source_position]);
        VirtualSnapshotQueryResult::clone_from(&mut this.query_results[kept_count], &kept_result);
        this.query_result_ids[kept_count] = this.query_result_ids[source_position];
        this.query_result_id_lens[kept_count] = this.query_result_id_lens[source_position];
        transition { _ -> retain_results(this, ((source_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, ((kept_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state drop_one(this: &mut VirtualSnapshot, source_position: u64, kept_count: u64) -> bool
        requires source_position < 16;
    {
        transition { _ -> retain_results(this, ((source_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, kept_count) }
    }
    state finish_retain(this: &mut VirtualSnapshot, kept_count: u64) -> bool {
        this.query_result_count = kept_count;
        (true)
    }
}

// Upstream `should_refresh` — now is caller-supplied millis.
pub machine VirtualSnapshot::should_refresh(this: &VirtualSnapshot, now_millis: u64) -> bool {
    transition this.query_count == 0 || this.is_refresh_in_progress {
        true -> (false)
        false -> check_version(this, now_millis)
        _ -> (false)
    }
    state check_version(this: &VirtualSnapshot, now_millis: u64) -> bool {
        transition !this.has_last_applied_query_version || this.last_applied_query_version != this.query_version {
            true -> (true)
            false -> check_elapsed(this, now_millis)
        }
    }
    state check_elapsed(this: &VirtualSnapshot, now_millis: u64) -> bool {
        transition this.has_last_refresh_completed_millis {
            true -> elapsed(this, now_millis)
            false -> (true)
        }
    }
    state elapsed(this: &VirtualSnapshot, now_millis: u64) -> bool {
        transition now_millis >= this.last_refresh_completed_millis && now_millis - this.last_refresh_completed_millis >= this.refresh_interval_millis {
            true -> (true)
            false -> (false)
        }
    }
}

pub machine VirtualSnapshot::can_force_refresh(this: &VirtualSnapshot) -> bool {
    transition this.query_count > 0 && !this.is_refresh_in_progress {
        true -> (true)
        false -> (false)
        _ -> (false)
    }
}

pub machine VirtualSnapshot::mark_dirty(this: &mut VirtualSnapshot) {
    this.query_version = ((this.query_version as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
}

pub machine VirtualSnapshot::mark_refresh_started(this: &mut VirtualSnapshot, now_millis: u64) -> u64 {
    this.last_refresh_started_millis = now_millis;
    this.has_last_refresh_started_millis = true;
    this.is_refresh_in_progress = true;
    this.refresh_in_progress_query_version = this.query_version;
    this.has_refresh_in_progress_query_version = true;
    this.query_version
}

pub machine VirtualSnapshot::get_refresh_in_progress_query_version(this: &VirtualSnapshot) -> u64 {
    this.refresh_in_progress_query_version
}

// Upstream `apply_refresh_results` — version-mismatch applies are dropped
// (a stale refresh racing newer queries). Results arrive via the parallel
// id/result tables the materializer fills.
pub machine VirtualSnapshot::apply_refresh_results(this: &mut VirtualSnapshot, refresh_query_version: u64, result_ids: &[[u8; 128]; 16], result_id_lens: &[u64; 16], query_results: &[VirtualSnapshotQueryResult; 16], query_result_count: u64, now_millis: u64) -> bool {
    transition !this.has_refresh_in_progress_query_version || this.refresh_in_progress_query_version != refresh_query_version {
        true -> (false)
        false -> apply(this, refresh_query_version, result_ids, result_id_lens, query_results, query_result_count, now_millis)
        _ -> (false)
    }
    state apply(this: &mut VirtualSnapshot, refresh_query_version: u64, result_ids: &[[u8; 128]; 16], result_id_lens: &[u64; 16], query_results: &[VirtualSnapshotQueryResult; 16], query_result_count: u64, now_millis: u64) -> bool {
        transition { _ -> fill(this, result_ids, result_id_lens, query_results, query_result_count, now_millis, refresh_query_version, 0) }
    }
    state fill(this: &mut VirtualSnapshot, result_ids: &[[u8; 128]; 16], result_id_lens: &[u64; 16], query_results: &[VirtualSnapshotQueryResult; 16], query_result_count: u64, now_millis: u64, refresh_query_version: u64, position: u64) -> bool

    {
        transition position < query_result_count && position < 16 {
            true -> fill_one(this, result_ids, result_id_lens, query_results, query_result_count, now_millis, refresh_query_version, position)
            false -> finish(this, query_result_count, now_millis, refresh_query_version)
        }
    }
    state fill_one(this: &mut VirtualSnapshot, result_ids: &[[u8; 128]; 16], result_id_lens: &[u64; 16], query_results: &[VirtualSnapshotQueryResult; 16], query_result_count: u64, now_millis: u64, refresh_query_version: u64, position: u64) -> bool
        requires position < query_result_count && position < 16;
    {
        this.query_result_ids[position] = result_ids[position];
        this.query_result_id_lens[position] = result_id_lens[position];
        VirtualSnapshotQueryResult::clone_from(&mut this.query_results[position], &query_results[position]);
        transition { _ -> fill(this, result_ids, result_id_lens, query_results, query_result_count, now_millis, refresh_query_version, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(this: &mut VirtualSnapshot, query_result_count: u64, now_millis: u64, refresh_query_version: u64) -> bool {
        this.query_result_count = query_result_count;
        this.last_applied_query_version = refresh_query_version;
        this.has_last_applied_query_version = true;
        this.last_refresh_completed_millis = now_millis;
        this.has_last_refresh_completed_millis = true;
        this.is_refresh_in_progress = false;
        this.has_refresh_in_progress_query_version = false;
        this.generation = ((this.generation as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine VirtualSnapshot::cancel_refresh_if_version_matches(this: &mut VirtualSnapshot, refresh_query_version: u64) {
    transition this.has_refresh_in_progress_query_version && this.refresh_in_progress_query_version == refresh_query_version {
        true -> cancel(this)
        false -> done(this)
        _ -> done(this)
    }
    state cancel(this: &mut VirtualSnapshot) {
        this.is_refresh_in_progress = false;
        this.has_refresh_in_progress_query_version = false;
        transition { _ -> done(this) }
    }
    state done(this: &mut VirtualSnapshot) {
    }
}

// Inserts or replaces a result keyed by query id — the materializer's
// per-query insert.
pub machine VirtualSnapshot::set_query_result(this: &mut VirtualSnapshot, query_id: &[u8], query_result: &VirtualSnapshotQueryResult) -> bool {
    transition { _ -> find(this, query_id, query_result, 0) }
    state find(this: &mut VirtualSnapshot, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, position: u64) -> bool {
        transition position < this.query_result_count && position < 16 {
            true -> compare(this, query_id, query_result, position)
            false -> insert(this, query_id, query_result)
        }
    }
    state compare(this: &mut VirtualSnapshot, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, position: u64) -> bool
        requires position < 16;
    {
        transition this.query_result_id_lens[position] == query_id.len && query_id.len <= 128 {
            true -> probe(this, query_id, query_result, position, 0)
            false -> find(this, query_id, query_result, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state probe(this: &mut VirtualSnapshot, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, position: u64, index: u64) -> bool
        requires position < 16;
    {
        transition index < query_id.len && index < 128 {
            true -> check_char(this, query_id, query_result, position, index)
            false -> overwrite(this, query_id, query_result, position)
        }
    }
    state check_char(this: &mut VirtualSnapshot, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, position: u64, index: u64) -> bool
        requires index < query_id.len && index < 128 && position < 16;
    {
        transition this.query_result_ids[position][index] == query_id[index] {
            true -> probe(this, query_id, query_result, position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> find(this, query_id, query_result, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state overwrite(this: &mut VirtualSnapshot, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, position: u64) -> bool
        requires position < 16;
    {
        VirtualSnapshotQueryResult::clone_from(&mut this.query_results[position], query_result);
        (true)
    }
    state insert(this: &mut VirtualSnapshot, query_id: &[u8], query_result: &VirtualSnapshotQueryResult) -> bool {
        transition this.query_result_count < 16 && query_id.len <= 128 {
            true -> store(this, query_id, query_result, 0)
            false -> (false)
        }
    }
    state store(this: &mut VirtualSnapshot, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, index: u64) -> bool
        requires this.query_result_count < 16;
    {
        transition index < query_id.len && index < 128 {
            true -> store_char(this, query_id, query_result, index)
            false -> store_finish(this, query_id, query_result)
        }
    }
    state store_char(this: &mut VirtualSnapshot, query_id: &[u8], query_result: &VirtualSnapshotQueryResult, index: u64) -> bool
        requires index < query_id.len && index < 128 && this.query_result_count < 16;
    {
        this.query_result_ids[this.query_result_count][index] = query_id[index];
        transition { _ -> store(this, query_id, query_result, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state store_finish(this: &mut VirtualSnapshot, query_id: &[u8], query_result: &VirtualSnapshotQueryResult) -> bool
        requires this.query_result_count < 16;
    {
        this.query_result_id_lens[this.query_result_count] = query_id.len;
        VirtualSnapshotQueryResult::clone_from(&mut this.query_results[this.query_result_count], query_result);
        this.query_result_count = ((this.query_result_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

machine copy_result_id(source: &[u8; 128], source_len: u64, destination: &mut [u8; 128], destination_len: &mut u64) {
    transition { _ -> copy(source, source_len, destination, destination_len, 0) }
    state copy(source: &[u8; 128], source_len: u64, destination: &mut [u8; 128], destination_len: &mut u64, position: u64) {
        transition position < source_len && position < 128 {
            true -> copy_one(source, source_len, destination, destination_len, position)
            false -> finish(source_len, destination_len)
        }
    }
    state copy_one(source: &[u8; 128], source_len: u64, destination: &mut [u8; 128], destination_len: &mut u64, position: u64) {
        destination[position] = source[position];
        transition { _ -> copy(source, source_len, destination, destination_len, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(source_len: u64, destination_len: &mut u64) {
        destination_len = source_len;
        transition { _ -> done() }
    }
    state done() {
    }
}

// Explicit copy — the synthesized `clone_from` selection does not emit a
// resolved occurrence on this record shape (large nested record arrays),
// so upstream's `Clone` derive is ported as a field-wise copy.
pub machine VirtualSnapshot::copy_from(this: &mut VirtualSnapshot, source: &VirtualSnapshot) {
    this.query_count = source.query_count;
    this.query_result_count = source.query_result_count;
    this.refresh_interval_millis = source.refresh_interval_millis;
    this.query_version = source.query_version;
    this.has_last_applied_query_version = source.has_last_applied_query_version;
    this.last_applied_query_version = source.last_applied_query_version;
    this.has_last_refresh_started_millis = source.has_last_refresh_started_millis;
    this.last_refresh_started_millis = source.last_refresh_started_millis;
    this.has_last_refresh_completed_millis = source.has_last_refresh_completed_millis;
    this.last_refresh_completed_millis = source.last_refresh_completed_millis;
    this.is_refresh_in_progress = source.is_refresh_in_progress;
    this.has_refresh_in_progress_query_version = source.has_refresh_in_progress_query_version;
    this.refresh_in_progress_query_version = source.refresh_in_progress_query_version;
    this.generation = source.generation;
    transition { _ -> copy_queries(this, source, 0) }
    state copy_queries(this: &mut VirtualSnapshot, source: &VirtualSnapshot, position: u64) {
        transition position < 16 {
            true -> copy_query_at(this, source, position)
            _ -> copy_result_ids(this, source, 0)
        }
    }
    state copy_query_at(this: &mut VirtualSnapshot, source: &VirtualSnapshot, position: u64)
        requires position < 16;
    {
        VirtualSnapshotQuery::clone_from(&mut this.queries[position], &source.queries[position]);
        let next_position: u64 = position + 1;
        transition { _ -> copy_queries(this, source, next_position) }
    }
    state copy_result_ids(this: &mut VirtualSnapshot, source: &VirtualSnapshot, position: u64) {
        transition position < 16 {
            true -> copy_result_id_at(this, source, position)
            _ -> copy_results(this, source, 0)
        }
    }
    state copy_result_id_at(this: &mut VirtualSnapshot, source: &VirtualSnapshot, position: u64)
        requires position < 16;
    {
        copy_result_id(&source.query_result_ids[position], source.query_result_id_lens[position], &mut this.query_result_ids[position], &mut this.query_result_id_lens[position]);
        let next_position: u64 = position + 1;
        transition { _ -> copy_result_ids(this, source, next_position) }
    }
    state copy_results(this: &mut VirtualSnapshot, source: &VirtualSnapshot, position: u64) {
        transition position < 16 {
            true -> copy_result_at(this, source, position)
            _ -> done(this)
        }
    }
    state copy_result_at(this: &mut VirtualSnapshot, source: &VirtualSnapshot, position: u64)
        requires position < 16;
    {
        VirtualSnapshotQueryResult::clone_from(&mut this.query_results[position], &source.query_results[position]);
        let next_position: u64 = position + 1;
        transition { _ -> copy_results(this, source, next_position) }
    }
    state done(this: &mut VirtualSnapshot) {
    }
}
