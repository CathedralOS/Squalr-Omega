module src::virtual_snapshots::stored_pointer;

use squalr_engine_api::src::structures::bounded_byte_copy::BoundedByteCopy;
use squalr_engine_api::src::structures::bounded_slice::flagged_bounded_slice;

// Bounded carrier for the pointer chain — upstream `SymbolicPointerChainLink`
// is `Offset(i64) | Symbol(String)`; `Symbol` links can't be resolved by a
// memory read, so the record stores plain i64 offsets plus
// `has_unresolvable_link`/`unresolvable_link_index` — the materializer
// emits the upstream `??` bail on them.
// Owned carrier for `squalr_engine_api::structures::memory::pointer::
// Pointer<'offsets>` — the api type borrows its offsets slice behind a
// lifetime, so it cannot sit on a stored record; snapshot queries keep
// this owned shape (bounded 8-offset chain covers pointer depths used by
// snapshot watches — documented bound, upstream's offsets are a caller
// slice).
pub data StoredPointer {
    module_name: [u8; 512];
    module_name_len: u64;
    address: u64;
    offsets: [i64; 8];
    offset_count: u64;
    pointer_size: u64;
    has_unresolvable_link: bool;
    unresolvable_link_index: u64;
}

pub machine StoredPointer::new(module_name: &[u8], address: u64, offsets: &[i64], pointer_size: u64) -> StoredPointer {
    let mut stored_pointer: StoredPointer = StoredPointer::default();
    _ = stored_pointer.set_module_name(module_name);
    _ = stored_pointer.set_offsets(offsets);
    stored_pointer.pointer_size = pointer_size;
    stored_pointer.address = address;
    stored_pointer
}

pub machine StoredPointer::default() -> StoredPointer {
    StoredPointer {
        module_name_len: 0,
        address: 0,
        offset_count: 0,
        pointer_size: 8,
        has_unresolvable_link: false,
        unresolvable_link_index: 0,
    }
}

pub machine StoredPointer::get_module_name(&self) -> &[u8] {
    (slice_512(&self.module_name, self.module_name_len))
}

pub machine StoredPointer::set_module_name(&mut self, module_name: &[u8]) -> bool {
    transition module_name.len <= 512 {
        true -> copy(module_name)
        false -> (false)
        _ -> (false)
    }
    state copy(&mut self, module_name: &[u8]) -> bool {
        self.module_name_len = BoundedByteCopy::copy(&mut self.module_name[0..512], module_name);
        (true)
    }
}

pub machine StoredPointer::get_address(&self) -> u64 {
    self.address
}

pub machine StoredPointer::set_address(&mut self, address: u64) {
    self.address = address;
}

pub machine StoredPointer::get_offset_count(&self) -> u64 {
    self.offset_count
}

pub machine StoredPointer::get_offset(&self, position: u64) -> i64 {
    transition position < self.offset_count && position < 8 {
        true -> (self.offsets[position])
        false -> (0)
        _ -> (0)
    }
}

pub machine StoredPointer::get_has_unresolvable_link(&self) -> bool {
    self.has_unresolvable_link
}

pub machine StoredPointer::get_unresolvable_link_index(&self) -> u64 {
    self.unresolvable_link_index
}

pub machine StoredPointer::set_unresolvable_link(&mut self, link_index: u64) {
    self.has_unresolvable_link = true;
    self.unresolvable_link_index = link_index;
}

pub machine StoredPointer::set_offsets(&mut self, offsets: &[i64]) -> bool {
    transition offsets.len <= 8 {
        true -> copy(offsets, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(&mut self, offsets: &[i64], position: u64) -> bool

    {
        transition position < offsets.len && position < 8 {
            true -> copy_one(offsets, position)
            false -> finish(offsets)
        }
    }
    state copy_one(&mut self, offsets: &[i64], position: u64) -> bool
        requires position < offsets.len && position < 8;
    {
        self.offsets[position] = offsets[position];
        transition { _ -> copy(offsets, position + 1) }
    }
    state finish(&mut self, offsets: &[i64]) -> bool {
        self.offset_count = offsets.len;
        (true)
    }
}

pub machine StoredPointer::get_pointer_size(&self) -> u64 {
    self.pointer_size
}

pub machine StoredPointer::set_pointer_size(&mut self, pointer_size: u64) {
    self.pointer_size = pointer_size;
}

pub machine StoredPointer::clone(&self) -> StoredPointer {
    StoredPointer {
        module_name: self.module_name,
        module_name_len: self.module_name_len,
        address: self.address,
        offsets: self.offsets,
        offset_count: self.offset_count,
        pointer_size: self.pointer_size,
        has_unresolvable_link: self.has_unresolvable_link,
        unresolvable_link_index: self.unresolvable_link_index,
    }
}

pub machine StoredPointer::clone_from(&mut self, source: &StoredPointer) {
    self.module_name = source.module_name;
    self.module_name_len = source.module_name_len;
    self.address = source.address;
    self.offsets = source.offsets;
    self.offset_count = source.offset_count;
    self.pointer_size = source.pointer_size;
    self.has_unresolvable_link = source.has_unresolvable_link;
    self.unresolvable_link_index = source.unresolvable_link_index;
}

// Copies the module name into a caller-owned buffer.
pub machine StoredPointer::copy_module_name(&self, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64) {
    transition { _ -> copy(0, out_module_name, out_module_name_len) }
    state copy(&self, index: u64, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64)

    {
        transition index < self.module_name_len && index < 512 {
            true -> copy_byte(index, out_module_name, out_module_name_len)
            false -> finish(out_module_name_len)
        }
    }
    state copy_byte(&self, index: u64, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64)
        requires index < self.module_name_len && index < 512;
    {
        out_module_name[index] = self.module_name[index];
        transition { _ -> copy(index + 1, out_module_name, out_module_name_len) }
    }
    state finish(&self, out_module_name_len: &mut u64) {
        out_module_name_len = self.module_name_len;
    }
}

// Pointer equality over the owned carrier fields (upstream `Pointer`
// `PartialEq` — module, address, offsets, size).
pub machine StoredPointer::equals(&self, other: &StoredPointer) -> bool {
    transition self.address == other.address && self.offset_count == other.offset_count
        && self.pointer_size == other.pointer_size && self.module_name_len == other.module_name_len
        && self.has_unresolvable_link == other.has_unresolvable_link && self.unresolvable_link_index == other.unresolvable_link_index {
        true -> module(0, other)
        false -> (false)
        _ -> (false)
    }
    state module(&self, index: u64, other: &StoredPointer) -> bool

    {
        transition index < self.module_name_len && index < 512 {
            true -> module_byte(index, other)
            false -> offsets(0, other)
        }
    }
    state module_byte(&self, index: u64, other: &StoredPointer) -> bool
        requires index < self.module_name_len && index < 512;
    {
        transition self.module_name[index] == other.module_name[index] {
            true -> module(index + 1, other)
            false -> (false)
        }
    }
    state offsets(&self, index: u64, other: &StoredPointer) -> bool

    {
        transition index < self.offset_count && index < 8 {
            true -> offset_at(index, other)
            false -> (true)
        }
    }
    state offset_at(&self, index: u64, other: &StoredPointer) -> bool
        requires index < self.offset_count && index < 8;
    {
        transition self.offsets[index] == other.offsets[index] {
            true -> offsets(index + 1, other)
            false -> (false)
        }
    }
}

// Bounded `&input[0..len]` — the slice bound is re-verified inside the
// helper so each caller does not need a dominated proof of the stored
// length. An out-of-range `len` cannot happen upstream (writers bound
// every stored length), so the fallback is the empty slice.
pub machine slice_512(input: &[u8; 512], len: u64) -> &[u8] {
    flagged_bounded_slice(&input[0..512], len, true)
}
