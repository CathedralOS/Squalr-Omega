module src::virtual_snapshots::stored_pointer;

// Bounded carrier for the pointer chain — upstream `SymbolicPointerChainLink`
// is `Offset(i64) | Symbol(String)`; `Symbol` links can't be resolved by a
// memory read, so the record stores plain i64 offsets plus
// `has_unresolvable_link`/`unresolvable_link_index` — the materializer
// emits the upstream `??` bail on them.
// Owned carrier for `squalr_engine_api::structures::memory::pointer::
// Pointer<'offsets>` — the api type borrows its offsets slice behind a
// lifetime, so it cannot sit on a stored record; snapshot queries keep
// this owned shape (bounded 8-offset chain covers pointer depths used by
// snapshot watches — documented bound, upstream's offsets are a caller
// slice).
pub data StoredPointer {
    module_name: [u8; 512];
    module_name_len: u64;
    address: u64;
    offsets: [i64; 8];
    offset_count: u64;
    pointer_size: u64;
    has_unresolvable_link: bool;
    unresolvable_link_index: u64;
}

pub machine StoredPointer::new(module_name: &[u8], address: u64, offsets: &[i64], pointer_size: u64) -> StoredPointer {
    let mut stored_pointer: StoredPointer = StoredPointer::default();
    _ = StoredPointer::set_module_name(&mut stored_pointer, module_name);
    _ = StoredPointer::set_offsets(&mut stored_pointer, offsets);
    stored_pointer.pointer_size = pointer_size;
    stored_pointer.address = address;
    stored_pointer
}

pub machine StoredPointer::default() -> StoredPointer {
    StoredPointer {
        module_name_len: 0,
        address: 0,
        offset_count: 0,
        pointer_size: 8,
        has_unresolvable_link: false,
        unresolvable_link_index: 0,
    }
}

pub machine StoredPointer::get_module_name(this: &StoredPointer) -> &[u8] {
    let hoist1: &[u8] = slice_512(&this.module_name, this.module_name_len);
    (hoist1)
}

pub machine StoredPointer::set_module_name(this: &mut StoredPointer, module_name: &[u8]) -> bool {
    transition module_name.len <= 512 {
        true -> copy(this, module_name, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(this: &mut StoredPointer, module_name: &[u8], position: u64) -> bool

    {
        transition position < module_name.len && position < 512 {
            true -> copy_one(this, module_name, position)
            false -> finish(this, module_name)
        }
    }
    state copy_one(this: &mut StoredPointer, module_name: &[u8], position: u64) -> bool
        requires position < module_name.len && position < 512;
    {
        this.module_name[position] = module_name[position];
        transition { _ -> copy(this, module_name, position + 1) }
    }
    state finish(this: &mut StoredPointer, module_name: &[u8]) -> bool {
        this.module_name_len = module_name.len;
        (true)
    }
}

pub machine StoredPointer::get_address(this: &StoredPointer) -> u64 {
    this.address
}

pub machine StoredPointer::set_address(this: &mut StoredPointer, address: u64) {
    this.address = address;
}

pub machine StoredPointer::get_offset_count(this: &StoredPointer) -> u64 {
    this.offset_count
}

pub machine StoredPointer::get_offset(this: &StoredPointer, position: u64) -> i64 {
    transition position < this.offset_count && position < 8 {
        true -> (this.offsets[position])
        false -> (0)
        _ -> (0)
    }
}

pub machine StoredPointer::get_has_unresolvable_link(this: &StoredPointer) -> bool {
    this.has_unresolvable_link
}

pub machine StoredPointer::get_unresolvable_link_index(this: &StoredPointer) -> u64 {
    this.unresolvable_link_index
}

pub machine StoredPointer::set_unresolvable_link(this: &mut StoredPointer, link_index: u64) {
    this.has_unresolvable_link = true;
    this.unresolvable_link_index = link_index;
}

pub machine StoredPointer::set_offsets(this: &mut StoredPointer, offsets: &[i64]) -> bool {
    transition offsets.len <= 8 {
        true -> copy(this, offsets, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(this: &mut StoredPointer, offsets: &[i64], position: u64) -> bool

    {
        transition position < offsets.len && position < 8 {
            true -> copy_one(this, offsets, position)
            false -> finish(this, offsets)
        }
    }
    state copy_one(this: &mut StoredPointer, offsets: &[i64], position: u64) -> bool
        requires position < offsets.len && position < 8;
    {
        this.offsets[position] = offsets[position];
        transition { _ -> copy(this, offsets, position + 1) }
    }
    state finish(this: &mut StoredPointer, offsets: &[i64]) -> bool {
        this.offset_count = offsets.len;
        (true)
    }
}

pub machine StoredPointer::get_pointer_size(this: &StoredPointer) -> u64 {
    this.pointer_size
}

pub machine StoredPointer::set_pointer_size(this: &mut StoredPointer, pointer_size: u64) {
    this.pointer_size = pointer_size;
}

pub machine StoredPointer::clone(this: &StoredPointer) -> StoredPointer {
    StoredPointer {
        module_name: this.module_name,
        module_name_len: this.module_name_len,
        address: this.address,
        offsets: this.offsets,
        offset_count: this.offset_count,
        pointer_size: this.pointer_size,
        has_unresolvable_link: this.has_unresolvable_link,
        unresolvable_link_index: this.unresolvable_link_index,
    }
}

pub machine StoredPointer::clone_from(this: &mut StoredPointer, source: &StoredPointer) {
    this.module_name = source.module_name;
    this.module_name_len = source.module_name_len;
    this.address = source.address;
    this.offsets = source.offsets;
    this.offset_count = source.offset_count;
    this.pointer_size = source.pointer_size;
    this.has_unresolvable_link = source.has_unresolvable_link;
    this.unresolvable_link_index = source.unresolvable_link_index;
}

// Copies the module name into a caller-owned buffer.
pub machine StoredPointer::copy_module_name(this: &StoredPointer, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64) {
    transition { _ -> copy(this, 0, out_module_name, out_module_name_len) }
    state copy(this: &StoredPointer, index: u64, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64)

    {
        transition index < this.module_name_len && index < 512 {
            true -> copy_byte(this, index, out_module_name, out_module_name_len)
            false -> finish(this, out_module_name_len)
        }
    }
    state copy_byte(this: &StoredPointer, index: u64, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64)
        requires index < this.module_name_len && index < 512;
    {
        out_module_name[index] = this.module_name[index];
        transition { _ -> copy(this, index + 1, out_module_name, out_module_name_len) }
    }
    state finish(this: &StoredPointer, out_module_name_len: &mut u64) {
        out_module_name_len = this.module_name_len;
    }
}

// Pointer equality over the owned carrier fields (upstream `Pointer`
// `PartialEq` — module, address, offsets, size).
pub machine StoredPointer::equals(this: &StoredPointer, other: &StoredPointer) -> bool {
    transition this.address == other.address && this.offset_count == other.offset_count
        && this.pointer_size == other.pointer_size && this.module_name_len == other.module_name_len
        && this.has_unresolvable_link == other.has_unresolvable_link && this.unresolvable_link_index == other.unresolvable_link_index {
        true -> module(this, 0, other)
        false -> (false)
        _ -> (false)
    }
    state module(this: &StoredPointer, index: u64, other: &StoredPointer) -> bool

    {
        transition index < this.module_name_len && index < 512 {
            true -> module_byte(this, index, other)
            false -> offsets(this, 0, other)
        }
    }
    state module_byte(this: &StoredPointer, index: u64, other: &StoredPointer) -> bool
        requires index < this.module_name_len && index < 512;
    {
        transition this.module_name[index] == other.module_name[index] {
            true -> module(this, index + 1, other)
            false -> (false)
        }
    }
    state offsets(this: &StoredPointer, index: u64, other: &StoredPointer) -> bool

    {
        transition index < this.offset_count && index < 8 {
            true -> offset_at(this, index, other)
            false -> (true)
        }
    }
    state offset_at(this: &StoredPointer, index: u64, other: &StoredPointer) -> bool
        requires index < this.offset_count && index < 8;
    {
        transition this.offsets[index] == other.offsets[index] {
            true -> offsets(this, index + 1, other)
            false -> (false)
        }
    }
}

// Bounded `&input[0..len]` — the slice bound is re-verified inside the
// helper so each caller does not need a dominated proof of the stored
// length. An out-of-range `len` cannot happen upstream (writers bound
// every stored length), so the fallback is the empty slice.
pub machine slice_512(input: &[u8; 512], len: u64) -> &[u8] {
    transition len <= 512 {
        true -> bounded(input, len)
        _ -> (&input[0..0])
    }
    state bounded(input: &[u8; 512], len: u64) -> &[u8]
        requires len <= 512;
    {
        (&input[0..len])
    }
}
