module src::virtual_snapshots::virtual_snapshot_query;

use squalr_engine_api::src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;
use src::virtual_snapshots::stored_pointer::StoredPointer;

// Port of virtual_snapshots/virtual_snapshot_query.rs. Upstream is the
// enum `Address { query_id, address, module_name,
// symbolic_struct_definition }` / `Pointer { query_id, pointer,
// symbolic_struct_definition }`. Union payload fields are not writable
// post-construction, so the port uses the same kind-tag + record carrier
// as `EngineBindingError`: `kind` selects the arm, the arm's fields sit
// flat on the record, and `is_address`/`is_pointer` give the scrutinee
// semantics. `String` bounds follow the project conventions; the
// lifetime'd `Pointer` becomes the owned `StoredPointer`.
pub data VirtualSnapshotQueryKind [copy] {
    case Address;
    case Pointer;
}

pub machine VirtualSnapshotQueryKind::get_tag(&self) -> u64 {
    transition self {
        VirtualSnapshotQueryKind::Address -> (0)
        VirtualSnapshotQueryKind::Pointer -> (1)
        _ -> (255)
    }
}

pub data VirtualSnapshotQuery {
    kind: VirtualSnapshotQueryKind;
    query_id: [u8; 128];
    query_id_len: u64;
    address: u64;
    module_name: [u8; 512];
    module_name_len: u64;
    pointer: StoredPointer;
    symbolic_struct_definition: SymbolicStructDefinition;
}

pub machine VirtualSnapshotQuery::default() -> VirtualSnapshotQuery {
    VirtualSnapshotQuery {
        kind: VirtualSnapshotQueryKind::Address,
        query_id_len: 0,
        address: 0,
        module_name_len: 0,
        pointer: StoredPointer::default(),
        symbolic_struct_definition: SymbolicStructDefinition::empty(),
    }
}

pub machine VirtualSnapshotQuery::address(query_id: &[u8], address: u64, module_name: &[u8], symbolic_struct_definition: &SymbolicStructDefinition) -> VirtualSnapshotQuery {
    let mut query: VirtualSnapshotQuery = VirtualSnapshotQuery::default();
    query.kind = VirtualSnapshotQueryKind::Address;
    _ = query.set_query_id(query_id);
    query.address = address;
    _ = query.set_module_name(module_name);
    query.symbolic_struct_definition.clone_from(symbolic_struct_definition);
    query
}

pub machine VirtualSnapshotQuery::pointer(query_id: &[u8], pointer: &StoredPointer, symbolic_struct_definition: &SymbolicStructDefinition) -> VirtualSnapshotQuery {
    let mut query: VirtualSnapshotQuery = VirtualSnapshotQuery::default();
    query.kind = VirtualSnapshotQueryKind::Pointer;
    _ = query.set_query_id(query_id);
    query.pointer.clone_from(pointer);
    query.symbolic_struct_definition.clone_from(symbolic_struct_definition);
    query
}

pub machine VirtualSnapshotQuery::get_is_address(&self) -> bool {
    transition self.kind {
        VirtualSnapshotQueryKind::Address -> (true)
        _ -> (false)
    }
}

pub machine VirtualSnapshotQuery::get_is_pointer(&self) -> bool {
    transition self.kind {
        VirtualSnapshotQueryKind::Pointer -> (true)
        _ -> (false)
    }
}

pub machine VirtualSnapshotQuery::get_query_id_len(&self) -> u64 {
    self.query_id_len
}

pub machine VirtualSnapshotQuery::copy_query_id_into(&self, out_query_id: &mut [u8; 128], out_query_id_len: &mut u64) {
    transition { _ -> walk(out_query_id, out_query_id_len, 0) }
    state walk(&self, out_query_id: &mut [u8; 128], out_query_id_len: &mut u64, position: u64) {
        transition position < self.query_id_len && position < 128 {
            true -> step(out_query_id, out_query_id_len, position)
            false -> finish(out_query_id_len)
        }
    }
    state step(&self, out_query_id: &mut [u8; 128], out_query_id_len: &mut u64, position: u64) {
        out_query_id[position] = self.query_id[position];
        transition { _ -> walk(out_query_id, out_query_id_len, position + 1) }
    }
    state finish(&self, out_query_id_len: &mut u64) {
        out_query_id_len = self.query_id_len;
        transition { _ -> done() }
    }
    state done(&self) {
    }
}

// Upstream `get_symbolic_struct_definition` — by value.
pub machine VirtualSnapshotQuery::get_symbolic_struct_definition(&self, out_definition: &mut SymbolicStructDefinition) {
    out_definition.clone_from(&self.symbolic_struct_definition);
}

pub machine VirtualSnapshotQuery::get_address(&self) -> u64 {
    self.address
}

pub machine VirtualSnapshotQuery::get_module_name_len(&self) -> u64 {
    self.module_name_len
}

pub machine VirtualSnapshotQuery::copy_module_name(&self, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64) {
    transition { _ -> walk(out_module_name, out_module_name_len, 0) }
    state walk(&self, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64, position: u64) {
        transition position < self.module_name_len && position < 512 {
            true -> step(out_module_name, out_module_name_len, position)
            false -> finish(out_module_name_len)
        }
    }
    state step(&self, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64, position: u64) {
        out_module_name[position] = self.module_name[position];
        transition { _ -> walk(out_module_name, out_module_name_len, position + 1) }
    }
    state finish(&self, out_module_name_len: &mut u64) {
        out_module_name_len = self.module_name_len;
        transition { _ -> done() }
    }
    state done(&self) {
    }
}

pub machine VirtualSnapshotQuery::get_pointer(&self) -> &StoredPointer {
    (&self.pointer)
}

pub machine VirtualSnapshotQuery::set_query_id(&mut self, query_id: &[u8]) -> bool {
    transition query_id.len <= 128 {
        true -> copy(query_id, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(&mut self, query_id: &[u8], position: u64) -> bool

    {
        transition position < query_id.len && position < 128 {
            true -> copy_one(query_id, position)
            false -> finish(query_id)
        }
    }
    state copy_one(&mut self, query_id: &[u8], position: u64) -> bool
        requires position < query_id.len && position < 128;
    {
        self.query_id[position] = query_id[position];
        transition { _ -> copy(query_id, position + 1) }
    }
    state finish(&mut self, query_id: &[u8]) -> bool {
        self.query_id_len = query_id.len;
        (true)
    }
}

pub machine VirtualSnapshotQuery::set_module_name(&mut self, module_name: &[u8]) -> bool {
    transition module_name.len <= 512 {
        true -> copy(module_name, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(&mut self, module_name: &[u8], position: u64) -> bool

    {
        transition position < module_name.len && position < 512 {
            true -> copy_one(module_name, position)
            false -> finish(module_name)
        }
    }
    state copy_one(&mut self, module_name: &[u8], position: u64) -> bool
        requires position < module_name.len && position < 512;
    {
        self.module_name[position] = module_name[position];
        transition { _ -> copy(module_name, position + 1) }
    }
    state finish(&mut self, module_name: &[u8]) -> bool {
        self.module_name_len = module_name.len;
        (true)
    }
}

pub machine VirtualSnapshotQuery::clone(&self) -> VirtualSnapshotQuery {
    let mut query: VirtualSnapshotQuery = VirtualSnapshotQuery {
        kind: self.kind,
        query_id_len: self.query_id_len,
        address: self.address,
        module_name_len: self.module_name_len,
        pointer: self.pointer.clone(),
        symbolic_struct_definition: self.symbolic_struct_definition.clone(),
    };
    query.query_id = self.query_id;
    query.module_name = self.module_name;
    query
}

pub machine VirtualSnapshotQuery::clone_from(&mut self, source: &VirtualSnapshotQuery) {
    self.kind = source.kind;
    self.query_id = source.query_id;
    self.query_id_len = source.query_id_len;
    self.address = source.address;
    self.module_name = source.module_name;
    self.module_name_len = source.module_name_len;
    self.pointer.clone_from(&source.pointer);
    self.symbolic_struct_definition.clone_from(&source.symbolic_struct_definition);
}

// Upstream `PartialEq` — near-equality documented: scalar fields plus
// the byte-array bodies plus the pointer chain and the struct
// definition's identity surface (namespace + field count + size);
// upstream compares every field recursively — a miss costs a redundant
// refresh, never stale data.
pub machine VirtualSnapshotQuery::equals(&self, other: &VirtualSnapshotQuery) -> bool {
    transition self.kind.get_tag() == other.kind.get_tag() && self.query_id_len == other.query_id_len && self.address == other.address && self.module_name_len == other.module_name_len {
        true -> check_pointer(other)
        false -> (false)
        _ -> (false)
    }
    state check_pointer(&self, other: &VirtualSnapshotQuery) -> bool {
        transition self.pointer.get_address() == other.pointer.get_address() && self.pointer.get_offset_count() == other.pointer.get_offset_count() && self.pointer.get_pointer_size() == other.pointer.get_pointer_size() && self.pointer.get_has_unresolvable_link() == other.pointer.get_has_unresolvable_link() && self.pointer.get_unresolvable_link_index() == other.pointer.get_unresolvable_link_index() {
            true -> check_query_id(other, 0)
            false -> (false)
        }
    }
    state check_query_id(&self, other: &VirtualSnapshotQuery, index: u64) -> bool

    {
        transition index < self.query_id_len && index < 128 {
            true -> check_id_char(other, index)
            false -> check_module(other, 0)
        }
    }
    state check_id_char(&self, other: &VirtualSnapshotQuery, index: u64) -> bool
        requires index < self.query_id_len && index < 128;
    {
        transition self.query_id[index] == other.query_id[index] {
            true -> check_query_id(other, index + 1)
            false -> (false)
        }
    }
    state check_module(&self, other: &VirtualSnapshotQuery, index: u64) -> bool

    {
        transition index < self.module_name_len && index < 512 {
            true -> check_module_char(other, index)
            false -> check_struct(other)
        }
    }
    state check_module_char(&self, other: &VirtualSnapshotQuery, index: u64) -> bool
        requires index < self.module_name_len && index < 512;
    {
        transition self.module_name[index] == other.module_name[index] {
            true -> check_module(other, index + 1)
            false -> (false)
        }
    }
    state check_struct(&self, other: &VirtualSnapshotQuery) -> bool {
        transition self.symbolic_struct_definition.get_field_count() == other.symbolic_struct_definition.get_field_count() && self.symbolic_struct_definition.get_size_in_bytes() == other.symbolic_struct_definition.get_size_in_bytes() {
            true -> check_namespace(other, 0)
            false -> (false)
        }
    }
    state check_namespace(&self, other: &VirtualSnapshotQuery, index: u64) -> bool {
        let left_len: u64 = self.symbolic_struct_definition.get_symbol_namespace().len;
        let right_len: u64 = other.symbolic_struct_definition.get_symbol_namespace().len;
        (left_len == right_len)
    }
}

// Copies the pointer carrier out (pointer-kind queries).
pub machine VirtualSnapshotQuery::copy_pointer(&self, out_pointer: &mut StoredPointer) -> bool {
    transition self.kind.get_tag() == 1 {
        true -> copy(out_pointer)
        false -> (false)
        _ -> (false)
    }
    state copy(&self, out_pointer: &mut StoredPointer) -> bool {
        out_pointer.clone_from(&self.pointer);
        (true)
    }
}
