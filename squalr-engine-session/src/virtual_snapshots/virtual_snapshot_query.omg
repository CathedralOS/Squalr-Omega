module src::virtual_snapshots::virtual_snapshot_query;

use squalr_engine_api::src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;
use src::virtual_snapshots::stored_pointer::StoredPointer;

// Port of virtual_snapshots/virtual_snapshot_query.rs. Upstream is the
// enum `Address { query_id, address, module_name,
// symbolic_struct_definition }` / `Pointer { query_id, pointer,
// symbolic_struct_definition }`. Union payload fields are not writable
// post-construction, so the port uses the same kind-tag + record carrier
// as `EngineBindingError`: `kind` selects the arm, the arm's fields sit
// flat on the record, and `is_address`/`is_pointer` give the scrutinee
// semantics. `String` bounds follow the project conventions; the
// lifetime'd `Pointer` becomes the owned `StoredPointer`.
pub data VirtualSnapshotQueryKind [copy] {
    case Address;
    case Pointer;
}

pub machine VirtualSnapshotQueryKind::get_tag(this: &VirtualSnapshotQueryKind) -> u64 {
    transition this {
        VirtualSnapshotQueryKind::Address -> (0)
        VirtualSnapshotQueryKind::Pointer -> (1)
        _ -> (255)
    }
}

pub data VirtualSnapshotQuery {
    kind: VirtualSnapshotQueryKind;
    query_id: [u8; 128];
    query_id_len: u64;
    address: u64;
    module_name: [u8; 512];
    module_name_len: u64;
    pointer: StoredPointer;
    symbolic_struct_definition: SymbolicStructDefinition;
}

pub machine VirtualSnapshotQuery::default() -> VirtualSnapshotQuery {
    VirtualSnapshotQuery {
        kind: VirtualSnapshotQueryKind::Address,
        query_id_len: 0,
        address: 0,
        module_name_len: 0,
        pointer: StoredPointer::default(),
        symbolic_struct_definition: SymbolicStructDefinition::empty(),
    }
}

pub machine VirtualSnapshotQuery::address(query_id: &[u8], address: u64, module_name: &[u8], symbolic_struct_definition: &SymbolicStructDefinition) -> VirtualSnapshotQuery {
    let mut query: VirtualSnapshotQuery = VirtualSnapshotQuery::default();
    query.kind = VirtualSnapshotQueryKind::Address;
    _ = VirtualSnapshotQuery::set_query_id(&mut query, query_id);
    query.address = address;
    _ = VirtualSnapshotQuery::set_module_name(&mut query, module_name);
    SymbolicStructDefinition::clone_from(&mut query.symbolic_struct_definition, symbolic_struct_definition);
    query
}

pub machine VirtualSnapshotQuery::pointer(query_id: &[u8], pointer: &StoredPointer, symbolic_struct_definition: &SymbolicStructDefinition) -> VirtualSnapshotQuery {
    let mut query: VirtualSnapshotQuery = VirtualSnapshotQuery::default();
    query.kind = VirtualSnapshotQueryKind::Pointer;
    _ = VirtualSnapshotQuery::set_query_id(&mut query, query_id);
    StoredPointer::clone_from(&mut query.pointer, pointer);
    SymbolicStructDefinition::clone_from(&mut query.symbolic_struct_definition, symbolic_struct_definition);
    query
}

pub machine VirtualSnapshotQuery::get_is_address(this: &VirtualSnapshotQuery) -> bool {
    transition this.kind {
        VirtualSnapshotQueryKind::Address -> (true)
        _ -> (false)
    }
}

pub machine VirtualSnapshotQuery::get_is_pointer(this: &VirtualSnapshotQuery) -> bool {
    transition this.kind {
        VirtualSnapshotQueryKind::Pointer -> (true)
        _ -> (false)
    }
}

pub machine VirtualSnapshotQuery::get_query_id_len(this: &VirtualSnapshotQuery) -> u64 {
    this.query_id_len
}

pub machine VirtualSnapshotQuery::copy_query_id_into(this: &VirtualSnapshotQuery, out_query_id: &mut [u8; 128], out_query_id_len: &mut u64) {
    transition { _ -> walk(this, out_query_id, out_query_id_len, 0) }
    state walk(this: &VirtualSnapshotQuery, out_query_id: &mut [u8; 128], out_query_id_len: &mut u64, position: u64) {
        transition position < this.query_id_len && position < 128 {
            true -> step(this, out_query_id, out_query_id_len, position)
            false -> finish(this, out_query_id_len)
        }
    }
    state step(this: &VirtualSnapshotQuery, out_query_id: &mut [u8; 128], out_query_id_len: &mut u64, position: u64) {
        out_query_id[position] = this.query_id[position];
        transition { _ -> walk(this, out_query_id, out_query_id_len, position + 1) }
    }
    state finish(this: &VirtualSnapshotQuery, out_query_id_len: &mut u64) {
        out_query_id_len = this.query_id_len;
        transition { _ -> done(this) }
    }
    state done(this: &VirtualSnapshotQuery) {
    }
}

// Upstream `get_symbolic_struct_definition` — by value.
pub machine VirtualSnapshotQuery::get_symbolic_struct_definition(this: &VirtualSnapshotQuery, out_definition: &mut SymbolicStructDefinition) {
    SymbolicStructDefinition::clone_from(&mut out_definition, &this.symbolic_struct_definition);
}

pub machine VirtualSnapshotQuery::get_address(this: &VirtualSnapshotQuery) -> u64 {
    this.address
}

pub machine VirtualSnapshotQuery::get_module_name_len(this: &VirtualSnapshotQuery) -> u64 {
    this.module_name_len
}

pub machine VirtualSnapshotQuery::copy_module_name(this: &VirtualSnapshotQuery, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64) {
    transition { _ -> walk(this, out_module_name, out_module_name_len, 0) }
    state walk(this: &VirtualSnapshotQuery, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64, position: u64) {
        transition position < this.module_name_len && position < 512 {
            true -> step(this, out_module_name, out_module_name_len, position)
            false -> finish(this, out_module_name_len)
        }
    }
    state step(this: &VirtualSnapshotQuery, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64, position: u64) {
        out_module_name[position] = this.module_name[position];
        transition { _ -> walk(this, out_module_name, out_module_name_len, position + 1) }
    }
    state finish(this: &VirtualSnapshotQuery, out_module_name_len: &mut u64) {
        out_module_name_len = this.module_name_len;
        transition { _ -> done(this) }
    }
    state done(this: &VirtualSnapshotQuery) {
    }
}

pub machine VirtualSnapshotQuery::get_pointer(this: &VirtualSnapshotQuery) -> &StoredPointer {
    (&this.pointer)
}

pub machine VirtualSnapshotQuery::set_query_id(this: &mut VirtualSnapshotQuery, query_id: &[u8]) -> bool {
    transition query_id.len <= 128 {
        true -> copy(this, query_id, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(this: &mut VirtualSnapshotQuery, query_id: &[u8], position: u64) -> bool

    {
        transition position < query_id.len && position < 128 {
            true -> copy_one(this, query_id, position)
            false -> finish(this, query_id)
        }
    }
    state copy_one(this: &mut VirtualSnapshotQuery, query_id: &[u8], position: u64) -> bool
        requires position < query_id.len && position < 128;
    {
        this.query_id[position] = query_id[position];
        transition { _ -> copy(this, query_id, position + 1) }
    }
    state finish(this: &mut VirtualSnapshotQuery, query_id: &[u8]) -> bool {
        this.query_id_len = query_id.len;
        (true)
    }
}

pub machine VirtualSnapshotQuery::set_module_name(this: &mut VirtualSnapshotQuery, module_name: &[u8]) -> bool {
    transition module_name.len <= 512 {
        true -> copy(this, module_name, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(this: &mut VirtualSnapshotQuery, module_name: &[u8], position: u64) -> bool

    {
        transition position < module_name.len && position < 512 {
            true -> copy_one(this, module_name, position)
            false -> finish(this, module_name)
        }
    }
    state copy_one(this: &mut VirtualSnapshotQuery, module_name: &[u8], position: u64) -> bool
        requires position < module_name.len && position < 512;
    {
        this.module_name[position] = module_name[position];
        transition { _ -> copy(this, module_name, position + 1) }
    }
    state finish(this: &mut VirtualSnapshotQuery, module_name: &[u8]) -> bool {
        this.module_name_len = module_name.len;
        (true)
    }
}

pub machine VirtualSnapshotQuery::clone(this: &VirtualSnapshotQuery) -> VirtualSnapshotQuery {
    let hoist19: SymbolicStructDefinition = SymbolicStructDefinition::clone(&this.symbolic_struct_definition);
    let hoist18: StoredPointer = StoredPointer::clone(&this.pointer);
    let mut query: VirtualSnapshotQuery = VirtualSnapshotQuery {
        kind: this.kind,
        query_id_len: this.query_id_len,
        address: this.address,
        module_name_len: this.module_name_len,
        pointer: hoist18,
        symbolic_struct_definition: hoist19,
    };
    query.query_id = this.query_id;
    query.module_name = this.module_name;
    query
}

pub machine VirtualSnapshotQuery::clone_from(this: &mut VirtualSnapshotQuery, source: &VirtualSnapshotQuery) {
    this.kind = source.kind;
    this.query_id = source.query_id;
    this.query_id_len = source.query_id_len;
    this.address = source.address;
    this.module_name = source.module_name;
    this.module_name_len = source.module_name_len;
    StoredPointer::clone_from(&mut this.pointer, &source.pointer);
    SymbolicStructDefinition::clone_from(&mut this.symbolic_struct_definition, &source.symbolic_struct_definition);
}

// Upstream `PartialEq` — near-equality documented: scalar fields plus
// the byte-array bodies plus the pointer chain and the struct
// definition's identity surface (namespace + field count + size);
// upstream compares every field recursively — a miss costs a redundant
// refresh, never stale data.
pub machine VirtualSnapshotQuery::equals(this: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery) -> bool {
    let hoist2: u64 = VirtualSnapshotQueryKind::get_tag(&other.kind);
    let hoist1: u64 = VirtualSnapshotQueryKind::get_tag(&this.kind);
    transition hoist1 == hoist2 && this.query_id_len == other.query_id_len && this.address == other.address && this.module_name_len == other.module_name_len {
        true -> check_pointer(this, other)
        false -> (false)
        _ -> (false)
    }
    state check_pointer(this: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery) -> bool {
        let hoist12: u64 = StoredPointer::get_unresolvable_link_index(&other.pointer);
        let hoist11: u64 = StoredPointer::get_unresolvable_link_index(&this.pointer);
        let hoist10: bool = StoredPointer::get_has_unresolvable_link(&other.pointer);
        let hoist9: bool = StoredPointer::get_has_unresolvable_link(&this.pointer);
        let hoist8: u64 = StoredPointer::get_pointer_size(&other.pointer);
        let hoist7: u64 = StoredPointer::get_pointer_size(&this.pointer);
        let hoist6: u64 = StoredPointer::get_offset_count(&other.pointer);
        let hoist5: u64 = StoredPointer::get_offset_count(&this.pointer);
        let hoist4: u64 = StoredPointer::get_address(&other.pointer);
        let hoist3: u64 = StoredPointer::get_address(&this.pointer);
        transition hoist3 == hoist4 && hoist5 == hoist6 && hoist7 == hoist8 && hoist9 == hoist10 && hoist11 == hoist12 {
            true -> check_query_id(this, other, 0)
            false -> (false)
        }
    }
    state check_query_id(this: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery, index: u64) -> bool

    {
        transition index < this.query_id_len && index < 128 {
            true -> check_id_char(this, other, index)
            false -> check_module(this, other, 0)
        }
    }
    state check_id_char(this: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery, index: u64) -> bool
        requires index < this.query_id_len && index < 128;
    {
        transition this.query_id[index] == other.query_id[index] {
            true -> check_query_id(this, other, index + 1)
            false -> (false)
        }
    }
    state check_module(this: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery, index: u64) -> bool

    {
        transition index < this.module_name_len && index < 512 {
            true -> check_module_char(this, other, index)
            false -> check_struct(this, other)
        }
    }
    state check_module_char(this: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery, index: u64) -> bool
        requires index < this.module_name_len && index < 512;
    {
        transition this.module_name[index] == other.module_name[index] {
            true -> check_module(this, other, index + 1)
            false -> (false)
        }
    }
    state check_struct(this: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery) -> bool {
        let hoist16: u64 = get_size_in_bySymbolicStructDefinition::get_size_in_bytes(&other.symbolic_struct_definition)hoist15: u64 = get_size_in_bySymbolicStructDefinition::get_size_in_bytes(&this.symbolic_struct_definition)hoist14: u64 = get_field_counSymbolicStructDefinition::get_field_count(&other.symbolic_struct_definition)hoist13: u64 = get_field_counSymbolicStructDefinition::get_field_count(&this.symbolic_struct_definition)sition hoist13 == hoist14 && hoist15 == hoist16 {
            true -> check_namespace(this, other, 0)
            false -> (false)
        }
    }
    state check_namespace(this: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery, index: u64) -> bool {
        let left_len: u64 = get_symbol_namSymbolicStructDefinition::get_symbol_namespace(&this.symbolic_struct_definition)let right_len: u64 = get_symbol_namSymbolicStructDefinition::get_symbol_namespace(&other.symbolic_struct_definition)(left_len == right_len)
    }
}

// Copies the pointer carrier out (pointer-kind queries).
pub machine VirtualSnapshotQuery::copy_pointer(this: &VirtualSnapshotQuery, out_pointer: &mut StoredPointer) -> bool {
    let hoist17: u64 = VirtualSnapshotQueryKind::get_tag(&this.kind);
    transition hoist17 == 1 {
        true -> copy(this, out_pointer)
        false -> (false)
        _ -> (false)
    }
    state copy(this: &VirtualSnapshotQuery, out_pointer: &mut StoredPointer) -> bool {
        StoredPointer::clone_from(&mut out_pointer, &this.pointer);
        (true)
    }
}
