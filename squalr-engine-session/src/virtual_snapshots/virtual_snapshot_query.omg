module src::virtual_snapshots::virtual_snapshot_query;

use squalr_engine_api::src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;
use src::virtual_snapshots::stored_pointer::StoredPointer;

// Port of virtual_snapshots/virtual_snapshot_query.rs. Upstream is the
// enum `Address { query_id, address, module_name,
// symbolic_struct_definition }` / `Pointer { query_id, pointer,
// symbolic_struct_definition }`. Union payload fields are not writable
// post-construction, so the port uses the same kind-tag + record carrier
// as `EngineBindingError`: `kind` selects the arm, the arm's fields sit
// flat on the record, and `is_address`/`is_pointer` give the scrutinee
// semantics. `String` bounds follow the project conventions; the
// lifetime'd `Pointer` becomes the owned `StoredPointer`.
pub data VirtualSnapshotQueryKind [copy] {
    case Address;
    case Pointer;
}

pub machine VirtualSnapshotQueryKind::get_tag(virtual_snapshot_query_kind: &VirtualSnapshotQueryKind) -> u64 {
    transition virtual_snapshot_query_kind {
        VirtualSnapshotQueryKind::Address -> (0)
        VirtualSnapshotQueryKind::Pointer -> (1)
        _ -> (255)
    }
}

pub data VirtualSnapshotQuery {
    kind: VirtualSnapshotQueryKind;
    query_id: [u8; 128];
    query_id_len: u64;
    address: u64;
    module_name: [u8; 512];
    module_name_len: u64;
    pointer: StoredPointer;
    symbolic_struct_definition: SymbolicStructDefinition;
}

pub machine VirtualSnapshotQuery::default() -> VirtualSnapshotQuery {
    VirtualSnapshotQuery {
        kind: VirtualSnapshotQueryKind::Address,
        query_id_len: 0,
        address: 0,
        module_name_len: 0,
        pointer: StoredPointer::default(),
        symbolic_struct_definition: SymbolicStructDefinition::empty(),
    }
}

pub machine VirtualSnapshotQuery::address(query_id: &[u8], address: u64, module_name: &[u8], symbolic_struct_definition: &SymbolicStructDefinition) -> VirtualSnapshotQuery {
    let mut query: VirtualSnapshotQuery = VirtualSnapshotQuery::default();
    query.kind = VirtualSnapshotQueryKind::Address;
    _ = VirtualSnapshotQuery::set_query_id(&mut query, query_id);
    query.address = address;
    _ = VirtualSnapshotQuery::set_module_name(&mut query, module_name);
    SymbolicStructDefinition::clone_from(&mut query.symbolic_struct_definition, symbolic_struct_definition);
    query
}

pub machine VirtualSnapshotQuery::pointer(query_id: &[u8], pointer: &StoredPointer, symbolic_struct_definition: &SymbolicStructDefinition) -> VirtualSnapshotQuery {
    let mut query: VirtualSnapshotQuery = VirtualSnapshotQuery::default();
    query.kind = VirtualSnapshotQueryKind::Pointer;
    _ = VirtualSnapshotQuery::set_query_id(&mut query, query_id);
    StoredPointer::clone_from(&mut query.pointer, pointer);
    SymbolicStructDefinition::clone_from(&mut query.symbolic_struct_definition, symbolic_struct_definition);
    query
}

pub machine VirtualSnapshotQuery::get_is_address(virtual_snapshot_query: &VirtualSnapshotQuery) -> bool {
    transition virtual_snapshot_query.kind {
        VirtualSnapshotQueryKind::Address -> (true)
        _ -> (false)
    }
}

pub machine VirtualSnapshotQuery::get_is_pointer(virtual_snapshot_query: &VirtualSnapshotQuery) -> bool {
    transition virtual_snapshot_query.kind {
        VirtualSnapshotQueryKind::Pointer -> (true)
        _ -> (false)
    }
}

pub machine VirtualSnapshotQuery::get_query_id_len(virtual_snapshot_query: &VirtualSnapshotQuery) -> u64 {
    virtual_snapshot_query.query_id_len
}

pub machine VirtualSnapshotQuery::copy_query_id_into(virtual_snapshot_query: &VirtualSnapshotQuery, out_query_id: &mut [u8; 128], out_query_id_len: &mut u64) {
    transition { _ -> walk(virtual_snapshot_query, out_query_id, out_query_id_len, 0) }
    state walk(virtual_snapshot_query: &VirtualSnapshotQuery, out_query_id: &mut [u8; 128], out_query_id_len: &mut u64, position: u64) {
        transition position < virtual_snapshot_query.query_id_len && position < 128 {
            true -> step(virtual_snapshot_query, out_query_id, out_query_id_len, position)
            false -> finish(virtual_snapshot_query, out_query_id_len)
        }
    }
    state step(virtual_snapshot_query: &VirtualSnapshotQuery, out_query_id: &mut [u8; 128], out_query_id_len: &mut u64, position: u64) {
        out_query_id[position] = virtual_snapshot_query.query_id[position];
        transition { _ -> walk(virtual_snapshot_query, out_query_id, out_query_id_len, position + 1) }
    }
    state finish(virtual_snapshot_query: &VirtualSnapshotQuery, out_query_id_len: &mut u64) {
        out_query_id_len = virtual_snapshot_query.query_id_len;
        transition { _ -> done(virtual_snapshot_query) }
    }
    state done(virtual_snapshot_query: &VirtualSnapshotQuery) {
    }
}

// Upstream `get_symbolic_struct_definition` — by value.
pub machine VirtualSnapshotQuery::get_symbolic_struct_definition(virtual_snapshot_query: &VirtualSnapshotQuery, out_definition: &mut SymbolicStructDefinition) {
    SymbolicStructDefinition::clone_from(out_definition, &virtual_snapshot_query.symbolic_struct_definition);
}

pub machine VirtualSnapshotQuery::get_address(virtual_snapshot_query: &VirtualSnapshotQuery) -> u64 {
    virtual_snapshot_query.address
}

pub machine VirtualSnapshotQuery::get_module_name_len(virtual_snapshot_query: &VirtualSnapshotQuery) -> u64 {
    virtual_snapshot_query.module_name_len
}

pub machine VirtualSnapshotQuery::copy_module_name(virtual_snapshot_query: &VirtualSnapshotQuery, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64) {
    transition { _ -> walk(virtual_snapshot_query, out_module_name, out_module_name_len, 0) }
    state walk(virtual_snapshot_query: &VirtualSnapshotQuery, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64, position: u64) {
        transition position < virtual_snapshot_query.module_name_len && position < 512 {
            true -> step(virtual_snapshot_query, out_module_name, out_module_name_len, position)
            false -> finish(virtual_snapshot_query, out_module_name_len)
        }
    }
    state step(virtual_snapshot_query: &VirtualSnapshotQuery, out_module_name: &mut [u8; 512], out_module_name_len: &mut u64, position: u64) {
        out_module_name[position] = virtual_snapshot_query.module_name[position];
        transition { _ -> walk(virtual_snapshot_query, out_module_name, out_module_name_len, position + 1) }
    }
    state finish(virtual_snapshot_query: &VirtualSnapshotQuery, out_module_name_len: &mut u64) {
        out_module_name_len = virtual_snapshot_query.module_name_len;
        transition { _ -> done(virtual_snapshot_query) }
    }
    state done(virtual_snapshot_query: &VirtualSnapshotQuery) {
    }
}

pub machine VirtualSnapshotQuery::get_pointer(virtual_snapshot_query: &VirtualSnapshotQuery) -> &StoredPointer {
    (&virtual_snapshot_query.pointer)
}

pub machine VirtualSnapshotQuery::set_query_id(virtual_snapshot_query: &mut VirtualSnapshotQuery, query_id: &[u8]) -> bool {
    transition query_id.len <= 128 {
        true -> copy(virtual_snapshot_query, query_id, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(virtual_snapshot_query: &mut VirtualSnapshotQuery, query_id: &[u8], position: u64) -> bool

    {
        transition position < query_id.len && position < 128 {
            true -> copy_one(virtual_snapshot_query, query_id, position)
            false -> finish(virtual_snapshot_query, query_id)
        }
    }
    state copy_one(virtual_snapshot_query: &mut VirtualSnapshotQuery, query_id: &[u8], position: u64) -> bool
        requires position < query_id.len && position < 128;
    {
        virtual_snapshot_query.query_id[position] = query_id[position];
        transition { _ -> copy(virtual_snapshot_query, query_id, position + 1) }
    }
    state finish(virtual_snapshot_query: &mut VirtualSnapshotQuery, query_id: &[u8]) -> bool {
        virtual_snapshot_query.query_id_len = query_id.len;
        (true)
    }
}

pub machine VirtualSnapshotQuery::set_module_name(virtual_snapshot_query: &mut VirtualSnapshotQuery, module_name: &[u8]) -> bool {
    transition module_name.len <= 512 {
        true -> copy(virtual_snapshot_query, module_name, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(virtual_snapshot_query: &mut VirtualSnapshotQuery, module_name: &[u8], position: u64) -> bool

    {
        transition position < module_name.len && position < 512 {
            true -> copy_one(virtual_snapshot_query, module_name, position)
            false -> finish(virtual_snapshot_query, module_name)
        }
    }
    state copy_one(virtual_snapshot_query: &mut VirtualSnapshotQuery, module_name: &[u8], position: u64) -> bool
        requires position < module_name.len && position < 512;
    {
        virtual_snapshot_query.module_name[position] = module_name[position];
        transition { _ -> copy(virtual_snapshot_query, module_name, position + 1) }
    }
    state finish(virtual_snapshot_query: &mut VirtualSnapshotQuery, module_name: &[u8]) -> bool {
        virtual_snapshot_query.module_name_len = module_name.len;
        (true)
    }
}

pub machine VirtualSnapshotQuery::clone(virtual_snapshot_query: &VirtualSnapshotQuery) -> VirtualSnapshotQuery {
    let mut query: VirtualSnapshotQuery = VirtualSnapshotQuery {
        kind: virtual_snapshot_query.kind,
        query_id_len: virtual_snapshot_query.query_id_len,
        address: virtual_snapshot_query.address,
        module_name_len: virtual_snapshot_query.module_name_len,
        pointer: StoredPointer::clone(&virtual_snapshot_query.pointer),
        symbolic_struct_definition: SymbolicStructDefinition::clone(&virtual_snapshot_query.symbolic_struct_definition),
    };
    query.query_id = virtual_snapshot_query.query_id;
    query.module_name = virtual_snapshot_query.module_name;
    query
}

pub machine VirtualSnapshotQuery::clone_from(virtual_snapshot_query: &mut VirtualSnapshotQuery, source: &VirtualSnapshotQuery) {
    virtual_snapshot_query.kind = source.kind;
    virtual_snapshot_query.query_id = source.query_id;
    virtual_snapshot_query.query_id_len = source.query_id_len;
    virtual_snapshot_query.address = source.address;
    virtual_snapshot_query.module_name = source.module_name;
    virtual_snapshot_query.module_name_len = source.module_name_len;
    StoredPointer::clone_from(&mut virtual_snapshot_query.pointer, &source.pointer);
    SymbolicStructDefinition::clone_from(&mut virtual_snapshot_query.symbolic_struct_definition, &source.symbolic_struct_definition);
}

// Upstream `PartialEq` — near-equality documented: scalar fields plus
// the byte-array bodies plus the pointer chain and the struct
// definition's identity surface (namespace + field count + size);
// upstream compares every field recursively — a miss costs a redundant
// refresh, never stale data.
pub machine VirtualSnapshotQuery::equals(virtual_snapshot_query: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery) -> bool {
    transition VirtualSnapshotQueryKind::get_tag(&virtual_snapshot_query.kind) == VirtualSnapshotQueryKind::get_tag(&other.kind) && virtual_snapshot_query.query_id_len == other.query_id_len && virtual_snapshot_query.address == other.address && virtual_snapshot_query.module_name_len == other.module_name_len {
        true -> check_pointer(virtual_snapshot_query, other)
        false -> (false)
        _ -> (false)
    }
    state check_pointer(virtual_snapshot_query: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery) -> bool {
        transition StoredPointer::get_address(&virtual_snapshot_query.pointer) == StoredPointer::get_address(&other.pointer) && StoredPointer::get_offset_count(&virtual_snapshot_query.pointer) == StoredPointer::get_offset_count(&other.pointer) && StoredPointer::get_pointer_size(&virtual_snapshot_query.pointer) == StoredPointer::get_pointer_size(&other.pointer) && StoredPointer::get_has_unresolvable_link(&virtual_snapshot_query.pointer) == StoredPointer::get_has_unresolvable_link(&other.pointer) && StoredPointer::get_unresolvable_link_index(&virtual_snapshot_query.pointer) == StoredPointer::get_unresolvable_link_index(&other.pointer) {
            true -> check_query_id(virtual_snapshot_query, other, 0)
            false -> (false)
        }
    }
    state check_query_id(virtual_snapshot_query: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery, index: u64) -> bool

    {
        transition index < virtual_snapshot_query.query_id_len && index < 128 {
            true -> check_id_char(virtual_snapshot_query, other, index)
            false -> check_module(virtual_snapshot_query, other, 0)
        }
    }
    state check_id_char(virtual_snapshot_query: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery, index: u64) -> bool
        requires index < virtual_snapshot_query.query_id_len && index < 128;
    {
        transition virtual_snapshot_query.query_id[index] == other.query_id[index] {
            true -> check_query_id(virtual_snapshot_query, other, index + 1)
            false -> (false)
        }
    }
    state check_module(virtual_snapshot_query: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery, index: u64) -> bool

    {
        transition index < virtual_snapshot_query.module_name_len && index < 512 {
            true -> check_module_char(virtual_snapshot_query, other, index)
            false -> check_struct(virtual_snapshot_query, other)
        }
    }
    state check_module_char(virtual_snapshot_query: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery, index: u64) -> bool
        requires index < virtual_snapshot_query.module_name_len && index < 512;
    {
        transition virtual_snapshot_query.module_name[index] == other.module_name[index] {
            true -> check_module(virtual_snapshot_query, other, index + 1)
            false -> (false)
        }
    }
    state check_struct(virtual_snapshot_query: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery) -> bool {
        transition SymbolicStructDefinition::get_field_count(&virtual_snapshot_query.symbolic_struct_definition) == SymbolicStructDefinition::get_field_count(&other.symbolic_struct_definition) && SymbolicStructDefinition::get_size_in_bytes(&virtual_snapshot_query.symbolic_struct_definition) == SymbolicStructDefinition::get_size_in_bytes(&other.symbolic_struct_definition) {
            true -> check_namespace(virtual_snapshot_query, other, 0)
            false -> (false)
        }
    }
    state check_namespace(virtual_snapshot_query: &VirtualSnapshotQuery, other: &VirtualSnapshotQuery, index: u64) -> bool {
        let left_len: u64 = SymbolicStructDefinition::get_symbol_namespace(&virtual_snapshot_query.symbolic_struct_definition).len;
        let right_len: u64 = SymbolicStructDefinition::get_symbol_namespace(&other.symbolic_struct_definition).len;
        (left_len == right_len)
    }
}

// Copies the pointer carrier out (pointer-kind queries).
pub machine VirtualSnapshotQuery::copy_pointer(virtual_snapshot_query: &VirtualSnapshotQuery, out_pointer: &mut StoredPointer) -> bool {
    transition VirtualSnapshotQueryKind::get_tag(&virtual_snapshot_query.kind) == 1 {
        true -> copy(virtual_snapshot_query, out_pointer)
        false -> (false)
        _ -> (false)
    }
    state copy(virtual_snapshot_query: &VirtualSnapshotQuery, out_pointer: &mut StoredPointer) -> bool {
        StoredPointer::clone_from(out_pointer, &virtual_snapshot_query.pointer);
        (true)
    }
}
