module src::virtual_snapshots::virtual_snapshot_query_result;

use squalr_engine_api::src::commands::memory::read::memory_read_response::MemoryReadResponse;

// Port of virtual_snapshots/virtual_snapshot_query_result.rs —
// `Option` fields as has_ flags + stored value, `String` bounded.
pub data VirtualSnapshotQueryResult {
    has_memory_read_response: bool;
    memory_read_response: MemoryReadResponse;
    has_resolved_address: bool;
    resolved_address: u64;
    resolved_module_name: [u8; 512];
    resolved_module_name_len: u64;
    evaluated_pointer_path: [u8; 512];
    evaluated_pointer_path_len: u64;
}

pub machine VirtualSnapshotQueryResult::default() -> VirtualSnapshotQueryResult {
    VirtualSnapshotQueryResult {
        has_memory_read_response: false,
        memory_read_response: MemoryReadResponse::default(),
        has_resolved_address: false,
        resolved_address: 0,
        resolved_module_name_len: 0,
        evaluated_pointer_path_len: 0,
    }
}

pub machine VirtualSnapshotQueryResult::get_has_memory_read_response(&self) -> bool {
    self.has_memory_read_response
}

pub machine VirtualSnapshotQueryResult::get_memory_read_response(&self) -> &MemoryReadResponse {
    (&self.memory_read_response)
}

pub machine VirtualSnapshotQueryResult::set_memory_read_response(&mut self, memory_read_response: &MemoryReadResponse) {
    self.has_memory_read_response = true;
    self.memory_read_response.clone_from(memory_read_response);
}

pub machine VirtualSnapshotQueryResult::get_has_resolved_address(&self) -> bool {
    self.has_resolved_address
}

pub machine VirtualSnapshotQueryResult::get_resolved_address(&self) -> u64 {
    self.resolved_address
}

pub machine VirtualSnapshotQueryResult::set_resolved_address(&mut self, resolved_address: u64) {
    self.has_resolved_address = true;
    self.resolved_address = resolved_address;
}

pub machine VirtualSnapshotQueryResult::set_resolved_module_name(&mut self, module_name: &[u8]) -> bool {
    transition module_name.len <= 512 {
        true -> copy(module_name, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(&mut self, module_name: &[u8], position: u64) -> bool

    {
        transition position < module_name.len && position < 512 {
            true -> copy_one(module_name, position)
            false -> finish(module_name)
        }
    }
    state copy_one(&mut self, module_name: &[u8], position: u64) -> bool
        requires position < module_name.len && position < 512;
    {
        self.resolved_module_name[position] = module_name[position];
        transition { _ -> copy(module_name, position + 1) }
    }
    state finish(&mut self, module_name: &[u8]) -> bool {
        self.resolved_module_name_len = module_name.len;
        (true)
    }
}

pub machine VirtualSnapshotQueryResult::set_evaluated_pointer_path(&mut self, path: &[u8]) -> bool {
    transition path.len <= 512 {
        true -> copy(path, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(&mut self, path: &[u8], position: u64) -> bool

    {
        transition position < path.len && position < 512 {
            true -> copy_one(path, position)
            false -> finish(path)
        }
    }
    state copy_one(&mut self, path: &[u8], position: u64) -> bool
        requires position < path.len && position < 512;
    {
        self.evaluated_pointer_path[position] = path[position];
        transition { _ -> copy(path, position + 1) }
    }
    state finish(&mut self, path: &[u8]) -> bool {
        self.evaluated_pointer_path_len = path.len;
        (true)
    }
}

pub machine VirtualSnapshotQueryResult::clone_from(&mut self, source: &VirtualSnapshotQueryResult) {
    self.has_memory_read_response = source.has_memory_read_response;
    self.memory_read_response.clone_from(&source.memory_read_response);
    self.has_resolved_address = source.has_resolved_address;
    self.resolved_address = source.resolved_address;
    self.resolved_module_name = source.resolved_module_name;
    self.resolved_module_name_len = source.resolved_module_name_len;
    self.evaluated_pointer_path = source.evaluated_pointer_path;
    self.evaluated_pointer_path_len = source.evaluated_pointer_path_len;
}

pub machine VirtualSnapshotQueryResult::clone(&self) -> VirtualSnapshotQueryResult {
    let mut result: VirtualSnapshotQueryResult = VirtualSnapshotQueryResult::default();
    result.clone_from(self);
    result
}
