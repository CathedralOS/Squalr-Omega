module src::virtual_snapshots::virtual_snapshot_query_result;

use squalr_engine_api::src::commands::memory::read::memory_read_response::MemoryReadResponse;

// Port of virtual_snapshots/virtual_snapshot_query_result.rs —
// `Option` fields as has_ flags + stored value, `String` bounded.
pub data VirtualSnapshotQueryResult {
    has_memory_read_response: bool;
    memory_read_response: MemoryReadResponse;
    has_resolved_address: bool;
    resolved_address: u64;
    resolved_module_name: [u8; 512];
    resolved_module_name_len: u64;
    evaluated_pointer_path: [u8; 512];
    evaluated_pointer_path_len: u64;
}

pub machine VirtualSnapshotQueryResult::default() -> VirtualSnapshotQueryResult {
    VirtualSnapshotQueryResult {
        has_memory_read_response: false,
        memory_read_response: MemoryReadResponse::default(),
        has_resolved_address: false,
        resolved_address: 0,
        resolved_module_name_len: 0,
        evaluated_pointer_path_len: 0,
    }
}

pub machine VirtualSnapshotQueryResult::get_has_memory_read_response(virtual_snapshot_query_result: &VirtualSnapshotQueryResult) -> bool {
    virtual_snapshot_query_result.has_memory_read_response
}

pub machine VirtualSnapshotQueryResult::get_memory_read_response(virtual_snapshot_query_result: &VirtualSnapshotQueryResult) -> &MemoryReadResponse {
    (&virtual_snapshot_query_result.memory_read_response)
}

pub machine VirtualSnapshotQueryResult::set_memory_read_response(virtual_snapshot_query_result: &mut VirtualSnapshotQueryResult, memory_read_response: &MemoryReadResponse) {
    virtual_snapshot_query_result.has_memory_read_response = true;
    MemoryReadResponse::clone_from(&mut virtual_snapshot_query_result.memory_read_response, memory_read_response);
}

pub machine VirtualSnapshotQueryResult::get_has_resolved_address(virtual_snapshot_query_result: &VirtualSnapshotQueryResult) -> bool {
    virtual_snapshot_query_result.has_resolved_address
}

pub machine VirtualSnapshotQueryResult::get_resolved_address(virtual_snapshot_query_result: &VirtualSnapshotQueryResult) -> u64 {
    virtual_snapshot_query_result.resolved_address
}

pub machine VirtualSnapshotQueryResult::set_resolved_address(virtual_snapshot_query_result: &mut VirtualSnapshotQueryResult, resolved_address: u64) {
    virtual_snapshot_query_result.has_resolved_address = true;
    virtual_snapshot_query_result.resolved_address = resolved_address;
}

pub machine VirtualSnapshotQueryResult::set_resolved_module_name(virtual_snapshot_query_result: &mut VirtualSnapshotQueryResult, module_name: &[u8]) -> bool {
    transition module_name.len <= 512 {
        true -> copy(virtual_snapshot_query_result, module_name, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(virtual_snapshot_query_result: &mut VirtualSnapshotQueryResult, module_name: &[u8], position: u64) -> bool

    {
        transition position < module_name.len && position < 512 {
            true -> copy_one(virtual_snapshot_query_result, module_name, position)
            false -> finish(virtual_snapshot_query_result, module_name)
        }
    }
    state copy_one(virtual_snapshot_query_result: &mut VirtualSnapshotQueryResult, module_name: &[u8], position: u64) -> bool
        requires position < module_name.len && position < 512;
    {
        virtual_snapshot_query_result.resolved_module_name[position] = module_name[position];
        transition { _ -> copy(virtual_snapshot_query_result, module_name, position + 1) }
    }
    state finish(virtual_snapshot_query_result: &mut VirtualSnapshotQueryResult, module_name: &[u8]) -> bool {
        virtual_snapshot_query_result.resolved_module_name_len = module_name.len;
        (true)
    }
}

pub machine VirtualSnapshotQueryResult::set_evaluated_pointer_path(virtual_snapshot_query_result: &mut VirtualSnapshotQueryResult, path: &[u8]) -> bool {
    transition path.len <= 512 {
        true -> copy(virtual_snapshot_query_result, path, 0)
        false -> (false)
        _ -> (false)
    }
    state copy(virtual_snapshot_query_result: &mut VirtualSnapshotQueryResult, path: &[u8], position: u64) -> bool

    {
        transition position < path.len && position < 512 {
            true -> copy_one(virtual_snapshot_query_result, path, position)
            false -> finish(virtual_snapshot_query_result, path)
        }
    }
    state copy_one(virtual_snapshot_query_result: &mut VirtualSnapshotQueryResult, path: &[u8], position: u64) -> bool
        requires position < path.len && position < 512;
    {
        virtual_snapshot_query_result.evaluated_pointer_path[position] = path[position];
        transition { _ -> copy(virtual_snapshot_query_result, path, position + 1) }
    }
    state finish(virtual_snapshot_query_result: &mut VirtualSnapshotQueryResult, path: &[u8]) -> bool {
        virtual_snapshot_query_result.evaluated_pointer_path_len = path.len;
        (true)
    }
}

pub machine VirtualSnapshotQueryResult::clone_from(virtual_snapshot_query_result: &mut VirtualSnapshotQueryResult, source: &VirtualSnapshotQueryResult) {
    virtual_snapshot_query_result.has_memory_read_response = source.has_memory_read_response;
    MemoryReadResponse::clone_from(&mut virtual_snapshot_query_result.memory_read_response, &source.memory_read_response);
    virtual_snapshot_query_result.has_resolved_address = source.has_resolved_address;
    virtual_snapshot_query_result.resolved_address = source.resolved_address;
    virtual_snapshot_query_result.resolved_module_name = source.resolved_module_name;
    virtual_snapshot_query_result.resolved_module_name_len = source.resolved_module_name_len;
    virtual_snapshot_query_result.evaluated_pointer_path = source.evaluated_pointer_path;
    virtual_snapshot_query_result.evaluated_pointer_path_len = source.evaluated_pointer_path_len;
}

pub machine VirtualSnapshotQueryResult::clone(virtual_snapshot_query_result: &VirtualSnapshotQueryResult) -> VirtualSnapshotQueryResult {
    let mut result: VirtualSnapshotQueryResult = VirtualSnapshotQueryResult::default();
    VirtualSnapshotQueryResult::clone_from(&mut result, virtual_snapshot_query_result);
    result
}
