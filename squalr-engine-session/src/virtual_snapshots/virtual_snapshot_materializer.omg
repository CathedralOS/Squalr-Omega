module src::virtual_snapshots::virtual_snapshot_materializer;

use squalr_engine_api::src::commands::memory::read::memory_read_request::MemoryReadRequest;
use squalr_engine_api::src::commands::memory::read::memory_read_response::MemoryReadResponse;
use squalr_engine_api::src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;
use squalr_engine_api::src::structures::structs::valued_struct_field::ValuedStructField;
use squalr_engine_api::src::structures::structs::valued_struct::ValuedStruct;
use squalr_engine_api::src::structures::data_values::data_value::DataValue;
use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use squalr_engine_api::src::structures::memory::endian::Endian;
use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use src::virtual_snapshots::virtual_snapshot::VirtualSnapshot;
use src::virtual_snapshots::virtual_snapshot_query::VirtualSnapshotQuery;
use src::virtual_snapshots::virtual_snapshot_query_result::VirtualSnapshotQueryResult;
use src::virtual_snapshots::stored_pointer::StoredPointer;
use src::virtual_snapshots::stored_pointer::slice_512;
use src::registries::privileged_registry_cache::PrivilegedRegistryCache;

// Port of virtual_snapshots/virtual_snapshot_resolver.rs. Upstream
// `materialize_virtual_snapshot_queries` runs synchronously inside a
// spawned thread, dispatching memory reads through the execution
// context. Omega has no thread spawn or dyn context, so the resolver
// becomes a caller-pumped driver: the composition root calls
// `pump_next_request` to obtain the next `MemoryReadRequest`, dispatches
// it through the unprivileged bindings (the privileged read executor),
// and feeds the response back with `accept_response`. The pump loop ends
// when `pump_next_request` returns false — the same materialization
// upstream performs inline.
//
// Upstream's two caches are kept: `cached_memory_read_responses` dedups
// identical reads inside one refresh; `cached_pointer_query_evaluations`
// dedups identical pointer walks. Both are bounded 16-entry tables
// (upstream's HashMap is unbounded; a watch set past 16 distinct reads
// degrades to re-reading — documented bound).
//
// Upstream `resolved_target_address` is `(address, module)` where the
// module clears after the first resolved hop — the walk fields mirror
// that (`current_module_name` emptied once the first offset applies).
// `evaluated_path` accumulates upstream's "root -> 0x.. -> ??" text as
// hex segments.
pub data VirtualSnapshotMaterializer {
    queries: [VirtualSnapshotQuery; 16];
    query_count: u64;
    current_query_index: u64;
    result_ids: [[u8; 128]; 16];
    result_id_lens: [u64; 16];
    results: [VirtualSnapshotQueryResult; 16];
    result_count: u64;
    has_pending_request: bool;
    pending_is_final_read: bool;
    pending_was_cached_insert: bool;
    pending_module_name: [u8; 512];
    pending_module_name_len: u64;
    // Pointer-walk state for the in-flight query.
    pointer_walk_active: bool;
    pointer: StoredPointer;
    current_address: u64;
    current_module_name: [u8; 512];
    current_module_name_len: u64;
    next_link_index: u64;
    evaluated_path: [u8; 512];
    evaluated_path_len: u64;
    pointer_walk_had_first_hop: bool;
    resolved_address: u64;
    resolved_module_name: [u8; 512];
    resolved_module_name_len: u64;
    // Dedup caches.
    cached_addresses: [u64; 16];
    cached_module_names: [[u8; 512]; 16];
    cached_module_name_lens: [u64; 16];
    cached_responses: [MemoryReadResponse; 16];
    cache_count: u64;
    cached_eval_pointers: [StoredPointer; 16];
    cached_eval_has_address: [bool; 16];
    cached_eval_addresses: [u64; 16];
    cached_eval_module_names: [[u8; 512]; 16];
    cached_eval_module_name_lens: [u64; 16];
    cached_eval_paths: [[u8; 512]; 16];
    cached_eval_path_lens: [u64; 16];
    eval_cache_count: u64;
}

pub machine VirtualSnapshotMaterializer::new() -> VirtualSnapshotMaterializer {
    VirtualSnapshotMaterializer {
        query_count: 0,
        current_query_index: 0,
        result_count: 0,
        has_pending_request: false,
        pending_is_final_read: false,
        pending_was_cached_insert: false,
        pending_module_name_len: 0,
        pointer_walk_active: false,
        pointer: StoredPointer::default(),
        current_address: 0,
        current_module_name_len: 0,
        next_link_index: 0,
        evaluated_path_len: 0,
        pointer_walk_had_first_hop: false,
        resolved_address: 0,
        resolved_module_name_len: 0,
        cache_count: 0,
        eval_cache_count: 0,
    }
}

// `begin` copies the snapshot's query list — upstream captures the Vec
// for the spawned thread; the driver needs the same owned snapshot.
pub machine VirtualSnapshotMaterializer::begin(this: &mut VirtualSnapshotMaterializer, virtual_snapshot: &VirtualSnapshot) -> bool {
    this.result_count = 0;
    this.current_query_index = 0;
    this.pointer_walk_active = false;
    VirtualSnapshotMaterializer::in_flight_reset(&mut this);
    this.cache_count = 0;
    this.eval_cache_count = 0;
    transition { _ -> fill(this, virtual_snapshot, 0) }
    state fill(this: &mut VirtualSnapshotMaterializer, virtual_snapshot: &VirtualSnapshot, position: u64) -> bool {
        let hoist1: u64 = VirtualSnapshot::get_query_count(&virtual_snapshot);
        transition position < hoist1 && position < 16 {
            true -> fill_one(this, virtual_snapshot, position)
            false -> finish(this, virtual_snapshot)
        }
    }
    state fill_one(this: &mut VirtualSnapshotMaterializer, virtual_snapshot: &VirtualSnapshot, position: u64) -> bool
        requires position < 16;
    {
        _ = VirtualSnapshot::copy_query(&virtual_snapshot, position, &mut this.queries[position]);
        transition { _ -> fill(this, virtual_snapshot, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(this: &mut VirtualSnapshotMaterializer, virtual_snapshot: &VirtualSnapshot) -> bool {
        this.query_count = VirtualSnapshot::get_query_count(&virtual_snapshot);
        transition this.query_count > 16 {
            true -> clamp(this)
            false -> (true)
        }
    }
    state clamp(this: &mut VirtualSnapshotMaterializer) -> bool {
        this.query_count = 16;
        (true)
    }
}

pub machine VirtualSnapshotMaterializer::get_result_count(this: &VirtualSnapshotMaterializer) -> u64 {
    this.result_count
}

pub machine VirtualSnapshotMaterializer::get_result_ids(this: &VirtualSnapshotMaterializer) -> &[[u8; 128]; 16] {
    (&this.result_ids)
}

pub machine VirtualSnapshotMaterializer::get_result_id_lens(this: &VirtualSnapshotMaterializer) -> &[u64; 16] {
    (&this.result_id_lens)
}

pub machine VirtualSnapshotMaterializer::get_results(this: &VirtualSnapshotMaterializer) -> &[VirtualSnapshotQueryResult; 16] {
    (&this.results)
}

pub machine VirtualSnapshotMaterializer::get_is_finished(this: &VirtualSnapshotMaterializer) -> bool {
    transition this.current_query_index >= this.query_count && !this.pointer_walk_active {
        true -> (true)
        false -> (false)
        _ -> (false)
    }
}

// The pump — emits the next memory read needed to materialize, or false
// when the refresh is complete.
pub machine VirtualSnapshotMaterializer::pump_next_request(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
    transition this.pointer_walk_active && this.current_query_index < 16 {
        true -> pump_walk(this, registry, out_request)
        false -> advance(this, registry, out_request)
        _ -> (false)
    }
    // Mid pointer-walk: the next hop is a pointer-width read at the
    // current address/module — the walk bails on a `Symbol` link.
    state pump_walk(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires this.current_query_index < 16;
    {
        let hoist3: u64 = StoredPointer::get_unresolvable_link_index(&this.pointer);
        let hoist2: bool = StoredPointer::get_has_unresolvable_link(&this.pointer);
        transition hoist2 && hoist3 == this.next_link_index {
            true -> bail_walk(this, registry, out_request)
            false -> walk_step(this, registry, out_request)
        }
    }
    state walk_step(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires this.current_query_index < 16;
    {
        let hoist4: u64 = StoredPointer::get_offset_count(&this.pointer);
        transition this.next_link_index < hoist4 && this.current_query_index < 16 {
            true -> emit_hop(this, registry, out_request)
            false -> emit_final(this, registry, out_request)
        }
    }
    state emit_hop(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires this.current_query_index < 16;
    {
        let mut pointer_struct: SymbolicStructDefinition = SymbolicStructDefinition::empty();
        let hoist5: bool = VirtualSnapshotMaterializer::pointer_size_definition(&this, registry, &mut pointer_struct);
        transition hoist5 {
            true -> emit_hop_read(this, registry, &pointer_struct, out_request)
            false -> bail_walk(this, registry, out_request)
        }
    }
    state emit_hop_read(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, pointer_struct: &SymbolicStructDefinition, out_request: &mut MemoryReadRequest) -> bool
        requires this.current_query_index < 16;
    {
        transition this.current_module_name_len <= 512 {
            true -> emit_hop_bounded(this, pointer_struct, out_request)
            false -> bail_walk(this, registry, out_request)
        }
    }
    state emit_hop_bounded(this: &mut VirtualSnapshotMaterializer, pointer_struct: &SymbolicStructDefinition, out_request: &mut MemoryReadRequest) -> bool
        requires this.current_query_index < 16;
    {
        let current_name: &[u8] = slice_512(&this.current_module_name, this.current_module_name_len);
        let request: MemoryReadRequest = MemoryReadRequest::new(this.current_address, current_name, SymbolicStructDefinition::clone(&pointer_struct), false);
        MemoryReadRequest::clone_from(&mut out_request, &request);
        this.has_pending_request = true;
        this.pending_is_final_read = false;
        (true)
    }
    // All hops applied — the resolved target gets the query's struct read.
    state emit_final(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires this.current_query_index < 16;
    {
        this.resolved_address = this.current_address;
        _ = copy_slice(&this.current_module_name, this.current_module_name_len, &mut this.resolved_module_name, &mut this.resolved_module_name_len);
        transition this.resolved_module_name_len <= 512 {
            true -> emit_final_bounded(this, registry, out_request)
            false -> (false)
        }
    }
    state emit_final_bounded(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires this.current_query_index < 16;
    {
        let mut query_struct: SymbolicStructDefinition = SymbolicStructDefinition::empty();
        VirtualSnapshotQuery::get_symbolic_struct_definition(&this.queries[this.current_query_index], &mut query_struct);
        let resolved_name: &[u8] = slice_512(&this.resolved_module_name, this.resolved_module_name_len);
        let request: MemoryReadRequest = MemoryReadRequest::new(this.resolved_address, resolved_name, query_struct, false);
        MemoryReadRequest::clone_from(&mut out_request, &request);
        this.has_pending_request = true;
        this.pending_is_final_read = true;
        (true)
    }
    // `??` — upstream bails the evaluation with an unresolved target.
    state bail_walk(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        _ = VirtualSnapshotMaterializer::append_path_segment(&mut this, "??");
        transition { _ -> finish_walk_failed(this, registry, out_request) }
    }
    state finish_walk_failed(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        _ = VirtualSnapshotMaterializer::store_eval_cache(&mut this, 0, false);
        let position: u64 = this.current_query_index;
        transition position < 16 {
            true -> finish_failed_result(this, position)
            false -> advance_finished(this, position, registry, out_request)
        }
    }
    state finish_failed_result(this: &mut VirtualSnapshotMaterializer, position: u64) -> bool
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&this.evaluated_path, this.evaluated_path_len);
        _ = result_set_evaluated_path(&mut this.results[position], path_slice);
        _ = VirtualSnapshotMaterializer::store_result_id(&mut this, position);
        this.pointer_walk_active = false;
        this.has_pending_request = false;
        this.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (false)
    }
    state advance_finished(this: &mut VirtualSnapshotMaterializer, position: u64, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        this.pointer_walk_active = false;
        this.has_pending_request = false;
        this.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> advance(this, registry, out_request) }
    }
    state advance(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        transition this.current_query_index < this.query_count {
            true -> route(this, registry, out_request)
            false -> (false)
        }
    }
    state route(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        transition this.current_query_index < 16 {
            true -> route_kind(this, registry, out_request)
            false -> (false)
        }
    }
    state route_kind(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires this.current_query_index < 16;
    {
        let hoist6: bool = VirtualSnapshotQuery::get_is_address(&this.queries[this.current_query_index]);
        transition hoist6 {
            true -> address_query(this, registry, out_request)
            false -> pointer_query(this, registry, out_request)
        }
    }
    state address_query(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires this.current_query_index < 16;
    {
        let query_address: u64 = VirtualSnapshotQuery::get_address(&this.queries[this.current_query_index]);
        let mut module_name: [u8; 512];
        let mut module_name_len: u64 = 0;
        VirtualSnapshotQuery::copy_module_name(&this.queries[this.current_query_index], &mut module_name, &mut module_name_len);
        transition { _ -> cache_probe(this, registry, out_request, query_address, module_name, module_name_len, 0) }
    }
    // Read cache probe — on a hit the stored response fills the result
    // and the pump advances without emitting a request.
    state cache_probe(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64) -> bool
        requires this.current_query_index < 16;
    {
        transition cache_position < this.cache_count && cache_position < 16 {
            true -> cache_compare(this, registry, out_request, query_address, module_name, module_name_len, cache_position)
            false -> emit_address_read(this, out_request, query_address, module_name, module_name_len)
        }
    }
    state cache_compare(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64) -> bool
        requires cache_position < 16 && this.current_query_index < 16;
    {
        transition this.cached_addresses[cache_position] == query_address && this.cached_module_name_lens[cache_position] == module_name_len {
            true -> cache_bytes(this, registry, out_request, query_address, module_name, module_name_len, cache_position, 0)
            false -> cache_probe(this, registry, out_request, query_address, module_name, module_name_len, ((cache_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state cache_bytes(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64, index: u64) -> bool
        requires cache_position < 16 && this.current_query_index < 16;
    {
        transition index < module_name_len && index < 512 {
            true -> cache_char(this, registry, out_request, query_address, module_name, module_name_len, cache_position, index)
            false -> serve_cached(this, registry, out_request, query_address, module_name, module_name_len, cache_position)
        }
    }
    state cache_char(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64, index: u64) -> bool
        requires cache_position < 16 && index < module_name_len && index < 512 && this.current_query_index < 16;
    {
        transition this.cached_module_names[cache_position][index] == module_name[index] {
            true -> cache_bytes(this, registry, out_request, query_address, module_name, module_name_len, cache_position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> cache_probe(this, registry, out_request, query_address, module_name, module_name_len, ((cache_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state serve_cached(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64) -> bool
        requires cache_position < 16;
    {
        let cached_response: MemoryReadResponse = MemoryReadResponse::clone(&this.cached_responses[cache_position]);
        let position: u64 = this.current_query_index;
        transition position < 16 {
            true -> serve_cached_result(this, position, &cached_response, query_address, module_name, module_name_len, registry, out_request)
            false -> advance(this, registry, out_request)
        }
    }
    state serve_cached_result(this: &mut VirtualSnapshotMaterializer, position: u64, cached_response: &MemoryReadResponse, query_address: u64, module_name: &[u8; 512], module_name_len: u64, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires position < 16;
    {
        VirtualSnapshotQueryResult::set_memory_read_response(&mut this.results[position], cached_response);
        VirtualSnapshotQueryResult::set_resolved_address(&mut this.results[position], query_address);
        let module_name_slice: &[u8] = slice_512(module_name, module_name_len);
        _ = result_set_module_name(&mut this.results[position], module_name_slice);
        
        this.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> advance(this, registry, out_request) }
    }
    state emit_address_read(this: &mut VirtualSnapshotMaterializer, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64) -> bool
        requires this.current_query_index < 16;
    {
        transition module_name_len <= 512 {
            true -> emit_address_bounded(this, out_request, query_address, module_name, module_name_len)
            false -> (false)
        }
    }
    state emit_address_bounded(this: &mut VirtualSnapshotMaterializer, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64) -> bool
        requires this.current_query_index < 16;
    {
        let mut query_struct: SymbolicStructDefinition = SymbolicStructDefinition::empty();
        VirtualSnapshotQuery::get_symbolic_struct_definition(&this.queries[this.current_query_index], &mut query_struct);
        let module_name_slice: &[u8] = slice_512(module_name, module_name_len);
        let request: MemoryReadRequest = MemoryReadRequest::new(query_address, module_name_slice, query_struct, false);
        MemoryReadRequest::clone_from(&mut out_request, &request);
        this.has_pending_request = true;
        this.pending_is_final_read = true;
        this.pending_was_cached_insert = true;
        _ = copy_slice(module_name, module_name_len, &mut this.pending_module_name, &mut this.pending_module_name_len);
        (true)
    }
    state pointer_query(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires this.current_query_index < 16;
    {
        _ = query_copy_pointer(&this.queries[this.current_query_index], &mut this.pointer);
        // Seed the evaluated path with the root display text — upstream
        // pushes `pointer.get_root_display_text()` first (module + hex root).
        this.evaluated_path_len = 0;
        transition { _ -> seed_root(this, registry, out_request) }
    }
    state seed_root(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires this.current_query_index < 16;
    {
        _ = VirtualSnapshotMaterializer::append_path_segment(&mut this, StoredPointer::get_module_name(&this.pointer));
        _ = VirtualSnapshotMaterializer::append_hex_prefix(&mut this);
        _ = VirtualSnapshotMaterializer::append_hex_u64(&mut this, StoredPointer::get_address(&this.pointer));
        transition { _ -> eval_probe(this, registry, out_request, 0) }
    }
    state eval_probe(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires this.current_query_index < 16;
    {
        transition cache_position < this.eval_cache_count && cache_position < 16 {
            true -> eval_compare(this, registry, out_request, cache_position)
            false -> start_walk(this)
        }
    }
    state eval_compare(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires cache_position < 16 && this.current_query_index < 16;
    {
        let hoist7: bool = StoredPointer::equals(&this.cached_eval_pointers[cache_position], &this.pointer);
        transition hoist7 {
            true -> serve_eval(this, registry, out_request, cache_position)
            false -> eval_probe(this, registry, out_request, ((cache_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    // Cached eval — a resolved target goes straight to the final read; a
    // cached failure completes the query with an empty result.
    state serve_eval(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires cache_position < 16 && this.current_query_index < 16;
    {
        transition this.cached_eval_has_address[cache_position] {
            true -> eval_read(this, registry, out_request, cache_position)
            false -> eval_miss(this, registry, out_request, cache_position)
        }
    }
    state eval_read(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires cache_position < 16 && this.current_query_index < 16;
    {
        this.resolved_address = this.cached_eval_addresses[cache_position];
        _ = copy_slice(&this.cached_eval_module_names[cache_position], this.cached_eval_module_name_lens[cache_position], &mut this.resolved_module_name, &mut this.resolved_module_name_len);
        _ = copy_slice(&this.cached_eval_paths[cache_position], this.cached_eval_path_lens[cache_position], &mut this.evaluated_path, &mut this.evaluated_path_len);
        transition { _ -> emit_final(this, registry, out_request) }
    }
    state eval_miss(this: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires cache_position < 16;
    {
        let position: u64 = this.current_query_index;
        _ = copy_slice(&this.cached_eval_paths[cache_position], this.cached_eval_path_lens[cache_position], &mut this.evaluated_path, &mut this.evaluated_path_len);
        transition position < 16 {
            true -> eval_miss_result(this, position)
            false -> advance_finished(this, position, registry, out_request)
        }
    }
    state eval_miss_result(this: &mut VirtualSnapshotMaterializer, position: u64) -> bool
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&this.evaluated_path, this.evaluated_path_len);
        _ = result_set_evaluated_path(&mut this.results[position], path_slice);
        
        this.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (false)
    }
    state start_walk(this: &mut VirtualSnapshotMaterializer) -> bool {
        this.pointer_walk_active = true;
        this.pointer_walk_had_first_hop = false;
        this.current_address = StoredPointer::get_address(&this.pointer);
        StoredPointer::copy_module_name(&this.pointer, &mut this.current_module_name, &mut this.current_module_name_len);
        this.next_link_index = 0;
        (false)
    }

}

machine VirtualSnapshotMaterializer::in_flight_reset(this: &mut VirtualSnapshotMaterializer) {
    this.has_pending_request = false;
    this.pending_is_final_read = false;
    this.pending_was_cached_insert = false;
}

// `accept_response` — the composition root feeds each dispatched
// response back; hop responses drive the next offset, final responses
// complete the query's result.
pub machine VirtualSnapshotMaterializer::accept_response(this: &mut VirtualSnapshotMaterializer, response: &MemoryReadResponse) {
    this.has_pending_request = false;
    transition this.pending_is_final_read {
        true -> complete_query(this, response)
        false -> apply_hop(this, response)
        _ -> complete_query(this, response)
    }
    state complete_query(this: &mut VirtualSnapshotMaterializer, response: &MemoryReadResponse) {
        let position: u64 = this.current_query_index;
        transition position < 16 {
            true -> route_kind(this, position, response)
            false -> done(this)
        }
    }
    state route_kind(this: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        transition this.pointer_walk_active {
            true -> complete_pointer(this, position, response)
            false -> complete_address(this, position, response)
        }
    }
    state complete_address(this: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let hoist8: bool = MemoryReadResponse::get_success(&response);
        transition hoist8 {
            true -> fill_address_result(this, position, response)
            false -> fill_failed_result(this, position, response)
        }
    }
    state fill_address_result(this: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        VirtualSnapshotQueryResult::set_memory_read_response(&mut this.results[position], response);
        VirtualSnapshotQueryResult::set_resolved_address(&mut this.results[position], MemoryReadResponse::get_address(response));
        transition this.pending_module_name_len <= 512 {
            true -> fill_address_module(this, position, response)
            false -> fill_address_finish(this, position, response)
        }
    }
    state fill_address_module(this: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let pending_name: &[u8] = slice_512(&this.pending_module_name, this.pending_module_name_len);
        _ = result_set_module_name(&mut this.results[position], pending_name);
        transition { _ -> fill_address_finish(this, position, response) }
    }
    state fill_address_finish(this: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        
        _ = VirtualSnapshotMaterializer::store_read_cache(&mut this, response);
        this.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done(this) }
    }
    state fill_failed_result(this: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        
        _ = VirtualSnapshotMaterializer::store_read_cache(&mut this, response);
        this.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done(this) }
    }
    state complete_pointer(this: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let hoist9: bool = MemoryReadResponse::get_success(&response);
        transition hoist9 {
            true -> fill_pointer_result(this, position, response)
            false -> fill_pointer_failed(this, position, response)
        }
    }
    state fill_pointer_result(this: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        VirtualSnapshotQueryResult::set_memory_read_response(&mut this.results[position], response);
        VirtualSnapshotQueryResult::set_resolved_address(&mut this.results[position], this.resolved_address);
        transition this.resolved_module_name_len <= 512 {
            true -> fill_pointer_module(this, position, response)
            false -> fill_pointer_path(this, position, response)
        }
    }
    state fill_pointer_module(this: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let resolved_name: &[u8] = slice_512(&this.resolved_module_name, this.resolved_module_name_len);
        _ = result_set_module_name(&mut this.results[position], resolved_name);
        transition { _ -> fill_pointer_path(this, position, response) }
    }
    state fill_pointer_path(this: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&this.evaluated_path, this.evaluated_path_len);
        _ = result_set_evaluated_path(&mut this.results[position], path_slice);
        
        _ = VirtualSnapshotMaterializer::store_eval_cache(&mut this, this.resolved_address, true);
        _ = VirtualSnapshotMaterializer::store_read_cache(&mut this, response);
        this.pointer_walk_active = false;
        this.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done(this) }
    }
    state fill_pointer_failed(this: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&this.evaluated_path, this.evaluated_path_len);
        _ = result_set_evaluated_path(&mut this.results[position], path_slice);
        
        _ = VirtualSnapshotMaterializer::store_eval_cache(&mut this, this.resolved_address, true);
        _ = VirtualSnapshotMaterializer::store_read_cache(&mut this, response);
        this.pointer_walk_active = false;
        this.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done(this) }
    }
    // A hop response: extract the pointer value from the first field's
    // bytes (pointer-width little/big endian), apply the offset, and
    // advance. A failed read or overflow bails with `??`.
    state apply_hop(this: &mut VirtualSnapshotMaterializer, response: &MemoryReadResponse) {
        let hoist10: bool = MemoryReadResponse::get_success(&response);
        transition hoist10 {
            true -> read_value(this, response)
            false -> bail(this)
        }
    }
    state read_value(this: &mut VirtualSnapshotMaterializer, response: &MemoryReadResponse) {
        let valued_struct: &ValuedStruct = MemoryReadResponse::get_valued_struct(&response);
        let field: ValuedStructField = ValuedStruct::get_field_at(&valued_struct, 0);
        let data_value: DataValue = ValuedStructField::get_data_value(&field);
        let bytes: &[u8] = DataValue::get_value_bytes(&data_value);
        let pointer_endian: Endian = VirtualSnapshotMaterializer::get_pointer_endian(&this);
        let value: u64 = assemble_pointer_value(bytes, StoredPointer::get_pointer_size(&this.pointer), pointer_endian);
        let offset: i64 = StoredPointer::get_offset(&this.pointer, this.next_link_index);
        transition { _ -> apply_offset(this, value, offset) }
    }
    state apply_offset(this: &mut VirtualSnapshotMaterializer, value: u64, offset: i64) {
        transition offset >= 0 {
            true -> add_offset(this, value, offset)
            false -> sub_offset(this, value, offset)
        }
    }
    state add_offset(this: &mut VirtualSnapshotMaterializer, value: u64, offset: i64)
        requires offset >= 0;
    {
        // `apply_pointer_offset` — checked_add for non-negative offsets:
        // overflow refuses rather than wrapping.
        let offset_magnitude: u64 = offset as u64;
        transition offset_magnitude <= (18446744073709551615 - value) {
            true -> apply_add(this, value, offset)
            false -> bail(this)
        }
    }
    state sub_offset(this: &mut VirtualSnapshotMaterializer, value: u64, offset: i64) {
        // Negative offset — the u64 magnitude is the wrapping negation of
        // the two's-complement cast.
        let magnitude: u64 = ((0 - (offset as u64 in Wrapping)) as u64 in Wrapping) as u64;
        transition value >= magnitude {
            true -> apply_sub(this, value, offset)
            false -> bail(this)
        }
    }
    state apply_add(this: &mut VirtualSnapshotMaterializer, value: u64, offset: i64)
        requires offset >= 0;
    {
        this.current_address = ((value as u64 in Wrapping) + ((offset as u64 in Wrapping) as u64 in Wrapping)) as u64;
        transition { _ -> after_hop(this) }
    }
    state apply_sub(this: &mut VirtualSnapshotMaterializer, value: u64, offset: i64)
        requires offset < 0;
    {
        let magnitude: u64 = ((0 - (offset as u64 in Wrapping)) as u64 in Wrapping) as u64;
        this.current_address = ((value as u64 in Wrapping) - (magnitude as u64 in Wrapping)) as u64;
        transition { _ -> after_hop(this) }
    }
    state after_hop(this: &mut VirtualSnapshotMaterializer) {
        // Upstream clears the module once the first offset applies.
        this.current_module_name_len = 0;
        this.pointer_walk_had_first_hop = true;
        this.next_link_index = ((this.next_link_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        _ = VirtualSnapshotMaterializer::append_path_segment(&mut this, "0x..");
        transition { _ -> done(this) }
    }
    state bail(this: &mut VirtualSnapshotMaterializer) {
        _ = VirtualSnapshotMaterializer::append_path_segment(&mut this, "??");
        _ = VirtualSnapshotMaterializer::store_eval_cache(&mut this, 0, false);
        let position: u64 = this.current_query_index;
        transition position < 16 {
            true -> bail_result(this, position)
            false -> done(this)
        }
    }
    state bail_result(this: &mut VirtualSnapshotMaterializer, position: u64)
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&this.evaluated_path, this.evaluated_path_len);
        _ = result_set_evaluated_path(&mut this.results[position], path_slice);
        
        this.pointer_walk_active = false;
        this.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done(this) }
    }
    state done(this: &mut VirtualSnapshotMaterializer) {
    }
}

// Byte-array helpers — copy a bounded array into another with a length.
machine copy_slice(source: &[u8; 512], source_len: u64, destination: &mut [u8; 512], destination_len: &mut u64) -> bool {
    transition { _ -> copy(source, source_len, destination, destination_len, 0) }
    state copy(source: &[u8; 512], source_len: u64, destination: &mut [u8; 512], destination_len: &mut u64, position: u64) -> bool

    {
        transition position < source_len && position < 512 {
            true -> copy_one(source, source_len, destination, destination_len, position)
            false -> finish(source_len, destination_len)
        }
    }
    state copy_one(source: &[u8; 512], source_len: u64, destination: &mut [u8; 512], destination_len: &mut u64, position: u64) -> bool
        requires position < source_len && position < 512;
    {
        destination[position] = source[position];
        transition { _ -> copy(source, source_len, destination, destination_len, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(source_len: u64, destination_len: &mut u64) -> bool {
        destination_len = source_len;
        (true)
    }
}

// `read_pointer_value` — assemble the little/big-endian pointer-width
// value from the read bytes.
machine assemble_pointer_value(bytes: &[u8], pointer_size: u64, endian: Endian) -> u64 {
    transition endian {
        Endian::Little -> assemble_le(bytes, pointer_size, 0, 0)
        Endian::Big -> assemble_be(bytes, pointer_size, 0, 0)
        _ -> (0)
    }
    state assemble_le(bytes: &[u8], pointer_size: u64, index: u64, value: u64) -> u64

    {
        transition index < pointer_size && index < bytes.len && index < 8 {
            true -> accumulate_le(bytes, pointer_size, index, value)
            false -> (value)
        }
    }
    // Little-endian fold: value | (byte << index*8). `index < 8` (from the
    // requires) bounds the multiply and shift; the byte cast is a widening.
    state accumulate_le(bytes: &[u8], pointer_size: u64, index: u64, value: u64) -> u64
        requires index < bytes.len && index < 8;
    {
        let next_index: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let next_value: u64 = value | ((bytes[index] as u64) << (index * 8));
        transition { _ -> assemble_le(bytes, pointer_size, next_index, next_value) }
    }
    state assemble_be(bytes: &[u8], pointer_size: u64, index: u64, value: u64) -> u64

    {
        transition index < pointer_size && index < bytes.len && index < 8 {
            true -> accumulate_be(bytes, pointer_size, index, value)
            false -> (value)
        }
    }
    // Big-endian fold: (value << 8) | byte. The shift can legitimately
    // discard top bits once enough bytes accumulate (a u64 read at pointer
    // size 8 fills exactly); wrapping is the honest spelling.
    state accumulate_be(bytes: &[u8], pointer_size: u64, index: u64, value: u64) -> u64
        requires index < bytes.len && index < 8;
    {
        let next_index: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let next_value: u64 = (((value as u64 in Wrapping) << 8) | (bytes[index] as u64 in Wrapping)) as u64;
        transition { _ -> assemble_be(bytes, pointer_size, next_index, next_value) }
    }
}

// Insert into the read cache — keyed by (response address, module).
machine VirtualSnapshotMaterializer::store_read_cache(this: &mut VirtualSnapshotMaterializer, response: &MemoryReadResponse) -> bool {
    transition this.cache_count < 16 {
        true -> store(this, response)
        false -> (false)
        _ -> (false)
    }
    state store(this: &mut VirtualSnapshotMaterializer, response: &MemoryReadResponse) -> bool {
        let slot: u64 = this.cache_count;
        this.cached_addresses[slot] = MemoryReadResponse::get_address(&response);
        MemoryReadResponse::clone_from(&mut this.cached_responses[slot], response);
        transition this.pending_was_cached_insert {
            true -> store_module(this, slot)
            false -> store_empty_module(this, slot)
        }
    }
    state store_module(this: &mut VirtualSnapshotMaterializer, slot: u64) -> bool
        requires slot < 16;
    {
        _ = copy_slice(&this.pending_module_name, this.pending_module_name_len, &mut this.cached_module_names[slot], &mut this.cached_module_name_lens[slot]);
        this.cache_count = ((this.cache_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
    state store_empty_module(this: &mut VirtualSnapshotMaterializer, slot: u64) -> bool
        requires slot < 16;
    {
        this.cached_module_name_lens[slot] = 0;
        this.cache_count = ((this.cache_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// `pointer_size_definition` — resolves the pointer-width data type's
// struct layout through the registry cache.
machine VirtualSnapshotMaterializer::pointer_size_definition(this: &VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_definition: &mut SymbolicStructDefinition) -> bool {
    let pointer_size: PointerScanPointerSize = VirtualSnapshotMaterializer::pointer_size_value(&this);
    let data_type_ref: DataTypeRef = PointerScanPointerSize::to_data_type_ref(&pointer_size);
    let hoist13: bool = PrivilegedRegistryCache::resolve_struct_layout_definition(&registry, DataTypeRef::get_data_type_id(&data_type_ref), &mut out_definition);
    (hoist13)
}

machine VirtualSnapshotMaterializer::pointer_size_value(this: &VirtualSnapshotMaterializer) -> PointerScanPointerSize {
    let hoist11: u64 = StoredPointer::get_pointer_size(&this.pointer);
    transition hoist11 == 4 {
        true -> (PointerScanPointerSize::Pointer32)
        false -> check_three(this)
        _ -> (PointerScanPointerSize::Pointer64)
    }
    state check_three(this: &VirtualSnapshotMaterializer) -> PointerScanPointerSize {
        let hoist12: u64 = StoredPointer::get_pointer_size(&this.pointer);
        transition hoist12 == 3 {
            true -> (PointerScanPointerSize::Pointer24)
            false -> (PointerScanPointerSize::Pointer64)
        }
    }
}

// Records the query's id alongside its result slot.
machine VirtualSnapshotMaterializer::store_result_id(this: &mut VirtualSnapshotMaterializer, position: u64) -> bool {
    transition position < 16 {
        true -> store_id(this, position)
        false -> (false)
        _ -> (false)
    }
    state store_id(this: &mut VirtualSnapshotMaterializer, position: u64) -> bool
        requires position < 16;
    {
        let mut query_id: [u8; 128];
        let mut query_id_len: u64 = 0;
        VirtualSnapshotQuery::copy_query_id_into(&this.queries[position], &mut query_id, &mut query_id_len);
        this.result_ids[position] = query_id;
        this.result_id_lens[position] = query_id_len;
        transition this.result_count < 16 {
            true -> bump(this, position)
            false -> (true)
        }
    }
    state bump(this: &mut VirtualSnapshotMaterializer, position: u64) -> bool
        requires position < 16;
    {
        transition position == this.result_count {
            true -> bump_it(this)
            false -> (true)
        }
    }
    state bump_it(this: &mut VirtualSnapshotMaterializer) -> bool {
        this.result_count = ((this.result_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `cached_pointer_query_evaluations.insert` — dedup by pointer.
machine VirtualSnapshotMaterializer::store_eval_cache(this: &mut VirtualSnapshotMaterializer, resolved_address: u64, has_address: bool) -> bool {
    transition this.eval_cache_count < 16 {
        true -> store_eval(this, resolved_address, has_address)
        false -> (false)
        _ -> (false)
    }
    state store_eval(this: &mut VirtualSnapshotMaterializer, resolved_address: u64, has_address: bool) -> bool {
        let slot: u64 = this.eval_cache_count;
        StoredPointer::clone_from(&mut this.cached_eval_pointers[slot], &this.pointer);
        this.cached_eval_has_address[slot] = has_address;
        this.cached_eval_addresses[slot] = resolved_address;
        transition has_address {
            true -> store_eval_module(this, slot)
            false -> store_eval_path_only(this, slot)
        }
    }
    state store_eval_module(this: &mut VirtualSnapshotMaterializer, slot: u64) -> bool
        requires slot < 16;
    {
        _ = copy_slice(&this.resolved_module_name, this.resolved_module_name_len, &mut this.cached_eval_module_names[slot], &mut this.cached_eval_module_name_lens[slot]);
        _ = copy_slice(&this.evaluated_path, this.evaluated_path_len, &mut this.cached_eval_paths[slot], &mut this.cached_eval_path_lens[slot]);
        this.eval_cache_count = ((this.eval_cache_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
    state store_eval_path_only(this: &mut VirtualSnapshotMaterializer, slot: u64) -> bool
        requires slot < 16;
    {
        this.cached_eval_module_name_lens[slot] = 0;
        _ = copy_slice(&this.evaluated_path, this.evaluated_path_len, &mut this.cached_eval_paths[slot], &mut this.cached_eval_path_lens[slot]);
        this.eval_cache_count = ((this.eval_cache_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Appends " -> <text>" (or the leading segment) to evaluated_path —
// upstream `evaluated_path_segments.join(" -> ")`.
machine VirtualSnapshotMaterializer::append_path_segment(this: &mut VirtualSnapshotMaterializer, text: &[u8]) -> bool {
    transition this.evaluated_path_len == 0 {
        true -> append_text(this, text)
        false -> sep(this, text)
        _ -> append_text(this, text)
    }
    state sep(this: &mut VirtualSnapshotMaterializer, text: &[u8]) -> bool {
        transition this.evaluated_path_len <= 508 {
            true -> write_sep(this, text)
            false -> (false)
        }
    }
    state write_sep(this: &mut VirtualSnapshotMaterializer, text: &[u8]) -> bool
        requires this.evaluated_path_len <= 508;
    {
        let index_one: u64 = this.evaluated_path_len + 1;
        let index_two: u64 = this.evaluated_path_len + 2;
        let index_three: u64 = this.evaluated_path_len + 3;
        transition index_one < 512 && index_two < 512 && index_three < 512 {
            true -> write_sep_bounded(this, text, index_one, index_two, index_three)
            _ -> (false)
        }
    }
    state write_sep_bounded(this: &mut VirtualSnapshotMaterializer, text: &[u8], index_one: u64, index_two: u64, index_three: u64) -> bool
        requires this.evaluated_path_len <= 508 && index_one < 512 && index_two < 512 && index_three < 512;
    {
        this.evaluated_path[this.evaluated_path_len] = 32;
        this.evaluated_path[index_one] = 45;
        this.evaluated_path[index_two] = 62;
        this.evaluated_path[index_three] = 32;
        this.evaluated_path_len = this.evaluated_path_len + 4;
        transition { _ -> append_text(this, text) }
    }
    state append_text(this: &mut VirtualSnapshotMaterializer, text: &[u8]) -> bool {
        transition { _ -> loop_copy(this, text, 0) }
    }
    state loop_copy(this: &mut VirtualSnapshotMaterializer, text: &[u8], index: u64) -> bool

    {
        transition index < text.len && this.evaluated_path_len < 512 {
            true -> copy_char(this, text, index)
            false -> (true)
        }
    }
    state copy_char(this: &mut VirtualSnapshotMaterializer, text: &[u8], index: u64) -> bool
        requires index < text.len;
    {
        this.evaluated_path[this.evaluated_path_len] = text[index];
        this.evaluated_path_len = ((this.evaluated_path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> loop_copy(this, text, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Appends the "0x" prefix onto the evaluated path.
machine VirtualSnapshotMaterializer::append_hex_prefix(this: &mut VirtualSnapshotMaterializer) -> bool {
    transition this.evaluated_path_len <= 510 {
        true -> write(this)
        false -> (false)
        _ -> (false)
    }
    state write(this: &mut VirtualSnapshotMaterializer) -> bool
        requires this.evaluated_path_len <= 510;
    {
        let index_one: u64 = this.evaluated_path_len + 1;
        transition index_one < 512 {
            true -> write_bounded(this, index_one)
            _ -> (false)
        }
    }
    state write_bounded(this: &mut VirtualSnapshotMaterializer, index_one: u64) -> bool
        requires this.evaluated_path_len <= 510 && index_one < 512;
    {
        this.evaluated_path[this.evaluated_path_len] = 48;
        this.evaluated_path[index_one] = 120;
        this.evaluated_path_len = this.evaluated_path_len + 2;
        (true)
    }
}

// Appends an uppercase hex rendering — upstream `format!("{:X}", address)`.
// Zero renders as a single '0'.
machine VirtualSnapshotMaterializer::append_hex_u64(this: &mut VirtualSnapshotMaterializer, value: u64) -> bool {
    transition { _ -> walk(this, 15, value) }
    state walk(this: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)

    {
        transition nibble > 0 {
            true -> check_leading(this, nibble, value)
            false -> last_digit(this, value)
        }
    }
    state check_leading(this: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)
        requires nibble > 0;
    {
        // The nibble cursor walks 15 down to 0 upstream — the `nibble * 4`
        // shift count needs the bound re-spelled so it reaches the multiply
        // and shift obligations inside the dominated state.
        transition nibble <= 15 {
            true -> check_leading_bounded(this, nibble, value)
            _ -> step_down(this, nibble, value)
        }
    }
    state check_leading_bounded(this: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)
        requires nibble <= 15 && nibble > 0;
    {
        transition (value >> (nibble * 4)) & 15 != 0 {
            true -> write_nibble(this, nibble, value)
            false -> step_down(this, nibble, value)
        }
    }
    state step_down(this: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)
        requires nibble > 0;
    {
        let next_nibble: u64 = nibble - 1;
        transition { _ -> walk_from(this, next_nibble, value) }
    }
    state walk_from(this: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)

    {
        transition nibble > 0 {
            true -> check_leading(this, nibble, value)
            false -> last_digit(this, value)
        }
    }
    state write_nibble(this: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64) {
        transition nibble <= 15 {
            true -> write_nibble_bounded(this, nibble, value)
            _ -> (true)
        }
    }
    state write_nibble_bounded(this: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)
        requires nibble <= 15;
    {
        _ = VirtualSnapshotMaterializer::append_hex_digit(&mut this, ((value >> (nibble * 4)) & 15) as u8);
        transition nibble > 0 {
            true -> write_step(this, nibble, value)
            false -> (true)
        }
    }
    state write_step(this: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)
        requires nibble <= 15 && nibble > 0;
    {
        let next_nibble: u64 = nibble - 1;
        transition { _ -> write_rest(this, next_nibble, value) }
    }
    state write_rest(this: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64) {
        transition nibble <= 15 {
            true -> write_rest_bounded(this, nibble, value)
            _ -> (true)
        }
    }
    state write_rest_bounded(this: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)
        requires nibble <= 15;
    {
        _ = VirtualSnapshotMaterializer::append_hex_digit(&mut this, ((value >> (nibble * 4)) & 15) as u8);
        transition nibble > 0 {
            true -> write_step(this, nibble, value)
            false -> (true)
        }
    }
    state last_digit(this: &mut VirtualSnapshotMaterializer, value: u64) -> bool {
        _ = VirtualSnapshotMaterializer::append_hex_digit(&mut this, (value & 15) as u8);
        (true)
    }
}

machine VirtualSnapshotMaterializer::append_hex_digit(this: &mut VirtualSnapshotMaterializer, digit: u8) -> bool {
    transition digit < 10 {
        true -> numeric(this, digit)
        false -> letter(this, digit)
        _ -> letter(this, digit)
    }
    state numeric(this: &mut VirtualSnapshotMaterializer, digit: u8) -> bool {
        transition this.evaluated_path_len < 512 {
            true -> write_digit(this, digit + 48)
            false -> (false)
        }
    }
    state letter(this: &mut VirtualSnapshotMaterializer, digit: u8) -> bool {
        transition digit >= 10 && digit < 16 && this.evaluated_path_len < 512 {
            true -> write_letter(this, digit)
            false -> (false)
        }
    }
    state write_letter(this: &mut VirtualSnapshotMaterializer, digit: u8) -> bool {
        this.evaluated_path[this.evaluated_path_len] = digit + 55;
        this.evaluated_path_len = ((this.evaluated_path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
    state write_digit(this: &mut VirtualSnapshotMaterializer, byte: u8) -> bool {
        this.evaluated_path[this.evaluated_path_len] = byte;
        this.evaluated_path_len = ((this.evaluated_path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Indexed-element receivers do not parse under `_ =` — these helpers take
// the element as an argument instead.
machine result_set_evaluated_path(result: &mut VirtualSnapshotQueryResult, path: &[u8]) -> bool {
    let hoist14: bool = set_evaluated_pointer_path(result, path);
    (hoist14)
}

machine result_set_module_name(result: &mut VirtualSnapshotQueryResult, module_name: &[u8]) -> bool {
    let hoist15: bool = set_resolved_module_name(result, module_name);
    (hoist15)
}

machine query_copy_pointer(query: &VirtualSnapshotQuery, pointer: &mut StoredPointer) -> bool {
    let hoist16: bool = copy_pointer(query, pointer);
    (hoist16)
}

// Record-machine counterpart of the hop-endian probe (internal states are
// transition destinations, not value callees). Upstream reads hops in the
// process endianness — the materializer tracks it per walk today as the
// pointer-size default; the real source lands with the executor leg's
// OpenedProcess plumbing (documented approximation).
machine VirtualSnapshotMaterializer::get_pointer_endian(this: &VirtualSnapshotMaterializer) -> Endian {
    (Endian::Little)
}
