module src::virtual_snapshots::virtual_snapshot_materializer;

use squalr_engine_api::src::commands::memory::read::memory_read_request::MemoryReadRequest;
use squalr_engine_api::src::commands::memory::read::memory_read_response::MemoryReadResponse;
use squalr_engine_api::src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;
use squalr_engine_api::src::structures::structs::valued_struct_field::ValuedStructField;
use squalr_engine_api::src::structures::structs::valued_struct::ValuedStruct;
use squalr_engine_api::src::structures::data_values::data_value::DataValue;
use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use squalr_engine_api::src::structures::memory::endian::Endian;
use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use src::virtual_snapshots::virtual_snapshot::VirtualSnapshot;
use src::virtual_snapshots::virtual_snapshot_query::VirtualSnapshotQuery;
use src::virtual_snapshots::virtual_snapshot_query_result::VirtualSnapshotQueryResult;
use src::virtual_snapshots::stored_pointer::StoredPointer;
use src::virtual_snapshots::stored_pointer::slice_512;
use src::registries::privileged_registry_cache::PrivilegedRegistryCache;

// Port of virtual_snapshots/virtual_snapshot_resolver.rs. Upstream
// `materialize_virtual_snapshot_queries` runs synchronously inside a
// spawned thread, dispatching memory reads through the execution
// context. Omega has no thread spawn or dyn context, so the resolver
// becomes a caller-pumped driver: the composition root calls
// `pump_next_request` to obtain the next `MemoryReadRequest`, dispatches
// it through the unprivileged bindings (the privileged read executor),
// and feeds the response back with `accept_response`. The pump loop ends
// when `pump_next_request` returns false — the same materialization
// upstream performs inline.
//
// Upstream's two caches are kept: `cached_memory_read_responses` dedups
// identical reads inside one refresh; `cached_pointer_query_evaluations`
// dedups identical pointer walks. Both are bounded 16-entry tables
// (upstream's HashMap is unbounded; a watch set past 16 distinct reads
// degrades to re-reading — documented bound).
//
// Upstream `resolved_target_address` is `(address, module)` where the
// module clears after the first resolved hop — the walk fields mirror
// that (`current_module_name` emptied once the first offset applies).
// `evaluated_path` accumulates upstream's "root -> 0x.. -> ??" text as
// hex segments.
pub data VirtualSnapshotMaterializer {
    queries: [VirtualSnapshotQuery; 16];
    query_count: u64;
    current_query_index: u64;
    result_ids: [[u8; 128]; 16];
    result_id_lens: [u64; 16];
    results: [VirtualSnapshotQueryResult; 16];
    result_count: u64;
    has_pending_request: bool;
    pending_is_final_read: bool;
    pending_was_cached_insert: bool;
    pending_module_name: [u8; 512];
    pending_module_name_len: u64;
    // Pointer-walk state for the in-flight query.
    pointer_walk_active: bool;
    pointer: StoredPointer;
    current_address: u64;
    current_module_name: [u8; 512];
    current_module_name_len: u64;
    next_link_index: u64;
    evaluated_path: [u8; 512];
    evaluated_path_len: u64;
    pointer_walk_had_first_hop: bool;
    resolved_address: u64;
    resolved_module_name: [u8; 512];
    resolved_module_name_len: u64;
    // Dedup caches.
    cached_addresses: [u64; 16];
    cached_module_names: [[u8; 512]; 16];
    cached_module_name_lens: [u64; 16];
    cached_responses: [MemoryReadResponse; 16];
    cache_count: u64;
    cached_eval_pointers: [StoredPointer; 16];
    cached_eval_has_address: [bool; 16];
    cached_eval_addresses: [u64; 16];
    cached_eval_module_names: [[u8; 512]; 16];
    cached_eval_module_name_lens: [u64; 16];
    cached_eval_paths: [[u8; 512]; 16];
    cached_eval_path_lens: [u64; 16];
    eval_cache_count: u64;
}

pub machine VirtualSnapshotMaterializer::new() -> VirtualSnapshotMaterializer {
    VirtualSnapshotMaterializer {
        query_count: 0,
        current_query_index: 0,
        result_count: 0,
        has_pending_request: false,
        pending_is_final_read: false,
        pending_was_cached_insert: false,
        pending_module_name_len: 0,
        pointer_walk_active: false,
        pointer: StoredPointer::default(),
        current_address: 0,
        current_module_name_len: 0,
        next_link_index: 0,
        evaluated_path_len: 0,
        pointer_walk_had_first_hop: false,
        resolved_address: 0,
        resolved_module_name_len: 0,
        cache_count: 0,
        eval_cache_count: 0,
    }
}

// `begin` copies the snapshot's query list — upstream captures the Vec
// for the spawned thread; the driver needs the same owned snapshot.
pub machine VirtualSnapshotMaterializer::begin(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, virtual_snapshot: &VirtualSnapshot) -> bool {
    virtual_snapshot_materializer.result_count = 0;
    virtual_snapshot_materializer.current_query_index = 0;
    virtual_snapshot_materializer.pointer_walk_active = false;
    VirtualSnapshotMaterializer::in_flight_reset(virtual_snapshot_materializer);
    virtual_snapshot_materializer.cache_count = 0;
    virtual_snapshot_materializer.eval_cache_count = 0;
    transition { _ -> fill(virtual_snapshot_materializer, virtual_snapshot, 0) }
    state fill(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, virtual_snapshot: &VirtualSnapshot, position: u64) -> bool {
        transition position < VirtualSnapshot::get_query_count(virtual_snapshot) && position < 16 {
            true -> fill_one(virtual_snapshot_materializer, virtual_snapshot, position)
            false -> finish(virtual_snapshot_materializer, virtual_snapshot)
        }
    }
    state fill_one(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, virtual_snapshot: &VirtualSnapshot, position: u64) -> bool
        requires position < 16;
    {
        _ = VirtualSnapshot::copy_query(virtual_snapshot, position, &mut virtual_snapshot_materializer.queries[position]);
        transition { _ -> fill(virtual_snapshot_materializer, virtual_snapshot, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, virtual_snapshot: &VirtualSnapshot) -> bool {
        virtual_snapshot_materializer.query_count = VirtualSnapshot::get_query_count(virtual_snapshot);
        transition virtual_snapshot_materializer.query_count > 16 {
            true -> clamp(virtual_snapshot_materializer)
            false -> (true)
        }
    }
    state clamp(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer) -> bool {
        virtual_snapshot_materializer.query_count = 16;
        (true)
    }
}

pub machine VirtualSnapshotMaterializer::get_result_count(virtual_snapshot_materializer: &VirtualSnapshotMaterializer) -> u64 {
    virtual_snapshot_materializer.result_count
}

pub machine VirtualSnapshotMaterializer::get_result_ids(virtual_snapshot_materializer: &VirtualSnapshotMaterializer) -> &[[u8; 128]; 16] {
    (&virtual_snapshot_materializer.result_ids)
}

pub machine VirtualSnapshotMaterializer::get_result_id_lens(virtual_snapshot_materializer: &VirtualSnapshotMaterializer) -> &[u64; 16] {
    (&virtual_snapshot_materializer.result_id_lens)
}

pub machine VirtualSnapshotMaterializer::get_results(virtual_snapshot_materializer: &VirtualSnapshotMaterializer) -> &[VirtualSnapshotQueryResult; 16] {
    (&virtual_snapshot_materializer.results)
}

pub machine VirtualSnapshotMaterializer::get_is_finished(virtual_snapshot_materializer: &VirtualSnapshotMaterializer) -> bool {
    transition virtual_snapshot_materializer.current_query_index >= virtual_snapshot_materializer.query_count && !virtual_snapshot_materializer.pointer_walk_active {
        true -> (true)
        false -> (false)
        _ -> (false)
    }
}

// The pump — emits the next memory read needed to materialize, or false
// when the refresh is complete.
pub machine VirtualSnapshotMaterializer::pump_next_request(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
    transition virtual_snapshot_materializer.pointer_walk_active && virtual_snapshot_materializer.current_query_index < 16 {
        true -> pump_walk(virtual_snapshot_materializer, registry, out_request)
        false -> advance(virtual_snapshot_materializer, registry, out_request)
        _ -> (false)
    }
    // Mid pointer-walk: the next hop is a pointer-width read at the
    // current address/module — the walk bails on a `Symbol` link.
    state pump_walk(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        transition StoredPointer::get_has_unresolvable_link(&virtual_snapshot_materializer.pointer) && StoredPointer::get_unresolvable_link_index(&virtual_snapshot_materializer.pointer) == virtual_snapshot_materializer.next_link_index {
            true -> bail_walk(virtual_snapshot_materializer, registry, out_request)
            false -> walk_step(virtual_snapshot_materializer, registry, out_request)
        }
    }
    state walk_step(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        transition virtual_snapshot_materializer.next_link_index < StoredPointer::get_offset_count(&virtual_snapshot_materializer.pointer) && virtual_snapshot_materializer.current_query_index < 16 {
            true -> emit_hop(virtual_snapshot_materializer, registry, out_request)
            false -> emit_final(virtual_snapshot_materializer, registry, out_request)
        }
    }
    state emit_hop(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        let mut pointer_struct: SymbolicStructDefinition = SymbolicStructDefinition::empty();
        transition VirtualSnapshotMaterializer::pointer_size_definition(virtual_snapshot_materializer, registry, &mut pointer_struct) {
            true -> emit_hop_read(virtual_snapshot_materializer, registry, &pointer_struct, out_request)
            false -> bail_walk(virtual_snapshot_materializer, registry, out_request)
        }
    }
    state emit_hop_read(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, pointer_struct: &SymbolicStructDefinition, out_request: &mut MemoryReadRequest) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        transition virtual_snapshot_materializer.current_module_name_len <= 512 {
            true -> emit_hop_bounded(virtual_snapshot_materializer, pointer_struct, out_request)
            false -> bail_walk(virtual_snapshot_materializer, registry, out_request)
        }
    }
    state emit_hop_bounded(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, pointer_struct: &SymbolicStructDefinition, out_request: &mut MemoryReadRequest) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        let current_name: &[u8] = slice_512(&virtual_snapshot_materializer.current_module_name, virtual_snapshot_materializer.current_module_name_len);
        let request: MemoryReadRequest = MemoryReadRequest::new(virtual_snapshot_materializer.current_address, current_name, SymbolicStructDefinition::clone(pointer_struct), false);
        MemoryReadRequest::clone_from(out_request, &request);
        virtual_snapshot_materializer.has_pending_request = true;
        virtual_snapshot_materializer.pending_is_final_read = false;
        (true)
    }
    // All hops applied — the resolved target gets the query's struct read.
    state emit_final(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        virtual_snapshot_materializer.resolved_address = virtual_snapshot_materializer.current_address;
        _ = copy_slice(&virtual_snapshot_materializer.current_module_name, virtual_snapshot_materializer.current_module_name_len, &mut virtual_snapshot_materializer.resolved_module_name, &mut virtual_snapshot_materializer.resolved_module_name_len);
        transition virtual_snapshot_materializer.resolved_module_name_len <= 512 {
            true -> emit_final_bounded(virtual_snapshot_materializer, registry, out_request)
            false -> (false)
        }
    }
    state emit_final_bounded(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        let mut query_struct: SymbolicStructDefinition = SymbolicStructDefinition::empty();
        VirtualSnapshotQuery::get_symbolic_struct_definition(&virtual_snapshot_materializer.queries[virtual_snapshot_materializer.current_query_index], &mut query_struct);
        let resolved_name: &[u8] = slice_512(&virtual_snapshot_materializer.resolved_module_name, virtual_snapshot_materializer.resolved_module_name_len);
        let request: MemoryReadRequest = MemoryReadRequest::new(virtual_snapshot_materializer.resolved_address, resolved_name, query_struct, false);
        MemoryReadRequest::clone_from(out_request, &request);
        virtual_snapshot_materializer.has_pending_request = true;
        virtual_snapshot_materializer.pending_is_final_read = true;
        (true)
    }
    // `??` — upstream bails the evaluation with an unresolved target.
    state bail_walk(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        _ = VirtualSnapshotMaterializer::append_path_segment(virtual_snapshot_materializer, "??");
        transition { _ -> finish_walk_failed(virtual_snapshot_materializer, registry, out_request) }
    }
    state finish_walk_failed(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        _ = VirtualSnapshotMaterializer::store_eval_cache(virtual_snapshot_materializer, 0, false);
        let position: u64 = virtual_snapshot_materializer.current_query_index;
        transition position < 16 {
            true -> finish_failed_result(virtual_snapshot_materializer, position)
            false -> advance_finished(virtual_snapshot_materializer, position, registry, out_request)
        }
    }
    state finish_failed_result(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64) -> bool
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&virtual_snapshot_materializer.evaluated_path, virtual_snapshot_materializer.evaluated_path_len);
        _ = result_set_evaluated_path(&mut virtual_snapshot_materializer.results[position], path_slice);
        _ = VirtualSnapshotMaterializer::store_result_id(virtual_snapshot_materializer, position);
        virtual_snapshot_materializer.pointer_walk_active = false;
        virtual_snapshot_materializer.has_pending_request = false;
        virtual_snapshot_materializer.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (false)
    }
    state advance_finished(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        virtual_snapshot_materializer.pointer_walk_active = false;
        virtual_snapshot_materializer.has_pending_request = false;
        virtual_snapshot_materializer.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> advance(virtual_snapshot_materializer, registry, out_request) }
    }
    state advance(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        transition virtual_snapshot_materializer.current_query_index < virtual_snapshot_materializer.query_count {
            true -> route(virtual_snapshot_materializer, registry, out_request)
            false -> (false)
        }
    }
    state route(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        transition virtual_snapshot_materializer.current_query_index < 16 {
            true -> route_kind(virtual_snapshot_materializer, registry, out_request)
            false -> (false)
        }
    }
    state route_kind(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        transition VirtualSnapshotQuery::get_is_address(&virtual_snapshot_materializer.queries[virtual_snapshot_materializer.current_query_index]) {
            true -> address_query(virtual_snapshot_materializer, registry, out_request)
            false -> pointer_query(virtual_snapshot_materializer, registry, out_request)
        }
    }
    state address_query(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        let query_address: u64 = VirtualSnapshotQuery::get_address(&virtual_snapshot_materializer.queries[virtual_snapshot_materializer.current_query_index]);
        let mut module_name: [u8; 512];
        let mut module_name_len: u64 = 0;
        VirtualSnapshotQuery::copy_module_name(&virtual_snapshot_materializer.queries[virtual_snapshot_materializer.current_query_index], &mut module_name, &mut module_name_len);
        transition { _ -> cache_probe(virtual_snapshot_materializer, registry, out_request, query_address, module_name, module_name_len, 0) }
    }
    // Read cache probe — on a hit the stored response fills the result
    // and the pump advances without emitting a request.
    state cache_probe(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        transition cache_position < virtual_snapshot_materializer.cache_count && cache_position < 16 {
            true -> cache_compare(virtual_snapshot_materializer, registry, out_request, query_address, module_name, module_name_len, cache_position)
            false -> emit_address_read(virtual_snapshot_materializer, out_request, query_address, module_name, module_name_len)
        }
    }
    state cache_compare(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64) -> bool
        requires cache_position < 16 && virtual_snapshot_materializer.current_query_index < 16;
    {
        transition virtual_snapshot_materializer.cached_addresses[cache_position] == query_address && virtual_snapshot_materializer.cached_module_name_lens[cache_position] == module_name_len {
            true -> cache_bytes(virtual_snapshot_materializer, registry, out_request, query_address, module_name, module_name_len, cache_position, 0)
            false -> cache_probe(virtual_snapshot_materializer, registry, out_request, query_address, module_name, module_name_len, ((cache_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state cache_bytes(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64, index: u64) -> bool
        requires cache_position < 16 && virtual_snapshot_materializer.current_query_index < 16;
    {
        transition index < module_name_len && index < 512 {
            true -> cache_char(virtual_snapshot_materializer, registry, out_request, query_address, module_name, module_name_len, cache_position, index)
            false -> serve_cached(virtual_snapshot_materializer, registry, out_request, query_address, module_name, module_name_len, cache_position)
        }
    }
    state cache_char(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64, index: u64) -> bool
        requires cache_position < 16 && index < module_name_len && index < 512 && virtual_snapshot_materializer.current_query_index < 16;
    {
        transition virtual_snapshot_materializer.cached_module_names[cache_position][index] == module_name[index] {
            true -> cache_bytes(virtual_snapshot_materializer, registry, out_request, query_address, module_name, module_name_len, cache_position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> cache_probe(virtual_snapshot_materializer, registry, out_request, query_address, module_name, module_name_len, ((cache_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state serve_cached(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64) -> bool
        requires cache_position < 16;
    {
        let cached_response: MemoryReadResponse = MemoryReadResponse::clone(&virtual_snapshot_materializer.cached_responses[cache_position]);
        let position: u64 = virtual_snapshot_materializer.current_query_index;
        transition position < 16 {
            true -> serve_cached_result(virtual_snapshot_materializer, position, &cached_response, query_address, module_name, module_name_len, registry, out_request)
            false -> advance(virtual_snapshot_materializer, registry, out_request)
        }
    }
    state serve_cached_result(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, cached_response: &MemoryReadResponse, query_address: u64, module_name: &[u8; 512], module_name_len: u64, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires position < 16;
    {
        VirtualSnapshotQueryResult::set_memory_read_response(&mut virtual_snapshot_materializer.results[position], cached_response);
        VirtualSnapshotQueryResult::set_resolved_address(&mut virtual_snapshot_materializer.results[position], query_address);
        let module_name_slice: &[u8] = slice_512(module_name, module_name_len);
        _ = result_set_module_name(&mut virtual_snapshot_materializer.results[position], module_name_slice);
        
        virtual_snapshot_materializer.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> advance(virtual_snapshot_materializer, registry, out_request) }
    }
    state emit_address_read(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        transition module_name_len <= 512 {
            true -> emit_address_bounded(virtual_snapshot_materializer, out_request, query_address, module_name, module_name_len)
            false -> (false)
        }
    }
    state emit_address_bounded(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        let mut query_struct: SymbolicStructDefinition = SymbolicStructDefinition::empty();
        VirtualSnapshotQuery::get_symbolic_struct_definition(&virtual_snapshot_materializer.queries[virtual_snapshot_materializer.current_query_index], &mut query_struct);
        let module_name_slice: &[u8] = slice_512(module_name, module_name_len);
        let request: MemoryReadRequest = MemoryReadRequest::new(query_address, module_name_slice, query_struct, false);
        MemoryReadRequest::clone_from(out_request, &request);
        virtual_snapshot_materializer.has_pending_request = true;
        virtual_snapshot_materializer.pending_is_final_read = true;
        virtual_snapshot_materializer.pending_was_cached_insert = true;
        _ = copy_slice(module_name, module_name_len, &mut virtual_snapshot_materializer.pending_module_name, &mut virtual_snapshot_materializer.pending_module_name_len);
        (true)
    }
    state pointer_query(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        _ = query_copy_pointer(&virtual_snapshot_materializer.queries[virtual_snapshot_materializer.current_query_index], &mut virtual_snapshot_materializer.pointer);
        // Seed the evaluated path with the root display text — upstream
        // pushes `pointer.get_root_display_text()` first (module + hex root).
        virtual_snapshot_materializer.evaluated_path_len = 0;
        transition { _ -> seed_root(virtual_snapshot_materializer, registry, out_request) }
    }
    state seed_root(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        _ = VirtualSnapshotMaterializer::append_path_segment(virtual_snapshot_materializer, StoredPointer::get_module_name(&virtual_snapshot_materializer.pointer));
        _ = VirtualSnapshotMaterializer::append_hex_prefix(virtual_snapshot_materializer);
        _ = VirtualSnapshotMaterializer::append_hex_u64(virtual_snapshot_materializer, StoredPointer::get_address(&virtual_snapshot_materializer.pointer));
        transition { _ -> eval_probe(virtual_snapshot_materializer, registry, out_request, 0) }
    }
    state eval_probe(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires virtual_snapshot_materializer.current_query_index < 16;
    {
        transition cache_position < virtual_snapshot_materializer.eval_cache_count && cache_position < 16 {
            true -> eval_compare(virtual_snapshot_materializer, registry, out_request, cache_position)
            false -> start_walk(virtual_snapshot_materializer)
        }
    }
    state eval_compare(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires cache_position < 16 && virtual_snapshot_materializer.current_query_index < 16;
    {
        transition StoredPointer::equals(&virtual_snapshot_materializer.cached_eval_pointers[cache_position], &virtual_snapshot_materializer.pointer) {
            true -> serve_eval(virtual_snapshot_materializer, registry, out_request, cache_position)
            false -> eval_probe(virtual_snapshot_materializer, registry, out_request, ((cache_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    // Cached eval — a resolved target goes straight to the final read; a
    // cached failure completes the query with an empty result.
    state serve_eval(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires cache_position < 16 && virtual_snapshot_materializer.current_query_index < 16;
    {
        transition virtual_snapshot_materializer.cached_eval_has_address[cache_position] {
            true -> eval_read(virtual_snapshot_materializer, registry, out_request, cache_position)
            false -> eval_miss(virtual_snapshot_materializer, registry, out_request, cache_position)
        }
    }
    state eval_read(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires cache_position < 16 && virtual_snapshot_materializer.current_query_index < 16;
    {
        virtual_snapshot_materializer.resolved_address = virtual_snapshot_materializer.cached_eval_addresses[cache_position];
        _ = copy_slice(&virtual_snapshot_materializer.cached_eval_module_names[cache_position], virtual_snapshot_materializer.cached_eval_module_name_lens[cache_position], &mut virtual_snapshot_materializer.resolved_module_name, &mut virtual_snapshot_materializer.resolved_module_name_len);
        _ = copy_slice(&virtual_snapshot_materializer.cached_eval_paths[cache_position], virtual_snapshot_materializer.cached_eval_path_lens[cache_position], &mut virtual_snapshot_materializer.evaluated_path, &mut virtual_snapshot_materializer.evaluated_path_len);
        transition { _ -> emit_final(virtual_snapshot_materializer, registry, out_request) }
    }
    state eval_miss(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires cache_position < 16;
    {
        let position: u64 = virtual_snapshot_materializer.current_query_index;
        _ = copy_slice(&virtual_snapshot_materializer.cached_eval_paths[cache_position], virtual_snapshot_materializer.cached_eval_path_lens[cache_position], &mut virtual_snapshot_materializer.evaluated_path, &mut virtual_snapshot_materializer.evaluated_path_len);
        transition position < 16 {
            true -> eval_miss_result(virtual_snapshot_materializer, position)
            false -> advance_finished(virtual_snapshot_materializer, position, registry, out_request)
        }
    }
    state eval_miss_result(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64) -> bool
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&virtual_snapshot_materializer.evaluated_path, virtual_snapshot_materializer.evaluated_path_len);
        _ = result_set_evaluated_path(&mut virtual_snapshot_materializer.results[position], path_slice);
        
        virtual_snapshot_materializer.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (false)
    }
    state start_walk(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer) -> bool {
        virtual_snapshot_materializer.pointer_walk_active = true;
        virtual_snapshot_materializer.pointer_walk_had_first_hop = false;
        virtual_snapshot_materializer.current_address = StoredPointer::get_address(&virtual_snapshot_materializer.pointer);
        StoredPointer::copy_module_name(&virtual_snapshot_materializer.pointer, &mut virtual_snapshot_materializer.current_module_name, &mut virtual_snapshot_materializer.current_module_name_len);
        virtual_snapshot_materializer.next_link_index = 0;
        (false)
    }

}

machine VirtualSnapshotMaterializer::in_flight_reset(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer) {
    virtual_snapshot_materializer.has_pending_request = false;
    virtual_snapshot_materializer.pending_is_final_read = false;
    virtual_snapshot_materializer.pending_was_cached_insert = false;
}

// `accept_response` — the composition root feeds each dispatched
// response back; hop responses drive the next offset, final responses
// complete the query's result.
pub machine VirtualSnapshotMaterializer::accept_response(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, response: &MemoryReadResponse) {
    virtual_snapshot_materializer.has_pending_request = false;
    transition virtual_snapshot_materializer.pending_is_final_read {
        true -> complete_query(virtual_snapshot_materializer, response)
        false -> apply_hop(virtual_snapshot_materializer, response)
        _ -> complete_query(virtual_snapshot_materializer, response)
    }
    state complete_query(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, response: &MemoryReadResponse) {
        let position: u64 = virtual_snapshot_materializer.current_query_index;
        transition position < 16 {
            true -> route_kind(virtual_snapshot_materializer, position, response)
            false -> done(virtual_snapshot_materializer)
        }
    }
    state route_kind(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        transition virtual_snapshot_materializer.pointer_walk_active {
            true -> complete_pointer(virtual_snapshot_materializer, position, response)
            false -> complete_address(virtual_snapshot_materializer, position, response)
        }
    }
    state complete_address(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        transition MemoryReadResponse::get_success(response) {
            true -> fill_address_result(virtual_snapshot_materializer, position, response)
            false -> fill_failed_result(virtual_snapshot_materializer, position, response)
        }
    }
    state fill_address_result(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        VirtualSnapshotQueryResult::set_memory_read_response(&mut virtual_snapshot_materializer.results[position], response);
        VirtualSnapshotQueryResult::set_resolved_address(&mut virtual_snapshot_materializer.results[position], MemoryReadResponse::get_address(response));
        transition virtual_snapshot_materializer.pending_module_name_len <= 512 {
            true -> fill_address_module(virtual_snapshot_materializer, position, response)
            false -> fill_address_finish(virtual_snapshot_materializer, position, response)
        }
    }
    state fill_address_module(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let pending_name: &[u8] = slice_512(&virtual_snapshot_materializer.pending_module_name, virtual_snapshot_materializer.pending_module_name_len);
        _ = result_set_module_name(&mut virtual_snapshot_materializer.results[position], pending_name);
        transition { _ -> fill_address_finish(virtual_snapshot_materializer, position, response) }
    }
    state fill_address_finish(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        
        _ = VirtualSnapshotMaterializer::store_read_cache(virtual_snapshot_materializer, response);
        virtual_snapshot_materializer.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done(virtual_snapshot_materializer) }
    }
    state fill_failed_result(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        
        _ = VirtualSnapshotMaterializer::store_read_cache(virtual_snapshot_materializer, response);
        virtual_snapshot_materializer.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done(virtual_snapshot_materializer) }
    }
    state complete_pointer(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        transition MemoryReadResponse::get_success(response) {
            true -> fill_pointer_result(virtual_snapshot_materializer, position, response)
            false -> fill_pointer_failed(virtual_snapshot_materializer, position, response)
        }
    }
    state fill_pointer_result(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        VirtualSnapshotQueryResult::set_memory_read_response(&mut virtual_snapshot_materializer.results[position], response);
        VirtualSnapshotQueryResult::set_resolved_address(&mut virtual_snapshot_materializer.results[position], virtual_snapshot_materializer.resolved_address);
        transition virtual_snapshot_materializer.resolved_module_name_len <= 512 {
            true -> fill_pointer_module(virtual_snapshot_materializer, position, response)
            false -> fill_pointer_path(virtual_snapshot_materializer, position, response)
        }
    }
    state fill_pointer_module(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let resolved_name: &[u8] = slice_512(&virtual_snapshot_materializer.resolved_module_name, virtual_snapshot_materializer.resolved_module_name_len);
        _ = result_set_module_name(&mut virtual_snapshot_materializer.results[position], resolved_name);
        transition { _ -> fill_pointer_path(virtual_snapshot_materializer, position, response) }
    }
    state fill_pointer_path(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&virtual_snapshot_materializer.evaluated_path, virtual_snapshot_materializer.evaluated_path_len);
        _ = result_set_evaluated_path(&mut virtual_snapshot_materializer.results[position], path_slice);
        
        _ = VirtualSnapshotMaterializer::store_eval_cache(virtual_snapshot_materializer, virtual_snapshot_materializer.resolved_address, true);
        _ = VirtualSnapshotMaterializer::store_read_cache(virtual_snapshot_materializer, response);
        virtual_snapshot_materializer.pointer_walk_active = false;
        virtual_snapshot_materializer.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done(virtual_snapshot_materializer) }
    }
    state fill_pointer_failed(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&virtual_snapshot_materializer.evaluated_path, virtual_snapshot_materializer.evaluated_path_len);
        _ = result_set_evaluated_path(&mut virtual_snapshot_materializer.results[position], path_slice);
        
        _ = VirtualSnapshotMaterializer::store_eval_cache(virtual_snapshot_materializer, virtual_snapshot_materializer.resolved_address, true);
        _ = VirtualSnapshotMaterializer::store_read_cache(virtual_snapshot_materializer, response);
        virtual_snapshot_materializer.pointer_walk_active = false;
        virtual_snapshot_materializer.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done(virtual_snapshot_materializer) }
    }
    // A hop response: extract the pointer value from the first field's
    // bytes (pointer-width little/big endian), apply the offset, and
    // advance. A failed read or overflow bails with `??`.
    state apply_hop(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, response: &MemoryReadResponse) {
        transition MemoryReadResponse::get_success(response) {
            true -> read_value(virtual_snapshot_materializer, response)
            false -> bail(virtual_snapshot_materializer)
        }
    }
    state read_value(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, response: &MemoryReadResponse) {
        let valued_struct: &ValuedStruct = MemoryReadResponse::get_valued_struct(response);
        let field: ValuedStructField = ValuedStruct::get_field_at(valued_struct, 0);
        let data_value: DataValue = ValuedStructField::get_data_value(&field);
        let bytes: &[u8] = DataValue::get_value_bytes(&data_value);
        let pointer_endian: Endian = VirtualSnapshotMaterializer::get_pointer_endian(virtual_snapshot_materializer);
        let value: u64 = assemble_pointer_value(bytes, StoredPointer::get_pointer_size(&virtual_snapshot_materializer.pointer), pointer_endian);
        let offset: i64 = StoredPointer::get_offset(&virtual_snapshot_materializer.pointer, virtual_snapshot_materializer.next_link_index);
        transition { _ -> apply_offset(virtual_snapshot_materializer, value, offset) }
    }
    state apply_offset(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, value: u64, offset: i64) {
        transition offset >= 0 {
            true -> add_offset(virtual_snapshot_materializer, value, offset)
            false -> sub_offset(virtual_snapshot_materializer, value, offset)
        }
    }
    state add_offset(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, value: u64, offset: i64)
        requires offset >= 0;
    {
        // `apply_pointer_offset` — checked_add for non-negative offsets:
        // overflow refuses rather than wrapping.
        let offset_magnitude: u64 = offset as u64;
        transition offset_magnitude <= (18446744073709551615 - value) {
            true -> apply_add(virtual_snapshot_materializer, value, offset)
            false -> bail(virtual_snapshot_materializer)
        }
    }
    state sub_offset(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, value: u64, offset: i64) {
        // Negative offset — the u64 magnitude is the wrapping negation of
        // the two's-complement cast.
        let magnitude: u64 = ((0 - (offset as u64 in Wrapping)) as u64 in Wrapping) as u64;
        transition value >= magnitude {
            true -> apply_sub(virtual_snapshot_materializer, value, offset)
            false -> bail(virtual_snapshot_materializer)
        }
    }
    state apply_add(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, value: u64, offset: i64)
        requires offset >= 0;
    {
        virtual_snapshot_materializer.current_address = ((value as u64 in Wrapping) + ((offset as u64 in Wrapping) as u64 in Wrapping)) as u64;
        transition { _ -> after_hop(virtual_snapshot_materializer) }
    }
    state apply_sub(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, value: u64, offset: i64)
        requires offset < 0;
    {
        let magnitude: u64 = ((0 - (offset as u64 in Wrapping)) as u64 in Wrapping) as u64;
        virtual_snapshot_materializer.current_address = ((value as u64 in Wrapping) - (magnitude as u64 in Wrapping)) as u64;
        transition { _ -> after_hop(virtual_snapshot_materializer) }
    }
    state after_hop(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer) {
        // Upstream clears the module once the first offset applies.
        virtual_snapshot_materializer.current_module_name_len = 0;
        virtual_snapshot_materializer.pointer_walk_had_first_hop = true;
        virtual_snapshot_materializer.next_link_index = ((virtual_snapshot_materializer.next_link_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        _ = VirtualSnapshotMaterializer::append_path_segment(virtual_snapshot_materializer, "0x..");
        transition { _ -> done(virtual_snapshot_materializer) }
    }
    state bail(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer) {
        _ = VirtualSnapshotMaterializer::append_path_segment(virtual_snapshot_materializer, "??");
        _ = VirtualSnapshotMaterializer::store_eval_cache(virtual_snapshot_materializer, 0, false);
        let position: u64 = virtual_snapshot_materializer.current_query_index;
        transition position < 16 {
            true -> bail_result(virtual_snapshot_materializer, position)
            false -> done(virtual_snapshot_materializer)
        }
    }
    state bail_result(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64)
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&virtual_snapshot_materializer.evaluated_path, virtual_snapshot_materializer.evaluated_path_len);
        _ = result_set_evaluated_path(&mut virtual_snapshot_materializer.results[position], path_slice);
        
        virtual_snapshot_materializer.pointer_walk_active = false;
        virtual_snapshot_materializer.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done(virtual_snapshot_materializer) }
    }
    state done(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer) {
    }
}

// Byte-array helpers — copy a bounded array into another with a length.
machine copy_slice(source: &[u8; 512], source_len: u64, destination: &mut [u8; 512], destination_len: &mut u64) -> bool {
    transition { _ -> copy(source, source_len, destination, destination_len, 0) }
    state copy(source: &[u8; 512], source_len: u64, destination: &mut [u8; 512], destination_len: &mut u64, position: u64) -> bool

    {
        transition position < source_len && position < 512 {
            true -> copy_one(source, source_len, destination, destination_len, position)
            false -> finish(source_len, destination_len)
        }
    }
    state copy_one(source: &[u8; 512], source_len: u64, destination: &mut [u8; 512], destination_len: &mut u64, position: u64) -> bool
        requires position < source_len && position < 512;
    {
        destination[position] = source[position];
        transition { _ -> copy(source, source_len, destination, destination_len, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(source_len: u64, destination_len: &mut u64) -> bool {
        destination_len = source_len;
        (true)
    }
}

// `read_pointer_value` — assemble the little/big-endian pointer-width
// value from the read bytes.
machine assemble_pointer_value(bytes: &[u8], pointer_size: u64, endian: Endian) -> u64 {
    transition endian {
        Endian::Little -> assemble_le(bytes, pointer_size, 0, 0)
        Endian::Big -> assemble_be(bytes, pointer_size, 0, 0)
        _ -> (0)
    }
    state assemble_le(bytes: &[u8], pointer_size: u64, index: u64, value: u64) -> u64

    {
        transition index < pointer_size && index < bytes.len && index < 8 {
            true -> accumulate_le(bytes, pointer_size, index, value)
            false -> (value)
        }
    }
    // Little-endian fold: value | (byte << index*8). `index < 8` (from the
    // requires) bounds the multiply and shift; the byte cast is a widening.
    state accumulate_le(bytes: &[u8], pointer_size: u64, index: u64, value: u64) -> u64
        requires index < bytes.len && index < 8;
    {
        let next_index: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let next_value: u64 = value | ((bytes[index] as u64) << (index * 8));
        transition { _ -> assemble_le(bytes, pointer_size, next_index, next_value) }
    }
    state assemble_be(bytes: &[u8], pointer_size: u64, index: u64, value: u64) -> u64

    {
        transition index < pointer_size && index < bytes.len && index < 8 {
            true -> accumulate_be(bytes, pointer_size, index, value)
            false -> (value)
        }
    }
    // Big-endian fold: (value << 8) | byte. The shift can legitimately
    // discard top bits once enough bytes accumulate (a u64 read at pointer
    // size 8 fills exactly); wrapping is the honest spelling.
    state accumulate_be(bytes: &[u8], pointer_size: u64, index: u64, value: u64) -> u64
        requires index < bytes.len && index < 8;
    {
        let next_index: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let next_value: u64 = (((value as u64 in Wrapping) << 8) | (bytes[index] as u64 in Wrapping)) as u64;
        transition { _ -> assemble_be(bytes, pointer_size, next_index, next_value) }
    }
}

// Insert into the read cache — keyed by (response address, module).
machine VirtualSnapshotMaterializer::store_read_cache(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, response: &MemoryReadResponse) -> bool {
    transition virtual_snapshot_materializer.cache_count < 16 {
        true -> store(virtual_snapshot_materializer, response)
        false -> (false)
        _ -> (false)
    }
    state store(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, response: &MemoryReadResponse) -> bool {
        let slot: u64 = virtual_snapshot_materializer.cache_count;
        virtual_snapshot_materializer.cached_addresses[slot] = MemoryReadResponse::get_address(response);
        MemoryReadResponse::clone_from(&mut virtual_snapshot_materializer.cached_responses[slot], response);
        transition virtual_snapshot_materializer.pending_was_cached_insert {
            true -> store_module(virtual_snapshot_materializer, slot)
            false -> store_empty_module(virtual_snapshot_materializer, slot)
        }
    }
    state store_module(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, slot: u64) -> bool
        requires slot < 16;
    {
        _ = copy_slice(&virtual_snapshot_materializer.pending_module_name, virtual_snapshot_materializer.pending_module_name_len, &mut virtual_snapshot_materializer.cached_module_names[slot], &mut virtual_snapshot_materializer.cached_module_name_lens[slot]);
        virtual_snapshot_materializer.cache_count = ((virtual_snapshot_materializer.cache_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
    state store_empty_module(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, slot: u64) -> bool
        requires slot < 16;
    {
        virtual_snapshot_materializer.cached_module_name_lens[slot] = 0;
        virtual_snapshot_materializer.cache_count = ((virtual_snapshot_materializer.cache_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// `pointer_size_definition` — resolves the pointer-width data type's
// struct layout through the registry cache.
machine VirtualSnapshotMaterializer::pointer_size_definition(virtual_snapshot_materializer: &VirtualSnapshotMaterializer, registry: &PrivilegedRegistryCache, out_definition: &mut SymbolicStructDefinition) -> bool {
    let pointer_size: PointerScanPointerSize = VirtualSnapshotMaterializer::pointer_size_value(virtual_snapshot_materializer);
    let data_type_ref: DataTypeRef = PointerScanPointerSize::to_data_type_ref(&pointer_size);
    (PrivilegedRegistryCache::resolve_struct_layout_definition(registry, DataTypeRef::get_data_type_id(&data_type_ref), out_definition))
}

machine VirtualSnapshotMaterializer::pointer_size_value(virtual_snapshot_materializer: &VirtualSnapshotMaterializer) -> PointerScanPointerSize {
    transition StoredPointer::get_pointer_size(&virtual_snapshot_materializer.pointer) == 4 {
        true -> (PointerScanPointerSize::Pointer32)
        false -> check_three(virtual_snapshot_materializer)
        _ -> (PointerScanPointerSize::Pointer64)
    }
    state check_three(virtual_snapshot_materializer: &VirtualSnapshotMaterializer) -> PointerScanPointerSize {
        transition StoredPointer::get_pointer_size(&virtual_snapshot_materializer.pointer) == 3 {
            true -> (PointerScanPointerSize::Pointer24)
            false -> (PointerScanPointerSize::Pointer64)
        }
    }
}

// Records the query's id alongside its result slot.
machine VirtualSnapshotMaterializer::store_result_id(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64) -> bool {
    transition position < 16 {
        true -> store_id(virtual_snapshot_materializer, position)
        false -> (false)
        _ -> (false)
    }
    state store_id(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64) -> bool
        requires position < 16;
    {
        let mut query_id: [u8; 128];
        let mut query_id_len: u64 = 0;
        VirtualSnapshotQuery::copy_query_id_into(&virtual_snapshot_materializer.queries[position], &mut query_id, &mut query_id_len);
        virtual_snapshot_materializer.result_ids[position] = query_id;
        virtual_snapshot_materializer.result_id_lens[position] = query_id_len;
        transition virtual_snapshot_materializer.result_count < 16 {
            true -> bump(virtual_snapshot_materializer, position)
            false -> (true)
        }
    }
    state bump(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, position: u64) -> bool
        requires position < 16;
    {
        transition position == virtual_snapshot_materializer.result_count {
            true -> bump_it(virtual_snapshot_materializer)
            false -> (true)
        }
    }
    state bump_it(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer) -> bool {
        virtual_snapshot_materializer.result_count = ((virtual_snapshot_materializer.result_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `cached_pointer_query_evaluations.insert` — dedup by pointer.
machine VirtualSnapshotMaterializer::store_eval_cache(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, resolved_address: u64, has_address: bool) -> bool {
    transition virtual_snapshot_materializer.eval_cache_count < 16 {
        true -> store_eval(virtual_snapshot_materializer, resolved_address, has_address)
        false -> (false)
        _ -> (false)
    }
    state store_eval(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, resolved_address: u64, has_address: bool) -> bool {
        let slot: u64 = virtual_snapshot_materializer.eval_cache_count;
        StoredPointer::clone_from(&mut virtual_snapshot_materializer.cached_eval_pointers[slot], &virtual_snapshot_materializer.pointer);
        virtual_snapshot_materializer.cached_eval_has_address[slot] = has_address;
        virtual_snapshot_materializer.cached_eval_addresses[slot] = resolved_address;
        transition has_address {
            true -> store_eval_module(virtual_snapshot_materializer, slot)
            false -> store_eval_path_only(virtual_snapshot_materializer, slot)
        }
    }
    state store_eval_module(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, slot: u64) -> bool
        requires slot < 16;
    {
        _ = copy_slice(&virtual_snapshot_materializer.resolved_module_name, virtual_snapshot_materializer.resolved_module_name_len, &mut virtual_snapshot_materializer.cached_eval_module_names[slot], &mut virtual_snapshot_materializer.cached_eval_module_name_lens[slot]);
        _ = copy_slice(&virtual_snapshot_materializer.evaluated_path, virtual_snapshot_materializer.evaluated_path_len, &mut virtual_snapshot_materializer.cached_eval_paths[slot], &mut virtual_snapshot_materializer.cached_eval_path_lens[slot]);
        virtual_snapshot_materializer.eval_cache_count = ((virtual_snapshot_materializer.eval_cache_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
    state store_eval_path_only(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, slot: u64) -> bool
        requires slot < 16;
    {
        virtual_snapshot_materializer.cached_eval_module_name_lens[slot] = 0;
        _ = copy_slice(&virtual_snapshot_materializer.evaluated_path, virtual_snapshot_materializer.evaluated_path_len, &mut virtual_snapshot_materializer.cached_eval_paths[slot], &mut virtual_snapshot_materializer.cached_eval_path_lens[slot]);
        virtual_snapshot_materializer.eval_cache_count = ((virtual_snapshot_materializer.eval_cache_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Appends " -> <text>" (or the leading segment) to evaluated_path —
// upstream `evaluated_path_segments.join(" -> ")`.
machine VirtualSnapshotMaterializer::append_path_segment(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, text: &[u8]) -> bool {
    transition virtual_snapshot_materializer.evaluated_path_len == 0 {
        true -> append_text(virtual_snapshot_materializer, text)
        false -> sep(virtual_snapshot_materializer, text)
        _ -> append_text(virtual_snapshot_materializer, text)
    }
    state sep(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, text: &[u8]) -> bool {
        transition virtual_snapshot_materializer.evaluated_path_len <= 508 {
            true -> write_sep(virtual_snapshot_materializer, text)
            false -> (false)
        }
    }
    state write_sep(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, text: &[u8]) -> bool
        requires virtual_snapshot_materializer.evaluated_path_len <= 508;
    {
        let index_one: u64 = virtual_snapshot_materializer.evaluated_path_len + 1;
        let index_two: u64 = virtual_snapshot_materializer.evaluated_path_len + 2;
        let index_three: u64 = virtual_snapshot_materializer.evaluated_path_len + 3;
        transition index_one < 512 && index_two < 512 && index_three < 512 {
            true -> write_sep_bounded(virtual_snapshot_materializer, text, index_one, index_two, index_three)
            _ -> (false)
        }
    }
    state write_sep_bounded(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, text: &[u8], index_one: u64, index_two: u64, index_three: u64) -> bool
        requires virtual_snapshot_materializer.evaluated_path_len <= 508 && index_one < 512 && index_two < 512 && index_three < 512;
    {
        virtual_snapshot_materializer.evaluated_path[virtual_snapshot_materializer.evaluated_path_len] = 32;
        virtual_snapshot_materializer.evaluated_path[index_one] = 45;
        virtual_snapshot_materializer.evaluated_path[index_two] = 62;
        virtual_snapshot_materializer.evaluated_path[index_three] = 32;
        virtual_snapshot_materializer.evaluated_path_len = virtual_snapshot_materializer.evaluated_path_len + 4;
        transition { _ -> append_text(virtual_snapshot_materializer, text) }
    }
    state append_text(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, text: &[u8]) -> bool {
        transition { _ -> loop_copy(virtual_snapshot_materializer, text, 0) }
    }
    state loop_copy(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, text: &[u8], index: u64) -> bool

    {
        transition index < text.len && virtual_snapshot_materializer.evaluated_path_len < 512 {
            true -> copy_char(virtual_snapshot_materializer, text, index)
            false -> (true)
        }
    }
    state copy_char(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, text: &[u8], index: u64) -> bool
        requires index < text.len;
    {
        virtual_snapshot_materializer.evaluated_path[virtual_snapshot_materializer.evaluated_path_len] = text[index];
        virtual_snapshot_materializer.evaluated_path_len = ((virtual_snapshot_materializer.evaluated_path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> loop_copy(virtual_snapshot_materializer, text, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Appends the "0x" prefix onto the evaluated path.
machine VirtualSnapshotMaterializer::append_hex_prefix(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer) -> bool {
    transition virtual_snapshot_materializer.evaluated_path_len <= 510 {
        true -> write(virtual_snapshot_materializer)
        false -> (false)
        _ -> (false)
    }
    state write(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer) -> bool
        requires virtual_snapshot_materializer.evaluated_path_len <= 510;
    {
        let index_one: u64 = virtual_snapshot_materializer.evaluated_path_len + 1;
        transition index_one < 512 {
            true -> write_bounded(virtual_snapshot_materializer, index_one)
            _ -> (false)
        }
    }
    state write_bounded(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, index_one: u64) -> bool
        requires virtual_snapshot_materializer.evaluated_path_len <= 510 && index_one < 512;
    {
        virtual_snapshot_materializer.evaluated_path[virtual_snapshot_materializer.evaluated_path_len] = 48;
        virtual_snapshot_materializer.evaluated_path[index_one] = 120;
        virtual_snapshot_materializer.evaluated_path_len = virtual_snapshot_materializer.evaluated_path_len + 2;
        (true)
    }
}

// Appends an uppercase hex rendering — upstream `format!("{:X}", address)`.
// Zero renders as a single '0'.
machine VirtualSnapshotMaterializer::append_hex_u64(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, value: u64) -> bool {
    transition { _ -> walk(virtual_snapshot_materializer, 15, value) }
    state walk(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)

    {
        transition nibble > 0 {
            true -> check_leading(virtual_snapshot_materializer, nibble, value)
            false -> last_digit(virtual_snapshot_materializer, value)
        }
    }
    state check_leading(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)
        requires nibble > 0;
    {
        // The nibble cursor walks 15 down to 0 upstream — the `nibble * 4`
        // shift count needs the bound re-spelled so it reaches the multiply
        // and shift obligations inside the dominated state.
        transition nibble <= 15 {
            true -> check_leading_bounded(virtual_snapshot_materializer, nibble, value)
            _ -> step_down(virtual_snapshot_materializer, nibble, value)
        }
    }
    state check_leading_bounded(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)
        requires nibble <= 15 && nibble > 0;
    {
        transition (value >> (nibble * 4)) & 15 != 0 {
            true -> write_nibble(virtual_snapshot_materializer, nibble, value)
            false -> step_down(virtual_snapshot_materializer, nibble, value)
        }
    }
    state step_down(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)
        requires nibble > 0;
    {
        let next_nibble: u64 = nibble - 1;
        transition { _ -> walk_from(virtual_snapshot_materializer, next_nibble, value) }
    }
    state walk_from(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)

    {
        transition nibble > 0 {
            true -> check_leading(virtual_snapshot_materializer, nibble, value)
            false -> last_digit(virtual_snapshot_materializer, value)
        }
    }
    state write_nibble(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64) {
        transition nibble <= 15 {
            true -> write_nibble_bounded(virtual_snapshot_materializer, nibble, value)
            _ -> (true)
        }
    }
    state write_nibble_bounded(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)
        requires nibble <= 15;
    {
        _ = VirtualSnapshotMaterializer::append_hex_digit(virtual_snapshot_materializer, ((value >> (nibble * 4)) & 15) as u8);
        transition nibble > 0 {
            true -> write_step(virtual_snapshot_materializer, nibble, value)
            false -> (true)
        }
    }
    state write_step(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)
        requires nibble <= 15 && nibble > 0;
    {
        let next_nibble: u64 = nibble - 1;
        transition { _ -> write_rest(virtual_snapshot_materializer, next_nibble, value) }
    }
    state write_rest(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64) {
        transition nibble <= 15 {
            true -> write_rest_bounded(virtual_snapshot_materializer, nibble, value)
            _ -> (true)
        }
    }
    state write_rest_bounded(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, nibble: u64, value: u64)
        requires nibble <= 15;
    {
        _ = VirtualSnapshotMaterializer::append_hex_digit(virtual_snapshot_materializer, ((value >> (nibble * 4)) & 15) as u8);
        transition nibble > 0 {
            true -> write_step(virtual_snapshot_materializer, nibble, value)
            false -> (true)
        }
    }
    state last_digit(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, value: u64) -> bool {
        _ = VirtualSnapshotMaterializer::append_hex_digit(virtual_snapshot_materializer, (value & 15) as u8);
        (true)
    }
}

machine VirtualSnapshotMaterializer::append_hex_digit(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, digit: u8) -> bool {
    transition digit < 10 {
        true -> numeric(virtual_snapshot_materializer, digit)
        false -> letter(virtual_snapshot_materializer, digit)
        _ -> letter(virtual_snapshot_materializer, digit)
    }
    state numeric(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, digit: u8) -> bool {
        transition virtual_snapshot_materializer.evaluated_path_len < 512 {
            true -> write_digit(virtual_snapshot_materializer, digit + 48)
            false -> (false)
        }
    }
    state letter(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, digit: u8) -> bool {
        transition digit >= 10 && digit < 16 && virtual_snapshot_materializer.evaluated_path_len < 512 {
            true -> write_letter(virtual_snapshot_materializer, digit)
            false -> (false)
        }
    }
    state write_letter(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, digit: u8) -> bool {
        virtual_snapshot_materializer.evaluated_path[virtual_snapshot_materializer.evaluated_path_len] = digit + 55;
        virtual_snapshot_materializer.evaluated_path_len = ((virtual_snapshot_materializer.evaluated_path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
    state write_digit(virtual_snapshot_materializer: &mut VirtualSnapshotMaterializer, byte: u8) -> bool {
        virtual_snapshot_materializer.evaluated_path[virtual_snapshot_materializer.evaluated_path_len] = byte;
        virtual_snapshot_materializer.evaluated_path_len = ((virtual_snapshot_materializer.evaluated_path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Indexed-element receivers do not parse under `_ =` — these helpers take
// the element as an argument instead.
machine result_set_evaluated_path(result: &mut VirtualSnapshotQueryResult, path: &[u8]) -> bool {
    VirtualSnapshotQueryResult::set_evaluated_pointer_path(result, path)
}

machine result_set_module_name(result: &mut VirtualSnapshotQueryResult, module_name: &[u8]) -> bool {
    VirtualSnapshotQueryResult::set_resolved_module_name(result, module_name)
}

machine query_copy_pointer(query: &VirtualSnapshotQuery, pointer: &mut StoredPointer) -> bool {
    VirtualSnapshotQuery::copy_pointer(query, pointer)
}

// Record-machine counterpart of the hop-endian probe (internal states are
// transition destinations, not value callees). Upstream reads hops in the
// process endianness — the materializer tracks it per walk today as the
// pointer-size default; the real source lands with the executor leg's
// OpenedProcess plumbing (documented approximation).
machine VirtualSnapshotMaterializer::get_pointer_endian(virtual_snapshot_materializer: &VirtualSnapshotMaterializer) -> Endian {
    (Endian::Little)
}
