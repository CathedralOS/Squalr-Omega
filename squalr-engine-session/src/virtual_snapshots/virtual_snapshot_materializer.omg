module src::virtual_snapshots::virtual_snapshot_materializer;

use squalr_engine_api::src::commands::memory::read::memory_read_request::MemoryReadRequest;
use squalr_engine_api::src::commands::memory::read::memory_read_response::MemoryReadResponse;
use squalr_engine_api::src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;
use squalr_engine_api::src::structures::structs::valued_struct_field::ValuedStructField;
use squalr_engine_api::src::structures::structs::valued_struct::ValuedStruct;
use squalr_engine_api::src::structures::data_values::data_value::DataValue;
use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use squalr_engine_api::src::structures::memory::endian::Endian;
use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use src::virtual_snapshots::virtual_snapshot::VirtualSnapshot;
use src::virtual_snapshots::virtual_snapshot_query::VirtualSnapshotQuery;
use src::virtual_snapshots::virtual_snapshot_query_result::VirtualSnapshotQueryResult;
use src::virtual_snapshots::stored_pointer::StoredPointer;
use src::virtual_snapshots::stored_pointer::slice_512;
use src::registries::privileged_registry_cache::PrivilegedRegistryCache;

// Port of virtual_snapshots/virtual_snapshot_resolver.rs. Upstream
// `materialize_virtual_snapshot_queries` runs synchronously inside a
// spawned thread, dispatching memory reads through the execution
// context. Omega has no thread spawn or dyn context, so the resolver
// becomes a caller-pumped driver: the composition root calls
// `pump_next_request` to obtain the next `MemoryReadRequest`, dispatches
// it through the unprivileged bindings (the privileged read executor),
// and feeds the response back with `accept_response`. The pump loop ends
// when `pump_next_request` returns false — the same materialization
// upstream performs inline.
//
// Upstream's two caches are kept: `cached_memory_read_responses` dedups
// identical reads inside one refresh; `cached_pointer_query_evaluations`
// dedups identical pointer walks. Both are bounded 16-entry tables
// (upstream's HashMap is unbounded; a watch set past 16 distinct reads
// degrades to re-reading — documented bound).
//
// Upstream `resolved_target_address` is `(address, module)` where the
// module clears after the first resolved hop — the walk fields mirror
// that (`current_module_name` emptied once the first offset applies).
// `evaluated_path` accumulates upstream's "root -> 0x.. -> ??" text as
// hex segments.
pub data VirtualSnapshotMaterializer {
    queries: [VirtualSnapshotQuery; 16];
    query_count: u64;
    current_query_index: u64;
    result_ids: [[u8; 128]; 16];
    result_id_lens: [u64; 16];
    results: [VirtualSnapshotQueryResult; 16];
    result_count: u64;
    has_pending_request: bool;
    pending_is_final_read: bool;
    pending_was_cached_insert: bool;
    pending_module_name: [u8; 512];
    pending_module_name_len: u64;
    // Pointer-walk state for the in-flight query.
    pointer_walk_active: bool;
    pointer: StoredPointer;
    current_address: u64;
    current_module_name: [u8; 512];
    current_module_name_len: u64;
    next_link_index: u64;
    evaluated_path: [u8; 512];
    evaluated_path_len: u64;
    pointer_walk_had_first_hop: bool;
    resolved_address: u64;
    resolved_module_name: [u8; 512];
    resolved_module_name_len: u64;
    // Dedup caches.
    cached_addresses: [u64; 16];
    cached_module_names: [[u8; 512]; 16];
    cached_module_name_lens: [u64; 16];
    cached_responses: [MemoryReadResponse; 16];
    cache_count: u64;
    cached_eval_pointers: [StoredPointer; 16];
    cached_eval_has_address: [bool; 16];
    cached_eval_addresses: [u64; 16];
    cached_eval_module_names: [[u8; 512]; 16];
    cached_eval_module_name_lens: [u64; 16];
    cached_eval_paths: [[u8; 512]; 16];
    cached_eval_path_lens: [u64; 16];
    eval_cache_count: u64;
}

pub machine VirtualSnapshotMaterializer::new() -> VirtualSnapshotMaterializer {
    VirtualSnapshotMaterializer {
        query_count: 0,
        current_query_index: 0,
        result_count: 0,
        has_pending_request: false,
        pending_is_final_read: false,
        pending_was_cached_insert: false,
        pending_module_name_len: 0,
        pointer_walk_active: false,
        pointer: StoredPointer::default(),
        current_address: 0,
        current_module_name_len: 0,
        next_link_index: 0,
        evaluated_path_len: 0,
        pointer_walk_had_first_hop: false,
        resolved_address: 0,
        resolved_module_name_len: 0,
        cache_count: 0,
        eval_cache_count: 0,
    }
}

// `begin` copies the snapshot's query list — upstream captures the Vec
// for the spawned thread; the driver needs the same owned snapshot.
pub machine VirtualSnapshotMaterializer::begin(&mut self, virtual_snapshot: &VirtualSnapshot) -> bool {
    self.result_count = 0;
    self.current_query_index = 0;
    self.pointer_walk_active = false;
    self.in_flight_reset();
    self.cache_count = 0;
    self.eval_cache_count = 0;
    transition { _ -> fill(virtual_snapshot, 0) }
    state fill(&mut self, virtual_snapshot: &VirtualSnapshot, position: u64) -> bool {
        transition position < virtual_snapshot.get_query_count() && position < 16 {
            true -> fill_one(virtual_snapshot, position)
            false -> finish(virtual_snapshot)
        }
    }
    state fill_one(&mut self, virtual_snapshot: &VirtualSnapshot, position: u64) -> bool
        requires position < 16;
    {
        _ = virtual_snapshot.copy_query(position, &mut self.queries[position]);
        transition { _ -> fill(virtual_snapshot, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(&mut self, virtual_snapshot: &VirtualSnapshot) -> bool {
        self.query_count = virtual_snapshot.get_query_count();
        transition self.query_count > 16 {
            true -> clamp()
            false -> (true)
        }
    }
    state clamp(&mut self) -> bool {
        self.query_count = 16;
        (true)
    }
}

pub machine VirtualSnapshotMaterializer::get_result_count(&self) -> u64 {
    self.result_count
}

pub machine VirtualSnapshotMaterializer::get_result_ids(&self) -> &[[u8; 128]; 16] {
    (&self.result_ids)
}

pub machine VirtualSnapshotMaterializer::get_result_id_lens(&self) -> &[u64; 16] {
    (&self.result_id_lens)
}

pub machine VirtualSnapshotMaterializer::get_results(&self) -> &[VirtualSnapshotQueryResult; 16] {
    (&self.results)
}

pub machine VirtualSnapshotMaterializer::get_is_finished(&self) -> bool {
    transition self.current_query_index >= self.query_count && !self.pointer_walk_active {
        true -> (true)
        false -> (false)
        _ -> (false)
    }
}

// The pump — emits the next memory read needed to materialize, or false
// when the refresh is complete.
pub machine VirtualSnapshotMaterializer::pump_next_request(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
    transition self.pointer_walk_active && self.current_query_index < 16 {
        true -> pump_walk(registry, out_request)
        false -> advance(registry, out_request)
        _ -> (false)
    }
    // Mid pointer-walk: the next hop is a pointer-width read at the
    // current address/module — the walk bails on a `Symbol` link.
    state pump_walk(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires self.current_query_index < 16;
    {
        transition self.pointer.get_has_unresolvable_link() && self.pointer.get_unresolvable_link_index() == self.next_link_index {
            true -> bail_walk(registry, out_request)
            false -> walk_step(registry, out_request)
        }
    }
    state walk_step(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires self.current_query_index < 16;
    {
        transition self.next_link_index < self.pointer.get_offset_count() && self.current_query_index < 16 {
            true -> emit_hop(registry, out_request)
            false -> emit_final(registry, out_request)
        }
    }
    state emit_hop(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires self.current_query_index < 16;
    {
        let mut pointer_struct: SymbolicStructDefinition = SymbolicStructDefinition::empty();
        transition self.pointer_size_definition(registry, &mut pointer_struct) {
            true -> emit_hop_read(registry, &pointer_struct, out_request)
            false -> bail_walk(registry, out_request)
        }
    }
    state emit_hop_read(&mut self, registry: &PrivilegedRegistryCache, pointer_struct: &SymbolicStructDefinition, out_request: &mut MemoryReadRequest) -> bool
        requires self.current_query_index < 16;
    {
        transition self.current_module_name_len <= 512 {
            true -> emit_hop_bounded(pointer_struct, out_request)
            false -> bail_walk(registry, out_request)
        }
    }
    state emit_hop_bounded(&mut self, pointer_struct: &SymbolicStructDefinition, out_request: &mut MemoryReadRequest) -> bool
        requires self.current_query_index < 16;
    {
        let current_name: &[u8] = slice_512(&self.current_module_name, self.current_module_name_len);
        let request: MemoryReadRequest = MemoryReadRequest::new(self.current_address, current_name, pointer_struct.clone(), false);
        out_request.clone_from(&request);
        self.has_pending_request = true;
        self.pending_is_final_read = false;
        (true)
    }
    // All hops applied — the resolved target gets the query's struct read.
    state emit_final(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires self.current_query_index < 16;
    {
        self.resolved_address = self.current_address;
        _ = copy_slice(&self.current_module_name, self.current_module_name_len, &mut self.resolved_module_name, &mut self.resolved_module_name_len);
        transition self.resolved_module_name_len <= 512 {
            true -> emit_final_bounded(registry, out_request)
            false -> (false)
        }
    }
    state emit_final_bounded(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires self.current_query_index < 16;
    {
        let mut query_struct: SymbolicStructDefinition = SymbolicStructDefinition::empty();
        self.queries[self.current_query_index].get_symbolic_struct_definition(&mut query_struct);
        let resolved_name: &[u8] = slice_512(&self.resolved_module_name, self.resolved_module_name_len);
        let request: MemoryReadRequest = MemoryReadRequest::new(self.resolved_address, resolved_name, query_struct, false);
        out_request.clone_from(&request);
        self.has_pending_request = true;
        self.pending_is_final_read = true;
        (true)
    }
    // `??` — upstream bails the evaluation with an unresolved target.
    state bail_walk(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        _ = self.append_path_segment("??");
        transition { _ -> finish_walk_failed(registry, out_request) }
    }
    state finish_walk_failed(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        _ = self.store_eval_cache(0, false);
        let position: u64 = self.current_query_index;
        transition position < 16 {
            true -> finish_failed_result(position)
            false -> advance_finished(position, registry, out_request)
        }
    }
    state finish_failed_result(&mut self, position: u64) -> bool
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&self.evaluated_path, self.evaluated_path_len);
        _ = result_set_evaluated_path(&mut self.results[position], path_slice);
        _ = self.store_result_id(position);
        self.pointer_walk_active = false;
        self.has_pending_request = false;
        self.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (false)
    }
    state advance_finished(&mut self, position: u64, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        self.pointer_walk_active = false;
        self.has_pending_request = false;
        self.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> advance(registry, out_request) }
    }
    state advance(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        transition self.current_query_index < self.query_count {
            true -> route(registry, out_request)
            false -> (false)
        }
    }
    state route(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool {
        transition self.current_query_index < 16 {
            true -> route_kind(registry, out_request)
            false -> (false)
        }
    }
    state route_kind(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires self.current_query_index < 16;
    {
        transition self.queries[self.current_query_index].get_is_address() {
            true -> address_query(registry, out_request)
            false -> pointer_query(registry, out_request)
        }
    }
    state address_query(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires self.current_query_index < 16;
    {
        let query_address: u64 = self.queries[self.current_query_index].get_address();
        let mut module_name: [u8; 512];
        let mut module_name_len: u64 = 0;
        self.queries[self.current_query_index].copy_module_name(&mut module_name, &mut module_name_len);
        transition { _ -> cache_probe(registry, out_request, query_address, module_name, module_name_len, 0) }
    }
    // Read cache probe — on a hit the stored response fills the result
    // and the pump advances without emitting a request.
    state cache_probe(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64) -> bool
        requires self.current_query_index < 16;
    {
        transition cache_position < self.cache_count && cache_position < 16 {
            true -> cache_compare(registry, out_request, query_address, module_name, module_name_len, cache_position)
            false -> emit_address_read(out_request, query_address, module_name, module_name_len)
        }
    }
    state cache_compare(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64) -> bool
        requires cache_position < 16 && self.current_query_index < 16;
    {
        transition self.cached_addresses[cache_position] == query_address && self.cached_module_name_lens[cache_position] == module_name_len {
            true -> cache_bytes(registry, out_request, query_address, module_name, module_name_len, cache_position, 0)
            false -> cache_probe(registry, out_request, query_address, module_name, module_name_len, ((cache_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state cache_bytes(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64, index: u64) -> bool
        requires cache_position < 16 && self.current_query_index < 16;
    {
        transition index < module_name_len && index < 512 {
            true -> cache_char(registry, out_request, query_address, module_name, module_name_len, cache_position, index)
            false -> serve_cached(registry, out_request, query_address, module_name, module_name_len, cache_position)
        }
    }
    state cache_char(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64, index: u64) -> bool
        requires cache_position < 16 && index < module_name_len && index < 512 && self.current_query_index < 16;
    {
        transition self.cached_module_names[cache_position][index] == module_name[index] {
            true -> cache_bytes(registry, out_request, query_address, module_name, module_name_len, cache_position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> cache_probe(registry, out_request, query_address, module_name, module_name_len, ((cache_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state serve_cached(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64, cache_position: u64) -> bool
        requires cache_position < 16;
    {
        let cached_response: MemoryReadResponse = self.cached_responses[cache_position].clone();
        let position: u64 = self.current_query_index;
        transition position < 16 {
            true -> serve_cached_result(position, &cached_response, query_address, module_name, module_name_len, registry, out_request)
            false -> advance(registry, out_request)
        }
    }
    state serve_cached_result(&mut self, position: u64, cached_response: &MemoryReadResponse, query_address: u64, module_name: &[u8; 512], module_name_len: u64, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires position < 16;
    {
        self.results[position].set_memory_read_response(cached_response);
        self.results[position].set_resolved_address(query_address);
        let module_name_slice: &[u8] = slice_512(module_name, module_name_len);
        _ = result_set_module_name(&mut self.results[position], module_name_slice);
        
        self.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> advance(registry, out_request) }
    }
    state emit_address_read(&mut self, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64) -> bool
        requires self.current_query_index < 16;
    {
        transition module_name_len <= 512 {
            true -> emit_address_bounded(out_request, query_address, module_name, module_name_len)
            false -> (false)
        }
    }
    state emit_address_bounded(&mut self, out_request: &mut MemoryReadRequest, query_address: u64, module_name: &[u8; 512], module_name_len: u64) -> bool
        requires self.current_query_index < 16;
    {
        let mut query_struct: SymbolicStructDefinition = SymbolicStructDefinition::empty();
        self.queries[self.current_query_index].get_symbolic_struct_definition(&mut query_struct);
        let module_name_slice: &[u8] = slice_512(module_name, module_name_len);
        let request: MemoryReadRequest = MemoryReadRequest::new(query_address, module_name_slice, query_struct, false);
        out_request.clone_from(&request);
        self.has_pending_request = true;
        self.pending_is_final_read = true;
        self.pending_was_cached_insert = true;
        _ = copy_slice(module_name, module_name_len, &mut self.pending_module_name, &mut self.pending_module_name_len);
        (true)
    }
    state pointer_query(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires self.current_query_index < 16;
    {
        _ = query_copy_pointer(&self.queries[self.current_query_index], &mut self.pointer);
        // Seed the evaluated path with the root display text — upstream
        // pushes `pointer.get_root_display_text()` first (module + hex root).
        self.evaluated_path_len = 0;
        transition { _ -> seed_root(registry, out_request) }
    }
    state seed_root(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest) -> bool
        requires self.current_query_index < 16;
    {
        _ = self.append_path_segment(self.pointer.get_module_name());
        _ = self.append_hex_prefix();
        _ = self.append_hex_u64(self.pointer.get_address());
        transition { _ -> eval_probe(registry, out_request, 0) }
    }
    state eval_probe(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires self.current_query_index < 16;
    {
        transition cache_position < self.eval_cache_count && cache_position < 16 {
            true -> eval_compare(registry, out_request, cache_position)
            false -> start_walk()
        }
    }
    state eval_compare(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires cache_position < 16 && self.current_query_index < 16;
    {
        transition self.cached_eval_pointers[cache_position].equals(&self.pointer) {
            true -> serve_eval(registry, out_request, cache_position)
            false -> eval_probe(registry, out_request, ((cache_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    // Cached eval — a resolved target goes straight to the final read; a
    // cached failure completes the query with an empty result.
    state serve_eval(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires cache_position < 16 && self.current_query_index < 16;
    {
        transition self.cached_eval_has_address[cache_position] {
            true -> eval_read(registry, out_request, cache_position)
            false -> eval_miss(registry, out_request, cache_position)
        }
    }
    state eval_read(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires cache_position < 16 && self.current_query_index < 16;
    {
        self.resolved_address = self.cached_eval_addresses[cache_position];
        _ = copy_slice(&self.cached_eval_module_names[cache_position], self.cached_eval_module_name_lens[cache_position], &mut self.resolved_module_name, &mut self.resolved_module_name_len);
        _ = copy_slice(&self.cached_eval_paths[cache_position], self.cached_eval_path_lens[cache_position], &mut self.evaluated_path, &mut self.evaluated_path_len);
        transition { _ -> emit_final(registry, out_request) }
    }
    state eval_miss(&mut self, registry: &PrivilegedRegistryCache, out_request: &mut MemoryReadRequest, cache_position: u64) -> bool
        requires cache_position < 16;
    {
        let position: u64 = self.current_query_index;
        _ = copy_slice(&self.cached_eval_paths[cache_position], self.cached_eval_path_lens[cache_position], &mut self.evaluated_path, &mut self.evaluated_path_len);
        transition position < 16 {
            true -> eval_miss_result(position)
            false -> advance_finished(position, registry, out_request)
        }
    }
    state eval_miss_result(&mut self, position: u64) -> bool
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&self.evaluated_path, self.evaluated_path_len);
        _ = result_set_evaluated_path(&mut self.results[position], path_slice);
        
        self.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (false)
    }
    state start_walk(&mut self) -> bool {
        self.pointer_walk_active = true;
        self.pointer_walk_had_first_hop = false;
        self.current_address = self.pointer.get_address();
        self.pointer.copy_module_name(&mut self.current_module_name, &mut self.current_module_name_len);
        self.next_link_index = 0;
        (false)
    }

}

machine VirtualSnapshotMaterializer::in_flight_reset(&mut self) {
    self.has_pending_request = false;
    self.pending_is_final_read = false;
    self.pending_was_cached_insert = false;
}

// `accept_response` — the composition root feeds each dispatched
// response back; hop responses drive the next offset, final responses
// complete the query's result.
pub machine VirtualSnapshotMaterializer::accept_response(&mut self, response: &MemoryReadResponse) {
    self.has_pending_request = false;
    transition self.pending_is_final_read {
        true -> complete_query(response)
        false -> apply_hop(response)
        _ -> complete_query(response)
    }
    state complete_query(&mut self, response: &MemoryReadResponse) {
        let position: u64 = self.current_query_index;
        transition position < 16 {
            true -> route_kind(position, response)
            false -> done()
        }
    }
    state route_kind(&mut self, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        transition self.pointer_walk_active {
            true -> complete_pointer(position, response)
            false -> complete_address(position, response)
        }
    }
    state complete_address(&mut self, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        transition response.get_success() {
            true -> fill_address_result(position, response)
            false -> fill_failed_result(position, response)
        }
    }
    state fill_address_result(&mut self, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        self.results[position].set_memory_read_response(response);
        self.results[position].set_resolved_address(response.get_address());
        transition self.pending_module_name_len <= 512 {
            true -> fill_address_module(position, response)
            false -> fill_address_finish(position, response)
        }
    }
    state fill_address_module(&mut self, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let pending_name: &[u8] = slice_512(&self.pending_module_name, self.pending_module_name_len);
        _ = result_set_module_name(&mut self.results[position], pending_name);
        transition { _ -> fill_address_finish(position, response) }
    }
    state fill_address_finish(&mut self, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        
        _ = self.store_read_cache(response);
        self.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done() }
    }
    state fill_failed_result(&mut self, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        
        _ = self.store_read_cache(response);
        self.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done() }
    }
    state complete_pointer(&mut self, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        transition response.get_success() {
            true -> fill_pointer_result(position, response)
            false -> fill_pointer_failed(position, response)
        }
    }
    state fill_pointer_result(&mut self, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        self.results[position].set_memory_read_response(response);
        self.results[position].set_resolved_address(self.resolved_address);
        transition self.resolved_module_name_len <= 512 {
            true -> fill_pointer_module(position, response)
            false -> fill_pointer_path(position, response)
        }
    }
    state fill_pointer_module(&mut self, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let resolved_name: &[u8] = slice_512(&self.resolved_module_name, self.resolved_module_name_len);
        _ = result_set_module_name(&mut self.results[position], resolved_name);
        transition { _ -> fill_pointer_path(position, response) }
    }
    state fill_pointer_path(&mut self, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&self.evaluated_path, self.evaluated_path_len);
        _ = result_set_evaluated_path(&mut self.results[position], path_slice);
        
        _ = self.store_eval_cache(self.resolved_address, true);
        _ = self.store_read_cache(response);
        self.pointer_walk_active = false;
        self.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done() }
    }
    state fill_pointer_failed(&mut self, position: u64, response: &MemoryReadResponse)
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&self.evaluated_path, self.evaluated_path_len);
        _ = result_set_evaluated_path(&mut self.results[position], path_slice);
        
        _ = self.store_eval_cache(self.resolved_address, true);
        _ = self.store_read_cache(response);
        self.pointer_walk_active = false;
        self.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done() }
    }
    // A hop response: extract the pointer value from the first field's
    // bytes (pointer-width little/big endian), apply the offset, and
    // advance. A failed read or overflow bails with `??`.
    state apply_hop(&mut self, response: &MemoryReadResponse) {
        transition response.get_success() {
            true -> read_value(response)
            false -> bail()
        }
    }
    state read_value(&mut self, response: &MemoryReadResponse) {
        let valued_struct: &ValuedStruct = response.get_valued_struct();
        let field: ValuedStructField = valued_struct.get_field_at(0);
        let data_value: DataValue = field.get_data_value();
        let bytes: &[u8] = data_value.get_value_bytes();
        let pointer_endian: Endian = self.get_pointer_endian();
        let value: u64 = assemble_pointer_value(bytes, self.pointer.get_pointer_size(), pointer_endian);
        let offset: i64 = self.pointer.get_offset(self.next_link_index);
        transition { _ -> apply_offset(value, offset) }
    }
    state apply_offset(&mut self, value: u64, offset: i64) {
        transition offset >= 0 {
            true -> add_offset(value, offset)
            false -> sub_offset(value, offset)
        }
    }
    state add_offset(&mut self, value: u64, offset: i64)
        requires offset >= 0;
    {
        // `apply_pointer_offset` — checked_add for non-negative offsets:
        // overflow refuses rather than wrapping.
        let offset_magnitude: u64 = offset as u64;
        transition offset_magnitude <= (18446744073709551615 - value) {
            true -> apply_add(value, offset)
            false -> bail()
        }
    }
    state sub_offset(&mut self, value: u64, offset: i64) {
        // Negative offset — the u64 magnitude is the wrapping negation of
        // the two's-complement cast.
        let magnitude: u64 = ((0 - (offset as u64 in Wrapping)) as u64 in Wrapping) as u64;
        transition value >= magnitude {
            true -> apply_sub(value, offset)
            false -> bail()
        }
    }
    state apply_add(&mut self, value: u64, offset: i64)
        requires offset >= 0;
    {
        self.current_address = ((value as u64 in Wrapping) + ((offset as u64 in Wrapping) as u64 in Wrapping)) as u64;
        transition { _ -> after_hop() }
    }
    state apply_sub(&mut self, value: u64, offset: i64)
        requires offset < 0;
    {
        let magnitude: u64 = ((0 - (offset as u64 in Wrapping)) as u64 in Wrapping) as u64;
        self.current_address = ((value as u64 in Wrapping) - (magnitude as u64 in Wrapping)) as u64;
        transition { _ -> after_hop() }
    }
    state after_hop(&mut self) {
        // Upstream clears the module once the first offset applies.
        self.current_module_name_len = 0;
        self.pointer_walk_had_first_hop = true;
        self.next_link_index = ((self.next_link_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        _ = self.append_path_segment("0x..");
        transition { _ -> done() }
    }
    state bail(&mut self) {
        _ = self.append_path_segment("??");
        _ = self.store_eval_cache(0, false);
        let position: u64 = self.current_query_index;
        transition position < 16 {
            true -> bail_result(position)
            false -> done()
        }
    }
    state bail_result(&mut self, position: u64)
        requires position < 16;
    {
        let path_slice: &[u8] = slice_512(&self.evaluated_path, self.evaluated_path_len);
        _ = result_set_evaluated_path(&mut self.results[position], path_slice);
        
        self.pointer_walk_active = false;
        self.current_query_index = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

// Byte-array helpers — copy a bounded array into another with a length.
machine copy_slice(source: &[u8; 512], source_len: u64, destination: &mut [u8; 512], destination_len: &mut u64) -> bool {
    transition { _ -> copy(source, source_len, destination, destination_len, 0) }
    state copy(source: &[u8; 512], source_len: u64, destination: &mut [u8; 512], destination_len: &mut u64, position: u64) -> bool

    {
        transition position < source_len && position < 512 {
            true -> copy_one(source, source_len, destination, destination_len, position)
            false -> finish(source_len, destination_len)
        }
    }
    state copy_one(source: &[u8; 512], source_len: u64, destination: &mut [u8; 512], destination_len: &mut u64, position: u64) -> bool
        requires position < source_len && position < 512;
    {
        destination[position] = source[position];
        transition { _ -> copy(source, source_len, destination, destination_len, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(source_len: u64, destination_len: &mut u64) -> bool {
        destination_len = source_len;
        (true)
    }
}

// `read_pointer_value` — assemble the little/big-endian pointer-width
// value from the read bytes.
machine assemble_pointer_value(bytes: &[u8], pointer_size: u64, endian: Endian) -> u64 {
    transition endian {
        Endian::Little -> assemble_le(bytes, pointer_size, 0, 0)
        Endian::Big -> assemble_be(bytes, pointer_size, 0, 0)
        _ -> (0)
    }
    state assemble_le(bytes: &[u8], pointer_size: u64, index: u64, value: u64) -> u64

    {
        transition index < pointer_size && index < bytes.len && index < 8 {
            true -> accumulate_le(bytes, pointer_size, index, value)
            false -> (value)
        }
    }
    // Little-endian fold: value | (byte << index*8). `index < 8` (from the
    // requires) bounds the multiply and shift; the byte cast is a widening.
    state accumulate_le(bytes: &[u8], pointer_size: u64, index: u64, value: u64) -> u64
        requires index < bytes.len && index < 8;
    {
        let next_index: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let next_value: u64 = value | ((bytes[index] as u64) << (index * 8));
        transition { _ -> assemble_le(bytes, pointer_size, next_index, next_value) }
    }
    state assemble_be(bytes: &[u8], pointer_size: u64, index: u64, value: u64) -> u64

    {
        transition index < pointer_size && index < bytes.len && index < 8 {
            true -> accumulate_be(bytes, pointer_size, index, value)
            false -> (value)
        }
    }
    // Big-endian fold: (value << 8) | byte. The shift can legitimately
    // discard top bits once enough bytes accumulate (a u64 read at pointer
    // size 8 fills exactly); wrapping is the honest spelling.
    state accumulate_be(bytes: &[u8], pointer_size: u64, index: u64, value: u64) -> u64
        requires index < bytes.len && index < 8;
    {
        let next_index: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let next_value: u64 = (((value as u64 in Wrapping) << 8) | (bytes[index] as u64 in Wrapping)) as u64;
        transition { _ -> assemble_be(bytes, pointer_size, next_index, next_value) }
    }
}

// Insert into the read cache — keyed by (response address, module).
machine VirtualSnapshotMaterializer::store_read_cache(&mut self, response: &MemoryReadResponse) -> bool {
    transition self.cache_count < 16 {
        true -> store(response)
        false -> (false)
        _ -> (false)
    }
    state store(&mut self, response: &MemoryReadResponse) -> bool {
        let slot: u64 = self.cache_count;
        self.cached_addresses[slot] = response.get_address();
        self.cached_responses[slot].clone_from(response);
        transition self.pending_was_cached_insert {
            true -> store_module(slot)
            false -> store_empty_module(slot)
        }
    }
    state store_module(&mut self, slot: u64) -> bool
        requires slot < 16;
    {
        _ = copy_slice(&self.pending_module_name, self.pending_module_name_len, &mut self.cached_module_names[slot], &mut self.cached_module_name_lens[slot]);
        self.cache_count = ((self.cache_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
    state store_empty_module(&mut self, slot: u64) -> bool
        requires slot < 16;
    {
        self.cached_module_name_lens[slot] = 0;
        self.cache_count = ((self.cache_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// `pointer_size_definition` — resolves the pointer-width data type's
// struct layout through the registry cache.
machine VirtualSnapshotMaterializer::pointer_size_definition(&self, registry: &PrivilegedRegistryCache, out_definition: &mut SymbolicStructDefinition) -> bool {
    let pointer_size: PointerScanPointerSize = self.pointer_size_value();
    let data_type_ref: DataTypeRef = pointer_size.to_data_type_ref();
    (registry.resolve_struct_layout_definition(data_type_ref.get_data_type_id(), out_definition))
}

machine VirtualSnapshotMaterializer::pointer_size_value(&self) -> PointerScanPointerSize {
    transition self.pointer.get_pointer_size() == 4 {
        true -> (PointerScanPointerSize::Pointer32)
        false -> check_three()
        _ -> (PointerScanPointerSize::Pointer64)
    }
    state check_three(&self) -> PointerScanPointerSize {
        transition self.pointer.get_pointer_size() == 3 {
            true -> (PointerScanPointerSize::Pointer24)
            false -> (PointerScanPointerSize::Pointer64)
        }
    }
}

// Records the query's id alongside its result slot.
machine VirtualSnapshotMaterializer::store_result_id(&mut self, position: u64) -> bool {
    transition position < 16 {
        true -> store_id(position)
        false -> (false)
        _ -> (false)
    }
    state store_id(&mut self, position: u64) -> bool
        requires position < 16;
    {
        let mut query_id: [u8; 128];
        let mut query_id_len: u64 = 0;
        self.queries[position].copy_query_id_into(&mut query_id, &mut query_id_len);
        self.result_ids[position] = query_id;
        self.result_id_lens[position] = query_id_len;
        transition self.result_count < 16 {
            true -> bump(position)
            false -> (true)
        }
    }
    state bump(&mut self, position: u64) -> bool
        requires position < 16;
    {
        transition position == self.result_count {
            true -> bump_it()
            false -> (true)
        }
    }
    state bump_it(&mut self) -> bool {
        self.result_count = ((self.result_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `cached_pointer_query_evaluations.insert` — dedup by pointer.
machine VirtualSnapshotMaterializer::store_eval_cache(&mut self, resolved_address: u64, has_address: bool) -> bool {
    transition self.eval_cache_count < 16 {
        true -> store_eval(resolved_address, has_address)
        false -> (false)
        _ -> (false)
    }
    state store_eval(&mut self, resolved_address: u64, has_address: bool) -> bool {
        let slot: u64 = self.eval_cache_count;
        self.cached_eval_pointers[slot].clone_from(&self.pointer);
        self.cached_eval_has_address[slot] = has_address;
        self.cached_eval_addresses[slot] = resolved_address;
        transition has_address {
            true -> store_eval_module(slot)
            false -> store_eval_path_only(slot)
        }
    }
    state store_eval_module(&mut self, slot: u64) -> bool
        requires slot < 16;
    {
        _ = copy_slice(&self.resolved_module_name, self.resolved_module_name_len, &mut self.cached_eval_module_names[slot], &mut self.cached_eval_module_name_lens[slot]);
        _ = copy_slice(&self.evaluated_path, self.evaluated_path_len, &mut self.cached_eval_paths[slot], &mut self.cached_eval_path_lens[slot]);
        self.eval_cache_count = ((self.eval_cache_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
    state store_eval_path_only(&mut self, slot: u64) -> bool
        requires slot < 16;
    {
        self.cached_eval_module_name_lens[slot] = 0;
        _ = copy_slice(&self.evaluated_path, self.evaluated_path_len, &mut self.cached_eval_paths[slot], &mut self.cached_eval_path_lens[slot]);
        self.eval_cache_count = ((self.eval_cache_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Appends " -> <text>" (or the leading segment) to evaluated_path —
// upstream `evaluated_path_segments.join(" -> ")`.
machine VirtualSnapshotMaterializer::append_path_segment(&mut self, text: &[u8]) -> bool {
    transition self.evaluated_path_len == 0 {
        true -> append_text(text)
        false -> sep(text)
        _ -> append_text(text)
    }
    state sep(&mut self, text: &[u8]) -> bool {
        transition self.evaluated_path_len <= 508 {
            true -> write_sep(text)
            false -> (false)
        }
    }
    state write_sep(&mut self, text: &[u8]) -> bool
        requires self.evaluated_path_len <= 508;
    {
        let index_one: u64 = self.evaluated_path_len + 1;
        let index_two: u64 = self.evaluated_path_len + 2;
        let index_three: u64 = self.evaluated_path_len + 3;
        transition index_one < 512 && index_two < 512 && index_three < 512 {
            true -> write_sep_bounded(text, index_one, index_two, index_three)
            _ -> (false)
        }
    }
    state write_sep_bounded(&mut self, text: &[u8], index_one: u64, index_two: u64, index_three: u64) -> bool
        requires self.evaluated_path_len <= 508 && index_one < 512 && index_two < 512 && index_three < 512;
    {
        self.evaluated_path[self.evaluated_path_len] = 32;
        self.evaluated_path[index_one] = 45;
        self.evaluated_path[index_two] = 62;
        self.evaluated_path[index_three] = 32;
        self.evaluated_path_len = self.evaluated_path_len + 4;
        transition { _ -> append_text(text) }
    }
    state append_text(&mut self, text: &[u8]) -> bool {
        transition { _ -> loop_copy(text, 0) }
    }
    state loop_copy(&mut self, text: &[u8], index: u64) -> bool

    {
        transition index < text.len && self.evaluated_path_len < 512 {
            true -> copy_char(text, index)
            false -> (true)
        }
    }
    state copy_char(&mut self, text: &[u8], index: u64) -> bool
        requires index < text.len;
    {
        self.evaluated_path[self.evaluated_path_len] = text[index];
        self.evaluated_path_len = ((self.evaluated_path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> loop_copy(text, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Appends the "0x" prefix onto the evaluated path.
machine VirtualSnapshotMaterializer::append_hex_prefix(&mut self) -> bool {
    transition self.evaluated_path_len <= 510 {
        true -> write()
        false -> (false)
        _ -> (false)
    }
    state write(&mut self) -> bool
        requires self.evaluated_path_len <= 510;
    {
        let index_one: u64 = self.evaluated_path_len + 1;
        transition index_one < 512 {
            true -> write_bounded(index_one)
            _ -> (false)
        }
    }
    state write_bounded(&mut self, index_one: u64) -> bool
        requires self.evaluated_path_len <= 510 && index_one < 512;
    {
        self.evaluated_path[self.evaluated_path_len] = 48;
        self.evaluated_path[index_one] = 120;
        self.evaluated_path_len = self.evaluated_path_len + 2;
        (true)
    }
}

// Appends an uppercase hex rendering — upstream `format!("{:X}", address)`.
// Zero renders as a single '0'.
machine VirtualSnapshotMaterializer::append_hex_u64(&mut self, value: u64) -> bool {
    transition { _ -> walk(15, value) }
    state walk(&mut self, nibble: u64, value: u64)

    {
        transition nibble > 0 {
            true -> check_leading(nibble, value)
            false -> last_digit(value)
        }
    }
    state check_leading(&mut self, nibble: u64, value: u64)
        requires nibble > 0;
    {
        // The nibble cursor walks 15 down to 0 upstream — the `nibble * 4`
        // shift count needs the bound re-spelled so it reaches the multiply
        // and shift obligations inside the dominated state.
        transition nibble <= 15 {
            true -> check_leading_bounded(nibble, value)
            _ -> step_down(nibble, value)
        }
    }
    state check_leading_bounded(&mut self, nibble: u64, value: u64)
        requires nibble <= 15 && nibble > 0;
    {
        transition (value >> (nibble * 4)) & 15 != 0 {
            true -> write_nibble(nibble, value)
            false -> step_down(nibble, value)
        }
    }
    state step_down(&mut self, nibble: u64, value: u64)
        requires nibble > 0;
    {
        let next_nibble: u64 = nibble - 1;
        transition { _ -> walk_from(next_nibble, value) }
    }
    state walk_from(&mut self, nibble: u64, value: u64)

    {
        transition nibble > 0 {
            true -> check_leading(nibble, value)
            false -> last_digit(value)
        }
    }
    state write_nibble(&mut self, nibble: u64, value: u64) {
        transition nibble <= 15 {
            true -> write_nibble_bounded(nibble, value)
            _ -> (true)
        }
    }
    state write_nibble_bounded(&mut self, nibble: u64, value: u64)
        requires nibble <= 15;
    {
        _ = self.append_hex_digit(((value >> (nibble * 4)) & 15) as u8);
        transition nibble > 0 {
            true -> write_step(nibble, value)
            false -> (true)
        }
    }
    state write_step(&mut self, nibble: u64, value: u64)
        requires nibble <= 15 && nibble > 0;
    {
        let next_nibble: u64 = nibble - 1;
        transition { _ -> write_rest(next_nibble, value) }
    }
    state write_rest(&mut self, nibble: u64, value: u64) {
        transition nibble <= 15 {
            true -> write_rest_bounded(nibble, value)
            _ -> (true)
        }
    }
    state write_rest_bounded(&mut self, nibble: u64, value: u64)
        requires nibble <= 15;
    {
        _ = self.append_hex_digit(((value >> (nibble * 4)) & 15) as u8);
        transition nibble > 0 {
            true -> write_step(nibble, value)
            false -> (true)
        }
    }
    state last_digit(&mut self, value: u64) -> bool {
        _ = self.append_hex_digit((value & 15) as u8);
        (true)
    }
}

machine VirtualSnapshotMaterializer::append_hex_digit(&mut self, digit: u8) -> bool {
    transition digit < 10 {
        true -> numeric(digit)
        false -> letter(digit)
        _ -> letter(digit)
    }
    state numeric(&mut self, digit: u8) -> bool {
        transition self.evaluated_path_len < 512 {
            true -> write_digit(digit + 48)
            false -> (false)
        }
    }
    state letter(&mut self, digit: u8) -> bool {
        transition digit >= 10 && digit < 16 && self.evaluated_path_len < 512 {
            true -> write_letter(digit)
            false -> (false)
        }
    }
    state write_letter(&mut self, digit: u8) -> bool {
        self.evaluated_path[self.evaluated_path_len] = digit + 55;
        self.evaluated_path_len = ((self.evaluated_path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
    state write_digit(&mut self, byte: u8) -> bool {
        self.evaluated_path[self.evaluated_path_len] = byte;
        self.evaluated_path_len = ((self.evaluated_path_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Indexed-element receivers do not parse under `_ =` — these helpers take
// the element as an argument instead.
machine result_set_evaluated_path(result: &mut VirtualSnapshotQueryResult, path: &[u8]) -> bool {
    result.set_evaluated_pointer_path(path)
}

machine result_set_module_name(result: &mut VirtualSnapshotQueryResult, module_name: &[u8]) -> bool {
    result.set_resolved_module_name(module_name)
}

machine query_copy_pointer(query: &VirtualSnapshotQuery, pointer: &mut StoredPointer) -> bool {
    query.copy_pointer(pointer)
}

// Record-machine counterpart of the hop-endian probe (internal states are
// transition destinations, not value callees). Upstream reads hops in the
// process endianness — the materializer tracks it per walk today as the
// pointer-size default; the real source lands with the executor leg's
// OpenedProcess plumbing (documented approximation).
machine VirtualSnapshotMaterializer::get_pointer_endian(&self) -> Endian {
    (Endian::Little)
}
