module src::plugins::plugin_registry;

use squalr_engine_api::src::commands::plugins::set_order::plugin_set_order_request::PluginSetOrderRequest;
use squalr_engine_api::src::plugins::plugin_activation_state::PluginActivationState;
use squalr_engine_api::src::plugins::plugin_capability::PluginCapability;
use squalr_engine_api::src::plugins::plugin_id::PluginId;
use squalr_engine_api::src::plugins::plugin_metadata::PluginMetadata;
use squalr_engine_api::src::plugins::plugin_permission::PluginPermission;
use squalr_engine_api::src::plugins::plugin_state::PluginState;
use squalr_engine_api::src::registries::symbols::data_type_descriptor::DataTypeDescriptor;
use squalr_engine_api::src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use squalr_engine_api::src::structures::memory::endian::Endian;

// Port of plugins/plugin_registry.rs. The bounded-metadata port:
// - `plugin_packages: Vec<Arc<dyn PluginPackage>>` maps to a 8-slot seed
//   table of `PluginMetadata` — the command surface only ever reads
//   metadata (list/set_enabled/set_order), so the record carries the
//   same 7 builtin packages `get_builtin_plugin_packages()` returns.
// - `enabled_plugin_ids: RwLock<HashSet<String>>` maps to a parallel
//   `is_enabled` flag per seed entry.
// - `plugin_order: RwLock<Vec<String>>` maps to a position permutation —
//   the port orders positions, not ids, since the seed table is closed.
// - `data_type_plugin_ids_by_data_type_id` maps to a bounded pair table
//   rebuilt the same way (ordered packages, first-wins).
//
// Documented deviations (dyn plugin surfaces are absent headless):
// - `as_*_plugin`/`can_attach`/`symbol_tree_actions`/`contributed_*` dyn
//   calls have no plugin-host correspondent: `get_plugin_states` reports
//   `PluginActivationState::Idle` for every entry (upstream's activation
//   path requires a live memory-view/debugger plugin instance).
// - `register_plugin_data_types` (the contribution of u24/i_* descriptors
//   into the SymbolRegistry) is deferred to the plugin-host leg — the
//   descriptor impls do not exist. The ownership TABLE is carried so
//   `is_data_type_enabled` keeps upstream's real enablement semantics.
// - `find_instruction_set`/`find_memory_view_plugin_package`/
//   `find_debugger_plugin_package`/`get_enabled_symbol_tree_actions`/
//   `plugin_action_has_required_permissions` arrive with the plugin-host
//   leg (selection needs the plugin impls, not just metadata).

// The 7 upstream builtin package entries in `get_builtin_plugin_packages`
// order. Table is 8 slots so registration-order append keeps a spare.
pub data PluginRegistry {
    plugins: [PluginMetadata; 8];
    plugin_count: u64;
    is_enabled: [bool; 8];
    plugin_order: [u64; 8];
    plugin_order_count: u64;
    data_type_ids: [[u8; 64]; 16];
    data_type_id_lens: [u64; 16];
    data_type_plugin_positions: [u64; 16];
    data_type_count: u64;
}

pub machine PluginRegistry::new() -> PluginRegistry {
    let mut registry: PluginRegistry = PluginRegistry {
        plugin_count: 0,
        plugin_order_count: 0,
        data_type_count: 0,
    };
    PluginRegistry::seed_builtins(&mut registry);
    (registry)
}

pub machine PluginRegistry::default() -> PluginRegistry {
    (PluginRegistry::new())
}

// `get_builtin_plugin_packages()` — one seed state per package, upstream
// registration order. Each seed fills the metadata carrier and the
// enabled flag (`is_enabled_by_default`) plus its order position and
// contributed data-type pairs.
machine PluginRegistry::seed_builtins(this: &mut PluginRegistry) {
    transition { _ -> seed_dolphin(this) }

    state seed_dolphin(this: &mut PluginRegistry) {
        let mut metadata: PluginMetadata = PluginMetadata::new("builtin.memory-view.dolphin", "Dolphin Memory View", "Exposes Dolphin emulator memory as a canonical virtual address space.", true, true);
        _ = PluginMetadata::add_plugin_capability(&mut metadata, PluginCapability::MemoryView);
        _ = PluginMetadata::add_plugin_permission(&mut metadata, PluginPermission::ReadProcessMemory);
        _ = PluginMetadata::add_plugin_permission(&mut metadata, PluginPermission::WriteProcessMemory);
        PluginMetadata::clone_from(&mut this.plugins[0], &metadata);
        this.is_enabled[0] = true;
        this.plugin_order[0] = 0;
        transition { _ -> seed_24bit(this) }
    }

    state seed_24bit(this: &mut PluginRegistry) {
        let mut metadata: PluginMetadata = PluginMetadata::new("builtin.data-type.24bit-integers", "24-bit Integers", "Adds u24, u24be, i24, and i24be scan and formatting support.", true, false);
        _ = PluginMetadata::add_plugin_capability(&mut metadata, PluginCapability::DataType);
        PluginMetadata::clone_from(&mut this.plugins[1], &metadata);
        this.is_enabled[1] = false;
        this.plugin_order[1] = 1;
        transition { _ -> seed_arm(this) }
    }

    state seed_arm(this: &mut PluginRegistry) {
        let mut metadata: PluginMetadata = PluginMetadata::new("builtin.instruction-set.arm-family", "ARM Instructions", "Adds ARM32, Thumb, and ARM64 instruction data types with built-in assembly/disassembly support for common control-flow and load/store forms.", true, true);
        _ = PluginMetadata::add_plugin_capability(&mut metadata, PluginCapability::DataType);
        _ = PluginMetadata::add_plugin_capability(&mut metadata, PluginCapability::InstructionSet);
        PluginMetadata::clone_from(&mut this.plugins[2], &metadata);
        this.is_enabled[2] = true;
        this.plugin_order[2] = 2;
        transition { _ -> seed_powerpc(this) }
    }

    state seed_powerpc(this: &mut PluginRegistry) {
        let mut metadata: PluginMetadata = PluginMetadata::new("builtin.instruction-set.powerpc-family", "PowerPC Instructions", "Adds PowerPC instruction data types with built-in assembly/disassembly support for common branch, arithmetic, and load/store forms.", true, true);
        _ = PluginMetadata::add_plugin_capability(&mut metadata, PluginCapability::DataType);
        _ = PluginMetadata::add_plugin_capability(&mut metadata, PluginCapability::InstructionSet);
        PluginMetadata::clone_from(&mut this.plugins[3], &metadata);
        this.is_enabled[3] = true;
        this.plugin_order[3] = 3;
        transition { _ -> seed_x86(this) }
    }

    state seed_x86(this: &mut PluginRegistry) {
        let mut metadata: PluginMetadata = PluginMetadata::new("builtin.instruction-set.x86-family", "x86/x64 Instructions", "Adds x86 and x64 instruction data types with built-in assembly/disassembly support for common immediate/register forms.", true, true);
        _ = PluginMetadata::add_plugin_capability(&mut metadata, PluginCapability::DataType);
        _ = PluginMetadata::add_plugin_capability(&mut metadata, PluginCapability::InstructionSet);
        PluginMetadata::clone_from(&mut this.plugins[4], &metadata);
        this.is_enabled[4] = true;
        this.plugin_order[4] = 4;
        transition { _ -> seed_binary_symbols(this) }
    }

    state seed_binary_symbols(this: &mut PluginRegistry) {
        let mut metadata: PluginMetadata = PluginMetadata::new("builtin.symbols.binary", "Binary Symbols", "Populates common binary image structures into module symbol trees.", true, true);
        _ = PluginMetadata::add_plugin_capability(&mut metadata, PluginCapability::SymbolTree);
        _ = PluginMetadata::add_plugin_permission(&mut metadata, PluginPermission::ReadSymbolStore);
        _ = PluginMetadata::add_plugin_permission(&mut metadata, PluginPermission::WriteSymbolStore);
        _ = PluginMetadata::add_plugin_permission(&mut metadata, PluginPermission::ReadSymbolTreeWindow);
        _ = PluginMetadata::add_plugin_permission(&mut metadata, PluginPermission::WriteSymbolTreeWindow);
        _ = PluginMetadata::add_plugin_permission(&mut metadata, PluginPermission::ReadProcessMemory);
        PluginMetadata::clone_from(&mut this.plugins[5], &metadata);
        this.is_enabled[5] = true;
        this.plugin_order[5] = 5;
        transition { _ -> seed_debuggers(this) }
    }

    state seed_debuggers(this: &mut PluginRegistry) {
        let mut metadata: PluginMetadata = PluginMetadata::new("builtin.debuggers.native", "Native Debuggers", "Built-in native debugger backends for supported platforms.", true, true);
        _ = PluginMetadata::add_plugin_capability(&mut metadata, PluginCapability::Debugger);
        _ = PluginMetadata::add_plugin_permission(&mut metadata, PluginPermission::AttachDebugger);
        _ = PluginMetadata::add_plugin_permission(&mut metadata, PluginPermission::ControlDebuggerExecution);
        _ = PluginMetadata::add_plugin_permission(&mut metadata, PluginPermission::ManageDebuggerBreakpoints);
        _ = PluginMetadata::add_plugin_permission(&mut metadata, PluginPermission::ReadRegisters);
        _ = PluginMetadata::add_plugin_permission(&mut metadata, PluginPermission::WriteRegisters);
        PluginMetadata::clone_from(&mut this.plugins[6], &metadata);
        this.is_enabled[6] = true;
        this.plugin_order[6] = 6;
        this.plugin_count = 7;
        this.plugin_order_count = 7;
        transition { _ -> seed_data_types(this, 0, 0) }
    }

    // `build_data_type_plugin_ids_by_data_type_id` — walks the seeded
    // package order (positions 0..count) and first-wins each package's
    // contributed data-type ids. The contribution lists are the constant
    // `*_DATA_TYPE_IDS` tables in each builtin's constants.rs.
    state seed_data_types(this: &mut PluginRegistry, position: u64, index: u64) {
        transition position < this.plugin_count && position < 8 && index < 16 {
            true -> seed_data_type_pair(this, position, index)
            _ -> done(this)
        }
    }

    state seed_data_type_pair(this: &mut PluginRegistry, position: u64, index: u64)
        requires position < 8 && index < 16
    {
        let hoist1: u64 = PluginRegistry::contributed_data_type_count(&this, position);
        transition index < hoist1 && this.data_type_count < 16 {
            true -> insert_pair(this, position, index)
            _ -> advance(this, position)
        }
    }

    state insert_pair(this: &mut PluginRegistry, position: u64, index: u64)
        requires position < 8 && index < 16
    {
        transition this.data_type_count < 16 {
            true -> store_pair(this, position, index)
            _ -> next_index(this, position, index)
        }
    }

    state store_pair(this: &mut PluginRegistry, position: u64, index: u64)
        requires position < 8 && index < 16 && this.data_type_count < 16
    {
        PluginRegistry::store_contributed_id(&mut this, position, index);
        transition { _ -> next_index(this, position, index) }
    }

    state next_index(this: &mut PluginRegistry, position: u64, index: u64)
        requires position < 8 && index < 16
    {
        let next_index: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next_index < 16 {
            true -> seed_data_type_pair(this, position, next_index)
            _ -> advance(this, position)
        }
    }

    state advance(this: &mut PluginRegistry, position: u64)
        requires position < 8
    {
        let next_position: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next_position < 16 {
            true -> seed_data_types(this, next_position, 0)
            _ -> done(this)
        }
    }

    state done(this: &mut PluginRegistry) {}
}

// The contributed data-type id list per seed position — the constant
// `*_DATA_TYPE_IDS` tables (24bit: u24/u24be/i24/i24be; arm: i_arm/i_thumb/
// i_arm64; powerpc: i_ppc32be; x86: i_x86/i_x64; others: none).
pub machine PluginRegistry::contributed_data_type_count(this: &PluginRegistry, position: u64) -> u64 {
    transition position {
        1 -> (4)
        2 -> (3)
        3 -> (1)
        4 -> (2)
        _ -> (0)
    }
}

// Byte/len view of each contributed id — value-returning accessors so
// callers never hold a `&[u8]` loan across a mutation of the pair table
// (the checked borrow rule rejects write-while-borrowed shapes).
machine PluginRegistry::contributed_data_type_len(this: &PluginRegistry, position: u64, index: u64) -> u64 {
    transition position {
        1 -> len_24bit(this, index)
        2 -> len_arm(this, index)
        3 -> len_powerpc(this, index)
        4 -> len_x86(this, index)
        _ -> (0)
    }
    state len_24bit(this: &PluginRegistry, index: u64) -> u64 {
        transition index {
            0 -> (3)
            1 -> (5)
            2 -> (3)
            3 -> (5)
            _ -> (0)
        }
    }
    state len_arm(this: &PluginRegistry, index: u64) -> u64 {
        transition index {
            0 -> (5)
            1 -> (7)
            2 -> (7)
            _ -> (0)
        }
    }
    state len_powerpc(this: &PluginRegistry, index: u64) -> u64 {
        transition index {
            0 -> (9)
            _ -> (0)
        }
    }
    state len_x86(this: &PluginRegistry, index: u64) -> u64 {
        transition index {
            0 -> (5)
            1 -> (4)
            _ -> (0)
        }
    }
}

// "u24" "u24be" "i24" "i24be" / "i_arm" "i_thumb" "i_arm64" / "i_ppc32be"
// / "i_x86" "i_x64" — each id's ASCII bytes by (position, index, char_pos).
machine PluginRegistry::contributed_data_type_byte(this: &PluginRegistry, position: u64, index: u64, char_pos: u64) -> u8 {
    transition position {
        1 -> byte_24bit(this, index, char_pos)
        2 -> byte_arm(this, index, char_pos)
        3 -> byte_powerpc(this, index, char_pos)
        4 -> byte_x86(this, index, char_pos)
        _ -> (0)
    }
    state byte_24bit(this: &PluginRegistry, index: u64, char_pos: u64) -> u8 {
        transition index {
            0 -> u24(this, char_pos)
            1 -> u24be(this, char_pos)
            2 -> i24(this, char_pos)
            3 -> i24be(this, char_pos)
            _ -> (0)
        }
    }
    state u24(this: &PluginRegistry, char_pos: u64) -> u8 {
        transition char_pos {
            0 -> (117)
            1 -> (50)
            2 -> (52)
            _ -> (0)
        }
    }
    state u24be(this: &PluginRegistry, char_pos: u64) -> u8 {
        transition char_pos {
            0 -> (117)
            1 -> (50)
            2 -> (52)
            3 -> (98)
            4 -> (101)
            _ -> (0)
        }
    }
    state i24(this: &PluginRegistry, char_pos: u64) -> u8 {
        transition char_pos {
            0 -> (105)
            1 -> (50)
            2 -> (52)
            _ -> (0)
        }
    }
    state i24be(this: &PluginRegistry, char_pos: u64) -> u8 {
        transition char_pos {
            0 -> (105)
            1 -> (50)
            2 -> (52)
            3 -> (98)
            4 -> (101)
            _ -> (0)
        }
    }
    state byte_arm(this: &PluginRegistry, index: u64, char_pos: u64) -> u8 {
        transition index {
            0 -> i_arm(this, char_pos)
            1 -> i_thumb(this, char_pos)
            2 -> i_arm64(this, char_pos)
            _ -> (0)
        }
    }
    state i_arm(this: &PluginRegistry, char_pos: u64) -> u8 {
        transition char_pos {
            0 -> (105)
            1 -> (95)
            2 -> (97)
            3 -> (114)
            4 -> (109)
            _ -> (0)
        }
    }
    state i_thumb(this: &PluginRegistry, char_pos: u64) -> u8 {
        transition char_pos {
            0 -> (105)
            1 -> (95)
            2 -> (116)
            3 -> (104)
            4 -> (117)
            5 -> (109)
            6 -> (98)
            _ -> (0)
        }
    }
    state i_arm64(this: &PluginRegistry, char_pos: u64) -> u8 {
        transition char_pos {
            0 -> (105)
            1 -> (95)
            2 -> (97)
            3 -> (114)
            4 -> (109)
            5 -> (54)
            6 -> (52)
            _ -> (0)
        }
    }
    state byte_powerpc(this: &PluginRegistry, index: u64, char_pos: u64) -> u8 {
        transition index {
            0 -> i_ppc32be(this, char_pos)
            _ -> (0)
        }
    }
    state i_ppc32be(this: &PluginRegistry, char_pos: u64) -> u8 {
        transition char_pos {
            0 -> (105)
            1 -> (95)
            2 -> (112)
            3 -> (112)
            4 -> (99)
            5 -> (51)
            6 -> (50)
            7 -> (98)
            8 -> (101)
            _ -> (0)
        }
    }
    state byte_x86(this: &PluginRegistry, index: u64, char_pos: u64) -> u8 {
        transition index {
            0 -> i_x86(this, char_pos)
            1 -> i_x64(this, char_pos)
            _ -> (0)
        }
    }
    state i_x86(this: &PluginRegistry, char_pos: u64) -> u8 {
        transition char_pos {
            0 -> (105)
            1 -> (95)
            2 -> (120)
            3 -> (56)
            4 -> (54)
            _ -> (0)
        }
    }
    state i_x64(this: &PluginRegistry, char_pos: u64) -> u8 {
        transition char_pos {
            0 -> (105)
            1 -> (95)
            2 -> (120)
            3 -> (54)
            4 -> (52)
            _ -> (0)
        }
    }
}

// Writes the contributed id at `data_type_count` — the shared insert for
// the seed walk and `set_plugin_order`'s ownership rebuild.
machine PluginRegistry::store_contributed_id(this: &mut PluginRegistry, position: u64, index: u64)
    requires position < 8 && index < 16 && this.data_type_count < 16
{
    let id_len: u64 = PluginRegistry::contributed_data_type_len(&this, position, index);
    this.data_type_id_lens[this.data_type_count] = id_len;
    this.data_type_plugin_positions[this.data_type_count] = position;
    transition { _ -> copy_bytes(this, position, index, this.data_type_count, id_len, 0) }
    state copy_bytes(this: &mut PluginRegistry, position: u64, index: u64, slot: u64, id_len: u64, char_pos: u64)
        requires position < 8 && index < 16 && slot < 16
    {
        transition char_pos < id_len && char_pos < 64 {
            true -> write_byte(this, position, index, slot, id_len, char_pos)
            _ -> bump(this)
        }
    }
    state write_byte(this: &mut PluginRegistry, position: u64, index: u64, slot: u64, id_len: u64, char_pos: u64)
        requires position < 8 && index < 16 && slot < 16 && char_pos < 64 && char_pos < id_len
    {
        let byte: u8 = PluginRegistry::contributed_data_type_byte(&this, position, index, char_pos);
        this.data_type_ids[slot][char_pos] = byte;
        transition {
            _ -> copy_bytes(this, position, index, slot, id_len, ((char_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state bump(this: &mut PluginRegistry) {
        this.data_type_count = ((this.data_type_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    }
}

// `entry(id).or_insert(owner)` — the dedup probe for a contributed id:
// walks the pair table comparing len + bytes via the value accessors.
machine PluginRegistry::contributed_id_matches_slot(this: &PluginRegistry, position: u64, index: u64, pair: u64) -> bool
    requires position < 8 && index < 16 && pair < 16
{
    let id_len: u64 = PluginRegistry::contributed_data_type_len(&this, position, index);
    transition id_len == this.data_type_id_lens[pair] {
        true -> scan(this, position, index, pair, 0)
        _ -> (false)
    }
    state scan(this: &PluginRegistry, position: u64, index: u64, pair: u64, char_pos: u64) -> bool
        requires position < 8 && index < 16 && pair < 16
    {
        transition char_pos < this.data_type_id_lens[pair] && char_pos < 64 && position < 8 && index < 16 && pair < 16 {
            true -> compare(this, position, index, pair, char_pos)
            _ -> (true)
        }
    }
    state compare(this: &PluginRegistry, position: u64, index: u64, pair: u64, char_pos: u64) -> bool
        requires position < 8 && index < 16 && pair < 16 && char_pos < 64
    {
        let byte: u8 = PluginRegistry::contributed_data_type_byte(&this, position, index, char_pos);
        transition byte == this.data_type_ids[pair][char_pos] {
            true -> scan(this, position, index, pair, ((char_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

machine PluginRegistry::find_contributed_position(this: &PluginRegistry, position: u64, index: u64) -> u64 {
    transition { _ -> scan(this, position, index, 0) }
    state scan(this: &PluginRegistry, position: u64, index: u64, pair: u64) -> u64 {
        transition pair < this.data_type_count && pair < 16 && position < 8 && index < 16 {
            true -> probe(this, position, index, pair)
            _ -> (this.data_type_count)
        }
    }
    state probe(this: &PluginRegistry, position: u64, index: u64, pair: u64) -> u64
        requires position < 8 && index < 16 && pair < 16
    {
        let hoist2: bool = PluginRegistry::contributed_id_matches_slot(&this, position, index, pair);
        transition hoist2 {
            true -> (pair)
            _ -> scan(this, position, index, ((pair as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// `plugin_packages.iter().find(|p| p.metadata().get_plugin_id() == id)` —
// returns the seed position or `plugin_count` as the none-found sentinel.
machine PluginRegistry::find_plugin_position(this: &PluginRegistry, plugin_id: &[u8]) -> u64 {
    transition { _ -> scan(this, plugin_id, 0) }
    state scan(this: &PluginRegistry, plugin_id: &[u8], position: u64) -> u64 {
        transition position < this.plugin_count && position < 8 {
            true -> probe(this, plugin_id, position)
            _ -> (this.plugin_count)
        }
    }
    state probe(this: &PluginRegistry, plugin_id: &[u8], position: u64) -> u64
        requires position < 8
    {
        let hoist3: bool = spans_equal(PluginMetadata::get_plugin_id(&this.plugins[position]), plugin_id);
        transition hoist3 {
            true -> (position)
            _ -> scan(this, plugin_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

machine spans_equal(left: &[u8], right: &[u8]) -> bool {
    transition left.len == right.len {
        true -> scan(left, right, 0)
        _ -> (false)
    }
    state scan(left: &[u8], right: &[u8], position: u64) -> bool {
        transition position < left.len && position < right.len {
            true -> compare(left, right, position)
            _ -> (true)
        }
    }
    state compare(left: &[u8], right: &[u8], position: u64) -> bool
        requires position < left.len && position < right.len
    {
        transition left[position] == right[position] {
            true -> scan(left, right, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

machine data_type_span_equal(left: &[u8; 64], left_len: u64, right: &[u8]) -> bool {
    transition left_len == right.len && left_len < 65 {
        true -> scan(left, right, 0)
        _ -> (false)
    }
    state scan(left: &[u8; 64], right: &[u8], position: u64) -> bool {
        transition position < right.len && position < 64 {
            true -> compare(left, right, position)
            _ -> (true)
        }
    }
    state compare(left: &[u8; 64], right: &[u8], position: u64) -> bool
        requires position < 64
    {
        transition left[position] == right[position] {
            true -> scan(left, right, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// `enabled_plugin_ids.contains` — false on an unknown id.
pub machine PluginRegistry::is_plugin_enabled(this: &PluginRegistry, plugin_id: &[u8]) -> bool {
    let position: u64 = PluginRegistry::find_plugin_position(&this, plugin_id);
    transition position < this.plugin_count && position < 8 {
        true -> read(this, position)
        _ -> (false)
    }
    state read(this: &PluginRegistry, position: u64) -> bool
        requires position < 8
    {
        (this.is_enabled[position])
    }
}

// `set_plugin_enabled` — false when the id names no seed package.
pub machine PluginRegistry::set_plugin_enabled(this: &mut PluginRegistry, plugin_id: &[u8], is_enabled: bool) -> bool {
    let position: u64 = PluginRegistry::find_plugin_position(&this, plugin_id);
    transition position < this.plugin_count && position < 8 {
        true -> store(this, position, is_enabled)
        _ -> (false)
    }
    state store(this: &mut PluginRegistry, position: u64, is_enabled: bool) -> bool
        requires position < 8
    {
        this.is_enabled[position] = is_enabled;
        (true)
    }
}

// `get_plugin_order()` slot — the position occupying `ordinal`.
pub machine PluginRegistry::get_ordered_plugin_position(this: &PluginRegistry, ordinal: u64) -> u64
    requires ordinal < 8
{
    this.plugin_order[ordinal]
}

pub machine PluginRegistry::get_plugin_count(this: &PluginRegistry) -> u64 {
    this.plugin_count
}

pub machine PluginRegistry::get_plugin_order_count(this: &PluginRegistry) -> u64 {
    this.plugin_order_count
}

// `build_plugin_state` — metadata + enabled flag; activation is `Idle`
// headless (see the file header — upstream resolves it through live
// plugin instances that do not exist here).
pub machine PluginRegistry::get_plugin_state_at(this: &PluginRegistry, position: u64) -> PluginState
    requires position < 8
{
    (PluginState::new(PluginMetadata::clone(&this.plugins[position]), this.is_enabled[position], PluginActivationState::Idle))
}

// `get_default_plugin_ids` — every seeded package id in registration
// order (upstream returns plugin_packages order).
pub machine PluginRegistry::get_default_plugin_id_at(this: &PluginRegistry, position: u64) -> PluginId
    requires position < 8
{
    (PluginId::new(PluginMetadata::get_plugin_id(&this.plugins[position])))
}

// `has_plugin_capability` — the package's capability set contains().
pub machine PluginRegistry::has_plugin_capability(this: &PluginRegistry, plugin_id: &[u8], capability: PluginCapability) -> bool {
    let position: u64 = PluginRegistry::find_plugin_position(&this, plugin_id);
    transition position < this.plugin_count && position < 8 {
        true -> read(this, position, capability)
        _ -> (false)
    }
    state read(this: &PluginRegistry, position: u64, capability: PluginCapability) -> bool
        requires position < 8
    {
        let hoist10: bool = PluginMetadata::has_plugin_capability(&this.plugins[position], capability);
        (hoist10)
    }
}

// `has_plugin_permission` — same lookup on the permission set.
pub machine PluginRegistry::has_plugin_permission(this: &PluginRegistry, plugin_id: &[u8], permission: PluginPermission) -> bool {
    let position: u64 = PluginRegistry::find_plugin_position(&this, plugin_id);
    transition position < this.plugin_count && position < 8 {
        true -> read(this, position, permission)
        _ -> (false)
    }
    state read(this: &PluginRegistry, position: u64, permission: PluginPermission) -> bool
        requires position < 8
    {
        let hoist11: bool = PluginMetadata::has_plugin_permission(&this.plugins[position], permission);
        (hoist11)
    }
}

// `is_data_type_enabled` — unowned data type ids report enabled
// (upstream returns true on the None arm); owned ids defer to the owner
// plugin's enabled flag.
pub machine PluginRegistry::is_data_type_enabled(this: &PluginRegistry, data_type_id: &[u8]) -> bool {
    let pair_position: u64 = PluginRegistry::find_data_type_position(&this, data_type_id);
    transition pair_position < this.data_type_count && pair_position < 16 {
        true -> owner(this, pair_position)
        _ -> (true)
    }
    state owner(this: &PluginRegistry, pair_position: u64) -> bool
        requires pair_position < 16
    {
        let plugin_position: u64 = this.data_type_plugin_positions[pair_position];
        transition plugin_position < 8 {
            true -> read_flag(this, plugin_position)
            _ -> (true)
        }
    }
    state read_flag(this: &PluginRegistry, plugin_position: u64) -> bool
        requires plugin_position < 8
    {
        (this.is_enabled[plugin_position])
    }
}

// Map slot for a contributed data type id, `data_type_count` sentinel.
machine PluginRegistry::find_data_type_position(this: &PluginRegistry, data_type_id: &[u8]) -> u64 {
    transition { _ -> scan(this, data_type_id, 0) }
    state scan(this: &PluginRegistry, data_type_id: &[u8], pair_position: u64) -> u64 {
        transition pair_position < this.data_type_count && pair_position < 16 {
            true -> probe(this, data_type_id, pair_position)
            _ -> (this.data_type_count)
        }
    }
    state probe(this: &PluginRegistry, data_type_id: &[u8], pair_position: u64) -> u64
        requires pair_position < 16
    {
        let hoist4: bool = data_type_span_equal(&this.data_type_ids[pair_position], this.data_type_id_lens[pair_position], data_type_id);
        transition hoist4 {
            true -> (pair_position)
            _ -> scan(this, data_type_id, ((pair_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// Scratch for `normalize_plugin_order` — the new order builds here before
// the no-change comparison; a record (not a bare local) so the `&mut`
// param shape matches the collection-walk precedent.
data PluginOrderScratch {
    order: [u64; 8];
    count: u64;
}

// `set_plugin_order` — `normalize_plugin_order` (known unduplicated ids
// first, missing ids appended in registration order), a no-change early
// return, then the order store + ownership rebuild. Returns `did_update`.
// Takes the request record so `get_plugin_id` carries the id bound.
pub machine PluginRegistry::set_plugin_order(this: &mut PluginRegistry, request: &PluginSetOrderRequest) -> bool {
    let mut scratch: PluginOrderScratch = PluginOrderScratch {
        count: 0,
    };
    transition { _ -> normalize(this, request, &mut scratch, 0) }

    state normalize(this: &mut PluginRegistry, request: &PluginSetOrderRequest, scratch: &mut PluginOrderScratch, index: u64) -> bool {
        let hoist5: u64 = PluginSetOrderRequest::get_plugin_id_count(&request);
        transition index < hoist5 && index < 64 && scratch.count < 8 {
            true -> accept(this, request, scratch, index)
            _ -> fill_missing(this, scratch, 0)
        }
    }

    state accept(this: &mut PluginRegistry, request: &PluginSetOrderRequest, scratch: &mut PluginOrderScratch, index: u64) -> bool
        requires index < 64
    {
        let plugin_id: &PluginId = PluginSetOrderRequest::get_plugin_id(&request, index);
        let id_bytes: &[u8] = get_plugin_id(plugin_id);
        let position: u64 = PluginRegistry::find_plugin_position(&this, id_bytes);
        transition position < this.plugin_count && position < 8 {
            true -> maybe_push(this, request, scratch, index, position)
            _ -> skip(this, request, scratch, index)
        }
    }

    state maybe_push(this: &mut PluginRegistry, request: &PluginSetOrderRequest, scratch: &mut PluginOrderScratch, index: u64, position: u64) -> bool
        requires index < 64 && position < 8
    {
        let hoist6: bool = PluginRegistry::order_contains(&this, scratch, position);
        transition hoist6 {
            true -> skip(this, request, scratch, index)
            _ -> push(this, request, scratch, index, position)
        }
    }

    state push(this: &mut PluginRegistry, request: &PluginSetOrderRequest, scratch: &mut PluginOrderScratch, index: u64, position: u64) -> bool
        requires index < 64 && position < 8
    {
        let count: u64 = scratch.count;
        transition count < 8 {
            true -> store_at(this, request, scratch, index, position, count)
            _ -> skip(this, request, scratch, index)
        }
    }

    state store_at(this: &mut PluginRegistry, request: &PluginSetOrderRequest, scratch: &mut PluginOrderScratch, index: u64, position: u64, count: u64) -> bool
        requires index < 64 && position < 8 && count < 8
    {
        scratch.order[count] = position;
        scratch.count = ((count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> skip(this, request, scratch, index) }
    }

    state skip(this: &mut PluginRegistry, request: &PluginSetOrderRequest, scratch: &mut PluginOrderScratch, index: u64) -> bool
        requires index < 64
    {
        let next_index: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next_index < 64 {
            true -> normalize(this, request, scratch, next_index)
            _ -> fill_missing(this, scratch, 0)
        }
    }

    state fill_missing(this: &mut PluginRegistry, scratch: &mut PluginOrderScratch, position: u64) -> bool {
        transition position < this.plugin_count && position < 8 {
            true -> maybe_push_missing(this, scratch, position)
            _ -> changed(this, scratch)
        }
    }

    state maybe_push_missing(this: &mut PluginRegistry, scratch: &mut PluginOrderScratch, position: u64) -> bool
        requires position < 8
    {
        let hoist7: bool = PluginRegistry::order_contains(&this, scratch, position);
        transition hoist7 {
            true -> advance_missing(this, scratch, position)
            _ -> push_missing(this, scratch, position)
        }
    }

    state push_missing(this: &mut PluginRegistry, scratch: &mut PluginOrderScratch, position: u64) -> bool
        requires position < 8
    {
        let count: u64 = scratch.count;
        transition count < 8 {
            true -> store_missing(this, scratch, position, count)
            _ -> advance_missing(this, scratch, position)
        }
    }

    state store_missing(this: &mut PluginRegistry, scratch: &mut PluginOrderScratch, position: u64, count: u64) -> bool
        requires position < 8 && count < 8
    {
        scratch.order[count] = position;
        scratch.count = ((count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> advance_missing(this, scratch, position) }
    }

    state advance_missing(this: &mut PluginRegistry, scratch: &mut PluginOrderScratch, position: u64) -> bool
        requires position < 8
    {
        let next_position: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next_position < 16 {
            true -> fill_missing(this, scratch, next_position)
            _ -> changed(this, scratch)
        }
    }

    // `*plugin_order == normalized` -> false (upstream's no-op early return).
    state changed(this: &mut PluginRegistry, scratch: &mut PluginOrderScratch) -> bool {
        let hoist8: bool = PluginRegistry::orders_equal(&this, scratch);
        transition scratch.count == this.plugin_order_count && hoist8 {
            true -> (false)
            _ -> commit(this, scratch)
        }
    }

    state commit(this: &mut PluginRegistry, scratch: &mut PluginOrderScratch) -> bool {
        transition { _ -> copy_order(this, scratch, 0) }
    }

    state copy_order(this: &mut PluginRegistry, scratch: &mut PluginOrderScratch, index: u64) -> bool {
        transition index < scratch.count && index < 8 {
            true -> store_order(this, scratch, index)
            _ -> finish_order(this, scratch)
        }
    }

    state store_order(this: &mut PluginRegistry, scratch: &mut PluginOrderScratch, index: u64) -> bool
        requires index < 8
    {
        this.plugin_order[index] = scratch.order[index];
        transition {
            _ -> copy_order(this, scratch, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    state finish_order(this: &mut PluginRegistry, scratch: &mut PluginOrderScratch) -> bool {
        this.plugin_order_count = scratch.count;
        transition { _ -> rebuild(this) }
    }

    // `*data_type_plugin_ids_by_data_type_id = ScanConstraintBuilder::build(&ordered_packages)` —
    // ordered positions first, first-wins per id.
    state rebuild(this: &mut PluginRegistry) -> bool {
        this.data_type_count = 0;
        transition { _ -> rebuild_order(this, 0, 0) }
    }

    state rebuild_order(this: &mut PluginRegistry, ordinal: u64, index: u64) -> bool {
        transition ordinal < this.plugin_order_count && ordinal < 8 {
            true -> rebuild_entry(this, ordinal, index)
            _ -> (true)
        }
    }

    state rebuild_entry(this: &mut PluginRegistry, ordinal: u64, index: u64) -> bool
        requires ordinal < 8 && index < 16
    {
        let position: u64 = this.plugin_order[ordinal];
        transition position < 8 {
            true -> rebuild_check(this, ordinal, position, index)
            _ -> rebuild_advance(this, ordinal)
        }
    }

    state rebuild_check(this: &mut PluginRegistry, ordinal: u64, position: u64, index: u64) -> bool
        requires ordinal < 8 && position < 8 && index < 16
    {
        let hoist9: u64 = PluginRegistry::contributed_data_type_count(&this, position);
        transition index < hoist9 {
            true -> rebuild_insert(this, ordinal, position, index)
            _ -> rebuild_advance(this, ordinal)
        }
    }

    state rebuild_insert(this: &mut PluginRegistry, ordinal: u64, position: u64, index: u64) -> bool
        requires ordinal < 8 && position < 8 && index < 16
    {
        let existing: u64 = PluginRegistry::find_contributed_position(&this, position, index);
        transition existing < this.data_type_count && existing < 16 {
            true -> rebuild_next_index(this, ordinal, position, index)
            _ -> rebuild_slot(this, ordinal, position, index)
        }
    }

    state rebuild_slot(this: &mut PluginRegistry, ordinal: u64, position: u64, index: u64) -> bool
        requires ordinal < 8 && position < 8 && index < 16
    {
        transition this.data_type_count < 16 {
            true -> rebuild_store(this, ordinal, position, index)
            _ -> (true)
        }
    }

    state rebuild_store(this: &mut PluginRegistry, ordinal: u64, position: u64, index: u64) -> bool
        requires ordinal < 8 && position < 8 && index < 16
    {
        transition this.data_type_count < 16 {
            true -> rebuild_commit(this, ordinal, position, index)
            _ -> rebuild_next_index(this, ordinal, position, index)
        }
    }

    state rebuild_commit(this: &mut PluginRegistry, ordinal: u64, position: u64, index: u64) -> bool
        requires ordinal < 8 && position < 8 && index < 16 && this.data_type_count < 16
    {
        PluginRegistry::store_contributed_id(&mut this, position, index);
        transition { _ -> rebuild_next_index(this, ordinal, position, index) }
    }

    state rebuild_next_index(this: &mut PluginRegistry, ordinal: u64, position: u64, index: u64) -> bool
        requires ordinal < 8 && position < 8 && index < 16
    {
        let next_index: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next_index < 16 {
            true -> rebuild_entry(this, ordinal, next_index)
            _ -> rebuild_advance(this, ordinal)
        }
    }

    state rebuild_advance(this: &mut PluginRegistry, ordinal: u64) -> bool
        requires ordinal < 8
    {
        let next_ordinal: u64 = ((ordinal as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next_ordinal < 16 {
            true -> rebuild_order(this, next_ordinal, 0)
            _ -> (true)
        }
    }
}

machine PluginRegistry::order_contains(this: &PluginRegistry, scratch: &PluginOrderScratch, position: u64) -> bool {
    transition { _ -> scan(this, scratch, position, 0) }
    state scan(this: &PluginRegistry, scratch: &PluginOrderScratch, position: u64, index: u64) -> bool {
        transition index < scratch.count && index < 8 {
            true -> compare(this, scratch, position, index)
            _ -> (false)
        }
    }
    state compare(this: &PluginRegistry, scratch: &PluginOrderScratch, position: u64, index: u64) -> bool
        requires index < 8
    {
        transition scratch.order[index] == position {
            true -> (true)
            _ -> scan(this, scratch, position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

machine PluginRegistry::orders_equal(this: &PluginRegistry, scratch: &PluginOrderScratch) -> bool {
    transition { _ -> scan(this, scratch, 0) }
    state scan(this: &PluginRegistry, scratch: &PluginOrderScratch, index: u64) -> bool {
        transition index < scratch.count && index < 8 {
            true -> compare(this, scratch, index)
            _ -> (true)
        }
    }
    state compare(this: &PluginRegistry, scratch: &PluginOrderScratch, index: u64) -> bool
        requires index < 8
    {
        transition this.plugin_order[index] == scratch.order[index] {
            true -> scan(this, scratch, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// Upstream `register_plugin_data_types` — materializes the
// DataTypeDescriptor for the contributed id at (position, index). The
// seed-leg's deferred plugin-host surface lands here as descriptor
// constants: every contributed type's fields are compile-time data on
// the package it ships with (24bit x4, arm x3, powerpc x1, x86 x2).
// Returns false for (position, index) pairs carrying no data type.
pub machine PluginRegistry::contributed_data_type_descriptor(this: &PluginRegistry, position: u64, index: u64, out_descriptor: &mut DataTypeDescriptor) -> bool {
    transition position {
        1 -> twenty_four_bit(this, index, out_descriptor)
        2 -> arm(this, index, out_descriptor)
        3 -> powerpc(this, index, out_descriptor)
        4 -> x86(this, index, out_descriptor)
        _ -> (false)
    }
    state twenty_four_bit(this: &PluginRegistry, index: u64, out_descriptor: &mut DataTypeDescriptor) -> bool {
        // u24 u24be i24 i24be — icon "u32", unit 3, [Binary Decimal
        // Hexadecimal], Decimal default; be arm big-endian, i* signed.
        transition index {
            0 -> fill(this, out_descriptor, "u24", 3, Endian::Little, false)
            1 -> fill(this, out_descriptor, "u24be", 3, Endian::Big, false)
            2 -> fill(this, out_descriptor, "i24", 3, Endian::Little, true)
            3 -> fill(this, out_descriptor, "i24be", 3, Endian::Big, true)
            _ -> (false)
        }
    }
    state fill(this: &PluginRegistry, out_descriptor: &mut DataTypeDescriptor, data_type_id: &[u8], unit_size_in_bytes: u64, endian: Endian, is_signed: bool) -> bool {
        let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::new(
            data_type_id, "u32", unit_size_in_bytes, AnonymousValueStringFormat::Decimal, endian, false, is_signed);
        _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Binary);
        _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Decimal);
        _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Hexadecimal);
        DataTypeDescriptor::clone_from(&mut out_descriptor, &descriptor);
        (true)
    }
    state arm(this: &PluginRegistry, index: u64, out_descriptor: &mut DataTypeDescriptor) -> bool {
        // i_arm i_thumb i_arm64 — icon "cpu_instruction", unit 1,
        // [String Hexadecimal], String default, little-endian, unsigned.
        transition index {
            0 -> fill_instruction(this, out_descriptor, "i_arm", Endian::Little)
            1 -> fill_instruction(this, out_descriptor, "i_thumb", Endian::Little)
            2 -> fill_instruction(this, out_descriptor, "i_arm64", Endian::Little)
            _ -> (false)
        }
    }
    state powerpc(this: &PluginRegistry, index: u64, out_descriptor: &mut DataTypeDescriptor) -> bool {
        transition index {
            0 -> fill_instruction(this, out_descriptor, "i_ppc32be", Endian::Big)
            _ -> (false)
        }
    }
    state x86(this: &PluginRegistry, index: u64, out_descriptor: &mut DataTypeDescriptor) -> bool {
        transition index {
            0 -> fill_instruction(this, out_descriptor, "i_x86", Endian::Little)
            1 -> fill_instruction(this, out_descriptor, "i_x64", Endian::Little)
            _ -> (false)
        }
    }
    state fill_instruction(this: &PluginRegistry, out_descriptor: &mut DataTypeDescriptor, data_type_id: &[u8], endian: Endian) -> bool {
        let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::new(
            data_type_id, "cpu_instruction", 1, AnonymousValueStringFormat::String, endian, false, false);
        _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::String);
        _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Hexadecimal);
        DataTypeDescriptor::clone_from(&mut out_descriptor, &descriptor);
        (true)
    }
}
