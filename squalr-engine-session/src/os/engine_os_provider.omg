satisfies MemoryQueryProvider::open_page_bounds
reaches FilesystemHost
invokes FilesystemHost;
{
    self.memory_queryer.open_memory_page_bounds(process_info, mode_tag)
}

pub linux_x86_64 machine EngineOsProviders::next_page_bounds_region(
    &mut self,
    region: &mut normalized_region::NormalizedRegion
