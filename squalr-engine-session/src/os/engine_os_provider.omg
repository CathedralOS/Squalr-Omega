use squalr_engine_targets_native::src::memory_queryer::normalized_module::ResolvedModuleAddress;
use squalr_engine_targets_native::src::memory_queryer::memory_queryer::MemoryQueryer;
use squalr_engine_targets_native::src::memory_reader::linux::linux_memory_reader::LinuxMemoryReader;
use squalr_engine_targets_native::src::memory_writer::linux::linux_memory_writer::LinuxMemoryWriter;
use squalr_engine_targets_native::src::process::process_manager::ProcessManager;
use squalr_engine_targets_native::src::process_query::process_queryer::ProcessQuery;

// Port of os/engine_os_provider.rs — the session's provider holder. Upstream
// stores Arc<dyn Trait> trait objects; Omega's translation holds the concrete
// provider values and satisfies the same provider traits directly (the
// Default*Provider forwarding impls upstream wraps them in). The `Routed*`
// dispatch wrappers upstream layers on for test injection ride this item's
// probe only — the memory_view router itself is a later leg.
pub data EngineOsProviders {
    process_query: ProcessQuery;
    memory_queryer: MemoryQueryer;
    memory_reader: LinuxMemoryReader;
    memory_writer: LinuxMemoryWriter;
    process_manager: ProcessManager;
}

pub linux_x86_64 machine EngineOsProviders::open_process(
    &mut self,
    process_info: &ProcessInfo
) -> OpenedProcessResult
satisfies ProcessQueryProvider::open_process
reaches FilesystemHost
invokes FilesystemHost;
{
    self.process_query.open_process(process_info)
}

pub linux_x86_64 machine EngineOsProviders::close_process(
    &mut self,
    handle: u64
) -> ProcessQueryOutcome
satisfies ProcessQueryProvider::close_process
reaches FilesystemHost
invokes FilesystemHost;
{
    self.process_query.close_process(handle)
}

pub linux_x86_64 machine EngineOsProviders::is_process_alive(
    &mut self,
    process_id: u32
) -> ProcessAliveResult
satisfies ProcessQueryProvider::is_process_alive
reaches FilesystemHost
invokes FilesystemHost;
{
    self.process_manager.is_process_alive(process_id)
}

pub linux_x86_64 machine EngineOsProviders::get_processes(
    &mut self,
    options: ProcessQueryOptions,
    out: &mut [ProcessInfo]
) -> ProcessListOutcome
satisfies ProcessQueryProvider::get_processes
reaches FilesystemHost
invokes FilesystemHost;
{
    self.process_query.get_processes(options, &mut out)
}

pub linux_x86_64 machine EngineOsProviders::start_monitoring(
    &mut self,
    process_id: u32
) -> ProcessQueryOutcome
satisfies ProcessQueryProvider::start_monitoring
{
    self.process_query.start_monitoring(process_id)
}

pub linux_x86_64 machine EngineOsProviders::stop_monitoring(
    &mut self
) -> ProcessQueryOutcome
satisfies ProcessQueryProvider::stop_monitoring
{
    self.process_query.stop_monitoring()
}

pub linux_x86_64 machine EngineOsProviders::read_bytes(
    &mut self,
    process_info: &OpenedProcessInfo,
    address: u64,
    values: &mut [u8]
) -> MemoryReadResult
satisfies MemoryReadProvider::read_bytes
reaches FilesystemHost
invokes FilesystemHost;
{
    self.memory_reader.read_bytes(process_info, address, &mut values)
}

