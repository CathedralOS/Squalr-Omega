// Upstream DefaultMemoryQueryProvider also forwards the module surface
// (get_modules / address_to_module / resolve_module / resolve_module_-
// address); the session trait has no declared shapes for them yet, so the
// forwards ride as plain machines pending that declaration — the wiring
// itself is what this leg ports.
pub linux_x86_64 machine EngineOsProviders::open_modules(
    &mut self,
    process_info: &OpenedProcessInfo
) -> MemoryBoundsOpen
reaches FilesystemHost
invokes FilesystemHost;
{
    self.memory_queryer.open_modules(process_info)
}

pub linux_x86_64 machine EngineOsProviders::next_module(
    &mut self,
    module: &mut NormalizedModule
) -> ModuleStreamStep
{
    self.memory_queryer.next_module(&mut module)
}

pub linux_x86_64 machine EngineOsProviders::resolve_module(
    &mut self,
    process_info: &OpenedProcessInfo,
    identifier: &[u8]
) -> u64
reaches FilesystemHost
invokes FilesystemHost;
{
    self.memory_queryer.resolve_module(process_info, identifier)
}

pub linux_x86_64 machine EngineOsProviders::resolve_module_address(
    &mut self,
    process_info: &OpenedProcessInfo,
    identifier: &[u8],
    offset: u64
) -> ResolvedModuleAddress
reaches FilesystemHost
invokes FilesystemHost;
{
    self.memory_queryer.resolve_module_address(process_info, identifier, offset)
}

pub linux_x86_64 machine EngineOsProviders::address_to_module(
    &mut self,
    process_info: &OpenedProcessInfo,
    address: u64,
    module: &mut NormalizedModule
) -> AddressModuleResult
reaches FilesystemHost
invokes FilesystemHost;
{
    self.memory_queryer.address_to_module(process_info, address, &mut module)
}
