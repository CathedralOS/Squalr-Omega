pub linux_x86_64 machine EngineOsProviders::close_page_bounds(
    &mut self
)
satisfies MemoryQueryProvider::close_page_bounds
reaches FilesystemHost
invokes FilesystemHost;
{
    self.memory_queryer.close_memory_page_bounds()
}

pub linux_x86_64 machine EngineOsProviders::is_address_writable(
    &mut self,
    process_info: &OpenedProcessInfo,
