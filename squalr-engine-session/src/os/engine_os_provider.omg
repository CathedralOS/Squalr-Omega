    &mut self,
    process_info: &OpenedProcessInfo,
    address: u64,
    values: &[u8]
) -> MemoryWriteResult
satisfies MemoryWriteProvider::write_bytes
reaches FilesystemHost
invokes FilesystemHost;
{
    self.memory_writer.write_bytes(process_info, address, values)
}

