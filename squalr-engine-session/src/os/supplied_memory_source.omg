module src::os::supplied_memory_source;

use squalr_engine_api::src::structures::memory::normalized_region::NormalizedRegion;
use squalr_engine_api::src::structures::snapshots::element_window::ElementWindow;

// Sanctioned test adapter for the headless command leg: a fault-injected
// memory source standing in for the live process reader, in the spirit of
// upstream's test `MemoryViewInstance` implementations. The CLI leg has no
// real target to open, so the engine drives scans over the supplied regions;
// the native target leg swaps in the real reader unchanged downstream of the
// provider boundary. One supplied region is one mergeable page run —
// `get_memory_page_bounds` reports each region as one page so the engine's
// merge keeps upstream's shape.
pub data SuppliedRegion {
    base_address: u64;
    elements: ElementWindow;
    element_stride_bytes: u64;
    // Upstream unreadable-page analog: the page is still declared in
    // `get_page_bounds` (it is mapped), but every read over it fails —
    // `read_bytes` returning false on a deallocated or guarded page.
    is_readable: bool;
}

pub data SuppliedMemorySource {
    // NATIVE-LOWERING DEVIATION: 4 regions, not upstream-growable headroom —
    // the native backend rejects structural types over 8192 slots and one
    // region is a full element window (~1027 slots), so 16 regions cannot
    // lower. Named toolchain gap (tools/native_probe_resume.md).
    regions: [SuppliedRegion; 4];
    region_count: u64;
}

pub machine SuppliedRegion::new(
    base_address: u64,
    elements: &ElementWindow,
    element_stride_bytes: u64
) -> SuppliedRegion {
    SuppliedRegion {
        base_address: base_address,
        elements: ElementWindow::clone(elements),
        element_stride_bytes: element_stride_bytes,
        is_readable: true,
    }
}

// Fault-injection surface for the partial-read leg: mark a region unreadable
// so `try_read_window` fails over it while `get_page_bounds` keeps reporting
// its page (upstream: mapped but unreadable).
pub machine SuppliedRegion::set_readable(&mut self, readable: bool) {
    self.is_readable = readable;
}

pub machine SuppliedRegion::get_base_address(&self) -> u64 {
    self.base_address
}

// Owned-window variant of `new` for construction sites that cannot form a
// borrow (the fixture path's entry-closure admissibility).
pub machine SuppliedRegion::of_window(
    base_address: u64,
    elements: ElementWindow,
    element_stride_bytes: u64
) -> SuppliedRegion {
    SuppliedRegion {
        base_address: base_address,
        elements: elements,
        element_stride_bytes: element_stride_bytes,
        is_readable: true,
    }
}

// The region's byte extent — upstream computes
// `current_values.len() * element_stride` worth of covered bytes.
pub machine SuppliedRegion::get_region_size(&self) -> u64 {
    ((self.elements.get_element_count() as u64 in Saturating)
        * (self.element_stride_bytes as u64 in Saturating)) as u64
}

pub machine SuppliedRegion::get_elements(&self) -> ElementWindow {
    ElementWindow::clone(&self.elements)
}

pub machine SuppliedMemorySource::empty() -> SuppliedMemorySource {
    SuppliedMemorySource { region_count: 0 }
}

// Single-region fixture source: record-literal construction, the only shape
// the entry-closure local-construction stage admits for aggregates.
pub machine SuppliedMemorySource::of_region(region: SuppliedRegion) -> SuppliedMemorySource {
    SuppliedMemorySource {
        regions: [
            region,
            SuppliedRegion { base_address: 0, elements: ElementWindow::empty(), element_stride_bytes: 0, is_readable: true },
            SuppliedRegion { base_address: 0, elements: ElementWindow::empty(), element_stride_bytes: 0, is_readable: true },
            SuppliedRegion { base_address: 0, elements: ElementWindow::empty(), element_stride_bytes: 0, is_readable: true }
        ],
        region_count: 1,
    }
}

pub machine SuppliedMemorySource::get_region_count(&self) -> u64 {
    self.region_count
}

// Fixture-side readability toggle — see `SuppliedRegion::set_readable`.
pub machine SuppliedMemorySource::set_region_readable(&mut self, position: u64, readable: bool) {
    transition position < self.region_count && position < 4 {
        true -> store(position, readable)
        false -> done()
        _ -> done()
    }
    state store(&mut self, position: u64, readable: bool) {
        self.regions[position].is_readable = readable;
        transition { _ -> done() }
    }
    state done(&mut self) {
    }
}

pub machine SuppliedRegion::clone_from(&mut self, source: &SuppliedRegion) {
    self.base_address = source.base_address;
    self.elements.clone_from(&source.elements);
    self.element_stride_bytes = source.element_stride_bytes;
    self.is_readable = source.is_readable;
}

pub machine SuppliedRegion::clone(source: &SuppliedRegion) -> SuppliedRegion {
    SuppliedRegion {
        base_address: source.base_address,
        elements: ElementWindow::clone(&source.elements),
        element_stride_bytes: source.element_stride_bytes,
        is_readable: source.is_readable,
    }
}

// Upstream `get_memory_page_bounds` over the supplied set — yields each
// region's normalized bounds one at a time through the cursor.
pub machine SuppliedMemorySource::get_page_bounds(
    &self,
    position: u64
) -> NormalizedRegion {
    transition position < self.region_count && position < 4 {
        true -> found(position)
        false -> (NormalizedRegion::new(0, 0))
    }
    state found(&self, position: u64 [0..4]) -> NormalizedRegion {
        NormalizedRegion::new(
            self.regions[position].get_base_address(),
            self.regions[position].get_region_size())
    }
}

// The collector's read of one snapshot region — upstream issues a byte
// read over `[base, base+size)`; the adapter answers by walking the supplied
// regions in order and concatenating the windows that overlap the range.
// Elements carry `element_stride_bytes`; the window bound truncates.
pub machine SuppliedMemorySource::read_window(
    &self,
    base_address: u64,
    size_in_bytes: u64
) -> ElementWindow {
    let mut window: ElementWindow = ElementWindow::empty();
    transition { _ -> each(&mut window, base_address, size_in_bytes, 0) }
    state each(&self, window: &mut ElementWindow, base_address: u64, size_in_bytes: u64, position: u64) {
        transition position < self.region_count && position < 4 {
            true -> overlap(window, base_address, size_in_bytes, position)
            false -> done(window)
        }
    }
    state overlap(&self, window: &mut ElementWindow, base_address: u64, size_in_bytes: u64, position: u64 [0..4]) {
        let region_base: u64 = self.regions[position].get_base_address();
        let region_end: u64 = ((region_base as u64 in Saturating)
            + (self.regions[position].get_region_size() as u64 in Saturating)) as u64;
        let read_end: u64 = ((base_address as u64 in Saturating)
            + (size_in_bytes as u64 in Saturating)) as u64;
        transition region_base < read_end && region_end > base_address && self.regions[position].is_readable {
            true -> append(window, base_address, size_in_bytes, position)
            false -> each(window, base_address, size_in_bytes, position + 1)
        }
    }
    state append(&self, window: &mut ElementWindow, base_address: u64, size_in_bytes: u64, position: u64 [0..4]) {
        let supplied: ElementWindow = self.regions[position].get_elements();
        transition { _ -> append_at(window, &supplied, base_address, size_in_bytes, 0, position) }
    }
    state append_at(&self, window: &mut ElementWindow, supplied: &ElementWindow, base_address: u64, size_in_bytes: u64, element_index: u64, position: u64 [0..4]) {
        transition element_index < supplied.get_element_count() {
            true -> push(window, supplied, base_address, size_in_bytes, element_index, position)
            false -> each(window, base_address, size_in_bytes, position + 1)
        }
    }
    state push(&self, window: &mut ElementWindow, supplied: &ElementWindow, base_address: u64, size_in_bytes: u64, element_index: u64, position: u64 [0..4]) {
        let value: u64 = supplied.get_element(element_index);
        let pushed: bool = window.push_element(value);
        transition { _ -> append_at(window, supplied, base_address, size_in_bytes, ((element_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, position) }
    }
    state done(&self, window: &mut ElementWindow) -> ElementWindow {
        (ElementWindow::clone(window))
    }
}

// Upstream `read_bytes(process_info, address, values) -> bool` surface:
// `succeeded` iff the OS call could fill the whole buffer — the adapter's
// analogue is full coverage of `[base, base+size)` by READABLE supplied
// regions. `window` carries the overlapping elements on success only.
pub data ReadWindowResult {
    succeeded: bool;
    window: ElementWindow;
}

// Upstream `read_process_memory` returning `bytes_read == len` — an
// all-or-nothing read: partial coverage is a failure, not a short read
// (the per-page fallback in the collector is what tolerates short spans).
pub machine SuppliedMemorySource::try_read_window(
    &self,
    base_address: u64,
    size_in_bytes: u64
) -> ReadWindowResult {
    let limit: u64 = ((base_address as u64 in Saturating)
        + (size_in_bytes as u64 in Saturating)) as u64;
    let covered: bool = self.covers_readable(base_address, limit, 0);
    transition covered {
        true -> fill(base_address, size_in_bytes)
        false -> (ReadWindowResult { succeeded: false, window: ElementWindow::empty() })
        _ -> (ReadWindowResult { succeeded: false, window: ElementWindow::empty() })
    }
    state fill(&self, base_address: u64, size_in_bytes: u64) -> ReadWindowResult {
        let window: ElementWindow = self.read_window(base_address, size_in_bytes);
        ReadWindowResult { succeeded: true, window: window }
    }
}

// Coverage walk for `try_read_window`: advance a cursor across the readable
// regions covering it — every gap or unreadable span fails the check,
// mirroring `process_vm_readv` failing on any unmapped page in the range.
// At most one hop per region.
machine SuppliedMemorySource::covers_readable(&self, cursor: u64, limit: u64, iteration: u64) -> bool {
    transition cursor >= limit || iteration >= 4 {
        true -> (cursor >= limit)
        false -> seek(cursor, limit, iteration, 0)
        _ -> seek(cursor, limit, iteration, 0)
    }
    state seek(&self, cursor: u64, limit: u64, iteration: u64, position: u64) -> bool {
        transition position < self.region_count && position < 4 {
            true -> probe(cursor, limit, iteration, position)
            false -> (false)
        }
    }
    state probe(&self, cursor: u64, limit: u64, iteration: u64, position: u64 [0..4]) -> bool {
        let region_base: u64 = self.regions[position].get_base_address();
        let region_end: u64 = ((region_base as u64 in Saturating)
            + (self.regions[position].get_region_size() as u64 in Saturating)) as u64;
        let readable: bool = self.regions[position].is_readable;
        transition readable && region_base <= cursor && cursor < region_end {
            true -> advance(cursor, limit, iteration, region_end)
            false -> seek(cursor, limit, iteration, position + 1)
            _ -> seek(cursor, limit, iteration, position + 1)
        }
    }
    // Recursion must be tail-only here (measured-recursion rule): the next
    // hop re-enters `seek` through a transition, not a nested value call.
    state advance(&self, cursor: u64, limit: u64, iteration: u64, region_end: u64) -> bool {
        transition region_end >= limit {
            true -> (true)
            false -> seek(region_end, limit, ((iteration as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, 0)
            _ -> seek(region_end, limit, ((iteration as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, 0)
        }
    }
}

// Best-effort live read for `scan-results list` display — the value at the
// element offset under `address`, or 0 when the address misses every
// supplied region (upstream logs the read failure and shows the default).
pub machine SuppliedMemorySource::read_u64(&self, address: u64) -> u64 {
    transition { _ -> each(address, 0) }
    state each(&self, address: u64, position: u64) -> u64 {
        transition position < self.region_count && position < 4 {
            true -> inside(address, position)
            false -> (0)
        }
    }
    state inside(&self, address: u64, position: u64 [0..4]) -> u64 {
        let base: u64 = self.regions[position].get_base_address();
        let size: u64 = self.regions[position].get_region_size();
        let stride: u64 = self.regions[position].element_stride_bytes;
        let limit: u64 = ((base as u64 in Saturating) + (size as u64 in Saturating)) as u64;
        transition address >= base && address < limit && stride > 0 && self.regions[position].is_readable {
            true -> at(address, position, base, stride)
            false -> each(address, position + 1)
        }
    }
    state at(&self, address: u64, position: u64 [0..4], base: u64, stride: u64) -> u64 {
        let element_index: u64 = (((address as u64 in Saturating) - (base as u64 in Saturating))
            / (stride as u64 in Saturating)) as u64;
        self.regions[position].elements.get_element(element_index)
    }
}

pub machine SuppliedMemorySource::clone_from(&mut self, source: &SuppliedMemorySource) {
    self.region_count = source.region_count;
    transition { _ -> copy(source, 0) }
    state copy(&mut self, source: &SuppliedMemorySource, position: u64) {
        transition position < source.region_count && position < 4 {
            true -> store(source, position)
            false -> done()
        }
    }
    state store(&mut self, source: &SuppliedMemorySource, position: u64 [0..4]) {
        self.regions[position].clone_from(&source.regions[position]);
        transition { _ -> copy(source, position + 1) }
    }
    state done(&mut self) {
        self.region_count = self.region_count;
    }
}
