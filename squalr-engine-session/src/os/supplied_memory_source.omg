module src::os::supplied_memory_source;

use squalr_engine_api::src::structures::memory::normalized_region::NormalizedRegion;
use squalr_engine_api::src::structures::snapshots::element_window::ElementWindow;

// Sanctioned test adapter for the headless command leg: a fault-injected
// memory source standing in for the live process reader, in the spirit of
// upstream's test `MemoryViewInstance` implementations. The CLI leg has no
// real target to open, so the engine drives scans over the supplied regions;
// the native target leg swaps in the real reader unchanged downstream of the
// provider boundary. One supplied region is one mergeable page run —
// `get_memory_page_bounds` reports each region as one page so the engine's
// merge keeps upstream's shape.
pub data SuppliedRegion {
    base_address: u64;
    elements: ElementWindow;
    element_stride_bytes: u64;
    // Upstream unreadable-page analog: the page is still declared in
    // `get_page_bounds` (it is mapped), but every read over it fails —
    // `read_bytes` returning false on a deallocated or guarded page.
    is_readable: bool;
}

pub data SuppliedMemorySource {
    // NATIVE-LOWERING DEVIATION: 4 regions, not upstream-growable headroom —
    // the native backend rejects structural types over 8192 slots and one
    // region is a full element window (~1027 slots), so 16 regions cannot
    // lower. Named toolchain gap (tools/native_probe_resume.md).
    regions: [SuppliedRegion; 4];
    region_count: u64;
}

pub machine SuppliedRegion::new(
    base_address: u64,
    elements: &ElementWindow,
    element_stride_bytes: u64
) -> SuppliedRegion {
    SuppliedRegion {
        base_address: base_address,
        elements: ElementWindow::clone(elements),
        element_stride_bytes: element_stride_bytes,
        is_readable: true,
    }
}

// Fault-injection surface for the partial-read leg: mark a region unreadable
// so `try_read_window` fails over it while `get_page_bounds` keeps reporting
// its page (upstream: mapped but unreadable).
pub machine SuppliedRegion::set_readable(this: &mut SuppliedRegion, readable: bool) {
    this.is_readable = readable;
}

pub machine SuppliedRegion::get_base_address(this: &SuppliedRegion) -> u64 {
    this.base_address
}

// Owned-window variant of `new` for construction sites that cannot form a
// borrow (the fixture path's entry-closure admissibility).
pub machine SuppliedRegion::of_window(
    base_address: u64,
    elements: ElementWindow,
    element_stride_bytes: u64
) -> SuppliedRegion {
    SuppliedRegion {
        base_address: base_address,
        elements: elements,
        element_stride_bytes: element_stride_bytes,
        is_readable: true,
    }
}

// The region's byte extent — upstream computes
// `current_values.len() * element_stride` worth of covered bytes.
pub machine SuppliedRegion::get_region_size(this: &SuppliedRegion) -> u64 {
    ((ElementWindow::get_element_count(&this.elements) as u64 in Saturating)
        * (this.element_stride_bytes as u64 in Saturating)) as u64
}

pub machine SuppliedRegion::get_elements(this: &SuppliedRegion) -> ElementWindow {
    ElementWindow::clone(&this.elements)
}

// Fixture-side counterpart — entry closures cannot descend below an
// array element into a nested record (`carrier path` wall), so seeds
// reach the element window through a flat setter.
pub machine SuppliedRegion::set_element_count(this: &mut SuppliedRegion, element_count: u64) {
    this.elements.element_count = element_count;
}

// Fixture seed: write one element value into the region's window (same
// carrier-path reasoning as set_element_count).
pub machine SuppliedRegion::set_element(this: &mut SuppliedRegion, element_index: u64, element_value: u64) {
    ElementWindow::set_element(&mut this.elements, element_index, element_value);
}

pub machine SuppliedMemorySource::empty() -> SuppliedMemorySource {
    SuppliedMemorySource { region_count: 0 }
}

// Single-region fixture source: record-literal construction, the only shape
// the entry-closure local-construction stage admits for aggregates.
pub machine SuppliedMemorySource::of_region(region: SuppliedRegion) -> SuppliedMemorySource {
    SuppliedMemorySource {
        regions: [
            region,
            SuppliedRegion { base_address: 0, elements: ElementWindow::empty(), element_stride_bytes: 0, is_readable: true },
            SuppliedRegion { base_address: 0, elements: ElementWindow::empty(), element_stride_bytes: 0, is_readable: true },
            SuppliedRegion { base_address: 0, elements: ElementWindow::empty(), element_stride_bytes: 0, is_readable: true }
        ],
        region_count: 1,
    }
}

pub machine SuppliedMemorySource::get_region_count(this: &SuppliedMemorySource) -> u64 {
    this.region_count
}

// Supplied-bytes scan adapter: install a caller-supplied byte span as the
// captured target's memory. One supplied byte lands per u64 element lane at
// stride 1 (the byte-array and u8-scanner element contract — wider units read
// elements at their own stride, the capture-stride binding documented on
// `read_current_elements`). The span chunks across the region bound
// (4 × 1024 elements = the 4096-byte request bound, contiguous bases so the
// snapshot builder merges them into one region with page-boundary
// tombstones). Bytes past the bound are not installed — the request's own
// 4096 bound makes that unreachable.
pub machine SuppliedMemorySource::of_bytes(
    base_address: u64,
    bytes: &[u8]
) -> SuppliedMemorySource {
    transition { _ -> region_each(SuppliedMemorySource::empty(), base_address, bytes, 0) }

    state region_each(
        source: SuppliedMemorySource,
        base_address: u64,
        bytes: &[u8],
        region_index: u64
    ) -> SuppliedMemorySource {
        let byte_offset: u64 = ((region_index as u64 in Saturating)
            * (1024 as u64 in Saturating)) as u64;
        transition region_index < 4 && byte_offset < bytes.len {
            true -> element_each(source, base_address, bytes, region_index, byte_offset, ElementWindow::empty(), 0)
            false -> (source)
            _ -> (source)
        }
    }

    state element_each(
        source: SuppliedMemorySource,
        base_address: u64,
        bytes: &[u8],
        region_index: u64,
        byte_offset: u64,
        window: ElementWindow,
        element_index: u64
    ) -> SuppliedMemorySource {
        let byte_index: u64 = ((byte_offset as u64 in Saturating)
            + (element_index as u64 in Saturating)) as u64;
        transition element_index < 1024 && byte_index < bytes.len {
            true -> element_store(source, base_address, bytes, region_index, byte_offset, window, element_index, byte_index)
            false -> region_store(source, base_address, bytes, region_index, byte_offset, window)
            _ -> region_store(source, base_address, bytes, region_index, byte_offset, window)
        }
    }

    state element_store(
        source: SuppliedMemorySource,
        base_address: u64,
        bytes: &[u8],
        region_index: u64,
        byte_offset: u64,
        window: ElementWindow,
        element_index: u64,
        byte_index: u64
    ) -> SuppliedMemorySource
        requires byte_index < bytes.len;
    {
        let mut carried: ElementWindow = window;
        let byte_value: u64 = bytes[byte_index] as u64;
        let pushed: bool = ElementWindow::push_element(&mut carried, byte_value);
        transition { _ -> element_each(
            source, base_address, bytes, region_index, byte_offset, carried,
            ((element_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state region_store(
        source: SuppliedMemorySource,
        base_address: u64,
        bytes: &[u8],
        region_index: u64,
        byte_offset: u64,
        window: ElementWindow
    ) -> SuppliedMemorySource {
        let mut carried: SuppliedMemorySource = source;
        transition region_index < 4 {
            true -> commit(carried, base_address, bytes, region_index, byte_offset, window)
            false -> (carried)
            _ -> (carried)
        }
    }

    state commit(
        carried: SuppliedMemorySource,
        base_address: u64,
        bytes: &[u8],
        region_index: u64,
        byte_offset: u64,
        window: ElementWindow
    ) -> SuppliedMemorySource
        requires 0 <= region_index && region_index < 4;
    {
        let region_base: u64 = ((base_address as u64 in Saturating)
            + (byte_offset as u64 in Saturating)) as u64;
        let mut stored: SuppliedMemorySource = carried;
        stored.regions[region_index] = SuppliedRegion::of_window(region_base, window, 1);
        stored.region_count = ((region_index as u64 in Wrapping)
            + (1 as u64 in Wrapping)) as u64;
        transition { _ -> region_each(
            stored, base_address, bytes,
            ((region_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Fixture-side readability toggle — see `SuppliedRegion::set_readable`.
pub machine SuppliedMemorySource::set_region_readable(this: &mut SuppliedMemorySource, position: u64, readable: bool) {
    transition position < this.region_count && position < 4 {
        true -> store(this, position, readable)
        false -> done(this)
        _ -> done(this)
    }
    state store(this: &mut SuppliedMemorySource, position: u64, readable: bool) {
        this.regions[position].is_readable = readable;
        transition { _ -> done(this) }
    }
    state done(this: &mut SuppliedMemorySource) {
    }
}

pub machine SuppliedRegion::clone_from(this: &mut SuppliedRegion, source: &SuppliedRegion) {
    this.base_address = source.base_address;
    ElementWindow::clone_from(&mut this.elements, &source.elements);
    this.element_stride_bytes = source.element_stride_bytes;
    this.is_readable = source.is_readable;
}

pub machine SuppliedRegion::clone(source: &SuppliedRegion) -> SuppliedRegion {
    SuppliedRegion {
        base_address: source.base_address,
        elements: ElementWindow::clone(&source.elements),
        element_stride_bytes: source.element_stride_bytes,
        is_readable: source.is_readable,
    }
}

// Upstream `get_memory_page_bounds` over the supplied set — yields each
// region's normalized bounds one at a time through the cursor.
pub machine SuppliedMemorySource::get_page_bounds(
    this: &SuppliedMemorySource,
    position: u64
) -> NormalizedRegion {
    transition position < this.region_count && position < 4 {
        true -> found(this, position)
        false -> (NormalizedRegion::new(0, 0))
    }
    state found(this: &SuppliedMemorySource, position: u64) -> NormalizedRegion
    requires 0 <= position && position < 4;
    {
        NormalizedRegion::new(
            SuppliedRegion::get_base_address(&this.regions[position]),
            SuppliedRegion::get_region_size(&this.regions[position]))
    }
}

// The collector's read of one snapshot region — upstream issues a byte
// read over `[base, base+size)`; the adapter answers by walking the supplied
// regions in order and concatenating the windows that overlap the range.
// Elements carry `element_stride_bytes`; the window bound truncates.
pub machine SuppliedMemorySource::read_window(
    this: &SuppliedMemorySource,
    base_address: u64,
    size_in_bytes: u64
) -> ElementWindow {
    let mut window: ElementWindow = ElementWindow::empty();
    transition { _ -> each(this, &mut window, base_address, size_in_bytes, 0) }
    state each(this: &SuppliedMemorySource, window: &mut ElementWindow, base_address: u64, size_in_bytes: u64, position: u64) {
        transition position < this.region_count && position < 4 {
            true -> overlap(this, window, base_address, size_in_bytes, position)
            false -> done(this, window)
        }
    }
    state overlap(this: &SuppliedMemorySource, window: &mut ElementWindow, base_address: u64, size_in_bytes: u64, position: u64)
    requires 0 <= position && position < 4;
    {
        let region_base: u64 = SuppliedRegion::get_base_address(&this.regions[position]);
        let region_end: u64 = ((region_base as u64 in Saturating)
            + (SuppliedRegion::get_region_size(&this.regions[position]) as u64 in Saturating)) as u64;
        let read_end: u64 = ((base_address as u64 in Saturating)
            + (size_in_bytes as u64 in Saturating)) as u64;
        transition region_base < read_end && region_end > base_address && this.regions[position].is_readable {
            true -> append(this, window, base_address, size_in_bytes, position)
            false -> each(this, window, base_address, size_in_bytes, position + 1)
        }
    }
    state append(this: &SuppliedMemorySource, window: &mut ElementWindow, base_address: u64, size_in_bytes: u64, position: u64)
    requires 0 <= position && position < 4;
    {
        let supplied: ElementWindow = SuppliedRegion::get_elements(&this.regions[position]);
        transition { _ -> append_at(this, window, &supplied, base_address, size_in_bytes, 0, position) }
    }
    state append_at(this: &SuppliedMemorySource, window: &mut ElementWindow, supplied: &ElementWindow, base_address: u64, size_in_bytes: u64, element_index: u64, position: u64)
    requires 0 <= position && position < 4;
    {
        let hoist1: u64 = ElementWindow::get_element_count(&supplied);
        transition element_index < hoist1 {
            true -> push(this, window, supplied, base_address, size_in_bytes, element_index, position)
            false -> each(this, window, base_address, size_in_bytes, position + 1)
        }
    }
    state push(this: &SuppliedMemorySource, window: &mut ElementWindow, supplied: &ElementWindow, base_address: u64, size_in_bytes: u64, element_index: u64, position: u64)
    requires 0 <= position && position < 4;
    {
        let value: u64 = ElementWindow::get_element(&supplied, element_index);
        let pushed: bool = ElementWindow::push_element(&mut window, value);
        transition { _ -> append_at(this, window, supplied, base_address, size_in_bytes, ((element_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, position) }
    }
    state done(this: &SuppliedMemorySource, window: &mut ElementWindow) -> ElementWindow {
        (ElementWindow::clone(&mut window))
    }
}

// Upstream `read_bytes(process_info, address, values) -> bool` surface:
// `succeeded` iff the OS call could fill the whole buffer — the adapter's
// analogue is full coverage of `[base, base+size)` by READABLE supplied
// regions. `window` carries the overlapping elements on success only.
pub data ReadWindowResult {
    succeeded: bool;
    window: ElementWindow;
}

// Upstream `read_process_memory` returning `bytes_read == len` — an
// all-or-nothing read: partial coverage is a failure, not a short read
// (the per-page fallback in the collector is what tolerates short spans).
pub machine SuppliedMemorySource::try_read_window(
    this: &SuppliedMemorySource,
    base_address: u64,
    size_in_bytes: u64
) -> ReadWindowResult {
    let limit: u64 = ((base_address as u64 in Saturating)
        + (size_in_bytes as u64 in Saturating)) as u64;
    let covered: bool = SuppliedMemorySource::covers_readable(&this, base_address, limit, 0);
    transition covered {
        true -> fill(this, base_address, size_in_bytes)
        _ -> (ReadWindowResult { succeeded: false, window: ElementWindow::empty() })
    }
    state fill(this: &SuppliedMemorySource, base_address: u64, size_in_bytes: u64) -> ReadWindowResult {
        let window: ElementWindow = SuppliedMemorySource::read_window(&this, base_address, size_in_bytes);
        ReadWindowResult { succeeded: true, window: window }
    }
}

// Coverage walk for `try_read_window`: advance a cursor across the readable
// regions covering it — every gap or unreadable span fails the check,
// mirroring `process_vm_readv` failing on any unmapped page in the range.
// At most one hop per region.
machine SuppliedMemorySource::covers_readable(this: &SuppliedMemorySource, cursor: u64, limit: u64, iteration: u64) -> bool {
    transition cursor >= limit || iteration >= 4 {
        true -> (cursor >= limit)
        false -> seek(this, cursor, limit, iteration, 0)
        _ -> seek(this, cursor, limit, iteration, 0)
    }
    state seek(this: &SuppliedMemorySource, cursor: u64, limit: u64, iteration: u64, position: u64) -> bool {
        transition position < this.region_count && position < 4 {
            true -> probe(this, cursor, limit, iteration, position)
            false -> (false)
        }
    }
    state probe(this: &SuppliedMemorySource, cursor: u64, limit: u64, iteration: u64, position: u64) -> bool
    requires 0 <= position && position < 4;
    {
        let region_base: u64 = SuppliedRegion::get_base_address(&this.regions[position]);
        let region_end: u64 = ((region_base as u64 in Saturating)
            + (SuppliedRegion::get_region_size(&this.regions[position]) as u64 in Saturating)) as u64;
        let readable: bool = this.regions[position].is_readable;
        transition readable && region_base <= cursor && cursor < region_end {
            true -> advance(this, cursor, limit, iteration, region_end)
            false -> seek(this, cursor, limit, iteration, position + 1)
            _ -> seek(this, cursor, limit, iteration, position + 1)
        }
    }
    // Recursion must be tail-only here (measured-recursion rule): the next
    // hop re-enters `seek` through a transition, not a nested value call.
    state advance(this: &SuppliedMemorySource, cursor: u64, limit: u64, iteration: u64, region_end: u64) -> bool {
        transition region_end >= limit {
            true -> (true)
            false -> seek(this, region_end, limit, ((iteration as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, 0)
            _ -> seek(this, region_end, limit, ((iteration as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, 0)
        }
    }
}

// Upstream `write_bytes(process_info, address, bytes) -> bool` surface:
// `succeeded` iff the whole byte span is covered by mapped supplied
// regions — the adapter's `is_readable` flag is the mapped-ness proxy for
// writes too (fault injection marks the whole page, same as
// process_vm_writev failing on any unmapped page in the range). The write
// is one element-granular u64 store at the slot `address` maps to —
// byte-precise merges below element stride are outside the element-window
// storage model (named deviation, same bound as the read path).
pub machine SuppliedMemorySource::try_write_window(
    this: &mut SuppliedMemorySource,
    address: u64,
    byte_len: u64,
    value: u64
) -> bool {
    let limit: u64 = ((address as u64 in Saturating) + (byte_len as u64 in Saturating)) as u64;
    let covered: bool = SuppliedMemorySource::covers_readable(&this, address, limit, 0);
    transition covered {
        true -> write(this, address, value, 0)
        false -> (false)
        _ -> (false)
    }
    state write(this: &mut SuppliedMemorySource, address: u64, value: u64, position: u64) -> bool {
        transition position < this.region_count && position < 4 {
            true -> inside(this, address, value, position)
            false -> (false)
        }
    }
    state inside(this: &mut SuppliedMemorySource, address: u64, value: u64, position: u64) -> bool
    requires 0 <= position && position < 4;
    {
        let base: u64 = SuppliedRegion::get_base_address(&this.regions[position]);
        let size: u64 = SuppliedRegion::get_region_size(&this.regions[position]);
        let stride: u64 = this.regions[position].element_stride_bytes;
        let limit: u64 = ((base as u64 in Saturating) + (size as u64 in Saturating)) as u64;
        transition address >= base && address < limit && stride > 0 && this.regions[position].is_readable {
            true -> store(this, address, value, position, base, stride)
            false -> write(this, address, value, position + 1)
        }
    }
    state store(this: &mut SuppliedMemorySource, address: u64, value: u64, position: u64, base: u64, stride: u64) -> bool
    requires 0 <= position && position < 4;
    {
        let element_index: u64 = (((address as u64 in Saturating) - (base as u64 in Saturating))
            / (stride as u64 in Saturating)) as u64;
        ElementWindow::set_element(&mut this.regions[position].elements, element_index, value);
        true
    }
}

// Best-effort live read for `scan-results list` display — the value at the
// element offset under `address`, or 0 when the address misses every
// supplied region (upstream logs the read failure and shows the default).
pub machine SuppliedMemorySource::read_u64(this: &SuppliedMemorySource, address: u64) -> u64 {
    transition { _ -> each(this, address, 0) }
    state each(this: &SuppliedMemorySource, address: u64, position: u64) -> u64 {
        transition position < this.region_count && position < 4 {
            true -> inside(this, address, position)
            false -> (0)
        }
    }
    state inside(this: &SuppliedMemorySource, address: u64, position: u64) -> u64
    requires 0 <= position && position < 4;
    {
        let base: u64 = SuppliedRegion::get_base_address(&this.regions[position]);
        let size: u64 = SuppliedRegion::get_region_size(&this.regions[position]);
        let stride: u64 = this.regions[position].element_stride_bytes;
        let limit: u64 = ((base as u64 in Saturating) + (size as u64 in Saturating)) as u64;
        transition address >= base && address < limit && stride > 0 && this.regions[position].is_readable {
            true -> at(this, address, position, base, stride)
            false -> each(this, address, position + 1)
        }
    }
    state at(this: &SuppliedMemorySource, address: u64, position: u64, base: u64, stride: u64) -> u64
    requires 0 <= position && position < 4;
    {
        let element_index: u64 = (((address as u64 in Saturating) - (base as u64 in Saturating))
            / (stride as u64 in Saturating)) as u64;
        let hoist2: u64 = ElementWindow::get_element(&this.regions[position].elements, element_index);
        (hoist2)
    }
}

pub machine SuppliedMemorySource::clone_from(this: &mut SuppliedMemorySource, source: &SuppliedMemorySource) {
    this.region_count = source.region_count;
    transition { _ -> copy(this, source, 0) }
    state copy(this: &mut SuppliedMemorySource, source: &SuppliedMemorySource, position: u64) {
        transition position < source.region_count && position < 4 {
            true -> store(this, source, position)
            false -> done(this)
        }
    }
    state store(this: &mut SuppliedMemorySource, source: &SuppliedMemorySource, position: u64)
    requires 0 <= position && position < 4;
    {
        SuppliedRegion::clone_from(&mut this.regions[position], &source.regions[position]);
        transition { _ -> copy(this, source, position + 1) }
    }
    state done(this: &mut SuppliedMemorySource) {
        this.region_count = this.region_count;
    }
}
