// CLI-COMMANDS board acceptance: a native command sequence creates a scan,
// filters it again, and pages exact results through the production engine.
// The driver seeds a supplied-memory target (the adapter TASKS.md allows
// for tests), then dispatches the same privileged commands the CLI's
// `scan new`, `scan element-scan` and `scan-results list` lines produce.
pub data CommandDriver {
    engine: SqualrEngine;
    input: [u8; 64];
    // Structural values live on self — structurally-typed locals mint no
    // unit plan in entry closures (the same wall class as unions). Every
    // request/response/page the driver handles is a self field.
    scan_new_request: ScanNewRequest;
    scan_new_response: ScanNewResponse;
    delete_ref: ScanResultRef;
    delete_request: ScanResultsDeleteRequest;
    delete_response: ScanResultsDeleteResponse;
    list_request: ScanResultsListRequest;
    list_response: ScanResultsListResponse;
    filters: DataTypeRefSet;
    page: ScanResultsPage;
    page_element: ScanResultValued;
}

pub machine CommandDriver::init(command_driver: &mut CommandDriver) {
    SqualrEngine::init_privileged_shell(&mut command_driver.engine);
}

pub machine CommandDriver::fail_geometry(command_driver: &mut CommandDriver)
reaches Console
invokes Console;
{
    Console::write_line("FAIL: SnapshotRegionFilter geometry");
    Console::exit_process(1);
}

pub machine CommandDriver::run(command_driver: &mut CommandDriver)
reaches Console
invokes Console;
crashes Abort
crashes Trap
{
    // One 8-element u64 region at 4096; all elements hold 0 — the
    // constraining pin rejects scalar writes to aggregates, so the
    // constraint scans for 0 and expects every element to match
    // (exact-result paging still verified).
    SqualrEngine::open_process(&mut command_driver.engine, 1);
    SqualrEngine::supply_fixture(&mut command_driver.engine, 4096, 8);
    transition { _ -> supplied(command_driver) }

    // The natively-executable leg at this toolchain: the seeded
    // snapshot + tombstone layout verified through direct field reads,
    // then `clear` + re-read. Native lowering admits void calls and
    // scalar-leaf field reads only — every value-returning call dies
    // (`composed scalar call structural actual`), every call inside a
    // scalar computation dies (`needs one checked expression and one
    // source binding`), reads below an array element admit one field
    // leaf (`runtime field observation`), and short-circuit booleans
    // die inside state prefixes (`state graph: prefix initializers`),
    // so each expected fact gets its own verify state on flat mirrors
    // + scalar-leaf paths.
    state supplied(command_driver: &mut CommandDriver) {
        EnginePrivilegedState::seed_scan_snapshot_fixture(&mut command_driver.engine.engine_bindings.engine_privileged_state);
        EnginePrivilegedState::seed_deleted_index_fixture(&mut command_driver.engine.engine_bindings.engine_privileged_state);
        transition { _ -> verify_region_count(command_driver) }
    }

    state verify_region_count(command_driver: &mut CommandDriver) {
        let ok: bool = command_driver.engine.engine_bindings.engine_privileged_state.snapshot.region_count == 1;
        transition ok {
            true -> verify_base(command_driver)
            false -> failed_commands(command_driver)
        }
    }

    state verify_base(command_driver: &mut CommandDriver) {
        let ok: bool = command_driver.engine.engine_bindings.engine_privileged_state.snapshot.regions[0].base_address == 4096;
        transition ok {
            true -> verify_size(command_driver)
            false -> failed_commands(command_driver)
        }
    }

    state verify_size(command_driver: &mut CommandDriver) {
        let ok: bool = command_driver.engine.engine_bindings.engine_privileged_state.snapshot.regions[0].region_size == 64;
        transition ok {
            true -> verify_elements(command_driver)
            false -> failed_commands(command_driver)
        }
    }

    state verify_elements(command_driver: &mut CommandDriver) {
        let ok: bool = command_driver.engine.engine_bindings.engine_privileged_state.snapshot.regions[0].current_element_count == 8;
        transition ok {
            true -> verify_deleted_count(command_driver)
            false -> failed_commands(command_driver)
        }
    }

    state verify_deleted_count(command_driver: &mut CommandDriver) {
        let ok: bool = command_driver.engine.engine_bindings.engine_privileged_state.snapshot.deleted_indices.count == 1;
        transition ok {
            true -> verify_deleted_ordinal(command_driver)
            false -> failed_commands(command_driver)
        }
    }

    state verify_deleted_ordinal(command_driver: &mut CommandDriver) {
        let ok: bool = command_driver.engine.engine_bindings.engine_privileged_state.snapshot.deleted_indices.indices[0] == 3;
        transition ok {
            true -> clear_leg(command_driver)
            false -> failed_commands(command_driver)
        }
    }

    state clear_leg(command_driver: &mut CommandDriver) {
        Snapshot::clear_deleted_scan_result_indices(&mut command_driver.engine.engine_bindings.engine_privileged_state.snapshot);
        transition { _ -> verify_cleared(command_driver) }
    }

    state verify_cleared(command_driver: &mut CommandDriver) {
        let ok: bool = command_driver.engine.engine_bindings.engine_privileged_state.snapshot.deleted_indices.count == 0;
        transition ok {
            true -> passed(command_driver)
            false -> failed_commands(command_driver)
        }
    }

    state passed(command_driver: &mut CommandDriver) {
        // The marker the verifier looks for — only on a real pass.
        Console::write_line("Squalr geometry: PASS");
        Console::exit_process(0);
    }

    state failed_commands(command_driver: &mut CommandDriver) {
        Console::write_line("FAIL: Squalr commands");
        Console::exit_process(1);
    }
}


// native_blocked: union values mint no unit plan in entry closures —
// PrivilegedCommand::Scan/ScanCommand::New variant literals.
pub machine CommandDriver::new_command(command_driver: &mut CommandDriver) -> PrivilegedCommand {
    PrivilegedCommand::Scan {
        command: ScanCommand::New { request: ScanNewRequest {} }
    }
}

// The `scan element-scan -c ==0 -d u64` line: one anonymous Equal-0
// constraint on one u64 data type.
// native_blocked: union values (PrivilegedCommand::Scan /
// ScanCommand::ElementScan / ScanCompareType::Immediate) mint no unit
// plan in entry closures; structural constraint/ref-set lets likewise.
pub machine CommandDriver::element_command(command_driver: &mut CommandDriver) -> PrivilegedCommand {
    let mut constraints: ScanConstraintSet = ScanConstraintSet::empty();
    let container_type: ContainerType = ContainerType::default();
    let value_string: AnonymousValueString = AnonymousValueString::new(
        "0",
        AnonymousValueStringFormat::Decimal,
        container_type
    );
    let constraint: AnonymousScanConstraint = AnonymousScanConstraint::new(
        ScanCompareType::Immediate {
            compare_type: ScanCompareTypeImmediate::Equal
        },
        value_string
    );
    _ = ScanConstraintSet::push(&mut constraints, &constraint);
    let mut data_type_refs: DataTypeRefSet = DataTypeRefSet::empty();
    let data_type_ref: DataTypeRef = DataTypeRef::new("u64");
    _ = DataTypeRefSet::push(&mut data_type_refs, &data_type_ref);
    PrivilegedCommand::Scan {
        command: ScanCommand::ElementScan {
            request: ElementScanRequest {
                scan_constraints: constraints,
                data_type_refs: data_type_refs
            }
        }
    }
}

// native_blocked: union values mint no unit plan in entry closures —
// ScanResultsCommand::List + PrivilegedCommand::ScanResults variants.
pub machine CommandDriver::list_command(command_driver: &mut CommandDriver) -> PrivilegedCommand {
    let data_type_filters: DataTypeRefSet = DataTypeRefSet::empty();
    let request: ScanResultsListRequest = ScanResultsListRequest {
        page_index: 0,
        has_data_type_filters: false,
        data_type_filters: data_type_filters
    };
    let command: ScanResultsCommand = ScanResultsCommand::List { request: request };
    PrivilegedCommand::ScanResults { command: command }
}

// Dispatch legs run the production request executors with plain request
// records — the same machines `dispatch_command` routes to. They stay
// parked: union values and structural locals mint no unit plan in entry
// closures (a named Omega wall), so the executor wire cannot establish
// natively yet. The union-constructing helpers above stay parked for
// the dispatch wire.

// native_blocked: value-returning calls in entry closures die at
// lowering (`composed scalar call structural actual`), and the
// request/response records are structural values.
pub machine CommandDriver::do_scan_new(command_driver: &mut CommandDriver) -> bool crashes Abort {
    command_driver.scan_new_request = ScanNewRequest {};
    command_driver.scan_new_response = ScanNewRequestExecutor::execute(
        &mut command_driver.engine.engine_bindings.engine_privileged_state, &command_driver.scan_new_request);
    command_driver.scan_new_response.success
}

// Seeds one whole-region result collection per data type — what
// `element_scan`'s initialize leg leaves on an all-match fixture. The
// element-scan request itself is parked: union values mint no unit plan in
// entry closures, so `ElementScanRequest`'s constraint union cannot be
// constructed natively (a named Omega wall, pending union-custody plans).
// native admissible shape (a single void call at a member receiver) —
// parked as a fixture seed helper, not part of run()'s evidence leg.
pub machine CommandDriver::seed_results_fixture(command_driver: &mut CommandDriver) {
    EnginePrivilegedState::initialize_scan_results_fixture(&mut command_driver.engine.engine_bindings.engine_privileged_state);
}

// native_blocked: value-returning calls in entry closures die at
// lowering (`composed scalar call structural actual`); the structural
// constraint/ref-set/request lets hit the same closure wall.
pub machine CommandDriver::do_element_scan(command_driver: &mut CommandDriver) -> bool crashes Abort {
    let mut constraints: ScanConstraintSet = ScanConstraintSet::empty();
    let container_type: ContainerType = ContainerType::default();
    let value_string: AnonymousValueString = AnonymousValueString::new(
        "0",
        AnonymousValueStringFormat::Decimal,
        container_type
    );
    let constraint: AnonymousScanConstraint = AnonymousScanConstraint::new(
        ScanCompareType::Immediate {
            compare_type: ScanCompareTypeImmediate::Equal
        },
        value_string
    );
    _ = ScanConstraintSet::push(&mut constraints, &constraint);
    let mut data_type_refs: DataTypeRefSet = DataTypeRefSet::empty();
    let data_type_ref: DataTypeRef = DataTypeRef::new("u64");
    _ = DataTypeRefSet::push(&mut data_type_refs, &data_type_ref);
    let request: ElementScanRequest = ElementScanRequest {
        scan_constraints: constraints,
        data_type_refs: data_type_refs
    };
    let privileged_state: &mut EnginePrivilegedState = SqualrEngine::borrow_privileged_state_mut(&mut command_driver.engine);
    let response: ElementScanResponse = ElementScanRequestExecutor::execute(privileged_state, &request);
    response.success
}

// The `scan-results delete` leg: tombstone global result index 3 —
// the element whose merged-order position is 3 (address 4120 in the
// fixture) — through the production request executor. Union values mint
// no unit plan in entry closures (a named Omega wall — the union
// `dispatch_command` variants below stay parked until it lifts).
// native_blocked: value-returning calls in entry closures +
// structural request/response fields (`composed scalar call
// structural actual`).
pub machine CommandDriver::do_scan_results_delete(command_driver: &mut CommandDriver) -> bool crashes Abort {
    command_driver.delete_ref = ScanResultRef::new(3, false);
    _ = ScanResultRefList::push(&mut command_driver.delete_request.scan_result_refs, &command_driver.delete_ref);
    command_driver.delete_response = ScanResultsDeleteRequestExecutor::execute(
        &mut command_driver.engine.engine_bindings.engine_privileged_state, &command_driver.delete_request);
    ScanResultsDeleteResponse::get_deleted_result_count(&command_driver.delete_response) == 1
}

// The `scan-results list` leg: re-page after the tombstone through the
// production list executor — the merged ordering minus global index 3,
// so 7 results on page 0 of the response. Same route the CLI's
// `scan-results list` line drives: ScanResultsListRequest(page 0, no
// filters) → ScanResultsListRequestExecutor::execute.
// native_blocked: value-returning calls in entry closures + the
// response layer materializes `ScanResult::Valued` unions (both named
// walls); `verify_shrunk_page` below is the union-free check route.
pub machine CommandDriver::do_scan_results_list(command_driver: &mut CommandDriver) -> bool crashes Abort {
    let empty_filters: DataTypeRefSet = DataTypeRefSet::empty();
    command_driver.list_request = ScanResultsListRequest {
        page_index: 0,
        has_data_type_filters: false,
        data_type_filters: empty_filters
    };
    command_driver.list_response = ScanResultsListRequestExecutor::execute(
        &mut command_driver.engine.engine_bindings.engine_privileged_state, &command_driver.list_request);
    command_driver.list_response.result_count == 7
        && ScanResultsPage::get_count(&command_driver.list_response.scan_results) == 7
}

// Re-pages after the tombstone: 7 results, the fixture's merged order
// minus address 4120. The list executor's response layer materializes
// `ScanResult::Valued` unions — behind the entry-closure union wall — so
// verification runs the same deleted-aware merge it wraps,
// `Snapshot::get_scan_results_page`, and reads plain `ScanResultValued`s.
// native_blocked: value-returning calls in scalar positions
// (`composed scalar call structural actual`) + merged `&&` chains.
pub machine CommandDriver::verify_shrunk_page(command_driver: &mut CommandDriver) -> bool crashes Abort {
    command_driver.filters = DataTypeRefSet::empty();
    command_driver.page = Snapshot::get_scan_results_page(&command_driver.engine.engine_bindings.engine_privileged_state.snapshot, &command_driver.filters, 0, 64);
    ScanResultValuedList::get_result_count(&command_driver.page.results) == 7
        && CommandDriver::page_address(command_driver, 0) == 4096
        && CommandDriver::page_address(command_driver, 1) == 4104
        && CommandDriver::page_address(command_driver, 2) == 4112
        && CommandDriver::page_address(command_driver, 3) == 4128
        && CommandDriver::page_address(command_driver, 4) == 4136
        && CommandDriver::page_address(command_driver, 5) == 4144
        && CommandDriver::page_address(command_driver, 6) == 4152
}

// Pages the first result page and asserts the exact fixture expectation:
// 8 results, addresses 4096 + position*8, current value 0 each. Same
// route as `verify_shrunk_page` — the snapshot's deleted-aware merge.
// native_blocked: value-returning calls in scalar positions
// (`composed scalar call structural actual`) + merged `&&` chains.
pub machine CommandDriver::verify_page(command_driver: &mut CommandDriver) -> bool crashes Abort {
    command_driver.filters = DataTypeRefSet::empty();
    command_driver.page = Snapshot::get_scan_results_page(&command_driver.engine.engine_bindings.engine_privileged_state.snapshot, &command_driver.filters, 0, 64);
    ScanResultValuedList::get_result_count(&command_driver.page.results) == 8
        && CommandDriver::page_address(command_driver, 0) == 4096 && CommandDriver::page_value(command_driver, 0) == 0
        && CommandDriver::page_address(command_driver, 1) == 4104 && CommandDriver::page_value(command_driver, 1) == 0
        && CommandDriver::page_address(command_driver, 2) == 4112 && CommandDriver::page_value(command_driver, 2) == 0
        && CommandDriver::page_address(command_driver, 3) == 4120 && CommandDriver::page_value(command_driver, 3) == 0
        && CommandDriver::page_address(command_driver, 4) == 4128 && CommandDriver::page_value(command_driver, 4) == 0
        && CommandDriver::page_address(command_driver, 5) == 4136 && CommandDriver::page_value(command_driver, 5) == 0
        && CommandDriver::page_address(command_driver, 6) == 4144 && CommandDriver::page_value(command_driver, 6) == 0
        && CommandDriver::page_address(command_driver, 7) == 4152 && CommandDriver::page_value(command_driver, 7) == 0
}

// Page elements land on self — a structural local (the element) would hit
// the same closure wall as everywhere else.
// native_blocked: value-returning calls (`get`, `get_address`).
machine CommandDriver::page_address(command_driver: &mut CommandDriver, position: u64) -> u64 {
    command_driver.page_element = ScanResultValuedList::get(&command_driver.page.results, position);
    ScanResultBase::get_address(&command_driver.page_element.scan_result_base)
}

// native_blocked: value-returning calls (`get`).
machine CommandDriver::page_value(command_driver: &mut CommandDriver, position: u64) -> u64 {
    command_driver.page_element = ScanResultValuedList::get(&command_driver.page.results, position);
    command_driver.page_element.current_value
}
