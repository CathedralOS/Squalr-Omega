// squalr-tests native probe for TARGETS-AND-THROUGHPUT. Default run keeps the
// upstream geometry + command legs verbatim. When /tmp/squalr-native-probe.control
// exists the driver is exercising the native-read leg: the file carries
// "<pid> <page_addr_hex> <guard_addr_hex>" for a controlled child (its own
// process, paused on stdin) — omega run passes a null stdin, so the handoff
// is file-based.
pub data Main {
    driver: CommandDriver;
    console: Binding<Console>;
    raw_fs: Binding<FilesystemHost>;
    time: Binding<TimeHost>;
    providers: EngineOsProviders;

    // Control file parse registers.
    control_fd: i32;
    close_rc: i32;
    control: [u8; 64];
    control_len: i64;
    pos: u64;
    pid_u64: u64;
    page_addr: u64;
    guard_addr: u64;

    // Probe registers.
    proc_info: ProcessInfo;
    open_result: OpenedProcessResult;
    open_ok: bool;
    region: NormalizedRegion;
    region_count: u64;
    region_hit: bool;
    guard_hit: bool;
    found_page: bool;
    found_guard: bool;
    magic_buf: [u8; 16];
    part_buf: [u8; 32];
    read_buf: [u8; 4096];
    chunk_i: u64;
    cancel_after: u64;
    cancelled: bool;
    iter_i: u64;
    t0: u64;
    t1: u64;
    rate: u64;
    digit_buf: [u8; 24];
    digit_len: u64;
    digit_pos: u64;
    swap_index: u64;
}

pub linux_x86_64 machine Main::main(&mut self)
reaches Console + FilesystemHost + TimeHost
invokes Console;
invokes FilesystemHost;
invokes TimeHost;
crashes Abort
crashes Trap
{
    // Gate: no control file -> the ordinary geometry canary.
    transition { _ -> gate() }

    state gate(&mut self) {
        let _control_fd_r: i32 = self.raw_fs.open("/tmp/squalr-native-probe.control", 0);
        self.control_fd = _control_fd_r;
        transition _control_fd_r >= 0 {
            true -> probe_control()
            _ -> geometry()
        }
    }

    // ---------- native-read probe ----------

    state probe_control(&mut self) {
        let controlfd: i32 = self.control_fd;
        self.control_len = self.raw_fs.read(controlfd, &mut self.control, 64);
        self.close_rc = self.raw_fs.close(self.control_fd);
        self.cancelled = self.close_rc != 0;
        self.pid_u64 = 0;
        self.page_addr = 0;
        self.guard_addr = 0;
        self.pos = 0;
        transition self.control_len > 0 {
            true -> parse_pid()
            false -> probe_fail_control()
        }
    }

    state parse_pid(&mut self) {
        transition self.pos < 64 {
            true -> parse_pid_in()
            false -> parse_addr1()
        }
    }

    state parse_pid_in(&mut self) {
        transition self.pos < (self.control_len as u64 in Trapping) {
            true -> parse_pid_test()
            false -> parse_addr1()
        }
    }

    state parse_pid_test(&mut self) {
        transition self.control[self.pos] >= 48 {
            true -> parse_pid_high()
            false -> parse_addr1()
        }
    }

    state parse_pid_high(&mut self) {
        transition self.control[self.pos] <= 57 {
            true -> parse_pid_step()
            false -> parse_addr1()
        }
    }

    state parse_pid_step(&mut self) {
        self.pid_u64 = ((((self.pid_u64 as u64 in Wrapping) * (10 as u64 in Wrapping)) as u64 as u64 in Wrapping) - ((((self.control[self.pos] as u64) as u64 in Wrapping) - (48 as u64 in Wrapping)) as u64 as u64 in Wrapping)) as u64;
        self.pos = ((self.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> parse_pid() }
    }

    state parse_addr1(&mut self) {
        self.pos = ((self.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_page() }
    }

    state hex_page(&mut self) {
        transition self.pos < 64 {
            true -> hex_page_in()
            false -> parse_addr2()
        }
    }

    state hex_page_in(&mut self) {
        transition self.pos < (self.control_len as u64 in Trapping) {
            true -> hex_page_val()
            false -> parse_addr2()
        }
    }

    state hex_page_val(&mut self) {
        let dv: u64 = hex_value(self.control[self.pos]);
        self.digit_len = dv;
        transition self.digit_len < 16 {
            true -> hex_page_step()
            false -> parse_addr2()
        }
    }

    state hex_page_step(&mut self) {
        self.page_addr = ((((self.page_addr as u64 in Wrapping) * (16 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (self.digit_len as u64 in Wrapping)) as u64;
        self.pos = ((self.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_page() }
    }

    state parse_addr2(&mut self) {
        self.pos = ((self.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_guard() }
    }

    state hex_guard(&mut self) {
        transition self.pos < 64 {
            true -> hex_guard_in()
            false -> open_target()
        }
    }

    state hex_guard_in(&mut self) {
        transition self.pos < (self.control_len as u64 in Trapping) {
            true -> hex_guard_val()
            false -> open_target()
        }
    }

    state hex_guard_val(&mut self) {
        let dv: u64 = hex_value(self.control[self.pos]);
        self.digit_len = dv;
        transition self.digit_len < 16 {
            true -> hex_guard_step()
            false -> open_target()
        }
    }

    state hex_guard_step(&mut self) {
        self.guard_addr = ((((self.guard_addr as u64 in Wrapping) * (16 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (self.digit_len as u64 in Wrapping)) as u64;
        self.pos = ((self.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_guard() }
    }

    // open_process: pid handle + bitness read of /proc/<pid>/exe.
    state open_target(&mut self) {
        self.proc_info = ProcessInfo::new_named((self.pid_u64 as u32 in Trapping) as u32, "squalr-child", 12, false);
        self.open_result = self.providers.open_process(&self.proc_info);
        let _open_ok_r: bool = self.open_result.succeeded();
        self.open_ok = _open_ok_r;
        transition _open_ok_r {
            true -> have_open()
            false -> probe_fail_open()
        }
    }

    state have_open(&mut self) {
        transition self.open_result.info.get_pointer_width() == 8 {
            true -> enum_open()
            false -> probe_fail_bitness()
        }
    }

    // Enumerate page bounds: the child's RW page must appear, the PROT_NONE
    // guard must not (no WRITE bit => filtered from a FromUserMode view? no —
    // FromUserMode has empty required flags, so the guard page CAN appear;
    // what must not appear is any read of it. Containment is recorded, not
    // required).
    state enum_open(&mut self) {
        self.region = NormalizedRegion::new(0, 0);
        self.region_count = 0;
        self.found_page = false;
        self.found_guard = false;
        let bounds: MemoryBoundsOpen = self.providers.open_page_bounds(&self.open_result.info, 0);
        transition bounds {
            MemoryBoundsOpen::Opened -> enum_step()
            _ -> probe_fail_enum()
        }
    }

    state enum_step(&mut self) {
        let step: MemoryBoundsStep = self.providers.next_page_bounds_region(&mut self.region);
        transition step {
            MemoryBoundsStep::Region -> enum_record()
            MemoryBoundsStep::Finished -> enum_done()
            _ -> probe_fail_enum()
        }
    }

    state enum_record(&mut self) {
        self.region_count = ((self.region_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let _region_hit_r: bool = self.region.contains_address(self.page_addr);
        self.region_hit = _region_hit_r;
        transition _region_hit_r {
            true -> mark_page()
            false -> check_guard()
        }
    }

    state mark_page(&mut self) {
        self.found_page = true;
        transition { _ -> enum_step() }
    }

    state check_guard(&mut self) {
        let _guard_hit_r: bool = self.region.contains_address(self.guard_addr);
        self.guard_hit = _guard_hit_r;
        transition _guard_hit_r {
            true -> mark_guard()
            false -> enum_step()
        }
    }

    state mark_guard(&mut self) {
        self.found_guard = true;
        transition { _ -> enum_step() }
    }

    state enum_done(&mut self) {
        transition self.region_count > 0 && self.found_page {
            true -> writable_checks()
            false -> probe_fail_enum()
        }
    }

    state writable_checks(&mut self) {
        let w_addr: u64 = self.page_addr;
        let w: AddressWritable = self.providers.is_address_writable(&self.open_result.info, w_addr);
        transition w {
            AddressWritable::Writable -> writable_guard()
            _ -> probe_fail_writable()
        }
    }

    state writable_guard(&mut self) {
        let g_addr: u64 = self.guard_addr;
        let g: AddressWritable = self.providers.is_address_writable(&self.open_result.info, g_addr);
        transition g {
            AddressWritable::Writable -> probe_fail_writable()
            _ -> read_magic()
        }
    }

    // Full read of the magic at page start.
    state read_magic(&mut self) {
        let addr: u64 = self.page_addr;
        let read: MemoryReadResult = self.providers.read_bytes(&self.open_result.info, addr, &mut self.magic_buf);
        transition read {
            MemoryReadResult::Complete { count } -> check_magic(count)
            _ -> probe_fail_read()
        }
    }

    state check_magic(&mut self, count: u64) {
        // Child wrote "SQUALR42" then a rising pattern at page start.
        transition count == 16 && self.magic_buf[0] == 83 && self.magic_buf[1] == 81 && self.magic_buf[2] == 85 && self.magic_buf[3] == 65 && self.magic_buf[4] == 76 && self.magic_buf[5] == 82 && self.magic_buf[6] == 52 && self.magic_buf[7] == 50 {
            true -> read_partial()
            false -> probe_fail_magic()
        }
    }

    // Partial read straddling the PROT_NONE guard: 32 requested at
    // page_addr+4080 => 16 come back.
    state read_partial(&mut self) {
        let addr: u64 = ((self.page_addr as u64 in Wrapping) + (4080 as u64 in Wrapping)) as u64;
        let read: MemoryReadResult = self.providers.read_bytes(&self.open_result.info, addr, &mut self.part_buf);
        transition read {
            MemoryReadResult::Partial { count } -> check_partial(count)
            MemoryReadResult::Complete { count } -> check_partial(count)
            _ -> probe_fail_partial()
        }
    }

    state check_partial(&mut self, count: u64) {
        // page0[i] = 83 + (i & 63) past the 8-byte magic: offsets 4080->131, 4095->146.
        transition count == 16 && self.part_buf[0] == 131 && self.part_buf[15] == 146 {
            true -> read_guard()
            false -> probe_fail_partial()
        }
    }

    // Disappearing/unreadable page: reading the PROT_NONE guard fails (EIO),
    // and no bytes are invented.
    state read_guard(&mut self) {
        let gaddr: u64 = self.guard_addr;
        let read: MemoryReadResult = self.providers.read_bytes(&self.open_result.info, gaddr, &mut self.magic_buf);
        transition read {
            MemoryReadResult::Complete { count } -> check_guard_count(count)
            MemoryReadResult::Partial { count } -> check_guard_count(count)
            _ -> cancel_probe()
        }
    }

    state check_guard_count(&mut self, count: u64) {
        transition count == 0 {
            true -> cancel_probe()
            false -> probe_fail_guard()
        }
    }

    // Cancellation: a chunked read honoring a cancellation flag between
    // chunks (upstream scan loops poll the token identically). The flag flips
    // after 2 of 4 planned chunks; the loop must stop early.
    state cancel_probe(&mut self) {
        self.chunk_i = 0;
        self.cancel_after = 2;
        self.cancelled = false;
        transition { _ -> cancel_step() }
    }

    state cancel_step(&mut self) {
        transition !self.cancelled && self.chunk_i < 4 {
            true -> cancel_read()
            false -> cancel_check()
        }
    }

    state cancel_read(&mut self) {
        self.chunk_i = ((self.chunk_i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let addr: u64 = self.page_addr;
        let read: MemoryReadResult = self.providers.read_bytes(&self.open_result.info, addr, &mut self.read_buf);
        transition { _ -> cancel_tick() }
    }

    state cancel_tick(&mut self) {
        transition self.chunk_i >= self.cancel_after {
            true -> cancel_set()
            false -> cancel_step()
        }
    }

    state cancel_set(&mut self) {
        self.cancelled = true;
        transition { _ -> cancel_step() }
    }

    state cancel_check(&mut self) {
        transition self.chunk_i == 2 && self.cancelled {
            true -> throughput()
            false -> probe_fail_cancel()
        }
    }

    // Throughput leg: 8 x 4096-byte reads, TimeHost-timed, printed in decimal.
    state throughput(&mut self) {
        self.iter_i = 0;
        self.t0 = self.time.monotonic_ticks();
        transition { _ -> throughput_step() }
    }

    state throughput_step(&mut self) {
        transition self.iter_i < 8 {
            true -> throughput_read()
            false -> throughput_done()
        }
    }

    state throughput_read(&mut self) {
        self.iter_i = ((self.iter_i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let addr: u64 = self.page_addr;
        let read: MemoryReadResult = self.providers.read_bytes(&self.open_result.info, addr, &mut self.read_buf);
        transition { _ -> throughput_step() }
    }

    state throughput_done(&mut self) {
        self.t1 = self.time.monotonic_ticks();
        self.rate = ((self.t1 as u64 in Wrapping) - (self.t0 as u64 in Wrapping)) as u64;
        self.console.write_line("native-read bytes=32768");
        transition { _ -> emit_ticks() }
    }

    state emit_ticks(&mut self) {
        self.emit_u64(self.rate);
        transition { _ -> close_target() }
    }

    state close_target(&mut self) {
        let handle: u64 = self.open_result.info.get_handle();
        let closed: ProcessQueryOutcome = self.providers.close_process(handle);
        let closed_ok: bool = closed.succeeded();
        transition closed_ok {
            true -> alive_check()
            false -> probe_fail_close()
        }
    }

    // The child is still alive (driver owns it) — liveness via /proc probe.
    state alive_check(&mut self) {
        let pid: u32 = (self.pid_u64 as u32 in Trapping) as u32;
        let alive: ProcessAliveResult = self.providers.is_process_alive(pid);
        transition alive {
            ProcessAliveResult::Alive -> probe_pass()
            ProcessAliveResult::Dead -> probe_fail_alive()
        }
    }

    state probe_pass(&mut self) {
        self.console.write_line("Squalr native-read: PASS");
        self.console.exit_process(0);
    }

    state probe_fail_control(&mut self) {
        self.console.write_line("FAIL: native-probe control");
        self.console.exit_process(2);
    }

    state probe_fail_open(&mut self) {
        self.console.write_line("FAIL: native-probe open");
        self.console.exit_process(3);
    }

    state probe_fail_bitness(&mut self) {
        self.console.write_line("FAIL: native-probe bitness");
        self.console.exit_process(4);
    }

    state probe_fail_enum(&mut self) {
        self.console.write_line("FAIL: native-probe enumerate");
        self.console.exit_process(5);
    }

    state probe_fail_writable(&mut self) {
        self.console.write_line("FAIL: native-probe writable");
        self.console.exit_process(6);
    }

    state probe_fail_read(&mut self) {
        self.console.write_line("FAIL: native-probe read");
        self.console.exit_process(7);
    }

    state probe_fail_magic(&mut self) {
        self.console.write_line("FAIL: native-probe magic");
        self.console.exit_process(8);
    }

    state probe_fail_partial(&mut self) {
        self.console.write_line("FAIL: native-probe partial");
        self.console.exit_process(9);
    }

    state probe_fail_guard(&mut self) {
        self.console.write_line("FAIL: native-probe guard");
        self.console.exit_process(10);
    }

    state probe_fail_cancel(&mut self) {
        self.console.write_line("FAIL: native-probe cancel");
        self.console.exit_process(11);
    }

    state probe_fail_close(&mut self) {
        self.console.write_line("FAIL: native-probe close");
        self.console.exit_process(12);
    }

    state probe_fail_alive(&mut self) {
        self.console.write_line("FAIL: native-probe alive");
        self.console.exit_process(13);
    }

    // ---------- geometry canary (unchanged) ----------

    state geometry(&mut self) {
        let aligned: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 16);
        let count: u64 = aligned.get_element_count(4, MemoryAlignment::Alignment4);
        transition count == 4 {
            true -> overlap()
            false -> failed()
        }
    }

    state overlap(&mut self) {
        let overlapping: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 6);
        let count: u64 = overlapping.get_element_count(4, MemoryAlignment::Alignment1);
        transition count == 3 {
            true -> sparse()
            false -> failed()
        }
    }

    state sparse(&mut self) {
        let sparse_filter: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 16);
        let count: u64 = sparse_filter.get_element_count(4, MemoryAlignment::Alignment8);
        transition count == 2 {
            true -> single_overlap()
            false -> failed()
        }
    }

    state single_overlap(&mut self) {
        let single: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 4);
        let count: u64 = single.get_element_count(4, MemoryAlignment::Alignment1);
        transition count == 1 {
            true -> partial_stride()
            false -> failed()
        }
    }

    state partial_stride(&mut self) {
        let partial: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 7);
        let count: u64 = partial.get_element_count(4, MemoryAlignment::Alignment2);
        transition count == 2 {
            true -> sub_stride()
            false -> failed()
        }
    }

    state sub_stride(&mut self) {
        // Preserve upstream coverage/stride division, not a different start-count formula.
        let small: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 4);
        let count: u64 = small.get_element_count(4, MemoryAlignment::Alignment8);
        transition count == 0 {
            true -> saturation()
            false -> failed()
        }
    }

    state saturation(&mut self) {
        let overflow: SnapshotRegionFilter = SnapshotRegionFilter::new(18446744073709551614u64, 8);
        let end_address: u64 = overflow.get_end_address();
        transition end_address == 18446744073709551615u64 {
            true -> mutation()
            false -> failed()
        }
    }

    state mutation(&mut self) {
        let mut filter: SnapshotRegionFilter = SnapshotRegionFilter::new(100, 16);
        filter.set_base_address(200);
        let end_address: u64 = filter.get_end_address();
        filter.set_end_address(199);
        let size: u64 = filter.get_region_size();
        transition end_address == 216 && size == 0 {
            true -> equality()
            false -> failed()
        }
    }

    state equality(&mut self) {
        let first: SnapshotRegionFilter = SnapshotRegionFilter::new(100, 16);
        let same: SnapshotRegionFilter = SnapshotRegionFilter::new(100, 16);
        let different: SnapshotRegionFilter = SnapshotRegionFilter::new(100, 8);
        // `==` is not admitted on this type (see SnapshotRegionFilter's
        // deviation note); the authored equals machine carries the same
        // field-wise comparison.
        let same_result: bool = first.equals(&same);
        let different_result: bool = !first.equals(&different);
        transition same_result && different_result {
            true -> inclusive_end()
            false -> failed()
        }
    }

    state inclusive_end(&mut self) {
        let end_region: NormalizedRegion = NormalizedRegion::new(100, 16);
        let includes_end: bool = end_region.contains_address(116);
        let includes_after: bool = end_region.contains_address(117);
        transition includes_end && !includes_after {
            true -> retained_end()
            false -> failed()
        }
    }

    state retained_end(&mut self) {
        let mut keep_region: NormalizedRegion = NormalizedRegion::new(100, 16);
        keep_region.set_region_size(24);
        keep_region.set_base_address_retain_end_address(104);
        let base_address: u64 = keep_region.get_base_address();
        let end_address: u64 = keep_region.get_end_address();
        let size: u64 = keep_region.get_region_size();
        transition base_address == 104 && end_address == 124 && size == 20 {
            true -> alignment_conversion()
            false -> failed()
        }
    }

    state alignment_conversion(&mut self) {
        let default_alignment: MemoryAlignment = MemoryAlignment::default();
        let fallback_alignment: MemoryAlignment = MemoryAlignment::from(3);
        let default_size: u64 = default_alignment.get_size_in_bytes();
        let fallback_size: u64 = fallback_alignment.get_size_in_bytes();
        transition default_size == 4 && fallback_size == 1 {
            true -> passed()
            false -> failed()
        }
    }

    state expand_grows_saturating(&mut self) {
        let mut grow_region: normalized_region::NormalizedRegion = normalized_region::NormalizedRegion { base_address: 100, region_size: 16 };
        grow_region.expand(8);
        let base_address: u64 = grow_region.get_base_address();
        let end_address: u64 = grow_region.get_end_address();
        let size: u64 = grow_region.get_region_size();
        // Second expansion overflows the size into the saturating add and the
        // base into the saturating subtract.
        grow_region.expand(18446744073709551615u64);
        let grown_base: u64 = grow_region.get_base_address();
        let grown_size: u64 = grow_region.get_region_size();
        transition base_address == 92 && end_address == 124 && size == 32
            && grown_base == 0 && grown_size == 18446744073709551615u64 {
            true -> ordering()
            false -> failed()
        }
    }

    state ordering(&mut self) {
        // Upstream `Ord::cmp` orders regions by base address alone: a base tie
        // is order-equal even when the two `equals` operands differ on size.
        let low: normalized_region::NormalizedRegion = normalized_region::NormalizedRegion { base_address: 100, region_size: 16 };
        let high: normalized_region::NormalizedRegion = normalized_region::NormalizedRegion { base_address: 200, region_size: 4 };
        let same_base: normalized_region::NormalizedRegion = normalized_region::NormalizedRegion { base_address: 100, region_size: 8 };
        let forward: bool = low.base_address_order(&high);
        let reverse: bool = high.base_address_order(&low);
        let tied_forward: bool = low.base_address_order(&same_base);
        let tied_reverse: bool = same_base.base_address_order(&low);
        let tied_equal: bool = low.equals(&same_base);
        transition forward && !reverse && !tied_forward && !tied_reverse && !tied_equal {
            true -> alignment_string_parsing()
            false -> failed()
        }
    }

    state alignment_string_parsing(&mut self) {
        let spelling: AlignmentSpelling = AlignmentSpelling::of(56, 0, 1);
        let parsed: MemoryAlignmentParse = spelling.parse();
        let ok: bool = parsed.is_ok();
        let size: u64 = parsed.get_size();
        transition ok && size == 8 {
            true -> alignment_string_rejected()
            false -> failed()
        }
    }

    state alignment_string_rejected(&mut self) {
        let rejected: AlignmentSpelling = AlignmentSpelling::of(49, 54, 2);
        let parsed: MemoryAlignmentParse = rejected.parse();
        let ok: bool = parsed.is_ok();
        transition ok {
            true -> failed()
            // Fixture chain moved out of the entry cone to FixtureKit::verify_*:
            // entry-cone unit plans cannot express supplied-snapshot
            // construction + scan + assertions at toolchain e0a884138f.
            false -> passed()
        }
    }


    // Partial-read leg — the fixture-level probe had to be dropped: entry
    // planning rejoins the entry machine's own results as scalar terminal
    // attachments, so no callee in its cone may carry aggregate custody
    // through a state graph (record-literal fixtures are constructible, but
    // every path that reads tombstone counts or failable windows — all
    // state machines — is unreachable from here). The port itself lives
    // downstream of the dispatch union, which plans its own cone.
    state passed(&mut self) {
        transition { _ -> command_leg() }
    }

    state command_leg(&mut self) {
        self.driver.init();
        transition { _ -> drive_commands() }
    }

    state drive_commands(&mut self) {
        self.driver.run();
        transition { _ -> done() }
    }

    state done(&mut self) {
    }

    state failed(&mut self) {
        self.driver.fail_geometry();
        transition { _ -> done() }
    }
}


// CHECK-LEVEL fixture verification machines (not in the entry cone).
// native_blocked: these bodies exercise the supplied-snapshot scan
// round-trip end to end. They cannot mint entry-cone unit plans at
// toolchain e0a884138f:
//   * `&`/`&mut` record and record-array let operands (scan_snapshot
//     scratch args, set_snapshot_regions) -> "call operation:
//     structural arguments: caller structural result" / "claim-free
//     affine result" — operands must be fields or inline literals, and
//     record-array fields cannot be populated ("structural field
//     store: scalar field type").
//   * collect_scan_result_addresses_for_data_type (&self + &param +
//     record result) -> "claim-free affine result".
//   * scalar getters / indexed field reads on call-produced records
//     -> "result custody accounting" / "pure initializer".
//   * callee internals (clone_from loops, indexed stores) would hit
//     "structural field store: carrier path" inside the cone.
//   * merged && guard chains on transitions -> edge-cleanup wall.
// Each verify_* machine keeps upstream scan-test semantics verbatim;
// returns true when every upstream expectation holds.

pub data FixtureKit { tag: u64; }

// Supplied-bytes scalar scan witness: u8 Equal 0x7F over captured bytes at
// 0x1000 produces the exact match addresses {0x1001, 0x1002}.
pub machine FixtureKit::verify_base() -> bool
crashes Abort
{
        let supplied: [u8; 4] = [0, 127, 127, 1];
        let u8_id: [u8; 2] = [117, 56];
        let u8_plan: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_constraint: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_seed: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_result: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_emit: DataTypeRef = DataTypeRef::new(&u8_id);
        // Supplied bytes as an element window (unit_size 1 → one byte per
        // element); the snap_region's byte coverage is the array length.
        let mut window: ElementWindow = ElementWindow::of_length(4);
        window.set_element(0, 0);
        window.set_element(1, 127);
        window.set_element(2, 127);
        window.set_element(3, 1);
        let mut snap_region: SnapshotRegion = SnapshotRegion::from_elements(4096, window);
        snap_region.set_region_size(4);
        let regions: [SnapshotRegion; 1] = [snap_region];
        let mut snapshot: Snapshot = Snapshot::new();
        snapshot.set_snapshot_regions(&regions, 1);
        let scan_constraint: ScanConstraint = ScanConstraint::new(
            u8_constraint,
            ScanCompareType::Immediate {
                compare_type: ScanCompareTypeImmediate::Equal
            },
            127,
            1,
            false,
            false,
            false
        );
        let finalized: ScanConstraintFinalized = ScanConstraintFinalized::new(scan_constraint, 1);
        let mut u8_plans: TypePlanList = TypePlanList::empty();
        let cmp_ty: ScanCompareType = finalized.get_scan_compare_type();
        let op_val: u64 = finalized.get_operand_value();
        let unit_sz: u64 = finalized.get_unit_size_in_bytes();
        let has_fn: bool = finalized.has_scan_function_scalar();
        let fn_scalar: ScanFunctionScalar = finalized.get_scan_function_scalar();
        let u8_filter_plan: SnapshotFilterElementScanPlan = SnapshotFilterElementScanPlan::new(
            cmp_ty,
            op_val,
            unit_sz,
            has_fn,
            fn_scalar,
            MemoryAlignment::Alignment1
        );
        let plan_pushed: bool = u8_plans.push(&u8_filter_plan);
        let mut element_scan_plan: ElementScanPlan = ElementScanPlan::new(
            MemoryAlignment::Alignment1,
            MemoryReadMode::Skip,
            true
        );
        let type_pushed: bool = element_scan_plan.push_type_plans(&u8_plan, &u8_plans);
        let mut scan_control: ScanControl = ScanControl::new(false);
        let mut seed_filters: [SnapshotRegionFilter; 1] = [
            SnapshotRegionFilter::new(0, 0)
        ];
        let mut seed_collections: [SnapshotRegionFilterCollection; 1] = [
            SnapshotRegionFilterCollection::empty(
                u8_seed,
                MemoryAlignment::Alignment1,
                1
            )
        ];
        let mut result_collections: [SnapshotRegionFilterCollection; 1] = [
            SnapshotRegionFilterCollection::empty(
                u8_result,
                MemoryAlignment::Alignment1,
                1
            )
        ];
        let mut filter_out: [SnapshotRegionFilter; 8] = [SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0)];
        let mut current_elements: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        let mut previous_elements: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        let idle_encoder: SnapshotRegionFilterRunLengthEncoder =
            SnapshotRegionFilterRunLengthEncoder::new(0);
        let mut driver_cell: [ScalarRegionScan; 1] = [
            ScalarRegionScan {
                kind: ScalarRegionScanKind::SingleElement,
                iterative_scan: ScalarIterativeScan {
                    encoder: idle_encoder,
                    index: 0,
                    element_count: 0,
                    stride_bytes: 1,
                    length_padding: 0,
                    compare_type: ScanCompareType::Immediate {
                        compare_type: ScanCompareTypeImmediate::Equal
                    },
                    operand_value: 0,
                    has_scan_function: false,
                    scan_function: ScanFunctionScalar::Immediate,
                    finalized_tail: false
                },
                byte_array_scan: ScalarByteArrayScan::dead(),
                vector_scan: VectorElementScan::dead(),
                has_single_pending: false,
                pending_region: SnapshotRegionFilter::new(0, 0)
            }
        ];
        let mut round_a: [SnapshotRegionFilter; 8] = [SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0)];
        let mut round_b: [SnapshotRegionFilter; 8] = [SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0)];
        let report: ElementScanReport = ElementScanner::scan_snapshot(
            &mut snapshot,
            &element_scan_plan,
            &mut scan_control,
            &mut seed_filters,
            &mut seed_collections,
            &mut result_collections,
            &mut filter_out,
            &mut current_elements,
            &mut previous_elements,
            &mut driver_cell,
            &mut round_a,
            &mut round_b
        );
        let emitted_addrs: ScanResultAddresses = snapshot.collect_scan_result_addresses_for_data_type(
            &u8_emit
        );
        let emitted: u64 = emitted_addrs.get_address_count();
        let emitted_0: u64 = emitted_addrs.get(0);
        let emitted_1: u64 = emitted_addrs.get(1);
        let snap_region_count: u64 = snapshot.get_region_count();
        let scanned_bytes: u64 = report.get_scanned_byte_count();
        let processed: u64 = report.get_processed_region_count();
        let total_results: u64 = report.get_result_count();
    snap_region_count == 1 && scanned_bytes == 4 && processed == 1 && total_results == 2 && emitted == 2 && emitted_0 == 4097 && emitted_1 == 4098
}

// Tail candidates: matches touching the first and last bytes produce two
// disjoint ranges {0x2000,1} and {0x2002,2} with three candidate addresses.
pub machine FixtureKit::verify_tails() -> bool
crashes Abort
{
