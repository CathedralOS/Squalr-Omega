            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 },
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 },
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 },
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 },
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 },
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 }
        ];
        let snaps: [&Snapshot; 1] = [&snapshot];
        let executor: PointerScanExecutor = PointerScanExecutor {};
        let mut results: PointerScanResults = executor.execute_scan(
            &snaps,
            41,
            &params,
            target_descriptor,
            &mut target_addresses,
            1,
            PointerScanAddressSpace::EmulatorMemory,
            &modules,
            false,
            &mut sorted_scratch,
            &mut target_ranges,
            &mut lower_bounds,
            &mut upper_bounds,
            &mut target_range_buckets,
            &mut tasks_scratch,
            &mut byte_arena,
            &mut module_order,
            &mut level_out,
            &mut heap_addr_scratch,
            &mut module_names,
            &mut levels_out,
            &mut level_spans,
            &mut level_candidates,
            &mut static_arena,
            &mut heap_arena,
            &mut materialized_nodes,
            &mut node_id_slab,
            &mut page_key_cache
        );
        let level0: PointerScanLevel = results.get_pointer_scan_level_copy(0);
        let level1: PointerScanLevel = results.get_pointer_scan_level_copy(1);
        let mut root_ids: [u64; 4] = [0, 0, 0, 0];
        let root_page: ExpandedNodePage = results.get_expanded_node_page(
            false,
            0,
            0,
            4,
            &mut root_ids
        );
        let chain_root: PointerScanNode = FixtureKit::page_node_by_address(&results, &root_ids, 4112);
        let chain_root_id: u64 = chain_root.get_node_id();
        let chain_root_static: bool = FixtureKit::node_is_static(&chain_root);
        // Deviation: upstream asserts module_name == "game.exe"; here name
        // identity is carried by len==8 plus module_offset/module_index.
        // A byte-equality walk machine blew the check budget on this graph.
        let chain_name: &[u8] = chain_root.get_module_name();
        let chain_name_len: u64 = chain_name.len;
        let direct_root: PointerScanNode = FixtureKit::page_node_by_address(&results, &root_ids, 4144);
        let direct_root_static: bool = FixtureKit::node_is_static(&direct_root);
        let direct_name: &[u8] = direct_root.get_module_name();
        let direct_name_len: u64 = direct_name.len;
        let mut child_ids: [u64; 4] = [0, 0, 0, 0];
        let child_page: ExpandedNodePage = results.get_expanded_node_page(
            true,
            chain_root_id,
            0,
            4,
            &mut child_ids
        );
        let child: PointerScanNode = FixtureKit::page_node_by_address(&results, &child_ids, 4112);
        let child_id: u64 = child.get_node_id();
        let child_static: bool = FixtureKit::node_is_static(&child);
        let child_name: &[u8] = child.get_module_name();
        let child_name_len: u64 = child_name.len;
        let mut grandchild_ids: [u64; 4] = [0, 0, 0, 0];
        let grandchild_page: ExpandedNodePage = results.get_expanded_node_page(
            true,
            child_id,
            0,
            4,
            &mut grandchild_ids
        );
        let grandchild: PointerScanNode = FixtureKit::page_node_by_address(&results, &grandchild_ids, 8192);
        let grandchild_static: bool = FixtureKit::node_is_static(&grandchild);

        results.get_session_id() == 41 && results.get_root_node_count() == 2 && results.get_total_node_count() == 3 && results.get_total_static_node_count() == 2 && results.get_total_heap_node_count() == 1 && results.get_pointer_scan_level_count() == 2 && level0.get_depth() == 1 && level0.get_node_count() == 2 && level0.get_static_node_count() == 1 && level0.get_heap_node_count() == 1 && level1.get_depth() == 2 && level1.get_node_count() == 1 && level1.get_static_node_count() == 1 && level1.get_heap_node_count() == 0 && root_page.node_count == 2 && chain_root.get_pointer_address() == 4112 && chain_root.get_depth() == 1 && chain_root_static && chain_name_len == 8 && chain_root.get_module_offset() == 16 && chain_root.get_resolved_target_address() == 8176 && chain_root.get_pointer_offset() == 0 && chain_root.has_children() && child_page.node_count == 1 && child.get_pointer_address() == 4112 && child_static && child.get_depth() == 2 && child.get_resolved_target_address() == 8192 && child_name_len == 8 && child.get_pointer_offset() == 16 && child.has_children() && grandchild_page.node_count == 1 && grandchild.get_pointer_address() == 8192 && !grandchild_static && grandchild.get_depth() == 3 && grandchild.get_resolved_target_address() == 12304 && grandchild.get_pointer_offset() == 16 && !grandchild.has_children() && direct_root.get_pointer_address() == 4144 && direct_root_static && direct_root.get_depth() == 1 && direct_name_len == 8 && direct_root.get_module_offset() == 48 && direct_root.get_resolved_target_address() == 12304 && direct_root.get_pointer_offset() == -16 && !direct_root.has_children()
}
