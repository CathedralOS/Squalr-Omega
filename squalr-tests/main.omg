// squalr-tests native probe for TARGETS-AND-THROUGHPUT. Default run keeps the
// upstream geometry + command legs verbatim. When /tmp/squalr-native-probe.control
// exists the driver is exercising the native-read leg: the file carries
// "<pid> <page_addr_hex> <guard_addr_hex>" for a controlled child (its own
// process, paused on stdin) — omega run passes a null stdin, so the handoff
// is file-based.
pub data Main {
    driver: CommandDriver;
    providers: EngineOsProviders;

    // Control file parse registers.
    control_fd: i32;
    close_rc: i32;
    control: [u8; 64];
    control_len: i64;
    pos: u64;
    pid_u64: u64;
    page_addr: u64;
    guard_addr: u64;

    // Probe registers.
    proc_info: ProcessInfo;
    open_result: OpenedProcessResult;
    open_ok: bool;
    region: NormalizedRegion;
    region_count: u64;
    region_hit: bool;
    guard_hit: bool;
    found_page: bool;
    found_guard: bool;
    magic_buf: [u8; 16];
    part_buf: [u8; 32];
    read_buf: [u8; 4096];
    chunk_i: u64;
    cancel_after: u64;
    cancelled: bool;
    iter_i: u64;
    t0: u64;
    t1: u64;
    rate: u64;
    digit_buf: [u8; 24];
    digit_len: u64;
    digit_pos: u64;
    swap_index: u64;
}

pub linux_x86_64 machine Main::main(main: &mut Main)
reaches Console + FilesystemHost + TimeHost
invokes Console;
invokes FilesystemHost;
invokes TimeHost;
crashes Abort
crashes Trap
{
    // Gate: no control file -> the ordinary geometry canary.
    transition { _ -> gate(main) }

    state gate(main: &mut Main) {
        let _control_fd_r: i32 = FilesystemHost::open("/tmp/squalr-native-probe.control", 0);
        main.control_fd = _control_fd_r;
        transition _control_fd_r >= 0 {
            true -> probe_control(main)
            _ -> geometry(main)
        }
    }

    // ---------- native-read probe ----------

    state probe_control(main: &mut Main) {
        let controlfd: i32 = main.control_fd;
        main.control_len = FilesystemHost::read(controlfd, &mut main.control, 64);
        main.close_rc = FilesystemHost::close(main.control_fd);
        main.cancelled = main.close_rc != 0;
        main.pid_u64 = 0;
        main.page_addr = 0;
        main.guard_addr = 0;
        main.pos = 0;
        transition main.control_len > 0 {
            true -> parse_pid(main)
            false -> probe_fail_control(main)
        }
    }

    state parse_pid(main: &mut Main) {
        transition main.pos < 64 {
            true -> parse_pid_in(main)
            false -> parse_addr1(main)
        }
    }

    state parse_pid_in(main: &mut Main) {
        transition main.pos < (main.control_len as u64 in Trapping) {
            true -> parse_pid_test(main)
            false -> parse_addr1(main)
        }
    }

    state parse_pid_test(main: &mut Main) {
        transition main.control[main.pos] >= 48 {
            true -> parse_pid_high(main)
            false -> parse_addr1(main)
        }
    }

    state parse_pid_high(main: &mut Main) {
        transition main.control[main.pos] <= 57 {
            true -> parse_pid_step(main)
            false -> parse_addr1(main)
        }
    }

    state parse_pid_step(main: &mut Main) {
        main.pid_u64 = ((((main.pid_u64 as u64 in Wrapping) * (10 as u64 in Wrapping)) as u64 as u64 in Wrapping) - ((((main.control[main.pos] as u64) as u64 in Wrapping) - (48 as u64 in Wrapping)) as u64 as u64 in Wrapping)) as u64;
        main.pos = ((main.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> parse_pid(main) }
    }

    state parse_addr1(main: &mut Main) {
        main.pos = ((main.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_page(main) }
    }

    state hex_page(main: &mut Main) {
        transition main.pos < 64 {
            true -> hex_page_in(main)
            false -> parse_addr2(main)
        }
    }

    state hex_page_in(main: &mut Main) {
        transition main.pos < (main.control_len as u64 in Trapping) {
            true -> hex_page_val(main)
            false -> parse_addr2(main)
        }
    }

    state hex_page_val(main: &mut Main) {
        let dv: u64 = hex_value(main.control[main.pos]);
        main.digit_len = dv;
        transition main.digit_len < 16 {
            true -> hex_page_step(main)
            false -> parse_addr2(main)
        }
    }

    state hex_page_step(main: &mut Main) {
        main.page_addr = ((((main.page_addr as u64 in Wrapping) * (16 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (main.digit_len as u64 in Wrapping)) as u64;
        main.pos = ((main.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_page(main) }
    }

    state parse_addr2(main: &mut Main) {
        main.pos = ((main.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_guard(main) }
    }

    state hex_guard(main: &mut Main) {
        transition main.pos < 64 {
            true -> hex_guard_in(main)
            false -> open_target(main)
        }
    }

    state hex_guard_in(main: &mut Main) {
        transition main.pos < (main.control_len as u64 in Trapping) {
            true -> hex_guard_val(main)
            false -> open_target(main)
        }
    }

    state hex_guard_val(main: &mut Main) {
        let dv: u64 = hex_value(main.control[main.pos]);
        main.digit_len = dv;
        transition main.digit_len < 16 {
            true -> hex_guard_step(main)
            false -> open_target(main)
        }
    }

    state hex_guard_step(main: &mut Main) {
        main.guard_addr = ((((main.guard_addr as u64 in Wrapping) * (16 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (main.digit_len as u64 in Wrapping)) as u64;
        main.pos = ((main.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_guard(main) }
    }

    // open_process: pid handle + bitness read of /proc/<pid>/exe.
    state open_target(main: &mut Main) {
        main.proc_info = ProcessInfo::new_named((main.pid_u64 as u32 in Trapping) as u32, "squalr-child", 12, false);
        main.open_result = main.providers.open_process(&main.proc_info);
        let _open_ok_r: bool = OpenedProcessResult::succeeded(&main.open_result);
        main.open_ok = _open_ok_r;
        transition _open_ok_r {
            true -> have_open(main)
            false -> probe_fail_open(main)
        }
    }

    state have_open(main: &mut Main) {
        let pointer_width: u64 = OpenedProcessInfo::get_pointer_width(&main.open_result.info);
        transition pointer_width == 8 {
            true -> enum_open(main)
            false -> probe_fail_bitness(main)
        }
    }

    // Enumerate page bounds: the child's RW page must appear, the PROT_NONE
    // guard must not (no WRITE bit => filtered from a FromUserMode view? no —
    // FromUserMode has empty required flags, so the guard page CAN appear;
    // what must not appear is any read of it. Containment is recorded, not
    // required).
    state enum_open(main: &mut Main) {
        main.region = NormalizedRegion::new(0, 0);
        main.region_count = 0;
        main.found_page = false;
        main.found_guard = false;
        let bounds: MemoryBoundsOpen = main.providers.open_page_bounds(&main.open_result.info, 0);
        let bounds_ok: bool = MemoryBoundsOpen::is_opened(&bounds);
        transition bounds_ok {
            true -> enum_step(main)
            _ -> probe_fail_enum(main)
        }
    }

    state enum_step(main: &mut Main) {
        let step: MemoryBoundsStep = main.providers.next_page_bounds_region(&mut main.region);
        // Three-way kind dispatch — union scrutinees are admitted on
        // params, not locals, so the split rides a hop state.
        transition {
            _ -> enum_step_kind(main, step)
        }
    }

    state enum_step_kind(main: &mut Main, step: MemoryBoundsStep) {
        transition step {
            MemoryBoundsStep::Region -> enum_record(main)
            MemoryBoundsStep::Finished -> enum_done(main)
            _ -> probe_fail_enum(main)
        }
    }

    state enum_record(main: &mut Main) {
        main.region_count = ((main.region_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let _region_hit_r: bool = NormalizedRegion::contains_address(&main.region, main.page_addr);
        main.region_hit = _region_hit_r;
        transition _region_hit_r {
            true -> mark_page(main)
            false -> check_guard(main)
        }
    }

    state mark_page(main: &mut Main) {
        main.found_page = true;
        transition { _ -> enum_step(main) }
    }

    state check_guard(main: &mut Main) {
        let _guard_hit_r: bool = NormalizedRegion::contains_address(&main.region, main.guard_addr);
        main.guard_hit = _guard_hit_r;
        transition _guard_hit_r {
            true -> mark_guard(main)
            false -> enum_step(main)
        }
    }

    state mark_guard(main: &mut Main) {
        main.found_guard = true;
        transition { _ -> enum_step(main) }
    }

    state enum_done(main: &mut Main) {
        transition main.region_count > 0 && main.found_page {
            true -> writable_checks(main)
            false -> probe_fail_enum(main)
        }
    }

    state writable_checks(main: &mut Main) {
        let w_addr: u64 = main.page_addr;
        let w: AddressWritable = main.providers.is_address_writable(&main.open_result.info, w_addr);
        let w_ok: bool = AddressWritable::is_writable(&w);
        transition w_ok {
            true -> writable_guard(main)
            _ -> probe_fail_writable(main)
        }
    }

    state writable_guard(main: &mut Main) {
        let g_addr: u64 = main.guard_addr;
        let g: AddressWritable = main.providers.is_address_writable(&main.open_result.info, g_addr);
        let g_ok: bool = AddressWritable::is_writable(&g);
        transition g_ok {
            true -> probe_fail_writable(main)
            _ -> read_magic(main)
        }
    }

    // Full read of the magic at page start.
    state read_magic(main: &mut Main) {
        let addr: u64 = main.page_addr;
        let read: MemoryReadResult = main.providers.read_bytes(&main.open_result.info, addr, &mut main.magic_buf);
        let read_complete: bool = MemoryReadResult::is_complete(&read);
        transition read_complete {
            true -> check_magic(main, MemoryReadResult::count(&read))
            _ -> probe_fail_read(main)
        }
    }

    state check_magic(main: &mut Main, count: u64) {
        // Child wrote "SQUALR42" then a rising pattern at page start.
        transition count == 16 && main.magic_buf[0] == 83 && main.magic_buf[1] == 81 && main.magic_buf[2] == 85 && main.magic_buf[3] == 65 && main.magic_buf[4] == 76 && main.magic_buf[5] == 82 && main.magic_buf[6] == 52 && main.magic_buf[7] == 50 {
            true -> read_partial(main)
            false -> probe_fail_magic(main)
        }
    }

    // Partial read straddling the PROT_NONE guard: 32 requested at
    // page_addr+4080 => 16 come back.
    state read_partial(main: &mut Main) {
        let addr: u64 = ((main.page_addr as u64 in Wrapping) + (4080 as u64 in Wrapping)) as u64;
        let read: MemoryReadResult = main.providers.read_bytes(&main.open_result.info, addr, &mut main.part_buf);
        let read_have: bool = MemoryReadResult::is_partial(&read) || MemoryReadResult::is_complete(&read);
        transition read_have {
            true -> check_partial(main, MemoryReadResult::count(&read))
            _ -> probe_fail_partial(main)
        }
    }

    state check_partial(main: &mut Main, count: u64) {
        // page0[i] = 83 + (i & 63) past the 8-byte magic: offsets 4080->131, 4095->146.
        transition count == 16 && main.part_buf[0] == 131 && main.part_buf[15] == 146 {
            true -> read_guard(main)
            false -> probe_fail_partial(main)
        }
    }

    // Disappearing/unreadable page: reading the PROT_NONE guard fails (EIO),
    // and no bytes are invented.
    state read_guard(main: &mut Main) {
        let gaddr: u64 = main.guard_addr;
        let read: MemoryReadResult = main.providers.read_bytes(&main.open_result.info, gaddr, &mut main.magic_buf);
        let read_have: bool = MemoryReadResult::is_complete(&read) || MemoryReadResult::is_partial(&read);
        transition read_have {
            true -> check_guard_count(main, MemoryReadResult::count(&read))
            _ -> cancel_probe(main)
        }
    }

    state check_guard_count(main: &mut Main, count: u64) {
        transition count == 0 {
            true -> cancel_probe(main)
            false -> probe_fail_guard(main)
        }
    }

    // Cancellation: a chunked read honoring a cancellation flag between
    // chunks (upstream scan loops poll the token identically). The flag flips
    // after 2 of 4 planned chunks; the loop must stop early.
    state cancel_probe(main: &mut Main) {
        main.chunk_i = 0;
        main.cancel_after = 2;
        main.cancelled = false;
        transition { _ -> cancel_step(main) }
    }

    state cancel_step(main: &mut Main) {
        transition !main.cancelled && main.chunk_i < 4 {
            true -> cancel_read(main)
            false -> cancel_check(main)
        }
    }

    state cancel_read(main: &mut Main) {
        main.chunk_i = ((main.chunk_i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let addr: u64 = main.page_addr;
        let read: MemoryReadResult = main.providers.read_bytes(&main.open_result.info, addr, &mut main.read_buf);
        transition { _ -> cancel_tick(main) }
    }

    state cancel_tick(main: &mut Main) {
        transition main.chunk_i >= main.cancel_after {
            true -> cancel_set(main)
            false -> cancel_step(main)
        }
    }

    state cancel_set(main: &mut Main) {
        main.cancelled = true;
        transition { _ -> cancel_step(main) }
    }

    state cancel_check(main: &mut Main) {
        transition main.chunk_i == 2 && main.cancelled {
            true -> throughput(main)
            false -> probe_fail_cancel(main)
        }
    }

    // Throughput leg: 8 x 4096-byte reads, TimeHost-timed, printed in decimal.
    state throughput(main: &mut Main) {
        main.iter_i = 0;
        main.t0 = TimeHost::monotonic_ticks();
        transition { _ -> throughput_step(main) }
    }

    state throughput_step(main: &mut Main) {
        transition main.iter_i < 8 {
            true -> throughput_read(main)
            false -> throughput_done(main)
        }
    }

    state throughput_read(main: &mut Main) {
        main.iter_i = ((main.iter_i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let addr: u64 = main.page_addr;
        let read: MemoryReadResult = main.providers.read_bytes(&main.open_result.info, addr, &mut main.read_buf);
        transition { _ -> throughput_step(main) }
    }

    state throughput_done(main: &mut Main) {
        main.t1 = TimeHost::monotonic_ticks();
        main.rate = ((main.t1 as u64 in Wrapping) - (main.t0 as u64 in Wrapping)) as u64;
        Console::write_line("native-read bytes=32768");
        transition { _ -> emit_ticks(main) }
    }

    state emit_ticks(main: &mut Main) {
        Main::emit_u64(main, main.rate);
        transition { _ -> close_target(main) }
    }

    state close_target(main: &mut Main) {
        let handle: u64 = OpenedProcessInfo::get_handle(&main.open_result.info);
        let closed: ProcessQueryOutcome = main.providers.close_process(handle);
        let closed_ok: bool = ProcessQueryOutcome::succeeded(&closed);
        transition closed_ok {
            true -> alive_check(main)
            false -> probe_fail_close(main)
        }
    }

    // The child is still alive (driver owns it) — liveness via /proc probe.
    state alive_check(main: &mut Main) {
        let pid: u32 = (main.pid_u64 as u32 in Trapping) as u32;
        let alive: ProcessAliveResult = main.providers.is_process_alive(pid);
        let is_alive: bool = ProcessAliveResult::is_alive(&alive);
        transition is_alive {
            true -> probe_pass(main)
            _ -> probe_fail_alive(main)
        }
    }

    state probe_pass(main: &mut Main) {
        Console::write_line("Squalr native-read: PASS");
        Console::exit_process(0);
    }

    state probe_fail_control(main: &mut Main) {
        Console::write_line("FAIL: native-probe control");
        Console::exit_process(2);
    }

    state probe_fail_open(main: &mut Main) {
        Console::write_line("FAIL: native-probe open");
        Console::exit_process(3);
    }

    state probe_fail_bitness(main: &mut Main) {
        Console::write_line("FAIL: native-probe bitness");
        Console::exit_process(4);
    }

    state probe_fail_enum(main: &mut Main) {
        Console::write_line("FAIL: native-probe enumerate");
        Console::exit_process(5);
    }

    state probe_fail_writable(main: &mut Main) {
        Console::write_line("FAIL: native-probe writable");
        Console::exit_process(6);
    }

    state probe_fail_read(main: &mut Main) {
        Console::write_line("FAIL: native-probe read");
        Console::exit_process(7);
    }

    state probe_fail_magic(main: &mut Main) {
        Console::write_line("FAIL: native-probe magic");
        Console::exit_process(8);
    }

    state probe_fail_partial(main: &mut Main) {
        Console::write_line("FAIL: native-probe partial");
        Console::exit_process(9);
    }

    state probe_fail_guard(main: &mut Main) {
        Console::write_line("FAIL: native-probe guard");
        Console::exit_process(10);
    }

    state probe_fail_cancel(main: &mut Main) {
        Console::write_line("FAIL: native-probe cancel");
        Console::exit_process(11);
    }

    state probe_fail_close(main: &mut Main) {
        Console::write_line("FAIL: native-probe close");
        Console::exit_process(12);
    }

    state probe_fail_alive(main: &mut Main) {
        Console::write_line("FAIL: native-probe alive");
        Console::exit_process(13);
    }

    // ---------- geometry canary (unchanged) ----------

    state geometry(main: &mut Main) {
        let aligned: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 16);
        let count: u64 = SnapshotRegionFilter::get_element_count(&aligned, 4, MemoryAlignment::Alignment4);
        transition count == 4 {
            true -> overlap(main)
            false -> failed(main)
        }
    }

    state overlap(main: &mut Main) {
        let overlapping: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 6);
        let count: u64 = SnapshotRegionFilter::get_element_count(&overlapping, 4, MemoryAlignment::Alignment1);
        transition count == 3 {
            true -> sparse(main)
            false -> failed(main)
        }
    }

    state sparse(main: &mut Main) {
        let sparse_filter: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 16);
        let count: u64 = SnapshotRegionFilter::get_element_count(&sparse_filter, 4, MemoryAlignment::Alignment8);
        transition count == 2 {
            true -> single_overlap(main)
            false -> failed(main)
        }
    }

    state single_overlap(main: &mut Main) {
        let single: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 4);
        let count: u64 = SnapshotRegionFilter::get_element_count(&single, 4, MemoryAlignment::Alignment1);
        transition count == 1 {
            true -> partial_stride(main)
            false -> failed(main)
        }
    }

    state partial_stride(main: &mut Main) {
        let partial: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 7);
        let count: u64 = SnapshotRegionFilter::get_element_count(&partial, 4, MemoryAlignment::Alignment2);
        transition count == 2 {
            true -> sub_stride(main)
            false -> failed(main)
        }
    }

    state sub_stride(main: &mut Main) {
        // Preserve upstream coverage/stride division, not a different start-count formula.
        let small: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 4);
        let count: u64 = SnapshotRegionFilter::get_element_count(&small, 4, MemoryAlignment::Alignment8);
        transition count == 0 {
            true -> saturation(main)
            false -> failed(main)
        }
    }

    state saturation(main: &mut Main) {
        let overflow: SnapshotRegionFilter = SnapshotRegionFilter::new(18446744073709551614u64, 8);
        let end_address: u64 = SnapshotRegionFilter::get_end_address(&overflow);
        transition end_address == 18446744073709551615u64 {
            true -> mutation(main)
            false -> failed(main)
        }
    }

    state mutation(main: &mut Main) {
        let mut filter: SnapshotRegionFilter = SnapshotRegionFilter::new(100, 16);
        SnapshotRegionFilter::set_base_address(&mut filter, 200);
        let end_address: u64 = SnapshotRegionFilter::get_end_address(&filter);
        SnapshotRegionFilter::set_end_address(&mut filter, 199);
        let size: u64 = SnapshotRegionFilter::get_region_size(&filter);
        transition end_address == 216 && size == 0 {
            true -> equality(main)
            false -> failed(main)
        }
    }

    state equality(main: &mut Main) {
        let first: SnapshotRegionFilter = SnapshotRegionFilter::new(100, 16);
        let same: SnapshotRegionFilter = SnapshotRegionFilter::new(100, 16);
        let different: SnapshotRegionFilter = SnapshotRegionFilter::new(100, 8);
        // `==` is not admitted on this type (see SnapshotRegionFilter's
        // deviation note); the authored equals machine carries the same
        // field-wise comparison.
        let same_result: bool = SnapshotRegionFilter::equals(&first, &same);
        let different_result: bool = !SnapshotRegionFilter::equals(&first, &different);
        transition same_result && different_result {
            true -> inclusive_end(main)
            false -> failed(main)
        }
    }

    state inclusive_end(main: &mut Main) {
        let end_region: NormalizedRegion = NormalizedRegion::new(100, 16);
        let includes_end: bool = NormalizedRegion::contains_address(&end_region, 116);
        let includes_after: bool = NormalizedRegion::contains_address(&end_region, 117);
        transition includes_end && !includes_after {
            true -> retained_end(main)
            false -> failed(main)
        }
    }

    state retained_end(main: &mut Main) {
        let mut keep_region: NormalizedRegion = NormalizedRegion::new(100, 16);
        NormalizedRegion::set_region_size(&mut keep_region, 24);
        NormalizedRegion::set_base_address_retain_end_address(&mut keep_region, 104);
        let base_address: u64 = NormalizedRegion::get_base_address(&keep_region);
        let end_address: u64 = NormalizedRegion::get_end_address(&keep_region);
        let size: u64 = NormalizedRegion::get_region_size(&keep_region);
        transition base_address == 104 && end_address == 124 && size == 20 {
            true -> alignment_conversion(main)
            false -> failed(main)
        }
    }

    state alignment_conversion(main: &mut Main) {
        let default_alignment: MemoryAlignment = MemoryAlignment::default();
        let fallback_alignment: MemoryAlignment = MemoryAlignment::from(3);
        let default_size: u64 = MemoryAlignment::get_size_in_bytes(&default_alignment);
        let fallback_size: u64 = MemoryAlignment::get_size_in_bytes(&fallback_alignment);
        transition default_size == 4 && fallback_size == 1 {
            true -> passed(main)
            false -> failed(main)
        }
    }

    state expand_grows_saturating(main: &mut Main) {
        let mut grow_region: normalized_region::NormalizedRegion = normalized_region::NormalizedRegion { base_address: 100, region_size: 16 };
        grow_region.expand(8);
        let base_address: u64 = grow_region.get_base_address();
        let end_address: u64 = grow_region.get_end_address();
        let size: u64 = grow_region.get_region_size();
        // Second expansion overflows the size into the saturating add and the
        // base into the saturating subtract.
        grow_region.expand(18446744073709551615u64);
        let grown_base: u64 = grow_region.get_base_address();
        let grown_size: u64 = grow_region.get_region_size();
        transition base_address == 92 && end_address == 124 && size == 32
            && grown_base == 0 && grown_size == 18446744073709551615u64 {
            true -> ordering(main)
            false -> failed(main)
        }
    }

    state ordering(main: &mut Main) {
        // Upstream `Ord::cmp` orders regions by base address alone: a base tie
        // is order-equal even when the two `equals` operands differ on size.
        let low: normalized_region::NormalizedRegion = normalized_region::NormalizedRegion { base_address: 100, region_size: 16 };
        let high: normalized_region::NormalizedRegion = normalized_region::NormalizedRegion { base_address: 200, region_size: 4 };
        let same_base: normalized_region::NormalizedRegion = normalized_region::NormalizedRegion { base_address: 100, region_size: 8 };
        let forward: bool = low.base_address_order(&high);
        let reverse: bool = high.base_address_order(&low);
        let tied_forward: bool = low.base_address_order(&same_base);
        let tied_reverse: bool = same_base.base_address_order(&low);
        let tied_equal: bool = low.equals(&same_base);
        transition forward && !reverse && !tied_forward && !tied_reverse && !tied_equal {
            true -> alignment_string_parsing(main)
            false -> failed(main)
        }
    }

    state alignment_string_parsing(main: &mut Main) {
        let spelling: AlignmentSpelling = AlignmentSpelling::of(56, 0, 1);
        let parsed: MemoryAlignmentParse = AlignmentSpelling::parse(&spelling);
        let ok: bool = MemoryAlignmentParse::is_ok(&parsed);
        let size: u64 = MemoryAlignmentParse::get_size(&parsed);
        transition ok && size == 8 {
            true -> alignment_string_rejected(main)
            false -> failed(main)
        }
    }

    state alignment_string_rejected(main: &mut Main) {
        let rejected: AlignmentSpelling = AlignmentSpelling::of(49, 54, 2);
        let parsed: MemoryAlignmentParse = AlignmentSpelling::parse(&rejected);
        let ok: bool = MemoryAlignmentParse::is_ok(&parsed);
        transition ok {
            true -> failed(main)
            // Fixture chain moved out of the entry cone to FixtureKit::verify_*:
            // entry-cone unit plans cannot express supplied-snapshot
            // construction + scan + assertions at toolchain e0a884138f.
            false -> passed(main)
        }
    }


    // Partial-read leg — the fixture-level probe had to be dropped: entry
    // planning rejoins the entry machine's own results as scalar terminal
    // attachments, so no callee in its cone may carry aggregate custody
    // through a state graph (record-literal fixtures are constructible, but
    // every path that reads tombstone counts or failable windows — all
    // state machines — is unreachable from here). The port itself lives
    // downstream of the dispatch union, which plans its own cone.
    state passed(main: &mut Main) {
        transition { _ -> command_leg(main) }
    }

    state command_leg(main: &mut Main) {
        main.driver.init();
        transition { _ -> drive_commands(main) }
    }

    state drive_commands(main: &mut Main) {
        Driver::run(&mut main.driver);
        transition { _ -> done(main) }
    }

    state done(main: &mut Main) {
    }

    state failed(main: &mut Main) {
        main.driver.fail_geometry();
        transition { _ -> done(main) }
    }
}


// CHECK-LEVEL fixture verification machines (not in the entry cone).
// native_blocked: these bodies exercise the supplied-snapshot scan
// round-trip end to end. They cannot mint entry-cone unit plans at
// toolchain e0a884138f:
//   * `&`/`&mut` record and record-array let operands (scan_snapshot
//     scratch args, set_snapshot_regions) -> "call operation:
//     structural arguments: caller structural result" / "claim-free
//     affine result" — operands must be fields or inline literals, and
//     record-array fields cannot be populated ("structural field
//     store: scalar field type").
//   * collect_scan_result_addresses_for_data_type (&self + &param +
//     record result) -> "claim-free affine result".
//   * scalar getters / indexed field reads on call-produced records
//     -> "result custody accounting" / "pure initializer".
//   * callee internals (clone_from loops, indexed stores) would hit
//     "structural field store: carrier path" inside the cone.
//   * merged && guard chains on transitions -> edge-cleanup wall.
// Each verify_* machine keeps upstream scan-test semantics verbatim;
// returns true when every upstream expectation holds.

pub data FixtureKit { tag: u64; }

// Supplied-bytes scalar scan witness: u8 Equal 0x7F over captured bytes at
// 0x1000 produces the exact match addresses {0x1001, 0x1002}.
pub machine FixtureKit::verify_base() -> bool
crashes Abort
{
        let supplied: [u8; 4] = [0, 127, 127, 1];
        let u8_id: [u8; 2] = [117, 56];
        let u8_plan: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_constraint: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_seed: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_result: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_emit: DataTypeRef = DataTypeRef::new(&u8_id);
        // Supplied bytes as an element window (unit_size 1 → one byte per
        // element); the snap_region's byte coverage is the array length.
        let mut window: ElementWindow = ElementWindow::of_length(4);
        ElementWindow::set_element(&mut window, 0, 0);
        ElementWindow::set_element(&mut window, 1, 127);
        ElementWindow::set_element(&mut window, 2, 127);
        ElementWindow::set_element(&mut window, 3, 1);
        let mut snap_region: SnapshotRegion = SnapshotRegion::from_elements(4096, window);
        SnapshotRegion::set_region_size(&mut snap_region, 4);
        let regions: [SnapshotRegion; 1] = [snap_region];
        let mut snapshot: Snapshot = Snapshot::new();
        Snapshot::set_snapshot_regions(&mut snapshot, &regions, 1);
        let floating_point_tolerance: FloatingPointTolerance = FloatingPointTolerance::default();
        let scan_constraint: ScanConstraint = ScanConstraint::new(
            u8_constraint,
            ScanCompareType::Immediate {
                compare_type: ScanCompareTypeImmediate::Equal
            },
            127,
            1,
            false,
            false,
            false,
            floating_point_tolerance
        );
        let finalized: ScanConstraintFinalized = ScanConstraintFinalized::new(scan_constraint, 1);
        let mut u8_plans: TypePlanList = TypePlanList::empty();
        let cmp_ty: ScanCompareType = ScanConstraintFinalized::get_scan_compare_type(&finalized);
        let op_val: u64 = ScanConstraintFinalized::get_operand_value(&finalized);
        let unit_sz: u64 = ScanConstraintFinalized::get_unit_size_in_bytes(&finalized);
        let has_fn: bool = ScanConstraintFinalized::has_scan_function_scalar(&finalized);
        let fn_scalar: ScanFunctionScalar = ScanConstraintFinalized::get_scan_function_scalar(&finalized);
        let u8_filter_plan: SnapshotFilterElementScanPlan = SnapshotFilterElementScanPlan::new(
            cmp_ty,
            op_val,
            unit_sz,
            has_fn,
            fn_scalar,
            MemoryAlignment::Alignment1
        );
        let plan_pushed: bool = TypePlanList::push(&mut u8_plans, &u8_filter_plan);
        let mut element_scan_plan: ElementScanPlan = ElementScanPlan::new(
            MemoryAlignment::Alignment1,
            MemoryReadMode::Skip,
            true,
            false
        );
        let type_pushed: bool = ElementScanPlan::push_type_plans(&mut element_scan_plan, &u8_plan, &u8_plans);
        let mut scan_control: ScanControl = ScanControl::new(false);
        let mut seed_filters: [SnapshotRegionFilter; 1] = [
            SnapshotRegionFilter::new(0, 0)
        ];
        let mut seed_collections: [SnapshotRegionFilterCollection; 1] = [
            SnapshotRegionFilterCollection::empty(
                u8_seed,
                MemoryAlignment::Alignment1,
                1
            )
        ];
        let mut result_collections: [SnapshotRegionFilterCollection; 1] = [
            SnapshotRegionFilterCollection::empty(
                u8_result,
                MemoryAlignment::Alignment1,
                1
            )
        ];
        let mut filter_out: [SnapshotRegionFilter; 8] = [SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0)];
        let mut current_elements: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        let mut previous_elements: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        let idle_encoder: SnapshotRegionFilterRunLengthEncoder =
            SnapshotRegionFilterRunLengthEncoder::new(0);
        let mut driver_cell: [ScalarRegionScan; 1] = [
            ScalarRegionScan {
                kind: ScalarRegionScanKind::SingleElement,
                iterative_scan: ScalarIterativeScan {
                    encoder: idle_encoder,
                    index: 0,
                    element_count: 0,
                    stride_bytes: 1,
                    length_padding: 0,
                    compare_type: ScanCompareType::Immediate {
                        compare_type: ScanCompareTypeImmediate::Equal
                    },
                    operand_value: 0,
                    has_scan_function: false,
                    scan_function: ScanFunctionScalar::Immediate,
                    finalized_tail: false
                },
                byte_array_scan: ScalarByteArrayScan::dead(),
                vector_scan: VectorElementScan::dead(),
                has_single_pending: false,
                pending_region: SnapshotRegionFilter::new(0, 0)
            }
        ];
        let mut round_a: [SnapshotRegionFilter; 8] = [SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0)];
        let mut round_b: [SnapshotRegionFilter; 8] = [SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0)];
        let report: ElementScanReport = ElementScanner::scan_snapshot(
            &mut snapshot,
            &element_scan_plan,
            &mut scan_control,
            &mut seed_filters,
            &mut seed_collections,
            &mut result_collections,
            &mut filter_out,
            &mut current_elements,
            &mut previous_elements,
            &mut driver_cell,
            &mut round_a,
            &mut round_b
        );
        let emitted_addrs: ScanResultAddresses = Snapshot::collect_scan_result_addresses_for_data_type(&snapshot, 
            &u8_emit
        );
        let emitted: u64 = ScanResultAddresses::get_address_count(&emitted_addrs);
        let emitted_0: u64 = ScanResultAddresses::get(&emitted_addrs, 0);
        let emitted_1: u64 = ScanResultAddresses::get(&emitted_addrs, 1);
        let snap_region_count: u64 = Snapshot::get_region_count(&snapshot);
        let scanned_bytes: u64 = ElementScanReport::get_scanned_byte_count(&report);
        let processed: u64 = ElementScanReport::get_processed_region_count(&report);
        let total_results: u64 = ElementScanReport::get_result_count(&report);
    snap_region_count == 1 && scanned_bytes == 4 && processed == 1 && total_results == 2 && emitted == 2 && emitted_0 == 4097 && emitted_1 == 4098
}

// Tail candidates: matches touching the first and last bytes produce two
// disjoint ranges {0x2000,1} and {0x2002,2} with three candidate addresses.
pub machine FixtureKit::verify_tails() -> bool
crashes Abort
{
        let supplied: [u8; 4] = [127, 0, 127, 127];
        let u8_id: [u8; 2] = [117, 56];
        let u8_plan: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_constraint: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_seed: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_result: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_emit: DataTypeRef = DataTypeRef::new(&u8_id);
        let mut window: ElementWindow = ElementWindow::of_length(4);
        ElementWindow::set_element(&mut window, 0, 127);
        ElementWindow::set_element(&mut window, 1, 0);
        ElementWindow::set_element(&mut window, 2, 127);
        ElementWindow::set_element(&mut window, 3, 127);
        let mut snap_region: SnapshotRegion = SnapshotRegion::from_elements(8192, window);
        SnapshotRegion::set_region_size(&mut snap_region, 4);
        let regions: [SnapshotRegion; 1] = [snap_region];
        let mut snapshot: Snapshot = Snapshot::new();
        Snapshot::set_snapshot_regions(&mut snapshot, &regions, 1);
        let floating_point_tolerance: FloatingPointTolerance = FloatingPointTolerance::default();
        let scan_constraint: ScanConstraint = ScanConstraint::new(
            u8_constraint,
            ScanCompareType::Immediate {
                compare_type: ScanCompareTypeImmediate::Equal
            },
            127,
            1,
            false,
            false,
            false,
            floating_point_tolerance
        );
        let finalized: ScanConstraintFinalized = ScanConstraintFinalized::new(scan_constraint, 1);
        let mut u8_plans: TypePlanList = TypePlanList::empty();
        let cmp_ty: ScanCompareType = ScanConstraintFinalized::get_scan_compare_type(&finalized);
        let op_val: u64 = ScanConstraintFinalized::get_operand_value(&finalized);
        let unit_sz: u64 = ScanConstraintFinalized::get_unit_size_in_bytes(&finalized);
        let has_fn: bool = ScanConstraintFinalized::has_scan_function_scalar(&finalized);
        let fn_scalar: ScanFunctionScalar = ScanConstraintFinalized::get_scan_function_scalar(&finalized);
        let u8_filter_plan: SnapshotFilterElementScanPlan = SnapshotFilterElementScanPlan::new(
            cmp_ty,
            op_val,
            unit_sz,
            has_fn,
            fn_scalar,
            MemoryAlignment::Alignment1
        );
        let plan_pushed: bool = TypePlanList::push(&mut u8_plans, &u8_filter_plan);
        let mut element_scan_plan: ElementScanPlan = ElementScanPlan::new(
            MemoryAlignment::Alignment1,
            MemoryReadMode::Skip,
            true,
            false
        );
        let type_pushed: bool = ElementScanPlan::push_type_plans(&mut element_scan_plan, &u8_plan, &u8_plans);
        let mut scan_control: ScanControl = ScanControl::new(false);
        let mut seed_filters: [SnapshotRegionFilter; 1] = [
            SnapshotRegionFilter::new(0, 0)
        ];
        let mut seed_collections: [SnapshotRegionFilterCollection; 1] = [
            SnapshotRegionFilterCollection::empty(
                u8_seed,
                MemoryAlignment::Alignment1,
                1
            )
        ];
        let mut result_collections: [SnapshotRegionFilterCollection; 1] = [
            SnapshotRegionFilterCollection::empty(
                u8_result,
                MemoryAlignment::Alignment1,
                1
            )
        ];
        let mut filter_out: [SnapshotRegionFilter; 8] = [SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0)];
        let mut current_elements: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
