use {omega_language_std}/console.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {omega_language_std}/time_host.omg;
use {squalr_engine_api}/src/plugins/memory_view/page_retrieval_mode.omg;
use {squalr_engine_api}/src/structures/memory/memory_alignment.omg;
use {squalr_engine_api}/src/structures/memory/normalized_region.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_api}/src/structures/processes/process_info.omg;
use {squalr_engine_api}/src/structures/scanning/filters/snapshot_region_filter.omg;
use {squalr_engine_session}/src/os/engine_os_provider.omg;
use {squalr_engine_targets}/src/target_providers.omg;

// squalr-tests native probe for TARGETS-AND-THROUGHPUT. Default run keeps the
// upstream geometry canary verbatim. When /tmp/squalr-native-probe.control
// exists the driver is exercising the native-read leg: the file carries
// "<pid> <page_addr_hex> <guard_addr_hex>" for a controlled child (its own
// process, paused on stdin) — omega run passes a null stdin, so the handoff
// is file-based.
// The native-read probe chain that used to gate this entry on a control file
// stays parked in tools/native_probe_main.omg.parked: its provider helpers
// (open_process, read_bytes, page bounds) are not ported, so the entry runs the
// geometry canary directly.
data Main { }

machine Main::main(this: &mut Main) reaches |console|::Console
invokes |console|::Console;
{
    transition { _ -> geometry(this) }

    machine geometry(this: &mut Main) {
        let aligned: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter|::SnapshotRegionFilter::new(4096, 16);
        let count: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_element_count(&aligned, 4, |memory_alignment|::MemoryAlignment::Alignment4);
        transition count == 4 {
            true -> overlap(this)
            false -> failed(this)
        }
    }

    machine overlap(this: &mut Main) {
        let overlapping: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter|::SnapshotRegionFilter::new(4096, 6);
        let count: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_element_count(&overlapping, 4, |memory_alignment|::MemoryAlignment::Alignment1);
        transition count == 3 {
            true -> sparse(this)
            false -> failed(this)
        }
    }

    machine sparse(this: &mut Main) {
        let sparse_filter: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter|::SnapshotRegionFilter::new(4096, 16);
        let count: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_element_count(&sparse_filter, 4, |memory_alignment|::MemoryAlignment::Alignment8);
        transition count == 2 {
            true -> single_overlap(this)
            false -> failed(this)
        }
    }

    machine single_overlap(this: &mut Main) {
        let single: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter|::SnapshotRegionFilter::new(4096, 4);
        let count: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_element_count(&single, 4, |memory_alignment|::MemoryAlignment::Alignment1);
        transition count == 1 {
            true -> partial_stride(this)
            false -> failed(this)
        }
    }

    machine partial_stride(this: &mut Main) {
        let partial: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter|::SnapshotRegionFilter::new(4096, 7);
        let count: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_element_count(&partial, 4, |memory_alignment|::MemoryAlignment::Alignment2);
        transition count == 2 {
            true -> sub_stride(this)
            false -> failed(this)
        }
    }

    machine sub_stride(this: &mut Main) {
        // Preserve upstream coverage/stride division, not a different start-count formula.
        let small: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter|::SnapshotRegionFilter::new(4096, 4);
        let count: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_element_count(&small, 4, |memory_alignment|::MemoryAlignment::Alignment8);
        transition count == 0 {
            true -> saturation(this)
            false -> failed(this)
        }
    }

    machine saturation(this: &mut Main) {
        let overflow: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter|::SnapshotRegionFilter::new(18446744073709551614u64, 8);
        let end_address: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_end_address(&overflow);
        transition end_address == 18446744073709551615u64 {
            true -> mutation(this)
            false -> failed(this)
        }
    }

    machine mutation(this: &mut Main) {
        let mut filter: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter|::SnapshotRegionFilter::new(100, 16);
        |snapshot_region_filter|::SnapshotRegionFilter::set_base_address(&mut filter, 200);
        let end_address: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_end_address(&filter);
        |snapshot_region_filter|::SnapshotRegionFilter::set_end_address(&mut filter, 199);
        let size: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_region_size(&filter);
        transition end_address == 216 && size == 0 {
            true -> equality(this)
            false -> failed(this)
        }
    }

    machine equality(this: &mut Main) {
        let first: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter|::SnapshotRegionFilter::new(100, 16);
        let same: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter|::SnapshotRegionFilter::new(100, 16);
        let different: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter|::SnapshotRegionFilter::new(100, 8);
        let same_result: bool = |snapshot_region_filter|::SnapshotRegionFilter::equals(&first, &same);
        let different_result: bool = |snapshot_region_filter|::SnapshotRegionFilter::equals(&first, &different);
        transition same_result && !different_result {
            true -> inclusive_end(this)
            false -> failed(this)
        }
    }

    machine inclusive_end(this: &mut Main) {
        let end_region: |normalized_region|::NormalizedRegion = |normalized_region|::NormalizedRegion::new(100, 16);
        let includes_end: bool = |normalized_region|::NormalizedRegion::contains_address(&end_region, 116);
        let includes_after: bool = |normalized_region|::NormalizedRegion::contains_address(&end_region, 117);
        transition includes_end && !includes_after {
            true -> retained_end(this)
            false -> failed(this)
        }
    }

    machine retained_end(this: &mut Main) {
        let mut keep_region: |normalized_region|::NormalizedRegion = |normalized_region|::NormalizedRegion::new(100, 16);
        |normalized_region|::NormalizedRegion::set_region_size(&mut keep_region, 24);
        |normalized_region|::NormalizedRegion::set_base_address_retain_end_address(&mut keep_region, 104);
        let base_address: u64 = |normalized_region|::NormalizedRegion::get_base_address(&keep_region);
        let end_address: u64 = |normalized_region|::NormalizedRegion::get_end_address(&keep_region);
        let size: u64 = |normalized_region|::NormalizedRegion::get_region_size(&keep_region);
        transition base_address == 104 && end_address == 124 && size == 20 {
            true -> alignment_conversion(this)
            false -> failed(this)
        }
    }

    machine alignment_conversion(this: &mut Main) {
        let default_alignment: |memory_alignment|::MemoryAlignment = |memory_alignment|::MemoryAlignment::default();
        let fallback_alignment: |memory_alignment|::MemoryAlignment = |memory_alignment|::MemoryAlignment::from(3);
        let default_size: u64 = |memory_alignment|::MemoryAlignment::get_size_in_bytes(&default_alignment);
        let fallback_size: u64 = |memory_alignment|::MemoryAlignment::get_size_in_bytes(&fallback_alignment);
        transition default_size == 4 && fallback_size == 1 {
            true -> passed(this)
            false -> failed(this)
        }
    }

    machine passed(this: &mut Main) {
        |console|::Console::write_line("Squalr geometry: PASS");
        |console|::Console::exit_process(0);
    }

    machine failed(this: &mut Main) {
        |console|::Console::write_line("FAIL: SnapshotRegionFilter geometry");
        |console|::Console::exit_process(1);
    }
}
