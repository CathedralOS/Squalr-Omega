// Successive filtering inside one round: the plan's two constraints chain
// AND-style per upstream — Equal(7) produces the retained set {0,2,3}, then
// NotEqual(7) re-filters it to empty; upstream's empty-collection fold drops
// the collection and discard_empty_regions drops the region.
pub machine FixtureKit::verify_constraint_chain() -> bool
crashes Abort
{
        let supplied: [u8; 4] = [7, 0, 7, 7];
        let u8_id: [u8; 2] = [117, 56];
        let u8_plan: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_constraint: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_constraint2: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_seed: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_result: DataTypeRef = DataTypeRef::new(&u8_id);
        let u8_emit: DataTypeRef = DataTypeRef::new(&u8_id);
        let mut window: ElementWindow = ElementWindow::of_length(4);
        window.set_element(0, 7);
        window.set_element(1, 0);
        window.set_element(2, 7);
        window.set_element(3, 7);
        let mut region: SnapshotRegion = SnapshotRegion::from_elements(8192, window);
        region.set_region_size(4);
        let regions: [SnapshotRegion; 1] = [region];
        let mut snapshot: Snapshot = Snapshot::new();
        snapshot.set_snapshot_regions(&regions, 1);
        let scan_constraint: ScanConstraint = ScanConstraint::new(
            u8_constraint,
            ScanCompareType::Immediate {
                compare_type: ScanCompareTypeImmediate::Equal
            },
            7,
            1,
            false,
            false,
            false
        );
        let scan_constraint2: ScanConstraint = ScanConstraint::new(
            u8_constraint2,
            ScanCompareType::Immediate {
                compare_type: ScanCompareTypeImmediate::NotEqual
            },
            7,
            1,
            false,
            false,
            false
        );
        let finalized: ScanConstraintFinalized = ScanConstraintFinalized::new(scan_constraint, 1);
        let finalized2: ScanConstraintFinalized = ScanConstraintFinalized::new(scan_constraint2, 1);
        let mut u8_plans: TypePlanList = TypePlanList::empty();
        let cmp_ty: ScanCompareType = finalized.get_scan_compare_type();
        let op_val: u64 = finalized.get_operand_value();
        let unit_sz: u64 = finalized.get_unit_size_in_bytes();
        let has_fn: bool = finalized.has_scan_function_scalar();
        let fn_scalar: ScanFunctionScalar = finalized.get_scan_function_scalar();
        let cmp_ty2: ScanCompareType = finalized2.get_scan_compare_type();
        let op_val2: u64 = finalized2.get_operand_value();
        let unit_sz2: u64 = finalized2.get_unit_size_in_bytes();
        let has_fn2: bool = finalized2.has_scan_function_scalar();
        let fn_scalar2: ScanFunctionScalar = finalized2.get_scan_function_scalar();
        let u8_filter_plan: SnapshotFilterElementScanPlan = SnapshotFilterElementScanPlan::new(
            cmp_ty,
            op_val,
            unit_sz,
            has_fn,
            fn_scalar,
            MemoryAlignment::Alignment1
        );
        let u8_filter_plan2: SnapshotFilterElementScanPlan = SnapshotFilterElementScanPlan::new(
            cmp_ty2,
            op_val2,
            unit_sz2,
            has_fn2,
            fn_scalar2,
            MemoryAlignment::Alignment1
        );
        let plan_pushed: bool = u8_plans.push(&u8_filter_plan);
        let plan_pushed2: bool = u8_plans.push(&u8_filter_plan2);
        let mut element_scan_plan: ElementScanPlan = ElementScanPlan::new(
            MemoryAlignment::Alignment1,
            MemoryReadMode::Skip,
            true
        );
        let type_pushed: bool = element_scan_plan.push_type_plans(&u8_plan, &u8_plans);
        let mut scan_control: ScanControl = ScanControl::new(false);
        let mut seed_filters: [SnapshotRegionFilter; 1] = [
            SnapshotRegionFilter::new(0, 0)
        ];
        let mut seed_collections: [SnapshotRegionFilterCollection; 1] = [
            SnapshotRegionFilterCollection::empty(
                u8_seed,
                MemoryAlignment::Alignment1,
                1
            )
        ];
        let mut result_collections: [SnapshotRegionFilterCollection; 1] = [
            SnapshotRegionFilterCollection::empty(
                u8_result,
                MemoryAlignment::Alignment1,
                1
            )
        ];
        let mut filter_out: [SnapshotRegionFilter; 8] = [SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0)];
        let mut current_elements: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        let mut previous_elements: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        let idle_encoder: SnapshotRegionFilterRunLengthEncoder =
            SnapshotRegionFilterRunLengthEncoder::new(0);
        let mut driver_cell: [ScalarRegionScan; 1] = [
            ScalarRegionScan {
                kind: ScalarRegionScanKind::SingleElement,
                iterative_scan: ScalarIterativeScan {
                    encoder: idle_encoder,
                    index: 0,
                    element_count: 0,
                    stride_bytes: 1,
                    length_padding: 0,
                    compare_type: ScanCompareType::Immediate {
                        compare_type: ScanCompareTypeImmediate::Equal
                    },
                    operand_value: 0,
                    has_scan_function: false,
                    scan_function: ScanFunctionScalar::Immediate,
                    finalized_tail: false
                },
                has_single_pending: false,
                pending_region: SnapshotRegionFilter::new(0, 0)
            }
        ];
        let mut round_a: [SnapshotRegionFilter; 8] = [SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0)];
        let mut round_b: [SnapshotRegionFilter; 8] = [SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0)];
        let report: ElementScanReport = ElementScanner::scan_snapshot(
            &mut snapshot,
            &element_scan_plan,
            &mut scan_control,
            &mut seed_filters,
            &mut seed_collections,
            &mut result_collections,
            &mut filter_out,
            &mut current_elements,
            &mut previous_elements,
            &mut driver_cell,
            &mut round_a,
            &mut round_b
        );
        let emitted_addrs: ScanResultAddresses = snapshot.collect_scan_result_addresses_for_data_type(
            &u8_emit
        );
        let emitted: u64 = emitted_addrs.get_address_count();
        let region_count: u64 = snapshot.get_region_count();
        let scanned_bytes: u64 = report.get_scanned_byte_count();
        let processed: u64 = report.get_processed_region_count();
        let total_results: u64 = report.get_result_count();
    region_count == 0 && scanned_bytes == 0 && processed == 1 && total_results == 0 && emitted == 0
}

// Pointer-scan materialization witness — port of upstream's
// execute_scan_builds_pointer_chains_and_classifies_static_nodes test:
// a pointer-scan run produces collected candidate addresses through the
// dispatcher -> collector -> results path, materializing chain nodes owned
// by the results partition. Upstream builds three 0x40-byte regions at
// 0x1000/0x2000/0x3000; the port bounds snapshots at one region, so the
// fixture collapses to a single 0x1000..0x2040 region covering every read
// site (gap bytes read as zero and produce no candidates — 0 is neither in
// module range nor in any target range).
machine FixtureKit::absent_node() -> PointerScanNode {
    let empty: [u8; 1] = [0];
    (PointerScanNode::new_materialized(0, 0, 0, 0, 0, false, 0, PointerScanNodeType::Heap, 0, 0, 0, 0, &empty, 0, false))
}

machine FixtureKit::node_at<'e, 'sh, 's, 'h>(results: &PointerScanResults<'e, 'sh, 's, 'h>, node_id: u64) -> PointerScanNode {
    let lookup: MaterializedNodeLookup = results.find_materialized_node(node_id);
    transition lookup {
        MaterializedNodeLookup::Found { index } -> (results.copy_materialized_node(index))
        _ -> (FixtureKit::absent_node())
    }
}

machine FixtureKit::node_is_static(node: &PointerScanNode) -> bool {
    transition node.get_pointer_scan_node_type() {
        PointerScanNodeType::Static -> (true)
        _ -> (false)
    }
}

// Upstream's `.find(|n| n.get_pointer_address() == want)` over an expanded
// page — order-independent node lookup by pointer address.
machine FixtureKit::page_node_by_address<'e, 'sh, 's, 'h>(results: &PointerScanResults<'e, 'sh, 's, 'h>, ids: &[u64], want_address: u64) -> PointerScanNode {
    transition { _ -> walk(results, ids, want_address, 0) }
    state walk(results: &PointerScanResults<'e, 'sh, 's, 'h>, ids: &[u64], want_address: u64, position: u64) -> PointerScanNode {
        transition position < ids.len {
            true -> probe(results, ids, want_address, position)
            false -> absent()
        }
    }
    state probe(results: &PointerScanResults<'e, 'sh, 's, 'h>, ids: &[u64], want_address: u64, position: u64 [0..ids.len]) -> PointerScanNode {
        let node: PointerScanNode = FixtureKit::node_at(results, ids[position]);
        transition node.get_pointer_address() == want_address {
            true -> (node)
            false -> next(results, ids, want_address, position)
        }
    }
    state next(results: &PointerScanResults<'e, 'sh, 's, 'h>, ids: &[u64], want_address: u64, position: u64) -> PointerScanNode {
        let advanced: u64 = ((position as u64 in Wrapping) + 1) as u64;
        transition { _ -> walk(results, ids, want_address, advanced) }
    }
    state absent() -> PointerScanNode {
        (FixtureKit::absent_node())
    }
}

