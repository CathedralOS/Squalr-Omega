        let mut page_key_cache: [MaterializedPageKeyEntry; 8] = [
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 },
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 },
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 },
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 },
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 },
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 },
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 },
            MaterializedPageKeyEntry { has_parent_node_id: false, parent_node_id: 0, page_index: 0, page_size: 0, ids_start: 0, ids_len: 0 }
        ];
        let snaps: [&Snapshot; 1] = [&snapshot];
        let executor: PointerScanExecutor = PointerScanExecutor {};
        let mut results: PointerScanResults = executor.execute_scan(
            &snaps,
            41,
            &params,
            target_descriptor,
            &mut target_addresses,
            1,
            PointerScanAddressSpace::EmulatorMemory,
            &modules,
            false,
            &mut sorted_scratch,
            &mut target_ranges,
            &mut lower_bounds,
            &mut upper_bounds,
            &mut target_range_buckets,
            &mut tasks_scratch,
            &mut byte_arena,
            &mut module_order,
            &mut level_out,
            &mut heap_addr_scratch,
            &mut module_names,
            &mut levels_out,
            &mut level_spans,
            &mut level_candidates,
            &mut static_arena,
            &mut heap_arena,
            &mut materialized_nodes,
            &mut node_id_slab,
            &mut page_key_cache
        );
        let level0: PointerScanLevel = results.get_pointer_scan_level_copy(0);
        let level1: PointerScanLevel = results.get_pointer_scan_level_copy(1);
        let mut root_ids: [u64; 4] = [0, 0, 0, 0];
        let root_page: ExpandedNodePage = results.get_expanded_node_page(
            false,
            0,
            0,
            4,
            &mut root_ids
        );
        let chain_root: PointerScanNode = FixtureKit::page_node_by_address(&results, &root_ids, 4112);
        let chain_root_id: u64 = chain_root.get_node_id();
        let chain_root_static: bool = FixtureKit::node_is_static(&chain_root);
        // Deviation: upstream asserts module_name == "game.exe"; here name
        // identity is carried by len==8 plus module_offset/module_index.
        // A byte-equality walk machine blew the check budget on this graph.
        let chain_name: &[u8] = chain_root.get_module_name();
        let chain_name_len: u64 = chain_name.len;
        let direct_root: PointerScanNode = FixtureKit::page_node_by_address(&results, &root_ids, 4144);
        let direct_root_static: bool = FixtureKit::node_is_static(&direct_root);
        let direct_name: &[u8] = direct_root.get_module_name();
        let direct_name_len: u64 = direct_name.len;
        let mut child_ids: [u64; 4] = [0, 0, 0, 0];
        let child_page: ExpandedNodePage = results.get_expanded_node_page(
            true,
            chain_root_id,
            0,
            4,
            &mut child_ids
        );
        let child: PointerScanNode = FixtureKit::page_node_by_address(&results, &child_ids, 4112);
        let child_id: u64 = child.get_node_id();
        let child_static: bool = FixtureKit::node_is_static(&child);
        let child_name: &[u8] = child.get_module_name();
        let child_name_len: u64 = child_name.len;
        let mut grandchild_ids: [u64; 4] = [0, 0, 0, 0];
        let grandchild_page: ExpandedNodePage = results.get_expanded_node_page(
            true,
            child_id,
            0,
            4,
            &mut grandchild_ids
        );
        let grandchild: PointerScanNode = FixtureKit::page_node_by_address(&results, &grandchild_ids, 8192);
        let grandchild_static: bool = FixtureKit::node_is_static(&grandchild);

        results.get_session_id() == 41 && results.get_root_node_count() == 2 && results.get_total_node_count() == 3 && results.get_total_static_node_count() == 2 && results.get_total_heap_node_count() == 1 && results.get_pointer_scan_level_count() == 2 && level0.get_depth() == 1 && level0.get_node_count() == 2 && level0.get_static_node_count() == 1 && level0.get_heap_node_count() == 1 && level1.get_depth() == 2 && level1.get_node_count() == 1 && level1.get_static_node_count() == 1 && level1.get_heap_node_count() == 0 && root_page.node_count == 2 && chain_root.get_pointer_address() == 4112 && chain_root.get_depth() == 1 && chain_root_static && chain_name_len == 8 && chain_root.get_module_offset() == 16 && chain_root.get_resolved_target_address() == 8176 && chain_root.get_pointer_offset() == 0 && chain_root.has_children() && child_page.node_count == 1 && child.get_pointer_address() == 4112 && child_static && child.get_depth() == 2 && child.get_resolved_target_address() == 8192 && child_name_len == 8 && child.get_pointer_offset() == 16 && child.has_children() && grandchild_page.node_count == 1 && grandchild.get_pointer_address() == 8192 && !grandchild_static && grandchild.get_depth() == 3 && grandchild.get_resolved_target_address() == 12304 && grandchild.get_pointer_offset() == 16 && !grandchild.has_children() && direct_root.get_pointer_address() == 4144 && direct_root_static && direct_root.get_depth() == 1 && direct_name_len == 8 && direct_root.get_module_offset() == 48 && direct_root.get_resolved_target_address() == 12304 && direct_root.get_pointer_offset() == -16 && !direct_root.has_children()
}

// CHECK-LEVEL orchestration witness (not in the entry cone): drives the
// full PointerScanCommandExecutor chain — Start -> Summary -> Expand ->
// Reset — against an EnginePrivilegedState whose supplied memory seeds the
// upstream pointer-chain fixture (base 0x1000, 520-element u64 window;
// values 8176@idx2 / 12320@idx6 / 12288@idx256; module "game.exe"
// [0x1000, +256); hex target 0x3010). Same geometry as the raw
// execute_scan witness — roots {0x1010,0x1030}, total 3, statics 2, heap
// 1, 2 levels — now produced through the start-request executor and the
// session results store instead of caller-assembled scratch.
// native_blocked: entry-cone walls catalogue on the FixtureKit banner
// above (union command values, record lets, call-produced records).
pub machine FixtureKit::verify_pointer_scan_orchestration() -> bool
crashes Abort
{
    transition { _ -> scan() }

    state scan() -> bool {
        let mut engine_privileged_state: EnginePrivilegedState = EnginePrivilegedState::new();
        engine_privileged_state.init();
        engine_privileged_state.set_opened_process_fixture(1);
        engine_privileged_state.set_supplied_memory_fixture(4096, 520);
        engine_privileged_state.seed_supplied_element(2, 8176);
        engine_privileged_state.seed_supplied_element(6, 12320);
        engine_privileged_state.seed_supplied_element(256, 12288);
        let module_name: [u8; 8] = [103, 97, 109, 101, 46, 101, 120, 101];
        let module_pushed: bool = engine_privileged_state.push_supplied_module(&module_name, 4096, 256);
        let container_type: ContainerType = ContainerType::default();
        let target_string: AnonymousValueString = AnonymousValueString::new(
            "0x3010",
            AnonymousValueStringFormat::Hexadecimal,
            container_type
        );
        let target_request: PointerScanTargetRequest = PointerScanTargetRequest::address(target_string);
        let request: PointerScanStartRequest = PointerScanStartRequest::new(
            target_request,
            PointerScanPointerSize::Pointer64,
            3,
            32,
            PointerScanAddressSpace::Auto
        );
        let response: PointerScanResponse = PointerScanCommandExecutor::execute(
            &mut engine_privileged_state,
            PointerScanCommand::Start { request: request }
        );
        transition module_pushed {
            true -> started(&mut engine_privileged_state, response)
            false -> (false)
        }
    }

    state started(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: PointerScanResponse
    ) -> bool {
        transition response {
            PointerScanResponse::Start { response } -> checked_start(&mut engine_privileged_state, response)
            _ -> (false)
        }
    }

    state checked_start(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: PointerScanStartResponse
    ) -> bool {
        let summary: StoredPointerScanSummary = response.pointer_scan_summary;
        let session_id: u64 = summary.get_session_id();
        let ok: bool = response.success
            && response.has_pointer_scan_summary
            && session_id == 1
            && summary.get_root_node_count() == 2
            && summary.get_total_node_count() == 3
            && summary.get_total_static_node_count() == 2
            && summary.get_total_heap_node_count() == 1
            && summary.get_level_summary_count() == 2;
        transition ok {
            true -> summarize(&mut engine_privileged_state)
            false -> (false)
        }
    }

    state summarize(engine_privileged_state: &mut EnginePrivilegedState) -> bool {
        let response: PointerScanResponse = PointerScanCommandExecutor::execute(
            engine_privileged_state,
            PointerScanCommand::Summary {
                request: PointerScanSummaryRequest::of_session(1)
            }
        );
        transition response {
            PointerScanResponse::Summary { response } -> checked_summary(&mut engine_privileged_state, response)
            _ -> (false)
        }
    }

    state checked_summary(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: PointerScanSummaryResponse
    ) -> bool {
        let summary: StoredPointerScanSummary = response.pointer_scan_summary;
        let ok: bool = response.has_pointer_scan_summary
            && summary.get_session_id() == 1
            && summary.get_root_node_count() == 2
            && summary.get_total_node_count() == 3
            && summary.get_level_summary_count() == 2;
        transition ok {
            true -> expand(&mut engine_privileged_state)
            false -> (false)
        }
    }

    state expand(engine_privileged_state: &mut EnginePrivilegedState) -> bool {
        let response: PointerScanResponse = PointerScanCommandExecutor::execute(
            engine_privileged_state,
            PointerScanCommand::Expand {
                request: PointerScanExpandRequest::new(1, false, 0, 0, 4)
            }
        );
        transition response {
            PointerScanResponse::Expand { response } -> checked_expand(&mut engine_privileged_state, response)
            _ -> (false)
        }
    }

    state checked_expand(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: PointerScanExpandResponse
    ) -> bool {
        let node0: PointerScanNode = response.pointer_scan_nodes[0];
        let node1: PointerScanNode = response.pointer_scan_nodes[1];
        let addr0: u64 = node0.get_pointer_address();
        let addr1: u64 = node1.get_pointer_address();
        // Root page = both level-1 roots (upstream ordering by pointer
        // address: 0x1010 then 0x1030); asserted unordered so page order is
        // not a spec input here.
        let roots_ok: bool = (addr0 == 4112 && addr1 == 4144) || (addr0 == 4144 && addr1 == 4112);
        let ok: bool = response.pointer_scan_node_count == 2
            && response.total_node_count == 3
            && response.session_id == 1
            && roots_ok;
        transition ok {
            true -> reset(&mut engine_privileged_state)
            false -> (false)
        }
    }

    state reset(engine_privileged_state: &mut EnginePrivilegedState) -> bool {
        let response: PointerScanResponse = PointerScanCommandExecutor::execute(
            engine_privileged_state,
            PointerScanCommand::Reset { request: PointerScanResetRequest {} }
        );
        transition response {
            PointerScanResponse::Reset { response } -> cleared(&mut engine_privileged_state, response)
            _ -> (false)
        }
    }

    state cleared(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: PointerScanResetResponse
    ) -> bool {
        let results_cleared: bool = !engine_privileged_state.pointer_scan_results_store.has_results();
        response.success && results_cleared
    }
}

// CHECK-LEVEL freeze/set_property witness (not in the entry cone): drives
// ScanResultsCommandExecutor::Freeze + SetProperty + the session freeze task
// over the seeded 8-element u64 snapshot (region [0x1000, +64), element 2 =
// address 0x1010). Asserts the upstream contract: freeze registers the
// (module_offset, module_name) key and captures the current value;
// freeze_values rewrites it after mutation; set_property "is_frozen" fires
// the internal freeze request both directions; set_property "value" writes
// the deanonymized bytes.
// native_blocked: same entry-cone wall catalogue as the other fixtures.
pub machine FixtureKit::verify_scan_results_freeze() -> bool
crashes Abort
{
    transition { _ -> scan() }

    state scan() -> bool {
        let mut engine_privileged_state: EnginePrivilegedState = EnginePrivilegedState::new();
        engine_privileged_state.init();
        engine_privileged_state.set_opened_process_fixture(1);
        engine_privileged_state.set_supplied_memory_fixture(4096, 8);
        engine_privileged_state.seed_supplied_element(2, 999);
        engine_privileged_state.seed_scan_snapshot_fixture();
        engine_privileged_state.initialize_scan_results_fixture();
        let module_name: [u8; 8] = [103, 97, 109, 101, 46, 101, 120, 101];
        let module_pushed: bool = engine_privileged_state.push_supplied_module(&module_name, 4096, 256);
        transition module_pushed {
            true -> freeze(&mut engine_privileged_state)
            false -> (false)
        }
    }

    // Freeze ref index 2 (address 0x1010, value 999, inside "game.exe").
    state freeze(engine_privileged_state: &mut EnginePrivilegedState) -> bool {
        let mut refs: ScanResultRefList = ScanResultRefList::empty();
        let scan_ref: ScanResultRef = ScanResultRef::new(2, false);
        let pushed: bool = refs.push(&scan_ref);
        let request: ScanResultsFreezeRequest = ScanResultsFreezeRequest::new(refs, true);
        let response: ScanResultsResponse = ScanResultsCommandExecutor::execute(
            engine_privileged_state,
            ScanResultsCommand::Freeze { request: request }
        );
        transition response {
            ScanResultsResponse::Freeze { response } -> frozen(&mut engine_privileged_state, response)
            _ -> (false)
        }
    }

    state frozen(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: ScanResultsFreezeResponse
    ) -> bool {
        let frozen_count: u64 = engine_privileged_state.get_freeze_list_count();
        let ok: bool = response.get_failed_count() == 0 && frozen_count == 1;
        transition ok {
            true -> mutate(&mut engine_privileged_state)
            false -> (false)
        }
    }

    // Mutate the live element, then let the freeze task restore it.
    state mutate(engine_privileged_state: &mut EnginePrivilegedState) -> bool {
        engine_privileged_state.seed_supplied_element(2, 555);
        let written: u64 = SnapshotScanResultFreezeTask::freeze_values(engine_privileged_state);
        let restored: u64 = engine_privileged_state.get_supplied_memory_source().read_u64(4112);
        let ok: bool = written == 1 && restored == 999;
        transition ok {
            true -> unfreeze(&mut engine_privileged_state)
            false -> (false)
        }
    }

    // set_property "is_frozen"="0" -> internal freeze request unfrozen arm.
    state unfreeze(engine_privileged_state: &mut EnginePrivilegedState) -> bool {
        let mut refs: ScanResultRefList = ScanResultRefList::empty();
        let scan_ref: ScanResultRef = ScanResultRef::new(2, false);
        let pushed: bool = refs.push(&scan_ref);
        let container_type: ContainerType = ContainerType::default();
        let value_string: AnonymousValueString = AnonymousValueString::new(
            "0",
            AnonymousValueStringFormat::Decimal,
            container_type
        );
        let request: ScanResultsSetPropertyRequest = ScanResultsSetPropertyRequest::new(
            refs,
            value_string,
            "is_frozen"
        );
        let response: ScanResultsResponse = ScanResultsCommandExecutor::execute(
            engine_privileged_state,
            ScanResultsCommand::SetProperty { request: request }
        );
        let remaining: u64 = engine_privileged_state.get_freeze_list_count();
        transition response.is_set_property() && remaining == 0 {
            true -> refreeze(&mut engine_privileged_state)
            false -> (false)
            _ -> (false)
        }
    }

    // set_property "is_frozen"="1" -> freeze arm registers the key again.
    state refreeze(engine_privileged_state: &mut EnginePrivilegedState) -> bool {
        let mut refs: ScanResultRefList = ScanResultRefList::empty();
        let scan_ref: ScanResultRef = ScanResultRef::new(2, false);
        let pushed: bool = refs.push(&scan_ref);
        let container_type: ContainerType = ContainerType::default();
        let value_string: AnonymousValueString = AnonymousValueString::new(
            "1",
            AnonymousValueStringFormat::Decimal,
            container_type
        );
        let request: ScanResultsSetPropertyRequest = ScanResultsSetPropertyRequest::new(
            refs,
            value_string,
            "is_frozen"
        );
        let response: ScanResultsResponse = ScanResultsCommandExecutor::execute(
            engine_privileged_state,
            ScanResultsCommand::SetProperty { request: request }
        );
        let frozen_again: u64 = engine_privileged_state.get_freeze_list_count();
        transition response.is_set_property() && frozen_again == 1 {
            true -> set_value(&mut engine_privileged_state)
            false -> (false)
            _ -> (false)
        }
    }

    // set_property "value"="777" -> deanonymized write to 0x1010.
    state set_value(engine_privileged_state: &mut EnginePrivilegedState) -> bool {
        let mut refs: ScanResultRefList = ScanResultRefList::empty();
        let scan_ref: ScanResultRef = ScanResultRef::new(2, false);
        let pushed: bool = refs.push(&scan_ref);
        let container_type: ContainerType = ContainerType::default();
        let value_string: AnonymousValueString = AnonymousValueString::new(
            "777",
            AnonymousValueStringFormat::Decimal,
            container_type
        );
        let request: ScanResultsSetPropertyRequest = ScanResultsSetPropertyRequest::new(
            refs,
            value_string,
            "value"
        );
        let response: ScanResultsResponse = ScanResultsCommandExecutor::execute(
            engine_privileged_state,
            ScanResultsCommand::SetProperty { request: request }
        );
        let current: u64 = engine_privileged_state.get_supplied_memory_source().read_u64(4112);
        response.is_set_property() && current == 777
    }
}

// Value-target resolution witness (upstream resolve_value_target end to
// end): a Value-typed target request runs the exact-Equal element scan
// over the snapshot's collected current values and resolves the collected
// hit addresses into the results store. u8 elements at the supplied region
// are [55, 0, 55, 2, 55, 0, 55, 4] — Equal(55) matches offsets 0/2/4/6
// -> {0x1000, 0x1002, 0x1004, 0x1006}.
pub machine FixtureKit::verify_value_targets() -> bool
crashes Abort
{
    transition { _ -> scan() }

    state scan() -> bool {
        let mut engine_privileged_state: EnginePrivilegedState = EnginePrivilegedState::new();
        engine_privileged_state.init();
        engine_privileged_state.set_opened_process_fixture(1);
        engine_privileged_state.set_supplied_memory_fixture(4096, 8);
        engine_privileged_state.seed_supplied_element(0, 55);
        engine_privileged_state.seed_supplied_element(2, 55);
        engine_privileged_state.seed_supplied_element(3, 2);
        engine_privileged_state.seed_supplied_element(4, 55);
        engine_privileged_state.seed_supplied_element(6, 55);
        engine_privileged_state.seed_supplied_element(7, 4);
        let u8_id: [u8; 2] = [117, 56];
        let u8_type: DataTypeRef = DataTypeRef::new(&u8_id);
        let container_type: ContainerType = ContainerType::default();
        let target_string: AnonymousValueString = AnonymousValueString::new(
            "55",
            AnonymousValueStringFormat::Decimal,
            container_type
        );
        let target_request: PointerScanTargetRequest = PointerScanTargetRequest::value(
            target_string, u8_type);
        let request: PointerScanStartRequest = PointerScanStartRequest::new(
            target_request,
            PointerScanPointerSize::Pointer64,
            3,
            32,
            PointerScanAddressSpace::Auto
        );
        let response: PointerScanResponse = PointerScanCommandExecutor::execute(
            &mut engine_privileged_state,
            PointerScanCommand::Start { request: request }
        );
        transition { _ -> started(&mut engine_privileged_state, response) }
    }

    state started(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: PointerScanResponse
    ) -> bool {
        transition response {
            PointerScanResponse::Start { response } -> checked(&mut engine_privileged_state, response)
            _ -> (false)
        }
    }

    // The stored targets carry the Value descriptor + the four collected
    // addresses; upstream asserts the same post-scan store contents.
    state checked(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: PointerScanStartResponse
    ) -> bool {
        let descriptor_is_value: bool = engine_privileged_state
            .pointer_scan_results_store
            .target_descriptor
            .is_value_descriptor();
        let count_ok: bool = engine_privileged_state
            .pointer_scan_results_store
            .target_address_count == 4;
        let addresses_ok: bool = engine_privileged_state
                .pointer_scan_results_store
                .target_addresses[0] == 4096
            && engine_privileged_state
                .pointer_scan_results_store
                .target_addresses[1] == 4098
            && engine_privileged_state
                .pointer_scan_results_store
                .target_addresses[2] == 4100
            && engine_privileged_state
                .pointer_scan_results_store
                .target_addresses[3] == 4102;
        (response.success && descriptor_is_value && count_ok && addresses_ok)
    }
}
