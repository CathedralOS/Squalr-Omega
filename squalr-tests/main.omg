                    has_scan_function: false,
                    scan_function: ScanFunctionScalar::Immediate,
                    finalized_tail: false
                },
                has_single_pending: false,
                pending_region: SnapshotRegionFilter::new(0, 0)
            }
        ];
        let mut round_a: [SnapshotRegionFilter; 8] = [SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0)];
        let mut round_b: [SnapshotRegionFilter; 8] = [SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0), SnapshotRegionFilter::new(0, 0)];
        let report: ElementScanReport = ElementScanner::scan_snapshot(
            &mut snapshot,
            &element_scan_plan,
            &mut scan_control,
            &mut seed_filters,
            &mut seed_collections,
            &mut result_collections,
            &mut filter_out,
            &mut current_elements,
            &mut previous_elements,
            &mut driver_cell,
            &mut round_a,
            &mut round_b
        );
        let emitted_addrs: ScanResultAddresses = Snapshot::collect_scan_result_addresses_for_data_type(&snapshot, 
            &u8_emit
        );
        let emitted: u64 = ScanResultAddresses::get_address_count(&emitted_addrs);
        let snap_region_count: u64 = Snapshot::get_region_count(&snapshot);
        let scanned_bytes: u64 = ElementScanReport::get_scanned_byte_count(&report);
        let processed: u64 = ElementScanReport::get_processed_region_count(&report);
        let total_results: u64 = ElementScanReport::get_result_count(&report);
    snap_region_count == 0 && scanned_bytes == 0 && processed == 1 && total_results == 0 && emitted == 0
}


// Decimal emission: digits land LSD-first then reverse (same shape as
// ProcName); the line "ticks=<n>" goes to the console for the driver.
machine Main::emit_u64(main: &mut Main, value: u64)
reaches Console
invokes Console;
{
    main.digit_len = 0;
    transition { _ -> emit_state(main, value) }
    state emit_state(main: &mut Main, value: u64) {
        transition { _ -> emit_step(main, value) }
    }
    state emit_step(main: &mut Main, value: u64) {
        transition value > 0 || main.digit_len == 0 {
            true -> digit_bound(main, value)
            false -> reverse_start(main)
        }
    }
    state digit_bound(main: &mut Main, value: u64) {
        transition main.digit_len < 24 {
            true -> take_digit(main, value)
            false -> reverse_start(main)
        }
    }
    state take_digit(main: &mut Main, value: u64) {
        transition main.digit_len < 24 {
            true -> store_digit(main, value, main.digit_len)
            false -> reverse_start(main)
        }
    }
    state store_digit(main: &mut Main, value: u64, len: u64)
    requires 0 <= len && len < 24;
    {
        main.digit_buf[len] = ((48 as u64 in Wrapping) + ((value % 10) as u64 as u64 in Wrapping)) as u64 as u8;
        main.digit_len = ((len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> emit_step(main, value / 10) }
    }
    state reverse_start(main: &mut Main) {
        main.digit_pos = 0;
        transition { _ -> reverse_step(main) }
    }
    state reverse_step(main: &mut Main) {
        transition main.digit_pos < main.digit_len / 2 {
            true -> swap_digit(main)
            false -> print_bound(main)
        }
    }
    state swap_digit(main: &mut Main) {
        transition main.digit_pos < 24 {
            true -> swap_bound(main)
            false -> print_bound(main)
        }
    }
    state swap_bound(main: &mut Main) {
        main.swap_index = ((((main.digit_len as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64 as u64 in Wrapping) - (main.digit_pos as u64 in Wrapping)) as u64;
        transition main.swap_index < 24 && main.digit_pos < 24 {
            true -> swap_move(main, main.digit_pos, main.swap_index)
            false -> print_bound(main)
        }
    }
    state swap_move(main: &mut Main, pos_lo: u64, idx: u64)
    requires 0 <= pos_lo && pos_lo < 24 && 0 <= idx && idx < 24;
    {
        let left: u8 = main.digit_buf[pos_lo];
        main.digit_buf[pos_lo] = main.digit_buf[idx];
        main.digit_buf[idx] = left;
        main.digit_pos = ((pos_lo as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> reverse_step(main) }
    }
    state print_bound(main: &mut Main) {
        transition main.digit_len <= 24 {
            true -> print_at(main, 0, main.digit_len)
            false -> emit_done(main)
        }
    }
    state print_at(main: &mut Main, i: u64, len: u64)
    requires 0 <= len && len <= 24;
    {
        transition i < len {
            true -> print_byte(main, i, len)
            false -> print_nl(main)
        }
    }
    state print_byte(main: &mut Main, i: u64, len: u64)
    requires 0 <= len && len <= 24;
    {
        transition i < 24 {
            true -> write_digit(main, i, len)
            false -> print_nl(main)
        }
    }
    state write_digit(main: &mut Main, i: u64, len: u64)
    requires 0 <= i && i < 24 && 0 <= len && len <= 24;
    {
        let b: i32 = main.digit_buf[i] as i32;
        Console::write_byte(b);
        transition { _ -> print_at(main, ((i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, len) }
    }
    state print_nl(main: &mut Main) {
        Console::write_byte(10);
        transition { _ -> emit_done(main) }
    }
    state emit_done(main: &mut Main) {
    }
}

machine hex_value(byte: u8) -> u64 {
    transition byte >= 48 && byte <= 57 {
        true -> dec(byte)
        false -> alpha(byte)
    }
    state dec(byte: u8) -> u64 {
        (((byte as u64) as u64 in Wrapping) - (48 as u64 in Wrapping)) as u64
    }
    state alpha(byte: u8) -> u64 {
        transition byte >= 97 && byte <= 102 {
            true -> lower(byte)
            false -> upper(byte)
        }
    }
    state lower(byte: u8) -> u64 {
        (((byte as u64) as u64 in Wrapping) - (87 as u64 in Wrapping)) as u64
    }
    state upper(byte: u8) -> u64 {
        transition byte >= 65 && byte <= 70 {
            true -> up(byte)
            false -> invalid(byte)
        }
    }
    state up(byte: u8) -> u64 {
        (((byte as u64) as u64 in Wrapping) - (55 as u64 in Wrapping)) as u64
    }
    state invalid(byte: u8) -> u64 {
        16
    }
}


// Pointer-scan materialization witness — port of upstream's
// execute_scan_builds_pointer_chains_and_classifies_static_nodes test:
// a pointer-scan run produces collected candidate addresses through the
// dispatcher -> collector -> results path, materializing chain nodes owned
// by the results partition. Upstream builds three 0x40-byte regions at
// 0x1000/0x2000/0x3000; the port bounds snapshots at one snap_region, so the
// fixture collapses to a single 0x1000..0x2040 snap_region covering every read
// site (gap bytes read as zero and produce no candidates — 0 is neither in
// module range nor in any target range).
machine FixtureKit::absent_node() -> PointerScanNode {
    let empty: [u8; 1] = [0];
    (PointerScanNode::new_materialized(0, 0, 0, 0, 0, false, 0, PointerScanNodeType::Heap, 0, 0, 0, 0, &empty, 0, false))
}

machine FixtureKit::node_at<'e, 'sh, 's, 'h>(results: &PointerScanResults<'e, 'sh, 's, 'h>, node_id: u64) -> PointerScanNode {
    let lookup: MaterializedNodeLookup = PointerScanResults::find_materialized_node(results, node_id);
    transition lookup.found {
        true -> (PointerScanResults::copy_materialized_node(results, lookup.index))
        false -> (FixtureKit::absent_node())
        _ -> (FixtureKit::absent_node())
    }
}

machine FixtureKit::node_is_static(node: &PointerScanNode) -> bool {
    transition PointerScanNode::get_pointer_scan_node_type(node) {
        PointerScanNodeType::Static -> (true)
        _ -> (false)
    }
}

// Upstream's `.find(|n| n.get_pointer_address() == want)` over an expanded
// page — order-independent node lookup by pointer address.
machine FixtureKit::page_node_by_address<'e, 'sh, 's, 'h>(results: &PointerScanResults<'e, 'sh, 's, 'h>, ids: &[u64], want_address: u64) -> PointerScanNode {
    transition { _ -> walk(results, ids, want_address, 0) }
    state walk(results: &PointerScanResults<'e, 'sh, 's, 'h>, ids: &[u64], want_address: u64, position: u64) -> PointerScanNode {
        transition position < ids.len {
            true -> probe(results, ids, want_address, position)
            false -> absent()
        }
    }
    state probe(results: &PointerScanResults<'e, 'sh, 's, 'h>, ids: &[u64], want_address: u64, position: u64) -> PointerScanNode
    requires 0 <= position && position < ids.len;
    {
        let node: PointerScanNode = FixtureKit::node_at(results, ids[position]);
        transition PointerScanNode::get_pointer_address(&node) == want_address {
            true -> (node)
            false -> next(results, ids, want_address, position)
        }
    }
    state next(results: &PointerScanResults<'e, 'sh, 's, 'h>, ids: &[u64], want_address: u64, position: u64) -> PointerScanNode {
        let advanced: u64 = ((position as u64 in Wrapping) + 1) as u64;
        transition { _ -> walk(results, ids, want_address, advanced) }
    }
    state absent() -> PointerScanNode {
        (FixtureKit::absent_node())
    }
}

