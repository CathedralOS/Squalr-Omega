use omega_language_std::console;
use omega_language_std::filesystem_host;
use omega_language_std::time_host;
use omega::language::core::service;
use squalr_engine_api::src::plugins::memory_view::page_retrieval_mode::PageRetrievalMode;
use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::memory::normalized_region::NormalizedRegion;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::processes::process_info::ProcessInfo;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_session::src::os::engine_os_provider::EngineOsProviders;
use squalr_engine_targets::src::target_providers::MemoryBoundsOpen;
use squalr_engine_targets::src::target_providers::MemoryBoundsStep;
use squalr_engine_targets::src::target_providers::MemoryReadResult;
use squalr_engine_targets::src::target_providers::OpenedProcessResult;
use squalr_engine_targets::src::target_providers::ProcessQueryOutcome;

// squalr-tests native probe for TARGETS-AND-THROUGHPUT. Default run keeps the
// upstream geometry canary verbatim. When /tmp/squalr-native-probe.control
// exists the driver is exercising the native-read leg: the file carries
// "<pid> <page_addr_hex> <guard_addr_hex>" for a controlled child (its own
// process, paused on stdin) — omega run passes a null stdin, so the handoff
// is file-based.
data Main {
    console: Service<Console>;
    raw_fs: Service<FilesystemHost>;
    time: Service<TimeHost>;
    providers: EngineOsProviders;

    // Control file parse registers.
    control_fd: i32;
    control: [u8; 64];
    control_len: i64;
    pos: u64;
    pid_u64: u64;
    page_addr: u64;
    guard_addr: u64;

    // Probe registers.
    proc_info: ProcessInfo;
    open_result: OpenedProcessResult;
    opened: OpenedProcessInfo;
    bounds_open: MemoryBoundsOpen;
    step_result: MemoryBoundsStep;
    read_result: MemoryReadResult;
    close_result: ProcessQueryOutcome;
    region: NormalizedRegion;
    region_count: u64;
    found_page: bool;
    found_guard: bool;
    writable_page: bool;
    writable_guard: bool;
    magic_buf: [u8; 16];
    part_buf: [u8; 32];
    read_buf: [u8; 4096];
    chunk_i: u64;
    cancel_after: u64;
    cancelled: bool;
    iter_i: u64;
    t0: u64;
    t1: u64;
    rate: u64;
    digit_buf: [u8; 24];
    digit_len: u64;
    digit_pos: u64;
    swap_index: u64;
}

machine Main::main(this: &mut Main) reaches Console + FilesystemHost + TimeHost
invokes Console;
invokes FilesystemHost;
invokes TimeHost;
{
    // Gate: no control file -> the ordinary geometry canary.
    this.control_fd = open(this.raw_fs, "/tmp/squalr-native-probe.control", 0);
    transition this.control_fd >= 0 {
        true -> probe_control(this)
        false -> geometry(this)
    }

    // ---------- native-read probe ----------

    state probe_control(this: &mut Main) {
        this.control_len = read(this.raw_fs, this.control_fd, &mut this.control, 64);
        this.cancelled = close(this.raw_fs, this.control_fd) != 0;
        this.pid_u64 = 0;
        this.page_addr = 0;
        this.guard_addr = 0;
        this.pos = 0;
        transition this.control_len > 0 {
            true -> parse_pid(this)
            false -> probe_fail_control(this)
        }
    }

    state parse_pid(this: &mut Main) {
        transition this.pos < 64 {
            true -> parse_pid_in(this)
            false -> parse_addr1(this)
        }
    }

    state parse_pid_in(this: &mut Main) {
        transition this.pos < (this.control_len as u64 in Trapping) {
            true -> parse_pid_test(this)
            false -> parse_addr1(this)
        }
    }

    state parse_pid_test(this: &mut Main) {
        transition this.control[this.pos] >= 48 {
            true -> parse_pid_high(this)
            false -> parse_addr1(this)
        }
    }

    state parse_pid_high(this: &mut Main) {
        transition this.control[this.pos] <= 57 {
            true -> parse_pid_step(this)
            false -> parse_addr1(this)
        }
    }

    state parse_pid_step(this: &mut Main) {
        this.pid_u64 = ((((this.pid_u64 as u64 in Wrapping) * (10 as u64 in Wrapping)) as u64 as u64 in Wrapping) - ((((this.control[this.pos] as u64) as u64 in Wrapping) - (48 as u64 in Wrapping)) as u64 as u64 in Wrapping)) as u64;
        this.pos = ((this.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> parse_pid(this) }
    }

    state parse_addr1(this: &mut Main) {
        this.pos = ((this.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_page(this) }
    }

    state hex_page(this: &mut Main) {
        transition this.pos < 64 {
            true -> hex_page_in(this)
            false -> parse_addr2(this)
        }
    }

    state hex_page_in(this: &mut Main) {
        transition this.pos < (this.control_len as u64 in Trapping) {
            true -> hex_page_val(this)
            false -> parse_addr2(this)
        }
    }

    state hex_page_val(this: &mut Main) {
        this.digit_len = hex_value(this, this.control[this.pos]);
        transition this.digit_len < 16 {
            true -> hex_page_step(this)
            false -> parse_addr2(this)
        }
    }

    state hex_page_step(this: &mut Main) {
        this.page_addr = ((((this.page_addr as u64 in Wrapping) * (16 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (this.digit_len as u64 in Wrapping)) as u64;
        this.pos = ((this.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_page(this) }
    }

    state parse_addr2(this: &mut Main) {
        this.pos = ((this.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_guard(this) }
    }

    state hex_guard(this: &mut Main) {
        transition this.pos < 64 {
            true -> hex_guard_in(this)
            false -> open_target(this)
        }
    }

    state hex_guard_in(this: &mut Main) {
        transition this.pos < (this.control_len as u64 in Trapping) {
            true -> hex_guard_val(this)
            false -> open_target(this)
        }
    }

    state hex_guard_val(this: &mut Main) {
        this.digit_len = hex_value(this, this.control[this.pos]);
        transition this.digit_len < 16 {
            true -> hex_guard_step(this)
            false -> open_target(this)
        }
    }

    state hex_guard_step(this: &mut Main) {
        this.guard_addr = ((((this.guard_addr as u64 in Wrapping) * (16 as u64 in Wrapping)) as u64 as u64 in Wrapping) + (this.digit_len as u64 in Wrapping)) as u64;
        this.pos = ((this.pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> hex_guard(this) }
    }

    // open_process: pid handle + bitness read of /proc/<pid>/exe.
    state open_target(this: &mut Main) {
        this.proc_info = ProcessInfo::new_named((this.pid_u64 as u32 in Trapping) as u32, "squalr-child", false);
        this.open_result = open_process(this.providers, &this.proc_info);
        transition this.open_result {
            OpenedProcessResult::Opened { info } -> have_open(this, info)
            OpenedProcessResult::Failed { error } -> probe_fail_open(this)
        }
    }

    state have_open(this: &mut Main, info: OpenedProcessInfo) {
        this.opened = info;
        let hoist1: u64 = get_pointer_width(this.opened);
        transition hoist1 == 8 {
            true -> enum_open(this)
            false -> probe_fail_bitness(this)
        }
    }

    // Enumerate page bounds: the child's RW page must appear, the PROT_NONE
    // guard must not (no WRITE bit => filtered from a FromUserMode view? no —
    // FromUserMode has empty required flags, so the guard page CAN appear;
    // what must not appear is any read of it. Containment is recorded, not
    // required).
    state enum_open(this: &mut Main) {
        this.bounds_open = open_page_bounds(this.providers, &this.opened, PageRetrievalMode::FromUserMode);
        this.region_count = 0;
        this.found_page = false;
        this.found_guard = false;
        transition this.bounds_open {
            MemoryBoundsOpen::Opened -> enum_step(this)
            MemoryBoundsOpen::Failed -> probe_fail_enum(this)
        }
    }

    state enum_step(this: &mut Main) {
        this.step_result = next_page_bounds_region(this.providers, &mut this.region);
        transition this.step_result {
            MemoryBoundsStep::Region -> enum_record(this)
            MemoryBoundsStep::Finished -> enum_done(this)
            MemoryBoundsStep::Failed -> probe_fail_enum(this)
        }
    }

    state enum_record(this: &mut Main) {
        this.region_count = ((this.region_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let hoist2: bool = contains_address(this.region, this.page_addr);
        transition hoist2 {
            true -> mark_page(this)
            false -> check_guard(this)
        }
    }

    state mark_page(this: &mut Main) {
        this.found_page = true;
        transition { _ -> enum_step(this) }
    }

    state check_guard(this: &mut Main) {
        let hoist3: bool = contains_address(this.region, this.guard_addr);
        transition hoist3 {
            true -> mark_guard(this)
            false -> enum_step(this)
        }
    }

    state mark_guard(this: &mut Main) {
        this.found_guard = true;
        transition { _ -> enum_step(this) }
    }

    state enum_done(this: &mut Main) {
        transition this.region_count > 0 && this.found_page {
            true -> writable_checks(this)
            false -> probe_fail_enum(this)
        }
    }

    state writable_checks(this: &mut Main) {
        this.writable_page = is_address_writable(this.providers, &this.opened, this.page_addr);
        this.writable_guard = is_address_writable(this.providers, &this.opened, this.guard_addr);
        transition this.writable_page && !this.writable_guard {
            true -> read_magic(this)
            false -> probe_fail_writable(this)
        }
    }

    // Full read of the magic at page start.
    state read_magic(this: &mut Main) {
        this.read_result = read_bytes(this.providers, &this.opened, this.page_addr, &mut this.magic_buf);
        transition this.read_result {
            MemoryReadResult::Complete { count } -> check_magic(this, count)
            MemoryReadResult::Partial { count } -> probe_fail_read(this)
            MemoryReadResult::Failed -> probe_fail_read(this)
        }
    }

    state check_magic(this: &mut Main, count: u64) {
        // Child wrote "SQUALR42" then a rising pattern at page start.
        transition count == 16 && this.magic_buf[0] == 83 && this.magic_buf[1] == 81 && this.magic_buf[2] == 85 && this.magic_buf[3] == 65 && this.magic_buf[4] == 76 && this.magic_buf[5] == 82 && this.magic_buf[6] == 52 && this.magic_buf[7] == 50 {
            true -> read_partial(this)
            false -> probe_fail_magic(this)
        }
    }

    // Partial read straddling the PROT_NONE guard: 32 requested at
    // page_addr+4080 => 16 come back.
    state read_partial(this: &mut Main) {
        this.read_result = read_bytes(this.providers, &this.opened, ((this.page_addr as u64 in Wrapping) + (4080 as u64 in Wrapping)) as u64, &mut this.part_buf);
        transition this.read_result {
            MemoryReadResult::Partial { count } -> check_partial(this, count)
            MemoryReadResult::Complete { count } -> check_partial(this, count)
            MemoryReadResult::Failed -> probe_fail_partial(this)
        }
    }

    state check_partial(this: &mut Main, count: u64) {
        // page0[i] = 83 + (i & 63) past the 8-byte magic: offsets 4080->131, 4095->146.
        transition count == 16 && this.part_buf[0] == 131 && this.part_buf[15] == 146 {
            true -> read_guard(this)
            false -> probe_fail_partial(this)
        }
    }

    // Disappearing/unreadable page: reading the PROT_NONE guard fails (EIO),
    // and no bytes are invented.
    state read_guard(this: &mut Main) {
        this.read_result = read_bytes(this.providers, &this.opened, this.guard_addr, &mut this.magic_buf);
        transition this.read_result {
            MemoryReadResult::Failed -> cancel_probe(this)
            MemoryReadResult::Complete { count } -> check_guard_count(this, count)
            MemoryReadResult::Partial { count } -> check_guard_count(this, count)
        }
    }

    state check_guard_count(this: &mut Main, count: u64) {
        transition count == 0 {
            true -> cancel_probe(this)
            false -> probe_fail_guard(this)
        }
    }

    // Cancellation: a chunked read honoring a cancellation flag between
    // chunks (upstream scan loops poll the token identically). The flag flips
    // after 2 of 4 planned chunks; the loop must stop early.
    state cancel_probe(this: &mut Main) {
        this.chunk_i = 0;
        this.cancel_after = 2;
        this.cancelled = false;
        transition { _ -> cancel_step(this) }
    }

    state cancel_step(this: &mut Main) {
        transition !this.cancelled && this.chunk_i < 4 {
            true -> cancel_read(this)
            false -> cancel_check(this)
        }
    }

    state cancel_read(this: &mut Main) {
        this.read_result = read_bytes(this.providers, &this.opened, this.page_addr, &mut this.read_buf);
        this.chunk_i = ((this.chunk_i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> cancel_tick(this) }
    }

    state cancel_tick(this: &mut Main) {
        transition this.chunk_i >= this.cancel_after {
            true -> cancel_set(this)
            false -> cancel_step(this)
        }
    }

    state cancel_set(this: &mut Main) {
        this.cancelled = true;
        transition { _ -> cancel_step(this) }
    }

    state cancel_check(this: &mut Main) {
        transition this.chunk_i == 2 && this.cancelled {
            true -> throughput(this)
            false -> probe_fail_cancel(this)
        }
    }

    // Throughput leg: 8 x 4096-byte reads, TimeHost-timed, printed in decimal.
    state throughput(this: &mut Main) {
        this.iter_i = 0;
        this.t0 = monotonic_ticks(this.time);
        transition { _ -> throughput_step(this) }
    }

    state throughput_step(this: &mut Main) {
        transition this.iter_i < 8 {
            true -> throughput_read(this)
            false -> throughput_done(this)
        }
    }

    state throughput_read(this: &mut Main) {
        this.read_result = read_bytes(this.providers, &this.opened, this.page_addr, &mut this.read_buf);
        this.iter_i = ((this.iter_i as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> throughput_step(this) }
    }

    state throughput_done(this: &mut Main) {
        this.t1 = monotonic_ticks(this.time);
        this.rate = ((this.t1 as u64 in Wrapping) - (this.t0 as u64 in Wrapping)) as u64;
        write_line(this.console, "native-read bytes=32768");
        transition { _ -> emit_ticks(this) }
    }

    state emit_ticks(this: &mut Main) {
        emit_u64(this, this.rate);
        transition { _ -> close_target(this) }
    }

    state close_target(this: &mut Main) {
        let handle: u64 = get_handle(this.opened);
        this.close_result = close_process(this.providers, handle);
        transition this.close_result {
            ProcessQueryOutcome::Succeeded -> alive_check(this)
            ProcessQueryOutcome::Failed { error } -> probe_fail_close(this)
        }
    }

    // The child is still alive (driver owns it) — liveness via /proc probe.
    state alive_check(this: &mut Main) {
        let hoist4: ProcessAliveResult = is_process_alive(this.providers, (this.pid_u64 as u32 in Trapping) as u32);
        transition hoist4 {
            true -> probe_pass(this)
            false -> probe_fail_alive(this)
        }
    }

    state probe_pass(this: &mut Main) {
        write_line(this.console, "Squalr native-read: PASS");
        exit_process(this.console, 0);
    }

    state probe_fail_control(this: &mut Main) {
        write_line(this.console, "FAIL: native-probe control");
        exit_process(this.console, 2);
    }

    state probe_fail_open(this: &mut Main) {
        write_line(this.console, "FAIL: native-probe open");
        exit_process(this.console, 3);
    }

    state probe_fail_bitness(this: &mut Main) {
        write_line(this.console, "FAIL: native-probe bitness");
        exit_process(this.console, 4);
    }

    state probe_fail_enum(this: &mut Main) {
        write_line(this.console, "FAIL: native-probe enumerate");
        exit_process(this.console, 5);
    }

    state probe_fail_writable(this: &mut Main) {
        write_line(this.console, "FAIL: native-probe writable");
        exit_process(this.console, 6);
    }

    state probe_fail_read(this: &mut Main) {
        write_line(this.console, "FAIL: native-probe read");
        exit_process(this.console, 7);
    }

    state probe_fail_magic(this: &mut Main) {
        write_line(this.console, "FAIL: native-probe magic");
        exit_process(this.console, 8);
    }

    state probe_fail_partial(this: &mut Main) {
        write_line(this.console, "FAIL: native-probe partial");
        exit_process(this.console, 9);
    }

    state probe_fail_guard(this: &mut Main) {
        write_line(this.console, "FAIL: native-probe guard");
        exit_process(this.console, 10);
    }

    state probe_fail_cancel(this: &mut Main) {
        write_line(this.console, "FAIL: native-probe cancel");
        exit_process(this.console, 11);
    }

    state probe_fail_close(this: &mut Main) {
        write_line(this.console, "FAIL: native-probe close");
        exit_process(this.console, 12);
    }

    state probe_fail_alive(this: &mut Main) {
        write_line(this.console, "FAIL: native-probe alive");
        exit_process(this.console, 13);
    }

    // ---------- geometry canary (unchanged) ----------

    state geometry(this: &mut Main) {
        let aligned: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 16);
        let count: u64 = get_element_count(aligned, 4, MemoryAlignment::Alignment4);
        transition count == 4 {
            true -> overlap(this)
            false -> failed(this)
        }
    }

    state overlap(this: &mut Main) {
        let overlapping: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 6);
        let count: u64 = get_element_count(overlapping, 4, MemoryAlignment::Alignment1);
        transition count == 3 {
            true -> sparse(this)
            false -> failed(this)
        }
    }

    state sparse(this: &mut Main) {
        let sparse_filter: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 16);
        let count: u64 = get_element_count(sparse_filter, 4, MemoryAlignment::Alignment8);
        transition count == 2 {
            true -> single_overlap(this)
            false -> failed(this)
        }
    }

    state single_overlap(this: &mut Main) {
        let single: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 4);
        let count: u64 = get_element_count(single, 4, MemoryAlignment::Alignment1);
        transition count == 1 {
            true -> partial_stride(this)
            false -> failed(this)
        }
    }

    state partial_stride(this: &mut Main) {
        let partial: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 7);
        let count: u64 = get_element_count(partial, 4, MemoryAlignment::Alignment2);
        transition count == 2 {
            true -> sub_stride(this)
            false -> failed(this)
        }
    }

    state sub_stride(this: &mut Main) {
        // Preserve upstream coverage/stride division, not a different start-count formula.
        let small: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 4);
        let count: u64 = get_element_count(small, 4, MemoryAlignment::Alignment8);
        transition count == 0 {
            true -> saturation(this)
            false -> failed(this)
        }
    }

    state saturation(this: &mut Main) {
        let overflow: SnapshotRegionFilter = SnapshotRegionFilter::new(18446744073709551614u64, 8);
        let end_address: u64 = get_end_address(overflow);
        transition end_address == 18446744073709551615u64 {
            true -> mutation(this)
            false -> failed(this)
        }
    }

    state mutation(this: &mut Main) {
        let mut filter: SnapshotRegionFilter = SnapshotRegionFilter::new(100, 16);
        set_base_address(filter, 200);
        let end_address: u64 = get_end_address(filter);
        set_end_address(filter, 199);
        let size: u64 = get_region_size(filter);
        transition end_address == 216 && size == 0 {
            true -> equality(this)
            false -> failed(this)
        }
    }

    state equality(this: &mut Main) {
        let first: SnapshotRegionFilter = SnapshotRegionFilter::new(100, 16);
        let same: SnapshotRegionFilter = SnapshotRegionFilter::new(100, 16);
        let different: SnapshotRegionFilter = SnapshotRegionFilter::new(100, 8);
        let same_result: bool = equals(first, &same);
        let different_result: bool = equals(first, &different);
        transition same_result && !different_result {
            true -> inclusive_end(this)
            false -> failed(this)
        }
    }

    state inclusive_end(this: &mut Main) {
        let end_region: NormalizedRegion = NormalizedRegion::new(100, 16);
        let includes_end: bool = contains_address(end_region, 116);
        let includes_after: bool = contains_address(end_region, 117);
        transition includes_end && !includes_after {
            true -> retained_end(this)
            false -> failed(this)
        }
    }

    state retained_end(this: &mut Main) {
        let mut keep_region: NormalizedRegion = NormalizedRegion::new(100, 16);
        set_region_size(keep_region, 24);
        set_base_address_retain_end_address(keep_region, 104);
        let base_address: u64 = get_base_address(keep_region);
        let end_address: u64 = get_end_address(keep_region);
        let size: u64 = get_region_size(keep_region);
        transition base_address == 104 && end_address == 124 && size == 20 {
            true -> alignment_conversion(this)
            false -> failed(this)
        }
    }

    state alignment_conversion(this: &mut Main) {
        let default_alignment: MemoryAlignment = MemoryAlignment::default();
        let fallback_alignment: MemoryAlignment = MemoryAlignment::from(3);
        let default_size: u64 = get_size_in_bytes(default_alignment);
        let fallback_size: u64 = get_size_in_bytes(fallback_alignment);
        transition default_size == 4 && fallback_size == 1 {
            true -> passed(this)
            false -> failed(this)
        }
    }

    state passed(this: &mut Main) {
        write_line(this.console, "Squalr geometry: PASS");
        exit_process(this.console, 0);
    }

    state failed(this: &mut Main) {
        write_line(this.console, "FAIL: SnapshotRegionFilter geometry");
        exit_process(this.console, 1);
    }
}

// Decimal emission: digits land LSD-first then reverse (same shape as
// ProcName); the line "ticks=<n>" goes to the console for the driver.
machine Main::emit_u64(this: &mut Main, value: u64)
reaches Console
{
    this.digit_len = 0;
    transition { _ -> emit_state(this, value) }
    state emit_state(this: &mut Main, value: u64) {
        transition { _ -> emit_step(this, value) }
    }
    state emit_step(this: &mut Main, value: u64) {
        transition value > 0 || this.digit_len == 0 {
            true -> digit_bound(this, value)
            false -> reverse_start(this)
        }
    }
    state digit_bound(this: &mut Main, value: u64) {
        transition this.digit_len < 24 {
            true -> take_digit(this, value)
            false -> reverse_start(this)
        }
    }
    state take_digit(this: &mut Main, value: u64) {
        this.digit_buf[this.digit_len] = ((48 as u64 in Wrapping) + ((value % 10) as u64 as u64 in Wrapping)) as u64 as u8;
        this.digit_len = ((this.digit_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> emit_step(this, value / 10) }
    }
    state reverse_start(this: &mut Main) {
        this.digit_pos = 0;
        transition { _ -> reverse_step(this) }
    }
    state reverse_step(this: &mut Main) {
        transition this.digit_pos < this.digit_len / 2 {
            true -> swap_digit(this)
            false -> print_bound(this)
        }
    }
    state swap_digit(this: &mut Main) {
        transition this.digit_pos < 24 {
            true -> swap_bound(this)
            false -> print_bound(this)
        }
    }
    state swap_bound(this: &mut Main) {
        this.swap_index = ((((this.digit_len as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64 as u64 in Wrapping) - (this.digit_pos as u64 in Wrapping)) as u64;
        transition this.swap_index < 24 {
            true -> swap_move(this)
            false -> print_bound(this)
        }
    }
    state swap_move(this: &mut Main) {
        let left: u8 = this.digit_buf[this.digit_pos];
        this.digit_buf[this.digit_pos] = this.digit_buf[this.swap_index];
        this.digit_buf[this.swap_index] = left;
        this.digit_pos = ((this.digit_pos as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> reverse_step(this) }
    }
    state print_bound(this: &mut Main) {
        transition this.digit_len <= 24 {
            true -> print_line(this)
            false -> emit_done(this)
        }
    }
    state print_line(this: &mut Main) {
        write_line(this.console, this.digit_buf[0..this.digit_len]);
        transition { _ -> emit_done(this) }
    }
    state emit_done(this: &mut Main) {
    }
}

machine Main::hex_value(this: &Main, byte: u8) -> u64 {
    transition byte >= 48 && byte <= 57 {
        true -> dec(this, byte)
        false -> alpha(this, byte)
    }
    state dec(this: &Main, byte: u8) -> u64 {
        (((byte as u64) as u64 in Wrapping) - (48 as u64 in Wrapping)) as u64
    }
    state alpha(this: &Main, byte: u8) -> u64 {
        transition byte >= 97 && byte <= 102 {
            true -> lower(this, byte)
            false -> upper(this, byte)
        }
    }
    state lower(this: &Main, byte: u8) -> u64 {
        (((byte as u64) as u64 in Wrapping) - (87 as u64 in Wrapping)) as u64
    }
    state upper(this: &Main, byte: u8) -> u64 {
        transition byte >= 65 && byte <= 70 {
            true -> up(this, byte)
            false -> invalid(this, byte)
        }
    }
    state up(this: &Main, byte: u8) -> u64 {
        (((byte as u64) as u64 in Wrapping) - (55 as u64 in Wrapping)) as u64
    }
    state invalid(this: &Main, byte: u8) -> u64 {
        16
    }
}
