// Package boundary and internal edges mirror upstream squalr-tests/Cargo.toml.
machine build(builder: &mut Build) {
    Build::application(builder, "squalr_tests");
    Build::depend(builder, Source::Path { location: "../squalr-engine" });
    Build::depend(builder, Source::Path { location: "../squalr-engine-api" });
    Build::depend(builder, Source::Path { location: "../squalr-engine-scanning" });
    Build::depend(builder, Source::Path { location: "../squalr-engine-session" });
    Build::depend(builder, Source::Path { location: "../squalr-engine-targets" });
    Build::depend(builder, Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "438173f7da3e27c24bf4ac710714039937367cee",
        selection: PackageSelection::Named { package: "omega_language_std" }
    });
    builder.roots.bind(windows_x86_64::ProgramEntry, Main::main);
    builder.roots.bind(linux_x86_64::ProgramEntry, Main::main);
    builder.roots.bind(linux_arm64::ProgramEntry, Main::main);
    builder.roots.bind(macos_arm64::ProgramEntry, Main::main);
}
