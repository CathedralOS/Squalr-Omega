// Package boundary and internal edges mirror upstream squalr-engine/Cargo.toml.
machine build(builder: &mut Build) {
    builder.package("squalr-engine");
    builder.depend(Source::Path { location: "../squalr-engine-api" });
    builder.depend(Source::Path { location: "../squalr-engine-session" });
    builder.depend(Source::Path { location: "../squalr-engine-projects" });
    builder.depend(Source::Path { location: "../squalr-engine-scanning" });
}
