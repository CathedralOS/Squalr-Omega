// Package boundary and internal edges mirror upstream squalr-engine/Cargo.toml.
machine build(builder: &mut Build) {
    Build::package(builder, "squalr_engine");
    Build::depend(builder, Source::Path { location: "../squalr-engine-api" });
    Build::depend(builder, Source::Path { location: "../squalr-engine-session" });
    Build::depend(builder, Source::Path { location: "../squalr-engine-projects" });
    Build::depend(builder, Source::Path { location: "../squalr-engine-scanning" });
    // Upstream reaches squalr-engine-targets types through
    // `squalr_engine_session::os` `pub use` re-exports; Omega has no
    // re-export, so the query option/outcome types need the direct edge.
    Build::depend(builder, Source::Path { location: "../squalr-engine-targets" });
    Build::depend(builder, Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "fef76bc46fc70ee30378c7ca42abf787728433be",
        selection: PackageSelection::Named { package: "omega_language_std" }
    });
}
