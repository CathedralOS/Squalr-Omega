// Package boundary and internal edges mirror upstream squalr-engine/Cargo.toml.
machine build(builder: &mut Build) {
    builder.package("squalr_engine");
    builder.depend(Source::Path { location: "../squalr-engine-api" });
    builder.depend(Source::Path { location: "../squalr-engine-session" });
    builder.depend(Source::Path { location: "../squalr-engine-projects" });
    builder.depend(Source::Path { location: "../squalr-engine-scanning" });
    // Upstream reaches squalr-engine-targets types through
    // `squalr_engine_session::os` `pub use` re-exports; Omega has no
    // re-export, so the query option/outcome types need the direct edge.
    builder.depend(Source::Path { location: "../squalr-engine-targets" });
    builder.depend(Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "10f4821bdabfb70c7d428afdd952f7fcf54378e2",
        selection: PackageSelection::Named { package: "omega_language_std" }
    });
}
