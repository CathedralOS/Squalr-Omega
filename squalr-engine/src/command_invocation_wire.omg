module src::command_invocation_wire;

use squalr_engine_api::src::commands::command_invocation::CommandInvocation;
use squalr_engine_api::src::commands::command_invocation::EngineCommand;
use squalr_engine_api::src::commands::command_invocation::EngineCommandResponse;
use squalr_engine_api::src::commands::privileged_command::PrivilegedCommand;
use squalr_engine_api::src::commands::privileged_command_response::PrivilegedCommandResponse;
use src::squalr_engine::SqualrEngine;
use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;

// L1 invocation wire seam. Upstream routes a CommandInvocation through the
// unprivileged state's dispatcher onto a pipe transport; this leg keeps the
// synchronous executor path — `send_invocation` unwraps the envelope's
// engine command and borrows it into `dispatch_command`. The
// CommandInvocationOutcome interception (decide_command/decide_response
// middleware) and the fetch_add invocation-id allocator stay deferred to
// the unprivileged-state port, the next sub-leg off the framer.
pub data CommandInvocationWireModule {}

pub machine CommandInvocationWireModule::send_invocation(
    engine: &mut SqualrEngine,
    invocation: &CommandInvocation
) -> EngineCommandResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let command: &EngineCommand = invocation.get_command();
    transition command {
        EngineCommand::Privileged { command } -> dispatch(engine, command)
    }

    state dispatch(
        engine: &mut SqualrEngine,
        command: &PrivilegedCommand
    ) -> EngineCommandResponse {
        let response: PrivilegedCommandResponse = engine.dispatch_command(command);
        (EngineCommandResponse::Privileged { response: response })
    }
}
