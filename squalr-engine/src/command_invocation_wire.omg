use {omega}/language/core/filesystem_authority.omg;
use {omega}/language/core/wait_wake.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/commands/command_invocation.omg;
use {squalr_engine_api}/src/commands/privileged_command.omg;
use {squalr_engine_api}/src/commands/privileged_command_response.omg;
use {squalr_engine_api}/src/engine/privileged_response_mailbox.omg;
use {squalr_engine_session}/src/engine_unprivileged_state.omg;
use src/squalr_engine.omg;
use src/engine_bindings/standalone_engine_api_unprivileged_bindings.omg;

// Invocation wire — upstream `EngineUnprivilegedState::
// dispatch_privileged_command_invocation` verbatim: create (fetch_add
// allocator on the unprivileged state), prepare (invocation middleware
// walk), the Respond/Reject short-circuit arms, then
// `engine_api_unprivileged_bindings.dispatch_privileged_command` whose
// callback is the response publisher middleware+listener walk. The
// upstream worker-thread hop and crossbeam callback collapse to the
// caller-owned `PrivilegedResponseMailbox` — the synchronous bindings
// record delivers the response inside the dispatch call, so the
// publisher still wraps the delivery exactly as upstream's callback does.
// Returns upstream's dispatch-accepted bool: false when middleware
// rejects, when a synthetic response is type-mismatched, or when the
// bindings hop itself refuses.
public data CommandInvocationWireModule {}

public machine CommandInvocationWireModule::send_invocation(
    engine: &mut |squalr_engine|::SqualrEngine,
    source: |command_invocation|::CommandInvocationSource,
    privileged_command: |privileged_command|::PrivilegedCommand,
    out_response: &mut |privileged_response_mailbox|::PrivilegedResponseMailbox
) -> bool
reaches |wait_wake|::WaitWake
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |wait_wake|::WaitWake;
invokes |posix_filesystem_host|::PosixFilesystemHost;
crashes Abort
crashes Trap
{
    let command_invocation: |command_invocation|::CommandInvocation = |engine_unprivileged_state|::EngineUnprivilegedState::create_command_invocation(&mut engine.engine_unprivileged_state, source,
        |command_invocation|::EngineCommand::Privileged { command: privileged_command });
    let plan: |engine_unprivileged_state|::CommandDispatchPlan = |engine_unprivileged_state|::EngineUnprivilegedState::prepare_command_invocation(&mut engine.engine_unprivileged_state, command_invocation);
    transition plan {
        |engine_unprivileged_state|::CommandDispatchPlan::Dispatch { invocation } -> extract(engine, invocation, out_response)
        |engine_unprivileged_state|::CommandDispatchPlan::Respond { invocation, response } -> respond(engine, invocation, response, out_response)
        |engine_unprivileged_state|::CommandDispatchPlan::Reject { invocation, reason, reason_len } -> reject(engine, &invocation, reason, reason_len)
        _ -> (false)
    }

    // Upstream `Respond` — publish the synthetic response through the
    // response-middleware walk; a delivered Privileged response reaches the
    // caller's callback (the mailbox). A non-Privileged synthetic response
    // is the upstream "mismatched synthetic response" error arm.
    machine respond(
        engine: &mut |squalr_engine|::SqualrEngine,
        invocation: |command_invocation|::CommandInvocation,
        response: |command_invocation|::EngineCommandResponse,
        out_response: &mut |privileged_response_mailbox|::PrivilegedResponseMailbox
    ) -> bool {
        transition response {
            |command_invocation|::EngineCommandResponse::Privileged { response } -> publish(engine, &invocation, |command_invocation|::EngineCommandResponse::Privileged { response: response }, out_response)
            _ -> mismatched(engine, &invocation)
        }
    }

    // Upstream `Reject` — warn through the session's log surface before
    // dispatch; the command never reaches the bindings.
    machine reject(
        engine: &mut |squalr_engine|::SqualrEngine,
        invocation: &|command_invocation|::CommandInvocation,
        reason: [u8; 256],
        reason_len: u64
    ) -> bool {
        |engine_unprivileged_state|::EngineUnprivilegedState::log_rejected_invocation(&mut engine.engine_unprivileged_state, invocation, reason, reason_len);
        (false)
    }

    machine mismatched(engine: &mut |squalr_engine|::SqualrEngine, invocation: &|command_invocation|::CommandInvocation) -> bool {
        |engine_unprivileged_state|::EngineUnprivilegedState::log_mismatched_invocation_response(&mut engine.engine_unprivileged_state, invocation);
        (false)
    }

    // Upstream's `let EngineCommand::Privileged(command) =
    // dispatch_invocation.get_command()` — a middleware that rewrote the
    // command into a non-privileged one fails here (impossible today:
    // EngineCommand has only the Privileged case).
    machine extract(
        engine: &mut |squalr_engine|::SqualrEngine,
        invocation: |command_invocation|::CommandInvocation,
        out_response: &mut |privileged_response_mailbox|::PrivilegedResponseMailbox
    ) -> bool {
        let command: &|command_invocation|::EngineCommand = |command_invocation|::CommandInvocation::get_command(&invocation);
        transition command {
            |command_invocation|::EngineCommand::Privileged { command } -> dispatch(engine, &invocation, command, out_response)
        }
    }

    // Upstream `engine_bindings.dispatch_privileged_command(command,
    // publisher-callback)` — the standalone bindings record executes
    // synchronously into the mailbox, then the response publisher runs
    // (upstream wraps the callback in `command_response_publisher`).
    machine dispatch(
        engine: &mut |squalr_engine|::SqualrEngine,
        invocation: &|command_invocation|::CommandInvocation,
        command: &|privileged_command|::PrivilegedCommand,
        out_response: &mut |privileged_response_mailbox|::PrivilegedResponseMailbox
    ) -> bool {
        let mut mailbox: |privileged_response_mailbox|::PrivilegedResponseMailbox = |privileged_response_mailbox|::PrivilegedResponseMailbox::default();
        _ = |standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings::dispatch_privileged_command(&mut engine.engine_bindings, command, &mut mailbox);
        transition mailbox {
            |privileged_response_mailbox|::PrivilegedResponseMailbox::Delivered { response } -> publish(engine, invocation, |command_invocation|::EngineCommandResponse::Privileged { response: response }, out_response)
            |privileged_response_mailbox|::PrivilegedResponseMailbox::Empty -> (false)
            _ -> (false)
        }
    }

    // Upstream `command_response_publisher(invocation, response)` followed
    // by `callback(response)` — publish may suppress (middleware) or
    // replace; only a delivered Privileged response reaches the caller.
    machine publish(
        engine: &mut |squalr_engine|::SqualrEngine,
        invocation: &|command_invocation|::CommandInvocation,
        response: |command_invocation|::EngineCommandResponse,
        out_response: &mut |privileged_response_mailbox|::PrivilegedResponseMailbox
    ) -> bool {
        let publication: |engine_unprivileged_state|::CommandPublicationResult = |engine_unprivileged_state|::EngineUnprivilegedState::publish_command_response(&mut engine.engine_unprivileged_state, invocation, response);
        transition publication {
            |engine_unprivileged_state|::CommandPublicationResult::Delivered { response } -> deliver(response, out_response)
            |engine_unprivileged_state|::CommandPublicationResult::Suppressed { reason, reason_len } -> (false)
            _ -> (false)
        }
    }
    machine deliver(
        response: |command_invocation|::EngineCommandResponse,
        out_response: &mut |privileged_response_mailbox|::PrivilegedResponseMailbox
    ) -> bool {
        transition response {
            |command_invocation|::EngineCommandResponse::Privileged { response } -> store(response, out_response)
            _ -> (false)
        }
    }
    machine store(
        response: |privileged_command_response|::PrivilegedCommandResponse,
        out_response: &mut |privileged_response_mailbox|::PrivilegedResponseMailbox
    ) -> bool {
        |privileged_response_mailbox|::PrivilegedResponseMailbox::deliver(&mut out_response, response);
        (true)
    }
}
