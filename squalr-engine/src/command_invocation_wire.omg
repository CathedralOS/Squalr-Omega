module src::command_invocation_wire;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::command_invocation::CommandInvocation;
use squalr_engine_api::src::commands::command_invocation::CommandInvocationSource;
use squalr_engine_api::src::commands::command_invocation::EngineCommand;
use squalr_engine_api::src::commands::command_invocation::EngineCommandResponse;
use squalr_engine_api::src::commands::privileged_command::PrivilegedCommand;
use squalr_engine_api::src::commands::privileged_command_response::PrivilegedCommandResponse;
use squalr_engine_api::src::engine::privileged_response_mailbox::PrivilegedResponseMailbox;
use squalr_engine_session::src::engine_unprivileged_state::CommandDispatchPlan;
use squalr_engine_session::src::engine_unprivileged_state::CommandPublicationResult;
use src::squalr_engine::SqualrEngine;

// Invocation wire — upstream `EngineUnprivilegedState::
// dispatch_privileged_command_invocation` verbatim: create (fetch_add
// allocator on the unprivileged state), prepare (invocation middleware
// walk), the Respond/Reject short-circuit arms, then
// `engine_api_unprivileged_bindings.dispatch_privileged_command` whose
// callback is the response publisher middleware+listener walk. The
// upstream worker-thread hop and crossbeam callback collapse to the
// caller-owned `PrivilegedResponseMailbox` — the synchronous bindings
// record delivers the response inside the dispatch call, so the
// publisher still wraps the delivery exactly as upstream's callback does.
// Returns upstream's dispatch-accepted bool: false when middleware
// rejects, when a synthetic response is type-mismatched, or when the
// bindings hop itself refuses.
pub data CommandInvocationWireModule {}

pub machine CommandInvocationWireModule::send_invocation(
    engine: &mut SqualrEngine,
    source: CommandInvocationSource,
    privileged_command: PrivilegedCommand,
    out_response: &mut PrivilegedResponseMailbox
) -> bool
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let command_invocation: CommandInvocation = EngineUnprivilegedState::create_command_invocation(&mut engine.engine_unprivileged_state, source,
        EngineCommand::Privileged { command: privileged_command });
    let plan: CommandDispatchPlan = EngineUnprivilegedState::prepare_command_invocation(&mut engine.engine_unprivileged_state, command_invocation);
    transition plan {
        CommandDispatchPlan::Dispatch { invocation } -> extract(engine, invocation, out_response)
        CommandDispatchPlan::Respond { invocation, response } -> respond(engine, invocation, response, out_response)
        CommandDispatchPlan::Reject { invocation, reason, reason_len } -> reject(engine, &invocation, reason, reason_len)
        _ -> (false)
    }

    // Upstream `Respond` — publish the synthetic response through the
    // response-middleware walk; a delivered Privileged response reaches the
    // caller's callback (the mailbox). A non-Privileged synthetic response
    // is the upstream "mismatched synthetic response" error arm.
    state respond(
        engine: &mut SqualrEngine,
        invocation: CommandInvocation,
        response: EngineCommandResponse,
        out_response: &mut PrivilegedResponseMailbox
    ) -> bool {
        transition response {
            EngineCommandResponse::Privileged { response } -> publish(engine, &invocation, EngineCommandResponse::Privileged { response: response }, out_response)
            _ -> mismatched(engine, &invocation)
        }
    }

    // Upstream `Reject` — warn through the session's log surface before
    // dispatch; the command never reaches the bindings.
    state reject(
        engine: &mut SqualrEngine,
        invocation: &CommandInvocation,
        reason: [u8; 256],
        reason_len: u64
    ) -> bool {
        EngineUnprivilegedState::log_rejected_invocation(&mut engine.engine_unprivileged_state, invocation, reason, reason_len);
        (false)
    }

    state mismatched(engine: &mut SqualrEngine, invocation: &CommandInvocation) -> bool {
        EngineUnprivilegedState::log_mismatched_invocation_response(&mut engine.engine_unprivileged_state, invocation);
        (false)
    }

    // Upstream's `let EngineCommand::Privileged(command) =
    // dispatch_invocation.get_command()` — a middleware that rewrote the
    // command into a non-privileged one fails here (impossible today:
    // EngineCommand has only the Privileged case).
    state extract(
        engine: &mut SqualrEngine,
        invocation: CommandInvocation,
        out_response: &mut PrivilegedResponseMailbox
    ) -> bool {
        let command: &EngineCommand = CommandInvocation::get_command(&invocation);
        transition command {
            EngineCommand::Privileged { command } -> dispatch(engine, &invocation, command, out_response)
        }
    }

    // Upstream `engine_bindings.dispatch_privileged_command(command,
    // publisher-callback)` — the standalone bindings record executes
    // synchronously into the mailbox, then the response publisher runs
    // (upstream wraps the callback in `command_response_publisher`).
    state dispatch(
        engine: &mut SqualrEngine,
        invocation: &CommandInvocation,
        command: &PrivilegedCommand,
        out_response: &mut PrivilegedResponseMailbox
    ) -> bool {
        let mut mailbox: PrivilegedResponseMailbox = PrivilegedResponseMailbox::default();
        _ = StandaloneEngineApiUnprivilegedBindings::dispatch_privileged_command(&mut engine.engine_bindings, command, &mut mailbox);
        transition mailbox {
            PrivilegedResponseMailbox::Delivered { response } -> publish(engine, invocation, EngineCommandResponse::Privileged { response: response }, out_response)
            PrivilegedResponseMailbox::Empty -> (false)
            _ -> (false)
        }
    }

    // Upstream `command_response_publisher(invocation, response)` followed
    // by `callback(response)` — publish may suppress (middleware) or
    // replace; only a delivered Privileged response reaches the caller.
    state publish(
        engine: &mut SqualrEngine,
        invocation: &CommandInvocation,
        response: EngineCommandResponse,
        out_response: &mut PrivilegedResponseMailbox
    ) -> bool {
        let publication: CommandPublicationResult = EngineUnprivilegedState::publish_command_response(&mut engine.engine_unprivileged_state, invocation, response);
        transition publication {
            CommandPublicationResult::Delivered { response } -> deliver(response, out_response)
            CommandPublicationResult::Suppressed { reason, reason_len } -> (false)
            _ -> (false)
        }
    }
    state deliver(
        response: EngineCommandResponse,
        out_response: &mut PrivilegedResponseMailbox
    ) -> bool {
        transition response {
            EngineCommandResponse::Privileged { response } -> store(response, out_response)
            _ -> (false)
        }
    }
    state store(
        response: PrivilegedCommandResponse,
        out_response: &mut PrivilegedResponseMailbox
    ) -> bool {
        PrivilegedResponseMailbox::deliver(&mut out_response, response);
        (true)
    }
}
