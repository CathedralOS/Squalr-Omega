// Headless CLI scan driver — the supplied-snapshot testing adapter for the
// scalar scan path. Upstream's scan leg builds its snapshot from a live
// process's memory pages and seeds each region through
// initialize_scan_results; the supplied snapshot stands in for that target
// leg (AGENTS.md allows supplied snapshots as test adapters). The driver
// owns the flat storage that the port's borrowed-extent structures need,
// seeds one region of known little-endian u64 elements, runs a u64 == value
// immediate scan through the request executor, and reports the produced
// result count plus the first two matched filter bounds so the CLI can
// print and assert them.
pub data CliScanDriver {
    region_current_bytes: [u8; 32];
    region_previous_bytes: [u8; 8];
    page_boundaries: [u64; 8];
    page_tombstones: [u64; 8];
    deleted_result_indices: [u64; 8];
    region_order: [u64; 4];
    collection_filters: [SnapshotRegionFilter; 16];
    collection_runs: [u64; 8];
    input_filters: [SnapshotRegionFilter; 8];
    input_runs: [u64; 8];
    type_id_input: [u8; 3];
    type_id_set: [u8; 3];
    type_id_value: [u8; 3];
    type_id_output: [u8; 3];
    value_bytes: [u8; 8];
    mask_bytes: [u8; 8];
    scratch_current: [u64; 16];
    scratch_previous: [u64; 16];
    chain_a: [SnapshotRegionFilter; 16];
    chain_b: [SnapshotRegionFilter; 16];
    out_filters: [SnapshotRegionFilter; 16];
    out_runs: [u64; 8];
    cell_filter_counts: [u64; 4];
    cell_run_counts: [u64; 4];
}

// Compact scan outcome for the CLI to print and assert on. The two matched
// filter bounds are the first two surviving filters of the region's first
// scan-result collection; a field stays 0 when fewer matches were produced.
pub data HeadlessScanReport {
    scanned_byte_count: u64;
    processed_region_count: u64;
    result_count: u64;
    first_filter_base: u64;
    first_filter_size: u64;
    second_filter_base: u64;
    second_filter_size: u64;
}

pub machine HeadlessScanReport::get_scanned_byte_count(&self) -> u64 {
    (self.scanned_byte_count)
}

pub machine HeadlessScanReport::get_processed_region_count(&self) -> u64 {
    (self.processed_region_count)
}

pub machine HeadlessScanReport::get_result_count(&self) -> u64 {
    (self.result_count)
}

pub machine HeadlessScanReport::get_first_filter_base(&self) -> u64 {
    (self.first_filter_base)
}

pub machine HeadlessScanReport::get_first_filter_size(&self) -> u64 {
    (self.first_filter_size)
}

pub machine HeadlessScanReport::get_second_filter_base(&self) -> u64 {
    (self.second_filter_base)
}

pub machine HeadlessScanReport::get_second_filter_size(&self) -> u64 {
    (self.second_filter_size)
}

