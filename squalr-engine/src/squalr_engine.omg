// Port of squalr_engine.rs for the headless leg. Upstream's
// `Option<Arc<EnginePrivilegedState>>` + `Option<Arc<EngineUnprivilegedState>>`
// + `Arc<RwLock<dyn EngineApiUnprivilegedBindings>>` trio collapses to
// single-owner fields: the standalone bindings record owns the privileged
// state (upstream's shared Arc), the unprivileged state sits beside it,
// and dispatch is synchronous — commands complete before returning, so
// no TrackableTask crosses the wire (named deviation). Upstream
// PrivilegedShell mode leaves the unprivileged state unconstructed —
// the port keeps both fields present and simply never drives the
// unprivileged side there (upstream's Option<> collapses to a
// never-read zero-init field; `has_engine_unprivileged_state` documents
// the arm for consumers that probe presence).
public data SqualrEngine {
    engine_mode: |engine_mode|::EngineMode;
    has_engine_unprivileged_state: bool;
    engine_unprivileged_state: |engine_unprivileged_state|::EngineUnprivilegedState;
    engine_bindings: |standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings;
}

// Re-entrant initializer for hosts (the CLI's `Main`) that own an
// already-constructed engine slot — the entry context cannot bind a
// structural local or call-source assignment, so construction lands
// through a `&mut` receiver instead.
public machine SqualrEngine::init(this: &mut SqualrEngine, engine_mode: |engine_mode|::EngineMode) {
    this.engine_mode = engine_mode;
    this.has_engine_unprivileged_state = true;
    this.engine_unprivileged_state = |engine_unprivileged_state|::EngineUnprivilegedState::new();
    this.engine_bindings = |standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings::new();
}

// No-arg entry-context variant: the entry machine's closure cannot
// construct or pass union values, so the headless CLI's fixed launch
// mode is pinned here where ordinary semantics apply.
public machine SqualrEngine::init_privileged_shell(this: &mut SqualrEngine) {
    // Union field stores cannot appear anywhere in the entry's transitive
    // unit plan, so `engine_mode` keeps its zero-initialized first case
    // (`Standalone`). Upstream PrivilegedShell constructs no unprivileged
    // state — the flag + zero-init field spell that arm.
    this.has_engine_unprivileged_state = false;
    |standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings::init(&mut this.engine_bindings);
}

// Upstream `EngineMode::Standalone` construction for headless hosts —
// the cli's interactive path. The privileged state lives inside the
// standalone bindings record (upstream's shared Arc collapses to sole
// ownership there); the unprivileged state mints alongside it and gets
// `initialize`'s lifecycle hook.
public machine SqualrEngine::init_standalone(this: &mut SqualrEngine) {
    this.has_engine_unprivileged_state = true;
    |standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings::init(&mut this.engine_bindings);
    |engine_unprivileged_state|::EngineUnprivilegedState::init(&mut this.engine_unprivileged_state);
    _ = |engine_unprivileged_state|::EngineUnprivilegedState::initialize(&mut this.engine_unprivileged_state);
}

public machine SqualrEngine::new(engine_mode: |engine_mode|::EngineMode) -> SqualrEngine {
    SqualrEngine {
        engine_mode: engine_mode,
        has_engine_unprivileged_state: true,
        engine_unprivileged_state: |engine_unprivileged_state|::EngineUnprivilegedState::new(),
        engine_bindings: |standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings::new(),
    }
}

public machine SqualrEngine::get_mode(this: &SqualrEngine) -> |engine_mode|::EngineMode {
    this.engine_mode
}

// Test-side process open — the adapter's equivalent of `open_process`
// completing; `scan new` requires an opened process upstream.
public machine SqualrEngine::open_process(this: &mut SqualrEngine, process_id: u32) {
    // Entry plans cannot move the aggregate across the call boundary, so the
    // fixture variant builds it inside the owning state.
    let privileged: &mut |engine_privileged_state|::EnginePrivilegedState = |standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings::borrow_engine_privileged_state_mut(&mut this.engine_bindings);
    |engine_privileged_state|::EnginePrivilegedState::set_opened_process_fixture(privileged, process_id);
}

// Install the supplied memory regions the CLI's `--memory` flag captures —
// the adapter's stand-in for a real target's page map + contents.
public machine SqualrEngine::supply_memory(this: &mut SqualrEngine, source: |supplied_memory_source|::SuppliedMemorySource) {
    let privileged: &mut |engine_privileged_state|::EnginePrivilegedState = |standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings::borrow_engine_privileged_state_mut(&mut this.engine_bindings);
    |engine_privileged_state|::EnginePrivilegedState::set_supplied_memory_source(privileged, source);
}

// Fixture variant of `supply_memory` for harnesses whose call sites can only
// carry scalars: installs one zeroed `element_count`-wide u64 region at
// `base_address` — a fault-injected page under the same adapter.
public machine SqualrEngine::supply_fixture(this: &mut SqualrEngine, base_address: u64, element_count: u64) {
    // Same aggregate-boundary constraint as `open_process`.
    let privileged: &mut |engine_privileged_state|::EnginePrivilegedState = |standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings::borrow_engine_privileged_state_mut(&mut this.engine_bindings);
    |engine_privileged_state|::EnginePrivilegedState::set_supplied_memory_fixture(privileged, base_address, element_count);
}

// Borrowed access to the owned privileged state for harnesses that reach
// the request executors directly — the union `dispatch_command` wire is
// unplannable in entry closures (union-typed locals/args mint no unit
// plan), so canaries call the same executors the dispatcher would.
public machine SqualrEngine::borrow_privileged_state_mut(this: &mut SqualrEngine) -> &mut |engine_privileged_state|::EnginePrivilegedState {
    let hoist1: &mut |engine_privileged_state|::EnginePrivilegedState = |standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings::borrow_engine_privileged_state_mut(&mut this.engine_bindings);
    (hoist1)
}

// Upstream `get_engine_unprivileged_state` — present in Standalone and
// UnprivilegedHost modes; absent (never-read) under PrivilegedShell.
public machine SqualrEngine::get_engine_unprivileged_state(this: &SqualrEngine) -> &|engine_unprivileged_state|::EngineUnprivilegedState {
    &this.engine_unprivileged_state
}

public machine SqualrEngine::borrow_engine_unprivileged_state_mut(this: &mut SqualrEngine) -> &mut |engine_unprivileged_state|::EngineUnprivilegedState {
    &mut this.engine_unprivileged_state
}

// Upstream `get_engine_privileged_state` — the state lives inside the
// standalone bindings record (upstream's shared Arc).
public machine SqualrEngine::get_engine_privileged_state(this: &SqualrEngine) -> &|engine_privileged_state|::EnginePrivilegedState {
    let hoist2: &|engine_privileged_state|::EnginePrivilegedState = |standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings::get_engine_privileged_state(&this.engine_bindings);
    (hoist2)
}

public machine SqualrEngine::get_engine_bindings(this: &SqualrEngine) -> &|standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings {
    &this.engine_bindings
}

public machine SqualrEngine::borrow_engine_bindings_mut(this: &mut SqualrEngine) -> &mut |standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings {
    &mut this.engine_bindings
}

// Upstream `dispatch_command` — the synchronous equivalent of the IPC
// command loop: route the privileged command through the executor chain and
// produce the wire-shaped response.
public machine SqualrEngine::dispatch_command(
    this: &mut SqualrEngine,
    privileged_command: &|privileged_command|::PrivilegedCommand
) -> |privileged_command_response|::PrivilegedCommandResponse
crashes Abort
crashes Trap
reaches |wait_wake|::WaitWake
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |wait_wake|::WaitWake;
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    |privileged_command_executor|::PrivilegedCommandExecutor::execute(|standalone_engine_api_unprivileged_bindings|::StandaloneEngineApiUnprivilegedBindings::borrow_engine_privileged_state_mut(&mut this.engine_bindings), privileged_command)
}

// Extracted-list wire for `Cli::run`: union-typed values cannot cross an
// entry machine's state successors, so the cli borrows the command in and
// receives only the record it stores (defaulted when the response carries
// no list — the print loop's zero-count path already ends in `next`).
public machine SqualrEngine::dispatch_list(
    this: &mut SqualrEngine,
    privileged_command: &|privileged_command|::PrivilegedCommand
) -> |scan_results_list_response|::ScanResultsListResponse
crashes Abort
crashes Trap
reaches |wait_wake|::WaitWake
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |wait_wake|::WaitWake;
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let response: |privileged_command_response|::PrivilegedCommandResponse = SqualrEngine::dispatch_command(&mut this, privileged_command);
    transition response {
        |privileged_command_response|::PrivilegedCommandResponse::ScanResults { response } -> extract(response)
        _ -> (|scan_results_list_response|::ScanResultsListResponse::default())
    }

    machine extract(response: |scan_results_response|::ScanResultsResponse) -> |scan_results_list_response|::ScanResultsListResponse {
        transition response {
            |scan_results_response|::ScanResultsResponse::List { response } -> (response)
            _ -> (|scan_results_list_response|::ScanResultsListResponse::default())
        }
    }
}

// Entry-machine wire for `Cli::run`: the parsed command stays borrowed —
// this machine walks CommandLineParse -> CommandLineCommand -> the
// privileged executor chain and returns only the record the cli stashes.
public machine SqualrEngine::dispatch_parsed_list(
    this: &mut SqualrEngine,
    parsed: &|command_line_parser|::CommandLineParse
) -> |scan_results_list_response|::ScanResultsListResponse
crashes Abort
crashes Trap
reaches |wait_wake|::WaitWake
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |wait_wake|::WaitWake;
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    transition parsed {
        |command_line_parser|::CommandLineParse::Parsed { command } -> walk(this, command)
        _ -> (|scan_results_list_response|::ScanResultsListResponse::default())
    }

    machine walk(this: &mut SqualrEngine, command: &|command_line_command|::CommandLineCommand) -> |scan_results_list_response|::ScanResultsListResponse {
        transition command {
            |command_line_command|::CommandLineCommand::Privileged { command } -> drive(this, command)
        }
    }

    machine drive(this: &mut SqualrEngine, command: &|privileged_command|::PrivilegedCommand) -> |scan_results_list_response|::ScanResultsListResponse {
        let hoist3: |scan_results_list_response|::ScanResultsListResponse = SqualrEngine::dispatch_list(&mut this, command);
        (hoist3)
    }
}

// Invocation-envelope wire for `Cli::run`: the parse owns the command and
// union construction is admitted inside the engine's machines, so cli
// moves the PrivilegedCommand payload through and the envelope mints in
// `send_invocation` — `create_command_invocation` on the unprivileged
// state allocates the id (upstream `fetch_add(1) + 1`) before the
// prepare → bindings-dispatch → publish pipeline runs. Same
// union-extraction discipline as `dispatch_parsed_list` on the way out.
public machine SqualrEngine::dispatch_invocation_list(
    this: &mut SqualrEngine,
    command: |privileged_command|::PrivilegedCommand
) -> |scan_results_list_response|::ScanResultsListResponse
crashes Abort
crashes Trap
reaches |wait_wake|::WaitWake
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |wait_wake|::WaitWake;
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let mut mailbox: |privileged_response_mailbox|::PrivilegedResponseMailbox = |privileged_response_mailbox|::PrivilegedResponseMailbox::default();
    _ = |command_invocation_wire|::CommandInvocationWireModule::send_invocation(
        &mut this,
        |command_invocation|::CommandInvocationSource::Cli,
        command,
        &mut mailbox);
    transition mailbox {
        |privileged_response_mailbox|::PrivilegedResponseMailbox::Delivered { response } -> walk(this, response)
        |privileged_response_mailbox|::PrivilegedResponseMailbox::Empty -> (|scan_results_list_response|::ScanResultsListResponse::default())
        _ -> (|scan_results_list_response|::ScanResultsListResponse::default())
    }

    machine walk(this: &mut SqualrEngine, response: |privileged_command_response|::PrivilegedCommandResponse) -> |scan_results_list_response|::ScanResultsListResponse {
        transition response {
            |privileged_command_response|::PrivilegedCommandResponse::ScanResults { response } -> extract(response)
            _ -> (|scan_results_list_response|::ScanResultsListResponse::default())
        }
    }

    machine extract(response: |scan_results_response|::ScanResultsResponse) -> |scan_results_list_response|::ScanResultsListResponse {
        transition response {
            |scan_results_response|::ScanResultsResponse::List { response } -> (response)
            _ -> (|scan_results_list_response|::ScanResultsListResponse::default())
        }
    }
}
