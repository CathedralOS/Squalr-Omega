module src::squalr_engine;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::command_invocation::CommandInvocationSource;
use squalr_engine_api::src::commands::command_line::command_line_command::CommandLineCommand;
use squalr_engine_api::src::commands::command_line::command_line_parser::CommandLineParse;
use squalr_engine_api::src::commands::privileged_command::PrivilegedCommand;
use squalr_engine_api::src::commands::privileged_command_response::PrivilegedCommandResponse;
use squalr_engine_api::src::commands::scan_results::list::scan_results_list_response::ScanResultsListResponse;
use squalr_engine_api::src::commands::scan_results::scan_results_response::ScanResultsResponse;
use squalr_engine_api::src::structures::memory::bitness::Bitness;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::engine::privileged_response_mailbox::PrivilegedResponseMailbox;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use squalr_engine_session::src::os::supplied_memory_source::SuppliedMemorySource;
use src::command_executors::privileged_command_executor::PrivilegedCommandExecutor;
use src::command_invocation_wire::CommandInvocationWireModule;
use src::engine_bindings::standalone_engine_api_unprivileged_bindings::StandaloneEngineApiUnprivilegedBindings;
use src::engine_mode::EngineMode;

// Port of squalr_engine.rs for the headless leg. Upstream's
// `Option<Arc<EnginePrivilegedState>>` + `Option<Arc<EngineUnprivilegedState>>`
// + `Arc<RwLock<dyn EngineApiUnprivilegedBindings>>` trio collapses to
// single-owner fields: the standalone bindings record owns the privileged
// state (upstream's shared Arc), the unprivileged state sits beside it,
// and dispatch is synchronous — commands complete before returning, so
// no TrackableTask crosses the wire (named deviation). Upstream
// PrivilegedShell mode leaves the unprivileged state unconstructed —
// the port keeps both fields present and simply never drives the
// unprivileged side there (upstream's Option<> collapses to a
// never-read zero-init field; `has_engine_unprivileged_state` documents
// the arm for consumers that probe presence).
pub data SqualrEngine {
    engine_mode: EngineMode;
    has_engine_unprivileged_state: bool;
    engine_unprivileged_state: EngineUnprivilegedState;
    engine_bindings: StandaloneEngineApiUnprivilegedBindings;
}

// Re-entrant initializer for hosts (the CLI's `Main`) that own an
// already-constructed engine slot — the entry context cannot bind a
// structural local or call-source assignment, so construction lands
// through a `&mut` receiver instead.
pub machine SqualrEngine::init(&mut self, engine_mode: EngineMode) {
    self.engine_mode = engine_mode;
    self.has_engine_unprivileged_state = true;
    self.engine_unprivileged_state = EngineUnprivilegedState::new();
    self.engine_bindings = StandaloneEngineApiUnprivilegedBindings::new();
}

// No-arg entry-context variant: the entry machine's closure cannot
// construct or pass union values, so the headless CLI's fixed launch
// mode is pinned here where ordinary semantics apply.
pub machine SqualrEngine::init_privileged_shell(&mut self) {
    // Union field stores cannot appear anywhere in the entry's transitive
    // unit plan, so `engine_mode` keeps its zero-initialized first case
    // (`Standalone`). Upstream PrivilegedShell constructs no unprivileged
    // state — the flag + zero-init field spell that arm.
    self.has_engine_unprivileged_state = false;
    self.engine_bindings.init();
}

// Upstream `EngineMode::Standalone` construction for headless hosts —
// the cli's interactive path. The privileged state lives inside the
// standalone bindings record (upstream's shared Arc collapses to sole
// ownership there); the unprivileged state mints alongside it and gets
// `initialize`'s lifecycle hook.
pub machine SqualrEngine::init_standalone(&mut self) {
    self.has_engine_unprivileged_state = true;
    self.engine_bindings.init();
    self.engine_unprivileged_state.init();
    _ = self.engine_unprivileged_state.initialize();
}

pub machine SqualrEngine::new(engine_mode: EngineMode) -> SqualrEngine {
    SqualrEngine {
        engine_mode: engine_mode,
        has_engine_unprivileged_state: true,
        engine_unprivileged_state: EngineUnprivilegedState::new(),
        engine_bindings: StandaloneEngineApiUnprivilegedBindings::new(),
    }
}

pub machine SqualrEngine::get_mode(&self) -> EngineMode {
    self.engine_mode
}

// Test-side process open — the adapter's equivalent of `open_process`
// completing; `scan new` requires an opened process upstream.
pub machine SqualrEngine::open_process(&mut self, process_id: u32) {
    // Entry plans cannot move the aggregate across the call boundary, so the
    // fixture variant builds it inside the owning state.
    self.engine_bindings.borrow_engine_privileged_state_mut().set_opened_process_fixture(process_id);
}

// Install the supplied memory regions the CLI's `--memory` flag captures —
// the adapter's stand-in for a real target's page map + contents.
pub machine SqualrEngine::supply_memory(&mut self, source: SuppliedMemorySource) {
    self.engine_bindings.borrow_engine_privileged_state_mut().set_supplied_memory_source(source);
}

// Fixture variant of `supply_memory` for harnesses whose call sites can only
// carry scalars: installs one zeroed `element_count`-wide u64 region at
// `base_address` — a fault-injected page under the same adapter.
pub machine SqualrEngine::supply_fixture(&mut self, base_address: u64, element_count: u64) {
    // Same aggregate-boundary constraint as `open_process`.
    self.engine_bindings.borrow_engine_privileged_state_mut().set_supplied_memory_fixture(base_address, element_count);
}

// Borrowed access to the owned privileged state for harnesses that reach
// the request executors directly — the union `dispatch_command` wire is
// unplannable in entry closures (union-typed locals/args mint no unit
// plan), so canaries call the same executors the dispatcher would.
pub machine SqualrEngine::borrow_privileged_state_mut(&mut self) -> &mut EnginePrivilegedState {
    self.engine_bindings.borrow_engine_privileged_state_mut()
}

// Upstream `get_engine_unprivileged_state` — present in Standalone and
// UnprivilegedHost modes; absent (never-read) under PrivilegedShell.
pub machine SqualrEngine::get_engine_unprivileged_state(&self) -> &EngineUnprivilegedState {
    &self.engine_unprivileged_state
}

pub machine SqualrEngine::borrow_engine_unprivileged_state_mut(&mut self) -> &mut EngineUnprivilegedState {
    &mut self.engine_unprivileged_state
}

// Upstream `get_engine_privileged_state` — the state lives inside the
// standalone bindings record (upstream's shared Arc).
pub machine SqualrEngine::get_engine_privileged_state(&self) -> &EnginePrivilegedState {
    self.engine_bindings.get_engine_privileged_state()
}

pub machine SqualrEngine::get_engine_bindings(&self) -> &StandaloneEngineApiUnprivilegedBindings {
    &self.engine_bindings
}

pub machine SqualrEngine::borrow_engine_bindings_mut(&mut self) -> &mut StandaloneEngineApiUnprivilegedBindings {
    &mut self.engine_bindings
}

// Upstream `dispatch_command` — the synchronous equivalent of the IPC
// command loop: route the privileged command through the executor chain and
// produce the wire-shaped response.
pub machine SqualrEngine::dispatch_command(
    &mut self,
    privileged_command: &PrivilegedCommand
) -> PrivilegedCommandResponse
crashes Abort
crashes Trap
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
{
    PrivilegedCommandExecutor::execute(self.engine_bindings.borrow_engine_privileged_state_mut(), privileged_command)
}

// Extracted-list wire for `Cli::run`: union-typed values cannot cross an
// entry machine's state successors, so the cli borrows the command in and
// receives only the record it stores (defaulted when the response carries
// no list — the print loop's zero-count path already ends in `next`).
pub machine SqualrEngine::dispatch_list(
    &mut self,
    privileged_command: &PrivilegedCommand
) -> ScanResultsListResponse
crashes Abort
crashes Trap
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
{
    let response: PrivilegedCommandResponse = self.dispatch_command(privileged_command);
    transition response {
        PrivilegedCommandResponse::ScanResults { response } -> extract(response)
        _ -> (ScanResultsListResponse::default())
    }

    state extract(response: ScanResultsResponse) -> ScanResultsListResponse {
        transition response {
            ScanResultsResponse::List { response } -> (response)
            _ -> (ScanResultsListResponse::default())
        }
    }
}

// Entry-machine wire for `Cli::run`: the parsed command stays borrowed —
// this machine walks CommandLineParse -> CommandLineCommand -> the
// privileged executor chain and returns only the record the cli stashes.
pub machine SqualrEngine::dispatch_parsed_list(
    &mut self,
    parsed: &CommandLineParse
) -> ScanResultsListResponse
crashes Abort
crashes Trap
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
{
    transition parsed {
        CommandLineParse::Parsed { command } -> walk(command)
        _ -> (ScanResultsListResponse::default())
    }

    state walk(&mut self, command: &CommandLineCommand) -> ScanResultsListResponse {
        transition command {
            CommandLineCommand::Privileged { command } -> drive(command)
        }
    }

    state drive(&mut self, command: &PrivilegedCommand) -> ScanResultsListResponse {
        self.dispatch_list(command)
    }
}

// Invocation-envelope wire for `Cli::run`: the parse owns the command and
// union construction is admitted inside the engine's machines, so cli
// moves the PrivilegedCommand payload through and the envelope mints in
// `send_invocation` — `create_command_invocation` on the unprivileged
// state allocates the id (upstream `fetch_add(1) + 1`) before the
// prepare → bindings-dispatch → publish pipeline runs. Same
// union-extraction discipline as `dispatch_parsed_list` on the way out.
pub machine SqualrEngine::dispatch_invocation_list(
    &mut self,
    command: PrivilegedCommand
) -> ScanResultsListResponse
crashes Abort
crashes Trap
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
{
    let mut mailbox: PrivilegedResponseMailbox = PrivilegedResponseMailbox::default();
    _ = CommandInvocationWireModule::send_invocation(
        &mut self,
        CommandInvocationSource::Cli,
        command,
        &mut mailbox);
    transition mailbox {
        PrivilegedResponseMailbox::Delivered { response } -> walk(response)
        PrivilegedResponseMailbox::Empty -> (ScanResultsListResponse::default())
        _ -> (ScanResultsListResponse::default())
    }

    state walk(&mut self, response: PrivilegedCommandResponse) -> ScanResultsListResponse {
        transition response {
            PrivilegedCommandResponse::ScanResults { response } -> extract(response)
            _ -> (ScanResultsListResponse::default())
        }
    }

    state extract(response: ScanResultsResponse) -> ScanResultsListResponse {
        transition response {
            ScanResultsResponse::List { response } -> (response)
            _ -> (ScanResultsListResponse::default())
        }
    }
}
