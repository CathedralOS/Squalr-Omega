use {omega}/language/core/filesystem_authority.omg;
use {omega}/language/core/wait_wake.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/commands/privileged_command.omg;
use {squalr_engine_api}/src/commands/privileged_command_response.omg;
use {squalr_engine_api}/src/commands/privileged_command_result.omg;
use {squalr_engine_api}/src/registries/symbols/privileged_registry_catalog.omg;
use {squalr_engine_api}/src/engine/engine_api_unprivileged_bindings.omg;
use {squalr_engine_api}/src/engine/engine_event_envelope.omg;
use {squalr_engine_api}/src/events/engine_event.omg;
use {squalr_engine_api}/src/engine/privileged_response_mailbox.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/privileged_command_executor.omg;

// Port of engine_bindings/standalone/standalone_engine_api_unprivileged_bindings.rs.
// Upstream holds `Arc<EnginePrivilegedState>` shared with SqualrEngine's own
// handle; the port's single-owner collapse makes the bindings record the sole
// owner — SqualrEngine borrows the state back through the accessors below.
// Upstream's spawned dispatch thread and crossbeam callback collapse to the
// caller-owned `PrivilegedResponseMailbox` (the api trait's documented
// respelling); commands still complete before `dispatch_privileged_command`
// returns, matching the synchronous wire the headless leg drives.
public data StandaloneEngineApiUnprivilegedBindings {
    engine_privileged_state: |engine_privileged_state|::EnginePrivilegedState;
}

// Re-entrant initializer for hosts whose engine slot already exists (the
// headless entry context — see `SqualrEngine::init_privileged_shell`).
public machine StandaloneEngineApiUnprivilegedBindings::init(this: &mut StandaloneEngineApiUnprivilegedBindings) {
    |engine_privileged_state|::EnginePrivilegedState::init(&mut this.engine_privileged_state);
}

public machine StandaloneEngineApiUnprivilegedBindings::new() -> StandaloneEngineApiUnprivilegedBindings {
    StandaloneEngineApiUnprivilegedBindings {
        engine_privileged_state: |engine_privileged_state|::EnginePrivilegedState::new(),
    }
}

public machine StandaloneEngineApiUnprivilegedBindings::get_engine_privileged_state(
    this: &StandaloneEngineApiUnprivilegedBindings) -> &|engine_privileged_state|::EnginePrivilegedState {
    &this.engine_privileged_state
}

public machine StandaloneEngineApiUnprivilegedBindings::borrow_engine_privileged_state_mut(
    this: &mut StandaloneEngineApiUnprivilegedBindings) -> &mut |engine_privileged_state|::EnginePrivilegedState {
    &mut this.engine_privileged_state
}

// Upstream `dispatch_privileged_command` verbatim — the worker thread that
// runs `create_privileged_command_result` against the privileged state and
// answers through the callback collapses to a synchronous evaluate here.
// Upstream order preserved: the `should_include_privileged_registry_catalog`
// probe runs BEFORE `execute`, the result bundles through
// `PrivilegedCommandResult::new`, and `into_privileged_command_response`
// drops the catalog before the callback fires — the standalone hop only
// ever serializes the response (documented upstream semantics: the catalog
// exists for the interprocess bindings' wire).
public machine StandaloneEngineApiUnprivilegedBindings::dispatch_privileged_command(
    this: &mut StandaloneEngineApiUnprivilegedBindings,
    command: &|privileged_command|::PrivilegedCommand,
    mailbox: &mut |privileged_response_mailbox|::PrivilegedResponseMailbox
) -> bool
satisfies |engine_api_unprivileged_bindings|::EngineApiUnprivilegedBindings<StandaloneEngineApiUnprivilegedBindings>::dispatch_privileged_command
reaches |wait_wake|::WaitWake
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |wait_wake|::WaitWake;
invokes |posix_filesystem_host|::PosixFilesystemHost;
crashes Abort
crashes Trap
{
    let should_include_catalog: bool = |privileged_command|::PrivilegedCommand::should_include_privileged_registry_catalog(&command);
    let response: |privileged_command_response|::PrivilegedCommandResponse = |privileged_command_executor|::PrivilegedCommandExecutor::execute(
        &mut this.engine_privileged_state,
        command);
    transition should_include_catalog {
        true -> with_catalog(this, response, mailbox)
        false -> without_catalog(this, response, mailbox)
    }

    machine with_catalog(
        this: &mut StandaloneEngineApiUnprivilegedBindings,
        response: |privileged_command_response|::PrivilegedCommandResponse,
        mailbox: &mut |privileged_response_mailbox|::PrivilegedResponseMailbox
    ) -> bool {
        let catalog: |privileged_registry_catalog|::PrivilegedRegistryCatalog =
            |engine_privileged_state|::EnginePrivilegedState::get_privileged_registry_catalog(&this.engine_privileged_state);
        let result: |privileged_command_result|::PrivilegedCommandResult = |privileged_command_result|::PrivilegedCommandResult::new(response, true, catalog);
        let final_response: |privileged_command_response|::PrivilegedCommandResponse =
            |privileged_command_result|::PrivilegedCommandResult::into_privileged_command_response(result);
        |privileged_response_mailbox|::PrivilegedResponseMailbox::deliver(&mut mailbox, final_response);
        (true)
    }
    machine without_catalog(
        this: &mut StandaloneEngineApiUnprivilegedBindings,
        response: |privileged_command_response|::PrivilegedCommandResponse,
        mailbox: &mut |privileged_response_mailbox|::PrivilegedResponseMailbox
    ) -> bool {
        let result: |privileged_command_result|::PrivilegedCommandResult = |privileged_command_result|::PrivilegedCommandResult::new(
            response,
            false,
            |privileged_registry_catalog|::PrivilegedRegistryCatalog::default());
        let final_response: |privileged_command_response|::PrivilegedCommandResponse =
            |privileged_command_result|::PrivilegedCommandResult::into_privileged_command_response(result);
        |privileged_response_mailbox|::PrivilegedResponseMailbox::deliver(&mut mailbox, final_response);
        (true)
    }
}

// Upstream `subscribe_to_engine_events` — the channel receiver respells as
// a drain of the privileged state's pending queue into the caller's
// bounded envelope queue (64 slots, drop-on-full like the channel's
// fire-and-forget consumers).
public machine StandaloneEngineApiUnprivilegedBindings::drain_engine_events(
    this: &mut StandaloneEngineApiUnprivilegedBindings,
    out: &mut |engine_event_envelope|::EngineEventEnvelopeQueue
) -> bool
satisfies |engine_api_unprivileged_bindings|::EngineApiUnprivilegedBindings<StandaloneEngineApiUnprivilegedBindings>::drain_engine_events
{
    let generation: u64 = |engine_privileged_state|::EnginePrivilegedState::get_registry_generation(&this.engine_privileged_state);
    let count: u64 = |engine_privileged_state|::EnginePrivilegedState::get_pending_event_count(&this.engine_privileged_state);
    transition { _ -> walk(this, generation, count, out, 0) }
    machine walk(
        this: &mut StandaloneEngineApiUnprivilegedBindings,
        generation: u64,
        count: u64,
        out: &mut |engine_event_envelope|::EngineEventEnvelopeQueue,
        position: u64
    ) -> bool
    {
        transition position < count {
            true -> pump(this, generation, count, out, position)
            false -> finish(this, out)
        }
    }
    machine pump(
        this: &mut StandaloneEngineApiUnprivilegedBindings,
        generation: u64,
        count: u64,
        out: &mut |engine_event_envelope|::EngineEventEnvelopeQueue,
        position: u64
    ) -> bool
        requires position < count;
    {
        let engine_event: |engine_event|::EngineEvent = |engine_privileged_state|::EnginePrivilegedState::get_pending_event(&this.engine_privileged_state, position);
        let envelope: |engine_event_envelope|::EngineEventEnvelope = |engine_event_envelope|::EngineEventEnvelope::new(generation, engine_event);
        _ = |engine_event_envelope|::EngineEventEnvelopeQueue::push(&mut out, &envelope);
        let next_position: u64 = position + 1;
        transition { _ -> walk(this, generation, count, out, next_position) }
    }
    machine finish(this: &mut StandaloneEngineApiUnprivilegedBindings, out: &mut |engine_event_envelope|::EngineEventEnvelopeQueue) -> bool {
        |engine_privileged_state|::EnginePrivilegedState::drain_pending_events(&mut this.engine_privileged_state);
        (true)
    }
}
