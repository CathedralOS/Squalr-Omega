// Port of squalr-engine/src/services/projects/project_item_symbol_resolution.rs.
//
// Resolves a project item's runtime memory target (address + module) and its
// symbolic struct layout id, and answers the promotable/memory-viewer/
// code-viewer questions the GUI asks when rows are edited.
//
// Named deviations:
// - Upstream routes through `engine_execution_context` (dyn) for the
//   privileged memory read and `get_default_value`. The port takes the dual
//   unprivileged context `(engine_unprivileged_state, engine_bindings)`:
//   memory reads dispatch through `dispatch_privileged_command` on the
//   standalone bindings (upstream's send_unprivileged equivalent), and the
//   unit-size lookup uses `DataTypeRef::get_unit_size_in_bytes` — upstream's
//   `get_default_value(...).get_size_in_bytes()` resolves to the same number
//   for every registered builtin; an unregistered id falls back to 1 byte
//   here exactly as upstream's `unwrap_or(1)`.
// - `Pointer` stays the borrowed pointer; `OwnedRuntimePointer` carries the
//   converted runtime shape. `resolve_pointer_runtime_target` accepts the
//   owned shape; pointer-typed items convert via `pointer_to_owned_runtime`.
// - `SymbolicFieldDefinition::from_str` parse failures collapse to the
//   result union's absent arm — upstream only `.ok()?`s them.

module src::services::projects::project_item_symbol_resolution;

use omega::language::core::option;
use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::memory::memory_command::MemoryCommand;
use squalr_engine_api::src::commands::memory::memory_response::MemoryResponse;
use squalr_engine_api::src::commands::memory::read::memory_read_request::MemoryReadRequest;
use squalr_engine_api::src::commands::memory::read::memory_read_response::MemoryReadResponse;
use squalr_engine_api::src::commands::privileged_command::PrivilegedCommand;
use squalr_engine_api::src::commands::privileged_command_response::PrivilegedCommandResponse;
use squalr_engine_api::src::engine::privileged_response_mailbox::PrivilegedResponseMailbox;
use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use squalr_engine_api::src::structures::data_values::container_type::ContainerType;
use squalr_engine_api::src::structures::data_values::data_value::DataValue;
use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerAddressValue;
use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use squalr_engine_api::src::structures::memory::pointer::Pointer;
use squalr_engine_api::src::structures::memory::symbolic_pointer_chain::SymbolicLinkOffset;
use squalr_engine_api::src::structures::memory::symbolic_pointer_chain::SymbolicPointerChainLink;
use squalr_engine_api::src::structures::projects::project_items::built_in_types::project_item_type_address::ProjectItemTypeAddress;
use squalr_engine_api::src::structures::projects::project_items::built_in_types::project_item_type_address::SymbolicStructRefMatch;
use squalr_engine_api::src::structures::projects::project_items::built_in_types::project_item_type_address_target::AddressTargetMatch;
use squalr_engine_api::src::structures::projects::project_items::built_in_types::project_item_type_address_target::OwnedRuntimePointer;
use squalr_engine_api::src::structures::projects::project_items::built_in_types::project_item_type_address_target::ProjectItemAddressTarget;
use squalr_engine_api::src::structures::projects::project_items::built_in_types::project_item_type_address_target::RuntimePointerMatch;
use squalr_engine_api::src::structures::projects::project_items::built_in_types::project_item_type_pointer::ProjectItemTypePointer;
use squalr_engine_api::src::structures::projects::project_items::project_item::ProjectItem;
use squalr_engine_api::src::structures::projects::project_items::project_item_type_ref::ProjectItemTypeRef;
