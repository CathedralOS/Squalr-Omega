    state retarget_push(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, source_relative: &ManifestPathScratch, target_relative: &ManifestPathScratch, out_next: &mut ProjectPathList, seen: &mut ProjectPathList, position: u64, rewritten: &ManifestPathScratch) -> bool
        requires rewritten.len <= 512;
    {
