// Upstream `apply_project_item_reorder_to_sort_order` — the
// min-position-insertion merge: anchor = min over configured order of the
// moved items' positions; entries at/after anchor that aren't moving stay;
// moved subset inserts at anchor in requested order.
pub machine ProjectItemSortOrder::apply_project_item_reorder_to_sort_order(
    project_item_sort_order: &ProjectItemSortOrder,
    project: &mut Project,
    project_directory_path: &[u8],
    reordered_project_item_paths: &ProjectPathList ) -> bool {
    let mut moving_relative: ProjectPathList = ProjectPathList::empty();
    _ = ProjectItemSortOrder::to_relative_list(project_item_sort_order, project_directory_path, reordered_project_item_paths, &mut moving_relative);
    // anchor = min configured position of any moving rel path (else no-op).
    let configured: &ProjectPathList = Project::get_project_item_sort_order(project);
    let anchor: u64 = ProjectItemSortOrder::min_configured_position(project_item_sort_order, configured, &moving_relative);
    transition anchor < ProjectPathList::get_path_count(configured) {
        true -> merge(project_item_sort_order, project, &moving_relative, anchor)
        false -> (false)
        _ -> (false)
    }
    state merge(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, moving_relative: &ProjectPathList, anchor: u64) -> bool {
        let configured: &ProjectPathList = Project::get_project_item_sort_order(project);
        let mut next_sort_order: ProjectPathList = ProjectPathList::empty();
        _ = ProjectItemSortOrder::reorder_merge(project_item_sort_order, configured, moving_relative, anchor, &mut next_sort_order);
        _ = ProjectItemSortOrder::set_project_item_sort_order_if_changed(project_item_sort_order, project, &next_sort_order);
        (true)
    }
}

// smallest position p in configured whose path is in moving (else
// configured.count as the "no anchor" sentinel).
pub machine ProjectItemSortOrder::min_configured_position(
    project_item_sort_order: &ProjectItemSortOrder,
    configured: &ProjectPathList,
    moving: &ProjectPathList ) -> u64 {
    transition {
        _ -> scan(project_item_sort_order, configured, moving, 0)
    }
    state scan(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, moving: &ProjectPathList, position: u64) -> u64 {
        transition position < ProjectPathList::get_path_count(configured) {
            true -> check(project_item_sort_order, configured, moving, position)
            false -> (ProjectPathList::get_path_count(configured))
            _ -> (ProjectPathList::get_path_count(configured))
        }
    }
    state check(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, moving: &ProjectPathList, position: u64) -> u64 {
        let inner3117: &[u8] = ProjectPathList::get_path(configured, position);
        transition ProjectItemSortOrder::list_contains(project_item_sort_order, moving, inner3117) {
            true -> (position)
            false -> scan(project_item_sort_order, configured, moving, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (ProjectPathList::get_path_count(configured))
        }
    }
}

// next = configured[0..anchor non-moving? NO — upstream keeps prefix
// verbatim (pre-anchor entries untouched), drops moving entries after
// anchor, inserts moving subset at anchor in requested order.
pub machine ProjectItemSortOrder::reorder_merge(
    project_item_sort_order: &ProjectItemSortOrder,
    configured: &ProjectPathList,
    moving_relative: &ProjectPathList,
    anchor: u64,
    out_next: &mut ProjectPathList ) -> bool {
    transition {
        _ -> prefix(project_item_sort_order, configured, moving_relative, anchor, out_next, 0)
    }
    // Copy configured[0..anchor] verbatim.
    state prefix(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, moving_relative: &ProjectPathList, anchor: u64, out_next: &mut ProjectPathList, position: u64) -> bool {
        transition position < anchor && position < ProjectPathList::get_path_count(configured) {
            true -> prefix_push(project_item_sort_order, configured, moving_relative, anchor, out_next, position)
            false -> insert_moving(project_item_sort_order, configured, moving_relative, anchor, out_next, 0)
            _ -> (false)
        }
    }
    state prefix_push(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, moving_relative: &ProjectPathList, anchor: u64, out_next: &mut ProjectPathList, position: u64) -> bool {
        let inner3118: &[u8] = ProjectPathList::get_path(configured, position);
        _ = ProjectPathList::add_path(out_next, inner3118);
        transition {
            _ -> prefix(project_item_sort_order, configured, moving_relative, anchor, out_next, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    // Insert the moving subset in requested order.
    state insert_moving(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, moving_relative: &ProjectPathList, anchor: u64, out_next: &mut ProjectPathList, position: u64) -> bool {
        transition position < ProjectPathList::get_path_count(moving_relative) {
            true -> insert_moving_push(project_item_sort_order, configured, moving_relative, anchor, out_next, position)
            false -> tail(project_item_sort_order, configured, moving_relative, anchor, out_next, anchor)
            _ -> (false)
        }
    }
    state insert_moving_push(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, moving_relative: &ProjectPathList, anchor: u64, out_next: &mut ProjectPathList, position: u64) -> bool {
        let inner3119: &[u8] = ProjectPathList::get_path(moving_relative, position);
        _ = ProjectPathList::add_path(out_next, inner3119);
        transition {
            _ -> insert_moving(project_item_sort_order, configured, moving_relative, anchor, out_next, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    // Append configured[anchor..] minus moving entries.
    state tail(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, moving_relative: &ProjectPathList, anchor: u64, out_next: &mut ProjectPathList, position: u64) -> bool {
        transition position < ProjectPathList::get_path_count(configured) {
            true -> tail_check(project_item_sort_order, configured, moving_relative, anchor, out_next, position)
            false -> (true)
            _ -> (false)
        }
    }
    state tail_check(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, moving_relative: &ProjectPathList, anchor: u64, out_next: &mut ProjectPathList, position: u64) -> bool {
        let inner3120: &[u8] = ProjectPathList::get_path(configured, position);
        transition ProjectItemSortOrder::list_contains(project_item_sort_order, moving_relative, inner3120) {
            true -> tail(project_item_sort_order, configured, moving_relative, anchor, out_next, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> tail_push(project_item_sort_order, configured, moving_relative, anchor, out_next, position)
            _ -> (false)
        }
    }
    state tail_push(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, moving_relative: &ProjectPathList, anchor: u64, out_next: &mut ProjectPathList, position: u64) -> bool {
        let inner3121: &[u8] = ProjectPathList::get_path(configured, position);
        _ = ProjectPathList::add_path(out_next, inner3121);
        transition {
            _ -> tail(project_item_sort_order, configured, moving_relative, anchor, out_next, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// Upstream `append_project_items_to_sort_order` — normalize the manifest's
// sort-order table against the project contents, then append each added
// path's manifest-relative spelling once (deduped), persisting only when the
// table changed.
pub machine ProjectItemSortOrder::append_project_items_to_sort_order(
    project_item_sort_order: &ProjectItemSortOrder,
    project: &mut Project,
    project_directory_path: &[u8],
    added_project_item_paths: &ProjectPathList
) -> bool {
    let mut did_mutate_sort_order: bool = ProjectItemSortOrder::normalize_project_item_sort_order(project_item_sort_order, project, project_directory_path);
    let mut known: ProjectPathList = ProjectPathList::empty();
    _ = ProjectItemSortOrder::collect_existing_project_item_relative_paths(project_item_sort_order, project, project_directory_path, &mut known);
    let inner13: &ProjectPathList = Project::get_project_item_sort_order(project);
    let current: ProjectPathList = ProjectPathList::clone(inner13);
    transition { _ -> seed(project_item_sort_order, project, project_directory_path, added_project_item_paths, did_mutate_sort_order, known, current, 0) }
    // Fold the manifest's configured entries into `known` — they are already
    // manifest-relative.
    state seed(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, project_directory_path: &[u8], added_project_item_paths: &ProjectPathList, did_mutate_sort_order: bool, known: ProjectPathList, current: ProjectPathList, position: u64) -> bool {
        transition position < ProjectPathList::get_path_count(&current) {
            true -> seed_take(project_item_sort_order, project, project_directory_path, added_project_item_paths, did_mutate_sort_order, known, current, position)
            _ -> append_at(project_item_sort_order, project, project_directory_path, added_project_item_paths, did_mutate_sort_order, known, current, 0)
        }
    }
    state seed_take(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, project_directory_path: &[u8], added_project_item_paths: &ProjectPathList, did_mutate_sort_order: bool, known: ProjectPathList, current: ProjectPathList, position: u64) -> bool {
        let entry: &[u8] = ProjectPathList::get_path(&current, position);
        let mut entry_scratch: ManifestPathScratch;
        ManifestPathScratch::new(&mut entry_scratch);
        _ = ProjectItemSortOrder::copy_into(project_item_sort_order, entry, &mut entry_scratch);
        let inner3122: &[u8] = ManifestPathScratch::get_bytes(&entry_scratch);
        _ = ProjectPathList::add_path(&mut known, inner3122);
        transition { _ -> seed(project_item_sort_order, project, project_directory_path, added_project_item_paths, did_mutate_sort_order, known, current, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state append_at(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, project_directory_path: &[u8], added_project_item_paths: &ProjectPathList, did_mutate_sort_order: bool, known: ProjectPathList, current: ProjectPathList, position: u64) -> bool {
        transition position < ProjectPathList::get_path_count(added_project_item_paths) {
            true -> append_take(project_item_sort_order, project, project_directory_path, added_project_item_paths, did_mutate_sort_order, known, current, position)
            _ -> commit(project_item_sort_order, project, did_mutate_sort_order, current)
        }
    }
    state append_take(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, project_directory_path: &[u8], added_project_item_paths: &ProjectPathList, did_mutate_sort_order: bool, known: ProjectPathList, current: ProjectPathList, position: u64) -> bool {
        let absolute: &[u8] = ProjectPathList::get_path(added_project_item_paths, position);
        let mut absolute_scratch: ManifestPathScratch;
        ManifestPathScratch::new(&mut absolute_scratch);
        _ = ProjectItemSortOrder::copy_into(project_item_sort_order, absolute, &mut absolute_scratch);
        let mut relative: ManifestPathScratch;
        ManifestPathScratch::new(&mut relative);
        let inner14: &[u8] = ManifestPathScratch::get_bytes(&absolute_scratch);
        let has_relative: bool = ProjectItemSortOrder::to_manifest_relative_path(project_item_sort_order, project_directory_path, inner14, &mut relative);
        let inner3123: &[u8] = ManifestPathScratch::get_bytes(&relative);
        transition has_relative && relative.len <= 512 && relative.len > 0 && !ProjectItemSortOrder::is_hidden_project_root_relative_path(project_item_sort_order, inner3123) {
            true -> append_dedup(project_item_sort_order, project, project_directory_path, added_project_item_paths, did_mutate_sort_order, known, current, position, relative)
            _ -> append_at(project_item_sort_order, project, project_directory_path, added_project_item_paths, did_mutate_sort_order, known, current, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state append_dedup(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, project_directory_path: &[u8], added_project_item_paths: &ProjectPathList, did_mutate_sort_order: bool, known: ProjectPathList, current: ProjectPathList, position: u64, relative: ManifestPathScratch) -> bool {
        let mut probe: ProjectPathList = known;
        let inner3124: &[u8] = ManifestPathScratch::get_bytes(&relative);
        transition ProjectItemSortOrder::list_contains(project_item_sort_order, &mut probe, inner3124) {
            true -> append_at(project_item_sort_order, project, project_directory_path, added_project_item_paths, did_mutate_sort_order, known, current, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> append_push(project_item_sort_order, project, project_directory_path, added_project_item_paths, did_mutate_sort_order, known, current, position, relative)
        }
    }
    state append_push(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, project_directory_path: &[u8], added_project_item_paths: &ProjectPathList, did_mutate_sort_order: bool, known: ProjectPathList, current: ProjectPathList, position: u64, relative: ManifestPathScratch) -> bool {
        let inner3125: &[u8] = ManifestPathScratch::get_bytes(&relative);
        _ = ProjectPathList::add_path(&mut known, inner3125);
        let inner3126: &[u8] = ManifestPathScratch::get_bytes(&relative);
        _ = ProjectPathList::add_path(&mut current, inner3126);
        transition { _ -> append_at(project_item_sort_order, project, project_directory_path, added_project_item_paths, true, known, current, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state commit(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, did_mutate_sort_order: bool, current: ProjectPathList) -> bool {
        transition did_mutate_sort_order {
            true -> apply(project_item_sort_order, project, did_mutate_sort_order, current)
            _ -> (false)
        }
    }
    state apply(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, did_mutate_sort_order: bool, current: ProjectPathList) -> bool {
        let changed: bool = ProjectItemSortOrder::set_project_item_sort_order_if_changed(project_item_sort_order, project, &current);
        transition { _ -> (did_mutate_sort_order || changed) }
    }
}
