// Upstream `append_project_item_paths_to_sort_order` — normalize then add
// each new manifest-relative path (skipping the hidden project_items dir
// root) in sorted position.
pub machine ProjectItemSortOrder::append_project_item_paths_to_sort_order(
    project_item_sort_order: &ProjectItemSortOrder,
    project: &mut Project,
    project_directory_path: &[u8],
    appended_project_item_paths: &ProjectPathList ) -> bool {
    _ = ProjectItemSortOrder::normalize_project_item_sort_order(project_item_sort_order, project, project_directory_path);
    transition {
        _ -> scan(project_item_sort_order, project, project_directory_path, appended_project_item_paths, 0)
    }
    state scan(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, project_directory_path: &[u8], appended_project_item_paths: &ProjectPathList, position: u64) -> bool {
        transition position < ProjectPathList::get_path_count(appended_project_item_paths) {
            true -> rel(project_item_sort_order, project, project_directory_path, appended_project_item_paths, position)
            false -> (true)
            _ -> (false)
        }
    }
    state rel(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, project_directory_path: &[u8], appended_project_item_paths: &ProjectPathList, position: u64) -> bool {
        let appended_path: &[u8] = ProjectPathList::get_path(appended_project_item_paths, position);
        let mut scratch: ManifestPathScratch;
        ManifestPathScratch::new(&mut scratch);
        transition ProjectItemSortOrder::to_manifest_relative_path(project_item_sort_order, project_directory_path, appended_path, &mut scratch) && scratch.len <= 512 && scratch.len > 0 {
            true -> hidden(project_item_sort_order, project, project_directory_path, appended_project_item_paths, position, &scratch)
            false -> scan(project_item_sort_order, project, project_directory_path, appended_project_item_paths, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
    state hidden(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, project_directory_path: &[u8], appended_project_item_paths: &ProjectPathList, position: u64, scratch: &ManifestPathScratch) -> bool
        requires scratch.len <= 512;
    {
        let inner3104: &[u8] = ManifestPathScratch::get_bytes(&scratch);
        transition ProjectItemSortOrder::is_hidden_project_root_relative_path(project_item_sort_order, inner3104) {
            true -> scan(project_item_sort_order, project, project_directory_path, appended_project_item_paths, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> insert(project_item_sort_order, project, project_directory_path, appended_project_item_paths, position, scratch)
            _ -> (false)
        }
    }
    state insert(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, project_directory_path: &[u8], appended_project_item_paths: &ProjectPathList, position: u64, scratch: &ManifestPathScratch) -> bool
        requires scratch.len <= 512;
    {
        // Sorted-insert into the live sort order when absent.
        let sort_order: &ProjectPathList = Project::get_project_item_sort_order(project);
        let inner3105: &[u8] = ManifestPathScratch::get_bytes(&scratch);
        transition ProjectItemSortOrder::list_contains(project_item_sort_order, sort_order, inner3105) {
            true -> scan(project_item_sort_order, project, project_directory_path, appended_project_item_paths, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> do_insert(project_item_sort_order, project, project_directory_path, appended_project_item_paths, position, scratch)
            _ -> (false)
        }
    }
    state do_insert(project_item_sort_order: &ProjectItemSortOrder, project: &mut Project, project_directory_path: &[u8], appended_project_item_paths: &ProjectPathList, position: u64, scratch: &ManifestPathScratch) -> bool
        requires scratch.len <= 512;
    {
        let current_order: &ProjectPathList = Project::get_project_item_sort_order(project);
        let mut next_sort_order: ProjectPathList = ProjectPathList::clone(&current_order);
        let inner3106: &[u8] = ManifestPathScratch::get_bytes(&scratch);
        _ = ProjectItemSortOrder::insert_sorted(project_item_sort_order, &mut next_sort_order, inner3106);
        _ = ProjectItemSortOrder::set_project_item_sort_order_if_changed(project_item_sort_order, project, &next_sort_order);
        transition {
            _ -> scan(project_item_sort_order, project, project_directory_path, appended_project_item_paths, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// Upstream `remove_project_item_paths_from_sort_order` — drop configured
// entries equal to, or descendants of, each removed root.
pub machine ProjectItemSortOrder::remove_project_item_paths_from_sort_order(
    project_item_sort_order: &ProjectItemSortOrder,
    project: &mut Project,
    project_directory_path: &[u8],
    removed_project_item_paths: &ProjectPathList ) -> bool {
    let mut removed_relative: ProjectPathList = ProjectPathList::empty();
    _ = ProjectItemSortOrder::to_relative_list(project_item_sort_order, project_directory_path, removed_project_item_paths, &mut removed_relative);
    let mut next_sort_order: ProjectPathList = ProjectPathList::empty();
    let inner3107: &ProjectPathList = Project::get_project_item_sort_order(project);
    _ = ProjectItemSortOrder::filter_removed(project_item_sort_order, inner3107, &removed_relative, &mut next_sort_order);
    transition {
        _ -> (ProjectItemSortOrder::set_project_item_sort_order_if_changed(project_item_sort_order, project, &next_sort_order))
    }
}

// Map each input path through to_manifest_relative_path into out_list.
pub machine ProjectItemSortOrder::to_relative_list(
    project_item_sort_order: &ProjectItemSortOrder,
    project_directory_path: &[u8],
    source_paths: &ProjectPathList,
    out_list: &mut ProjectPathList ) -> bool {
    ProjectPathList::clear(out_list);
    transition {
        _ -> scan(project_item_sort_order, project_directory_path, source_paths, out_list, 0)
    }
    state scan(project_item_sort_order: &ProjectItemSortOrder, project_directory_path: &[u8], source_paths: &ProjectPathList, out_list: &mut ProjectPathList, position: u64) -> bool {
        transition position < ProjectPathList::get_path_count(source_paths) {
            true -> rel(project_item_sort_order, project_directory_path, source_paths, out_list, position)
            false -> (true)
            _ -> (false)
        }
    }
    state rel(project_item_sort_order: &ProjectItemSortOrder, project_directory_path: &[u8], source_paths: &ProjectPathList, out_list: &mut ProjectPathList, position: u64) -> bool {
        let source_path: &[u8] = ProjectPathList::get_path(source_paths, position);
        let mut scratch: ManifestPathScratch;
        ManifestPathScratch::new(&mut scratch);
        transition ProjectItemSortOrder::to_manifest_relative_path(project_item_sort_order, project_directory_path, source_path, &mut scratch) && scratch.len <= 512 && scratch.len > 0 {
            true -> push_rel(project_item_sort_order, project_directory_path, source_paths, out_list, position, &scratch)
            false -> scan(project_item_sort_order, project_directory_path, source_paths, out_list, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
    state push_rel(project_item_sort_order: &ProjectItemSortOrder, project_directory_path: &[u8], source_paths: &ProjectPathList, out_list: &mut ProjectPathList, position: u64, scratch: &ManifestPathScratch) -> bool
        requires scratch.len <= 512;
    {
        let inner3108: &[u8] = ManifestPathScratch::get_bytes(&scratch);
        _ = ProjectPathList::add_path(out_list, inner3108);
        transition {
            _ -> scan(project_item_sort_order, project_directory_path, source_paths, out_list, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// Keep configured entries that are not (equal to or descendant of) a
// removed root.
pub machine ProjectItemSortOrder::filter_removed(
    project_item_sort_order: &ProjectItemSortOrder,
    configured: &ProjectPathList,
    removed_relative: &ProjectPathList,
    out_kept: &mut ProjectPathList ) -> bool {
    transition {
        _ -> scan(project_item_sort_order, configured, removed_relative, out_kept, 0)
    }
    state scan(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, removed_relative: &ProjectPathList, out_kept: &mut ProjectPathList, position: u64) -> bool {
        transition position < ProjectPathList::get_path_count(configured) {
            true -> check(project_item_sort_order, configured, removed_relative, out_kept, position)
            false -> (true)
            _ -> (false)
        }
    }
    state check(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, removed_relative: &ProjectPathList, out_kept: &mut ProjectPathList, position: u64) -> bool {
        let configured_path: &[u8] = ProjectPathList::get_path(configured, position);
        transition ProjectItemSortOrder::list_contains_prefix_root(project_item_sort_order, removed_relative, configured_path) {
            true -> scan(project_item_sort_order, configured, removed_relative, out_kept, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> keep(project_item_sort_order, configured, removed_relative, out_kept, position)
            _ -> (false)
        }
    }
    state keep(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, removed_relative: &ProjectPathList, out_kept: &mut ProjectPathList, position: u64) -> bool {
        let inner3109: &[u8] = ProjectPathList::get_path(configured, position);
        _ = ProjectPathList::add_path(out_kept, inner3109);
        transition {
            _ -> scan(project_item_sort_order, configured, removed_relative, out_kept, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// Whether `path` equals or descends from any entry in `roots`.
pub machine ProjectItemSortOrder::list_contains_prefix_root(
    project_item_sort_order: &ProjectItemSortOrder,
    roots: &ProjectPathList,
    path: &[u8] ) -> bool {
    transition {
        _ -> scan(project_item_sort_order, roots, path, 0)
