            false -> (false)
            _ -> (false)
        }
    }
    state check(project_item_sort_order: &ProjectItemSortOrder, roots: &ProjectPathList, path: &[u8], position: u64) -> bool {
        let inner3110: &[u8] = ProjectPathList::get_path(roots, position);
        transition ProjectItemSortOrder::path_starts_with(project_item_sort_order, path, inner3110) {
            true -> (true)
            false -> scan(project_item_sort_order, roots, path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// Upstream `rename_project_item_path_in_sort_order` — retarget each
// configured entry equal to or under the source root onto the target
// root, preserving suffix, then dedup + commit-if-changed.
pub machine ProjectItemSortOrder::rename_project_item_path_in_sort_order(
    project_item_sort_order: &ProjectItemSortOrder,
    project: &mut Project,
    project_directory_path: &[u8],
    source_project_item_path: &[u8],
    target_project_item_path: &[u8] ) -> bool {
    let mut source_relative: ManifestPathScratch;
    ManifestPathScratch::new(&mut source_relative);
    let mut target_relative: ManifestPathScratch;
    ManifestPathScratch::new(&mut target_relative);
    _ = ProjectItemSortOrder::to_manifest_relative_path(project_item_sort_order, project_directory_path, source_project_item_path, &mut source_relative);
    _ = ProjectItemSortOrder::to_manifest_relative_path(project_item_sort_order, project_directory_path, target_project_item_path, &mut target_relative);
    let mut next_sort_order: ProjectPathList = ProjectPathList::empty();
    let inner3111: &ProjectPathList = Project::get_project_item_sort_order(project);
    _ = ProjectItemSortOrder::retarget_scan(project_item_sort_order, inner3111, &source_relative, &target_relative, &mut next_sort_order);
    transition {
        _ -> (ProjectItemSortOrder::set_project_item_sort_order_if_changed(project_item_sort_order, project, &next_sort_order))
    }
}

// For each configured entry: if it sits under source root, rewrite as
// target_root + suffix; keep others verbatim. Dedup via seen-set.
pub machine ProjectItemSortOrder::retarget_scan(
    project_item_sort_order: &ProjectItemSortOrder,
    configured: &ProjectPathList,
    source_relative: &ManifestPathScratch,
    target_relative: &ManifestPathScratch,
    out_next: &mut ProjectPathList ) -> bool {
    let mut seen: ProjectPathList = ProjectPathList::empty();
    transition {
        _ -> scan(project_item_sort_order, configured, source_relative, target_relative, out_next, &mut seen, 0)
    }
    state scan(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, source_relative: &ManifestPathScratch, target_relative: &ManifestPathScratch, out_next: &mut ProjectPathList, seen: &mut ProjectPathList, position: u64) -> bool {
        transition position < ProjectPathList::get_path_count(configured) {
            true -> check(project_item_sort_order, configured, source_relative, target_relative, out_next, seen, position)
            false -> (true)
            _ -> (false)
        }
    }
    state check(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, source_relative: &ManifestPathScratch, target_relative: &ManifestPathScratch, out_next: &mut ProjectPathList, seen: &mut ProjectPathList, position: u64) -> bool
        requires source_relative.len <= 512;
    {
        let configured_path: &[u8] = ProjectPathList::get_path(configured, position);
        let inner3112: &[u8] = ManifestPathScratch::get_bytes(source_relative);
        transition ProjectItemSortOrder::path_starts_with(project_item_sort_order, configured_path, inner3112) {
            true -> retarget(project_item_sort_order, configured, source_relative, target_relative, out_next, seen, position)
            false -> keep(project_item_sort_order, configured, source_relative, target_relative, out_next, seen, position)
            _ -> (false)
        }
    }
    state keep(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, source_relative: &ManifestPathScratch, target_relative: &ManifestPathScratch, out_next: &mut ProjectPathList, seen: &mut ProjectPathList, position: u64) -> bool {
        let configured_path: &[u8] = ProjectPathList::get_path(configured, position);
        transition ProjectItemSortOrder::list_contains(project_item_sort_order, seen, configured_path) {
            true -> scan(project_item_sort_order, configured, source_relative, target_relative, out_next, seen, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> keep_push(project_item_sort_order, configured, source_relative, target_relative, out_next, seen, position)
            _ -> (false)
        }
    }
    state keep_push(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, source_relative: &ManifestPathScratch, target_relative: &ManifestPathScratch, out_next: &mut ProjectPathList, seen: &mut ProjectPathList, position: u64) -> bool {
        let configured_path: &[u8] = ProjectPathList::get_path(configured, position);
        _ = ProjectPathList::add_path(out_next, configured_path);
        _ = ProjectPathList::add_path(seen, configured_path);
        transition {
            _ -> scan(project_item_sort_order, configured, source_relative, target_relative, out_next, seen, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    // target_root + the configured suffix from len(source), skipping a leading
    // '/' if present).
    state retarget(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, source_relative: &ManifestPathScratch, target_relative: &ManifestPathScratch, out_next: &mut ProjectPathList, seen: &mut ProjectPathList, position: u64) -> bool
        requires source_relative.len <= 512 && target_relative.len <= 512;
    {
        let configured_path: &[u8] = ProjectPathList::get_path(configured, position);
        let mut rewritten: ManifestPathScratch;
        ManifestPathScratch::new(&mut rewritten);
        let inner3113: &[u8] = ManifestPathScratch::get_bytes(target_relative);
        _ = ProjectItemSortOrder::copy_into(project_item_sort_order, inner3113, &mut rewritten);
        transition {
            _ -> suffix(project_item_sort_order, configured, source_relative, target_relative, out_next, seen, position, &mut rewritten, source_relative.len)
        }
