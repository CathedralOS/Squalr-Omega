    state suffix(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, source_relative: &ManifestPathScratch, target_relative: &ManifestPathScratch, out_next: &mut ProjectPathList, seen: &mut ProjectPathList, position: u64, rewritten: &mut ManifestPathScratch, suffix_position: u64) -> bool
        requires source_relative.len <= 512;
    {
        let configured_path: &[u8] = ProjectPathList::get_path(configured, position);
        transition suffix_position < configured_path.len {
            true -> suffix_byte(project_item_sort_order, configured, source_relative, target_relative, out_next, seen, position, rewritten, suffix_position)
            false -> retarget_push(project_item_sort_order, configured, source_relative, target_relative, out_next, seen, position, rewritten)
            _ -> (false)
        }
    }
    state suffix_byte(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, source_relative: &ManifestPathScratch, target_relative: &ManifestPathScratch, out_next: &mut ProjectPathList, seen: &mut ProjectPathList, position: u64, rewritten: &mut ManifestPathScratch, suffix_position: u64) -> bool
        requires rewritten.len < 512 && source_relative.len <= 512;
    {
        let configured_path: &[u8] = ProjectPathList::get_path(configured, position);
        transition suffix_position < configured_path.len {
            true -> suffix_byte_do(project_item_sort_order, configured, source_relative, target_relative, out_next, seen, position, rewritten, suffix_position)
            false -> retarget_push(project_item_sort_order, configured, source_relative, target_relative, out_next, seen, position, rewritten)
