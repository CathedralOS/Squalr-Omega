    state suffix_byte_do(project_item_sort_order: &ProjectItemSortOrder, configured: &ProjectPathList, source_relative: &ManifestPathScratch, target_relative: &ManifestPathScratch, out_next: &mut ProjectPathList, seen: &mut ProjectPathList, position: u64, rewritten: &mut ManifestPathScratch, suffix_position: u64) -> bool
        requires rewritten.len < 512 && suffix_position < ProjectPathList::get_path(configured, position).len;
