module src::services::projects::project_item_runtime_value_write;

use src::services::projects::project_item_symbol_resolution::LocatorMatch;
use src::services::projects::project_item_symbol_resolution::ProjectItemSymbolResolution;
use src::services::projects::project_item_symbol_resolution::StructLayoutMatch;
use src::services::projects::project_symbol_runtime_value_write::ProjectSymbolRuntimeValueWrite;
use src::services::projects::project_symbol_runtime_value_write::SymbolRuntimeValueWritePlanRequest;
use src::services::projects::project_symbol_runtime_value_write::SymbolWritePlan;
use omega_language_std::filesystem_host;
use omega::language::core::wait_wake;
use squalr_engine_api::src::structures::data_values::anonymous_value_string::AnonymousValueString;
use squalr_engine_api::src::structures::data_values::container_type::ContainerType;
use squalr_engine_api::src::structures::projects::project_items::project_item::ProjectItem;
use squalr_engine_api::src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;
use squalr_engine_api::src::structures::projects::project_symbol_locator::ProjectSymbolLocator;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use src::engine_bindings::standalone_engine_api_unprivileged_bindings::StandaloneEngineApiUnprivilegedBindings;

// Port of services/projects/project_item_runtime_value_write.rs —
// the thin per-item wrapper over
// build_project_symbol_runtime_value_write_request: resolves the
// item's runtime locator + struct-layout id, then delegates.

pub data ProjectItemRuntimeValueWrite {}

// Upstream `ProjectItemRuntimeValueWritePlanRequest`.
pub data ProjectItemRuntimeValueWritePlanRequest {
    field_name: [u8; 256];
    field_name_len: u64;
    anonymous_value_string: AnonymousValueString;
}

// Upstream `build_project_item_runtime_value_write_request`.
pub machine ProjectItemRuntimeValueWrite::build_project_item_runtime_value_write_request(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_symbol_catalog: &ProjectSymbolCatalog,
    project_item: &ProjectItem,
    write_plan_request: &ProjectItemRuntimeValueWritePlanRequest
) -> SymbolWritePlan
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let locator: LocatorMatch = ProjectItemSymbolResolution::resolve_project_item_locator(
        engine_unprivileged_state, engine_bindings, project_symbol_catalog, project_item);
    transition locator.found {
        true -> layout(engine_unprivileged_state, project_symbol_catalog, project_item, write_plan_request, &locator.locator)
        _ -> (ProjectSymbolRuntimeValueWrite::failed_write_plan("unable to resolve project item runtime target"))
    }
    state layout(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        project_item: &ProjectItem,
        write_plan_request: &ProjectItemRuntimeValueWritePlanRequest,
        project_symbol_locator: &ProjectSymbolLocator
    ) -> SymbolWritePlan {
        let layout: StructLayoutMatch = ProjectItemSymbolResolution::resolve_project_item_struct_layout_id(project_item);
        transition layout.found {
            true -> delegate(engine_unprivileged_state, project_symbol_catalog, write_plan_request, project_symbol_locator, layout.layout_id, layout.layout_id_len)
            _ -> (ProjectSymbolRuntimeValueWrite::failed_write_plan("unable to resolve project item value type"))
        }
    }
    state delegate(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        write_plan_request: &ProjectItemRuntimeValueWritePlanRequest,
        project_symbol_locator: &ProjectSymbolLocator,
        layout_id: [u8; 256],
        layout_id_len: u64
    ) -> SymbolWritePlan {
        let mut symbol_write_plan_request: SymbolRuntimeValueWritePlanRequest = SymbolRuntimeValueWritePlanRequest {
            address: 0,
            module_name_len: 0,
            symbol_type_id_len: 0,
            container_type: ContainerType::None,
            field_name_len: 0,
            anonymous_value_string: AnonymousValueString::clone(&write_plan_request.anonymous_value_string),
        };
        symbol_write_plan_request.address = ProjectSymbolLocator::get_focus_address(project_symbol_locator);
        symbol_write_plan_request.module_name_len = copy_module(&mut symbol_write_plan_request.module_name, project_symbol_locator);
        symbol_write_plan_request.symbol_type_id = layout_id;
        symbol_write_plan_request.symbol_type_id_len = layout_id_len;
        symbol_write_plan_request.field_name = write_plan_request.field_name;
        symbol_write_plan_request.field_name_len = write_plan_request.field_name_len;
        (ProjectSymbolRuntimeValueWrite::build_project_symbol_runtime_value_write_request(
            engine_unprivileged_state, project_symbol_catalog, &symbol_write_plan_request))
    }
}

machine copy_module(out: &mut [u8; 256], project_symbol_locator: &ProjectSymbolLocator) -> u64 {
    let module_name: &[u8] = ProjectSymbolLocator::get_focus_module_name(project_symbol_locator);
    transition { _ -> each(out, module_name, 0) }
    state each(out: &mut [u8; 256], module_name: &[u8], position: u64) -> u64 {
        transition position < module_name.len && position < 256 {
            true -> write(out, module_name, position)
            _ -> (position)
        }
    }
    state write(out: &mut [u8; 256], module_name: &[u8], position: u64) -> u64
        requires position < module_name.len && position < 256;
    {
        out[position] = module_name[position];
        transition { _ -> each(out, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}
