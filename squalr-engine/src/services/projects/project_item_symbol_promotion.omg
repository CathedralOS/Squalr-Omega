    }
    state symbol_text(promoted_symbol: &mut ProjectSymbolClaim, pointer: &OwnedRuntimePointer, project_item: &ProjectItem, segments_text: &mut ManifestPathScratch, position: u64, link: &SymbolicPointerChainLink)
        requires position < 64;
    {
        transition link {
            SymbolicPointerChainLink::Symbol { symbol } -> symbol_emit(promoted_symbol, pointer, project_item, segments_text, position, symbol.symbol_name, symbol.symbol_name_len)
            _ -> segment_each(promoted_symbol, pointer, project_item, segments_text, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state symbol_emit(
        promoted_symbol: &mut ProjectSymbolClaim,
        pointer: &OwnedRuntimePointer,
        project_item: &ProjectItem,
        segments_text: &mut ManifestPathScratch,
        position: u64,
        symbol_name: [u8; 256],
        symbol_name_len: u64
    )
        requires position < 64;
    {
        _ = promotion_append_bytes(segments_text, "symbol:");
        transition symbol_name_len <= 256 {
            true -> symbol_copy(promoted_symbol, pointer, project_item, segments_text, position, &symbol_name, symbol_name_len)
            _ -> segment_each(promoted_symbol, pointer, project_item, segments_text, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state symbol_copy(
        promoted_symbol: &mut ProjectSymbolClaim,
        pointer: &OwnedRuntimePointer,
        project_item: &ProjectItem,
        segments_text: &mut ManifestPathScratch,
        position: u64,
        symbol_name: &[u8; 256],
        symbol_name_len: u64
    )
        requires position < 64 && symbol_name_len <= 256;
    {
        _ = promotion_append_bytes(segments_text, &symbol_name[0..symbol_name_len]);
        transition { _ -> segment_each(promoted_symbol, pointer, project_item, segments_text, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state size_entry(promoted_symbol: &mut ProjectSymbolClaim, pointer: &OwnedRuntimePointer, project_item: &ProjectItem, segments_text: &mut ManifestPathScratch) {
        let inner3137: &[u8] = ManifestPathScratch::get_bytes(segments_text);
        _ = ProjectSymbolClaim::add_metadata(promoted_symbol, "source.pointer_offsets", inner3137);
        let inner3138: PointerScanPointerSize = OwnedRuntimePointer::get_pointer_size(pointer);
        let inner3139: &[u8] = PointerScanPointerSize::spelling(&inner3138);
        _ = ProjectSymbolClaim::add_metadata(promoted_symbol, "source.pointer_size", inner3139);
        transition { _ -> evaluated(promoted_symbol, project_item) }
