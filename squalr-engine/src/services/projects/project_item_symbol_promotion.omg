        transition evaluated_path_len <= 512 {
            true -> evaluated_trim(promoted_symbol, &evaluated_path, evaluated_path_len)
            _ -> done()
        }
    }
    state evaluated_trim(promoted_symbol: &mut ProjectSymbolClaim, evaluated_path: &[u8; 512], evaluated_path_len: u64)
        requires evaluated_path_len <= 512;
    {
        let mut empty_locator_module_name: [u8; 256];
        ProjectItemSymbolPromotion::zero_256(&mut empty_locator_module_name);
        let empty_locator: ProjectSymbolLocator = ProjectSymbolLocator::AbsoluteAddress {
            address: 0,
            module_name: empty_locator_module_name,
            module_name_len: 0,
        };
        let mut trimmed: ManifestPathScratch;
        ManifestPathScratch::new(&mut trimmed);
