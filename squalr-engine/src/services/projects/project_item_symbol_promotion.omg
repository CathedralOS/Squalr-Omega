}

// Upstream `find_exact_symbol_claim` over the catalog (the port's claim
// list IS the catalog — documented in-place deviation).
pub machine ProjectItemSymbolPromotion::find_exact_symbol_claim(
    project_symbol_catalog: &ProjectSymbolCatalog,
    promoted_symbol: &ProjectSymbolClaim
 ) -> PromotedSymbolMatch {
    transition { _ -> scan(project_symbol_catalog, promoted_symbol, 0) }
    state scan(project_symbol_catalog: &ProjectSymbolCatalog, promoted_symbol: &ProjectSymbolClaim, position: u64) -> PromotedSymbolMatch {
        let mut empty_locator_module_name: [u8; 256];
        ProjectItemSymbolPromotion::zero_256(&mut empty_locator_module_name);
        let empty_locator: ProjectSymbolLocator = ProjectSymbolLocator::AbsoluteAddress {
            address: 0,
            module_name: empty_locator_module_name,
            module_name_len: 0,
        };
        transition position < ProjectSymbolCatalog::get_symbol_claim_count(project_symbol_catalog) && position < 128 {
            true -> compare(project_symbol_catalog, promoted_symbol, position)
            _ -> (PromotedSymbolMatch { found: false, promoted_symbol: ProjectSymbolClaim::new("", &empty_locator, "") })
        }
    }
    state compare(project_symbol_catalog: &ProjectSymbolCatalog, promoted_symbol: &ProjectSymbolClaim, position: u64) -> PromotedSymbolMatch
        requires position < 128;
    {
        let existing: &ProjectSymbolClaim = ProjectSymbolCatalog::get_symbol_claim(project_symbol_catalog, position);
        let names_equal: bool = promotion_bytes_equal(
            ProjectSymbolClaim::get_display_name(existing),
            ProjectSymbolClaim::get_display_name(promoted_symbol));
        let layouts_equal: bool = promotion_bytes_equal(
            ProjectSymbolClaim::get_struct_layout_id(existing),
            ProjectSymbolClaim::get_struct_layout_id(promoted_symbol));
        let locators_equal: bool = promotion_locator_equals(
            ProjectSymbolClaim::get_locator(existing),
            ProjectSymbolClaim::get_locator(promoted_symbol));
        transition names_equal && layouts_equal && locators_equal {
            true -> (PromotedSymbolMatch { found: true, promoted_symbol: ProjectSymbolClaim::clone(existing) })
            _ -> scan(project_symbol_catalog, promoted_symbol, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

