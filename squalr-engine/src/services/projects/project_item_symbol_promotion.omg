// Upstream `build_promoted_project_item`: clone + per-type struct-layout
// reference, chain-segment rewrite for address, freeze interpreter carried.
pub machine ProjectItemSymbolPromotion::build_promoted_project_item(
    source_project_item: &ProjectItem,
    promoted_symbol: &ProjectSymbolClaim
 ) -> ProjectItem {
    let mut promoted_project_item: ProjectItem = ProjectItem::clone(source_project_item);
    let inner10: &ProjectItemTypeRef = ProjectItem::get_item_type(source_project_item);
    let source_type_id: &[u8] = ProjectItemTypeRef::get_project_item_type_id(inner10);
    transition ProjectItemSymbolResolution::type_id_is(source_type_id, "address") {
        true -> address_reference(&mut promoted_project_item, source_project_item, promoted_symbol)
        _ -> pointer_reference(&mut promoted_project_item, source_project_item, promoted_symbol)
    }
    state address_reference(promoted_project_item: &mut ProjectItem, source_project_item: &ProjectItem, promoted_symbol: &ProjectSymbolClaim) {
