        catalog_mutated: bool,
        position: u64,
        resolved_path: ManifestPathScratch,
        project_item_ref: ProjectItemRef,
        project_item: ProjectItem,
        promoted_symbol: ProjectSymbolClaim
     ) -> ProjectItemSymbolPromotionChangeSet {
        let mut locator_key: [u8; 256];
        let locator_key_len: u64 = ProjectSymbolClaim::get_symbol_locator_key(&promoted_symbol, &mut locator_key);
        transition locator_key_len <= 256 {
            true -> conflict_find(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, resolved_path, project_item_ref, project_item, promoted_symbol, &locator_key, locator_key_len)
            _ -> skip_with_path(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, resolved_path)
        }
    }
    state conflict_find(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        opened_project: &mut Project,
        project_directory_path: &[u8],
        requested_project_item_paths: &ProjectPathList,
        overwrite_conflicting_symbols: bool,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool,
        position: u64,
        resolved_path: ManifestPathScratch,
        project_item_ref: ProjectItemRef,
        project_item: ProjectItem,
        promoted_symbol: ProjectSymbolClaim,
        locator_key: &[u8; 256],
        locator_key_len: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires locator_key_len <= 256;
    {
        let catalog: &ProjectSymbolCatalog = Project::get_project_symbol_catalog(opened_project);
        let conflict_position: u64 = ProjectSymbolCatalog::find_symbol_claim_position(catalog, &locator_key[0..locator_key_len]);
        transition conflict_position < ProjectSymbolCatalog::get_symbol_claim_count(catalog) {
            true -> conflict_found(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, resolved_path, project_item_ref, project_item, promoted_symbol, locator_key, locator_key_len, conflict_position)
            _ -> dedup_new(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, resolved_path, project_item_ref, project_item, promoted_symbol, locator_key, locator_key_len)
        }
    }
    state conflict_found(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        opened_project: &mut Project,
        project_directory_path: &[u8],
        requested_project_item_paths: &ProjectPathList,
        overwrite_conflicting_symbols: bool,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool,
        position: u64,
        resolved_path: ManifestPathScratch,
        project_item_ref: ProjectItemRef,
        project_item: ProjectItem,
        promoted_symbol: ProjectSymbolClaim,
        locator_key: &[u8; 256],
        locator_key_len: u64,
        conflict_position: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires locator_key_len <= 256;
    {
        transition overwrite_conflicting_symbols {
            true -> dedup_replace(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, resolved_path, project_item_ref, project_item, promoted_symbol, locator_key, locator_key_len, conflict_position)
            _ -> conflict_record(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, resolved_path, project_item_ref, project_item, promoted_symbol, locator_key, locator_key_len, conflict_position)
        }
    }
    // !overwrite: record the conflict row + skip — locator display is the
    // locator key (documented deviation).
    state conflict_record(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        opened_project: &mut Project,
        project_directory_path: &[u8],
        requested_project_item_paths: &ProjectPathList,
        overwrite_conflicting_symbols: bool,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool,
        position: u64,
        resolved_path: ManifestPathScratch,
        project_item_ref: ProjectItemRef,
        project_item: ProjectItem,
        promoted_symbol: ProjectSymbolClaim,
        locator_key: &[u8; 256],
        locator_key_len: u64,
        conflict_position: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires locator_key_len <= 256;
    {
        transition conflict_position < 128 {
            true -> conflict_claim(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, resolved_path, project_item_ref, project_item, promoted_symbol, locator_key, locator_key_len, conflict_position)
            _ -> skip_with_path(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, resolved_path)
        }
    }
    state conflict_claim(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        opened_project: &mut Project,
        project_directory_path: &[u8],
        requested_project_item_paths: &ProjectPathList,
        overwrite_conflicting_symbols: bool,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool,
        position: u64,
        resolved_path: ManifestPathScratch,
        project_item_ref: ProjectItemRef,
        project_item: ProjectItem,
        promoted_symbol: ProjectSymbolClaim,
        locator_key: &[u8; 256],
        locator_key_len: u64,
        conflict_position: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires locator_key_len <= 256 && conflict_position < 128;
    {
        let conflict_catalog: &ProjectSymbolCatalog = Project::get_project_symbol_catalog(opened_project);
        let existing_claim: &ProjectSymbolClaim = ProjectSymbolCatalog::get_symbol_claim(
            conflict_catalog,
            conflict_position);
        let mut existing_locator_key: [u8; 256];
        let existing_locator_key_len: u64 = ProjectSymbolClaim::get_symbol_locator_key(existing_claim, &mut existing_locator_key);
        transition existing_locator_key_len <= 256 {
            true -> conflict_emit(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, resolved_path, promoted_symbol, locator_key, locator_key_len, existing_claim, &existing_locator_key, existing_locator_key_len)
            _ -> skip_with_path(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, resolved_path)
        }
    }
    state conflict_emit(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        opened_project: &mut Project,
        project_directory_path: &[u8],
        requested_project_item_paths: &ProjectPathList,
        overwrite_conflicting_symbols: bool,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool,
        position: u64,
        resolved_path: ManifestPathScratch,
        promoted_symbol: ProjectSymbolClaim,
        locator_key: &[u8; 256],
        locator_key_len: u64,
        existing_claim: &ProjectSymbolClaim,
        existing_locator_key: &[u8; 256],
        existing_locator_key_len: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires locator_key_len <= 256 && existing_locator_key_len <= 256;
    {
        let conflict: ProjectItemsPromoteSymbolConflict = ProjectItemsPromoteSymbolConflict::new_with(
            ManifestPathScratch::get_bytes(&resolved_path),
            &locator_key[0..locator_key_len],
            ProjectSymbolClaim::get_display_name(existing_claim),
            &existing_locator_key[0..existing_locator_key_len],
            ProjectSymbolClaim::get_display_name(&promoted_symbol));
        _ = PromotionConflictList::push(&mut change_set.conflicts, &conflict);
        transition { _ -> next_path(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position) }
    }
    // Conflict + overwrite: dedup with the replaced claim's key ignored.
    state dedup_replace(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        opened_project: &mut Project,
        project_directory_path: &[u8],
        requested_project_item_paths: &ProjectPathList,
        overwrite_conflicting_symbols: bool,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool,
        position: u64,
        resolved_path: ManifestPathScratch,
        project_item_ref: ProjectItemRef,
        project_item: ProjectItem,
        promoted_symbol: ProjectSymbolClaim,
        locator_key: &[u8; 256],
        locator_key_len: u64,
        conflict_position: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires locator_key_len <= 256;
    {
        let mut name_scope: ProjectSymbolNameScope = ProjectSymbolNameScope {};
        let mut deduped_name: ManifestPathScratch;
        ManifestPathScratch::new(&mut deduped_name);
        _ = ProjectSymbolNameScope::deduplicate_display_name(
            &mut name_scope,
            Project::get_project_symbol_catalog(opened_project),
            ProjectSymbolClaim::get_locator(&promoted_symbol),
            ProjectSymbolClaim::get_display_name(&promoted_symbol),
            &locator_key[0..locator_key_len],
            true,
            &mut deduped_name);
        transition conflict_position < 128 {
            true -> replace_claim(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, resolved_path, project_item_ref, project_item, promoted_symbol, locator_key, locator_key_len, conflict_position, deduped_name)
            _ -> next_path(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position)
        }
    }
    state replace_claim(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        opened_project: &mut Project,
        project_directory_path: &[u8],
        requested_project_item_paths: &ProjectPathList,
        overwrite_conflicting_symbols: bool,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool,
        position: u64,
        resolved_path: ManifestPathScratch,
        project_item_ref: ProjectItemRef,
        project_item: ProjectItem,
        promoted_symbol: ProjectSymbolClaim,
        locator_key: &[u8; 256],
        locator_key_len: u64,
        conflict_position: u64,
        deduped_name: ManifestPathScratch
     ) -> ProjectItemSymbolPromotionChangeSet
        requires locator_key_len <= 256 && conflict_position < 128;
    {
        let mut promoted: ProjectSymbolClaim = promoted_symbol;
        ProjectSymbolClaim::set_display_name(&mut promoted, ManifestPathScratch::get_bytes(&deduped_name));
        _ = ProjectSymbolCatalog::set_symbol_claim_at(
            Project::borrow_project_symbol_catalog_mut(opened_project),
            conflict_position,
            &promoted);
        transition { _ -> promoted_entry(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, position, resolved_path, project_item_ref, project_item, promoted, locator_key, locator_key_len) }
    }
    // Fresh claim: dedup without an ignored key, then append.
    state dedup_new(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        opened_project: &mut Project,
        project_directory_path: &[u8],
        requested_project_item_paths: &ProjectPathList,
        overwrite_conflicting_symbols: bool,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool,
        position: u64,
        resolved_path: ManifestPathScratch,
        project_item_ref: ProjectItemRef,
        project_item: ProjectItem,
        promoted_symbol: ProjectSymbolClaim,
        locator_key: &[u8; 256],
        locator_key_len: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires locator_key_len <= 256;
    {
        let mut name_scope: ProjectSymbolNameScope = ProjectSymbolNameScope {};
        let mut deduped_name: ManifestPathScratch;
        ManifestPathScratch::new(&mut deduped_name);
        _ = ProjectSymbolNameScope::deduplicate_display_name(
            &mut name_scope,
            Project::get_project_symbol_catalog(opened_project),
            ProjectSymbolClaim::get_locator(&promoted_symbol),
            ProjectSymbolClaim::get_display_name(&promoted_symbol),
            &locator_key[0..locator_key_len],
            false,
            &mut deduped_name);
        let mut promoted: ProjectSymbolClaim = promoted_symbol;
        ProjectSymbolClaim::set_display_name(&mut promoted, ManifestPathScratch::get_bytes(&deduped_name));
        _ = ProjectSymbolCatalog::add_symbol_claim(
            Project::borrow_project_symbol_catalog_mut(opened_project),
            &promoted);
        transition { _ -> promoted_entry(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, position, resolved_path, project_item_ref, project_item, promoted, locator_key, locator_key_len) }
    }
    // Shared post-add path: promoted++, locator key, upsert, replacement.
    state promoted_entry(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        opened_project: &mut Project,
        project_directory_path: &[u8],
        requested_project_item_paths: &ProjectPathList,
        overwrite_conflicting_symbols: bool,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        position: u64,
        resolved_path: ManifestPathScratch,
        project_item_ref: ProjectItemRef,
        project_item: ProjectItem,
        promoted_symbol: ProjectSymbolClaim,
        locator_key: &[u8; 256],
        locator_key_len: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires locator_key_len <= 256;
    {
        _ = ProjectStringList::add_string(&mut change_set.promoted_symbol_locator_keys, &locator_key[0..locator_key_len]);
        _ = PromotionClaimList::push(layout_upserts, &promoted_symbol);
        let replacement_item: ProjectItem = ProjectItemSymbolPromotion::build_promoted_project_item(&project_item, &promoted_symbol);
        _ = PromotionReplacementList::push(replacements, &project_item_ref, &replacement_item);
        transition change_set.promoted_symbol_count < 18446744073709551615 {
            true -> promoted_advance(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, position)
            _ -> advance_mutated(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, position)
        }
    }
    state promoted_advance(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        opened_project: &mut Project,
        project_directory_path: &[u8],
        requested_project_item_paths: &ProjectPathList,
        overwrite_conflicting_symbols: bool,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        position: u64
     ) -> ProjectItemSymbolPromotionChangeSet {
        change_set.promoted_symbol_count = ((change_set.promoted_symbol_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> advance_mutated(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, position) }
    }
    // did_mutate_symbol_catalog = true, then `continue`.
    state advance_mutated(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        opened_project: &mut Project,
        project_directory_path: &[u8],
        requested_project_item_paths: &ProjectPathList,
        overwrite_conflicting_symbols: bool,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        position: u64
     ) -> ProjectItemSymbolPromotionChangeSet {
        transition overwrite_conflicting_symbols {
            true -> next_path_overwrite(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, position)
            _ -> next_path_overwrite(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, position)
        }
    }
    state next_path_overwrite(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        opened_project: &mut Project,
        project_directory_path: &[u8],
        requested_project_item_paths: &ProjectPathList,
        overwrite_conflicting_symbols: bool,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        position: u64
     ) -> ProjectItemSymbolPromotionChangeSet {
        transition { _ -> request_each(engine_unprivileged_state, engine_bindings, opened_project, project_directory_path, requested_project_item_paths, overwrite_conflicting_symbols, change_set, module_size_hints, layout_upserts, replacements, true, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    // ---- post-loop ----

    // `if project_item_replacements.is_empty() && !did_mutate { return }`.
    state post_loop(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        opened_project: &mut Project,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool
     ) -> ProjectItemSymbolPromotionChangeSet {
        transition replacements.count == 0 && !catalog_mutated {
            true -> (ProjectItemSymbolPromotionChangeSet::clone(change_set))
            _ -> write_items(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, 0)
        }
    }
    // `*project_item = replacement` + set_has_unsaved_changes(true).
    state write_items(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        opened_project: &mut Project,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool,
        position: u64
     ) -> ProjectItemSymbolPromotionChangeSet {
        transition position < replacements.count && position < 64 {
            true -> write_item(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position)
            _ -> catalog_phase(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, catalog_mutated)
        }
    }
    state write_item(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        opened_project: &mut Project,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool,
        position: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires position < 64;
    {
        let lookup_result: ProjectItemLookup = Project::lookup_project_item_index(
            opened_project,
            ProjectItemPair::get_project_item_ref(&replacements.pairs[position]));
        transition lookup_result {
            ProjectItemLookup::Found { index } -> write_pair(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, index)
            _ -> write_items(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state write_pair(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        opened_project: &mut Project,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool,
        position: u64,
        index: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires position < 64;
    {
        transition index < Project::get_project_items_len(opened_project) && index < 256 {
            true -> assign_item(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, position, index)
            _ -> write_items(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state assign_item(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        opened_project: &mut Project,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        replacements: &mut PromotionReplacementList,
        catalog_mutated: bool,
        position: u64,
        index: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires position < 64 && index < 256;
    {
        let mut replacement_item: ProjectItem = ProjectItem::clone(ProjectItemPair::get_project_item(&replacements.pairs[position]));
        ProjectItem::set_has_unsaved_changes(&mut replacement_item, true);
        ProjectItem::clone_from(
            ProjectItemPair::borrow_project_item_mut(Project::borrow_project_item_pair_mut(opened_project, index)),
            &replacement_item);
        transition { _ -> write_items(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, replacements, catalog_mutated, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    // `should_update_symbol_catalog = mutated || upserts nonempty`.
    state catalog_phase(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        opened_project: &mut Project,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        catalog_mutated: bool
     ) -> ProjectItemSymbolPromotionChangeSet {
        transition catalog_mutated || layout_upserts.count > 0 {
            true -> update_catalog(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts)
            _ -> dirty_only(opened_project, change_set)
        }
    }
    state dirty_only(opened_project: &mut Project, change_set: &mut ProjectItemSymbolPromotionChangeSet) -> ProjectItemSymbolPromotionChangeSet {
        ProjectInfo::set_has_unsaved_changes(Project::borrow_project_info_mut(opened_project), true);
        transition { _ -> finish(change_set) }
    }
    state update_catalog(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        opened_project: &mut Project,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList
     ) -> ProjectItemSymbolPromotionChangeSet {
        transition { _ -> hints_each(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, 0) }
    }
    state hints_each(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        opened_project: &mut Project,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        position: u64
     ) -> ProjectItemSymbolPromotionChangeSet {
        transition position < module_size_hints.count && position < 16 {
            true -> hint_apply(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, position)
            _ -> upserts_each(engine_unprivileged_state, opened_project, change_set, layout_upserts, 0)
        }
    }
    state hint_apply(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        opened_project: &mut Project,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        position: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires position < 16;
    {
        transition module_size_hints.name_lens[position] <= 256 {
            true -> hint_apply_at(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, position)
            _ -> hints_each(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state hint_apply_at(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        opened_project: &mut Project,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        module_size_hints: &mut PromotionModuleSizeHintList,
        layout_upserts: &mut PromotionClaimList,
        position: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires position < 16 && module_size_hints.name_lens[position] <= 256;
    {
        let catalog: &mut ProjectSymbolCatalog = Project::borrow_project_symbol_catalog_mut(opened_project);
        let module_name: &[u8] = &module_size_hints.names[position][0..module_size_hints.name_lens[position]];
        ProjectSymbolCatalog::ensure_symbol_module(catalog, module_name, module_size_hints.sizes[position]);
        ProjectItemSymbolPromotion::ensure_module_root_struct_layout(engine_unprivileged_state, catalog, module_name, module_size_hints.sizes[position]);
        transition { _ -> hints_each(engine_unprivileged_state, opened_project, change_set, module_size_hints, layout_upserts, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state upserts_each(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        opened_project: &mut Project,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        layout_upserts: &mut PromotionClaimList,
        position: u64
     ) -> ProjectItemSymbolPromotionChangeSet {
        transition position < layout_upserts.count && position < 64 {
            true -> upsert_apply(engine_unprivileged_state, opened_project, change_set, layout_upserts, position)
            _ -> catalog_stored(opened_project, change_set)
        }
    }
    state upsert_apply(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        opened_project: &mut Project,
        change_set: &mut ProjectItemSymbolPromotionChangeSet,
        layout_upserts: &mut PromotionClaimList,
        position: u64
     ) -> ProjectItemSymbolPromotionChangeSet
        requires position < 64;
    {
        _ = ProjectItemSymbolPromotion::upsert_promoted_module_symbol_layout_field(
            engine_unprivileged_state,
            Project::borrow_project_symbol_catalog_mut(opened_project),
            &layout_upserts.claims[position]);
        transition { _ -> upserts_each(engine_unprivileged_state, opened_project, change_set, layout_upserts, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    // `project_info.set_has_unsaved_changes(true)` + `Some(updated_catalog)`
    // — the catalog is in place, so the flag carries the Option.
    state catalog_stored(opened_project: &mut Project, change_set: &mut ProjectItemSymbolPromotionChangeSet) -> ProjectItemSymbolPromotionChangeSet {
        ProjectInfo::set_has_unsaved_changes(Project::borrow_project_info_mut(opened_project), true);
        change_set.has_updated_project_symbol_catalog = true;
        transition { _ -> finish(change_set) }
    }
    state finish(change_set: &mut ProjectItemSymbolPromotionChangeSet) -> ProjectItemSymbolPromotionChangeSet {
        change_set.should_save_project = true;
        (ProjectItemSymbolPromotionChangeSet::clone(change_set))
    }
}


// Bounded-index zero fill for fixed 256-byte name buffers.
pub machine ProjectItemSymbolPromotion::zero_256(out: &mut [u8; 256]) {
    transition { _ -> each(out, 0) }
    state each(out: &mut [u8; 256], position: u64) {
        transition position < 256 {
            true -> write(out, position)
            _ -> done()
        }
    }
    state write(out: &mut [u8; 256], position: u64)
        requires position < 256;
    {
        out[position] = 0;
        transition { _ -> each(out, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state done() { }
}
