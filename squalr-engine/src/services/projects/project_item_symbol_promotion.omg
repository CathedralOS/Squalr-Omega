// ---- carriers ----

// Upstream `BTreeMap<String, u64>` keyed by module name — bounded list with
// a max-upsert matching `entry().and_modify(max).or_insert()`.
pub data PromotionModuleSizeHintList {
    names: [[u8; 256]; 16];
    name_lens: [u64; 16];
    sizes: [u64; 16];
    count: u64;
}

// Upstream `Vec<ProjectSymbolClaim>` — claims mirrored into module layouts.
pub data PromotionClaimList {
    claims: [ProjectSymbolClaim; 64];
    count: u64;
}

// Upstream `Vec<(ProjectItemRef, ProjectItem)>` write-back list — the pair
// record is exactly the (ref, item) tuple.
pub data PromotionReplacementList {
    pairs: [ProjectItemPair; 64];
    count: u64;
}

// Upstream `Vec<ProjectItemsPromoteSymbolConflict>` on the change set.
pub data PromotionConflictList {
    conflicts: [ProjectItemsPromoteSymbolConflict; 16];
    count: u64;
}

// Upstream private `SymbolicFieldSpan`.
pub data SymbolicFieldSpan [copy] {
    field_index: u64;
    offset_in_bytes: u64;
    size_in_bytes: u64;
}

pub data SymbolicFieldSpanList [copy] {
    spans: [SymbolicFieldSpan; 64];
    count: u64;
}

// Upstream private `ContainingChildStructLayout` + the `Option<usize>` span
// size that sorted it (smallest containing span wins).
pub data ContainingChildMatch [copy] {
    found: bool;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
    offset_in_child: u64;
}

// `Option<u64>` for queried module sizes.
pub data ModuleSizeMatch [copy] {
    found: bool;
    size_in_bytes: u64;
}

// `Option<(String, u64)>` for `(module_name, size_hint)`.
pub data ModuleHintMatch {
    found: bool;
    module_name: [u8; 256];
    module_name_len: u64;
    size_in_bytes: u64;
}

// `Option<ProjectSymbolClaim>` for `build_promoted_symbol`.
pub data PromotedSymbolMatch {
    found: bool;
    promoted_symbol: ProjectSymbolClaim;
}

// `Result<SymbolicStructDefinition, String>` — failures log-and-continue
// upstream, so the message collapses to `found`.
pub data FieldUpsertResult {
    found: bool;
    struct_layout_definition: SymbolicStructDefinition;
}

// Upstream `ProjectItemSymbolPromotionChangeSet`. `updated_project_symbol_
// catalog` (Option) collapses to `has_updated_project_symbol_catalog` — the
// port mutates the project's catalog in place, so the executor re-reads the
// catalog from the project rather than receiving a clone back.
pub data ProjectItemSymbolPromotionChangeSet {
    should_save_project: bool;
    has_updated_project_symbol_catalog: bool;
    promoted_symbol_count: u64;
    reused_symbol_count: u64;
    promoted_symbol_locator_keys: ProjectStringList;
    conflicts: PromotionConflictList;
}

pub data ProjectItemSymbolPromotion {}

// Shared byte-slice equality — the private `bytes_equal` helpers in api
// are not importable across packages.
machine promotion_bytes_equal(left: &[u8], right: &[u8]) -> bool {
    transition left.len == right.len {
        true -> scan(left, right, 0)
        _ -> (false)
    }
    state scan(left: &[u8], right: &[u8], position: u64) -> bool {
        transition position < left.len {
            true -> byte(left, right, position)
            _ -> (true)
        }
    }
    state byte(left: &[u8], right: &[u8], position: u64) -> bool
        requires position < left.len;
    {
        transition left[position] == right[position] {
            true -> scan(left, right, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// Upstream `NO_OPENED_PROCESS_STATUS_MESSAGE`.
pub machine ProjectItemSymbolPromotion::no_opened_process_status_message() -> &[u8] {
    ("Cannot promote project items to symbols without an opened process.")
}

// ---- list helpers ----

pub machine PromotionModuleSizeHintList::new(promotion_module_size_hint_list: &mut PromotionModuleSizeHintList) {
    promotion_module_size_hint_list.count = 0;
}

// Upstream `entry(name).and_modify(max).or_insert(hint)` verbatim.
pub machine PromotionModuleSizeHintList::upsert_max(promotion_module_size_hint_list: &mut PromotionModuleSizeHintList, module_name: &[u8], size_hint: u64) {
    transition { _ -> scan(promotion_module_size_hint_list, module_name, size_hint, 0) }
    state scan(promotion_module_size_hint_list: &mut PromotionModuleSizeHintList, module_name: &[u8], size_hint: u64, position: u64) {
        transition position < promotion_module_size_hint_list.count && position < 16 {
            true -> compare(promotion_module_size_hint_list, module_name, size_hint, position)
            _ -> append(promotion_module_size_hint_list, module_name, size_hint)
        }
    }
    state compare(promotion_module_size_hint_list: &mut PromotionModuleSizeHintList, module_name: &[u8], size_hint: u64, position: u64)
        requires position < 16;
    {
        let name_len: u64 = promotion_module_size_hint_list.name_lens[position];
        let name_equal: bool = promotion_bytes_equal(&promotion_module_size_hint_list.names[position][0..256], module_name);
        transition name_len == module_name.len && name_equal {
            true -> apply_max(promotion_module_size_hint_list, size_hint, position)
            _ -> scan(promotion_module_size_hint_list, module_name, size_hint, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state apply_max(promotion_module_size_hint_list: &mut PromotionModuleSizeHintList, size_hint: u64, position: u64)
        requires position < 16;
    {
        transition promotion_module_size_hint_list.sizes[position] < size_hint {
            true -> store(promotion_module_size_hint_list, size_hint, position)
            _ -> done()
        }
    }
    state store(promotion_module_size_hint_list: &mut PromotionModuleSizeHintList, size_hint: u64, position: u64)
        requires position < 16;
    {
        promotion_module_size_hint_list.sizes[position] = size_hint;
    }
    state append(promotion_module_size_hint_list: &mut PromotionModuleSizeHintList, module_name: &[u8], size_hint: u64) {
        transition promotion_module_size_hint_list.count < 16 && module_name.len <= 256 {
            true -> insert(promotion_module_size_hint_list, module_name, size_hint)
            _ -> done()
        }
    }
    state insert(promotion_module_size_hint_list: &mut PromotionModuleSizeHintList, module_name: &[u8], size_hint: u64)
        requires promotion_module_size_hint_list.count < 16;
    {
        promotion_module_size_hint_list.sizes[promotion_module_size_hint_list.count] = size_hint;
        promotion_module_size_hint_list.name_lens[promotion_module_size_hint_list.count] = module_name.len;
        transition { _ -> copy_name(promotion_module_size_hint_list, module_name, promotion_module_size_hint_list.count, 0) }
    }
    state copy_name(promotion_module_size_hint_list: &mut PromotionModuleSizeHintList, module_name: &[u8], insert_position: u64, index: u64)
        requires insert_position < 16;
    {
        transition index < module_name.len && index < 256 {
            true -> copy_byte(promotion_module_size_hint_list, module_name, insert_position, index)
            _ -> finish(promotion_module_size_hint_list)
        }
    }
    state copy_byte(promotion_module_size_hint_list: &mut PromotionModuleSizeHintList, module_name: &[u8], insert_position: u64, index: u64)
        requires insert_position < 16;
    {
        promotion_module_size_hint_list.names[insert_position][index] = module_name[index];
        transition { _ -> copy_name(promotion_module_size_hint_list, module_name, insert_position, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(promotion_module_size_hint_list: &mut PromotionModuleSizeHintList) {
        transition promotion_module_size_hint_list.count < 18446744073709551615 {
            true -> increment(promotion_module_size_hint_list)
            _ -> done()
        }
    }
    state increment(promotion_module_size_hint_list: &mut PromotionModuleSizeHintList) {
        promotion_module_size_hint_list.count = ((promotion_module_size_hint_list.count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    }
    state done() { }
}

pub machine PromotionClaimList::new(promotion_claim_list: &mut PromotionClaimList) {
    promotion_claim_list.count = 0;
}

pub machine PromotionClaimList::push(promotion_claim_list: &mut PromotionClaimList, claim: &ProjectSymbolClaim) -> bool {
    transition promotion_claim_list.count < 64 {
        true -> store(promotion_claim_list, claim)
        _ -> (false)
    }
    state store(promotion_claim_list: &mut PromotionClaimList, claim: &ProjectSymbolClaim) -> bool {
        let insert_position: u64 = promotion_claim_list.count;
        ProjectSymbolClaim::clone_from(&mut promotion_claim_list.claims[insert_position], claim);
        promotion_claim_list.count = ((promotion_claim_list.count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine PromotionReplacementList::new(promotion_replacement_list: &mut PromotionReplacementList) {
    promotion_replacement_list.count = 0;
}

pub machine PromotionReplacementList::push(promotion_replacement_list: &mut PromotionReplacementList, project_item_ref: &ProjectItemRef, project_item: &ProjectItem) -> bool {
    transition promotion_replacement_list.count < 64 {
        true -> store(promotion_replacement_list, project_item_ref, project_item)
        _ -> (false)
    }
    state store(promotion_replacement_list: &mut PromotionReplacementList, project_item_ref: &ProjectItemRef, project_item: &ProjectItem) -> bool
        requires promotion_replacement_list.count < 64;
    {
        let cloned_ref: ProjectItemRef = ProjectItemRef::clone(project_item_ref);
        let cloned_item: ProjectItem = ProjectItem::clone(project_item);
        promotion_replacement_list.pairs[promotion_replacement_list.count] = ProjectItemPair::new(cloned_ref, cloned_item);
        promotion_replacement_list.count = ((promotion_replacement_list.count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine PromotionConflictList::new(promotion_conflict_list: &mut PromotionConflictList) {
    promotion_conflict_list.count = 0;
}

pub machine PromotionConflictList::clone(
    source: &PromotionConflictList
) -> PromotionConflictList {
    let mut cloned: PromotionConflictList;
    PromotionConflictList::new(&mut cloned);
    transition { _ -> each(source, &mut cloned, 0) }
    state each(source: &PromotionConflictList, cloned: &mut PromotionConflictList, position: u64) -> PromotionConflictList {
        transition position < source.count && position < 16 {
            true -> copy(source, cloned, position)
            _ -> (PromotionConflictList { conflicts: cloned.conflicts, count: cloned.count })
        }
    }
    state copy(source: &PromotionConflictList, cloned: &mut PromotionConflictList, position: u64) -> PromotionConflictList
        requires position < 16;
    {
        cloned.conflicts[position] = ProjectItemsPromoteSymbolConflict::clone(&source.conflicts[position]);
        cloned.count = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> each(source, cloned, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

pub machine PromotionConflictList::push(promotion_conflict_list: &mut PromotionConflictList, conflict: &ProjectItemsPromoteSymbolConflict) -> bool {
    transition promotion_conflict_list.count < 16 {
        true -> store(promotion_conflict_list, conflict)
        _ -> (false)
    }
    state store(promotion_conflict_list: &mut PromotionConflictList, conflict: &ProjectItemsPromoteSymbolConflict) -> bool
        requires promotion_conflict_list.count < 16;
    {
        promotion_conflict_list.conflicts[promotion_conflict_list.count] = ProjectItemsPromoteSymbolConflict::clone(conflict);
        promotion_conflict_list.count = ((promotion_conflict_list.count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine SymbolicFieldSpanList::new(symbolic_field_span_list: &mut SymbolicFieldSpanList) {
    symbolic_field_span_list.count = 0;
}

pub machine SymbolicFieldSpanList::push(symbolic_field_span_list: &mut SymbolicFieldSpanList, field_index: u64, offset_in_bytes: u64, size_in_bytes: u64) {
    transition symbolic_field_span_list.count < 64 {
        true -> store(symbolic_field_span_list, field_index, offset_in_bytes, size_in_bytes)
        _ -> done()
    }
    state store(symbolic_field_span_list: &mut SymbolicFieldSpanList, field_index: u64, offset_in_bytes: u64, size_in_bytes: u64) {
        let insert_position: u64 = symbolic_field_span_list.count;
        symbolic_field_span_list.spans[insert_position].field_index = field_index;
        symbolic_field_span_list.spans[insert_position].offset_in_bytes = offset_in_bytes;
        symbolic_field_span_list.spans[insert_position].size_in_bytes = size_in_bytes;
        symbolic_field_span_list.count = ((symbolic_field_span_list.count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    }
    state done() { }
}

pub machine ProjectItemSymbolPromotionChangeSet::new() -> ProjectItemSymbolPromotionChangeSet {
    let mut conflicts: PromotionConflictList;
    PromotionConflictList::new(&mut conflicts);
    ProjectItemSymbolPromotionChangeSet {
        should_save_project: false,
        has_updated_project_symbol_catalog: false,
        promoted_symbol_count: 0,
        reused_symbol_count: 0,
        promoted_symbol_locator_keys: ProjectStringList::empty(),
        conflicts: conflicts,
    }
}

pub machine ProjectItemSymbolPromotionChangeSet::clone(source: &ProjectItemSymbolPromotionChangeSet) -> ProjectItemSymbolPromotionChangeSet {
    ProjectItemSymbolPromotionChangeSet {
        should_save_project: source.should_save_project,
        has_updated_project_symbol_catalog: source.has_updated_project_symbol_catalog,
        promoted_symbol_count: source.promoted_symbol_count,
        reused_symbol_count: source.reused_symbol_count,
        promoted_symbol_locator_keys: ProjectStringList::clone(&source.promoted_symbol_locator_keys),
        conflicts: PromotionConflictList::clone(&source.conflicts),
    }
}

// ---- privileged query hops ----

// Upstream `query_has_opened_process` — the mpsc channel + recv_timeout
// resolves to the synchronous mailbox hop.
pub machine ProjectItemSymbolPromotion::query_has_opened_process(
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings
 )
 -> bool
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let mut mailbox: PrivilegedResponseMailbox = PrivilegedResponseMailbox::default();
    let request: MemoryQueryRequest = MemoryQueryRequest::default();
    let command: PrivilegedCommand = PrivilegedCommand::Memory { command: MemoryCommand::Query { request: request } };
    _ = StandaloneEngineApiUnprivilegedBindings::dispatch_privileged_command(engine_bindings, &command, &mut mailbox);
    transition mailbox {
        PrivilegedResponseMailbox::Delivered { response } -> domain(response)
        _ -> (false)
    }
    state domain(response: PrivilegedCommandResponse) -> bool {
        transition response {
            PrivilegedCommandResponse::Memory { response } -> leaf(response)
            _ -> (false)
        }
    }
    state leaf(response: MemoryResponse) -> bool {
        transition response {
            MemoryResponse::Query { response } -> (MemoryQueryResponse::get_success(&response))
            _ -> (false)
        }
    }
}

// Upstream `query_loaded_module_size`: module lookup by name, then the size
// is max(region_size, containing_page_end - module_base).
pub machine ProjectItemSymbolPromotion::query_loaded_module_size(
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    module_name: &[u8]
 ) -> ModuleSizeMatch
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let mut mailbox: PrivilegedResponseMailbox = PrivilegedResponseMailbox::default();
    let request: MemoryQueryRequest = MemoryQueryRequest::default();
    let command: PrivilegedCommand = PrivilegedCommand::Memory { command: MemoryCommand::Query { request: request } };
    _ = StandaloneEngineApiUnprivilegedBindings::dispatch_privileged_command(engine_bindings, &command, &mut mailbox);
    transition mailbox {
        PrivilegedResponseMailbox::Delivered { response } -> domain(response, module_name)
        _ -> (ModuleSizeMatch { found: false, size_in_bytes: 0 })
    }
    state domain(response: PrivilegedCommandResponse, module_name: &[u8]) -> ModuleSizeMatch {
        transition response {
            PrivilegedCommandResponse::Memory { response } -> leaf(response, module_name)
            _ -> (ModuleSizeMatch { found: false, size_in_bytes: 0 })
        }
    }
    state leaf(response: MemoryResponse, module_name: &[u8]) -> ModuleSizeMatch {
        transition response {
            MemoryResponse::Query { response } -> respond(response, module_name)
            _ -> (ModuleSizeMatch { found: false, size_in_bytes: 0 })
        }
    }
    state respond(query_response: MemoryQueryResponse, module_name: &[u8]) -> ModuleSizeMatch {
        transition MemoryQueryResponse::get_success(&query_response) {
            true -> modules(&query_response, module_name, 0)
            _ -> (ModuleSizeMatch { found: false, size_in_bytes: 0 })
        }
    }
    state modules(query_response: &MemoryQueryResponse, module_name: &[u8], position: u64) -> ModuleSizeMatch {
        transition position < MemoryQueryResponse::get_module_count(query_response) {
            true -> named(query_response, module_name, position)
            _ -> (ModuleSizeMatch { found: false, size_in_bytes: 0 })
        }
    }
    state named(query_response: &MemoryQueryResponse, module_name: &[u8], position: u64) -> ModuleSizeMatch {
        let loaded_module: &NormalizedModule = MemoryQueryResponse::get_module(query_response, position);
        let name_equal: bool = promotion_bytes_equal(NormalizedModule::get_module_name(loaded_module), module_name);
        transition name_equal {
            true -> pages(query_response, NormalizedModule::get_base_address(loaded_module), NormalizedModule::get_region_size(loaded_module), 0)
            _ -> modules(query_response, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    // `unwrap_or(0).max(loaded_module_size)` — page miss contributes 0.
    state pages(query_response: &MemoryQueryResponse, module_base_address: u64, loaded_module_size: u64, position: u64) -> ModuleSizeMatch {
        transition position < MemoryQueryResponse::get_virtual_page_count(query_response) {
            true -> contains(query_response, module_base_address, loaded_module_size, position)
            _ -> (ModuleSizeMatch { found: true, size_in_bytes: loaded_module_size })
        }
    }
    state contains(query_response: &MemoryQueryResponse, module_base_address: u64, loaded_module_size: u64, position: u64) -> ModuleSizeMatch {
        let virtual_page: &NormalizedRegion = MemoryQueryResponse::get_virtual_page(query_response, position);
        transition NormalizedRegion::contains_address(virtual_page, module_base_address) {
            true -> page_size(module_base_address, loaded_module_size, NormalizedRegion::get_end_address(virtual_page))
            _ -> pages(query_response, module_base_address, loaded_module_size, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state page_size(module_base_address: u64, loaded_module_size: u64, page_end_address: u64) -> ModuleSizeMatch {
        let mut page_span: u64 = 0;
        transition page_end_address >= module_base_address {
            true -> saturating(module_base_address, loaded_module_size, page_end_address)
            _ -> pick(loaded_module_size, page_span)
        }
    }
    state saturating(module_base_address: u64, loaded_module_size: u64, page_end_address: u64) -> ModuleSizeMatch {
        transition page_end_address >= module_base_address {
            true -> pick(loaded_module_size, page_end_address - module_base_address)
            _ -> pick(loaded_module_size, 0)
        }
    }
    state pick(loaded_module_size: u64, page_span: u64) -> ModuleSizeMatch {
        transition loaded_module_size >= page_span {
            true -> (ModuleSizeMatch { found: true, size_in_bytes: loaded_module_size })
            _ -> (ModuleSizeMatch { found: true, size_in_bytes: page_span })
        }
    }
}

// Upstream `resolve_promoted_symbol_module_size_hint`: ModuleOffset claims
// hint `max(queried_size.unwrap_or(minimum), minimum)`; anything else misses.
pub machine ProjectItemSymbolPromotion::resolve_promoted_symbol_module_size_hint(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_symbol_catalog: &ProjectSymbolCatalog,
    promoted_symbol: &ProjectSymbolClaim
 ) -> ModuleHintMatch
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let inner1: &ProjectSymbolLocator = ProjectSymbolClaim::get_locator(promoted_symbol);
    let locator: ProjectSymbolLocator = ProjectSymbolLocator::clone(inner1);
    let mut empty_module_name: [u8; 256];
    ProjectItemSymbolPromotion::zero_256(&mut empty_module_name);
    transition locator {
        ProjectSymbolLocator::ModuleOffset { module_name, module_name_len, offset } -> bounded(engine_unprivileged_state, engine_bindings, project_symbol_catalog, promoted_symbol, module_name, module_name_len, offset)
        _ -> (ModuleHintMatch { found: false, module_name_len: 0, size_in_bytes: 0, module_name: empty_module_name })
    }
    state bounded(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        project_symbol_catalog: &ProjectSymbolCatalog,
        promoted_symbol: &ProjectSymbolClaim,
        module_name: [u8; 256],
        module_name_len: u64,
        offset: u64
     ) -> ModuleHintMatch {
        let mut empty_module_name: [u8; 256];
        ProjectItemSymbolPromotion::zero_256(&mut empty_module_name);
        transition module_name_len <= 256 {
            true -> estimate(engine_unprivileged_state, engine_bindings, project_symbol_catalog, promoted_symbol, module_name, module_name_len, offset)
            _ -> (ModuleHintMatch { found: false, module_name_len: 0, size_in_bytes: 0, module_name: empty_module_name })
        }
    }
    state estimate(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        project_symbol_catalog: &ProjectSymbolCatalog,
        promoted_symbol: &ProjectSymbolClaim,
        module_name: [u8; 256],
        module_name_len: u64,
        offset: u64
     ) -> ModuleHintMatch
        requires module_name_len <= 256;
    {
        // the estimate, max(1), then saturating add — the minimum module size.
        let claim_size: u64 = ProjectItemSymbolPromotion::estimate_symbol_claim_size_in_bytes(engine_unprivileged_state, project_symbol_catalog, promoted_symbol);
        let mut claim_size_at_least_one: u64 = claim_size;
        transition claim_size_at_least_one < 1 {
            true -> floor(engine_unprivileged_state, engine_bindings, module_name, module_name_len, offset, claim_size_at_least_one)
            _ -> add(engine_unprivileged_state, engine_bindings, module_name, module_name_len, offset, claim_size_at_least_one)
        }
    }
    state floor(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        module_name: [u8; 256],
        module_name_len: u64,
        offset: u64,
        claim_size_at_least_one: u64
     ) -> ModuleHintMatch
        requires module_name_len <= 256;
    {
        transition { _ -> add(engine_unprivileged_state, engine_bindings, module_name, module_name_len, offset, 1) }
    }
    state add(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        module_name: [u8; 256],
        module_name_len: u64,
        offset: u64,
        claim_size_at_least_one: u64
     ) -> ModuleHintMatch
        requires module_name_len <= 256;
    {
        let mut minimum_module_size: u64 = offset;
        transition claim_size_at_least_one <= 18446744073709551615 - offset {
            true -> summed(engine_unprivileged_state, engine_bindings, module_name, module_name_len, offset, claim_size_at_least_one)
            _ -> query(engine_unprivileged_state, engine_bindings, module_name, module_name_len, minimum_module_size)
        }
    }
    state summed(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        module_name: [u8; 256],
        module_name_len: u64,
        offset: u64,
        claim_size_at_least_one: u64
     ) -> ModuleHintMatch
        requires module_name_len <= 256;
    {
        let minimum_module_size: u64 = ((offset as u64 in Wrapping) + (claim_size_at_least_one as u64 in Wrapping)) as u64;
        transition { _ -> query(engine_unprivileged_state, engine_bindings, module_name, module_name_len, minimum_module_size) }
    }
    state query(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
        module_name: [u8; 256],
        module_name_len: u64,
        minimum_module_size: u64
     ) -> ModuleHintMatch
        requires module_name_len <= 256;
    {
        let queried: ModuleSizeMatch = ProjectItemSymbolPromotion::query_loaded_module_size(engine_bindings, &module_name[0..module_name_len]);
        // `queried.unwrap_or(minimum).max(minimum)` — the hint never shrinks.
        let mut size_hint: u64 = minimum_module_size;
        transition queried.found && queried.size_in_bytes > minimum_module_size {
            true -> picked(engine_unprivileged_state, module_name, module_name_len, queried.size_in_bytes)
            _ -> emit(engine_unprivileged_state, module_name, module_name_len, size_hint)
        }
    }
    state picked(engine_unprivileged_state: &mut EngineUnprivilegedState, module_name: [u8; 256], module_name_len: u64, size_hint: u64) -> ModuleHintMatch {
        (ModuleHintMatch { found: true, module_name: module_name, module_name_len: module_name_len, size_in_bytes: size_hint })
    }
    state emit(engine_unprivileged_state: &mut EngineUnprivilegedState, module_name: [u8; 256], module_name_len: u64, size_hint: u64) -> ModuleHintMatch {
        (ModuleHintMatch { found: true, module_name: module_name, module_name_len: module_name_len, size_in_bytes: size_hint })
    }
}

// ---- size estimates (upstream estimate_* — u64 results, never Option) ----

// Upstream `estimate_symbol_claim_size_in_bytes`.
pub machine ProjectItemSymbolPromotion::estimate_symbol_claim_size_in_bytes(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    project_symbol_catalog: &ProjectSymbolCatalog,
    symbol_claim: &ProjectSymbolClaim
 )
 -> u64 {
    let mut visited_type_ids: SymbolLayoutVisitSet = SymbolLayoutVisitSet::new();
    (ProjectItemSymbolPromotion::estimate_symbol_type_size_in_bytes(
        engine_unprivileged_state,
        project_symbol_catalog,
        ProjectSymbolClaim::get_struct_layout_id(symbol_claim),
        &mut visited_type_ids))
}

// Upstream `estimate_symbol_type_size_in_bytes`,
// `estimate_symbolic_struct_size_in_bytes`, and
// `estimate_symbolic_field_size_in_bytes` form a recursive triad
// (type -> struct -> field -> type) whose post-call continuations have
// no tail spelling under Omega's runtime call-cycle admission, so the
// descent ports as a bounded explicit frame worklist with the same
// visit/dedup and saturating/max arithmetic. Documented deviation:
// descent bounded to 64 frames; a full stack fails the estimate to 0.

pub data PromotionSizeFrame {
    kind: u8;
    awaiting: bool;
    field: SymbolicFieldDefinition;
    structure: SymbolicStructDefinition;
    container_type: ContainerType;
    field_offset: u64;
    cursor: u64;
    accumulator: u64;
    type_id: [u8; 256];
    type_id_len: u64;
    unvisit_id: [u8; 256];
    unvisit_len: u64;
}

pub data PromotionSizeStack {
    frames: [PromotionSizeFrame; 64];
    len: u64;
}

machine promotion_frame_push(
    stack: &mut PromotionSizeStack,
    frame: PromotionSizeFrame
) -> bool {
    transition stack.len < 64 {
        true -> store(stack, frame)
        _ -> (false)
    }
    state store(
        stack: &mut PromotionSizeStack,
        frame: PromotionSizeFrame
    ) -> bool
        requires stack.len < 64;
    {
        stack.frames[stack.len] = frame;
        stack.len = ((stack.len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

machine promotion_size_run(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    project_symbol_catalog: &ProjectSymbolCatalog,
    stack: &mut PromotionSizeStack,
    visited_type_ids: &mut SymbolLayoutVisitSet,
    result: u64
) -> u64 {
    transition stack.len == 0 {
        true -> (result)
        _ -> dispatch(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result)
    }
    state dispatch(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64
    ) -> u64
        requires 0 < stack.len && stack.len <= 64;
    {
        let top_index: u64 = stack.len - 1;
        transition top_index < 64 {
            true -> peeked(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
            _ -> (result)
        }
    }
    state peeked(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        transition frame.kind == 1 {
            true -> walk_step(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
            _ -> peeked_not_walk(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
        }
    }
    state peeked_not_walk(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        transition frame.kind == 0 {
            true -> field_step(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
            _ -> type_step(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
        }
    }
    state field_step(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        // An awaiting frame is never the dispatch top — its child sits
        // above it until deliver() consumes the child result.
        transition frame.awaiting {
            true -> (result)
            _ -> eval_field(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
        }
    }
    state eval_field(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        transition frame.container_type {
            ContainerType::Pointer { pointer_size } -> field_pointer_complete(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, PointerScanPointerSize::get_size_in_bytes(&pointer_size))
            _ -> field_visit(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index)
        }
    }
    state field_pointer_complete(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        top_index: u64,
        pointer_size_in_bytes: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let total_size: u64 = ContainerType::get_total_size_in_bytes(&frame.container_type, pointer_size_in_bytes);
        transition { _ -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, total_size) }
    }
    state field_visit(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let data_type_ref: DataTypeRef = SymbolicFieldDefinition::get_data_type_ref(&frame.field);
        let data_type_id: &[u8] = DataTypeRef::get_data_type_id(&data_type_ref);
        let mut type_id_copy: [u8; 256];
        let type_id_len: u64 = promotion_copy_256(&mut type_id_copy, data_type_id);
        transition type_id_len <= 256 {
            true -> field_visit_insert(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, type_id_copy, type_id_len)
            _ -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, 0)
        }
    }
    state field_visit_insert(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        top_index: u64,
        type_id_copy: [u8; 256],
        type_id_len: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len && type_id_len <= 256;
    {
        // upstream `visited_type_ids.insert(...)` — false = cycle -> 0.
        let inserted: bool = SymbolLayoutVisitSet::insert(visited_type_ids, &type_id_copy[0..type_id_len]);
        transition inserted {
            true -> field_await_type(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, type_id_copy, type_id_len)
            _ -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, 0)
        }
    }
    state field_await_type(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        top_index: u64,
        type_id_copy: [u8; 256],
        type_id_len: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len && type_id_len <= 256;
    {
        _ = promotion_copy_256(&mut stack.frames[top_index].unvisit_id, &type_id_copy[0..type_id_len]);
        stack.frames[top_index].unvisit_len = type_id_len;
        stack.frames[top_index].awaiting = true;
        let mut child: PromotionSizeFrame;
        child.kind = 2;
        child.awaiting = false;
        child.field = SymbolicFieldDefinition::new_unassigned(0);
        child.structure = SymbolicStructDefinition::new_empty("");
        child.container_type = ContainerType::default();
        child.field_offset = 0;
        child.cursor = 0;
        child.accumulator = 0;
        child.type_id = type_id_copy;
        child.type_id_len = type_id_len;
        child.unvisit_len = 0;
        let pushed: bool = promotion_frame_push(stack, child);
        transition pushed {
            true -> dispatch(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, 0)
            _ -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, 0)
        }
    }
    state type_step(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let type_id_len: u64 = frame.type_id_len;
        transition frame.awaiting {
            true -> (result)
            _ -> eval_type(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index, type_id_len)
        }
    }
    state eval_type(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64,
        type_id_len: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len && type_id_len <= 256;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let data_type_ref: DataTypeRef = DataTypeRef::new(&frame.type_id[0..type_id_len]);
        let unit_size: u64 = EngineUnprivilegedState::get_unit_size_in_bytes(engine_unprivileged_state, &data_type_ref);
        transition unit_size > 0 {
            true -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, unit_size)
            _ -> type_descriptor(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, type_id_len)
        }
    }
    state type_descriptor(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        top_index: u64,
        type_id_len: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len && type_id_len <= 256;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let position: u64 = ProjectSymbolCatalog::find_struct_layout_descriptor_position(project_symbol_catalog, &frame.type_id[0..type_id_len]);
        transition position < 128 && position < ProjectSymbolCatalog::get_struct_layout_descriptor_count(project_symbol_catalog) {
            true -> type_descriptor_walk(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, position)
            _ -> type_field_parse(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, type_id_len)
        }
    }
    state type_descriptor_walk(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        top_index: u64,
        position: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len && position < 128 && position < ProjectSymbolCatalog::get_struct_layout_descriptor_count(project_symbol_catalog);
    {
        let descriptor: &StructLayoutDescriptor = ProjectSymbolCatalog::get_struct_layout_descriptor(project_symbol_catalog, position);
        let inner_definition: &SymbolicStructDefinition = StructLayoutDescriptor::get_struct_layout_definition(descriptor);
        let mut child: PromotionSizeFrame;
        child.kind = 1;
        child.awaiting = false;
        child.field = SymbolicFieldDefinition::new_unassigned(0);
        child.structure = SymbolicStructDefinition::clone(inner_definition);
        child.container_type = ContainerType::default();
        child.field_offset = 0;
        child.cursor = 0;
        child.accumulator = 0;
        child.type_id_len = 0;
        child.unvisit_len = 0;
        stack.frames[top_index].awaiting = true;
        let pushed: bool = promotion_frame_push(stack, child);
        transition pushed {
            true -> dispatch(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, 0)
            _ -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, 0)
        }
    }
    state type_field_parse(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        top_index: u64,
        type_id_len: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len && type_id_len <= 256;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let parsed: SymbolicFieldDefinitionParse = SymbolicFieldDefinition::from_str(&frame.type_id[0..type_id_len]);
        transition parsed {
            SymbolicFieldDefinitionParse::Parsed { value } -> type_field_push(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, value)
            _ -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, 1)
        }
    }
    state type_field_push(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        top_index: u64,
        field_definition: SymbolicFieldDefinition
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let container_type: ContainerType = SymbolicFieldDefinition::get_container_type(&field_definition);
        let mut child: PromotionSizeFrame;
        child.kind = 0;
        child.awaiting = false;
        child.field = field_definition;
        child.structure = SymbolicStructDefinition::new_empty("");
        child.container_type = container_type;
        child.field_offset = 0;
        child.cursor = 0;
        child.accumulator = 0;
        child.type_id_len = 0;
        child.unvisit_len = 0;
        stack.frames[top_index].awaiting = true;
        let pushed: bool = promotion_frame_push(stack, child);
        transition pushed {
            true -> dispatch(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, 0)
            _ -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, 0)
        }
    }
    state walk_step(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let field_cursor: u64 = frame.cursor;
        let field_count: u64 = SymbolicStructDefinition::get_field_count(&frame.structure);
        transition field_cursor < field_count && field_cursor < 64 {
            true -> walk_indexed(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index, field_cursor)
            _ -> walk_finish(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
        }
    }
    state walk_indexed(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64,
        field_cursor: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len && field_cursor < 64;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let symbolic_field_definition: &SymbolicFieldDefinition = SymbolicStructDefinition::get_field(&frame.structure, field_cursor);
        let offset_resolution: SymbolicFieldOffsetResolution = SymbolicFieldDefinition::get_offset_resolution(symbolic_field_definition);
        transition offset_resolution {
            SymbolicFieldOffsetResolution::Static { offset_in_bytes } -> walk_push_field(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index, field_cursor, offset_in_bytes)
            _ -> walk_union_probe(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index, field_cursor)
        }
    }
    state walk_union_probe(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64,
        field_cursor: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let layout_kind: SymbolicLayoutKind = SymbolicStructDefinition::get_layout_kind(&frame.structure);
        let accumulator: u64 = frame.accumulator;
        transition SymbolicLayoutKind::is_union(&layout_kind) {
            true -> walk_push_field(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index, field_cursor, 0)
            _ -> walk_push_field(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index, field_cursor, accumulator)
        }
    }
    state walk_push_field(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64,
        field_cursor: u64,
        field_offset: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len && field_cursor < 64;
    {
        stack.frames[top_index].field_offset = field_offset;
        let inner_field: &SymbolicFieldDefinition = SymbolicStructDefinition::get_field(&stack.frames[top_index].structure, field_cursor);
        let field_copy: SymbolicFieldDefinition = SymbolicFieldDefinition::clone(inner_field);
        let container_type: ContainerType = SymbolicFieldDefinition::get_container_type(&field_copy);
        let mut child: PromotionSizeFrame;
        child.kind = 0;
        child.awaiting = false;
        child.field = field_copy;
        child.structure = SymbolicStructDefinition::new_empty("");
        child.container_type = container_type;
        child.field_offset = 0;
        child.cursor = 0;
        child.accumulator = 0;
        child.type_id_len = 0;
        child.unvisit_len = 0;
        let pushed: bool = promotion_frame_push(stack, child);
        transition pushed {
            true -> dispatch(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result)
            _ -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, 0)
        }
    }
    state walk_finish(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let accumulator: u64 = frame.accumulator;
        let declared: u64 = SymbolicStructDefinition::get_declared_size_in_bytes(&frame.structure);
        transition declared > accumulator {
            true -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, declared)
            _ -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, accumulator)
        }
    }
    state pop_deliver(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        top_index: u64,
        size_in_bytes: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        stack.len = stack.len - 1;
        transition { _ -> deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, size_in_bytes) }
    }
    state deliver(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64
    ) -> u64 {
        transition stack.len == 0 {
            true -> (result)
            _ -> deliver_top(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result)
        }
    }
    state deliver_top(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64
    ) -> u64
        requires 0 < stack.len && stack.len <= 64;
    {
        let top_index: u64 = stack.len - 1;
        transition top_index < 64 {
            true -> deliver_peek(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
            _ -> (0)
        }
    }
    state deliver_peek(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        transition frame.kind == 1 {
            true -> deliver_walk(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
            _ -> deliver_not_walk(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
        }
    }
    state deliver_not_walk(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        transition frame.kind == 0 {
            true -> deliver_field(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
            _ -> deliver_type(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
        }
    }
    state deliver_walk(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let field_end: u64 = ((frame.field_offset as u64 in Saturating) + (result as u64 in Saturating)) as u64;
        transition frame.accumulator < field_end {
            true -> deliver_walk_grow(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index, field_end)
            _ -> deliver_walk_advance(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index)
        }
    }
    state deliver_walk_grow(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64,
        field_end: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        stack.frames[top_index].accumulator = field_end;
        transition { _ -> deliver_walk_advance(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index) }
    }
    state deliver_walk_advance(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        stack.frames[top_index].cursor = ((stack.frames[top_index].cursor as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> dispatch(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result) }
    }
    state deliver_field(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let total_size: u64 = ContainerType::get_total_size_in_bytes(&frame.container_type, result);
        transition { _ -> deliver_field_unvisit(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index, total_size) }
    }
    state deliver_field_unvisit(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64,
        total_size: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        let unvisit_len: u64 = frame.unvisit_len;
        transition 0 < unvisit_len && unvisit_len <= 256 {
            true -> deliver_field_remove(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result, top_index, total_size, unvisit_len)
            _ -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, total_size)
        }
    }
    state deliver_field_remove(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64,
        total_size: u64,
        unvisit_len: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len && 0 < unvisit_len && unvisit_len <= 256;
    {
        let frame: &PromotionSizeFrame = &stack.frames[top_index];
        _ = SymbolLayoutVisitSet::remove(visited_type_ids, &frame.unvisit_id[0..unvisit_len]);
        transition { _ -> pop_deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, top_index, total_size) }
    }
    state deliver_type(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        stack: &mut PromotionSizeStack,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        result: u64,
        top_index: u64
    ) -> u64
        requires top_index < 64 && 0 < stack.len;
    {
        stack.len = stack.len - 1;
        transition { _ -> deliver(engine_unprivileged_state, project_symbol_catalog, stack, visited_type_ids, result) }
    }
}

// Upstream `estimate_symbol_type_size_in_bytes`. The
// `SymbolicStructDefinition::from_str` arm is dropped — the api has no
// struct-definition text parser (documented deviation); field parsing
// survives.
pub machine ProjectItemSymbolPromotion::estimate_symbol_type_size_in_bytes(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    project_symbol_catalog: &ProjectSymbolCatalog,
    symbol_type_id: &[u8],
    visited_type_ids: &mut SymbolLayoutVisitSet
 )
 -> u64 {
    let mut type_id_copy: [u8; 256];
    let type_id_len: u64 = promotion_copy_256(&mut type_id_copy, symbol_type_id);
    transition type_id_len <= 256 {
        true -> seed(engine_unprivileged_state, project_symbol_catalog, visited_type_ids, type_id_copy, type_id_len)
        _ -> (1)
    }
    state seed(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        visited_type_ids: &mut SymbolLayoutVisitSet,
        type_id_copy: [u8; 256],
        type_id_len: u64
    ) -> u64
        requires type_id_len <= 256;
    {
        let mut stack: PromotionSizeStack;
        stack.len = 0;
        let mut root: PromotionSizeFrame;
        root.kind = 2;
        root.awaiting = false;
        root.field = SymbolicFieldDefinition::new_unassigned(0);
        root.structure = SymbolicStructDefinition::new_empty("");
        root.container_type = ContainerType::default();
        root.field_offset = 0;
        root.cursor = 0;
        root.accumulator = 0;
        root.type_id = type_id_copy;
        root.type_id_len = type_id_len;
        root.unvisit_len = 0;
        _ = promotion_frame_push(&mut stack, root);
        (promotion_size_run(engine_unprivileged_state, project_symbol_catalog, &mut stack, visited_type_ids, 0))
    }
}

// Upstream `estimate_symbolic_struct_size_in_bytes`.
pub machine ProjectItemSymbolPromotion::estimate_symbolic_struct_size_in_bytes(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    project_symbol_catalog: &ProjectSymbolCatalog,
    symbolic_struct_definition: &SymbolicStructDefinition,
    visited_type_ids: &mut SymbolLayoutVisitSet
 )
 -> u64 {
    let mut stack: PromotionSizeStack;
    stack.len = 0;
    let mut root: PromotionSizeFrame;
    root.kind = 1;
    root.awaiting = false;
    root.field = SymbolicFieldDefinition::new_unassigned(0);
    root.structure = SymbolicStructDefinition::clone(symbolic_struct_definition);
    root.container_type = ContainerType::default();
    root.field_offset = 0;
    root.cursor = 0;
    root.accumulator = 0;
    root.type_id_len = 0;
    root.unvisit_len = 0;
    _ = promotion_frame_push(&mut stack, root);
    (promotion_size_run(engine_unprivileged_state, project_symbol_catalog, &mut stack, visited_type_ids, 0))
}

// Upstream `estimate_symbolic_field_size_in_bytes`: pointer containers take
// the pointer size; every other container resolves the element type then
// multiplies by `get_total_size_in_bytes`.
pub machine ProjectItemSymbolPromotion::estimate_symbolic_field_size_in_bytes(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    project_symbol_catalog: &ProjectSymbolCatalog,
    symbolic_field_definition: &SymbolicFieldDefinition,
    visited_type_ids: &mut SymbolLayoutVisitSet
 )
 -> u64 {
    let mut stack: PromotionSizeStack;
    stack.len = 0;
    let mut root: PromotionSizeFrame;
    root.kind = 0;
    root.awaiting = false;
    root.field = SymbolicFieldDefinition::clone(symbolic_field_definition);
    root.structure = SymbolicStructDefinition::new_empty("");
    root.container_type = SymbolicFieldDefinition::get_container_type(symbolic_field_definition);
    root.field_offset = 0;
    root.cursor = 0;
    root.accumulator = 0;
    root.type_id_len = 0;
    root.unvisit_len = 0;
    _ = promotion_frame_push(&mut stack, root);
    (promotion_size_run(engine_unprivileged_state, project_symbol_catalog, &mut stack, visited_type_ids, 0))
}

// ---- module-root layout upsert chain ----

// Upstream `upsert_promoted_module_symbol_layout_field`: ModuleOffset claims
// mirror into the module's root layout at the claim offset; other locators
// succeed vacuously.
pub machine ProjectItemSymbolPromotion::upsert_promoted_module_symbol_layout_field(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    project_symbol_catalog: &mut ProjectSymbolCatalog,
    promoted_symbol: &ProjectSymbolClaim
 )
 -> bool {
    let inner2: &ProjectSymbolLocator = ProjectSymbolClaim::get_locator(promoted_symbol);
    let locator: ProjectSymbolLocator = ProjectSymbolLocator::clone(inner2);
    let mut visited_layout_ids: SymbolLayoutVisitSet = SymbolLayoutVisitSet::new();
    transition locator {
        ProjectSymbolLocator::ModuleOffset { module_name, module_name_len, offset } -> bounded(engine_unprivileged_state, project_symbol_catalog, promoted_symbol, module_name, module_name_len, offset, &mut visited_layout_ids)
        _ -> (true)
    }
    state bounded(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        promoted_symbol: &ProjectSymbolClaim,
        module_name: [u8; 256],
        module_name_len: u64,
        offset: u64,
        visited_layout_ids: &mut SymbolLayoutVisitSet
     )
     -> bool {
        transition module_name_len <= 256 {
            true -> sized(engine_unprivileged_state, project_symbol_catalog, promoted_symbol, module_name, module_name_len, offset, visited_layout_ids)
            _ -> (true)
        }
    }
    state sized(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        promoted_symbol: &ProjectSymbolClaim,
        module_name: [u8; 256],
        module_name_len: u64,
        offset: u64,
        visited_layout_ids: &mut SymbolLayoutVisitSet
     )
     -> bool
        requires module_name_len <= 256;
    {
        let mut claim_size: u64 = ProjectItemSymbolPromotion::estimate_symbol_claim_size_in_bytes(engine_unprivileged_state, project_symbol_catalog, promoted_symbol);
        transition claim_size < 1 {
            true -> floored(engine_unprivileged_state, project_symbol_catalog, promoted_symbol, module_name, module_name_len, offset, visited_layout_ids)
            _ -> at_offset(engine_unprivileged_state, project_symbol_catalog, promoted_symbol, module_name, module_name_len, offset, claim_size, visited_layout_ids)
        }
    }
    state floored(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        promoted_symbol: &ProjectSymbolClaim,
        module_name: [u8; 256],
        module_name_len: u64,
        offset: u64,
        visited_layout_ids: &mut SymbolLayoutVisitSet
     )
     -> bool
        requires module_name_len <= 256;
    {
        transition { _ -> at_offset(engine_unprivileged_state, project_symbol_catalog, promoted_symbol, module_name, module_name_len, offset, 1, visited_layout_ids) }
    }
    state at_offset(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        promoted_symbol: &ProjectSymbolClaim,
        module_name: [u8; 256],
        module_name_len: u64,
        offset: u64,
        claim_size: u64,
        visited_layout_ids: &mut SymbolLayoutVisitSet
     )
     -> bool
        requires module_name_len <= 256;
    {
        (ProjectItemSymbolPromotion::upsert_symbol_layout_field_at_offset(
            engine_unprivileged_state,
            project_symbol_catalog,
            &module_name[0..module_name_len],
            offset,
            ProjectSymbolClaim::get_display_name(promoted_symbol),
            ProjectSymbolClaim::get_struct_layout_id(promoted_symbol),
            claim_size,
            visited_layout_ids))
    }
}

// Upstream `upsert_symbol_layout_field_at_offset`: insert into the visited
// set, find the layout, descend into a containing child when the field sits
// wholly inside one, else upsert the field and replace the descriptor. The
// port runs the descent as a state loop — runtime recursion is tail-only —
// with each ancestor layout id pushed onto a bounded stack and removed from
// the visited set on unwind (upstream drops the frame locals the same way).
pub machine ProjectItemSymbolPromotion::upsert_symbol_layout_field_at_offset(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    project_symbol_catalog: &mut ProjectSymbolCatalog,
    struct_layout_id: &[u8],
    offset_in_bytes: u64,
    field_name: &[u8],
    field_type_id: &[u8],
    field_size_in_bytes: u64,
    visited_layout_ids: &mut SymbolLayoutVisitSet
 )
 -> bool {
    let mut descend_stack: ProjectStringList = ProjectStringList::empty();
    let mut current_layout_id: [u8; 256];
    let current_layout_id_len: u64 = promotion_copy_256(&mut current_layout_id, struct_layout_id);
    transition current_layout_id_len <= 256 {
        true -> visit(engine_unprivileged_state, project_symbol_catalog, offset_in_bytes, field_name, field_type_id, field_size_in_bytes, visited_layout_ids, &mut descend_stack, current_layout_id, current_layout_id_len)
        _ -> (false)
    }
    state visit(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        offset_in_bytes: u64,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        visited_layout_ids: &mut SymbolLayoutVisitSet,
        descend_stack: &mut ProjectStringList,
        current_layout_id: [u8; 256],
        current_layout_id_len: u64
     )
     -> bool
        requires current_layout_id_len <= 256;
    {
        transition SymbolLayoutVisitSet::insert(visited_layout_ids, &current_layout_id[0..current_layout_id_len]) {
            true -> find(engine_unprivileged_state, project_symbol_catalog, offset_in_bytes, field_name, field_type_id, field_size_in_bytes, visited_layout_ids, descend_stack, current_layout_id, current_layout_id_len)
            _ -> unwind(visited_layout_ids, descend_stack, false)
        }
    }
    state find(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        offset_in_bytes: u64,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        visited_layout_ids: &mut SymbolLayoutVisitSet,
        descend_stack: &mut ProjectStringList,
        current_layout_id: [u8; 256],
        current_layout_id_len: u64
     )
     -> bool
        requires current_layout_id_len <= 256;
    {
        let position: u64 = ProjectSymbolCatalog::find_struct_layout_descriptor_position(project_symbol_catalog, &current_layout_id[0..current_layout_id_len]);
        transition position < ProjectSymbolCatalog::get_struct_layout_descriptor_count(project_symbol_catalog) && position < 128 {
            true -> descriptor(engine_unprivileged_state, project_symbol_catalog, offset_in_bytes, field_name, field_type_id, field_size_in_bytes, visited_layout_ids, descend_stack, current_layout_id, current_layout_id_len, position)
            _ -> miss(visited_layout_ids, descend_stack, current_layout_id, current_layout_id_len)
        }
    }
    state miss(
        visited_layout_ids: &mut SymbolLayoutVisitSet,
        descend_stack: &mut ProjectStringList,
        current_layout_id: [u8; 256],
        current_layout_id_len: u64
     )
     -> bool
        requires current_layout_id_len <= 256;
    {
        _ = SymbolLayoutVisitSet::remove(visited_layout_ids, &current_layout_id[0..current_layout_id_len]);
        transition { _ -> unwind(visited_layout_ids, descend_stack, false) }
    }
    state descriptor(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        offset_in_bytes: u64,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        visited_layout_ids: &mut SymbolLayoutVisitSet,
        descend_stack: &mut ProjectStringList,
        current_layout_id: [u8; 256],
        current_layout_id_len: u64,
        position: u64
     )
     -> bool
        requires current_layout_id_len <= 256 && position < 128;
    {
        let definition: SymbolicStructDefinition = SymbolicStructDefinition::clone(
            StructLayoutDescriptor::get_struct_layout_definition(
                ProjectSymbolCatalog::get_struct_layout_descriptor(project_symbol_catalog, position)));
        transition { _ -> child(engine_unprivileged_state, project_symbol_catalog, offset_in_bytes, field_name, field_type_id, field_size_in_bytes, visited_layout_ids, descend_stack, current_layout_id, current_layout_id_len, definition) }
    }
    state child(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        offset_in_bytes: u64,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        visited_layout_ids: &mut SymbolLayoutVisitSet,
        descend_stack: &mut ProjectStringList,
        current_layout_id: [u8; 256],
        current_layout_id_len: u64,
        struct_layout_definition: SymbolicStructDefinition
     )
     -> bool
        requires current_layout_id_len <= 256;
    {
        let containing: ContainingChildMatch = ProjectItemSymbolPromotion::find_containing_child_struct_layout(
            engine_unprivileged_state,
            project_symbol_catalog,
            &struct_layout_definition,
            offset_in_bytes,
            field_size_in_bytes,
            visited_layout_ids);
        transition containing.found {
            true -> descend(engine_unprivileged_state, project_symbol_catalog, field_name, field_type_id, field_size_in_bytes, visited_layout_ids, descend_stack, current_layout_id, current_layout_id_len, containing)
            _ -> upsert(engine_unprivileged_state, project_symbol_catalog, offset_in_bytes, field_name, field_type_id, field_size_in_bytes, visited_layout_ids, descend_stack, current_layout_id, current_layout_id_len, struct_layout_definition)
        }
    }
    state descend(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        visited_layout_ids: &mut SymbolLayoutVisitSet,
        descend_stack: &mut ProjectStringList,
        current_layout_id: [u8; 256],
        current_layout_id_len: u64,
        containing: ContainingChildMatch
     )
     -> bool
        requires current_layout_id_len <= 256;
    {
        transition containing.struct_layout_id_len <= 256 {
            true -> push(engine_unprivileged_state, project_symbol_catalog, field_name, field_type_id, field_size_in_bytes, visited_layout_ids, descend_stack, current_layout_id, current_layout_id_len, containing)
            _ -> miss(visited_layout_ids, descend_stack, current_layout_id, current_layout_id_len)
        }
    }
    state push(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        visited_layout_ids: &mut SymbolLayoutVisitSet,
        descend_stack: &mut ProjectStringList,
        current_layout_id: [u8; 256],
        current_layout_id_len: u64,
        containing: ContainingChildMatch
     )
     -> bool
        requires current_layout_id_len <= 256 && containing.struct_layout_id_len <= 256;
    {
        _ = ProjectStringList::add_string(descend_stack, &current_layout_id[0..current_layout_id_len]);
        transition { _ -> visit(engine_unprivileged_state, project_symbol_catalog, containing.offset_in_child, field_name, field_type_id, field_size_in_bytes, visited_layout_ids, descend_stack, containing.struct_layout_id, containing.struct_layout_id_len) }
    }
    state upsert(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        offset_in_bytes: u64,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        visited_layout_ids: &mut SymbolLayoutVisitSet,
        descend_stack: &mut ProjectStringList,
        current_layout_id: [u8; 256],
        current_layout_id_len: u64,
        struct_layout_definition: SymbolicStructDefinition
     )
     -> bool
        requires current_layout_id_len <= 256;
    {
        let upserted: FieldUpsertResult = ProjectItemSymbolPromotion::upsert_field_in_symbolic_struct_definition(
            engine_unprivileged_state,
            project_symbol_catalog,
            &struct_layout_definition,
            offset_in_bytes,
            field_name,
            field_type_id,
            field_size_in_bytes);
        transition upserted.found {
            true -> replace(project_symbol_catalog, visited_layout_ids, descend_stack, current_layout_id, current_layout_id_len, upserted.struct_layout_definition)
            _ -> miss(visited_layout_ids, descend_stack, current_layout_id, current_layout_id_len)
        }
    }
    state replace(
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        visited_layout_ids: &mut SymbolLayoutVisitSet,
        descend_stack: &mut ProjectStringList,
        current_layout_id: [u8; 256],
        current_layout_id_len: u64,
        struct_layout_definition: SymbolicStructDefinition
     )
     -> bool
        requires current_layout_id_len <= 256;
    {
        let replaced: bool = ProjectItemSymbolPromotion::replace_struct_layout_definition(project_symbol_catalog, &current_layout_id[0..current_layout_id_len], &struct_layout_definition);
        _ = SymbolLayoutVisitSet::remove(visited_layout_ids, &current_layout_id[0..current_layout_id_len]);
        transition { _ -> unwind(visited_layout_ids, descend_stack, replaced) }
    }
    state unwind(
        visited_layout_ids: &mut SymbolLayoutVisitSet,
        descend_stack: &mut ProjectStringList,
        result: bool
     )
     -> bool {
        transition ProjectStringList::get_string_count(descend_stack) > 0 {
            true -> unwind_pop(visited_layout_ids, descend_stack, result)
            _ -> (result)
        }
    }
    state unwind_pop(
        visited_layout_ids: &mut SymbolLayoutVisitSet,
        descend_stack: &mut ProjectStringList,
        result: bool
     )
     -> bool {
        let inner3: u64 = ProjectStringList::get_string_count(descend_stack);
        let last_position: u64 = ((inner3 as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        let last_id: &[u8] = ProjectStringList::get_string(descend_stack, last_position);
        _ = SymbolLayoutVisitSet::remove(visited_layout_ids, last_id);
        descend_stack.string_count = last_position;
        transition { _ -> unwind(visited_layout_ids, descend_stack, result) }
    }
}

// Upstream `find_containing_child_struct_layout`: every field span that
// wholly contains the request is a candidate; the smallest span wins,
// ties break on the layout id bytes (upstream sorts then takes first —
// the bounded port keeps the running best instead).
pub machine ProjectItemSymbolPromotion::find_containing_child_struct_layout(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    project_symbol_catalog: &ProjectSymbolCatalog,
    struct_layout_definition: &SymbolicStructDefinition,
    offset_in_bytes: u64,
    field_size_in_bytes: u64,
    visited_layout_ids: &SymbolLayoutVisitSet
 ) -> ContainingChildMatch {
    let mut empty_struct_layout_id: [u8; 256];
    ProjectItemSymbolPromotion::zero_256(&mut empty_struct_layout_id);
    transition field_size_in_bytes <= 18446744073709551615 - offset_in_bytes {
        true -> collect(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids)
        _ -> (ContainingChildMatch { found: false, struct_layout_id_len: 0, offset_in_child: 0, struct_layout_id: empty_struct_layout_id })
    }
    state collect(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_size_in_bytes: u64,
        visited_layout_ids: &SymbolLayoutVisitSet
     ) -> ContainingChildMatch
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes;
    {
        let mut field_spans: SymbolicFieldSpanList;
        SymbolicFieldSpanList::new(&mut field_spans);
        ProjectItemSymbolPromotion::collect_symbolic_field_spans(
            engine_unprivileged_state,
            project_symbol_catalog,
            struct_layout_definition,
            &mut field_spans);
        let mut empty_struct_layout_id: [u8; 256];
        ProjectItemSymbolPromotion::zero_256(&mut empty_struct_layout_id);
        let empty_best: ContainingChildMatch = ContainingChildMatch { found: false, struct_layout_id_len: 0, offset_in_child: 0, struct_layout_id: empty_struct_layout_id };
        transition empty_best.struct_layout_id_len <= 256 {
            true -> each(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, 0, empty_best, 0)
            _ -> (empty_best)
        }
    }
    // `best`/`best_span_size` carry by value — the running smallest
    // containing candidate, 18446744073709551615 until the first hit.
    state each(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_size_in_bytes: u64,
        visited_layout_ids: &SymbolLayoutVisitSet,
        field_spans: &SymbolicFieldSpanList,
        position: u64,
        best: ContainingChildMatch,
        best_span_size: u64
     ) -> ContainingChildMatch
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && best.struct_layout_id_len <= 256;
    {
        transition position < field_spans.count && position < 64 {
            true -> contains(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, position, best, best_span_size)
            _ -> (best)
        }
    }
    state contains(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_size_in_bytes: u64,
        visited_layout_ids: &SymbolLayoutVisitSet,
        field_spans: &SymbolicFieldSpanList,
        position: u64,
        best: ContainingChildMatch,
        best_span_size: u64
     ) -> ContainingChildMatch
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64 && best.struct_layout_id_len <= 256;
    {
        let requested_end: u64 = ((offset_in_bytes as u64 in Wrapping) + (field_size_in_bytes as u64 in Wrapping)) as u64;
        let span_offset: u64 = field_spans.spans[position].offset_in_bytes;
        let span_size: u64 = field_spans.spans[position].size_in_bytes;
        // `offset < span.offset || end > span.end` skips; the span's own
        // checked_add overflow skips too.
        transition span_size <= 18446744073709551615 - span_offset && offset_in_bytes >= span_offset && requested_end <= ((span_offset as u64 in Wrapping) + (span_size as u64 in Wrapping)) as u64 {
            true -> field(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, position, span_offset, span_size, best, best_span_size)
            _ -> each(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, best, best_span_size)
        }
    }
    state field(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_size_in_bytes: u64,
        visited_layout_ids: &SymbolLayoutVisitSet,
        field_spans: &SymbolicFieldSpanList,
        position: u64,
        span_offset: u64,
        span_size: u64,
        best: ContainingChildMatch,
        best_span_size: u64
     ) -> ContainingChildMatch
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64 && best.struct_layout_id_len <= 256 && span_offset <= offset_in_bytes;
    {
        let field_index: u64 = field_spans.spans[position].field_index;
        let field_definition: &SymbolicFieldDefinition = SymbolicStructDefinition::get_field(struct_layout_definition, field_index);
        let child_ref: DataTypeRef = SymbolicFieldDefinition::get_data_type_ref(field_definition);
        let container_type: ContainerType = SymbolicFieldDefinition::get_container_type(field_definition);
        transition { _ -> gate(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, position, span_offset, span_size, container_type, child_ref, best, best_span_size) }
    }
    state gate(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_size_in_bytes: u64,
        visited_layout_ids: &SymbolLayoutVisitSet,
        field_spans: &SymbolicFieldSpanList,
        position: u64,
        span_offset: u64,
        span_size: u64,
        container_type: ContainerType,
        child_ref: DataTypeRef,
        best: ContainingChildMatch,
        best_span_size: u64
     ) -> ContainingChildMatch
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64 && best.struct_layout_id_len <= 256 && span_offset <= offset_in_bytes;
    {
        // Upstream `visited.contains(child) || find_descriptor(child).is_none()`
        // skips the span.
        let child_layout_id: &[u8] = DataTypeRef::get_data_type_id(&child_ref);
        let descriptor_position: u64 = ProjectSymbolCatalog::find_struct_layout_descriptor_position(project_symbol_catalog, child_layout_id);
        let skip: bool = SymbolLayoutVisitSet::contains(visited_layout_ids, child_layout_id)
            || descriptor_position >= ProjectSymbolCatalog::get_struct_layout_descriptor_count(project_symbol_catalog);
        transition skip {
            false -> container(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, position, span_offset, span_size, container_type, child_ref, best, best_span_size)
            _ -> each(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, best, best_span_size)
        }
    }
    state container(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_size_in_bytes: u64,
        visited_layout_ids: &SymbolLayoutVisitSet,
        field_spans: &SymbolicFieldSpanList,
        position: u64,
        span_offset: u64,
        span_size: u64,
        container_type: ContainerType,
        child_ref: DataTypeRef,
        best: ContainingChildMatch,
        best_span_size: u64
     ) -> ContainingChildMatch
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64 && best.struct_layout_id_len <= 256 && span_offset <= offset_in_bytes;
    {
        transition container_type {
            ContainerType::None -> direct(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, position, span_offset, span_size, child_ref, best, best_span_size)
            ContainerType::Array -> modulo(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, position, span_offset, span_size, child_ref, best, best_span_size)
            ContainerType::ArrayFixed { length } -> modulo(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, position, span_offset, span_size, child_ref, best, best_span_size)
            _ -> each(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, best, best_span_size)
        }
    }
    // `None` fields: offset_in_child = offset - span.offset.
    state direct(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_size_in_bytes: u64,
        visited_layout_ids: &SymbolLayoutVisitSet,
        field_spans: &SymbolicFieldSpanList,
        position: u64,
        span_offset: u64,
        span_size: u64,
        child_ref: DataTypeRef,
        best: ContainingChildMatch,
        best_span_size: u64
     ) -> ContainingChildMatch
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64 && span_offset <= offset_in_bytes && best.struct_layout_id_len <= 256;
    {
        let offset_in_child: u64 = offset_in_bytes - span_offset;
        transition { _ -> choose(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, position, span_size, child_ref, offset_in_child, best, best_span_size) }
    }
    // Array arms: offset_in_child = (offset - span.offset) % child_size;
    // child_size == 0 skips.
    state modulo(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_size_in_bytes: u64,
        visited_layout_ids: &SymbolLayoutVisitSet,
        field_spans: &SymbolicFieldSpanList,
        position: u64,
        span_offset: u64,
        span_size: u64,
        child_ref: DataTypeRef,
        best: ContainingChildMatch,
        best_span_size: u64
     ) -> ContainingChildMatch
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64 && best.struct_layout_id_len <= 256 && span_offset <= offset_in_bytes;
    {
        let mut child_visits: SymbolLayoutVisitSet = SymbolLayoutVisitSet::new();
        let inner4: &[u8] = DataTypeRef::get_data_type_id(&child_ref);
        let child_size: u64 = ProjectItemSymbolPromotion::estimate_symbol_type_size_in_bytes(engine_unprivileged_state, project_symbol_catalog, inner4, &mut child_visits);
        transition child_size > 0 {
            true -> modded(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, position, span_offset, span_size, child_ref, child_size, best, best_span_size)
            _ -> each(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, best, best_span_size)
        }
    }
    state modded(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_size_in_bytes: u64,
        visited_layout_ids: &SymbolLayoutVisitSet,
        field_spans: &SymbolicFieldSpanList,
        position: u64,
        span_offset: u64,
        span_size: u64,
        child_ref: DataTypeRef,
        child_size: u64,
        best: ContainingChildMatch,
        best_span_size: u64
     ) -> ContainingChildMatch
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64 && span_offset <= offset_in_bytes && child_size > 0 && best.struct_layout_id_len <= 256;
    {
        let offset_in_child: u64 = (offset_in_bytes - span_offset) % child_size;
        transition { _ -> choose(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, position, span_size, child_ref, offset_in_child, best, best_span_size) }
    }
    // Keep the candidate when it is the first, smaller, or equal-size with
    // a lexically smaller layout id (upstream sort key (size, id)).
    state choose(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_size_in_bytes: u64,
        visited_layout_ids: &SymbolLayoutVisitSet,
        field_spans: &SymbolicFieldSpanList,
        position: u64,
        span_size: u64,
        child_ref: DataTypeRef,
        offset_in_child: u64,
        best: ContainingChildMatch,
        best_span_size: u64
     ) -> ContainingChildMatch
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64 && best.struct_layout_id_len <= 256;
    {
        let id_smaller: bool = promotion_bytes_less(DataTypeRef::get_data_type_id(&child_ref), &best.struct_layout_id[0..best.struct_layout_id_len]);
        transition !best.found || span_size < best_span_size || (span_size == best_span_size && id_smaller) {
            true -> keep(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, position, span_size, child_ref, offset_in_child, best, best_span_size)
            _ -> each(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, best, best_span_size)
        }
    }
    state keep(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_size_in_bytes: u64,
        visited_layout_ids: &SymbolLayoutVisitSet,
        field_spans: &SymbolicFieldSpanList,
        position: u64,
        span_size: u64,
        child_ref: DataTypeRef,
        offset_in_child: u64,
        best: ContainingChildMatch,
        best_span_size: u64
     ) -> ContainingChildMatch
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64 && best.struct_layout_id_len <= 256;
    {
        let mut empty_struct_layout_id: [u8; 256];
        ProjectItemSymbolPromotion::zero_256(&mut empty_struct_layout_id);
        let mut kept: ContainingChildMatch = ContainingChildMatch { found: true, offset_in_child: offset_in_child, struct_layout_id_len: 0, struct_layout_id: empty_struct_layout_id };
        kept.struct_layout_id_len = promotion_copy_256(&mut kept.struct_layout_id, DataTypeRef::get_data_type_id(&child_ref));
        transition kept.struct_layout_id_len <= 256 {
            true -> each(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_size_in_bytes, visited_layout_ids, field_spans, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, kept, best_span_size)
            _ -> (kept)
        }
    }
}

// Byte-string less-than for the (size, id) sort key — shorter-or-smaller
// lexicographic order.
machine promotion_bytes_less(left: &[u8], right: &[u8]) -> bool {
    transition { _ -> scan(left, right, 0) }
    state scan(left: &[u8], right: &[u8], position: u64) -> bool {
        transition position < left.len && position < right.len {
            true -> differ(left, right, position)
            _ -> (left.len < right.len)
        }
    }
    state differ(left: &[u8], right: &[u8], position: u64) -> bool
        requires position < left.len && position < right.len;
    {
        transition left[position] != right[position] {
            true -> (left[position] < right[position])
            _ -> scan(left, right, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// Copy a slice into a fixed 256 carrier (clamped); returns stored length.
machine promotion_copy_256(out: &mut [u8; 256], source: &[u8]) -> u64 {
    transition source.len <= 256 {
        true -> copy(out, source, source.len, 0)
        _ -> copy(out, source, 256, 0)
    }
    state copy(out: &mut [u8; 256], source: &[u8], stored_len: u64, position: u64) -> u64 {
        transition position < stored_len && position < 256 {
            true -> byte(out, source, stored_len, position)
            _ -> (stored_len)
        }
    }
    state byte(out: &mut [u8; 256], source: &[u8], stored_len: u64, position: u64) -> u64
        requires position < stored_len && position < 256 && position < source.len;
    {
        out[position] = source[position];
        transition { _ -> copy(out, source, stored_len, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Upstream `collect_symbolic_field_spans`.
pub machine ProjectItemSymbolPromotion::collect_symbolic_field_spans(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    project_symbol_catalog: &ProjectSymbolCatalog,
    struct_layout_definition: &SymbolicStructDefinition,
    symbolic_field_span_list: &mut SymbolicFieldSpanList
) {
    let is_union: bool = SymbolicLayoutKind::is_union(&SymbolicStructDefinition::get_layout_kind(struct_layout_definition));
    transition { _ -> each(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, 0, 0) }
    state each(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        symbolic_field_span_list: &mut SymbolicFieldSpanList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64
    ) {
        transition position < SymbolicStructDefinition::get_field_count(struct_layout_definition) {
            true -> field(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, position, next_sequential_offset)
            _ -> done()
        }
    }
    state field(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        symbolic_field_span_list: &mut SymbolicFieldSpanList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64
    ) {
        let field_definition: &SymbolicFieldDefinition = SymbolicStructDefinition::get_field(struct_layout_definition, position);
        transition SymbolicFieldDefinition::is_unassigned(field_definition) {
            true -> unassigned(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, position, next_sequential_offset, field_definition)
            _ -> assigned(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, position, next_sequential_offset, field_definition)
        }
    }
    // `next += unassigned.unwrap_or(0)` — saturating upstream.
    state unassigned(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        symbolic_field_span_list: &mut SymbolicFieldSpanList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64,
        field_definition: &SymbolicFieldDefinition
    ) {
        let unassigned_size: SymbolicUnassignedSize = SymbolicFieldDefinition::get_unassigned_size_in_bytes(field_definition);
        transition unassigned_size.found {
            true -> unassigned_stored(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, position, next_sequential_offset, unassigned_size.size_in_bytes)
            _ -> unassigned_stored(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, position, next_sequential_offset, 0)
        }
    }
    state unassigned_stored(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        symbolic_field_span_list: &mut SymbolicFieldSpanList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64,
        gap: u64
    ) {
        transition gap <= 18446744073709551615 - next_sequential_offset {
            true -> each(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, ((next_sequential_offset as u64 in Wrapping) + (gap as u64 in Wrapping)) as u64)
            _ -> each(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, 18446744073709551615)
        }
    }
    state assigned(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        symbolic_field_span_list: &mut SymbolicFieldSpanList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64,
        field_definition: &SymbolicFieldDefinition
    ) {
        let offset_resolution: SymbolicFieldOffsetResolution = SymbolicFieldDefinition::get_offset_resolution(field_definition);
        transition offset_resolution {
            SymbolicFieldOffsetResolution::Static { offset_in_bytes } -> sized(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, position, next_sequential_offset, field_definition, offset_in_bytes)
            _ -> sequential(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, position, next_sequential_offset, field_definition)
        }
    }
    state sequential(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        symbolic_field_span_list: &mut SymbolicFieldSpanList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64,
        field_definition: &SymbolicFieldDefinition
    ) {
        transition is_union {
            true -> sized(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, position, next_sequential_offset, field_definition, 0)
            _ -> sized(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, position, next_sequential_offset, field_definition, next_sequential_offset)
        }
    }
    state sized(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        symbolic_field_span_list: &mut SymbolicFieldSpanList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64,
        field_definition: &SymbolicFieldDefinition,
        field_offset: u64
    ) {
        let mut field_visits: SymbolLayoutVisitSet = SymbolLayoutVisitSet::new();
        let field_size: u64 = ProjectItemSymbolPromotion::estimate_symbolic_field_size_in_bytes(
            engine_unprivileged_state,
            project_symbol_catalog,
            field_definition,
            &mut field_visits);
        SymbolicFieldSpanList::push(symbolic_field_span_list, position, field_offset, field_size);
        // `next.max(offset.saturating_add(size))`.
        transition field_size <= 18446744073709551615 - field_offset && ((field_offset as u64 in Wrapping) + (field_size as u64 in Wrapping)) as u64 > next_sequential_offset {
            true -> each(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, ((field_offset as u64 in Wrapping) + (field_size as u64 in Wrapping)) as u64)
            _ -> each(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, symbolic_field_span_list, is_union, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, next_sequential_offset)
        }
    }
    state done() { }
}

// Upstream `upsert_field_in_symbolic_struct_definition`: overlap against a
// differently-placed span fails; same-offset spans are replaced; the field
// list materializes back into the rebuilt definition.
pub machine ProjectItemSymbolPromotion::upsert_field_in_symbolic_struct_definition(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    project_symbol_catalog: &ProjectSymbolCatalog,
    struct_layout_definition: &SymbolicStructDefinition,
    offset_in_bytes: u64,
    field_name: &[u8],
    field_type_id: &[u8],
    field_size_in_bytes: u64
 ) -> FieldUpsertResult {
    transition field_size_in_bytes <= 18446744073709551615 - offset_in_bytes {
        true -> collect(engine_unprivileged_state, project_symbol_catalog, struct_layout_definition, offset_in_bytes, field_name, field_type_id, field_size_in_bytes)
        _ -> (FieldUpsertResult { found: false, struct_layout_definition: SymbolicStructDefinition::empty() })
    }
    state collect(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64
     ) -> FieldUpsertResult
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes;
    {
        let mut field_spans: SymbolicFieldSpanList;
        SymbolicFieldSpanList::new(&mut field_spans);
        ProjectItemSymbolPromotion::collect_symbolic_field_spans(
            engine_unprivileged_state,
            project_symbol_catalog,
            struct_layout_definition,
            &mut field_spans);
        let mut positioned_fields: SymbolLayoutPositionedFieldList = SymbolLayoutPositionedFieldList::new();
        transition { _ -> each(engine_unprivileged_state, struct_layout_definition, offset_in_bytes, field_name, field_type_id, field_size_in_bytes, &field_spans, &mut positioned_fields, 0) }
    }
    state each(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        field_spans: &SymbolicFieldSpanList,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        position: u64
     ) -> FieldUpsertResult
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes;
    {
        transition position < field_spans.count && position < 64 {
            true -> overlap(engine_unprivileged_state, struct_layout_definition, offset_in_bytes, field_name, field_type_id, field_size_in_bytes, field_spans, positioned_fields, position)
            _ -> promote(engine_unprivileged_state, struct_layout_definition, offset_in_bytes, field_name, field_type_id, field_size_in_bytes, positioned_fields)
        }
    }
    state overlap(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        field_spans: &SymbolicFieldSpanList,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        position: u64
     ) -> FieldUpsertResult
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64;
    {
        let field_end: u64 = ((offset_in_bytes as u64 in Wrapping) + (field_size_in_bytes as u64 in Wrapping)) as u64;
        let span_offset: u64 = field_spans.spans[position].offset_in_bytes;
        let span_size: u64 = field_spans.spans[position].size_in_bytes;
        // Existing-end overflow fails upstream (`?` on checked_add).
        transition span_size <= 18446744073709551615 - span_offset {
            true -> ranges(engine_unprivileged_state, struct_layout_definition, offset_in_bytes, field_end, field_name, field_type_id, field_size_in_bytes, field_spans, positioned_fields, position, span_offset, span_size)
            _ -> (FieldUpsertResult { found: false, struct_layout_definition: SymbolicStructDefinition::empty() })
        }
    }
    state ranges(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_end: u64,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        field_spans: &SymbolicFieldSpanList,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        position: u64,
        span_offset: u64,
        span_size: u64
     ) -> FieldUpsertResult
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64 && span_size <= 18446744073709551615 - span_offset;
    {
        let span_end: u64 = ((span_offset as u64 in Wrapping) + (span_size as u64 in Wrapping)) as u64;
        let ranges_overlap: bool = span_offset < field_end && offset_in_bytes < span_end;
        transition ranges_overlap && span_offset != offset_in_bytes {
            true -> (FieldUpsertResult { found: false, struct_layout_definition: SymbolicStructDefinition::empty() })
            _ -> keep_or_skip(engine_unprivileged_state, struct_layout_definition, offset_in_bytes, field_name, field_type_id, field_size_in_bytes, field_spans, positioned_fields, position, span_offset, span_size)
        }
    }
    state keep_or_skip(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        field_spans: &SymbolicFieldSpanList,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        position: u64,
        span_offset: u64,
        span_size: u64
     ) -> FieldUpsertResult
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64;
    {
        // Same-offset spans drop (the promoted field replaces them);
        // every other span is preserved as a positioned field.
        transition span_offset != offset_in_bytes {
            true -> keep(engine_unprivileged_state, struct_layout_definition, offset_in_bytes, field_name, field_type_id, field_size_in_bytes, field_spans, positioned_fields, position, span_offset, span_size)
            _ -> each(engine_unprivileged_state, struct_layout_definition, offset_in_bytes, field_name, field_type_id, field_size_in_bytes, field_spans, positioned_fields, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state keep(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        field_spans: &SymbolicFieldSpanList,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        position: u64,
        span_offset: u64,
        span_size: u64
     ) -> FieldUpsertResult
        requires field_size_in_bytes <= 18446744073709551615 - offset_in_bytes && position < 64;
    {
        let field_index: u64 = field_spans.spans[position].field_index;
        let kept_field: &SymbolicFieldDefinition = SymbolicStructDefinition::get_field(struct_layout_definition, field_index);
        let positioned: SymbolLayoutPositionedField = SymbolLayoutPositionedField::new(span_offset, span_size, kept_field);
        _ = SymbolLayoutPositionedFieldList::push(positioned_fields, &positioned);
        transition { _ -> each(engine_unprivileged_state, struct_layout_definition, offset_in_bytes, field_name, field_type_id, field_size_in_bytes, field_spans, positioned_fields, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state promote(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        struct_layout_definition: &SymbolicStructDefinition,
        offset_in_bytes: u64,
        field_name: &[u8],
        field_type_id: &[u8],
        field_size_in_bytes: u64,
        positioned_fields: &mut SymbolLayoutPositionedFieldList
     ) -> FieldUpsertResult {
        let promoted_field: SymbolicFieldDefinition = ProjectItemSymbolPromotion::build_promoted_symbolic_field(field_name, field_type_id, offset_in_bytes);
        let promoted_positioned: SymbolLayoutPositionedField = SymbolLayoutPositionedField::new(offset_in_bytes, field_size_in_bytes, &promoted_field);
        _ = SymbolLayoutPositionedFieldList::push(positioned_fields, &promoted_positioned);
        transition { _ -> materialize(engine_unprivileged_state, struct_layout_definition, positioned_fields) }
    }
    state materialize(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        struct_layout_definition: &SymbolicStructDefinition,
        positioned_fields: &mut SymbolLayoutPositionedFieldList
     ) -> FieldUpsertResult {
        let materialized: MaterializedFieldList = SymbolLayoutFieldMaterializer::materialize_positioned_fields(
            SymbolicStructDefinition::get_layout_kind(struct_layout_definition),
            SymbolicStructDefinition::has_declared_size_in_bytes(struct_layout_definition),
            SymbolicStructDefinition::get_declared_size_in_bytes(struct_layout_definition),
            positioned_fields);
        transition materialized.found {
            true -> rebuild(engine_unprivileged_state, struct_layout_definition, &materialized)
            _ -> (FieldUpsertResult { found: false, struct_layout_definition: SymbolicStructDefinition::empty() })
        }
    }
    // `new_with_layout_kind(namespace, kind, fields)` + declared restore.
    state rebuild(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        struct_layout_definition: &SymbolicStructDefinition,
        materialized: &MaterializedFieldList
     ) -> FieldUpsertResult {
        transition MaterializedFieldList::get_field_count(materialized) <= 64 {
            true -> with_declared(struct_layout_definition, materialized)
            _ -> (FieldUpsertResult { found: false, struct_layout_definition: SymbolicStructDefinition::empty() })
        }
    }
    state with_declared(
        struct_layout_definition: &SymbolicStructDefinition,
        materialized: &MaterializedFieldList
     ) -> FieldUpsertResult
        requires materialized.field_count <= 64;
    {
        let mut rebuilt: SymbolicStructDefinition = SymbolicStructDefinition::new_with_layout_kind(
            SymbolicStructDefinition::get_symbol_namespace(struct_layout_definition),
            SymbolicStructDefinition::get_layout_kind(struct_layout_definition),
            MaterializedFieldList::get_fields(materialized));
        SymbolicStructDefinition::set_declared_size_in_bytes(
            &mut rebuilt,
            SymbolicStructDefinition::has_declared_size_in_bytes(struct_layout_definition),
            SymbolicStructDefinition::get_declared_size_in_bytes(struct_layout_definition));
        (FieldUpsertResult { found: true, struct_layout_definition: rebuilt })
    }
}

// Upstream `build_promoted_symbolic_field`: field-text parse fallback, then
// named-with-resolutions + a static offset + the carried active-when ref.
pub machine ProjectItemSymbolPromotion::build_promoted_symbolic_field(
    field_name: &[u8],
    field_type_id: &[u8],
    offset_in_bytes: u64
 ) -> SymbolicFieldDefinition {
    let parsed: SymbolicFieldDefinitionParse = SymbolicFieldDefinition::from_str(field_type_id);
    transition parsed {
        SymbolicFieldDefinitionParse::Parsed { value } -> named(field_name, offset_in_bytes, &value)
        _ -> plain(field_name, field_type_id, offset_in_bytes)
    }
    state named(field_name: &[u8], offset_in_bytes: u64, parsed_field: &SymbolicFieldDefinition) -> SymbolicFieldDefinition {
        let promoted_field: SymbolicFieldDefinition = SymbolicFieldDefinition::new_named_with_resolutions_and_display_count(
            field_name,
            SymbolicFieldDefinition::get_data_type_ref(parsed_field),
            SymbolicFieldDefinition::get_container_type(parsed_field),
            SymbolicFieldDefinition::get_count_resolution(parsed_field),
            SymbolicFieldDefinition::get_display_count_resolution(parsed_field),
            SymbolicFieldOffsetResolution::new_static(offset_in_bytes));
        let inner3129: SymbolicResolverRefMatch = SymbolicFieldDefinition::get_active_when_resolver(parsed_field);
        (SymbolicFieldDefinition::with_active_when_resolver(promoted_field, inner3129))
    }
    state plain(field_name: &[u8], field_type_id: &[u8], offset_in_bytes: u64) -> SymbolicFieldDefinition {
        let inner5: DataTypeRef = DataTypeRef::new(field_type_id);
        let unparseable: SymbolicFieldDefinition = SymbolicFieldDefinition::new(inner5, ContainerType::None);
        let promoted_field: SymbolicFieldDefinition = SymbolicFieldDefinition::new_named_with_resolutions_and_display_count(
            field_name,
            SymbolicFieldDefinition::get_data_type_ref(&unparseable),
            SymbolicFieldDefinition::get_container_type(&unparseable),
            SymbolicFieldDefinition::get_count_resolution(&unparseable),
            SymbolicFieldDefinition::get_display_count_resolution(&unparseable),
            SymbolicFieldOffsetResolution::new_static(offset_in_bytes));
        let inner3130: SymbolicResolverRefMatch = SymbolicFieldDefinition::get_active_when_resolver(&unparseable);
        (SymbolicFieldDefinition::with_active_when_resolver(promoted_field, inner3130))
    }
}

// Upstream `replace_struct_layout_definition` — position + set_at replace
// the get-to-vec/set-back dance.
pub machine ProjectItemSymbolPromotion::replace_struct_layout_definition(
    project_symbol_catalog: &mut ProjectSymbolCatalog,
    struct_layout_id: &[u8],
    struct_layout_definition: &SymbolicStructDefinition
 )
 -> bool {
    let position: u64 = ProjectSymbolCatalog::find_struct_layout_descriptor_position(project_symbol_catalog, struct_layout_id);
    transition position < ProjectSymbolCatalog::get_struct_layout_descriptor_count(project_symbol_catalog) && position < 128 {
        true -> replace(project_symbol_catalog, struct_layout_id, struct_layout_definition, position)
        _ -> (false)
    }
    state replace(
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        struct_layout_id: &[u8],
        struct_layout_definition: &SymbolicStructDefinition,
        position: u64
     )
     -> bool
        requires position < 128;
    {
        let replacement: StructLayoutDescriptor = StructLayoutDescriptor::new(struct_layout_id, struct_layout_definition);
        (ProjectSymbolCatalog::set_struct_layout_descriptor_at(project_symbol_catalog, position, &replacement))
    }
}

// Upstream `find_containing_child`'s `find_struct_layout_descriptor` — the
// position scan + accessor pair.
pub machine ProjectItemSymbolPromotion::has_struct_layout_descriptor(
    project_symbol_catalog: &ProjectSymbolCatalog,
    struct_layout_id: &[u8]
 )
 -> bool {
    let position: u64 = ProjectSymbolCatalog::find_struct_layout_descriptor_position(project_symbol_catalog, struct_layout_id);
    (position < ProjectSymbolCatalog::get_struct_layout_descriptor_count(project_symbol_catalog))
}

// ---- catalog-side layout helpers (upstream catalog methods; engine-side
// here because they need `EngineUnprivilegedState` for unit sizes) ----

// Upstream `ProjectSymbolCatalog::ensure_module_root_struct_layout`: grow or
// create the module's root descriptor with the declared size, materialize
// it, and keep descriptors sorted by id.
pub machine ProjectItemSymbolPromotion::ensure_module_root_struct_layout(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    project_symbol_catalog: &mut ProjectSymbolCatalog,
    module_name: &[u8],
    module_size_in_bytes: u64
) {
    let trimmed: ManifestPathScratch = promotion_trim_scratch(module_name);
    transition trimmed.len > 0 {
        true -> positioned(engine_unprivileged_state, project_symbol_catalog, &trimmed, module_size_in_bytes)
        _ -> done()
    }
    state positioned(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        module_name: &ManifestPathScratch,
        module_size_in_bytes: u64
    ) {
        let inner6: &[u8] = ManifestPathScratch::get_bytes(module_name);
        let position: u64 = ProjectSymbolCatalog::find_struct_layout_descriptor_position(project_symbol_catalog, inner6);
        transition position < ProjectSymbolCatalog::get_struct_layout_descriptor_count(project_symbol_catalog) && position < 128 {
            true -> existing(engine_unprivileged_state, project_symbol_catalog, module_name, module_size_in_bytes, position)
            _ -> fresh(engine_unprivileged_state, project_symbol_catalog, module_name, module_size_in_bytes)
        }
    }
    state existing(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        module_name: &ManifestPathScratch,
        module_size_in_bytes: u64,
        position: u64
    )
        requires position < 128;
    {
        let descriptor: &StructLayoutDescriptor = ProjectSymbolCatalog::get_struct_layout_descriptor(project_symbol_catalog, position);
        let mut updated: SymbolicStructDefinition = SymbolicStructDefinition::clone(StructLayoutDescriptor::get_struct_layout_definition(descriptor));
        SymbolicStructDefinition::set_declared_size_in_bytes(&mut updated, true, module_size_in_bytes);
        transition { _ -> materialize_existing(engine_unprivileged_state, project_symbol_catalog, module_name, position, updated) }
    }
    state materialize_existing(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        module_name: &ManifestPathScratch,
        position: u64,
        struct_layout_definition: SymbolicStructDefinition
    )
        requires position < 128;
    {
        let materialized: SymbolicStructDefinition = ProjectItemSymbolPromotion::materialize_struct_layout_definition(engine_unprivileged_state, project_symbol_catalog, &struct_layout_definition);
        let inner7: &[u8] = ManifestPathScratch::get_bytes(module_name);
        let descriptor: StructLayoutDescriptor = StructLayoutDescriptor::new(inner7, &materialized);
        _ = ProjectSymbolCatalog::set_struct_layout_descriptor_at(project_symbol_catalog, position, &descriptor);
        transition { _ -> sort(project_symbol_catalog) }
    }
    state fresh(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &mut ProjectSymbolCatalog,
        module_name: &ManifestPathScratch,
        module_size_in_bytes: u64
    ) {
        let mut definition: SymbolicStructDefinition = SymbolicStructDefinition::new_empty(ManifestPathScratch::get_bytes(module_name));
        SymbolicStructDefinition::set_declared_size_in_bytes(&mut definition, true, module_size_in_bytes);
        let materialized: SymbolicStructDefinition = ProjectItemSymbolPromotion::materialize_struct_layout_definition(engine_unprivileged_state, project_symbol_catalog, &definition);
        let inner8: &[u8] = ManifestPathScratch::get_bytes(module_name);
        let descriptor: StructLayoutDescriptor = StructLayoutDescriptor::new(inner8, &materialized);
        _ = ProjectSymbolCatalog::add_struct_layout_descriptor(project_symbol_catalog, &descriptor);
        transition { _ -> sort(project_symbol_catalog) }
    }
    state done() { }
    state sort(project_symbol_catalog: &mut ProjectSymbolCatalog) {
        ProjectSymbolCatalog::sort_struct_layout_descriptors_by_id(project_symbol_catalog);
    }
}


// Upstream `ProjectSymbolCatalog::materialize_struct_layout_definition` —
// fields get positioned by span, then the materializer fills gaps and
// rewrites offsets; a failed materialize returns the input unchanged.
pub machine ProjectItemSymbolPromotion::materialize_struct_layout_definition(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    project_symbol_catalog: &ProjectSymbolCatalog,
    symbolic_struct_definition: &SymbolicStructDefinition
 ) -> SymbolicStructDefinition {
    let is_union: bool = SymbolicLayoutKind::is_union(&SymbolicStructDefinition::get_layout_kind(symbolic_struct_definition));
    let mut positioned_fields: SymbolLayoutPositionedFieldList = SymbolLayoutPositionedFieldList::new();
    transition { _ -> each(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, &mut positioned_fields, is_union, 0, 0) }
    state each(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        symbolic_struct_definition: &SymbolicStructDefinition,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64
     ) -> SymbolicStructDefinition {
        transition position < SymbolicStructDefinition::get_field_count(symbolic_struct_definition) {
            true -> field(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, position, next_sequential_offset)
            _ -> materialize(symbolic_struct_definition, positioned_fields)
        }
    }
    state field(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        symbolic_struct_definition: &SymbolicStructDefinition,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64
     ) -> SymbolicStructDefinition {
        let field_definition: &SymbolicFieldDefinition = SymbolicStructDefinition::get_field(symbolic_struct_definition, position);
        transition SymbolicFieldDefinition::is_unassigned(field_definition) {
            true -> unassigned(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, position, next_sequential_offset, field_definition)
            _ -> assigned(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, position, next_sequential_offset, field_definition)
        }
    }
    state unassigned(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        symbolic_struct_definition: &SymbolicStructDefinition,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64,
        field_definition: &SymbolicFieldDefinition
     ) -> SymbolicStructDefinition {
        let unassigned_size: SymbolicUnassignedSize = SymbolicFieldDefinition::get_unassigned_size_in_bytes(field_definition);
        transition unassigned_size.found {
            true -> unassigned_advance(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, position, next_sequential_offset, unassigned_size.size_in_bytes)
            _ -> unassigned_advance(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, position, next_sequential_offset, 0)
        }
    }
    state unassigned_advance(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        symbolic_struct_definition: &SymbolicStructDefinition,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64,
        gap: u64
     ) -> SymbolicStructDefinition {
        transition gap <= 18446744073709551615 - next_sequential_offset {
            true -> each(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, ((next_sequential_offset as u64 in Wrapping) + (gap as u64 in Wrapping)) as u64)
            _ -> each(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, 18446744073709551615)
        }
    }
    state assigned(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        symbolic_struct_definition: &SymbolicStructDefinition,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64,
        field_definition: &SymbolicFieldDefinition
     ) -> SymbolicStructDefinition {
        let offset_resolution: SymbolicFieldOffsetResolution = SymbolicFieldDefinition::get_offset_resolution(field_definition);
        transition offset_resolution {
            SymbolicFieldOffsetResolution::Static { offset_in_bytes } -> sized(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, position, next_sequential_offset, field_definition, offset_in_bytes)
            _ -> sequential(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, position, next_sequential_offset, field_definition)
        }
    }
    state sequential(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        symbolic_struct_definition: &SymbolicStructDefinition,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64,
        field_definition: &SymbolicFieldDefinition
     ) -> SymbolicStructDefinition {
        transition is_union {
            true -> sized(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, position, next_sequential_offset, field_definition, 0)
            _ -> sized(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, position, next_sequential_offset, field_definition, next_sequential_offset)
        }
    }
    // Descriptor-builder semantics: catalog-scoped resolve, miss -> 1.
    state sized(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        symbolic_struct_definition: &SymbolicStructDefinition,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64,
        field_definition: &SymbolicFieldDefinition,
        field_offset: u64
     ) -> SymbolicStructDefinition {
        let mut field_visits: SymbolLayoutVisitSet = SymbolLayoutVisitSet::new();
        let resolved: SymbolLayoutSizeResult = SymbolLayoutSizeResolver::resolve_symbolic_field_size_in_bytes(
            engine_unprivileged_state,
            project_symbol_catalog,
            true,
            field_definition,
            &mut field_visits);
        let mut field_size: u64 = resolved.size_in_bytes;
        transition !resolved.found {
            true -> sized_floor(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, position, next_sequential_offset, field_definition, field_offset)
            _ -> positioned(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, position, next_sequential_offset, field_definition, field_offset, field_size)
        }
    }
    state sized_floor(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        symbolic_struct_definition: &SymbolicStructDefinition,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64,
        field_definition: &SymbolicFieldDefinition,
        field_offset: u64
     ) -> SymbolicStructDefinition {
        transition { _ -> positioned(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, position, next_sequential_offset, field_definition, field_offset, 1) }
    }
    state positioned(
        engine_unprivileged_state: &mut EngineUnprivilegedState,
        project_symbol_catalog: &ProjectSymbolCatalog,
        symbolic_struct_definition: &SymbolicStructDefinition,
        positioned_fields: &mut SymbolLayoutPositionedFieldList,
        is_union: bool,
        position: u64,
        next_sequential_offset: u64,
        field_definition: &SymbolicFieldDefinition,
        field_offset: u64,
        field_size: u64
     ) -> SymbolicStructDefinition {
        let positioned_field: SymbolLayoutPositionedField = SymbolLayoutPositionedField::new(field_offset, field_size, field_definition);
        _ = SymbolLayoutPositionedFieldList::push(positioned_fields, &positioned_field);
        transition field_size <= 18446744073709551615 - field_offset && ((field_offset as u64 in Wrapping) + (field_size as u64 in Wrapping)) as u64 > next_sequential_offset {
            true -> each(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, ((field_offset as u64 in Wrapping) + (field_size as u64 in Wrapping)) as u64)
            _ -> each(engine_unprivileged_state, project_symbol_catalog, symbolic_struct_definition, positioned_fields, is_union, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, next_sequential_offset)
        }
    }
    state materialize(
        symbolic_struct_definition: &SymbolicStructDefinition,
        positioned_fields: &mut SymbolLayoutPositionedFieldList
     ) -> SymbolicStructDefinition {
        let materialized: MaterializedFieldList = SymbolLayoutFieldMaterializer::materialize_positioned_fields(
            SymbolicStructDefinition::get_layout_kind(symbolic_struct_definition),
            SymbolicStructDefinition::has_declared_size_in_bytes(symbolic_struct_definition),
            SymbolicStructDefinition::get_declared_size_in_bytes(symbolic_struct_definition),
            positioned_fields);
        // Upstream: failed materialize returns the input unchanged.
        transition materialized.found {
            true -> rebuild(symbolic_struct_definition, &materialized)
            _ -> (SymbolicStructDefinition::clone(symbolic_struct_definition))
        }
    }
    state rebuild(
        symbolic_struct_definition: &SymbolicStructDefinition,
        materialized: &MaterializedFieldList
     ) -> SymbolicStructDefinition {
        transition MaterializedFieldList::get_field_count(materialized) <= 64 {
            true -> with_declared(symbolic_struct_definition, materialized)
            _ -> (SymbolicStructDefinition::clone(symbolic_struct_definition))
        }
    }
    state with_declared(
        symbolic_struct_definition: &SymbolicStructDefinition,
        materialized: &MaterializedFieldList
     ) -> SymbolicStructDefinition
        requires materialized.field_count <= 64;
    {
        let mut rebuilt: SymbolicStructDefinition = SymbolicStructDefinition::new_with_layout_kind(
            SymbolicStructDefinition::get_symbol_namespace(symbolic_struct_definition),
            SymbolicStructDefinition::get_layout_kind(symbolic_struct_definition),
            MaterializedFieldList::get_fields(materialized));
        SymbolicStructDefinition::set_declared_size_in_bytes(
            &mut rebuilt,
            SymbolicStructDefinition::has_declared_size_in_bytes(symbolic_struct_definition),
            SymbolicStructDefinition::get_declared_size_in_bytes(symbolic_struct_definition));
        (rebuilt)
    }
}

// `str::trim` on a slice into the shared scratch carrier.
machine promotion_trim_scratch(source: &[u8]) -> ManifestPathScratch {
        let mut name_scope: ProjectSymbolNameScope = ProjectSymbolNameScope {};
    let mut trimmed: ManifestPathScratch;
    ManifestPathScratch::new(&mut trimmed);
    _ = ProjectSymbolNameScope::trim_copy(&mut name_scope, source, &mut trimmed);
    (trimmed)
}

// Exact locator equality — upstream `PartialEq`. The focus accessors expose
// each arm's payload, so arm-kind + address + module bytes is structural.
machine promotion_locator_equals(left: &ProjectSymbolLocator, right: &ProjectSymbolLocator) -> bool {
    let same_kind: bool = ProjectSymbolLocator::is_module_offset(left) == ProjectSymbolLocator::is_module_offset(right);
    let same_address: bool = ProjectSymbolLocator::get_focus_address(left) == ProjectSymbolLocator::get_focus_address(right);
    let same_module: bool = promotion_bytes_equal(
        ProjectSymbolLocator::get_focus_module_name(left),
        ProjectSymbolLocator::get_focus_module_name(right));
    (same_kind && same_address && same_module)
}

// `{:X}` into scratch — `minimum_width` zero-pads like `{:08X}`.
machine promotion_append_hex_u64(scratch: &mut ManifestPathScratch, value: u64, minimum_width: u64) -> bool {
    transition { _ -> emit(scratch, value, minimum_width, 0) }
    // One digit per shift step from the most significant nibble.
    state emit(scratch: &mut ManifestPathScratch, value: u64, minimum_width: u64, emitted: u64) -> bool {
        transition emitted < 16 {
            true -> digit(scratch, value, minimum_width, emitted)
            _ -> (true)
        }
    }
    state digit(scratch: &mut ManifestPathScratch, value: u64, minimum_width: u64, emitted: u64) -> bool
        requires emitted < 16;
    {
        let shift: u64 = (((15 as u64 in Wrapping) - (emitted as u64 in Wrapping) * (4 as u64 in Wrapping)) as u64);
        let shifted: u64 = ((value as u64 in Wrapping) >> (shift as u64 in Wrapping)) as u64;
        let nibble: u64 = ((shifted as u64 in Wrapping) % (16 as u64 in Wrapping)) as u64;
        // Skip leading zero nibbles unless the field's minimum width or a
        // nonzero digit has already committed the field.
        // The final position always commits so `0` renders as `0`.
        let width_committed: bool = 16 - emitted <= minimum_width || emitted == 15;
        transition nibble == 0 && !width_committed {
            true -> emit(scratch, value, minimum_width, ((emitted as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> store(scratch, nibble, value, minimum_width, emitted)
        }
    }
    state store(scratch: &mut ManifestPathScratch, nibble: u64, value: u64, minimum_width: u64, emitted: u64) -> bool
        requires emitted < 16;
    {
        transition nibble < 10 {
            true -> store_decimal(scratch, nibble, value, minimum_width, emitted)
            _ -> store_letter(scratch, nibble, value, minimum_width, emitted)
        }
    }
    state store_decimal(scratch: &mut ManifestPathScratch, nibble: u64, value: u64, minimum_width: u64, emitted: u64) -> bool
        requires emitted < 16 && nibble < 10;
    {
        transition ManifestPathScratch::append(scratch, ((48 + nibble) as u8)) {
            true -> emit_tail(scratch, value, minimum_width, emitted)
            _ -> (false)
        }
    }
    state store_letter(scratch: &mut ManifestPathScratch, nibble: u64, value: u64, minimum_width: u64, emitted: u64) -> bool
        requires emitted < 16;
    {
        transition nibble < 16 {
            true -> store_letter_emit(scratch, nibble, value, minimum_width, emitted)
            _ -> emit_tail(scratch, value, minimum_width, emitted)
        }
    }
    state store_letter_emit(scratch: &mut ManifestPathScratch, nibble: u64, value: u64, minimum_width: u64, emitted: u64) -> bool
        requires emitted < 16 && nibble >= 10 && nibble < 16;
    {
        transition ManifestPathScratch::append(scratch, ((55 + nibble) as u8)) {
            true -> emit_tail(scratch, value, minimum_width, emitted)
            _ -> (false)
        }
    }
    // Once a digit is written, every remaining position commits — recurse
    // with width 16.
    state emit_tail(scratch: &mut ManifestPathScratch, value: u64, minimum_width: u64, emitted: u64) -> bool
        requires emitted < 16;
    {
        transition { _ -> emit(scratch, value, 16, ((emitted as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Byte-append over a slice (`&[u8]` has no append surface here).
machine promotion_append_bytes(scratch: &mut ManifestPathScratch, source: &[u8]) -> bool {
    transition { _ -> each(scratch, source, 0) }
    state each(scratch: &mut ManifestPathScratch, source: &[u8], position: u64) -> bool {
        transition position < source.len {
            true -> byte(scratch, source, position)
            _ -> (true)
        }
    }
    state byte(scratch: &mut ManifestPathScratch, source: &[u8], position: u64) -> bool
        requires position < source.len;
    {
        transition ManifestPathScratch::append(scratch, source[position]) {
            true -> each(scratch, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// `Path::file_stem` — basename through the last '.', "" when absent.
machine promotion_file_stem(path: &[u8], out_stem: &mut ManifestPathScratch) -> bool {
    let mut file_mutation: ProjectItemFileMutation = ProjectItemFileMutation {};
    let base_start: u64 = ProjectItemFileMutation::find_last_separator(path);
    transition { _ -> dot_scan(path, base_start, base_start, base_start, out_stem) }
    // Track the last '.' at or after `base_start` as `dot`; `position` walks.
    state dot_scan(path: &[u8], base_start: u64, position: u64, dot: u64, out_stem: &mut ManifestPathScratch) -> bool {
        transition position < path.len {
            true -> dot_probe(path, base_start, position, dot, out_stem)
            _ -> emit(path, base_start, dot, out_stem)
        }
    }
    state dot_probe(path: &[u8], base_start: u64, position: u64, dot: u64, out_stem: &mut ManifestPathScratch) -> bool
        requires position < path.len;
    {
        transition path[position] == 46 {
            true -> dot_scan(path, base_start, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, position, out_stem)
            _ -> dot_scan(path, base_start, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, dot, out_stem)
        }
    }
    // `dot == base_start` means no '.' found — stem is the whole basename.
    state emit(path: &[u8], base_start: u64, dot: u64, out_stem: &mut ManifestPathScratch) -> bool {
        transition dot > base_start {
            true -> copy_stem(path, base_start, dot, out_stem, base_start)
            _ -> copy_stem(path, base_start, path.len, out_stem, base_start)
        }
    }
    state copy_stem(path: &[u8], base_start: u64, end: u64, out_stem: &mut ManifestPathScratch, position: u64) -> bool {
        transition position < end && position < path.len {
            true -> stem_byte(path, base_start, end, out_stem, position)
            _ -> (true)
        }
    }
    state stem_byte(path: &[u8], base_start: u64, end: u64, out_stem: &mut ManifestPathScratch, position: u64) -> bool
        requires position < end && position < path.len;
    {
        transition ManifestPathScratch::append(out_stem, path[position]) {
            true -> copy_stem(path, base_start, end, out_stem, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// Upstream `build_display_name`: trimmed field name, else the path's file
// stem trimmed, else "Symbol".
pub machine ProjectItemSymbolPromotion::build_display_name(
    project_item: &ProjectItem,
    project_item_path: &[u8]
 ) -> ManifestPathScratch {
        let mut name_scope: ProjectSymbolNameScope = ProjectSymbolNameScope {};
    let mut name_bytes: [u8; 256];
    let name_len: u64 = ProjectItem::get_field_name(project_item, &mut name_bytes);
    let mut display_name: ManifestPathScratch;
    ManifestPathScratch::new(&mut display_name);
    transition name_len <= 256 {
        true -> trim_field(name_bytes, name_len, display_name, project_item_path)
        _ -> stem(project_item_path, display_name)
    }
    state trim_field(name_bytes: [u8; 256], name_len: u64, display_name: ManifestPathScratch, project_item_path: &[u8]) -> ManifestPathScratch
        requires name_len <= 256;
    {
        let mut trimmed: ManifestPathScratch;
        ManifestPathScratch::new(&mut trimmed);
        let mut name_scope: ProjectSymbolNameScope = ProjectSymbolNameScope {};
        _ = ProjectSymbolNameScope::trim_copy(&mut name_scope, &name_bytes[0..name_len], &mut trimmed);
        transition trimmed.len > 0 {
            true -> (trimmed)
            _ -> stem(project_item_path, trimmed)
        }
    }
    state stem(project_item_path: &[u8], display_name: ManifestPathScratch) -> ManifestPathScratch {
        let mut stem_name: ManifestPathScratch;
        ManifestPathScratch::new(&mut stem_name);
        _ = promotion_file_stem(project_item_path, &mut stem_name);
        transition { _ -> trim_stem(stem_name, display_name) }
    }
    state trim_stem(stem_name: ManifestPathScratch, display_name: ManifestPathScratch) -> ManifestPathScratch {
        let mut trimmed: ManifestPathScratch;
        ManifestPathScratch::new(&mut trimmed);
        let mut name_scope: ProjectSymbolNameScope = ProjectSymbolNameScope {};
        let inner3131: &[u8] = ManifestPathScratch::get_bytes(&stem_name);
        _ = ProjectSymbolNameScope::trim_copy(&mut name_scope, inner3131, &mut trimmed);
        transition trimmed.len > 0 {
            true -> (trimmed)
            _ -> fallback(trimmed)
        }
    }
    state fallback(display_name: ManifestPathScratch) -> ManifestPathScratch {
        let mut symbol_name: ManifestPathScratch = display_name;
        _ = promotion_append_bytes(&mut symbol_name, "Symbol");
