}

// Upstream `apply_promoted_symbol_chain_segment`: when the promoted locator
// is a module offset matching the address target's module, the matching
// first offset link is rewritten to the symbol name.
pub machine ProjectItemSymbolPromotion::apply_promoted_symbol_chain_segment(
    promoted_project_item: &mut ProjectItem,
    promoted_symbol: &ProjectSymbolClaim
) {
    let locator: &ProjectSymbolLocator = ProjectSymbolClaim::get_locator(promoted_symbol);
    transition locator {
        ProjectSymbolLocator::ModuleOffset { module_name, module_name_len, offset } -> valid_name(promoted_project_item, promoted_symbol, module_name, module_name_len, offset)
        _ -> done()
    }
    state valid_name(
        promoted_project_item: &mut ProjectItem,
        promoted_symbol: &ProjectSymbolClaim,
        module_name: [u8; 256],
        module_name_len: u64,
        offset: u64
    ) {
        transition symbolic_pointer_chain_is_valid_symbol_name(ProjectSymbolClaim::get_display_name(promoted_symbol)) {
            true -> target(promoted_project_item, promoted_symbol, module_name, module_name_len, offset)
            _ -> done()
        }
    }
    state target(
        promoted_project_item: &mut ProjectItem,
        promoted_symbol: &ProjectSymbolClaim,
        module_name: [u8; 256],
        module_name_len: u64,
        offset: u64
    ) {
        transition module_name_len <= 256 {
            true -> module_match(promoted_project_item, promoted_symbol, module_name, module_name_len, offset)
            _ -> done()
        }
    }
    state module_match(
        promoted_project_item: &mut ProjectItem,
        promoted_symbol: &ProjectSymbolClaim,
        module_name: [u8; 256],
        module_name_len: u64,
        offset: u64
    )
        requires module_name_len <= 256;
    {
        let mut address_target: ProjectItemAddressTarget = ProjectItemTypeAddress::get_address_target(promoted_project_item);
        let module_matches: bool = promotion_bytes_equal(&module_name[0..module_name_len], ProjectItemAddressTarget::get_module_name(&address_target));
        transition module_matches {
            true -> first_link(promoted_project_item, promoted_symbol, address_target, offset)
            _ -> done()
        }
    }
    state first_link(
        promoted_project_item: &mut ProjectItem,
        promoted_symbol: &ProjectSymbolClaim,
        address_target: ProjectItemAddressTarget,
        offset: u64
    ) {
        transition ProjectItemAddressTarget::get_link_count(&address_target) > 0 {
            true -> offset_match(promoted_project_item, promoted_symbol, address_target, offset)
            _ -> done()
        }
    }
    state offset_match(
        promoted_project_item: &mut ProjectItem,
        promoted_symbol: &ProjectSymbolClaim,
        address_target: ProjectItemAddressTarget,
        offset: u64
    ) {
        transition offset <= 9223372036854775807 {
            true -> offset_compare(promoted_project_item, promoted_symbol, address_target, offset)
            _ -> done()
        }
    }
    state offset_compare(
        promoted_project_item: &mut ProjectItem,
        promoted_symbol: &ProjectSymbolClaim,
        address_target: ProjectItemAddressTarget,
        offset: u64
    )
        requires offset <= 9223372036854775807;
    {
        let first_link: SymbolicPointerChainLink = ProjectItemAddressTarget::get_first_pointer_offset(&address_target);
        let first_offset: SymbolicLinkOffset = SymbolicPointerChainLink::as_offset(&first_link);
        transition first_offset.found && first_offset.offset == (offset as i64) {
            true -> rewrite(promoted_project_item, promoted_symbol, address_target)
            _ -> done()
        }
    }
    state rewrite(
        promoted_project_item: &mut ProjectItem,
        promoted_symbol: &ProjectSymbolClaim,
        address_target: ProjectItemAddressTarget
    ) {
        let inner9: &[u8] = ProjectSymbolClaim::get_display_name(promoted_symbol);
        let symbol_link: SymbolicLinkBuild = SymbolicPointerChainLink::new_symbol(inner9);
        transition symbol_link.found {
            true -> relink(promoted_project_item, address_target, symbol_link.link)
            _ -> done()
        }
    }
    state relink(
        promoted_project_item: &mut ProjectItem,
        address_target: ProjectItemAddressTarget,
        symbol_link: SymbolicPointerChainLink
    ) {
        let mut links: [SymbolicPointerChainLink; 64];
        let link_count: u64 = ProjectItemAddressTarget::get_link_count(&address_target);
        transition link_count <= 64 {
            true -> copy_links(promoted_project_item, address_target, symbol_link, &mut links, link_count, 0)
            _ -> done()
        }
    }
    state copy_links(
        promoted_project_item: &mut ProjectItem,
        address_target: ProjectItemAddressTarget,
        symbol_link: SymbolicPointerChainLink,
        links: &mut [SymbolicPointerChainLink; 64],
        link_count: u64,
        position: u64
    )
        requires link_count <= 64;
    {
        transition position < link_count {
            true -> copy_link(promoted_project_item, address_target, symbol_link, links, link_count, position)
            _ -> splice(promoted_project_item, address_target, symbol_link, links, link_count)
        }
    }
    state copy_link(
        promoted_project_item: &mut ProjectItem,
        address_target: ProjectItemAddressTarget,
        symbol_link: SymbolicPointerChainLink,
        links: &mut [SymbolicPointerChainLink; 64],
        link_count: u64,
        position: u64
    )
        requires link_count <= 64 && position < link_count;
    {
        let stored_link: SymbolicPointerChainLink = ProjectItemAddressTarget::get_pointer_offset_at(&address_target, position);
        links[position] = stored_link;
        transition { _ -> copy_links(promoted_project_item, address_target, symbol_link, links, link_count, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state splice(
        promoted_project_item: &mut ProjectItem,
        address_target: ProjectItemAddressTarget,
        symbol_link: SymbolicPointerChainLink,
        links: &mut [SymbolicPointerChainLink; 64],
        link_count: u64
    )
        requires link_count <= 64;
    {
        links[0] = symbol_link;
        transition { _ -> store(promoted_project_item, address_target, links, link_count) }
    }
    state store(
        promoted_project_item: &mut ProjectItem,
        address_target: ProjectItemAddressTarget,
        links: &mut [SymbolicPointerChainLink; 64],
        link_count: u64
    )
        requires link_count <= 64;
    {
        let mut updated_target: ProjectItemAddressTarget = address_target;
        ProjectItemAddressTarget::set_pointer_offsets(&mut updated_target, &links[0..link_count]);
        ProjectItemTypeAddress::set_address_target(promoted_project_item, &updated_target);
    }
    state done() { }
}

// Upstream `append_pointer_metadata` — `source.pointer_offsets` renders
// textually per the documented serde deviation.
pub machine ProjectItemSymbolPromotion::append_pointer_metadata(
    promoted_symbol: &mut ProjectSymbolClaim,
    pointer: &OwnedRuntimePointer,
    project_item: &ProjectItem
) {
        let mut name_scope: ProjectSymbolNameScope = ProjectSymbolNameScope {};
    let module_name: &[u8] = OwnedRuntimePointer::get_module_name(pointer);
    transition module_name.len > 0 {
        true -> module_root(promoted_symbol, pointer, project_item)
        _ -> absolute_root(promoted_symbol, pointer, project_item)
    }
    // `format_module_address`: "name+0x<offset hex>".
    state module_root(promoted_symbol: &mut ProjectSymbolClaim, pointer: &OwnedRuntimePointer, project_item: &ProjectItem) {
        let mut root_text: ManifestPathScratch;
        ManifestPathScratch::new(&mut root_text);
        _ = promotion_append_bytes(&mut root_text, OwnedRuntimePointer::get_module_name(pointer));
        _ = promotion_append_bytes(&mut root_text, "+0x");
        _ = promotion_append_hex_u64(&mut root_text, OwnedRuntimePointer::get_address(pointer), 0);
        let inner3132: &[u8] = ManifestPathScratch::get_bytes(&root_text);
        _ = ProjectSymbolClaim::add_metadata(promoted_symbol, "source.pointer_root", inner3132);
        transition { _ -> remaining(promoted_symbol, pointer, project_item) }
    }
    // `format_absolute_address`: 8-digit hex at u32 range, else 16-digit.
    state absolute_root(promoted_symbol: &mut ProjectSymbolClaim, pointer: &OwnedRuntimePointer, project_item: &ProjectItem) {
        let mut root_text: ManifestPathScratch;
        ManifestPathScratch::new(&mut root_text);
        transition OwnedRuntimePointer::get_address(pointer) <= 4294967295 {
            true -> pad_eight(promoted_symbol, pointer, project_item, &mut root_text)
            _ -> pad_sixteen(promoted_symbol, pointer, project_item, &mut root_text)
        }
    }
    state pad_eight(promoted_symbol: &mut ProjectSymbolClaim, pointer: &OwnedRuntimePointer, project_item: &ProjectItem, root_text: &mut ManifestPathScratch) {
        _ = promotion_append_hex_u64(root_text, OwnedRuntimePointer::get_address(pointer), 8);
        let inner3133: &[u8] = ManifestPathScratch::get_bytes(root_text);
        _ = ProjectSymbolClaim::add_metadata(promoted_symbol, "source.pointer_root", inner3133);
        transition { _ -> remaining(promoted_symbol, pointer, project_item) }
    }
    state pad_sixteen(promoted_symbol: &mut ProjectSymbolClaim, pointer: &OwnedRuntimePointer, project_item: &ProjectItem, root_text: &mut ManifestPathScratch) {
        _ = promotion_append_hex_u64(root_text, OwnedRuntimePointer::get_address(pointer), 16);
        let inner3134: &[u8] = ManifestPathScratch::get_bytes(root_text);
        _ = ProjectSymbolClaim::add_metadata(promoted_symbol, "source.pointer_root", inner3134);
        transition { _ -> remaining(promoted_symbol, pointer, project_item) }
    }
    state remaining(promoted_symbol: &mut ProjectSymbolClaim, pointer: &OwnedRuntimePointer, project_item: &ProjectItem) {
        let inner3135: &[u8] = OwnedRuntimePointer::get_module_name(pointer);
        _ = ProjectSymbolClaim::add_metadata(promoted_symbol, "source.pointer_root_module", inner3135);
        let mut offset_text: ManifestPathScratch;
        ManifestPathScratch::new(&mut offset_text);
        _ = promotion_append_bytes(&mut offset_text, "0x");
        _ = promotion_append_hex_u64(&mut offset_text, OwnedRuntimePointer::get_address(pointer), 0);
        let inner3136: &[u8] = ManifestPathScratch::get_bytes(&offset_text);
        _ = ProjectSymbolClaim::add_metadata(promoted_symbol, "source.pointer_root_offset", inner3136);
        transition { _ -> segments(promoted_symbol, pointer, project_item) }
    }
    // Textual segment list: `0x<hex>` offsets, `symbol:<name>` links,
    // `;`-joined — the serde deviation documented at file top.
    state segments(promoted_symbol: &mut ProjectSymbolClaim, pointer: &OwnedRuntimePointer, project_item: &ProjectItem) {
        let mut segments_text: ManifestPathScratch;
        ManifestPathScratch::new(&mut segments_text);
        transition { _ -> segment_each(promoted_symbol, pointer, project_item, &mut segments_text, 0) }
    }
    state segment_each(promoted_symbol: &mut ProjectSymbolClaim, pointer: &OwnedRuntimePointer, project_item: &ProjectItem, segments_text: &mut ManifestPathScratch, position: u64) {
        transition position < OwnedRuntimePointer::get_offset_count(pointer) && position < 64 {
            true -> segment_sep(promoted_symbol, pointer, project_item, segments_text, position)
            _ -> size_entry(promoted_symbol, pointer, project_item, segments_text)
        }
    }
    state segment_sep(promoted_symbol: &mut ProjectSymbolClaim, pointer: &OwnedRuntimePointer, project_item: &ProjectItem, segments_text: &mut ManifestPathScratch, position: u64) {
        transition position > 0 {
            true -> append_sep(promoted_symbol, pointer, project_item, segments_text, position)
            _ -> segment_link(promoted_symbol, pointer, project_item, segments_text, position)
        }
    }
    state append_sep(promoted_symbol: &mut ProjectSymbolClaim, pointer: &OwnedRuntimePointer, project_item: &ProjectItem, segments_text: &mut ManifestPathScratch, position: u64) {
        _ = promotion_append_bytes(segments_text, ";");
        transition { _ -> segment_link(promoted_symbol, pointer, project_item, segments_text, position) }
    }
    state segment_link(promoted_symbol: &mut ProjectSymbolClaim, pointer: &OwnedRuntimePointer, project_item: &ProjectItem, segments_text: &mut ManifestPathScratch, position: u64)
        requires position < 64;
    {
        let link: SymbolicPointerChainLink = OwnedRuntimePointer::get_offset_segment(pointer, position);
        let link_offset: SymbolicLinkOffset = SymbolicPointerChainLink::as_offset(&link);
