module src::command_executors::pointer_scan_start_request_executor;

use squalr_engine_api::src::commands::pointer_scan::start::pointer_scan_start_request::PointerScanStartRequest;
use squalr_engine_api::src::commands::pointer_scan::start::pointer_scan_start_response::PointerScanStartResponse;
use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_address_space::PointerScanAddressSpace;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_candidate::PointerScanCandidate;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_level_candidates::PointerScanLevelCandidates;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_level_summary::PointerScanLevelSummary;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_node_type::PointerScanNodeType;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_results::PointerScanResults;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_summary::StoredPointerScanSummary;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_target_descriptor::PointerScanTargetDescriptor;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::scanning::plans::pointer_scan::pointer_scan_parameters::PointerScanParameters;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use squalr_engine_scanning::src::pointer_scans::pointer_scan_executor_task::PointerScanExecutor;
use squalr_engine_scanning::src::pointer_scans::structures::pointer_scan_collected_level::PointerScanCollectedLevel;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::memory::normalized_module::NormalizedModule;
use squalr_engine_session::src::pointer_scan_results_store::PointerScanResultsArenas;
use src::command_executors::pointer_scan_level_harvest::pointer_scan_harvest_level_data;
use src::command_executors::pointer_scan_scratch::PointerScanScratch;
use src::command_executors::pointer_scan_target_resolution::PointerScanTargetResolution;
use src::command_executors::pointer_scan_target_resolution::PointerScanTargetResolver;
use src::command_executors::pointer_scan_target_resolution::resolve_pointer_scan_address_space;
use src::command_executors::pointer_scan_target_resolution::resolve_pointer_size_for_process_bitness;
use squalr_engine_session::src::pointer_scan_results_store::PointerScanResultsStore;
use src::command_executors::snapshot_region_builder::SnapshotRegionBuilder;
use src::command_executors::snapshot_value_collector::SnapshotValueCollector;

// Port of command_executors/pointer_scan/start/pointer_scan_start_request_executor.rs
// — the orchestrator entry: open-process gate → resolve address space +
// pointer size → build the scan snapshot from the memory-query regions →
// collect snapshot values → resolve the target request into concrete
// target addresses → run PointerScanExecutor::execute_scan (dispatcher →
// collectors → executor → results builder) → store the results on state.
// `upstream's Sync wrapper + `track_performance_entry` folds to straight
// calls; the memory-query provider reads come from `supplied_memory_source`
// (the port's sanctioned target adapter) and `supplied_modules`.
//
// Value-target requests resolve to upstream's `Err` surface (see
// pointer_scan_target_resolution).
pub data PointerScanStartRequestExecutor {}

pub machine PointerScanStartRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    pointer_scan_start_request: &PointerScanStartRequest
) -> PointerScanStartResponse
crashes Abort
{
    // Upstream `let Some(process_info) = get_opened_process() else return default`.
    transition engine_privileged_state.has_opened_process {
        true -> opened(engine_privileged_state, pointer_scan_start_request)
        _ -> (PointerScanStartResponse::default())
    }

    state opened(
        engine_privileged_state: &mut EnginePrivilegedState,
        pointer_scan_start_request: &PointerScanStartRequest
    ) -> PointerScanStartResponse {
        let process_info: OpenedProcessInfo = EnginePrivilegedState::get_opened_process(engine_privileged_state);
        let effective_address_space: PointerScanAddressSpace = resolve_pointer_scan_address_space(
            pointer_scan_start_request.address_space,
            &pointer_scan_start_request.target);
        let effective_pointer_size: PointerScanPointerSize = resolve_pointer_size_for_process_bitness(
            pointer_scan_start_request.pointer_size,
            effective_address_space,
            &process_info);
        transition {
            _ -> regions(engine_privileged_state, pointer_scan_start_request, effective_address_space, effective_pointer_size)
        }
    }

    // Upstream `get_memory_page_bounds(process)` merged into snapshot
    // regions; an empty region list returns the default response.
    state regions(
        engine_privileged_state: &mut EnginePrivilegedState,
        pointer_scan_start_request: &PointerScanStartRequest,
        effective_address_space: PointerScanAddressSpace,
        effective_pointer_size: PointerScanPointerSize
    ) -> PointerScanStartResponse {
        let mut builder: SnapshotRegionBuilder = SnapshotRegionBuilder::new();
        SnapshotRegionBuilder::fill_from_supplied_source(
            &mut builder,
            EnginePrivilegedState::get_supplied_memory_source(engine_privileged_state));
        transition SnapshotRegionBuilder::get_region_count(&builder) == 0 {
            true -> arm_result_90_0(builder)
            false -> snapshot(engine_privileged_state, pointer_scan_start_request, effective_address_space, effective_pointer_size, builder)
            _ -> snapshot(engine_privileged_state, pointer_scan_start_request, effective_address_space, effective_pointer_size, builder)
        }
    }

    state snapshot(
        engine_privileged_state: &mut EnginePrivilegedState,
        pointer_scan_start_request: &PointerScanStartRequest,
        effective_address_space: PointerScanAddressSpace,
        effective_pointer_size: PointerScanPointerSize,
        builder: SnapshotRegionBuilder
    ) -> PointerScanStartResponse {
        let mut snapshot: Snapshot = Snapshot::new();
        SnapshotRegionBuilder::fill_snapshot(&builder, &mut snapshot);
        EnginePrivilegedState::set_snapshot(engine_privileged_state, snapshot);
        // Upstream SnapshotValueCollector::collect_values(process, snapshot,
        // memory_reader, true) — the fixture adapter collects the same
        // snapshot over the supplied source.
        SnapshotValueCollector::collect_all_regions(engine_privileged_state);
        transition {
            _ -> targets(engine_privileged_state, pointer_scan_start_request, effective_address_space, effective_pointer_size)
        }
    }

    // Upstream `resolve_targets` writing into the results' own target
    // arena (the store's); a Failed resolution leaves any stored results
    // untouched, as upstream leaves the guard entry.
    state targets(
        engine_privileged_state: &mut EnginePrivilegedState,
        pointer_scan_start_request: &PointerScanStartRequest,
        effective_address_space: PointerScanAddressSpace,
        effective_pointer_size: PointerScanPointerSize
    ) -> PointerScanStartResponse {
        let memory_alignment: MemoryAlignment = engine_privileged_state.scan_settings.memory_alignment;
        let is_single_threaded_scan: bool = engine_privileged_state.scan_settings.is_single_threaded_scan;
        let debug_perform_validation_scan: bool = engine_privileged_state.scan_settings.debug_perform_validation_scan;
        let resolution: PointerScanTargetResolution = PointerScanTargetResolver::resolve_targets(
            &pointer_scan_start_request.target,
            effective_pointer_size,
            &engine_privileged_state.snapshot,
            memory_alignment,
            is_single_threaded_scan,
            debug_perform_validation_scan,
            &mut engine_privileged_state.pointer_scan_results_store.target_addresses);
        transition resolution {
            PointerScanTargetResolution::Resolved { target_descriptor, target_address_count } -> scan(
                engine_privileged_state,
                pointer_scan_start_request,
                effective_address_space,
                effective_pointer_size,
                target_descriptor,
                target_address_count)
            _ -> (PointerScanStartResponse::default())
        }
    }

    state scan(
        engine_privileged_state: &mut EnginePrivilegedState,
        pointer_scan_start_request: &PointerScanStartRequest,
        effective_address_space: PointerScanAddressSpace,
        effective_pointer_size: PointerScanPointerSize,
        target_descriptor: PointerScanTargetDescriptor,
        target_address_count: u64
    ) -> PointerScanStartResponse {
        let pointer_scan_results_id: u64 = EnginePrivilegedState::allocate_pointer_scan_results_id(engine_privileged_state);
        let pointer_scan_parameters: PointerScanParameters = PointerScanParameters::new(
            effective_pointer_size,
            pointer_scan_start_request.offset_radius,
            pointer_scan_start_request.max_depth,
            engine_privileged_state.scan_settings.is_single_threaded_scan,
            false);
        let snapshots: [&Snapshot; 1] = [&engine_privileged_state.snapshot];
        let mut scratch: PointerScanScratch = PointerScanScratch::new();
        let empty_module_name: [u8; 1] = [0];
        let mut supplied_modules: [NormalizedModule; 8] = [
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0)
        ];
        let supplied_module_count: u64 = EnginePrivilegedState::copy_supplied_modules(engine_privileged_state, &mut supplied_modules);
        let arenas: PointerScanResultsArenas = PointerScanResultsStore::borrow_arenas_mut(&mut engine_privileged_state.pointer_scan_results_store);
        let empty_static_view: [PointerScanCandidate; 1] = [
            PointerScanCandidate::new(0, 0, PointerScanNodeType::Heap, 0, 0, 0, 0)
        ];
        let empty_heap_view: [PointerScanCandidate; 1] = [
            PointerScanCandidate::new(0, 0, PointerScanNodeType::Heap, 0, 0, 0, 0)
        ];
        let mut level_candidates: [PointerScanLevelCandidates; 8] = [
            PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0)
        ];
        let mut level_out: PointerScanCollectedLevel = PointerScanCollectedLevel::new(
            &mut scratch.collected_static_candidates,
            &mut scratch.collected_heap_candidates);
        let executor: PointerScanExecutor = PointerScanExecutor {};
        let exec_descriptor: PointerScanTargetDescriptor = PointerScanTargetDescriptor::clone(&target_descriptor);
        let mut results: PointerScanResults = PointerScanExecutor::execute_scan(&executor, 
            &snapshots,
            pointer_scan_results_id,
            &pointer_scan_parameters,
            exec_descriptor,
            arenas.target_addresses,
            target_address_count,
            effective_address_space,
            &supplied_modules[0..supplied_module_count],
            false,
            &mut scratch.sorted_scratch,
            &mut scratch.target_ranges,
            &mut scratch.lower_bounds,
            &mut scratch.upper_bounds,
            &mut scratch.target_range_buckets,
            &mut scratch.tasks_scratch,
            &mut scratch.byte_arena,
            &mut scratch.module_order_scratch,
            &mut level_out,
            &mut scratch.heap_address_scratch,
            arenas.module_names,
            arenas.levels,
            &mut scratch.level_spans_out,
            &mut level_candidates,
            arenas.static_candidate_arena,
            arenas.heap_candidate_arena,
            arenas.materialized_nodes,
            arenas.materialized_node_id_slab,
            arenas.page_key_cache);
        // Capture the view scalars + per-level arena windows before the
        // view dies with this state.
        let root_node_count: u64 = PointerScanResults::get_root_node_count(&results);
        let total_node_count: u64 = PointerScanResults::get_total_node_count(&results);
        let total_static_node_count: u64 = PointerScanResults::get_total_static_node_count(&results);
        let total_heap_node_count: u64 = PointerScanResults::get_total_heap_node_count(&results);
        let module_name_count: u64 = PointerScanResults::get_module_name_count(&results);
        let level_count: u64 = PointerScanResults::get_pointer_scan_level_count(&results);
        let materialized_node_count: u64 = PointerScanResults::get_materialized_node_count(&results);
        let materialized_node_id_slab_count: u64 = PointerScanResults::get_materialized_node_id_slab_count(&results);
        let page_key_cache_count: u64 = PointerScanResults::get_page_key_cache_count(&results);
        let next_materialized_node_id: u64 = PointerScanResults::get_next_materialized_node_id(&results);
        let materialized_nodes_overflowed: bool = PointerScanResults::get_materialized_nodes_overflowed(&results);
        let mut level_static_counts: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        let mut level_heap_counts: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        let mut level_summaries: [PointerScanLevelSummary; 8] = [
            PointerScanLevelSummary::new(0, 0, 0, 0),
            PointerScanLevelSummary::new(0, 0, 0, 0),
            PointerScanLevelSummary::new(0, 0, 0, 0),
            PointerScanLevelSummary::new(0, 0, 0, 0),
            PointerScanLevelSummary::new(0, 0, 0, 0),
            PointerScanLevelSummary::new(0, 0, 0, 0),
            PointerScanLevelSummary::new(0, 0, 0, 0),
            PointerScanLevelSummary::new(0, 0, 0, 0)
        ];
        pointer_scan_harvest_level_data(
            &results,
            &mut level_static_counts,
            &mut level_heap_counts,
            &mut level_summaries);
        transition {
            _ -> commit(
                engine_privileged_state,
                pointer_scan_results_id,
                target_descriptor,
                effective_address_space,
                effective_pointer_size,
                pointer_scan_start_request.max_depth,
                pointer_scan_start_request.offset_radius,
                root_node_count,
                total_node_count,
                total_static_node_count,
                total_heap_node_count,
                target_address_count,
                module_name_count,
                level_count,
                materialized_node_count,
                materialized_node_id_slab_count,
                page_key_cache_count,
                next_materialized_node_id,
                materialized_nodes_overflowed,
                level_static_counts,
                level_heap_counts,
                level_summaries)
        }
    }

    // Upstream `*pointer_scan_results_guard = Some(pointer_scan_results)` +
    // the stored-summary response.
    state commit(
        engine_privileged_state: &mut EnginePrivilegedState,
        session_id: u64,
        target_descriptor: PointerScanTargetDescriptor,
        address_space: PointerScanAddressSpace,
        pointer_size: PointerScanPointerSize,
        max_depth: u64,
        offset_radius: u64,
        root_node_count: u64,
        total_node_count: u64,
        total_static_node_count: u64,
        total_heap_node_count: u64,
        target_address_count: u64,
        module_name_count: u64,
        level_count: u64,
        materialized_node_count: u64,
        materialized_node_id_slab_count: u64,
        page_key_cache_count: u64,
        next_materialized_node_id: u64,
        materialized_nodes_overflowed: bool,
        level_static_counts: [u64; 8],
        level_heap_counts: [u64; 8],
        level_summaries: [PointerScanLevelSummary; 8]
    ) -> PointerScanStartResponse {
        let header_descriptor: PointerScanTargetDescriptor = PointerScanTargetDescriptor::clone(&target_descriptor);
        PointerScanResultsStore::clear(&mut engine_privileged_state.pointer_scan_results_store);
        PointerScanResultsStore::commit_header(&mut engine_privileged_state.pointer_scan_results_store, 
            session_id,
            header_descriptor,
            address_space,
            pointer_size,
            max_depth,
            offset_radius,
            root_node_count,
            total_node_count,
            total_static_node_count,
            total_heap_node_count,
            target_address_count,
            module_name_count,
            level_count,
            materialized_node_count,
            materialized_node_id_slab_count,
            page_key_cache_count,
            next_materialized_node_id,
            materialized_nodes_overflowed);
        PointerScanResultsStore::commit_level_windows(&mut engine_privileged_state.pointer_scan_results_store, 
            &level_static_counts,
            &level_heap_counts,
            level_count);
        let stored_summary: StoredPointerScanSummary = StoredPointerScanSummary::of_scalars(
            session_id,
            target_descriptor,
            address_space,
            pointer_size,
            max_depth,
            offset_radius,
            root_node_count,
            total_node_count,
            total_static_node_count,
            total_heap_node_count,
            &level_summaries, level_count);
        transition {
            _ -> (PointerScanStartResponse::of_summary(stored_summary))
        }
    }
    state arm_result_90_0(builder: SnapshotRegionBuilder) -> PointerScanStartResponse
    {
        (PointerScanStartResponse::default())
    }
}


