use {squalr_engine_api}/src/commands/pointer_scan/start/pointer_scan_start_request.omg;
use {squalr_engine_api}/src/commands/pointer_scan/start/pointer_scan_start_response.omg;
use {squalr_engine_api}/src/structures/data_values/pointer_scan_pointer_size.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_address_space.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_candidate.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_level.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_level_candidates.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_level_summary.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_node_type.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_results.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_summary.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_target_descriptor.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_api}/src/structures/scanning/plans/pointer_scan/pointer_scan_parameters.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;
use {squalr_engine_scanning}/src/pointer_scans/pointer_scan_executor_task.omg;
use {squalr_engine_scanning}/src/pointer_scans/pointer_scan_results_builder.omg;
use {squalr_engine_scanning}/src/pointer_scans/structures/pointer_scan_collected_level.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_api}/src/structures/memory/memory_alignment.omg;
use {squalr_engine_api}/src/structures/memory/normalized_module.omg;
use src/command_executors/pointer_scan_scratch.omg;
use src/command_executors/pointer_scan_target_resolution.omg;
use src/command_executors/snapshot_region_builder.omg;
use src/command_executors/snapshot_value_collector.omg;
use {squalr_engine_session}/src/pointer_scan_results_store.omg;

// Port of command_executors/pointer_scan/start/pointer_scan_start_request_executor.rs
// — the orchestrator entry: open-process gate → resolve address space +
// pointer size → build the scan snapshot from the memory-query regions →
// collect snapshot values → resolve the target request into concrete
// target addresses → run PointerScanExecutor::collect_scan_levels (dispatcher
// → collectors → level pull into the arenas) and seal the arenas with
// PointerScanResultsBuilder::seal_results → store the results on state.
// `upstream's Sync wrapper + `track_performance_entry` folds to straight
// calls; the memory-query provider reads come from `supplied_memory_source`
// (the port's sanctioned target adapter) and `supplied_modules`.
//
// Value-target requests resolve to upstream's `Err` surface (see
// pointer_scan_target_resolution).
public data PointerScanStartRequestExecutor {}

public machine PointerScanStartRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    pointer_scan_start_request: &|pointer_scan_start_request|::PointerScanStartRequest
) -> |pointer_scan_start_response|::PointerScanStartResponse
crashes Abort
{
    // Upstream `let Some(process_info) = get_opened_process() else return default`.
    transition engine_privileged_state.has_opened_process {
        true -> opened(engine_privileged_state, pointer_scan_start_request)
        _ -> (|pointer_scan_start_response|::PointerScanStartResponse::default())
    }

    machine opened(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        pointer_scan_start_request: &|pointer_scan_start_request|::PointerScanStartRequest
    ) -> |pointer_scan_start_response|::PointerScanStartResponse {
        let process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        let effective_address_space: |pointer_scan_address_space|::PointerScanAddressSpace = |pointer_scan_target_resolution|::resolve_pointer_scan_address_space(
            pointer_scan_start_request.address_space,
            &pointer_scan_start_request.target);
        let effective_pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize = |pointer_scan_target_resolution|::resolve_pointer_size_for_process_bitness(
            pointer_scan_start_request.pointer_size,
            effective_address_space,
            &process_info);
        transition {
            _ -> regions(engine_privileged_state, pointer_scan_start_request, effective_address_space, effective_pointer_size)
        }
    }

    // Upstream `get_memory_page_bounds(process)` merged into snapshot
    // regions; an empty region list returns the default response.
    machine regions(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        pointer_scan_start_request: &|pointer_scan_start_request|::PointerScanStartRequest,
        effective_address_space: |pointer_scan_address_space|::PointerScanAddressSpace,
        effective_pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize
    ) -> |pointer_scan_start_response|::PointerScanStartResponse {
        let mut builder: |snapshot_region_builder|::SnapshotRegionBuilder = |snapshot_region_builder|::SnapshotRegionBuilder::new();
        |snapshot_region_builder|::SnapshotRegionBuilder::fill_from_supplied_source(
            &mut builder,
            |engine_privileged_state|::EnginePrivilegedState::get_supplied_memory_source(&engine_privileged_state));
        let hoist1: u64 = |snapshot_region_builder|::SnapshotRegionBuilder::get_region_count(&builder);
        transition hoist1 == 0 {
            true -> arm_result_90_0(builder)
            false -> snapshot(engine_privileged_state, pointer_scan_start_request, effective_address_space, effective_pointer_size, builder)
            _ -> snapshot(engine_privileged_state, pointer_scan_start_request, effective_address_space, effective_pointer_size, builder)
        }
    }

    machine snapshot(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        pointer_scan_start_request: &|pointer_scan_start_request|::PointerScanStartRequest,
        effective_address_space: |pointer_scan_address_space|::PointerScanAddressSpace,
        effective_pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize,
        builder: |snapshot_region_builder|::SnapshotRegionBuilder
    ) -> |pointer_scan_start_response|::PointerScanStartResponse {
        let mut snapshot: |snapshot|::Snapshot = |snapshot|::Snapshot::new();
        |snapshot_region_builder|::SnapshotRegionBuilder::fill_snapshot(&builder, &mut snapshot);
        |engine_privileged_state|::EnginePrivilegedState::set_snapshot(&mut engine_privileged_state, snapshot);
        // Upstream SnapshotValueCollector::collect_values(process, snapshot,
        // memory_reader, true) — the fixture adapter collects the same
        // snapshot over the supplied source.
        |snapshot_value_collector|::SnapshotValueCollector::collect_all_regions(engine_privileged_state);
        transition {
            _ -> targets(engine_privileged_state, pointer_scan_start_request, effective_address_space, effective_pointer_size)
        }
    }

    // Upstream `resolve_targets` writing into the results' own target
    // arena (the store's); a Failed resolution leaves any stored results
    // untouched, as upstream leaves the guard entry.
    machine targets(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        pointer_scan_start_request: &|pointer_scan_start_request|::PointerScanStartRequest,
        effective_address_space: |pointer_scan_address_space|::PointerScanAddressSpace,
        effective_pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize
    ) -> |pointer_scan_start_response|::PointerScanStartResponse {
        let memory_alignment: |memory_alignment|::MemoryAlignment = engine_privileged_state.scan_settings.memory_alignment;
        let is_single_threaded_scan: bool = engine_privileged_state.scan_settings.is_single_threaded_scan;
        let debug_perform_validation_scan: bool = engine_privileged_state.scan_settings.debug_perform_validation_scan;
        let resolution: |pointer_scan_target_resolution|::PointerScanTargetResolution = |pointer_scan_target_resolution|::PointerScanTargetResolver::resolve_targets(&pointer_scan_start_request.target,
            effective_pointer_size,
            &engine_privileged_state.snapshot,
            memory_alignment,
            is_single_threaded_scan,
            debug_perform_validation_scan,
            &mut engine_privileged_state.pointer_scan_results_store.target_addresses);
        transition resolution {
            |pointer_scan_target_resolution|::PointerScanTargetResolution::Resolved { target_descriptor, target_address_count } -> scan(
                engine_privileged_state,
                pointer_scan_start_request,
                effective_address_space,
                effective_pointer_size,
                target_descriptor,
                target_address_count)
            _ -> (|pointer_scan_start_response|::PointerScanStartResponse::default())
        }
    }

    machine scan(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        pointer_scan_start_request: &|pointer_scan_start_request|::PointerScanStartRequest,
        effective_address_space: |pointer_scan_address_space|::PointerScanAddressSpace,
        effective_pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize,
        target_descriptor: |pointer_scan_target_descriptor|::PointerScanTargetDescriptor,
        target_address_count: u64
    ) -> |pointer_scan_start_response|::PointerScanStartResponse {
        let pointer_scan_results_id: u64 = |engine_privileged_state|::EnginePrivilegedState::allocate_pointer_scan_results_id(&mut engine_privileged_state);
        let pointer_scan_parameters: |pointer_scan_parameters|::PointerScanParameters = |pointer_scan_parameters|::PointerScanParameters::new(
            effective_pointer_size,
            pointer_scan_start_request.offset_radius,
            pointer_scan_start_request.max_depth,
            engine_privileged_state.scan_settings.is_single_threaded_scan,
            false);
        let mut scratch: |pointer_scan_scratch|::PointerScanScratch = |pointer_scan_scratch|::PointerScanScratch::new();
        let empty_module_name: [u8; 1] = [0];
        let mut supplied_modules: [|normalized_module|::NormalizedModule; 8] = [
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0)
        ];
        let supplied_module_count: u64 = |engine_privileged_state|::EnginePrivilegedState::copy_supplied_modules(&mut engine_privileged_state, &mut supplied_modules);
        let snapshots: [&|snapshot|::Snapshot; 1] = [&engine_privileged_state.snapshot];
        let empty_static_view: [|pointer_scan_candidate|::PointerScanCandidate; 1] = [
            |pointer_scan_candidate|::PointerScanCandidate::new(0, 0, |pointer_scan_node_type|::PointerScanNodeType::Heap, 0, 0, 0, 0)
        ];
        let empty_heap_view: [|pointer_scan_candidate|::PointerScanCandidate; 1] = [
            |pointer_scan_candidate|::PointerScanCandidate::new(0, 0, |pointer_scan_node_type|::PointerScanNodeType::Heap, 0, 0, 0, 0)
        ];
        let mut level_candidates: [|pointer_scan_level_candidates|::PointerScanLevelCandidates; 8] = [
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0)
        ];
        let level_out: |pointer_scan_collected_level|::PointerScanCollectedLevel = |pointer_scan_collected_level|::PointerScanCollectedLevel::new(
            &mut scratch.collected_static_candidates,
            &mut scratch.collected_heap_candidates);
        let executor: |pointer_scan_executor_task|::PointerScanExecutor = |pointer_scan_executor_task|::PointerScanExecutor {};
        let exec_descriptor: |pointer_scan_target_descriptor|::PointerScanTargetDescriptor = |pointer_scan_target_descriptor|::PointerScanTargetDescriptor::clone(&target_descriptor);
        let build: |pointer_scan_results_builder|::PointerScanResultsBuild = |pointer_scan_executor_task|::PointerScanExecutor::collect_scan_levels(&executor, &snapshots,
            &pointer_scan_parameters,
            &engine_privileged_state.pointer_scan_results_store.target_addresses[..],
            &supplied_modules[0..supplied_module_count],
            false,
            &mut scratch.sorted_scratch,
            &mut scratch.target_ranges,
            &mut scratch.lower_bounds,
            &mut scratch.upper_bounds,
            &mut scratch.target_range_buckets,
            &mut scratch.tasks_scratch,
            &mut scratch.byte_arena,
            &mut scratch.module_order_scratch,
            level_out,
            &mut scratch.heap_address_scratch,
            &mut engine_privileged_state.pointer_scan_results_store.module_names[..],
            &mut engine_privileged_state.pointer_scan_results_store.levels[..],
            &mut scratch.level_spans_out,
            &mut engine_privileged_state.pointer_scan_results_store.static_candidate_arena[..],
            &mut engine_privileged_state.pointer_scan_results_store.heap_candidate_arena[..]);
        let mut results: |pointer_scan_results|::PointerScanResults = |pointer_scan_results_builder|::PointerScanResultsBuilder::seal_results(build,
            pointer_scan_results_id,
            &pointer_scan_parameters,
            exec_descriptor,
            &mut engine_privileged_state.pointer_scan_results_store.target_addresses[..],
            target_address_count,
            effective_address_space,
            &mut engine_privileged_state.pointer_scan_results_store.module_names[..],
            &mut engine_privileged_state.pointer_scan_results_store.levels[..],
            &scratch.level_spans_out,
            &mut level_candidates,
            &engine_privileged_state.pointer_scan_results_store.static_candidate_arena[..],
            &engine_privileged_state.pointer_scan_results_store.heap_candidate_arena[..],
            &mut engine_privileged_state.pointer_scan_results_store.materialized_nodes[..],
            &mut engine_privileged_state.pointer_scan_results_store.materialized_node_id_slab[..],
            &mut engine_privileged_state.pointer_scan_results_store.page_key_cache[..]);
        // Capture the view scalars + per-level arena windows before the
        // view dies with this state.
        let root_node_count: u64 = |pointer_scan_results|::PointerScanResults::get_root_node_count(&results);
        let total_node_count: u64 = |pointer_scan_results|::PointerScanResults::get_total_node_count(&results);
        let total_static_node_count: u64 = |pointer_scan_results|::PointerScanResults::get_total_static_node_count(&results);
        let total_heap_node_count: u64 = |pointer_scan_results|::PointerScanResults::get_total_heap_node_count(&results);
        let module_name_count: u64 = |pointer_scan_results|::PointerScanResults::get_module_name_count(&results);
        let level_count: u64 = |pointer_scan_results|::PointerScanResults::get_pointer_scan_level_count(&results);
        let materialized_node_count: u64 = |pointer_scan_results|::PointerScanResults::get_materialized_node_count(&results);
        let materialized_node_id_slab_count: u64 = |pointer_scan_results|::PointerScanResults::get_materialized_node_id_slab_count(&results);
        let page_key_cache_count: u64 = |pointer_scan_results|::PointerScanResults::get_page_key_cache_count(&results);
        let next_materialized_node_id: u64 = |pointer_scan_results|::PointerScanResults::get_next_materialized_node_id(&results);
        let materialized_nodes_overflowed: bool = |pointer_scan_results|::PointerScanResults::get_materialized_nodes_overflowed(&results);
        let mut level_static_counts: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        let mut level_heap_counts: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        let mut level_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8] = [
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0)
        ];
        pointer_scan_harvest_level_data(
            &results,
            &mut level_static_counts,
            &mut level_heap_counts,
            &mut level_summaries);
        transition {
            _ -> commit(
                engine_privileged_state,
                pointer_scan_results_id,
                target_descriptor,
                effective_address_space,
                effective_pointer_size,
                pointer_scan_start_request.max_depth,
                pointer_scan_start_request.offset_radius,
                root_node_count,
                total_node_count,
                total_static_node_count,
                total_heap_node_count,
                target_address_count,
                module_name_count,
                level_count,
                materialized_node_count,
                materialized_node_id_slab_count,
                page_key_cache_count,
                next_materialized_node_id,
                materialized_nodes_overflowed,
                level_static_counts,
                level_heap_counts,
                level_summaries)
        }
    }

    // Upstream `*pointer_scan_results_guard = Some(pointer_scan_results)` +
    // the stored-summary response.
    machine commit(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        session_id: u64,
        target_descriptor: |pointer_scan_target_descriptor|::PointerScanTargetDescriptor,
        address_space: |pointer_scan_address_space|::PointerScanAddressSpace,
        pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize,
        max_depth: u64,
        offset_radius: u64,
        root_node_count: u64,
        total_node_count: u64,
        total_static_node_count: u64,
        total_heap_node_count: u64,
        target_address_count: u64,
        module_name_count: u64,
        level_count: u64,
        materialized_node_count: u64,
        materialized_node_id_slab_count: u64,
        page_key_cache_count: u64,
        next_materialized_node_id: u64,
        materialized_nodes_overflowed: bool,
        level_static_counts: [u64; 8],
        level_heap_counts: [u64; 8],
        level_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8]
    ) -> |pointer_scan_start_response|::PointerScanStartResponse {
        let header_descriptor: |pointer_scan_target_descriptor|::PointerScanTargetDescriptor = |pointer_scan_target_descriptor|::PointerScanTargetDescriptor::clone(&target_descriptor);
        |pointer_scan_results_store|::PointerScanResultsStore::clear(&mut engine_privileged_state.pointer_scan_results_store);
        |pointer_scan_results_store|::PointerScanResultsStore::commit_header(&mut engine_privileged_state.pointer_scan_results_store, session_id,
            header_descriptor,
            address_space,
            pointer_size,
            max_depth,
            offset_radius,
            root_node_count,
            total_node_count,
            total_static_node_count,
            total_heap_node_count,
            target_address_count,
            module_name_count,
            level_count,
            materialized_node_count,
            materialized_node_id_slab_count,
            page_key_cache_count,
            next_materialized_node_id,
            materialized_nodes_overflowed);
        |pointer_scan_results_store|::PointerScanResultsStore::commit_level_windows(&mut engine_privileged_state.pointer_scan_results_store, &level_static_counts,
            &level_heap_counts,
            level_count);
        let stored_summary: |pointer_scan_summary|::StoredPointerScanSummary = |pointer_scan_summary|::StoredPointerScanSummary::of_scalars(
            session_id,
            target_descriptor,
            address_space,
            pointer_size,
            max_depth,
            offset_radius,
            root_node_count,
            total_node_count,
            total_static_node_count,
            total_heap_node_count,
            &level_summaries, level_count);
        transition {
            _ -> (|pointer_scan_start_response|::PointerScanStartResponse::of_summary(stored_summary))
        }
    }
    machine arm_result_90_0(builder: |snapshot_region_builder|::SnapshotRegionBuilder) -> |pointer_scan_start_response|::PointerScanStartResponse
    {
        (|pointer_scan_start_response|::PointerScanStartResponse::default())
    }
}

// Captures the per-level node counts (for the store's arena windows) and
// summaries (for the stored summary) off the returned view — upstream's
// `summarize` reads the same fields; the port emits the data while the
// borrowed view is still live.
machine pointer_scan_harvest_level_data<'ext, 'sh, 's, 'h>(
    pointer_scan_results: &|pointer_scan_results|::PointerScanResults<'ext, 'sh, 's, 'h>,
    level_static_counts: &mut [u64; 8],
    level_heap_counts: &mut [u64; 8],
    level_summaries: &mut [|pointer_scan_level_summary|::PointerScanLevelSummary; 8]
) {
    transition { _ -> walk(pointer_scan_results, level_static_counts, level_heap_counts, level_summaries, 0) }

    machine walk(
        pointer_scan_results: &|pointer_scan_results|::PointerScanResults<'ext, 'sh, 's, 'h>,
        level_static_counts: &mut [u64; 8],
        level_heap_counts: &mut [u64; 8],
        level_summaries: &mut [|pointer_scan_level_summary|::PointerScanLevelSummary; 8],
        level_index: u64
    ) {
        let hoist2: u64 = |pointer_scan_results|::PointerScanResults::get_pointer_scan_level_count(pointer_scan_results);
        transition level_index < hoist2
            && level_index < 8 {
            true -> harvest(pointer_scan_results, level_static_counts, level_heap_counts, level_summaries, level_index)
            false -> done()
            _ -> done()
        }
    }
    machine harvest(
        pointer_scan_results: &|pointer_scan_results|::PointerScanResults<'ext, 'sh, 's, 'h>,
        level_static_counts: &mut [u64; 8],
        level_heap_counts: &mut [u64; 8],
        level_summaries: &mut [|pointer_scan_level_summary|::PointerScanLevelSummary; 8],
        level_index: u64
    )
    requires 0 <= level_index && level_index < 8;
    {
        let level: |pointer_scan_level|::PointerScanLevel = |pointer_scan_results|::PointerScanResults::get_pointer_scan_level_copy(pointer_scan_results, level_index);
        level_static_counts[level_index] = |pointer_scan_level|::PointerScanLevel::get_static_node_count(level);
        level_heap_counts[level_index] = |pointer_scan_level|::PointerScanLevel::get_heap_node_count(level);
        let depth: u64 = |pointer_scan_level|::PointerScanLevel::get_depth(level);
        let node_count: u64 = |pointer_scan_level|::PointerScanLevel::get_node_count(level);
        let static_node_count: u64 = |pointer_scan_level|::PointerScanLevel::get_static_node_count(level);
        let heap_node_count: u64 = |pointer_scan_level|::PointerScanLevel::get_heap_node_count(level);
        level_summaries[level_index] = |pointer_scan_level_summary|::PointerScanLevelSummary::new(
            depth,
            node_count,
            static_node_count,
            heap_node_count);
        transition {
            _ -> walk(pointer_scan_results, level_static_counts, level_heap_counts, level_summaries, level_index + 1)
        }
    }
    machine done() {
    }
}
