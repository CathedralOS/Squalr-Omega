use {squalr_engine_api}/src/commands/scan/reset/scan_reset_request.omg;
use {squalr_engine_api}/src/commands/scan/reset/scan_reset_response.omg;
use {squalr_engine_api}/src/events/engine_event.omg;
use {squalr_engine_api}/src/events/scan_results/updated/scan_results_updated_event.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;

// Port of commands/scan/reset/scan_reset_request_executor.rs — upstream
// clears the freeze-list registry and the snapshot regions, then emits
// `ScanResultsUpdatedEvent { is_new_scan: false }` ("Cleared scan data.").
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ScanResetRequestExecutor {}

public machine ScanResetRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    scan_reset_request: &|scan_reset_request|::ScanResetRequest
) -> |scan_reset_response|::ScanResetResponse {
    |engine_privileged_state|::EnginePrivilegedState::clear_freeze_list(&mut engine_privileged_state);
    let snapshot: &mut |snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot_mut(&mut engine_privileged_state);
    |snapshot|::Snapshot::clear(snapshot);
    let updated: |scan_results_updated_event|::ScanResultsUpdatedEvent = |scan_results_updated_event|::ScanResultsUpdatedEvent::new(false);
    let event: |engine_event|::EngineEvent = |scan_results_updated_event|::ScanResultsUpdatedEvent::to_engine_event(&updated);
    _ = |engine_privileged_state|::EnginePrivilegedState::emit_event(&mut engine_privileged_state, &event);
    |scan_reset_response|::ScanResetResponse { success: true }
}
