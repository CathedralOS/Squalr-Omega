module src::command_executors::scan_reset_request_executor;

use squalr_engine_api::src::commands::scan::reset::scan_reset_request::ScanResetRequest;
use squalr_engine_api::src::commands::scan::reset::scan_reset_response::ScanResetResponse;
use squalr_engine_api::src::events::engine_event::EngineEvent;
use squalr_engine_api::src::events::scan_results::updated::scan_results_updated_event::ScanResultsUpdatedEvent;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;

// Port of commands/scan/reset/scan_reset_request_executor.rs — upstream
// clears the freeze-list registry and the snapshot regions, then emits
// `ScanResultsUpdatedEvent { is_new_scan: false }` ("Cleared scan data.").
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ScanResetRequestExecutor {}

pub machine ScanResetRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    scan_reset_request: &ScanResetRequest
) -> ScanResetResponse {
    EnginePrivilegedState::clear_freeze_list(&mut engine_privileged_state);
    let snapshot: &mut Snapshot = EnginePrivilegedState::borrow_snapshot_mut(&mut engine_privileged_state);
    clear(snapshot);
    let updated: ScanResultsUpdatedEvent = ScanResultsUpdatedEvent::new(false);
    let event: EngineEvent = ScanResultsUpdatedEvent::to_engine_event(&updated);
    _ = EnginePrivilegedState::emit_event(&mut engine_privileged_state, &event);
    ScanResetResponse { success: true }
}
