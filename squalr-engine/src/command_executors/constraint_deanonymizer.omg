module src::command_executors::constraint_deanonymizer;

use squalr_engine_api::src::commands::scan::element_scan::element_scan_request::ScanConstraintSet;
use squalr_engine_api::src::registries::scan_rules::element_scan_rule_registry::ElementScanRuleRegistry;
use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use squalr_engine_api::src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use squalr_engine_api::src::structures::data_values::container_type::ContainerType;
use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use squalr_engine_api::src::structures::scanning::comparisons::scan_compare_type::element_width_mask_u64;
use squalr_engine_api::src::structures::scanning::comparisons::scan_function_scalar::ScanFunctionScalar;
use squalr_engine_api::src::structures::scanning::constraints::anonymous_scan_constraint::AnonymousScanConstraint;
use squalr_engine_api::src::structures::scanning::constraints::scan_constraint::ScanConstraint;
use squalr_engine_api::src::structures::scanning::constraints::scan_constraint_builder::PatternScanConstraint;
use squalr_engine_api::src::structures::scanning::constraints::scan_constraint_builder::ScanConstraintBuild;
use squalr_engine_api::src::structures::scanning::constraints::scan_constraint_builder::ScanConstraintBuilder;
use squalr_engine_api::src::structures::scanning::constraints::scan_constraint_finalized::ScanConstraintFinalized;
use squalr_engine_api::src::structures::scanning::plans::element_scan::element_scan_plan::TypePlanList;
use squalr_engine_api::src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use squalr_engine_api::src::structures::scanning::plans::plan_types::planned_scan_type::PlannedScanType;
use squalr_engine_api::src::structures::scanning::plans::plan_types::planned_scan_type_byte_array::PlannedScanTypeByteArray;
use squalr_engine_api::src::structures::scanning::plans::plan_types::planned_scan_type_scalar::PlannedScanTypeScalar;

// Port of the executor's deanonymize step: `ScanConstraintBuilder::build`
// per (anonymous constraint, data type) — upstream calls the builder inside
// `filter_map`, so `Refused`/`Empty` arms drop the constraint the way
// Err/None results drop there. `Built` is the scalar u64 carrier;
// `BuiltPattern` is upstream's byte-vector constraint (hex patterns,
// wildcard arrays, multi-element scalars) and lands on the plan's pattern
// carriers — patterns up to 8 bytes additionally pack into `operand_value`
// for the u64 fast path the byte-array scanners read.
//
// Upstream then folds `get_scan_parameters_rule_registry()` over the built
// constraints before `ScanConstraintFinalized::new` — RuleMapToPrimitiveType
// (array-of-bytes at primitive width -> u8/u16be/u32be/u64be) and
// RuleMapUnsignedGreaterThanZeroToNotEqual (unsigned non-float `> 0` on a
// zero operand -> `!= 0`). The registry applies each rule to each element
// independently, so per-constraint application inside this build loop is
// the same rewrite, applied in upstream's `built_in_rules` declaration
// order. `rule_scalar`/`rule_pattern` are that fold; a retyped
// `BuiltPattern` scalarizes onto the scalar plan path the way upstream's
// finalized treats the retyped constraint.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ConstraintDeanonymizer {}

pub machine ConstraintDeanonymizer::build_type_plan_list<'a>(
    scan_constraints: &ScanConstraintSet,
    data_type_ref: &DataTypeRef,
    memory_alignment: MemoryAlignment
) -> TypePlanList {
    // Upstream builds one `ScanConstraintBuilder` per executor call (holding
    // symbol registry + floating point tolerance); the port's builder keeps
    // the tolerance only — type facts ride on DataTypeRef.
    let floating_point_tolerance: FloatingPointTolerance =
        FloatingPointTolerance::default();
    let builder: ScanConstraintBuilder =
        ScanConstraintBuilder::new(floating_point_tolerance);
    let mut plan_list: TypePlanList = TypePlanList::empty();
    transition { _ -> each(&mut plan_list, &builder, scan_constraints, data_type_ref, memory_alignment, 0) }

    state each(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64
    ) {
        transition position < ScanConstraintSet::get_count(scan_constraints) {
            true -> build(plan_list, builder, scan_constraints, data_type_ref, memory_alignment, position)
            false -> done(plan_list)
        }
    }

    // Upstream's `match scan_constraint_builder.build(anonymous_scan_constraint,
    // data_type_ref) { Ok(c) => c, Err(_) => None }` inside filter_map.
    state build(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64
    ) {
        let constraint: AnonymousScanConstraint = ScanConstraintSet::get(scan_constraints, position);
        let built: ScanConstraintBuild<'a> =
            ScanConstraintBuilder::build(builder, &constraint, data_type_ref);
        transition built {
            ScanConstraintBuild::Built { value } -> rule_scalar(
                plan_list, builder, scan_constraints, value,
                data_type_ref, memory_alignment, position)
            ScanConstraintBuild::BuiltPattern { value } -> rule_pattern(
                plan_list, builder, scan_constraints, value,
                data_type_ref, memory_alignment, position)
            _ -> next(plan_list, builder, scan_constraints, data_type_ref, memory_alignment, position)
        }
    }

    // Upstream's parameter-rule fold between `build` and finalize — the
    // registry applies RuleMapToPrimitiveType then
    // RuleMapUnsignedGreaterThanZeroToNotEqual (built_in_rules declaration
    // order) to the built scalar constraint.
    state rule_scalar(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        built: ScanConstraint<'a>,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64
    ) {
        let mut rewritten: ScanConstraint<'a> = built;
        ElementScanRuleRegistry::apply_parameter_rule_scalar(
            &mut rewritten, "u8", "u16be", "u32be", "u64be");
        transition { _ -> plan_scalar(
            plan_list, builder, scan_constraints, rewritten,
            data_type_ref, memory_alignment, position) }
    }

    // The same fold on the pattern carrier — the primitive retype reports
    // whether it fired: a {1,2,4,8}-byte pattern that remapped to a
    // primitive goes down the scalar plan path like upstream's finalized
    // sees the retyped constraint; anything else keeps the byte-array plan.
    state rule_pattern(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        pattern: PatternScanConstraint,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64
    ) {
        let mut rewritten: PatternScanConstraint = pattern;
        let scalarize: bool = ElementScanRuleRegistry::apply_parameter_rule_pattern(
            &mut rewritten, "u8", "u16be", "u32be", "u64be");
        transition scalarize {
            true -> pattern_scalarize(
                plan_list, builder, scan_constraints, rewritten,
                data_type_ref, memory_alignment, position)
            false -> plan_pattern(
                plan_list, builder, scan_constraints, rewritten,
                data_type_ref, memory_alignment, position)
            _ -> plan_pattern(
                plan_list, builder, scan_constraints, rewritten,
                data_type_ref, memory_alignment, position)
        }
    }

    // A retyped pattern becomes a scalar-carrier constraint: upstream's
    // `ScanConstraintFinalized` sees the new primitive ref, the same byte
    // operand, and the same mask. `operand_value`/`mask_value` pack the
    // pattern's own spans — identical bytes, so the scalar plan compares
    // the same span upstream's retyped scalar does.
    state pattern_scalarize(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        pattern: PatternScanConstraint,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64
    ) {
        let pattern_bytes: &[u8] = PatternScanConstraint::get_pattern_bytes(&pattern);
        let pattern_len: u64 = PatternScanConstraint::get_pattern_len(&pattern);
        // The scalarized operand is a numeric word — a big-endian retype
        // keeps its stored MSB-first bytes, so the pack folds MSB-first to
        // land the same numeric the element slot carries.
        let pattern_ref: DataTypeRef = PatternScanConstraint::get_data_type_ref(&pattern);
        let big_endian: bool = DataTypeRef::is_big_endian(&pattern_ref);
        let operand_value: u64 =
            pack_for_endianness_u64(pattern_bytes, pattern_len, big_endian);
        transition PatternScanConstraint::has_mask(&pattern) {
            true -> scalarize_mask(
                plan_list, builder, scan_constraints, pattern,
                data_type_ref, memory_alignment, position, operand_value,
                big_endian)
            false -> scalarize_emit(
                plan_list, builder, scan_constraints, pattern,
                data_type_ref, memory_alignment, position, operand_value, 0)
            _ -> scalarize_emit(
                plan_list, builder, scan_constraints, pattern,
                data_type_ref, memory_alignment, position, operand_value, 0)
        }
    }

    state scalarize_mask(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        pattern: PatternScanConstraint,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64,
        operand_value: u64,
        big_endian: bool
    ) {
        let mask_bytes: &[u8] = PatternScanConstraint::get_mask_bytes(&pattern);
        let mask_len: u64 = PatternScanConstraint::get_mask_len(&pattern);
        // The mask is a type-width integer under the same endianness —
        // upstream's masked scalar compare applies it to the typed value.
        let mask_value: u64 =
            pack_for_endianness_u64(mask_bytes, mask_len, big_endian);
        transition { _ -> scalarize_emit(
            plan_list, builder, scan_constraints, pattern,
            data_type_ref, memory_alignment, position, operand_value, mask_value) }
    }

    // The emit reads the pattern's own ref — the new primitive after the
    // retype — so unit size, signedness, float, preference and container
    // all follow the remap exactly as upstream's registry reads do.
    state scalarize_emit(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        pattern: PatternScanConstraint,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64,
        operand_value: u64,
        mask_value: u64
    ) {
        let new_ref: DataTypeRef = PatternScanConstraint::get_data_type_ref(&pattern);
        let pattern_len: u64 = PatternScanConstraint::get_pattern_len(&pattern);
        let scan_compare_type: ScanCompareType = PatternScanConstraint::get_scan_compare_type(&pattern);
        let has_mask: bool = PatternScanConstraint::has_mask(&pattern);
        let signed: bool = DataTypeRef::is_signed(&new_ref);
        let floating: bool = DataTypeRef::is_floating_point(&new_ref);
        let prefer: bool = DataTypeRef::prefers_type_scanner(&new_ref);
        let container: ContainerType = DataTypeRef::get_result_container_type(&new_ref);
        transition has_mask {
            true -> scalarize_masked(
                plan_list, builder, scan_constraints, pattern,
                data_type_ref, memory_alignment, position,
                new_ref, pattern_len, scan_compare_type, operand_value,
                mask_value, signed, floating, prefer, container)
            false -> scalarize_plain(
                plan_list, builder, scan_constraints, pattern,
                data_type_ref, memory_alignment, position,
                new_ref, pattern_len, scan_compare_type, operand_value,
                signed, floating, prefer, container)
            _ -> scalarize_plain(
                plan_list, builder, scan_constraints, pattern,
                data_type_ref, memory_alignment, position,
                new_ref, pattern_len, scan_compare_type, operand_value,
                signed, floating, prefer, container)
        }
    }

    state scalarize_masked(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        pattern: PatternScanConstraint,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64,
        new_ref: DataTypeRef,
        pattern_len: u64,
        scan_compare_type: ScanCompareType,
        operand_value: u64,
        mask_value: u64,
        signed: bool,
        floating: bool,
        prefer: bool,
        container: ContainerType
    ) {
        let floating_point_tolerance: FloatingPointTolerance =
            ScanConstraintBuilder::get_floating_point_tolerance(builder);
        let mut scalar: ScanConstraint<'a> = ScanConstraint::new_masked(
            new_ref, scan_compare_type, operand_value, pattern_len,
            mask_value, signed, floating, prefer, floating_point_tolerance);
        ScanConstraint::set_result_container_type(&mut scalar, container);
        transition { _ -> plan_scalar(
            plan_list, builder, scan_constraints, scalar,
            data_type_ref, memory_alignment, position) }
    }

    state scalarize_plain(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        pattern: PatternScanConstraint,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64,
        new_ref: DataTypeRef,
        pattern_len: u64,
        scan_compare_type: ScanCompareType,
        operand_value: u64,
        signed: bool,
        floating: bool,
        prefer: bool,
        container: ContainerType
    ) {
        let floating_point_tolerance: FloatingPointTolerance =
            ScanConstraintBuilder::get_floating_point_tolerance(builder);
        let mut scalar: ScanConstraint<'a> = ScanConstraint::new(
            new_ref, scan_compare_type, operand_value, pattern_len,
            signed, floating, prefer, floating_point_tolerance);
        ScanConstraint::set_result_container_type(&mut scalar, container);
        transition { _ -> plan_scalar(
            plan_list, builder, scan_constraints, scalar,
            data_type_ref, memory_alignment, position) }
    }

    // The scalar plan: `operand_value`/`mask_value` are the built
    // constraint's u64-packed words; `result_container_type` reads off the
    // built constraint (the anonymous string's container — Array/ArrayFixed
    // when the value text declared a collection). Element metrics read off
    // the constraint's own ref — after a parameter-rule retype that is the
    // primitive type, exactly what upstream's finalized reads.
    state plan_scalar(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        built: ScanConstraint<'a>,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64
    ) {
        let built_ref: DataTypeRef = ScanConstraint::get_data_type_ref(&built);
        let unit_size_in_bytes: u64 = DataTypeRef::get_unit_size_in_bytes(&built_ref);
        let scan_compare_type: ScanCompareType = ScanConstraint::get_scan_compare_type(&built);
        let operand_value: u64 = ScanConstraint::get_operand_value(&built);
        let periodicity: u64 = ScanConstraintFinalized::calculate_periodicity(
            scan_compare_type,
            operand_value,
            unit_size_in_bytes,
            unit_size_in_bytes);
        let scalar_function: ScanFunctionScalar =
            ScanConstraintFinalized::build_scan_function_scalar(scan_compare_type);
        // Upstream's `Option<ScanFunctionScalar>` absence: the delta
        // divide/modulo-by-zero construction refusal. `has_scan_function`
        // mirrors `Option::is_some` — the plan exists but every element is
        // a miss, matching upstream's skipped constraint.
        let delta_needs_divisor: bool =
            ScanCompareType::requires_nonzero_delta(&scan_compare_type);
        let operand_width_mask: u64 =
            element_width_mask_u64(unit_size_in_bytes);
        let delta_operand_masked: u64 = ((operand_value as u64 in Wrapping)
            & (operand_width_mask as u64 in Wrapping)) as u64;
        let built_is_floating_point: bool = ScanConstraint::is_floating_point(&built);
        // Upstream's scalar-function Option also goes absent two other ways:
        // the integer-only divisor refusal applies to integer types only
        // (float divide/modulo compares exist — a zero float divisor yields
        // inf/NaN targets that simply miss), and the float impls return
        // `None` for the shift/logical delta kinds.
        let zero_delta: bool =
            delta_needs_divisor && !built_is_floating_point &&
            delta_operand_masked == 0;
        let float_bit_op_delta: bool =
            built_is_floating_point && ScanCompareType::requires_integer_delta(&scan_compare_type);
        let has_scalar_function: bool = !(zero_delta || float_bit_op_delta);
        let mut plan: SnapshotFilterElementScanPlan = SnapshotFilterElementScanPlan::new(
            scan_compare_type,
            operand_value,
            unit_size_in_bytes,
            has_scalar_function,
            scalar_function,
            memory_alignment);
        let built_is_signed: bool = ScanConstraint::is_signed(&built);
        let built_prefers_type_scanner: bool = ScanConstraint::prefers_type_scanner(&built);
        let built_floating_point_tolerance: FloatingPointTolerance =
            ScanConstraint::get_floating_point_tolerance(&built);
        let built_has_mask: bool = ScanConstraint::has_mask(&built);
        let built_mask_value: u64 = ScanConstraint::get_mask_value(&built);
        let built_result_container_type: ContainerType = ScanConstraint::get_result_container_type(&built);
        SnapshotFilterElementScanPlan::set_scan_profile(&mut plan, 
            periodicity,
            built_is_floating_point,
            built_is_signed,
            built_prefers_type_scanner,
            built_floating_point_tolerance,
            built_has_mask,
            built_mask_value,
            built_result_container_type);
        let operand_size_in_bytes: u64 = ScanConstraint::get_operand_size_in_bytes(&built);
        let built_big_endian: bool = DataTypeRef::is_big_endian(&built_ref);
        transition operand_size_in_bytes == unit_size_in_bytes {
            true -> scalar_emit(
                plan_list, builder, scan_constraints, plan,
                data_type_ref, memory_alignment, position)
            false -> scalar_span(
                plan_list, builder, scan_constraints, plan, operand_value,
                operand_size_in_bytes, data_type_ref, memory_alignment,
                position, built_big_endian)
            _ -> scalar_span(
                plan_list, builder, scan_constraints, plan, operand_value,
                operand_size_in_bytes, data_type_ref, memory_alignment,
                position, built_big_endian)
        }
    }

    // Multi-element array operands (`u8[3]`, `u16be[2]` — operand width !=
    // element unit): the operand bytes ARE the scan span upstream's byte
    // array gets from `get_value_bytes()`, so the plan's pattern carriers
    // carry the unpacked span and the byte-array drain reads the true
    // length instead of the unit width. The `<= 8` guard restates the
    // scalar carrier's construction bound (`scalar_pack` packs at most a
    // u64) so the span slice discharges honestly.
    state scalar_span(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        plan: SnapshotFilterElementScanPlan,
        operand_value: u64,
        operand_size_in_bytes: u64,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64,
        big_endian: bool
    ) {
        let mut spanned: SnapshotFilterElementScanPlan = plan;
        transition operand_size_in_bytes <= 8 {
            true -> span_write(
                plan_list, builder, scan_constraints, spanned,
                operand_value, operand_size_in_bytes,
                data_type_ref, memory_alignment, position, big_endian)
            false -> scalar_emit(
                plan_list, builder, scan_constraints, spanned,
                data_type_ref, memory_alignment, position)
            _ -> scalar_emit(
                plan_list, builder, scan_constraints, spanned,
                data_type_ref, memory_alignment, position)
        }
    }

    state span_write(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        plan: SnapshotFilterElementScanPlan,
        operand_value: u64,
        operand_size_in_bytes: u64,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64,
        big_endian: bool
    ) {
        let mut written: SnapshotFilterElementScanPlan = plan;
        let mut span: [u8; 8];
        // The span must reproduce the stored operand bytes byte-for-byte —
        // the pack direction was the type's endianness, so the unpack
        // follows it (BE-packed words recover their MSB-first bytes).
        unpack_for_endianness_u64(operand_value, operand_size_in_bytes,
            big_endian, &mut span);
        let wrote: bool =
            SnapshotFilterElementScanPlan::set_pattern_bytes(&mut written, &span[0..operand_size_in_bytes]);
        transition { _ -> scalar_emit(
            plan_list, builder, scan_constraints, written,
            data_type_ref, memory_alignment, position) }
    }

    // The scalar leg's plan-type rule: a present current window makes
    // the filter scannable scalar-iteratively (upstream's byte-array and
    // vector specializations land with their own legs; scalar covers the
    // same filter set, only less specialized). The dispatch-time filter
    // rule re-picks the planned type against each live filter.
    state scalar_emit(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        plan: SnapshotFilterElementScanPlan,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64
    ) {
        let mut stored: SnapshotFilterElementScanPlan = plan;
        SnapshotFilterElementScanPlan::set_planned_scan_type(&mut stored, PlannedScanType::Scalar {
            scan_type: PlannedScanTypeScalar::ScalarIterative });
        let pushed: bool = TypePlanList::push(plan_list, &stored);
        transition { _ -> next(plan_list, builder, scan_constraints, data_type_ref, memory_alignment, position) }
    }

    // The pattern plan: byte-pattern constraints (upstream's
    // `ScanConstraint{data_value: Vec<u8>, mask}`) ride the plan's bounded
    // pattern carriers; the u64 operand words pack the pattern when it fits
    // so the existing byte-array scanners read them unchanged. Masked
    // patterns pick upstream's masked Boyer-Moore plan type.
    state plan_pattern(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        pattern: PatternScanConstraint,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64
    ) {
        let unit_size_in_bytes: u64 = DataTypeRef::get_unit_size_in_bytes(data_type_ref);
        let scan_compare_type: ScanCompareType = PatternScanConstraint::get_scan_compare_type(&pattern);
        let pattern_len: u64 = PatternScanConstraint::get_pattern_len(&pattern);
        transition pattern_len <= 8 {
            true -> pattern_operand(
                plan_list, builder, scan_constraints, pattern,
                data_type_ref, memory_alignment, position,
                scan_compare_type, unit_size_in_bytes)
            false -> pattern_fill(
                plan_list, builder, scan_constraints, pattern,
                data_type_ref, memory_alignment, position,
                scan_compare_type, unit_size_in_bytes, 0, 0)
            _ -> pattern_fill(
                plan_list, builder, scan_constraints, pattern,
                data_type_ref, memory_alignment, position,
                scan_compare_type, unit_size_in_bytes, 0, 0)
        }
    }

    // Packs pattern bytes (and mask bytes when present) into the u64
    // operand words — the <=8-byte path.
    state pattern_operand(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        pattern: PatternScanConstraint,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64,
        scan_compare_type: ScanCompareType,
        unit_size_in_bytes: u64
    ) {
        let pattern_bytes: &[u8] = PatternScanConstraint::get_pattern_bytes(&pattern);
        let pattern_len: u64 = PatternScanConstraint::get_pattern_len(&pattern);
        let operand_value: u64 =
            pack_bytes_le_u64(pattern_bytes, pattern_len);
        transition PatternScanConstraint::has_mask(&pattern) {
            true -> pattern_mask_pack(
                plan_list, builder, scan_constraints, pattern,
                data_type_ref, memory_alignment, position,
                scan_compare_type, unit_size_in_bytes, operand_value)
            false -> pattern_fill(
                plan_list, builder, scan_constraints, pattern,
                data_type_ref, memory_alignment, position,
                scan_compare_type, unit_size_in_bytes, operand_value, 0)
            _ -> pattern_fill(
                plan_list, builder, scan_constraints, pattern,
                data_type_ref, memory_alignment, position,
                scan_compare_type, unit_size_in_bytes, operand_value, 0)
        }
    }

    state pattern_mask_pack(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        pattern: PatternScanConstraint,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64,
        scan_compare_type: ScanCompareType,
        unit_size_in_bytes: u64,
        operand_value: u64
    ) {
        let mask_bytes: &[u8] = PatternScanConstraint::get_mask_bytes(&pattern);
        let mask_len: u64 = PatternScanConstraint::get_mask_len(&pattern);
        let mask_value: u64 =
            pack_bytes_le_u64(mask_bytes, mask_len);
        transition { _ -> pattern_fill(
            plan_list, builder, scan_constraints, pattern,
            data_type_ref, memory_alignment, position,
            scan_compare_type, unit_size_in_bytes, operand_value, mask_value) }
    }

    state pattern_fill(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        pattern: PatternScanConstraint,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64,
        scan_compare_type: ScanCompareType,
        unit_size_in_bytes: u64,
        operand_value: u64,
        mask_value: u64
    ) {
        let mut plan: SnapshotFilterElementScanPlan = SnapshotFilterElementScanPlan::new(
            scan_compare_type,
            operand_value,
            unit_size_in_bytes,
            true,
            ScanFunctionScalar::Immediate,
            memory_alignment);
        // Byte-array scans carry no scalar compare function — the flag marks
        // the pattern carrier so scanners read the byte span instead.
        let pattern_periodicity: u64 = ScanConstraintFinalized::calculate_periodicity(
            scan_compare_type, operand_value, unit_size_in_bytes, unit_size_in_bytes);
        let is_floating_point: bool = DataTypeRef::is_floating_point(data_type_ref);
        let is_signed: bool = DataTypeRef::is_signed(data_type_ref);
        let prefers_type_scanner: bool = DataTypeRef::prefers_type_scanner(data_type_ref);
        let pattern_has_mask: bool = PatternScanConstraint::has_mask(&pattern);
        let pattern_result_container_type: ContainerType = PatternScanConstraint::get_result_container_type(&pattern);
        let pattern_floating_point_tolerance: FloatingPointTolerance =
            ScanConstraintBuilder::get_floating_point_tolerance(builder);
        SnapshotFilterElementScanPlan::set_scan_profile(&mut plan, 
            pattern_periodicity,
            is_floating_point,
            is_signed,
            prefers_type_scanner,
            pattern_floating_point_tolerance,
            pattern_has_mask,
            mask_value,
            pattern_result_container_type);
        let pattern_bytes: &[u8] = PatternScanConstraint::get_pattern_bytes(&pattern);
        let mask_bytes: &[u8] = PatternScanConstraint::get_mask_bytes(&pattern);
        let wrote_pattern: bool =
            SnapshotFilterElementScanPlan::set_pattern_bytes(&mut plan, pattern_bytes);
        let wrote_mask: bool =
            SnapshotFilterElementScanPlan::set_pattern_mask_bytes(&mut plan, mask_bytes);
        transition wrote_pattern && wrote_mask {
            true -> pattern_store(
                plan_list, builder, plan, pattern, scan_constraints,
                data_type_ref, memory_alignment, position)
            false -> next(plan_list, builder, scan_constraints, data_type_ref, memory_alignment, position)
            _ -> next(plan_list, builder, scan_constraints, data_type_ref, memory_alignment, position)
        }
    }

    state pattern_store(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        plan: SnapshotFilterElementScanPlan,
        pattern: PatternScanConstraint,
        scan_constraints: &ScanConstraintSet,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64
    ) {
        let mut stored: SnapshotFilterElementScanPlan = plan;
        let pattern_has_mask: bool = PatternScanConstraint::has_mask(&pattern);
        let planned_scan_type: PlannedScanType =
            planned_byte_array_scan_type(pattern_has_mask);
        SnapshotFilterElementScanPlan::set_planned_scan_type(&mut stored, planned_scan_type);
        let pushed: bool = TypePlanList::push(plan_list, &stored);
        transition { _ -> next(plan_list, builder, scan_constraints, data_type_ref, memory_alignment, position) }
    }

    state next(
        plan_list: &mut TypePlanList,
        builder: &ScanConstraintBuilder,
        scan_constraints: &ScanConstraintSet,
        data_type_ref: &DataTypeRef,
        memory_alignment: MemoryAlignment,
        position: u64
    ) {
        transition { _ -> each(plan_list, builder, scan_constraints, data_type_ref, memory_alignment, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state done(plan_list: &mut TypePlanList) -> TypePlanList {
        (TypePlanList::clone(&mut plan_list))
    }
}

// Upstream's masked/unmasked byte-array scanner pick — the pattern
// constraint's `has_mask()` selects Boyer-Moore vs masked Boyer-Moore.
machine planned_byte_array_scan_type(has_mask: bool) -> PlannedScanType {
    transition has_mask {
        true -> (PlannedScanType::ByteArray {
            scan_type: PlannedScanTypeByteArray::ByteArrayBooyerMooreMasked })
        false -> (PlannedScanType::ByteArray {
            scan_type: PlannedScanTypeByteArray::ByteArrayBooyerMoore })
        _ -> (PlannedScanType::ByteArray {
            scan_type: PlannedScanTypeByteArray::ByteArrayBooyerMoore })
    }
}

// Packs `bytes[0..count]` little-endian into u64 — the same byte order
// `ScanConstraint`'s `operand_value` uses. Callers bound count <= 8.
machine pack_bytes_le_u64(bytes: &[u8], count: u64) -> u64 {
    transition { _ -> pack(bytes, count, 0, 0) }
    state pack(bytes: &[u8], count: u64, at: u64, acc: u64) -> u64 {
        transition at < count && at < bytes.len && at < 8 {
            true -> one(bytes, count, at, acc)
            false -> (acc)
        }
    }
    state one(bytes: &[u8], count: u64, at: u64, acc: u64) -> u64
    {
        let byte: u64 = bytes[at] as u64;
        let shifted: u64 = ((byte as u64 in Wrapping)
            * (pow256_u64(at) as u64 in Wrapping)) as u64;
        transition { _ -> pack(bytes, count,
            ((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64,
            ((acc as u64 in Wrapping) + (shifted as u64 in Wrapping)) as u64) }
    }
}

// 256^at as u64 — the LE byte-placement multiplier.
machine pow256_u64(at: u64) -> u64 {
    transition { _ -> each(1, 0, at) }
    state each(acc: u64, step: u64, at: u64) -> u64 {
        transition step < at && step < 8 {
            true -> each(((acc as u64 in Wrapping) * (256 as u64 in Wrapping)) as u64,
                step + 1, at)
            false -> (acc)
        }
    }
}

// Packs `bytes[0..count]` big-endian into u64 — MSB-first accumulation, the
// operand's numeric form for a big-endian element type. Callers bound
// count <= 8.
machine pack_bytes_be_u64(bytes: &[u8], count: u64) -> u64 {
    transition { _ -> pack(bytes, count, 0, 0) }
    state pack(bytes: &[u8], count: u64, at: u64, acc: u64) -> u64 {
        transition at < count && at < bytes.len && at < 8 {
            true -> one(bytes, count, at, acc)
            false -> (acc)
        }
    }
    state one(bytes: &[u8], count: u64, at: u64, acc: u64) -> u64
    {
        let byte: u64 = bytes[at] as u64;
        transition { _ -> pack(bytes, count,
            ((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64,
            ((acc as u64 in Wrapping) * (256 as u64 in Wrapping)
                + (byte as u64 in Wrapping)) as u64) }
    }
}

// Endianness pick for the operand/mask packs — the numeric convention the
// element slots and the typed compares share.
machine pack_for_endianness_u64(
    bytes: &[u8],
    count: u64,
    is_big_endian: bool
) -> u64 {
    transition is_big_endian {
        true -> (pack_bytes_be_u64(bytes, count))
        false -> (pack_bytes_le_u64(bytes, count))
        _ -> (pack_bytes_le_u64(bytes, count))
    }
}

// The inverse of `pack_bytes_le_u64` — writes the packed word's low `count`
// bytes little-endian into `out` (out-of-bounds writes refuse through the
// `at < out.len` guard; a `count` wider than the destination writes only
// what fits, like the pack side reading what exists).
machine unpack_le_u64(value: u64, count: u64, out: &mut [u8]) {
    transition { _ -> each(value, count, out, 0) }

    state each(value: u64, count: u64, out: &mut [u8], at: u64) {
        transition at < count && at < out.len && at < 8 {
            true -> one(value, count, out, at)
            false -> done()
            _ -> done()
        }
    }

    state one(value: u64, count: u64, out: &mut [u8], at: u64)
        requires at < out.len && at < 8
    {
        let place: u64 = pow256_u64(at);
        let digit: u64 = ((value as u64 in Wrapping) / (place as u64 in Wrapping)) as u64;
        let byte: u64 = digit % 256;
        out[at] = byte as u8;
        transition { _ -> each(value, count, out,
            ((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state done() {
    }
}

// The inverse of `pack_bytes_be_u64` — writes the packed word's low `count`
// bytes MSB-first into `out`, recovering the stored big-endian byte order
// (out[count-1] is the value's least significant byte).
machine unpack_be_u64(value: u64, count: u64, out: &mut [u8]) {
    transition { _ -> each(value, count, out, 0) }

    state each(value: u64, count: u64, out: &mut [u8], at: u64) {
        transition at < count && at < out.len && at < 8 {
            true -> one(value, count, out, at)
            false -> done()
            _ -> done()
        }
    }

    state one(value: u64, count: u64, out: &mut [u8], at: u64)
        requires at < out.len && at < 8 && at < count
    {
        // Byte at `at` sits at place (count-1-at) from the low end.
        let distance_from_low: u64 = ((count as u64 in Saturating)
            - (1 as u64 in Saturating) - (at as u64 in Saturating)) as u64;
        let shift_bits: u64 = ((distance_from_low as u64 in Wrapping)
            * (8 as u64 in Wrapping)) as u64;
        let shifted: u64 = ((value as u64 in Wrapping)
            >> (shift_bits as u64 in Wrapping)) as u64;
        let byte: u64 = ((shifted as u64 in Wrapping)
            % (256 as u64 in Wrapping)) as u64;
        out[at] = byte as u8;
        transition { _ -> each(value, count, out,
            ((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state done() {
    }
}

// Endianness pick for the span unpack — mirrors the operand pack direction
// so the recovered bytes reproduce the stored operand byte-for-byte.
machine unpack_for_endianness_u64(
    value: u64,
    count: u64,
    is_big_endian: bool,
    out: &mut [u8]
) {
    transition is_big_endian {
        true -> be(value, count, out)
        false -> le(value, count, out)
        _ -> le(value, count, out)
    }
    state be(value: u64, count: u64, out: &mut [u8]) {
        unpack_be_u64(value, count, out);
    }
    state le(value: u64, count: u64, out: &mut [u8]) {
        unpack_le_u64(value, count, out);
    }
}

