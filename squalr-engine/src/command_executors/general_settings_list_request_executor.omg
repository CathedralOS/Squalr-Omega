use {squalr_engine_api}/src/commands/settings/general/list/general_settings_list_request.omg;
use {squalr_engine_api}/src/commands/settings/general/list/general_settings_list_response.omg;
use {squalr_engine_api}/src/structures/settings/general_settings.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/settings/general/list/general_settings_list_request_executor.rs —
// upstream clones the full settings out of general_settings_config.rs's `GeneralSettingsConfig::get_full_config().read()`;
// the upstream read-lock failure arm (`Err(SettingsError::read_failure("general"))`) is unreachable: the port reads a session field, not a shared lock. Upstream's `Ok(...)` arm is the only reachable case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data GeneralSettingsListRequestExecutor {}

public machine GeneralSettingsListRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    general_settings_list_request: &|general_settings_list_request|::GeneralSettingsListRequest
) -> |general_settings_list_response|::GeneralSettingsListResponse {
    let settings: |general_settings|::GeneralSettings = |engine_privileged_state|::EnginePrivilegedState::get_general_settings(&engine_privileged_state);
    let result: |general_settings_list_response|::GeneralSettingsResult = |general_settings_list_response|::GeneralSettingsResult::new_ok(settings);
    (|general_settings_list_response|::GeneralSettingsListResponse::new(result))
}
