module src::command_executors::general_settings_list_request_executor;

use squalr_engine_api::src::commands::settings::general::list::general_settings_list_request::GeneralSettingsListRequest;
use squalr_engine_api::src::commands::settings::general::list::general_settings_list_response::GeneralSettingsListResponse;
use squalr_engine_api::src::commands::settings::general::list::general_settings_list_response::GeneralSettingsResult;
use squalr_engine_api::src::structures::settings::general_settings::GeneralSettings;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/settings/general/list/general_settings_list_request_executor.rs —
// upstream clones the full settings out of general_settings_config.rs's `GeneralSettingsConfig::get_full_config().read()`;
// the upstream read-lock failure arm (`Err(SettingsError::read_failure("general"))`) is unreachable: the port reads a session field, not a shared lock. Upstream's `Ok(...)` arm is the only reachable case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data GeneralSettingsListRequestExecutor {}

pub machine GeneralSettingsListRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    general_settings_list_request: &GeneralSettingsListRequest
) -> GeneralSettingsListResponse {
    let settings: GeneralSettings = EnginePrivilegedState::get_general_settings(&engine_privileged_state);
    let result: GeneralSettingsResult = GeneralSettingsResult::new_ok(settings);
    (GeneralSettingsListResponse::new(result))
}
