use {omega}/language/core/filesystem_authority.omg;
use {squalr_engine_api}/src/commands/patches/apply/patch_apply_request.omg;
use {squalr_engine_api}/src/commands/patches/apply/patch_apply_response.omg;
use {squalr_engine_api}/src/structures/patches/patch_command_status.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/patches/patch_service.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/structures/patches/patch_descriptor.omg;
use {squalr_engine_api}/src/structures/patches/patch_kind.omg;

// Port of command_executors/patches/apply/patch_apply_request_executor.rs —
// requires an opened process, then delegates to the session patch service
// (which resolves the absolute address, enforces the process scope and the
// overlap rule, reads the original bytes and writes the patch). Upstream
// wraps the operation in `run_patch_operation_with_debugger_paused`; the
// headless port has no debugger orchestration, so the service call runs
// directly (documented residual).
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data PatchApplyRequestExecutor {}

public machine PatchApplyRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    patch_apply_request: &|patch_apply_request|::PatchApplyRequest
) -> |patch_apply_response|::PatchApplyResponse
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> apply(engine_privileged_state, patch_apply_request)
        _ -> absent()
    }

    machine absent() -> |patch_apply_response|::PatchApplyResponse {
        (|patch_apply_response|::PatchApplyResponse::new(|patch_command_status|::PatchCommandStatus::failure("No opened process to patch.")))
    }

    machine apply(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        patch_apply_request: &|patch_apply_request|::PatchApplyRequest
    ) -> |patch_apply_response|::PatchApplyResponse {
        let opened_process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        let address: u64 = |patch_apply_request|::PatchApplyRequest::get_address(&patch_apply_request);
        let module_name: &[u8] = |patch_apply_request|::PatchApplyRequest::get_module_name(&patch_apply_request);
        let patched_bytes: &[u8] = |patch_apply_request|::PatchApplyRequest::get_patched_bytes(&patch_apply_request);
        let kind: |patch_kind|::PatchKind = |patch_apply_request|::PatchApplyRequest::get_kind(&patch_apply_request);
        let has_label: bool = |patch_apply_request|::PatchApplyRequest::has_label(&patch_apply_request);
        let label: &[u8] = |patch_apply_request|::PatchApplyRequest::get_label(&patch_apply_request);
        transition {
            _ -> dispatch(
                engine_privileged_state, &opened_process_info,
                address, module_name, patched_bytes, kind, has_label, label)
        }
    }

    machine dispatch(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        opened_process_info: &|opened_process_info|::OpenedProcessInfo,
        address: u64,
        module_name: &[u8],
        patched_bytes: &[u8],
        kind: |patch_kind|::PatchKind,
        has_label: bool,
        label: &[u8]
    ) -> |patch_apply_response|::PatchApplyResponse {
        let outcome: |patch_service|::PatchServiceResult = |engine_privileged_state|::EnginePrivilegedState::apply_patch(&mut engine_privileged_state, opened_process_info, address, module_name, patched_bytes, kind, has_label, label);
        transition outcome {
            |patch_service|::PatchServiceResult::Ok { patch } -> commit(patch)
            |patch_service|::PatchServiceResult::Err { error } -> fail(error)
        }
    }

    machine commit(patch: |patch_descriptor|::PatchDescriptor) -> |patch_apply_response|::PatchApplyResponse {
        let mut response: |patch_apply_response|::PatchApplyResponse = |patch_apply_response|::PatchApplyResponse::new(|patch_command_status|::PatchCommandStatus::success());
        |patch_apply_response|::PatchApplyResponse::set_patch(&mut response, &patch);
        (response)
    }

    machine fail(error: |patch_service|::PatchServiceError) -> |patch_apply_response|::PatchApplyResponse {
        let message: &[u8] = |patch_service|::PatchServiceError::get_message(&error);
        (|patch_apply_response|::PatchApplyResponse::new(|patch_command_status|::PatchCommandStatus::failure(message)))
    }
}
