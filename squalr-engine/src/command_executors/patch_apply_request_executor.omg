module src::command_executors::patch_apply_request_executor;

use squalr_engine_api::src::commands::patches::apply::patch_apply_request::PatchApplyRequest;
use squalr_engine_api::src::commands::patches::apply::patch_apply_response::PatchApplyResponse;
use squalr_engine_api::src::structures::patches::patch_command_status::PatchCommandStatus;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::patches::patch_service::PatchServiceError;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::patches::patch_descriptor::PatchDescriptor;
use squalr_engine_api::src::structures::patches::patch_kind::PatchKind;
use squalr_engine_session::src::patches::patch_service::PatchServiceResult;

// Port of command_executors/patches/apply/patch_apply_request_executor.rs —
// requires an opened process, then delegates to the session patch service
// (which resolves the absolute address, enforces the process scope and the
// overlap rule, reads the original bytes and writes the patch). Upstream
// wraps the operation in `run_patch_operation_with_debugger_paused`; the
// headless port has no debugger orchestration, so the service call runs
// directly (documented residual).
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data PatchApplyRequestExecutor {}

pub machine PatchApplyRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    patch_apply_request: &PatchApplyRequest
) -> PatchApplyResponse
reaches FilesystemHost
invokes FilesystemHost;
{
    transition EnginePrivilegedState::has_opened_process(engine_privileged_state) {
        true -> apply(engine_privileged_state, patch_apply_request)
        _ -> absent()
    }

    state absent() -> PatchApplyResponse {
        let inner3000: PatchCommandStatus = PatchCommandStatus::failure("No opened process to patch.");
        (PatchApplyResponse::new(inner3000))
    }

    state apply(
        engine_privileged_state: &mut EnginePrivilegedState,
        patch_apply_request: &PatchApplyRequest
    ) -> PatchApplyResponse {
        let opened_process_info: OpenedProcessInfo = EnginePrivilegedState::get_opened_process(engine_privileged_state);
        let address: u64 = PatchApplyRequest::get_address(patch_apply_request);
        let module_name: &[u8] = PatchApplyRequest::get_module_name(patch_apply_request);
        let patched_bytes: &[u8] = PatchApplyRequest::get_patched_bytes(patch_apply_request);
        let kind: PatchKind = PatchApplyRequest::get_kind(patch_apply_request);
        let has_label: bool = PatchApplyRequest::has_label(patch_apply_request);
        let label: &[u8] = PatchApplyRequest::get_label(patch_apply_request);
        transition {
            _ -> dispatch(
                engine_privileged_state, &opened_process_info,
                address, module_name, patched_bytes, kind, has_label, label)
        }
    }

    state dispatch(
        engine_privileged_state: &mut EnginePrivilegedState,
        opened_process_info: &OpenedProcessInfo,
        address: u64,
        module_name: &[u8],
        patched_bytes: &[u8],
        kind: PatchKind,
        has_label: bool,
        label: &[u8]
    ) -> PatchApplyResponse {
        let outcome: PatchServiceResult = EnginePrivilegedState::apply_patch(engine_privileged_state, 
            opened_process_info, address, module_name, patched_bytes, kind, has_label, label);
        transition outcome {
            PatchServiceResult::Ok { patch } -> commit(patch)
            PatchServiceResult::Err { error } -> fail(error)
        }
    }

    state commit(patch: PatchDescriptor) -> PatchApplyResponse {
        let mut response: PatchApplyResponse = PatchApplyResponse::new(PatchCommandStatus::success());
        PatchApplyResponse::set_patch(&mut response, &patch);
        (response)
    }

    state fail(error: PatchServiceError) -> PatchApplyResponse {
        let message: &[u8] = PatchServiceError::get_message(&error);
        let inner3001: PatchCommandStatus = PatchCommandStatus::failure(message);
        (PatchApplyResponse::new(inner3001))
    }
}
