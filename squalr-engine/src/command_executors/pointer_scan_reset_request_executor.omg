module src::command_executors::pointer_scan_reset_request_executor;

use squalr_engine_api::src::commands::pointer_scan::reset::pointer_scan_reset_request::PointerScanResetRequest;
use squalr_engine_api::src::commands::pointer_scan::reset::pointer_scan_reset_response::PointerScanResetResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/pointer_scan/reset/pointer_scan_reset_request_executor.rs.
// Upstream: `*pointer_scan_results_guard = None` under the write lock;
// lock poisoning is the only failure and the port has no locks → success.
pub data PointerScanResetRequestExecutor {}

pub machine PointerScanResetRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    pointer_scan_reset_request: &PointerScanResetRequest
) -> PointerScanResetResponse
crashes Abort
{
    engine_privileged_state.pointer_scan_results_store.clear();
    PointerScanResetResponse::of_success(true)
}
