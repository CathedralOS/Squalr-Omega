use {omega}/language/core/filesystem_authority.omg;
use {squalr_engine_api}/src/commands/patches/restore/patch_restore_request.omg;
use {squalr_engine_api}/src/commands/patches/restore/patch_restore_response.omg;
use {squalr_engine_api}/src/structures/patches/patch_command_status.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/patches/patch_service.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/structures/patches/patch_descriptor.omg;

// Port of command_executors/patches/restore/patch_restore_request_executor.rs —
// restores the original bytes of the patch named by `patch_id` (scope
// check, active check, current-bytes comparison, original-byte rewrite,
// deactivation all inside the session patch service). The debugger-pause
// wrapper collapses to a direct call — see the apply executor's note.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data PatchRestoreRequestExecutor {}

public machine PatchRestoreRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    patch_restore_request: &|patch_restore_request|::PatchRestoreRequest
) -> |patch_restore_response|::PatchRestoreResponse
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> restore(engine_privileged_state, patch_restore_request)
        _ -> absent()
    }

    machine absent() -> |patch_restore_response|::PatchRestoreResponse {
        (|patch_restore_response|::PatchRestoreResponse::new(|patch_command_status|::PatchCommandStatus::failure("No opened process to patch.")))
    }

    machine restore(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        patch_restore_request: &|patch_restore_request|::PatchRestoreRequest
    ) -> |patch_restore_response|::PatchRestoreResponse {
        let opened_process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        let patch_id: &[u8] = |patch_restore_request|::PatchRestoreRequest::get_patch_id(&patch_restore_request);
        let outcome: |patch_service|::PatchServiceResult = |engine_privileged_state|::EnginePrivilegedState::restore_patch(&mut engine_privileged_state, &opened_process_info, patch_id);
        transition outcome {
            |patch_service|::PatchServiceResult::Ok { patch } -> commit(patch)
            |patch_service|::PatchServiceResult::Err { error } -> fail(error)
        }
    }

    machine commit(patch: |patch_descriptor|::PatchDescriptor) -> |patch_restore_response|::PatchRestoreResponse {
        let mut response: |patch_restore_response|::PatchRestoreResponse = |patch_restore_response|::PatchRestoreResponse::new(|patch_command_status|::PatchCommandStatus::success());
        |patch_restore_response|::PatchRestoreResponse::set_patch(&mut response, &patch);
        (response)
    }

    machine fail(error: |patch_service|::PatchServiceError) -> |patch_restore_response|::PatchRestoreResponse {
        let message: &[u8] = |patch_service|::PatchServiceError::get_message(&error);
        (|patch_restore_response|::PatchRestoreResponse::new(|patch_command_status|::PatchCommandStatus::failure(message)))
    }
}
