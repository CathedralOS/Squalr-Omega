module src::command_executors::patch_restore_request_executor;

use squalr_engine_api::src::commands::patches::restore::patch_restore_request::PatchRestoreRequest;
use squalr_engine_api::src::commands::patches::restore::patch_restore_response::PatchRestoreResponse;
use squalr_engine_api::src::structures::patches::patch_command_status::PatchCommandStatus;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::patches::patch_service::PatchServiceError;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::patches::patch_descriptor::PatchDescriptor;
use squalr_engine_session::src::patches::patch_service::PatchServiceResult;

// Port of command_executors/patches/restore/patch_restore_request_executor.rs —
// restores the original bytes of the patch named by `patch_id` (scope
// check, active check, current-bytes comparison, original-byte rewrite,
// deactivation all inside the session patch service). The debugger-pause
// wrapper collapses to a direct call — see the apply executor's note.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data PatchRestoreRequestExecutor {}

pub machine PatchRestoreRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    patch_restore_request: &PatchRestoreRequest
) -> PatchRestoreResponse
reaches FilesystemHost
invokes FilesystemHost;
{
    transition engine_privileged_state.has_opened_process() {
        true -> restore(engine_privileged_state, patch_restore_request)
        _ -> absent()
    }

    state absent() -> PatchRestoreResponse {
        (PatchRestoreResponse::new(PatchCommandStatus::failure("No opened process to patch.")))
    }

    state restore(
        engine_privileged_state: &mut EnginePrivilegedState,
        patch_restore_request: &PatchRestoreRequest
    ) -> PatchRestoreResponse {
        let opened_process_info: OpenedProcessInfo = engine_privileged_state.get_opened_process();
        let patch_id: &[u8] = patch_restore_request.get_patch_id();
        let outcome: PatchServiceResult = engine_privileged_state.restore_patch(
            &opened_process_info, patch_id);
        transition outcome {
            PatchServiceResult::Ok { patch } -> commit(patch)
            PatchServiceResult::Err { error } -> fail(error)
        }
    }

    state commit(patch: PatchDescriptor) -> PatchRestoreResponse {
        let mut response: PatchRestoreResponse = PatchRestoreResponse::new(PatchCommandStatus::success());
        response.set_patch(&patch);
        (response)
    }

    state fail(error: PatchServiceError) -> PatchRestoreResponse {
        let message: &[u8] = error.get_message();
        (PatchRestoreResponse::new(PatchCommandStatus::failure(message)))
    }
}
