module src::command_executors::scan_command_executor;

use squalr_engine_api::src::commands::scan::scan_command::ScanCommand;
use squalr_engine_api::src::commands::scan::scan_response::ScanResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::collect_values_request_executor::CollectValuesRequestExecutor;
use src::command_executors::element_scan_request_executor::ElementScanRequestExecutor;
use src::command_executors::scan_new_request_executor::ScanNewRequestExecutor;
use src::command_executors::scan_reset_request_executor::ScanResetRequestExecutor;
use squalr_engine_api::src::commands::scan::reset::scan_reset_request::ScanResetRequest;
use squalr_engine_api::src::commands::scan::new::scan_new_request::ScanNewRequest;
use squalr_engine_api::src::commands::scan::collect_values::collect_values_request::CollectValuesRequest;
use squalr_engine_api::src::commands::scan::element_scan::element_scan_request::ElementScanRequest;
use squalr_engine_api::src::commands::scan::reset::scan_reset_response::ScanResetResponse;
use squalr_engine_api::src::commands::scan::new::scan_new_response::ScanNewResponse;
use squalr_engine_api::src::commands::scan::collect_values::collect_values_response::CollectValuesResponse;
use squalr_engine_api::src::commands::scan::element_scan::element_scan_response::ElementScanResponse;

// Port of command_executors/scan/scan_command_executor.rs — routes the scan
// command union to its executor and wraps each executor's typed response in
// the `ScanResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ScanCommandExecutor {}

pub machine ScanCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    scan_command: &ScanCommand
) -> ScanResponse
crashes Abort
{
    transition scan_command {
        ScanCommand::Reset { request } -> reset(engine_privileged_state, &request)
        ScanCommand::New { request } -> new(engine_privileged_state, &request)
        ScanCommand::CollectValues { request } -> collect_values(engine_privileged_state, &request)
        ScanCommand::ElementScan { request } -> element_scan(engine_privileged_state, &request)
    }

    state reset(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanResetRequest
    ) -> ScanResponse {
        let response: ScanResetResponse = ScanResetRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (ScanResponse::Reset { response: response }) }
    }

    state new(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanNewRequest
    ) -> ScanResponse {
        let response: ScanNewResponse = ScanNewRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (ScanResponse::New { response: response }) }
    }

    state collect_values(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &CollectValuesRequest
    ) -> ScanResponse {
        let response: CollectValuesResponse = CollectValuesRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (ScanResponse::CollectValues { response: response }) }
    }

    state element_scan(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ElementScanRequest
    ) -> ScanResponse
    {
        let response: ElementScanResponse = ElementScanRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (ScanResponse::ElementScan { response: response }) }
    }
}
