use {squalr_engine_api}/src/commands/scan/scan_command.omg;
use {squalr_engine_api}/src/commands/scan/scan_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/collect_values_request_executor.omg;
use src/command_executors/element_scan_request_executor.omg;
use src/command_executors/scan_new_request_executor.omg;
use src/command_executors/scan_supplied_bytes_request_executor.omg;
use src/command_executors/scan_reset_request_executor.omg;
use {squalr_engine_api}/src/commands/scan/reset/scan_reset_request.omg;
use {squalr_engine_api}/src/commands/scan/new/scan_new_request.omg;
use {squalr_engine_api}/src/commands/scan/collect_values/collect_values_request.omg;
use {squalr_engine_api}/src/commands/scan/element_scan/element_scan_request.omg;
use {squalr_engine_api}/src/commands/scan/supplied_bytes/scan_supplied_bytes_request.omg;
use {squalr_engine_api}/src/commands/scan/supplied_bytes/scan_supplied_bytes_response.omg;
use {squalr_engine_api}/src/commands/scan/reset/scan_reset_response.omg;
use {squalr_engine_api}/src/commands/scan/new/scan_new_response.omg;
use {squalr_engine_api}/src/commands/scan/collect_values/collect_values_response.omg;
use {squalr_engine_api}/src/commands/scan/element_scan/element_scan_response.omg;

// Port of command_executors/scan/scan_command_executor.rs — routes the scan
// command union to its executor and wraps each executor's typed response in
// the `ScanResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ScanCommandExecutor {}

public machine ScanCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    scan_command: &|scan_command|::ScanCommand
) -> |scan_response|::ScanResponse
crashes Abort
{
    transition scan_command {
        |scan_command|::ScanCommand::Reset { request } -> reset(engine_privileged_state, &request)
        |scan_command|::ScanCommand::New { request } -> new(engine_privileged_state, &request)
        |scan_command|::ScanCommand::CollectValues { request } -> collect_values(engine_privileged_state, &request)
        |scan_command|::ScanCommand::ElementScan { request } -> element_scan(engine_privileged_state, &request)
        |scan_command|::ScanCommand::SuppliedBytes { request } -> supplied_bytes(engine_privileged_state, &request)
    }

    machine reset(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|scan_reset_request|::ScanResetRequest
    ) -> |scan_response|::ScanResponse {
        let response: |scan_reset_response|::ScanResetResponse = |scan_reset_request_executor|::ScanResetRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_response|::ScanResponse::Reset { response: response }) }
    }

    machine new(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|scan_new_request|::ScanNewRequest
    ) -> |scan_response|::ScanResponse {
        let response: |scan_new_response|::ScanNewResponse = |scan_new_request_executor|::ScanNewRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_response|::ScanResponse::New { response: response }) }
    }

    machine collect_values(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|collect_values_request|::CollectValuesRequest
    ) -> |scan_response|::ScanResponse {
        let response: |collect_values_response|::CollectValuesResponse = |collect_values_request_executor|::CollectValuesRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_response|::ScanResponse::CollectValues { response: response }) }
    }

    machine element_scan(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|element_scan_request|::ElementScanRequest
    ) -> |scan_response|::ScanResponse
    {
        let response: |element_scan_response|::ElementScanResponse = |element_scan_request_executor|::ElementScanRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_response|::ScanResponse::ElementScan { response: response }) }
    }

    // Supplied-bytes dispatch: the request's byte payload seeds the supplied
    // memory source, then the shared scan pipeline runs over it.
    machine supplied_bytes(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|scan_supplied_bytes_request|::ScanSuppliedBytesRequest
    ) -> |scan_response|::ScanResponse {
        let response: |scan_supplied_bytes_response|::ScanSuppliedBytesResponse = |scan_supplied_bytes_request_executor|::ScanSuppliedBytesRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_response|::ScanResponse::SuppliedBytes { response: response }) }
    }
}
