use {squalr_engine_api}/src/commands/scan/element_scan/element_scan_request.omg;
use {squalr_engine_api}/src/commands/scan/element_scan/element_scan_response.omg;
use {squalr_engine_api}/src/events/engine_event.omg;
use {squalr_engine_api}/src/events/scan_results/updated/scan_results_updated_event.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_results_metadata.omg;
use {squalr_engine_api}/src/structures/settings/scan_settings.omg;
use {squalr_engine_api}/src/structures/scanning/memory_read_mode.omg;
use {squalr_engine_api}/src/structures/scanning/plans/element_scan/element_scan_plan.omg;
use {squalr_engine_api}/src/structures/data_types/data_type_ref.omg;
use {squalr_engine_scanning}/src/scanners/scan_control.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/constraint_deanonymizer.omg;
use src/command_executors/element_scanner.omg;
use src/command_executors/scan_results_metadata_collector.omg;
use src/command_executors/snapshot_value_collector.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot_region.omg;

// Port of commands/scan/element_scan/element_scan_request_executor.rs:
// settings → deanonymize per data type → collect values (unless
// MemoryReadMode::Skip) → scan_snapshot → respond with the collected
// metadata. No opened process → upstream's default (success=false).
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ElementScanRequestExecutor {}

public machine ElementScanRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    element_scan_request: &|element_scan_request|::ElementScanRequest
) -> |element_scan_response|::ElementScanResponse
crashes Abort
{
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> plan(engine_privileged_state, element_scan_request)
        _ -> (|element_scan_response|::ElementScanResponse::default())
    }

    // Upstream: `ElementScanPlan::new` then deanonymize per requested data
    // type. Settings come from the session's stored ScanSettings.
    machine plan(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        element_scan_request: &|element_scan_request|::ElementScanRequest
    ) -> |element_scan_response|::ElementScanResponse
    {
        let settings: |scan_settings|::ScanSettings = |engine_privileged_state|::EnginePrivilegedState::get_scan_settings(&engine_privileged_state);
        let mut plan: |element_scan_plan|::ElementScanPlan = |element_scan_plan|::ElementScanPlan::new(
            |scan_settings|::ScanSettings::get_memory_alignment(&settings),
            |scan_settings|::ScanSettings::get_memory_read_mode(&settings),
            |scan_settings|::ScanSettings::get_is_single_threaded_scan(&settings),
            |scan_settings|::ScanSettings::get_debug_perform_validation_scan(&settings));
        transition { _ -> deanonymize(engine_privileged_state, element_scan_request, plan, settings, 0) }
    }

    machine deanonymize(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        element_scan_request: &|element_scan_request|::ElementScanRequest,
        plan: |element_scan_plan|::ElementScanPlan,
        settings: |scan_settings|::ScanSettings,
        type_index: u64
    ) -> |element_scan_response|::ElementScanResponse
    {
        transition type_index < element_scan_request.data_type_refs.count {
            true -> build_type(engine_privileged_state, element_scan_request, plan, settings, type_index)
            false -> collect(engine_privileged_state, plan, settings)
        }
    }

    machine build_type(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        element_scan_request: &|element_scan_request|::ElementScanRequest,
        plan: |element_scan_plan|::ElementScanPlan,
        settings: |scan_settings|::ScanSettings,
        type_index: u64
    ) -> |element_scan_response|::ElementScanResponse
    {
        let data_type_ref: |data_type_ref|::DataTypeRef = |snapshot_region|::DataTypeRefSet::get(&element_scan_request.data_type_refs, type_index);
        let plan_list: |element_scan_plan|::TypePlanList = |constraint_deanonymizer|::ConstraintDeanonymizer::build_type_plan_list(
            &element_scan_request.scan_constraints,
            &data_type_ref,
            |scan_settings|::ScanSettings::get_memory_alignment(&settings));
        let mut carried: |element_scan_plan|::ElementScanPlan = plan;
        let pushed: bool = |element_scan_plan|::ElementScanPlan::push_type_plans(&mut carried, &data_type_ref, &plan_list);
        transition { _ -> deanonymize(
            engine_privileged_state, element_scan_request, carried, settings, ((type_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    machine collect(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        plan: |element_scan_plan|::ElementScanPlan,
        settings: |scan_settings|::ScanSettings
    ) -> |element_scan_response|::ElementScanResponse
    {
        // Upstream reads live values unless MemoryReadMode::Skip — the
        // supplied source answers the read for the captured target.
        let hoist2: |memory_read_mode|::MemoryReadMode = |element_scan_plan|::ElementScanPlan::get_memory_read_mode(&plan);
        transition hoist2 {
            |memory_read_mode|::MemoryReadMode::ReadBeforeScan -> read(engine_privileged_state, plan)
            |memory_read_mode|::MemoryReadMode::Skip -> scan(engine_privileged_state, plan)
            _ -> scan(engine_privileged_state, plan)
        }
    }

    machine read(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        plan: |element_scan_plan|::ElementScanPlan
    ) -> |element_scan_response|::ElementScanResponse
    {
        |snapshot_value_collector|::SnapshotValueCollector::collect_all_regions(&mut engine_privileged_state);
        transition { _ -> scan(engine_privileged_state, plan) }
    }

    machine scan(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        plan: |element_scan_plan|::ElementScanPlan
    ) -> |element_scan_response|::ElementScanResponse
    {
        // Upstream `ScanControl::new(None, Some(reporter))` — the port
        // carries the flag/progress record directly on the control object.
        let mut scan_control: |scan_control|::ScanControl = |scan_control|::ScanControl::new(false);
        let mut carried_plan: |element_scan_plan|::ElementScanPlan = plan;
        let metadata: |scan_results_metadata|::ScanResultsMetadata = |element_scanner|::ElementScannerDriver::scan_snapshot(
            |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot_mut(&mut engine_privileged_state), &mut carried_plan, &mut scan_control);
        transition { _ -> finish(engine_privileged_state) }
    }

    // Upstream answers with `collect_scan_results_metadata(state)` — the
    // response metadata is collected off the snapshot at response time,
    // equal to the driver's post-scan counts. Upstream emits
    // `ScanResultsUpdatedEvent { is_new_scan: false }` after the scan
    // report — same order here.
    machine finish(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
    ) -> |element_scan_response|::ElementScanResponse {
        let updated: |scan_results_updated_event|::ScanResultsUpdatedEvent = |scan_results_updated_event|::ScanResultsUpdatedEvent::new(false);
        let event: |engine_event|::EngineEvent = |scan_results_updated_event|::ScanResultsUpdatedEvent::to_engine_event(&updated);
        _ = |engine_privileged_state|::EnginePrivilegedState::emit_event(&mut engine_privileged_state, &event);
        let collected: |scan_results_metadata|::ScanResultsMetadata = |scan_results_metadata_collector|::ScanResultsMetadataCollector::collect(engine_privileged_state);
        |element_scan_response|::ElementScanResponse {
            success: true,
            scan_results_metadata: collected,
        }
    }
}
