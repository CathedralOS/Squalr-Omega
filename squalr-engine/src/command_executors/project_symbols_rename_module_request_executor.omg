module src::command_executors::project_symbols_rename_module_request_executor;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::project_symbols::rename_module::project_symbols_rename_module_request::ProjectSymbolsRenameModuleRequest;
use squalr_engine_api::src::commands::project_symbols::rename_module::project_symbols_rename_module_response::ProjectSymbolsRenameModuleResponse;
use squalr_engine_api::src::structures::projects::project::Project;
use squalr_engine_api::src::structures::projects::project_info::ProjectInfo;
use squalr_engine_api::src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;
use squalr_engine_api::src::structures::projects::project_symbol_claim::ProjectSymbolClaim;
use squalr_engine_api::src::structures::projects::project_symbol_module::ProjectSymbolModule;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use squalr_engine_session::src::projects::project_manager::ProjectManager;
