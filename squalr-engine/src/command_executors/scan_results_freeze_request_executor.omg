use {squalr_engine_api}/src/commands/scan_results/delete/scan_results_delete_request.omg;
use {squalr_engine_api}/src/commands/scan_results/freeze/scan_results_freeze_request.omg;
use {squalr_engine_api}/src/commands/scan_results/freeze/scan_results_freeze_response.omg;
use {squalr_engine_api}/src/registries/freeze_list/freeze_list_registry.omg;
use {squalr_engine_api}/src/structures/data_types/data_type_ref.omg;
use {squalr_engine_api}/src/structures/memory/normalized_module.omg;
use {squalr_engine_api}/src/structures/results/snapshot_region_scan_results.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_base.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_ref.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_valued.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/os/supplied_memory_source.omg;
use {squalr_engine_api}/src/structures/snapshots/element_window.omg;

// Port of command_executors/scan_results/freeze/scan_results_freeze_request_executor.rs:
// for each requested scan-result ref, resolve the result's address through
// the snapshot, reduce the address to a (module_name, module_offset) key
// when it lands inside a module, then either register the address frozen at
// its current bytes or drop it from the freeze list. Refs that cannot be
// resolved/read are collected into `failed_freeze_toggle_scan_result_refs`.
//
// Named deviations:
// - Upstream wraps the (offset, name) pair in a `Pointer` keyed by a
//   HashMap; the ported registry stores the decomposed key directly — the
//   pipeline only builds empty-offset pointers (see the registry file).
// - Upstream `symbol_registry.get_default_value(data_type_ref)` sizes the
//   read buffer by the registered type. The port has no symbol registry;
//   `DataTypeRef::get_unit_size_in_bytes` is its analogue — a 0 size (the
//   type is not a ported u64 scalar) maps to upstream's `None` arm and the
//   ref is failed.
// - Upstream reads current bytes through `memory_read`; the supplied
//   memory source is the adapter reader — element-granular u64.
// - Upstream failure of `get_modules`/`address_to_module` leaves the raw
//   address as the offset and an empty module name — same here, and a
//   failed module lookup is NOT a failed ref upstream.
public data ScanResultsFreezeRequestExecutor {}

public machine ScanResultsFreezeRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest
) -> |scan_results_freeze_response|::ScanResultsFreezeResponse
crashes Abort
{
    let empty_module_name: [u8; 1] = [0];
    let mut supplied_modules: [|normalized_module|::NormalizedModule; 8] = [
        |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0)
    ];
    let supplied_module_count: u64 = |engine_privileged_state|::EnginePrivilegedState::copy_supplied_modules(&mut engine_privileged_state, &mut supplied_modules);
    let has_process: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    // Upstream collects `modules` only when a process is opened — an
    // unopened target freezes against an empty module list.
    transition has_process {
        true -> with_modules(engine_privileged_state, scan_results_freeze_request, &supplied_modules, supplied_module_count)
        false -> with_modules(engine_privileged_state, scan_results_freeze_request, &supplied_modules, 0)
        _ -> with_modules(engine_privileged_state, scan_results_freeze_request, &supplied_modules, 0)
    }

    machine with_modules(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse {
        transition { _ -> each(
            engine_privileged_state,
            scan_results_freeze_request,
            supplied_modules,
            module_count,
            |scan_results_freeze_response|::ScanResultsFreezeResponse::empty(),
            0) }
    }
    machine each(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        response: |scan_results_freeze_response|::ScanResultsFreezeResponse,
        position: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse {
        let refs: &|scan_results_delete_request|::ScanResultRefList = |scan_results_freeze_request|::ScanResultsFreezeRequest::get_scan_result_refs(&scan_results_freeze_request);
        let ref_count: u64 = |scan_results_delete_request|::ScanResultRefList::get_count(refs);
        transition position < ref_count {
            true -> resolve(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                response,
                position)
            _ -> (response)
        }
    }
    machine resolve(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        response: |scan_results_freeze_response|::ScanResultsFreezeResponse,
        position: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse {
        let refs: &|scan_results_delete_request|::ScanResultRefList = |scan_results_freeze_request|::ScanResultsFreezeRequest::get_scan_result_refs(&scan_results_freeze_request);
        let scan_result_ref: |scan_result_ref|::ScanResultRef = |scan_results_delete_request|::ScanResultRefList::get(refs, position);
        let global_index: u64 = |scan_result_ref|::ScanResultRef::get_scan_result_index(&scan_result_ref);
        let snapshot: &|snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let structural_result: |snapshot_region_scan_results|::StructuralResult = |snapshot|::Snapshot::get_scan_result(&snapshot, global_index);
        transition structural_result {
            |snapshot_region_scan_results|::StructuralResult::Found { valued_result } -> locate_module(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                valued_result,
                scan_result_ref,
                response,
                position)
            _ -> push_failed(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                scan_result_ref,
                response,
                position)
        }
    }

    // Upstream's `address_to_module` walk: `module_name`/`module_offset`
    // default to "" and the raw address; a containing module replaces both.
    machine locate_module(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        valued_result: |scan_result_valued|::ScanResultValued,
        scan_result_ref: |scan_result_ref|::ScanResultRef,
        response: |scan_results_freeze_response|::ScanResultsFreezeResponse,
        position: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse {
        let base: |scan_result_base|::ScanResultBase = |scan_result_valued|::ScanResultValued::get_base_result(&valued_result);
        let address: u64 = |scan_result_base|::ScanResultBase::get_address(&base);
        let data_type_ref: |data_type_ref|::DataTypeRef = |scan_result_base|::ScanResultBase::get_data_type_ref(&base);
        let byte_len: u64 = |data_type_ref|::DataTypeRef::get_unit_size_in_bytes(&data_type_ref);
        transition { _ -> probe_module(
            engine_privileged_state,
            scan_results_freeze_request,
            supplied_modules,
            module_count,
            address,
            byte_len,
            scan_result_ref,
            response,
            position,
            0) }
    }
    machine probe_module(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        address: u64,
        byte_len: u64,
        scan_result_ref: |scan_result_ref|::ScanResultRef,
        response: |scan_results_freeze_response|::ScanResultsFreezeResponse,
        position: u64,
        module_index: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse {
        transition module_index < module_count && module_index < 8 {
            true -> test_module(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                address,
                byte_len,
                scan_result_ref,
                response,
                position,
                module_index)
            false -> apply(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                address,
                byte_len,
                address,
                "",
                scan_result_ref,
                response,
                position)
            _ -> apply(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                address,
                byte_len,
                address,
                "",
                scan_result_ref,
                response,
                position)
        }
    }
    machine test_module(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        address: u64,
        byte_len: u64,
        scan_result_ref: |scan_result_ref|::ScanResultRef,
        response: |scan_results_freeze_response|::ScanResultsFreezeResponse,
        position: u64,
        module_index: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse
    requires 0 <= module_index && module_index < 8;
    {
        let contained: bool = |normalized_module|::NormalizedModule::contains_address(supplied_modules[module_index], address);
        transition contained {
            true -> found_module(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                address,
                byte_len,
                scan_result_ref,
                response,
                position,
                module_index)
            false -> probe_module(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                address,
                byte_len,
                scan_result_ref,
                response,
                position,
                module_index + 1)
            _ -> probe_module(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                address,
                byte_len,
                scan_result_ref,
                response,
                position,
                module_index + 1)
        }
    }
    machine found_module(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        address: u64,
        byte_len: u64,
        scan_result_ref: |scan_result_ref|::ScanResultRef,
        response: |scan_results_freeze_response|::ScanResultsFreezeResponse,
        position: u64,
        module_index: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse
    requires 0 <= module_index && module_index < 8;
    {
        let base_address: u64 = |normalized_module|::NormalizedModule::get_base_address(supplied_modules[module_index]);
        let module_offset: u64 = ((address as u64 in Saturating) - (base_address as u64 in Saturating)) as u64;
        let module_name: &[u8] = |normalized_module|::NormalizedModule::get_module_name(supplied_modules[module_index]);
        transition { _ -> apply(
            engine_privileged_state,
            scan_results_freeze_request,
            supplied_modules,
            module_count,
            address,
            byte_len,
            module_offset,
            module_name,
            scan_result_ref,
            response,
            position) }
    }

    // Upstream `Pointer::new(module_offset, vec![], module_name)` followed
    // by the is_frozen branch — the decomposed key flows straight to the
    // registry.
    machine apply(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        address: u64,
        byte_len: u64,
        module_offset: u64,
        module_name: &[u8],
        scan_result_ref: |scan_result_ref|::ScanResultRef,
        response: |scan_results_freeze_response|::ScanResultsFreezeResponse,
        position: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse {
        let hoist1: bool = |scan_results_freeze_request|::ScanResultsFreezeRequest::get_is_frozen(&scan_results_freeze_request);
        transition hoist1 {
            true -> gate_process(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                address,
                byte_len,
                module_offset,
                module_name,
                scan_result_ref,
                response,
                position)
            false -> unfrozen(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                module_offset,
                module_name,
                scan_result_ref,
                response,
                position)
            _ -> unfrozen(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                module_offset,
                module_name,
                scan_result_ref,
                response,
                position)
        }
    }
    machine gate_process(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        address: u64,
        byte_len: u64,
        module_offset: u64,
        module_name: &[u8],
        scan_result_ref: |scan_result_ref|::ScanResultRef,
        response: |scan_results_freeze_response|::ScanResultsFreezeResponse,
        position: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse {
        // Upstream: freeze requires an opened process AND a typed default
        // value — either missing pushes the ref to the failed list.
        let has_process: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
        transition has_process && byte_len > 0 {
            true -> read_value(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                address,
                byte_len,
                module_offset,
                module_name,
                scan_result_ref,
                response,
                position)
            false -> push_failed(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                scan_result_ref,
                response,
                position)
            _ -> push_failed(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                scan_result_ref,
                response,
                position)
        }
    }
    machine read_value(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        address: u64,
        byte_len: u64,
        module_offset: u64,
        module_name: &[u8],
        scan_result_ref: |scan_result_ref|::ScanResultRef,
        response: |scan_results_freeze_response|::ScanResultsFreezeResponse,
        position: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse {
        let source: &|supplied_memory_source|::SuppliedMemorySource = |engine_privileged_state|::EnginePrivilegedState::get_supplied_memory_source(&engine_privileged_state);
        let read: |supplied_memory_source|::ReadWindowResult = |supplied_memory_source|::SuppliedMemorySource::try_read_window(&source, address, byte_len);
        let value: u64 = |element_window|::ElementWindow::get_element(&read.window, 0);
        transition read.succeeded {
            true -> store_frozen(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                module_offset,
                module_name,
                value,
                byte_len,
                scan_result_ref,
                response,
                position)
            false -> push_failed(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                scan_result_ref,
                response,
                position)
            _ -> push_failed(
                engine_privileged_state,
                scan_results_freeze_request,
                supplied_modules,
                module_count,
                scan_result_ref,
                response,
                position)
        }
    }
    machine store_frozen(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        module_offset: u64,
        module_name: &[u8],
        value: u64,
        byte_len: u64,
        scan_result_ref: |scan_result_ref|::ScanResultRef,
        response: |scan_results_freeze_response|::ScanResultsFreezeResponse,
        position: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse {
        let registry: &mut |freeze_list_registry|::FreezeListRegistry = |engine_privileged_state|::EnginePrivilegedState::borrow_freeze_list_registry_mut(&mut engine_privileged_state);
        |freeze_list_registry|::FreezeListRegistry::set_address_frozen(&mut registry, module_offset, module_name, value, byte_len);
        transition { _ -> each(
            engine_privileged_state,
            scan_results_freeze_request,
            supplied_modules,
            module_count,
            response,
            ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    machine unfrozen(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        module_offset: u64,
        module_name: &[u8],
        scan_result_ref: |scan_result_ref|::ScanResultRef,
        response: |scan_results_freeze_response|::ScanResultsFreezeResponse,
        position: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse {
        let registry: &mut |freeze_list_registry|::FreezeListRegistry = |engine_privileged_state|::EnginePrivilegedState::borrow_freeze_list_registry_mut(&mut engine_privileged_state);
        let removed: bool = |freeze_list_registry|::FreezeListRegistry::set_address_unfrozen(&mut registry, module_offset, module_name);
        transition { _ -> each(
            engine_privileged_state,
            scan_results_freeze_request,
            supplied_modules,
            module_count,
            response,
            ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    machine push_failed(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_freeze_request: &|scan_results_freeze_request|::ScanResultsFreezeRequest,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        scan_result_ref: |scan_result_ref|::ScanResultRef,
        response: |scan_results_freeze_response|::ScanResultsFreezeResponse,
        position: u64
    ) -> |scan_results_freeze_response|::ScanResultsFreezeResponse {
        let mut carried: |scan_results_freeze_response|::ScanResultsFreezeResponse = response;
        |scan_results_freeze_response|::ScanResultsFreezeResponse::push_failed(&mut carried, &scan_result_ref);
        transition { _ -> each(
            engine_privileged_state,
            scan_results_freeze_request,
            supplied_modules,
            module_count,
            carried,
            ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}
