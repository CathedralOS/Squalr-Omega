use {squalr_engine_api}/src/commands/scan_results/list/scan_results_list_request.omg;
use {squalr_engine_api}/src/commands/scan_results/list/scan_results_list_response.omg;
use {squalr_engine_api}/src/structures/results/snapshot_region_scan_results.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_base.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_ref.omg;
use {squalr_engine_api}/src/structures/data_types/data_type_ref.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_enriched.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_valued.omg;
use {squalr_engine_api}/src/structures/settings/scan_settings.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot_region.omg;
use src/command_executors/scan_result_enricher.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/os/supplied_memory_source.omg;

// Port of commands/scan_results/list/scan_results_list_request_executor.rs:
// `last_page = (count-1)/page_size` (saturating), page contents = the
// globally merged, address-ordered enumeration of every region's scan
// results (upstream's shared BinaryHeap merge — here sorted insertion into
// the bounded page carrier, a named deviation for pages beyond 64
// elements). Each listed element materializes a `ScanResult::Valued` with
// the best-effort live read and the stored previous value.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ScanResultsListRequestExecutor {}

public machine ScanResultsListRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest
) -> |scan_results_list_response|::ScanResultsListResponse
crashes Abort
{
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> count(engine_privileged_state, scan_results_list_request)
        _ -> (|scan_results_list_response|::ScanResultsListResponse::default())
    }

    machine count(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest
    ) -> |scan_results_list_response|::ScanResultsListResponse
    {
        let settings: |scan_settings|::ScanSettings = |engine_privileged_state|::EnginePrivilegedState::get_scan_settings(&engine_privileged_state);
        let snapshot: &|snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let result_count: u64 = ScanResultsListRequestExecutor::count_results(
            snapshot, scan_results_list_request);
        transition { _ -> page(
            engine_privileged_state, scan_results_list_request, settings, result_count) }
    }

    machine page(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
        settings: |scan_settings|::ScanSettings,
        result_count: u64
    ) -> |scan_results_list_response|::ScanResultsListResponse
    {
        let page_size: u64 = |scan_settings|::ScanSettings::get_results_page_size(&settings);
        transition page_size == 0 {
            true -> sized(engine_privileged_state, scan_results_list_request, settings, result_count, 22)
            false -> sized(engine_privileged_state, scan_results_list_request, settings, result_count, page_size)
            _ -> sized(engine_privileged_state, scan_results_list_request, settings, result_count, page_size)
        }
    }
    machine sized(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
        settings: |scan_settings|::ScanSettings,
        result_count: u64,
        bounded_page_size: u64
    ) -> |scan_results_list_response|::ScanResultsListResponse
    {
        transition bounded_page_size > 0 {
            true -> paged(engine_privileged_state, scan_results_list_request, settings, result_count, bounded_page_size)
            false -> paged(engine_privileged_state, scan_results_list_request, settings, result_count, 1)
            _ -> paged(engine_privileged_state, scan_results_list_request, settings, result_count, 1)
        }
    }
    machine paged(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
        settings: |scan_settings|::ScanSettings,
        result_count: u64,
        bounded_page_size: u64
    ) -> |scan_results_list_response|::ScanResultsListResponse
    {
        let last_page: u64 = (((result_count as u64 in Saturating)
            - 1) as u64) / bounded_page_size;
        let results_to_skip: u64 = ((scan_results_list_request.page_index as u64 in Saturating)
            * (bounded_page_size as u64 in Saturating)) as u64;
        // The global merge needs up to `results_to_skip + page_size`
        // head-room per region — every surviving element of a region can
        // sort ahead of another region's.
        let headroom: u64 = ((results_to_skip as u64 in Saturating)
            + (bounded_page_size as u64 in Saturating)) as u64;
        let snapshot: &|snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let all: |snapshot_region_scan_results|::PageElementList = ScanResultsListRequestExecutor::enumerate_all(
            snapshot, scan_results_list_request, headroom);
        transition { _ -> window(
            engine_privileged_state, scan_results_list_request, &all, results_to_skip,
            bounded_page_size, |scan_results_list_response|::ScanResultPage::empty(), 0, result_count, last_page) }
    }

    // Materialize the page window — elements [skip, skip+page_size) of the
    // merged ordering.
    machine window(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
        all: &|snapshot_region_scan_results|::PageElementList,
        results_to_skip: u64,
        page_size: u64,
        page: |scan_results_list_response|::ScanResultPage,
        position: u64,
        result_count: u64,
        last_page: u64
    ) -> |scan_results_list_response|::ScanResultsListResponse
    {
        let hoist3: u64 = |scan_results_list_response|::ScanResultPage::get_count(&page);
        let hoist2: u64 = |snapshot_region_scan_results|::PageElementList::get_element_count(&all);
        transition position < hoist2
            && position >= results_to_skip
            && hoist3 < page_size {
            true -> element(
                engine_privileged_state, scan_results_list_request, all, results_to_skip,
                page_size, page, position, result_count, last_page)
            false -> finish(engine_privileged_state, scan_results_list_request, page, result_count, last_page, page_size)
        }
    }

    machine element(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
        all: &|snapshot_region_scan_results|::PageElementList,
        results_to_skip: u64,
        page_size: u64,
        page: |scan_results_list_response|::ScanResultPage,
        position: u64,
        result_count: u64,
        last_page: u64
    ) -> |scan_results_list_response|::ScanResultsListResponse
    {
        let element: |snapshot_region_scan_results|::PageElement = |snapshot_region_scan_results|::PageElementList::get_page_element(&all, position);
        // Upstream's best-effort live read for the displayed current value;
        // the previous value comes from the stored snapshot window.
        let source: &|supplied_memory_source|::SuppliedMemorySource = |engine_privileged_state|::EnginePrivilegedState::get_supplied_memory_source(&engine_privileged_state);
        let current_value: u64 = |supplied_memory_source|::SuppliedMemorySource::read_u64(&source, element.address);
        let snapshot: &|snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let region: |snapshot_region|::SnapshotRegion = |snapshot|::Snapshot::get_region(snapshot, element.collection_index);
        let previous: u64 = |snapshot_region|::SnapshotRegion::get_previous_element(&region, element.element_index);
        let base_dtr: |data_type_ref|::DataTypeRef = element.data_type_ref;
        let base: |scan_result_base|::ScanResultBase = |scan_result_base|::ScanResultBase::new(
            element.address, base_dtr, |scan_result_ref|::ScanResultRef::new(element.element_index, false));
        let valued: |scan_result_valued|::ScanResultValued = |scan_result_valued|::ScanResultValued::new(base, true, current_value, true, previous);
        // Upstream's module + freeze enrichment (address_to_module +
        // is_address_frozen -> ScanResult::new).
        let enriched: |scan_result_enriched|::ScanResultEnriched = |scan_result_enricher|::ScanResultEnricher::enrich(
            engine_privileged_state, valued);
        let mut carried: |scan_results_list_response|::ScanResultPage = page;
        let pushed: bool = |scan_results_list_response|::ScanResultPage::push(&mut carried, &|scan_result|::ScanResult::Valued { result: enriched });
        transition { _ -> window(
            engine_privileged_state, scan_results_list_request, all, results_to_skip,
            page_size, carried, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, result_count, last_page) }
    }

    machine finish(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
        page: |scan_results_list_response|::ScanResultPage,
        result_count: u64,
        last_page: u64,
        page_size: u64
    ) -> |scan_results_list_response|::ScanResultsListResponse {
        // Upstream fills `data_type_result_counts` +
        // `total_size_in_bytes` from the same snapshot counters.
        let snapshot: &|snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let hoist8: u64 = |snapshot|::Snapshot::get_collected_byte_count(snapshot);
        let counts: |snapshot_region_scan_results|::DataTypeResultCounts = ScanResultsListRequestExecutor::count_by_type(
            snapshot, scan_results_list_request);
        |scan_results_list_response|::ScanResultsListResponse {
            scan_results: page,
            data_type_result_counts: counts,
            page_index: scan_results_list_request.page_index,
            page_size: page_size,
            last_page_index: last_page,
            result_count: result_count,
            total_size_in_bytes: hoist8,
        }
    }
}

// Upstream `get_number_of_results_for_data_types` across every region.
public machine ScanResultsListRequestExecutor::count_results(
    snapshot: &|snapshot|::Snapshot,
    scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest
) -> u64 
crashes Abort
{
    transition { _ -> each(snapshot, scan_results_list_request, 0, 0) }
    machine each(
        snapshot: &|snapshot|::Snapshot,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
        position: u64,
        total: u64
    ) -> u64 {
        let hoist4: u64 = |snapshot|::Snapshot::get_region_count(&snapshot);
        transition position < hoist4 {
            true -> tally(snapshot, scan_results_list_request, position, total)
            false -> (total)
            _ -> (total)
        }
    }
    machine tally(
        snapshot: &|snapshot|::Snapshot,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
        position: u64,
        total: u64
    ) -> u64 {
        let region: |snapshot_region|::SnapshotRegion = |snapshot|::Snapshot::get_region(&snapshot, position);
        let scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&region);
        let region_count: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_number_of_results_for_data_types(&scan_results, &scan_results_list_request.data_type_filters.data_type_refs,
            |snapshot_region|::DataTypeRefSet::get_count(&scan_results_list_request.data_type_filters));
        let next_total: u64 = ((total as u64 in Saturating)
            + (region_count as u64 in Saturating)) as u64;
        transition { _ -> each(snapshot, scan_results_list_request, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, next_total) }
    }
}

// Merge every region's `enumerate_page` output into one address-sorted
// list — upstream's BinaryHeap merge over per-region cursors. The headroom
// bound truncates pages deeper than 64 (a named deviation).
public machine ScanResultsListRequestExecutor::enumerate_all(
    snapshot: &|snapshot|::Snapshot,
    scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
    headroom: u64
) -> |snapshot_region_scan_results|::PageElementList
crashes Abort
{
    transition { _ -> each(snapshot, scan_results_list_request, headroom,
        |snapshot_region_scan_results|::PageElementList::empty(), 0) }
    machine each(
        snapshot: &|snapshot|::Snapshot,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
        headroom: u64,
        out: |snapshot_region_scan_results|::PageElementList,
        region_index: u64
    ) -> |snapshot_region_scan_results|::PageElementList
    {
        let hoist5: u64 = |snapshot|::Snapshot::get_region_count(&snapshot);
        transition region_index < hoist5 {
            true -> merge(snapshot, scan_results_list_request, headroom, out, region_index)
            false -> (out)
        }
    }
    machine merge(
        snapshot: &|snapshot|::Snapshot,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
        headroom: u64,
        out: |snapshot_region_scan_results|::PageElementList,
        region_index: u64
    ) -> |snapshot_region_scan_results|::PageElementList
    {
        let region: |snapshot_region|::SnapshotRegion = |snapshot|::Snapshot::get_region(&snapshot, region_index);
        let scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&region);
        // `enumerate_page` is per-region: zero skip, `headroom` take — the
        // global skip/window applies after the merge.
        let region_page: |snapshot_region_scan_results|::PageElementList = |snapshot_region_scan_results|::SnapshotRegionScanResults::enumerate_page(&scan_results, 0, headroom, &scan_results_list_request.data_type_filters);
        let merged: |snapshot_region_scan_results|::PageElementList = ScanResultsListRequestExecutor::merge_sorted(
            out, &region_page, 0);
        transition { _ -> each(snapshot, scan_results_list_request, headroom,
            merged, ((region_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Sorted-insertion merge of `source` into `dest`.
public machine ScanResultsListRequestExecutor::merge_sorted(
    dest: |snapshot_region_scan_results|::PageElementList,
    source: &|snapshot_region_scan_results|::PageElementList,
    position: u64
) -> |snapshot_region_scan_results|::PageElementList {
    let hoist6: u64 = |snapshot_region_scan_results|::PageElementList::get_element_count(&source);
    transition position < hoist6 {
        true -> insert(dest, source, position)
        _ -> (dest)
    }
    machine insert(dest: |snapshot_region_scan_results|::PageElementList, source: &|snapshot_region_scan_results|::PageElementList, position: u64) -> |snapshot_region_scan_results|::PageElementList {
        let element: |snapshot_region_scan_results|::PageElement = |snapshot_region_scan_results|::PageElementList::get_page_element(&source, position);
        let mut carried: |snapshot_region_scan_results|::PageElementList = dest;
        let _merged: bool = |snapshot_region_scan_results|::PageElementList::insert_sorted(&mut carried, &element);
        transition { _ -> merge_sorted(carried, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Upstream `get_result_counts_by_data_type` merged across regions.
public machine ScanResultsListRequestExecutor::count_by_type(
    snapshot: &|snapshot|::Snapshot,
    scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest
) -> |snapshot_region_scan_results|::DataTypeResultCounts
crashes Abort
{
    transition { _ -> each(snapshot, scan_results_list_request, |snapshot_region_scan_results|::DataTypeResultCounts::empty(), 0) }
    machine each(
        snapshot: &|snapshot|::Snapshot,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
        out: |snapshot_region_scan_results|::DataTypeResultCounts,
        position: u64
    ) -> |snapshot_region_scan_results|::DataTypeResultCounts {
        let hoist7: u64 = |snapshot|::Snapshot::get_region_count(&snapshot);
        transition position < hoist7 {
            true -> merge(snapshot, scan_results_list_request, out, position)
            _ -> (out)
        }
    }
    machine merge(
        snapshot: &|snapshot|::Snapshot,
        scan_results_list_request: &|scan_results_list_request|::ScanResultsListRequest,
        out: |snapshot_region_scan_results|::DataTypeResultCounts,
        position: u64
    ) -> |snapshot_region_scan_results|::DataTypeResultCounts {
        let region: |snapshot_region|::SnapshotRegion = |snapshot|::Snapshot::get_region(&snapshot, position);
        let scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&region);
        let mut carried: |snapshot_region_scan_results|::DataTypeResultCounts = out;
        let region_counts: |snapshot_region_scan_results|::DataTypeResultCounts = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_result_counts_by_data_type(&scan_results);
        |snapshot_region_scan_results|::DataTypeResultCounts::merge_from(&mut carried, &region_counts);
        transition { _ -> each(snapshot, scan_results_list_request, carried, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}
