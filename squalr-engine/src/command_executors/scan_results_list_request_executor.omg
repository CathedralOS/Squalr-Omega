module src::command_executors::scan_results_list_request_executor;

use squalr_engine_api::src::commands::scan_results::list::scan_results_list_request::ScanResultsListRequest;
use squalr_engine_api::src::commands::scan_results::list::scan_results_list_response::ScanResultPage;
use squalr_engine_api::src::commands::scan_results::list::scan_results_list_response::ScanResultsListResponse;
use squalr_engine_api::src::structures::results::snapshot_region_scan_results::DataTypeResultCounts;
use squalr_engine_api::src::structures::results::snapshot_region_scan_results::PageElement;
use squalr_engine_api::src::structures::results::snapshot_region_scan_results::PageElementList;
use squalr_engine_api::src::structures::results::snapshot_region_scan_results::SnapshotRegionScanResults;
use squalr_engine_api::src::structures::scan_results::scan_result::ScanResult;
use squalr_engine_api::src::structures::scan_results::scan_result_base::ScanResultBase;
use squalr_engine_api::src::structures::scan_results::scan_result_ref::ScanResultRef;
use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use squalr_engine_api::src::structures::scan_results::scan_result_enriched::ScanResultEnriched;
use squalr_engine_api::src::structures::scan_results::scan_result_valued::ScanResultValued;
use squalr_engine_api::src::structures::settings::scan_settings::ScanSettings;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use squalr_engine_api::src::structures::snapshots::snapshot_region::SnapshotRegion;
use src::command_executors::scan_result_enricher::ScanResultEnricher;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::os::supplied_memory_source::SuppliedMemorySource;

// Port of commands/scan_results/list/scan_results_list_request_executor.rs:
// `last_page = (count-1)/page_size` (saturating), page contents = the
// globally merged, address-ordered enumeration of every region's scan
// results (upstream's shared BinaryHeap merge — here sorted insertion into
// the bounded page carrier, a named deviation for pages beyond 64
// elements). Each listed element materializes a `ScanResult::Valued` with
// the best-effort live read and the stored previous value.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ScanResultsListRequestExecutor {}

pub machine ScanResultsListRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    scan_results_list_request: &ScanResultsListRequest
) -> ScanResultsListResponse
crashes Abort
{
    let hoist1: bool = EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> count(engine_privileged_state, scan_results_list_request)
        _ -> (ScanResultsListResponse::default())
    }

    state count(
        engine_privileged_state: &mut EnginePrivilegedState,
        scan_results_list_request: &ScanResultsListRequest
    ) -> ScanResultsListResponse
    {
        let settings: ScanSettings = EnginePrivilegedState::get_scan_settings(&engine_privileged_state);
        let snapshot: &Snapshot = EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let result_count: u64 = ScanResultsListRequestExecutor::count_results(
            snapshot, scan_results_list_request);
        transition { _ -> page(
            engine_privileged_state, scan_results_list_request, settings, result_count) }
    }

    state page(
        engine_privileged_state: &mut EnginePrivilegedState,
        scan_results_list_request: &ScanResultsListRequest,
        settings: ScanSettings,
        result_count: u64
    ) -> ScanResultsListResponse
    {
        let page_size: u64 = ScanSettings::get_results_page_size(&settings);
        transition page_size == 0 {
            true -> sized(engine_privileged_state, scan_results_list_request, settings, result_count, 22)
            false -> sized(engine_privileged_state, scan_results_list_request, settings, result_count, page_size)
            _ -> sized(engine_privileged_state, scan_results_list_request, settings, result_count, page_size)
        }
    }
    state sized(
        engine_privileged_state: &mut EnginePrivilegedState,
        scan_results_list_request: &ScanResultsListRequest,
        settings: ScanSettings,
        result_count: u64,
        bounded_page_size: u64
    ) -> ScanResultsListResponse
    {
        transition bounded_page_size > 0 {
            true -> paged(engine_privileged_state, scan_results_list_request, settings, result_count, bounded_page_size)
            false -> paged(engine_privileged_state, scan_results_list_request, settings, result_count, 1)
            _ -> paged(engine_privileged_state, scan_results_list_request, settings, result_count, 1)
        }
    }
    state paged(
        engine_privileged_state: &mut EnginePrivilegedState,
        scan_results_list_request: &ScanResultsListRequest,
        settings: ScanSettings,
        result_count: u64,
        bounded_page_size: u64
    ) -> ScanResultsListResponse
    {
        let last_page: u64 = (((result_count as u64 in Saturating)
            - 1) as u64) / bounded_page_size;
        let results_to_skip: u64 = ((scan_results_list_request.page_index as u64 in Saturating)
            * (bounded_page_size as u64 in Saturating)) as u64;
        // The global merge needs up to `results_to_skip + page_size`
        // head-room per region — every surviving element of a region can
        // sort ahead of another region's.
        let headroom: u64 = ((results_to_skip as u64 in Saturating)
            + (bounded_page_size as u64 in Saturating)) as u64;
        let snapshot: &Snapshot = EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let all: PageElementList = ScanResultsListRequestExecutor::enumerate_all(
            snapshot, scan_results_list_request, headroom);
        transition { _ -> window(
            engine_privileged_state, scan_results_list_request, &all, results_to_skip,
            bounded_page_size, ScanResultPage::empty(), 0, result_count, last_page) }
    }

    // Materialize the page window — elements [skip, skip+page_size) of the
    // merged ordering.
    state window(
        engine_privileged_state: &mut EnginePrivilegedState,
        scan_results_list_request: &ScanResultsListRequest,
        all: &PageElementList,
        results_to_skip: u64,
        page_size: u64,
        page: ScanResultPage,
        position: u64,
        result_count: u64,
        last_page: u64
    ) -> ScanResultsListResponse
    {
        let hoist3: u64 = ScanResultPage::get_count(&page);
        let hoist2: u64 = PageElementList::get_element_count(&all);
        transition position < hoist2
            && position >= results_to_skip
            && hoist3 < page_size {
            true -> element(
                engine_privileged_state, scan_results_list_request, all, results_to_skip,
                page_size, page, position, result_count, last_page)
            false -> finish(engine_privileged_state, scan_results_list_request, page, result_count, last_page, page_size)
        }
    }

    state element(
        engine_privileged_state: &mut EnginePrivilegedState,
        scan_results_list_request: &ScanResultsListRequest,
        all: &PageElementList,
        results_to_skip: u64,
        page_size: u64,
        page: ScanResultPage,
        position: u64,
        result_count: u64,
        last_page: u64
    ) -> ScanResultsListResponse
    {
        let element: PageElement = PageElementList::get_page_element(&all, position);
        // Upstream's best-effort live read for the displayed current value;
        // the previous value comes from the stored snapshot window.
        let source: &SuppliedMemorySource = EnginePrivilegedState::get_supplied_memory_source(&engine_privileged_state);
        let current_value: u64 = SuppliedMemorySource::read_u64(&source, element.address);
        let snapshot: &Snapshot = EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let region: SnapshotRegion = get_region(snapshot, element.collection_index);
        let previous: u64 = SnapshotRegion::get_previous_element(&region, element.element_index);
        let base_dtr: DataTypeRef = element.data_type_ref;
        let base: ScanResultBase = ScanResultBase::new(
            element.address, base_dtr, ScanResultRef::new(element.element_index, false));
        let valued: ScanResultValued = ScanResultBase::new(&base, true, current_value, true, previous);
        // Upstream's module + freeze enrichment (address_to_module +
        // is_address_frozen -> ScanResult::new).
        let enriched: ScanResultEnriched = ScanResultEnricher::enrich(
            engine_privileged_state, valued);
        let mut carried: ScanResultPage = page;
        let pushed: bool = ScanResultPage::push(&mut carried, &ScanResult::Valued { result: enriched });
        transition { _ -> window(
            engine_privileged_state, scan_results_list_request, all, results_to_skip,
            page_size, carried, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, result_count, last_page) }
    }

    state finish(
        engine_privileged_state: &mut EnginePrivilegedState,
        scan_results_list_request: &ScanResultsListRequest,
        page: ScanResultPage,
        result_count: u64,
        last_page: u64,
        page_size: u64
    ) -> ScanResultsListResponse {
        let hoist8: u64 = get_collected_byte_count(snapshot);
        // Upstream fills `data_type_result_counts` +
        // `total_size_in_bytes` from the same snapshot counters.
        let snapshot: &Snapshot = EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let counts: DataTypeResultCounts = ScanResultsListRequestExecutor::count_by_type(
            snapshot, scan_results_list_request);
        ScanResultsListResponse {
            scan_results: page,
            data_type_result_counts: counts,
            page_index: scan_results_list_request.page_index,
            page_size: page_size,
            last_page_index: last_page,
            result_count: result_count,
            total_size_in_bytes: hoist8,
        }
    }
}

// Upstream `get_number_of_results_for_data_types` across every region.
pub machine ScanResultsListRequestExecutor::count_results(
    snapshot: &Snapshot,
    scan_results_list_request: &ScanResultsListRequest
) -> u64 
crashes Abort
{
    transition { _ -> each(snapshot, scan_results_list_request, 0, 0) }
    state each(
        snapshot: &Snapshot,
        scan_results_list_request: &ScanResultsListRequest,
        position: u64,
        total: u64
    ) -> u64 {
        let hoist4: u64 = Snapshot::get_region_count(&snapshot);
        transition position < hoist4 {
            true -> tally(snapshot, scan_results_list_request, position, total)
            false -> (total)
            _ -> (total)
        }
    }
    state tally(
        snapshot: &Snapshot,
        scan_results_list_request: &ScanResultsListRequest,
        position: u64,
        total: u64
    ) -> u64 {
        let region: SnapshotRegion = Snapshot::get_region(&snapshot, position);
        let scan_results: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&region);
        let region_count: u64 = SnapshotRegionScanResults::get_number_of_results_for_data_types(&scan_results, &scan_results_list_request.data_type_filters.data_type_refs,
            DataTypeRefSet::get_count(&scan_results_list_request.data_type_filters));
        let next_total: u64 = ((total as u64 in Saturating)
            + (region_count as u64 in Saturating)) as u64;
        transition { _ -> each(snapshot, scan_results_list_request, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, next_total) }
    }
}

// Merge every region's `enumerate_page` output into one address-sorted
// list — upstream's BinaryHeap merge over per-region cursors. The headroom
// bound truncates pages deeper than 64 (a named deviation).
pub machine ScanResultsListRequestExecutor::enumerate_all(
    snapshot: &Snapshot,
    scan_results_list_request: &ScanResultsListRequest,
    headroom: u64
) -> PageElementList
crashes Abort
{
    transition { _ -> each(snapshot, scan_results_list_request, headroom,
        PageElementList::empty(), 0) }
    state each(
        snapshot: &Snapshot,
        scan_results_list_request: &ScanResultsListRequest,
        headroom: u64,
        out: PageElementList,
        region_index: u64
    ) -> PageElementList
    {
        let hoist5: u64 = Snapshot::get_region_count(&snapshot);
        transition region_index < hoist5 {
            true -> merge(snapshot, scan_results_list_request, headroom, out, region_index)
            false -> (out)
        }
    }
    state merge(
        snapshot: &Snapshot,
        scan_results_list_request: &ScanResultsListRequest,
        headroom: u64,
        out: PageElementList,
        region_index: u64
    ) -> PageElementList
    {
        let region: SnapshotRegion = Snapshot::get_region(&snapshot, region_index);
        let scan_results: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&region);
        // `enumerate_page` is per-region: zero skip, `headroom` take — the
        // global skip/window applies after the merge.
        let region_page: PageElementList = SnapshotRegionScanResults::enumerate_page(&scan_results, 0, headroom, &scan_results_list_request.data_type_filters);
        let merged: PageElementList = ScanResultsListRequestExecutor::merge_sorted(
            out, &region_page, 0);
        transition { _ -> each(snapshot, scan_results_list_request, headroom,
            merged, ((region_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Sorted-insertion merge of `source` into `dest`.
pub machine ScanResultsListRequestExecutor::merge_sorted(
    dest: PageElementList,
    source: &PageElementList,
    position: u64
) -> PageElementList {
    let hoist6: u64 = PageElementList::get_element_count(&source);
    transition position < hoist6 {
        true -> insert(dest, source, position)
        _ -> (dest)
    }
    state insert(dest: PageElementList, source: &PageElementList, position: u64) -> PageElementList {
        let element: PageElement = PageElementList::get_page_element(&source, position);
        let mut carried: PageElementList = dest;
        let _merged: bool = PageElementList::insert_sorted(&mut carried, &element);
        transition { _ -> merge_sorted(carried, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Upstream `get_result_counts_by_data_type` merged across regions.
pub machine ScanResultsListRequestExecutor::count_by_type(
    snapshot: &Snapshot,
    scan_results_list_request: &ScanResultsListRequest
) -> DataTypeResultCounts 
crashes Abort
{
    transition { _ -> each(snapshot, scan_results_list_request, DataTypeResultCounts::empty(), 0) }
    state each(
        snapshot: &Snapshot,
        scan_results_list_request: &ScanResultsListRequest,
        out: DataTypeResultCounts,
        position: u64
    ) -> DataTypeResultCounts {
        let hoist7: u64 = Snapshot::get_region_count(&snapshot);
        transition position < hoist7 {
            true -> merge(snapshot, scan_results_list_request, out, position)
            _ -> (out)
        }
    }
    state merge(
        snapshot: &Snapshot,
        scan_results_list_request: &ScanResultsListRequest,
        out: DataTypeResultCounts,
        position: u64
    ) -> DataTypeResultCounts {
        let region: SnapshotRegion = Snapshot::get_region(&snapshot, position);
        let scan_results: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&region);
        let mut carried: DataTypeResultCounts = out;
        let region_counts: DataTypeResultCounts = SnapshotRegionScanResults::get_result_counts_by_data_type(&scan_results);
        DataTypeResultCounts::merge_from(&mut carried, &region_counts);
        transition { _ -> each(snapshot, scan_results_list_request, carried, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}
