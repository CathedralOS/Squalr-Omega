module src::command_executors::registry_command_executor;

use squalr_engine_api::src::commands::registry::get_metadata::registry_get_metadata_request::RegistryGetMetadataRequest;
use squalr_engine_api::src::commands::registry::get_metadata::registry_get_metadata_response::RegistryGetMetadataResponse;
use squalr_engine_api::src::commands::registry::registry_command::RegistryCommand;
use squalr_engine_api::src::commands::registry::registry_response::RegistryResponse;
use squalr_engine_api::src::commands::registry::set_project_symbols::registry_set_project_symbols_request::RegistrySetProjectSymbolsRequest;
use squalr_engine_api::src::commands::registry::set_project_symbols::registry_set_project_symbols_response::RegistrySetProjectSymbolsResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::registry_get_metadata_request_executor::RegistryGetMetadataRequestExecutor;
use src::command_executors::registry_set_project_symbols_request_executor::RegistrySetProjectSymbolsRequestExecutor;

// Port of command_executors/registry/registry_command_executor.rs — routes
// the registry command union to the per-leaf executor and wraps each
// typed response in the matching `RegistryResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data RegistryCommandExecutor {}

pub machine RegistryCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    registry_command: &RegistryCommand
) -> RegistryResponse {
    transition registry_command {
        RegistryCommand::GetMetadata { registry_get_metadata_request } -> get_metadata(engine_privileged_state, &registry_get_metadata_request)
        RegistryCommand::SetProjectSymbols { registry_set_project_symbols_request } -> set_project_symbols(engine_privileged_state, &registry_set_project_symbols_request)
    }

    state get_metadata(
        engine_privileged_state: &mut EnginePrivilegedState,
        registry_get_metadata_request: &RegistryGetMetadataRequest
    ) -> RegistryResponse {
        let response: RegistryGetMetadataResponse = RegistryGetMetadataRequestExecutor::execute(
            engine_privileged_state, registry_get_metadata_request);
        transition { _ -> (RegistryResponse::GetMetadata { registry_get_metadata_response: response }) }
    }

    state set_project_symbols(
        engine_privileged_state: &mut EnginePrivilegedState,
        registry_set_project_symbols_request: &RegistrySetProjectSymbolsRequest
    ) -> RegistryResponse {
        let response: RegistrySetProjectSymbolsResponse = RegistrySetProjectSymbolsRequestExecutor::execute(
            engine_privileged_state, registry_set_project_symbols_request);
        transition { _ -> (RegistryResponse::SetProjectSymbols { registry_set_project_symbols_response: response }) }
    }
}
