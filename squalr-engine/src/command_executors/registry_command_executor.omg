use {squalr_engine_api}/src/commands/registry/get_metadata/registry_get_metadata_request.omg;
use {squalr_engine_api}/src/commands/registry/get_metadata/registry_get_metadata_response.omg;
use {squalr_engine_api}/src/commands/registry/registry_command.omg;
use {squalr_engine_api}/src/commands/registry/registry_response.omg;
use {squalr_engine_api}/src/commands/registry/set_project_symbols/registry_set_project_symbols_request.omg;
use {squalr_engine_api}/src/commands/registry/set_project_symbols/registry_set_project_symbols_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/registry_get_metadata_request_executor.omg;
use src/command_executors/registry_set_project_symbols_request_executor.omg;

// Port of command_executors/registry/registry_command_executor.rs — routes
// the registry command union to the per-leaf executor and wraps each
// typed response in the matching `RegistryResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data RegistryCommandExecutor {}

public machine RegistryCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    registry_command: &|registry_command|::RegistryCommand
) -> |registry_response|::RegistryResponse {
    transition registry_command {
        |registry_command|::RegistryCommand::GetMetadata { registry_get_metadata_request } -> get_metadata(engine_privileged_state, &registry_get_metadata_request)
        |registry_command|::RegistryCommand::SetProjectSymbols { registry_set_project_symbols_request } -> set_project_symbols(engine_privileged_state, &registry_set_project_symbols_request)
    }

    machine get_metadata(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        registry_get_metadata_request: &|registry_get_metadata_request|::RegistryGetMetadataRequest
    ) -> |registry_response|::RegistryResponse {
        let response: |registry_get_metadata_response|::RegistryGetMetadataResponse = |registry_get_metadata_request_executor|::RegistryGetMetadataRequestExecutor::execute(
            engine_privileged_state, registry_get_metadata_request);
        transition { _ -> (|registry_response|::RegistryResponse::GetMetadata { registry_get_metadata_response: response }) }
    }

    machine set_project_symbols(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        registry_set_project_symbols_request: &|registry_set_project_symbols_request|::RegistrySetProjectSymbolsRequest
    ) -> |registry_response|::RegistryResponse {
        let response: |registry_set_project_symbols_response|::RegistrySetProjectSymbolsResponse = |registry_set_project_symbols_request_executor|::RegistrySetProjectSymbolsRequestExecutor::execute(
            engine_privileged_state, registry_set_project_symbols_request);
        transition { _ -> (|registry_response|::RegistryResponse::SetProjectSymbols { registry_set_project_symbols_response: response }) }
    }
}
