use {squalr_engine_api}/src/commands/plugins/set_order/plugin_set_order_request.omg;
use {squalr_engine_api}/src/commands/plugins/set_order/plugin_set_order_response.omg;
use {squalr_engine_api}/src/events/engine_event.omg;
use {squalr_engine_api}/src/events/plugins/changed/plugins_changed_event.omg;
use {squalr_engine_api}/src/plugins/plugin_id.omg;
use {squalr_engine_api}/src/plugins/plugin_state.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/plugins/plugin_registry.omg;

// Port of command_executors/plugins/set_order/
// plugin_set_order_request_executor.rs — `set_plugin_order` then, only when
// it updated: `invalidate_memory_view_runtime_state` +
// `notify_registry_changed` + `PluginsChangedEvent` — all three
// unconditionally inside the update arm, unlike set_enabled's
// capability-keyed guards.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data PluginSetOrderRequestExecutor {}

public machine PluginSetOrderRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    plugin_set_order_request: &|plugin_set_order_request|::PluginSetOrderRequest
) -> |plugin_set_order_response|::PluginSetOrderResponse {
    transition { _ -> apply(engine_privileged_state, plugin_set_order_request) }

    machine apply(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|plugin_set_order_request|::PluginSetOrderRequest
    ) -> |plugin_set_order_response|::PluginSetOrderResponse {
        let registry: &mut |plugin_registry|::PluginRegistry = |engine_privileged_state|::EnginePrivilegedState::borrow_plugin_registry_mut(&mut engine_privileged_state);
        let did_update: bool = |plugin_registry|::PluginRegistry::set_plugin_order(&mut registry, request);
        transition did_update {
            true -> invalidate(engine_privileged_state)
            _ -> walk(engine_privileged_state, |plugin_set_order_response|::PluginSetOrderResponse::new(), did_update, 0)
        }
    }

    machine invalidate(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
    ) -> |plugin_set_order_response|::PluginSetOrderResponse {
        |engine_privileged_state|::EnginePrivilegedState::invalidate_memory_view_runtime_state(&mut engine_privileged_state);
        transition { _ -> notify(engine_privileged_state) }
    }

    machine notify(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
    ) -> |plugin_set_order_response|::PluginSetOrderResponse {
        |engine_privileged_state|::EnginePrivilegedState::notify_registry_changed(&mut engine_privileged_state);
        transition { _ -> emit(engine_privileged_state) }
    }

    // `EnginePrivilegedState::emit_event(&mut PluginsChangedEvent {})`.
    machine emit(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
    ) -> |plugin_set_order_response|::PluginSetOrderResponse {
        let changed_event: |plugins_changed_event|::PluginsChangedEvent = |plugins_changed_event|::PluginsChangedEvent::new();
        let engine_event: |engine_event|::EngineEvent = |plugins_changed_event|::PluginsChangedEvent::to_engine_event(&changed_event);
        _ = |engine_privileged_state|::EnginePrivilegedState::emit_event(&mut engine_privileged_state, &engine_event);
        transition { _ -> walk(engine_privileged_state, |plugin_set_order_response|::PluginSetOrderResponse::new(), true, 0) }
    }

    machine walk(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_set_order_response|::PluginSetOrderResponse,
        did_update: bool,
        ordinal: u64
    ) -> |plugin_set_order_response|::PluginSetOrderResponse {
        let registry: &|plugin_registry|::PluginRegistry = |engine_privileged_state|::EnginePrivilegedState::get_plugin_registry(&engine_privileged_state);
        let hoist1: u64 = |plugin_registry|::PluginRegistry::get_plugin_order_count(&registry);
        transition ordinal < hoist1 && ordinal < 8 {
            true -> append(engine_privileged_state, response, did_update, ordinal)
            _ -> set_process_info(engine_privileged_state, response, did_update)
        }
    }

    machine append(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_set_order_response|::PluginSetOrderResponse,
        did_update: bool,
        ordinal: u64
    ) -> |plugin_set_order_response|::PluginSetOrderResponse
        requires ordinal < 8
    {
        let registry: &|plugin_registry|::PluginRegistry = |engine_privileged_state|::EnginePrivilegedState::get_plugin_registry(&engine_privileged_state);
        let position: u64 = |plugin_registry|::PluginRegistry::get_ordered_plugin_position(&registry, ordinal);
        transition position < 8 {
            true -> push(engine_privileged_state, response, did_update, ordinal, position)
            _ -> walk(engine_privileged_state, response, did_update, ((ordinal as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    machine push(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_set_order_response|::PluginSetOrderResponse,
        did_update: bool,
        ordinal: u64,
        position: u64
    ) -> |plugin_set_order_response|::PluginSetOrderResponse
        requires ordinal < 8 && position < 8
    {
        let registry: &|plugin_registry|::PluginRegistry = |engine_privileged_state|::EnginePrivilegedState::get_plugin_registry(&engine_privileged_state);
        let plugin_state: |plugin_state|::PluginState = |plugin_registry|::PluginRegistry::get_plugin_state_at(&registry, position);
        _ = |plugin_set_order_response|::PluginSetOrderResponse::add_plugin(&mut response, &plugin_state);
        transition {
            _ -> walk(engine_privileged_state, response, did_update, ((ordinal as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    machine set_process_info(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_set_order_response|::PluginSetOrderResponse,
        did_update: bool
    ) -> |plugin_set_order_response|::PluginSetOrderResponse {
        let hoist2: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
        transition hoist2 {
            true -> set_present(engine_privileged_state, response, did_update)
            _ -> fill_default_ids(engine_privileged_state, response, did_update, 0)
        }
    }

    machine set_present(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_set_order_response|::PluginSetOrderResponse,
        did_update: bool
    ) -> |plugin_set_order_response|::PluginSetOrderResponse {
        let opened_process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        |plugin_set_order_response|::PluginSetOrderResponse::set_opened_process_info(&mut response, opened_process_info);
        transition { _ -> fill_default_ids(engine_privileged_state, response, did_update, 0) }
    }

    machine fill_default_ids(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_set_order_response|::PluginSetOrderResponse,
        did_update: bool,
        position: u64
    ) -> |plugin_set_order_response|::PluginSetOrderResponse {
        let registry: &|plugin_registry|::PluginRegistry = |engine_privileged_state|::EnginePrivilegedState::get_plugin_registry(&engine_privileged_state);
        let hoist3: u64 = |plugin_registry|::PluginRegistry::get_plugin_count(registry);
        transition position < hoist3 && position < 8 {
            true -> push_id(engine_privileged_state, response, did_update, position)
            _ -> finish(response, did_update)
        }
    }

    machine push_id(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_set_order_response|::PluginSetOrderResponse,
        did_update: bool,
        position: u64
    ) -> |plugin_set_order_response|::PluginSetOrderResponse
        requires position < 8
    {
        let registry: &|plugin_registry|::PluginRegistry = |engine_privileged_state|::EnginePrivilegedState::get_plugin_registry(&engine_privileged_state);
        let plugin_id: |plugin_id|::PluginId = |plugin_registry|::PluginRegistry::get_default_plugin_id_at(&registry, position);
        _ = |plugin_set_order_response|::PluginSetOrderResponse::add_default_plugin_id(&mut response, &plugin_id);
        transition {
            _ -> fill_default_ids(engine_privileged_state, response, did_update, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    machine finish(
        mut response: |plugin_set_order_response|::PluginSetOrderResponse,
        did_update: bool
    ) -> |plugin_set_order_response|::PluginSetOrderResponse {
        |plugin_set_order_response|::PluginSetOrderResponse::set_did_update(&mut response, did_update);
        transition { _ -> (response) }
    }
}
