module src::command_executors::project_command_executor;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::project::project_command::ProjectCommand;
use squalr_engine_api::src::commands::project::close::project_close_response::ProjectCloseResponse;
use squalr_engine_api::src::commands::project::create::project_create_response::ProjectCreateResponse;
use squalr_engine_api::src::commands::project::delete::project_delete_response::ProjectDeleteResponse;
use squalr_engine_api::src::commands::project::export::project_export_response::ProjectExportResponse;
use squalr_engine_api::src::commands::project::list::project_list_response::ProjectListResponse;
use squalr_engine_api::src::commands::project::open::project_open_response::ProjectOpenResponse;
use squalr_engine_api::src::commands::project::rename::project_rename_response::ProjectRenameResponse;
use squalr_engine_api::src::commands::project::save::project_save_response::ProjectSaveResponse;
use squalr_engine_api::src::commands::unprivileged_command_response::UnprivilegedCommandResponse;
use squalr_engine_api::src::commands::typed_unprivileged_command_response;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use src::engine_bindings::standalone_engine_api_unprivileged_bindings::StandaloneEngineApiUnprivilegedBindings;
use src::command_executors::project_close_request_executor::ProjectCloseRequestExecutor;
use src::command_executors::project_create_request_executor::ProjectCreateRequestExecutor;
use src::command_executors::project_delete_request_executor::ProjectDeleteRequestExecutor;
use src::command_executors::project_export_request_executor::ProjectExportRequestExecutor;
use src::command_executors::project_list_request_executor::ProjectListRequestExecutor;
use src::command_executors::project_open_request_executor::ProjectOpenRequestExecutor;
use src::command_executors::project_rename_request_executor::ProjectRenameRequestExecutor;
use src::command_executors::project_save_request_executor::ProjectSaveRequestExecutor;

// Port of command_executors/project/project_command_executor.rs — the
// domain router: each command arm executes its leaf request and wraps the
// leaf response into the root union through the leaf's
// `to_engine_response` (upstream's `.to_engine_response()` call).
pub data ProjectCommandExecutor {}

pub machine ProjectCommandExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_command: &ProjectCommand
) -> UnprivilegedCommandResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    transition project_command {
        ProjectCommand::Close { request } -> (ProjectCloseResponse::to_engine_response(ProjectCloseRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectCommand::Create { request } -> (ProjectCreateResponse::to_engine_response(ProjectCreateRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectCommand::Delete { request } -> (ProjectDeleteResponse::to_engine_response(ProjectDeleteRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectCommand::Export { request } -> (ProjectExportResponse::to_engine_response(ProjectExportRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectCommand::List { request } -> (ProjectListResponse::to_engine_response(ProjectListRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectCommand::Open { request } -> (ProjectOpenResponse::to_engine_response(ProjectOpenRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectCommand::Rename { request } -> (ProjectRenameResponse::to_engine_response(ProjectRenameRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectCommand::Save { request } -> (ProjectSaveResponse::to_engine_response(ProjectSaveRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
    }
}
