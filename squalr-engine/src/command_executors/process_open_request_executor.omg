use {omega}/language/core/filesystem_authority.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/commands/process/open/process_open_request.omg;
use {squalr_engine_api}/src/commands/process/open/process_open_response.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_api}/src/structures/processes/process_info.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/os/engine_os_provider.omg;
use {squalr_engine_targets}/src/process_query/process_query_options.omg;
use {squalr_engine_targets}/src/target_providers.omg;

// Port of command_executors/process/open/process_open_request_executor.rs —
// the open resolves through the same provider sweep as the list (pid or
// name filter, first match, limit one), opens the matched process and
// stores it as the state's opened process. Both filters absent -> an empty
// response, matching upstream's early return.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ProcessOpenRequestExecutor {}

public linux_x86_64 machine ProcessOpenRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    request: &|process_open_request|::ProcessOpenRequest
) -> |process_open_response|::ProcessOpenResponse
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
crashes Trap
{
    let response: |process_open_response|::ProcessOpenResponse = |process_open_response|::ProcessOpenResponse::new();
    let hoist2: bool = |process_open_request|::ProcessOpenRequest::has_search_name(&request);
    let hoist1: bool = |process_open_request|::ProcessOpenRequest::has_process_id(&request);
    transition hoist1 || hoist2 {
        true -> query(engine_privileged_state, request, response)
        false -> (response)
        _ -> (response)
    }

    machine query(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|process_open_request|::ProcessOpenRequest,
        response: |process_open_response|::ProcessOpenResponse
    ) -> |process_open_response|::ProcessOpenResponse {
        let hoist6: bool = |process_open_request|::ProcessOpenRequest::get_match_case(&request);
        let name_view: &[u8] = |process_open_request|::ProcessOpenRequest::get_search_name(&request);
        let mut name: [u8; 256];
        let name_len: u64 = ProcessOpenRequestExecutor::copy_bounded_name(name_view, &mut name);
        let mut found: [|process_info|::ProcessInfo; 1];
        let options: |process_query_options|::ProcessQueryOptions = |process_query_options|::ProcessQueryOptions {
            required_process_id: ProcessOpenRequestExecutor::required_process_id(request),
            search_name: ProcessOpenRequestExecutor::search_name(request, name, name_len),
            require_windowed: false,
            match_case: hoist6,
            fetch_icons: false,
            limit: |process_query_options|::ProcessQueryLimit::Limited { limit: 1 }
        };
        let providers: &mut |engine_os_provider|::EngineOsProviders = |engine_privileged_state|::EnginePrivilegedState::get_os_providers(&mut engine_privileged_state);
        let outcome: |target_providers|::ProcessListOutcome = |engine_os_provider|::EngineOsProviders::get_processes(providers, options, &mut found);
        transition outcome {
            |target_providers|::ProcessListOutcome::Listed { count, truncated } -> matched(engine_privileged_state, response, found, count)
            |target_providers|::ProcessListOutcome::Failed { error } -> (response)
            _ -> (response)
        }
    }

    machine matched(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        response: |process_open_response|::ProcessOpenResponse,
        found: [|process_info|::ProcessInfo; 1],
        count: u64
    ) -> |process_open_response|::ProcessOpenResponse {
        transition count > 0 {
            true -> open(engine_privileged_state, response, &found[0])
            false -> (response)
            _ -> (response)
        }
    }

    machine open(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |process_open_response|::ProcessOpenResponse,
        process_info: &|process_info|::ProcessInfo
    ) -> |process_open_response|::ProcessOpenResponse {
        let providers: &mut |engine_os_provider|::EngineOsProviders = |engine_privileged_state|::EnginePrivilegedState::get_os_providers(&mut engine_privileged_state);
        let result: |target_providers|::OpenedProcessResult = |engine_os_provider|::EngineOsProviders::open_process(providers, process_info);
        let hoist3: bool = |target_providers|::OpenedProcessResult::succeeded(&result);
        transition hoist3 {
            true -> opened(engine_privileged_state, response, result)
            false -> (response)
            _ -> (response)
        }
    }

    machine opened(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |process_open_response|::ProcessOpenResponse,
        result: |target_providers|::OpenedProcessResult
    ) -> |process_open_response|::ProcessOpenResponse {
        |engine_privileged_state|::EnginePrivilegedState::set_opened_process(&mut engine_privileged_state, result.info);
        |process_open_response|::ProcessOpenResponse::set_opened_process_info(&mut response, result.info);
        (response)
    }
}

machine ProcessOpenRequestExecutor::required_process_id(
    request: &|process_open_request|::ProcessOpenRequest
) -> |process_query_options|::RequiredProcessId {
    let hoist7: u32 = |process_open_request|::ProcessOpenRequest::get_process_id(&request);
    let hoist4: bool = |process_open_request|::ProcessOpenRequest::has_process_id(&request);
    transition hoist4 {
        true -> (|process_query_options|::RequiredProcessId::Required { process_id: hoist7 })
        false -> (|process_query_options|::RequiredProcessId::Any)
        _ -> (|process_query_options|::RequiredProcessId::Any)
    }
}

machine ProcessOpenRequestExecutor::copy_bounded_name(name: &[u8], out: &mut [u8; 256]) -> u64 {
    transition { _ -> copy(name, out, 0) }

    machine copy(name: &[u8], out: &mut [u8; 256], position: u64) -> u64 {
        transition position < name.len && position < 256 {
            true -> store(name, out, position)
            false -> (position)
            _ -> (position)
        }
    }

    machine store(name: &[u8], out: &mut [u8; 256], position: u64) -> u64
        requires 0 <= position && position < name.len && position < 256;
    {
        out[position] = name[position];
        transition { _ -> copy(name, out, position + 1) }
    }
}

machine ProcessOpenRequestExecutor::search_name(
    request: &|process_open_request|::ProcessOpenRequest,
    name: [u8; 256],
    name_len: u64
) -> |process_query_options|::ProcessNameSearch {
    let hoist5: bool = |process_open_request|::ProcessOpenRequest::has_search_name(&request);
    transition hoist5 {
        true -> (|process_query_options|::ProcessNameSearch::Named { name: name, name_len: name_len })
        false -> (|process_query_options|::ProcessNameSearch::Any)
        _ -> (|process_query_options|::ProcessNameSearch::Any)
    }
}
