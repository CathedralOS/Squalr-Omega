module src::command_executors::plugin_set_enabled_request_executor;

use squalr_engine_api::src::commands::plugins::set_enabled::plugin_set_enabled_request::PluginSetEnabledRequest;
use squalr_engine_api::src::commands::plugins::set_enabled::plugin_set_enabled_response::PluginSetEnabledResponse;
use squalr_engine_api::src::events::engine_event::EngineEvent;
use squalr_engine_api::src::events::plugins::changed::plugins_changed_event::PluginsChangedEvent;
use squalr_engine_api::src::plugins::plugin_capability::PluginCapability;
use squalr_engine_api::src::plugins::plugin_id::PluginId;
use squalr_engine_api::src::plugins::plugin_state::PluginState;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::plugins::plugin_registry::PluginRegistry;

// Port of command_executors/plugins/set_enabled/
// plugin_set_enabled_request_executor.rs — `set_plugin_enabled` then, only
// when it updated: MemoryView cap -> `invalidate_memory_view_runtime_state`,
// DataType|InstructionSet cap -> `notify_registry_changed`, and a
// `PluginsChangedEvent` emit. Response carries the refreshed states +
// opened process info + default ids + `did_update`.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data PluginSetEnabledRequestExecutor {}

pub machine PluginSetEnabledRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    plugin_set_enabled_request: &PluginSetEnabledRequest
) -> PluginSetEnabledResponse {
    let plugin_id: &[u8] = plugin_set_enabled_request.get_plugin_id();
    let is_enabled: bool = plugin_set_enabled_request.get_is_enabled();
    transition { _ -> apply(engine_privileged_state, plugin_id, is_enabled) }

    state apply(
        engine_privileged_state: &mut EnginePrivilegedState,
        plugin_id: &[u8],
        is_enabled: bool
    ) -> PluginSetEnabledResponse {
        let registry: &mut PluginRegistry = engine_privileged_state.borrow_plugin_registry_mut();
        let did_update: bool = registry.set_plugin_enabled(plugin_id, is_enabled);
        transition did_update {
            true -> check_memory_view(engine_privileged_state, plugin_id)
            _ -> fill_plugins(engine_privileged_state, did_update, 0)
        }
    }

    // `has_plugin_capability(plugin_id, MemoryView)` -> invalidate.
    state check_memory_view(
        engine_privileged_state: &mut EnginePrivilegedState,
        plugin_id: &[u8]
    ) -> PluginSetEnabledResponse {
        let registry: &PluginRegistry = engine_privileged_state.get_plugin_registry();
        let has_memory_view: bool = registry.has_plugin_capability(plugin_id, PluginCapability::MemoryView);
        transition has_memory_view {
            true -> invalidate_view(engine_privileged_state, plugin_id)
            _ -> check_data_type(engine_privileged_state, plugin_id)
        }
    }

    state invalidate_view(
        engine_privileged_state: &mut EnginePrivilegedState,
        plugin_id: &[u8]
    ) -> PluginSetEnabledResponse {
        engine_privileged_state.invalidate_memory_view_runtime_state();
        transition { _ -> check_data_type(engine_privileged_state, plugin_id) }
    }

    // `DataType || InstructionSet` cap -> `notify_registry_changed`.
    state check_data_type(
        engine_privileged_state: &mut EnginePrivilegedState,
        plugin_id: &[u8]
    ) -> PluginSetEnabledResponse {
        let registry: &PluginRegistry = engine_privileged_state.get_plugin_registry();
        let has_data_type: bool = registry.has_plugin_capability(plugin_id, PluginCapability::DataType);
        let has_instruction_set: bool = registry.has_plugin_capability(plugin_id, PluginCapability::InstructionSet);
        transition has_data_type || has_instruction_set {
            true -> notify(engine_privileged_state)
            _ -> emit(engine_privileged_state)
        }
    }

    state notify(
        engine_privileged_state: &mut EnginePrivilegedState
    ) -> PluginSetEnabledResponse {
        engine_privileged_state.notify_registry_changed();
        transition { _ -> emit(engine_privileged_state) }
    }

    // `emit_event(PluginsChangedEvent {})`.
    state emit(
        engine_privileged_state: &mut EnginePrivilegedState
    ) -> PluginSetEnabledResponse {
        let changed_event: PluginsChangedEvent = PluginsChangedEvent::new();
        let engine_event: EngineEvent = changed_event.to_engine_event();
        _ = engine_privileged_state.emit_event(&engine_event);
        transition { _ -> fill_plugins(engine_privileged_state, true, 0) }
    }

    state fill_plugins(
        engine_privileged_state: &mut EnginePrivilegedState,
        did_update: bool,
        ordinal: u64
    ) -> PluginSetEnabledResponse {
        transition { _ -> walk(engine_privileged_state, PluginSetEnabledResponse::new(), did_update, ordinal) }
    }

    state walk(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginSetEnabledResponse,
        did_update: bool,
        ordinal: u64
    ) -> PluginSetEnabledResponse {
        let registry: &PluginRegistry = engine_privileged_state.get_plugin_registry();
        transition ordinal < registry.get_plugin_order_count() && ordinal < 8 {
            true -> append(engine_privileged_state, response, did_update, ordinal)
            _ -> set_process_info(engine_privileged_state, response, did_update)
        }
    }

    state append(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginSetEnabledResponse,
        did_update: bool,
        ordinal: u64
    ) -> PluginSetEnabledResponse
        requires ordinal < 8
    {
        let registry: &PluginRegistry = engine_privileged_state.get_plugin_registry();
        let position: u64 = registry.get_ordered_plugin_position(ordinal);
        transition position < 8 {
            true -> push(engine_privileged_state, response, did_update, ordinal, position)
            _ -> walk(engine_privileged_state, response, did_update, ((ordinal as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    state push(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginSetEnabledResponse,
        did_update: bool,
        ordinal: u64,
        position: u64
    ) -> PluginSetEnabledResponse
        requires ordinal < 8 && position < 8
    {
        let registry: &PluginRegistry = engine_privileged_state.get_plugin_registry();
        let plugin_state: PluginState = registry.get_plugin_state_at(position);
        _ = response.add_plugin(&plugin_state);
        transition {
            _ -> walk(engine_privileged_state, response, did_update, ((ordinal as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    state set_process_info(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginSetEnabledResponse,
        did_update: bool
    ) -> PluginSetEnabledResponse {
        transition engine_privileged_state.has_opened_process() {
            true -> set_present(engine_privileged_state, response, did_update)
            _ -> fill_default_ids(engine_privileged_state, response, did_update, 0)
        }
    }

    state set_present(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginSetEnabledResponse,
        did_update: bool
    ) -> PluginSetEnabledResponse {
        let opened_process_info: OpenedProcessInfo = engine_privileged_state.get_opened_process();
        response.set_opened_process_info(opened_process_info);
        transition { _ -> fill_default_ids(engine_privileged_state, response, did_update, 0) }
    }

    state fill_default_ids(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginSetEnabledResponse,
        did_update: bool,
        position: u64
    ) -> PluginSetEnabledResponse {
        let registry: &PluginRegistry = engine_privileged_state.get_plugin_registry();
        transition position < registry.get_plugin_count() && position < 8 {
            true -> push_id(engine_privileged_state, response, did_update, position)
            _ -> finish(response, did_update)
        }
    }

    state push_id(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginSetEnabledResponse,
        did_update: bool,
        position: u64
    ) -> PluginSetEnabledResponse
        requires position < 8
    {
        let registry: &PluginRegistry = engine_privileged_state.get_plugin_registry();
        let plugin_id: PluginId = registry.get_default_plugin_id_at(position);
        _ = response.add_default_plugin_id(&plugin_id);
        transition {
            _ -> fill_default_ids(engine_privileged_state, response, did_update, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    state finish(
        mut response: PluginSetEnabledResponse,
        did_update: bool
    ) -> PluginSetEnabledResponse {
        response.set_did_update(did_update);
        transition { _ -> (response) }
    }
}
