use {squalr_engine_api}/src/commands/settings/memory/list/memory_settings_list_request.omg;
use {squalr_engine_api}/src/commands/settings/memory/list/memory_settings_list_response.omg;
use {squalr_engine_api}/src/structures/settings/memory_settings.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/settings/memory/list/memory_settings_list_request_executor.rs —
// upstream clones the full settings out of memory_settings_config.rs's `MemorySettingsConfig::get_full_config().read()`;
// the upstream read-lock failure arm (`Err(SettingsError::read_failure("memory"))`) is unreachable: the port reads a session field, not a shared lock. Upstream's `Ok(...)` arm is the only reachable case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data MemorySettingsListRequestExecutor {}

public machine MemorySettingsListRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    memory_settings_list_request: &|memory_settings_list_request|::MemorySettingsListRequest
) -> |memory_settings_list_response|::MemorySettingsListResponse {
    let settings: |memory_settings|::MemorySettings = |engine_privileged_state|::EnginePrivilegedState::get_memory_settings(&engine_privileged_state);
    let result: |memory_settings_list_response|::MemorySettingsResult = |memory_settings_list_response|::MemorySettingsResult::new_ok(settings);
    (|memory_settings_list_response|::MemorySettingsListResponse::new(result))
}
