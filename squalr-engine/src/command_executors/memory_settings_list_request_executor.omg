module src::command_executors::memory_settings_list_request_executor;

use squalr_engine_api::src::commands::settings::memory::list::memory_settings_list_request::MemorySettingsListRequest;
use squalr_engine_api::src::commands::settings::memory::list::memory_settings_list_response::MemorySettingsListResponse;
use squalr_engine_api::src::commands::settings::memory::list::memory_settings_list_response::MemorySettingsResult;
use squalr_engine_api::src::structures::settings::memory_settings::MemorySettings;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/settings/memory/list/memory_settings_list_request_executor.rs —
// upstream clones the full settings out of memory_settings_config.rs's `MemorySettingsConfig::get_full_config().read()`;
// the upstream read-lock failure arm (`Err(SettingsError::read_failure("memory"))`) is unreachable: the port reads a session field, not a shared lock. Upstream's `Ok(...)` arm is the only reachable case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data MemorySettingsListRequestExecutor {}

pub machine MemorySettingsListRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    memory_settings_list_request: &MemorySettingsListRequest
) -> MemorySettingsListResponse {
    let settings: MemorySettings = EnginePrivilegedState::get_memory_settings(&engine_privileged_state);
    let result: MemorySettingsResult = MemorySettingsResult::new_ok(settings);
    (MemorySettingsListResponse::new(result))
}
