module src::command_executors::element_scanner;

use squalr_engine_api::src::structures::scan_results::scan_results_metadata::ScanResultsMetadata;
use squalr_engine_api::src::structures::scanning::plans::element_scan::element_scan_plan::ElementScanPlan;
use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use squalr_engine_api::src::structures::scanning::plans::element_scan::element_scan_plan::TypePlanList;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter_collection::SnapshotRegionFilterCollection;
use squalr_engine_api::src::structures::results::snapshot_region_scan_results::SnapshotRegionScanResults;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use squalr_engine_api::src::structures::snapshots::snapshot_region::SnapshotRegion;
use squalr_engine_scanning::src::scanners::scan_control::ScanControl;
use src::command_executors::element_scan_dispatcher::ElementScanChainDispatcher;

// Port of `ElementScanner::scan_snapshot` (single-threaded leg). Per region:
// seed scan results for the plan's data types, dispatch each collection
// through the constraint chain, install the results, resize the region to
// its surviving filters, and finally drop empty regions — the exact upstream
// ordering.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ElementScannerDriver {}

// Upstream `scan_snapshot(snapshot, symbol_registry, plan, scan_control,
// with_logging, refresh)`: the owned-model port carries `scan_control` by
// `&mut` since cancellation and the reported progress write onto the
// control object (upstream reads a shared atomic + invokes a closure).
pub machine ElementScannerDriver::scan_snapshot(
    snapshot: &mut Snapshot,
    element_scan_plan: &ElementScanPlan,
    scan_control: &mut ScanControl
) -> ScanResultsMetadata
crashes Abort
{
    // Upstream calls `commit_deleted_scan_result_indices` first: pending
    // tombstones become structural before a fresh scan recomputes results.
    let committed_deleted_result_count: u64 = snapshot.commit_deleted_scan_result_indices();
    let total_region_count: u64 = snapshot.get_region_count();
    snapshot.initialize_all_scan_results(
        element_scan_plan.clone_data_type_refs(),
        element_scan_plan.get_memory_alignment());
    ElementScannerDriver::scan_regions(
        snapshot, element_scan_plan, scan_control, 0, 0, total_region_count);
    snapshot.discard_empty_regions();
    ElementScannerDriver::collect_metadata(snapshot, 0, 0)
}

// Per-region scan over the snapshot — the sequential equivalent of
// upstream's `snapshot_regions.iter_mut().for_each(scan_region)` under the
// single-thread setting.
pub machine ElementScannerDriver::scan_regions(
    snapshot: &mut Snapshot,
    element_scan_plan: &ElementScanPlan,
    scan_control: &mut ScanControl,
    region_index: u64,
    processed_region_count: u64,
    total_region_count: u64
) 
crashes Abort
{
    transition region_index < total_region_count && region_index < snapshot.get_region_count() {
        true -> cancel_gate(
            snapshot, element_scan_plan, scan_control,
            region_index, processed_region_count, total_region_count)
        false -> done()
        _ -> done()
    }

    // Upstream's per-region `if scan_control.should_cancel() { return; }` —
    // the cancelled region (and every one after) contributes neither scanned
    // results nor a processed count, exactly as upstream's early return.
    state cancel_gate(
        snapshot: &mut Snapshot,
        element_scan_plan: &ElementScanPlan,
        scan_control: &mut ScanControl,
        region_index: u64,
        processed_region_count: u64,
        total_region_count: u64
    ) {
        let cancelled: bool = scan_control.should_cancel();
        transition cancelled == false {
            true -> scan_one(
                snapshot, element_scan_plan, scan_control,
                region_index, processed_region_count, total_region_count)
            false -> done()
            _ -> done()
        }
    }

    state scan_one(
        snapshot: &mut Snapshot,
        element_scan_plan: &ElementScanPlan,
        scan_control: &mut ScanControl,
        region_index: u64,
        processed_region_count: u64,
        total_region_count: u64
    ) {
        let results: SnapshotRegionScanResults = ElementScannerDriver::dispatch_region(
            snapshot, element_scan_plan, region_index);
        snapshot.apply_region_scan_results(region_index, results);
        // `fetch_add(1)` returns the pre-increment index — report on it.
        transition { _ -> progress(
            snapshot, element_scan_plan, scan_control,
            region_index, processed_region_count, total_region_count) }
    }

    // Upstream's `processed_region_index % 32 == 0 && total_region_count > 0`.
    state progress(
        snapshot: &mut Snapshot,
        element_scan_plan: &ElementScanPlan,
        scan_control: &mut ScanControl,
        region_index: u64,
        processed_index: u64,
        total_region_count: u64
    ) {
        let next_region: u64 = ((region_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let next_processed: u64 = ((processed_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let phase: u64 = processed_index % 32;
        transition phase == 0 && total_region_count > 0 {
            true -> report(
                snapshot, element_scan_plan, scan_control,
                next_region, next_processed, total_region_count, processed_index)
            false -> scan_regions(
                snapshot, element_scan_plan, scan_control,
                next_region, next_processed, total_region_count)
            _ -> scan_regions(
                snapshot, element_scan_plan, scan_control,
                next_region, next_processed, total_region_count)
        }
    }

    state report(
        snapshot: &mut Snapshot,
        element_scan_plan: &ElementScanPlan,
        scan_control: &mut ScanControl,
        next_region: u64,
        next_processed: u64,
        total_region_count: u64,
        processed_index: u64
    ) {
        let pct: f32 =
            ((processed_index as f32) / (total_region_count as f32)) * 100.0;
        scan_control.report_progress(pct);
        transition { _ -> scan_regions(
            snapshot, element_scan_plan, scan_control,
            next_region, next_processed, total_region_count) }
    }

    state done() {
    }
}

// One region: per collection of the region's seeded scan results, run the
// constraint chain and collect the outcome collections — upstream's
// `iter().map(dispatch).collect()`.
pub machine ElementScannerDriver::dispatch_region(
    snapshot: &Snapshot,
    element_scan_plan: &ElementScanPlan,
    region_index: u64
) -> SnapshotRegionScanResults
crashes Abort
{
    let region: SnapshotRegion = snapshot.get_region(region_index);
    let scan_results: SnapshotRegionScanResults = region.get_scan_results();
    transition { _ -> each(&region, element_scan_plan, &scan_results,
        SnapshotRegionScanResults::empty(), 0) }

    state each(
        region: &SnapshotRegion,
        element_scan_plan: &ElementScanPlan,
        scan_results: &SnapshotRegionScanResults,
        out: SnapshotRegionScanResults,
        collection_index: u64
    ) -> SnapshotRegionScanResults
    {
        transition collection_index < scan_results.get_collection_count() {
            true -> dispatch(
                region, element_scan_plan, scan_results, out, collection_index)
            false -> (out)
        }
    }

    state dispatch(
        region: &SnapshotRegion,
        element_scan_plan: &ElementScanPlan,
        scan_results: &SnapshotRegionScanResults,
        out: SnapshotRegionScanResults,
        collection_index: u64
    ) -> SnapshotRegionScanResults
    {
        let collection: SnapshotRegionFilterCollection = scan_results.get_filter_collection(collection_index);
        let dtr: DataTypeRef = collection.get_data_type_ref();
        let plan_list: TypePlanList = element_scan_plan.get_plan_list_for(&dtr);
        let scanned: SnapshotRegionFilterCollection = ElementScanChainDispatcher::dispatch_collection(
            region, &collection, element_scan_plan, &plan_list);
        let mut carried: SnapshotRegionScanResults = out;
        let pushed: bool = carried.push_collection(&scanned);
        transition { _ -> each(region, element_scan_plan, scan_results, carried, ((collection_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Upstream's report fields: `get_number_of_results` +
// `get_collected_byte_count` over the surviving snapshot.
pub machine ElementScannerDriver::collect_metadata(
    snapshot: &Snapshot,
    position: u64,
    result_count: u64
) -> ScanResultsMetadata 
crashes Abort
{
    transition position < snapshot.get_region_count() {
        true -> tally(snapshot, position, result_count)
        false -> finish(snapshot, result_count)
        _ -> finish(snapshot, result_count)
    }

    state tally(snapshot: &Snapshot, position: u64, result_count: u64) -> ScanResultsMetadata {
        let region: SnapshotRegion = snapshot.get_region(position);
        let region_results: SnapshotRegionScanResults = region.get_scan_results();
        let next_count: u64 = ((result_count as u64 in Saturating)
            + (region_results.get_number_of_results() as u64 in Saturating)) as u64;
        transition { _ -> collect_metadata(snapshot, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, next_count) }
    }

    state finish(snapshot: &Snapshot, result_count: u64) -> ScanResultsMetadata {
        ScanResultsMetadata {
            result_count: result_count,
            total_size_in_bytes: snapshot.get_collected_byte_count(),
        }
    }
}
