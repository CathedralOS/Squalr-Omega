// Port of `ElementScanner::scan_snapshot` (single-threaded leg). Per region:
// seed scan results for the plan's data types, dispatch each collection
// through the constraint chain, install the results, resize the region to
// its surviving filters, and finally drop empty regions — the exact upstream
// ordering.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ElementScannerDriver {}

// Scalar outcome of a supplied-window fixture scan — the exact counts and
// addresses a test asserts on, carried as plain scalars so the record binds
// in a caller frame.
public data SuppliedScanOutcome {
    region_count: u64;
    total_results: u64;
    collected_bytes: u64;
    emitted_count: u64;
    emitted_first: u64;
    emitted_second: u64;
    emitted_third: u64;
}

// Supplied-window scan fixture (test adapter): builds the region and the
// finalized plan inside the frame — owned plan/snapshot construction cannot
// mint in a ProgramEntry machine — then runs the real `scan_snapshot` leg.
// `element_count` up to 5 mirrors `SnapshotRegion::of_elements`'s window.
public machine ElementScannerDriver::run_supplied_fixture(
    base_address: u64,
    element_count: u64,
    e0: u64,
    e1: u64,
    e2: u64,
    e3: u64,
    e4: u64,
    operand_value: u64,
    memory_alignment: |memory_alignment|::MemoryAlignment
) -> SuppliedScanOutcome
crashes Abort
{
    let u8_ref: |data_type_ref|::DataTypeRef = |data_type_ref|::DataTypeRef::new("u8");
    let region: |snapshot_region|::SnapshotRegion = |snapshot_region|::SnapshotRegion::of_elements(
        base_address, element_count, e0, e1, e2, e3, e4);
    let mut snapshot: |snapshot|::Snapshot = |snapshot|::Snapshot::new();
    _ = |snapshot|::Snapshot::push_region(&mut snapshot, region);
    let compare_type: |scan_compare_type|::ScanCompareType = |scan_compare_type|::ScanCompareType::Immediate {
        compare_type: |scan_compare_type_immediate|::ScanCompareTypeImmediate::Equal
    };
    let operand_size_in_bytes: u64 = 1;
    let unit_size_in_bytes: u64 = 1;
    let periodicity: u64 = |scan_constraint_finalized|::ScanConstraintFinalized::calculate_periodicity(
        compare_type,
        operand_value,
        operand_size_in_bytes,
        unit_size_in_bytes);
    let is_floating_point: bool = |data_type_ref|::DataTypeRef::is_floating_point(&u8_ref);
    let is_signed: bool = |data_type_ref|::DataTypeRef::is_signed(&u8_ref);
    let prefer_type_scanner: bool = |data_type_ref|::DataTypeRef::prefers_type_scanner(&u8_ref);
    let container_type: |container_type|::ContainerType = |data_type_ref|::DataTypeRef::get_result_container_type(&u8_ref);
    let read_mode: |memory_read_mode|::MemoryReadMode = |memory_read_mode|::MemoryReadMode::Skip;
    let mut element_scan_plan: |element_scan_plan|::ElementScanPlan = |element_scan_plan|::ElementScanPlan::new(
        memory_alignment,
        read_mode,
        true,
        false);
    let scan_function: |scan_function_scalar|::ScanFunctionScalar = |scan_function_scalar|::ScanFunctionScalar::Immediate;
    let planned_scan_type: |planned_scan_type|::PlannedScanType = |planned_scan_type|::PlannedScanType::Scalar {
        scan_type: |planned_scan_type_scalar|::PlannedScanTypeScalar::ScalarIterative
    };
    _ = |element_scan_plan|::ElementScanPlan::insert_profiled(&mut element_scan_plan, &u8_ref,
        compare_type,
        operand_value,
        unit_size_in_bytes,
        true,
        scan_function,
        memory_alignment,
        periodicity,
        is_floating_point,
        is_signed,
        prefer_type_scanner,
        |floating_point_tolerance|::FloatingPointTolerance::default(),
        false,
        0,
        container_type,
        planned_scan_type);
    let mut scan_control: |scan_control|::ScanControl = |scan_control|::ScanControl::new(false);
    let metadata: |scan_results_metadata|::ScanResultsMetadata = ElementScannerDriver::scan_snapshot(
        &mut snapshot, &mut element_scan_plan, &mut scan_control);
    let out: |snapshot_region_scan_results|::ScanResultAddresses = |snapshot|::Snapshot::collect_scan_result_addresses_for_data_type(&snapshot, &u8_ref);
    let region_count: u64 = |snapshot|::Snapshot::get_region_count(&snapshot);
    let total_results: u64 = |scan_results_metadata|::ScanResultsMetadata::get_result_count(&metadata);
    let collected_bytes: u64 = |scan_results_metadata|::ScanResultsMetadata::get_total_size_in_bytes(&metadata);
    let emitted_count: u64 = |snapshot_region_scan_results|::ScanResultAddresses::get_address_count(&out);
    let emitted_first: u64 = |snapshot_region_scan_results|::ScanResultAddresses::get(&out, 0);
    let emitted_second: u64 = |snapshot_region_scan_results|::ScanResultAddresses::get(&out, 1);
    let emitted_third: u64 = |snapshot_region_scan_results|::ScanResultAddresses::get(&out, 2);
    SuppliedScanOutcome {
        region_count: region_count,
        total_results: total_results,
        collected_bytes: collected_bytes,
        emitted_count: emitted_count,
        emitted_first: emitted_first,
        emitted_second: emitted_second,
        emitted_third: emitted_third
    }
}

// Upstream `scan_snapshot(snapshot, symbol_registry, plan, scan_control,
// with_logging, refresh)`: the owned-model port carries `scan_control` by
// `&mut` since cancellation and the reported progress write onto the
// control object (upstream reads a shared atomic + invokes a closure).
public machine ElementScannerDriver::scan_snapshot(
    snapshot: &mut |snapshot|::Snapshot,
    element_scan_plan: &mut |element_scan_plan|::ElementScanPlan,
    scan_control: &mut |scan_control|::ScanControl
) -> |scan_results_metadata|::ScanResultsMetadata
crashes Abort
{
    // Upstream calls `commit_deleted_scan_result_indices` first: pending
    // tombstones become structural before a fresh scan recomputes results.
    let committed_deleted_result_count: u64 = |snapshot|::Snapshot::commit_deleted_scan_result_indices(&mut snapshot);
    let total_region_count: u64 = |snapshot|::Snapshot::get_region_count(&snapshot);
    |snapshot|::Snapshot::initialize_all_scan_results(&mut snapshot, |element_scan_plan|::ElementScanPlan::clone_data_type_refs(element_scan_plan),
        |element_scan_plan|::ElementScanPlan::get_memory_alignment(element_scan_plan));
    ElementScannerDriver::scan_regions(
        snapshot, element_scan_plan, scan_control, 0, 0, total_region_count);
    |snapshot|::Snapshot::discard_empty_regions(&mut snapshot);
    ElementScannerDriver::collect_metadata(snapshot, 0, 0)
}

// Per-region scan over the snapshot — the sequential equivalent of
// upstream's `snapshot_regions.iter_mut().for_each(scan_region)` under the
// single-thread setting.
public machine ElementScannerDriver::scan_regions(
    snapshot: &mut |snapshot|::Snapshot,
    element_scan_plan: &|element_scan_plan|::ElementScanPlan,
    scan_control: &mut |scan_control|::ScanControl,
    region_index: u64,
    processed_region_count: u64,
    total_region_count: u64
) 
crashes Abort
{
    let hoist1: u64 = |snapshot|::Snapshot::get_region_count(&snapshot);
    transition region_index < total_region_count && region_index < hoist1 {
        true -> cancel_gate(
            snapshot, element_scan_plan, scan_control,
            region_index, processed_region_count, total_region_count)
        false -> done()
        _ -> done()
    }

    // Upstream's per-region `if scan_control.should_cancel() { return; }` —
    // the cancelled region (and every one after) contributes neither scanned
    // results nor a processed count, exactly as upstream's early return.
    machine cancel_gate(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        region_index: u64,
        processed_region_count: u64,
        total_region_count: u64
    ) {
        let cancelled: bool = |scan_control|::ScanControl::should_cancel(&scan_control);
        transition cancelled == false {
            true -> scan_one(
                snapshot, element_scan_plan, scan_control,
                region_index, processed_region_count, total_region_count)
            false -> done()
            _ -> done()
        }
    }

    machine scan_one(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        region_index: u64,
        processed_region_count: u64,
        total_region_count: u64
    ) {
        let results: |snapshot_region_scan_results|::SnapshotRegionScanResults = ElementScannerDriver::dispatch_region(
            snapshot, element_scan_plan, scan_control, region_index);
        |snapshot|::Snapshot::apply_region_scan_results(&mut snapshot, region_index, results);
        // `fetch_add(1)` returns the pre-increment index — report on it.
        transition { _ -> progress(
            snapshot, element_scan_plan, scan_control,
            region_index, processed_region_count, total_region_count) }
    }

    // Upstream's `processed_region_index % 32 == 0 && total_region_count > 0`.
    machine progress(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        region_index: u64,
        processed_index: u64,
        total_region_count: u64
    ) {
        let next_region: u64 = ((region_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let next_processed: u64 = ((processed_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let phase: u64 = processed_index % 32;
        transition phase == 0 && total_region_count > 0 {
            true -> report(
                snapshot, element_scan_plan, scan_control,
                next_region, next_processed, total_region_count, processed_index)
            false -> scan_regions(
                snapshot, element_scan_plan, scan_control,
                next_region, next_processed, total_region_count)
            _ -> scan_regions(
                snapshot, element_scan_plan, scan_control,
                next_region, next_processed, total_region_count)
        }
    }

    machine report(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        next_region: u64,
        next_processed: u64,
        total_region_count: u64,
        processed_index: u64
    ) {
        let pct: f32 =
            (|float_operations|::F32::from_u64(processed_index) / |float_operations|::F32::from_u64(total_region_count)) * 100.0;
        |scan_control|::ScanControl::report_progress(&mut scan_control, pct);
        transition { _ -> scan_regions(
            snapshot, element_scan_plan, scan_control,
            next_region, next_processed, total_region_count) }
    }

    machine done() {
    }
}

// One region: per collection of the region's seeded scan results, run the
// constraint chain and collect the outcome collections — upstream's
// `iter().map(dispatch).collect()`.
public machine ElementScannerDriver::dispatch_region(
    snapshot: &|snapshot|::Snapshot,
    element_scan_plan: &|element_scan_plan|::ElementScanPlan,
    scan_control: &mut |scan_control|::ScanControl,
    region_index: u64
) -> |snapshot_region_scan_results|::SnapshotRegionScanResults
crashes Abort
{
    let region: |snapshot_region|::SnapshotRegion = |snapshot|::Snapshot::get_region(&snapshot, region_index);
    let scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&region);
    transition { _ -> each(&region, element_scan_plan, scan_control, &scan_results,
        |snapshot_region_scan_results|::SnapshotRegionScanResults::empty(), 0) }

    machine each(
        region: &|snapshot_region|::SnapshotRegion,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        scan_results: &|snapshot_region_scan_results|::SnapshotRegionScanResults,
        out: |snapshot_region_scan_results|::SnapshotRegionScanResults,
        collection_index: u64
    ) -> |snapshot_region_scan_results|::SnapshotRegionScanResults
    {
        let hoist2: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_collection_count(&scan_results);
        transition collection_index < hoist2 {
            true -> dispatch(
                region, element_scan_plan, scan_control, scan_results, out, collection_index)
            false -> (out)
        }
    }

    machine dispatch(
        region: &|snapshot_region|::SnapshotRegion,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        scan_results: &|snapshot_region_scan_results|::SnapshotRegionScanResults,
        out: |snapshot_region_scan_results|::SnapshotRegionScanResults,
        collection_index: u64
    ) -> |snapshot_region_scan_results|::SnapshotRegionScanResults
    {
        let collection: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_filter_collection(&scan_results, collection_index);
        let dtr: |data_type_ref|::DataTypeRef = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_data_type_ref(&collection);
        let plan_list: |element_scan_plan|::TypePlanList = |element_scan_plan|::ElementScanPlan::get_plan_list_for(&element_scan_plan, &dtr);
        let scanned: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = |element_scan_dispatcher|::ElementScanChainDispatcher::dispatch_collection(
            region, &collection, element_scan_plan, &plan_list, scan_control);
        let mut carried: |snapshot_region_scan_results|::SnapshotRegionScanResults = out;
        let pushed: bool = |snapshot_region_scan_results|::SnapshotRegionScanResults::push_collection(&mut carried, &scanned);
        transition { _ -> each(region, element_scan_plan, scan_control, scan_results, carried, ((collection_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Upstream's report fields: `get_number_of_results` +
// `get_collected_byte_count` over the surviving snapshot.
public machine ElementScannerDriver::collect_metadata(
    snapshot: &|snapshot|::Snapshot,
    position: u64,
    result_count: u64
) -> |scan_results_metadata|::ScanResultsMetadata
crashes Abort
{
    let hoist3: u64 = |snapshot|::Snapshot::get_region_count(&snapshot);
    transition position < hoist3 {
        true -> tally(snapshot, position, result_count)
        false -> finish(snapshot, result_count)
        _ -> finish(snapshot, result_count)
    }

    machine tally(snapshot: &|snapshot|::Snapshot, position: u64, result_count: u64) -> |scan_results_metadata|::ScanResultsMetadata {
        let region: |snapshot_region|::SnapshotRegion = |snapshot|::Snapshot::get_region(&snapshot, position);
        let region_results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&region);
        let next_count: u64 = ((result_count as u64 in Saturating)
            + (|snapshot_region_scan_results|::SnapshotRegionScanResults::get_number_of_results(&region_results) as u64 in Saturating)) as u64;
        transition { _ -> collect_metadata(snapshot, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, next_count) }
    }

    machine finish(snapshot: &|snapshot|::Snapshot, result_count: u64) -> |scan_results_metadata|::ScanResultsMetadata {
        let hoist4: u64 = |snapshot|::Snapshot::get_collected_byte_count(&snapshot);
        |scan_results_metadata|::ScanResultsMetadata {
            result_count: result_count,
            total_size_in_bytes: hoist4,
        }
    }
}
