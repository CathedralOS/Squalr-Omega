use {squalr_engine_api}/src/structures/scanning/plans/element_scan/element_scan_plan.omg;
use {squalr_engine_api}/src/structures/data_types/data_type_ref.omg;
use {squalr_engine_api}/src/structures/data_types/floating_point_tolerance.omg;
use {squalr_engine_api}/src/structures/memory/memory_alignment.omg;
use {squalr_engine_api}/src/structures/scanning/memory_read_mode.omg;
use {squalr_engine_api}/src/structures/scanning/comparisons/scan_compare_type.omg;
use {squalr_engine_api}/src/structures/scanning/comparisons/scan_compare_type_immediate.omg;
use {squalr_engine_api}/src/structures/scanning/comparisons/scan_function_scalar.omg;
use {squalr_engine_api}/src/structures/data_values/container_type.omg;
use {squalr_engine_api}/src/structures/scanning/plans/plan_types/planned_scan_type.omg;
use {squalr_engine_api}/src/structures/scanning/plans/plan_types/planned_scan_type_scalar.omg;
use {squalr_engine_api}/src/structures/scanning/constraints/scan_constraint_finalized.omg;
use {squalr_engine_api}/src/structures/results/snapshot_region_scan_results.omg;
