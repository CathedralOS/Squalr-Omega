// Port of command_executors/project_items/project_items_executor.rs —
// upstream's domain router; each arm executes the leaf request and wraps
// the response through the leaf's `to_engine_response`.
pub data ProjectItemsCommandExecutor {}

pub machine ProjectItemsCommandExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_items_command: &ProjectItemsCommand
) -> UnprivilegedCommandResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    transition project_items_command {
        ProjectItemsCommand::Activate { request } -> (ProjectItemsActivateResponse::to_engine_response(ProjectItemsActivateRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectItemsCommand::Add { request } -> (ProjectItemsAddResponse::to_engine_response(ProjectItemsAddRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectItemsCommand::Create { request } -> (ProjectItemsCreateResponse::to_engine_response(ProjectItemsCreateRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectItemsCommand::Delete { request } -> (ProjectItemsDeleteResponse::to_engine_response(ProjectItemsDeleteRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectItemsCommand::Duplicate { request } -> (ProjectItemsDuplicateResponse::to_engine_response(ProjectItemsDuplicateRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectItemsCommand::List { request } -> (ProjectItemsListResponse::to_engine_response(ProjectItemsListRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectItemsCommand::MoveItem { request } -> (ProjectItemsMoveItemResponse::to_engine_response(ProjectItemsMoveItemRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectItemsCommand::PromoteSymbol { request } -> (ProjectItemsPromoteSymbolResponse::to_engine_response(ProjectItemsPromoteSymbolRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectItemsCommand::Rename { request } -> (ProjectItemsRenameResponse::to_engine_response(ProjectItemsRenameRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectItemsCommand::Reorder { request } -> (ProjectItemsReorderResponse::to_engine_response(ProjectItemsReorderRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectItemsCommand::StripSymbol { request } -> (ProjectItemsStripSymbolResponse::to_engine_response(ProjectItemsStripSymbolRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectItemsCommand::UpdateDetails { request } -> (ProjectItemsUpdateDetailsResponse::to_engine_response(ProjectItemsUpdateDetailsRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
        ProjectItemsCommand::WriteValue { request } -> (ProjectItemsWriteValueResponse::to_engine_response(ProjectItemsWriteValueRequestExecutor::execute(engine_unprivileged_state, engine_bindings, &request)))
    }
}
