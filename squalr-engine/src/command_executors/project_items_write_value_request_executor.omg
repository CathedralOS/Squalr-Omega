module src::command_executors::project_items_write_value_request_executor;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::memory::write::memory_write_response::MemoryWriteResponse;
use squalr_engine_api::src::commands::project_items::write_value::project_items_write_value_request::ProjectItemsWriteValueRequest;
use squalr_engine_api::src::commands::project_items::write_value::project_items_write_value_response::ProjectItemsWriteValueResponse;
use squalr_engine_api::src::structures::projects::project::Project;
use squalr_engine_api::src::structures::projects::project::ProjectItemLookup;
use squalr_engine_api::src::structures::projects::project_info::ProjectInfo;
use squalr_engine_api::src::structures::data_values::anonymous_value_string::AnonymousValueString;
use squalr_engine_api::src::structures::projects::project_items::project_item::ProjectItem;
use squalr_engine_api::src::structures::projects::project_items::project_item_pair::ProjectItemPair;
use squalr_engine_api::src::structures::projects::project_items::project_item_ref::ProjectItemRef;
use squalr_engine_api::src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use squalr_engine_session::src::projects::project_manager::ProjectManager;
use src::engine_bindings::standalone_engine_api_unprivileged_bindings::StandaloneEngineApiUnprivilegedBindings;
use src::services::memory::memory_write_dispatch::MemoryWriteDispatch;
use src::services::memory::memory_write_dispatch::MemoryWriteDispatchResult;
use src::services::projects::project_item_file_mutation::ProjectItemFileMutation;
use src::services::projects::project_item_runtime_value_write::ProjectItemRuntimeValueWrite;
use src::services::projects::project_item_runtime_value_write::ProjectItemRuntimeValueWritePlanRequest;
use src::services::projects::project_item_sort_order::ManifestPathScratch;
use src::services::projects::project_symbol_runtime_value_write::SymbolWritePlan;

// Port of command_executors/project_items/write_value/
// project_items_write_value_request_executor.rs — resolve the request's
// item path against the opened project directory, clone the item, build
// the runtime-value write plan (symbol resolution + value parse), and
// dispatch the privileged memory write. Errors land in `response.error`.
pub data ProjectItemsWriteValueRequestExecutor {}

pub machine ProjectItemsWriteValueRequestExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_items_write_value_request: &ProjectItemsWriteValueRequest
) -> ProjectItemsWriteValueResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
    transition ProjectManager::get_has_opened_project(project_manager) {
        true -> directory(engine_unprivileged_state, engine_bindings, project_items_write_value_request)
        _ -> (fail("Cannot write a project item value without an opened project."))
    }

    state directory(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_items_write_value_request: &ProjectItemsWriteValueRequest) -> ProjectItemsWriteValueResponse {
        let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
        let opened_project: &Project = ProjectManager::get_opened_project(project_manager);
        let project_info: &ProjectInfo = Project::get_project_info(opened_project);
        let mut directory: [u8; 512];
        transition ProjectInfo::get_project_directory(project_info, &mut directory) {
            true -> measure(engine_unprivileged_state, engine_bindings, project_items_write_value_request, directory)
            _ -> (fail("Cannot write a project item value without an opened project directory."))
        }
    }

    state measure(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_items_write_value_request: &ProjectItemsWriteValueRequest, directory: [u8; 512]) -> ProjectItemsWriteValueResponse {
        let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
        let opened_project: &Project = ProjectManager::get_opened_project(project_manager);
        let project_info: &ProjectInfo = Project::get_project_info(opened_project);
        let directory_len: u64 = ProjectInfo::get_project_directory_len(project_info);
        transition directory_len <= 512 {
            true -> resolve(engine_unprivileged_state, engine_bindings, project_items_write_value_request, directory, directory_len)
            _ -> (fail("Cannot write a project item value without an opened project directory."))
        }
    }

    // Upstream `resolve_project_item_path(dir, request.path)`.
    state resolve(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_items_write_value_request: &ProjectItemsWriteValueRequest, directory: [u8; 512], directory_len: u64) -> ProjectItemsWriteValueResponse
        requires directory_len <= 512;
    {
        let mut resolved: ManifestPathScratch;
        ManifestPathScratch::new(&mut resolved);
        let project_item_path: &[u8] = ProjectItemsWriteValueRequest::get_project_item_path(project_items_write_value_request);
        transition ProjectItemFileMutation::resolve_project_item_path(&directory[0..directory_len], project_item_path, &mut resolved) {
            true -> lookup(engine_unprivileged_state, engine_bindings, project_items_write_value_request, resolved)
            _ -> (fail("Unable to resolve the project item path."))
        }
    }

    state lookup(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_items_write_value_request: &ProjectItemsWriteValueRequest, resolved: ManifestPathScratch) -> ProjectItemsWriteValueResponse {
        let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
        let opened_project: &Project = ProjectManager::get_opened_project(project_manager);
        let inner26: &[u8] = ManifestPathScratch::get_bytes(&resolved);
        let project_item_ref: ProjectItemRef = ProjectItemRef::new(inner26);
        let found: ProjectItemLookup = Project::lookup_project_item_index(opened_project, &project_item_ref);
        transition found {
            ProjectItemLookup::Found { index } -> clone_item(engine_unprivileged_state, engine_bindings, project_items_write_value_request, index)
            _ -> (fail("Unable to find the project item."))
        }
    }

    state clone_item(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_items_write_value_request: &ProjectItemsWriteValueRequest, index: u64) -> ProjectItemsWriteValueResponse {
        let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
        let opened_project: &Project = ProjectManager::get_opened_project(project_manager);
        let pair: &squalr_engine_api::src::structures::projects::project_items::project_item_pair::ProjectItemPair = Project::get_project_item_pair(opened_project, index);
        let inner27: &ProjectItem = ProjectItemPair::get_project_item(pair);
        let project_item: ProjectItem = ProjectItem::clone(inner27);
        let project_symbol_catalog: &ProjectSymbolCatalog = Project::get_project_symbol_catalog(opened_project);
        let mut empty_field_name: [u8; 256];
        ProjectItemsWriteValueRequestExecutor::zero_256(&mut empty_field_name);
        let write_plan_request: ProjectItemRuntimeValueWritePlanRequest = ProjectItemRuntimeValueWritePlanRequest {
            field_name: empty_field_name,
            field_name_len: 0,
            anonymous_value_string: AnonymousValueString::clone(ProjectItemsWriteValueRequest::get_anonymous_value_string(project_items_write_value_request)),
        };
        transition { _ -> plan(engine_unprivileged_state, engine_bindings, project_items_write_value_request, project_item, write_plan_request) }
    }

    // Fill the bounded field_name from the request before planning.
    state plan(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_items_write_value_request: &ProjectItemsWriteValueRequest, project_item: ProjectItem, mut write_plan_request: ProjectItemRuntimeValueWritePlanRequest) -> ProjectItemsWriteValueResponse {
        let field_name: &[u8] = ProjectItemsWriteValueRequest::get_field_name(project_items_write_value_request);
        transition { _ -> copy_field(engine_unprivileged_state, engine_bindings, project_items_write_value_request, project_item, write_plan_request, field_name, 0) }
    }
    state copy_field(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_items_write_value_request: &ProjectItemsWriteValueRequest, project_item: ProjectItem, mut write_plan_request: ProjectItemRuntimeValueWritePlanRequest, field_name: &[u8], position: u64) -> ProjectItemsWriteValueResponse {
        transition position < field_name.len && position < 256 {
            true -> put_field(engine_unprivileged_state, engine_bindings, project_items_write_value_request, project_item, write_plan_request, field_name, position)
            _ -> build_plan(engine_unprivileged_state, engine_bindings, project_items_write_value_request, project_item, write_plan_request)
        }
    }
    state put_field(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_items_write_value_request: &ProjectItemsWriteValueRequest, project_item: ProjectItem, mut write_plan_request: ProjectItemRuntimeValueWritePlanRequest, field_name: &[u8], position: u64) -> ProjectItemsWriteValueResponse
        requires position < 256 && position < field_name.len;
    {
        write_plan_request.field_name[position] = field_name[position];
        write_plan_request.field_name_len = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> copy_field(engine_unprivileged_state, engine_bindings, project_items_write_value_request, project_item, write_plan_request, field_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state build_plan(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_items_write_value_request: &ProjectItemsWriteValueRequest, project_item: ProjectItem, write_plan_request: ProjectItemRuntimeValueWritePlanRequest) -> ProjectItemsWriteValueResponse {
        let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
        let opened_project: &Project = ProjectManager::get_opened_project(project_manager);
        let project_symbol_catalog: &ProjectSymbolCatalog = Project::get_project_symbol_catalog(opened_project);
        let plan: SymbolWritePlan = ProjectItemRuntimeValueWrite::build_project_item_runtime_value_write_request(engine_unprivileged_state, engine_bindings, project_symbol_catalog, &project_item, &write_plan_request);
        transition plan.found {
            true -> dispatch(engine_unprivileged_state, engine_bindings, plan)
            _ -> (fail_plan(&plan))
        }
    }

    state dispatch(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, plan: SymbolWritePlan) -> ProjectItemsWriteValueResponse {
        let result: MemoryWriteDispatchResult = MemoryWriteDispatch::dispatch_memory_write_request(engine_bindings, &plan.request);
        transition result {
            MemoryWriteDispatchResult::Present { response } -> write_result(response)
            _ -> (fail("Privileged memory write command failed."))
        }
    }
    state write_result(response: MemoryWriteResponse) -> ProjectItemsWriteValueResponse {
        transition MemoryWriteResponse::get_success(&response) {
            true -> succeed()
            _ -> (fail("Privileged memory write command failed."))
        }
    }
    state succeed() -> ProjectItemsWriteValueResponse {
        let mut response: ProjectItemsWriteValueResponse = ProjectItemsWriteValueResponse::new();
        ProjectItemsWriteValueResponse::set_success(&mut response, true);
        (response)
    }

    state fail(message: &[u8]) -> ProjectItemsWriteValueResponse {
        let mut response: ProjectItemsWriteValueResponse = ProjectItemsWriteValueResponse::new();
        ProjectItemsWriteValueResponse::set_error(&mut response, message);
        (response)
    }
    state fail_plan(plan: &SymbolWritePlan) -> ProjectItemsWriteValueResponse {
        let mut response: ProjectItemsWriteValueResponse = ProjectItemsWriteValueResponse::new();
        transition plan.failure_len <= 256 {
            true -> put_failure(response, plan)
            _ -> (response)
        }
    }
    state put_failure(mut response: ProjectItemsWriteValueResponse, plan: &SymbolWritePlan) -> ProjectItemsWriteValueResponse
        requires plan.failure_len <= 256;
    {
        ProjectItemsWriteValueResponse::set_error(&mut response, &plan.failure[0..plan.failure_len]);
        (response)
    }
}

// Bounded-index zero fill for the plan request's empty name slots.
pub machine ProjectItemsWriteValueRequestExecutor::zero_256(out: &mut [u8; 256]) {
    transition { _ -> each(out, 0) }
    state each(out: &mut [u8; 256], position: u64) {
        transition position < 256 {
            true -> write(out, position)
            _ -> done()
        }
    }
    state write(out: &mut [u8; 256], position: u64)
        requires position < 256;
    {
        out[position] = 0;
        transition { _ -> each(out, position + 1) }
    }
    state done() { }
}
