module src::command_executors::project_close_request_executor;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::project::close::project_close_request::ProjectCloseRequest;
use squalr_engine_api::src::commands::project::close::project_close_response::ProjectCloseResponse;
use squalr_engine_api::src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use squalr_engine_session::src::projects::project_manager::ProjectManager;
use src::engine_bindings::standalone_engine_api_unprivileged_bindings::StandaloneEngineApiUnprivilegedBindings;
use src::services::projects::project_symbol_sync::ProjectSymbolSync;

// Port of command_executors/project/close/project_close_request_executor.rs —
// sync the default catalog upstream of the close, clear the opened
// project, unwatch its directory, notify closed.
pub data ProjectCloseRequestExecutor {}

pub machine ProjectCloseRequestExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_close_request: &ProjectCloseRequest
) -> ProjectCloseResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let default_catalog: ProjectSymbolCatalog = ProjectSymbolCatalog::default();
    transition ProjectSymbolSync::sync_project_symbol_catalog(engine_bindings, &default_catalog) {
        true -> close(engine_unprivileged_state)
        _ -> refused()
    }

    state refused() -> ProjectCloseResponse {
        (ProjectCloseResponse::new())
    }

    state close(engine_unprivileged_state: &mut EngineUnprivilegedState) -> ProjectCloseResponse {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        ProjectManager::clear_opened_project(project_manager);
        EngineUnprivilegedState::watch_opened_project(engine_unprivileged_state, "", false);
        EngineUnprivilegedState::notify_project_closed(engine_unprivileged_state);
        let mut response: ProjectCloseResponse = ProjectCloseResponse::new();
        ProjectCloseResponse::set_success(&mut response, true);
        (response)
    }
}
