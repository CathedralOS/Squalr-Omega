module src::command_executors::patch_list_request_executor;

use squalr_engine_api::src::commands::patches::list::patch_list_request::PatchListRequest;
use squalr_engine_api::src::commands::patches::list::patch_list_response::PatchListResponse;
use squalr_engine_api::src::structures::patches::patch_command_status::PatchCommandStatus;
use squalr_engine_api::src::structures::patches::patch_descriptor::PatchDescriptor;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::patches::patch_service::PatchService;

// Port of command_executors/patches/list/patch_list_request_executor.rs —
// upstream returns the patch service's sorted `Vec<PatchDescriptor>`. The
// port's bounded table sorts in place (`list_patches` returns unit), so
// the executor copies the sorted entries into the response's 64-entry
// page — identical observable contents, bounded carrier.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data PatchListRequestExecutor {}

pub machine PatchListRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    patch_list_request: &PatchListRequest
) -> PatchListResponse {
    let hoist1: bool = EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> prepare(engine_privileged_state)
        _ -> absent()
    }

    state absent() -> PatchListResponse {
        (PatchListResponse::new(PatchCommandStatus::failure("No opened process to patch.")))
    }

    state prepare(engine_privileged_state: &mut EnginePrivilegedState) -> PatchListResponse {
        let opened_process_info: OpenedProcessInfo = EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        EnginePrivilegedState::list_patches(&mut engine_privileged_state, &opened_process_info);
        let patch_count: u64 = EnginePrivilegedState::borrow_patch_service_mut(&mut engine_privileged_state).get_patch_count();
        transition {
            _ -> walk(
                engine_privileged_state,
                PatchListResponse::new(PatchCommandStatus::success()),
                patch_count, 0)
        }
    }

    state walk(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PatchListResponse,
        patch_count: u64,
        position: u64
    ) -> PatchListResponse {
        transition position < patch_count && position < 64 {
            true -> append(engine_privileged_state, response, patch_count, position)
            false -> (response)
            _ -> (response)
        }
    }

    state append(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PatchListResponse,
        patch_count: u64,
        position: u64
    ) -> PatchListResponse
        requires position < 64
    {
        let service: &mut PatchService = EnginePrivilegedState::borrow_patch_service_mut(&mut engine_privileged_state);
        let patch: PatchDescriptor = PatchService::clone_patch_at(&service, position);
        let added: bool = PatchListResponse::add_patch(&mut response, &patch);
        transition {
            _ -> walk(
                engine_privileged_state, response, patch_count,
                ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}
