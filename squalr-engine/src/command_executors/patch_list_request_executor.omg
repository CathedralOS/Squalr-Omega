use {squalr_engine_api}/src/commands/patches/list/patch_list_request.omg;
use {squalr_engine_api}/src/commands/patches/list/patch_list_response.omg;
use {squalr_engine_api}/src/structures/patches/patch_command_status.omg;
use {squalr_engine_api}/src/structures/patches/patch_descriptor.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/patches/patch_service.omg;

// Port of command_executors/patches/list/patch_list_request_executor.rs —
// upstream returns the patch service's sorted `Vec<PatchDescriptor>`. The
// port's bounded table sorts in place (`list_patches` returns unit), so
// the executor copies the sorted entries into the response's 64-entry
// page — identical observable contents, bounded carrier.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data PatchListRequestExecutor {}

public machine PatchListRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    patch_list_request: &|patch_list_request|::PatchListRequest
) -> |patch_list_response|::PatchListResponse {
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> prepare(engine_privileged_state)
        _ -> absent()
    }

    machine absent() -> |patch_list_response|::PatchListResponse {
        (|patch_list_response|::PatchListResponse::new(|patch_command_status|::PatchCommandStatus::failure("No opened process to patch.")))
    }

    machine prepare(engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState) -> |patch_list_response|::PatchListResponse {
        let opened_process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        |engine_privileged_state|::EnginePrivilegedState::list_patches(&mut engine_privileged_state, &opened_process_info);
        let patch_service: &mut |patch_service|::PatchService = |engine_privileged_state|::EnginePrivilegedState::borrow_patch_service_mut(&mut engine_privileged_state);
        let patch_count: u64 = |patch_service|::PatchService::get_patch_count(patch_service);
        transition {
            _ -> walk(
                engine_privileged_state,
                |patch_list_response|::PatchListResponse::new(|patch_command_status|::PatchCommandStatus::success()),
                patch_count, 0)
        }
    }

    machine walk(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |patch_list_response|::PatchListResponse,
        patch_count: u64,
        position: u64
    ) -> |patch_list_response|::PatchListResponse {
        transition position < patch_count && position < 64 {
            true -> append(engine_privileged_state, response, patch_count, position)
            false -> (response)
            _ -> (response)
        }
    }

    machine append(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |patch_list_response|::PatchListResponse,
        patch_count: u64,
        position: u64
    ) -> |patch_list_response|::PatchListResponse
        requires position < 64
    {
        let service: &mut |patch_service|::PatchService = |engine_privileged_state|::EnginePrivilegedState::borrow_patch_service_mut(&mut engine_privileged_state);
        let patch: |patch_descriptor|::PatchDescriptor = |patch_service|::PatchService::clone_patch_at(&service, position);
        let added: bool = |patch_list_response|::PatchListResponse::add_patch(&mut response, &patch);
        transition {
            _ -> walk(
                engine_privileged_state, response, patch_count,
                ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}
