use {squalr_engine_api}/src/structures/memory/memory_alignment.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot_region.omg;
use {squalr_engine_api}/src/structures/results/snapshot_region_scan_results.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/snapshot_region_builder.omg;

// Port of commands/scan/scan_initializer.rs — the shared scan-start glue the
// collect-values and struct-scan executors call before reading values.
//
// `ensure_snapshot_regions_for_scan`: upstream reads live page bounds through
// the target's memory queryer and merges them into snapshot regions; the
// sanctioned supplied source yields the same bound sequence for the captured
// target — the same substitution the scan-new executor names.
//
// `initialize_snapshot_scan_results_if_empty`: seeds a whole-region filter
// collection per requested data type into every region that has none and
// reports whether any region was seeded. Upstream then clears the pending
// delete tombstones; the tombstone set ships with the delete command leg
// (Snapshot header deviation), so the clear has no carrier here yet.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ScanInitializer {}

public machine ScanInitializer::ensure_snapshot_regions(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
) {
    let snapshot: &|snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
    let region_count: u64 = |snapshot|::Snapshot::get_region_count(snapshot);
    transition region_count == 0 {
        true -> fill(engine_privileged_state)
        false -> done()
    }

    machine fill(engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState) {
        let mut builder: |snapshot_region_builder|::SnapshotRegionBuilder = |snapshot_region_builder|::SnapshotRegionBuilder::new();
        let mut snapshot: |snapshot|::Snapshot = |snapshot|::Snapshot::new();
        |snapshot_region_builder|::SnapshotRegionBuilder::fill_from_supplied_source(
            &mut builder,
            |engine_privileged_state|::EnginePrivilegedState::get_supplied_memory_source(&engine_privileged_state));
        |snapshot_region_builder|::SnapshotRegionBuilder::fill_snapshot(&builder, &mut snapshot);
        |engine_privileged_state|::EnginePrivilegedState::set_snapshot(&mut engine_privileged_state, snapshot);
        transition { _ -> done() }
    }

    machine done() {
    }
}

// Upstream returns true when at least one region gained collections — the
// caller uses it to clear the freeze list and to tag the update event as a
// new scan.
public machine ScanInitializer::initialize_snapshot_scan_results_if_empty(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    data_type_refs: &|snapshot_region|::DataTypeRefSet,
    memory_alignment: |memory_alignment|::MemoryAlignment
) -> bool {
    let hoist1: u64 = |snapshot_region|::DataTypeRefSet::get_count(&data_type_refs);
    transition hoist1 == 0 {
        true -> (false)
        false -> probe(engine_privileged_state, data_type_refs, memory_alignment, 0, false)
    }

    machine probe(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        data_type_refs: &|snapshot_region|::DataTypeRefSet,
        memory_alignment: |memory_alignment|::MemoryAlignment,
        position: u64,
        did_initialize: bool
    ) -> bool {
        let snapshot: &|snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let region_count: u64 = |snapshot|::Snapshot::get_region_count(snapshot);
        transition position < region_count {
            true -> measure(engine_privileged_state, data_type_refs, memory_alignment, position, did_initialize)
            false -> finish(engine_privileged_state, did_initialize)
        }
    }

    // Upstream `snapshot.clear_deleted_scan_result_indices()` — a fresh
    // seed retires the tombstones from the snapshot it replaced.
    machine finish(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        did_initialize: bool
    ) -> bool {
        transition did_initialize {
            true -> clear_deleted(engine_privileged_state)
            false -> (did_initialize)
            _ -> (did_initialize)
        }
    }

    machine clear_deleted(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
    ) -> bool {
        let snapshot: &mut |snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot_mut(&mut engine_privileged_state);
        |snapshot|::Snapshot::clear_deleted_scan_result_indices(snapshot);
        transition { _ -> (true) }
    }

    // Upstream checks each region's had/has around the seed loop; since the
    // seed only fills regions that had no collections, a region that starts
    // empty and ends populated is exactly `did_initialize`. The port checks
    // the same condition one region at a time.
    machine measure(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        data_type_refs: &|snapshot_region|::DataTypeRefSet,
        memory_alignment: |memory_alignment|::MemoryAlignment,
        position: u64,
        did_initialize: bool
    ) -> bool {
        let snapshot_before: &|snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let region_before: |snapshot_region|::SnapshotRegion = |snapshot|::Snapshot::get_region(snapshot_before, position);
        let results_before: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&region_before);
        let had_scan_results: bool = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_collection_count(&results_before) > 0;
        let set: |snapshot_region|::DataTypeRefSet = |snapshot_region|::DataTypeRefSet::clone(data_type_refs);
        let snapshot_mut: &mut |snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot_mut(&mut engine_privileged_state);
        |snapshot|::Snapshot::initialize_region_scan_results(snapshot_mut, position, set, memory_alignment);
        let snapshot_after: &|snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let region_after: |snapshot_region|::SnapshotRegion = |snapshot|::Snapshot::get_region(snapshot_after, position);
        let results_after: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&region_after);
        let has_scan_results: bool = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_collection_count(&results_after) > 0;
        transition { _ -> probe(
            engine_privileged_state,
            data_type_refs,
            memory_alignment,
            ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64,
            did_initialize || (!had_scan_results && has_scan_results)) }
    }

}
