module src::command_executors::scan_initializer;

use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use squalr_engine_api::src::structures::snapshots::snapshot_region::DataTypeRefSet;
use squalr_engine_api::src::structures::snapshots::snapshot_region::SnapshotRegion;
use squalr_engine_api::src::structures::results::snapshot_region_scan_results::SnapshotRegionScanResults;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::snapshot_region_builder::SnapshotRegionBuilder;

// Port of commands/scan/scan_initializer.rs — the shared scan-start glue the
// collect-values and struct-scan executors call before reading values.
//
// `ensure_snapshot_regions_for_scan`: upstream reads live page bounds through
// the target's memory queryer and merges them into snapshot regions; the
// sanctioned supplied source yields the same bound sequence for the captured
// target — the same substitution the scan-new executor names.
//
// `initialize_snapshot_scan_results_if_empty`: seeds a whole-region filter
// collection per requested data type into every region that has none and
// reports whether any region was seeded. Upstream then clears the pending
// delete tombstones; the tombstone set ships with the delete command leg
// (Snapshot header deviation), so the clear has no carrier here yet.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ScanInitializer {}

pub machine ScanInitializer::ensure_snapshot_regions(
    engine_privileged_state: &mut EnginePrivilegedState
) {
    let snapshot: &Snapshot = EnginePrivilegedState::borrow_snapshot(engine_privileged_state);
        let region_count: u64 = Snapshot::get_region_count(snapshot);
    transition region_count == 0 {
        true -> fill(engine_privileged_state)
        false -> done()
    }

    state fill(engine_privileged_state: &mut EnginePrivilegedState) {
        let mut builder: SnapshotRegionBuilder = SnapshotRegionBuilder::new();
        let mut snapshot: Snapshot = Snapshot::new();
        SnapshotRegionBuilder::fill_from_supplied_source(
            &mut builder,
            EnginePrivilegedState::get_supplied_memory_source(engine_privileged_state));
        SnapshotRegionBuilder::fill_snapshot(&builder, &mut snapshot);
        EnginePrivilegedState::set_snapshot(engine_privileged_state, snapshot);
        transition { _ -> done() }
    }

    state done() {
    }
}

// Upstream returns true when at least one region gained collections — the
// caller uses it to clear the freeze list and to tag the update event as a
// new scan.
pub machine ScanInitializer::initialize_snapshot_scan_results_if_empty(
    engine_privileged_state: &mut EnginePrivilegedState,
    data_type_refs: &DataTypeRefSet,
    memory_alignment: MemoryAlignment
) -> bool {
    transition DataTypeRefSet::get_count(data_type_refs) == 0 {
        true -> (false)
        false -> probe(engine_privileged_state, data_type_refs, memory_alignment, 0, false)
    }

    state probe(
        engine_privileged_state: &mut EnginePrivilegedState,
        data_type_refs: &DataTypeRefSet,
        memory_alignment: MemoryAlignment,
        position: u64,
        did_initialize: bool
    ) -> bool {
        let snapshot: &Snapshot = EnginePrivilegedState::borrow_snapshot(engine_privileged_state);
        let region_count: u64 = Snapshot::get_region_count(snapshot);
        transition position < region_count {
            true -> measure(engine_privileged_state, data_type_refs, memory_alignment, position, did_initialize)
            false -> finish(engine_privileged_state, did_initialize)
        }
    }

    // Upstream `snapshot.clear_deleted_scan_result_indices()` — a fresh
    // seed retires the tombstones from the snapshot it replaced.
    state finish(
        engine_privileged_state: &mut EnginePrivilegedState,
        did_initialize: bool
    ) -> bool {
        transition did_initialize {
            true -> clear_deleted(engine_privileged_state)
            false -> (did_initialize)
            _ -> (did_initialize)
        }
    }

    state clear_deleted(
        engine_privileged_state: &mut EnginePrivilegedState
    ) -> bool {
        let snapshot_mut: &mut Snapshot = EnginePrivilegedState::borrow_snapshot_mut(engine_privileged_state);
        Snapshot::clear_deleted_scan_result_indices(snapshot_mut);
        transition { _ -> (true) }
    }

    // Upstream checks each region's had/has around the seed loop; since the
    // seed only fills regions that had no collections, a region that starts
    // empty and ends populated is exactly `did_initialize`. The port checks
    // the same condition one region at a time.
    state measure(
        engine_privileged_state: &mut EnginePrivilegedState,
        data_type_refs: &DataTypeRefSet,
        memory_alignment: MemoryAlignment,
        position: u64,
        did_initialize: bool
    ) -> bool {
        let snapshot: &Snapshot = EnginePrivilegedState::borrow_snapshot(engine_privileged_state);
        let region: SnapshotRegion = Snapshot::get_region(snapshot, position);
        let scan_results: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&region);
        let had_scan_results: bool = SnapshotRegionScanResults::get_collection_count(&scan_results) > 0;
        let set: DataTypeRefSet = DataTypeRefSet::clone(data_type_refs);
        let snapshot_mut: &mut Snapshot = EnginePrivilegedState::borrow_snapshot_mut(engine_privileged_state);
        Snapshot::initialize_region_scan_results(snapshot_mut, position, set, memory_alignment);
        let snapshot_after: &Snapshot = EnginePrivilegedState::borrow_snapshot(engine_privileged_state);
        let region_after: SnapshotRegion = Snapshot::get_region(snapshot_after, position);
        let scan_results_after: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&region_after);
        let has_scan_results: bool = SnapshotRegionScanResults::get_collection_count(&scan_results_after) > 0;
        transition { _ -> probe(
            engine_privileged_state,
            data_type_refs,
            memory_alignment,
            ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64,
            did_initialize || (!had_scan_results && has_scan_results)) }
    }

}
