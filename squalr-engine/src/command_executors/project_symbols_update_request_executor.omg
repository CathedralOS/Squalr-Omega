module src::command_executors::project_symbols_update_request_executor;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::project_symbols::update::project_symbols_update_request::ProjectSymbolsUpdateRequest;
use squalr_engine_api::src::commands::project_symbols::update::project_symbols_update_response::ProjectSymbolsUpdateResponse;
use squalr_engine_api::src::structures::projects::project::Project;
use squalr_engine_api::src::structures::projects::project_info::ProjectInfo;
use squalr_engine_api::src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use squalr_engine_session::src::projects::project_manager::ProjectManager;
use src::engine_bindings::standalone_engine_api_unprivileged_bindings::StandaloneEngineApiUnprivilegedBindings;
use src::services::projects::project_symbol_catalog_mutation::ProjectSymbolCatalogMutation;
use src::services::projects::project_symbol_catalog_mutation::CatalogMutationResult;
use src::services::projects::project_symbol_catalog_persistence::ProjectSymbolCatalogPersistence;

// Port of command_executors/project_symbols/update/
// project_symbols_update_request_executor.rs — apply the display-name /
// struct-layout / metadata edits to the matched claim or module field,
// then save + sync.
// Deviations:
// - upstream's `Result<(), String>` folds to CatalogMutationResult
//   Succeeded/Refused; a refused update responds default() with no locator
//   key (upstream returns default() on the error path).
// - the project directory resolves inside save_and_sync (upstream resolved
//   it early only to pass it through).
pub data ProjectSymbolsUpdateRequestExecutor {}

pub linux_x86_64 machine ProjectSymbolsUpdateRequestExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_symbols_update_request: &ProjectSymbolsUpdateRequest
) -> ProjectSymbolsUpdateResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
    transition ProjectManager::get_has_opened_project(project_manager) {
        true -> mutate(engine_unprivileged_state, engine_bindings, project_symbols_update_request)
        _ -> (refused())
    }
    state refused() -> ProjectSymbolsUpdateResponse {
        (ProjectSymbolsUpdateResponse::new())
    }
    state mutate(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_update_request: &ProjectSymbolsUpdateRequest) -> ProjectSymbolsUpdateResponse {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        let opened_project: &mut Project = ProjectManager::borrow_opened_project_mut(project_manager);
        let project_info: &mut ProjectInfo = Project::borrow_project_info_mut(opened_project);
        let project_symbol_catalog: &mut ProjectSymbolCatalog = ProjectInfo::borrow_project_symbol_catalog_mut(project_info);
        let mut mutation: ProjectSymbolCatalogMutation = ProjectSymbolCatalogMutation {};
        let result: CatalogMutationResult = ProjectSymbolCatalogMutation::update_project_symbol(&mut mutation, engine_unprivileged_state, project_symbol_catalog, project_symbols_update_request);
        transition result {
            CatalogMutationResult::Succeeded -> save(engine_unprivileged_state, engine_bindings, project_symbols_update_request)
            _ -> (refused())
        }
    }
    state save(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_update_request: &ProjectSymbolsUpdateRequest) -> ProjectSymbolsUpdateResponse {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        let opened_project: &mut Project = ProjectManager::borrow_opened_project_mut(project_manager);
        transition ProjectSymbolCatalogPersistence::save_and_sync_project_symbol_catalog(engine_bindings, opened_project) {
            true -> succeed(project_symbols_update_request)
            _ -> (refused())
        }
    }
    state succeed(project_symbols_update_request: &ProjectSymbolsUpdateRequest) -> ProjectSymbolsUpdateResponse {
        let mut response: ProjectSymbolsUpdateResponse = ProjectSymbolsUpdateResponse::new();
        ProjectSymbolsUpdateResponse::set_success(&mut response, true);
        ProjectSymbolsUpdateResponse::set_symbol_locator_key(&mut response, ProjectSymbolsUpdateRequest::get_symbol_locator_key(project_symbols_update_request));
        (response)
    }
}
