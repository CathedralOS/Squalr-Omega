use {squalr_engine_api}/src/commands/patches/no_operation/patch_no_operation_request.omg;
use {squalr_engine_api}/src/commands/patches/no_operation/patch_no_operation_response.omg;
use {squalr_engine_api}/src/structures/patches/patch_command_status.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_api}/src/structures/processes/target_architecture.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/patches/patch_service.omg;

// Port of command_executors/patches/no_operation/patch_no_operation_request_executor.rs —
// upstream resolves the normalized instruction address, asks the plugin
// registry for the target architecture's instruction set, fills the patch
// with that architecture's no-op bytes and applies it. The headless port
// has no plugin subsystem: `find_instruction_set` returns false, so the
// executor takes upstream's own failure path verbatim ("No instruction
// set plugin is enabled for target architecture '{id}'."). The `found`
// arm lands on the same failure until instruction-set plugins exist —
// the port cannot fabricate architecture no-op bytes.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data PatchNoOperationRequestExecutor {}

public machine PatchNoOperationRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    patch_no_operation_request: &|patch_no_operation_request|::PatchNoOperationRequest
) -> |patch_no_operation_response|::PatchNoOperationResponse {
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> resolve(engine_privileged_state, patch_no_operation_request)
        _ -> absent()
    }

    machine absent() -> |patch_no_operation_response|::PatchNoOperationResponse {
        (|patch_no_operation_response|::PatchNoOperationResponse::new(|patch_command_status|::PatchCommandStatus::failure("No opened process to patch.")))
    }

    // Upstream `normalize_instruction_address` + `instruction_set_id` on
    // the opened process's target architecture; the instruction-set id is
    // what the failure path reports.
    machine resolve(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        patch_no_operation_request: &|patch_no_operation_request|::PatchNoOperationRequest
    ) -> |patch_no_operation_response|::PatchNoOperationResponse {
        let opened_process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        let architecture: |target_architecture|::TargetArchitecture = |opened_process_info|::OpenedProcessInfo::get_target_architecture(&opened_process_info);
        let instruction_set_id: &[u8] = |target_architecture|::TargetArchitecture::get_instruction_set_id(&architecture);
        transition {
            _ -> probe(engine_privileged_state, instruction_set_id)
        }
    }

    machine probe(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        instruction_set_id: &[u8]
    ) -> |patch_no_operation_response|::PatchNoOperationResponse {
        let found: bool = |engine_privileged_state|::EnginePrivilegedState::find_instruction_set(&mut engine_privileged_state, instruction_set_id);
        transition found {
            true -> missing(instruction_set_id)
            false -> missing(instruction_set_id)
            _ -> missing(instruction_set_id)
        }
    }

    machine missing(instruction_set_id: &[u8]) -> |patch_no_operation_response|::PatchNoOperationResponse {
        let mut error: |patch_service|::PatchServiceError = |patch_service|::PatchServiceError::empty();
        |patch_service|::PatchServiceError::put(&mut error, "No instruction set plugin is enabled for target architecture '");
        |patch_service|::PatchServiceError::put(&mut error, instruction_set_id);
        |patch_service|::PatchServiceError::put(&mut error, "'.");
        let message: &[u8] = |patch_service|::PatchServiceError::get_message(&error);
        (|patch_no_operation_response|::PatchNoOperationResponse::new(|patch_command_status|::PatchCommandStatus::failure(message)))
    }
}
