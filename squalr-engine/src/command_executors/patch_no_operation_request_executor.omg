module src::command_executors::patch_no_operation_request_executor;

use squalr_engine_api::src::commands::patches::no_operation::patch_no_operation_request::PatchNoOperationRequest;
use squalr_engine_api::src::commands::patches::no_operation::patch_no_operation_response::PatchNoOperationResponse;
use squalr_engine_api::src::structures::patches::patch_command_status::PatchCommandStatus;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::processes::target_architecture::TargetArchitecture;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::patches::patch_service::PatchServiceError;

// Port of command_executors/patches/no_operation/patch_no_operation_request_executor.rs —
// upstream resolves the normalized instruction address, asks the plugin
// registry for the target architecture's instruction set, fills the patch
// with that architecture's no-op bytes and applies it. The headless port
// has no plugin subsystem: `find_instruction_set` returns false, so the
// executor takes upstream's own failure path verbatim ("No instruction
// set plugin is enabled for target architecture '{id}'."). The `found`
// arm lands on the same failure until instruction-set plugins exist —
// the port cannot fabricate architecture no-op bytes.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data PatchNoOperationRequestExecutor {}

pub machine PatchNoOperationRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    patch_no_operation_request: &PatchNoOperationRequest
) -> PatchNoOperationResponse {
    let hoist1: bool = EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> resolve(engine_privileged_state, patch_no_operation_request)
        _ -> absent()
    }

    state absent() -> PatchNoOperationResponse {
        (PatchNoOperationResponse::new(PatchCommandStatus::failure("No opened process to patch.")))
    }

    // Upstream `normalize_instruction_address` + `instruction_set_id` on
    // the opened process's target architecture; the instruction-set id is
    // what the failure path reports.
    state resolve(
        engine_privileged_state: &mut EnginePrivilegedState,
        patch_no_operation_request: &PatchNoOperationRequest
    ) -> PatchNoOperationResponse {
        let opened_process_info: OpenedProcessInfo = EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        let architecture: TargetArchitecture = OpenedProcessInfo::get_target_architecture(&opened_process_info);
        let instruction_set_id: &[u8] = TargetArchitecture::get_instruction_set_id(&architecture);
        transition {
            _ -> probe(engine_privileged_state, instruction_set_id)
        }
    }

    state probe(
        engine_privileged_state: &mut EnginePrivilegedState,
        instruction_set_id: &[u8]
    ) -> PatchNoOperationResponse {
        let found: bool = EnginePrivilegedState::find_instruction_set(&mut engine_privileged_state, instruction_set_id);
        transition found {
            true -> missing(instruction_set_id)
            false -> missing(instruction_set_id)
            _ -> missing(instruction_set_id)
        }
    }

    state missing(instruction_set_id: &[u8]) -> PatchNoOperationResponse {
        let mut error: PatchServiceError = PatchServiceError::empty();
        PatchServiceError::put(&mut error, "No instruction set plugin is enabled for target architecture '");
        PatchServiceError::put(&mut error, instruction_set_id);
        PatchServiceError::put(&mut error, "'.");
        let message: &[u8] = PatchServiceError::get_message(&error);
        (PatchNoOperationResponse::new(PatchCommandStatus::failure(message)))
    }
}
