module src::command_executors::unprivileged_command_executor;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::unprivileged_command::UnprivilegedCommand;
use squalr_engine_api::src::commands::unprivileged_command_response::UnprivilegedCommandResponse;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use src::engine_bindings::standalone_engine_api_unprivileged_bindings::StandaloneEngineApiUnprivilegedBindings;
use src::command_executors::project_command_executor::ProjectCommandExecutor;
use src::command_executors::project_items_command_executor::ProjectItemsCommandExecutor;
use src::command_executors::project_symbols_command_executor::ProjectSymbolsCommandExecutor;

// Port of command_executors/unprivileged_command_executor.rs — the
// `ExecutableCommandUnprivleged for UnprivilegedCommand` match. Upstream
// passes the execution context alone; the port carries the bindings
// record as a second context because executors' privileged hops (symbol
// sync, plugin dispatch) reach the bindings directly instead of through
// `state.get_bindings()` (the standalone session does not nest the
// bindings inside the unprivileged state). Domain routers already return
// the root union via `to_engine_response`, so the root delegates without
// re-wrapping.
pub data UnprivilegedCommandExecutor {}

pub machine UnprivilegedCommandExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    unprivileged_command: &UnprivilegedCommand
) -> UnprivilegedCommandResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    transition unprivileged_command {
        UnprivilegedCommand::Project { command } -> (ProjectCommandExecutor::execute(engine_unprivileged_state, engine_bindings, &command))
        UnprivilegedCommand::ProjectItems { command } -> (ProjectItemsCommandExecutor::execute(engine_unprivileged_state, engine_bindings, &command))
        UnprivilegedCommand::ProjectSymbols { command } -> (ProjectSymbolsCommandExecutor::execute(engine_unprivileged_state, engine_bindings, &command))
    }
}
