module src::command_executors::project_symbols_delete_resolver_request_executor;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::project_symbols::delete_resolver::project_symbols_delete_resolver_request::ProjectSymbolsDeleteResolverRequest;
use squalr_engine_api::src::commands::project_symbols::delete_resolver::project_symbols_delete_resolver_response::ProjectSymbolsDeleteResolverResponse;
use squalr_engine_api::src::structures::projects::project::Project;
use squalr_engine_api::src::structures::projects::project_info::ProjectInfo;
use squalr_engine_api::src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use squalr_engine_session::src::projects::project_manager::ProjectManager;
use src::engine_bindings::standalone_engine_api_unprivileged_bindings::StandaloneEngineApiUnprivilegedBindings;
use src::services::projects::project_symbol_resolver_mutation::ProjectSymbolResolverMutation;
use src::services::projects::project_symbol_resolver_mutation::ResolverMutationResult;
use src::services::projects::project_symbol_catalog_persistence::ProjectSymbolCatalogPersistence;

// Port of command_executors/project_symbols/delete_resolver/
// project_symbols_delete_resolver_request_executor.rs — remove the
// resolver descriptor, then save + sync.
// Deviations:
// - upstream's `Result<(), String>` folds to ResolverMutationResult
//   Succeeded/Refused; the refused arm returns the resolver id with a
//   generic error message (the Err string is not carried).
// - the project directory resolves inside save_and_sync (upstream resolved
//   it early only to pass it through).
pub data ProjectSymbolsDeleteResolverRequestExecutor {}

pub linux_x86_64 machine ProjectSymbolsDeleteResolverRequestExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_symbols_delete_resolver_request: &ProjectSymbolsDeleteResolverRequest
) -> ProjectSymbolsDeleteResolverResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
    transition ProjectManager::get_has_opened_project(project_manager) {
        true -> mutate(engine_unprivileged_state, engine_bindings, project_symbols_delete_resolver_request)
        _ -> (fail(ProjectSymbolsDeleteResolverRequest::get_resolver_id(project_symbols_delete_resolver_request), "Cannot delete a symbol resolver without an opened project."))
    }
    state mutate(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_delete_resolver_request: &ProjectSymbolsDeleteResolverRequest) -> ProjectSymbolsDeleteResolverResponse {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        let opened_project: &mut Project = ProjectManager::borrow_opened_project_mut(project_manager);
        let project_info: &mut ProjectInfo = Project::borrow_project_info_mut(opened_project);
        let project_symbol_catalog: &mut ProjectSymbolCatalog = ProjectInfo::borrow_project_symbol_catalog_mut(project_info);
        let mut mutation: ProjectSymbolResolverMutation = ProjectSymbolResolverMutation {};
        let inner76: &[u8] = ProjectSymbolsDeleteResolverRequest::get_resolver_id(project_symbols_delete_resolver_request);
        let result: ResolverMutationResult = ProjectSymbolResolverMutation::delete_resolver(&mut mutation, project_symbol_catalog, inner76);
        transition result {
            ResolverMutationResult::Succeeded -> save(engine_unprivileged_state, engine_bindings, project_symbols_delete_resolver_request)
            _ -> (fail(ProjectSymbolsDeleteResolverRequest::get_resolver_id(project_symbols_delete_resolver_request), "Failed to delete the symbol resolver."))
        }
    }
    state save(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_delete_resolver_request: &ProjectSymbolsDeleteResolverRequest) -> ProjectSymbolsDeleteResolverResponse {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        let opened_project: &mut Project = ProjectManager::borrow_opened_project_mut(project_manager);
        transition ProjectSymbolCatalogPersistence::save_and_sync_project_symbol_catalog(engine_bindings, opened_project) {
            true -> succeed(project_symbols_delete_resolver_request)
            _ -> (fail(ProjectSymbolsDeleteResolverRequest::get_resolver_id(project_symbols_delete_resolver_request), "Failed to save and sync project symbol catalog."))
        }
    }
    state succeed(project_symbols_delete_resolver_request: &ProjectSymbolsDeleteResolverRequest) -> ProjectSymbolsDeleteResolverResponse {
        let mut response: ProjectSymbolsDeleteResolverResponse = ProjectSymbolsDeleteResolverResponse::new();
        ProjectSymbolsDeleteResolverResponse::set_success(&mut response, true);
        ProjectSymbolsDeleteResolverResponse::set_resolver_id(&mut response, ProjectSymbolsDeleteResolverRequest::get_resolver_id(project_symbols_delete_resolver_request));
        (response)
    }
    state fail(id: &[u8], message: &[u8]) -> ProjectSymbolsDeleteResolverResponse {
        let mut response: ProjectSymbolsDeleteResolverResponse = ProjectSymbolsDeleteResolverResponse::new();
        ProjectSymbolsDeleteResolverResponse::set_resolver_id(&mut response, id);
        ProjectSymbolsDeleteResolverResponse::set_error(&mut response, message);
        (response)
    }
}
