module src::command_executors::process_command_executor;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::process::close::process_close_request::ProcessCloseRequest;
use squalr_engine_api::src::commands::process::close::process_close_response::ProcessCloseResponse;
use squalr_engine_api::src::commands::process::icon::process_icon_request::ProcessIconRequest;
use squalr_engine_api::src::commands::process::icon::process_icon_response::ProcessIconResponse;
use squalr_engine_api::src::commands::process::list::process_list_request::ProcessListRequest;
use squalr_engine_api::src::commands::process::list::process_list_response::ProcessListResponse;
use squalr_engine_api::src::commands::process::open::process_open_request::ProcessOpenRequest;
use squalr_engine_api::src::commands::process::open::process_open_response::ProcessOpenResponse;
use squalr_engine_api::src::commands::process::process_command::ProcessCommand;
use squalr_engine_api::src::commands::process::process_response::ProcessResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::process_close_request_executor::ProcessCloseRequestExecutor;
use src::command_executors::process_icon_request_executor::ProcessIconRequestExecutor;
use src::command_executors::process_list_request_executor::ProcessListRequestExecutor;
use src::command_executors::process_open_request_executor::ProcessOpenRequestExecutor;

// Port of command_executors/process/process_command_executor.rs — routes
// the process command union to the per-request executor and wraps each
// typed response in the matching `ProcessResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ProcessCommandExecutor {}

pub machine ProcessCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    process_command: &ProcessCommand
) -> ProcessResponse
reaches FilesystemHost
invokes FilesystemHost;
crashes Trap
{
    transition process_command {
        ProcessCommand::Open { request } -> open(engine_privileged_state, &request)
        ProcessCommand::List { request } -> list(engine_privileged_state, &request)
        ProcessCommand::Icon { request } -> icon(engine_privileged_state, &request)
        ProcessCommand::Close { request } -> close(engine_privileged_state, &request)
    }

    state open(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ProcessOpenRequest
    ) -> ProcessResponse
    {
        let response: ProcessOpenResponse = ProcessOpenRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (ProcessResponse::Open { response: response }) }
    }

    state list(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ProcessListRequest
    ) -> ProcessResponse
    {
        let response: ProcessListResponse = ProcessListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (ProcessResponse::List { response: response }) }
    }

    state icon(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ProcessIconRequest
    ) -> ProcessResponse
    {
        let response: ProcessIconResponse = ProcessIconRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (ProcessResponse::Icon { response: response }) }
    }

    state close(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ProcessCloseRequest
    ) -> ProcessResponse
    {
        let response: ProcessCloseResponse = ProcessCloseRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (ProcessResponse::Close { response: response }) }
    }
}
