use {omega}/language/core/filesystem_authority.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/commands/process/close/process_close_request.omg;
use {squalr_engine_api}/src/commands/process/close/process_close_response.omg;
use {squalr_engine_api}/src/commands/process/icon/process_icon_request.omg;
use {squalr_engine_api}/src/commands/process/icon/process_icon_response.omg;
use {squalr_engine_api}/src/commands/process/list/process_list_request.omg;
use {squalr_engine_api}/src/commands/process/list/process_list_response.omg;
use {squalr_engine_api}/src/commands/process/open/process_open_request.omg;
use {squalr_engine_api}/src/commands/process/open/process_open_response.omg;
use {squalr_engine_api}/src/commands/process/process_command.omg;
use {squalr_engine_api}/src/commands/process/process_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/process_close_request_executor.omg;
use src/command_executors/process_icon_request_executor.omg;
use src/command_executors/process_list_request_executor.omg;
use src/command_executors/process_open_request_executor.omg;

// Port of command_executors/process/process_command_executor.rs — routes
// the process command union to the per-request executor and wraps each
// typed response in the matching `ProcessResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ProcessCommandExecutor {}

public machine ProcessCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    process_command: &|process_command|::ProcessCommand
) -> |process_response|::ProcessResponse
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
crashes Trap
{
    transition process_command {
        |process_command|::ProcessCommand::Open { request } -> open(engine_privileged_state, &request)
        |process_command|::ProcessCommand::List { request } -> list(engine_privileged_state, &request)
        |process_command|::ProcessCommand::Icon { request } -> icon(engine_privileged_state, &request)
        |process_command|::ProcessCommand::Close { request } -> close(engine_privileged_state, &request)
    }

    machine open(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|process_open_request|::ProcessOpenRequest
    ) -> |process_response|::ProcessResponse
    {
        let response: |process_open_response|::ProcessOpenResponse = |process_open_request_executor|::ProcessOpenRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|process_response|::ProcessResponse::Open { response: response }) }
    }

    machine list(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|process_list_request|::ProcessListRequest
    ) -> |process_response|::ProcessResponse
    {
        let response: |process_list_response|::ProcessListResponse = |process_list_request_executor|::ProcessListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|process_response|::ProcessResponse::List { response: response }) }
    }

    machine icon(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|process_icon_request|::ProcessIconRequest
    ) -> |process_response|::ProcessResponse
    {
        let response: |process_icon_response|::ProcessIconResponse = |process_icon_request_executor|::ProcessIconRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|process_response|::ProcessResponse::Icon { response: response }) }
    }

    machine close(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|process_close_request|::ProcessCloseRequest
    ) -> |process_response|::ProcessResponse
    {
        let response: |process_close_response|::ProcessCloseResponse = |process_close_request_executor|::ProcessCloseRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|process_response|::ProcessResponse::Close { response: response }) }
    }
}
