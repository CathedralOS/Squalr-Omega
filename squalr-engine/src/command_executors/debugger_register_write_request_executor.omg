use {squalr_engine_api}/src/commands/debugger/register_write/debugger_register_write_request.omg;
use {squalr_engine_api}/src/commands/debugger/register_write/debugger_register_write_response.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_command_status.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_register_snapshot.omg;
use {squalr_engine_session}/src/debugger/debugger_service.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/debugger/mod.rs::DebuggerRegisterWriteRequest —
// service.write_register(register_name, value) -> Some(snapshot) / Err.
public data DebuggerRegisterWriteRequestExecutor {}

public machine DebuggerRegisterWriteRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    debugger_register_write_request: &|debugger_register_write_request|::DebuggerRegisterWriteRequest
) -> |debugger_register_write_response|::DebuggerRegisterWriteResponse {
    let register_name: &[u8] = |debugger_register_write_request|::DebuggerRegisterWriteRequest::get_register_name(&debugger_register_write_request);
    let value: u64 = |debugger_register_write_request|::DebuggerRegisterWriteRequest::get_value(&debugger_register_write_request);
    let outcome: |debugger_service|::DebuggerRegisterOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_write_register(&mut engine_privileged_state, register_name,
        value);
    transition outcome.succeeded {
        true -> succeeded(outcome)
        _ -> failed(outcome)
    }

    machine succeeded(outcome: |debugger_service|::DebuggerRegisterOutcome) -> |debugger_register_write_response|::DebuggerRegisterWriteResponse {
        let mut response: |debugger_register_write_response|::DebuggerRegisterWriteResponse = |debugger_register_write_response|::DebuggerRegisterWriteResponse::new();
        |debugger_register_write_response|::DebuggerRegisterWriteResponse::set_register_snapshot(&mut response, |debugger_register_snapshot|::DebuggerRegisterSnapshot::clone(&outcome.register_snapshot));
        (response)
    }

    machine failed(outcome: |debugger_service|::DebuggerRegisterOutcome) -> |debugger_register_write_response|::DebuggerRegisterWriteResponse {
        let mut response: |debugger_register_write_response|::DebuggerRegisterWriteResponse = |debugger_register_write_response|::DebuggerRegisterWriteResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, |debugger_service|::DebuggerRegisterOutcome::get_error_message(outcome));
        |debugger_register_write_response|::DebuggerRegisterWriteResponse::set_status(&mut response, status);
        (response)
    }
}
