module src::command_executors::debugger_register_write_request_executor;

use squalr_engine_api::src::commands::debugger::register_write::debugger_register_write_request::DebuggerRegisterWriteRequest;
use squalr_engine_api::src::commands::debugger::register_write::debugger_register_write_response::DebuggerRegisterWriteResponse;
use squalr_engine_api::src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use squalr_engine_api::src::structures::debugger::debugger_register_snapshot::DebuggerRegisterSnapshot;
use squalr_engine_session::src::debugger::debugger_service::DebuggerRegisterOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/debugger/mod.rs::DebuggerRegisterWriteRequest —
// service.write_register(register_name, value) -> Some(snapshot) / Err.
pub data DebuggerRegisterWriteRequestExecutor {}

pub machine DebuggerRegisterWriteRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_register_write_request: &DebuggerRegisterWriteRequest
) -> DebuggerRegisterWriteResponse {
    let register_name: &[u8] = debugger_register_write_request.get_register_name();
    let value: u64 = debugger_register_write_request.get_value();
    let outcome: DebuggerRegisterOutcome = engine_privileged_state.debugger_write_register(
        register_name,
        value);
    transition outcome.succeeded {
        true -> succeeded(outcome)
        _ -> failed(outcome)
    }

    state succeeded(outcome: DebuggerRegisterOutcome) -> DebuggerRegisterWriteResponse {
        let mut response: DebuggerRegisterWriteResponse = DebuggerRegisterWriteResponse::new();
        response.set_register_snapshot(DebuggerRegisterSnapshot::clone(&outcome.register_snapshot));
        (response)
    }

    state failed(outcome: DebuggerRegisterOutcome) -> DebuggerRegisterWriteResponse {
        let mut response: DebuggerRegisterWriteResponse = DebuggerRegisterWriteResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        status.set_message(outcome.get_error_message());
        response.set_status(status);
        (response)
    }
}
