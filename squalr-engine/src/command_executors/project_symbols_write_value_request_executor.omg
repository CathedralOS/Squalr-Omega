use src::services::projects::project_symbol_runtime_value_write::SymbolWritePlan;

// Port of command_executors/project_symbols/write_value/
// project_symbols_write_value_request_executor.rs — plan the write against
// a CLONED catalog (upstream drops the read guard before the privileged
// hop — the clone detaches), then hop MemoryWrite through the bindings.
// Deviations:
// - upstream's mpsc+recv_timeout collapses to the in-session sync dispatch
//   (same hop as every other privileged call on this lane).
// - bounded 256-byte name buffers replace String carriers.
pub data ProjectSymbolsWriteValueRequestExecutor {}

pub linux_x86_64 machine ProjectSymbolsWriteValueRequestExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_symbols_write_value_request: &ProjectSymbolsWriteValueRequest
) -> ProjectSymbolsWriteValueResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
    transition ProjectManager::get_has_opened_project(project_manager) {
        true -> clone_catalog(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request)
        _ -> (fail("Cannot write a project symbol value without an opened project."))
    }
    state clone_catalog(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_write_value_request: &ProjectSymbolsWriteValueRequest) -> ProjectSymbolsWriteValueResponse {
        let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
        let opened_project: &Project = ProjectManager::get_opened_project(project_manager);
        let inner29: &ProjectSymbolCatalog = Project::get_project_symbol_catalog(opened_project);
        let project_symbol_catalog: ProjectSymbolCatalog = ProjectSymbolCatalog::clone(inner29);
        let mut empty_module_name: [u8; 256];
        let mut empty_symbol_type_id: [u8; 256];
        let mut empty_field_name: [u8; 256];
        ProjectSymbolsWriteValueRequestExecutor::zero_256(&mut empty_module_name);
        ProjectSymbolsWriteValueRequestExecutor::zero_256(&mut empty_symbol_type_id);
        ProjectSymbolsWriteValueRequestExecutor::zero_256(&mut empty_field_name);
        let mut write_plan_request: SymbolRuntimeValueWritePlanRequest = SymbolRuntimeValueWritePlanRequest {
            address: ProjectSymbolsWriteValueRequest::get_address(project_symbols_write_value_request),
            module_name: empty_module_name,
            module_name_len: 0,
            symbol_type_id: empty_symbol_type_id,
            symbol_type_id_len: 0,
            container_type: ContainerType::clone(ProjectSymbolsWriteValueRequest::get_container_type(project_symbols_write_value_request)),
            field_name: empty_field_name,
            field_name_len: 0,
            anonymous_value_string: AnonymousValueString::clone(ProjectSymbolsWriteValueRequest::get_anonymous_value_string(project_symbols_write_value_request)),
        };
        transition { _ -> fill_module(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request, project_symbol_catalog, write_plan_request) }
    }
    state fill_module(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_write_value_request: &ProjectSymbolsWriteValueRequest, project_symbol_catalog: ProjectSymbolCatalog, mut write_plan_request: SymbolRuntimeValueWritePlanRequest) -> ProjectSymbolsWriteValueResponse {
        let module_name: &[u8] = ProjectSymbolsWriteValueRequest::get_module_name(project_symbols_write_value_request);
        transition { _ -> module_at(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request, project_symbol_catalog, write_plan_request, module_name, 0) }
    }
    state module_at(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_write_value_request: &ProjectSymbolsWriteValueRequest, project_symbol_catalog: ProjectSymbolCatalog, mut write_plan_request: SymbolRuntimeValueWritePlanRequest, module_name: &[u8], position: u64) -> ProjectSymbolsWriteValueResponse {
        transition position < module_name.len && position < 256 {
            true -> module_put(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request, project_symbol_catalog, write_plan_request, module_name, position)
            _ -> fill_type(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request, project_symbol_catalog, write_plan_request)
        }
    }
    state module_put(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_write_value_request: &ProjectSymbolsWriteValueRequest, project_symbol_catalog: ProjectSymbolCatalog, mut write_plan_request: SymbolRuntimeValueWritePlanRequest, module_name: &[u8], position: u64) -> ProjectSymbolsWriteValueResponse
        requires position < 256 && position < module_name.len;
    {
        write_plan_request.module_name[position] = module_name[position];
        write_plan_request.module_name_len = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> module_at(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request, project_symbol_catalog, write_plan_request, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state fill_type(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_write_value_request: &ProjectSymbolsWriteValueRequest, project_symbol_catalog: ProjectSymbolCatalog, mut write_plan_request: SymbolRuntimeValueWritePlanRequest) -> ProjectSymbolsWriteValueResponse {
        let symbol_type_id: &[u8] = ProjectSymbolsWriteValueRequest::get_symbol_type_id(project_symbols_write_value_request);
        transition { _ -> type_at(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request, project_symbol_catalog, write_plan_request, symbol_type_id, 0) }
    }
    state type_at(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_write_value_request: &ProjectSymbolsWriteValueRequest, project_symbol_catalog: ProjectSymbolCatalog, mut write_plan_request: SymbolRuntimeValueWritePlanRequest, symbol_type_id: &[u8], position: u64) -> ProjectSymbolsWriteValueResponse {
        transition position < symbol_type_id.len && position < 256 {
            true -> type_put(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request, project_symbol_catalog, write_plan_request, symbol_type_id, position)
            _ -> fill_field(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request, project_symbol_catalog, write_plan_request)
        }
    }
    state type_put(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_write_value_request: &ProjectSymbolsWriteValueRequest, project_symbol_catalog: ProjectSymbolCatalog, mut write_plan_request: SymbolRuntimeValueWritePlanRequest, symbol_type_id: &[u8], position: u64) -> ProjectSymbolsWriteValueResponse
        requires position < 256 && position < symbol_type_id.len;
    {
        write_plan_request.symbol_type_id[position] = symbol_type_id[position];
        write_plan_request.symbol_type_id_len = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> type_at(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request, project_symbol_catalog, write_plan_request, symbol_type_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state fill_field(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_write_value_request: &ProjectSymbolsWriteValueRequest, project_symbol_catalog: ProjectSymbolCatalog, mut write_plan_request: SymbolRuntimeValueWritePlanRequest) -> ProjectSymbolsWriteValueResponse {
        let field_name: &[u8] = ProjectSymbolsWriteValueRequest::get_field_name(project_symbols_write_value_request);
        transition { _ -> field_at(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request, project_symbol_catalog, write_plan_request, field_name, 0) }
    }
    state field_at(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_write_value_request: &ProjectSymbolsWriteValueRequest, project_symbol_catalog: ProjectSymbolCatalog, mut write_plan_request: SymbolRuntimeValueWritePlanRequest, field_name: &[u8], position: u64) -> ProjectSymbolsWriteValueResponse {
        transition position < field_name.len && position < 256 {
            true -> field_put(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request, project_symbol_catalog, write_plan_request, field_name, position)
            _ -> plan(engine_unprivileged_state, engine_bindings, project_symbol_catalog, write_plan_request)
        }
    }
    state field_put(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_write_value_request: &ProjectSymbolsWriteValueRequest, project_symbol_catalog: ProjectSymbolCatalog, mut write_plan_request: SymbolRuntimeValueWritePlanRequest, field_name: &[u8], position: u64) -> ProjectSymbolsWriteValueResponse
        requires position < 256 && position < field_name.len;
    {
        write_plan_request.field_name[position] = field_name[position];
        write_plan_request.field_name_len = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> field_at(engine_unprivileged_state, engine_bindings, project_symbols_write_value_request, project_symbol_catalog, write_plan_request, field_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state plan(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbol_catalog: ProjectSymbolCatalog, write_plan_request: SymbolRuntimeValueWritePlanRequest) -> ProjectSymbolsWriteValueResponse {
        let mut service: ProjectSymbolRuntimeValueWrite = ProjectSymbolRuntimeValueWrite {};
        let plan: SymbolWritePlan = ProjectSymbolRuntimeValueWrite::build_project_symbol_runtime_value_write_request(engine_unprivileged_state, &project_symbol_catalog, &write_plan_request);
        transition plan.found {
            true -> dispatch(engine_unprivileged_state, engine_bindings, plan)
            _ -> (fail_plan(&plan))
        }
    }
    state dispatch(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, plan: SymbolWritePlan) -> ProjectSymbolsWriteValueResponse {
        let result: MemoryWriteDispatchResult = MemoryWriteDispatch::dispatch_memory_write_request(engine_bindings, &plan.request);
        transition result {
            MemoryWriteDispatchResult::Present { response } -> write_result(response)
            _ -> (fail("Privileged memory write command failed."))
        }
    }
    state write_result(response: MemoryWriteResponse) -> ProjectSymbolsWriteValueResponse {
        transition MemoryWriteResponse::get_success(&response) {
            true -> succeed()
            _ -> (fail("Privileged memory write command failed."))
        }
    }
    state succeed() -> ProjectSymbolsWriteValueResponse {
        let mut response: ProjectSymbolsWriteValueResponse = ProjectSymbolsWriteValueResponse::new();
        ProjectSymbolsWriteValueResponse::set_success(&mut response, true);
        (response)
    }
    state fail(message: &[u8]) -> ProjectSymbolsWriteValueResponse {
        let mut response: ProjectSymbolsWriteValueResponse = ProjectSymbolsWriteValueResponse::new();
        ProjectSymbolsWriteValueResponse::set_error(&mut response, message);
        (response)
    }
    state fail_plan(plan: &SymbolWritePlan) -> ProjectSymbolsWriteValueResponse {
        let mut response: ProjectSymbolsWriteValueResponse = ProjectSymbolsWriteValueResponse::new();
        transition plan.failure_len <= 256 {
            true -> put_failure(response, plan)
            _ -> (response)
        }
    }
    state put_failure(mut response: ProjectSymbolsWriteValueResponse, plan: &SymbolWritePlan) -> ProjectSymbolsWriteValueResponse
        requires plan.failure_len <= 256;
    {
        ProjectSymbolsWriteValueResponse::set_error(&mut response, &plan.failure[0..plan.failure_len]);
        (response)
    }
}

// Bounded-index zero fill for the plan request's empty name slots.
pub machine ProjectSymbolsWriteValueRequestExecutor::zero_256(out: &mut [u8; 256]) {
    transition { _ -> each(out, 0) }
    state each(out: &mut [u8; 256], position: u64) {
        transition position < 256 {
            true -> write(out, position)
            _ -> done()
        }
    }
    state write(out: &mut [u8; 256], position: u64)
        requires position < 256;
    {
        out[position] = 0;
        transition { _ -> each(out, position + 1) }
    }
    state done() { }
}
