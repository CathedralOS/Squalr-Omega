use {squalr_engine_api}/src/commands/debugger/breakpoint_set/debugger_breakpoint_set_request.omg;
use {squalr_engine_api}/src/commands/debugger/breakpoint_set/debugger_breakpoint_set_response.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_breakpoint_kind.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_breakpoint_descriptor.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_command_status.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_api}/src/structures/processes/target_architecture.omg;
use {squalr_engine_session}/src/debugger/debugger_service.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/patches/patch_service.omg;

// Port of command_executors/debugger/mod.rs::DebuggerBreakpointSetRequest —
// Software kind routes through `set_software_breakpoint_patch` (instruction-
// set plugin builds the breakpoint bytes, then apply_patch kind
// SoftwareBreakpoint, id "patch:" + patch_id); every other kind goes to the
// debugger service's set_breakpoint. Headless has no plugin subsystem:
// `find_instruction_set` is always absent, so the Software arm lands on
// upstream's own "No instruction set plugin is enabled ..." failure — the
// port cannot fabricate architecture breakpoint bytes. Same documented
// degradation as patch_no_operation_request_executor.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data DebuggerBreakpointSetRequestExecutor {}

public machine DebuggerBreakpointSetRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    debugger_breakpoint_set_request: &|debugger_breakpoint_set_request|::DebuggerBreakpointSetRequest
) -> |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse {
    transition |debugger_breakpoint_set_request|::DebuggerBreakpointSetRequest::get_kind(&debugger_breakpoint_set_request) {
        |debugger_breakpoint_kind|::DebuggerBreakpointKind::Software -> probe(engine_privileged_state, debugger_breakpoint_set_request)
        _ -> call_service(engine_privileged_state, debugger_breakpoint_set_request)
    }

    machine absent() -> |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse {
        let mut response: |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse = |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, "No opened process to debug.");
        |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse::set_status(&mut response, status);
        (response)
    }

    // `set_software_breakpoint_patch`: opened-process guard, then the
    // instruction-set probe. Both upstream plugin-miss arms (absent set,
    // empty/error byte build) share this failure message until instruction-
    // set plugins exist.
    machine probe(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        debugger_breakpoint_set_request: &|debugger_breakpoint_set_request|::DebuggerBreakpointSetRequest
    ) -> |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse {
        let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
        transition hoist1 {
            true -> resolve(engine_privileged_state)
            _ -> absent()
        }
    }

    machine resolve(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
    ) -> |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse {
        let opened_process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        let architecture: |target_architecture|::TargetArchitecture = |opened_process_info|::OpenedProcessInfo::get_target_architecture(&opened_process_info);
        let instruction_set_id: &[u8] = |target_architecture|::TargetArchitecture::get_instruction_set_id(&architecture);
        transition {
            _ -> probe_plugin(engine_privileged_state, instruction_set_id)
        }
    }

    machine probe_plugin(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        instruction_set_id: &[u8]
    ) -> |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse {
        let found: bool = |engine_privileged_state|::EnginePrivilegedState::find_instruction_set(&mut engine_privileged_state, instruction_set_id);
        transition found {
            true -> missing(instruction_set_id)
            false -> missing(instruction_set_id)
            _ -> missing(instruction_set_id)
        }
    }

    machine missing(instruction_set_id: &[u8]) -> |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse {
        let mut response: |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse = |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse::new();
        let mut error: |patch_service|::PatchServiceError = |patch_service|::PatchServiceError::empty();
        |patch_service|::PatchServiceError::put(&mut error, "No instruction set plugin is enabled for target architecture '");
        |patch_service|::PatchServiceError::put(&mut error, instruction_set_id);
        |patch_service|::PatchServiceError::put(&mut error, "'.");
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, |patch_service|::PatchServiceError::get_message(error));
        |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse::set_status(&mut response, status);
        (response)
    }

    machine call_service(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        debugger_breakpoint_set_request: &|debugger_breakpoint_set_request|::DebuggerBreakpointSetRequest
    ) -> |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse {
        let address: u64 = |debugger_breakpoint_set_request|::DebuggerBreakpointSetRequest::get_address(&debugger_breakpoint_set_request);
        let kind: |debugger_breakpoint_kind|::DebuggerBreakpointKind = |debugger_breakpoint_set_request|::DebuggerBreakpointSetRequest::get_kind(&debugger_breakpoint_set_request);
        let has_label: bool = |debugger_breakpoint_set_request|::DebuggerBreakpointSetRequest::has_label(&debugger_breakpoint_set_request);
        let label: &[u8] = |debugger_breakpoint_set_request|::DebuggerBreakpointSetRequest::get_label(&debugger_breakpoint_set_request);
        let outcome: |debugger_service|::DebuggerBreakpointOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_set_breakpoint(&mut engine_privileged_state, address,
            kind,
            has_label,
            label);
        transition outcome.succeeded && outcome.has_breakpoint {
            true -> fill(outcome)
            _ -> failed(outcome)
        }
    }

    machine fill(outcome: |debugger_service|::DebuggerBreakpointOutcome) -> |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse {
        let mut response: |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse = |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse::new();
        |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse::set_breakpoint(&mut response, |debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor::clone(&outcome.breakpoint));
        (response)
    }

    machine failed(outcome: |debugger_service|::DebuggerBreakpointOutcome) -> |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse {
        let mut response: |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse = |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, |debugger_service|::DebuggerBreakpointOutcome::get_error_message(outcome));
        |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse::set_status(&mut response, status);
        (response)
    }
}
