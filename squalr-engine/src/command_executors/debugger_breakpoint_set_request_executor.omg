module src::command_executors::debugger_breakpoint_set_request_executor;

use squalr_engine_api::src::commands::debugger::breakpoint_set::debugger_breakpoint_set_request::DebuggerBreakpointSetRequest;
use squalr_engine_api::src::commands::debugger::breakpoint_set::debugger_breakpoint_set_response::DebuggerBreakpointSetResponse;
use squalr_engine_api::src::structures::debugger::debugger_breakpoint_kind::DebuggerBreakpointKind;
use squalr_engine_api::src::structures::debugger::debugger_breakpoint_descriptor::DebuggerBreakpointDescriptor;
use squalr_engine_api::src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::processes::target_architecture::TargetArchitecture;
use squalr_engine_session::src::debugger::debugger_service::DebuggerBreakpointOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::patches::patch_service::PatchServiceError;

// Port of command_executors/debugger/mod.rs::DebuggerBreakpointSetRequest —
// Software kind routes through `set_software_breakpoint_patch` (instruction-
// set plugin builds the breakpoint bytes, then apply_patch kind
// SoftwareBreakpoint, id "patch:" + patch_id); every other kind goes to the
// debugger service's set_breakpoint. Headless has no plugin subsystem:
// `find_instruction_set` is always absent, so the Software arm lands on
// upstream's own "No instruction set plugin is enabled ..." failure — the
// port cannot fabricate architecture breakpoint bytes. Same documented
// degradation as patch_no_operation_request_executor.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data DebuggerBreakpointSetRequestExecutor {}

pub machine DebuggerBreakpointSetRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_breakpoint_set_request: &DebuggerBreakpointSetRequest
) -> DebuggerBreakpointSetResponse {
    transition debugger_breakpoint_set_request.get_kind() {
        DebuggerBreakpointKind::Software -> probe(engine_privileged_state, debugger_breakpoint_set_request)
        _ -> call_service(engine_privileged_state, debugger_breakpoint_set_request)
    }

    state absent() -> DebuggerBreakpointSetResponse {
        let mut response: DebuggerBreakpointSetResponse = DebuggerBreakpointSetResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        status.set_message("No opened process to debug.");
        response.set_status(status);
        (response)
    }

    // `set_software_breakpoint_patch`: opened-process guard, then the
    // instruction-set probe. Both upstream plugin-miss arms (absent set,
    // empty/error byte build) share this failure message until instruction-
    // set plugins exist.
    state probe(
        engine_privileged_state: &mut EnginePrivilegedState,
        debugger_breakpoint_set_request: &DebuggerBreakpointSetRequest
    ) -> DebuggerBreakpointSetResponse {
        transition engine_privileged_state.has_opened_process() {
            true -> resolve(engine_privileged_state)
            _ -> absent()
        }
    }

    state resolve(
        engine_privileged_state: &mut EnginePrivilegedState
    ) -> DebuggerBreakpointSetResponse {
        let opened_process_info: OpenedProcessInfo = engine_privileged_state.get_opened_process();
        let architecture: TargetArchitecture = opened_process_info.get_target_architecture();
        let instruction_set_id: &[u8] = architecture.get_instruction_set_id();
        transition {
            _ -> probe_plugin(engine_privileged_state, instruction_set_id)
        }
    }

    state probe_plugin(
        engine_privileged_state: &mut EnginePrivilegedState,
        instruction_set_id: &[u8]
    ) -> DebuggerBreakpointSetResponse {
        let found: bool = engine_privileged_state.find_instruction_set(instruction_set_id);
        transition found {
            true -> missing(instruction_set_id)
            false -> missing(instruction_set_id)
            _ -> missing(instruction_set_id)
        }
    }

    state missing(instruction_set_id: &[u8]) -> DebuggerBreakpointSetResponse {
        let mut response: DebuggerBreakpointSetResponse = DebuggerBreakpointSetResponse::new();
        let mut error: PatchServiceError = PatchServiceError::empty();
        error.put("No instruction set plugin is enabled for target architecture '");
        error.put(instruction_set_id);
        error.put("'.");
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        status.set_message(error.get_message());
        response.set_status(status);
        (response)
    }

    state call_service(
        engine_privileged_state: &mut EnginePrivilegedState,
        debugger_breakpoint_set_request: &DebuggerBreakpointSetRequest
    ) -> DebuggerBreakpointSetResponse {
        let address: u64 = debugger_breakpoint_set_request.get_address();
        let kind: DebuggerBreakpointKind = debugger_breakpoint_set_request.get_kind();
        let has_label: bool = debugger_breakpoint_set_request.has_label();
        let label: &[u8] = debugger_breakpoint_set_request.get_label();
        let outcome: DebuggerBreakpointOutcome = engine_privileged_state.debugger_set_breakpoint(
            address,
            kind,
            has_label,
            label);
        transition outcome.succeeded && outcome.has_breakpoint {
            true -> fill(outcome)
            _ -> failed(outcome)
        }
    }

    state fill(outcome: DebuggerBreakpointOutcome) -> DebuggerBreakpointSetResponse {
        let mut response: DebuggerBreakpointSetResponse = DebuggerBreakpointSetResponse::new();
        response.set_breakpoint(DebuggerBreakpointDescriptor::clone(&outcome.breakpoint));
        (response)
    }

    state failed(outcome: DebuggerBreakpointOutcome) -> DebuggerBreakpointSetResponse {
        let mut response: DebuggerBreakpointSetResponse = DebuggerBreakpointSetResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        status.set_message(outcome.get_error_message());
        response.set_status(status);
        (response)
    }
}
