module src::command_executors::general_settings_command_executor;

use squalr_engine_api::src::commands::settings::general::general_settings_command::GeneralSettingsCommand;
use squalr_engine_api::src::commands::settings::general::general_settings_response::GeneralSettingsResponse;
use squalr_engine_api::src::commands::settings::general::list::general_settings_list_request::GeneralSettingsListRequest;
use squalr_engine_api::src::commands::settings::general::list::general_settings_list_response::GeneralSettingsListResponse;
use squalr_engine_api::src::commands::settings::general::set::general_settings_set_request::GeneralSettingsSetRequest;
use squalr_engine_api::src::commands::settings::general::set::general_settings_set_response::GeneralSettingsSetResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::general_settings_list_request_executor::GeneralSettingsListRequestExecutor;
use src::command_executors::general_settings_set_request_executor::GeneralSettingsSetRequestExecutor;

// Port of command_executors/settings/general/general_settings_command_executor.rs —
// routes the general settings command union to the per-request executor and
// wraps each typed response in the matching `GeneralSettingsResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data GeneralSettingsCommandExecutor {}

pub machine GeneralSettingsCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    general_settings_command: &GeneralSettingsCommand
) -> GeneralSettingsResponse {
    transition general_settings_command {
        GeneralSettingsCommand::List { request } -> list(engine_privileged_state, &request)
        GeneralSettingsCommand::Set { request } -> set(engine_privileged_state, &request)
    }

    state list(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &GeneralSettingsListRequest
    ) -> GeneralSettingsResponse {
        let response: GeneralSettingsListResponse = GeneralSettingsListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (GeneralSettingsResponse::List { response: response }) }
    }

    state set(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &GeneralSettingsSetRequest
    ) -> GeneralSettingsResponse {
        let response: GeneralSettingsSetResponse = GeneralSettingsSetRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (GeneralSettingsResponse::Set { response: response }) }
    }
}
