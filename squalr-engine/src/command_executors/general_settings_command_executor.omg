use {squalr_engine_api}/src/commands/settings/general/general_settings_command.omg;
use {squalr_engine_api}/src/commands/settings/general/general_settings_response.omg;
use {squalr_engine_api}/src/commands/settings/general/list/general_settings_list_request.omg;
use {squalr_engine_api}/src/commands/settings/general/list/general_settings_list_response.omg;
use {squalr_engine_api}/src/commands/settings/general/set/general_settings_set_request.omg;
use {squalr_engine_api}/src/commands/settings/general/set/general_settings_set_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/general_settings_list_request_executor.omg;
use src/command_executors/general_settings_set_request_executor.omg;

// Port of command_executors/settings/general/general_settings_command_executor.rs —
// routes the general settings command union to the per-request executor and
// wraps each typed response in the matching `GeneralSettingsResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data GeneralSettingsCommandExecutor {}

public machine GeneralSettingsCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    general_settings_command: &|general_settings_command|::GeneralSettingsCommand
) -> |general_settings_response|::GeneralSettingsResponse {
    transition general_settings_command {
        |general_settings_command|::GeneralSettingsCommand::List { request } -> list(engine_privileged_state, &request)
        |general_settings_command|::GeneralSettingsCommand::Set { request } -> set(engine_privileged_state, &request)
    }

    machine list(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|general_settings_list_request|::GeneralSettingsListRequest
    ) -> |general_settings_response|::GeneralSettingsResponse {
        let response: |general_settings_list_response|::GeneralSettingsListResponse = |general_settings_list_request_executor|::GeneralSettingsListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|general_settings_response|::GeneralSettingsResponse::List { response: response }) }
    }

    machine set(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|general_settings_set_request|::GeneralSettingsSetRequest
    ) -> |general_settings_response|::GeneralSettingsResponse {
        let response: |general_settings_set_response|::GeneralSettingsSetResponse = |general_settings_set_request_executor|::GeneralSettingsSetRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|general_settings_response|::GeneralSettingsResponse::Set { response: response }) }
    }
}
