use {omega}/language/core/filesystem_authority.omg;
use {squalr_engine_api}/src/commands/patches/restore_address/patch_restore_address_request.omg;
use {squalr_engine_api}/src/commands/patches/restore_address/patch_restore_address_response.omg;
use {squalr_engine_api}/src/structures/patches/patch_command_status.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/patches/patch_service.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/structures/patches/patch_descriptor.omg;
use {squalr_engine_api}/src/structures/patches/patch_kind.omg;

// Port of command_executors/patches/restore_address/patch_restore_address_request_executor.rs —
// resolves the absolute address, finds the active patch containing it
// (optionally checked against `expected_kind`), and restores its original
// bytes through the same staged restore flow as `restore_patch`. The
// debugger-pause wrapper collapses to a direct call — see the apply
// executor's note.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data PatchRestoreAddressRequestExecutor {}

public machine PatchRestoreAddressRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    patch_restore_address_request: &|patch_restore_address_request|::PatchRestoreAddressRequest
) -> |patch_restore_address_response|::PatchRestoreAddressResponse
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> restore(engine_privileged_state, patch_restore_address_request)
        _ -> absent()
    }

    machine absent() -> |patch_restore_address_response|::PatchRestoreAddressResponse {
        (|patch_restore_address_response|::PatchRestoreAddressResponse::new(|patch_command_status|::PatchCommandStatus::failure("No opened process to patch.")))
    }

    machine restore(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        patch_restore_address_request: &|patch_restore_address_request|::PatchRestoreAddressRequest
    ) -> |patch_restore_address_response|::PatchRestoreAddressResponse {
        let opened_process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        let address: u64 = |patch_restore_address_request|::PatchRestoreAddressRequest::get_address(&patch_restore_address_request);
        let module_name: &[u8] = |patch_restore_address_request|::PatchRestoreAddressRequest::get_module_name(&patch_restore_address_request);
        let has_expected_kind: bool = |patch_restore_address_request|::PatchRestoreAddressRequest::has_expected_kind(&patch_restore_address_request);
        let expected_kind: |patch_kind|::PatchKind = |patch_restore_address_request|::PatchRestoreAddressRequest::get_expected_kind(&patch_restore_address_request);
        let outcome: |patch_service|::PatchServiceResult = |engine_privileged_state|::EnginePrivilegedState::restore_patch_at_address(&mut engine_privileged_state, &opened_process_info, address, module_name, has_expected_kind, expected_kind);
        transition outcome {
            |patch_service|::PatchServiceResult::Ok { patch } -> commit(patch)
            |patch_service|::PatchServiceResult::Err { error } -> fail(error)
        }
    }

    machine commit(patch: |patch_descriptor|::PatchDescriptor) -> |patch_restore_address_response|::PatchRestoreAddressResponse {
        let mut response: |patch_restore_address_response|::PatchRestoreAddressResponse = |patch_restore_address_response|::PatchRestoreAddressResponse::new(|patch_command_status|::PatchCommandStatus::success());
        |patch_restore_address_response|::PatchRestoreAddressResponse::set_patch(&mut response, &patch);
        (response)
    }

    machine fail(error: |patch_service|::PatchServiceError) -> |patch_restore_address_response|::PatchRestoreAddressResponse {
        let message: &[u8] = |patch_service|::PatchServiceError::get_message(&error);
        (|patch_restore_address_response|::PatchRestoreAddressResponse::new(|patch_command_status|::PatchCommandStatus::failure(message)))
    }
}
