module src::command_executors::patch_restore_address_request_executor;

use squalr_engine_api::src::commands::patches::restore_address::patch_restore_address_request::PatchRestoreAddressRequest;
use squalr_engine_api::src::commands::patches::restore_address::patch_restore_address_response::PatchRestoreAddressResponse;
use squalr_engine_api::src::structures::patches::patch_command_status::PatchCommandStatus;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::patches::patch_service::PatchServiceError;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::patches::patch_descriptor::PatchDescriptor;
use squalr_engine_api::src::structures::patches::patch_kind::PatchKind;
use squalr_engine_session::src::patches::patch_service::PatchServiceResult;

// Port of command_executors/patches/restore_address/patch_restore_address_request_executor.rs —
// resolves the absolute address, finds the active patch containing it
// (optionally checked against `expected_kind`), and restores its original
// bytes through the same staged restore flow as `restore_patch`. The
// debugger-pause wrapper collapses to a direct call — see the apply
// executor's note.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data PatchRestoreAddressRequestExecutor {}

pub machine PatchRestoreAddressRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    patch_restore_address_request: &PatchRestoreAddressRequest
) -> PatchRestoreAddressResponse
reaches FilesystemHost
invokes FilesystemHost;
{
    let hoist1: bool = EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> restore(engine_privileged_state, patch_restore_address_request)
        _ -> absent()
    }

    state absent() -> PatchRestoreAddressResponse {
        (PatchRestoreAddressResponse::new(PatchCommandStatus::failure("No opened process to patch.")))
    }

    state restore(
        engine_privileged_state: &mut EnginePrivilegedState,
        patch_restore_address_request: &PatchRestoreAddressRequest
    ) -> PatchRestoreAddressResponse {
        let opened_process_info: OpenedProcessInfo = EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        let address: u64 = PatchRestoreAddressRequest::get_address(&patch_restore_address_request);
        let module_name: &[u8] = PatchRestoreAddressRequest::get_module_name(&patch_restore_address_request);
        let has_expected_kind: bool = PatchRestoreAddressRequest::has_expected_kind(&patch_restore_address_request);
        let expected_kind: PatchKind = PatchRestoreAddressRequest::get_expected_kind(&patch_restore_address_request);
        let outcome: PatchServiceResult = EnginePrivilegedState::restore_patch_at_address(&mut engine_privileged_state, &opened_process_info, address, module_name, has_expected_kind, expected_kind);
        transition outcome {
            PatchServiceResult::Ok { patch } -> commit(patch)
            PatchServiceResult::Err { error } -> fail(error)
        }
    }

    state commit(patch: PatchDescriptor) -> PatchRestoreAddressResponse {
        let mut response: PatchRestoreAddressResponse = PatchRestoreAddressResponse::new(PatchCommandStatus::success());
        PatchRestoreAddressResponse::set_patch(&mut response, &patch);
        (response)
    }

    state fail(error: PatchServiceError) -> PatchRestoreAddressResponse {
        let message: &[u8] = PatchServiceError::get_message(&error);
        (PatchRestoreAddressResponse::new(PatchCommandStatus::failure(message)))
    }
}
