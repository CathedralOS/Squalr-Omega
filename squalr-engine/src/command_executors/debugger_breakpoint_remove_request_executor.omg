use {omega}/language/core/filesystem_authority.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/commands/debugger/breakpoint_remove/debugger_breakpoint_remove_request.omg;
use {squalr_engine_api}/src/commands/debugger/breakpoint_remove/debugger_breakpoint_remove_response.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_command_status.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_session}/src/debugger/debugger_service.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/patches/patch_service.omg;

// Port of command_executors/debugger/mod.rs::DebuggerBreakpointRemoveRequest —
// a `patch:`-prefixed breakpoint id routes to patch_service.restore_patch
// with the prefix stripped (software breakpoints are patch-backed); every
// other id goes to debugger_service.remove_breakpoint.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data DebuggerBreakpointRemoveRequestExecutor {}

// PATCH_SOFTWARE_BREAKPOINT_ID_PREFIX: "patch:" — 112 97 116 99 104 58.
machine debugger_breakpoint_id_has_patch_prefix(breakpoint_id: &[u8]) -> bool {
    transition breakpoint_id.len > 5 {
        true -> check(breakpoint_id)
        _ -> (false)
    }
    machine check(breakpoint_id: &[u8]) -> bool
        requires breakpoint_id.len > 5
    {
        (breakpoint_id[0] == 112 && breakpoint_id[1] == 97 && breakpoint_id[2] == 116 && breakpoint_id[3] == 99 && breakpoint_id[4] == 104 && breakpoint_id[5] == 58)
    }
}

// `strip_prefix("patch:")` — copies breakpoint_id[6..] into `out` bounded,
// returning the tail length. Indices run off `position + 6` so the requires
// bound stays a plain param comparison.
machine debugger_breakpoint_id_patch_tail(breakpoint_id: &[u8], out: &mut [u8; 64]) -> u64 {
    transition { _ -> copy(breakpoint_id, out, 0) }
    machine copy(breakpoint_id: &[u8], out: &mut [u8; 64], position: u64) -> u64 {
        let source_position: u64 = ((position as u64 in Wrapping) + (6 as u64 in Wrapping)) as u64;
        transition source_position < breakpoint_id.len && position < 64 {
            true -> store(breakpoint_id, out, position, source_position)
            _ -> (position)
        }
    }
    machine store(breakpoint_id: &[u8], out: &mut [u8; 64], position: u64, source_position: u64) -> u64
        requires position < 64 && source_position < breakpoint_id.len
    {
        out[position] = breakpoint_id[source_position];
        transition { _ -> copy(breakpoint_id, out, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

public machine DebuggerBreakpointRemoveRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    debugger_breakpoint_remove_request: &|debugger_breakpoint_remove_request|::DebuggerBreakpointRemoveRequest
) -> |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let hoist3: &[u8] = |debugger_breakpoint_remove_request|::DebuggerBreakpointRemoveRequest::get_breakpoint_id(&debugger_breakpoint_remove_request);
    let hoist1: bool = debugger_breakpoint_id_has_patch_prefix(hoist3);
    transition hoist1 {
        true -> guarded_patch(engine_privileged_state, debugger_breakpoint_remove_request)
        _ -> call_service(engine_privileged_state, debugger_breakpoint_remove_request)
    }

    machine absent() -> |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse {
        let mut response: |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse = |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, "No opened process to debug.");
        |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse::set_status(&mut response, status);
        (response)
    }

    machine guarded_patch(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        debugger_breakpoint_remove_request: &|debugger_breakpoint_remove_request|::DebuggerBreakpointRemoveRequest
    ) -> |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse
    {
        let hoist2: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(engine_privileged_state);
        transition hoist2 {
            true -> restore_patch(engine_privileged_state, debugger_breakpoint_remove_request)
            _ -> absent()
        }
    }

    machine restore_patch(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        debugger_breakpoint_remove_request: &|debugger_breakpoint_remove_request|::DebuggerBreakpointRemoveRequest
    ) -> |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse
    {
        let mut patch_id_tail: [u8; 64];
        let breakpoint_id: &[u8] = |debugger_breakpoint_remove_request|::DebuggerBreakpointRemoveRequest::get_breakpoint_id(debugger_breakpoint_remove_request);
        let tail_len: u64 = debugger_breakpoint_id_patch_tail(
            breakpoint_id,
            &mut patch_id_tail);
        transition tail_len <= 64 {
            true -> restore_tail(engine_privileged_state, &patch_id_tail, tail_len)
            _ -> restore_tail(engine_privileged_state, &patch_id_tail, 64)
        }
    }

    machine restore_tail(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        patch_id_tail: &[u8; 64],
        tail_len: u64
    ) -> |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse
    requires tail_len < 65
    {
        let opened_process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(engine_privileged_state);
        let result: |patch_service|::PatchServiceResult = |engine_privileged_state|::EnginePrivilegedState::restore_patch(engine_privileged_state, &opened_process_info,
            &patch_id_tail[0..tail_len]);
        transition result {
            |patch_service|::PatchServiceResult::Ok { patch } -> ok_result()
            |patch_service|::PatchServiceResult::Err { error } -> patch_failed(error)
            _ -> ok_result()
        }
    }

    machine ok_result() -> |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse {
        (|debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse::new())
    }

    machine patch_failed(error: |patch_service|::PatchServiceError) -> |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse {
        let mut response: |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse = |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, |patch_service|::PatchServiceError::get_message(error));
        |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse::set_status(&mut response, status);
        (response)
    }

    machine call_service(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        debugger_breakpoint_remove_request: &|debugger_breakpoint_remove_request|::DebuggerBreakpointRemoveRequest
    ) -> |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse {
        let breakpoint_id: &[u8] = |debugger_breakpoint_remove_request|::DebuggerBreakpointRemoveRequest::get_breakpoint_id(debugger_breakpoint_remove_request);
        let outcome: |debugger_service|::DebuggerVoidOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_remove_breakpoint(engine_privileged_state, breakpoint_id);
        transition outcome.succeeded {
            true -> removed()
            _ -> failed(outcome)
        }
    }

    machine removed() -> |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse {
        (|debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse::new())
    }

    machine failed(outcome: |debugger_service|::DebuggerVoidOutcome) -> |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse {
        let mut response: |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse = |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, |debugger_service|::DebuggerVoidOutcome::get_error_message(outcome));
        |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse::set_status(&mut response, status);
        (response)
    }
}
