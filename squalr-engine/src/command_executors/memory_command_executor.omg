module src::command_executors::memory_command_executor;

use squalr_engine_api::src::commands::memory::freeze::memory_freeze_request::MemoryFreezeRequest;
use squalr_engine_api::src::commands::memory::freeze::memory_freeze_response::MemoryFreezeResponse;
use squalr_engine_api::src::commands::memory::memory_command::MemoryCommand;
use squalr_engine_api::src::commands::memory::memory_response::MemoryResponse;
use squalr_engine_api::src::commands::memory::query::memory_query_request::MemoryQueryRequest;
use squalr_engine_api::src::commands::memory::query::memory_query_response::MemoryQueryResponse;
use squalr_engine_api::src::commands::memory::read::memory_read_request::MemoryReadRequest;
use squalr_engine_api::src::commands::memory::read::memory_read_response::MemoryReadResponse;
use squalr_engine_api::src::commands::memory::write::memory_write_request::MemoryWriteRequest;
use squalr_engine_api::src::commands::memory::write::memory_write_response::MemoryWriteResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::memory_freeze_request_executor::MemoryFreezeRequestExecutor;
use src::command_executors::memory_query_request_executor::MemoryQueryRequestExecutor;
use src::command_executors::memory_read_request_executor::MemoryReadRequestExecutor;
use src::command_executors::memory_write_request_executor::MemoryWriteRequestExecutor;

// Port of command_executors/memory/memory_command_executor.rs — routes the
// memory command union to the per-request executor and wraps each typed
// response in the matching `MemoryResponse` case.
pub data MemoryCommandExecutor {}

pub machine MemoryCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    memory_command: &MemoryCommand
) -> MemoryResponse
crashes Abort
{
    transition memory_command {
        MemoryCommand::Freeze { request } -> freeze(engine_privileged_state, &request)
        MemoryCommand::Query { request } -> query(engine_privileged_state, &request)
        MemoryCommand::Read { request } -> read(engine_privileged_state, &request)
        MemoryCommand::Write { request } -> write(engine_privileged_state, &request)
    }

    state freeze(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemoryFreezeRequest
    ) -> MemoryResponse {
        let response: MemoryFreezeResponse = MemoryFreezeRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (MemoryResponse::Freeze { response: response }) }
    }

    state query(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemoryQueryRequest
    ) -> MemoryResponse {
        let response: MemoryQueryResponse = MemoryQueryRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (MemoryResponse::Query { response: response }) }
    }

    state read(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemoryReadRequest
    ) -> MemoryResponse {
        let response: MemoryReadResponse = MemoryReadRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (MemoryResponse::Read { response: response }) }
    }

    state write(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemoryWriteRequest
    ) -> MemoryResponse {
        let response: MemoryWriteResponse = MemoryWriteRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (MemoryResponse::Write { response: response }) }
    }
}
