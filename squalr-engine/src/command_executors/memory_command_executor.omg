use {squalr_engine_api}/src/commands/memory/freeze/memory_freeze_request.omg;
use {squalr_engine_api}/src/commands/memory/freeze/memory_freeze_response.omg;
use {squalr_engine_api}/src/commands/memory/memory_command.omg;
use {squalr_engine_api}/src/commands/memory/memory_response.omg;
use {squalr_engine_api}/src/commands/memory/query/memory_query_request.omg;
use {squalr_engine_api}/src/commands/memory/query/memory_query_response.omg;
use {squalr_engine_api}/src/commands/memory/read/memory_read_request.omg;
use {squalr_engine_api}/src/commands/memory/read/memory_read_response.omg;
use {squalr_engine_api}/src/commands/memory/write/memory_write_request.omg;
use {squalr_engine_api}/src/commands/memory/write/memory_write_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/memory_freeze_request_executor.omg;
use src/command_executors/memory_query_request_executor.omg;
use src/command_executors/memory_read_request_executor.omg;
use src/command_executors/memory_write_request_executor.omg;

// Port of command_executors/memory/memory_command_executor.rs — routes the
// memory command union to the per-request executor and wraps each typed
// response in the matching `MemoryResponse` case.
public data MemoryCommandExecutor {}

public machine MemoryCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    memory_command: &|memory_command|::MemoryCommand
) -> |memory_response|::MemoryResponse
crashes Abort
{
    transition memory_command {
        |memory_command|::MemoryCommand::Freeze { request } -> freeze(engine_privileged_state, &request)
        |memory_command|::MemoryCommand::Query { request } -> query(engine_privileged_state, &request)
        |memory_command|::MemoryCommand::Read { request } -> read(engine_privileged_state, &request)
        |memory_command|::MemoryCommand::Write { request } -> write(engine_privileged_state, &request)
    }

    machine freeze(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|memory_freeze_request|::MemoryFreezeRequest
    ) -> |memory_response|::MemoryResponse {
        let response: |memory_freeze_response|::MemoryFreezeResponse = |memory_freeze_request_executor|::MemoryFreezeRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|memory_response|::MemoryResponse::Freeze { response: response }) }
    }

    machine query(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|memory_query_request|::MemoryQueryRequest
    ) -> |memory_response|::MemoryResponse {
        let response: |memory_query_response|::MemoryQueryResponse = |memory_query_request_executor|::MemoryQueryRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|memory_response|::MemoryResponse::Query { response: response }) }
    }

    machine read(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|memory_read_request|::MemoryReadRequest
    ) -> |memory_response|::MemoryResponse {
        let response: |memory_read_response|::MemoryReadResponse = |memory_read_request_executor|::MemoryReadRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|memory_response|::MemoryResponse::Read { response: response }) }
    }

    machine write(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|memory_write_request|::MemoryWriteRequest
    ) -> |memory_response|::MemoryResponse {
        let response: |memory_write_response|::MemoryWriteResponse = |memory_write_request_executor|::MemoryWriteRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|memory_response|::MemoryResponse::Write { response: response }) }
    }
}
