module src::command_executors::trackable_tasks_cancel_request_executor;

use omega::language::core::wait_wake;
use squalr_engine_api::src::commands::trackable_tasks::cancel::trackable_tasks_cancel_request::TrackableTasksCancelRequest;
use squalr_engine_api::src::commands::trackable_tasks::cancel::trackable_tasks_cancel_response::TrackableTasksCancelResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::tasks::trackable_task_manager::TrackableTaskManager;

// Port of command_executors/trackable_tasks/cancel/trackable_tasks_cancel_
// request_executor.rs — upstream `engine_privileged_state
// .get_trackable_task_manager().cancel_task(&self.task_id)` then an empty
// response. The mutable route is `borrow_trackable_task_manager_mut`: the
// manager's `&self` + `RwLock` interior mutability upstream becomes `&mut`
// in the single-owner model (same shape as `clear_freeze_list`).
pub data TrackableTasksCancelRequestExecutor {}

pub machine TrackableTasksCancelRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    request: &TrackableTasksCancelRequest
) -> TrackableTasksCancelResponse
reaches WaitWake
invokes WaitWake;
{
    let task_manager: &mut TrackableTaskManager = engine_privileged_state
        .borrow_trackable_task_manager_mut();
    TrackableTaskManager::cancel_task(&mut task_manager, TrackableTasksCancelRequest::get_task_id(request));
    TrackableTasksCancelResponse::new()
}
