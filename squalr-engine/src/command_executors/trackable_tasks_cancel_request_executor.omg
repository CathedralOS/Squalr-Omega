use {omega}/language/core/wait_wake.omg;
use {squalr_engine_api}/src/commands/trackable_tasks/cancel/trackable_tasks_cancel_request.omg;
use {squalr_engine_api}/src/commands/trackable_tasks/cancel/trackable_tasks_cancel_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/tasks/trackable_task_manager.omg;

// Port of command_executors/trackable_tasks/cancel/trackable_tasks_cancel_
// request_executor.rs — upstream `engine_privileged_state
// .get_trackable_task_manager().cancel_task(&self.task_id)` then an empty
// response. The mutable route is `borrow_trackable_task_manager_mut`: the
// manager's `&self` + `RwLock` interior mutability upstream becomes `&mut`
// in the single-owner model (same shape as `clear_freeze_list`).
public data TrackableTasksCancelRequestExecutor {}

public machine TrackableTasksCancelRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    request: &|trackable_tasks_cancel_request|::TrackableTasksCancelRequest
) -> |trackable_tasks_cancel_response|::TrackableTasksCancelResponse
reaches |wait_wake|::WaitWake
invokes |wait_wake|::WaitWake;
{
    let task_manager: &mut |trackable_task_manager|::TrackableTaskManager = |engine_privileged_state|::EnginePrivilegedState::borrow_trackable_task_manager_mut(&mut engine_privileged_state);
    |trackable_task_manager|::TrackableTaskManager::cancel_task(task_manager, |trackable_tasks_cancel_request|::TrackableTasksCancelRequest::get_task_id(request));
    |trackable_tasks_cancel_response|::TrackableTasksCancelResponse::new()
}
