module src::command_executors::scan_results_query_request_executor;

use squalr_engine_api::src::commands::scan_results::query::scan_results_query_request::ScanResultsQueryRequest;
use squalr_engine_api::src::commands::scan_results::query::scan_results_query_response::ScanResultsQueryResponse;
use squalr_engine_api::src::commands::scan_results::list::scan_results_list_response::ScanResultPage;
use squalr_engine_api::src::structures::results::snapshot_region_scan_results::DataTypeResultCounts;
use squalr_engine_api::src::structures::results::snapshot_region_scan_results::ScanResultsPage;
use squalr_engine_api::src::structures::results::snapshot_region_scan_results::ScanResultValuedList;
use squalr_engine_api::src::structures::scan_results::scan_result::ScanResult;
use squalr_engine_api::src::structures::scan_results::scan_result_base::ScanResultBase;
use squalr_engine_api::src::structures::scan_results::scan_result_enriched::ScanResultEnriched;
use squalr_engine_api::src::structures::scan_results::scan_result_valued::ScanResultValued;
use squalr_engine_api::src::structures::settings::scan_settings::ScanSettings;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use src::command_executors::scan_result_enricher::ScanResultEnricher;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::os::supplied_memory_source::ReadWindowResult;
use squalr_engine_session::src::os::supplied_memory_source::SuppliedMemorySource;
use squalr_engine_api::src::structures::snapshots::element_window::ElementWindow;

// Port of command_executors/scan_results/query/scan_results_query_request_executor.rs.
// Upstream reads the snapshot unconditionally — a missing opened process only
// empties the module table and the best-effort reads — so unlike the list
// executor this path has no has_opened_process gate: the port's lock-free
// snapshot is always available, and no-process degrades to stored values.
// Upstream's read()/write() lock collapse onto the snapshot's fixed bounded
// collections.
//
// Per-result enrichment: the page's stored ScanResultValued is re-read through
// the supplied memory source (upstream memory_read best-effort — a failed
// read leaves recently_read_value = None → has_current_value = false here,
// the stored current value is NOT kept as fallback). Module-name resolution,
// display-format anonymization, and freeze-flag probing are CLI/formatter
// surfaces — the slim ScanResultValued carries the fields the port owns.
pub data ScanResultsQueryRequestExecutor {}

pub machine ScanResultsQueryRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    scan_results_query_request: &ScanResultsQueryRequest
) -> ScanResultsQueryResponse
crashes Abort
{
    let settings: ScanSettings = EnginePrivilegedState::get_scan_settings(engine_privileged_state);
    let page_size: u64 = ScanSettings::get_results_page_size(&settings);
    transition { _ -> sized(engine_privileged_state, scan_results_query_request, page_size) }

    state sized(
        engine_privileged_state: &mut EnginePrivilegedState,
        scan_results_query_request: &ScanResultsQueryRequest,
        page_size: u64
    ) -> ScanResultsQueryResponse {
        transition page_size > 0 {
            true -> paged(engine_privileged_state, scan_results_query_request, page_size)
            false -> paged(engine_privileged_state, scan_results_query_request, 1)
            _ -> paged(engine_privileged_state, scan_results_query_request, 1)
        }
    }
    state paged(
        engine_privileged_state: &mut EnginePrivilegedState,
        scan_results_query_request: &ScanResultsQueryRequest,
        bounded_page_size: u64
    ) -> ScanResultsQueryResponse {
        let snapshot: &Snapshot = EnginePrivilegedState::borrow_snapshot(engine_privileged_state);
        let result_count: u64 = Snapshot::get_number_of_results_for_data_types(snapshot, 
            &scan_results_query_request.data_type_filters);
        let last_page: u64 = (((result_count as u64 in Saturating)
            - (1 as u64 in Saturating)) as u64) / bounded_page_size;
        let data_type_result_counts: DataTypeResultCounts = Snapshot::get_result_counts_by_data_type(snapshot);
        let total_size_in_bytes: u64 = Snapshot::get_collected_byte_count(snapshot);
        let page: ScanResultsPage = Snapshot::get_scan_results_page(snapshot, 
            &scan_results_query_request.data_type_filters,
            scan_results_query_request.page_index,
            bounded_page_size);
        let results: ScanResultValuedList = page.results;
        let effective_page_index: u64 = page.effective_page_index;
        transition { _ -> enrich(
            engine_privileged_state,
            results,
            effective_page_index,
            result_count,
            last_page,
            bounded_page_size,
            data_type_result_counts,
            total_size_in_bytes,
            ScanResultPage::empty(),
            0) }
    }
    state enrich(
        engine_privileged_state: &mut EnginePrivilegedState,
        results: &ScanResultValuedList,
        effective_page_index: u64,
        result_count: u64,
        last_page: u64,
        bounded_page_size: u64,
        data_type_result_counts: DataTypeResultCounts,
        total_size_in_bytes: u64,
        scan_results: ScanResultPage,
        position: u64
    ) -> ScanResultsQueryResponse {
        transition position < ScanResultValuedList::get_result_count(results) && position < 64 {
            true -> element(
                engine_privileged_state,
                results,
                effective_page_index,
                result_count,
                last_page,
                bounded_page_size,
                data_type_result_counts,
                total_size_in_bytes,
                scan_results,
                position)
            false -> finish(
                effective_page_index,
                result_count,
                last_page,
                bounded_page_size,
                data_type_result_counts,
                total_size_in_bytes,
                scan_results)
            _ -> finish(
                effective_page_index,
                result_count,
                last_page,
                bounded_page_size,
                data_type_result_counts,
                total_size_in_bytes,
                scan_results)
        }
    }
    state element(
        engine_privileged_state: &mut EnginePrivilegedState,
        results: &ScanResultValuedList,
        effective_page_index: u64,
        result_count: u64,
        last_page: u64,
        bounded_page_size: u64,
        data_type_result_counts: DataTypeResultCounts,
        total_size_in_bytes: u64,
        scan_results: ScanResultPage,
        position: u64
    ) -> ScanResultsQueryResponse {
        let valued_result: ScanResultValued = ScanResultValuedList::get(results, position);
        let base: ScanResultBase = ScanResultValued::get_base_result(&valued_result);
        let address: u64 = ScanResultBase::get_address(&base);
        let source: &SuppliedMemorySource = EnginePrivilegedState::get_supplied_memory_source(engine_privileged_state);
        let read: ReadWindowResult = SuppliedMemorySource::try_read_window(source, address, 8);
        let has_current: bool = read.succeeded;
        let current_value: u64 = ElementWindow::get_element(&read.window, 0);
        let has_previous: bool = valued_result.has_previous_value;
        let previous_value: u64 = ScanResultValued::get_previous_value(&valued_result);
        let valued: ScanResultValued = ScanResultValued::new(
            base, has_current, current_value, has_previous, previous_value);
        // Upstream's module + freeze enrichment over the stored valued
        // result (address_to_module + is_address_frozen -> ScanResult::new).
        let enriched: ScanResultEnriched = ScanResultEnricher::enrich(
            engine_privileged_state, valued);
        let mut carried: ScanResultPage = scan_results;
        let pushed: bool = ScanResultPage::push(&mut carried, &ScanResult::Valued { result: enriched });
        transition { _ -> enrich(
            engine_privileged_state,
            results,
            effective_page_index,
            result_count,
            last_page,
            bounded_page_size,
            data_type_result_counts,
            total_size_in_bytes,
            carried,
            ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(
        effective_page_index: u64,
        result_count: u64,
        last_page: u64,
        bounded_page_size: u64,
        data_type_result_counts: DataTypeResultCounts,
        total_size_in_bytes: u64,
        scan_results: ScanResultPage
    ) -> ScanResultsQueryResponse {
        ScanResultsQueryResponse {
            scan_results: scan_results,
            data_type_result_counts: data_type_result_counts,
            page_index: effective_page_index,
            last_page_index: last_page,
            page_size: bounded_page_size,
            result_count: result_count,
            total_size_in_bytes: total_size_in_bytes,
        }
    }
}
