use {squalr_engine_api}/src/structures/scan_results/scan_results_metadata.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of commands/scan/scan_results_metadata_collector.rs —
// `collect_scan_results_metadata`: the response-carried statistics pair read
// off the snapshot at response time. Upstream's lock-acquire failure returns
// the default metadata; the session-owned snapshot cannot fail to borrow, so
// there is no error arm to port.
// Empty receiver carrying the machines — mirrors upstream's free function.
public data ScanResultsMetadataCollector {}

public machine ScanResultsMetadataCollector::collect(
    engine_privileged_state: &|engine_privileged_state|::EnginePrivilegedState
) -> |scan_results_metadata|::ScanResultsMetadata
crashes Abort
{
    let snapshot: &|snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
    let result_count: u64 = |snapshot|::Snapshot::get_number_of_results(snapshot);
    let total_size_in_bytes: u64 = |snapshot|::Snapshot::get_collected_byte_count(snapshot);
    |scan_results_metadata|::ScanResultsMetadata {
        result_count: result_count,
        total_size_in_bytes: total_size_in_bytes,
    }
}
