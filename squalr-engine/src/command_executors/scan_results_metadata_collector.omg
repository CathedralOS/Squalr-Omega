module src::command_executors::scan_results_metadata_collector;

use squalr_engine_api::src::structures::scan_results::scan_results_metadata::ScanResultsMetadata;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of commands/scan/scan_results_metadata_collector.rs —
// `collect_scan_results_metadata`: the response-carried statistics pair read
// off the snapshot at response time. Upstream's lock-acquire failure returns
// the default metadata; the session-owned snapshot cannot fail to borrow, so
// there is no error arm to port.
// Empty receiver carrying the machines — mirrors upstream's free function.
pub data ScanResultsMetadataCollector {}

pub machine ScanResultsMetadataCollector::collect(
    engine_privileged_state: &EnginePrivilegedState
) -> ScanResultsMetadata
crashes Abort
{
    let snapshot: &Snapshot = EnginePrivilegedState::borrow_snapshot(engine_privileged_state);
    ScanResultsMetadata {
        result_count: Snapshot::get_number_of_results(snapshot),
        total_size_in_bytes: Snapshot::get_collected_byte_count(snapshot),
    }
}
