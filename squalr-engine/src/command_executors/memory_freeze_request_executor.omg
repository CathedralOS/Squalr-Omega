module src::command_executors::memory_freeze_request_executor;

use squalr_engine_api::src::commands::memory::freeze::memory_freeze_request::MemoryFreezeRequest;
use squalr_engine_api::src::commands::memory::freeze::memory_freeze_request::MemoryFreezeTargetList;
use squalr_engine_api::src::commands::memory::freeze::memory_freeze_response::MemoryFreezeResponse;
use squalr_engine_api::src::commands::memory::freeze::memory_freeze_target::MemoryFreezeTarget;
use squalr_engine_api::src::structures::memory::normalized_module::NormalizedModule;
use squalr_engine_api::src::registries::freeze_list::freeze_list_registry::FreezeListRegistry;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::os::supplied_memory_source::ReadWindowResult;
use squalr_engine_session::src::os::supplied_memory_source::SuppliedMemorySource;

// Port of command_executors/memory/freeze/memory_freeze_request_executor.rs:
// unfrozen toggles unregister each target outright; frozen toggles require an
// opened process, resolve each target's pointer chain against the supplied
// modules (module-relative base plus offset hops read through the memory
// source), and register the target in the freeze registry.
//
// Named deviations:
// - Upstream resolves `data_type_id` through the symbol registry and reads
//   the current struct bytes to store as the freeze value; the ported
//   registry stores the decomposed (module_offset, module_name) key only
//   (see registries/freeze_list — the value column arrives with the
//   registry-value leg).
// - Upstream's pointer chase reads `pointer_size` bytes per hop; the
//   supplied memory source is element-granular, so hops read one u64 lane.
// - A failed module lookup or unreadable hop counts the target failed —
//   upstream's `resolve_final_address` `None` arm.
// - Wrapping address arithmetic matches upstream release-mode `u64`
//   wrap semantics exactly; `offset as u64 in Wrapping` is the i64->u64
//   two's-complement bitcast `as` performs in Rust.
pub data MemoryFreezeRequestExecutor {}

pub machine MemoryFreezeRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    memory_freeze_request: &MemoryFreezeRequest
) -> MemoryFreezeResponse
crashes Abort
{
    let freeze_targets: &MemoryFreezeTargetList =
        MemoryFreezeRequest::get_freeze_targets(&memory_freeze_request);
    let target_count: u64 = get_count(freeze_targets);
    let empty_module_name: [u8; 1] = [0];
    let mut supplied_modules: [NormalizedModule; 8] = [
        NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        NormalizedModule::new(&empty_module_name[0..0], 0, 0),
        NormalizedModule::new(&empty_module_name[0..0], 0, 0)
    ];
    let supplied_module_count: u64 = EnginePrivilegedState::copy_supplied_modules(&mut engine_privileged_state, &mut supplied_modules);
    let hoist1: bool = MemoryFreezeRequest::get_is_frozen(&memory_freeze_request);
    transition hoist1 {
        true -> check_process(engine_privileged_state, freeze_targets, target_count, &supplied_modules, supplied_module_count)
        false -> unfrozen(engine_privileged_state, freeze_targets, target_count, 0)
        _ -> unfrozen(engine_privileged_state, freeze_targets, target_count, 0)
    }

    // Unfreeze needs no opened process upstream — unregister each target's
    // (address, module_name) key and report success.
    state unfrozen(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        position: u64
    ) -> MemoryFreezeResponse {
        transition position < target_count {
            true -> unfreeze_one(engine_privileged_state, freeze_targets, target_count, position)
            false -> (MemoryFreezeResponse::new(0))
            _ -> (MemoryFreezeResponse::new(0))
        }
    }
    state unfreeze_one(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        position: u64
    ) -> MemoryFreezeResponse
    requires 0 <= position && position < target_count;
    {
        let target: &MemoryFreezeTarget = MemoryFreezeTargetList::get_target(&freeze_targets, position);
        let module_offset: u64 = get_address(target);
        let module_name: &[u8] = get_module_name(target);
        let registry: &mut FreezeListRegistry =
            EnginePrivilegedState::borrow_freeze_list_registry_mut(&mut engine_privileged_state);
        _ = FreezeListRegistry::set_address_unfrozen(&mut registry, module_offset, module_name);
        transition { _ -> unfrozen(engine_privileged_state, freeze_targets, target_count, position + 1) }
    }

    // Upstream: no opened process fails every target.
    state check_process(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64
    ) -> MemoryFreezeResponse {
        let hoist2: bool = EnginePrivilegedState::has_opened_process(&engine_privileged_state);
        transition hoist2 {
            true -> each(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, 0, 0)
            false -> (MemoryFreezeResponse::new(target_count))
            _ -> (MemoryFreezeResponse::new(target_count))
        }
    }
    state each(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64,
        failed_count: u64
    ) -> MemoryFreezeResponse
    requires 0 <= position && position <= target_count;
    requires 0 <= failed_count && failed_count <= position;
    {
        transition position < target_count {
            true -> resolve_base(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count)
            false -> (MemoryFreezeResponse::new(failed_count))
            _ -> (MemoryFreezeResponse::new(failed_count))
        }
    }

    // Module resolution: named modules resolve `address` as a
    // module-relative offset; an unnamed target's address is already
    // absolute; an absent module name fails the target.
    state resolve_base(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64,
        failed_count: u64
    ) -> MemoryFreezeResponse
    requires 0 <= position && position < target_count;
    requires 0 <= failed_count && failed_count <= position;
    {
        let target: &MemoryFreezeTarget = MemoryFreezeTargetList::get_target(&freeze_targets, position);
        let target_address: u64 = get_address(target);
        let offset_count: u64 = get_pointer_offset_count(target);
        let hoist3: &[u8] = get_module_name(target);
        transition hoist3.len == 0 {
            true -> chase(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, target_address, 0, offset_count)
            false -> find_module(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, 0)
            _ -> chase(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, target_address, 0, offset_count)
        }
    }
    state find_module(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64,
        failed_count: u64,
        module_index: u64
    ) -> MemoryFreezeResponse
    requires 0 <= position && position < target_count;
    requires 0 <= failed_count && failed_count <= position;
    requires 0 <= module_index && module_index <= 8;
    {
        transition module_index < module_count && module_index < 8 {
            true -> compare_name(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, module_index, 0)
            false -> each(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position + 1, failed_count + 1)
            _ -> each(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position + 1, failed_count + 1)
        }
    }
    state compare_name(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64,
        failed_count: u64,
        module_index: u64,
        name_position: u64
    ) -> MemoryFreezeResponse
    requires 0 <= position && position < target_count;
    requires 0 <= failed_count && failed_count <= position;
    requires 0 <= module_index && module_index < 8;
    {
        let target: &MemoryFreezeTarget = MemoryFreezeTargetList::get_target(&freeze_targets, position);
        let module: &NormalizedModule = &supplied_modules[module_index];
        let target_name: &[u8] = get_module_name(target);
        let module_name: &[u8] = get_module_name(module);
        transition name_position < target_name.len {
            true -> compare_byte(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, module_index, name_position)
            false -> resolved_module(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, module_index)
            _ -> resolved_module(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, module_index)
        }
    }
    state compare_byte(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64,
        failed_count: u64,
        module_index: u64,
        name_position: u64
    ) -> MemoryFreezeResponse
    requires 0 <= position && position < target_count;
    requires 0 <= failed_count && failed_count <= position;
    requires 0 <= module_index && module_index < 8;
    {
        let target: &MemoryFreezeTarget = MemoryFreezeTargetList::get_target(&freeze_targets, position);
        let module: &NormalizedModule = &supplied_modules[module_index];
        let target_name: &[u8] = get_module_name(target);
        let module_name: &[u8] = get_module_name(module);
        transition name_position < module_name.len && name_position < target_name.len && module_name[name_position] == target_name[name_position] {
            true -> compare_name(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, module_index, name_position + 1)
            false -> find_module(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, module_index + 1)
            _ -> find_module(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, module_index + 1)
        }
    }
    state resolved_module(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64,
        failed_count: u64,
        module_index: u64
    ) -> MemoryFreezeResponse
    requires 0 <= position && position < target_count;
    requires 0 <= failed_count && failed_count <= position;
    requires 0 <= module_index && module_index < 8;
    {
        let target: &MemoryFreezeTarget = MemoryFreezeTargetList::get_target(&freeze_targets, position);
        let absolute: u64 = (((get_base_address(supplied_modules[module_index]) as u64 in Wrapping)
            + (get_address(target) as u64 in Wrapping)) as u64);
        let offset_count: u64 = get_pointer_offset_count(target);
        transition { _ -> chase(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, absolute, 0, offset_count) }
    }

    // Pointer chase: upstream reads `pointer_size` bytes at each hop and
    // adds the offset; the supplied source answers one u64 lane per hop.
    // A hop that cannot be read fails the target.
    state chase(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64,
        failed_count: u64,
        current_address: u64,
        hop: u64,
        offset_count: u64
    ) -> MemoryFreezeResponse
    requires 0 <= position && position < target_count;
    requires 0 <= failed_count && failed_count <= position;
    requires 0 <= hop && hop <= offset_count;
    {
        transition hop < offset_count {
            true -> hop_read(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, current_address, hop, offset_count)
            false -> register(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, current_address)
            _ -> register(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, current_address)
        }
    }
    state hop_read(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64,
        failed_count: u64,
        current_address: u64,
        hop: u64,
        offset_count: u64
    ) -> MemoryFreezeResponse
    requires 0 <= position && position < target_count;
    requires 0 <= failed_count && failed_count <= position;
    requires 0 <= hop && hop < offset_count;
    {
        let source: &SuppliedMemorySource = EnginePrivilegedState::get_supplied_memory_source(&engine_privileged_state);
        let read_result: ReadWindowResult = SuppliedMemorySource::try_read_window(&source, current_address, 8);
        transition read_result.succeeded {
            true -> hop_apply_with(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, hop, offset_count, read_result)
            false -> each(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position + 1, failed_count + 1)
            _ -> each(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position + 1, failed_count + 1)
        }
    }
    state hop_apply_with(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64,
        failed_count: u64,
        hop: u64,
        offset_count: u64,
        read_result: ReadWindowResult
    ) -> MemoryFreezeResponse
    requires 0 <= position && position < target_count;
    requires 0 <= failed_count && failed_count <= position;
    requires 0 <= hop && hop < offset_count;
    {
        let pointer_value: u64 = ElementWindow::get_element(&read_result.window, 0);
        transition { _ -> hop_apply(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, hop, offset_count, pointer_value) }
    }
    state hop_apply(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64,
        failed_count: u64,
        hop: u64,
        offset_count: u64,
        pointer_value: u64
    ) -> MemoryFreezeResponse
    requires 0 <= position && position < target_count;
    requires 0 <= failed_count && failed_count <= position;
    requires 0 <= hop && hop < offset_count;
    {
        let target: &MemoryFreezeTarget = MemoryFreezeTargetList::get_target(&freeze_targets, position);
        let pointer_offset: i64 = get_pointer_offset(target, hop);
        let next_address: u64 = apply_i64_offset(pointer_value, pointer_offset);
        transition { _ -> chase(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, next_address, hop + 1, offset_count) }
    }
    // Upstream freezes `FreezeListRegistry::set_address_frozen(&mut pointer, valued_struct.get_bytes())`
    // — the key is the target pointer, the stored value is the bytes read at
    // the resolved address. The element-granular source reads one u64 lane;
    // an unreadable resolved address counts the target failed (upstream's
    // `read_struct` failure arm).
    state register(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64,
        failed_count: u64,
        current_address: u64
    ) -> MemoryFreezeResponse
    requires 0 <= position && position < target_count;
    requires 0 <= failed_count && failed_count <= position;
    {
        let source: &SuppliedMemorySource =
            EnginePrivilegedState::get_supplied_memory_source(&engine_privileged_state);
        let read_result: ReadWindowResult = SuppliedMemorySource::try_read_window(&source, current_address, 8);
        transition read_result.succeeded {
            true -> register_write(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position, failed_count, read_result)
            false -> each(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position + 1, failed_count + 1)
            _ -> each(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position + 1, failed_count + 1)
        }
    }
    state register_write(
        engine_privileged_state: &mut EnginePrivilegedState,
        freeze_targets: &MemoryFreezeTargetList,
        target_count: u64,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64,
        failed_count: u64,
        read_result: ReadWindowResult
    ) -> MemoryFreezeResponse
    requires 0 <= position && position < target_count;
    requires 0 <= failed_count && failed_count <= position;
    {
        let target: &MemoryFreezeTarget = MemoryFreezeTargetList::get_target(&freeze_targets, position);
        let module_offset: u64 = get_address(target);
        let module_name: &[u8] = get_module_name(target);
        let value: u64 = ElementWindow::get_element(&read_result.window, 0);
        let registry: &mut FreezeListRegistry =
            EnginePrivilegedState::borrow_freeze_list_registry_mut(&mut engine_privileged_state);
        FreezeListRegistry::set_address_frozen(&mut registry, module_offset, module_name, value, 8);
        transition { _ -> each(engine_privileged_state, freeze_targets, target_count, supplied_modules, module_count, position + 1, failed_count) }
    }
}

machine apply_i64_offset(base: u64, offset: i64) -> u64 {
    (((base as u64 in Wrapping) + (offset as u64 in Wrapping)) as u64)
}
