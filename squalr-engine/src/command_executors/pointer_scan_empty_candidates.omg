module src::command_executors::pointer_scan_empty_candidates;

use squalr_engine_api::src::structures::pointer_scans::pointer_scan_candidate::PointerScanCandidate;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_level_candidates::PointerScanLevelCandidates;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_node_type::PointerScanNodeType;

// Empty level-candidate scaffolds shared by the pointer-scan command
// executors. `PointerScanLevelCandidates` stores borrowed candidate views,
// so the anchor arrays must live in the caller frame: the helpers take the
// caller's anchors and fill the eight-slot array the executors restated.
pub machine empty_candidate_view() -> [PointerScanCandidate; 1] {
    ([PointerScanCandidate::new(0, 0, PointerScanNodeType::Heap, 0, 0, 0, 0)])
}

pub machine empty_level_candidates<'static_ext, 'heap_ext>(
    static_candidates: &'static_ext [PointerScanCandidate],
    heap_candidates: &'heap_ext [PointerScanCandidate]
) -> [PointerScanLevelCandidates<'static_ext, 'heap_ext>; 8] {
    ([
        PointerScanLevelCandidates::new_presorted(0, static_candidates, 0, heap_candidates, 0),
        PointerScanLevelCandidates::new_presorted(0, static_candidates, 0, heap_candidates, 0),
        PointerScanLevelCandidates::new_presorted(0, static_candidates, 0, heap_candidates, 0),
        PointerScanLevelCandidates::new_presorted(0, static_candidates, 0, heap_candidates, 0),
        PointerScanLevelCandidates::new_presorted(0, static_candidates, 0, heap_candidates, 0),
        PointerScanLevelCandidates::new_presorted(0, static_candidates, 0, heap_candidates, 0),
        PointerScanLevelCandidates::new_presorted(0, static_candidates, 0, heap_candidates, 0),
        PointerScanLevelCandidates::new_presorted(0, static_candidates, 0, heap_candidates, 0)
    ])
}
