module src::command_executors::scan_results_command_executor;

use squalr_engine_api::src::commands::scan_results::delete::scan_results_delete_request::ScanResultsDeleteRequest;
use squalr_engine_api::src::commands::scan_results::delete::scan_results_delete_response::ScanResultsDeleteResponse;
use squalr_engine_api::src::commands::scan_results::query::scan_results_query_request::ScanResultsQueryRequest;
use squalr_engine_api::src::commands::scan_results::query::scan_results_query_response::ScanResultsQueryResponse;
use squalr_engine_api::src::commands::scan_results::refresh::scan_results_refresh_request::ScanResultsRefreshRequest;
use squalr_engine_api::src::commands::scan_results::refresh::scan_results_refresh_response::ScanResultsRefreshResponse;
use squalr_engine_api::src::commands::scan_results::scan_results_command::ScanResultsCommand;
use squalr_engine_api::src::commands::scan_results::scan_results_response::ScanResultsResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_api::src::commands::scan_results::freeze::scan_results_freeze_request::ScanResultsFreezeRequest;
use squalr_engine_api::src::commands::scan_results::freeze::scan_results_freeze_response::ScanResultsFreezeResponse;
use squalr_engine_api::src::commands::scan_results::set_property::scan_results_set_property_request::ScanResultsSetPropertyRequest;
use squalr_engine_api::src::commands::scan_results::set_property::scan_results_set_property_response::ScanResultsSetPropertyResponse;
use src::command_executors::scan_results_delete_request_executor::ScanResultsDeleteRequestExecutor;
use src::command_executors::scan_results_freeze_request_executor::ScanResultsFreezeRequestExecutor;
use src::command_executors::scan_results_set_property_request_executor::ScanResultsSetPropertyRequestExecutor;
use src::command_executors::scan_results_list_request_executor::ScanResultsListRequestExecutor;
use src::command_executors::scan_results_query_request_executor::ScanResultsQueryRequestExecutor;
use src::command_executors::scan_results_refresh_request_executor::ScanResultsRefreshRequestExecutor;
use squalr_engine_api::src::commands::scan_results::list::scan_results_list_request::ScanResultsListRequest;
use squalr_engine_api::src::commands::scan_results::list::scan_results_list_response::ScanResultsListResponse;

// Port of command_executors/scan_results/scan_results_command_executor.rs —
// routes the scan-results command union to its executor.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ScanResultsCommandExecutor {}

pub machine ScanResultsCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    scan_results_command: ScanResultsCommand
) -> ScanResultsResponse
crashes Abort
{
    transition scan_results_command {
        ScanResultsCommand::List { request } -> list(engine_privileged_state, request)
        ScanResultsCommand::Query { request } -> query(engine_privileged_state, request)
        ScanResultsCommand::Refresh { request } -> refresh(engine_privileged_state, request)
        ScanResultsCommand::Freeze { request } -> freeze(engine_privileged_state, request)
        ScanResultsCommand::SetProperty { request } -> set_property(engine_privileged_state, request)
        ScanResultsCommand::Delete { request } -> delete(engine_privileged_state, request)
    }

    state list(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: ScanResultsListRequest
    ) -> ScanResultsResponse
    {
        let response: ScanResultsListResponse = ScanResultsListRequestExecutor::execute(
            engine_privileged_state, &request);
        transition { _ -> (ScanResultsResponse::List { response: response }) }
    }

    state query(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: ScanResultsQueryRequest
    ) -> ScanResultsResponse
    {
        let response: ScanResultsQueryResponse = ScanResultsQueryRequestExecutor::execute(
            engine_privileged_state, &request);
        transition { _ -> (ScanResultsResponse::Query { response: response }) }
    }

    state refresh(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: ScanResultsRefreshRequest
    ) -> ScanResultsResponse
    {
        let response: ScanResultsRefreshResponse = ScanResultsRefreshRequestExecutor::execute(
            engine_privileged_state, &request);
        transition { _ -> (ScanResultsResponse::Refresh { response: response }) }
    }

    state freeze(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: ScanResultsFreezeRequest
    ) -> ScanResultsResponse
    {
        let response: ScanResultsFreezeResponse = ScanResultsFreezeRequestExecutor::execute(
            engine_privileged_state, &request);
        transition { _ -> (ScanResultsResponse::Freeze { response: response }) }
    }

    state set_property(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: ScanResultsSetPropertyRequest
    ) -> ScanResultsResponse
    {
        let response: ScanResultsSetPropertyResponse = ScanResultsSetPropertyRequestExecutor::execute(
            engine_privileged_state, &request);
        transition { _ -> (ScanResultsResponse::SetProperty { response: response }) }
    }

    state delete(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: ScanResultsDeleteRequest
    ) -> ScanResultsResponse
    {
        let response: ScanResultsDeleteResponse = ScanResultsDeleteRequestExecutor::execute(
            engine_privileged_state, &request);
        transition { _ -> (ScanResultsResponse::Delete { response: response }) }
    }
}
