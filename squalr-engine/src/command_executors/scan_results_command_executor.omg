use {squalr_engine_api}/src/commands/scan_results/delete/scan_results_delete_request.omg;
use {squalr_engine_api}/src/commands/scan_results/delete/scan_results_delete_response.omg;
use {squalr_engine_api}/src/commands/scan_results/query/scan_results_query_request.omg;
use {squalr_engine_api}/src/commands/scan_results/query/scan_results_query_response.omg;
use {squalr_engine_api}/src/commands/scan_results/refresh/scan_results_refresh_request.omg;
use {squalr_engine_api}/src/commands/scan_results/refresh/scan_results_refresh_response.omg;
use {squalr_engine_api}/src/commands/scan_results/scan_results_command.omg;
use {squalr_engine_api}/src/commands/scan_results/scan_results_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_api}/src/commands/scan_results/freeze/scan_results_freeze_request.omg;
use {squalr_engine_api}/src/commands/scan_results/freeze/scan_results_freeze_response.omg;
use {squalr_engine_api}/src/commands/scan_results/set_property/scan_results_set_property_request.omg;
use {squalr_engine_api}/src/commands/scan_results/set_property/scan_results_set_property_response.omg;
use src/command_executors/scan_results_delete_request_executor.omg;
use src/command_executors/scan_results_freeze_request_executor.omg;
use src/command_executors/scan_results_set_property_request_executor.omg;
use src/command_executors/scan_results_list_request_executor.omg;
use src/command_executors/scan_results_query_request_executor.omg;
use src/command_executors/scan_results_refresh_request_executor.omg;
use {squalr_engine_api}/src/commands/scan_results/list/scan_results_list_request.omg;
use {squalr_engine_api}/src/commands/scan_results/list/scan_results_list_response.omg;

// Port of command_executors/scan_results/scan_results_command_executor.rs —
// routes the scan-results command union to its executor.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ScanResultsCommandExecutor {}

public machine ScanResultsCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    scan_results_command: &|scan_results_command|::ScanResultsCommand
) -> |scan_results_response|::ScanResultsResponse
crashes Abort
{
    transition scan_results_command {
        |scan_results_command|::ScanResultsCommand::List { request } -> list(engine_privileged_state, &request)
        |scan_results_command|::ScanResultsCommand::Query { request } -> query(engine_privileged_state, &request)
        |scan_results_command|::ScanResultsCommand::Refresh { request } -> refresh(engine_privileged_state, &request)
        |scan_results_command|::ScanResultsCommand::Freeze { request } -> freeze(engine_privileged_state, &request)
        |scan_results_command|::ScanResultsCommand::SetProperty { request } -> set_property(engine_privileged_state, &request)
        |scan_results_command|::ScanResultsCommand::Delete { request } -> delete(engine_privileged_state, &request)
    }

    machine list(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|scan_results_list_request|::ScanResultsListRequest
    ) -> |scan_results_response|::ScanResultsResponse
    {
        let response: |scan_results_list_response|::ScanResultsListResponse = |scan_results_list_request_executor|::ScanResultsListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_results_response|::ScanResultsResponse::List { response: response }) }
    }

    machine query(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|scan_results_query_request|::ScanResultsQueryRequest
    ) -> |scan_results_response|::ScanResultsResponse
    {
        let response: |scan_results_query_response|::ScanResultsQueryResponse = |scan_results_query_request_executor|::ScanResultsQueryRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_results_response|::ScanResultsResponse::Query { response: response }) }
    }

    machine refresh(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|scan_results_refresh_request|::ScanResultsRefreshRequest
    ) -> |scan_results_response|::ScanResultsResponse
    {
        let response: |scan_results_refresh_response|::ScanResultsRefreshResponse = |scan_results_refresh_request_executor|::ScanResultsRefreshRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_results_response|::ScanResultsResponse::Refresh { response: response }) }
    }

    machine freeze(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|scan_results_freeze_request|::ScanResultsFreezeRequest
    ) -> |scan_results_response|::ScanResultsResponse
    {
        let response: |scan_results_freeze_response|::ScanResultsFreezeResponse = |scan_results_freeze_request_executor|::ScanResultsFreezeRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_results_response|::ScanResultsResponse::Freeze { response: response }) }
    }

    machine set_property(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|scan_results_set_property_request|::ScanResultsSetPropertyRequest
    ) -> |scan_results_response|::ScanResultsResponse
    {
        let response: |scan_results_set_property_response|::ScanResultsSetPropertyResponse = |scan_results_set_property_request_executor|::ScanResultsSetPropertyRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_results_response|::ScanResultsResponse::SetProperty { response: response }) }
    }

    machine delete(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|scan_results_delete_request|::ScanResultsDeleteRequest
    ) -> |scan_results_response|::ScanResultsResponse
    {
        let response: |scan_results_delete_response|::ScanResultsDeleteResponse = |scan_results_delete_request_executor|::ScanResultsDeleteRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_results_response|::ScanResultsResponse::Delete { response: response }) }
    }
}
