module src::command_executors::settings_command_executor;

use squalr_engine_api::src::commands::settings::settings_command::SettingsCommand;
use squalr_engine_api::src::commands::settings::settings_response::SettingsResponse;
use squalr_engine_api::src::commands::settings::general::general_settings_command::GeneralSettingsCommand;
use squalr_engine_api::src::commands::settings::general::general_settings_response::GeneralSettingsResponse;
use squalr_engine_api::src::commands::settings::memory::memory_settings_command::MemorySettingsCommand;
use squalr_engine_api::src::commands::settings::memory::memory_settings_response::MemorySettingsResponse;
use squalr_engine_api::src::commands::settings::scan::scan_settings_command::ScanSettingsCommand;
use squalr_engine_api::src::commands::settings::scan::scan_settings_response::ScanSettingsResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::general_settings_command_executor::GeneralSettingsCommandExecutor;
use src::command_executors::memory_settings_command_executor::MemorySettingsCommandExecutor;
use src::command_executors::scan_settings_command_executor::ScanSettingsCommandExecutor;

// Port of command_executors/settings/settings_command_executor.rs — routes
// the settings command union to the per-domain executor and wraps each
// typed response in the matching `SettingsResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data SettingsCommandExecutor {}

pub machine SettingsCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    settings_command: &SettingsCommand
) -> SettingsResponse {
    transition settings_command {
        SettingsCommand::General { command } -> general(engine_privileged_state, &command)
        SettingsCommand::Memory { command } -> memory(engine_privileged_state, &command)
        SettingsCommand::Scan { command } -> scan(engine_privileged_state, &command)
    }

    state general(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &GeneralSettingsCommand
    ) -> SettingsResponse {
        let response: GeneralSettingsResponse = GeneralSettingsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (SettingsResponse::General { response: response }) }
    }

    state memory(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &MemorySettingsCommand
    ) -> SettingsResponse {
        let response: MemorySettingsResponse = MemorySettingsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (SettingsResponse::Memory { response: response }) }
    }

    state scan(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &ScanSettingsCommand
    ) -> SettingsResponse {
        let response: ScanSettingsResponse = ScanSettingsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (SettingsResponse::Scan { response: response }) }
    }
}
