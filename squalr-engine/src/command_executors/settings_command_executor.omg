use {squalr_engine_api}/src/commands/settings/settings_command.omg;
use {squalr_engine_api}/src/commands/settings/settings_response.omg;
use {squalr_engine_api}/src/commands/settings/general/general_settings_command.omg;
use {squalr_engine_api}/src/commands/settings/general/general_settings_response.omg;
use {squalr_engine_api}/src/commands/settings/memory/memory_settings_command.omg;
use {squalr_engine_api}/src/commands/settings/memory/memory_settings_response.omg;
use {squalr_engine_api}/src/commands/settings/scan/scan_settings_command.omg;
use {squalr_engine_api}/src/commands/settings/scan/scan_settings_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/general_settings_command_executor.omg;
use src/command_executors/memory_settings_command_executor.omg;
use src/command_executors/scan_settings_command_executor.omg;

// Port of command_executors/settings/settings_command_executor.rs — routes
// the settings command union to the per-domain executor and wraps each
// typed response in the matching `SettingsResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data SettingsCommandExecutor {}

public machine SettingsCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    settings_command: &|settings_command|::SettingsCommand
) -> |settings_response|::SettingsResponse {
    transition settings_command {
        |settings_command|::SettingsCommand::General { command } -> general(engine_privileged_state, &command)
        |settings_command|::SettingsCommand::Memory { command } -> memory(engine_privileged_state, &command)
        |settings_command|::SettingsCommand::Scan { command } -> scan(engine_privileged_state, &command)
    }

    machine general(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|general_settings_command|::GeneralSettingsCommand
    ) -> |settings_response|::SettingsResponse {
        let response: |general_settings_response|::GeneralSettingsResponse = |general_settings_command_executor|::GeneralSettingsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|settings_response|::SettingsResponse::General { response: response }) }
    }

    machine memory(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|memory_settings_command|::MemorySettingsCommand
    ) -> |settings_response|::SettingsResponse {
        let response: |memory_settings_response|::MemorySettingsResponse = |memory_settings_command_executor|::MemorySettingsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|settings_response|::SettingsResponse::Memory { response: response }) }
    }

    machine scan(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|scan_settings_command|::ScanSettingsCommand
    ) -> |settings_response|::SettingsResponse {
        let response: |scan_settings_response|::ScanSettingsResponse = |scan_settings_command_executor|::ScanSettingsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|settings_response|::SettingsResponse::Scan { response: response }) }
    }
}
