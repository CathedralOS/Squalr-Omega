use {squalr_engine_api}/src/commands/scan/collect_values/collect_values_request.omg;
use {squalr_engine_api}/src/commands/scan/collect_values/collect_values_response.omg;
use {squalr_engine_api}/src/events/engine_event.omg;
use {squalr_engine_api}/src/events/scan_results/updated/scan_results_updated_event.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_results_metadata.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;
use {squalr_engine_api}/src/structures/memory/memory_alignment.omg;
use {squalr_engine_api}/src/structures/settings/scan_settings.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/scan_initializer.omg;
use src/command_executors/scan_results_metadata_collector.omg;
use src/command_executors/snapshot_value_collector.omg;

// Port of commands/scan/collect_values/collect_values_request_executor.rs.
// Upstream: open the process gate, ensure the snapshot has regions, seed
// scan results for the requested data types when the snapshot is fresh,
// clear the freeze list only on that new-scan transition, then rotate
// current→previous with freshly read windows and answer with the response
// metadata. The supplied source answers both the region bounds and the read
// for the captured target; a real reader swaps in behind the same shape with
// the targets leg. Upstream's `ScanResultsUpdatedEvent` emit lands in the
// `collect` state — `is_new_scan` carries `did_initialize`.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data CollectValuesRequestExecutor {}

public machine CollectValuesRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    collect_values_request: &|collect_values_request|::CollectValuesRequest
) -> |collect_values_response|::CollectValuesResponse
crashes Abort
{
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> ensure(engine_privileged_state, collect_values_request)
        _ -> (|collect_values_response|::CollectValuesResponse::default())
    }

    // Upstream `ensure_snapshot_regions_for_scan` — populate regions only
    // when the snapshot is empty; a populated snapshot keeps its regions.
    machine ensure(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        collect_values_request: &|collect_values_request|::CollectValuesRequest
    ) -> |collect_values_response|::CollectValuesResponse {
        |scan_initializer|::ScanInitializer::ensure_snapshot_regions(engine_privileged_state);
        transition { _ -> regions(engine_privileged_state, collect_values_request) }
    }

    // Upstream skips the seed entirely when no regions were produced.
    machine regions(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        collect_values_request: &|collect_values_request|::CollectValuesRequest
    ) -> |collect_values_response|::CollectValuesResponse {
        let snapshot: &|snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let region_count: u64 = |snapshot|::Snapshot::get_region_count(snapshot);
        transition region_count > 0 {
            true -> seed(engine_privileged_state, collect_values_request)
            false -> collect(engine_privileged_state, false)
            _ -> collect(engine_privileged_state, false)
        }
    }

    // Upstream `initialize_snapshot_scan_results_if_empty` with the request's
    // data types and the stored alignment.
    machine seed(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        collect_values_request: &|collect_values_request|::CollectValuesRequest
    ) -> |collect_values_response|::CollectValuesResponse {
        let settings: |scan_settings|::ScanSettings = |engine_privileged_state|::EnginePrivilegedState::get_scan_settings(&engine_privileged_state);
        let memory_alignment: |memory_alignment|::MemoryAlignment = |scan_settings|::ScanSettings::get_memory_alignment(&settings);
        let did_initialize_new_scan: bool = |scan_initializer|::ScanInitializer::initialize_snapshot_scan_results_if_empty(
            engine_privileged_state,
            &collect_values_request.data_type_refs,
            memory_alignment);
        transition did_initialize_new_scan {
            true -> clear_freeze(engine_privileged_state)
            false -> collect(engine_privileged_state, false)
            _ -> collect(engine_privileged_state, false)
        }
    }

    // Upstream `freeze_list_registry.clear()` — gated on did_initialize.
    machine clear_freeze(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
    ) -> |collect_values_response|::CollectValuesResponse {
        |engine_privileged_state|::EnginePrivilegedState::clear_freeze_list(&mut engine_privileged_state);
        transition { _ -> collect(engine_privileged_state, true) }
    }

    // Upstream `SnapshotValueCollector::collect_values` then the update
    // event — `ScanResultsUpdatedEvent { is_new_scan: did_initialize }`.
    machine collect(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        did_initialize_new_scan: bool
    ) -> |collect_values_response|::CollectValuesResponse {
        |snapshot_value_collector|::SnapshotValueCollector::collect_all_regions(engine_privileged_state);
        let updated: |scan_results_updated_event|::ScanResultsUpdatedEvent = |scan_results_updated_event|::ScanResultsUpdatedEvent::new(did_initialize_new_scan);
        let event: |engine_event|::EngineEvent = |scan_results_updated_event|::ScanResultsUpdatedEvent::to_engine_event(&updated);
        _ = |engine_privileged_state|::EnginePrivilegedState::emit_event(&mut engine_privileged_state, &event);
        transition { _ -> finish(engine_privileged_state) }
    }

    // Upstream `collect_scan_results_metadata` on the response path.
    machine finish(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
    ) -> |collect_values_response|::CollectValuesResponse {
        let metadata: |scan_results_metadata|::ScanResultsMetadata = |scan_results_metadata_collector|::ScanResultsMetadataCollector::collect(engine_privileged_state);
        |collect_values_response|::CollectValuesResponse {
            success: true,
            scan_results_metadata: metadata,
        }
    }
}
