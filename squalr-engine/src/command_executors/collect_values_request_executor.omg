module src::command_executors::collect_values_request_executor;

use squalr_engine_api::src::commands::scan::collect_values::collect_values_request::CollectValuesRequest;
use squalr_engine_api::src::commands::scan::collect_values::collect_values_response::CollectValuesResponse;
use squalr_engine_api::src::structures::scan_results::scan_results_metadata::ScanResultsMetadata;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::settings::scan_settings::ScanSettings;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::scan_initializer::ScanInitializer;
use src::command_executors::scan_results_metadata_collector::ScanResultsMetadataCollector;
use src::command_executors::snapshot_value_collector::SnapshotValueCollector;

// Port of commands/scan/collect_values/collect_values_request_executor.rs.
// Upstream: open the process gate, ensure the snapshot has regions, seed
// scan results for the requested data types when the snapshot is fresh,
// clear the freeze list only on that new-scan transition, then rotate
// current→previous with freshly read windows and answer with the response
// metadata. The supplied source answers both the region bounds and the read
// for the captured target; a real reader swaps in behind the same shape with
// the targets leg. Upstream also emits `ScanResultsUpdatedEvent` — the event
// surface lands with the events leg, so the `is_new_scan` flag is computed
// but has no carrier yet.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data CollectValuesRequestExecutor {}

pub machine CollectValuesRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    collect_values_request: &CollectValuesRequest
) -> CollectValuesResponse
crashes Abort
{
    transition engine_privileged_state.has_opened_process() {
        true -> ensure(engine_privileged_state, collect_values_request)
        false -> (CollectValuesResponse::default())
        _ -> (CollectValuesResponse::default())
    }

    // Upstream `ensure_snapshot_regions_for_scan` — populate regions only
    // when the snapshot is empty; a populated snapshot keeps its regions.
    state ensure(
        engine_privileged_state: &mut EnginePrivilegedState,
        collect_values_request: &CollectValuesRequest
    ) -> CollectValuesResponse {
        ScanInitializer::ensure_snapshot_regions(engine_privileged_state);
        transition { _ -> regions(engine_privileged_state, collect_values_request) }
    }

    // Upstream skips the seed entirely when no regions were produced.
    state regions(
        engine_privileged_state: &mut EnginePrivilegedState,
        collect_values_request: &CollectValuesRequest
    ) -> CollectValuesResponse {
        let region_count: u64 = engine_privileged_state.borrow_snapshot().get_region_count();
        transition region_count > 0 {
            true -> seed(engine_privileged_state, collect_values_request)
            false -> collect(engine_privileged_state, false)
            _ -> collect(engine_privileged_state, false)
        }
    }

    // Upstream `initialize_snapshot_scan_results_if_empty` with the request's
    // data types and the stored alignment.
    state seed(
        engine_privileged_state: &mut EnginePrivilegedState,
        collect_values_request: &CollectValuesRequest
    ) -> CollectValuesResponse {
        let settings: ScanSettings = engine_privileged_state.get_scan_settings();
        let memory_alignment: MemoryAlignment = settings.get_memory_alignment();
        let did_initialize_new_scan: bool = ScanInitializer::initialize_snapshot_scan_results_if_empty(
            engine_privileged_state,
            &collect_values_request.data_type_refs,
            memory_alignment);
        transition did_initialize_new_scan {
            true -> clear_freeze(engine_privileged_state)
            false -> collect(engine_privileged_state, false)
            _ -> collect(engine_privileged_state, false)
        }
    }

    // Upstream `freeze_list_registry.clear()` — gated on did_initialize.
    state clear_freeze(
        engine_privileged_state: &mut EnginePrivilegedState
    ) -> CollectValuesResponse {
        engine_privileged_state.clear_freeze_list();
        transition { _ -> collect(engine_privileged_state, true) }
    }

    // Upstream `SnapshotValueCollector::collect_values` then the update
    // event; the event's `is_new_scan` flag carries `did_initialize` when the
    // events leg lands.
    state collect(
        engine_privileged_state: &mut EnginePrivilegedState,
        did_initialize_new_scan: bool
    ) -> CollectValuesResponse {
        SnapshotValueCollector::collect_all_regions(engine_privileged_state);
        transition { _ -> finish(engine_privileged_state) }
    }

    // Upstream `collect_scan_results_metadata` on the response path.
    state finish(
        engine_privileged_state: &mut EnginePrivilegedState
    ) -> CollectValuesResponse {
        let metadata: ScanResultsMetadata = ScanResultsMetadataCollector::collect(engine_privileged_state);
        CollectValuesResponse {
            success: true,
            scan_results_metadata: metadata,
        }
    }
}
