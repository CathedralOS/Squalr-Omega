module src::command_executors::debugger_pause_request_executor;

use squalr_engine_api::src::commands::debugger::pause::debugger_pause_request::DebuggerPauseRequest;
use squalr_engine_api::src::commands::debugger::pause::debugger_pause_response::DebuggerPauseResponse;
use squalr_engine_api::src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use squalr_engine_session::src::debugger::debugger_service::DebuggerOperationOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/debugger/mod.rs::DebuggerPauseRequest — no
// opened-process guard upstream; the service surfaces "No active debugger
// session." itself.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data DebuggerPauseRequestExecutor {}

pub machine DebuggerPauseRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_pause_request: &DebuggerPauseRequest
) -> DebuggerPauseResponse {
    let outcome: DebuggerOperationOutcome = EnginePrivilegedState::debugger_pause(engine_privileged_state);
    transition outcome.succeeded {
        true -> succeeded(outcome)
        _ -> failed(outcome)
    }

    state succeeded(outcome: DebuggerOperationOutcome) -> DebuggerPauseResponse {
        let mut response: DebuggerPauseResponse = DebuggerPauseResponse::new();
        DebuggerPauseResponse::set_session_state(&mut response, outcome.session_state);
        (response)
    }

    state failed(outcome: DebuggerOperationOutcome) -> DebuggerPauseResponse {
        let mut response: DebuggerPauseResponse = DebuggerPauseResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        DebuggerCommandStatus::set_message(&mut status, DebuggerOperationOutcome::get_error_message(&outcome));
        DebuggerPauseResponse::set_status(&mut response, status);
        (response)
    }
}
