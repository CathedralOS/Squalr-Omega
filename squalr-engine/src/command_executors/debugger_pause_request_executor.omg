use {squalr_engine_api}/src/commands/debugger/pause/debugger_pause_request.omg;
use {squalr_engine_api}/src/commands/debugger/pause/debugger_pause_response.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_command_status.omg;
use {squalr_engine_session}/src/debugger/debugger_service.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/debugger/mod.rs::DebuggerPauseRequest — no
// opened-process guard upstream; the service surfaces "No active debugger
// session." itself.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data DebuggerPauseRequestExecutor {}

public machine DebuggerPauseRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    debugger_pause_request: &|debugger_pause_request|::DebuggerPauseRequest
) -> |debugger_pause_response|::DebuggerPauseResponse {
    let outcome: |debugger_service|::DebuggerOperationOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_pause(&mut engine_privileged_state);
    transition outcome.succeeded {
        true -> succeeded(outcome)
        _ -> failed(outcome)
    }

    machine succeeded(outcome: |debugger_service|::DebuggerOperationOutcome) -> |debugger_pause_response|::DebuggerPauseResponse {
        let mut response: |debugger_pause_response|::DebuggerPauseResponse = |debugger_pause_response|::DebuggerPauseResponse::new();
        |debugger_pause_response|::DebuggerPauseResponse::set_session_state(&mut response, outcome.session_state);
        (response)
    }

    machine failed(outcome: |debugger_service|::DebuggerOperationOutcome) -> |debugger_pause_response|::DebuggerPauseResponse {
        let mut response: |debugger_pause_response|::DebuggerPauseResponse = |debugger_pause_response|::DebuggerPauseResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, |debugger_service|::DebuggerOperationOutcome::get_error_message(outcome));
        |debugger_pause_response|::DebuggerPauseResponse::set_status(&mut response, status);
        (response)
    }
}
