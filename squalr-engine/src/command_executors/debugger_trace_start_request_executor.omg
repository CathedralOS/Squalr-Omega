use {squalr_engine_api}/src/commands/debugger/trace_start/debugger_trace_start_request.omg;
use {squalr_engine_api}/src/commands/debugger/trace_start/debugger_trace_start_response.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_command_status.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_data_breakpoint_access.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_trace_session_descriptor.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_trace_target_kind.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_session}/src/debugger/debugger_service.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {omega}/language/core/numeric_conversion.omg;

// Port of command_executors/debugger/mod.rs::DebuggerTraceStartRequest —
// opened-process guard, service.attach(plugin_id None) first, then
// start_trace_session / start_instruction_trace_session by target_kind.
// `size_in_bytes` narrows u64 -> u8 per upstream's request field type.
public data DebuggerTraceStartRequestExecutor {}

public machine DebuggerTraceStartRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    debugger_trace_start_request: &|debugger_trace_start_request|::DebuggerTraceStartRequest
) -> |debugger_trace_start_response|::DebuggerTraceStartResponse {
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> attach(engine_privileged_state, debugger_trace_start_request)
        _ -> absent()
    }

    machine absent() -> |debugger_trace_start_response|::DebuggerTraceStartResponse {
        let mut response: |debugger_trace_start_response|::DebuggerTraceStartResponse = |debugger_trace_start_response|::DebuggerTraceStartResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, "No opened process to debug.");
        |debugger_trace_start_response|::DebuggerTraceStartResponse::set_status(&mut response, status);
        (response)
    }

    machine attach(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        debugger_trace_start_request: &|debugger_trace_start_request|::DebuggerTraceStartRequest
    ) -> |debugger_trace_start_response|::DebuggerTraceStartResponse {
        let opened_process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        let attach_outcome: |debugger_service|::DebuggerOperationOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_attach(&mut engine_privileged_state, &opened_process_info, false, "");
        transition attach_outcome.succeeded {
            true -> dispatch(engine_privileged_state, debugger_trace_start_request)
            _ -> attach_failed(attach_outcome)
        }
    }

    machine attach_failed(outcome: |debugger_service|::DebuggerOperationOutcome) -> |debugger_trace_start_response|::DebuggerTraceStartResponse {
        let mut response: |debugger_trace_start_response|::DebuggerTraceStartResponse = |debugger_trace_start_response|::DebuggerTraceStartResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, |debugger_service|::DebuggerOperationOutcome::get_error_message(&outcome));
        |debugger_trace_start_response|::DebuggerTraceStartResponse::set_status(&mut response, status);
        (response)
    }

    machine dispatch(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        debugger_trace_start_request: &|debugger_trace_start_request|::DebuggerTraceStartRequest
    ) -> |debugger_trace_start_response|::DebuggerTraceStartResponse {
        let hoist2: |debugger_trace_target_kind|::DebuggerTraceTargetKind = |debugger_trace_start_request|::DebuggerTraceStartRequest::get_target_kind(&debugger_trace_start_request);
        transition hoist2 {
            |debugger_trace_target_kind|::DebuggerTraceTargetKind::Address -> start_address(engine_privileged_state, debugger_trace_start_request)
            |debugger_trace_target_kind|::DebuggerTraceTargetKind::Instruction -> start_instruction(engine_privileged_state, debugger_trace_start_request)
            _ -> start_address(engine_privileged_state, debugger_trace_start_request)
        }
    }

    machine start_address(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        debugger_trace_start_request: &|debugger_trace_start_request|::DebuggerTraceStartRequest
    ) -> |debugger_trace_start_response|::DebuggerTraceStartResponse {
        let address: u64 = |debugger_trace_start_request|::DebuggerTraceStartRequest::get_address(&debugger_trace_start_request);
        let requested_size: u64 = |debugger_trace_start_request|::DebuggerTraceStartRequest::get_size_in_bytes(&debugger_trace_start_request);
        let size_in_bytes: u8 = |numeric_conversion|::narrow_u64_to_u8_saturating(requested_size);
        let access: |debugger_data_breakpoint_access|::DebuggerDataBreakpointAccess = |debugger_trace_start_request|::DebuggerTraceStartRequest::get_access(&debugger_trace_start_request);
        let has_label: bool = |debugger_trace_start_request|::DebuggerTraceStartRequest::has_label(&debugger_trace_start_request);
        let label: &[u8] = |debugger_trace_start_request|::DebuggerTraceStartRequest::get_label(&debugger_trace_start_request);
        let outcome: |debugger_service|::DebuggerTraceOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_start_trace_session(&mut engine_privileged_state, address,
            size_in_bytes,
            access,
            has_label,
            label);
        transition outcome.succeeded && outcome.has_trace_session {
            true -> fill(outcome)
            _ -> failed(outcome)
        }
    }

    machine start_instruction(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        debugger_trace_start_request: &|debugger_trace_start_request|::DebuggerTraceStartRequest
    ) -> |debugger_trace_start_response|::DebuggerTraceStartResponse {
        let instruction_address: u64 = |debugger_trace_start_request|::DebuggerTraceStartRequest::get_address(&debugger_trace_start_request);
        let access: |debugger_data_breakpoint_access|::DebuggerDataBreakpointAccess = |debugger_trace_start_request|::DebuggerTraceStartRequest::get_access(&debugger_trace_start_request);
        let has_label: bool = |debugger_trace_start_request|::DebuggerTraceStartRequest::has_label(&debugger_trace_start_request);
        let label: &[u8] = |debugger_trace_start_request|::DebuggerTraceStartRequest::get_label(&debugger_trace_start_request);
        let outcome: |debugger_service|::DebuggerTraceOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_start_instruction_trace_session(&mut engine_privileged_state, instruction_address,
            access,
            has_label,
            label);
        transition outcome.succeeded && outcome.has_trace_session {
            true -> fill(outcome)
            _ -> failed(outcome)
        }
    }

    machine fill(outcome: |debugger_service|::DebuggerTraceOutcome) -> |debugger_trace_start_response|::DebuggerTraceStartResponse {
        let mut response: |debugger_trace_start_response|::DebuggerTraceStartResponse = |debugger_trace_start_response|::DebuggerTraceStartResponse::new();
        |debugger_trace_start_response|::DebuggerTraceStartResponse::set_trace_session(&mut response, |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor::clone(&outcome.trace_session));
        transition { _ -> records(response, outcome, 0) }
    }

    machine records(response: |debugger_trace_start_response|::DebuggerTraceStartResponse, outcome: |debugger_service|::DebuggerTraceOutcome, position: u64) -> |debugger_trace_start_response|::DebuggerTraceStartResponse {
        transition position < outcome.instruction_record_count && position < 16 {
            true -> record(response, outcome, position)
            _ -> (response)
        }
    }

    machine record(mut response: |debugger_trace_start_response|::DebuggerTraceStartResponse, outcome: |debugger_service|::DebuggerTraceOutcome, position: u64) -> |debugger_trace_start_response|::DebuggerTraceStartResponse
        requires position < 16
    {
        _ = |debugger_trace_start_response|::DebuggerTraceStartResponse::add_instruction_record(&mut response, &outcome.instruction_records[position]);
        transition { _ -> records(response, outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    machine failed(outcome: |debugger_service|::DebuggerTraceOutcome) -> |debugger_trace_start_response|::DebuggerTraceStartResponse {
        let mut response: |debugger_trace_start_response|::DebuggerTraceStartResponse = |debugger_trace_start_response|::DebuggerTraceStartResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, |debugger_service|::DebuggerTraceOutcome::get_error_message(&outcome));
        |debugger_trace_start_response|::DebuggerTraceStartResponse::set_status(&mut response, status);
        (response)
    }
}
