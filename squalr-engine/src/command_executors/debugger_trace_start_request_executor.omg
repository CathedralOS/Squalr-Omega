module src::command_executors::debugger_trace_start_request_executor;

use squalr_engine_api::src::commands::debugger::trace_start::debugger_trace_start_request::DebuggerTraceStartRequest;
use squalr_engine_api::src::commands::debugger::trace_start::debugger_trace_start_response::DebuggerTraceStartResponse;
use squalr_engine_api::src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use squalr_engine_api::src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use squalr_engine_api::src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;
use squalr_engine_api::src::structures::debugger::debugger_trace_target_kind::DebuggerTraceTargetKind;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_session::src::debugger::debugger_service::DebuggerOperationOutcome;
use squalr_engine_session::src::debugger::debugger_service::DebuggerTraceOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use omega::language::core::numeric_conversion;

// Port of command_executors/debugger/mod.rs::DebuggerTraceStartRequest —
// opened-process guard, service.attach(plugin_id None) first, then
// start_trace_session / start_instruction_trace_session by target_kind.
// `size_in_bytes` narrows u64 -> u8 per upstream's request field type.
public data DebuggerTraceStartRequestExecutor {}

public machine DebuggerTraceStartRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_trace_start_request: &DebuggerTraceStartRequest
) -> DebuggerTraceStartResponse {
    let hoist1: bool = EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> attach(engine_privileged_state, debugger_trace_start_request)
        _ -> absent()
    }

    machine absent() -> DebuggerTraceStartResponse {
        let mut response: DebuggerTraceStartResponse = DebuggerTraceStartResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        DebuggerCommandStatus::set_message(&mut status, "No opened process to debug.");
        DebuggerTraceStartResponse::set_status(&mut response, status);
        (response)
    }

    machine attach(
        engine_privileged_state: &mut EnginePrivilegedState,
        debugger_trace_start_request: &DebuggerTraceStartRequest
    ) -> DebuggerTraceStartResponse {
        let opened_process_info: OpenedProcessInfo = EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        let attach_outcome: DebuggerOperationOutcome = EnginePrivilegedState::debugger_attach(&mut engine_privileged_state, &opened_process_info, false, "");
        transition attach_outcome.succeeded {
            true -> dispatch(engine_privileged_state, debugger_trace_start_request)
            _ -> attach_failed(attach_outcome)
        }
    }

    machine attach_failed(outcome: DebuggerOperationOutcome) -> DebuggerTraceStartResponse {
        let mut response: DebuggerTraceStartResponse = DebuggerTraceStartResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        DebuggerCommandStatus::set_message(&mut status, DebuggerOperationOutcome::get_error_message(&outcome));
        DebuggerTraceStartResponse::set_status(&mut response, status);
        (response)
    }

    machine dispatch(
        engine_privileged_state: &mut EnginePrivilegedState,
        debugger_trace_start_request: &DebuggerTraceStartRequest
    ) -> DebuggerTraceStartResponse {
        let hoist2: DebuggerTraceTargetKind = DebuggerTraceStartRequest::get_target_kind(&debugger_trace_start_request);
        transition hoist2 {
            DebuggerTraceTargetKind::Address -> start_address(engine_privileged_state, debugger_trace_start_request)
            DebuggerTraceTargetKind::Instruction -> start_instruction(engine_privileged_state, debugger_trace_start_request)
            _ -> start_address(engine_privileged_state, debugger_trace_start_request)
        }
    }

    machine start_address(
        engine_privileged_state: &mut EnginePrivilegedState,
        debugger_trace_start_request: &DebuggerTraceStartRequest
    ) -> DebuggerTraceStartResponse {
        let address: u64 = DebuggerTraceStartRequest::get_address(&debugger_trace_start_request);
        let requested_size: u64 = DebuggerTraceStartRequest::get_size_in_bytes(&debugger_trace_start_request);
        let size_in_bytes: u8 = narrow_u64_to_u8_saturating(requested_size);
        let access: DebuggerDataBreakpointAccess = DebuggerTraceStartRequest::get_access(&debugger_trace_start_request);
        let has_label: bool = DebuggerTraceStartRequest::has_label(&debugger_trace_start_request);
        let label: &[u8] = DebuggerTraceStartRequest::get_label(&debugger_trace_start_request);
        let outcome: DebuggerTraceOutcome = EnginePrivilegedState::debugger_start_trace_session(&mut engine_privileged_state, address,
            size_in_bytes,
            access,
            has_label,
            label);
        transition outcome.succeeded && outcome.has_trace_session {
            true -> fill(outcome)
            _ -> failed(outcome)
        }
    }

    machine start_instruction(
        engine_privileged_state: &mut EnginePrivilegedState,
        debugger_trace_start_request: &DebuggerTraceStartRequest
    ) -> DebuggerTraceStartResponse {
        let instruction_address: u64 = DebuggerTraceStartRequest::get_address(&debugger_trace_start_request);
        let access: DebuggerDataBreakpointAccess = DebuggerTraceStartRequest::get_access(&debugger_trace_start_request);
        let has_label: bool = DebuggerTraceStartRequest::has_label(&debugger_trace_start_request);
        let label: &[u8] = DebuggerTraceStartRequest::get_label(&debugger_trace_start_request);
        let outcome: DebuggerTraceOutcome = EnginePrivilegedState::debugger_start_instruction_trace_session(&mut engine_privileged_state, instruction_address,
            access,
            has_label,
            label);
        transition outcome.succeeded && outcome.has_trace_session {
            true -> fill(outcome)
            _ -> failed(outcome)
        }
    }

    machine fill(outcome: DebuggerTraceOutcome) -> DebuggerTraceStartResponse {
        let mut response: DebuggerTraceStartResponse = DebuggerTraceStartResponse::new();
        DebuggerTraceStartResponse::set_trace_session(&mut response, DebuggerTraceSessionDescriptor::clone(&outcome.trace_session));
        transition { _ -> records(response, outcome, 0) }
    }

    machine records(response: DebuggerTraceStartResponse, outcome: DebuggerTraceOutcome, position: u64) -> DebuggerTraceStartResponse {
        transition position < outcome.instruction_record_count && position < 16 {
            true -> record(response, outcome, position)
            _ -> (response)
        }
    }

    machine record(mut response: DebuggerTraceStartResponse, outcome: DebuggerTraceOutcome, position: u64) -> DebuggerTraceStartResponse
        requires position < 16
    {
        _ = DebuggerTraceStartResponse::add_instruction_record(&mut response, &outcome.instruction_records[position]);
        transition { _ -> records(response, outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    machine failed(outcome: DebuggerTraceOutcome) -> DebuggerTraceStartResponse {
        let mut response: DebuggerTraceStartResponse = DebuggerTraceStartResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        DebuggerCommandStatus::set_message(&mut status, DebuggerTraceOutcome::get_error_message(&outcome));
        DebuggerTraceStartResponse::set_status(&mut response, status);
        (response)
    }
}
