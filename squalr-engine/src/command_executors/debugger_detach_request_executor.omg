module src::command_executors::debugger_detach_request_executor;

use squalr_engine_api::src::commands::debugger::detach::debugger_detach_request::DebuggerDetachRequest;
use squalr_engine_api::src::commands::debugger::detach::debugger_detach_response::DebuggerDetachResponse;
use squalr_engine_api::src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use squalr_engine_session::src::debugger::debugger_service::DebuggerOperationOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/debugger/mod.rs::DebuggerDetachRequest — no
// opened-process guard upstream; the service surfaces "No active debugger
// session." itself.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data DebuggerDetachRequestExecutor {}

pub machine DebuggerDetachRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_detach_request: &DebuggerDetachRequest
) -> DebuggerDetachResponse {
    let outcome: DebuggerOperationOutcome = EnginePrivilegedState::debugger_detach(engine_privileged_state);
    transition outcome.succeeded {
        true -> succeeded(outcome)
        _ -> failed(outcome)
    }

    state succeeded(outcome: DebuggerOperationOutcome) -> DebuggerDetachResponse {
        let mut response: DebuggerDetachResponse = DebuggerDetachResponse::new();
        DebuggerDetachResponse::set_session_state(&mut response, outcome.session_state);
        (response)
    }

    state failed(outcome: DebuggerOperationOutcome) -> DebuggerDetachResponse {
        let mut response: DebuggerDetachResponse = DebuggerDetachResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        DebuggerCommandStatus::set_message(&mut status, DebuggerOperationOutcome::get_error_message(&outcome));
        DebuggerDetachResponse::set_status(&mut response, status);
        (response)
    }
}
