use {squalr_engine_api}/src/commands/debugger/detach/debugger_detach_request.omg;
use {squalr_engine_api}/src/commands/debugger/detach/debugger_detach_response.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_command_status.omg;
use {squalr_engine_session}/src/debugger/debugger_service.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/debugger/mod.rs::DebuggerDetachRequest — no
// opened-process guard upstream; the service surfaces "No active debugger
// session." itself.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data DebuggerDetachRequestExecutor {}

public machine DebuggerDetachRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    debugger_detach_request: &|debugger_detach_request|::DebuggerDetachRequest
) -> |debugger_detach_response|::DebuggerDetachResponse {
    let outcome: |debugger_service|::DebuggerOperationOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_detach(&mut engine_privileged_state);
    transition outcome.succeeded {
        true -> succeeded(outcome)
        _ -> failed(outcome)
    }

    machine succeeded(outcome: |debugger_service|::DebuggerOperationOutcome) -> |debugger_detach_response|::DebuggerDetachResponse {
        let mut response: |debugger_detach_response|::DebuggerDetachResponse = |debugger_detach_response|::DebuggerDetachResponse::new();
        |debugger_detach_response|::DebuggerDetachResponse::set_session_state(&mut response, outcome.session_state);
        (response)
    }

    machine failed(outcome: |debugger_service|::DebuggerOperationOutcome) -> |debugger_detach_response|::DebuggerDetachResponse {
        let mut response: |debugger_detach_response|::DebuggerDetachResponse = |debugger_detach_response|::DebuggerDetachResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, |debugger_service|::DebuggerOperationOutcome::get_error_message(outcome));
        |debugger_detach_response|::DebuggerDetachResponse::set_status(&mut response, status);
        (response)
    }
}
