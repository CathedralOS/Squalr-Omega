    }
    state dot_done(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, last_dot: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        let source_bytes: &[u8] = ManifestPathScratch::get_bytes(&source);
        transition last_dot > 0 && last_dot <= source_bytes.len {
