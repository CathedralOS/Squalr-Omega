    state copy_stem(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        let source_bytes: &[u8] = ManifestPathScratch::get_bytes(&source);
        transition name_start <= stem_end && stem_end <= source_bytes.len {
            true -> stem_loop(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, name_start)
