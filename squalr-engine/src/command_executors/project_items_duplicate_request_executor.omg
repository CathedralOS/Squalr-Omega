    state stem_loop(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch, copy_position: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        let source_bytes: &[u8] = ManifestPathScratch::get_bytes(&source);
        transition copy_position < stem_end && copy_position < source_bytes.len {
            true -> stem_byte(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, copy_position)
            _ -> suffix_gate(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name)
        }
    }
    state stem_byte(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch, copy_position: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        let source_bytes: &[u8] = ManifestPathScratch::get_bytes(&source);
        _ = ManifestPathScratch::append(&mut name, source_bytes[copy_position]);
        transition { _ -> stem_loop(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, ((copy_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    // Directories append `_N` to the whole name; files split stem/ext.
    state suffix_gate(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        transition sequence > 0 {
            true -> suffix_emit(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, sequence, 1)
            _ -> ext_copy(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name)
        }
    }
    // `_` + decimal(sequence) — magnitude-first bounded emit.
    state suffix_emit(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch, value: u64, magnitude: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        let mut next_magnitude: u64 = ((magnitude as u64 in Wrapping) * (10 as u64 in Wrapping)) as u64;
        transition magnitude == 1 && name.len < 512 {
            true -> underscore(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, value, magnitude)
            _ -> suffix_grow(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, value, magnitude, next_magnitude)
        }
    }
    state underscore(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch, value: u64, magnitude: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
        requires name.len < 512;
    {
        name.bytes[name.len] = 95;
        name.len = ((name.len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> suffix_grow(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, value, magnitude, magnitude) }
    }
    state suffix_grow(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch, value: u64, magnitude: u64, next_magnitude: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        transition next_magnitude <= value && next_magnitude <= 999 {
            true -> suffix_emit(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, value, next_magnitude)
            _ -> suffix_digit(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, value, magnitude)
        }
    }
    state suffix_digit(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch, value: u64, magnitude: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        transition magnitude > 0 {
            true -> digit_byte(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, value, magnitude)
            _ -> ext_copy(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name)
        }
    }
    state digit_byte(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch, value: u64, magnitude: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        let digit: u64 = ((value as u64 in Wrapping) / (magnitude as u64 in Wrapping)) as u64;
        let rem: u64 = ((digit as u64 in Wrapping) % (10 as u64 in Wrapping)) as u64;
        let byte_value: u8 = ((rem as u64 in Wrapping) + (48 as u64 in Wrapping)) as u8;
        transition name.len < 512 {
            true -> digit_put(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, value, magnitude, byte_value)
            _ -> ext_copy(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name)
        }
    }
    state digit_put(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch, value: u64, magnitude: u64, byte_value: u8) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
        requires name.len < 512;
    {
        name.bytes[name.len] = byte_value;
        name.len = ((name.len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> suffix_digit(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, value, ((magnitude as u64 in Wrapping) / (10 as u64 in Wrapping)) as u64) }
    }

    // Files append `<dot..end>` (extension incl. dot); directories have
    // stem_end == name end so this copies nothing.
    state ext_copy(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        transition is_dir {
            true -> join_candidate(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name)
            _ -> ext_loop(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, stem_end)
        }
    }
    state ext_loop(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch, copy_position: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        let source_bytes: &[u8] = ManifestPathScratch::get_bytes(&source);
        transition copy_position < source_bytes.len {
            true -> ext_byte(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, copy_position)
            _ -> join_candidate(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name)
        }
    }
    state ext_byte(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, mut name: ManifestPathScratch, copy_position: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        let source_bytes: &[u8] = ManifestPathScratch::get_bytes(&source);
        _ = ManifestPathScratch::append(&mut name, source_bytes[copy_position]);
        transition { _ -> ext_loop(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, name, ((copy_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state join_candidate(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, name: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        let mut candidate: ManifestPathScratch;
        ManifestPathScratch::new(&mut candidate);
        let mut path_joiner: ProjectItemSortOrder = ProjectItemSortOrder {};
        let inner3036: &[u8] = ManifestPathScratch::get_bytes(&target);
        let inner3037: &[u8] = ManifestPathScratch::get_bytes(&name);
        transition ProjectItemSortOrder::join_path(path_joiner, inner3036, inner3037, &mut candidate) {
            true -> candidate_exists(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, sequence, candidate)
            _ -> each(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, duplicated_count, false)
        }
    }
    state candidate_exists(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, stem_end: u64, sequence: u64, candidate: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        let inner3038: &[u8] = ManifestPathScratch::get_bytes(&candidate);
        transition FileSystemUtils::path_exists(inner3038) {
            true -> candidate_loop(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, stem_end, ((sequence as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> copy_tree(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, candidate)
        }
    }
    // `duplicate_project_item_from_snapshot` — `rename_tree` copies the
    // tree without removing the source (upstream's snapshot+replay post
    // state).
    state copy_tree(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, candidate: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let inner3039: &[u8] = ManifestPathScratch::get_bytes(&source);
        let inner3040: &[u8] = ManifestPathScratch::get_bytes(&candidate);
        transition FileSystemUtils::rename_tree(inner3039, inner3040) {
            true -> record(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, candidate)
            _ -> each(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, duplicated_count, false)
        }
    }
    state record(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, candidate: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let inner3041: &[u8] = ManifestPathScratch::get_bytes(&candidate);
        _ = ProjectPathList::add_path(&mut duplicated_paths, inner3041);
        transition { _ -> each(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, ((duplicated_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, operation_success) }
    }

    state reload_gate(engine_unprivileged_state: &mut EngineUnprivilegedState, directory: [u8; 512], directory_len: u64, duplicated_paths: ProjectPathList, duplicated_count: u64, operation_success: bool) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        transition duplicated_count > 0 {
            true -> reload_open(engine_unprivileged_state, directory, directory_len, duplicated_paths, duplicated_count, operation_success)
            _ -> respond(operation_success, duplicated_paths, duplicated_count)
        }
    }
    state reload_open(engine_unprivileged_state: &mut EngineUnprivilegedState, directory: [u8; 512], directory_len: u64, duplicated_paths: ProjectPathList, duplicated_count: u64, operation_success: bool) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let dir_fd: i32 = FileSystemUtils::open_path(&directory[0..directory_len], 0);
        transition dir_fd >= 0 {
            true -> reload_read(engine_unprivileged_state, dir_fd, directory, directory_len, duplicated_paths, duplicated_count, operation_success)
            _ -> respond_fail(duplicated_paths, duplicated_count)
        }
    }
    state reload_read(engine_unprivileged_state: &mut EngineUnprivilegedState, dir_fd: i32, directory: [u8; 512], directory_len: u64, duplicated_paths: ProjectPathList, duplicated_count: u64, operation_success: bool) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let loaded: ProjectLoad = Project::load_at(dir_fd, &directory[0..directory_len]);
        _ = FilesystemHost::close(dir_fd);
        transition loaded {
            ProjectLoad::Loaded { project } -> sort(engine_unprivileged_state, directory, directory_len, duplicated_paths, duplicated_count, operation_success, project)
            _ -> respond_fail(duplicated_paths, duplicated_count)
        }
    }
    state sort(engine_unprivileged_state: &mut EngineUnprivilegedState, directory: [u8; 512], directory_len: u64, duplicated_paths: ProjectPathList, duplicated_count: u64, operation_success: bool, mut project: Project) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let mut sort_order: ProjectItemSortOrder = ProjectItemSortOrder {};
        _ = ProjectItemSortOrder::append_project_item_paths_to_sort_order(&sort_order, &mut project, &directory[0..directory_len], &duplicated_paths);
        transition { _ -> store(engine_unprivileged_state, directory, directory_len, duplicated_paths, duplicated_count, operation_success, project) }
    }
    state store(engine_unprivileged_state: &mut EngineUnprivilegedState, directory: [u8; 512], directory_len: u64, duplicated_paths: ProjectPathList, duplicated_count: u64, operation_success: bool, project: Project) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        ProjectManager::set_opened_project(project_manager, &project);
        transition { _ -> save_open(engine_unprivileged_state, directory, directory_len, duplicated_paths, duplicated_count, operation_success) }
    }
    state save_open(engine_unprivileged_state: &mut EngineUnprivilegedState, directory: [u8; 512], directory_len: u64, duplicated_paths: ProjectPathList, duplicated_count: u64, operation_success: bool) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let dir_fd: i32 = FileSystemUtils::open_path(&directory[0..directory_len], 0);
        transition dir_fd >= 0 {
            true -> save_do(engine_unprivileged_state, dir_fd, directory, directory_len, duplicated_paths, duplicated_count, operation_success)
            _ -> respond_fail(duplicated_paths, duplicated_count)
        }
    }
    state save_do(engine_unprivileged_state: &mut EngineUnprivilegedState, dir_fd: i32, directory: [u8; 512], directory_len: u64, duplicated_paths: ProjectPathList, duplicated_count: u64, operation_success: bool) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        let opened_project: &mut Project = ProjectManager::borrow_opened_project_mut(project_manager);
        let saved: ProjectFileSave = Project::save_at(opened_project, dir_fd, &directory[0..directory_len], false);
        _ = FilesystemHost::close(dir_fd);
        transition saved {
            ProjectFileSave::Stored -> notify_done(engine_unprivileged_state, duplicated_paths, duplicated_count, operation_success)
            _ -> respond_fail(duplicated_paths, duplicated_count)
        }
    }
    state notify_done(engine_unprivileged_state: &mut EngineUnprivilegedState, duplicated_paths: ProjectPathList, duplicated_count: u64, operation_success: bool) -> ProjectItemsDuplicateResponse {
        EngineUnprivilegedState::notify_project_items_changed(engine_unprivileged_state);
        transition { _ -> respond(operation_success, duplicated_paths, duplicated_count) }
    }
    state respond(operation_success: bool, duplicated_paths: ProjectPathList, duplicated_count: u64) -> ProjectItemsDuplicateResponse {
        let mut response: ProjectItemsDuplicateResponse = ProjectItemsDuplicateResponse::new();
        ProjectItemsDuplicateResponse::set_success(&mut response, operation_success);
        ProjectItemsDuplicateResponse::set_duplicated_project_item_paths(&mut response, duplicated_paths);
        ProjectItemsDuplicateResponse::set_duplicated_project_item_count(&mut response, duplicated_count);
        (response)
    }
    state respond_fail(duplicated_paths: ProjectPathList, duplicated_count: u64) -> ProjectItemsDuplicateResponse {
        let mut response: ProjectItemsDuplicateResponse = ProjectItemsDuplicateResponse::new();
        ProjectItemsDuplicateResponse::set_duplicated_project_item_paths(&mut response, duplicated_paths);
        ProjectItemsDuplicateResponse::set_duplicated_project_item_count(&mut response, duplicated_count);
        (response)
    }
    state refused() -> ProjectItemsDuplicateResponse {
        (ProjectItemsDuplicateResponse::new())
    }
}
