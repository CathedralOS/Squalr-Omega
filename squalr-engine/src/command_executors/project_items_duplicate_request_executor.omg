            _ -> dot_scan(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, ((scan_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, last_dot)
