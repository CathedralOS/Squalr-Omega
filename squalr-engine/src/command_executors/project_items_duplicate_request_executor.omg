    state each(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let paths: &ProjectPathList = ProjectItemsDuplicateRequest::get_project_item_paths(project_items_duplicate_request);
        transition position < ProjectPathList::get_path_count(paths) {
            true -> resolve_source(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success)
            _ -> reload_gate(engine_unprivileged_state, directory, directory_len, duplicated_paths, duplicated_count, operation_success)
        }
    }
    state resolve_source(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let paths: &ProjectPathList = ProjectItemsDuplicateRequest::get_project_item_paths(project_items_duplicate_request);
        let item_path: &[u8] = ProjectPathList::get_path(paths, position);
        let mut source: ManifestPathScratch;
        ManifestPathScratch::new(&mut source);
        transition ProjectItemFileMutation::resolve_project_item_path(&directory[0..directory_len], item_path, &mut source) {
            true -> root_guard(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source)
            _ -> each(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, duplicated_count, false)
        }
    }
    // Upstream refuses the items root itself.
    state root_guard(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let mut path_equaler: ProjectItemSortOrder = ProjectItemSortOrder {};
        let inner3033: &[u8] = ManifestPathScratch::get_bytes(&source);
        let inner3034: &[u8] = ManifestPathScratch::get_bytes(&items_root);
        transition ProjectItemSortOrder::paths_equal(path_equaler, inner3033, inner3034) {
            true -> each(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, duplicated_count, false)
            _ -> source_exists(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source)
        }
    }
    state source_exists(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let inner3035: &[u8] = ManifestPathScratch::get_bytes(&source);
        transition FileSystemUtils::path_exists(inner3035) {
            true -> source_kind(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source)
            _ -> each(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, duplicated_count, false)
        }
    }
    state source_kind(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let is_dir: bool = FileSystemUtils::is_dir_path(ManifestPathScratch::get_bytes(&source));
        let inner45: &[u8] = ManifestPathScratch::get_bytes(&source);
        let name_start: u64 = ProjectItemFileMutation::find_last_separator(inner45);
        transition { _ -> name_parts(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start) }
    }
    // name_start bounds the file-name slice; the last '.' after it is the
    // extension (extension includes the dot, per upstream format!("{}_{}.{}")).
    state name_parts(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let source_bytes: &[u8] = ManifestPathScratch::get_bytes(&source);
        transition name_start <= source_bytes.len && name_start <= 512 {
            true -> dot_scan(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, name_start, 0)
            _ -> each(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, duplicated_count, false)
        }
    }
    // Scan for the last '.' in the name, tracked in `last_dot` (0 = none
    // found yet); `stem_end` resolves to last_dot or the name end.
    state dot_scan(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, scan_position: u64, last_dot: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        let source_bytes: &[u8] = ManifestPathScratch::get_bytes(&source);
        transition scan_position < source_bytes.len {
            true -> dot_check(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, scan_position, last_dot)
            _ -> dot_done(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, last_dot)
        }
    }
    state dot_check(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch, mut duplicated_paths: ProjectPathList, position: u64, duplicated_count: u64, operation_success: bool, source: ManifestPathScratch, is_dir: bool, name_start: u64, scan_position: u64, last_dot: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
        requires name_start <= 512;
    {
        let source_bytes: &[u8] = ManifestPathScratch::get_bytes(&source);
        transition scan_position < source_bytes.len {
            true -> dot_byte(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, scan_position, last_dot)
            _ -> dot_done(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, position, duplicated_count, operation_success, source, is_dir, name_start, last_dot)
