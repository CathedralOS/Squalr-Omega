// Port of command_executors/project_items/duplicate/
// project_items_duplicate_request_executor.rs — resolve the target dir
// (clamped to <dir>/project_items), create it, then per item: refuse the
// items root itself, require existence, mint a unique
// `<stem>[_N]<ext>` candidate under the target, and tree-copy
// (`rename_tree` — copy without delete; upstream's read+write snapshot
// has the same post state). Reload, append sort-order entries, save,
// notify.
pub data ProjectItemsDuplicateRequestExecutor {}

pub machine ProjectItemsDuplicateRequestExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_items_duplicate_request: &ProjectItemsDuplicateRequest
) -> ProjectItemsDuplicateResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let paths: &ProjectPathList = ProjectItemsDuplicateRequest::get_project_item_paths(project_items_duplicate_request);
    transition ProjectPathList::get_path_count(paths) == 0 {
        true -> empty()
        _ -> opened(engine_unprivileged_state, project_items_duplicate_request)
    }

    state empty() -> ProjectItemsDuplicateResponse {
        let mut response: ProjectItemsDuplicateResponse = ProjectItemsDuplicateResponse::new();
        ProjectItemsDuplicateResponse::set_success(&mut response, true);
        (response)
    }

    state opened(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest) -> ProjectItemsDuplicateResponse {
        let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
        transition ProjectManager::get_has_opened_project(project_manager) {
            true -> directory(engine_unprivileged_state, project_items_duplicate_request)
            _ -> refused()
        }
    }
    state directory(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest) -> ProjectItemsDuplicateResponse {
        let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
        let opened_project: &Project = ProjectManager::get_opened_project(project_manager);
        let project_info: &ProjectInfo = Project::get_project_info(opened_project);
        let mut directory: [u8; 512];
        transition ProjectInfo::get_project_directory(project_info, &mut directory) {
            true -> measure(engine_unprivileged_state, project_items_duplicate_request, directory)
            _ -> refused()
        }
    }
    state measure(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512]) -> ProjectItemsDuplicateResponse {
        let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
        let opened_project: &Project = ProjectManager::get_opened_project(project_manager);
        let project_info: &ProjectInfo = Project::get_project_info(opened_project);
        let directory_len: u64 = ProjectInfo::get_project_directory_len(project_info);
        transition directory_len <= 512 {
            true -> root(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len)
            _ -> refused()
        }
    }
    state root(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let mut items_root: ManifestPathScratch;
        ManifestPathScratch::new(&mut items_root);
        let mut path_joiner: ProjectItemSortOrder = ProjectItemSortOrder {};
        _ = ProjectItemSortOrder::join_path(path_joiner, &directory[0..directory_len], "project_items", &mut items_root);
        transition { _ -> resolve_target(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root) }
    }
    state resolve_target(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let mut target: ManifestPathScratch;
        ManifestPathScratch::new(&mut target);
        let target_path: &[u8] = ProjectItemsDuplicateRequest::get_target_directory_path(project_items_duplicate_request);
        transition ProjectItemFileMutation::resolve_project_item_path(&directory[0..directory_len], target_path, &mut target) {
            true -> clamp_target(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target)
            _ -> refused()
        }
    }
    // Upstream `starts_with(project_root)` — otherwise clamp to the root.
    state clamp_target(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let mut path_starter: ProjectItemSortOrder = ProjectItemSortOrder {};
        let inner3029: &[u8] = ManifestPathScratch::get_bytes(&target);
        let inner3030: &[u8] = ManifestPathScratch::get_bytes(&items_root);
        transition ProjectItemSortOrder::path_starts_with(path_starter, inner3029, inner3030) {
            true -> mkdir_target(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target)
            _ -> clamp_copy(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root)
        }
    }
    state clamp_copy(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let mut target: ManifestPathScratch;
        ManifestPathScratch::new(&mut target);
        let mut path_copier: ProjectItemSortOrder = ProjectItemSortOrder {};
        let inner3031: &[u8] = ManifestPathScratch::get_bytes(&items_root);
        _ = ProjectItemSortOrder::copy_into(path_copier, inner3031, &mut target);
        transition { _ -> mkdir_target(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target) }
    }
    state mkdir_target(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let inner3032: &[u8] = ManifestPathScratch::get_bytes(&target);
        transition FileSystemUtils::create_dir_all_path(inner3032) {
            true -> items(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target)
            _ -> refused()
        }
    }

    state items(engine_unprivileged_state: &mut EngineUnprivilegedState, project_items_duplicate_request: &ProjectItemsDuplicateRequest, directory: [u8; 512], directory_len: u64, items_root: ManifestPathScratch, target: ManifestPathScratch) -> ProjectItemsDuplicateResponse
        requires directory_len <= 512;
    {
        let mut duplicated_paths: ProjectPathList = ProjectPathList::empty();
        transition { _ -> each(engine_unprivileged_state, project_items_duplicate_request, directory, directory_len, items_root, target, duplicated_paths, 0, 0, true) }
