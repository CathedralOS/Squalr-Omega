module src::command_executors::debugger_trace_stop_request_executor;

use squalr_engine_api::src::commands::debugger::trace_stop::debugger_trace_stop_request::DebuggerTraceStopRequest;
use squalr_engine_api::src::commands::debugger::trace_stop::debugger_trace_stop_response::DebuggerTraceStopResponse;
use squalr_engine_api::src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use squalr_engine_api::src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;
use squalr_engine_session::src::debugger::debugger_service::DebuggerTraceOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/debugger/mod.rs::DebuggerTraceStopRequest —
// service.debugger_stop_trace_session(trace_session_id) -> Some(session)+records / Err.
pub data DebuggerTraceStopRequestExecutor {}

pub machine DebuggerTraceStopRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_trace_stop_request: &DebuggerTraceStopRequest
) -> DebuggerTraceStopResponse {
    let trace_session_id: &[u8] = DebuggerTraceStopRequest::get_trace_session_id(&debugger_trace_stop_request);
    let outcome: DebuggerTraceOutcome = EnginePrivilegedState::debugger_stop_trace_session(&mut engine_privileged_state, trace_session_id);
    transition outcome.succeeded && outcome.has_trace_session {
        true -> fill(outcome)
        _ -> failed(outcome)
    }

    state fill(outcome: DebuggerTraceOutcome) -> DebuggerTraceStopResponse {
        let mut response: DebuggerTraceStopResponse = DebuggerTraceStopResponse::new();
        DebuggerTraceStopResponse::set_trace_session(&mut response, DebuggerTraceSessionDescriptor::clone(&outcome.trace_session));
        transition { _ -> records(response, outcome, 0) }
    }

    state records(response: DebuggerTraceStopResponse, outcome: DebuggerTraceOutcome, position: u64) -> DebuggerTraceStopResponse {
        transition position < outcome.instruction_record_count && position < 16 {
            true -> record(response, outcome, position)
            _ -> (response)
        }
    }

    state record(mut response: DebuggerTraceStopResponse, outcome: DebuggerTraceOutcome, position: u64) -> DebuggerTraceStopResponse
        requires position < 16
    {
        _ = DebuggerTraceStopResponse::add_instruction_record(&mut response, &outcome.instruction_records[position]);
        transition { _ -> records(response, outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state failed(outcome: DebuggerTraceOutcome) -> DebuggerTraceStopResponse {
        let mut response: DebuggerTraceStopResponse = DebuggerTraceStopResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        DebuggerCommandStatus::set_message(&mut status, DebuggerTraceOutcome::get_error_message(outcome));
        DebuggerTraceStopResponse::set_status(&mut response, status);
        (response)
    }
}
