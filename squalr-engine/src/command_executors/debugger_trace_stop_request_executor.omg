use {squalr_engine_api}/src/commands/debugger/trace_stop/debugger_trace_stop_request.omg;
use {squalr_engine_api}/src/commands/debugger/trace_stop/debugger_trace_stop_response.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_command_status.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_trace_session_descriptor.omg;
use {squalr_engine_session}/src/debugger/debugger_service.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/debugger/mod.rs::DebuggerTraceStopRequest —
// service.debugger_stop_trace_session(trace_session_id) -> Some(session)+records / Err.
public data DebuggerTraceStopRequestExecutor {}

public machine DebuggerTraceStopRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    debugger_trace_stop_request: &|debugger_trace_stop_request|::DebuggerTraceStopRequest
) -> |debugger_trace_stop_response|::DebuggerTraceStopResponse {
    let trace_session_id: &[u8] = |debugger_trace_stop_request|::DebuggerTraceStopRequest::get_trace_session_id(&debugger_trace_stop_request);
    let outcome: |debugger_service|::DebuggerTraceOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_stop_trace_session(&mut engine_privileged_state, trace_session_id);
    transition outcome.succeeded && outcome.has_trace_session {
        true -> fill(outcome)
        _ -> failed(outcome)
    }

    machine fill(outcome: |debugger_service|::DebuggerTraceOutcome) -> |debugger_trace_stop_response|::DebuggerTraceStopResponse {
        let mut response: |debugger_trace_stop_response|::DebuggerTraceStopResponse = |debugger_trace_stop_response|::DebuggerTraceStopResponse::new();
        |debugger_trace_stop_response|::DebuggerTraceStopResponse::set_trace_session(&mut response, |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor::clone(&outcome.trace_session));
        transition { _ -> records(response, outcome, 0) }
    }

    machine records(response: |debugger_trace_stop_response|::DebuggerTraceStopResponse, outcome: |debugger_service|::DebuggerTraceOutcome, position: u64) -> |debugger_trace_stop_response|::DebuggerTraceStopResponse {
        transition position < outcome.instruction_record_count && position < 16 {
            true -> record(response, outcome, position)
            _ -> (response)
        }
    }

    machine record(mut response: |debugger_trace_stop_response|::DebuggerTraceStopResponse, outcome: |debugger_service|::DebuggerTraceOutcome, position: u64) -> |debugger_trace_stop_response|::DebuggerTraceStopResponse
        requires position < 16
    {
        _ = |debugger_trace_stop_response|::DebuggerTraceStopResponse::add_instruction_record(&mut response, &outcome.instruction_records[position]);
        transition { _ -> records(response, outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    machine failed(outcome: |debugger_service|::DebuggerTraceOutcome) -> |debugger_trace_stop_response|::DebuggerTraceStopResponse {
        let mut response: |debugger_trace_stop_response|::DebuggerTraceStopResponse = |debugger_trace_stop_response|::DebuggerTraceStopResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, |debugger_service|::DebuggerTraceOutcome::get_error_message(outcome));
        |debugger_trace_stop_response|::DebuggerTraceStopResponse::set_status(&mut response, status);
        (response)
    }
}
