use {squalr_engine_api}/src/structures/data_types/data_type_ref.omg;
use {squalr_engine_api}/src/structures/memory/memory_alignment.omg;
use {squalr_engine_api}/src/registries/scan_rules/element_scan_rule_registry.omg;
use {squalr_engine_api}/src/structures/scanning/comparisons/scan_compare_type.omg;
use {squalr_engine_api}/src/structures/scanning/filters/snapshot_region_filter.omg;
use {squalr_engine_api}/src/structures/scanning/filters/snapshot_region_filter_collection.omg;
use {squalr_engine_api}/src/structures/scanning/plans/element_scan/element_scan_plan.omg;
use {squalr_engine_api}/src/structures/scanning/plans/element_scan/snapshot_filter_element_scan_plan.omg;
use {squalr_engine_api}/src/structures/scanning/plans/plan_types/planned_scan_type.omg;
use {squalr_engine_api}/src/structures/scanning/plans/plan_types/planned_scan_type_scalar.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot_region.omg;
use {squalr_engine_scanning}/src/scanners/element_scan_runner.omg;
use {squalr_engine_scanning}/src/scanners/scan_control.omg;

// Port of `ElementScanDispatcher::dispatch_scan` +
// `dispatch_scan_for_snapshot_filter_collection` (single-threaded leg). Per
// filter of the incoming collection, constraints run SEQUENTIALLY — each
// constraint's scan maps the current filter set to a new set; a filter whose
// chain empties contributes nothing (upstream's filter_map drop). The chain
// carrier is the filter collection itself, matching upstream's Vec of
// filters one stage deep.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ElementScanChainDispatcher {}

public machine ElementScanChainDispatcher::dispatch_collection(
    snapshot_region: &|snapshot_region|::SnapshotRegion,
    collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
    element_scan_plan: &|element_scan_plan|::ElementScanPlan,
    plan_list: &|element_scan_plan|::TypePlanList,
    scan_control: &mut |scan_control|::ScanControl
) -> |snapshot_region_filter_collection|::SnapshotRegionFilterCollection
crashes Abort
{
    let dtr: |data_type_ref|::DataTypeRef = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_data_type_ref(&collection);
    let ma: |memory_alignment|::MemoryAlignment = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_memory_alignment(&collection);
    let rv: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_result_value_size_in_bytes(&collection);
    let out: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::empty(dtr, ma, rv);
    transition { _ -> each_filter(
        snapshot_region, collection, element_scan_plan, plan_list, scan_control, out, 0) }

    machine each_filter(
        snapshot_region: &|snapshot_region|::SnapshotRegion,
        collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        plan_list: &|element_scan_plan|::TypePlanList,
        scan_control: &mut |scan_control|::ScanControl,
        out: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        filter_index: u64
    ) -> |snapshot_region_filter_collection|::SnapshotRegionFilterCollection
    {
        let hoist1: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter_count(&collection);
        transition filter_index < hoist1 {
            true -> chain(
                snapshot_region, collection, element_scan_plan, plan_list, scan_control, out, filter_index)
            false -> (out)
        }
    }

    // Run one input filter through every plan in the list. `stage` is the
    // collection-shaped carrier of the surviving filters between
    // constraints — upstream's `scan_result_filters` Vec.
    machine chain(
        snapshot_region: &|snapshot_region|::SnapshotRegion,
        collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        plan_list: &|element_scan_plan|::TypePlanList,
        scan_control: &mut |scan_control|::ScanControl,
        out: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        filter_index: u64
    ) -> |snapshot_region_filter_collection|::SnapshotRegionFilterCollection
    {
        let filter: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter(&collection, filter_index);
        let stage_dtr: |data_type_ref|::DataTypeRef = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_data_type_ref(&collection);
        let stage_ma: |memory_alignment|::MemoryAlignment = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_memory_alignment(&collection);
        let stage_rv: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_result_value_size_in_bytes(&collection);
        let mut stage: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::empty(
            stage_dtr, stage_ma, stage_rv);
        let seeded: bool = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::push_filter(&mut stage, &filter);
        let survived: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = ElementScanChainDispatcher::run_chain(
            snapshot_region, stage, collection, element_scan_plan, plan_list, scan_control, 0);
        let merged: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = ElementScanChainDispatcher::append_filters(
            out, &survived, 0);
        transition { _ -> each_filter(
            snapshot_region, collection, element_scan_plan, plan_list, scan_control, merged, ((filter_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// The sequential constraint pass over one input filter — plan-by-plan.
public machine ElementScanChainDispatcher::run_chain(
    snapshot_region: &|snapshot_region|::SnapshotRegion,
    stage: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
    collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
    element_scan_plan: &|element_scan_plan|::ElementScanPlan,
    plan_list: &|element_scan_plan|::TypePlanList,
    scan_control: &mut |scan_control|::ScanControl,
    plan_index: u64
) -> |snapshot_region_filter_collection|::SnapshotRegionFilterCollection
crashes Abort
{
    let hoist3: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter_count(&stage);
    let hoist2: u64 = |element_scan_plan|::TypePlanList::get_plan_count(&plan_list);
    transition plan_index < hoist2 && hoist3 > 0 {
        true -> apply(snapshot_region, stage, collection, element_scan_plan, plan_list, scan_control, plan_index)
        _ -> (stage)
    }

    machine apply(
        snapshot_region: &|snapshot_region|::SnapshotRegion,
        stage: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        plan_list: &|element_scan_plan|::TypePlanList,
        scan_control: &mut |scan_control|::ScanControl,
        plan_index: u64
    ) -> |snapshot_region_filter_collection|::SnapshotRegionFilterCollection
    {
        let plan: |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan = |element_scan_plan|::TypePlanList::get_plan(&plan_list, plan_index);
        let empty_dtr: |data_type_ref|::DataTypeRef = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_data_type_ref(&collection);
        let empty_ma: |memory_alignment|::MemoryAlignment = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_memory_alignment(&collection);
        let empty_rv: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_result_value_size_in_bytes(&collection);
        let empty_collection: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::empty(
            empty_dtr, empty_ma, empty_rv);
        let next_stage: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = ElementScanChainDispatcher::apply_plan(
            snapshot_region, &stage, collection, &plan, element_scan_plan, scan_control, 0, empty_collection);
        transition { _ -> continue(
            snapshot_region, next_stage, collection, element_scan_plan, plan_list, scan_control, ((plan_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    machine continue(
        snapshot_region: &|snapshot_region|::SnapshotRegion,
        stage: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        plan_list: &|element_scan_plan|::TypePlanList,
        scan_control: &mut |scan_control|::ScanControl,
        next_plan_index: u64
    ) -> |snapshot_region_filter_collection|::SnapshotRegionFilterCollection
    {
        ElementScanChainDispatcher::run_chain(
            snapshot_region, stage, collection, element_scan_plan, plan_list, scan_control, next_plan_index)
    }
}

// One plan over every staged filter — the flat_map body. A filter surviving
// the runner contributes its emitted filters to the next stage.
public machine ElementScanChainDispatcher::apply_plan(
    snapshot_region: &|snapshot_region|::SnapshotRegion,
    stage: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
    collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
    plan: &|snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan,
    element_scan_plan: &|element_scan_plan|::ElementScanPlan,
    scan_control: &mut |scan_control|::ScanControl,
    filter_index: u64,
    next_stage: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection
) -> |snapshot_region_filter_collection|::SnapshotRegionFilterCollection
crashes Abort
{
    let hoist4: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter_count(&stage);
    transition filter_index < hoist4 {
        true -> scan(snapshot_region, stage, collection, plan, element_scan_plan, scan_control, filter_index, next_stage)
        _ -> (next_stage)
    }

    machine scan(
        snapshot_region: &|snapshot_region|::SnapshotRegion,
        stage: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        plan: &|snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        filter_index: u64,
        next_stage: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection
    ) -> |snapshot_region_filter_collection|::SnapshotRegionFilterCollection
    {
        let filter: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter(&stage, filter_index);
        let dtr: |data_type_ref|::DataTypeRef = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_data_type_ref(&collection);
        // Upstream `process_constraint`: the filter-rule registry remaps a
        // scratch copy of the plan per (filter, constraint) — RuleMapScanType's
        // validity gate (Relative/Delta need previous values) and scanner-type
        // pick ride runtime inputs the build-time plan cannot see.
        let mut scan_plan: |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::clone(plan);
        let compare_type: |scan_compare_type|::ScanCompareType = |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_scan_compare_type(&plan);
        let has_current: bool = |snapshot_region|::SnapshotRegion::has_current_values(&snapshot_region);
        let has_previous: bool = |snapshot_region|::SnapshotRegion::has_previous_values(&snapshot_region);
        let filter_size: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_region_size(&filter);
        let data_type_size: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_result_value_size_in_bytes(&collection);
        let is_floating_point: bool = |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_is_floating_point(&plan);
        let prefer_scanner: bool = |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_prefer_type_scanner(&plan);
        let alignment: |memory_alignment|::MemoryAlignment = |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_memory_alignment(&plan);
        let alignment_size: u64 = |memory_alignment|::MemoryAlignment::get_size_in_bytes(&alignment);
        let periodicity: u64 = |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_periodicity(&plan);
        let has_mask: bool = |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_has_mask(&plan);
        |element_scan_rule_registry|::ElementScanRuleRegistry::apply_filter_rules(
            compare_type,
            has_current,
            has_previous,
            filter_size,
            data_type_size,
            is_floating_point,
            prefer_scanner,
            alignment_size,
            periodicity,
            has_mask,
            &mut scan_plan);
        let emitted: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = |element_scan_runner|::ElementScanRunner::run_region(
            snapshot_region, &filter, &scan_plan, &dtr);
        // Upstream `dispatch_scan_for_snapshot_filter`: with the debug flag
        // set, a scalar-iterative reference scan validates the specialized
        // scanner's output for this (filter, constraint) pair.
        ElementScanChainDispatcher::perform_debug_scan(
            snapshot_region, &filter, &scan_plan, element_scan_plan, &dtr,
            &emitted, scan_control);
        let merged: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = ElementScanChainDispatcher::append_filters(
            next_stage, &emitted, 0);
        transition { _ -> apply_plan(
            snapshot_region, stage, collection, plan, element_scan_plan, scan_control,
            ((filter_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, merged) }
    }
}

// Upstream `perform_debug_scan`: re-run the region through the scalar
// iterative scanner on the SAME (rule-mapped) plan and compare — the way
// complex scanner implementations get unit-tested on real-world data.
// Each disagreement is one upstream `log::error!`; the port counts them on
// ScanControl (the owned-model carrier — the engine has no log sink).
// upstream gate order: debug flag at the call site, ByteArray plans exempt
// inside the function.
public machine ElementScanChainDispatcher::perform_debug_scan(
    snapshot_region: &|snapshot_region|::SnapshotRegion,
    snapshot_region_filter: &|snapshot_region_filter|::SnapshotRegionFilter,
    plan: &|snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan,
    element_scan_plan: &|element_scan_plan|::ElementScanPlan,
    data_type_ref: &|data_type_ref|::DataTypeRef,
    comparison: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
    scan_control: &mut |scan_control|::ScanControl
)
crashes Abort
{
    let hoist5: bool = |element_scan_plan|::ElementScanPlan::get_debug_perform_validation_scan(&element_scan_plan);
    transition hoist5 {
        true -> kind_gate(snapshot_region, snapshot_region_filter, plan, data_type_ref, comparison, scan_control)
        false -> done()
        _ -> done()
    }

    machine kind_gate(
        snapshot_region: &|snapshot_region|::SnapshotRegion,
        snapshot_region_filter: &|snapshot_region_filter|::SnapshotRegionFilter,
        plan: &|snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan,
        data_type_ref: &|data_type_ref|::DataTypeRef,
        comparison: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        scan_control: &mut |scan_control|::ScanControl
    ) {
        let hoist6: |planned_scan_type|::PlannedScanType = |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_planned_scan_type(&plan);
        transition hoist6 {
            |planned_scan_type|::PlannedScanType::ByteArray { scan_type } -> done()
            _ -> reference(snapshot_region, snapshot_region_filter, plan, data_type_ref, comparison, scan_control)
        }
    }

    machine reference(
        snapshot_region: &|snapshot_region|::SnapshotRegion,
        snapshot_region_filter: &|snapshot_region_filter|::SnapshotRegionFilter,
        plan: &|snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan,
        data_type_ref: &|data_type_ref|::DataTypeRef,
        comparison: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        scan_control: &mut |scan_control|::ScanControl
    ) {
        // Upstream hands the same plan to ScannerScalarIterative — the
        // planned scan type is a dispatch field, not scanner input — so a
        // scratch clone forces the scalar pick here.
        let mut reference_plan: |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::clone(plan);
        |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::set_planned_scan_type(&mut reference_plan, |planned_scan_type|::PlannedScanType::Scalar {
            scan_type: |planned_scan_type_scalar|::PlannedScanTypeScalar::ScalarIterative });
        let reference_collection: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = |element_scan_runner|::ElementScanRunner::run_region(
            snapshot_region, snapshot_region_filter, &reference_plan, data_type_ref);
        let reference_count: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter_count(&reference_collection);
        let comparison_count: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter_count(&comparison);
        transition reference_count != comparison_count {
            true -> mismatch_count(comparison, &reference_collection, scan_control)
            false -> compare_each(comparison, &reference_collection, scan_control, 0)
            _ -> compare_each(comparison, &reference_collection, scan_control, 0)
        }
    }

    // Upstream's length-mismatch `log::error!` — the index loop still runs
    // over the shorter count (cmp::min), so both checks stay.
    machine mismatch_count(
        comparison: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        reference: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        scan_control: &mut |scan_control|::ScanControl
    ) {
        |scan_control|::ScanControl::note_debug_mismatch(&mut scan_control);
        transition { _ -> compare_each(comparison, reference, scan_control, 0) }
    }

    machine compare_each(
        comparison: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        reference: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        scan_control: &mut |scan_control|::ScanControl,
        position: u64
    ) {
        let comparison_count: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter_count(&comparison);
        let reference_count: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter_count(&reference);
        transition position < comparison_count && position < reference_count {
            true -> compare_one(comparison, reference, scan_control, position)
            false -> done()
        }
    }

    // Upstream's per-index `debug_filter != filter` — SnapshotRegionFilter
    // equality is (base_address, region_size); a mismatch logs once and
    // breaks.
    machine compare_one(
        comparison: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        reference: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        scan_control: &mut |scan_control|::ScanControl,
        position: u64
    ) {
        let expected: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter(&reference, position);
        let found: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter(&comparison, position);
        let expected_base: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_base_address(&expected);
        let expected_size: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_region_size(&expected);
        let found_base: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_base_address(&found);
        let found_size: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_region_size(&found);
        transition expected_base == found_base && expected_size == found_size {
            true -> compare_each(
                comparison, reference, scan_control,
                ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> mismatch_index(scan_control)
            _ -> mismatch_index(scan_control)
        }
    }

    machine mismatch_index(
        scan_control: &mut |scan_control|::ScanControl
    ) {
        |scan_control|::ScanControl::note_debug_mismatch(&mut scan_control);
        transition { _ -> done() }
    }

    machine done() {
    }
}

// Append every filter of `source` into `dest` — upstream's collect-after-
// flat_map flattening.
public machine ElementScanChainDispatcher::append_filters(
    dest: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
    source: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
    position: u64
) -> |snapshot_region_filter_collection|::SnapshotRegionFilterCollection {
    let hoist7: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter_count(&source);
    transition position < hoist7 {
        true -> push(dest, source, position)
        _ -> (dest)
    }

    machine push(
        dest: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        source: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        position: u64
    ) -> |snapshot_region_filter_collection|::SnapshotRegionFilterCollection {
        let filter: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter(&source, position);
        let mut carried: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = dest;
        let pushed: bool = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::push_filter(&mut carried, &filter);
        transition { _ -> append_filters(carried, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}
