use {squalr_engine_api}/src/registries/freeze_list/freeze_list_registry.omg;
use {squalr_engine_api}/src/structures/memory/normalized_module.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_enriched.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_valued.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of the shared per-result enrichment block inside upstream's
// query/list/refresh scan-results executors (each executor inlines the same
// ~40 lines — the one shared helper upstream factors is
// `resolve_module_address_display`). Given a stored `ScanResultValued`:
//   1. `memory_query.address_to_module(address, &modules)` — first module
//      whose normalized region contains the address wins; module_name comes
//      back with `module_offset = address - base_address`. Unresolved keeps
//      upstream's defaults (empty name, offset = address,
//      ModuleAddressDisplay::ModuleRelative).
//   2. `resolve_module_address_display` — upstream re-finds a module by
//      case-insensitive name + containment; the containing module already
//      satisfies that lookup, so its own display field answers directly
//      (folded, equivalent).
//   3. `freeze_list_registry.is_address_frozen(&Pointer::new(module_offset,
//      [], module_name))` — the registry's keyed machine takes the pair
//      directly, matching upstream's pointer key semantics.
public data ScanResultEnricher {}

public machine ScanResultEnricher::enrich(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    valued_result: |scan_result_valued|::ScanResultValued
) -> |scan_result_enriched|::ScanResultEnriched {
    let address: u64 = |scan_result_valued|::ScanResultValued::get_address(&valued_result);
    // Two overlapping shared borrows (upstream's `modules` + registry reads
    // are both shared); `engine_privileged_state` itself does not cross into
    // the loop states because a derived borrow is live.
    let modules: &[|normalized_module|::NormalizedModule] = |engine_privileged_state|::EnginePrivilegedState::get_supplied_modules(&engine_privileged_state);
    let registry: &|freeze_list_registry|::FreezeListRegistry = |engine_privileged_state|::EnginePrivilegedState::get_freeze_list_registry(&engine_privileged_state);
    transition { _ -> resolve(modules, registry, valued_result, address, 0) }

    machine resolve(
        modules: &[|normalized_module|::NormalizedModule],
        registry: &|freeze_list_registry|::FreezeListRegistry,
        valued_result: |scan_result_valued|::ScanResultValued,
        address: u64,
        position: u64
    ) -> |scan_result_enriched|::ScanResultEnriched {
        transition position < modules.len {
            true -> probe(modules, registry, valued_result, address, position)
            false -> unresolved(modules, registry, valued_result, address)
            _ -> unresolved(modules, registry, valued_result, address)
        }
    }

    machine probe(
        modules: &[|normalized_module|::NormalizedModule],
        registry: &|freeze_list_registry|::FreezeListRegistry,
        valued_result: |scan_result_valued|::ScanResultValued,
        address: u64,
        position: u64
    ) -> |scan_result_enriched|::ScanResultEnriched {
        let hoist1: bool = |normalized_module|::NormalizedModule::contains_address(modules[position], address);
        transition hoist1 {
            true -> found(modules, registry, valued_result, address, position)
            false -> resolve(modules, registry, valued_result, address, position + 1)
            _ -> resolve(modules, registry, valued_result, address, position + 1)
        }
    }

    machine found(
        modules: &[|normalized_module|::NormalizedModule],
        registry: &|freeze_list_registry|::FreezeListRegistry,
        valued_result: |scan_result_valued|::ScanResultValued,
        address: u64,
        position: u64
    ) -> |scan_result_enriched|::ScanResultEnriched {
        let module_name: &[u8] = |normalized_module|::NormalizedModule::get_module_name(modules[position]);
        // Reached only under the probe state's contains_address guard, so
        // base <= address always holds — the Saturating domain is the
        // codebase's domain opt-in for that proof gap (never clamps).
        let module_offset: u64 =
            ((address as u64 in Saturating)
                - (|normalized_module|::NormalizedModule::get_base_address(&modules[position]) as u64 in Saturating)) as u64;
        let module_address_display: |normalized_module|::ModuleAddressDisplay =
            |normalized_module|::NormalizedModule::get_module_address_display(&modules[position]);
        let is_frozen: bool = |freeze_list_registry|::FreezeListRegistry::is_address_frozen(&registry, module_offset, module_name);
        |scan_result_enriched|::ScanResultEnriched::new(valued_result,
            module_name,
            module_offset,
            module_address_display,
            is_frozen)
    }

    machine unresolved(
        modules: &[|normalized_module|::NormalizedModule],
        registry: &|freeze_list_registry|::FreezeListRegistry,
        valued_result: |scan_result_valued|::ScanResultValued,
        address: u64
    ) -> |scan_result_enriched|::ScanResultEnriched {
        // Upstream's defaults for a result with no containing module: empty
        // module name, module_offset = the absolute address, ModuleRelative
        // display; the freeze probe still runs on that (offset, "") key.
        let empty_name: &[u8] = ("");
        let is_frozen: bool = |freeze_list_registry|::FreezeListRegistry::is_address_frozen(&registry, address, empty_name);
        |scan_result_enriched|::ScanResultEnriched::new(valued_result,
            empty_name,
            address,
            |normalized_module|::ModuleAddressDisplay::ModuleRelative,
            is_frozen)
    }
}
