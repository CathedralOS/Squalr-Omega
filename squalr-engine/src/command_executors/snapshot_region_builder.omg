module src::command_executors::snapshot_region_builder;

use squalr_engine_api::src::structures::memory::normalized_region::NormalizedRegion;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use squalr_engine_api::src::structures::snapshots::snapshot_region::SnapshotRegion;
use squalr_engine_session::src::os::supplied_memory_source::SuppliedMemorySource;

// Port of snapshot/snapshot_region_builder.rs `merge_memory_regions_into_snapshot_regions`
// — walk page bounds in order; a page adjacent to the open region
// (`current.end == next.base`) merges in and records the boundary, otherwise
// the region is closed and a new one starts.
pub data SnapshotRegionBuilder {
    regions: [SnapshotRegion; 1];
    region_count: u64;
}

pub machine SnapshotRegionBuilder::new() -> SnapshotRegionBuilder {
    SnapshotRegionBuilder { region_count: 0 }
}

pub machine SnapshotRegionBuilder::get_region_count(snapshot_region_builder: &SnapshotRegionBuilder) -> u64 {
    snapshot_region_builder.region_count
}

// Upstream's `add_memory_region`: merge-or-push.
pub machine SnapshotRegionBuilder::add_memory_region(snapshot_region_builder: &mut SnapshotRegionBuilder, region: &NormalizedRegion) -> bool {
    transition snapshot_region_builder.region_count > 0 {
        true -> maybe_merge(snapshot_region_builder, region)
        false -> push_new(snapshot_region_builder, region)
    }
    state maybe_merge(snapshot_region_builder: &mut SnapshotRegionBuilder, region: &NormalizedRegion) -> bool {
        let last_index: u64 = ((snapshot_region_builder.region_count as u64 in Wrapping) - 1) as u64;
        transition last_index < 1 {
            true -> check_adjacent(snapshot_region_builder, region, last_index)
            false -> push_new(snapshot_region_builder, region)
        }
    }
    state check_adjacent(snapshot_region_builder: &mut SnapshotRegionBuilder, region: &NormalizedRegion, last_index: u64) -> bool
    requires 0 <= last_index && last_index < 1;
    {
        let open_end: u64 = SnapshotRegion::get_end_address(&snapshot_region_builder.regions[last_index]);
        transition NormalizedRegion::get_base_address(region) == open_end {
            true -> merge(snapshot_region_builder, region, last_index)
            false -> push_new(snapshot_region_builder, region)
        }
    }
    state merge(snapshot_region_builder: &mut SnapshotRegionBuilder, region: &NormalizedRegion, last_index: u64) -> bool
    requires 0 <= last_index && last_index < 1;
    {
        let merged_size: u64 = ((SnapshotRegion::get_region_size(&snapshot_region_builder.regions[last_index]) as u64 in Saturating)
            + (NormalizedRegion::get_region_size(region) as u64 in Saturating)) as u64;
        SnapshotRegion::set_region_size(&mut snapshot_region_builder.regions[last_index], merged_size);
        let region_base: u64 = NormalizedRegion::get_base_address(region);
        let boundary: bool = SnapshotRegion::push_page_boundary(&mut snapshot_region_builder.regions[last_index], region_base);
        boundary
    }
    state push_new(snapshot_region_builder: &mut SnapshotRegionBuilder, region: &NormalizedRegion) -> bool {
        transition snapshot_region_builder.region_count < 1 {
            true -> store(snapshot_region_builder, region)
            false -> (false)
        }
    }
    state store(snapshot_region_builder: &mut SnapshotRegionBuilder, region: &NormalizedRegion) -> bool {
        let fresh_base: u64 = NormalizedRegion::get_base_address(region);
        let fresh_size: u64 = NormalizedRegion::get_region_size(region);
        let fresh: SnapshotRegion = SnapshotRegion::new(fresh_base, fresh_size);
        SnapshotRegion::clone_from(&mut snapshot_region_builder.regions[snapshot_region_builder.region_count], &fresh);
        snapshot_region_builder.region_count = ((snapshot_region_builder.region_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        true
    }
}

pub machine SnapshotRegionBuilder::get_region(snapshot_region_builder: &SnapshotRegionBuilder, position: u64) -> SnapshotRegion {
    transition position < snapshot_region_builder.region_count && position < 1 {
        true -> found(snapshot_region_builder, position)
        false -> (SnapshotRegion::new(0, 0))
    }
    state found(snapshot_region_builder: &SnapshotRegionBuilder, position: u64) -> SnapshotRegion
    requires 0 <= position && position < 1;
    {
        SnapshotRegion::clone(&snapshot_region_builder.regions[position])
    }
}

// The scan-new walk over the supplied page-bound stream — fills the builder
// one page at a time, then `fill_from_builder` empties it into the snapshot.
// Both live in-engine because `&mut` calls on locals can't cross packages.
pub machine SnapshotRegionBuilder::fill_from_supplied_source(
    builder: &mut SnapshotRegionBuilder,
    source: &SuppliedMemorySource
) {
    transition { _ -> each(builder, source, 0) }
    state each(
        builder: &mut SnapshotRegionBuilder,
        source: &SuppliedMemorySource,
        position: u64
    ) {
        transition position < SuppliedMemorySource::get_region_count(source) {
            true -> page(builder, source, position)
            false -> done()
        }
    }
    state page(
        builder: &mut SnapshotRegionBuilder,
        source: &SuppliedMemorySource,
        position: u64
    ) {
        let bounds: NormalizedRegion = SuppliedMemorySource::get_page_bounds(source, position);
        let added: bool = SnapshotRegionBuilder::add_memory_region(builder, &bounds);
        transition { _ -> each(builder, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state done() {
    }
}

// Installs each built region into the snapshot in order — the bounded
// equivalent of upstream's `set_snapshot_regions(Vec)`.
pub machine SnapshotRegionBuilder::fill_snapshot(
    builder: &SnapshotRegionBuilder,
    snapshot: &mut Snapshot
) {
    transition { _ -> each(builder, snapshot, 0) }
    state each(
        builder: &SnapshotRegionBuilder,
        snapshot: &mut Snapshot,
        position: u64
    ) {
        transition position < SnapshotRegionBuilder::get_region_count(builder) {
            true -> store(builder, snapshot, position)
            false -> done()
        }
    }
    state store(
        builder: &SnapshotRegionBuilder,
        snapshot: &mut Snapshot,
        position: u64
    ) {
        let region: SnapshotRegion = SnapshotRegionBuilder::get_region(builder, position);
        let pushed: bool = Snapshot::push_region(snapshot, &region);
        transition { _ -> each(builder, snapshot, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state done() {
    }
}
