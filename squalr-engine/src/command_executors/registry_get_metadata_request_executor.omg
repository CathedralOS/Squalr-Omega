module src::command_executors::registry_get_metadata_request_executor;

use squalr_engine_api::src::commands::registry::get_metadata::registry_get_metadata_request::RegistryGetMetadataRequest;
use squalr_engine_api::src::commands::registry::get_metadata::registry_get_metadata_response::RegistryGetMetadataResponse;
use squalr_engine_api::src::registries::symbols::privileged_registry_catalog::PrivilegedRegistryCatalog;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/registry/get_metadata/registry_get_metadata_request_executor.rs —
// the response is the session's privileged registry catalog (sorted
// descriptor tables stamped with the live generation). Upstream's
// plugin-enable filter is a no-op here — see the deviation note on
// EnginePrivilegedState::get_privileged_registry_catalog.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data RegistryGetMetadataRequestExecutor {}

pub machine RegistryGetMetadataRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    registry_get_metadata_request: &RegistryGetMetadataRequest
) -> RegistryGetMetadataResponse {
    let catalog: PrivilegedRegistryCatalog = EnginePrivilegedState::get_privileged_registry_catalog(engine_privileged_state);
    (RegistryGetMetadataResponse::new(catalog))
}
