use {squalr_engine_api}/src/commands/registry/get_metadata/registry_get_metadata_request.omg;
use {squalr_engine_api}/src/commands/registry/get_metadata/registry_get_metadata_response.omg;
use {squalr_engine_api}/src/registries/symbols/privileged_registry_catalog.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/registry/get_metadata/registry_get_metadata_request_executor.rs —
// the response is the session's privileged registry catalog (sorted
// descriptor tables stamped with the live generation). Upstream's
// plugin-enable filter is a no-op here — see the deviation note on
// EnginePrivilegedState::get_privileged_registry_catalog.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data RegistryGetMetadataRequestExecutor {}

public machine RegistryGetMetadataRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    registry_get_metadata_request: &|registry_get_metadata_request|::RegistryGetMetadataRequest
) -> |registry_get_metadata_response|::RegistryGetMetadataResponse {
    let catalog: |privileged_registry_catalog|::PrivilegedRegistryCatalog = |engine_privileged_state|::EnginePrivilegedState::get_privileged_registry_catalog(&engine_privileged_state);
    (|registry_get_metadata_response|::RegistryGetMetadataResponse::new(catalog))
}
