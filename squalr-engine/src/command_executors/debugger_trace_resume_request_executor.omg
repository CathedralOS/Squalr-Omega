module src::command_executors::debugger_trace_resume_request_executor;

use squalr_engine_api::src::commands::debugger::trace_resume::debugger_trace_resume_request::DebuggerTraceResumeRequest;
use squalr_engine_api::src::commands::debugger::trace_resume::debugger_trace_resume_response::DebuggerTraceResumeResponse;
use squalr_engine_api::src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use squalr_engine_api::src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;
use squalr_engine_session::src::debugger::debugger_service::DebuggerTraceOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/debugger/mod.rs::DebuggerTraceResumeRequest —
// service.debugger_resume_trace_session(trace_session_id) -> Some(session)+records / Err.
pub data DebuggerTraceResumeRequestExecutor {}

pub machine DebuggerTraceResumeRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_trace_resume_request: &DebuggerTraceResumeRequest
) -> DebuggerTraceResumeResponse {
    let trace_session_id: &[u8] = DebuggerTraceResumeRequest::get_trace_session_id(debugger_trace_resume_request);
    let outcome: DebuggerTraceOutcome = EnginePrivilegedState::debugger_resume_trace_session(engine_privileged_state, 
        trace_session_id);
    transition outcome.succeeded && outcome.has_trace_session {
        true -> fill(outcome)
        _ -> failed(outcome)
    }

    state fill(outcome: DebuggerTraceOutcome) -> DebuggerTraceResumeResponse {
        let mut response: DebuggerTraceResumeResponse = DebuggerTraceResumeResponse::new();
        DebuggerTraceResumeResponse::set_trace_session(&mut response, DebuggerTraceSessionDescriptor::clone(&outcome.trace_session));
        transition { _ -> records(response, outcome, 0) }
    }

    state records(response: DebuggerTraceResumeResponse, outcome: DebuggerTraceOutcome, position: u64) -> DebuggerTraceResumeResponse {
        transition position < outcome.instruction_record_count && position < 16 {
            true -> record(response, outcome, position)
            _ -> (response)
        }
    }

    state record(mut response: DebuggerTraceResumeResponse, outcome: DebuggerTraceOutcome, position: u64) -> DebuggerTraceResumeResponse
        requires position < 16
    {
        _ = DebuggerTraceResumeResponse::add_instruction_record(&mut response, &outcome.instruction_records[position]);
        transition { _ -> records(response, outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state failed(outcome: DebuggerTraceOutcome) -> DebuggerTraceResumeResponse {
        let mut response: DebuggerTraceResumeResponse = DebuggerTraceResumeResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        DebuggerCommandStatus::set_message(&mut status, DebuggerTraceOutcome::get_error_message(&outcome));
        DebuggerTraceResumeResponse::set_status(&mut response, status);
        (response)
    }
}
