module src::command_executors::memory_query_request_executor;

use squalr_engine_api::src::commands::memory::query::memory_query_request::MemoryQueryRequest;
use squalr_engine_api::src::commands::memory::query::memory_query_response::MemoryQueryResponse;
use squalr_engine_api::src::structures::memory::normalized_module::NormalizedModule;
use squalr_engine_api::src::structures::memory::normalized_region::NormalizedRegion;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::os::supplied_memory_source::SuppliedMemorySource;

// Port of command_executors/memory/query/memory_query_request_executor.rs:
// an opened process enumerates the target's virtual pages and modules;
// upstream sorts both (pages ascending, modules by base address) before
// answering. No process answers the upstream default — an empty, failed
// response.
//
// Named deviations:
// - Upstream's `PageRetrievalMode` maps onto the session enum and the OS
//   query selects page subsets by mode; the supplied memory source's page
//   bounds enumerate its supplied regions in order — retrieval-mode
//   filtering is a supplied-source decision, so the mode is carried on the
//   request but not interpreted here.
// - Upstream sorts pages and modules before answering; the port emits the
//   supplied order (the adapter seeds regions/modules in order already).
pub data MemoryQueryRequestExecutor {}

pub machine MemoryQueryRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    memory_query_request: &MemoryQueryRequest
) -> MemoryQueryResponse
crashes Abort
{
    transition EnginePrivilegedState::has_opened_process(engine_privileged_state) {
        true -> query(engine_privileged_state)
        false -> (MemoryQueryResponse::new(false))
        _ -> (MemoryQueryResponse::new(false))
    }

    state query(
        engine_privileged_state: &mut EnginePrivilegedState
    ) -> MemoryQueryResponse {
        let mut response: MemoryQueryResponse = MemoryQueryResponse::new(true);
        let empty_module_name: [u8; 1] = [0];
        let mut supplied_modules: [NormalizedModule; 8] = [
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            NormalizedModule::new(&empty_module_name[0..0], 0, 0)
        ];
        let supplied_module_count: u64 = engine_privileged_state
            .copy_supplied_modules(&mut supplied_modules);
        let source: &SuppliedMemorySource =
            EnginePrivilegedState::get_supplied_memory_source(engine_privileged_state);
        let region_count: u64 = SuppliedMemorySource::get_region_count(source);
        transition { _ -> pages(
            engine_privileged_state,
            &mut response,
            &supplied_modules,
            supplied_module_count,
            region_count,
            0) }
    }

    state pages(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: &mut MemoryQueryResponse,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        region_count: u64,
        position: u64
    ) -> MemoryQueryResponse
    requires 0 <= position && position <= region_count;
    {
        transition position < region_count {
            true -> push_page(engine_privileged_state, response, supplied_modules, module_count, region_count, position)
            false -> modules(engine_privileged_state, response, supplied_modules, module_count, 0)
            _ -> modules(engine_privileged_state, response, supplied_modules, module_count, 0)
        }
    }
    state push_page(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: &mut MemoryQueryResponse,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        region_count: u64,
        position: u64
    ) -> MemoryQueryResponse
    requires 0 <= position && position < region_count;
    {
        let source: &SuppliedMemorySource =
            EnginePrivilegedState::get_supplied_memory_source(engine_privileged_state);
        let page: NormalizedRegion = SuppliedMemorySource::get_page_bounds(source, position);
        _ = MemoryQueryResponse::push_virtual_page(response, &page);
        transition { _ -> pages(engine_privileged_state, response, supplied_modules, module_count, region_count, position + 1) }
    }
    state modules(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: &mut MemoryQueryResponse,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64
    ) -> MemoryQueryResponse
    requires 0 <= position && position <= module_count;
    {
        transition position < module_count && position < 8 {
            true -> push_module(engine_privileged_state, response, supplied_modules, module_count, position)
            false -> done(response)
            _ -> done(response)
        }
    }
    state push_module(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: &mut MemoryQueryResponse,
        supplied_modules: &[NormalizedModule; 8],
        module_count: u64,
        position: u64
    ) -> MemoryQueryResponse
    requires 0 <= position && position < module_count;
    requires 0 <= position && position < 8;
    {
        _ = MemoryQueryResponse::push_module(response, &supplied_modules[position]);
        transition { _ -> modules(engine_privileged_state, response, supplied_modules, module_count, position + 1) }
    }
    state done(
        response: &mut MemoryQueryResponse
    ) -> MemoryQueryResponse {
        transition { _ -> (MemoryQueryResponse::clone(response)) }
    }
}
