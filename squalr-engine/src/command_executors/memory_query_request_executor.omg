use {squalr_engine_api}/src/commands/memory/query/memory_query_request.omg;
use {squalr_engine_api}/src/commands/memory/query/memory_query_response.omg;
use {squalr_engine_api}/src/structures/memory/normalized_module.omg;
use {squalr_engine_api}/src/structures/memory/normalized_region.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/os/supplied_memory_source.omg;

// Port of command_executors/memory/query/memory_query_request_executor.rs:
// an opened process enumerates the target's virtual pages and modules;
// upstream sorts both (pages ascending, modules by base address) before
// answering. No process answers the upstream default — an empty, failed
// response.
//
// Named deviations:
// - Upstream's `PageRetrievalMode` maps onto the session enum and the OS
//   query selects page subsets by mode; the supplied memory source's page
//   bounds enumerate its supplied regions in order — retrieval-mode
//   filtering is a supplied-source decision, so the mode is carried on the
//   request but not interpreted here.
// - Upstream sorts pages and modules before answering; the port emits the
//   supplied order (the adapter seeds regions/modules in order already).
public data MemoryQueryRequestExecutor {}

public machine MemoryQueryRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    memory_query_request: &|memory_query_request|::MemoryQueryRequest
) -> |memory_query_response|::MemoryQueryResponse
crashes Abort
{
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> query(engine_privileged_state)
        false -> (|memory_query_response|::MemoryQueryResponse::new(false))
        _ -> (|memory_query_response|::MemoryQueryResponse::new(false))
    }

    machine query(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
    ) -> |memory_query_response|::MemoryQueryResponse {
        let mut response: |memory_query_response|::MemoryQueryResponse = |memory_query_response|::MemoryQueryResponse::new(true);
        let empty_module_name: [u8; 1] = [0];
        let mut supplied_modules: [|normalized_module|::NormalizedModule; 8] = [
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0)
        ];
        let supplied_module_count: u64 = |engine_privileged_state|::EnginePrivilegedState::copy_supplied_modules(&mut engine_privileged_state, &mut supplied_modules);
        let source: &|supplied_memory_source|::SuppliedMemorySource =
            |engine_privileged_state|::EnginePrivilegedState::get_supplied_memory_source(&engine_privileged_state);
        let region_count: u64 = |supplied_memory_source|::SuppliedMemorySource::get_region_count(source);
        transition { _ -> pages(
            engine_privileged_state,
            &mut response,
            &supplied_modules,
            supplied_module_count,
            region_count,
            0) }
    }

    machine pages(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        response: &mut |memory_query_response|::MemoryQueryResponse,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        region_count: u64,
        position: u64
    ) -> |memory_query_response|::MemoryQueryResponse
    requires 0 <= position && position <= region_count;
    {
        transition position < region_count {
            true -> push_page(engine_privileged_state, response, supplied_modules, module_count, region_count, position)
            false -> modules(engine_privileged_state, response, supplied_modules, module_count, 0)
            _ -> modules(engine_privileged_state, response, supplied_modules, module_count, 0)
        }
    }
    machine push_page(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        response: &mut |memory_query_response|::MemoryQueryResponse,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        region_count: u64,
        position: u64
    ) -> |memory_query_response|::MemoryQueryResponse
    requires 0 <= position && position < region_count;
    {
        let source: &|supplied_memory_source|::SuppliedMemorySource =
            |engine_privileged_state|::EnginePrivilegedState::get_supplied_memory_source(&engine_privileged_state);
        let page: |normalized_region|::NormalizedRegion = |supplied_memory_source|::SuppliedMemorySource::get_page_bounds(&source, position);
        _ = |memory_query_response|::MemoryQueryResponse::push_virtual_page(&mut response, &page);
        transition { _ -> pages(engine_privileged_state, response, supplied_modules, module_count, region_count, position + 1) }
    }
    machine modules(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        response: &mut |memory_query_response|::MemoryQueryResponse,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        position: u64
    ) -> |memory_query_response|::MemoryQueryResponse
    requires 0 <= position && position <= module_count;
    {
        transition position < module_count && position < 8 {
            true -> push_module(engine_privileged_state, response, supplied_modules, module_count, position)
            false -> done(response)
            _ -> done(response)
        }
    }
    machine push_module(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        response: &mut |memory_query_response|::MemoryQueryResponse,
        supplied_modules: &[|normalized_module|::NormalizedModule; 8],
        module_count: u64,
        position: u64
    ) -> |memory_query_response|::MemoryQueryResponse
    requires 0 <= position && position < module_count;
    requires 0 <= position && position < 8;
    {
        _ = |memory_query_response|::MemoryQueryResponse::push_module(&mut response, &supplied_modules[position]);
        transition { _ -> modules(engine_privileged_state, response, supplied_modules, module_count, position + 1) }
    }
    machine done(
        response: &mut |memory_query_response|::MemoryQueryResponse
    ) -> |memory_query_response|::MemoryQueryResponse {
        transition { _ -> (|memory_query_response|::MemoryQueryResponse::clone(response)) }
    }
}
