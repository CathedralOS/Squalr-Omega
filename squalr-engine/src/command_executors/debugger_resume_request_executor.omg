module src::command_executors::debugger_resume_request_executor;

use squalr_engine_api::src::commands::debugger::resume::debugger_resume_request::DebuggerResumeRequest;
use squalr_engine_api::src::commands::debugger::resume::debugger_resume_response::DebuggerResumeResponse;
use squalr_engine_api::src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use squalr_engine_session::src::debugger::debugger_service::DebuggerOperationOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/debugger/mod.rs::DebuggerResumeRequest — no
// opened-process guard upstream; the service surfaces "No active debugger
// session." itself.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data DebuggerResumeRequestExecutor {}

pub machine DebuggerResumeRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_resume_request: &DebuggerResumeRequest
) -> DebuggerResumeResponse {
    let outcome: DebuggerOperationOutcome = EnginePrivilegedState::debugger_resume(engine_privileged_state);
    transition outcome.succeeded {
        true -> succeeded(outcome)
        _ -> failed(outcome)
    }

    state succeeded(outcome: DebuggerOperationOutcome) -> DebuggerResumeResponse {
        let mut response: DebuggerResumeResponse = DebuggerResumeResponse::new();
        DebuggerResumeResponse::set_session_state(&mut response, outcome.session_state);
        (response)
    }

    state failed(outcome: DebuggerOperationOutcome) -> DebuggerResumeResponse {
        let mut response: DebuggerResumeResponse = DebuggerResumeResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        DebuggerCommandStatus::set_message(&mut status, DebuggerOperationOutcome::get_error_message(&outcome));
        DebuggerResumeResponse::set_status(&mut response, status);
        (response)
    }
}
