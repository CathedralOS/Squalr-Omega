module src::command_executors::snapshot_value_collector;

use squalr_engine_api::src::structures::snapshots::element_window::ElementWindow;
use squalr_engine_api::src::structures::snapshots::snapshot_region::SnapshotRegion;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::os::supplied_memory_source::SuppliedMemorySource;

// Port of `SnapshotValueCollector::collect_values`: per region, rotate the
// current window into previous and install the freshly read window. The
// collected values live under `snapshot.collect_region_values` in the api
// package — `&mut`-receiver calls with borrowed arguments cannot cross the
// package boundary, so the per-region write goes through that entry.
// Empty receiver carrying the collector's machines — mirrors upstream's
// `impl` namespace.
pub data SnapshotValueCollector {}

pub machine SnapshotValueCollector::collect_all_regions(
    engine_privileged_state: &mut EnginePrivilegedState
) {
    transition { _ -> each(engine_privileged_state, 0) }
    state each(engine_privileged_state: &mut EnginePrivilegedState, position: u64) {
        let region_count: u64 = engine_privileged_state.borrow_snapshot().get_region_count();
        transition position < region_count {
            true -> region(engine_privileged_state, position)
            false -> done()
        }
    }
    state region(engine_privileged_state: &mut EnginePrivilegedState, position: u64) {
        let region: SnapshotRegion = engine_privileged_state.borrow_snapshot().get_region(position);
        let source: &SuppliedMemorySource = engine_privileged_state.get_supplied_memory_source();
        let region_base: u64 = region.get_base_address();
        let region_size: u64 = region.get_region_size();
        let window: ElementWindow = source.read_window(region_base, region_size);
        engine_privileged_state
            .borrow_snapshot_mut()
            .collect_region_values(position, window);
        transition { _ -> each(engine_privileged_state, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state done() {
    }
}
