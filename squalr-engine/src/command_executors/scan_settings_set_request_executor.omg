module src::command_executors::scan_settings_set_request_executor;

use squalr_engine_api::src::commands::settings::scan::set::scan_settings_set_request::ScanSettingsSetRequest;
use squalr_engine_api::src::commands::settings::scan::set::scan_settings_set_response::ScanSettingsSetResponse;
use squalr_engine_api::src::structures::settings::scan_settings::ScanSettings;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/settings/scan/set/scan_settings_set_request_executor.rs —
// upstream applies each present optional field to scan_settings_store.rs; the
// port applies them to the session-owned settings record (persistence is a
// deferred leg — see engine_privileged_state.omg). Each `if let Some` arm
// becomes a check/write state pair: Omega dispatches on `transition` guards,
// there is no statement-level `if`.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ScanSettingsSetRequestExecutor {}

pub machine ScanSettingsSetRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    request: &ScanSettingsSetRequest
) -> ScanSettingsSetResponse {
    transition request.has_page_retrieval_mode() {
        true -> wrote_page_retrieval_mode(engine_privileged_state, request)
        _ -> check1(engine_privileged_state, request)
    }

    state wrote_page_retrieval_mode(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        let mut settings: ScanSettings = engine_privileged_state.get_scan_settings();
        settings.set_page_retrieval_mode(request.get_page_retrieval_mode());
        engine_privileged_state.set_scan_settings(settings);
        transition { _ -> check1(engine_privileged_state, request) }
    }

    state check1(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        transition request.has_results_page_size() {
            true -> wrote_results_page_size(engine_privileged_state, request)
            _ -> check2(engine_privileged_state, request)
        }
    }

    state wrote_results_page_size(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        let mut settings: ScanSettings = engine_privileged_state.get_scan_settings();
        settings.set_results_page_size(request.get_results_page_size());
        engine_privileged_state.set_scan_settings(settings);
        transition { _ -> check2(engine_privileged_state, request) }
    }

    state check2(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        transition request.has_results_read_interval_ms() {
            true -> wrote_results_read_interval_ms(engine_privileged_state, request)
            _ -> check3(engine_privileged_state, request)
        }
    }

    state wrote_results_read_interval_ms(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        let mut settings: ScanSettings = engine_privileged_state.get_scan_settings();
        settings.set_results_read_interval_ms(request.get_results_read_interval_ms());
        engine_privileged_state.set_scan_settings(settings);
        transition { _ -> check3(engine_privileged_state, request) }
    }

    state check3(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        transition request.has_project_read_interval_ms() {
            true -> wrote_project_read_interval_ms(engine_privileged_state, request)
            _ -> check4(engine_privileged_state, request)
        }
    }

    state wrote_project_read_interval_ms(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        let mut settings: ScanSettings = engine_privileged_state.get_scan_settings();
        settings.set_project_read_interval_ms(request.get_project_read_interval_ms());
        engine_privileged_state.set_scan_settings(settings);
        transition { _ -> check4(engine_privileged_state, request) }
    }

    state check4(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        transition request.has_project_file_system_watch_enabled() {
            true -> wrote_project_file_system_watch_enabled(engine_privileged_state, request)
            _ -> check5(engine_privileged_state, request)
        }
    }

    state wrote_project_file_system_watch_enabled(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        let mut settings: ScanSettings = engine_privileged_state.get_scan_settings();
        settings.set_project_file_system_watch_enabled(request.get_project_file_system_watch_enabled());
        engine_privileged_state.set_scan_settings(settings);
        transition { _ -> check5(engine_privileged_state, request) }
    }

    state check5(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        transition request.has_freeze_interval_ms() {
            true -> wrote_freeze_interval_ms(engine_privileged_state, request)
            _ -> check6(engine_privileged_state, request)
        }
    }

    state wrote_freeze_interval_ms(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        let mut settings: ScanSettings = engine_privileged_state.get_scan_settings();
        settings.set_freeze_interval_ms(request.get_freeze_interval_ms());
        engine_privileged_state.set_scan_settings(settings);
        transition { _ -> check6(engine_privileged_state, request) }
    }

    state check6(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        transition request.has_memory_alignment() {
            true -> wrote_memory_alignment(engine_privileged_state, request)
            _ -> check7(engine_privileged_state, request)
        }
    }

    state wrote_memory_alignment(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        let mut settings: ScanSettings = engine_privileged_state.get_scan_settings();
        settings.set_memory_alignment(request.get_memory_alignment());
        engine_privileged_state.set_scan_settings(settings);
        transition { _ -> check7(engine_privileged_state, request) }
    }

    state check7(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        transition request.has_memory_read_mode() {
            true -> wrote_memory_read_mode(engine_privileged_state, request)
            _ -> check8(engine_privileged_state, request)
        }
    }

    state wrote_memory_read_mode(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        let mut settings: ScanSettings = engine_privileged_state.get_scan_settings();
        settings.set_memory_read_mode(request.get_memory_read_mode());
        engine_privileged_state.set_scan_settings(settings);
        transition { _ -> check8(engine_privileged_state, request) }
    }

    state check8(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        transition request.has_floating_point_tolerance() {
            true -> wrote_floating_point_tolerance(engine_privileged_state, request)
            _ -> check9(engine_privileged_state, request)
        }
    }

    state wrote_floating_point_tolerance(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        let mut settings: ScanSettings = engine_privileged_state.get_scan_settings();
        settings.set_floating_point_tolerance(request.get_floating_point_tolerance());
        engine_privileged_state.set_scan_settings(settings);
        transition { _ -> check9(engine_privileged_state, request) }
    }

    state check9(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        transition request.has_is_single_threaded_scan() {
            true -> wrote_is_single_threaded_scan(engine_privileged_state, request)
            _ -> check10(engine_privileged_state, request)
        }
    }

    state wrote_is_single_threaded_scan(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        let mut settings: ScanSettings = engine_privileged_state.get_scan_settings();
        settings.set_is_single_threaded_scan(request.get_is_single_threaded_scan());
        engine_privileged_state.set_scan_settings(settings);
        transition { _ -> check10(engine_privileged_state, request) }
    }

    state check10(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        transition request.has_debug_perform_validation_scan() {
            true -> wrote_debug_perform_validation_scan(engine_privileged_state, request)
            _ -> finish(engine_privileged_state)
        }
    }

    state wrote_debug_perform_validation_scan(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsSetResponse {
        let mut settings: ScanSettings = engine_privileged_state.get_scan_settings();
        settings.set_debug_perform_validation_scan(request.get_debug_perform_validation_scan());
        engine_privileged_state.set_scan_settings(settings);
        transition { _ -> finish(engine_privileged_state) }
    }

    state finish(
        engine_privileged_state: &mut EnginePrivilegedState
    ) -> ScanSettingsSetResponse {
        (ScanSettingsSetResponse::new())
    }
}
