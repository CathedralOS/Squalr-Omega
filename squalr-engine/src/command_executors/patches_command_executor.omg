module src::command_executors::patches_command_executor;

use squalr_engine_api::src::commands::patches::apply::patch_apply_request::PatchApplyRequest;
use squalr_engine_api::src::commands::patches::apply::patch_apply_response::PatchApplyResponse;
use squalr_engine_api::src::commands::patches::list::patch_list_request::PatchListRequest;
use squalr_engine_api::src::commands::patches::list::patch_list_response::PatchListResponse;
use squalr_engine_api::src::commands::patches::no_operation::patch_no_operation_request::PatchNoOperationRequest;
use squalr_engine_api::src::commands::patches::no_operation::patch_no_operation_response::PatchNoOperationResponse;
use squalr_engine_api::src::commands::patches::patches_command::PatchesCommand;
use squalr_engine_api::src::commands::patches::patches_response::PatchesResponse;
use squalr_engine_api::src::commands::patches::restore::patch_restore_request::PatchRestoreRequest;
use squalr_engine_api::src::commands::patches::restore::patch_restore_response::PatchRestoreResponse;
use squalr_engine_api::src::commands::patches::restore_address::patch_restore_address_request::PatchRestoreAddressRequest;
use squalr_engine_api::src::commands::patches::restore_address::patch_restore_address_response::PatchRestoreAddressResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::patch_apply_request_executor::PatchApplyRequestExecutor;
use src::command_executors::patch_list_request_executor::PatchListRequestExecutor;
use src::command_executors::patch_no_operation_request_executor::PatchNoOperationRequestExecutor;
use src::command_executors::patch_restore_address_request_executor::PatchRestoreAddressRequestExecutor;
use omega_language_std::filesystem_host;
use src::command_executors::patch_restore_request_executor::PatchRestoreRequestExecutor;

// Port of command_executors/patches/patches_command_executor.rs — routes
// the patches command union to the per-leaf executor and wraps each
// typed response in the matching `PatchesResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data PatchesCommandExecutor {}

pub machine PatchesCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    patches_command: &PatchesCommand
) -> PatchesResponse
reaches FilesystemHost
invokes FilesystemHost;
{
    transition patches_command {
        PatchesCommand::Apply { request } -> apply(engine_privileged_state, &request)
        PatchesCommand::NoOperation { request } -> no_operation(engine_privileged_state, &request)
        PatchesCommand::Restore { request } -> restore(engine_privileged_state, &request)
        PatchesCommand::RestoreAddress { request } -> restore_address(engine_privileged_state, &request)
        PatchesCommand::List { request } -> list(engine_privileged_state, &request)
    }

    state apply(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PatchApplyRequest
    ) -> PatchesResponse {
        let response: PatchApplyResponse = PatchApplyRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PatchesResponse::Apply { response: response }) }
    }

    state no_operation(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PatchNoOperationRequest
    ) -> PatchesResponse {
        let response: PatchNoOperationResponse = PatchNoOperationRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PatchesResponse::NoOperation { response: response }) }
    }

    state restore(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PatchRestoreRequest
    ) -> PatchesResponse {
        let response: PatchRestoreResponse = PatchRestoreRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PatchesResponse::Restore { response: response }) }
    }

    state restore_address(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PatchRestoreAddressRequest
    ) -> PatchesResponse {
        let response: PatchRestoreAddressResponse = PatchRestoreAddressRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PatchesResponse::RestoreAddress { response: response }) }
    }

    state list(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PatchListRequest
    ) -> PatchesResponse {
        let response: PatchListResponse = PatchListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PatchesResponse::List { response: response }) }
    }
}
