use {omega}/language/core/filesystem_authority.omg;
use {squalr_engine_api}/src/commands/patches/apply/patch_apply_request.omg;
use {squalr_engine_api}/src/commands/patches/apply/patch_apply_response.omg;
use {squalr_engine_api}/src/commands/patches/list/patch_list_request.omg;
use {squalr_engine_api}/src/commands/patches/list/patch_list_response.omg;
use {squalr_engine_api}/src/commands/patches/no_operation/patch_no_operation_request.omg;
use {squalr_engine_api}/src/commands/patches/no_operation/patch_no_operation_response.omg;
use {squalr_engine_api}/src/commands/patches/patches_command.omg;
use {squalr_engine_api}/src/commands/patches/patches_response.omg;
use {squalr_engine_api}/src/commands/patches/restore/patch_restore_request.omg;
use {squalr_engine_api}/src/commands/patches/restore/patch_restore_response.omg;
use {squalr_engine_api}/src/commands/patches/restore_address/patch_restore_address_request.omg;
use {squalr_engine_api}/src/commands/patches/restore_address/patch_restore_address_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/patch_apply_request_executor.omg;
use src/command_executors/patch_list_request_executor.omg;
use src/command_executors/patch_no_operation_request_executor.omg;
use src/command_executors/patch_restore_address_request_executor.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use src/command_executors/patch_restore_request_executor.omg;

// Port of command_executors/patches/patches_command_executor.rs — routes
// the patches command union to the per-leaf executor and wraps each
// typed response in the matching `PatchesResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data PatchesCommandExecutor {}

public machine PatchesCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    patches_command: &|patches_command|::PatchesCommand
) -> |patches_response|::PatchesResponse
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    transition patches_command {
        |patches_command|::PatchesCommand::Apply { request } -> apply(engine_privileged_state, &request)
        |patches_command|::PatchesCommand::NoOperation { request } -> no_operation(engine_privileged_state, &request)
        |patches_command|::PatchesCommand::Restore { request } -> restore(engine_privileged_state, &request)
        |patches_command|::PatchesCommand::RestoreAddress { request } -> restore_address(engine_privileged_state, &request)
        |patches_command|::PatchesCommand::List { request } -> list(engine_privileged_state, &request)
    }

    machine apply(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|patch_apply_request|::PatchApplyRequest
    ) -> |patches_response|::PatchesResponse {
        let response: |patch_apply_response|::PatchApplyResponse = |patch_apply_request_executor|::PatchApplyRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|patches_response|::PatchesResponse::Apply { response: response }) }
    }

    machine no_operation(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|patch_no_operation_request|::PatchNoOperationRequest
    ) -> |patches_response|::PatchesResponse {
        let response: |patch_no_operation_response|::PatchNoOperationResponse = |patch_no_operation_request_executor|::PatchNoOperationRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|patches_response|::PatchesResponse::NoOperation { response: response }) }
    }

    machine restore(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|patch_restore_request|::PatchRestoreRequest
    ) -> |patches_response|::PatchesResponse {
        let response: |patch_restore_response|::PatchRestoreResponse = |patch_restore_request_executor|::PatchRestoreRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|patches_response|::PatchesResponse::Restore { response: response }) }
    }

    machine restore_address(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|patch_restore_address_request|::PatchRestoreAddressRequest
    ) -> |patches_response|::PatchesResponse {
        let response: |patch_restore_address_response|::PatchRestoreAddressResponse = |patch_restore_address_request_executor|::PatchRestoreAddressRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|patches_response|::PatchesResponse::RestoreAddress { response: response }) }
    }

    machine list(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|patch_list_request|::PatchListRequest
    ) -> |patches_response|::PatchesResponse {
        let response: |patch_list_response|::PatchListResponse = |patch_list_request_executor|::PatchListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|patches_response|::PatchesResponse::List { response: response }) }
    }
}
