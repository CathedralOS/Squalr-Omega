module src::command_executors::scan::element_scan::element_scan_request_executor;

use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter_collection::SnapshotRegionFilterCollection;
use squalr_engine_api::src::structures::scanning::plans::element_scan::element_scan_plan::ElementScanPlan;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use squalr_engine_scanning::src::element_scans::element_scan_report::ElementScanReport;
use squalr_engine_scanning::src::element_scans::element_scanner::ElementScanner;
use squalr_engine_scanning::src::scanners::scan_control::ScanControl;

// Port of the ElementScanRequest executor's scan leg, reduced to the headless
// path. Upstream's execute() resolves settings, the symbol registry, and the
// opened process through engine state before calling
// ElementScanner::scan_snapshot; those legs ride with the engine-session and
// registry work. Here the caller supplies the seeded input collections (the
// initialize_scan_results-equivalent seed) and the finalized plan directly.
pub data ElementScanRequestExecutor {}

pub machine ElementScanRequestExecutor::execute_snapshot_scan<
    'regions, 'order, 'deleted, 'current, 'previous, 'boundaries, 'tombstones,
    'type_id, 'filters, 'runs, 'cols,
    'plan_bytes, 'plan_mask, 'cons, 'sets
>(
    snapshot: &mut Snapshot<'regions, 'order, 'deleted, 'current, 'previous, 'boundaries, 'tombstones, 'type_id, 'filters, 'runs, 'cols>,
    input_collections: &[SnapshotRegionFilterCollection<'type_id, 'filters, 'runs>],
    in_collections_per_region: u64,
    element_scan_plan: &ElementScanPlan<'type_id, 'plan_bytes, 'plan_mask, 'cons, 'sets>,
    scan_control: &mut ScanControl,
    scratch_current: &mut [u64],
    scratch_previous: &mut [u64],
    chain_a: &mut [SnapshotRegionFilter],
    chain_b: &mut [SnapshotRegionFilter],
    out_filters: &mut [SnapshotRegionFilter],
    cell_filters_stride: u64,
    out_runs: &mut [u64],
    cell_runs_stride: u64,
    cell_filter_counts: &mut [u64],
    cell_run_counts: &mut [u64]
) -> ElementScanReport
{
    (ElementScanner::scan_snapshot(
        snapshot,
        input_collections,
        in_collections_per_region,
        element_scan_plan,
        scan_control,
        scratch_current,
        scratch_previous,
        chain_a,
        chain_b,
        out_filters,
        cell_filters_stride,
        out_runs,
        cell_runs_stride,
        cell_filter_counts,
        cell_run_counts
    ))
}
