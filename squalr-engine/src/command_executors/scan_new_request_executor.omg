use {squalr_engine_api}/src/commands/scan/new/scan_new_request.omg;
use {squalr_engine_api}/src/commands/scan/new/scan_new_response.omg;
use {squalr_engine_api}/src/events/engine_event.omg;
use {squalr_engine_api}/src/events/scan_results/updated/scan_results_updated_event.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot_region.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/snapshot_region_builder.omg;

// Port of commands/scan/new/scan_new_request_executor.rs — the privileged
// scan-new path for the headless leg: clear the freeze list, require an
// opened process, then page-bound → merge → install the fresh snapshot.
// Upstream reads live page bounds through the target's memory queryer; the
// sanctioned supplied source yields the same bound sequence for the
// captured target.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ScanNewRequestExecutor {}

public machine ScanNewRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    scan_new_request: &|scan_new_request|::ScanNewRequest
) -> |scan_new_response|::ScanNewResponse {
    |engine_privileged_state|::EnginePrivilegedState::clear_freeze_list(&mut engine_privileged_state);
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> bounds(engine_privileged_state, scan_new_request)
        _ -> (|scan_new_response|::ScanNewResponse::default())
    }

    // Upstream `get_memory_page_bounds` + `merge_memory_regions_into_snapshot_regions`:
    // one supplied page at a time through the builder.
    machine bounds(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_new_request: &|scan_new_request|::ScanNewRequest
    ) -> |scan_new_response|::ScanNewResponse {
        let mut builder: |snapshot_region_builder|::SnapshotRegionBuilder = |snapshot_region_builder|::SnapshotRegionBuilder::new();
        let mut snapshot: |snapshot|::Snapshot = |snapshot|::Snapshot::new();
        |snapshot_region_builder|::SnapshotRegionBuilder::fill_from_supplied_source(
            &mut builder,
            |engine_privileged_state|::EnginePrivilegedState::get_supplied_memory_source(&engine_privileged_state));
        |snapshot_region_builder|::SnapshotRegionBuilder::fill_snapshot(&builder, &mut snapshot);
        let region_count: u64 = |snapshot|::Snapshot::get_region_count(&snapshot);
        |engine_privileged_state|::EnginePrivilegedState::set_snapshot(&mut engine_privileged_state, snapshot);
        transition { _ -> notify(engine_privileged_state, region_count) }
    }

    // Upstream emits `ScanResultsUpdatedEvent { is_new_scan: true }` only
    // when merged regions were installed — same gate on the built
    // snapshot's region count.
    machine notify(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        region_count: u64
    ) -> |scan_new_response|::ScanNewResponse {
        transition region_count > 0 {
            true -> emit(engine_privileged_state)
            false -> finish()
            _ -> finish()
        }
    }

    machine emit(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
    ) -> |scan_new_response|::ScanNewResponse {
        let updated: |scan_results_updated_event|::ScanResultsUpdatedEvent = |scan_results_updated_event|::ScanResultsUpdatedEvent::new(true);
        let event: |engine_event|::EngineEvent = |scan_results_updated_event|::ScanResultsUpdatedEvent::to_engine_event(&updated);
        _ = |engine_privileged_state|::EnginePrivilegedState::emit_event(&mut engine_privileged_state, &event);
        transition { _ -> finish() }
    }

    machine finish() -> |scan_new_response|::ScanNewResponse {
        |scan_new_response|::ScanNewResponse { success: true }
    }
}
