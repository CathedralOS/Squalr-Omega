module src::command_executors::scan_new_request_executor;

use squalr_engine_api::src::commands::scan::new::scan_new_request::ScanNewRequest;
use squalr_engine_api::src::commands::scan::new::scan_new_response::ScanNewResponse;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use squalr_engine_api::src::structures::snapshots::snapshot_region::SnapshotRegion;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::snapshot_region_builder::SnapshotRegionBuilder;

// Port of commands/scan/new/scan_new_request_executor.rs — the privileged
// scan-new path for the headless leg: clear the freeze list, require an
// opened process, then page-bound → merge → install the fresh snapshot.
// Upstream reads live page bounds through the target's memory queryer; the
// sanctioned supplied source yields the same bound sequence for the
// captured target.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ScanNewRequestExecutor {}

pub machine ScanNewRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    scan_new_request: &ScanNewRequest
) -> ScanNewResponse {
    engine_privileged_state.clear_freeze_list();
    transition engine_privileged_state.has_opened_process() {
        true -> bounds(engine_privileged_state, scan_new_request)
        false -> (ScanNewResponse::default())
        _ -> (ScanNewResponse::default())
    }

    // Upstream `get_memory_page_bounds` + `merge_memory_regions_into_snapshot_regions`:
    // one supplied page at a time through the builder.
    state bounds(
        engine_privileged_state: &mut EnginePrivilegedState,
        scan_new_request: &ScanNewRequest
    ) -> ScanNewResponse {
        let mut builder: SnapshotRegionBuilder = SnapshotRegionBuilder::new();
        let mut snapshot: Snapshot = Snapshot::new();
        SnapshotRegionBuilder::fill_from_supplied_source(
            &mut builder,
            engine_privileged_state.get_supplied_memory_source());
        SnapshotRegionBuilder::fill_snapshot(&builder, &mut snapshot);
        engine_privileged_state.set_snapshot(snapshot);
        transition { _ -> finish() }
    }

    state finish() -> ScanNewResponse {
        ScanNewResponse { success: true }
    }
}
