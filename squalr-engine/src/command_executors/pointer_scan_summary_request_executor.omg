use {squalr_engine_api}/src/commands/pointer_scan/summary/pointer_scan_summary_request.omg;
use {squalr_engine_api}/src/commands/pointer_scan/summary/pointer_scan_summary_response.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_level.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_level_summary.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_summary.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_target_descriptor.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/pointer_scan_results_store.omg;

// Port of command_executors/pointer_scan/summary/pointer_scan_summary_request_executor.rs.
// Upstream: no session id → summarize the first stored entry; a session id
// that misses the store → default response. The port's store is one slot:
// `has_session_id` false reads it, a mismatched id is the miss.
public data PointerScanSummaryRequestExecutor {}

public machine PointerScanSummaryRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    pointer_scan_summary_request: &|pointer_scan_summary_request|::PointerScanSummaryRequest
) -> |pointer_scan_summary_response|::PointerScanSummaryResponse
crashes Abort
{
    let hoist1: bool = |pointer_scan_results_store|::PointerScanResultsStore::has_results(&engine_privileged_state.pointer_scan_results_store);
    transition hoist1 {
        true -> session(engine_privileged_state, pointer_scan_summary_request)
        _ -> (|pointer_scan_summary_response|::PointerScanSummaryResponse::empty())
    }

    machine session(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        pointer_scan_summary_request: &|pointer_scan_summary_request|::PointerScanSummaryRequest
    ) -> |pointer_scan_summary_response|::PointerScanSummaryResponse {
        let matches: bool = !pointer_scan_summary_request.has_session_id
            || pointer_scan_summary_request.session_id == |pointer_scan_results_store|::PointerScanResultsStore::get_session_id(&engine_privileged_state.pointer_scan_results_store);
        transition matches {
            true -> summarize(engine_privileged_state)
            _ -> (|pointer_scan_summary_response|::PointerScanSummaryResponse::empty())
        }
    }

    machine summarize(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
    ) -> |pointer_scan_summary_response|::PointerScanSummaryResponse {
        let mut level_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8] = [
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0)
        ];
        transition { _ -> collect(engine_privileged_state, level_summaries, 0) }
    }

    machine collect(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        level_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8],
        level_index: u64
    ) -> |pointer_scan_summary_response|::PointerScanSummaryResponse {
        let hoist2: u64 = |pointer_scan_results_store|::PointerScanResultsStore::get_level_count(&engine_privileged_state.pointer_scan_results_store);
        transition level_index < hoist2
            && level_index < 8 {
            true -> level(engine_privileged_state, level_summaries, level_index)
            false -> respond(engine_privileged_state, level_summaries)
            _ -> respond(engine_privileged_state, level_summaries)
        }
    }

    machine level(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        level_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8],
        level_index: u64
    ) -> |pointer_scan_summary_response|::PointerScanSummaryResponse
    requires 0 <= level_index && level_index < 8;
    {
        let level: |pointer_scan_level|::PointerScanLevel = |pointer_scan_results_store|::PointerScanResultsStore::get_level(&engine_privileged_state.pointer_scan_results_store, level_index);
        let mut next_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8] = level_summaries;
        let depth: u64 = |pointer_scan_level|::PointerScanLevel::get_depth(&level);
        let node_count: u64 = |pointer_scan_level|::PointerScanLevel::get_node_count(&level);
        let static_node_count: u64 = |pointer_scan_level|::PointerScanLevel::get_static_node_count(&level);
        let heap_node_count: u64 = |pointer_scan_level|::PointerScanLevel::get_heap_node_count(&level);
        next_summaries[level_index] = |pointer_scan_level_summary|::PointerScanLevelSummary::new(
            depth,
            node_count,
            static_node_count,
            heap_node_count);
        transition { _ -> collect(engine_privileged_state, next_summaries, level_index + 1) }
    }

    // Upstream `Some(pointer_scan_results.summarize())` — the stored
    // scalars already carry the summary fields.
    machine respond(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        level_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8]
    ) -> |pointer_scan_summary_response|::PointerScanSummaryResponse {
        let level_count: u64 = |pointer_scan_results_store|::PointerScanResultsStore::get_level_count(&engine_privileged_state.pointer_scan_results_store);
        let cloned_descriptor: |pointer_scan_target_descriptor|::PointerScanTargetDescriptor = |pointer_scan_target_descriptor|::PointerScanTargetDescriptor::clone(&engine_privileged_state.pointer_scan_results_store.target_descriptor);
        let stored_summary: |pointer_scan_summary|::StoredPointerScanSummary = |pointer_scan_summary|::StoredPointerScanSummary::of_scalars(
            |pointer_scan_results_store|::PointerScanResultsStore::get_session_id(&engine_privileged_state.pointer_scan_results_store),
            cloned_descriptor,
            engine_privileged_state.pointer_scan_results_store.address_space,
            engine_privileged_state.pointer_scan_results_store.pointer_size,
            engine_privileged_state.pointer_scan_results_store.max_depth,
            engine_privileged_state.pointer_scan_results_store.offset_radius,
            engine_privileged_state.pointer_scan_results_store.root_node_count,
            engine_privileged_state.pointer_scan_results_store.total_node_count,
            engine_privileged_state.pointer_scan_results_store.total_static_node_count,
            engine_privileged_state.pointer_scan_results_store.total_heap_node_count,
            &level_summaries, level_count);
        transition { _ -> (|pointer_scan_summary_response|::PointerScanSummaryResponse::of_summary(stored_summary)) }
    }
}
