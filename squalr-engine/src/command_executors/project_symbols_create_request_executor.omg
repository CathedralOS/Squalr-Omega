module src::command_executors::project_symbols_create_request_executor;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::project_symbols::create::project_symbols_create_request::ProjectSymbolsCreateRequest;
use squalr_engine_api::src::commands::project_symbols::create::project_symbols_create_response::ProjectSymbolsCreateResponse;
use squalr_engine_api::src::structures::projects::project::Project;
use squalr_engine_api::src::structures::projects::project_info::ProjectInfo;
use squalr_engine_api::src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use squalr_engine_session::src::projects::project_manager::ProjectManager;
use src::engine_bindings::standalone_engine_api_unprivileged_bindings::StandaloneEngineApiUnprivilegedBindings;
use src::services::projects::project_symbol_catalog_mutation::ProjectSymbolCatalogMutation;
use src::services::projects::project_symbol_catalog_mutation::CatalogCreateResult;
use src::services::projects::project_symbol_catalog_persistence::ProjectSymbolCatalogPersistence;

// Port of command_executors/project_symbols/create/
// project_symbols_create_request_executor.rs — build the claim inside the
// opened project's catalog, then persist + broadcast via save_and_sync.
// Deviations:
// - upstream's mpsc dispatch hop collapses into the in-session bindings (the
//   privileged/unprivileged hop note applies here too).
// - upstream resolves `project_directory_path` before mutating; the port's
//   save_and_sync resolves the directory internally, so a missing directory
//   surfaces as the same "cannot save" refusal with identical fields.
// - upstream's `Result<String, String>` folds to CatalogCreateResult
//   Created{key}/Refused; a Refused create responds success=false with no
//   locator key (upstream returns default() = success:false, empty key).
pub data ProjectSymbolsCreateRequestExecutor {}

pub linux_x86_64 machine ProjectSymbolsCreateRequestExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_symbols_create_request: &ProjectSymbolsCreateRequest
) -> ProjectSymbolsCreateResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
    transition ProjectManager::get_has_opened_project(project_manager) {
        true -> mutate(engine_unprivileged_state, engine_bindings, project_symbols_create_request)
        _ -> (refused())
    }
    state refused() -> ProjectSymbolsCreateResponse {
        (ProjectSymbolsCreateResponse::new())
    }
    state mutate(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_create_request: &ProjectSymbolsCreateRequest) -> ProjectSymbolsCreateResponse {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        let opened_project: &mut Project = ProjectManager::borrow_opened_project_mut(project_manager);
        let project_info: &mut ProjectInfo = Project::borrow_project_info_mut(opened_project);
        let project_symbol_catalog: &mut ProjectSymbolCatalog = ProjectInfo::borrow_project_symbol_catalog_mut(project_info);
        let mut mutation: ProjectSymbolCatalogMutation = ProjectSymbolCatalogMutation {};
        let result: CatalogCreateResult = ProjectSymbolCatalogMutation::create_project_symbol(&mut mutation, engine_unprivileged_state, project_symbol_catalog, project_symbols_create_request);
        transition result {
            CatalogCreateResult::Created { locator_key, locator_key_len } -> save(engine_unprivileged_state, engine_bindings, locator_key, locator_key_len)
            _ -> (refused())
        }
    }
    state save(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, locator_key: [u8; 256], locator_key_len: u64) -> ProjectSymbolsCreateResponse {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        let opened_project: &mut Project = ProjectManager::borrow_opened_project_mut(project_manager);
        transition ProjectSymbolCatalogPersistence::save_and_sync_project_symbol_catalog(engine_bindings, opened_project) {
            true -> succeed(locator_key, locator_key_len)
            _ -> (refused())
        }
    }
    state succeed(locator_key: [u8; 256], locator_key_len: u64) -> ProjectSymbolsCreateResponse {
        let mut response: ProjectSymbolsCreateResponse = ProjectSymbolsCreateResponse::new();
        ProjectSymbolsCreateResponse::set_success(&mut response, true);
        transition locator_key_len <= 256 {
            true -> fill(response, locator_key, locator_key_len)
            _ -> (response)
        }
    }
    state fill(mut response: ProjectSymbolsCreateResponse, locator_key: [u8; 256], locator_key_len: u64) -> ProjectSymbolsCreateResponse
        requires locator_key_len <= 256;
    {
        ProjectSymbolsCreateResponse::set_created_symbol_locator_key(&mut response, &locator_key[0..locator_key_len]);
        (response)
    }
}
