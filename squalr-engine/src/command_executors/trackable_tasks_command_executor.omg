module src::command_executors::trackable_tasks_command_executor;

use omega::language::core::wait_wake;
use squalr_engine_api::src::commands::trackable_tasks::cancel::trackable_tasks_cancel_request::TrackableTasksCancelRequest;
use squalr_engine_api::src::commands::trackable_tasks::cancel::trackable_tasks_cancel_response::TrackableTasksCancelResponse;
use squalr_engine_api::src::commands::trackable_tasks::list::trackable_tasks_list_request::TrackableTasksListRequest;
use squalr_engine_api::src::commands::trackable_tasks::list::trackable_tasks_list_response::TrackableTasksListResponse;
use squalr_engine_api::src::commands::trackable_tasks::trackable_tasks_command::TrackableTasksCommand;
use squalr_engine_api::src::commands::trackable_tasks::trackable_tasks_response::TrackableTasksResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::trackable_tasks_cancel_request_executor::TrackableTasksCancelRequestExecutor;
use src::command_executors::trackable_tasks_list_request_executor::TrackableTasksListRequestExecutor;

// Port of command_executors/trackable_tasks/trackable_tasks_command_executor.rs
// — routes the trackable-tasks command union to its request executor and
// wraps each typed response in the matching `TrackableTasksResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data TrackableTasksCommandExecutor {}

pub machine TrackableTasksCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    trackable_tasks_command: &TrackableTasksCommand
) -> TrackableTasksResponse
crashes Abort
reaches WaitWake
invokes WaitWake;
{
    transition trackable_tasks_command {
        TrackableTasksCommand::List { request } -> list(engine_privileged_state, &request)
        TrackableTasksCommand::Cancel { request } -> cancel(engine_privileged_state, &request)
    }

    state list(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &TrackableTasksListRequest
    ) -> TrackableTasksResponse
    {
        let response: TrackableTasksListResponse = TrackableTasksListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (TrackableTasksResponse::List { response: response }) }
    }

    state cancel(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &TrackableTasksCancelRequest
    ) -> TrackableTasksResponse
    {
        let response: TrackableTasksCancelResponse = TrackableTasksCancelRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (TrackableTasksResponse::Cancel { response: response }) }
    }
}
