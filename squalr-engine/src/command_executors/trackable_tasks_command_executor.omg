use {omega}/language/core/wait_wake.omg;
use {squalr_engine_api}/src/commands/trackable_tasks/cancel/trackable_tasks_cancel_request.omg;
use {squalr_engine_api}/src/commands/trackable_tasks/cancel/trackable_tasks_cancel_response.omg;
use {squalr_engine_api}/src/commands/trackable_tasks/list/trackable_tasks_list_request.omg;
use {squalr_engine_api}/src/commands/trackable_tasks/list/trackable_tasks_list_response.omg;
use {squalr_engine_api}/src/commands/trackable_tasks/trackable_tasks_command.omg;
use {squalr_engine_api}/src/commands/trackable_tasks/trackable_tasks_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/trackable_tasks_cancel_request_executor.omg;
use src/command_executors/trackable_tasks_list_request_executor.omg;

// Port of command_executors/trackable_tasks/trackable_tasks_command_executor.rs
// — routes the trackable-tasks command union to its request executor and
// wraps each typed response in the matching `TrackableTasksResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data TrackableTasksCommandExecutor {}

public machine TrackableTasksCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    trackable_tasks_command: &|trackable_tasks_command|::TrackableTasksCommand
) -> |trackable_tasks_response|::TrackableTasksResponse
crashes Abort
reaches |wait_wake|::WaitWake
invokes |wait_wake|::WaitWake;
{
    transition trackable_tasks_command {
        |trackable_tasks_command|::TrackableTasksCommand::List { request } -> list(engine_privileged_state, &request)
        |trackable_tasks_command|::TrackableTasksCommand::Cancel { request } -> cancel(engine_privileged_state, &request)
    }

    machine list(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|trackable_tasks_list_request|::TrackableTasksListRequest
    ) -> |trackable_tasks_response|::TrackableTasksResponse
    {
        let response: |trackable_tasks_list_response|::TrackableTasksListResponse = |trackable_tasks_list_request_executor|::TrackableTasksListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|trackable_tasks_response|::TrackableTasksResponse::List { response: response }) }
    }

    machine cancel(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|trackable_tasks_cancel_request|::TrackableTasksCancelRequest
    ) -> |trackable_tasks_response|::TrackableTasksResponse
    {
        let response: |trackable_tasks_cancel_response|::TrackableTasksCancelResponse = |trackable_tasks_cancel_request_executor|::TrackableTasksCancelRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|trackable_tasks_response|::TrackableTasksResponse::Cancel { response: response }) }
    }
}
