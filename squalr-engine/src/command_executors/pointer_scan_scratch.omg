module src::command_executors::pointer_scan_scratch;

use squalr_engine_api::src::structures::memory::normalized_region;
use squalr_engine_api::src::structures::memory::normalized_region::NormalizedRegion;
use squalr_engine_scanning::src::pointer_scans::pointer_scan_results_builder::BuiltLevelSpan;
use squalr_engine_scanning::src::pointer_scans::structures::pointer_scan_collected_candidate::PointerScanCollectedCandidate;
use squalr_engine_scanning::src::pointer_scans::structures::pointer_scan_target_ranges::PointerScanTargetRangeBucket;
use squalr_engine_scanning::src::pointer_scans::structures::snapshot_region_scan_task::SnapshotRegionScanTask;

// Caller-owned scratch extents for PointerScanExecutor::execute_scan /
// PointerScanValidator::validate_scan — upstream allocates these Vecs fresh
// per call; the port keeps one fixed-capacity record on the caller stack so
// executor states don't rethread a dozen arrays. Bounds match the results
// store (targets 64, modules 32, levels 8, candidates 4096; byte_arena
// covers 4 regions x ~2K window bytes as upstream's per-region buffer).
pub data PointerScanScratch {
    sorted_scratch: [u64; 4096];
    target_ranges: [NormalizedRegion; 64];
    lower_bounds: [u64; 64];
    upper_bounds: [u64; 64];
    target_range_buckets: [PointerScanTargetRangeBucket; 64];
    tasks_scratch: [SnapshotRegionScanTask; 8];
    byte_arena: [u8; 8192];
    module_order_scratch: [u64; 32];
    heap_address_scratch: [u64; 4096];
    level_spans_out: [BuiltLevelSpan; 8];
    collected_static_candidates: [PointerScanCollectedCandidate; 4096];
    collected_heap_candidates: [PointerScanCollectedCandidate; 4096];
    pointer_value_scratch: [u8; 8];
    module_name_scratch: [u8; 256];
    // The level_candidates view array — its elements re-borrow the results
    // store's candidate arenas per access, so the array lives here as
    // caller storage and only its contents carry lifetimes.
}

pub machine PointerScanScratch::new() -> PointerScanScratch {
    PointerScanScratch {}
}

pub machine PointerScanScratch::borrow_sorted_scratch_mut(&mut self) -> &mut [u64] {
    &mut self.sorted_scratch
}
pub machine PointerScanScratch::borrow_target_ranges_mut(&mut self) -> &mut [normalized_region::NormalizedRegion] {
    &mut self.target_ranges
}
pub machine PointerScanScratch::borrow_lower_bounds_mut(&mut self) -> &mut [u64] {
    &mut self.lower_bounds
}
pub machine PointerScanScratch::borrow_upper_bounds_mut(&mut self) -> &mut [u64] {
    &mut self.upper_bounds
}
pub machine PointerScanScratch::borrow_target_range_buckets_mut(&mut self) -> &mut [PointerScanTargetRangeBucket] {
    &mut self.target_range_buckets
}
pub machine PointerScanScratch::borrow_tasks_scratch_mut(&mut self) -> &mut [SnapshotRegionScanTask] {
    &mut self.tasks_scratch
}
pub machine PointerScanScratch::borrow_byte_arena_mut(&mut self) -> &mut [u8] {
    &mut self.byte_arena
}
pub machine PointerScanScratch::borrow_module_order_scratch_mut(&mut self) -> &mut [u64] {
    &mut self.module_order_scratch
}
pub machine PointerScanScratch::borrow_heap_address_scratch_mut(&mut self) -> &mut [u64] {
    &mut self.heap_address_scratch
}
pub machine PointerScanScratch::borrow_level_spans_mut(&mut self) -> &mut [BuiltLevelSpan] {
    &mut self.level_spans_out
}
pub machine PointerScanScratch::borrow_collected_static_candidates_mut(&mut self) -> &mut [PointerScanCollectedCandidate] {
    &mut self.collected_static_candidates
}
pub machine PointerScanScratch::borrow_collected_heap_candidates_mut(&mut self) -> &mut [PointerScanCollectedCandidate] {
    &mut self.collected_heap_candidates
}
pub machine PointerScanScratch::borrow_pointer_value_scratch_mut(&mut self) -> &mut [u8] {
    &mut self.pointer_value_scratch
}
pub machine PointerScanScratch::borrow_module_name_scratch_mut(&mut self) -> &mut [u8] {
    &mut self.module_name_scratch
}
