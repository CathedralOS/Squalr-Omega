module src::command_executors::memory_settings_command_executor;

use squalr_engine_api::src::commands::settings::memory::memory_settings_command::MemorySettingsCommand;
use squalr_engine_api::src::commands::settings::memory::memory_settings_response::MemorySettingsResponse;
use squalr_engine_api::src::commands::settings::memory::list::memory_settings_list_request::MemorySettingsListRequest;
use squalr_engine_api::src::commands::settings::memory::list::memory_settings_list_response::MemorySettingsListResponse;
use squalr_engine_api::src::commands::settings::memory::set::memory_settings_set_request::MemorySettingsSetRequest;
use squalr_engine_api::src::commands::settings::memory::set::memory_settings_set_response::MemorySettingsSetResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::memory_settings_list_request_executor::MemorySettingsListRequestExecutor;
use src::command_executors::memory_settings_set_request_executor::MemorySettingsSetRequestExecutor;

// Port of command_executors/settings/memory/memory_settings_command_executor.rs —
// routes the memory settings command union to the per-request executor and
// wraps each typed response in the matching `MemorySettingsResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data MemorySettingsCommandExecutor {}

pub machine MemorySettingsCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    memory_settings_command: &MemorySettingsCommand
) -> MemorySettingsResponse {
    transition memory_settings_command {
        MemorySettingsCommand::List { request } -> list(engine_privileged_state, &request)
        MemorySettingsCommand::Set { request } -> set(engine_privileged_state, &request)
    }

    state list(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsListRequest
    ) -> MemorySettingsResponse {
        let response: MemorySettingsListResponse = MemorySettingsListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (MemorySettingsResponse::List { response: response }) }
    }

    state set(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsResponse {
        let response: MemorySettingsSetResponse = MemorySettingsSetRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (MemorySettingsResponse::Set { response: response }) }
    }
}
