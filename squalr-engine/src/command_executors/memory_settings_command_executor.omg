use {squalr_engine_api}/src/commands/settings/memory/memory_settings_command.omg;
use {squalr_engine_api}/src/commands/settings/memory/memory_settings_response.omg;
use {squalr_engine_api}/src/commands/settings/memory/list/memory_settings_list_request.omg;
use {squalr_engine_api}/src/commands/settings/memory/list/memory_settings_list_response.omg;
use {squalr_engine_api}/src/commands/settings/memory/set/memory_settings_set_request.omg;
use {squalr_engine_api}/src/commands/settings/memory/set/memory_settings_set_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/memory_settings_list_request_executor.omg;
use src/command_executors/memory_settings_set_request_executor.omg;

// Port of command_executors/settings/memory/memory_settings_command_executor.rs —
// routes the memory settings command union to the per-request executor and
// wraps each typed response in the matching `MemorySettingsResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data MemorySettingsCommandExecutor {}

public machine MemorySettingsCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    memory_settings_command: &|memory_settings_command|::MemorySettingsCommand
) -> |memory_settings_response|::MemorySettingsResponse {
    transition memory_settings_command {
        |memory_settings_command|::MemorySettingsCommand::List { request } -> list(engine_privileged_state, &request)
        |memory_settings_command|::MemorySettingsCommand::Set { request } -> set(engine_privileged_state, &request)
    }

    machine list(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|memory_settings_list_request|::MemorySettingsListRequest
    ) -> |memory_settings_response|::MemorySettingsResponse {
        let response: |memory_settings_list_response|::MemorySettingsListResponse = |memory_settings_list_request_executor|::MemorySettingsListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|memory_settings_response|::MemorySettingsResponse::List { response: response }) }
    }

    machine set(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|memory_settings_set_request|::MemorySettingsSetRequest
    ) -> |memory_settings_response|::MemorySettingsResponse {
        let response: |memory_settings_set_response|::MemorySettingsSetResponse = |memory_settings_set_request_executor|::MemorySettingsSetRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|memory_settings_response|::MemorySettingsResponse::Set { response: response }) }
    }
}
