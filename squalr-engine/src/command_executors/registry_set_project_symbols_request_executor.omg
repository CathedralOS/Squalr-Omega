module src::command_executors::registry_set_project_symbols_request_executor;

use squalr_engine_api::src::commands::registry::set_project_symbols::registry_set_project_symbols_request::RegistrySetProjectSymbolsRequest;
use squalr_engine_api::src::commands::registry::set_project_symbols::registry_set_project_symbols_response::RegistrySetProjectSymbolsResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/registry/set_project_symbols/registry_set_project_symbols_request_executor.rs —
// installs the request's project symbol catalog through the session's
// mutation contract (bump generation + emit RegistryChangedEvent when it
// lands) and reports the acceptance flag.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data RegistrySetProjectSymbolsRequestExecutor {}

pub machine RegistrySetProjectSymbolsRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    registry_set_project_symbols_request: &RegistrySetProjectSymbolsRequest
) -> RegistrySetProjectSymbolsResponse {
    let success: bool = EnginePrivilegedState::set_project_symbol_catalog(engine_privileged_state, 
        RegistrySetProjectSymbolsRequest::get_project_symbol_catalog(registry_set_project_symbols_request));
    (RegistrySetProjectSymbolsResponse::new(success))
}
