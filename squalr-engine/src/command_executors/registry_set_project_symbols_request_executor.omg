use {squalr_engine_api}/src/commands/registry/set_project_symbols/registry_set_project_symbols_request.omg;
use {squalr_engine_api}/src/commands/registry/set_project_symbols/registry_set_project_symbols_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/registry/set_project_symbols/registry_set_project_symbols_request_executor.rs —
// installs the request's project symbol catalog through the session's
// mutation contract (bump generation + emit RegistryChangedEvent when it
// lands) and reports the acceptance flag.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data RegistrySetProjectSymbolsRequestExecutor {}

public machine RegistrySetProjectSymbolsRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    registry_set_project_symbols_request: &|registry_set_project_symbols_request|::RegistrySetProjectSymbolsRequest
) -> |registry_set_project_symbols_response|::RegistrySetProjectSymbolsResponse {
    let success: bool = |engine_privileged_state|::EnginePrivilegedState::set_project_symbol_catalog(&mut engine_privileged_state, |registry_set_project_symbols_request|::RegistrySetProjectSymbolsRequest::get_project_symbol_catalog(&registry_set_project_symbols_request));
    (|registry_set_project_symbols_response|::RegistrySetProjectSymbolsResponse::new(success))
}
