    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_memory_type_mapped(&mut settings, MemorySettingsSetRequest::get_memory_type_mapped(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> check4(engine_privileged_state, request) }
    }

    state check4(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition MemorySettingsSetRequest::has_required_write(request) {
            true -> wrote_required_write(engine_privileged_state, request)
            _ -> check5(engine_privileged_state, request)
        }
    }

    state wrote_required_write(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_required_write(&mut settings, MemorySettingsSetRequest::get_required_write(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> check5(engine_privileged_state, request) }
    }

    state check5(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition MemorySettingsSetRequest::has_required_execute(request) {
            true -> wrote_required_execute(engine_privileged_state, request)
            _ -> check6(engine_privileged_state, request)
        }
    }

    state wrote_required_execute(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_required_execute(&mut settings, MemorySettingsSetRequest::get_required_execute(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> check6(engine_privileged_state, request) }
    }

    state check6(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition MemorySettingsSetRequest::has_required_copy_on_write(request) {
            true -> wrote_required_copy_on_write(engine_privileged_state, request)
            _ -> check7(engine_privileged_state, request)
        }
    }

    state wrote_required_copy_on_write(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_required_copy_on_write(&mut settings, MemorySettingsSetRequest::get_required_copy_on_write(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> check7(engine_privileged_state, request) }
    }

    state check7(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition MemorySettingsSetRequest::has_excluded_write(request) {
            true -> wrote_excluded_write(engine_privileged_state, request)
            _ -> check8(engine_privileged_state, request)
        }
    }

    state wrote_excluded_write(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_excluded_write(&mut settings, MemorySettingsSetRequest::get_excluded_write(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> check8(engine_privileged_state, request) }
    }

    state check8(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition MemorySettingsSetRequest::has_excluded_execute(request) {
            true -> wrote_excluded_execute(engine_privileged_state, request)
