module src::command_executors::memory_settings_set_request_executor;

use squalr_engine_api::src::commands::settings::memory::set::memory_settings_set_request::MemorySettingsSetRequest;
use squalr_engine_api::src::commands::settings::memory::set::memory_settings_set_response::MemorySettingsSetResponse;
use squalr_engine_api::src::structures::settings::memory_settings::MemorySettings;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/settings/memory/set/memory_settings_set_request_executor.rs —
// upstream applies each present optional field to memory_settings_config.rs; the
// port applies them to the session-owned settings record (persistence is a
// deferred leg — see engine_privileged_state.omg). Each `if let Some` arm
// becomes a check/write state pair: Omega dispatches on `transition` guards,
// there is no statement-level `if`.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data MemorySettingsSetRequestExecutor {}

pub machine MemorySettingsSetRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    request: &MemorySettingsSetRequest
) -> MemorySettingsSetResponse {
    transition MemorySettingsSetRequest::has_memory_type_none(request) {
        true -> wrote_memory_type_none(engine_privileged_state, request)
        _ -> check1(engine_privileged_state, request)
    }

    state wrote_memory_type_none(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_memory_type_none(&mut settings, MemorySettingsSetRequest::get_memory_type_none(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> check1(engine_privileged_state, request) }
    }

    state check1(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition MemorySettingsSetRequest::has_memory_type_private(request) {
            true -> wrote_memory_type_private(engine_privileged_state, request)
            _ -> check2(engine_privileged_state, request)
        }
    }

    state wrote_memory_type_private(
        engine_privileged_state: &mut EnginePrivilegedState,
