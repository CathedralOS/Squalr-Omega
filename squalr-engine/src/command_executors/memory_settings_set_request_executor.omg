    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_memory_type_private(&mut settings, MemorySettingsSetRequest::get_memory_type_private(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> check2(engine_privileged_state, request) }
    }

    state check2(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition MemorySettingsSetRequest::has_memory_type_image(request) {
            true -> wrote_memory_type_image(engine_privileged_state, request)
            _ -> check3(engine_privileged_state, request)
        }
    }

    state wrote_memory_type_image(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_memory_type_image(&mut settings, MemorySettingsSetRequest::get_memory_type_image(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> check3(engine_privileged_state, request) }
    }

    state check3(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition MemorySettingsSetRequest::has_memory_type_mapped(request) {
            true -> wrote_memory_type_mapped(engine_privileged_state, request)
            _ -> check4(engine_privileged_state, request)
        }
    }

    state wrote_memory_type_mapped(
        engine_privileged_state: &mut EnginePrivilegedState,
