        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_excluded_execute(&mut settings, MemorySettingsSetRequest::get_excluded_execute(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> check9(engine_privileged_state, request) }
    }

    state check9(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition MemorySettingsSetRequest::has_excluded_copy_on_write(request) {
            true -> wrote_excluded_copy_on_write(engine_privileged_state, request)
            _ -> check10(engine_privileged_state, request)
        }
    }

    state wrote_excluded_copy_on_write(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_excluded_copy_on_write(&mut settings, MemorySettingsSetRequest::get_excluded_copy_on_write(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> check10(engine_privileged_state, request) }
    }

    state check10(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition MemorySettingsSetRequest::has_start_address(request) {
            true -> wrote_start_address(engine_privileged_state, request)
            _ -> check11(engine_privileged_state, request)
        }
    }

    state wrote_start_address(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_start_address(&mut settings, MemorySettingsSetRequest::get_start_address(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> check11(engine_privileged_state, request) }
    }

    state check11(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition MemorySettingsSetRequest::has_end_address(request) {
            true -> wrote_end_address(engine_privileged_state, request)
            _ -> check12(engine_privileged_state, request)
        }
    }

    state wrote_end_address(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_end_address(&mut settings, MemorySettingsSetRequest::get_end_address(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> check12(engine_privileged_state, request) }
    }

    state check12(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition MemorySettingsSetRequest::has_only_query_usermode(request) {
            true -> wrote_only_query_usermode(engine_privileged_state, request)
            _ -> finish(engine_privileged_state)
        }
    }

    state wrote_only_query_usermode(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = EnginePrivilegedState::get_memory_settings(engine_privileged_state);
        MemorySettings::set_only_query_usermode(&mut settings, MemorySettingsSetRequest::get_only_query_usermode(request));
        EnginePrivilegedState::set_memory_settings(engine_privileged_state, settings);
        transition { _ -> finish(engine_privileged_state) }
