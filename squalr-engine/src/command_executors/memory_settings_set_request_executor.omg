module src::command_executors::memory_settings_set_request_executor;

use squalr_engine_api::src::commands::settings::memory::set::memory_settings_set_request::MemorySettingsSetRequest;
use squalr_engine_api::src::commands::settings::memory::set::memory_settings_set_response::MemorySettingsSetResponse;
use squalr_engine_api::src::structures::settings::memory_settings::MemorySettings;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/settings/memory/set/memory_settings_set_request_executor.rs —
// upstream applies each present optional field to memory_settings_config.rs; the
// port applies them to the session-owned settings record (persistence is a
// deferred leg — see engine_privileged_state.omg). Each `if let Some` arm
// becomes a check/write state pair: Omega dispatches on `transition` guards,
// there is no statement-level `if`.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data MemorySettingsSetRequestExecutor {}

pub machine MemorySettingsSetRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    request: &MemorySettingsSetRequest
) -> MemorySettingsSetResponse {
    transition request.has_memory_type_none() {
        true -> wrote_memory_type_none(engine_privileged_state, request)
        _ -> check1(engine_privileged_state, request)
    }

    state wrote_memory_type_none(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_memory_type_none(request.get_memory_type_none());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> check1(engine_privileged_state, request) }
    }

    state check1(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition request.has_memory_type_private() {
            true -> wrote_memory_type_private(engine_privileged_state, request)
            _ -> check2(engine_privileged_state, request)
        }
    }

    state wrote_memory_type_private(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_memory_type_private(request.get_memory_type_private());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> check2(engine_privileged_state, request) }
    }

    state check2(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition request.has_memory_type_image() {
            true -> wrote_memory_type_image(engine_privileged_state, request)
            _ -> check3(engine_privileged_state, request)
        }
    }

    state wrote_memory_type_image(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_memory_type_image(request.get_memory_type_image());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> check3(engine_privileged_state, request) }
    }

    state check3(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition request.has_memory_type_mapped() {
            true -> wrote_memory_type_mapped(engine_privileged_state, request)
            _ -> check4(engine_privileged_state, request)
        }
    }

    state wrote_memory_type_mapped(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_memory_type_mapped(request.get_memory_type_mapped());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> check4(engine_privileged_state, request) }
    }

    state check4(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition request.has_required_write() {
            true -> wrote_required_write(engine_privileged_state, request)
            _ -> check5(engine_privileged_state, request)
        }
    }

    state wrote_required_write(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_required_write(request.get_required_write());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> check5(engine_privileged_state, request) }
    }

    state check5(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition request.has_required_execute() {
            true -> wrote_required_execute(engine_privileged_state, request)
            _ -> check6(engine_privileged_state, request)
        }
    }

    state wrote_required_execute(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_required_execute(request.get_required_execute());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> check6(engine_privileged_state, request) }
    }

    state check6(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition request.has_required_copy_on_write() {
            true -> wrote_required_copy_on_write(engine_privileged_state, request)
            _ -> check7(engine_privileged_state, request)
        }
    }

    state wrote_required_copy_on_write(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_required_copy_on_write(request.get_required_copy_on_write());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> check7(engine_privileged_state, request) }
    }

    state check7(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition request.has_excluded_write() {
            true -> wrote_excluded_write(engine_privileged_state, request)
            _ -> check8(engine_privileged_state, request)
        }
    }

    state wrote_excluded_write(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_excluded_write(request.get_excluded_write());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> check8(engine_privileged_state, request) }
    }

    state check8(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition request.has_excluded_execute() {
            true -> wrote_excluded_execute(engine_privileged_state, request)
            _ -> check9(engine_privileged_state, request)
        }
    }

    state wrote_excluded_execute(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_excluded_execute(request.get_excluded_execute());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> check9(engine_privileged_state, request) }
    }

    state check9(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition request.has_excluded_copy_on_write() {
            true -> wrote_excluded_copy_on_write(engine_privileged_state, request)
            _ -> check10(engine_privileged_state, request)
        }
    }

    state wrote_excluded_copy_on_write(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_excluded_copy_on_write(request.get_excluded_copy_on_write());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> check10(engine_privileged_state, request) }
    }

    state check10(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition request.has_start_address() {
            true -> wrote_start_address(engine_privileged_state, request)
            _ -> check11(engine_privileged_state, request)
        }
    }

    state wrote_start_address(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_start_address(request.get_start_address());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> check11(engine_privileged_state, request) }
    }

    state check11(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition request.has_end_address() {
            true -> wrote_end_address(engine_privileged_state, request)
            _ -> check12(engine_privileged_state, request)
        }
    }

    state wrote_end_address(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_end_address(request.get_end_address());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> check12(engine_privileged_state, request) }
    }

    state check12(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        transition request.has_only_query_usermode() {
            true -> wrote_only_query_usermode(engine_privileged_state, request)
            _ -> finish(engine_privileged_state)
        }
    }

    state wrote_only_query_usermode(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &MemorySettingsSetRequest
    ) -> MemorySettingsSetResponse {
        let mut settings: MemorySettings = engine_privileged_state.get_memory_settings();
        settings.set_only_query_usermode(request.get_only_query_usermode());
        engine_privileged_state.set_memory_settings(settings);
        transition { _ -> finish(engine_privileged_state) }
    }

    state finish(
        engine_privileged_state: &mut EnginePrivilegedState
    ) -> MemorySettingsSetResponse {
        (MemorySettingsSetResponse::new())
    }
}
