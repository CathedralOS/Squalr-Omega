module src::command_executors::debugger_trace_pause_request_executor;

use squalr_engine_api::src::commands::debugger::trace_pause::debugger_trace_pause_request::DebuggerTracePauseRequest;
use squalr_engine_api::src::commands::debugger::trace_pause::debugger_trace_pause_response::DebuggerTracePauseResponse;
use squalr_engine_api::src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use squalr_engine_api::src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;
use squalr_engine_session::src::debugger::debugger_service::DebuggerTraceOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/debugger/mod.rs::DebuggerTracePauseRequest —
// service.debugger_pause_trace_session(trace_session_id) -> Some(session)+records / Err.
pub data DebuggerTracePauseRequestExecutor {}

pub machine DebuggerTracePauseRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_trace_pause_request: &DebuggerTracePauseRequest
) -> DebuggerTracePauseResponse {
    let trace_session_id: &[u8] = DebuggerTracePauseRequest::get_trace_session_id(debugger_trace_pause_request);
    let outcome: DebuggerTraceOutcome = EnginePrivilegedState::debugger_pause_trace_session(engine_privileged_state, 
        trace_session_id);
    transition outcome.succeeded && outcome.has_trace_session {
        true -> fill(outcome)
        _ -> failed(outcome)
    }

    state fill(outcome: DebuggerTraceOutcome) -> DebuggerTracePauseResponse {
        let mut response: DebuggerTracePauseResponse = DebuggerTracePauseResponse::new();
        DebuggerTracePauseResponse::set_trace_session(&mut response, DebuggerTraceSessionDescriptor::clone(&outcome.trace_session));
        transition { _ -> records(response, outcome, 0) }
    }

    state records(response: DebuggerTracePauseResponse, outcome: DebuggerTraceOutcome, position: u64) -> DebuggerTracePauseResponse {
        transition position < outcome.instruction_record_count && position < 16 {
            true -> record(response, outcome, position)
            _ -> (response)
        }
    }

    state record(mut response: DebuggerTracePauseResponse, outcome: DebuggerTraceOutcome, position: u64) -> DebuggerTracePauseResponse
        requires position < 16
    {
        _ = DebuggerTracePauseResponse::add_instruction_record(&mut response, &outcome.instruction_records[position]);
        transition { _ -> records(response, outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state failed(outcome: DebuggerTraceOutcome) -> DebuggerTracePauseResponse {
        let mut response: DebuggerTracePauseResponse = DebuggerTracePauseResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        DebuggerCommandStatus::set_message(&mut status, DebuggerTraceOutcome::get_error_message(&outcome));
        DebuggerTracePauseResponse::set_status(&mut response, status);
        (response)
    }
}
