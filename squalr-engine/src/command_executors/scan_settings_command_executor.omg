module src::command_executors::scan_settings_command_executor;

use squalr_engine_api::src::commands::settings::scan::scan_settings_command::ScanSettingsCommand;
use squalr_engine_api::src::commands::settings::scan::scan_settings_response::ScanSettingsResponse;
use squalr_engine_api::src::commands::settings::scan::list::scan_settings_list_request::ScanSettingsListRequest;
use squalr_engine_api::src::commands::settings::scan::list::scan_settings_list_response::ScanSettingsListResponse;
use squalr_engine_api::src::commands::settings::scan::set::scan_settings_set_request::ScanSettingsSetRequest;
use squalr_engine_api::src::commands::settings::scan::set::scan_settings_set_response::ScanSettingsSetResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::scan_settings_list_request_executor::ScanSettingsListRequestExecutor;
use src::command_executors::scan_settings_set_request_executor::ScanSettingsSetRequestExecutor;

// Port of command_executors/settings/scan/scan_settings_command_executor.rs —
// routes the scan settings command union to the per-request executor and
// wraps each typed response in the matching `ScanSettingsResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ScanSettingsCommandExecutor {}

pub machine ScanSettingsCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    scan_settings_command: &ScanSettingsCommand
) -> ScanSettingsResponse {
    transition scan_settings_command {
        ScanSettingsCommand::List { request } -> list(engine_privileged_state, &request)
        ScanSettingsCommand::Set { request } -> set(engine_privileged_state, &request)
    }

    state list(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsListRequest
    ) -> ScanSettingsResponse {
        let response: ScanSettingsListResponse = ScanSettingsListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (ScanSettingsResponse::List { response: response }) }
    }

    state set(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &ScanSettingsSetRequest
    ) -> ScanSettingsResponse {
        let response: ScanSettingsSetResponse = ScanSettingsSetRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (ScanSettingsResponse::Set { response: response }) }
    }
}
