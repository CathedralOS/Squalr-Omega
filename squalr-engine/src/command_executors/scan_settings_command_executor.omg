use {squalr_engine_api}/src/commands/settings/scan/scan_settings_command.omg;
use {squalr_engine_api}/src/commands/settings/scan/scan_settings_response.omg;
use {squalr_engine_api}/src/commands/settings/scan/list/scan_settings_list_request.omg;
use {squalr_engine_api}/src/commands/settings/scan/list/scan_settings_list_response.omg;
use {squalr_engine_api}/src/commands/settings/scan/set/scan_settings_set_request.omg;
use {squalr_engine_api}/src/commands/settings/scan/set/scan_settings_set_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/scan_settings_list_request_executor.omg;
use src/command_executors/scan_settings_set_request_executor.omg;

// Port of command_executors/settings/scan/scan_settings_command_executor.rs —
// routes the scan settings command union to the per-request executor and
// wraps each typed response in the matching `ScanSettingsResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ScanSettingsCommandExecutor {}

public machine ScanSettingsCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    scan_settings_command: &|scan_settings_command|::ScanSettingsCommand
) -> |scan_settings_response|::ScanSettingsResponse {
    transition scan_settings_command {
        |scan_settings_command|::ScanSettingsCommand::List { request } -> list(engine_privileged_state, &request)
        |scan_settings_command|::ScanSettingsCommand::Set { request } -> set(engine_privileged_state, &request)
    }

    machine list(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|scan_settings_list_request|::ScanSettingsListRequest
    ) -> |scan_settings_response|::ScanSettingsResponse {
        let response: |scan_settings_list_response|::ScanSettingsListResponse = |scan_settings_list_request_executor|::ScanSettingsListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_settings_response|::ScanSettingsResponse::List { response: response }) }
    }

    machine set(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|scan_settings_set_request|::ScanSettingsSetRequest
    ) -> |scan_settings_response|::ScanSettingsResponse {
        let response: |scan_settings_set_response|::ScanSettingsSetResponse = |scan_settings_set_request_executor|::ScanSettingsSetRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|scan_settings_response|::ScanSettingsResponse::Set { response: response }) }
    }
}
