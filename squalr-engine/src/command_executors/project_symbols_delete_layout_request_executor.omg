module src::command_executors::project_symbols_delete_layout_request_executor;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::project_symbols::delete_layout::project_symbols_delete_layout_request::ProjectSymbolsDeleteLayoutRequest;
use squalr_engine_api::src::commands::project_symbols::delete_layout::project_symbols_delete_layout_response::ProjectSymbolsDeleteLayoutResponse;
use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use squalr_engine_api::src::structures::projects::project::Project;
use squalr_engine_api::src::structures::projects::project_info::ProjectInfo;
use squalr_engine_api::src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use squalr_engine_session::src::projects::project_manager::ProjectManager;
use src::engine_bindings::standalone_engine_api_unprivileged_bindings::StandaloneEngineApiUnprivilegedBindings;
use src::services::projects::project_symbol_layout_mutation::ProjectSymbolLayoutMutation;
use src::services::projects::project_symbol_layout_mutation::LayoutMutationResult;
use src::services::projects::project_symbol_catalog_persistence::ProjectSymbolCatalogPersistence;

// Port of command_executors/project_symbols/delete_layout/
// project_symbols_delete_layout_request_executor.rs — delete the struct
// layout descriptor, retargeting claims/fields onto the replacement data
// type, then save + sync.
// Deviations:
// - upstream's `Result<(), String>` folds to LayoutMutationResult
//   Succeeded/Refused; the refused arm returns the id field with a generic
//   error message (the Err string is not carried).
// - the project directory resolves inside save_and_sync (upstream resolved
//   it early only to pass it through).
pub data ProjectSymbolsDeleteLayoutRequestExecutor {}

pub linux_x86_64 machine ProjectSymbolsDeleteLayoutRequestExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_symbols_delete_layout_request: &ProjectSymbolsDeleteLayoutRequest
) -> ProjectSymbolsDeleteLayoutResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
    transition ProjectManager::get_has_opened_project(project_manager) {
        true -> mutate(engine_unprivileged_state, engine_bindings, project_symbols_delete_layout_request)
        _ -> (fail(ProjectSymbolsDeleteLayoutRequest::get_struct_layout_id(project_symbols_delete_layout_request), "Cannot delete symbol layout without an opened project."))
    }
    state mutate(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_delete_layout_request: &ProjectSymbolsDeleteLayoutRequest) -> ProjectSymbolsDeleteLayoutResponse {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        let opened_project: &mut Project = ProjectManager::borrow_opened_project_mut(project_manager);
        let project_info: &mut ProjectInfo = Project::borrow_project_info_mut(opened_project);
        let project_symbol_catalog: &mut ProjectSymbolCatalog = ProjectInfo::borrow_project_symbol_catalog_mut(project_info);
        let inner38: &[u8] = ProjectSymbolsDeleteLayoutRequest::get_replacement_data_type_id(project_symbols_delete_layout_request);
        let replacement_data_type: DataTypeRef = DataTypeRef::new(inner38);
        let mut mutation: ProjectSymbolLayoutMutation = ProjectSymbolLayoutMutation {};
        let inner39: &[u8] = ProjectSymbolsDeleteLayoutRequest::get_struct_layout_id(project_symbols_delete_layout_request);
        let result: LayoutMutationResult = ProjectSymbolLayoutMutation::delete_struct_layout(&mut mutation, project_symbol_catalog, inner39, &replacement_data_type);
        transition result {
            LayoutMutationResult::Succeeded { summary } -> save(engine_unprivileged_state, engine_bindings, project_symbols_delete_layout_request)
            _ -> (fail(ProjectSymbolsDeleteLayoutRequest::get_struct_layout_id(project_symbols_delete_layout_request), "Failed to delete the symbol layout."))
        }
    }
    state save(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_delete_layout_request: &ProjectSymbolsDeleteLayoutRequest) -> ProjectSymbolsDeleteLayoutResponse {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        let opened_project: &mut Project = ProjectManager::borrow_opened_project_mut(project_manager);
        transition ProjectSymbolCatalogPersistence::save_and_sync_project_symbol_catalog(engine_bindings, opened_project) {
            true -> succeed(project_symbols_delete_layout_request)
            _ -> (fail(ProjectSymbolsDeleteLayoutRequest::get_struct_layout_id(project_symbols_delete_layout_request), "Failed to save and sync project symbol catalog."))
        }
    }
    state succeed(project_symbols_delete_layout_request: &ProjectSymbolsDeleteLayoutRequest) -> ProjectSymbolsDeleteLayoutResponse {
        let mut response: ProjectSymbolsDeleteLayoutResponse = ProjectSymbolsDeleteLayoutResponse::new();
        ProjectSymbolsDeleteLayoutResponse::set_success(&mut response, true);
        ProjectSymbolsDeleteLayoutResponse::set_struct_layout_id(&mut response, ProjectSymbolsDeleteLayoutRequest::get_struct_layout_id(project_symbols_delete_layout_request));
        (response)
    }
    state fail(id: &[u8], message: &[u8]) -> ProjectSymbolsDeleteLayoutResponse {
        let mut response: ProjectSymbolsDeleteLayoutResponse = ProjectSymbolsDeleteLayoutResponse::new();
        ProjectSymbolsDeleteLayoutResponse::set_struct_layout_id(&mut response, id);
        ProjectSymbolsDeleteLayoutResponse::set_error(&mut response, message);
        (response)
    }
}
