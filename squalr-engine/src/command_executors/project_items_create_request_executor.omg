use squalr_engine_api::src::structures::memory::symbolic_pointer_chain::SymbolicPointerChainLink;
use squalr_engine_api::src::structures::memory::symbolic_pointer_chain::PointerChainSymbol;
use squalr_engine_api::src::structures::structs::owned_symbolic_pointer_chain::OwnedSymbolicPointerChain;
