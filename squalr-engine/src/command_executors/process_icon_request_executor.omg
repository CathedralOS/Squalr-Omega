use {omega}/language/core/filesystem_authority.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/commands/process/icon/process_icon_request.omg;
use {squalr_engine_api}/src/commands/process/icon/process_icon_response.omg;
use {squalr_engine_api}/src/structures/processes/process_info.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/os/engine_os_provider.omg;
use {squalr_engine_targets}/src/process_query/process_query_options.omg;
use {squalr_engine_targets}/src/target_providers.omg;

// Port of command_executors/process/icon/process_icon_request_executor.rs —
// one provider sweep per unique pid with fetch_icons set, then an entry per
// id. `process_icon` is always absent here: the port's ProcessInfo drops
// upstream's icon field (GUI payload, unported — see
// linux_process_query.omg), so fetch_icons is a documented no-op and every
// entry lands has_process_icon = false. Upstream's HashSet dedup is a
// linear scan over the entries already written (the request is 64-bounded).
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ProcessIconRequestExecutor {}

public linux_x86_64 machine ProcessIconRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    request: &|process_icon_request|::ProcessIconRequest
) -> |process_icon_response|::ProcessIconResponse
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
crashes Trap
{
    let response: |process_icon_response|::ProcessIconResponse = |process_icon_response|::ProcessIconResponse::new();
    transition { _ -> each(engine_privileged_state, request, response, 0) }

    machine each(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|process_icon_request|::ProcessIconRequest,
        mut response: |process_icon_response|::ProcessIconResponse,
        position: u64
    ) -> |process_icon_response|::ProcessIconResponse {
        let hoist1: u64 = |process_icon_request|::ProcessIconRequest::get_process_id_count(&request);
        transition position < hoist1 && position < 64 {
            true -> seen(engine_privileged_state, request, response, position, 0)
            false -> (response)
            _ -> (response)
        }
    }

    // Dedup scan: skip pids already covered by an earlier entry.
    machine seen(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|process_icon_request|::ProcessIconRequest,
        response: |process_icon_response|::ProcessIconResponse,
        position: u64,
        earlier: u64
    ) -> |process_icon_response|::ProcessIconResponse
        requires 0 <= position && position < 64
    {
        transition earlier < position {
            true -> compare(engine_privileged_state, request, response, position, earlier)
            false -> query(engine_privileged_state, request, response, position)
            _ -> query(engine_privileged_state, request, response, position)
        }
    }

    machine compare(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|process_icon_request|::ProcessIconRequest,
        response: |process_icon_response|::ProcessIconResponse,
        position: u64,
        earlier: u64
    ) -> |process_icon_response|::ProcessIconResponse
        requires 0 <= position && position < 64 && earlier < position
    {
        let hoist3: u32 = |process_icon_request|::ProcessIconRequest::get_process_id(&request, position);
        let hoist2: u32 = |process_icon_request|::ProcessIconRequest::get_process_id(&request, earlier);
        transition hoist2 == hoist3 {
            true -> next(engine_privileged_state, request, response, position)
            false -> seen(engine_privileged_state, request, response, position, earlier + 1)
            _ -> seen(engine_privileged_state, request, response, position, earlier + 1)
        }
    }

    machine query(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|process_icon_request|::ProcessIconRequest,
        mut response: |process_icon_response|::ProcessIconResponse,
        position: u64
    ) -> |process_icon_response|::ProcessIconResponse
        requires 0 <= position && position < 64
    {
        let mut found: [|process_info|::ProcessInfo; 1];
        let process_id: u32 = |process_icon_request|::ProcessIconRequest::get_process_id(&request, position);
        let options: |process_query_options|::ProcessQueryOptions = |process_query_options|::ProcessQueryOptions {
            required_process_id: |process_query_options|::RequiredProcessId::Required { process_id: process_id },
            search_name: |process_query_options|::ProcessNameSearch::Any,
            require_windowed: false,
            match_case: false,
            fetch_icons: true,
            limit: |process_query_options|::ProcessQueryLimit::Limited { limit: 1 }
        };
        // The sweep only fetches the icon upstream stored on ProcessInfo —
        // unported payload, so the outcome rides the discard and every id
        // gets its entry with the icon leg absent (upstream still emits an
        // entry per unique id, found or not).
        let providers: &mut |engine_os_provider|::EngineOsProviders = |engine_privileged_state|::EnginePrivilegedState::get_os_providers(&mut engine_privileged_state);
        _ = |engine_os_provider|::EngineOsProviders::get_processes(providers, options, &mut found);
        let entry: |process_icon_response|::ProcessIconEntry = |process_icon_response|::ProcessIconEntry {
            process_id: process_id,
            has_process_icon: false
        };
        _ = |process_icon_response|::ProcessIconResponse::add_process_icon_entry(&mut response, entry);
        transition { _ -> next(engine_privileged_state, request, response, position) }
    }

    machine next(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|process_icon_request|::ProcessIconRequest,
        response: |process_icon_response|::ProcessIconResponse,
        position: u64
    ) -> |process_icon_response|::ProcessIconResponse
        requires 0 <= position && position < 64
    {
        transition { _ -> each(engine_privileged_state, request, response, position + 1) }
    }
}
