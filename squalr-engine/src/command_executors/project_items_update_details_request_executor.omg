module src::command_executors::project_items_update_details_request_executor;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::project_items::update_details::project_items_update_details_request::ProjectItemsUpdateDetailsRequest;
use squalr_engine_api::src::commands::project_items::update_details::project_items_update_details_response::ProjectItemsUpdateDetailsPathChange;
use squalr_engine_api::src::commands::project_items::update_details::project_items_update_details_response::ProjectItemsUpdateDetailsResponse;
use squalr_engine_api::src::structures::data_values::anonymous_value_string::AnonymousValueString;
use squalr_engine_api::src::structures::details::details_field::DetailsFieldSource;
use squalr_engine_api::src::structures::details::details_field::DetailsValue;
use squalr_engine_api::src::structures::projects::project::Project;
use squalr_engine_api::src::structures::projects::project::ProjectItemLookup;
use squalr_engine_api::src::structures::projects::project_info::ProjectInfo;
use squalr_engine_api::src::structures::projects::project_items::details::project_item_details_edit_applier::ProjectItemDetailsEditApplier;
use squalr_engine_api::src::structures::projects::project_items::project_item::ProjectItem;
use squalr_engine_api::src::structures::projects::project_items::project_item_pair::ProjectItemPair;
use squalr_engine_api::src::structures::projects::project_items::project_item_ref::ProjectItemRef;
use squalr_engine_api::src::structures::projects::project_items::project_item_type_ref::ProjectItemTypeRef;
use squalr_engine_api::src::structures::projects::project_path_list::ProjectPathList;
