module src::command_executors::debugger_trace_list_request_executor;

use squalr_engine_api::src::commands::debugger::trace_list::debugger_trace_list_request::DebuggerTraceListRequest;
use squalr_engine_api::src::commands::debugger::trace_list::debugger_trace_list_response::DebuggerTraceListResponse;
use squalr_engine_session::src::debugger::debugger_service::DebuggerTraceListOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/debugger/mod.rs::DebuggerTraceListRequest —
// service.list_trace_sessions -> (sessions, instruction_records). The
// bounded service collection cannot fail, so upstream's Err arm is
// unreachable in the port (documented).
pub data DebuggerTraceListRequestExecutor {}

pub machine DebuggerTraceListRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_trace_list_request: &DebuggerTraceListRequest
) -> DebuggerTraceListResponse {
    let outcome: DebuggerTraceListOutcome = engine_privileged_state.debugger_list_trace_sessions();
    transition { _ -> sessions(DebuggerTraceListResponse::new(), outcome, 0) }

    state sessions(response: DebuggerTraceListResponse, outcome: DebuggerTraceListOutcome, position: u64) -> DebuggerTraceListResponse {
        transition position < outcome.trace_session_count && position < 16 {
            true -> session(response, outcome, position)
            _ -> records(response, outcome, 0)
        }
    }

    state session(mut response: DebuggerTraceListResponse, outcome: DebuggerTraceListOutcome, position: u64) -> DebuggerTraceListResponse
        requires position < 16
    {
        _ = response.add_trace_session(&outcome.trace_sessions[position]);
        transition { _ -> sessions(response, outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state records(response: DebuggerTraceListResponse, outcome: DebuggerTraceListOutcome, position: u64) -> DebuggerTraceListResponse {
        transition position < outcome.instruction_record_count && position < 16 {
            true -> record(response, outcome, position)
            _ -> (response)
        }
    }

    state record(mut response: DebuggerTraceListResponse, outcome: DebuggerTraceListOutcome, position: u64) -> DebuggerTraceListResponse
        requires position < 16
    {
        _ = response.add_instruction_record(&outcome.instruction_records[position]);
        transition { _ -> records(response, outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}
