use {squalr_engine_api}/src/commands/debugger/trace_list/debugger_trace_list_request.omg;
use {squalr_engine_api}/src/commands/debugger/trace_list/debugger_trace_list_response.omg;
use {squalr_engine_session}/src/debugger/debugger_service.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/debugger/mod.rs::DebuggerTraceListRequest —
// service.list_trace_sessions -> (sessions, instruction_records). The
// bounded service collection cannot fail, so upstream's Err arm is
// unreachable in the port (documented).
public data DebuggerTraceListRequestExecutor {}

public machine DebuggerTraceListRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    debugger_trace_list_request: &|debugger_trace_list_request|::DebuggerTraceListRequest
) -> |debugger_trace_list_response|::DebuggerTraceListResponse {
    let outcome: |debugger_service|::DebuggerTraceListOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_list_trace_sessions(&engine_privileged_state);
    transition { _ -> sessions(|debugger_trace_list_response|::DebuggerTraceListResponse::new(), outcome, 0) }

    machine sessions(response: |debugger_trace_list_response|::DebuggerTraceListResponse, outcome: |debugger_service|::DebuggerTraceListOutcome, position: u64) -> |debugger_trace_list_response|::DebuggerTraceListResponse {
        transition position < outcome.trace_session_count && position < 16 {
            true -> session(response, outcome, position)
            _ -> records(response, outcome, 0)
        }
    }

    machine session(mut response: |debugger_trace_list_response|::DebuggerTraceListResponse, outcome: |debugger_service|::DebuggerTraceListOutcome, position: u64) -> |debugger_trace_list_response|::DebuggerTraceListResponse
        requires position < 16
    {
        _ = |debugger_trace_list_response|::DebuggerTraceListResponse::add_trace_session(&mut response, &outcome.trace_sessions[position]);
        transition { _ -> sessions(response, outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    machine records(response: |debugger_trace_list_response|::DebuggerTraceListResponse, outcome: |debugger_service|::DebuggerTraceListOutcome, position: u64) -> |debugger_trace_list_response|::DebuggerTraceListResponse {
        transition position < outcome.instruction_record_count && position < 16 {
            true -> record(response, outcome, position)
            _ -> (response)
        }
    }

    machine record(mut response: |debugger_trace_list_response|::DebuggerTraceListResponse, outcome: |debugger_service|::DebuggerTraceListOutcome, position: u64) -> |debugger_trace_list_response|::DebuggerTraceListResponse
        requires position < 16
    {
        _ = |debugger_trace_list_response|::DebuggerTraceListResponse::add_instruction_record(&mut response, &outcome.instruction_records[position]);
        transition { _ -> records(response, outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}
