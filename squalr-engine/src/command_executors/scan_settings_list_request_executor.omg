use {squalr_engine_api}/src/commands/settings/scan/list/scan_settings_list_request.omg;
use {squalr_engine_api}/src/commands/settings/scan/list/scan_settings_list_response.omg;
use {squalr_engine_api}/src/structures/settings/scan_settings.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/settings/scan/list/scan_settings_list_request_executor.rs —
// upstream clones the full settings out of ScanSettingsStore::get_scan_settings();
// the upstream read-lock failure arm (`Err(SettingsError::read_failure("scan"))`) is unreachable: the port reads a session field, not a shared lock. Upstream's `Ok(...)` arm is the only reachable case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ScanSettingsListRequestExecutor {}

public machine ScanSettingsListRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    scan_settings_list_request: &|scan_settings_list_request|::ScanSettingsListRequest
) -> |scan_settings_list_response|::ScanSettingsListResponse {
    let settings: |scan_settings|::ScanSettings = |engine_privileged_state|::EnginePrivilegedState::get_scan_settings(&engine_privileged_state);
    let result: |scan_settings_list_response|::ScanSettingsResult = |scan_settings_list_response|::ScanSettingsResult::new_ok(settings);
    (|scan_settings_list_response|::ScanSettingsListResponse::new(result))
}
