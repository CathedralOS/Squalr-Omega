module src::command_executors::scan_settings_list_request_executor;

use squalr_engine_api::src::commands::settings::scan::list::scan_settings_list_request::ScanSettingsListRequest;
use squalr_engine_api::src::commands::settings::scan::list::scan_settings_list_response::ScanSettingsListResponse;
use squalr_engine_api::src::commands::settings::scan::list::scan_settings_list_response::ScanSettingsResult;
use squalr_engine_api::src::structures::settings::scan_settings::ScanSettings;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/settings/scan/list/scan_settings_list_request_executor.rs —
// upstream clones the full settings out of ScanSettingsStore::get_scan_settings();
// the upstream read-lock failure arm (`Err(SettingsError::read_failure("scan"))`) is unreachable: the port reads a session field, not a shared lock. Upstream's `Ok(...)` arm is the only reachable case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ScanSettingsListRequestExecutor {}

pub machine ScanSettingsListRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    scan_settings_list_request: &ScanSettingsListRequest
) -> ScanSettingsListResponse {
    let settings: ScanSettings = EnginePrivilegedState::get_scan_settings(&engine_privileged_state);
    let result: ScanSettingsResult = ScanSettingsResult::new_ok(settings);
    (ScanSettingsListResponse::new(result))
}
