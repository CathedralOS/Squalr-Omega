use src/command_executors/debugger_trace_stop_request_executor.omg;

// Port of command_executors/debugger/mod.rs::DebuggerCommand — routes the
// debugger command union to the per-leaf executor and wraps each typed
// response in the matching `DebuggerResponse` case. Software breakpoint
// remove/set paths reach the patch service, so the machine declares the
// PosixFilesystemHost surface like the patches router.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data DebuggerCommandExecutor {}

public machine DebuggerCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    debugger_command: &|debugger_command|::DebuggerCommand
) -> |debugger_response|::DebuggerResponse
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    transition debugger_command {
        |debugger_command|::DebuggerCommand::Attach { request } -> leaf_attach(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::Detach { request } -> leaf_detach(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::Pause { request } -> leaf_pause(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::Resume { request } -> leaf_resume(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::BreakpointSet { request } -> leaf_breakpoint_set(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::BreakpointRemove { request } -> leaf_breakpoint_remove(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::BreakpointList { request } -> leaf_breakpoint_list(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::RegistersRead { request } -> leaf_registers_read(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::RegisterWrite { request } -> leaf_register_write(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::TraceStart { request } -> leaf_trace_start(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::TraceStop { request } -> leaf_trace_stop(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::TracePause { request } -> leaf_trace_pause(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::TraceResume { request } -> leaf_trace_resume(engine_privileged_state, &request)
        |debugger_command|::DebuggerCommand::TraceList { request } -> leaf_trace_list(engine_privileged_state, &request)
    }

    machine leaf_attach(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_attach_request|::DebuggerAttachRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_attach_response|::DebuggerAttachResponse = |debugger_attach_request_executor|::DebuggerAttachRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::Attach { response: response }) }
    }

    machine leaf_detach(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_detach_request|::DebuggerDetachRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_detach_response|::DebuggerDetachResponse = |debugger_detach_request_executor|::DebuggerDetachRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::Detach { response: response }) }
    }

    machine leaf_pause(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_pause_request|::DebuggerPauseRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_pause_response|::DebuggerPauseResponse = |debugger_pause_request_executor|::DebuggerPauseRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::Pause { response: response }) }
    }

    machine leaf_resume(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_resume_request|::DebuggerResumeRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_resume_response|::DebuggerResumeResponse = |debugger_resume_request_executor|::DebuggerResumeRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::Resume { response: response }) }
    }

    machine leaf_breakpoint_set(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_breakpoint_set_request|::DebuggerBreakpointSetRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse = |debugger_breakpoint_set_request_executor|::DebuggerBreakpointSetRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::BreakpointSet { response: response }) }
    }

    machine leaf_breakpoint_remove(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_breakpoint_remove_request|::DebuggerBreakpointRemoveRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse = |debugger_breakpoint_remove_request_executor|::DebuggerBreakpointRemoveRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::BreakpointRemove { response: response }) }
    }

    machine leaf_breakpoint_list(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_breakpoint_list_request|::DebuggerBreakpointListRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse = |debugger_breakpoint_list_request_executor|::DebuggerBreakpointListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::BreakpointList { response: response }) }
    }

    machine leaf_registers_read(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_registers_read_request|::DebuggerRegistersReadRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_registers_read_response|::DebuggerRegistersReadResponse = |debugger_registers_read_request_executor|::DebuggerRegistersReadRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::RegistersRead { response: response }) }
    }

    machine leaf_register_write(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_register_write_request|::DebuggerRegisterWriteRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_register_write_response|::DebuggerRegisterWriteResponse = |debugger_register_write_request_executor|::DebuggerRegisterWriteRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::RegisterWrite { response: response }) }
    }

    machine leaf_trace_start(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_trace_start_request|::DebuggerTraceStartRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_trace_start_response|::DebuggerTraceStartResponse = |debugger_trace_start_request_executor|::DebuggerTraceStartRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::TraceStart { response: response }) }
    }

    machine leaf_trace_stop(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_trace_stop_request|::DebuggerTraceStopRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_trace_stop_response|::DebuggerTraceStopResponse = |debugger_trace_stop_request_executor|::DebuggerTraceStopRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::TraceStop { response: response }) }
    }

    machine leaf_trace_pause(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_trace_pause_request|::DebuggerTracePauseRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_trace_pause_response|::DebuggerTracePauseResponse = |debugger_trace_pause_request_executor|::DebuggerTracePauseRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::TracePause { response: response }) }
    }

    machine leaf_trace_resume(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_trace_resume_request|::DebuggerTraceResumeRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_trace_resume_response|::DebuggerTraceResumeResponse = |debugger_trace_resume_request_executor|::DebuggerTraceResumeRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::TraceResume { response: response }) }
    }

    machine leaf_trace_list(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|debugger_trace_list_request|::DebuggerTraceListRequest
    ) -> |debugger_response|::DebuggerResponse {
        let response: |debugger_trace_list_response|::DebuggerTraceListResponse = |debugger_trace_list_request_executor|::DebuggerTraceListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|debugger_response|::DebuggerResponse::TraceList { response: response }) }
    }
}
