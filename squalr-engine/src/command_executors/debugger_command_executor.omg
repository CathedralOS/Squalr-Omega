use squalr_engine_api::src::commands::debugger::attach::debugger_attach_request::DebuggerAttachRequest;
use squalr_engine_api::src::commands::debugger::attach::debugger_attach_response::DebuggerAttachResponse;
use squalr_engine_api::src::commands::debugger::breakpoint_list::debugger_breakpoint_list_request::DebuggerBreakpointListRequest;
use squalr_engine_api::src::commands::debugger::breakpoint_list::debugger_breakpoint_list_response::DebuggerBreakpointListResponse;
use squalr_engine_api::src::commands::debugger::breakpoint_remove::debugger_breakpoint_remove_request::DebuggerBreakpointRemoveRequest;
use squalr_engine_api::src::commands::debugger::breakpoint_remove::debugger_breakpoint_remove_response::DebuggerBreakpointRemoveResponse;
use squalr_engine_api::src::commands::debugger::breakpoint_set::debugger_breakpoint_set_request::DebuggerBreakpointSetRequest;
use squalr_engine_api::src::commands::debugger::breakpoint_set::debugger_breakpoint_set_response::DebuggerBreakpointSetResponse;
use squalr_engine_api::src::commands::debugger::detach::debugger_detach_request::DebuggerDetachRequest;
use squalr_engine_api::src::commands::debugger::detach::debugger_detach_response::DebuggerDetachResponse;
use squalr_engine_api::src::commands::debugger::pause::debugger_pause_request::DebuggerPauseRequest;
use squalr_engine_api::src::commands::debugger::pause::debugger_pause_response::DebuggerPauseResponse;
use squalr_engine_api::src::commands::debugger::register_write::debugger_register_write_request::DebuggerRegisterWriteRequest;
use squalr_engine_api::src::commands::debugger::register_write::debugger_register_write_response::DebuggerRegisterWriteResponse;
use squalr_engine_api::src::commands::debugger::registers_read::debugger_registers_read_request::DebuggerRegistersReadRequest;
use squalr_engine_api::src::commands::debugger::registers_read::debugger_registers_read_response::DebuggerRegistersReadResponse;
use squalr_engine_api::src::commands::debugger::resume::debugger_resume_request::DebuggerResumeRequest;
use squalr_engine_api::src::commands::debugger::resume::debugger_resume_response::DebuggerResumeResponse;
use squalr_engine_api::src::commands::debugger::trace_list::debugger_trace_list_request::DebuggerTraceListRequest;
use squalr_engine_api::src::commands::debugger::trace_list::debugger_trace_list_response::DebuggerTraceListResponse;
use squalr_engine_api::src::commands::debugger::trace_pause::debugger_trace_pause_request::DebuggerTracePauseRequest;
use squalr_engine_api::src::commands::debugger::trace_pause::debugger_trace_pause_response::DebuggerTracePauseResponse;
use squalr_engine_api::src::commands::debugger::trace_resume::debugger_trace_resume_request::DebuggerTraceResumeRequest;
use squalr_engine_api::src::commands::debugger::trace_resume::debugger_trace_resume_response::DebuggerTraceResumeResponse;
use squalr_engine_api::src::commands::debugger::trace_start::debugger_trace_start_request::DebuggerTraceStartRequest;
use squalr_engine_api::src::commands::debugger::trace_start::debugger_trace_start_response::DebuggerTraceStartResponse;
use squalr_engine_api::src::commands::debugger::trace_stop::debugger_trace_stop_request::DebuggerTraceStopRequest;
use squalr_engine_api::src::commands::debugger::trace_stop::debugger_trace_stop_response::DebuggerTraceStopResponse;
use src::command_executors::debugger_attach_request_executor::DebuggerAttachRequestExecutor;
use src::command_executors::debugger_breakpoint_list_request_executor::DebuggerBreakpointListRequestExecutor;
use src::command_executors::debugger_breakpoint_remove_request_executor::DebuggerBreakpointRemoveRequestExecutor;
use src::command_executors::debugger_breakpoint_set_request_executor::DebuggerBreakpointSetRequestExecutor;
use src::command_executors::debugger_detach_request_executor::DebuggerDetachRequestExecutor;
use src::command_executors::debugger_pause_request_executor::DebuggerPauseRequestExecutor;
use src::command_executors::debugger_register_write_request_executor::DebuggerRegisterWriteRequestExecutor;
use src::command_executors::debugger_registers_read_request_executor::DebuggerRegistersReadRequestExecutor;
use src::command_executors::debugger_resume_request_executor::DebuggerResumeRequestExecutor;
use src::command_executors::debugger_trace_list_request_executor::DebuggerTraceListRequestExecutor;
use src::command_executors::debugger_trace_pause_request_executor::DebuggerTracePauseRequestExecutor;
use src::command_executors::debugger_trace_resume_request_executor::DebuggerTraceResumeRequestExecutor;
use src::command_executors::debugger_trace_start_request_executor::DebuggerTraceStartRequestExecutor;
use src::command_executors::debugger_trace_stop_request_executor::DebuggerTraceStopRequestExecutor;

// Port of command_executors/debugger/mod.rs::DebuggerCommand — routes the
// debugger command union to the per-leaf executor and wraps each typed
// response in the matching `DebuggerResponse` case. Software breakpoint
// remove/set paths reach the patch service, so the machine declares the
// FilesystemHost surface like the patches router.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data DebuggerCommandExecutor {}

pub machine DebuggerCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_command: &DebuggerCommand
) -> DebuggerResponse
reaches FilesystemHost
invokes FilesystemHost;
{
    transition debugger_command {
        DebuggerCommand::Attach { request } -> leaf_attach(engine_privileged_state, &request)
        DebuggerCommand::Detach { request } -> leaf_detach(engine_privileged_state, &request)
        DebuggerCommand::Pause { request } -> leaf_pause(engine_privileged_state, &request)
        DebuggerCommand::Resume { request } -> leaf_resume(engine_privileged_state, &request)
        DebuggerCommand::BreakpointSet { request } -> leaf_breakpoint_set(engine_privileged_state, &request)
        DebuggerCommand::BreakpointRemove { request } -> leaf_breakpoint_remove(engine_privileged_state, &request)
        DebuggerCommand::BreakpointList { request } -> leaf_breakpoint_list(engine_privileged_state, &request)
        DebuggerCommand::RegistersRead { request } -> leaf_registers_read(engine_privileged_state, &request)
        DebuggerCommand::RegisterWrite { request } -> leaf_register_write(engine_privileged_state, &request)
        DebuggerCommand::TraceStart { request } -> leaf_trace_start(engine_privileged_state, &request)
        DebuggerCommand::TraceStop { request } -> leaf_trace_stop(engine_privileged_state, &request)
        DebuggerCommand::TracePause { request } -> leaf_trace_pause(engine_privileged_state, &request)
        DebuggerCommand::TraceResume { request } -> leaf_trace_resume(engine_privileged_state, &request)
        DebuggerCommand::TraceList { request } -> leaf_trace_list(engine_privileged_state, &request)
    }

    state leaf_attach(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerAttachRequest
    ) -> DebuggerResponse {
        let response: DebuggerAttachResponse = DebuggerAttachRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::Attach { response: response }) }
    }

    state leaf_detach(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerDetachRequest
    ) -> DebuggerResponse {
        let response: DebuggerDetachResponse = DebuggerDetachRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::Detach { response: response }) }
    }

    state leaf_pause(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerPauseRequest
    ) -> DebuggerResponse {
        let response: DebuggerPauseResponse = DebuggerPauseRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::Pause { response: response }) }
    }

    state leaf_resume(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerResumeRequest
    ) -> DebuggerResponse {
        let response: DebuggerResumeResponse = DebuggerResumeRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::Resume { response: response }) }
    }

    state leaf_breakpoint_set(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerBreakpointSetRequest
    ) -> DebuggerResponse {
        let response: DebuggerBreakpointSetResponse = DebuggerBreakpointSetRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::BreakpointSet { response: response }) }
    }

    state leaf_breakpoint_remove(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerBreakpointRemoveRequest
    ) -> DebuggerResponse {
        let response: DebuggerBreakpointRemoveResponse = DebuggerBreakpointRemoveRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::BreakpointRemove { response: response }) }
    }

    state leaf_breakpoint_list(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerBreakpointListRequest
    ) -> DebuggerResponse {
        let response: DebuggerBreakpointListResponse = DebuggerBreakpointListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::BreakpointList { response: response }) }
    }

    state leaf_registers_read(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerRegistersReadRequest
    ) -> DebuggerResponse {
        let response: DebuggerRegistersReadResponse = DebuggerRegistersReadRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::RegistersRead { response: response }) }
    }

    state leaf_register_write(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerRegisterWriteRequest
    ) -> DebuggerResponse {
        let response: DebuggerRegisterWriteResponse = DebuggerRegisterWriteRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::RegisterWrite { response: response }) }
    }

    state leaf_trace_start(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerTraceStartRequest
    ) -> DebuggerResponse {
        let response: DebuggerTraceStartResponse = DebuggerTraceStartRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::TraceStart { response: response }) }
    }

    state leaf_trace_stop(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerTraceStopRequest
    ) -> DebuggerResponse {
        let response: DebuggerTraceStopResponse = DebuggerTraceStopRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::TraceStop { response: response }) }
    }

    state leaf_trace_pause(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerTracePauseRequest
    ) -> DebuggerResponse {
        let response: DebuggerTracePauseResponse = DebuggerTracePauseRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::TracePause { response: response }) }
    }

    state leaf_trace_resume(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerTraceResumeRequest
    ) -> DebuggerResponse {
        let response: DebuggerTraceResumeResponse = DebuggerTraceResumeRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::TraceResume { response: response }) }
    }

    state leaf_trace_list(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &DebuggerTraceListRequest
    ) -> DebuggerResponse {
        let response: DebuggerTraceListResponse = DebuggerTraceListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (DebuggerResponse::TraceList { response: response }) }
    }
}
