use {squalr_engine_api}/src/commands/debugger/trace_stop/debugger_trace_stop_response.omg;
use src/command_executors/debugger_attach_request_executor.omg;
use src/command_executors/debugger_breakpoint_list_request_executor.omg;
use src/command_executors/debugger_breakpoint_remove_request_executor.omg;
use src/command_executors/debugger_breakpoint_set_request_executor.omg;
