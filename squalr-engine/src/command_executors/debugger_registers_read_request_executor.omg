module src::command_executors::debugger_registers_read_request_executor;

use squalr_engine_api::src::commands::debugger::registers_read::debugger_registers_read_request::DebuggerRegistersReadRequest;
use squalr_engine_api::src::commands::debugger::registers_read::debugger_registers_read_response::DebuggerRegistersReadResponse;
use squalr_engine_api::src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use squalr_engine_api::src::structures::debugger::debugger_register_snapshot::DebuggerRegisterSnapshot;
use squalr_engine_session::src::debugger::debugger_service::DebuggerRegisterOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/debugger/mod.rs::DebuggerRegistersReadRequest —
// service.read_registers -> Some(snapshot) / Err -> failure + absent slot.
pub data DebuggerRegistersReadRequestExecutor {}

pub machine DebuggerRegistersReadRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_registers_read_request: &DebuggerRegistersReadRequest
) -> DebuggerRegistersReadResponse {
    let outcome: DebuggerRegisterOutcome = EnginePrivilegedState::debugger_read_registers(&mut engine_privileged_state);
    transition outcome.succeeded {
        true -> succeeded(outcome)
        _ -> failed(outcome)
    }

    state succeeded(outcome: DebuggerRegisterOutcome) -> DebuggerRegistersReadResponse {
        let mut response: DebuggerRegistersReadResponse = DebuggerRegistersReadResponse::new();
        DebuggerRegistersReadResponse::set_register_snapshot(&mut response, DebuggerRegisterSnapshot::clone(&outcome.register_snapshot));
        (response)
    }

    state failed(outcome: DebuggerRegisterOutcome) -> DebuggerRegistersReadResponse {
        let mut response: DebuggerRegistersReadResponse = DebuggerRegistersReadResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        DebuggerCommandStatus::set_message(&mut status, DebuggerRegisterOutcome::get_error_message(outcome));
        DebuggerRegistersReadResponse::set_status(&mut response, status);
        (response)
    }
}
