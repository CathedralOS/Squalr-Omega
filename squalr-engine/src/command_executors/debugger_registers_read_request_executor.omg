use {squalr_engine_api}/src/commands/debugger/registers_read/debugger_registers_read_request.omg;
use {squalr_engine_api}/src/commands/debugger/registers_read/debugger_registers_read_response.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_command_status.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_register_snapshot.omg;
use {squalr_engine_session}/src/debugger/debugger_service.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/debugger/mod.rs::DebuggerRegistersReadRequest —
// service.read_registers -> Some(snapshot) / Err -> failure + absent slot.
public data DebuggerRegistersReadRequestExecutor {}

public machine DebuggerRegistersReadRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    debugger_registers_read_request: &|debugger_registers_read_request|::DebuggerRegistersReadRequest
) -> |debugger_registers_read_response|::DebuggerRegistersReadResponse {
    let outcome: |debugger_service|::DebuggerRegisterOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_read_registers(&mut engine_privileged_state);
    transition outcome.succeeded {
        true -> succeeded(outcome)
        _ -> failed(outcome)
    }

    machine succeeded(outcome: |debugger_service|::DebuggerRegisterOutcome) -> |debugger_registers_read_response|::DebuggerRegistersReadResponse {
        let mut response: |debugger_registers_read_response|::DebuggerRegistersReadResponse = |debugger_registers_read_response|::DebuggerRegistersReadResponse::new();
        |debugger_registers_read_response|::DebuggerRegistersReadResponse::set_register_snapshot(&mut response, |debugger_register_snapshot|::DebuggerRegisterSnapshot::clone(&outcome.register_snapshot));
        (response)
    }

    machine failed(outcome: |debugger_service|::DebuggerRegisterOutcome) -> |debugger_registers_read_response|::DebuggerRegistersReadResponse {
        let mut response: |debugger_registers_read_response|::DebuggerRegistersReadResponse = |debugger_registers_read_response|::DebuggerRegistersReadResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, |debugger_service|::DebuggerRegisterOutcome::get_error_message(outcome));
        |debugger_registers_read_response|::DebuggerRegistersReadResponse::set_status(&mut response, status);
        (response)
    }
}
