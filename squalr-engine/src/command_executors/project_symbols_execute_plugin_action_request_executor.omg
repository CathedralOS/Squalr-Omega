module src::command_executors::project_symbols_execute_plugin_action_request_executor;

use squalr_engine_api::src::commands::project_symbols::execute_plugin_action::project_symbols_execute_plugin_action_request::ProjectSymbolsExecutePluginActionRequest;
use squalr_engine_api::src::commands::project_symbols::execute_plugin_action::project_symbols_execute_plugin_action_response::ProjectSymbolsExecutePluginActionResponse;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use src::engine_bindings::standalone_engine_api_unprivileged_bindings::StandaloneEngineApiUnprivilegedBindings;

// Port of command_executors/project_symbols/execute_plugin_action/
// project_symbols_execute_plugin_action_request_executor.rs — resolve the
// enabled Symbol Tree action from the plugin registry and execute it
// against engine-backed SymbolTreeActionServices.
// Named deviation (plugin-host boundary): the registry's action-enumeration
// surface (`get_enabled_symbol_tree_actions`,
// `plugin_action_has_required_permissions`) and the plugin's dyn action
// dispatch arrive with the plugin-host leg — the api PluginMetadata table
// carries no Symbol Tree action descriptors, and `SymbolTreeAction::execute`
// is a plugin-provided dyn method there is no host to call through. The
// port therefore lands on upstream's own "could not resolve" error arm
// (the arm upstream takes when an action is absent from the enabled set) —
// it is a real upstream refusal path, not a placeholder success; plugin
// actions become executable when the plugin-host surface lands.
pub data ProjectSymbolsExecutePluginActionRequestExecutor {}

pub linux_x86_64 machine ProjectSymbolsExecutePluginActionRequestExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_symbols_execute_plugin_action_request: &ProjectSymbolsExecutePluginActionRequest
) -> ProjectSymbolsExecutePluginActionResponse
crashes Abort
crashes Trap
{
    let mut response: ProjectSymbolsExecutePluginActionResponse = ProjectSymbolsExecutePluginActionResponse::new();
    ProjectSymbolsExecutePluginActionResponse::set_error(&mut response, "Could not resolve the Symbol Tree action — the plugin-host action surface is not ported yet.");
    (response)
}
