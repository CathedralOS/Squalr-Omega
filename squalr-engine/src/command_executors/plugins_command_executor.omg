module src::command_executors::plugins_command_executor;

use squalr_engine_api::src::commands::plugins::list::plugin_list_request::PluginListRequest;
use squalr_engine_api::src::commands::plugins::list::plugin_list_response::PluginListResponse;
use squalr_engine_api::src::commands::plugins::plugins_command::PluginsCommand;
use squalr_engine_api::src::commands::plugins::plugins_response::PluginsResponse;
use squalr_engine_api::src::commands::plugins::set_enabled::plugin_set_enabled_request::PluginSetEnabledRequest;
use squalr_engine_api::src::commands::plugins::set_enabled::plugin_set_enabled_response::PluginSetEnabledResponse;
use squalr_engine_api::src::commands::plugins::set_order::plugin_set_order_request::PluginSetOrderRequest;
use squalr_engine_api::src::commands::plugins::set_order::plugin_set_order_response::PluginSetOrderResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::plugin_list_request_executor::PluginListRequestExecutor;
use src::command_executors::plugin_set_enabled_request_executor::PluginSetEnabledRequestExecutor;
use src::command_executors::plugin_set_order_request_executor::PluginSetOrderRequestExecutor;

// Port of command_executors/plugins/plugins_command_executor.rs — routes
// the plugins command union to the per-leaf executor and wraps each
// typed response in the matching `PluginsResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data PluginsCommandExecutor {}

pub machine PluginsCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    plugins_command: &PluginsCommand
) -> PluginsResponse {
    transition plugins_command {
        PluginsCommand::List { request } -> list(engine_privileged_state, &request)
        PluginsCommand::SetEnabled { request } -> set_enabled(engine_privileged_state, &request)
        PluginsCommand::SetOrder { request } -> set_order(engine_privileged_state, &request)
    }

    state list(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PluginListRequest
    ) -> PluginsResponse {
        let response: PluginListResponse = PluginListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PluginsResponse::List { response: response }) }
    }

    state set_enabled(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PluginSetEnabledRequest
    ) -> PluginsResponse {
        let response: PluginSetEnabledResponse = PluginSetEnabledRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PluginsResponse::SetEnabled { response: response }) }
    }

    state set_order(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PluginSetOrderRequest
    ) -> PluginsResponse {
        let response: PluginSetOrderResponse = PluginSetOrderRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PluginsResponse::SetOrder { response: response }) }
    }
}
