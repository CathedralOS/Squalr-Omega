use {squalr_engine_api}/src/commands/plugins/list/plugin_list_request.omg;
use {squalr_engine_api}/src/commands/plugins/list/plugin_list_response.omg;
use {squalr_engine_api}/src/commands/plugins/plugins_command.omg;
use {squalr_engine_api}/src/commands/plugins/plugins_response.omg;
use {squalr_engine_api}/src/commands/plugins/set_enabled/plugin_set_enabled_request.omg;
use {squalr_engine_api}/src/commands/plugins/set_enabled/plugin_set_enabled_response.omg;
use {squalr_engine_api}/src/commands/plugins/set_order/plugin_set_order_request.omg;
use {squalr_engine_api}/src/commands/plugins/set_order/plugin_set_order_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/plugin_list_request_executor.omg;
use src/command_executors/plugin_set_enabled_request_executor.omg;
use src/command_executors/plugin_set_order_request_executor.omg;

// Port of command_executors/plugins/plugins_command_executor.rs — routes
// the plugins command union to the per-leaf executor and wraps each
// typed response in the matching `PluginsResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data PluginsCommandExecutor {}

public machine PluginsCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    plugins_command: &|plugins_command|::PluginsCommand
) -> |plugins_response|::PluginsResponse {
    transition plugins_command {
        |plugins_command|::PluginsCommand::List { request } -> list(engine_privileged_state, &request)
        |plugins_command|::PluginsCommand::SetEnabled { request } -> set_enabled(engine_privileged_state, &request)
        |plugins_command|::PluginsCommand::SetOrder { request } -> set_order(engine_privileged_state, &request)
    }

    machine list(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|plugin_list_request|::PluginListRequest
    ) -> |plugins_response|::PluginsResponse {
        let response: |plugin_list_response|::PluginListResponse = |plugin_list_request_executor|::PluginListRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|plugins_response|::PluginsResponse::List { response: response }) }
    }

    machine set_enabled(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|plugin_set_enabled_request|::PluginSetEnabledRequest
    ) -> |plugins_response|::PluginsResponse {
        let response: |plugin_set_enabled_response|::PluginSetEnabledResponse = |plugin_set_enabled_request_executor|::PluginSetEnabledRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|plugins_response|::PluginsResponse::SetEnabled { response: response }) }
    }

    machine set_order(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|plugin_set_order_request|::PluginSetOrderRequest
    ) -> |plugins_response|::PluginsResponse {
        let response: |plugin_set_order_response|::PluginSetOrderResponse = |plugin_set_order_request_executor|::PluginSetOrderRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|plugins_response|::PluginsResponse::SetOrder { response: response }) }
    }
}
