module src::command_executors::debugger_attach_request_executor;

use squalr_engine_api::src::commands::debugger::attach::debugger_attach_request::DebuggerAttachRequest;
use squalr_engine_api::src::commands::debugger::attach::debugger_attach_response::DebuggerAttachResponse;
use squalr_engine_api::src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_session::src::debugger::debugger_service::DebuggerOperationOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/debugger/mod.rs::DebuggerAttachRequest — the
// opened-process guard, service.attach with the request's Option plugin_id
// (has_plugin_id + bounded span), then status/session_state/plugin id.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data DebuggerAttachRequestExecutor {}

pub machine DebuggerAttachRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_attach_request: &DebuggerAttachRequest
) -> DebuggerAttachResponse {
    let hoist1: bool = EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> attach(engine_privileged_state, debugger_attach_request)
        _ -> absent()
    }

    state absent() -> DebuggerAttachResponse {
        let mut response: DebuggerAttachResponse = DebuggerAttachResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        DebuggerCommandStatus::set_message(&mut status, "No opened process to debug.");
        DebuggerAttachResponse::set_status(&mut response, status);
        (response)
    }

    state attach(
        engine_privileged_state: &mut EnginePrivilegedState,
        debugger_attach_request: &DebuggerAttachRequest
    ) -> DebuggerAttachResponse {
        let opened_process_info: OpenedProcessInfo = EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        let has_plugin_id: bool = DebuggerAttachRequest::has_plugin_id(&debugger_attach_request);
        let plugin_id: &[u8] = DebuggerAttachRequest::get_plugin_id(&debugger_attach_request);
        let outcome: DebuggerOperationOutcome = EnginePrivilegedState::debugger_attach(&mut engine_privileged_state, &opened_process_info,
            has_plugin_id,
            plugin_id);
        transition outcome.succeeded {
            true -> succeeded(outcome)
            _ -> failed(outcome)
        }
    }

    state succeeded(outcome: DebuggerOperationOutcome) -> DebuggerAttachResponse {
        let mut response: DebuggerAttachResponse = DebuggerAttachResponse::new();
        DebuggerAttachResponse::set_session_state(&mut response, outcome.session_state);
        transition outcome.has_active_plugin_id {
            true -> fill_plugin_id(outcome, response)
            _ -> (response)
        }
    }

    state fill_plugin_id(outcome: DebuggerOperationOutcome, mut response: DebuggerAttachResponse) -> DebuggerAttachResponse {
        DebuggerAttachResponse::set_active_plugin_id(&mut response, DebuggerOperationOutcome::get_active_plugin_id(outcome));
        (response)
    }

    state failed(outcome: DebuggerOperationOutcome) -> DebuggerAttachResponse {
        let mut response: DebuggerAttachResponse = DebuggerAttachResponse::new();
        let mut status: DebuggerCommandStatus = DebuggerCommandStatus::failure();
        DebuggerCommandStatus::set_message(&mut status, DebuggerOperationOutcome::get_error_message(outcome));
        DebuggerAttachResponse::set_status(&mut response, status);
        (response)
    }
}
