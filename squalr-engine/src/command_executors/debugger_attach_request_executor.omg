use {squalr_engine_api}/src/commands/debugger/attach/debugger_attach_request.omg;
use {squalr_engine_api}/src/commands/debugger/attach/debugger_attach_response.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_command_status.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_session}/src/debugger/debugger_service.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/debugger/mod.rs::DebuggerAttachRequest — the
// opened-process guard, service.attach with the request's Option plugin_id
// (has_plugin_id + bounded span), then status/session_state/plugin id.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data DebuggerAttachRequestExecutor {}

public machine DebuggerAttachRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    debugger_attach_request: &|debugger_attach_request|::DebuggerAttachRequest
) -> |debugger_attach_response|::DebuggerAttachResponse {
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> attach(engine_privileged_state, debugger_attach_request)
        _ -> absent()
    }

    machine absent() -> |debugger_attach_response|::DebuggerAttachResponse {
        let mut response: |debugger_attach_response|::DebuggerAttachResponse = |debugger_attach_response|::DebuggerAttachResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, "No opened process to debug.");
        |debugger_attach_response|::DebuggerAttachResponse::set_status(&mut response, status);
        (response)
    }

    machine attach(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        debugger_attach_request: &|debugger_attach_request|::DebuggerAttachRequest
    ) -> |debugger_attach_response|::DebuggerAttachResponse {
        let opened_process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        let has_plugin_id: bool = |debugger_attach_request|::DebuggerAttachRequest::has_plugin_id(&debugger_attach_request);
        let plugin_id: &[u8] = |debugger_attach_request|::DebuggerAttachRequest::get_plugin_id(&debugger_attach_request);
        let outcome: |debugger_service|::DebuggerOperationOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_attach(&mut engine_privileged_state, &opened_process_info,
            has_plugin_id,
            plugin_id);
        transition outcome.succeeded {
            true -> succeeded(outcome)
            _ -> failed(outcome)
        }
    }

    machine succeeded(outcome: |debugger_service|::DebuggerOperationOutcome) -> |debugger_attach_response|::DebuggerAttachResponse {
        let mut response: |debugger_attach_response|::DebuggerAttachResponse = |debugger_attach_response|::DebuggerAttachResponse::new();
        |debugger_attach_response|::DebuggerAttachResponse::set_session_state(&mut response, outcome.session_state);
        transition outcome.has_active_plugin_id {
            true -> fill_plugin_id(outcome, response)
            _ -> (response)
        }
    }

    machine fill_plugin_id(outcome: |debugger_service|::DebuggerOperationOutcome, mut response: |debugger_attach_response|::DebuggerAttachResponse) -> |debugger_attach_response|::DebuggerAttachResponse {
        |debugger_attach_response|::DebuggerAttachResponse::set_active_plugin_id(&mut response, |debugger_service|::DebuggerOperationOutcome::get_active_plugin_id(outcome));
        (response)
    }

    machine failed(outcome: |debugger_service|::DebuggerOperationOutcome) -> |debugger_attach_response|::DebuggerAttachResponse {
        let mut response: |debugger_attach_response|::DebuggerAttachResponse = |debugger_attach_response|::DebuggerAttachResponse::new();
        let mut status: |debugger_command_status|::DebuggerCommandStatus = |debugger_command_status|::DebuggerCommandStatus::failure();
        |debugger_command_status|::DebuggerCommandStatus::set_message(&mut status, |debugger_service|::DebuggerOperationOutcome::get_error_message(outcome));
        |debugger_attach_response|::DebuggerAttachResponse::set_status(&mut response, status);
        (response)
    }
}
