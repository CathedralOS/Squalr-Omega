use {squalr_engine_api}/src/commands/scan_results/refresh/scan_results_refresh_request.omg;
use {squalr_engine_api}/src/commands/scan_results/refresh/scan_results_refresh_response.omg;
use {squalr_engine_api}/src/commands/scan_results/list/scan_results_list_response.omg;
use {squalr_engine_api}/src/structures/results/snapshot_region_scan_results.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_base.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_ref.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_enriched.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_valued.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;
use src/command_executors/scan_result_enricher.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/os/supplied_memory_source.omg;
use {squalr_engine_api}/src/structures/snapshots/element_window.omg;
use {squalr_engine_api}/src/commands/scan_results/delete/scan_results_delete_request.omg;

// Port of command_executors/scan_results/refresh/scan_results_refresh_request_executor.rs:
// refresh the given scan result refs — resolve each global index through the
// snapshot (upstream `get_scan_result`, StructuralResult::Missing skips) and
// re-read the current value through the memory source. The snapshot read is
// unconditional like upstream; the lock collapse matches the query executor.
// Best-effort read failure leaves has_current_value = false (upstream
// recently_read_value = None).
public data ScanResultsRefreshRequestExecutor {}

public machine ScanResultsRefreshRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    scan_results_refresh_request: &|scan_results_refresh_request|::ScanResultsRefreshRequest
) -> |scan_results_refresh_response|::ScanResultsRefreshResponse
crashes Abort
{
    transition { _ -> each(engine_privileged_state, scan_results_refresh_request, |scan_results_list_response|::ScanResultPage::empty(), 0) }

    machine each(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_refresh_request: &|scan_results_refresh_request|::ScanResultsRefreshRequest,
        scan_results: |scan_results_list_response|::ScanResultPage,
        position: u64
    ) -> |scan_results_refresh_response|::ScanResultsRefreshResponse {
        let hoist1: u64 = |scan_results_delete_request|::ScanResultRefList::get_count(&scan_results_refresh_request.scan_result_refs);
        transition position < hoist1 {
            true -> resolve(
                engine_privileged_state,
                scan_results_refresh_request,
                scan_results,
                position)
            false -> finish(scan_results)
            _ -> finish(scan_results)
        }
    }
    machine resolve(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_refresh_request: &|scan_results_refresh_request|::ScanResultsRefreshRequest,
        scan_results: |scan_results_list_response|::ScanResultPage,
        position: u64
    ) -> |scan_results_refresh_response|::ScanResultsRefreshResponse {
        let scan_result_ref: |scan_result_ref|::ScanResultRef = |scan_results_delete_request|::ScanResultRefList::get(&scan_results_refresh_request.scan_result_refs, position);
        let global_index: u64 = |scan_result_ref|::ScanResultRef::get_scan_result_index(&scan_result_ref);
        let snapshot: &|snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot(&engine_privileged_state);
        let structural_result: |snapshot_region_scan_results|::StructuralResult = |snapshot|::Snapshot::get_scan_result(&snapshot, global_index);
        transition structural_result {
            |snapshot_region_scan_results|::StructuralResult::Found { valued_result } -> refresh(
                engine_privileged_state,
                scan_results_refresh_request,
                valued_result,
                scan_results,
                position)
            _ -> next(
                engine_privileged_state,
                scan_results_refresh_request,
                scan_results,
                position)
        }
    }
    machine refresh(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_refresh_request: &|scan_results_refresh_request|::ScanResultsRefreshRequest,
        valued_result: |scan_result_valued|::ScanResultValued,
        scan_results: |scan_results_list_response|::ScanResultPage,
        position: u64
    ) -> |scan_results_refresh_response|::ScanResultsRefreshResponse {
        let base: |scan_result_base|::ScanResultBase = |scan_result_valued|::ScanResultValued::get_base_result(&valued_result);
        let address: u64 = |scan_result_base|::ScanResultBase::get_address(&base);
        let source: &|supplied_memory_source|::SuppliedMemorySource = |engine_privileged_state|::EnginePrivilegedState::get_supplied_memory_source(&engine_privileged_state);
        let read: |supplied_memory_source|::ReadWindowResult = |supplied_memory_source|::SuppliedMemorySource::try_read_window(&source, address, 8);
        let has_current: bool = read.succeeded;
        let current_value: u64 = |element_window|::ElementWindow::get_element(&read.window, 0);
        let has_previous: bool = valued_result.has_previous_value;
        let previous_value: u64 = |scan_result_valued|::ScanResultValued::get_previous_value(&valued_result);
        let refreshed: |scan_result_valued|::ScanResultValued = |scan_result_valued|::ScanResultValued::new(base, has_current, current_value, has_previous, previous_value);
        // Upstream's module + freeze enrichment (address_to_module +
        // is_address_frozen -> ScanResult::new).
        let enriched: |scan_result_enriched|::ScanResultEnriched = |scan_result_enricher|::ScanResultEnricher::enrich(
            engine_privileged_state, refreshed);
        let mut carried: |scan_results_list_response|::ScanResultPage = scan_results;
        let pushed: bool = |scan_results_list_response|::ScanResultPage::push(&mut carried, &|scan_result|::ScanResult::Valued { result: enriched });
        transition { _ -> each(
            engine_privileged_state,
            scan_results_refresh_request,
            carried,
            ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    machine next(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_results_refresh_request: &|scan_results_refresh_request|::ScanResultsRefreshRequest,
        scan_results: |scan_results_list_response|::ScanResultPage,
        position: u64
    ) -> |scan_results_refresh_response|::ScanResultsRefreshResponse {
        transition { _ -> each(
            engine_privileged_state,
            scan_results_refresh_request,
            scan_results,
            ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    machine finish(
        scan_results: |scan_results_list_response|::ScanResultPage
    ) -> |scan_results_refresh_response|::ScanResultsRefreshResponse {
        |scan_results_refresh_response|::ScanResultsRefreshResponse {
            scan_results: scan_results,
        }
    }
}
