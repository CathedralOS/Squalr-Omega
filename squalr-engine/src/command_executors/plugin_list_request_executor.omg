use {squalr_engine_api}/src/commands/plugins/list/plugin_list_request.omg;
use {squalr_engine_api}/src/commands/plugins/list/plugin_list_response.omg;
use {squalr_engine_api}/src/plugins/plugin_id.omg;
use {squalr_engine_api}/src/plugins/plugin_state.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/plugins/plugin_registry.omg;

// Port of command_executors/plugins/list/plugin_list_request_executor.rs —
// upstream returns `get_plugin_states` (ordered packages) + the opened
// process info + `get_default_plugin_ids`. The port walks the ordered
// positions and fills the response's bounded pages — identical contents.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data PluginListRequestExecutor {}

public machine PluginListRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    plugin_list_request: &|plugin_list_request|::PluginListRequest
) -> |plugin_list_response|::PluginListResponse {
    transition { _ -> fill_plugins(engine_privileged_state, |plugin_list_response|::PluginListResponse::new(), 0) }

    machine fill_plugins(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_list_response|::PluginListResponse,
        ordinal: u64
    ) -> |plugin_list_response|::PluginListResponse {
        let registry: &|plugin_registry|::PluginRegistry = |engine_privileged_state|::EnginePrivilegedState::get_plugin_registry(&engine_privileged_state);
        let hoist1: u64 = |plugin_registry|::PluginRegistry::get_plugin_order_count(&registry);
        transition ordinal < hoist1 && ordinal < 8 {
            true -> append(engine_privileged_state, response, ordinal)
            _ -> set_process_info(engine_privileged_state, response)
        }
    }

    machine append(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_list_response|::PluginListResponse,
        ordinal: u64
    ) -> |plugin_list_response|::PluginListResponse
        requires ordinal < 8
    {
        let registry: &|plugin_registry|::PluginRegistry = |engine_privileged_state|::EnginePrivilegedState::get_plugin_registry(&engine_privileged_state);
        let position: u64 = |plugin_registry|::PluginRegistry::get_ordered_plugin_position(&registry, ordinal);
        transition position < 8 {
            true -> push(engine_privileged_state, response, ordinal, position)
            _ -> fill_plugins(engine_privileged_state, response, ((ordinal as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    machine push(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_list_response|::PluginListResponse,
        ordinal: u64,
        position: u64
    ) -> |plugin_list_response|::PluginListResponse
        requires ordinal < 8 && position < 8
    {
        let registry: &|plugin_registry|::PluginRegistry = |engine_privileged_state|::EnginePrivilegedState::get_plugin_registry(&engine_privileged_state);
        let plugin_state: |plugin_state|::PluginState = |plugin_registry|::PluginRegistry::get_plugin_state_at(&registry, position);
        _ = |plugin_list_response|::PluginListResponse::add_plugin(&mut response, &plugin_state);
        transition {
            _ -> fill_plugins(engine_privileged_state, response, ((ordinal as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    // `opened_process_info: Option<OpenedProcessInfo>` — present only when
    // a process is open (upstream `get_opened_process()`'s Option).
    machine set_process_info(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_list_response|::PluginListResponse
    ) -> |plugin_list_response|::PluginListResponse {
        let hoist2: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
        transition hoist2 {
            true -> set_present(engine_privileged_state, response)
            _ -> fill_default_ids(engine_privileged_state, response, 0)
        }
    }

    machine set_present(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_list_response|::PluginListResponse
    ) -> |plugin_list_response|::PluginListResponse {
        let opened_process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        |plugin_list_response|::PluginListResponse::set_opened_process_info(&mut response, opened_process_info);
        transition { _ -> fill_default_ids(engine_privileged_state, response, 0) }
    }

    // `get_default_plugin_ids` — every seeded package id in registration order.
    machine fill_default_ids(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_list_response|::PluginListResponse,
        position: u64
    ) -> |plugin_list_response|::PluginListResponse {
        let registry: &|plugin_registry|::PluginRegistry = |engine_privileged_state|::EnginePrivilegedState::get_plugin_registry(&engine_privileged_state);
        let hoist3: u64 = |plugin_registry|::PluginRegistry::get_plugin_count(registry);
        transition position < hoist3 && position < 8 {
            true -> push_id(engine_privileged_state, response, position)
            _ -> (response)
        }
    }

    machine push_id(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |plugin_list_response|::PluginListResponse,
        position: u64
    ) -> |plugin_list_response|::PluginListResponse
        requires position < 8
    {
        let registry: &|plugin_registry|::PluginRegistry = |engine_privileged_state|::EnginePrivilegedState::get_plugin_registry(&engine_privileged_state);
        let plugin_id: |plugin_id|::PluginId = |plugin_registry|::PluginRegistry::get_default_plugin_id_at(&registry, position);
        _ = |plugin_list_response|::PluginListResponse::add_default_plugin_id(&mut response, &plugin_id);
        transition {
            _ -> fill_default_ids(engine_privileged_state, response, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}
