module src::command_executors::plugin_list_request_executor;

use squalr_engine_api::src::commands::plugins::list::plugin_list_request::PluginListRequest;
use squalr_engine_api::src::commands::plugins::list::plugin_list_response::PluginListResponse;
use squalr_engine_api::src::plugins::plugin_id::PluginId;
use squalr_engine_api::src::plugins::plugin_state::PluginState;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::plugins::plugin_registry::PluginRegistry;

// Port of command_executors/plugins/list/plugin_list_request_executor.rs —
// upstream returns `get_plugin_states` (ordered packages) + the opened
// process info + `get_default_plugin_ids`. The port walks the ordered
// positions and fills the response's bounded pages — identical contents.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data PluginListRequestExecutor {}

pub machine PluginListRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    plugin_list_request: &PluginListRequest
) -> PluginListResponse {
    transition { _ -> fill_plugins(engine_privileged_state, PluginListResponse::new(), 0) }

    state fill_plugins(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginListResponse,
        ordinal: u64
    ) -> PluginListResponse {
        let registry: &PluginRegistry = engine_privileged_state.get_plugin_registry();
        transition ordinal < registry.get_plugin_order_count() && ordinal < 8 {
            true -> append(engine_privileged_state, response, ordinal)
            _ -> set_process_info(engine_privileged_state, response)
        }
    }

    state append(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginListResponse,
        ordinal: u64
    ) -> PluginListResponse
        requires ordinal < 8
    {
        let registry: &PluginRegistry = engine_privileged_state.get_plugin_registry();
        let position: u64 = registry.get_ordered_plugin_position(ordinal);
        transition position < 8 {
            true -> push(engine_privileged_state, response, ordinal, position)
            _ -> fill_plugins(engine_privileged_state, response, ((ordinal as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    state push(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginListResponse,
        ordinal: u64,
        position: u64
    ) -> PluginListResponse
        requires ordinal < 8 && position < 8
    {
        let registry: &PluginRegistry = engine_privileged_state.get_plugin_registry();
        let plugin_state: PluginState = registry.get_plugin_state_at(position);
        _ = response.add_plugin(&plugin_state);
        transition {
            _ -> fill_plugins(engine_privileged_state, response, ((ordinal as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    // `opened_process_info: Option<OpenedProcessInfo>` — present only when
    // a process is open (upstream `get_opened_process()`'s Option).
    state set_process_info(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginListResponse
    ) -> PluginListResponse {
        transition engine_privileged_state.has_opened_process() {
            true -> set_present(engine_privileged_state, response)
            _ -> fill_default_ids(engine_privileged_state, response, 0)
        }
    }

    state set_present(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginListResponse
    ) -> PluginListResponse {
        let opened_process_info: OpenedProcessInfo = engine_privileged_state.get_opened_process();
        response.set_opened_process_info(opened_process_info);
        transition { _ -> fill_default_ids(engine_privileged_state, response, 0) }
    }

    // `get_default_plugin_ids` — every seeded package id in registration order.
    state fill_default_ids(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginListResponse,
        position: u64
    ) -> PluginListResponse {
        let registry: &PluginRegistry = engine_privileged_state.get_plugin_registry();
        transition position < registry.get_plugin_count() && position < 8 {
            true -> push_id(engine_privileged_state, response, position)
            _ -> (response)
        }
    }

    state push_id(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: PluginListResponse,
        position: u64
    ) -> PluginListResponse
        requires position < 8
    {
        let registry: &PluginRegistry = engine_privileged_state.get_plugin_registry();
        let plugin_id: PluginId = registry.get_default_plugin_id_at(position);
        _ = response.add_default_plugin_id(&plugin_id);
        transition {
            _ -> fill_default_ids(engine_privileged_state, response, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}
