module src::command_executors::pointer_scan_target_resolution;

use squalr_engine_api::src::commands::scan::element_scan::element_scan_request::ScanConstraintSet;
use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use squalr_engine_api::src::structures::data_values::anonymous_value_string::AnonymousValueString;
use squalr_engine_api::src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use squalr_engine_api::src::structures::memory::address_display::is_virtual_module_address;
use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_address_space::PointerScanAddressSpace;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_target_descriptor::PointerScanTargetDescriptor;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_target_request::PointerScanTargetRequest;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::results::snapshot_region_scan_results::ScanResultAddresses;
use squalr_engine_api::src::structures::scan_results::scan_results_metadata::ScanResultsMetadata;
use squalr_engine_api::src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use squalr_engine_api::src::structures::scanning::comparisons::scan_compare_type_immediate::ScanCompareTypeImmediate;
use squalr_engine_api::src::structures::scanning::constraints::anonymous_scan_constraint::AnonymousScanConstraint;
use squalr_engine_api::src::structures::scanning::memory_read_mode::MemoryReadMode;
use squalr_engine_api::src::structures::scanning::plans::element_scan::element_scan_plan::ElementScanPlan;
use squalr_engine_api::src::structures::scanning::plans::element_scan::element_scan_plan::TypePlanList;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use squalr_engine_scanning::src::scanners::scan_control::ScanControl;
use src::command_executors::constraint_deanonymizer::ConstraintDeanonymizer;
use src::command_executors::element_scanner::ElementScannerDriver;

// Port of services/pointer_scans/pointer_scan_target_resolution.rs — the
// pure resolution half. Both upstream arms are now live: address targets
// parse through the same `parse_target_address` upstream itself uses, and
// value targets run upstream's `resolve_value_target` chain — an exact Equal
// constraint -> deanonymize to a per-type plan list -> ElementScanPlan ->
// clone-for-value-target snapshot -> element scan -> collected addresses.
// The symbol registry's role for primitive-typed anonymous values is the
// data-type deanonymize the ConstraintDeanonymizer already performs —
// upstream's `SymbolRegistry` handle adds module/symbol lookup that only the
// unmanaged-plugin surface reaches; named deviation recorded below.
//
// Upstream `Result<ResolvedPointerScanTargets, String>`: the union's
// `Failed` arm stands in for `Err(String)` — the error text only feeds
// upstream's log/status fields; see the executor's status handling.
pub data PointerScanTargetResolution {
    case Resolved(target_descriptor: PointerScanTargetDescriptor, target_address_count: u64);
    case Failed;
}

// Upstream `resolve_pointer_scan_address_space`: Auto resolves to
// GameMemory when the target address parses inside a virtual module range,
// otherwise EmulatorMemory.
pub machine resolve_pointer_scan_address_space(
    requested_address_space: PointerScanAddressSpace,
    target_request: &PointerScanTargetRequest
) -> PointerScanAddressSpace {
    transition requested_address_space {
        PointerScanAddressSpace::Auto -> route_auto(target_request)
        PointerScanAddressSpace::GameMemory -> (PointerScanAddressSpace::GameMemory)
        PointerScanAddressSpace::EmulatorMemory -> (PointerScanAddressSpace::EmulatorMemory)
        _ -> (PointerScanAddressSpace::EmulatorMemory)
    }
    state route_auto(
        target_request: &PointerScanTargetRequest
    ) -> PointerScanAddressSpace {
        transition target_request.has_target_address {
            true -> parse(target_request)
            false -> (PointerScanAddressSpace::EmulatorMemory)
        }
    }
    state parse(
        target_request: &PointerScanTargetRequest
    ) -> PointerScanAddressSpace {
        let target_address: &AnonymousValueString = target_request.get_target_address();
        let parsed: PointerScanTargetAddressParse = parse_target_address(
            target_address);
        transition parsed {
            PointerScanTargetAddressParse::Parsed { value } -> module_check(value)
            _ -> (PointerScanAddressSpace::EmulatorMemory)
        }
    }
    state module_check(address: u64) -> PointerScanAddressSpace {
        transition is_virtual_module_address(address) {
            true -> (PointerScanAddressSpace::GameMemory)
            false -> (PointerScanAddressSpace::EmulatorMemory)
            _ -> (PointerScanAddressSpace::EmulatorMemory)
        }
    }
}

// Upstream `resolve_pointer_size_for_process_bitness`: GameMemory keeps the
// request; every other space pins to the process's pointer size.
pub machine resolve_pointer_size_for_process_bitness(
    requested_pointer_size: PointerScanPointerSize,
    address_space: PointerScanAddressSpace,
    process_info: &OpenedProcessInfo
) -> PointerScanPointerSize {
    transition address_space {
        PointerScanAddressSpace::GameMemory -> (requested_pointer_size)
        _ -> (PointerScanPointerSize::from_process_bitness(process_info.get_bitness()))
    }
}

// Upstream `Option<u64>` folds to the same union convention the api
// package's parsers use (cross-package destructuring needs a data union).
pub data PointerScanTargetAddressParse {
    case Refused;
    case Parsed(value: u64);
}

// Upstream `parse_target_address`: trim → format-selected radix parse.
// `AnonymousValueString` stores pre-trimmed bytes (its setters strip
// whitespace — matching upstream `trim()`), so this walks bytes directly.
// Address/Hexadecimal strip a 0x/0X prefix then radix-16; Binary strips
// 0b/0B then radix-2; Decimal and every other format parse decimal.
pub machine parse_target_address(
    target_address: &AnonymousValueString
) -> PointerScanTargetAddressParse {
    let value_len: u64 = target_address.get_anonymous_value_string_len();
    transition value_len == 0 {
        true -> (PointerScanTargetAddressParse::Refused)
        false -> radix(target_address)
    }
    state radix(
        target_address: &AnonymousValueString
    ) -> PointerScanTargetAddressParse {
        transition target_address.get_anonymous_value_string_format() {
            AnonymousValueStringFormat::Address -> hex(target_address)
            AnonymousValueStringFormat::Hexadecimal -> hex(target_address)
            AnonymousValueStringFormat::Binary -> binary(target_address)
            _ -> (scan_radix(target_address, 0, 0, 10))
        }
    }
    state hex(
        target_address: &AnonymousValueString
    ) -> PointerScanTargetAddressParse {
        (scan_radix(target_address, 120, 88, 16))
    }
    state binary(
        target_address: &AnonymousValueString
    ) -> PointerScanTargetAddressParse {
        (scan_radix(target_address, 98, 66, 2))
    }
}

// Byte-wise radix walk — prefix_code selects the second byte to skip
// ('x'=120 strips "0x", 'b'=98 strips "0b", 0 keeps the whole string).
machine scan_radix(
    target_address: &AnonymousValueString,
    prefix_code: u64 [0..256],
    upper_prefix_code: u64 [0..256],
    radix: u64
) -> PointerScanTargetAddressParse {
    let value_len: u64 = target_address.get_anonymous_value_string_len();
    transition { _ -> prefix_check(target_address, value_len, prefix_code, upper_prefix_code, radix) }

    state prefix_check(
        target_address: &AnonymousValueString,
        value_len: u64,
        prefix_code: u64 [0..256],
        upper_prefix_code: u64 [0..256],
        radix: u64
    ) -> PointerScanTargetAddressParse {
        let first_byte: u8 = target_address.get_anonymous_value_string_byte(0);
        let second_byte: u8 = target_address.get_anonymous_value_string_byte(1);
        // 'x'/'b' uppercase prefix bytes ('X'=88, 'B'=66) arrive as
        // caller literals — the [0..256] bound keeps the u8 casts exact.
        let has_prefix: bool = prefix_code != 0
            && value_len > 2
            && first_byte == 48
            && (second_byte == (prefix_code as u8) || second_byte == (upper_prefix_code as u8));
        transition has_prefix {
            true -> scan(target_address, value_len, 2, 0, radix)
            false -> scan(target_address, value_len, 0, 0, radix)
        }
    }
    state scan(
        target_address: &AnonymousValueString,
        value_len: u64,
        position: u64,
        acc: u64,
        radix: u64
    ) -> PointerScanTargetAddressParse {
        transition position < value_len {
            true -> digit(target_address, value_len, position, acc, radix)
            false -> (PointerScanTargetAddressParse::Parsed { value: acc })
        }
    }
    state digit(
        target_address: &AnonymousValueString,
        value_len: u64,
        position: u64,
        acc: u64,
        radix: u64
    ) -> PointerScanTargetAddressParse {
        let byte: u8 = target_address.get_anonymous_value_string_byte(position);
        transition byte >= 48 && byte <= 57 {
            true -> merge(target_address, value_len, position, acc, radix, ((byte as u64 in Wrapping) - 48) as u64)
            false -> alpha(byte, target_address, value_len, position, acc, radix)
            _ -> alpha(byte, target_address, value_len, position, acc, radix)
        }
    }
    state alpha(
        byte: u8,
        target_address: &AnonymousValueString,
        value_len: u64,
        position: u64,
        acc: u64,
        radix: u64
    ) -> PointerScanTargetAddressParse {
        transition radix == 16 && byte >= 97 && byte <= 102 {
            true -> merge(target_address, value_len, position, acc, radix, ((byte as u64 in Wrapping) - 87) as u64)
            false -> upper(byte, target_address, value_len, position, acc, radix)
            _ -> upper(byte, target_address, value_len, position, acc, radix)
        }
    }
    state upper(
        byte: u8,
        target_address: &AnonymousValueString,
        value_len: u64,
        position: u64,
        acc: u64,
        radix: u64
    ) -> PointerScanTargetAddressParse {
        transition radix == 16 && byte >= 65 && byte <= 70 {
            true -> merge(target_address, value_len, position, acc, radix, ((byte as u64 in Wrapping) - 55) as u64)
            false -> (PointerScanTargetAddressParse::Refused)
            _ -> (PointerScanTargetAddressParse::Refused)
        }
    }
    state merge(
        target_address: &AnonymousValueString,
        value_len: u64,
        position: u64,
        acc: u64,
        radix: u64,
        digit_value: u64
    ) -> PointerScanTargetAddressParse {
        transition digit_value < radix {
            true -> scan(target_address, value_len, position + 1, (((acc as u64 in Wrapping) * (radix as u64 in Wrapping)) + (digit_value as u64 in Wrapping)) as u64, radix)
            false -> (PointerScanTargetAddressParse::Refused)
        }
    }
}

pub data PointerScanTargetResolver {}

// Upstream `PointerScanTargetResolver::resolve_targets` dispatch: the
// (Some(address), None, None) arm resolves an address; (None, Some(value),
// Some(data_type_ref)) resolves a value; every other combination is an
// upstream `Err` arm (missing target / both address+value / type without
// value / value without type / address with type) collapsed to `Failed`.
// Resolved addresses land in the caller's `out_target_addresses` extent;
// the address arm emits exactly one as upstream does.
//
// Params mirror upstream `(target_request, symbol_registry,
// address_pointer_size, snapshot, memory_alignment,
// floating_point_tolerance, is_single_thread_scan,
// debug_perform_validation_scan)`: `symbol_registry` is subsumed by the
// ConstraintDeanonymizer's primitive-type deanonymize (see resolve_value),
// `floating_point_tolerance` rides inside the ported constraint/plan
// surface, and `debug_perform_validation_scan` has no counterpart on the
// ported ElementScanPlan — deviations noted in place.
pub machine PointerScanTargetResolver::resolve_targets(
    target_request: &PointerScanTargetRequest,
    address_pointer_size: PointerScanPointerSize,
    snapshot: &Snapshot,
    memory_alignment: MemoryAlignment,
    is_single_threaded_scan: bool,
    out_target_addresses: &mut [u64]
) -> PointerScanTargetResolution
crashes Abort
{
    transition {
        _ -> route(target_request, address_pointer_size, snapshot, memory_alignment, is_single_threaded_scan, out_target_addresses)
    }
    state route(
        target_request: &PointerScanTargetRequest,
        address_pointer_size: PointerScanPointerSize,
        snapshot: &Snapshot,
        memory_alignment: MemoryAlignment,
        is_single_threaded_scan: bool,
        out_target_addresses: &mut [u64]
    ) -> PointerScanTargetResolution {
        let has_address: bool = target_request.has_target_address;
        let has_value: bool = target_request.has_target_value;
        let has_type: bool = target_request.has_target_data_type_ref;
        transition has_address && !has_value && !has_type {
            true -> address(target_request, out_target_addresses)
            false -> value_arm(has_address, has_value, has_type, target_request, snapshot, memory_alignment, is_single_threaded_scan, out_target_addresses)
            _ -> value_arm(has_address, has_value, has_type, target_request, snapshot, memory_alignment, is_single_threaded_scan, out_target_addresses)
        }
    }
    state address(
        target_request: &PointerScanTargetRequest,
        out_target_addresses: &mut [u64]
    ) -> PointerScanTargetResolution {
        // Upstream resolve_address_target goes through the symbol registry
        // (deanonymize → read_address_value). The registry is unported; the
        // equivalent parse here is the same `parse_target_address` upstream
        // itself uses for address-space/module resolution — Address/Hex/
        // Decimal/Binary formats decode identically.
        let target_address: &AnonymousValueString = target_request.get_target_address();
        let parsed: PointerScanTargetAddressParse = parse_target_address(
            target_address);
        transition parsed {
            PointerScanTargetAddressParse::Parsed { value } -> emit(value, out_target_addresses)
            _ -> (PointerScanTargetResolution::Failed)
        }
    }
    state emit(
        target_address: u64,
        out_target_addresses: &mut [u64]
    ) -> PointerScanTargetResolution {
        transition out_target_addresses.len > 0 {
            true -> stored(target_address, out_target_addresses)
            false -> (PointerScanTargetResolution::Failed)
        }
    }
    state stored(
        target_address: u64,
        out_target_addresses: &mut [u64]
    ) -> PointerScanTargetResolution {
        out_target_addresses[0] = target_address;
        (PointerScanTargetResolution::Resolved {
            target_descriptor: PointerScanTargetDescriptor::address(target_address),
            target_address_count: 1,
        })
    }
    // Upstream's second match arm: (None, Some(value), Some(type)).
    state value_arm(
        has_address: bool,
        has_value: bool,
        has_type: bool,
        target_request: &PointerScanTargetRequest,
        snapshot: &Snapshot,
        memory_alignment: MemoryAlignment,
        is_single_threaded_scan: bool,
        out_target_addresses: &mut [u64]
    ) -> PointerScanTargetResolution {
        transition !has_address && has_value && has_type {
            true -> constrain(target_request, snapshot, memory_alignment, is_single_threaded_scan, out_target_addresses)
            false -> (PointerScanTargetResolution::Failed)
            _ -> (PointerScanTargetResolution::Failed)
        }
    }
    // resolve_value_target — upstream: AnonymousScanConstraint::new(
    // ScanCompareType::Immediate(Equal), Some(target_value.clone())).
    state constrain(
        target_request: &PointerScanTargetRequest,
        snapshot: &Snapshot,
        memory_alignment: MemoryAlignment,
        is_single_threaded_scan: bool,
        out_target_addresses: &mut [u64]
    ) -> PointerScanTargetResolution {
        let target_value: AnonymousValueString = AnonymousValueString::clone(target_request.get_target_value());
        let exact_scan_constraint: AnonymousScanConstraint = AnonymousScanConstraint::new(
            ScanCompareType::Immediate { compare_type: ScanCompareTypeImmediate::Equal },
            target_value);
        let mut constraints: ScanConstraintSet = ScanConstraintSet::empty();
        let pushed: bool = constraints.push(&exact_scan_constraint);
        transition pushed {
            true -> plan(target_request, &constraints, snapshot, memory_alignment, is_single_threaded_scan, out_target_addresses)
            false -> (PointerScanTargetResolution::Failed)
            _ -> (PointerScanTargetResolution::Failed)
        }
    }
    // Upstream: ScanConstraintBuilder::build + the ElementScanRuleRegistry
    // param-rules fold + ScanConstraintFinalized — ConstraintDeanonymizer's
    // build_type_plan_list is the ported equivalent of that whole pipeline
    // (builder + rules fold + finalize; unparseable constraints drop like
    // upstream's filter_map). An empty list is upstream's
    // "Failed to parse pointer scan value target." Err.
    state plan(
        target_request: &PointerScanTargetRequest,
        constraints: &ScanConstraintSet,
        snapshot: &Snapshot,
        memory_alignment: MemoryAlignment,
        is_single_threaded_scan: bool,
        out_target_addresses: &mut [u64]
    ) -> PointerScanTargetResolution {
        let plan_list: TypePlanList = ConstraintDeanonymizer::build_type_plan_list(
            constraints,
            target_request.get_target_data_type_ref(),
            memory_alignment);
        transition plan_list.get_plan_count() > 0 {
            true -> scan(target_request, plan_list, snapshot, memory_alignment, is_single_threaded_scan, out_target_addresses)
            false -> (PointerScanTargetResolution::Failed)
            _ -> (PointerScanTargetResolution::Failed)
        }
    }
    // Upstream: ElementScanPlan::new({type: finals}, alignment, tolerance,
    // MemoryReadMode::Skip, single_thread, debug_validation) — the ported
    // constructor takes (alignment, read_mode, single_threaded); tolerance
    // and the debug-validation flag are carried inside the ported
    // constraint/plan surface (deviation). Then upstream clones the
    // snapshot minus scan results and runs ElementScanner::scan_snapshot.
    state scan(
        target_request: &PointerScanTargetRequest,
        plan_list: TypePlanList,
        snapshot: &Snapshot,
        memory_alignment: MemoryAlignment,
        is_single_threaded_scan: bool,
        out_target_addresses: &mut [u64]
    ) -> PointerScanTargetResolution {
        let mut element_scan_plan: ElementScanPlan = ElementScanPlan::new(
            memory_alignment, MemoryReadMode::Skip, is_single_threaded_scan);
        let data_type_ref: &DataTypeRef = target_request.get_target_data_type_ref();
        let installed: bool = element_scan_plan.push_type_plans(data_type_ref, &plan_list);
        transition installed {
            true -> scan_cloned(target_request, element_scan_plan, snapshot, out_target_addresses)
            false -> (PointerScanTargetResolution::Failed)
            _ -> (PointerScanTargetResolution::Failed)
        }
    }
    state scan_cloned(
        target_request: &PointerScanTargetRequest,
        element_scan_plan: ElementScanPlan,
        snapshot: &Snapshot,
        out_target_addresses: &mut [u64]
    ) -> PointerScanTargetResolution {
        let mut cloned_snapshot: Snapshot = Snapshot::clone_for_value_target_scan(snapshot);
        let mut carried_plan: ElementScanPlan = element_scan_plan;
        let mut scan_control: ScanControl = ScanControl::new(false);
        let scan_metadata: ScanResultsMetadata = ElementScannerDriver::scan_snapshot(
            &mut cloned_snapshot, &mut carried_plan, &mut scan_control);
        transition { _ -> collect(target_request, &cloned_snapshot, out_target_addresses) }
    }
    // Upstream: get_number_of_results + get_scan_results_page → collect
    // get_address() → sort_unstable + dedup →
    // ResolvedPointerScanTargets{Value{value, type, count}, addresses}.
    // collect_scan_result_addresses_for_data_type already walks pages in
    // ascending address order with no duplicates, so the upstream
    // sort+dedup is a no-op here (deviation note); the ScanResultAddresses
    // carrier is bounded [u64; 64] like the package's other query surfaces.
    state collect(
        target_request: &PointerScanTargetRequest,
        cloned_snapshot: &Snapshot,
        out_target_addresses: &mut [u64]
    ) -> PointerScanTargetResolution {
        let data_type_ref: &DataTypeRef = target_request.get_target_data_type_ref();
        let addresses: ScanResultAddresses = cloned_snapshot.collect_scan_result_addresses_for_data_type(data_type_ref);
        transition { _ -> copy_each(target_request, addresses, out_target_addresses, 0, 0) }
    }
    state copy_each(
        target_request: &PointerScanTargetRequest,
        addresses: ScanResultAddresses,
        out_target_addresses: &mut [u64],
        position: u64,
        written: u64
    ) -> PointerScanTargetResolution {
        transition position < addresses.get_address_count() && position < 64 && written < 64 && written < out_target_addresses.len {
            true -> store(target_request, addresses, out_target_addresses, position, written)
            false -> resolved_value(target_request, written)
            _ -> resolved_value(target_request, written)
        }
    }
    state store(
        target_request: &PointerScanTargetRequest,
        addresses: ScanResultAddresses,
        out_target_addresses: &mut [u64],
        position: u64 [0..64],
        written: u64 [0..64]
    ) -> PointerScanTargetResolution {
        out_target_addresses[written] = addresses.get(position);
        transition {
            _ -> copy_each(target_request, addresses, out_target_addresses,
                ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64,
                ((written as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    // PointerScanTargetDescriptor::value(target_value, data_type_ref,
    // target_addresses.len()) — `written` is the collected count.
    state resolved_value(
        target_request: &PointerScanTargetRequest,
        target_address_count: u64
    ) -> PointerScanTargetResolution {
        let target_value: AnonymousValueString = AnonymousValueString::clone(target_request.get_target_value());
        let data_type_ref: DataTypeRef = DataTypeRef::clone(target_request.get_target_data_type_ref());
        (PointerScanTargetResolution::Resolved {
            target_descriptor: PointerScanTargetDescriptor::value(target_value, data_type_ref, target_address_count),
            target_address_count: target_address_count,
        })
    }
}
