use {squalr_engine_api}/src/commands/settings/general/set/general_settings_set_request.omg;
use {squalr_engine_api}/src/commands/settings/general/set/general_settings_set_response.omg;
use {squalr_engine_api}/src/structures/settings/general_settings.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/settings/general/set/general_settings_set_request_executor.rs —
// upstream applies each present optional field to general_settings_config.rs; the
// port applies them to the session-owned settings record (persistence is a
// deferred leg — see engine_privileged_state.omg). Each `if let Some` arm
// becomes a check/write state pair: Omega dispatches on `transition` guards,
// there is no statement-level `if`.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data GeneralSettingsSetRequestExecutor {}

public machine GeneralSettingsSetRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    request: &|general_settings_set_request|::GeneralSettingsSetRequest
) -> |general_settings_set_response|::GeneralSettingsSetResponse {
    let hoist1: bool = |general_settings_set_request|::GeneralSettingsSetRequest::has_engine_request_delay(&request);
    transition hoist1 {
        true -> wrote_engine_request_delay(engine_privileged_state, request)
        _ -> finish(engine_privileged_state)
    }

    machine wrote_engine_request_delay(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|general_settings_set_request|::GeneralSettingsSetRequest
    ) -> |general_settings_set_response|::GeneralSettingsSetResponse {
        let mut settings: |general_settings|::GeneralSettings = |engine_privileged_state|::EnginePrivilegedState::get_general_settings(&engine_privileged_state);
        |general_settings|::GeneralSettings::set_debug_engine_request_delay_ms(&mut settings, |general_settings_set_request|::GeneralSettingsSetRequest::get_engine_request_delay(request));
        |engine_privileged_state|::EnginePrivilegedState::set_general_settings(&mut engine_privileged_state, settings);
        transition { _ -> finish(engine_privileged_state) }
    }

    machine finish(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
    ) -> |general_settings_set_response|::GeneralSettingsSetResponse {
        (|general_settings_set_response|::GeneralSettingsSetResponse::new())
    }
}
