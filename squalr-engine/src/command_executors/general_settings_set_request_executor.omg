module src::command_executors::general_settings_set_request_executor;

use squalr_engine_api::src::commands::settings::general::set::general_settings_set_request::GeneralSettingsSetRequest;
use squalr_engine_api::src::commands::settings::general::set::general_settings_set_response::GeneralSettingsSetResponse;
use squalr_engine_api::src::structures::settings::general_settings::GeneralSettings;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;

// Port of command_executors/settings/general/set/general_settings_set_request_executor.rs —
// upstream applies each present optional field to general_settings_config.rs; the
// port applies them to the session-owned settings record (persistence is a
// deferred leg — see engine_privileged_state.omg). Each `if let Some` arm
// becomes a check/write state pair: Omega dispatches on `transition` guards,
// there is no statement-level `if`.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data GeneralSettingsSetRequestExecutor {}

pub machine GeneralSettingsSetRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    request: &GeneralSettingsSetRequest
) -> GeneralSettingsSetResponse {
    let hoist1: bool = GeneralSettingsSetRequest::has_engine_request_delay(&request);
    transition hoist1 {
        true -> wrote_engine_request_delay(engine_privileged_state, request)
        _ -> finish(engine_privileged_state)
    }

    state wrote_engine_request_delay(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &GeneralSettingsSetRequest
    ) -> GeneralSettingsSetResponse {
        let mut settings: GeneralSettings = EnginePrivilegedState::get_general_settings(&engine_privileged_state);
        GeneralSettings::set_debug_engine_request_delay_ms(&mut settings, GeneralSettingsSetRequest::get_engine_request_delay(request));
        EnginePrivilegedState::set_general_settings(&mut engine_privileged_state, settings);
        transition { _ -> finish(engine_privileged_state) }
    }

    state finish(
        engine_privileged_state: &mut EnginePrivilegedState
    ) -> GeneralSettingsSetResponse {
        (GeneralSettingsSetResponse::new())
    }
}
