module src::command_executors::process_close_request_executor;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::process::close::process_close_request::ProcessCloseRequest;
use squalr_engine_api::src::commands::process::close::process_close_response::ProcessCloseResponse;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::os::engine_os_provider::EngineOsProviders;
use squalr_engine_targets::src::target_providers::ProcessQueryOutcome;

// Port of command_executors/process/close/process_close_request_executor.rs —
// closes the state's opened process handle through the provider, clears it
// on success and echoes the info either way (upstream returns Some whenever
// a process was open, close error included). Nothing open -> empty response.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data ProcessCloseRequestExecutor {}

pub linux_x86_64 machine ProcessCloseRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    request: &ProcessCloseRequest
) -> ProcessCloseResponse
reaches FilesystemHost
invokes FilesystemHost;
{
    let mut response: ProcessCloseResponse = ProcessCloseResponse::new();
    transition engine_privileged_state.has_opened_process() {
        true -> close(engine_privileged_state, response)
        false -> (response)
        _ -> (response)
    }

    state close(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut response: ProcessCloseResponse
    ) -> ProcessCloseResponse {
        let opened_process: OpenedProcessInfo = engine_privileged_state.get_opened_process();
        response.set_process_info(opened_process);
        let handle: u64 = opened_process.get_handle();
        let providers: &mut EngineOsProviders = engine_privileged_state.get_os_providers();
        let outcome: ProcessQueryOutcome = providers.close_process(handle);
        transition outcome.succeeded() {
            true -> cleared(engine_privileged_state, response)
            false -> (response)
            _ -> (response)
        }
    }

    state cleared(
        engine_privileged_state: &mut EnginePrivilegedState,
        response: ProcessCloseResponse
    ) -> ProcessCloseResponse {
        engine_privileged_state.clear_opened_process();
        (response)
    }
}
