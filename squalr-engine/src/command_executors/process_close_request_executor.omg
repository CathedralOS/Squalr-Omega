use {omega}/language/core/filesystem_authority.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/commands/process/close/process_close_request.omg;
use {squalr_engine_api}/src/commands/process/close/process_close_response.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/os/engine_os_provider.omg;
use {squalr_engine_targets}/src/target_providers.omg;

// Port of command_executors/process/close/process_close_request_executor.rs —
// closes the state's opened process handle through the provider, clears it
// on success and echoes the info either way (upstream returns Some whenever
// a process was open, close error included). Nothing open -> empty response.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ProcessCloseRequestExecutor {}

public linux_x86_64 machine ProcessCloseRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    request: &|process_close_request|::ProcessCloseRequest
) -> |process_close_response|::ProcessCloseResponse
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let mut response: |process_close_response|::ProcessCloseResponse = |process_close_response|::ProcessCloseResponse::new();
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> close(engine_privileged_state, response)
        false -> (response)
        _ -> (response)
    }

    machine close(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut response: |process_close_response|::ProcessCloseResponse
    ) -> |process_close_response|::ProcessCloseResponse {
        let opened_process: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        |process_close_response|::ProcessCloseResponse::set_process_info(&mut response, opened_process);
        let handle: u64 = |opened_process_info|::OpenedProcessInfo::get_handle(&opened_process);
        let providers: &mut |engine_os_provider|::EngineOsProviders = |engine_privileged_state|::EnginePrivilegedState::get_os_providers(&mut engine_privileged_state);
        let outcome: |target_providers|::ProcessQueryOutcome = |engine_os_provider|::EngineOsProviders::close_process(providers, handle);
        let hoist2: bool = |target_providers|::ProcessQueryOutcome::succeeded(&outcome);
        transition hoist2 {
            true -> cleared(engine_privileged_state, response)
            false -> (response)
            _ -> (response)
        }
    }

    machine cleared(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        response: |process_close_response|::ProcessCloseResponse
    ) -> |process_close_response|::ProcessCloseResponse {
        |engine_privileged_state|::EnginePrivilegedState::clear_opened_process(&mut engine_privileged_state);
        (response)
    }
}
