module src::command_executors::privileged_command_executor;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::commands::pointer_scan::pointer_scan_command::PointerScanCommand;
use squalr_engine_api::src::commands::pointer_scan::pointer_scan_response::PointerScanResponse;
use squalr_engine_api::src::commands::privileged_command::PrivilegedCommand;
use squalr_engine_api::src::commands::scan::scan_command::ScanCommand;
use squalr_engine_api::src::commands::scan::scan_response::ScanResponse;
use squalr_engine_api::src::commands::scan_results::scan_results_command::ScanResultsCommand;
use squalr_engine_api::src::commands::scan_results::scan_results_response::ScanResultsResponse;
use squalr_engine_api::src::commands::pointer_scan::pointer_scan_command::PointerScanCommand;
use squalr_engine_api::src::commands::pointer_scan::pointer_scan_response::PointerScanResponse;
use squalr_engine_api::src::commands::privileged_command_response::PrivilegedCommandResponse;
use squalr_engine_api::src::commands::memory::memory_command::MemoryCommand;
use squalr_engine_api::src::commands::memory::memory_response::MemoryResponse;
use squalr_engine_api::src::commands::patches::patches_command::PatchesCommand;
use squalr_engine_api::src::commands::patches::patches_response::PatchesResponse;
use squalr_engine_api::src::commands::plugins::plugins_command::PluginsCommand;
use squalr_engine_api::src::commands::plugins::plugins_response::PluginsResponse;
use squalr_engine_api::src::commands::process::process_command::ProcessCommand;
use squalr_engine_api::src::commands::process::process_response::ProcessResponse;
use squalr_engine_api::src::commands::registry::registry_command::RegistryCommand;
use squalr_engine_api::src::commands::registry::registry_response::RegistryResponse;
use squalr_engine_api::src::commands::settings::settings_command::SettingsCommand;
use squalr_engine_api::src::commands::settings::settings_response::SettingsResponse;
use squalr_engine_api::src::commands::struct_scan::struct_scan_command::StructScanCommand;
use squalr_engine_api::src::commands::struct_scan::struct_scan_response::StructScanResponse;
use squalr_engine_api::src::commands::trackable_tasks::trackable_tasks_command::TrackableTasksCommand;
use squalr_engine_api::src::commands::trackable_tasks::trackable_tasks_response::TrackableTasksResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::memory_command_executor::MemoryCommandExecutor;
use src::command_executors::process_command_executor::ProcessCommandExecutor;
use src::command_executors::patches_command_executor::PatchesCommandExecutor;
use src::command_executors::plugins_command_executor::PluginsCommandExecutor;
use src::command_executors::pointer_scan_command_executor::PointerScanCommandExecutor;
use src::command_executors::scan_command_executor::ScanCommandExecutor;
use src::command_executors::registry_command_executor::RegistryCommandExecutor;
use src::command_executors::scan_results_command_executor::ScanResultsCommandExecutor;
use src::command_executors::settings_command_executor::SettingsCommandExecutor;
use src::command_executors::struct_scan_command_executor::StructScanCommandExecutor;
use src::command_executors::trackable_tasks_command_executor::TrackableTasksCommandExecutor;

// Port of command_executors/privileged_request_executor.rs — routes the
// top-level privileged command union to the per-domain executor and wraps
// each typed response in the matching `PrivilegedCommandResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data PrivilegedCommandExecutor {}

pub machine PrivilegedCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    privileged_command: &PrivilegedCommand
) -> PrivilegedCommandResponse
crashes Abort
crashes Trap
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
{
    transition privileged_command {
        PrivilegedCommand::Scan { command } -> scan(engine_privileged_state, &command)
        PrivilegedCommand::ScanResults { command } -> scan_results(engine_privileged_state, &command)
        PrivilegedCommand::PointerScan { command } -> pointer_scan(engine_privileged_state, &command)
        PrivilegedCommand::Memory { command } -> memory(engine_privileged_state, &command)
        PrivilegedCommand::Process { command } -> process(engine_privileged_state, &command)
        PrivilegedCommand::StructScan { command } -> struct_scan(engine_privileged_state, &command)
        PrivilegedCommand::TrackableTasks { command } -> trackable_tasks(engine_privileged_state, &command)
        PrivilegedCommand::Settings { command } -> settings(engine_privileged_state, &command)
        PrivilegedCommand::Registry { command } -> registry(engine_privileged_state, &command)
        PrivilegedCommand::Patches { command } -> patches(engine_privileged_state, &command)
        PrivilegedCommand::Plugins { command } -> plugins(engine_privileged_state, &command)
    }

    state scan(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &ScanCommand
    ) -> PrivilegedCommandResponse
    {
        let response: ScanResponse = ScanCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::Scan { response: response }) }
    }

    state scan_results(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &ScanResultsCommand
    ) -> PrivilegedCommandResponse
    {
        let response: ScanResultsResponse = ScanResultsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::ScanResults { response: response }) }
    }

    state pointer_scan(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &PointerScanCommand
    ) -> PrivilegedCommandResponse
    {
        let response: PointerScanResponse = PointerScanCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::PointerScan { response: response }) }
    }

    state memory(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &MemoryCommand
    ) -> PrivilegedCommandResponse
    {
        let response: MemoryResponse = MemoryCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::Memory { response: response }) }
    }

    state process(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &ProcessCommand
    ) -> PrivilegedCommandResponse
    {
        let response: ProcessResponse = ProcessCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::Process { response: response }) }
    }

    state struct_scan(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &StructScanCommand
    ) -> PrivilegedCommandResponse
    {
        let response: StructScanResponse = StructScanCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::StructScan { response: response }) }
    }
    state trackable_tasks(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &TrackableTasksCommand
    ) -> PrivilegedCommandResponse
    {
        let response: TrackableTasksResponse = TrackableTasksCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::TrackableTasks { response: response }) }
    }

    state settings(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &SettingsCommand
    ) -> PrivilegedCommandResponse
    {
        let response: SettingsResponse = SettingsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::Settings { response: response }) }
    }
    state registry(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &RegistryCommand
    ) -> PrivilegedCommandResponse
    {
        let response: RegistryResponse = RegistryCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::Registry { response: response }) }
    }

    state patches(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &PatchesCommand
    ) -> PrivilegedCommandResponse
    {
        let response: PatchesResponse = PatchesCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::Patches { response: response }) }
    }

    state plugins(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &PluginsCommand
    ) -> PrivilegedCommandResponse
    {
        let response: PluginsResponse = PluginsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::Plugins { response: response }) }
    }
}
