module src::command_executors::privileged_command_executor;

use squalr_engine_api::src::commands::pointer_scan::pointer_scan_command::PointerScanCommand;
use squalr_engine_api::src::commands::pointer_scan::pointer_scan_response::PointerScanResponse;
use squalr_engine_api::src::commands::privileged_command::PrivilegedCommand;
use squalr_engine_api::src::commands::scan::scan_command::ScanCommand;
use squalr_engine_api::src::commands::scan::scan_response::ScanResponse;
use squalr_engine_api::src::commands::scan_results::scan_results_command::ScanResultsCommand;
use squalr_engine_api::src::commands::scan_results::scan_results_response::ScanResultsResponse;
use squalr_engine_api::src::commands::privileged_command_response::PrivilegedCommandResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::pointer_scan_command_executor::PointerScanCommandExecutor;
use src::command_executors::scan_command_executor::ScanCommandExecutor;
use src::command_executors::scan_results_command_executor::ScanResultsCommandExecutor;

// Port of command_executors/privileged_request_executor.rs — routes the
// top-level privileged command union to the per-domain executor and wraps
// each typed response in the matching `PrivilegedCommandResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data PrivilegedCommandExecutor {}

pub machine PrivilegedCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    privileged_command: &PrivilegedCommand
) -> PrivilegedCommandResponse
crashes Abort
{
    transition privileged_command {
        PrivilegedCommand::Scan { command } -> scan(engine_privileged_state, &command)
        PrivilegedCommand::ScanResults { command } -> scan_results(engine_privileged_state, &command)
        PrivilegedCommand::PointerScan { command } -> pointer_scan(engine_privileged_state, &command)
    }

    state scan(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &ScanCommand
    ) -> PrivilegedCommandResponse
    {
        let response: ScanResponse = ScanCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::Scan { response: response }) }
    }

    state scan_results(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &ScanResultsCommand
    ) -> PrivilegedCommandResponse
    {
        let response: ScanResultsResponse = ScanResultsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::ScanResults { response: response }) }
    }

    state pointer_scan(
        engine_privileged_state: &mut EnginePrivilegedState,
        command: &PointerScanCommand
    ) -> PrivilegedCommandResponse
    {
        let response: PointerScanResponse = PointerScanCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (PrivilegedCommandResponse::PointerScan { response: response }) }
    }
}
