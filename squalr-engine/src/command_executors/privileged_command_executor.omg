use src/command_executors/trackable_tasks_command_executor.omg;

// Port of command_executors/privileged_request_executor.rs — routes the
// top-level privileged command union to the per-domain executor and wraps
// each typed response in the matching `PrivilegedCommandResponse` case.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data PrivilegedCommandExecutor {}

public machine PrivilegedCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    privileged_command: &|privileged_command|::PrivilegedCommand
) -> |privileged_command_response|::PrivilegedCommandResponse
crashes Abort
crashes Trap
reaches |wait_wake|::WaitWake
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |wait_wake|::WaitWake;
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    transition privileged_command {
        |privileged_command|::PrivilegedCommand::Scan { command } -> scan(engine_privileged_state, &command)
        |privileged_command|::PrivilegedCommand::ScanResults { command } -> scan_results(engine_privileged_state, &command)
        |privileged_command|::PrivilegedCommand::PointerScan { command } -> pointer_scan(engine_privileged_state, &command)
        |privileged_command|::PrivilegedCommand::Memory { command } -> memory(engine_privileged_state, &command)
        |privileged_command|::PrivilegedCommand::Process { command } -> process(engine_privileged_state, &command)
        |privileged_command|::PrivilegedCommand::StructScan { command } -> struct_scan(engine_privileged_state, &command)
        |privileged_command|::PrivilegedCommand::TrackableTasks { command } -> trackable_tasks(engine_privileged_state, &command)
        |privileged_command|::PrivilegedCommand::Settings { command } -> settings(engine_privileged_state, &command)
        |privileged_command|::PrivilegedCommand::Registry { command } -> registry(engine_privileged_state, &command)
        |privileged_command|::PrivilegedCommand::Patches { command } -> patches(engine_privileged_state, &command)
        |privileged_command|::PrivilegedCommand::Plugins { command } -> plugins(engine_privileged_state, &command)
        |privileged_command|::PrivilegedCommand::Debugger { command } -> debugger(engine_privileged_state, &command)
    }

    machine scan(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|scan_command|::ScanCommand
    ) -> |privileged_command_response|::PrivilegedCommandResponse
    {
        let response: |scan_response|::ScanResponse = |scan_command_executor|::ScanCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|privileged_command_response|::PrivilegedCommandResponse::Scan { response: response }) }
    }

    machine scan_results(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|scan_results_command|::ScanResultsCommand
    ) -> |privileged_command_response|::PrivilegedCommandResponse
    {
        let response: |scan_results_response|::ScanResultsResponse = |scan_results_command_executor|::ScanResultsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|privileged_command_response|::PrivilegedCommandResponse::ScanResults { response: response }) }
    }

    machine pointer_scan(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|pointer_scan_command|::PointerScanCommand
    ) -> |privileged_command_response|::PrivilegedCommandResponse
    {
        let response: |pointer_scan_response|::PointerScanResponse = |pointer_scan_command_executor|::PointerScanCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|privileged_command_response|::PrivilegedCommandResponse::PointerScan { response: response }) }
    }

    machine memory(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|memory_command|::MemoryCommand
    ) -> |privileged_command_response|::PrivilegedCommandResponse
    {
        let response: |memory_response|::MemoryResponse = |memory_command_executor|::MemoryCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|privileged_command_response|::PrivilegedCommandResponse::Memory { response: response }) }
    }

    machine process(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|process_command|::ProcessCommand
    ) -> |privileged_command_response|::PrivilegedCommandResponse
    {
        let response: |process_response|::ProcessResponse = |process_command_executor|::ProcessCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|privileged_command_response|::PrivilegedCommandResponse::Process { response: response }) }
    }

    machine struct_scan(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|struct_scan_command|::StructScanCommand
    ) -> |privileged_command_response|::PrivilegedCommandResponse
    {
        let response: |struct_scan_response|::StructScanResponse = |struct_scan_command_executor|::StructScanCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|privileged_command_response|::PrivilegedCommandResponse::StructScan { response: response }) }
    }
    machine trackable_tasks(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|trackable_tasks_command|::TrackableTasksCommand
    ) -> |privileged_command_response|::PrivilegedCommandResponse
    {
        let response: |trackable_tasks_response|::TrackableTasksResponse = |trackable_tasks_command_executor|::TrackableTasksCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|privileged_command_response|::PrivilegedCommandResponse::TrackableTasks { response: response }) }
    }

    machine settings(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|settings_command|::SettingsCommand
    ) -> |privileged_command_response|::PrivilegedCommandResponse
    {
        let response: |settings_response|::SettingsResponse = |settings_command_executor|::SettingsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|privileged_command_response|::PrivilegedCommandResponse::Settings { response: response }) }
    }
    machine registry(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|registry_command|::RegistryCommand
    ) -> |privileged_command_response|::PrivilegedCommandResponse
    {
        let response: |registry_response|::RegistryResponse = |registry_command_executor|::RegistryCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|privileged_command_response|::PrivilegedCommandResponse::Registry { response: response }) }
    }

    machine patches(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|patches_command|::PatchesCommand
    ) -> |privileged_command_response|::PrivilegedCommandResponse
    {
        let response: |patches_response|::PatchesResponse = |patches_command_executor|::PatchesCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|privileged_command_response|::PrivilegedCommandResponse::Patches { response: response }) }
    }

    machine plugins(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|plugins_command|::PluginsCommand
    ) -> |privileged_command_response|::PrivilegedCommandResponse
    {
        let response: |plugins_response|::PluginsResponse = |plugins_command_executor|::PluginsCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|privileged_command_response|::PrivilegedCommandResponse::Plugins { response: response }) }
    }

    machine debugger(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        command: &|debugger_command|::DebuggerCommand
    ) -> |privileged_command_response|::PrivilegedCommandResponse
    {
        let response: |debugger_response|::DebuggerResponse = |debugger_command_executor|::DebuggerCommandExecutor::execute(
            engine_privileged_state, command);
        transition { _ -> (|privileged_command_response|::PrivilegedCommandResponse::Debugger { response: response }) }
    }
}
