use {squalr_engine_api}/src/commands/scan_results/delete/scan_results_delete_request.omg;
use {squalr_engine_api}/src/commands/scan_results/delete/scan_results_delete_response.omg;
use {squalr_engine_api}/src/events/engine_event.omg;
use {squalr_engine_api}/src/events/scan_results/updated/scan_results_updated_event.omg;
use {squalr_engine_api}/src/structures/scan_results/scan_result_ref.omg;
use {squalr_engine_api}/src/structures/snapshots/deleted_scan_result_index_set.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;

// Port of command_executors/scan_results/delete/
// scan_results_delete_request_executor.rs: mark each requested global
// result index as deleted on the snapshot tombstone set and report how
// many fresh marks landed. Upstream's write-lock failure arm folds into
// the `has_opened_process` gate here (the port's snapshot is owned, not
// RwLock'd). Upstream emits `ScanResultsUpdatedEvent { is_new_scan: false }`
// only when at least one result was deleted — same gate on `apply`.
public data ScanResultsDeleteRequestExecutor {}

public machine ScanResultsDeleteRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    scan_results_delete_request: &|scan_results_delete_request|::ScanResultsDeleteRequest
) -> |scan_results_delete_response|::ScanResultsDeleteResponse
crashes Abort
{
    let requested_result_count: u64 = |scan_results_delete_request|::ScanResultRefList::get_count(&scan_results_delete_request.scan_result_refs);
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> collect(engine_privileged_state, &scan_results_delete_request.scan_result_refs, requested_result_count)
        _ -> (|scan_results_delete_response|::ScanResultsDeleteResponse::of(requested_result_count, 0))
    }

    machine collect(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_result_refs: &|scan_results_delete_request|::ScanResultRefList,
        requested_result_count: u64
    ) -> |scan_results_delete_response|::ScanResultsDeleteResponse {
        let mut deleted_scan_result_indices: |deleted_scan_result_index_set|::DeletedScanResultIndexSet = |deleted_scan_result_index_set|::DeletedScanResultIndexSet::empty();
        transition { _ -> each(engine_privileged_state, scan_result_refs, requested_result_count, &mut deleted_scan_result_indices, 0) }
    }

    machine each(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_result_refs: &|scan_results_delete_request|::ScanResultRefList,
        requested_result_count: u64,
        deleted_scan_result_indices: &mut |deleted_scan_result_index_set|::DeletedScanResultIndexSet,
        position: u64
    ) -> |scan_results_delete_response|::ScanResultsDeleteResponse {
        let hoist2: u64 = |scan_results_delete_request|::ScanResultRefList::get_count(&scan_result_refs);
        transition position < hoist2 && position < 64 {
            true -> plant(engine_privileged_state, scan_result_refs, requested_result_count, deleted_scan_result_indices, position)
            false -> apply(engine_privileged_state, requested_result_count, deleted_scan_result_indices)
        }
    }

    machine plant(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        scan_result_refs: &|scan_results_delete_request|::ScanResultRefList,
        requested_result_count: u64,
        deleted_scan_result_indices: &mut |deleted_scan_result_index_set|::DeletedScanResultIndexSet,
        position: u64
    ) -> |scan_results_delete_response|::ScanResultsDeleteResponse {
        let scan_result_ref: |scan_result_ref|::ScanResultRef = |scan_results_delete_request|::ScanResultRefList::get(&scan_result_refs, position);
        _ = |deleted_scan_result_index_set|::DeletedScanResultIndexSet::insert(&mut deleted_scan_result_indices, |scan_result_ref|::ScanResultRef::get_scan_result_index(&scan_result_ref));
        transition { _ -> each(engine_privileged_state, scan_result_refs, requested_result_count, deleted_scan_result_indices, position + 1) }
    }

    machine apply(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        requested_result_count: u64,
        deleted_scan_result_indices: &mut |deleted_scan_result_index_set|::DeletedScanResultIndexSet
    ) -> |scan_results_delete_response|::ScanResultsDeleteResponse {
        let snapshot: &mut |snapshot|::Snapshot = |engine_privileged_state|::EnginePrivilegedState::borrow_snapshot_mut(&mut engine_privileged_state);
        let deleted_result_count: u64 = |snapshot|::Snapshot::delete_scan_results(&mut snapshot, deleted_scan_result_indices);
        transition deleted_result_count > 0 {
            true -> emit(engine_privileged_state, requested_result_count, deleted_result_count)
            false -> (|scan_results_delete_response|::ScanResultsDeleteResponse::of(requested_result_count, deleted_result_count))
            _ -> (|scan_results_delete_response|::ScanResultsDeleteResponse::of(requested_result_count, deleted_result_count))
        }
    }

    // Upstream `EnginePrivilegedState::emit_event(&mut ScanResultsUpdatedEvent { is_new_scan: false })`
    // — fires only on the deleted>0 arm above.
    machine emit(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        requested_result_count: u64,
        deleted_result_count: u64
    ) -> |scan_results_delete_response|::ScanResultsDeleteResponse {
        let updated: |scan_results_updated_event|::ScanResultsUpdatedEvent = |scan_results_updated_event|::ScanResultsUpdatedEvent::new(false);
        let event: |engine_event|::EngineEvent = |scan_results_updated_event|::ScanResultsUpdatedEvent::to_engine_event(&updated);
        _ = |engine_privileged_state|::EnginePrivilegedState::emit_event(&mut engine_privileged_state, &event);
        transition { _ -> (|scan_results_delete_response|::ScanResultsDeleteResponse::of(requested_result_count, deleted_result_count)) }
    }
}
