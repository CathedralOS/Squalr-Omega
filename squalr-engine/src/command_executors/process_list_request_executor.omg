use {omega}/language/core/filesystem_authority.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/commands/process/list/process_list_request.omg;
use {squalr_engine_api}/src/commands/process/list/process_list_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/os/engine_os_provider.omg;
use {squalr_engine_targets}/src/process_query/process_query_options.omg;
use {squalr_engine_targets}/src/target_providers.omg;

// Port of command_executors/process/list/process_list_request_executor.rs —
// the request's filters become the provider query options, and the sweep's
// listed rows move into the bounded response. Upstream returns the Vec the
// provider filled; the port passes the response's own array as the out
// buffer — the same zero-copy shape (the provider's count is the fill).
// required_process_id stays Any: only the open request binds a pid.
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data ProcessListRequestExecutor {}

public linux_x86_64 machine ProcessListRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    request: &|process_list_request|::ProcessListRequest
) -> |process_list_response|::ProcessListResponse
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
crashes Trap
{
    let hoist5: bool = |process_list_request|::ProcessListRequest::get_fetch_icons(&request);
    let hoist4: bool = |process_list_request|::ProcessListRequest::get_match_case(&request);
    let hoist3: bool = |process_list_request|::ProcessListRequest::get_require_windowed(&request);
    let mut response: |process_list_response|::ProcessListResponse = |process_list_response|::ProcessListResponse::new();
    let name_view: &[u8] = |process_list_request|::ProcessListRequest::get_search_name(&request);
    let mut name: [u8; 256];
    let name_len: u64 = ProcessListRequestExecutor::copy_bounded_name(name_view, &mut name);
    let options: |process_query_options|::ProcessQueryOptions = |process_query_options|::ProcessQueryOptions {
        required_process_id: |process_query_options|::RequiredProcessId::Any,
        search_name: ProcessListRequestExecutor::search_name(request, name, name_len),
        require_windowed: hoist3,
        match_case: hoist4,
        fetch_icons: hoist5,
        limit: ProcessListRequestExecutor::query_limit(request)
    };
    let providers: &mut |engine_os_provider|::EngineOsProviders = |engine_privileged_state|::EnginePrivilegedState::get_os_providers(&mut engine_privileged_state);
    let outcome: |target_providers|::ProcessListOutcome = |engine_os_provider|::EngineOsProviders::get_processes(providers, options, &mut response.processes);
    transition outcome {
        |target_providers|::ProcessListOutcome::Listed { count, truncated } -> finish(response, count)
        |target_providers|::ProcessListOutcome::Failed { error } -> (response)
        _ -> (response)
    }

    machine finish(mut response: |process_list_response|::ProcessListResponse, count: u64) -> |process_list_response|::ProcessListResponse {
        response.process_count = count;
        (response)
    }
}

// The request's Option<String> name as a fixed buffer — the same
// bounded-name convention the request records itself uses. The byte count
// is meaningful only when `has_search_name` holds.
machine ProcessListRequestExecutor::copy_bounded_name(name: &[u8], out: &mut [u8; 256]) -> u64 {
    transition { _ -> copy(name, out, 0) }

    machine copy(name: &[u8], out: &mut [u8; 256], position: u64) -> u64 {
        transition position < name.len && position < 256 {
            true -> store(name, out, position)
            false -> (position)
            _ -> (position)
        }
    }

    machine store(name: &[u8], out: &mut [u8; 256], position: u64) -> u64
        requires 0 <= position && position < name.len && position < 256;
    {
        out[position] = name[position];
        transition { _ -> copy(name, out, position + 1) }
    }
}

machine ProcessListRequestExecutor::search_name(
    request: &|process_list_request|::ProcessListRequest,
    name: [u8; 256],
    name_len: u64
) -> |process_query_options|::ProcessNameSearch {
    let hoist1: bool = |process_list_request|::ProcessListRequest::has_search_name(&request);
    transition hoist1 {
        true -> (|process_query_options|::ProcessNameSearch::Named { name: name, name_len: name_len })
        false -> (|process_query_options|::ProcessNameSearch::Any)
        _ -> (|process_query_options|::ProcessNameSearch::Any)
    }
}

machine ProcessListRequestExecutor::query_limit(request: &|process_list_request|::ProcessListRequest) -> |process_query_options|::ProcessQueryLimit {
    let hoist6: u64 = |process_list_request|::ProcessListRequest::get_limit(&request);
    let hoist2: bool = |process_list_request|::ProcessListRequest::has_limit(&request);
    transition hoist2 {
        true -> (|process_query_options|::ProcessQueryLimit::Limited { limit: hoist6 })
        false -> (|process_query_options|::ProcessQueryLimit::Unlimited)
        _ -> (|process_query_options|::ProcessQueryLimit::Unlimited)
    }
}
