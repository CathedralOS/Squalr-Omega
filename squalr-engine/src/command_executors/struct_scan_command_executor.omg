module src::command_executors::struct_scan_command_executor;

use squalr_engine_api::src::commands::struct_scan::struct_scan_command::StructScanCommand;
use squalr_engine_api::src::commands::struct_scan::struct_scan_response::StructScanResponse;
use squalr_engine_api::src::structures::scan_results::scan_results_metadata::ScanResultsMetadata;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::scan_results_metadata_collector::ScanResultsMetadataCollector;

// Port of command_executors/struct_scan/struct_scan_command_executor.rs +
// command_executors/scan/struct_scan/struct_scan_request_executor.rs (one
// machine — upstream's command impl delegates straight to the request
// executor): the response is the collected scan-results statistics pair.
// The request fields (optional value, data type ids, compare type) gate
// nothing upstream — the executor ignores them identically.
pub data StructScanCommandExecutor {}

pub machine StructScanCommandExecutor::execute(
    engine_privileged_state: &EnginePrivilegedState,
    struct_scan_command: &StructScanCommand
) -> StructScanResponse
crashes Abort
{
    StructScanResponse::new(
        ScanResultsMetadataCollector::collect(engine_privileged_state))
}
