use {squalr_engine_api}/src/commands/debugger/breakpoint_list/debugger_breakpoint_list_request.omg;
use {squalr_engine_api}/src/commands/debugger/breakpoint_list/debugger_breakpoint_list_response.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_breakpoint_descriptor.omg;
use {squalr_engine_api}/src/structures/debugger/debugger_breakpoint_kind.omg;
use {squalr_engine_api}/src/structures/memory/normalized_region.omg;
use {squalr_engine_api}/src/structures/patches/patch_descriptor.omg;
use {squalr_engine_api}/src/structures/patches/patch_kind.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_session}/src/debugger/debugger_service.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/patches/patch_service.omg;

// Port of command_executors/debugger/mod.rs::DebuggerBreakpointListRequest —
// debugger-service breakpoints merged with SoftwareBreakpoint-kind patches
// as `patch:`-prefixed memory-patch descriptors, sorted by (address,
// breakpoint_id). The session shim's only error is the absent-session one
// upstream absorbs into an empty page, and the bounded service's
// list_patches cannot fail — both Err arms collapse to their continuation.
// The merged page is bounded at the outcome/response 32 slots (upstream's
// Vec is unbounded — documented bound).
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
public data DebuggerBreakpointListRequestExecutor {}

// "patch:" + patch_id into `out` bounded — the breakpoint id upstream builds
// with format!("{}{}", PATCH_SOFTWARE_BREAKPOINT_ID_PREFIX, patch_id).
machine debugger_compose_patch_breakpoint_id(patch_id: &[u8], out: &mut [u8; 64]) -> u64 {
    transition { _ -> prefix(patch_id, out, 0) }
    machine prefix(patch_id: &[u8], out: &mut [u8; 64], position: u64) -> u64 {
        transition position < 6 {
            true -> store_prefix(patch_id, out, position)
            _ -> tail(patch_id, out, position, 0)
        }
    }
    machine store_prefix(patch_id: &[u8], out: &mut [u8; 64], position: u64) -> u64
        requires position < 6 && position < 64
    {
        transition position {
            0 -> emit_prefix(patch_id, out, position, 112)
            1 -> emit_prefix(patch_id, out, position, 97)
            2 -> emit_prefix(patch_id, out, position, 116)
            3 -> emit_prefix(patch_id, out, position, 99)
            4 -> emit_prefix(patch_id, out, position, 104)
            _ -> emit_prefix(patch_id, out, position, 58)
        }
    }
    machine emit_prefix(patch_id: &[u8], out: &mut [u8; 64], position: u64, byte: u8) -> u64
        requires position < 64
    {
        out[position] = byte;
        transition { _ -> prefix(patch_id, out, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    machine tail(patch_id: &[u8], out: &mut [u8; 64], write_position: u64, position: u64) -> u64 {
        transition position < patch_id.len && write_position < 64 {
            true -> store_tail(patch_id, out, write_position, position)
            _ -> (write_position)
        }
    }
    machine store_tail(patch_id: &[u8], out: &mut [u8; 64], write_position: u64, position: u64) -> u64
        requires position < patch_id.len && write_position < 64
    {
        out[write_position] = patch_id[position];
        transition {
            _ -> tail(patch_id, out,
                ((write_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64,
                ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

public machine DebuggerBreakpointListRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    debugger_breakpoint_list_request: &|debugger_breakpoint_list_request|::DebuggerBreakpointListRequest
) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse {
    // The service shim only ever produces the absent-session error, which
    // upstream absorbs into an empty page — outcome contents are used only
    // when the call reports success.
    let service_outcome: |debugger_service|::DebuggerBreakpointListOutcome = |engine_privileged_state|::EnginePrivilegedState::debugger_list_breakpoints(&engine_privileged_state);
    let hoist1: bool = |engine_privileged_state|::EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> list_patches(engine_privileged_state, service_outcome)
        _ -> sort_page(service_outcome)
    }

    machine list_patches(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        outcome: |debugger_service|::DebuggerBreakpointListOutcome
    ) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse {
        let opened_process_info: |opened_process_info|::OpenedProcessInfo = |engine_privileged_state|::EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        |engine_privileged_state|::EnginePrivilegedState::list_patches(&mut engine_privileged_state, &opened_process_info);
        let patch_service: &mut |patch_service|::PatchService = |engine_privileged_state|::EnginePrivilegedState::borrow_patch_service_mut(&mut engine_privileged_state);
        let patch_count: u64 = |patch_service|::PatchService::get_patch_count(patch_service);
        transition {
            _ -> walk(engine_privileged_state, outcome, patch_count, 0)
        }
    }

    // Fold each SoftwareBreakpoint-kind patch into the breakpoint list as a
    // memory-patch descriptor — upstream's filter+map extend.
    machine walk(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        outcome: |debugger_service|::DebuggerBreakpointListOutcome,
        patch_count: u64,
        position: u64
    ) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse {
        transition position < patch_count && position < 64 {
            true -> consider(engine_privileged_state, outcome, patch_count, position)
            _ -> sort_page(outcome)
        }
    }

    machine consider(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        outcome: |debugger_service|::DebuggerBreakpointListOutcome,
        patch_count: u64,
        position: u64
    ) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse
        requires position < 64
    {
        let service: &mut |patch_service|::PatchService = |engine_privileged_state|::EnginePrivilegedState::borrow_patch_service_mut(&mut engine_privileged_state);
        let patch: |patch_descriptor|::PatchDescriptor = |patch_service|::PatchService::clone_patch_at(&service, position);
        transition |patch_descriptor|::PatchDescriptor::get_kind(&patch) {
            |patch_kind|::PatchKind::SoftwareBreakpoint -> add_patch(engine_privileged_state, outcome, patch_count, position, patch)
            _ -> walk(engine_privileged_state, outcome, patch_count,
                ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    machine add_patch(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        outcome: |debugger_service|::DebuggerBreakpointListOutcome,
        patch_count: u64,
        position: u64,
        patch: |patch_descriptor|::PatchDescriptor
    ) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse {
        let region: &|normalized_region|::NormalizedRegion = |patch_descriptor|::PatchDescriptor::get_region(&patch);
        let base_address: u64 = |normalized_region|::NormalizedRegion::get_base_address(region);
        let is_active: bool = |patch_descriptor|::PatchDescriptor::get_is_active(&patch);
        let mut descriptor: |debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor = |debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor::new_memory_patch(
            base_address,
            |debugger_breakpoint_kind|::DebuggerBreakpointKind::Software,
            is_active);
        let mut composed_id: [u8; 64];
        let patch_id: &[u8] = |patch_descriptor|::PatchDescriptor::get_patch_id(&patch);
        let composed_len: u64 = debugger_compose_patch_breakpoint_id(patch_id, &mut composed_id);
        transition composed_len <= 64 {
            true -> label_check(engine_privileged_state, outcome, patch_count, position, descriptor, composed_id, composed_len, patch)
            _ -> walk(engine_privileged_state, outcome, patch_count,
                ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    machine label_check(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        outcome: |debugger_service|::DebuggerBreakpointListOutcome,
        patch_count: u64,
        position: u64,
        mut descriptor: |debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor,
        composed_id: [u8; 64],
        composed_len: u64,
        patch: |patch_descriptor|::PatchDescriptor
    ) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse
        requires composed_len < 65
    {
        |debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor::set_breakpoint_id(&mut descriptor, &composed_id[0..composed_len]);
        let hoist2: bool = |patch_descriptor|::PatchDescriptor::has_label(&patch);
        transition hoist2 {
            true -> with_label(engine_privileged_state, outcome, patch_count, position, descriptor, patch)
            _ -> merged(engine_privileged_state, outcome, patch_count, position, descriptor)
        }
    }

    machine with_label(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        outcome: |debugger_service|::DebuggerBreakpointListOutcome,
        patch_count: u64,
        position: u64,
        mut descriptor: |debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor,
        patch: |patch_descriptor|::PatchDescriptor
    ) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse {
        |debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor::set_label(&mut descriptor, |patch_descriptor|::PatchDescriptor::get_label(patch));
        transition { _ -> merged(engine_privileged_state, outcome, patch_count, position, descriptor) }
    }

    machine merged(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        mut outcome: |debugger_service|::DebuggerBreakpointListOutcome,
        patch_count: u64,
        position: u64,
        descriptor: |debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor
    ) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse {
        _ = |debugger_service|::DebuggerBreakpointListOutcome::add_breakpoint(&mut outcome, &descriptor);
        transition { _ -> walk(engine_privileged_state, outcome, patch_count,
            ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    machine sort_page(mut outcome: |debugger_service|::DebuggerBreakpointListOutcome) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse {
        |debugger_service|::DebuggerBreakpointListOutcome::sort_breakpoints(&mut outcome);
        transition { _ -> copy_page(outcome, 0) }
    }

    machine copy_page(outcome: |debugger_service|::DebuggerBreakpointListOutcome, position: u64) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse {
        transition position < outcome.breakpoint_count && position < 32 {
            true -> put_page(outcome, position)
            _ -> finish(outcome)
        }
    }

    machine put_page(outcome: |debugger_service|::DebuggerBreakpointListOutcome, position: u64) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse
        requires position < 32
    {
        let mut response: |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse = |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse::new();
        transition { _ -> fill(response, outcome, position) }
    }

    // Response pages are built in one pass: fill seeds a fresh response then
    // walks the sorted outcome entries into add_breakpoint.
    machine fill(response: |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse, outcome: |debugger_service|::DebuggerBreakpointListOutcome, position: u64) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse
        requires position < 32
    {
        let mut held_response: |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse = response;
        _ = |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse::add_breakpoint(&mut held_response, &outcome.breakpoints[position]);
        transition { _ -> resume(held_response, outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    machine resume(response: |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse, outcome: |debugger_service|::DebuggerBreakpointListOutcome, position: u64) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse {
        transition position < outcome.breakpoint_count && position < 32 {
            true -> fill(response, outcome, position)
            _ -> (response)
        }
    }

    machine finish(outcome: |debugger_service|::DebuggerBreakpointListOutcome) -> |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse {
        (|debugger_breakpoint_list_response|::DebuggerBreakpointListResponse::new())
    }
}
