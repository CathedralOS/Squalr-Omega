module src::command_executors::debugger_breakpoint_list_request_executor;

use squalr_engine_api::src::commands::debugger::breakpoint_list::debugger_breakpoint_list_request::DebuggerBreakpointListRequest;
use squalr_engine_api::src::commands::debugger::breakpoint_list::debugger_breakpoint_list_response::DebuggerBreakpointListResponse;
use squalr_engine_api::src::structures::debugger::debugger_breakpoint_descriptor::DebuggerBreakpointDescriptor;
use squalr_engine_api::src::structures::debugger::debugger_breakpoint_kind::DebuggerBreakpointKind;
use squalr_engine_api::src::structures::memory::normalized_region::NormalizedRegion;
use squalr_engine_api::src::structures::patches::patch_descriptor::PatchDescriptor;
use squalr_engine_api::src::structures::patches::patch_kind::PatchKind;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_session::src::debugger::debugger_service::DebuggerBreakpointListOutcome;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use squalr_engine_session::src::patches::patch_service::PatchService;

// Port of command_executors/debugger/mod.rs::DebuggerBreakpointListRequest —
// debugger-service breakpoints merged with SoftwareBreakpoint-kind patches
// as `patch:`-prefixed memory-patch descriptors, sorted by (address,
// breakpoint_id). The session shim's only error is the absent-session one
// upstream absorbs into an empty page, and the bounded service's
// list_patches cannot fail — both Err arms collapse to their continuation.
// The merged page is bounded at the outcome/response 32 slots (upstream's
// Vec is unbounded — documented bound).
// Empty receiver carrying the machines — mirrors upstream's `impl` namespace.
pub data DebuggerBreakpointListRequestExecutor {}

// "patch:" + patch_id into `out` bounded — the breakpoint id upstream builds
// with format!("{}{}", PATCH_SOFTWARE_BREAKPOINT_ID_PREFIX, patch_id).
machine debugger_compose_patch_breakpoint_id(patch_id: &[u8], out: &mut [u8; 64]) -> u64 {
    transition { _ -> prefix(patch_id, out, 0) }
    state prefix(patch_id: &[u8], out: &mut [u8; 64], position: u64) -> u64 {
        transition position < 6 {
            true -> store_prefix(patch_id, out, position)
            _ -> tail(patch_id, out, position, 0)
        }
    }
    state store_prefix(patch_id: &[u8], out: &mut [u8; 64], position: u64) -> u64
        requires position < 6 && position < 64
    {
        transition position {
            0 -> emit_prefix(patch_id, out, position, 112)
            1 -> emit_prefix(patch_id, out, position, 97)
            2 -> emit_prefix(patch_id, out, position, 116)
            3 -> emit_prefix(patch_id, out, position, 99)
            4 -> emit_prefix(patch_id, out, position, 104)
            _ -> emit_prefix(patch_id, out, position, 58)
        }
    }
    state emit_prefix(patch_id: &[u8], out: &mut [u8; 64], position: u64, byte: u8) -> u64
        requires position < 64
    {
        out[position] = byte;
        transition { _ -> prefix(patch_id, out, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state tail(patch_id: &[u8], out: &mut [u8; 64], write_position: u64, position: u64) -> u64 {
        transition position < patch_id.len && write_position < 64 {
            true -> store_tail(patch_id, out, write_position, position)
            _ -> (write_position)
        }
    }
    state store_tail(patch_id: &[u8], out: &mut [u8; 64], write_position: u64, position: u64) -> u64
        requires position < patch_id.len && write_position < 64
    {
        out[write_position] = patch_id[position];
        transition {
            _ -> tail(patch_id, out,
                ((write_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64,
                ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

pub machine DebuggerBreakpointListRequestExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    debugger_breakpoint_list_request: &DebuggerBreakpointListRequest
) -> DebuggerBreakpointListResponse {
    // The service shim only ever produces the absent-session error, which
    // upstream absorbs into an empty page — outcome contents are used only
    // when the call reports success.
    let service_outcome: DebuggerBreakpointListOutcome = EnginePrivilegedState::debugger_list_breakpoints(&engine_privileged_state);
    let hoist1: bool = EnginePrivilegedState::has_opened_process(&engine_privileged_state);
    transition hoist1 {
        true -> list_patches(engine_privileged_state, service_outcome)
        _ -> sort_page(service_outcome)
    }

    state list_patches(
        engine_privileged_state: &mut EnginePrivilegedState,
        outcome: DebuggerBreakpointListOutcome
    ) -> DebuggerBreakpointListResponse {
        let opened_process_info: OpenedProcessInfo = EnginePrivilegedState::get_opened_process(&engine_privileged_state);
        EnginePrivilegedState::list_patches(&mut engine_privileged_state, &opened_process_info);
        let patch_count: u64 = EnginePrivilegedState::borrow_patch_service_mut(&mut engine_privileged_state).get_patch_count();
        transition {
            _ -> walk(engine_privileged_state, outcome, patch_count, 0)
        }
    }

    // Fold each SoftwareBreakpoint-kind patch into the breakpoint list as a
    // memory-patch descriptor — upstream's filter+map extend.
    state walk(
        engine_privileged_state: &mut EnginePrivilegedState,
        outcome: DebuggerBreakpointListOutcome,
        patch_count: u64,
        position: u64
    ) -> DebuggerBreakpointListResponse {
        transition position < patch_count && position < 64 {
            true -> consider(engine_privileged_state, outcome, patch_count, position)
            _ -> sort_page(outcome)
        }
    }

    state consider(
        engine_privileged_state: &mut EnginePrivilegedState,
        outcome: DebuggerBreakpointListOutcome,
        patch_count: u64,
        position: u64
    ) -> DebuggerBreakpointListResponse
        requires position < 64
    {
        let service: &mut PatchService = EnginePrivilegedState::borrow_patch_service_mut(&mut engine_privileged_state);
        let patch: PatchDescriptor = PatchService::clone_patch_at(&service, position);
        transition PatchDescriptor::get_kind(&patch) {
            PatchKind::SoftwareBreakpoint -> add_patch(engine_privileged_state, outcome, patch_count, position, patch)
            _ -> walk(engine_privileged_state, outcome, patch_count,
                ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    state add_patch(
        engine_privileged_state: &mut EnginePrivilegedState,
        outcome: DebuggerBreakpointListOutcome,
        patch_count: u64,
        position: u64,
        patch: PatchDescriptor
    ) -> DebuggerBreakpointListResponse {
        let region: &NormalizedRegion = PatchDescriptor::get_region(&patch);
        let base_address: u64 = get_base_address(region);
        let is_active: bool = PatchDescriptor::get_is_active(&patch);
        let mut descriptor: DebuggerBreakpointDescriptor = DebuggerBreakpointDescriptor::new_memory_patch(
            base_address,
            DebuggerBreakpointKind::Software,
            is_active);
        let mut composed_id: [u8; 64];
        let patch_id: &[u8] = PatchDescriptor::get_patch_id(&patch);
        let composed_len: u64 = debugger_compose_patch_breakpoint_id(patch_id, &mut composed_id);
        transition composed_len <= 64 {
            true -> label_check(engine_privileged_state, outcome, patch_count, position, descriptor, composed_id, composed_len, patch)
            _ -> walk(engine_privileged_state, outcome, patch_count,
                ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    state label_check(
        engine_privileged_state: &mut EnginePrivilegedState,
        outcome: DebuggerBreakpointListOutcome,
        patch_count: u64,
        position: u64,
        mut descriptor: DebuggerBreakpointDescriptor,
        composed_id: [u8; 64],
        composed_len: u64,
        patch: PatchDescriptor
    ) -> DebuggerBreakpointListResponse
        requires composed_len < 65
    {
        DebuggerBreakpointDescriptor::set_breakpoint_id(&mut descriptor, &composed_id[0..composed_len]);
        let hoist2: bool = PatchDescriptor::has_label(&patch);
        transition hoist2 {
            true -> with_label(engine_privileged_state, outcome, patch_count, position, descriptor, patch)
            _ -> merged(engine_privileged_state, outcome, patch_count, position, descriptor)
        }
    }

    state with_label(
        engine_privileged_state: &mut EnginePrivilegedState,
        outcome: DebuggerBreakpointListOutcome,
        patch_count: u64,
        position: u64,
        mut descriptor: DebuggerBreakpointDescriptor,
        patch: PatchDescriptor
    ) -> DebuggerBreakpointListResponse {
        DebuggerBreakpointDescriptor::set_label(&mut descriptor, PatchDescriptor::get_label(patch));
        transition { _ -> merged(engine_privileged_state, outcome, patch_count, position, descriptor) }
    }

    state merged(
        engine_privileged_state: &mut EnginePrivilegedState,
        mut outcome: DebuggerBreakpointListOutcome,
        patch_count: u64,
        position: u64,
        descriptor: DebuggerBreakpointDescriptor
    ) -> DebuggerBreakpointListResponse {
        _ = DebuggerBreakpointListOutcome::add_breakpoint(&mut outcome, &descriptor);
        transition { _ -> walk(engine_privileged_state, outcome, patch_count,
            ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state sort_page(mut outcome: DebuggerBreakpointListOutcome) -> DebuggerBreakpointListResponse {
        DebuggerBreakpointListOutcome::sort_breakpoints(&mut outcome);
        transition { _ -> copy_page(outcome, 0) }
    }

    state copy_page(outcome: DebuggerBreakpointListOutcome, position: u64) -> DebuggerBreakpointListResponse {
        transition position < outcome.breakpoint_count && position < 32 {
            true -> put_page(outcome, position)
            _ -> finish(outcome)
        }
    }

    state put_page(outcome: DebuggerBreakpointListOutcome, position: u64) -> DebuggerBreakpointListResponse
        requires position < 32
    {
        let mut response: DebuggerBreakpointListResponse = DebuggerBreakpointListResponse::new();
        transition { _ -> fill(response, outcome, position) }
    }

    // Response pages are built in one pass: fill seeds a fresh response then
    // walks the sorted outcome entries into add_breakpoint.
    state fill(response: DebuggerBreakpointListResponse, outcome: DebuggerBreakpointListOutcome, position: u64) -> DebuggerBreakpointListResponse
        requires position < 32
    {
        let mut held_response: DebuggerBreakpointListResponse = response;
        _ = DebuggerBreakpointListResponse::add_breakpoint(&mut held_response, &outcome.breakpoints[position]);
        transition { _ -> resume(held_response, outcome, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state resume(response: DebuggerBreakpointListResponse, outcome: DebuggerBreakpointListOutcome, position: u64) -> DebuggerBreakpointListResponse {
        transition position < outcome.breakpoint_count && position < 32 {
            true -> fill(response, outcome, position)
            _ -> (response)
        }
    }

    state finish(outcome: DebuggerBreakpointListOutcome) -> DebuggerBreakpointListResponse {
        (DebuggerBreakpointListResponse::new())
    }
}
