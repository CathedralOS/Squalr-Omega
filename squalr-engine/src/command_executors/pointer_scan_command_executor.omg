module src::command_executors::pointer_scan_command_executor;

use squalr_engine_api::src::commands::pointer_scan::pointer_scan_command::PointerScanCommand;
use squalr_engine_api::src::commands::pointer_scan::pointer_scan_response::PointerScanResponse;
use squalr_engine_api::src::commands::pointer_scan::start::pointer_scan_start_request::PointerScanStartRequest;
use squalr_engine_api::src::commands::pointer_scan::start::pointer_scan_start_response::PointerScanStartResponse;
use squalr_engine_api::src::commands::pointer_scan::validate::pointer_scan_validate_request::PointerScanValidateRequest;
use squalr_engine_api::src::commands::pointer_scan::validate::pointer_scan_validate_response::PointerScanValidateResponse;
use squalr_engine_api::src::commands::pointer_scan::summary::pointer_scan_summary_request::PointerScanSummaryRequest;
use squalr_engine_api::src::commands::pointer_scan::summary::pointer_scan_summary_response::PointerScanSummaryResponse;
use squalr_engine_api::src::commands::pointer_scan::expand::pointer_scan_expand_request::PointerScanExpandRequest;
use squalr_engine_api::src::commands::pointer_scan::expand::pointer_scan_expand_response::PointerScanExpandResponse;
use squalr_engine_api::src::commands::pointer_scan::reset::pointer_scan_reset_request::PointerScanResetRequest;
use squalr_engine_api::src::commands::pointer_scan::reset::pointer_scan_reset_response::PointerScanResetResponse;
use squalr_engine_session::src::engine_privileged_state::EnginePrivilegedState;
use src::command_executors::pointer_scan_expand_request_executor::PointerScanExpandRequestExecutor;
use src::command_executors::pointer_scan_reset_request_executor::PointerScanResetRequestExecutor;
use src::command_executors::pointer_scan_start_request_executor::PointerScanStartRequestExecutor;
use src::command_executors::pointer_scan_summary_request_executor::PointerScanSummaryRequestExecutor;
use src::command_executors::pointer_scan_validate_request_executor::PointerScanValidateRequestExecutor;

// Port of command_executors/pointer_scan/pointer_scan_command_executor.rs —
// case dispatch in upstream order (Reset, Start, Summary, Expand, Validate).
pub data PointerScanCommandExecutor {}

pub machine PointerScanCommandExecutor::execute(
    engine_privileged_state: &mut EnginePrivilegedState,
    pointer_scan_command: &PointerScanCommand
) -> PointerScanResponse
crashes Abort
{
    transition pointer_scan_command {
        PointerScanCommand::Reset { request } -> reset(engine_privileged_state, &request)
        PointerScanCommand::Start { request } -> start(engine_privileged_state, &request)
        PointerScanCommand::Summary { request } -> summary(engine_privileged_state, &request)
        PointerScanCommand::Expand { request } -> expand(engine_privileged_state, &request)
        PointerScanCommand::Validate { request } -> validate(engine_privileged_state, &request)
    }

    state reset(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PointerScanResetRequest
    ) -> PointerScanResponse
    {
        let response: PointerScanResetResponse = PointerScanResetRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PointerScanResponse::Reset { response: response }) }
    }

    state start(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PointerScanStartRequest
    ) -> PointerScanResponse
    {
        let response: PointerScanStartResponse = PointerScanStartRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PointerScanResponse::Start { response: response }) }
    }

    state summary(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PointerScanSummaryRequest
    ) -> PointerScanResponse
    {
        let response: PointerScanSummaryResponse = PointerScanSummaryRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PointerScanResponse::Summary { response: response }) }
    }

    state expand(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PointerScanExpandRequest
    ) -> PointerScanResponse
    {
        let response: PointerScanExpandResponse = PointerScanExpandRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PointerScanResponse::Expand { response: response }) }
    }

    state validate(
        engine_privileged_state: &mut EnginePrivilegedState,
        request: &PointerScanValidateRequest
    ) -> PointerScanResponse
    {
        let response: PointerScanValidateResponse = PointerScanValidateRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (PointerScanResponse::Validate { response: response }) }
    }
}
