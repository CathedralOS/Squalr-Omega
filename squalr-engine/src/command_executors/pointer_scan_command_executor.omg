use {squalr_engine_api}/src/commands/pointer_scan/pointer_scan_command.omg;
use {squalr_engine_api}/src/commands/pointer_scan/pointer_scan_response.omg;
use {squalr_engine_api}/src/commands/pointer_scan/start/pointer_scan_start_request.omg;
use {squalr_engine_api}/src/commands/pointer_scan/start/pointer_scan_start_response.omg;
use {squalr_engine_api}/src/commands/pointer_scan/validate/pointer_scan_validate_request.omg;
use {squalr_engine_api}/src/commands/pointer_scan/validate/pointer_scan_validate_response.omg;
use {squalr_engine_api}/src/commands/pointer_scan/summary/pointer_scan_summary_request.omg;
use {squalr_engine_api}/src/commands/pointer_scan/summary/pointer_scan_summary_response.omg;
use {squalr_engine_api}/src/commands/pointer_scan/expand/pointer_scan_expand_request.omg;
use {squalr_engine_api}/src/commands/pointer_scan/expand/pointer_scan_expand_response.omg;
use {squalr_engine_api}/src/commands/pointer_scan/reset/pointer_scan_reset_request.omg;
use {squalr_engine_api}/src/commands/pointer_scan/reset/pointer_scan_reset_response.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use src/command_executors/pointer_scan_expand_request_executor.omg;
use src/command_executors/pointer_scan_reset_request_executor.omg;
use src/command_executors/pointer_scan_start_request_executor.omg;
use src/command_executors/pointer_scan_summary_request_executor.omg;
use src/command_executors/pointer_scan_validate_request_executor.omg;

// Port of command_executors/pointer_scan/pointer_scan_command_executor.rs —
// case dispatch in upstream order (Reset, Start, Summary, Expand, Validate).
public data PointerScanCommandExecutor {}

public machine PointerScanCommandExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    pointer_scan_command: &|pointer_scan_command|::PointerScanCommand
) -> |pointer_scan_response|::PointerScanResponse
crashes Abort
{
    transition pointer_scan_command {
        |pointer_scan_command|::PointerScanCommand::Reset { request } -> reset(engine_privileged_state, &request)
        |pointer_scan_command|::PointerScanCommand::Start { request } -> start(engine_privileged_state, &request)
        |pointer_scan_command|::PointerScanCommand::Summary { request } -> summary(engine_privileged_state, &request)
        |pointer_scan_command|::PointerScanCommand::Expand { request } -> expand(engine_privileged_state, &request)
        |pointer_scan_command|::PointerScanCommand::Validate { request } -> validate(engine_privileged_state, &request)
    }

    machine reset(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|pointer_scan_reset_request|::PointerScanResetRequest
    ) -> |pointer_scan_response|::PointerScanResponse
    {
        let response: |pointer_scan_reset_response|::PointerScanResetResponse = |pointer_scan_reset_request_executor|::PointerScanResetRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|pointer_scan_response|::PointerScanResponse::Reset { response: response }) }
    }

    machine start(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|pointer_scan_start_request|::PointerScanStartRequest
    ) -> |pointer_scan_response|::PointerScanResponse
    {
        let response: |pointer_scan_start_response|::PointerScanStartResponse = |pointer_scan_start_request_executor|::PointerScanStartRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|pointer_scan_response|::PointerScanResponse::Start { response: response }) }
    }

    machine summary(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|pointer_scan_summary_request|::PointerScanSummaryRequest
    ) -> |pointer_scan_response|::PointerScanResponse
    {
        let response: |pointer_scan_summary_response|::PointerScanSummaryResponse = |pointer_scan_summary_request_executor|::PointerScanSummaryRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|pointer_scan_response|::PointerScanResponse::Summary { response: response }) }
    }

    machine expand(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|pointer_scan_expand_request|::PointerScanExpandRequest
    ) -> |pointer_scan_response|::PointerScanResponse
    {
        let response: |pointer_scan_expand_response|::PointerScanExpandResponse = |pointer_scan_expand_request_executor|::PointerScanExpandRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|pointer_scan_response|::PointerScanResponse::Expand { response: response }) }
    }

    machine validate(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        request: &|pointer_scan_validate_request|::PointerScanValidateRequest
    ) -> |pointer_scan_response|::PointerScanResponse
    {
        let response: |pointer_scan_validate_response|::PointerScanValidateResponse = |pointer_scan_validate_request_executor|::PointerScanValidateRequestExecutor::execute(
            engine_privileged_state, request);
        transition { _ -> (|pointer_scan_response|::PointerScanResponse::Validate { response: response }) }
    }
}
