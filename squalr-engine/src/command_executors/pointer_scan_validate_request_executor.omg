use {squalr_engine_api}/src/commands/pointer_scan/validate/pointer_scan_validate_request.omg;
use {squalr_engine_api}/src/commands/pointer_scan/validate/pointer_scan_validate_response.omg;
use {squalr_engine_api}/src/structures/data_values/pointer_scan_pointer_size.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_address_space.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_candidate.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_level.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_level_candidates.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_level_summary.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_results.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_node.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_node_type.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_summary.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_target_descriptor.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;
use {squalr_engine_scanning}/src/pointer_scans/pointer_scan_validator.omg;
use {squalr_engine_api}/src/structures/scanning/plans/pointer_scan/pointer_scan_parameters.omg;
use {squalr_engine_scanning}/src/pointer_scans/pointer_scan_results_builder.omg;
use {squalr_engine_scanning}/src/pointer_scans/structures/pointer_scan_collected_level.omg;
use {squalr_engine_scanning}/src/scanners/scan_control.omg;
use {squalr_engine_api}/src/structures/memory/memory_alignment.omg;
use {squalr_engine_api}/src/structures/memory/normalized_module.omg;
use {squalr_engine_session}/src/engine_privileged_state.omg;
use {squalr_engine_session}/src/pointer_scan_results_store.omg;
use src/command_executors/pointer_scan_scratch.omg;
use src/command_executors/pointer_scan_target_resolution.omg;
use src/command_executors/snapshot_region_builder.omg;
use src/command_executors/snapshot_value_collector.omg;

// Port of command_executors/pointer_scan/validate/pointer_scan_validate_request_executor.rs.
// Upstream: gate open process → gate stored results → gate session-id
// match → modules + regions by the STORED results' address space → build
// + collect a fresh validation snapshot → resolve the target request →
// `collect_validated_levels` rebuilds levels against the fresh values into
// the arenas, `seal_results` assembles them → the guard is overwritten with
// the validated results → summary + pruned count.
//
// Deviations: the results store is one slot, so the pre-validation entry
// is dropped on commit — upstream replaces `*guard` too (same slot
// semantics); the error/status text is the upstream message bytes
// (256-byte bound). Value-target requests resolve Failed — same upstream
// `Err` → `status_message` path the symbol-registry arm would take.
public data PointerScanValidateRequestExecutor {}

public machine PointerScanValidateRequestExecutor::execute(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
    pointer_scan_validate_request: &|pointer_scan_validate_request|::PointerScanValidateRequest
) -> |pointer_scan_validate_response|::PointerScanValidateResponse
crashes Abort
{
    transition engine_privileged_state.has_opened_process {
        true -> results_gate(engine_privileged_state, pointer_scan_validate_request)
        false -> denied(engine_privileged_state, "No opened process is available for pointer validation.")
        _ -> denied(engine_privileged_state, "No opened process is available for pointer validation.")
    }

    // Upstream's error arm carries `Some(results.summarize())` once results
    // exist — `denied` is used only before that point, where upstream's
    // summary is absent.
    machine denied(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        status_message: &[u8]
    ) -> |pointer_scan_validate_response|::PointerScanValidateResponse {
        let mut response: |pointer_scan_validate_response|::PointerScanValidateResponse = |pointer_scan_validate_response|::PointerScanValidateResponse::empty();
        |pointer_scan_validate_response|::PointerScanValidateResponse::set_status_message(&mut response, status_message);
        transition { _ -> (response) }
    }

    machine results_gate(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        pointer_scan_validate_request: &|pointer_scan_validate_request|::PointerScanValidateRequest
    ) -> |pointer_scan_validate_response|::PointerScanValidateResponse {
        let hoist1: bool = |pointer_scan_results_store|::PointerScanResultsStore::has_results(&engine_privileged_state.pointer_scan_results_store);
        transition hoist1 {
            true -> session(engine_privileged_state, pointer_scan_validate_request)
            false -> denied(engine_privileged_state, "No active pointer scan results are available.")
            _ -> denied(engine_privileged_state, "No active pointer scan results are available.")
        }
    }

    machine session(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        pointer_scan_validate_request: &|pointer_scan_validate_request|::PointerScanValidateRequest
    ) -> |pointer_scan_validate_response|::PointerScanValidateResponse {
        let store_session_id: u64 = |pointer_scan_results_store|::PointerScanResultsStore::get_session_id(&engine_privileged_state.pointer_scan_results_store);
        transition store_session_id == pointer_scan_validate_request.session_id {
            true -> regions(engine_privileged_state, pointer_scan_validate_request)
            false -> denied(engine_privileged_state, "Pointer scan results were not found.")
            _ -> denied(engine_privileged_state, "Pointer scan results were not found.")
        }
    }

    // Upstream fetches modules + regions by the STORED results' address
    // space (not the request's) — the supplied adapters cover both.
    machine regions(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        pointer_scan_validate_request: &|pointer_scan_validate_request|::PointerScanValidateRequest
    ) -> |pointer_scan_validate_response|::PointerScanValidateResponse {
        let mut builder: |snapshot_region_builder|::SnapshotRegionBuilder = |snapshot_region_builder|::SnapshotRegionBuilder::new();
        |snapshot_region_builder|::SnapshotRegionBuilder::fill_from_supplied_source(
            &mut builder,
            |engine_privileged_state|::EnginePrivilegedState::get_supplied_memory_source(&engine_privileged_state));
        let hoist2: u64 = |snapshot_region_builder|::SnapshotRegionBuilder::get_region_count(&builder);
        transition hoist2 == 0 {
            true -> denied_with_summary(engine_privileged_state, "No readable memory regions were available for pointer validation.")
            false -> snapshot(engine_privileged_state, pointer_scan_validate_request, builder)
            _ -> snapshot(engine_privileged_state, pointer_scan_validate_request, builder)
        }
    }

    // Error arm after results exist: upstream answers
    // `pointer_scan_summary: Some(pointer_scan_results.summarize())`.
    machine denied_with_summary(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        status_message: &[u8]
    ) -> |pointer_scan_validate_response|::PointerScanValidateResponse {
        let mut response: |pointer_scan_validate_response|::PointerScanValidateResponse = |pointer_scan_validate_response|::PointerScanValidateResponse::empty();
        |pointer_scan_validate_response|::PointerScanValidateResponse::set_status_message(&mut response, status_message);
        response.has_pointer_scan_summary = true;
        response.pointer_scan_summary = pointer_scan_stored_summary(
            engine_privileged_state);
        transition { _ -> (response) }
    }

    machine snapshot(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        pointer_scan_validate_request: &|pointer_scan_validate_request|::PointerScanValidateRequest,
        builder: |snapshot_region_builder|::SnapshotRegionBuilder
    ) -> |pointer_scan_validate_response|::PointerScanValidateResponse {
        let mut validation_snapshot: |snapshot|::Snapshot = |snapshot|::Snapshot::new();
        |snapshot_region_builder|::SnapshotRegionBuilder::fill_snapshot(&builder, &mut validation_snapshot);
        // Upstream SnapshotValueCollector::collect_values(process, snapshot,
        // memory_read, true) over the fresh validation snapshot.
        |snapshot_value_collector|::SnapshotValueCollector::collect_into_snapshot(
            &engine_privileged_state.supplied_memory_source,
            &mut validation_snapshot);
        transition { _ -> resolve(engine_privileged_state, pointer_scan_validate_request, validation_snapshot) }
    }

    machine resolve(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        pointer_scan_validate_request: &|pointer_scan_validate_request|::PointerScanValidateRequest,
        validation_snapshot: |snapshot|::Snapshot
    ) -> |pointer_scan_validate_response|::PointerScanValidateResponse {
        let mut validation_arenas: |pointer_scan_results_store|::PointerScanValidationArenas = |pointer_scan_results_store|::PointerScanValidationArenas::empty();
        let targets: &mut [u64] = |pointer_scan_results_store|::PointerScanValidationArenas::borrow_target_addresses_mut(&mut validation_arenas);
        // Upstream: pointer_scan_results.get_pointer_size().
        let pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize = engine_privileged_state.pointer_scan_results_store.pointer_size;
        let memory_alignment: |memory_alignment|::MemoryAlignment = engine_privileged_state.scan_settings.memory_alignment;
        let is_single_threaded_scan: bool = engine_privileged_state.scan_settings.is_single_threaded_scan;
        let debug_perform_validation_scan: bool = engine_privileged_state.scan_settings.debug_perform_validation_scan;
        let resolution: |pointer_scan_target_resolution|::PointerScanTargetResolution = |pointer_scan_target_resolution|::PointerScanTargetResolver::resolve_targets(&pointer_scan_validate_request.target,
            pointer_size,
            &validation_snapshot,
            memory_alignment,
            is_single_threaded_scan,
            debug_perform_validation_scan,
            targets);
        transition resolution {
            |pointer_scan_target_resolution|::PointerScanTargetResolution::Resolved { target_descriptor, target_address_count } -> validate(
                engine_privileged_state,
                pointer_scan_validate_request,
                validation_snapshot,
                validation_arenas,
                target_descriptor,
                target_address_count)
            _ -> denied_with_summary(engine_privileged_state, "Failed to resolve the pointer scan validation target.")
        }
    }

    machine validate(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        pointer_scan_validate_request: &|pointer_scan_validate_request|::PointerScanValidateRequest,
        validation_snapshot: |snapshot|::Snapshot,
        validation_arenas: |pointer_scan_results_store|::PointerScanValidationArenas,
        target_descriptor: |pointer_scan_target_descriptor|::PointerScanTargetDescriptor,
        target_address_count: u64
    ) -> |pointer_scan_validate_response|::PointerScanValidateResponse {
        let empty_static_view: [|pointer_scan_candidate|::PointerScanCandidate; 1] = [
            |pointer_scan_candidate|::PointerScanCandidate::new(0, 0, |pointer_scan_node_type|::PointerScanNodeType::Heap, 0, 0, 0, 0)
        ];
        let empty_heap_view: [|pointer_scan_candidate|::PointerScanCandidate; 1] = [
            |pointer_scan_candidate|::PointerScanCandidate::new(0, 0, |pointer_scan_node_type|::PointerScanNodeType::Heap, 0, 0, 0, 0)
        ];
        let empty_module_name: [u8; 1] = [0];
        let mut source_level_candidates: [|pointer_scan_level_candidates|::PointerScanLevelCandidates; 8] = [
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0)
        ];
        let mut supplied_modules: [|normalized_module|::NormalizedModule; 8] = [
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0),
            |normalized_module|::NormalizedModule::new(&empty_module_name[0..0], 0, 0)
        ];
        let supplied_module_count: u64 = |engine_privileged_state|::EnginePrivilegedState::copy_supplied_modules(&mut engine_privileged_state, &mut supplied_modules);
        let mut source_results: |pointer_scan_results|::PointerScanResults = |pointer_scan_results_store|::PointerScanResultsStore::assemble_results_view(&mut engine_privileged_state.pointer_scan_results_store, &mut source_level_candidates);
        let prior_total_node_count: u64 = |pointer_scan_results|::PointerScanResults::get_total_node_count(&source_results);
        // `let mut` — the validate output needs `mut` fields of the local.
        let mut arenas: |pointer_scan_results_store|::PointerScanValidationArenas = validation_arenas;
        let mut scratch: |pointer_scan_scratch|::PointerScanScratch = |pointer_scan_scratch|::PointerScanScratch::new();
        let level_out: |pointer_scan_collected_level|::PointerScanCollectedLevel = |pointer_scan_collected_level|::PointerScanCollectedLevel::new(
            &mut scratch.collected_static_candidates,
            &mut scratch.collected_heap_candidates);
        let mut validated_level_candidates: [|pointer_scan_level_candidates|::PointerScanLevelCandidates; 8] = [
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0),
            |pointer_scan_level_candidates|::PointerScanLevelCandidates::new_presorted(0, &empty_static_view[0..0], 0, &empty_heap_view[0..0], 0)
        ];
        let snapshots: [&|snapshot|::Snapshot; 1] = [&engine_privileged_state.snapshot];
        let scan_control: |scan_control|::ScanControl = |scan_control|::ScanControl::new(false);
        let validator: |pointer_scan_validator|::PointerScanValidator = |pointer_scan_validator|::PointerScanValidator {};
        let validation_descriptor: |pointer_scan_target_descriptor|::PointerScanTargetDescriptor = |pointer_scan_target_descriptor|::PointerScanTargetDescriptor::clone(&target_descriptor);
        let build: |pointer_scan_results_builder|::PointerScanResultsBuild = |pointer_scan_validator|::PointerScanValidator::collect_validated_levels(&validator, &source_results,
            &arenas.target_addresses[..],
            &snapshots,
            &validation_snapshot,
            &supplied_modules[0..supplied_module_count],
            &scan_control,
            &mut scratch.sorted_scratch,
            &mut scratch.target_ranges,
            &mut scratch.lower_bounds,
            &mut scratch.upper_bounds,
            &mut scratch.target_range_buckets,
            &mut scratch.tasks_scratch,
            &mut scratch.byte_arena,
            &mut scratch.module_order_scratch,
            &mut scratch.pointer_value_scratch,
            &mut scratch.module_name_scratch,
            level_out,
            &mut scratch.heap_address_scratch,
            &mut arenas.module_names[..],
            &mut arenas.levels[..],
            &mut scratch.level_spans_out,
            &mut arenas.static_candidate_arena[..],
            &mut arenas.heap_candidate_arena[..]);
        let validation_parameters: |pointer_scan_parameters|::PointerScanParameters = |pointer_scan_validator|::PointerScanValidator::validation_parameters(&source_results);
        let mut validated_results: |pointer_scan_results|::PointerScanResults = |pointer_scan_results_builder|::PointerScanResultsBuilder::seal_results(build,
            |pointer_scan_results|::PointerScanResults::get_session_id(&source_results),
            &validation_parameters,
            validation_descriptor,
            &mut arenas.target_addresses[..],
            target_address_count,
            |pointer_scan_results|::PointerScanResults::get_address_space(&source_results),
            &mut arenas.module_names[..],
            &mut arenas.levels[..],
            &scratch.level_spans_out,
            &mut validated_level_candidates,
            &arenas.static_candidate_arena[..],
            &arenas.heap_candidate_arena[..],
            &mut arenas.materialized_nodes[..],
            &mut arenas.materialized_node_id_slab[..],
            &mut arenas.page_key_cache[..]);
        // Upstream: pruned = prior total - validated total; the write guard
        // commits the validated results over the stored slot.
        let pruned_node_count: u64 = ((prior_total_node_count as u64 in Saturating)
            - (|pointer_scan_results|::PointerScanResults::get_total_node_count(&validated_results) as u64 in Saturating)) as u64;
        let validation_target_address: u64 = |pointer_scan_target_descriptor|::PointerScanTargetDescriptor::get_target_address(&target_descriptor);
        let session_id: u64 = |pointer_scan_results|::PointerScanResults::get_session_id(&validated_results);
        let root_node_count: u64 = |pointer_scan_results|::PointerScanResults::get_root_node_count(&validated_results);
        let total_node_count: u64 = |pointer_scan_results|::PointerScanResults::get_total_node_count(&validated_results);
        let total_static_node_count: u64 = |pointer_scan_results|::PointerScanResults::get_total_static_node_count(&validated_results);
        let total_heap_node_count: u64 = |pointer_scan_results|::PointerScanResults::get_total_heap_node_count(&validated_results);
        let validated_target_address_count: u64 = |pointer_scan_results|::PointerScanResults::get_target_address_count(&validated_results);
        let module_name_count: u64 = |pointer_scan_results|::PointerScanResults::get_module_name_count(&validated_results);
        let level_count: u64 = |pointer_scan_results|::PointerScanResults::get_pointer_scan_level_count(&validated_results);
        let materialized_node_count: u64 = |pointer_scan_results|::PointerScanResults::get_materialized_node_count(&validated_results);
        let materialized_node_id_slab_count: u64 = |pointer_scan_results|::PointerScanResults::get_materialized_node_id_slab_count(&validated_results);
        let page_key_cache_count: u64 = |pointer_scan_results|::PointerScanResults::get_page_key_cache_count(&validated_results);
        let next_materialized_node_id: u64 = |pointer_scan_results|::PointerScanResults::get_next_materialized_node_id(&validated_results);
        let materialized_nodes_overflowed: bool = |pointer_scan_results|::PointerScanResults::get_materialized_nodes_overflowed(&validated_results);
        let mut level_static_counts: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        let mut level_heap_counts: [u64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
        let mut level_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8] = [
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
            |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0)
        ];
        pointer_scan_validate_harvest(
            &validated_results,
            &mut level_static_counts,
            &mut level_heap_counts,
            &mut level_summaries);
        transition {
            _ -> commit(
                engine_privileged_state,
                arenas,
                session_id,
                target_descriptor,
                validation_target_address,
                pruned_node_count,
                root_node_count,
                total_node_count,
                total_static_node_count,
                total_heap_node_count,
                validated_target_address_count,
                module_name_count,
                level_count,
                materialized_node_count,
                materialized_node_id_slab_count,
                page_key_cache_count,
                next_materialized_node_id,
                materialized_nodes_overflowed,
                level_static_counts,
                level_heap_counts,
                level_summaries)
        }
    }

    machine commit(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        arenas: |pointer_scan_results_store|::PointerScanValidationArenas,
        session_id: u64,
        target_descriptor: |pointer_scan_target_descriptor|::PointerScanTargetDescriptor,
        validation_target_address: u64,
        pruned_node_count: u64,
        root_node_count: u64,
        total_node_count: u64,
        total_static_node_count: u64,
        total_heap_node_count: u64,
        target_address_count: u64,
        module_name_count: u64,
        level_count: u64,
        materialized_node_count: u64,
        materialized_node_id_slab_count: u64,
        page_key_cache_count: u64,
        next_materialized_node_id: u64,
        materialized_nodes_overflowed: bool,
        level_static_counts: [u64; 8],
        level_heap_counts: [u64; 8],
        level_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8]
    ) -> |pointer_scan_validate_response|::PointerScanValidateResponse {
        // `*pointer_scan_results_guard = Some(validated_results)` — the
        // arena contents copy over the stored slot. The scan-shape scalars
        // keep the validated results' own values; address space/pointer
        // size/depth/radius persist from the scan (upstream's validated
        // results carry the same fields through the builder).
        let address_space: |pointer_scan_address_space|::PointerScanAddressSpace = engine_privileged_state.pointer_scan_results_store.address_space;
        let pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize = engine_privileged_state.pointer_scan_results_store.pointer_size;
        let max_depth: u64 = engine_privileged_state.pointer_scan_results_store.max_depth;
        let offset_radius: u64 = engine_privileged_state.pointer_scan_results_store.offset_radius;
        let header_descriptor: |pointer_scan_target_descriptor|::PointerScanTargetDescriptor = |pointer_scan_target_descriptor|::PointerScanTargetDescriptor::clone(&target_descriptor);
        |pointer_scan_results_store|::PointerScanResultsStore::clear(&mut engine_privileged_state.pointer_scan_results_store);
        |pointer_scan_results_store|::PointerScanResultsStore::commit_header(&mut engine_privileged_state.pointer_scan_results_store, session_id,
            header_descriptor,
            address_space,
            pointer_size,
            max_depth,
            offset_radius,
            root_node_count,
            total_node_count,
            total_static_node_count,
            total_heap_node_count,
            target_address_count,
            module_name_count,
            level_count,
            materialized_node_count,
            materialized_node_id_slab_count,
            page_key_cache_count,
            next_materialized_node_id,
            materialized_nodes_overflowed);
        |pointer_scan_results_store|::PointerScanResultsStore::commit_level_windows(&mut engine_privileged_state.pointer_scan_results_store, &level_static_counts,
            &level_heap_counts,
            level_count);
        |pointer_scan_results_store|::PointerScanResultsStore::commit_validated_arenas(&mut engine_privileged_state.pointer_scan_results_store, &arenas,
            target_address_count,
            module_name_count,
            level_count,
            materialized_node_count,
            materialized_node_id_slab_count,
            page_key_cache_count);
        let has_target_address: bool = |pointer_scan_target_descriptor|::PointerScanTargetDescriptor::has_target_address(&target_descriptor);
        let stored_summary: |pointer_scan_summary|::StoredPointerScanSummary = |pointer_scan_summary|::StoredPointerScanSummary::of_scalars(
            session_id,
            target_descriptor,
            address_space,
            pointer_size,
            max_depth,
            offset_radius,
            root_node_count,
            total_node_count,
            total_static_node_count,
            total_heap_node_count,
            &level_summaries, level_count);
        let mut response: |pointer_scan_validate_response|::PointerScanValidateResponse = |pointer_scan_validate_response|::PointerScanValidateResponse::empty();
        response.validation_performed = true;
        response.has_validation_target_address = has_target_address;
        response.validation_target_address = validation_target_address;
        response.pruned_node_count = pruned_node_count;
        |pointer_scan_validate_response|::PointerScanValidateResponse::set_status_message(&mut response, "Validated pointer scan results.");
        response.has_pointer_scan_summary = true;
        response.pointer_scan_summary = stored_summary;
        transition { _ -> (response) }
    }
}

// The stored-summary shorthand for the post-results error arms — reads the
// store's own scalars (upstream `results.summarize()` on the stored entry).
machine pointer_scan_stored_summary(
    engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState
) -> |pointer_scan_summary|::StoredPointerScanSummary {
    let mut level_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8] = [
        |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
        |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
        |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
        |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
        |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
        |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
        |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0),
        |pointer_scan_level_summary|::PointerScanLevelSummary::new(0, 0, 0, 0)
    ];
    transition { _ -> collect(engine_privileged_state, level_summaries, 0) }

    machine collect(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        level_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8],
        level_index: u64
    ) -> |pointer_scan_summary|::StoredPointerScanSummary {
        let hoist3: u64 = |pointer_scan_results_store|::PointerScanResultsStore::get_level_count(engine_privileged_state.pointer_scan_results_store);
        transition level_index < hoist3
            && level_index < 8 {
            true -> level(engine_privileged_state, level_summaries, level_index)
            false -> build(engine_privileged_state, level_summaries)
            _ -> build(engine_privileged_state, level_summaries)
        }
    }
    machine level(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        level_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8],
        level_index: u64
    ) -> |pointer_scan_summary|::StoredPointerScanSummary
    requires 0 <= level_index && level_index < 8;
    {
        let level: |pointer_scan_level|::PointerScanLevel = |pointer_scan_results_store|::PointerScanResultsStore::get_level(engine_privileged_state.pointer_scan_results_store, level_index);
        let mut next_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8] = level_summaries;
        let depth: u64 = |pointer_scan_level|::PointerScanLevel::get_depth(level);
        let node_count: u64 = |pointer_scan_level|::PointerScanLevel::get_node_count(level);
        let static_node_count: u64 = |pointer_scan_level|::PointerScanLevel::get_static_node_count(level);
        let heap_node_count: u64 = |pointer_scan_level|::PointerScanLevel::get_heap_node_count(level);
        next_summaries[level_index] = |pointer_scan_level_summary|::PointerScanLevelSummary::new(
            depth,
            node_count,
            static_node_count,
            heap_node_count);
        transition { _ -> collect(engine_privileged_state, next_summaries, level_index + 1) }
    }
    machine build(
        engine_privileged_state: &mut |engine_privileged_state|::EnginePrivilegedState,
        level_summaries: [|pointer_scan_level_summary|::PointerScanLevelSummary; 8]
    ) -> |pointer_scan_summary|::StoredPointerScanSummary {
        let level_count: u64 = |pointer_scan_results_store|::PointerScanResultsStore::get_level_count(engine_privileged_state.pointer_scan_results_store);
        let cloned_descriptor: |pointer_scan_target_descriptor|::PointerScanTargetDescriptor = |pointer_scan_target_descriptor|::PointerScanTargetDescriptor::clone(engine_privileged_state.pointer_scan_results_store.target_descriptor);
        (|pointer_scan_summary|::StoredPointerScanSummary::of_scalars(
            |pointer_scan_results_store|::PointerScanResultsStore::get_session_id(engine_privileged_state.pointer_scan_results_store),
            cloned_descriptor,
            engine_privileged_state.pointer_scan_results_store.address_space,
            engine_privileged_state.pointer_scan_results_store.pointer_size,
            engine_privileged_state.pointer_scan_results_store.max_depth,
            engine_privileged_state.pointer_scan_results_store.offset_radius,
            engine_privileged_state.pointer_scan_results_store.root_node_count,
            engine_privileged_state.pointer_scan_results_store.total_node_count,
            engine_privileged_state.pointer_scan_results_store.total_static_node_count,
            engine_privileged_state.pointer_scan_results_store.total_heap_node_count,
            &level_summaries, level_count))
    }
}

// Same per-level harvest as the start executor — captured while the
// validated view is still live.
machine pointer_scan_validate_harvest<'ext, 'sh, 's, 'h>(
    pointer_scan_results: &|pointer_scan_results|::PointerScanResults<'ext, 'sh, 's, 'h>,
    level_static_counts: &mut [u64; 8],
    level_heap_counts: &mut [u64; 8],
    level_summaries: &mut [|pointer_scan_level_summary|::PointerScanLevelSummary; 8]
) {
    transition { _ -> walk(pointer_scan_results, level_static_counts, level_heap_counts, level_summaries, 0) }

    machine walk(
        pointer_scan_results: &|pointer_scan_results|::PointerScanResults<'ext, 'sh, 's, 'h>,
        level_static_counts: &mut [u64; 8],
        level_heap_counts: &mut [u64; 8],
        level_summaries: &mut [|pointer_scan_level_summary|::PointerScanLevelSummary; 8],
        level_index: u64
    ) {
        let hoist4: u64 = |pointer_scan_results|::PointerScanResults::get_pointer_scan_level_count(pointer_scan_results);
        transition level_index < hoist4
            && level_index < 8 {
            true -> harvest(pointer_scan_results, level_static_counts, level_heap_counts, level_summaries, level_index)
            false -> done()
            _ -> done()
        }
    }
    machine harvest(
        pointer_scan_results: &|pointer_scan_results|::PointerScanResults<'ext, 'sh, 's, 'h>,
        level_static_counts: &mut [u64; 8],
        level_heap_counts: &mut [u64; 8],
        level_summaries: &mut [|pointer_scan_level_summary|::PointerScanLevelSummary; 8],
        level_index: u64
    )
    requires 0 <= level_index && level_index < 8;
    {
        let level: |pointer_scan_level|::PointerScanLevel = |pointer_scan_results|::PointerScanResults::get_pointer_scan_level_copy(pointer_scan_results, level_index);
        level_static_counts[level_index] = |pointer_scan_level|::PointerScanLevel::get_static_node_count(level);
        level_heap_counts[level_index] = |pointer_scan_level|::PointerScanLevel::get_heap_node_count(level);
        let depth: u64 = |pointer_scan_level|::PointerScanLevel::get_depth(level);
        let node_count: u64 = |pointer_scan_level|::PointerScanLevel::get_node_count(level);
        let static_node_count: u64 = |pointer_scan_level|::PointerScanLevel::get_static_node_count(level);
        let heap_node_count: u64 = |pointer_scan_level|::PointerScanLevel::get_heap_node_count(level);
        level_summaries[level_index] = |pointer_scan_level_summary|::PointerScanLevelSummary::new(
            depth,
            node_count,
            static_node_count,
            heap_node_count);
        transition {
            _ -> walk(pointer_scan_results, level_static_counts, level_heap_counts, level_summaries, level_index + 1)
        }
    }
    machine done() {
    }
}
