use src::services::projects::project_symbol_catalog_persistence::ProjectSymbolCatalogPersistence;

// Port of command_executors/project_symbols/create_module/
// project_symbols_create_module_request_executor.rs — resize or push the
// symbol module, ensure its root struct layout, then save + sync.
// Deviations:
// - `ensure_module_root_struct_layout` lands engine-side (it needs
//   EngineUnprivilegedState for unit sizes; the api catalog cannot see the
//   session package) — the promotion service already hosts it under the
//   upstream name.
// - `find_symbol_module_mut`/`get_symbol_modules_mut().push` respell as
//   find_symbol_module_position + get_symbol_module_mut / add_symbol_module.
// - the project directory resolves inside save_and_sync (upstream resolved
//   it early only to pass it through).
pub data ProjectSymbolsCreateModuleRequestExecutor {}

pub linux_x86_64 machine ProjectSymbolsCreateModuleRequestExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_symbols_create_module_request: &ProjectSymbolsCreateModuleRequest
) -> ProjectSymbolsCreateModuleResponse
reaches WaitWake
reaches FilesystemHost
invokes WaitWake;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
    transition ProjectManager::get_has_opened_project(project_manager) {
        true -> trim(engine_unprivileged_state, engine_bindings, project_symbols_create_module_request)
        _ -> (refused())
    }
    state refused() -> ProjectSymbolsCreateModuleResponse {
        (ProjectSymbolsCreateModuleResponse::new())
    }
    state trim(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_create_module_request: &ProjectSymbolsCreateModuleRequest) -> ProjectSymbolsCreateModuleResponse {
        let mut scope: ProjectSymbolNameScope = ProjectSymbolNameScope {};
        let mut module_name: ManifestPathScratch;
        ManifestPathScratch::new(&mut module_name);
        let inner3074: &[u8] = ProjectSymbolsCreateModuleRequest::get_module_name(project_symbols_create_module_request);
        _ = ProjectSymbolNameScope::trim_copy(&mut scope, inner3074, &mut module_name);
        transition module_name.len > 0 {
            true -> mutate(engine_unprivileged_state, engine_bindings, project_symbols_create_module_request, module_name)
            _ -> (refused())
        }
    }
    state mutate(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, project_symbols_create_module_request: &ProjectSymbolsCreateModuleRequest, module_name: ManifestPathScratch) -> ProjectSymbolsCreateModuleResponse {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        let opened_project: &mut Project = ProjectManager::borrow_opened_project_mut(project_manager);
        let project_info: &mut ProjectInfo = Project::borrow_project_info_mut(opened_project);
        let project_symbol_catalog: &mut ProjectSymbolCatalog = ProjectInfo::borrow_project_symbol_catalog_mut(project_info);
        let inner53: &[u8] = ManifestPathScratch::get_bytes(&module_name);
        let position: u64 = ProjectSymbolCatalog::find_symbol_module_position(project_symbol_catalog, inner53);
        transition position < ProjectSymbolCatalog::get_symbol_module_count(project_symbol_catalog) && position < 64 {
            true -> resize(project_symbol_catalog, position, ProjectSymbolsCreateModuleRequest::get_size(project_symbols_create_module_request), engine_unprivileged_state, engine_bindings, module_name)
            _ -> push(project_symbol_catalog, module_name, ProjectSymbolsCreateModuleRequest::get_size(project_symbols_create_module_request), engine_unprivileged_state, engine_bindings)
        }
    }
    state resize(project_symbol_catalog: &mut ProjectSymbolCatalog, position: u64, size: u64, engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, module_name: ManifestPathScratch) -> ProjectSymbolsCreateModuleResponse
        requires position < project_symbol_catalog.symbol_module_count && position < 64;
    {
        let symbol_module: &mut ProjectSymbolModule = ProjectSymbolCatalog::get_symbol_module_mut(project_symbol_catalog, position);
        ProjectSymbolModule::set_size(symbol_module, size);
        transition { _ -> ensure(project_symbol_catalog, engine_unprivileged_state, engine_bindings, module_name, size) }
    }
    state push(project_symbol_catalog: &mut ProjectSymbolCatalog, module_name: ManifestPathScratch, size: u64, engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings) -> ProjectSymbolsCreateModuleResponse {
        let inner54: &[u8] = ManifestPathScratch::get_bytes(&module_name);
        let symbol_module: ProjectSymbolModule = ProjectSymbolModule::new(inner54, size);
        _ = ProjectSymbolCatalog::add_symbol_module(project_symbol_catalog, &symbol_module);
        transition { _ -> ensure(project_symbol_catalog, engine_unprivileged_state, engine_bindings, module_name, size) }
    }
    state ensure(project_symbol_catalog: &mut ProjectSymbolCatalog, engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, module_name: ManifestPathScratch, size: u64) -> ProjectSymbolsCreateModuleResponse {
        ProjectItemSymbolPromotion::ensure_module_root_struct_layout(engine_unprivileged_state, project_symbol_catalog, ManifestPathScratch::get_bytes(&module_name), size);
        transition { _ -> save(engine_unprivileged_state, engine_bindings, module_name) }
    }
    state save(engine_unprivileged_state: &mut EngineUnprivilegedState, engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings, module_name: ManifestPathScratch) -> ProjectSymbolsCreateModuleResponse {
        let project_manager: &mut ProjectManager = EngineUnprivilegedState::borrow_project_manager_mut(engine_unprivileged_state);
        let opened_project: &mut Project = ProjectManager::borrow_opened_project_mut(project_manager);
        transition ProjectSymbolCatalogPersistence::save_and_sync_project_symbol_catalog(engine_bindings, opened_project) {
            true -> succeed(module_name)
            _ -> (refused())
        }
    }
    state succeed(module_name: ManifestPathScratch) -> ProjectSymbolsCreateModuleResponse {
        let mut response: ProjectSymbolsCreateModuleResponse = ProjectSymbolsCreateModuleResponse::new();
        ProjectSymbolsCreateModuleResponse::set_success(&mut response, true);
        ProjectSymbolsCreateModuleResponse::set_module_name(&mut response, ManifestPathScratch::get_bytes(&module_name));
        (response)
    }
}
