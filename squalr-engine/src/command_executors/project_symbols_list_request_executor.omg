module src::command_executors::project_symbols_list_request_executor;

use squalr_engine_api::src::commands::project_symbols::list::project_symbols_list_request::ProjectSymbolsListRequest;
use squalr_engine_api::src::commands::project_symbols::list::project_symbols_list_response::ProjectSymbolsListResponse;
use squalr_engine_api::src::structures::projects::project::Project;
use squalr_engine_api::src::structures::projects::project_info::ProjectInfo;
use squalr_engine_api::src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;
use squalr_engine_session::src::engine_unprivileged_state::EngineUnprivilegedState;
use squalr_engine_session::src::projects::project_manager::ProjectManager;
use src::engine_bindings::standalone_engine_api_unprivileged_bindings::StandaloneEngineApiUnprivilegedBindings;

// Port of command_executors/project_symbols/list/
// project_symbols_list_request_executor.rs — clone the opened project's
// info + symbol catalog into the response; absent project leaves the
// Option arms empty (upstream `as_ref().map(...)`).
pub data ProjectSymbolsListRequestExecutor {}

pub linux_x86_64 machine ProjectSymbolsListRequestExecutor::execute(
    engine_unprivileged_state: &mut EngineUnprivilegedState,
    engine_bindings: &mut StandaloneEngineApiUnprivilegedBindings,
    project_symbols_list_request: &ProjectSymbolsListRequest
) -> ProjectSymbolsListResponse
crashes Abort
crashes Trap
{
    let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
    transition ProjectManager::get_has_opened_project(project_manager) {
        true -> fill(engine_unprivileged_state)
        _ -> (ProjectSymbolsListResponse::new())
    }
    state fill(engine_unprivileged_state: &mut EngineUnprivilegedState) -> ProjectSymbolsListResponse {
        let mut response: ProjectSymbolsListResponse = ProjectSymbolsListResponse::new();
        let project_manager: &ProjectManager = EngineUnprivilegedState::get_project_manager(engine_unprivileged_state);
        let opened_project: &Project = ProjectManager::get_opened_project(project_manager);
        let project_info: &ProjectInfo = Project::get_project_info(opened_project);
        let cloned_project_info: ProjectInfo = ProjectInfo::clone(project_info);
        let project_symbol_catalog: &ProjectSymbolCatalog = ProjectInfo::get_project_symbol_catalog(project_info);
        let cloned_project_symbol_catalog: ProjectSymbolCatalog = ProjectSymbolCatalog::clone(project_symbol_catalog);
        ProjectSymbolsListResponse::set_opened_project_info(&mut response, cloned_project_info);
        ProjectSymbolsListResponse::set_project_symbol_catalog(&mut response, cloned_project_symbol_catalog);
        (response)
    }
}
