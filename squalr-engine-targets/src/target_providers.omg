module src::target_providers;

use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::memory::normalized_region;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::processes::process_info::ProcessInfo;
use src::process_query::process_query_error::ProcessQueryError;
use src::process_query::process_query_options::ProcessQueryOptions;

// Port of target_providers.rs — the provider contracts the session wires into
// EngineOsProviders. Upstream spellings use Result<T, ProcessQueryError> and
// Vec<T>; Omega's translations are value-discriminating case data and
// caller-supplied buffers / provider-owned streams:
//   - Result<T, E>         -> outcome case data carrying T or E.
//   - Vec<ProcessInfo>     -> a caller-supplied out buffer plus count/truncated.
//   - Vec<NormalizedRegion> from get_memory_page_bounds -> an open/next/close
//     enumeration the provider owns (there is no growable Vec type); the
//     kernel-ordered region stream is identical, merely consumed stepwise.
// DataValue/ValuedStruct-typed read/write ops are not part of this slice: their
// value-type machinery belongs to the scan-values item. read_bytes/write_bytes
// are the bytes-level ops those calls bottom out in.

// `Result<Process>` as an outcome record, not a case enum: the unit-plan
// store vocabulary admits an affine (non-[copy]) record call result into a
// structural field, while a case-payload record can only be moved or copied
// out of the stored enum — never written into a field — and whole-parameter
// record references (`&param`) are outside the admitted call-argument
// surface. `info` must therefore stay reachable inside the stored result
// record and be projected at call sites as `&self.result.info`.
pub data OpenedProcessResult {
    outcome: ProcessQueryOutcome;
    info: OpenedProcessInfo;
}

pub machine OpenedProcessResult::succeeded(&self) -> bool {
    self.outcome in ProcessQueryOutcome::Succeeded
}

pub data ProcessQueryOutcome {
    case Succeeded;
    case Failed(error: ProcessQueryError);
}

pub machine ProcessQueryOutcome::succeeded(&self) -> bool {
    self in ProcessQueryOutcome::Succeeded
}

// Upstream `is_process_alive` returns `bool`. Primitive results are
// inadmissible for machines that do structural work (result signature rejects
// unrestricted result types), so the alive answer travels as a dedicated
// linear enum and callers discriminate on the case.
pub data ProcessAliveResult {
    case Alive;
    case Dead;
}

pub data ProcessListOutcome [copy] {
    case Listed(count: u64, truncated: bool);
    case Failed(error: ProcessQueryError);
}

pub data MemoryReadResult {
    case Complete(count: u64);
    case Partial(count: u64);
    case Failed;
}

pub data MemoryWriteResult [copy] {
    case Complete(count: u64);
    case Partial(count: u64);
    case Failed;
}

// open_page_bounds stands in for upstream `get_memory_page_bounds(mode)`:
// caller pulls regions until Finished or calls close_page_bounds. One
// enumeration is live per provider instance at a time (upstream returns a
// materialized Vec, which permits independent collections; callers in this
// port enumerate serially).
pub data MemoryBoundsOpen {
    case Opened;
    case Failed;
}

pub data MemoryBoundsStep {
    case Region;
    case Finished;
    case Failed;
}

// is_address_writable's two answers as case data: the predicate is carried on
// an affine result so the provider's `&OpenedProcessInfo` contract stays a
// structural-call shape (scalar-result calls do not admit borrow arguments).
pub data AddressWritable {
    case Writable;
    case NotWritable;
}

pub trait ProcessQueryProvider {
    machine start_monitoring(&mut self, process_id: u32) -> ProcessQueryOutcome;
    machine stop_monitoring(&mut self) -> ProcessQueryOutcome;
    machine get_processes(
        &mut self,
        options: ProcessQueryOptions,
        out: &mut [ProcessInfo]
    ) -> ProcessListOutcome
    reaches FilesystemHost
    invokes FilesystemHost;
    crashes Trap;
    machine open_process(&mut self, process_info: &ProcessInfo) -> OpenedProcessResult
    reaches FilesystemHost
    invokes FilesystemHost;
    machine close_process(&mut self, handle: u64) -> ProcessQueryOutcome
    reaches FilesystemHost
    invokes FilesystemHost;
    machine is_process_alive(&mut self, process_id: u32) -> ProcessAliveResult
    reaches FilesystemHost
    invokes FilesystemHost;
}

pub trait MemoryQueryProvider {
    machine open_page_bounds(
        &mut self,
        process_info: &OpenedProcessInfo,
        mode_tag: u8
    ) -> MemoryBoundsOpen
    reaches FilesystemHost
    invokes FilesystemHost;
    machine next_page_bounds_region(
        &mut self,
        region: &mut normalized_region::NormalizedRegion
    ) -> MemoryBoundsStep
    reaches FilesystemHost
    invokes FilesystemHost;
    machine close_page_bounds(&mut self)
    reaches FilesystemHost
    invokes FilesystemHost;
    machine is_address_writable(
        &mut self,
        process_info: &OpenedProcessInfo,
        address: u64
    ) -> AddressWritable
    reaches FilesystemHost
    invokes FilesystemHost;
}

pub trait MemoryReadProvider {
    machine read_bytes(
        &mut self,
        process_info: &OpenedProcessInfo,
        address: u64,
        values: &mut [u8]
    ) -> MemoryReadResult
    reaches FilesystemHost
    invokes FilesystemHost;
}

pub trait MemoryWriteProvider {
    machine write_bytes(
        &mut self,
        process_info: &OpenedProcessInfo,
        address: u64,
        values: &[u8]
    ) -> MemoryWriteResult
    reaches FilesystemHost
    invokes FilesystemHost;
}
