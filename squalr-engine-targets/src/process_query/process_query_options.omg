module src::process_query::process_query_options;

// Port of process_query/process_query_options.rs. Option<Pid> and Option<String>
// become explicit case data; Option<u64> limit likewise. The bounded name buffer
// follows the ProcessInfo name translation.
pub data RequiredProcessId [copy] {
    case Any;
    case Required(process_id: u32);
}

pub data ProcessNameSearch [copy] {
    case Any;
    case Named(name: [u8; 256], name_len: u64);
}

pub data ProcessQueryLimit [copy] {
    case Unlimited;
    case Limited(limit: u64);
}

pub data ProcessQueryOptions [copy] {
    required_process_id: RequiredProcessId;
    search_name: ProcessNameSearch;
    require_windowed: bool;
    match_case: bool;
    fetch_icons: bool;
    limit: ProcessQueryLimit;
}

pub machine ProcessQueryOptions::default() -> ProcessQueryOptions {
    ProcessQueryOptions {
        required_process_id: RequiredProcessId::Any,
        search_name: ProcessNameSearch::Any,
        require_windowed: false,
        match_case: false,
        fetch_icons: false,
        limit: ProcessQueryLimit::Unlimited
    }
}
