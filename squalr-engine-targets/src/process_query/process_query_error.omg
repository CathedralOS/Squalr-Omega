module src::process_query::process_query_error;

// Port of process_query/process_query_error.rs. Upstream variants carry
// &'static str / String payloads (operation names, detail text); Omega keeps
// the variant shape and the scalar payloads, dropping the text payloads (no
// growable String — the variant case still carries the failure identity).
public data ProcessQueryError [copy] {
    case ProcessMonitorLockPoisoned;
    case OpenProcessFailed(process_id: u32);
    case CloseProcessFailed(handle: u64);
    case NotImplemented;
    case Internal;
}

public machine ProcessQueryError::not_implemented() -> ProcessQueryError {
    ProcessQueryError::NotImplemented
}

public machine ProcessQueryError::internal() -> ProcessQueryError {
    ProcessQueryError::Internal
}

public machine ProcessQueryError::open_process_failed(process_id: u32) -> ProcessQueryError {
    ProcessQueryError::OpenProcessFailed { process_id: process_id }
}

public machine ProcessQueryError::close_process_failed(handle: u64) -> ProcessQueryError {
    ProcessQueryError::CloseProcessFailed { handle: handle }
}

public machine ProcessQueryError::process_monitor_lock_poisoned() -> ProcessQueryError {
    ProcessQueryError::ProcessMonitorLockPoisoned
}
