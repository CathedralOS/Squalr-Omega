// Package boundary and internal edges mirror upstream squalr-engine-targets/Cargo.toml.
machine build(builder: &mut Build) {
    builder.package("squalr-engine-targets");
    builder.depend(Source::Path { location: "../squalr-engine-api" });
    builder.depend(Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "56adcc62ec3ae4b403e4e2e7546680447460f4f6",
        selection: PackageSelection::Named { package: "omega-language-std" }
    });
}
