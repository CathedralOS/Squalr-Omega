// Package boundary and internal edges mirror upstream squalr-engine-targets/Cargo.toml.
machine build(builder: &mut Build) {
    Build::package(builder, "squalr_engine_targets");
    Build::depend(builder, Source::Path { location: "../squalr-engine-api" });
    Build::depend(builder, Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "6cd22386cbb51240d17751e61d82b88632bbcd41",
        selection: PackageSelection::Named { package: "omega_language_std" }
    });
}
