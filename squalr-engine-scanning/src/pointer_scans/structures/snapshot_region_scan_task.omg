module src::pointer_scans::structures::snapshot_region_scan_task;

use src::pointer_scans::structures::snapshot_region_scan_task_kind::SnapshotRegionScanTaskKind;

// Port of structures/snapshot_region_scan_task.rs.
//
// Upstream tasks hold `current_values: &'a [u8]` — a view into the snapshot
// region's owned bytes. The ported builder materializes each task's byte
// view in a caller-owned `byte_arena` (see pointer_scan_task_builder), so the
// task carries the view as arena offsets and the scan-task carrier keeps
// the shared arena: the task itself is plain scalar data (`[copy]`), and
// `get_task_values` reslices the arena where upstream passed the slice.
pub data SnapshotRegionScanTask [copy] {
    scan_base_address: u64;
    scan_end_address: u64;
    arena_start_offset: u64;
    arena_end_offset: u64;
    task_kind: SnapshotRegionScanTaskKind;
}

// Upstream dispatches carry `Vec<SnapshotRegionScanTask>`; the extent + live
// count carrier pairs the ported tasks with caller-owned storage. `arena`
// is the shared byte view the tasks' offsets index into.
pub data SnapshotRegionScanTasks<'tasks, 'values> {
    tasks: &'tasks mut [SnapshotRegionScanTask];
    task_count: u64;
    arena: &'values [u8];
}

pub machine SnapshotRegionScanTasks::new<'tasks, 'values>(
    tasks: &'tasks mut [SnapshotRegionScanTask],
    arena: &'values [u8],
    task_count: u64
) -> SnapshotRegionScanTasks<'tasks, 'values> {
    SnapshotRegionScanTasks {
        tasks: tasks,
        task_count: task_count,
        arena: arena
    }
}

// Upstream `Vec::push` — bounded by the caller's extent.
pub machine SnapshotRegionScanTasks::push(
    &mut self,
    task: SnapshotRegionScanTask
) {
    transition self.task_count < self.tasks.len {
        true -> store(task)
        false -> finished()
    }

    state store(
        &mut self,
        task: SnapshotRegionScanTask
    ) {
        self.tasks[self.task_count] = task;
        self.task_count = ((self.task_count as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
    }

    state finished() {}
}

pub machine SnapshotRegionScanTasks::get_task_count(&self) -> u64 {
    self.task_count
}

// Upstream `tasks[index]` — copies are read; out-of-range callers get the
// zeroed task (every consumer guards `index < get_task_count()` first).
pub machine SnapshotRegionScanTasks::get_task(
    &self,
    index: u64
) -> SnapshotRegionScanTask {
    transition index < self.tasks.len {
        true -> (self.tasks[index])
        false -> absent()
        _ -> absent()
    }

    state absent() -> SnapshotRegionScanTask {
        (SnapshotRegionScanTask {
            scan_base_address: 0,
            scan_end_address: 0,
            arena_start_offset: 0,
            arena_end_offset: 0,
            task_kind: SnapshotRegionScanTaskKind::Heap
        })
    }
}

// Upstream `task.current_values` — the task's arena view.
pub machine SnapshotRegionScanTasks::get_task_values<'values>(
    &self,
    task: &SnapshotRegionScanTask
) -> &'values [u8] {
    transition task.arena_start_offset <= task.arena_end_offset
        && task.arena_end_offset <= self.arena.len {
        true -> (&self.arena[task.arena_start_offset..task.arena_end_offset])
        false -> (self.arena)
        _ -> (self.arena)
    }
}

machine SnapshotRegionScanTasks::get_task_byte_count(
    &self,
    index: u64
) -> u64 {
    transition index < self.tasks.len {
        true -> (((self.tasks[index].arena_end_offset as u64 in Saturating)
            - (self.tasks[index].arena_start_offset as u64 in Saturating)) as u64)
        false -> (0)
        _ -> (0)
    }
}

// Upstream's `iter().map(|t| t.current_values.len()).max().unwrap_or(0)` —
// the dispatcher's scan-region byte extent.
pub machine SnapshotRegionScanTasks::get_largest_region_byte_count(&self) -> u64 {
    self.largest(0, 0)
}

machine SnapshotRegionScanTasks::largest(
    &self,
    index: u64,
    largest_seen: u64
) -> u64 {
    transition index < self.task_count {
        true -> step(index, largest_seen)
        false -> (largest_seen)
    }

    state step(
        &self,
        index: u64,
        largest_seen: u64
    ) -> u64 {
        let byte_count: u64 = self.get_task_byte_count(index);
        transition byte_count > largest_seen {
            true -> self.largest(((index as u64 in Wrapping) + 1) as u64, byte_count)
            false -> self.largest(((index as u64 in Wrapping) + 1) as u64, largest_seen)
            _ -> self.largest(((index as u64 in Wrapping) + 1) as u64, largest_seen)
        }
    }
}
