module src::pointer_scans::structures::pointer_scan_collected_level;

use src::pointer_scans::structures::pointer_scan_collected_candidate::PointerScanCollectedCandidate;

// Port of structures/pointer_scan_collected_level.rs.
// Upstream's `Vec<PointerScanCollectedCandidate>` fields port as extents with
// live counts; callers own the backing storage.

pub data PointerScanCollectedLevel<'candidates> {
    static_candidates: &'candidates mut [PointerScanCollectedCandidate];
    static_candidate_count: u64;
    heap_candidates: &'candidates mut [PointerScanCollectedCandidate];
    heap_candidate_count: u64;
}

pub machine PointerScanCollectedLevel::new<'candidates>(
    static_candidates: &'candidates mut [PointerScanCollectedCandidate],
    heap_candidates: &'candidates mut [PointerScanCollectedCandidate]
) -> PointerScanCollectedLevel<'candidates> {
    PointerScanCollectedLevel {
        static_candidates: static_candidates,
        static_candidate_count: 0,
        heap_candidates: heap_candidates,
        heap_candidate_count: 0
    }
}

pub machine PointerScanCollectedLevel::push_static(
    this: &mut PointerScanCollectedLevel,
    candidate: PointerScanCollectedCandidate
) {
    transition (this.static_candidate_count < this.static_candidates.len) {
        true -> store(this, candidate)
        false -> finished()
    }

    state store(
        this: &mut PointerScanCollectedLevel,
        candidate: PointerScanCollectedCandidate
    ) {
        this.static_candidates[this.static_candidate_count] = candidate;
        this.static_candidate_count = ((this.static_candidate_count as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
    }

    state finished() {}
}

pub machine PointerScanCollectedLevel::push_heap(
    this: &mut PointerScanCollectedLevel,
    candidate: PointerScanCollectedCandidate
) {
    transition (this.heap_candidate_count < this.heap_candidates.len) {
        true -> store(this, candidate)
        false -> finished()
    }

    state store(
        this: &mut PointerScanCollectedLevel,
        candidate: PointerScanCollectedCandidate
    ) {
        this.heap_candidates[this.heap_candidate_count] = candidate;
        this.heap_candidate_count = ((this.heap_candidate_count as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
    }

    state finished() {}
}

pub machine PointerScanCollectedLevel::is_empty(this: &PointerScanCollectedLevel) -> bool {
    this.static_candidate_count == 0 && this.heap_candidate_count == 0
}

// Upstream `clear` — the slot is reused per discovered level; counts reset,
// backing extents stay caller-owned.
pub machine PointerScanCollectedLevel::clear(this: &mut PointerScanCollectedLevel) {
    this.static_candidate_count = 0;
    this.heap_candidate_count = 0;
}

pub machine PointerScanCollectedLevel::get_static_candidate_count(this: &PointerScanCollectedLevel) -> u64 {
    this.static_candidate_count
}

pub machine PointerScanCollectedLevel::get_heap_candidate_count(this: &PointerScanCollectedLevel) -> u64 {
    this.heap_candidate_count
}

// Upstream `static_candidates[index]` — callers bound via the count getters.
pub machine PointerScanCollectedLevel::get_static_candidate(
    this: &PointerScanCollectedLevel,
    index: u64
) -> PointerScanCollectedCandidate {
    transition index < this.static_candidates.len {
        true -> arm_result_92_0(this, index)
        false -> absent()
        _ -> absent()
    }

    state absent() -> PointerScanCollectedCandidate {
        (PointerScanCollectedCandidate {
            pointer_address: 0,
            pointer_value: 0,
            module_index: 0,
            module_offset: 0
        })
    }
    state arm_result_92_0(this: &PointerScanCollectedLevel, index: u64) -> PointerScanCollectedCandidate
    
    requires index < this.static_candidates.len;
{
        (this.static_candidates[index])
    }
}

// Upstream `heap_candidates[index]` — callers bound via the count getters.
pub machine PointerScanCollectedLevel::get_heap_candidate(
    this: &PointerScanCollectedLevel,
    index: u64
) -> PointerScanCollectedCandidate {
    transition index < this.heap_candidates.len {
        true -> arm_result_113_0(this, index)
        false -> absent()
        _ -> absent()
    }

    state absent() -> PointerScanCollectedCandidate {
        (PointerScanCollectedCandidate {
            pointer_address: 0,
            pointer_value: 0,
            module_index: 0,
            module_offset: 0
        })
    }
    state arm_result_113_0(this: &PointerScanCollectedLevel, index: u64) -> PointerScanCollectedCandidate
    
    requires index < this.heap_candidates.len;
{
        (this.heap_candidates[index])
    }
}
