module src::pointer_scans::structures::pointer_scan_collected_level;

use src::pointer_scans::structures::pointer_scan_collected_candidate::PointerScanCollectedCandidate;

// Port of structures/pointer_scan_collected_level.rs.
// Upstream's `Vec<PointerScanCollectedCandidate>` fields port as extents with
// live counts; callers own the backing storage.

pub data PointerScanCollectedLevel<'candidates> {
    static_candidates: &'candidates mut [PointerScanCollectedCandidate];
    static_candidate_count: u64;
    heap_candidates: &'candidates mut [PointerScanCollectedCandidate];
    heap_candidate_count: u64;
}

pub machine PointerScanCollectedLevel::new<'candidates>(
    static_candidates: &'candidates mut [PointerScanCollectedCandidate],
    heap_candidates: &'candidates mut [PointerScanCollectedCandidate]
) -> PointerScanCollectedLevel<'candidates> {
    PointerScanCollectedLevel {
        static_candidates: static_candidates,
        static_candidate_count: 0,
        heap_candidates: heap_candidates,
        heap_candidate_count: 0
    }
}

pub machine PointerScanCollectedLevel::push_static(
    pointer_scan_collected_level: &mut PointerScanCollectedLevel,
    candidate: PointerScanCollectedCandidate
) {
    transition (pointer_scan_collected_level.static_candidate_count < pointer_scan_collected_level.static_candidates.len) {
        true -> store(pointer_scan_collected_level, candidate)
        false -> finished()
    }

    state store(
        pointer_scan_collected_level: &mut PointerScanCollectedLevel,
        candidate: PointerScanCollectedCandidate
    ) {
        pointer_scan_collected_level.static_candidates[pointer_scan_collected_level.static_candidate_count] = candidate;
        pointer_scan_collected_level.static_candidate_count = ((pointer_scan_collected_level.static_candidate_count as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
    }

    state finished() {}
}

pub machine PointerScanCollectedLevel::push_heap(
    pointer_scan_collected_level: &mut PointerScanCollectedLevel,
    candidate: PointerScanCollectedCandidate
) {
    transition (pointer_scan_collected_level.heap_candidate_count < pointer_scan_collected_level.heap_candidates.len) {
        true -> store(pointer_scan_collected_level, candidate)
        false -> finished()
    }

    state store(
        pointer_scan_collected_level: &mut PointerScanCollectedLevel,
        candidate: PointerScanCollectedCandidate
    ) {
        pointer_scan_collected_level.heap_candidates[pointer_scan_collected_level.heap_candidate_count] = candidate;
        pointer_scan_collected_level.heap_candidate_count = ((pointer_scan_collected_level.heap_candidate_count as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
    }

    state finished() {}
}

pub machine PointerScanCollectedLevel::is_empty(pointer_scan_collected_level: &PointerScanCollectedLevel) -> bool {
    pointer_scan_collected_level.static_candidate_count == 0 && pointer_scan_collected_level.heap_candidate_count == 0
}

// Upstream `clear` — the slot is reused per discovered level; counts reset,
// backing extents stay caller-owned.
pub machine PointerScanCollectedLevel::clear(pointer_scan_collected_level: &mut PointerScanCollectedLevel) {
    pointer_scan_collected_level.static_candidate_count = 0;
    pointer_scan_collected_level.heap_candidate_count = 0;
}

pub machine PointerScanCollectedLevel::get_static_candidate_count(pointer_scan_collected_level: &PointerScanCollectedLevel) -> u64 {
    pointer_scan_collected_level.static_candidate_count
}

pub machine PointerScanCollectedLevel::get_heap_candidate_count(pointer_scan_collected_level: &PointerScanCollectedLevel) -> u64 {
    pointer_scan_collected_level.heap_candidate_count
}

// Upstream `static_candidates[index]` — callers bound via the count getters.
pub machine PointerScanCollectedLevel::get_static_candidate(
    pointer_scan_collected_level: &PointerScanCollectedLevel,
    index: u64
) -> PointerScanCollectedCandidate {
    transition index < pointer_scan_collected_level.static_candidates.len {
        true -> arm_result_92_0(pointer_scan_collected_level, index)
        false -> absent()
        _ -> absent()
    }

    state absent() -> PointerScanCollectedCandidate {
        (PointerScanCollectedCandidate {
            pointer_address: 0,
            pointer_value: 0,
            module_index: 0,
            module_offset: 0
        })
    }
    state arm_result_92_0(pointer_scan_collected_level: &PointerScanCollectedLevel, index: u64) -> PointerScanCollectedCandidate
    
    requires index < pointer_scan_collected_level.static_candidates.len;
{
        (pointer_scan_collected_level.static_candidates[index])
    }
}

// Upstream `heap_candidates[index]` — callers bound via the count getters.
pub machine PointerScanCollectedLevel::get_heap_candidate(
    pointer_scan_collected_level: &PointerScanCollectedLevel,
    index: u64
) -> PointerScanCollectedCandidate {
    transition index < pointer_scan_collected_level.heap_candidates.len {
        true -> arm_result_113_0(pointer_scan_collected_level, index)
        false -> absent()
        _ -> absent()
    }

    state absent() -> PointerScanCollectedCandidate {
        (PointerScanCollectedCandidate {
            pointer_address: 0,
            pointer_value: 0,
            module_index: 0,
            module_offset: 0
        })
    }
    state arm_result_113_0(pointer_scan_collected_level: &PointerScanCollectedLevel, index: u64) -> PointerScanCollectedCandidate
    
    requires index < pointer_scan_collected_level.heap_candidates.len;
{
        (pointer_scan_collected_level.heap_candidates[index])
    }
}
