module src::pointer_scans::pointer_scan_dispatcher;

use squalr_engine_api::src::registries::scan_rules::pointer_scan_rule_registry::PointerScanRuleRegistry;
use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use squalr_engine_api::src::structures::scanning::plans::pointer_scan::planned_pointer_scan_kernel_kind::PlannedPointerScanKernelKind;
use squalr_engine_api::src::structures::scanning::plans::pointer_scan::pointer_scan_execution_plan::PointerScanExecutionPlan;
use src::pointer_scans::search_kernels::pointer_scan_scalar_binary_search_kernel::ScalarBinaryPointerScanKernel;
use src::pointer_scans::search_kernels::pointer_scan_scalar_linear_search_kernel::ScalarLinearPointerScanKernel;
use src::pointer_scans::search_kernels::pointer_scan_search_kernel_context::PointerScanSearchKernelContext;
use src::pointer_scans::search_kernels::pointer_scan_search_kernel::PointerScanMatchVisitor;
use src::pointer_scans::search_kernels::pointer_scan_simd_linear_search_kernel::SimdLinearPointerScanKernel;
use src::pointer_scans::structures::pointer_scan_target_ranges::PointerScanTargetRangeSet;
use src::pointer_scans::structures::pointer_scan_target_ranges::pointer_scan_target_range_set_get_range_count;

// Port of pointer_scan_dispatcher.rs.
//
// Upstream `acquire_range_search_kernel` returns `&'static dyn
// PointerScanSearchKernel` over three unit-struct statics. Omega has no
// static trait objects, so the acquired kernel is a tag enum — the
// ScalarRegionScanKind precedent for trait-object selection — and the tag's
// `is_empty`/`scan_region_with_visitor` dispatch to the same concrete kernel
// upstream selects, with the same signatures.
pub data PointerScanRangeSearchKernel [copy] {
    case ScalarLinear;
    case ScalarBinary;
    case SimdLinear;
}

pub machine PointerScanRangeSearchKernel::is_empty(
    &self,
    pointer_scan_search_kernel_context: &PointerScanSearchKernelContext
) -> bool {
    transition self {
        PointerScanRangeSearchKernel::ScalarLinear -> scalar_linear(
            pointer_scan_search_kernel_context
        )
        PointerScanRangeSearchKernel::ScalarBinary -> scalar_binary(
            pointer_scan_search_kernel_context
        )
        PointerScanRangeSearchKernel::SimdLinear -> simd_linear(
            pointer_scan_search_kernel_context
        )
        _ -> simd_linear(pointer_scan_search_kernel_context)
    }

    state scalar_linear(
        pointer_scan_search_kernel_context: &PointerScanSearchKernelContext
    ) -> bool {
        let kernel: ScalarLinearPointerScanKernel = ScalarLinearPointerScanKernel {};
        kernel.is_empty(pointer_scan_search_kernel_context)
    }

    state scalar_binary(
        pointer_scan_search_kernel_context: &PointerScanSearchKernelContext
    ) -> bool {
        let kernel: ScalarBinaryPointerScanKernel = ScalarBinaryPointerScanKernel {};
        kernel.is_empty(pointer_scan_search_kernel_context)
    }

    state simd_linear(
        pointer_scan_search_kernel_context: &PointerScanSearchKernelContext
    ) -> bool {
        let kernel: SimdLinearPointerScanKernel = SimdLinearPointerScanKernel {};
        kernel.is_empty(pointer_scan_search_kernel_context)
    }
}

pub machine PointerScanRangeSearchKernel::scan_region_with_visitor(
    &self,
    pointer_scan_search_kernel_context: &PointerScanSearchKernelContext,
    base_address: u64,
    current_values: &[u8],
    visit_match: &mut dyn PointerScanMatchVisitor
) {
    transition self {
        PointerScanRangeSearchKernel::ScalarLinear -> scalar_linear(
            pointer_scan_search_kernel_context,
            base_address,
            current_values,
            &mut visit_match
        )
        PointerScanRangeSearchKernel::ScalarBinary -> scalar_binary(
            pointer_scan_search_kernel_context,
            base_address,
            current_values,
            &mut visit_match
        )
        PointerScanRangeSearchKernel::SimdLinear -> simd_linear(
            pointer_scan_search_kernel_context,
            base_address,
            current_values,
            &mut visit_match
        )
        _ -> simd_linear(
            pointer_scan_search_kernel_context,
            base_address,
            current_values,
            &mut visit_match
        )
    }

    state scalar_linear(
        pointer_scan_search_kernel_context: &PointerScanSearchKernelContext,
        base_address: u64,
        current_values: &[u8],
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        let kernel: ScalarLinearPointerScanKernel = ScalarLinearPointerScanKernel {};
        kernel.scan_region_with_visitor(
            pointer_scan_search_kernel_context,
            base_address,
            current_values,
            &mut visit_match
        );
    }

    state scalar_binary(
        pointer_scan_search_kernel_context: &PointerScanSearchKernelContext,
        base_address: u64,
        current_values: &[u8],
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        let kernel: ScalarBinaryPointerScanKernel = ScalarBinaryPointerScanKernel {};
        kernel.scan_region_with_visitor(
            pointer_scan_search_kernel_context,
            base_address,
            current_values,
            &mut visit_match
        );
    }

    state simd_linear(
        pointer_scan_search_kernel_context: &PointerScanSearchKernelContext,
        base_address: u64,
        current_values: &[u8],
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        let kernel: SimdLinearPointerScanKernel = SimdLinearPointerScanKernel {};
        kernel.scan_region_with_visitor(
            pointer_scan_search_kernel_context,
            base_address,
            current_values,
            &mut visit_match
        );
    }
}

// Upstream's `PointerScanDispatcher` unit struct.
pub data PointerScanDispatcher {}

pub machine PointerScanDispatcher::build_execution_plan<'a>(
    &self,
    target_range_set: &PointerScanTargetRangeSet,
    pointer_size: PointerScanPointerSize,
    scan_region_byte_count: u64
) -> PointerScanExecutionPlan {
    let target_range_count: u64 =
        pointer_scan_target_range_set_get_range_count(target_range_set);
    let mut pointer_scan_execution_plan: PointerScanExecutionPlan =
        PointerScanExecutionPlan::new(
            pointer_size,
            target_range_count,
            scan_region_byte_count
        );
    // Upstream loops `PointerScanRuleRegistry::get_instance()
    //   .get_pointer_scan_planning_rule_registry().iter()` calling
    // `rule.map_plan(&mut plan)` per planning rule. The registry's entries are
    // trait objects that cannot be iterated as a slice, so the composed pass
    // is one machine on the registry that applies its rules in order — same
    // mapping sequence, same resulting plan.
    PointerScanRuleRegistry::get_instance().map_pointer_scan_execution_plan(
        &mut pointer_scan_execution_plan
    );
    pointer_scan_execution_plan
}

pub machine PointerScanDispatcher::acquire_range_search_kernel(
    &self,
    target_range_set: &PointerScanTargetRangeSet,
    pointer_scan_execution_plan: &PointerScanExecutionPlan
) -> PointerScanRangeSearchKernel {
    transition pointer_scan_execution_plan.get_planned_kernel_kind() {
        PlannedPointerScanKernelKind::ScalarLinear -> (
            PointerScanRangeSearchKernel::ScalarLinear
        )
        PlannedPointerScanKernelKind::ScalarBinary -> (
            PointerScanRangeSearchKernel::ScalarBinary
        )
        PlannedPointerScanKernelKind::SimdLinear -> (
            PointerScanRangeSearchKernel::SimdLinear
        )
        _ -> (PointerScanRangeSearchKernel::SimdLinear)
    }
}
