module src::pointer_scans::pointer_scan_level_collector;

use squalr_engine_api::src::structures::memory::normalized_module::NormalizedModule;
use squalr_engine_api::src::structures::memory::normalized_region;
use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use squalr_engine_api::src::structures::scanning::plans::pointer_scan::pointer_scan_execution_plan::PointerScanExecutionPlan;
use squalr_engine_api::src::structures::scanning::plans::pointer_scan::pointer_scan_parameters::PointerScanParameters;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use src::pointer_scans::pointer_scan_candidate_collector::PointerScanCandidateCollector;
use src::pointer_scans::pointer_scan_task_builder::PointerScanTaskBuilder;
use src::pointer_scans::pointer_scan_task_builder::PointerScanTaskBuildState;
use src::pointer_scans::structures::pointer_scan_collected_candidate::PointerScanCollectedCandidate;
use src::pointer_scans::structures::pointer_scan_collected_level::PointerScanCollectedLevel;
use src::pointer_scans::structures::pointer_scan_target_ranges::PointerScanTargetRangeSet;
use src::pointer_scans::structures::pointer_scan_target_ranges::PointerScanTargetRangeBucket;
use src::pointer_scans::structures::pointer_scan_target_ranges::pointer_scan_target_range_set_is_empty;
use src::pointer_scans::structures::snapshot_region_scan_task::SnapshotRegionScanTask;
use src::pointer_scans::structures::snapshot_region_scan_task::SnapshotRegionScanTasks;

// Port of pointer_scan_level_collector.rs.
//
// Upstream `discover_pointer_levels` returns `Vec<PointerScanCollectedLevel>`
// after running its whole level loop eagerly. Vec construction does not
// exist in Omega yet, so the collector is a pull driver: `next` runs exactly
// one upstream loop iteration, reporting `EmittedDiscoveredLevel::Level` per
// retained level and `Done` where upstream breaks (empty frontier, empty
// level, or depth reached). Levels are produced in upstream order; the
// caller drains until Done.
//
// Two carrier changes fall out of borrowed extents: the emitted level is a
// caller-owned `level_out` slot (a `PointerScanCollectedLevel` borrows its
// candidate extents, so it cannot travel inside the emitted tag — the tag is
// `Level`/`Done` only), and the frontier is REBUILT in place —
// `heap_address_scratch` receives the level's heap candidate addresses (they
// are produced in scan order, hence already sorted, exactly as upstream's
// `iter().map(|c| c.pointer_address)` feeds `from_sorted_target_addresses_iter`)
// and `rebuild_from_sorted_target_addresses` merges them over the set's own
// extents, so a level's frontier can never outgrow the initial frontier.
pub data EmittedDiscoveredLevel {
    case Level;
    case Done;
}

// Kind query on the union — `transition self` is admitted on self while a
// let-bound union scrutinee is not, so consumers hoist the bool.
pub machine EmittedDiscoveredLevel::is_level(emitted_discovered_level: &EmittedDiscoveredLevel) -> bool {
    transition emitted_discovered_level {
        EmittedDiscoveredLevel::Level -> (true)
        _ -> (false)
    }
}

// Source contract for the results builder: both the discovery driver and the
// validator's rebuilt-levels driver yield collected levels through it.
pub trait PointerScanCollectedLevelSource {
    machine next<'candidates>(
        receiver: &mut Self,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64]
    ) -> EmittedDiscoveredLevel;
}

pub data PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params> {
    frontier_target_ranges: PointerScanTargetRangeSet<'frontier>;
    snapshot_region_scan_tasks: SnapshotRegionScanTasks<'tasks, 'values>;
    pointer_scan_parameters: &'params PointerScanParameters;
    pointer_chain_depth: u64;
    stopped: bool;
}

// Upstream construction: initial frontier from the target addresses, tasks
// from the builder, depth counter at zero. A `max_depth == 0` scan returns
// an empty result upstream; here `next` reports `Done` immediately via the
// same check on its first entry.
pub machine PointerScanDiscoveredLevels::new<'frontier, 'tasks, 'values, 'params>(
    frontier_target_ranges: PointerScanTargetRangeSet<'frontier>,
    snapshot_region_scan_tasks: SnapshotRegionScanTasks<'tasks, 'values>,
    pointer_scan_parameters: &'params PointerScanParameters
) -> PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params> {
    PointerScanDiscoveredLevels {
        frontier_target_ranges: frontier_target_ranges,
        snapshot_region_scan_tasks: snapshot_region_scan_tasks,
        pointer_scan_parameters: pointer_scan_parameters,
        pointer_chain_depth: 0,
        stopped: false,
    }
}

pub machine PointerScanDiscoveredLevels::next<'frontier, 'tasks, 'values, 'params, 'candidates>(
    pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
    level_out: &mut PointerScanCollectedLevel<'candidates>,
    heap_address_scratch: &mut [u64]
) -> EmittedDiscoveredLevel satisfies PointerScanCollectedLevelSource::next {
    transition pointer_scan_discovered_levels.stopped {
        true -> arm_result_85_0()
        false -> depth_gate(pointer_scan_discovered_levels, level_out, heap_address_scratch)
        _ -> depth_gate(pointer_scan_discovered_levels, level_out, heap_address_scratch)
    }

    state depth_gate(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64]
    ) -> EmittedDiscoveredLevel {
        // Upstream `if max_depth == 0 { return vec![] }` — the driver yields
        // `Done` on its first call instead.
        transition PointerScanParameters::get_max_depth(&pointer_scan_discovered_levels.pointer_scan_parameters) == 0 {
            true -> stop(pointer_scan_discovered_levels)
            false -> frontier_gate(pointer_scan_discovered_levels, level_out, heap_address_scratch)
            _ -> frontier_gate(pointer_scan_discovered_levels, level_out, heap_address_scratch)
        }
    }

    state frontier_gate(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64]
    ) -> EmittedDiscoveredLevel {
        // Upstream `if frontier_target_ranges.is_empty() { break; }`.
        transition pointer_scan_target_range_set_is_empty(&pointer_scan_discovered_levels.frontier_target_ranges) {
            true -> stop(pointer_scan_discovered_levels)
            false -> plan(pointer_scan_discovered_levels, level_out, heap_address_scratch)
            _ -> plan(pointer_scan_discovered_levels, level_out, heap_address_scratch)
        }
    }

    state plan(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64]
    ) -> EmittedDiscoveredLevel {
        let collector: PointerScanCandidateCollector = PointerScanCandidateCollector {};
        let pointer_size: PointerScanPointerSize =
            PointerScanParameters::get_pointer_size(&pointer_scan_discovered_levels.pointer_scan_parameters);
        let pointer_scan_execution_plan: PointerScanExecutionPlan =
            PointerScanCandidateCollector::build_execution_plan(&collector, 
                &pointer_scan_discovered_levels.frontier_target_ranges,
                pointer_size,
                &pointer_scan_discovered_levels.snapshot_region_scan_tasks
            );
        // Upstream `retain_heap_candidates = !is_terminal_level`.
        let is_terminal_level: bool = ((pointer_scan_discovered_levels.pointer_chain_depth as u64 in Saturating)
            + (1 as u64 in Saturating)) as u64 >= PointerScanParameters::get_max_depth(&pointer_scan_discovered_levels.pointer_scan_parameters);
        // The level slot is caller-owned; collect writes into it rather than
        // returning a level the way upstream's Vec materializes.
        PointerScanCollectedLevel::clear(level_out);
        PointerScanCandidateCollector::collect_candidates_into(&collector, 
            &pointer_scan_discovered_levels.snapshot_region_scan_tasks,
            &pointer_scan_discovered_levels.frontier_target_ranges,
            &pointer_scan_execution_plan,
            true,
            !is_terminal_level,
            &mut level_out
        );
        transition PointerScanCollectedLevel::is_empty(level_out) {
            true -> stop(pointer_scan_discovered_levels)
            false -> emit(pointer_scan_discovered_levels, level_out, heap_address_scratch, is_terminal_level)
            _ -> emit(pointer_scan_discovered_levels, level_out, heap_address_scratch, is_terminal_level)
        }
    }

    state emit(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        is_terminal_level: bool
    ) -> EmittedDiscoveredLevel {
        // Upstream rebuilds the frontier from the level's heap candidate
        // addresses only on non-terminal levels.
        transition is_terminal_level {
            true -> advance(pointer_scan_discovered_levels, level_out)
            false -> extract_heap(pointer_scan_discovered_levels, level_out, heap_address_scratch, 0)
        }
    }

    // Upstream `heap_candidates.iter().map(|c| c.pointer_address)` — the
    // ordered heap candidates land in the caller's scratch; each is then
    // merged through `rebuild_from_sorted_target_addresses`.
    state extract_heap(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        candidate_index: u64
    ) -> EmittedDiscoveredLevel {
        transition candidate_index < PointerScanCollectedLevel::get_heap_candidate_count(level_out) {
            true -> heap_write_gate(pointer_scan_discovered_levels, level_out, heap_address_scratch, candidate_index)
            false -> rebuild_frontier(pointer_scan_discovered_levels, level_out, heap_address_scratch, candidate_index)
        }
    }

    state heap_write_gate(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        candidate_index: u64
    ) -> EmittedDiscoveredLevel {
        transition candidate_index < heap_address_scratch.len {
            true -> heap_write(pointer_scan_discovered_levels, level_out, heap_address_scratch, candidate_index)
            false -> rebuild_frontier(pointer_scan_discovered_levels, level_out, heap_address_scratch, candidate_index)
        }
    }

    state heap_write(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        candidate_index: u64
    ) -> EmittedDiscoveredLevel {
        let candidate: PointerScanCollectedCandidate =
            PointerScanCollectedLevel::get_heap_candidate(level_out, candidate_index);
        heap_address_scratch[candidate_index] = candidate.pointer_address;
        transition { _ -> extract_heap(pointer_scan_discovered_levels, level_out, heap_address_scratch, ((candidate_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64) }
    }

    state rebuild_frontier(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        heap_candidate_count: u64
    ) -> EmittedDiscoveredLevel {
        let scan_offset_radius: u64 =
            PointerScanParameters::get_offset_radius(&pointer_scan_discovered_levels.pointer_scan_parameters);
        transition heap_candidate_count <= heap_address_scratch.len {
            true -> rebuild(pointer_scan_discovered_levels, level_out, heap_address_scratch, heap_candidate_count, scan_offset_radius)
            false -> truncate(pointer_scan_discovered_levels, level_out, heap_address_scratch, scan_offset_radius)
        }
    }

    state rebuild(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        heap_candidate_count: u64,
        scan_offset_radius: u64
    ) -> EmittedDiscoveredLevel {
        transition heap_candidate_count <= heap_address_scratch.len {
            true -> rebuild_apply(pointer_scan_discovered_levels, level_out, &heap_address_scratch[0..heap_candidate_count], scan_offset_radius)
            false -> advance(pointer_scan_discovered_levels, level_out)
        }
    }

    state rebuild_apply(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        sorted_target_addresses: &[u64],
        scan_offset_radius: u64
    ) -> EmittedDiscoveredLevel {
        PointerScanTargetRangeSet::rebuild_from_sorted_target_addresses(&mut pointer_scan_discovered_levels.frontier_target_ranges, 
            sorted_target_addresses,
            scan_offset_radius
        );
        transition { _ -> advance(pointer_scan_discovered_levels, level_out) }
    }

    // Scratch shorter than the heap count truncates the frontier input —
    // same sorted prefix, fewer merged ranges (bounded-extent deviation).
    state truncate(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        scan_offset_radius: u64
    ) -> EmittedDiscoveredLevel {
        transition 0 <= heap_address_scratch.len {
            true -> truncate_apply(pointer_scan_discovered_levels, level_out, &heap_address_scratch[0..0], scan_offset_radius)
            false -> advance(pointer_scan_discovered_levels, level_out)
            _ -> advance(pointer_scan_discovered_levels, level_out)
        }
    }

    state truncate_apply(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        sorted_target_addresses: &[u64],
        scan_offset_radius: u64
    ) -> EmittedDiscoveredLevel {
        PointerScanTargetRangeSet::rebuild_from_sorted_target_addresses(&mut pointer_scan_discovered_levels.frontier_target_ranges, 
            sorted_target_addresses,
            scan_offset_radius
        );
        transition { _ -> advance(pointer_scan_discovered_levels, level_out) }
    }

    state advance(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>
    ) -> EmittedDiscoveredLevel {
        pointer_scan_discovered_levels.pointer_chain_depth =
            ((pointer_scan_discovered_levels.pointer_chain_depth as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        transition pointer_scan_discovered_levels.pointer_chain_depth >=
            PointerScanParameters::get_max_depth(&pointer_scan_discovered_levels.pointer_scan_parameters) {
            true -> stop_with_level(pointer_scan_discovered_levels)
            false -> (EmittedDiscoveredLevel::Level)
            _ -> (EmittedDiscoveredLevel::Level)
        }
    }

    state stop_with_level(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels
    ) -> EmittedDiscoveredLevel {
        pointer_scan_discovered_levels.stopped = true;
        EmittedDiscoveredLevel::Level
    }

    state stop(
        pointer_scan_discovered_levels: &mut PointerScanDiscoveredLevels
    ) -> EmittedDiscoveredLevel {
        pointer_scan_discovered_levels.stopped = true;
        EmittedDiscoveredLevel::Done
    }
    state arm_result_85_0() -> EmittedDiscoveredLevel
    {
        (EmittedDiscoveredLevel::Done)
    }
}

// Upstream's `PointerScanLevelCollector` unit struct.
pub data PointerScanLevelCollector {}

// Upstream `discover_pointer_levels`. Its `Vec` return becomes the driver
// above — same construction of target ranges, task build, and loop bounds.
// The `with_logging` parameter is retained for signature parity; the upstream
// `log::info!` timing/progress emissions are deferred to a logging surface
// and change no data flow. All extents are caller-owned: `sorted_scratch`
// (>= target_addresses.len) backs the initial frontier sort;
// `target_ranges`/`lower_bounds`/`upper_bounds`/`target_range_buckets` bound
// merged frontier ranges and buckets; `tasks_scratch`/`byte_arena` bound the
// built scan tasks and their decoded byte views; `module_order_scratch`
// (>= modules.len) backs the module sort.
pub machine PointerScanLevelCollector::discover_pointer_levels<'frontier, 'tasks, 'values, 'params>(
    pointer_scan_level_collector: &PointerScanLevelCollector,
    snapshots: &[&Snapshot],
    target_addresses: &[u64],
    pointer_scan_parameters: &'params PointerScanParameters,
    modules: &[NormalizedModule],
    with_logging: bool,
    sorted_scratch: &'frontier mut [u64],
    target_ranges: &'frontier mut [normalized_region::NormalizedRegion],
    lower_bounds: &'frontier mut [u64],
    upper_bounds: &'frontier mut [u64],
    target_range_buckets: &'frontier mut [PointerScanTargetRangeBucket],
    tasks_scratch: &'tasks mut [SnapshotRegionScanTask],
    byte_arena: &'values mut [u8],
    module_order_scratch: &mut [u64]
) -> PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params> {
    let builder: PointerScanTaskBuilder = PointerScanTaskBuilder {};
    let pointer_size: PointerScanPointerSize = PointerScanParameters::get_pointer_size(pointer_scan_parameters);
    let task_build: PointerScanTaskBuildState =
        PointerScanTaskBuilder::build_snapshot_region_scan_tasks(&builder, 
            snapshots,
            modules,
            pointer_size,
            true,
            module_order_scratch,
            &mut tasks_scratch[..],
            &mut byte_arena[..]
        );
    let snapshot_region_scan_tasks: SnapshotRegionScanTasks<'tasks, 'values> =
        SnapshotRegionScanTasks::new(
            tasks_scratch,
            byte_arena,
            task_build.task_count
        );
    let offset_radius: u64 = PointerScanParameters::get_offset_radius(pointer_scan_parameters);
    let frontier_target_ranges: PointerScanTargetRangeSet<'frontier> =
        PointerScanTargetRangeSet::from_target_addresses(
            target_addresses,
            offset_radius,
            sorted_scratch,
            target_ranges,
            lower_bounds,
            upper_bounds,
            target_range_buckets
        );
    PointerScanDiscoveredLevels::new(
        frontier_target_ranges,
        snapshot_region_scan_tasks,
        pointer_scan_parameters
    )
}
