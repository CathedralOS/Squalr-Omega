use {squalr_engine_api}/src/structures/data_values/pointer_scan_pointer_size.omg;
use {squalr_engine_api}/src/structures/scanning/plans/pointer_scan/pointer_scan_execution_plan.omg;
use src/pointer_scans/pointer_scan_dispatcher.omg;
use src/pointer_scans/search_kernels/pointer_scan_search_kernel_context.omg;
use src/pointer_scans/search_kernels/pointer_scan_search_kernel.omg;
use src/pointer_scans/structures/pointer_scan_collected_candidate.omg;
use src/pointer_scans/structures/pointer_scan_collected_level.omg;
use src/pointer_scans/structures/pointer_scan_region_match.omg;
use src/pointer_scans/structures/pointer_scan_target_ranges.omg;
use src/pointer_scans/structures/snapshot_region_scan_task.omg;
use src/pointer_scans/structures/snapshot_region_scan_task_kind.omg;

// Port of pointer_scan_candidate_collector.rs.
//
// Upstream's per-task `&mut |pointer_match| {...}` closure captures
// (scan_end_address, task_kind, retain flags, `&mut collected_level`). The
// closure becomes a visitor data type whose `visit` satisfies
// PointerScanMatchVisitor — the closure body is preserved verbatim, with the
// captured mutable level as a borrowed field.
public data PointerScanCandidateCollectingVisitor<'level, 'candidates> {
    scan_end_address: u64;
    task_kind: |snapshot_region_scan_task_kind|::SnapshotRegionScanTaskKind;
    retain_static_candidates: bool;
    retain_heap_candidates: bool;
    collected_level: &'level mut |pointer_scan_collected_level|::PointerScanCollectedLevel<'candidates>;
}
// Upstream `impl PointerScanMatchVisitor for PointerScanCandidateCollectingVisitor`:
// the named implementation forwards to the collector's own visit machine, and
// the candidate walk selects it as the kernels' match visitor.
public CollectingVisitor<'level, 'candidates> satisfies |pointer_scan_search_kernel|::PointerScanMatchVisitor<PointerScanCandidateCollectingVisitor<'level, 'candidates>> {
    machine visit(provider: &mut PointerScanCandidateCollectingVisitor<'level, 'candidates>, pointer_match: |pointer_scan_region_match|::PointerScanRegionMatch) {
        PointerScanCandidateCollectingVisitor::visit(provider, pointer_match);
    }
}


public machine PointerScanCandidateCollectingVisitor::visit<'level, 'candidates>(
    this: &mut PointerScanCandidateCollectingVisitor,
    pointer_match: |pointer_scan_region_match|::PointerScanRegionMatch
)
{
    let pointer_address: u64 = |pointer_scan_region_match|::PointerScanRegionMatch::get_pointer_address(&pointer_match);
    transition pointer_address >= this.scan_end_address {
        true -> finished()
        false -> by_kind(this, pointer_address, |pointer_scan_region_match|::PointerScanRegionMatch::get_pointer_value(&pointer_match))
        _ -> by_kind(this, pointer_address, |pointer_scan_region_match|::PointerScanRegionMatch::get_pointer_value(&pointer_match))
    }

    machine by_kind(
        this: &mut PointerScanCandidateCollectingVisitor,
        pointer_address: u64,
        pointer_value: u64
    ) {
        transition this.task_kind {
            |snapshot_region_scan_task_kind|::SnapshotRegionScanTaskKind::Static {
                module_index,
                module_base_address
            } -> static_case(this, 
                pointer_address,
                pointer_value,
                module_index,
                module_base_address
            )
            |snapshot_region_scan_task_kind|::SnapshotRegionScanTaskKind::Heap -> heap_case(this,
                pointer_address,
                pointer_value
            )
            _ -> finished()
        }
    }

    machine static_case(
        this: &mut PointerScanCandidateCollectingVisitor,
        pointer_address: u64,
        pointer_value: u64,
        module_index: u64,
        module_base_address: u64
    ) {
        transition this.retain_static_candidates {
            true -> push_static(this, 
                |pointer_scan_collected_candidate|::PointerScanCollectedCandidate {
                    pointer_address: pointer_address,
                    pointer_value: pointer_value,
                    module_index: module_index,
                    module_offset: ((pointer_address as u64 in Saturating) - (module_base_address as u64 in Saturating)) as u64
                }
            )
            false -> finished()
            _ -> finished()
        }
    }

    machine push_static(
        this: &mut PointerScanCandidateCollectingVisitor,
        candidate: |pointer_scan_collected_candidate|::PointerScanCollectedCandidate
    ) {
        |pointer_scan_collected_level|::PointerScanCollectedLevel::push_static(&mut this.collected_level, candidate);
    }

    machine heap_case(
        this: &mut PointerScanCandidateCollectingVisitor,
        pointer_address: u64,
        pointer_value: u64
    ) {
        transition this.retain_heap_candidates {
            true -> push_heap(this, 
                |pointer_scan_collected_candidate|::PointerScanCollectedCandidate {
                    pointer_address: pointer_address,
                    pointer_value: pointer_value,
                    module_index: 0,
                    module_offset: 0
                }
            )
            false -> finished()
            _ -> finished()
        }
    }

    machine push_heap(
        this: &mut PointerScanCandidateCollectingVisitor,
        candidate: |pointer_scan_collected_candidate|::PointerScanCollectedCandidate
    ) {
        |pointer_scan_collected_level|::PointerScanCollectedLevel::push_heap(&mut this.collected_level, candidate);
    }

    machine finished() {}
}

// Upstream's `PointerScanCandidateCollector` unit struct.
public data PointerScanCandidateCollector {}

// Upstream `build_execution_plan`: largest task byte view becomes the plan's
// scan_region_byte_count before the dispatcher maps planning rules.
public machine PointerScanCandidateCollector::build_execution_plan<'ranges, 'tasks, 'values>(
    this: &PointerScanCandidateCollector,
    frontier_target_ranges: &'ranges |pointer_scan_target_ranges|::PointerScanTargetRangeSet<'ranges>,
    pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize,
    snapshot_region_scan_tasks: &'tasks |snapshot_region_scan_task|::SnapshotRegionScanTasks<'tasks, 'values>
) -> |pointer_scan_execution_plan|::PointerScanExecutionPlan {
    let dispatcher: |pointer_scan_dispatcher|::PointerScanDispatcher = |pointer_scan_dispatcher|::PointerScanDispatcher {};
    let hoist3: |pointer_scan_execution_plan|::PointerScanExecutionPlan = |pointer_scan_dispatcher|::PointerScanDispatcher::build_execution_plan(&dispatcher, frontier_target_ranges,
        pointer_size,
        |snapshot_region_scan_task|::SnapshotRegionScanTasks::get_largest_region_byte_count(&snapshot_region_scan_tasks));
    (hoist3)
}

// Upstream `collect_candidates`. Its per-task `par_iter().map(collect one
// level) -> append into merged` is a sequential task walk here: the merged
// level accumulates task outputs in the same task order, so the produced
// candidate order is identical — partition-owned output into the
// caller's `level_out` extents.
public machine PointerScanCandidateCollector::collect_candidates_into<'ranges, 'tasks, 'values, 'candidates>(
    this: &PointerScanCandidateCollector,
    snapshot_region_scan_tasks: &'tasks |snapshot_region_scan_task|::SnapshotRegionScanTasks<'tasks, 'values>,
    frontier_target_ranges: &'ranges |pointer_scan_target_ranges|::PointerScanTargetRangeSet<'ranges>,
    pointer_scan_execution_plan: &|pointer_scan_execution_plan|::PointerScanExecutionPlan,
    retain_static_candidates: bool,
    retain_heap_candidates: bool,
    level_out: &'candidates mut |pointer_scan_collected_level|::PointerScanCollectedLevel<'candidates>
) {
    let dispatcher: |pointer_scan_dispatcher|::PointerScanDispatcher = |pointer_scan_dispatcher|::PointerScanDispatcher {};
    let range_search_kernel: |pointer_scan_dispatcher|::PointerScanRangeSearchKernel =
        |pointer_scan_dispatcher|::PointerScanDispatcher::acquire_range_search_kernel(&dispatcher, frontier_target_ranges,
            pointer_scan_execution_plan);
    let pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize =
        |pointer_scan_execution_plan|::PointerScanExecutionPlan::get_pointer_size(&pointer_scan_execution_plan);
    let pointer_scan_search_kernel_context: |pointer_scan_search_kernel_context|::PointerScanSearchKernelContext =
        |pointer_scan_search_kernel_context|::PointerScanSearchKernelContext::new(frontier_target_ranges, pointer_size);
    transition { _ -> begin(
        &range_search_kernel,
        &pointer_scan_search_kernel_context,
        snapshot_region_scan_tasks,
        retain_static_candidates,
        retain_heap_candidates,
        level_out,
        0
    ) }

    // Upstream `if range_search_kernel.is_empty(context) { return default }`.
    machine begin(
        range_search_kernel: &|pointer_scan_dispatcher|::PointerScanRangeSearchKernel,
        pointer_scan_search_kernel_context: &|pointer_scan_search_kernel_context|::PointerScanSearchKernelContext,
        snapshot_region_scan_tasks: &'tasks |snapshot_region_scan_task|::SnapshotRegionScanTasks<'tasks, 'values>,
        retain_static_candidates: bool,
        retain_heap_candidates: bool,
        level_out: &'candidates mut |pointer_scan_collected_level|::PointerScanCollectedLevel<'candidates>,
        task_index: u64
    ) {
        let hoist1: bool = |pointer_scan_dispatcher|::PointerScanRangeSearchKernel::is_empty(&range_search_kernel, pointer_scan_search_kernel_context);
        transition hoist1 {
            true -> finished()
            false -> per_task(range_search_kernel, pointer_scan_search_kernel_context, snapshot_region_scan_tasks, retain_static_candidates, retain_heap_candidates, level_out, task_index)
            _ -> per_task(range_search_kernel, pointer_scan_search_kernel_context, snapshot_region_scan_tasks, retain_static_candidates, retain_heap_candidates, level_out, task_index)
        }
    }

    machine per_task(
        range_search_kernel: &|pointer_scan_dispatcher|::PointerScanRangeSearchKernel,
        pointer_scan_search_kernel_context: &|pointer_scan_search_kernel_context|::PointerScanSearchKernelContext,
        snapshot_region_scan_tasks: &'tasks |snapshot_region_scan_task|::SnapshotRegionScanTasks<'tasks, 'values>,
        retain_static_candidates: bool,
        retain_heap_candidates: bool,
        level_out: &'candidates mut |pointer_scan_collected_level|::PointerScanCollectedLevel<'candidates>,
        task_index: u64
    ) {
        let hoist2: u64 = |snapshot_region_scan_task|::SnapshotRegionScanTasks::get_task_count(snapshot_region_scan_tasks);
        transition task_index < hoist2 {
            true -> scan_task(range_search_kernel, pointer_scan_search_kernel_context, snapshot_region_scan_tasks, retain_static_candidates, retain_heap_candidates, level_out, task_index)
            false -> finished()
        }
    }

    // Upstream `collect_task_matches`: the visitor carries the task's
    // end address + kind so each match routes static/heap like the closure.
    machine scan_task(
        range_search_kernel: &|pointer_scan_dispatcher|::PointerScanRangeSearchKernel,
        pointer_scan_search_kernel_context: &|pointer_scan_search_kernel_context|::PointerScanSearchKernelContext,
        snapshot_region_scan_tasks: &'tasks |snapshot_region_scan_task|::SnapshotRegionScanTasks<'tasks, 'values>,
        retain_static_candidates: bool,
        retain_heap_candidates: bool,
        level_out: &'candidates mut |pointer_scan_collected_level|::PointerScanCollectedLevel<'candidates>,
        task_index: u64
    ) {
        let snapshot_region_scan_task: |snapshot_region_scan_task|::SnapshotRegionScanTask =
            |snapshot_region_scan_task|::SnapshotRegionScanTasks::get_task(&snapshot_region_scan_tasks, task_index);
        let mut collecting_visitor: PointerScanCandidateCollectingVisitor =
            PointerScanCandidateCollectingVisitor {
                scan_end_address: snapshot_region_scan_task.scan_end_address,
                task_kind: snapshot_region_scan_task.task_kind,
                retain_static_candidates: retain_static_candidates,
                retain_heap_candidates: retain_heap_candidates,
                collected_level: &mut level_out
            };
        let task_values: &[u8] = |snapshot_region_scan_task|::SnapshotRegionScanTasks::get_task_values(&snapshot_region_scan_tasks, &snapshot_region_scan_task);
        let visitor: dyn |pointer_scan_search_kernel|::PointerScanMatchVisitor<PointerScanCandidateCollectingVisitor> = CollectingVisitor as dyn |pointer_scan_search_kernel|::PointerScanMatchVisitor<PointerScanCandidateCollectingVisitor>;
        |pointer_scan_dispatcher|::PointerScanRangeSearchKernel::scan_region_with_visitor(&range_search_kernel, pointer_scan_search_kernel_context,
            snapshot_region_scan_task.scan_base_address,
            task_values,
            visitor,
            &mut collecting_visitor);
        transition { _ -> per_task(range_search_kernel, pointer_scan_search_kernel_context, snapshot_region_scan_tasks, retain_static_candidates, retain_heap_candidates, level_out, ((task_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64) }
    }

    machine finished() {}
}
