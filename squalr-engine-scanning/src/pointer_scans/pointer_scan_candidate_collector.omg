module src::pointer_scans::pointer_scan_candidate_collector;

use squalr_engine_api::src::structures::pointer_scans::pointer_scan_pointer_size::PointerScanPointerSize;
use squalr_engine_api::src::structures::scanning::plans::pointer_scan::pointer_scan_execution_plan::PointerScanExecutionPlan;
use src::pointer_scans::pointer_scan_dispatcher::PointerScanDispatcher;
use src::pointer_scans::pointer_scan_dispatcher::PointerScanRangeSearchKernel;
use src::pointer_scans::search_kernels::pointer_scan_search_kernel_context::PointerScanSearchKernelContext;
use src::pointer_scans::search_kernels::pointer_scan_simd_linear_search_kernel::PointerScanMatchVisitor;
use src::pointer_scans::structures::pointer_scan_collected_candidate::PointerScanCollectedCandidate;
use src::pointer_scans::structures::pointer_scan_collected_level::PointerScanCollectedLevel;
use src::pointer_scans::structures::pointer_scan_region_match::PointerScanRegionMatch;
use src::pointer_scans::structures::pointer_scan_target_ranges::PointerScanTargetRangeSet;
use src::pointer_scans::structures::snapshot_region_scan_task::SnapshotRegionScanTask;
use src::pointer_scans::structures::snapshot_region_scan_task::SnapshotRegionScanTasks;
use src::pointer_scans::structures::snapshot_region_scan_task_kind::SnapshotRegionScanTaskKind;

// Port of pointer_scan_candidate_collector.rs.
//
// Upstream's per-task `&mut |pointer_match| {...}` closure captures
// (scan_end_address, task_kind, retain flags, `&mut collected_level`). The
// closure becomes a visitor data type whose `visit` satisfies
// PointerScanMatchVisitor — the closure body is preserved verbatim, with the
// captured mutable level as a borrowed field.
pub data PointerScanCandidateCollectingVisitor<'a> {
    scan_end_address: u64;
    task_kind: SnapshotRegionScanTaskKind;
    retain_static_candidates: bool;
    retain_heap_candidates: bool;
    collected_level: &'a mut PointerScanCollectedLevel;
}

pub machine PointerScanCandidateCollectingVisitor::visit<'a>(
    &mut self,
    pointer_match: PointerScanRegionMatch
)
satisfies PointerScanMatchVisitor::visit
{
    let pointer_address: u64 = pointer_match.get_pointer_address();
    transition pointer_address >= self.scan_end_address {
        true -> finished()
        false -> by_kind(pointer_address, pointer_match.get_pointer_value())
        _ -> by_kind(pointer_address, pointer_match.get_pointer_value())
    }

    state by_kind(
        &mut self,
        pointer_address: u64,
        pointer_value: u64
    ) {
        transition self.task_kind {
            SnapshotRegionScanTaskKind::Static {
                module_index,
                module_base_address
            } -> static_case(
                pointer_address,
                pointer_value,
                module_index,
                module_base_address
            )
            SnapshotRegionScanTaskKind::Heap -> heap_case(
                pointer_address,
                pointer_value
            )
            _ -> finished()
        }
    }

    state static_case(
        &mut self,
        pointer_address: u64,
        pointer_value: u64,
        module_index: u64,
        module_base_address: u64
    ) {
        transition self.retain_static_candidates {
            true -> push_static(
                pointer_address,
                pointer_value,
                module_index,
                module_base_address
            )
            false -> finished()
            _ -> finished()
        }
    }

    state push_static(
        &mut self,
        pointer_address: u64,
        pointer_value: u64,
        module_index: u64,
        module_base_address: u64
    ) {
        self.collected_level.static_candidates.push(PointerScanCollectedCandidate {
            pointer_address: pointer_address,
            pointer_value: pointer_value,
            module_index: module_index,
            module_offset: ((pointer_address as u64 in Saturating)
                - (module_base_address as u64 in Saturating)) as u64,
        });
        finished()
    }

    state heap_case(
        &mut self,
        pointer_address: u64,
        pointer_value: u64
    ) {
        transition self.retain_heap_candidates {
            true -> push_heap(pointer_address, pointer_value)
            false -> finished()
            _ -> finished()
        }
    }

    state push_heap(
        &mut self,
        pointer_address: u64,
        pointer_value: u64
    ) {
        self.collected_level.heap_candidates.push(PointerScanCollectedCandidate {
            pointer_address: pointer_address,
            pointer_value: pointer_value,
            module_index: 0,
            module_offset: 0,
        });
        finished()
    }

    state finished() {}
}

// Upstream's `PointerScanCandidateCollector` unit struct.
pub data PointerScanCandidateCollector {}

pub machine PointerScanCandidateCollector::build_execution_plan<'a>(
    &self,
    frontier_target_ranges: &PointerScanTargetRangeSet,
    pointer_size: PointerScanPointerSize,
    snapshot_region_scan_tasks: &'a SnapshotRegionScanTasks<'a>
) -> PointerScanExecutionPlan {
    // `get_largest_region_byte_count` is upstream's
    // `iter().map(|t| t.current_values.len()).max().unwrap_or(0)` folded into
    // the task collection: it owns the per-task `current_values` views.
    let scan_region_byte_count: u64 =
        snapshot_region_scan_tasks.get_largest_region_byte_count();
    let dispatcher: PointerScanDispatcher = PointerScanDispatcher {};
    dispatcher.build_execution_plan(
        frontier_target_ranges,
        pointer_size,
        scan_region_byte_count
    )
}

pub machine PointerScanCandidateCollector::collect_candidates<'a>(
    &self,
    snapshot_region_scan_tasks: &'a SnapshotRegionScanTasks<'a>,
    frontier_target_ranges: &PointerScanTargetRangeSet,
    pointer_scan_execution_plan: &PointerScanExecutionPlan,
    retain_static_candidates: bool,
    retain_heap_candidates: bool
) -> PointerScanCollectedLevel {
    let dispatcher: PointerScanDispatcher = PointerScanDispatcher {};
    let range_search_kernel: PointerScanRangeSearchKernel =
        dispatcher.acquire_range_search_kernel(
            frontier_target_ranges,
            pointer_scan_execution_plan
        );
    let pointer_scan_search_kernel_context: PointerScanSearchKernelContext =
        PointerScanSearchKernelContext::new(
            frontier_target_ranges,
            pointer_scan_execution_plan.get_pointer_size()
        );
    self.collect_candidates_with_kernel(
        snapshot_region_scan_tasks,
        range_search_kernel,
        &pointer_scan_search_kernel_context,
        retain_static_candidates,
        retain_heap_candidates
    )
}

pub machine PointerScanCandidateCollector::collect_candidates_with_kernel<'a>(
    &self,
    snapshot_region_scan_tasks: &'a SnapshotRegionScanTasks<'a>,
    range_search_kernel: PointerScanRangeSearchKernel,
    pointer_scan_search_kernel_context: &PointerScanSearchKernelContext,
    retain_static_candidates: bool,
    retain_heap_candidates: bool
) -> PointerScanCollectedLevel {
    transition range_search_kernel.is_empty(pointer_scan_search_kernel_context) {
        true -> empty()
        false -> run(
            snapshot_region_scan_tasks,
            range_search_kernel,
            pointer_scan_search_kernel_context,
            retain_static_candidates,
            retain_heap_candidates
        )
        _ -> run(
            snapshot_region_scan_tasks,
            range_search_kernel,
            pointer_scan_search_kernel_context,
            retain_static_candidates,
            retain_heap_candidates
        )
    }

    state empty() -> PointerScanCollectedLevel {
        // Upstream `PointerScanCollectedLevel::default()`.
        PointerScanCollectedLevel::new()
    }

    // Upstream collects one `PointerScanCollectedLevel` per task under rayon
    // `par_iter` and then appends them into the merged level in task order.
    // The per-task staging exists only for thread partitioning: running the
    // tasks sequentially and letting the visitor push straight into the
    // merged level yields the identical ordered contents.
    state run(
        snapshot_region_scan_tasks: &'a SnapshotRegionScanTasks<'a>,
        range_search_kernel: PointerScanRangeSearchKernel,
        pointer_scan_search_kernel_context: &PointerScanSearchKernelContext,
        retain_static_candidates: bool,
        retain_heap_candidates: bool
    ) -> PointerScanCollectedLevel {
        let collected_level: PointerScanCollectedLevel =
            PointerScanCollectedLevel::new();
        next_task(
            snapshot_region_scan_tasks,
            range_search_kernel,
            pointer_scan_search_kernel_context,
            collected_level,
            retain_static_candidates,
            retain_heap_candidates,
            0
        )
    }

    state next_task(
        snapshot_region_scan_tasks: &'a SnapshotRegionScanTasks<'a>,
        range_search_kernel: PointerScanRangeSearchKernel,
        pointer_scan_search_kernel_context: &PointerScanSearchKernelContext,
        collected_level: PointerScanCollectedLevel,
        retain_static_candidates: bool,
        retain_heap_candidates: bool,
        task_index: u64
    ) -> PointerScanCollectedLevel {
        transition task_index < snapshot_region_scan_tasks.get_task_count() {
            true -> per_task(
                snapshot_region_scan_tasks,
                range_search_kernel,
                pointer_scan_search_kernel_context,
                collected_level,
                retain_static_candidates,
                retain_heap_candidates,
                task_index
            )
            false -> drained(collected_level)
        }
    }

    state per_task(
        snapshot_region_scan_tasks: &'a SnapshotRegionScanTasks<'a>,
        range_search_kernel: PointerScanRangeSearchKernel,
        pointer_scan_search_kernel_context: &PointerScanSearchKernelContext,
        collected_level: PointerScanCollectedLevel,
        retain_static_candidates: bool,
        retain_heap_candidates: bool,
        task_index: u64
    ) -> PointerScanCollectedLevel
    requires
        task_index < snapshot_region_scan_tasks.get_task_count()
    {
        let snapshot_region_scan_task: &SnapshotRegionScanTask =
            snapshot_region_scan_tasks.get_task(task_index);
        // The visitor's scoped borrow ends when `visit` calls finish: the
        // level moves onward to the next task with its pushes applied.
        let visitor: PointerScanCandidateCollectingVisitor =
            PointerScanCandidateCollectingVisitor {
                scan_end_address: snapshot_region_scan_task.scan_end_address,
                task_kind: snapshot_region_scan_task.task_kind,
                retain_static_candidates: retain_static_candidates,
                retain_heap_candidates: retain_heap_candidates,
                collected_level: &mut collected_level,
            };
        range_search_kernel.scan_region_with_visitor(
            pointer_scan_search_kernel_context,
            snapshot_region_scan_task.scan_base_address,
            snapshot_region_scan_task.current_values,
            &mut visitor
        );
        next_task(
            snapshot_region_scan_tasks,
            range_search_kernel,
            pointer_scan_search_kernel_context,
            collected_level,
            retain_static_candidates,
            retain_heap_candidates,
            ((task_index as u64 in Wrapping) + 1) as u64
        )
    }

    state drained(
        collected_level: PointerScanCollectedLevel
    ) -> PointerScanCollectedLevel {
        collected_level
    }
}
