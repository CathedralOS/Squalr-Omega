module src::pointer_scans::mod;

// Mirrors pointer_scans/mod.rs: the directory's public surface is the
// executor task and the validator; everything else is package-internal.
// Omega `use` wiring in the package main pulls the compiled set.
// The results-builder and executor-task legs stay deferred until the
// results materializer's api symbols land on main (see the lane's
// pointer_scan_results reservation — pointer_scan_results /
// pointer_scan_target_descriptor / emitted_built_level /
// pointer_scan_built_level_source).
use src::pointer_scans::pointer_scan_dispatcher;
use src::pointer_scans::pointer_scan_task_builder;
use src::pointer_scans::pointer_scan_candidate_collector;
use src::pointer_scans::pointer_scan_level_collector;
