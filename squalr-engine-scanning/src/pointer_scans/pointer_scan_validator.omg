// Port of pointer_scan_validator.rs.
//
// Upstream `validate_scan` rebuilds every level eagerly into a
// `Vec<PointerScanCollectedLevel>` and hands it to
// `PointerScanResultsBuilder::build_results_with_module_names`. Here the
// rebuilt levels are produced by `PointerScanValidatedLevels`, a pull driver
// that `collect_validated_levels` drains into the caller's arenas (the caller
// then seals them; see pointer_scan_results_builder.omg): each `next`
// runs exactly one upstream loop iteration — rebuild the level's heap
// candidates from the current frontier (skipped on the terminal level),
// walk the stored static candidates (resolve the current module base by
// name, re-read the pointer value from the validation snapshot, check
// frontier reachability), push survivors into `level_out`, then rebuild the
// frontier from the validated heap addresses.
//
// Pull-driver consequences (named deviations):
// - `truncate_empty_trailing_levels` has no pull analogue — the emitted
//   stream may carry a trailing fully-empty level which lands in the built
//   results; upstream prunes it.
// - `POINTER_VALIDATION_ROOT_CHUNK_SIZE` (64) + `par_chunks` are a thread
//   partition only; the sequential static walk keeps the same append order
//   as upstream's chunk-append merge.
// - The two `levels.is_empty()`/`validated_levels.is_empty()` empty-path
//   early-returns fold into the seal's `level_count == 0` finish — a drain
//   that records no level seals with module name count 0, the
//   `create_empty_results` shape.
// - `PointerValidationContext::current_modules_by_name` (a sorted
//   `Vec<(&str, u64)>`) is `module_name_order` — caller-sized `&[u64]`
//   indices into `modules`, name-sorted by insertion sort at construction.
// - `validation_snapshot_regions: &[SnapshotRegion]` folds into
//   `&Snapshot` + `get_region` index access (the snapshot stores a bounded
//   `[SnapshotRegion; 16]`).
// - Element-decoded byte reads: `SnapshotRegion` stores `ElementWindow`
//   (u64 elements covering 8 region bytes each); bytes are decoded
//   little-endian per element and reassembled through the ported
//   `read_pointer_value_unchecked` — identical semantics to upstream's
//   `current_values[byte_offset..byte_offset+size]` slice read.
// - `Instant`/`log::info!` timing+progress logging has no counterpart, so
//   `with_logging` is not taken.
// - `PointerValidationProgress` reporting was a progress-reporter callback —
//   dropped with ScanControl's reporter (see scan_control.omg).

// `Option<u64>` results surface as payload emissions.
public data EmittedResolvedStaticAddress {
    case Resolved(current_pointer_address: u64);
    case Missing;
}

public data EmittedReadPointerValue {
    case Read(current_pointer_value: u64);
    case Unreadable;
}

public data EmittedModuleBase {
    case Found(base_address: u64);
    case Missing;
}

public data EmittedRegionIndex {
    case Found(region_index: u64);
    case Missing;
}

// Kind/payload queries on the unions — `transition self` is admitted on self
// while a let-bound union scrutinee is not, so consumers hoist the calls.
public machine EmittedResolvedStaticAddress::is_resolved(this: &EmittedResolvedStaticAddress) -> bool {
    transition this {
        EmittedResolvedStaticAddress::Resolved { current_pointer_address } -> (true)
        _ -> (false)
    }
}

public machine EmittedResolvedStaticAddress::current_pointer_address(this: &EmittedResolvedStaticAddress) -> u64 {
    transition this {
        EmittedResolvedStaticAddress::Resolved { current_pointer_address } -> (current_pointer_address)
        _ -> (0)
    }
}

public machine EmittedReadPointerValue::is_readable(this: &EmittedReadPointerValue) -> bool {
    transition this {
        EmittedReadPointerValue::Read { current_pointer_value } -> (true)
        _ -> (false)
    }
}

public machine EmittedReadPointerValue::current_pointer_value(this: &EmittedReadPointerValue) -> u64 {
    transition this {
        EmittedReadPointerValue::Read { current_pointer_value } -> (current_pointer_value)
        _ -> (0)
    }
}

public machine EmittedModuleBase::is_found(this: &EmittedModuleBase) -> bool {
    transition this {
        EmittedModuleBase::Found { base_address } -> (true)
        _ -> (false)
    }
}

public machine EmittedModuleBase::base_address(this: &EmittedModuleBase) -> u64 {
    transition this {
        EmittedModuleBase::Found { base_address } -> (base_address)
        _ -> (0)
    }
}

public machine EmittedRegionIndex::is_found(this: &EmittedRegionIndex) -> bool {
    transition this {
        EmittedRegionIndex::Found { region_index } -> (true)
        _ -> (false)
    }
}

public machine EmittedRegionIndex::region_index(this: &EmittedRegionIndex) -> u64 {
    transition this {
        EmittedRegionIndex::Found { region_index } -> (region_index)
        _ -> (0)
    }
}

// ===== module-name ordering / lookup =====

// Lexicographic byte compare — upstream `str::cmp`: 0 equal, 1 `a < b`,
// 2 `a > b`.
public machine pointer_scan_module_names_compare(
    a: &[u8],
    b: &[u8]
) -> u64 {
    transition {
        _ -> walk(a, b, 0)
    }

    machine walk(
        a: &[u8],
        b: &[u8],
        position: u64
    ) -> u64 {
        transition (position < a.len && position < b.len) {
            true -> at(a, b, position)
            false -> tails(a, b)
        }
    }

    machine at(
        a: &[u8],
        b: &[u8],
        position: u64
    ) -> u64 {
        transition (a[position] < b[position]) {
            true -> (1)
            false -> gt(a, b, position)
            _ -> gt(a, b, position)
        }
    }

    machine gt(
        a: &[u8],
        b: &[u8],
        position: u64
    ) -> u64 {
        transition (a[position] > b[position]) {
            true -> (2)
            false -> walk(a, b, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> walk(a, b, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    machine tails(
        a: &[u8],
        b: &[u8]
    ) -> u64 {
        transition (a.len < b.len) {
            true -> (1)
            false -> longer(a, b)
            _ -> longer(a, b)
        }
    }

    machine longer(
        a: &[u8],
        b: &[u8]
    ) -> u64 {
        transition (a.len > b.len) {
            true -> (2)
            false -> (0)
            _ -> (0)
        }
    }
}

// Upstream `current_modules_by_name`: `Vec<(&str, u64)> sorted by name`.
// Fills `order` with `0..count` then insertion-sorts by module name —
// returns the written count (`min(order.len, modules.len)`).
public machine pointer_scan_sort_modules_by_name(
    order: &mut [u64],
    modules: &[NormalizedModule]
) -> u64 {
    transition {
        _ -> fill(order, modules, 0)
    }

    machine fill(
        order: &mut [u64],
        modules: &[NormalizedModule],
        index: u64
    ) -> u64 {
        transition (index < order.len && index < modules.len) {
            true -> store(order, modules, index)
            false -> (index)
        }
    }

    machine store(
        order: &mut [u64],
        modules: &[NormalizedModule],
        index: u64
    ) -> u64 {
        order[index] = index;
        transition {
            _ -> fill(order, modules, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// Insertion sort over the filled `order[0..count]` — upstream's
// `sort_unstable_by(name.cmp)`, same ascending result. `order` elements are
// u64 copies, so the insertion key travels as a scalar.
public machine pointer_scan_sort_module_order(
    order: &mut [u64],
    modules: &[NormalizedModule],
    count: u64
) {
    transition {
        _ -> outer(order, modules, count, 1)
    }

    machine outer(
        order: &mut [u64],
        modules: &[NormalizedModule],
        count: u64,
        insert_index: u64
    ) {
        transition (insert_index < count && insert_index < order.len) {
            true -> read_key(order, modules, count, insert_index)
            false -> finished()
        }
    }

    machine read_key(
        order: &mut [u64],
        modules: &[NormalizedModule],
        count: u64,
        insert_index: u64
    )
    requires insert_index < order.len;
    {
        let key_index: u64 = order[insert_index];
        transition {
            _ -> inner(order, modules, count, insert_index, insert_index, key_index)
        }
    }

    machine inner(
        order: &mut [u64],
        modules: &[NormalizedModule],
        count: u64,
        insert_index: u64,
        scan_index: u64,
        key_index: u64
    ) {
        transition (scan_index > 0 && scan_index <= order.len) {
            true -> bounds_gate(order, modules, count, insert_index, scan_index, key_index)
            false -> place(order, modules, count, insert_index, scan_index, key_index)
        }
    }

    machine bounds_gate(
        order: &mut [u64],
        modules: &[NormalizedModule],
        count: u64,
        insert_index: u64,
        scan_index: u64,
        key_index: u64
    ) {
        let prior_index: u64 = ((scan_index as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        transition (prior_index < order.len) {
            true -> elements_gate(order, modules, count, insert_index, scan_index, key_index, prior_index)
            false -> place(order, modules, count, insert_index, scan_index, key_index)
        }
    }

    machine elements_gate(
        order: &mut [u64],
        modules: &[NormalizedModule],
        count: u64,
        insert_index: u64,
        scan_index: u64,
        key_index: u64,
        prior_index: u64
    ) {
        transition prior_index < order.len {
            true -> read_prior_index(order, modules, count, insert_index, scan_index, key_index, prior_index)
            false -> place(order, modules, count, insert_index, scan_index, key_index)
        }
    }

    machine read_prior_index(
        order: &mut [u64],
        modules: &[NormalizedModule],
        count: u64,
        insert_index: u64,
        scan_index: u64,
        key_index: u64,
        prior_index: u64
    ) {
        let prior_module_index: u64 = order[prior_index];
        transition prior_module_index < modules.len {
            true -> read_prior(order, modules, count, insert_index, scan_index, key_index, prior_index, prior_module_index)
            false -> place(order, modules, count, insert_index, scan_index, key_index)
        }
    }

    machine read_prior(
        order: &mut [u64],
        modules: &[NormalizedModule],
        count: u64,
        insert_index: u64,
        scan_index: u64,
        key_index: u64,
        prior_index: u64,
        prior_module_index: u64
    ) {
        let prior_name: &[u8] = NormalizedModule::get_module_name(modules[prior_module_index]);
        transition key_index < modules.len {
            true -> compare(order, modules, count, insert_index, scan_index, key_index, prior_index, prior_name)
            false -> place(order, modules, count, insert_index, scan_index, key_index)
        }
    }

    machine compare(
        order: &mut [u64],
        modules: &[NormalizedModule],
        count: u64,
        insert_index: u64,
        scan_index: u64,
        key_index: u64,
        prior_index: u64,
        prior_name: &[u8]
    ) {
        let key_name: &[u8] = NormalizedModule::get_module_name(modules[key_index]);
        let name_order: u64 = pointer_scan_module_names_compare(
            prior_name,
            key_name
        );
        transition (name_order == 2) {
            true -> shift(order, modules, count, insert_index, scan_index, key_index, prior_index)
            false -> place(order, modules, count, insert_index, scan_index, key_index)
            _ -> place(order, modules, count, insert_index, scan_index, key_index)
        }
    }

    machine shift(
        order: &mut [u64],
        modules: &[NormalizedModule],
        count: u64,
        insert_index: u64,
        scan_index: u64,
        key_index: u64,
        prior_index: u64
    ) {
        order[scan_index] = order[prior_index];
        transition {
            _ -> inner(order, modules, count, insert_index, prior_index, key_index)
        }
    }

    machine place(
        order: &mut [u64],
        modules: &[NormalizedModule],
        count: u64,
        insert_index: u64,
        scan_index: u64,
        key_index: u64
    ) {
        order[scan_index] = key_index;
        transition {
            _ -> outer(order, modules, count, ((insert_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    machine finished() {}
}

// Upstream `find_current_module_base_address`: binary search the name-sorted
// (module_name, base_address) table — here `order` carries the sorted
// module indices.
public machine pointer_scan_find_module_base(
    modules: &[NormalizedModule],
    module_name_order: &[u64],
    module_name_order_count: u64,
    module_name: &[u8]
) -> EmittedModuleBase {
    transition {
        _ -> search(modules, module_name_order, module_name_order_count, module_name, 0, module_name_order_count)
    }

    machine search(
        modules: &[NormalizedModule],
        module_name_order: &[u64],
        module_name_order_count: u64,
        module_name: &[u8],
        lower_index: u64,
        upper_index: u64
    ) -> EmittedModuleBase {
        transition lower_index < upper_index {
            true -> probe(modules, module_name_order, module_name_order_count, module_name, lower_index, upper_index)
            false -> (EmittedModuleBase::Missing)
        }
    }

    machine probe(
        modules: &[NormalizedModule],
        module_name_order: &[u64],
        module_name_order_count: u64,
        module_name: &[u8],
        lower_index: u64,
        upper_index: u64
    ) -> EmittedModuleBase {
        let index_span: u64 =
            (((upper_index as u64 in Saturating) - (lower_index as u64 in Saturating)) / (2 as u64 in Saturating)) as u64;
        let middle_index: u64 =
            ((lower_index as u64 in Saturating) + (index_span as u64 in Saturating)) as u64;
        transition (middle_index < module_name_order.len && middle_index < upper_index) {
            true -> compare(modules, module_name_order, module_name_order_count, module_name, lower_index, upper_index, middle_index)
            false -> (EmittedModuleBase::Missing)
        }
    }

    machine compare(
        modules: &[NormalizedModule],
        module_name_order: &[u64],
        module_name_order_count: u64,
        module_name: &[u8],
        lower_index: u64,
        upper_index: u64,
        middle_index: u64
    ) -> EmittedModuleBase {
        transition middle_index < module_name_order.len {
            true -> probe_index_gate(modules, module_name_order, module_name_order_count, module_name, lower_index, upper_index, middle_index)
            false -> (EmittedModuleBase::Missing)
        }
    }

    machine probe_index_gate(
        modules: &[NormalizedModule],
        module_name_order: &[u64],
        module_name_order_count: u64,
        module_name: &[u8],
        lower_index: u64,
        upper_index: u64,
        middle_index: u64
    ) -> EmittedModuleBase {
        let probe_index: u64 = module_name_order[middle_index];
        transition probe_index < modules.len {
            true -> named(modules, module_name_order, module_name_order_count, module_name, lower_index, upper_index, middle_index, probe_index)
            false -> (EmittedModuleBase::Missing)
        }
    }

    machine named(
        modules: &[NormalizedModule],
        module_name_order: &[u64],
        module_name_order_count: u64,
        module_name: &[u8],
        lower_index: u64,
        upper_index: u64,
        middle_index: u64,
        probe_index: u64
    ) -> EmittedModuleBase {
        let probe_name: &[u8] = NormalizedModule::get_module_name(modules[probe_index]);
        let name_order: u64 = pointer_scan_module_names_compare(
            probe_name,
            module_name
        );
        let probe_base_address: u64 = NormalizedModule::get_base_address(modules[probe_index]);
        transition name_order {
            0 -> (EmittedModuleBase::Found { base_address: probe_base_address })
            1 -> search(modules, module_name_order, module_name_order_count, module_name, ((middle_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64, upper_index)
            2 -> search(modules, module_name_order, module_name_order_count, module_name, lower_index, middle_index)
            _ -> (EmittedModuleBase::Missing)
        }
    }
}

// Upstream `pointer_value_reaches_frontier` — the <=8 linear/binary split.
public machine pointer_scan_value_reaches_frontier<'ranges>(
    frontier_target_ranges: &'ranges PointerScanTargetRangeSet<'ranges>,
    pointer_value: u64
) -> bool {
    let hoist13: bool = pointer_scan_target_range_set_contains_value_binary(frontier_target_ranges, pointer_value);
    let hoist12: bool = pointer_scan_target_range_set_contains_value_binary(frontier_target_ranges, pointer_value);
    let hoist11: bool = pointer_scan_target_range_set_contains_value_linear(frontier_target_ranges, pointer_value);
    let hoist1: u64 = pointer_scan_target_range_set_get_range_count(frontier_target_ranges);
    transition hoist1 <= 8 {
        true -> (hoist11)
        false -> (hoist12)
        _ -> (hoist13)
    }
}

// Upstream `resolve_current_static_pointer_address`: stored module name at
// `candidate.module_index` → live module base + stored `module_offset`.
public machine pointer_scan_resolve_current_static_address<'a, 'aext, 'ash, 'as, 'ah>(
    pointer_scan_results: &'a PointerScanResults<'aext, 'ash, 'as, 'ah>,
    static_pointer_scan_candidate: PointerScanCandidate,
    modules: &[NormalizedModule],
    module_name_order: &[u64],
    module_name_order_count: u64,
    module_name_scratch: &mut [u8]
) -> EmittedResolvedStaticAddress {
    let stored_module_index: u64 = PointerScanCandidate::get_module_index(static_pointer_scan_candidate);
    let module_name_len: u64 = PointerScanResults::get_module_name_copy(pointer_scan_results, stored_module_index,
        module_name_scratch);
    transition (module_name_len > 0 && module_name_len <= module_name_scratch.len) {
        true -> find_base(pointer_scan_results, static_pointer_scan_candidate, modules, module_name_order, module_name_order_count, &module_name_scratch[0..module_name_len])
        false -> (EmittedResolvedStaticAddress::Missing)
    }

    machine find_base(
        pointer_scan_results: &'a PointerScanResults<'aext, 'ash, 'as, 'ah>,
        static_pointer_scan_candidate: PointerScanCandidate,
        modules: &[NormalizedModule],
        module_name_order: &[u64],
        module_name_order_count: u64,
        module_name: &[u8]
    ) -> EmittedResolvedStaticAddress {
        let module_base: EmittedModuleBase = pointer_scan_find_module_base(
            modules,
            module_name_order,
            module_name_order_count,
            module_name
        );
        let module_base_found: bool = EmittedModuleBase::is_found(module_base);
        transition module_base_found {
            true -> (EmittedResolvedStaticAddress::Resolved {
                current_pointer_address: ((EmittedModuleBase::base_address(module_base) as u64 in Saturating) + (PointerScanCandidate::get_module_offset(static_pointer_scan_candidate) as u64 in Saturating)) as u64
            })
            _ -> (EmittedResolvedStaticAddress::Missing)
        }
    }
}

// Upstream `find_snapshot_region_index_for_pointer_address`: binary search
// for the lowest region whose end exceeds the pointer address, then confirm
// the region covers the whole pointer.
public machine pointer_scan_find_region_index(
    validation_snapshot: &Snapshot,
    pointer_address: u64,
    pointer_size_in_bytes: u64
) -> EmittedRegionIndex {
    transition (pointer_address <= ((18446744073709551615 as u64 in Saturating) - (pointer_size_in_bytes as u64 in Saturating)) as u64) {
        true -> search(validation_snapshot, pointer_address, pointer_size_in_bytes, 0, Snapshot::get_region_count(validation_snapshot))
        false -> (EmittedRegionIndex::Missing)
    }

    machine search(
        validation_snapshot: &Snapshot,
        pointer_address: u64,
        pointer_size_in_bytes: u64,
        lower_index: u64,
        upper_index: u64
    ) -> EmittedRegionIndex {
        transition lower_index < upper_index {
            true -> probe(validation_snapshot, pointer_address, pointer_size_in_bytes, lower_index, upper_index)
            false -> verify(validation_snapshot, pointer_address, pointer_size_in_bytes, lower_index)
        }
    }

    machine probe(
        validation_snapshot: &Snapshot,
        pointer_address: u64,
        pointer_size_in_bytes: u64,
        lower_index: u64,
        upper_index: u64
    ) -> EmittedRegionIndex {
        let index_span: u64 =
            (((upper_index as u64 in Saturating) - (lower_index as u64 in Saturating)) / (2 as u64 in Saturating)) as u64;
        let middle_index: u64 =
            ((lower_index as u64 in Saturating) + (index_span as u64 in Saturating)) as u64;
        let snapshot_region: SnapshotRegion = Snapshot::get_region(validation_snapshot, middle_index);
        let hoist2: u64 = SnapshotRegion::get_end_address(snapshot_region);
        transition hoist2 <= pointer_address {
            true -> search(validation_snapshot, pointer_address, pointer_size_in_bytes, ((middle_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64, upper_index)
            false -> search(validation_snapshot, pointer_address, pointer_size_in_bytes, lower_index, middle_index)
            _ -> search(validation_snapshot, pointer_address, pointer_size_in_bytes, lower_index, middle_index)
        }
    }

    machine verify(
        validation_snapshot: &Snapshot,
        pointer_address: u64,
        pointer_size_in_bytes: u64,
        candidate_index: u64
    ) -> EmittedRegionIndex {
        let hoist3: u64 = Snapshot::get_region_count(validation_snapshot);
        transition candidate_index < hoist3 {
            true -> bounds(validation_snapshot, pointer_address, pointer_size_in_bytes, candidate_index)
            false -> (EmittedRegionIndex::Missing)
        }
    }

    machine bounds(
        validation_snapshot: &Snapshot,
        pointer_address: u64,
        pointer_size_in_bytes: u64,
        candidate_index: u64
    ) -> EmittedRegionIndex {
        let snapshot_region: SnapshotRegion = Snapshot::get_region(validation_snapshot, candidate_index);
        let pointer_end_address: u64 =
            ((pointer_address as u64 in Saturating) + (pointer_size_in_bytes as u64 in Saturating)) as u64;
        let region_base: u64 = SnapshotRegion::get_base_address(snapshot_region);
        let region_end: u64 = SnapshotRegion::get_end_address(snapshot_region);
        transition (pointer_address >= region_base && pointer_end_address <= region_end) {
            true -> arm_result_584_0(candidate_index, pointer_address, snapshot_region, pointer_end_address)
            false -> (EmittedRegionIndex::Missing)
        }
    }
    machine arm_result_584_0(candidate_index: u64, pointer_address: u64, snapshot_region: SnapshotRegion, pointer_end_address: u64) -> EmittedRegionIndex
    {
        (EmittedRegionIndex::Found { region_index: candidate_index })
    }
}

// Upstream `read_pointer_value_at_address` +
// `read_pointer_value_from_snapshot_region`: the region index hint walks
// forward past empty/overrun regions, the bounds check rejects, else the
// pointer bytes decode element-wise (little-endian within the u64 element)
// into `pointer_value_scratch` for `read_pointer_value_unchecked`.
public machine pointer_scan_read_pointer_value_at_address(
    validation_snapshot: &Snapshot,
    pointer_address: u64,
    pointer_size: PointerScanPointerSize,
    pointer_value_scratch: &mut [u8]
) -> EmittedReadPointerValue {
    let pointer_size_in_bytes: u64 = PointerScanPointerSize::get_size_in_bytes(pointer_size);
    transition (pointer_size_in_bytes > 0 && pointer_size_in_bytes <= 8 && pointer_size_in_bytes <= pointer_value_scratch.len) {
        true -> find(validation_snapshot, pointer_address, pointer_size, pointer_size_in_bytes, pointer_value_scratch)
        false -> (EmittedReadPointerValue::Unreadable)
    }

    machine find(
        validation_snapshot: &Snapshot,
        pointer_address: u64,
        pointer_size: PointerScanPointerSize,
        pointer_size_in_bytes: u64,
        pointer_value_scratch: &mut [u8]
    ) -> EmittedReadPointerValue {
        let region_index: EmittedRegionIndex = pointer_scan_find_region_index(
            validation_snapshot,
            pointer_address,
            pointer_size_in_bytes
        );
        let region_index_found: bool = EmittedRegionIndex::is_found(region_index);
        transition region_index_found {
            true -> walk(validation_snapshot, pointer_address, pointer_size, pointer_size_in_bytes, pointer_value_scratch, EmittedRegionIndex::region_index(region_index))
            _ -> (EmittedReadPointerValue::Unreadable)
        }
    }

    machine walk(
        validation_snapshot: &Snapshot,
        pointer_address: u64,
        pointer_size: PointerScanPointerSize,
        pointer_size_in_bytes: u64,
        pointer_value_scratch: &mut [u8],
        region_index_hint: u64
    ) -> EmittedReadPointerValue {
        let hoist4: u64 = Snapshot::get_region_count(validation_snapshot);
        transition region_index_hint < hoist4 {
            true -> region_gate(validation_snapshot, pointer_address, pointer_size, pointer_size_in_bytes, pointer_value_scratch, region_index_hint)
            false -> (EmittedReadPointerValue::Unreadable)
        }
    }

    // Upstream `if region.get_current_values().is_empty() || pointer_address
    // >= region.get_end_address() { hint += 1; continue; }`.
    machine region_gate(
        validation_snapshot: &Snapshot,
        pointer_address: u64,
        pointer_size: PointerScanPointerSize,
        pointer_size_in_bytes: u64,
        pointer_value_scratch: &mut [u8],
        region_index_hint: u64
    ) -> EmittedReadPointerValue {
        let snapshot_region: SnapshotRegion = Snapshot::get_region(validation_snapshot, region_index_hint);
        let has_current: bool = SnapshotRegion::has_current_values(snapshot_region);
        let region_end: u64 = SnapshotRegion::get_end_address(snapshot_region);
        transition (!has_current || pointer_address >= region_end) {
            true -> walk(validation_snapshot, pointer_address, pointer_size, pointer_size_in_bytes, pointer_value_scratch, ((region_index_hint as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
            false -> bounds(validation_snapshot, pointer_address, pointer_size, pointer_size_in_bytes, pointer_value_scratch, region_index_hint)
            _ -> bounds(validation_snapshot, pointer_address, pointer_size, pointer_size_in_bytes, pointer_value_scratch, region_index_hint)
        }
    }

    // Upstream `if pointer_address < base || pointer_end > end { return None }`.
    machine bounds(
        validation_snapshot: &Snapshot,
        pointer_address: u64,
        pointer_size: PointerScanPointerSize,
        pointer_size_in_bytes: u64,
        pointer_value_scratch: &mut [u8],
        region_index_hint: u64
    ) -> EmittedReadPointerValue {
        let snapshot_region: SnapshotRegion = Snapshot::get_region(validation_snapshot, region_index_hint);
        let pointer_end_address: u64 =
            ((pointer_address as u64 in Saturating) + (pointer_size_in_bytes as u64 in Saturating)) as u64;
        let region_base: u64 = SnapshotRegion::get_base_address(snapshot_region);
        let region_end: u64 = SnapshotRegion::get_end_address(snapshot_region);
        transition (pointer_address < region_base || pointer_end_address > region_end) {
            false -> decode(validation_snapshot, pointer_address, pointer_size, pointer_size_in_bytes, pointer_value_scratch, region_index_hint, 0)
            _ -> (EmittedReadPointerValue::Unreadable)
        }
    }

    // Element decode: region byte `j` lives in element `(offset+j)/8`, LE
    // byte `(offset+j)%8` of that element's u64 value.
    machine decode(
        validation_snapshot: &Snapshot,
        pointer_address: u64,
        pointer_size: PointerScanPointerSize,
        pointer_size_in_bytes: u64,
        pointer_value_scratch: &mut [u8],
        region_index_hint: u64,
        byte_index: u64
    ) -> EmittedReadPointerValue {
        transition byte_index < pointer_size_in_bytes {
            true -> element_bounds(validation_snapshot, pointer_address, pointer_size, pointer_size_in_bytes, pointer_value_scratch, region_index_hint, byte_index)
            false -> assemble(pointer_size, pointer_size_in_bytes, pointer_value_scratch)
        }
    }

    machine element_bounds(
        validation_snapshot: &Snapshot,
        pointer_address: u64,
        pointer_size: PointerScanPointerSize,
        pointer_size_in_bytes: u64,
        pointer_value_scratch: &mut [u8],
        region_index_hint: u64,
        byte_index: u64
    ) -> EmittedReadPointerValue {
        let snapshot_region: SnapshotRegion = Snapshot::get_region(validation_snapshot, region_index_hint);
        let byte_offset: u64 =
            ((pointer_address as u64 in Saturating) - (SnapshotRegion::get_base_address(snapshot_region) as u64 in Saturating)) as u64;
        let region_byte_offset: u64 =
            ((byte_offset as u64 in Saturating) + (byte_index as u64 in Saturating)) as u64;
        let element_index: u64 =
            ((region_byte_offset as u64 in Saturating) / (8 as u64 in Saturating)) as u64;
        let hoist5: u64 = SnapshotRegion::get_current_element_count(snapshot_region);
        transition element_index < hoist5 {
            true -> element_decode(validation_snapshot, pointer_address, pointer_size, pointer_size_in_bytes, pointer_value_scratch, region_index_hint, byte_index, region_byte_offset, element_index)
            false -> (EmittedReadPointerValue::Unreadable)
        }
    }

    machine element_decode(
        validation_snapshot: &Snapshot,
        pointer_address: u64,
        pointer_size: PointerScanPointerSize,
        pointer_size_in_bytes: u64,
        pointer_value_scratch: &mut [u8],
        region_index_hint: u64,
        byte_index: u64,
        region_byte_offset: u64,
        element_index: u64
    ) -> EmittedReadPointerValue {
        let snapshot_region: SnapshotRegion = Snapshot::get_region(validation_snapshot, region_index_hint);
        let element_value: u64 = SnapshotRegion::get_current_element(snapshot_region, element_index);
        let element_byte_index: u64 =
            ((region_byte_offset as u64 in Saturating) - ((element_index as u64 in Saturating) * (8 as u64 in Saturating))) as u64;
        let byte_shift: u64 =
            ((element_byte_index as u64 in Wrapping) * (8 as u64 in Wrapping)) as u64;
        let decoded_byte: u64 =
            (((element_value as u64 in Wrapping) >> (byte_shift as u64 in Wrapping)) & (255 as u64 in Wrapping)) as u64;
        transition byte_index < pointer_value_scratch.len {
            true -> store_byte(validation_snapshot, pointer_address, pointer_size, pointer_size_in_bytes, pointer_value_scratch, region_index_hint, byte_index, decoded_byte)
            false -> (EmittedReadPointerValue::Unreadable)
        }
    }

    machine store_byte(
        validation_snapshot: &Snapshot,
        pointer_address: u64,
        pointer_size: PointerScanPointerSize,
        pointer_size_in_bytes: u64,
        pointer_value_scratch: &mut [u8],
        region_index_hint: u64,
        byte_index: u64,
        decoded_byte: u64
    ) -> EmittedReadPointerValue {
        pointer_value_scratch[byte_index] = (decoded_byte as u8 in Wrapping) as u8;
        transition {
            _ -> decode(validation_snapshot, pointer_address, pointer_size, pointer_size_in_bytes, pointer_value_scratch, region_index_hint, ((byte_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    machine assemble(
        pointer_size: PointerScanPointerSize,
        pointer_size_in_bytes: u64,
        pointer_value_scratch: &mut [u8]
    ) -> EmittedReadPointerValue {
        transition pointer_size_in_bytes <= pointer_value_scratch.len {
            true -> assemble_in(pointer_size, &pointer_value_scratch[0..pointer_size_in_bytes])
            false -> (EmittedReadPointerValue::Unreadable)
        }
    }

    machine assemble_in(
        pointer_size: PointerScanPointerSize,
        pointer_bytes: &[u8]
    ) -> EmittedReadPointerValue {
        let hoist16: u64 = read_pointer_value_unchecked(pointer_bytes, 0, pointer_size);
        (EmittedReadPointerValue::Read {
            current_pointer_value: hoist16
        })
    }
}
// ===== validated-levels driver =====

// The pull driver: one upstream `for (level_index, candidates)` iteration
// per `next`. Owns the rebuilt frontier + the heap-task views between
// emissions; per-iteration scratch (`pointer_value_scratch`,
// `module_name_scratch`) is caller-lent.
public data PointerScanValidatedLevels<'a, 'aext, 'ash, 'as, 'ah, 'v, 'm, 'o, 'sc, 't, 'tv, 'f, 'pvs, 'mns> {
    pointer_scan_results: &'a PointerScanResults<'aext, 'ash, 'as, 'ah>;
    validation_snapshot: &'v Snapshot;
    modules: &'m [NormalizedModule];
    module_name_order: &'o [u64];
    module_name_order_count: u64;
    scan_control: &'sc ScanControl;
    validation_heap_scan_tasks: SnapshotRegionScanTasks<'t, 'tv>;
    pointer_size: PointerScanPointerSize;
    offset_radius: u64;
    frontier_target_ranges: PointerScanTargetRangeSet<'f>;
    pointer_value_scratch: &'pvs mut [u8];
    module_name_scratch: &'mns mut [u8];
    level_index: u64;
    level_count: u64;
    static_candidate_index: u64;
    stopped: bool;
}

// Upstream `PointerValidationContext::new` + the `build_heap_scan_tasks` +
// `from_target_addresses` setup — all supplied by the caller.
public machine PointerScanValidatedLevels::new<'a, 'aext, 'ash, 'as, 'ah, 'v, 'm, 'o, 'sc, 't, 'tv, 'f, 'pvs, 'mns>(
    pointer_scan_results: &'a PointerScanResults<'aext, 'ash, 'as, 'ah>,
    validation_snapshot: &'v Snapshot,
    modules: &'m [NormalizedModule],
    module_name_order: &'o [u64],
    module_name_order_count: u64,
    scan_control: &'sc ScanControl,
    validation_heap_scan_tasks: SnapshotRegionScanTasks<'t, 'tv>,
    pointer_size: PointerScanPointerSize,
    offset_radius: u64,
    frontier_target_ranges: PointerScanTargetRangeSet<'f>,
    pointer_value_scratch: &'pvs mut [u8],
    module_name_scratch: &'mns mut [u8]
) -> PointerScanValidatedLevels<'a, 'aext, 'ash, 'as, 'ah, 'v, 'm, 'o, 'sc, 't, 'tv, 'f, 'pvs, 'mns> {
    PointerScanValidatedLevels {
        pointer_scan_results: pointer_scan_results,
        validation_snapshot: validation_snapshot,
        modules: modules,
        module_name_order: module_name_order,
        module_name_order_count: module_name_order_count,
        scan_control: scan_control,
        validation_heap_scan_tasks: validation_heap_scan_tasks,
        pointer_size: pointer_size,
        offset_radius: offset_radius,
        frontier_target_ranges: frontier_target_ranges,
        pointer_value_scratch: pointer_value_scratch,
        module_name_scratch: module_name_scratch,
        level_index: 0,
        level_count: 0,
        static_candidate_index: 0,
        stopped: false
    }
}


// Upstream `for (level_index, pointer_scan_level_candidates)` — one level
// per call. Upstream pushes a level per iteration including empty ones and
// prunes only the trailing empty run afterwards; the pull stream carries the
// empties through (named deviation).
public machine PointerScanValidatedLevels::next<'a, 'aext, 'ash, 'as, 'ah, 'v, 'm, 'o, 'sc, 't, 'tv, 'f, 'pvs, 'mns, 'candidates>(
    this: &mut PointerScanValidatedLevels,
    level_out: &mut PointerScanCollectedLevel<'candidates>,
    heap_address_scratch: &mut [u64]
) -> EmittedDiscoveredLevel {
    transition this.stopped {
        true -> arm_result_848_0()
        false -> gate(this, level_out, heap_address_scratch)
        _ -> gate(this, level_out, heap_address_scratch)
    }

    // Upstream `for` bounds + `if scan_control.should_cancel() ||
    // frontier_target_ranges.is_empty() { break; }`.
    machine gate(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64]
    ) -> EmittedDiscoveredLevel {
        transition ((this.level_index < this.level_count)
            && !ScanControl::should_cancel(&this.scan_control)
            && !pointer_scan_target_range_set_is_empty(&this.frontier_target_ranges)) {
            true -> begin_level(this, level_out, heap_address_scratch)
            false -> stop(this)
            _ -> stop(this)
        }
    }

    machine begin_level(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64]
    ) -> EmittedDiscoveredLevel {
        PointerScanCollectedLevel::clear(&mut level_out);
        this.static_candidate_index = 0;
        // Upstream `retain_heap_candidates = level_index + 1 < level_count`.
        transition (((this.level_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64) < this.level_count {
            true -> heap_gate(this, level_out, heap_address_scratch)
            false -> collect_statics(this, level_out, heap_address_scratch)
            _ -> collect_statics(this, level_out, heap_address_scratch)
        }
    }

    machine heap_gate(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64]
    ) -> EmittedDiscoveredLevel {
        let hoist6: bool = pointer_scan_target_range_set_is_empty(&this.frontier_target_ranges);
        transition hoist6 {
            true -> collect_statics(this, level_out, heap_address_scratch)
            false -> collect_heaps(this, level_out, heap_address_scratch)
            _ -> collect_heaps(this, level_out, heap_address_scratch)
        }
    }

    // Upstream `collect_validated_heap_candidates`: `build_execution_plan` +
    // `collect_candidates` with retain_static=false, retain_heap=true.
    machine collect_heaps(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64]
    ) -> EmittedDiscoveredLevel {
        let candidate_collector: PointerScanCandidateCollector = PointerScanCandidateCollector {};
        let execution_plan: PointerScanExecutionPlan = PointerScanCandidateCollector::build_execution_plan(&candidate_collector, &this.frontier_target_ranges,
            this.pointer_size,
            &this.validation_heap_scan_tasks);
        PointerScanCandidateCollector::collect_candidates_into(&candidate_collector, &this.validation_heap_scan_tasks,
            &this.frontier_target_ranges,
            &execution_plan,
            false,
            true,
            level_out);
        transition { _ -> collect_statics(this, level_out, heap_address_scratch) }
    }

    // Upstream `collect_validated_static_candidates` — one stored static
    // candidate per step: resolve the current address from the live module
    // base, re-read the pointer value in the validation snapshot, keep it
    // only if the value still reaches the frontier.
    machine collect_statics(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64]
    ) -> EmittedDiscoveredLevel {
        let hoist7: bool = ScanControl::should_cancel(&this.scan_control);
        transition hoist7 {
            true -> finish_level(this, level_out, heap_address_scratch)
            false -> static_gate(this, level_out, heap_address_scratch)
            _ -> static_gate(this, level_out, heap_address_scratch)
        }
    }

    machine static_gate(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64]
    ) -> EmittedDiscoveredLevel {
        let current_level_index: u64 = this.level_index;
        let level_candidates: &[PointerScanLevelCandidates<'as, 'ah>] =
            PointerScanResults::get_pointer_scan_level_candidates(&this.pointer_scan_results);
        transition current_level_index < level_candidates.len {
            true -> static_count(this, level_out, heap_address_scratch, level_candidates, current_level_index)
            false -> finish_level(this, level_out, heap_address_scratch)
        }
    }

    machine static_count(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        level_candidates: &[PointerScanLevelCandidates<'as, 'ah>],
        current_level_index: u64
    ) -> EmittedDiscoveredLevel {
        let hoist8: u64 = PointerScanLevelCandidates::get_static_node_count(level_candidates[current_level_index]);
        transition this.static_candidate_index < hoist8 {
            true -> level_gate(this, level_out, heap_address_scratch, level_candidates, current_level_index)
            false -> finish_level(this, level_out, heap_address_scratch)
        }
    }

    machine level_gate(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        level_candidates: &[PointerScanLevelCandidates<'as, 'ah>],
        current_level_index: u64
    ) -> EmittedDiscoveredLevel {
        transition current_level_index < level_candidates.len {
            true -> resolve_static(this, level_out, heap_address_scratch, level_candidates, current_level_index)
            false -> finish_level(this, level_out, heap_address_scratch)
        }
    }

    machine resolve_static(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        level_candidates: &[PointerScanLevelCandidates<'as, 'ah>],
        current_level_index: u64
    ) -> EmittedDiscoveredLevel {
        let static_pointer_scan_candidate: PointerScanCandidate =
            PointerScanLevelCandidates::copy_static_candidate(&level_candidates[current_level_index], this.static_candidate_index);
        this.static_candidate_index =
            ((this.static_candidate_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        let resolved_address: EmittedResolvedStaticAddress =
            pointer_scan_resolve_current_static_address(
                this.pointer_scan_results,
                static_pointer_scan_candidate,
                this.modules,
                this.module_name_order,
                this.module_name_order_count,
                &mut this.module_name_scratch[..]
            );
        let address_resolved: bool = EmittedResolvedStaticAddress::is_resolved(&resolved_address);
        transition address_resolved {
            true -> read_value(this, level_out, heap_address_scratch, static_pointer_scan_candidate, EmittedResolvedStaticAddress::current_pointer_address(&resolved_address))
            _ -> static_gate(this, level_out, heap_address_scratch)
        }
    }

    machine read_value(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        static_pointer_scan_candidate: PointerScanCandidate,
        current_pointer_address: u64
    ) -> EmittedDiscoveredLevel {
        let read_pointer_value: EmittedReadPointerValue =
            pointer_scan_read_pointer_value_at_address(
                this.validation_snapshot,
                current_pointer_address,
                this.pointer_size,
                &mut this.pointer_value_scratch[..]
            );
        let pointer_readable: bool = EmittedReadPointerValue::is_readable(&read_pointer_value);
        transition pointer_readable {
            true -> check_frontier(this, level_out, heap_address_scratch, static_pointer_scan_candidate, current_pointer_address, EmittedReadPointerValue::current_pointer_value(&read_pointer_value))
            _ -> static_gate(this, level_out, heap_address_scratch)
        }
    }

    machine check_frontier(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        static_pointer_scan_candidate: PointerScanCandidate,
        current_pointer_address: u64,
        current_pointer_value: u64
    ) -> EmittedDiscoveredLevel {
        let hoist9: bool = pointer_scan_value_reaches_frontier(&this.frontier_target_ranges, current_pointer_value);
        transition hoist9 {
            true -> push_static(this, level_out, heap_address_scratch, static_pointer_scan_candidate, current_pointer_address, current_pointer_value)
            false -> static_gate(this, level_out, heap_address_scratch)
            _ -> static_gate(this, level_out, heap_address_scratch)
        }
    }

    // Upstream `validated_static_candidates.push(...)` — the candidate's
    // pointer_address is the RESOLVED current address; module identity is
    // carried through.
    machine push_static(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        static_pointer_scan_candidate: PointerScanCandidate,
        current_pointer_address: u64,
        current_pointer_value: u64
    ) -> EmittedDiscoveredLevel {
        let hoist18: u64 = PointerScanCandidate::get_module_offset(&static_pointer_scan_candidate);
        let hoist17: u64 = PointerScanCandidate::get_module_index(&static_pointer_scan_candidate);
        PointerScanCollectedLevel::push_static(&mut level_out, PointerScanCollectedCandidate {
                pointer_address: current_pointer_address,
                pointer_value: current_pointer_value,
                module_index: hoist17,
                module_offset: hoist18
            });
        transition { _ -> static_gate(this, level_out, heap_address_scratch) }
    }

    // Upstream's per-level epilogue: rebuild the frontier from the level's
    // validated heap addresses, then emit the level.
    machine finish_level(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64]
    ) -> EmittedDiscoveredLevel {
        this.level_index =
            ((this.level_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        transition {
            _ -> extract_heap(this, level_out, heap_address_scratch, 0)
        }
    }

    machine extract_heap(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        candidate_index: u64
    ) -> EmittedDiscoveredLevel {
        let heap_candidate_count: u64 = PointerScanCollectedLevel::get_heap_candidate_count(&level_out);
        transition candidate_index < heap_candidate_count {
            true -> heap_write_gate(this, level_out, heap_address_scratch, candidate_index)
            false -> rebuild_gate(this, level_out, heap_address_scratch, candidate_index)
        }
    }

    machine heap_write_gate(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        candidate_index: u64
    ) -> EmittedDiscoveredLevel {
        transition candidate_index < heap_address_scratch.len {
            true -> heap_write(this, level_out, heap_address_scratch, candidate_index)
            false -> rebuild_gate(this, level_out, heap_address_scratch, candidate_index)
        }
    }

    machine heap_write(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        candidate_index: u64
    ) -> EmittedDiscoveredLevel {
        let candidate: PointerScanCollectedCandidate = PointerScanCollectedLevel::get_heap_candidate(&level_out, candidate_index);
        heap_address_scratch[candidate_index] = candidate.pointer_address;
        transition { _ -> extract_heap(this, level_out, heap_address_scratch, ((candidate_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64) }
    }

    machine rebuild_gate(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        heap_candidate_count: u64
    ) -> EmittedDiscoveredLevel {
        transition heap_candidate_count <= heap_address_scratch.len {
            true -> rebuild_apply(this, level_out, &heap_address_scratch[0..heap_candidate_count])
            false -> emit_level()
        }
    }

    machine rebuild_apply(
        this: &mut PointerScanValidatedLevels,
        level_out: &mut PointerScanCollectedLevel<'candidates>,
        sorted_target_addresses: &[u64]
    ) -> EmittedDiscoveredLevel {
        PointerScanTargetRangeSet::rebuild_from_sorted_target_addresses(&mut this.frontier_target_ranges, sorted_target_addresses,
            this.offset_radius);
        transition { _ -> emit_level() }
    }

    machine emit_level() -> EmittedDiscoveredLevel {
        (EmittedDiscoveredLevel::Level)
    }

    machine stop(this: &mut PointerScanValidatedLevels) -> EmittedDiscoveredLevel {
        this.stopped = true;
        EmittedDiscoveredLevel::Done
    }
    machine arm_result_848_0() -> EmittedDiscoveredLevel
    {
        (EmittedDiscoveredLevel::Done)
    }
}

// Upstream `PointerScanValidator` — a zero-field namespace.
public data PointerScanValidator {}

// Upstream PointerScanValidator::validate_scan runs the rebuild and
// `build_results_with_module_names` in one call. Omega splits that call at
// the results seal (see pointer_scan_results_builder.omg): this machine
// rebuilds the levels through `PointerScanValidatedLevels` and copies each
// one into the caller's arenas, and the caller seals them with
// `PointerScanResultsBuilder::seal_results` under `validation_parameters`.
public machine PointerScanValidator::collect_validated_levels<'a, 'aext, 'ash, 'as, 'ah, 'v, 'm, 'o, 'sc, 't, 'tv, 'f, 'pvs, 'mns, 'candidates>(
    this: &PointerScanValidator,
    pointer_scan_results: &'a PointerScanResults<'aext, 'ash, 'as, 'ah>,
    validation_target_addresses: &[u64],
    snapshots: &[&Snapshot],
    validation_snapshot: &'v Snapshot,
    modules: &'m [NormalizedModule],
    scan_control: &'sc ScanControl,
    sorted_scratch: &'f mut [u64],
    target_ranges: &'f mut [normalized_region::NormalizedRegion],
    lower_bounds: &'f mut [u64],
    upper_bounds: &'f mut [u64],
    target_range_buckets: &'f mut [PointerScanTargetRangeBucket],
    tasks_scratch: &'t mut [SnapshotRegionScanTask],
    byte_arena: &'tv mut [u8],
    module_order_scratch: &'o mut [u64],
    pointer_value_scratch: &'pvs mut [u8],
    module_name_scratch: &'mns mut [u8],
    level_out: PointerScanCollectedLevel<'candidates>,
    heap_address_scratch: &mut [u64],
    module_names_out: &mut [PointerScanModuleName],
    levels_out: &mut [PointerScanLevel],
    level_spans_out: &mut [BuiltLevelSpan],
    static_candidate_arena: &mut [PointerScanCandidate],
    heap_candidate_arena: &mut [PointerScanCandidate]
) -> PointerScanResultsBuild {
    let stored_level_count: u64 = PointerScanResults::get_pointer_scan_level_candidate_count(pointer_scan_results);
    // Upstream `create_empty_results` for results without levels: no module
    // name is copied and the seal stores zero counts.
    transition stored_level_count == 0 {
        true -> (PointerScanResultsBuild::new(0))
        _ -> validate(pointer_scan_results, validation_target_addresses, snapshots, validation_snapshot, modules, scan_control, sorted_scratch, target_ranges, lower_bounds, upper_bounds, target_range_buckets, tasks_scratch, byte_arena, module_order_scratch, pointer_value_scratch, module_name_scratch, level_out, heap_address_scratch, module_names_out, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena)
    }

    // Upstream's non-empty path: build heap tasks (static ranges excluded),
    // the name-sorted module order, the initial frontier — then drain the
    // pull driver with `FromNames` on the original results.
    machine validate(
        pointer_scan_results: &'a PointerScanResults<'aext, 'ash, 'as, 'ah>,
        validation_target_addresses: &[u64],
        snapshots: &[&Snapshot],
        validation_snapshot: &'v Snapshot,
        modules: &'m [NormalizedModule],
        scan_control: &'sc ScanControl,
        sorted_scratch: &'f mut [u64],
        target_ranges: &'f mut [normalized_region::NormalizedRegion],
        lower_bounds: &'f mut [u64],
        upper_bounds: &'f mut [u64],
        target_range_buckets: &'f mut [PointerScanTargetRangeBucket],
        tasks_scratch: &'t mut [SnapshotRegionScanTask],
        byte_arena: &'tv mut [u8],
        module_order_scratch: &'o mut [u64],
        pointer_value_scratch: &'pvs mut [u8],
        module_name_scratch: &'mns mut [u8],
        level_out: PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        module_names_out: &mut [PointerScanModuleName],
        levels_out: &mut [PointerScanLevel],
        level_spans_out: &mut [BuiltLevelSpan],
        static_candidate_arena: &mut [PointerScanCandidate],
        heap_candidate_arena: &mut [PointerScanCandidate]
    ) -> PointerScanResultsBuild {
        let pointer_size: PointerScanPointerSize = PointerScanResults::get_pointer_size(pointer_scan_results);
        let offset_radius: u64 = PointerScanResults::get_offset_radius(pointer_scan_results);
        let task_build: PointerScanTaskBuildState =
            PointerScanTaskBuilder::build_snapshot_region_scan_tasks(snapshots,
                modules,
                pointer_size,
                false,
                module_order_scratch,
                &mut tasks_scratch[..],
                &mut byte_arena[..]);
        let validation_heap_scan_tasks: SnapshotRegionScanTasks<'t, 'tv> =
            SnapshotRegionScanTasks::new(
                tasks_scratch,
                byte_arena,
                task_build.task_count
            );
        let frontier_target_ranges: PointerScanTargetRangeSet<'f> =
            PointerScanTargetRangeSet::from_target_addresses(
                validation_target_addresses,
                offset_radius,
                sorted_scratch,
                target_ranges,
                lower_bounds,
                upper_bounds,
                target_range_buckets
            );
        let module_name_order_count: u64 = pointer_scan_sort_modules_by_name(
            module_order_scratch,
            modules
        );
        pointer_scan_sort_module_order(
            module_order_scratch,
            modules,
            module_name_order_count
        );
        let mut validated_levels: PointerScanValidatedLevels<'a, 'aext, 'ash, 'as, 'ah, 'v, 'm, 'o, 'sc, 't, 'tv, 'f, 'pvs, 'mns> =
            PointerScanValidatedLevels::new(
                pointer_scan_results,
                validation_snapshot,
                modules,
                module_order_scratch,
                module_name_order_count,
                scan_control,
                validation_heap_scan_tasks,
                pointer_size,
                offset_radius,
                frontier_target_ranges,
                pointer_value_scratch,
                module_name_scratch
            );
        validated_levels.level_count = PointerScanResults::get_pointer_scan_level_candidate_count(pointer_scan_results);
        let source_names: &[PointerScanModuleName] =
            PointerScanResults::get_module_names(pointer_scan_results);
        let build: PointerScanResultsBuild = PointerScanResultsBuilder::begin_from_module_names(source_names, module_names_out);
        transition {
            _ -> drain(validated_levels, level_out, heap_address_scratch, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, build)
        }
    }

    // Upstream `for (level_index, pointer_scan_level_candidates)` — one
    // `next` per iteration, recorded as it arrives.
    // The pull driver is owned by these states: the loans its kernels install
    // land in storage this machine owns, so no caller has to relate them.
    machine drain(
        mut validated_levels: PointerScanValidatedLevels<'a, 'aext, 'ash, 'as, 'ah, 'v, 'm, 'o, 'sc, 't, 'tv, 'f, 'pvs, 'mns>,
        mut level_out: PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        levels_out: &mut [PointerScanLevel],
        level_spans_out: &mut [BuiltLevelSpan],
        static_candidate_arena: &mut [PointerScanCandidate],
        heap_candidate_arena: &mut [PointerScanCandidate],
        build: PointerScanResultsBuild
    ) -> PointerScanResultsBuild {
        let emission: EmittedDiscoveredLevel =
            PointerScanValidatedLevels::next(&mut validated_levels, &mut level_out, heap_address_scratch);
        let emitted_level: bool = EmittedDiscoveredLevel::is_level(&emission);
        transition emitted_level {
            true -> record(validated_levels, level_out, heap_address_scratch, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, build)
            _ -> (build)
        }
    }

    machine record(
        validated_levels: PointerScanValidatedLevels<'a, 'aext, 'ash, 'as, 'ah, 'v, 'm, 'o, 'sc, 't, 'tv, 'f, 'pvs, 'mns>,
        level_out: PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        levels_out: &mut [PointerScanLevel],
        level_spans_out: &mut [BuiltLevelSpan],
        static_candidate_arena: &mut [PointerScanCandidate],
        heap_candidate_arena: &mut [PointerScanCandidate],
        build: PointerScanResultsBuild
    ) -> PointerScanResultsBuild {
        let recorded: PointerScanResultsBuild = PointerScanResultsBuilder::record_level(build, &level_out, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena);
        transition recorded.extents_full {
            true -> (recorded)
            _ -> drain(validated_levels, level_out, heap_address_scratch, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, recorded)
        }
    }
}

// Upstream `validate_scan` seals the validated results under the original
// results' pointer size, offset radius and max depth.
public machine PointerScanValidator::validation_parameters(pointer_scan_results: &PointerScanResults) -> PointerScanParameters {
    (PointerScanParameters::new(
        PointerScanResults::get_pointer_size(pointer_scan_results),
        PointerScanResults::get_offset_radius(pointer_scan_results),
        PointerScanResults::get_max_depth(pointer_scan_results),
        false,
        false
    ))
}
