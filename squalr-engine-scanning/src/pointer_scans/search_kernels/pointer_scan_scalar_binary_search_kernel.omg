use {squalr_engine_api}/src/structures/data_values/pointer_scan_pointer_size.omg;
use src/pointer_scans/search_kernels/pointer_scan_scalar_region_scanner.omg;
use src/pointer_scans/search_kernels/pointer_scan_search_kernel_context.omg;
use src/pointer_scans/search_kernels/pointer_scan_search_kernel_utils.omg;
use src/pointer_scans/search_kernels/pointer_scan_search_kernel.omg;
use src/pointer_scans/structures/pointer_scan_region_match.omg;
use src/pointer_scans/structures/pointer_scan_target_ranges.omg;

// Port of search_kernels/pointer_scan_scalar_binary_search_kernel.rs.

// Upstream's zero-field `ScalarBinaryPointerScanKernel` unit struct.
public data ScalarBinaryPointerScanKernel {}

// Upstream `PointerScanSearchKernel::is_empty` default: the kernel reports
// empty exactly when the target range set carries no ranges.
public machine ScalarBinaryPointerScanKernel::is_empty<'a>(
    this: &ScalarBinaryPointerScanKernel,
    pointer_scan_search_kernel_context: &|pointer_scan_search_kernel_context|::PointerScanSearchKernelContext<'a>
) -> bool satisfies |pointer_scan_search_kernel|::PointerScanSearchKernel<ScalarBinaryPointerScanKernel>::is_empty {
    let target_range_set: &|pointer_scan_target_ranges|::PointerScanTargetRangeSet = |pointer_scan_search_kernel_context|::PointerScanSearchKernelContext::get_target_range_set(&pointer_scan_search_kernel_context);
    let range_set_is_empty: bool = |pointer_scan_target_ranges|::pointer_scan_target_range_set_is_empty(target_range_set);
    range_set_is_empty
}

// Port of `scan_region_with_visitor`: aligned start offset, then the shared
// scalar region walk with `contains_value_binary` as the predicate.
public machine ScalarBinaryPointerScanKernel::scan_region_with_visitor<'a, Collector>(
    this: &ScalarBinaryPointerScanKernel,
    pointer_scan_search_kernel_context: &|pointer_scan_search_kernel_context|::PointerScanSearchKernelContext<'a>,
    base_address: u64,
    current_values: &[u8],
    visit_match: dyn |pointer_scan_search_kernel|::PointerScanMatchVisitor<Collector>,
    collector: &mut Collector
) satisfies |pointer_scan_search_kernel|::PointerScanSearchKernel<ScalarBinaryPointerScanKernel>::scan_region_with_visitor {
    let pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize =
        |pointer_scan_search_kernel_context|::PointerScanSearchKernelContext::get_pointer_size(&pointer_scan_search_kernel_context);
    let target_range_set: &|pointer_scan_target_ranges|::PointerScanTargetRangeSet =
        |pointer_scan_search_kernel_context|::PointerScanSearchKernelContext::get_target_range_set(&pointer_scan_search_kernel_context);
    let start: |pointer_scan_search_kernel_utils|::ScanStartOffset = |pointer_scan_search_kernel_utils|::find_scan_start_offset(base_address, current_values, pointer_size);
    transition (start.found) {
        true -> scan(
            base_address,
            current_values,
            start.start_offset,
            pointer_size,
            target_range_set,
            visit_match, collector
        )
        false -> finished()
    }

    machine scan(
        base_address: u64,
        current_values: &[u8],
        start_offset: u64,
        pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize,
        target_range_set: &|pointer_scan_target_ranges|::PointerScanTargetRangeSet,
        visit_match: dyn |pointer_scan_search_kernel|::PointerScanMatchVisitor<Collector>,
        collector: &mut Collector
    ) {
        |pointer_scan_scalar_region_scanner|::scan_region_scalar_with_predicate(
            base_address,
            current_values,
            start_offset,
            pointer_size,
            target_range_set,
            true,
            visit_match, collector
        );
    }

    machine finished() {}
}
