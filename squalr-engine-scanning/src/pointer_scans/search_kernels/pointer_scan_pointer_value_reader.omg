module src::pointer_scans::search_kernels::pointer_scan_pointer_value_reader;

use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;

// Port of search_kernels/pointer_scan_pointer_value_reader.rs.
//
// Upstream performs unaligned `ptr::read_unaligned` loads over the region's
// backing bytes; the port assembles the same value byte-by-byte from the
// `&[u8]` view — identical semantics for every pointer size and endianness.
// Callers' batch guards guarantee a full pointer-sized read, so the
// out-of-range fallback (0) is unreachable on upstream-valid input.
// SIMD lane readers port as extent fills: same lane values via scalar byte
// reads (Omega's library surface has no vector lane abstraction — the
// kernel's per-lane loop is where a future vector lowering plugs in).

// One guarded byte read: upstream's unaligned pointer load cannot fault on
// the scan loop's in-bounds offsets; the 0 fallback exists only so the
// read is total.
machine read_byte_at(
    current_values: &[u8],
    index: u64
) -> u64 {
    transition (index < current_values.len) {
        true -> at(current_values, index)
        false -> (0)
    }

    state at(
        current_values: &[u8],
        index: u64
    ) -> u64 {
        (current_values[index]) as u64
    }
}

// Upstream `read_unsigned_24_bit_unchecked` with `Endian::Little`.
machine read_unsigned_24_le(
    current_values: &[u8],
    offset: u64
) -> u64 {
    let byte0: u64 = read_byte_at(current_values, offset);
    let byte1: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (1 as u64 in Saturating)) as u64);
    let byte2: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (2 as u64 in Saturating)) as u64);
    (byte0 | (((byte1 as u64 in Wrapping) << (8 as u64 in Wrapping))) as u64 | (((byte2 as u64 in Wrapping) << (16 as u64 in Wrapping))) as u64)
}

// Upstream `read_unsigned_24_bit_unchecked` with `Endian::Big`.
machine read_unsigned_24_be(
    current_values: &[u8],
    offset: u64
) -> u64 {
    let byte0: u64 = read_byte_at(current_values, offset);
    let byte1: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (1 as u64 in Saturating)) as u64);
    let byte2: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (2 as u64 in Saturating)) as u64);
    ((((byte0 as u64 in Wrapping) << (16 as u64 in Wrapping))) as u64 | (((byte1 as u64 in Wrapping) << (8 as u64 in Wrapping))) as u64 | byte2)
}

machine read_unsigned_32_le(
    current_values: &[u8],
    offset: u64
) -> u64 {
    let byte0: u64 = read_byte_at(current_values, offset);
    let byte1: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (1 as u64 in Saturating)) as u64);
    let byte2: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (2 as u64 in Saturating)) as u64);
    let byte3: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (3 as u64 in Saturating)) as u64);
    (byte0 | (((byte1 as u64 in Wrapping) << (8 as u64 in Wrapping))) as u64 | (((byte2 as u64 in Wrapping) << (16 as u64 in Wrapping))) as u64 | (((byte3 as u64 in Wrapping) << (24 as u64 in Wrapping))) as u64)
}

machine read_unsigned_32_be(
    current_values: &[u8],
    offset: u64
) -> u64 {
    let byte0: u64 = read_byte_at(current_values, offset);
    let byte1: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (1 as u64 in Saturating)) as u64);
    let byte2: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (2 as u64 in Saturating)) as u64);
    let byte3: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (3 as u64 in Saturating)) as u64);
    (( ((byte0 as u64 in Wrapping) << (24 as u64 in Wrapping)) | ((byte1 as u64 in Wrapping) << (16 as u64 in Wrapping)) | ((byte2 as u64 in Wrapping) << (8 as u64 in Wrapping)) | (byte3 as u64 in Wrapping) ) as u64)
}

machine read_unsigned_64_le(
    current_values: &[u8],
    offset: u64
) -> u64 {
    let byte0: u64 = read_byte_at(current_values, offset);
    let byte1: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (1 as u64 in Saturating)) as u64);
    let byte2: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (2 as u64 in Saturating)) as u64);
    let byte3: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (3 as u64 in Saturating)) as u64);
    let byte4: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (4 as u64 in Saturating)) as u64);
    let byte5: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (5 as u64 in Saturating)) as u64);
    let byte6: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (6 as u64 in Saturating)) as u64);
    let byte7: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (7 as u64 in Saturating)) as u64);
    (( (byte0 as u64 in Wrapping) | ((byte1 as u64 in Wrapping) << (8 as u64 in Wrapping)) | ((byte2 as u64 in Wrapping) << (16 as u64 in Wrapping)) | ((byte3 as u64 in Wrapping) << (24 as u64 in Wrapping)) | ((byte4 as u64 in Wrapping) << (32 as u64 in Wrapping)) | ((byte5 as u64 in Wrapping) << (40 as u64 in Wrapping)) | ((byte6 as u64 in Wrapping) << (48 as u64 in Wrapping)) | ((byte7 as u64 in Wrapping) << (56 as u64 in Wrapping)) ) as u64)
}

machine read_unsigned_64_be(
    current_values: &[u8],
    offset: u64
) -> u64 {
    let byte0: u64 = read_byte_at(current_values, offset);
    let byte1: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (1 as u64 in Saturating)) as u64);
    let byte2: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (2 as u64 in Saturating)) as u64);
    let byte3: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (3 as u64 in Saturating)) as u64);
    let byte4: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (4 as u64 in Saturating)) as u64);
    let byte5: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (5 as u64 in Saturating)) as u64);
    let byte6: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (6 as u64 in Saturating)) as u64);
    let byte7: u64 = read_byte_at(current_values, ((offset as u64 in Saturating) + (7 as u64 in Saturating)) as u64);
    (( ((byte0 as u64 in Wrapping) << (56 as u64 in Wrapping)) | ((byte1 as u64 in Wrapping) << (48 as u64 in Wrapping)) | ((byte2 as u64 in Wrapping) << (40 as u64 in Wrapping)) | ((byte3 as u64 in Wrapping) << (32 as u64 in Wrapping)) | ((byte4 as u64 in Wrapping) << (24 as u64 in Wrapping)) | ((byte5 as u64 in Wrapping) << (16 as u64 in Wrapping)) | ((byte6 as u64 in Wrapping) << (8 as u64 in Wrapping)) | (byte7 as u64 in Wrapping) ) as u64)
}

// Upstream `read_pointer_value_unchecked` — the `*const u8` deref is the
// `current_values[offset..offset+size]` view reassembled per endianness.
pub machine read_pointer_value_unchecked(
    current_values: &[u8],
    offset: u64,
    pointer_size: PointerScanPointerSize
) -> u64 {
    transition pointer_size {
        PointerScanPointerSize::Pointer24 -> (read_unsigned_24_le(current_values, offset))
        PointerScanPointerSize::Pointer24be -> (read_unsigned_24_be(current_values, offset))
        PointerScanPointerSize::Pointer32 -> (read_unsigned_32_le(current_values, offset))
        PointerScanPointerSize::Pointer32be -> (read_unsigned_32_be(current_values, offset))
        PointerScanPointerSize::Pointer64 -> (read_unsigned_64_le(current_values, offset))
        PointerScanPointerSize::Pointer64be -> (read_unsigned_64_be(current_values, offset))
        _ -> (0)
    }
}

// Upstream `read_pointer_lane_values_u32<SIMD_LANE_COUNT>`: fills
// `lane_values[0..lane_count]` with the unaligned u32 lane loads at
// `offset + lane_index * 4`, endian-converted per pointer size. 24-bit
// sizes are unreachable upstream (SIMD unsupported); they fill 0 lanes.
pub machine read_pointer_lane_values_u32(
    current_values: &[u8],
    offset: u64,
    pointer_size: PointerScanPointerSize,
    lane_values: &mut [u32],
    lane_count: u64
) {
    fill_lanes(current_values, offset, pointer_size, lane_values, lane_count, 0);

    state fill_lanes(
        current_values: &[u8],
        offset: u64,
        pointer_size: PointerScanPointerSize,
        lane_values: &mut [u32],
        lane_count: u64,
        lane_index: u64
    ) {
        transition (lane_index < lane_count) {
            true -> capacity_gate(current_values, offset, pointer_size, lane_values, lane_count, lane_index)
            false -> finished()
        }
    }

    state capacity_gate(
        current_values: &[u8],
        offset: u64,
        pointer_size: PointerScanPointerSize,
        lane_values: &mut [u32],
        lane_count: u64,
        lane_index: u64
    ) {
        transition (lane_index < lane_values.len) {
            true -> lane_fill(current_values, offset, pointer_size, lane_values, lane_count, lane_index)
            false -> finished()
        }
    }

    state lane_fill(
        current_values: &[u8],
        offset: u64,
        pointer_size: PointerScanPointerSize,
        lane_values: &mut [u32],
        lane_count: u64,
        lane_index: u64
    ) {
        let lane_offset: u64 = (((offset as u64 in Saturating) + ((lane_index as u64 in Saturating) * (4 as u64 in Saturating))) as u64);
        transition pointer_size {
            PointerScanPointerSize::Pointer32 -> fill_le(current_values, offset, pointer_size, lane_values, lane_count, lane_index, lane_offset)
            PointerScanPointerSize::Pointer32be -> fill_be(current_values, offset, pointer_size, lane_values, lane_count, lane_index, lane_offset)
            _ -> fill_zero(current_values, offset, pointer_size, lane_values, lane_count, lane_index, lane_offset)
        }
    }

    state fill_le(
        current_values: &[u8],
        offset: u64,
        pointer_size: PointerScanPointerSize,
        lane_values: &mut [u32],
        lane_count: u64,
        lane_index: u64,
        lane_offset: u64
    ) {
        lane_values[lane_index] = (read_unsigned_32_le(current_values, lane_offset) as u32 in Wrapping) as u32;
        fill_lanes(current_values, offset, pointer_size, lane_values, lane_count, ((lane_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
    }

    state fill_be(
        current_values: &[u8],
        offset: u64,
        pointer_size: PointerScanPointerSize,
        lane_values: &mut [u32],
        lane_count: u64,
        lane_index: u64,
        lane_offset: u64
    ) {
        lane_values[lane_index] = (read_unsigned_32_be(current_values, lane_offset) as u32 in Wrapping) as u32;
        fill_lanes(current_values, offset, pointer_size, lane_values, lane_count, ((lane_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
    }

    state fill_zero(
        current_values: &[u8],
        offset: u64,
        pointer_size: PointerScanPointerSize,
        lane_values: &mut [u32],
        lane_count: u64,
        lane_index: u64,
        lane_offset: u64
    ) {
        lane_values[lane_index] = 0;
        fill_lanes(current_values, offset, pointer_size, lane_values, lane_count, ((lane_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
    }

    state finished() {}
}

// Upstream `read_pointer_lane_values_u64<SIMD_LANE_COUNT>`: fills
// `lane_values[0..lane_count]` with the unaligned u64 lane loads at
// `offset + lane_index * 8`. 32-bit sizes produce the same u64 lanes
// upstream does (the raw unaligned u64 read is endian-matched by size).
pub machine read_pointer_lane_values_u64(
    current_values: &[u8],
    offset: u64,
    pointer_size: PointerScanPointerSize,
    lane_values: &mut [u64],
    lane_count: u64
) {
    fill_lanes(current_values, offset, pointer_size, lane_values, lane_count, 0);

    state fill_lanes(
        current_values: &[u8],
        offset: u64,
        pointer_size: PointerScanPointerSize,
        lane_values: &mut [u64],
        lane_count: u64,
        lane_index: u64
    ) {
        transition (lane_index < lane_count) {
            true -> capacity_gate(current_values, offset, pointer_size, lane_values, lane_count, lane_index)
            false -> finished()
        }
    }

    state capacity_gate(
        current_values: &[u8],
        offset: u64,
        pointer_size: PointerScanPointerSize,
        lane_values: &mut [u64],
        lane_count: u64,
        lane_index: u64
    ) {
        transition (lane_index < lane_values.len) {
            true -> lane_fill(current_values, offset, pointer_size, lane_values, lane_count, lane_index)
            false -> finished()
        }
    }

    state lane_fill(
        current_values: &[u8],
        offset: u64,
        pointer_size: PointerScanPointerSize,
        lane_values: &mut [u64],
        lane_count: u64,
        lane_index: u64
    ) {
        let lane_offset: u64 = (((offset as u64 in Saturating) + ((lane_index as u64 in Saturating) * (8 as u64 in Saturating))) as u64);
        transition pointer_size {
            PointerScanPointerSize::Pointer64 -> fill_le(current_values, offset, pointer_size, lane_values, lane_count, lane_index, lane_offset)
            PointerScanPointerSize::Pointer64be -> fill_be(current_values, offset, pointer_size, lane_values, lane_count, lane_index, lane_offset)
            _ -> fill_zero(current_values, offset, pointer_size, lane_values, lane_count, lane_index, lane_offset)
        }
    }

    state fill_le(
        current_values: &[u8],
        offset: u64,
        pointer_size: PointerScanPointerSize,
        lane_values: &mut [u64],
        lane_count: u64,
        lane_index: u64,
        lane_offset: u64
    ) {
        lane_values[lane_index] = read_unsigned_64_le(current_values, lane_offset);
        fill_lanes(current_values, offset, pointer_size, lane_values, lane_count, ((lane_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
    }

    state fill_be(
        current_values: &[u8],
        offset: u64,
        pointer_size: PointerScanPointerSize,
        lane_values: &mut [u64],
        lane_count: u64,
        lane_index: u64,
        lane_offset: u64
    ) {
        lane_values[lane_index] = read_unsigned_64_be(current_values, lane_offset);
        fill_lanes(current_values, offset, pointer_size, lane_values, lane_count, ((lane_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
    }

    state fill_zero(
        current_values: &[u8],
        offset: u64,
        pointer_size: PointerScanPointerSize,
        lane_values: &mut [u64],
        lane_count: u64,
        lane_index: u64,
        lane_offset: u64
    ) {
        lane_values[lane_index] = 0;
        fill_lanes(current_values, offset, pointer_size, lane_values, lane_count, ((lane_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
    }

    state finished() {}
}
