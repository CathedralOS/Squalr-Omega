module src::pointer_scans::search_kernels::pointer_scan_search_kernel;

use src::pointer_scans::structures::pointer_scan_region_match::PointerScanRegionMatch;
use src::pointer_scans::search_kernels::pointer_scan_search_kernel_context::PointerScanSearchKernelContext;

// Upstream's `visit_match: &mut dyn FnMut(PointerScanRegionMatch)` translates
// to an erased visitor trait: the caller conforms its collector and the
// kernel emits one `visit` per discovered candidate, preserving upstream's
// push model rather than collecting into an intermediate buffer. The trait
// was seeded beside the SIMD-linear kernel that first needed it and re-homes
// onto this shared search-kernel surface with the kernel hub trait.
pub trait PointerScanMatchVisitor {
    machine visit(&mut self, pointer_match: PointerScanRegionMatch);
}

// Port of search_kernels/pointer_scan_search_kernel.rs: the hub trait every
// pointer-scan search kernel implements (upstream also requires Send + Sync
// auto-traits, which have no Omega counterpart). Upstream's `is_empty` is a
// defaulted method (`self.context.get_target_range_set().is_empty()`) — the
// three ported kernels each carry the identical body. Upstream's cfg(test)
// `scan_region` convenience wrapper — which adapts an `&mut Vec` collector
// into `scan_region_with_visitor` — is not ported: it is test-only
// scaffolding upstream and Vec construction has no Omega surface.
pub trait PointerScanSearchKernel {
    machine is_empty(
        &self,
        pointer_scan_search_kernel_context: &PointerScanSearchKernelContext
    ) -> bool;

    machine scan_region_with_visitor(
        &self,
        pointer_scan_search_kernel_context: &PointerScanSearchKernelContext,
        base_address: u64,
        current_values: &[u8],
        visit_match: &mut dyn PointerScanMatchVisitor
    );
}
