module src::pointer_scans::search_kernels::pointer_scan_simd_linear_search_kernel;

use squalr_engine_api::src::structures::pointer_scans::pointer_scan_pointer_size::PointerScanPointerSize;
use src::pointer_scans::search_kernels::pointer_scan_pointer_value_reader::read_pointer_value_unchecked;
use src::pointer_scans::search_kernels::pointer_scan_search_kernel_context::PointerScanSearchKernelContext;
use src::pointer_scans::structures::pointer_scan_region_match::PointerScanRegionMatch;
use src::pointer_scans::structures::pointer_scan_target_ranges::PointerScanTargetRangeSet;

// Port of search_kernels/pointer_scan_simd_linear_search_kernel.rs.
//
// Upstream's `visit_match: &mut dyn FnMut(PointerScanRegionMatch)` translates
// to an erased visitor trait: the caller conforms its collector and the
// kernel emits one `visit` per discovered candidate, preserving upstream's
// push model rather than collecting into an intermediate buffer. The trait
// lives beside the kernel that first needs it; if the search-kernel leaf
// lands a shared visitor surface this should re-home onto it.
pub trait PointerScanMatchVisitor {
    machine visit(&mut self, pointer_match: PointerScanRegionMatch);
}

// Upstream's zero-field `SimdLinearPointerScanKernel` unit struct.
pub data SimdLinearPointerScanKernel {}

// Upstream `PointerScanSearchKernel::is_empty` default: the kernel reports
// empty exactly when the target range set carries no ranges.
pub machine SimdLinearPointerScanKernel::is_empty(
    &self,
    pointer_scan_search_kernel_context: &PointerScanSearchKernelContext
) -> bool {
    pointer_scan_search_kernel_context.get_target_range_set().is_empty()
}

// Port of `scan_region_with_visitor`. Upstream splits the region body into a
// vectorized prefix and a scalar tail handled by
// `scan_region_scalar_with_predicate`. Omega has no SIMD lane abstraction in
// its library surface, so each 64-byte batch walks its lanes as ordinary
// sequential pointer reads before emitting the set lanes — the produced match
// set, ordering, and tail behavior are identical (the lane loop is where a
// future vector lowering plugs in). The 24-bit sizes never had lane support
// upstream and take the same scalar walk as the shared tail.
pub machine SimdLinearPointerScanKernel::scan_region_with_visitor(
    &self,
    pointer_scan_search_kernel_context: &PointerScanSearchKernelContext,
    base_address: u64,
    current_values: &[u8],
    visit_match: &mut dyn PointerScanMatchVisitor
) {
    begin(
        pointer_scan_search_kernel_context,
        base_address,
        current_values,
        &mut visit_match
    );

    state begin(
        pointer_scan_search_kernel_context: &PointerScanSearchKernelContext,
        base_address: u64,
        current_values: &[u8],
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        let pointer_size: PointerScanPointerSize =
            pointer_scan_search_kernel_context.get_pointer_size();
        let target_range_set: &PointerScanTargetRangeSet =
            pointer_scan_search_kernel_context.get_target_range_set();
        // Upstream `find_scan_start_offset` inlined: its Option<usize> is
        // std Optional<T>, which cannot be destructured inside a module file
        // (the checker rejects imported generic instantiations in transition
        // patterns). Same computation: alignment remainder folds to the
        // aligned offset; the helper's two None cases are exactly
        // `start_offset + size > len` on `covered` below.
        let pointer_size_in_bytes: u64 = pointer_size.get_size_in_bytes();
        let alignment_remainder: u64 = base_address % pointer_size_in_bytes;
        let start_offset: u64 =
            (((pointer_size_in_bytes as u64 in Saturating) - (alignment_remainder as u64 in Saturating)) as u64)
                % pointer_size_in_bytes;
        let covered: u64 = ((start_offset as u64 in Saturating)
            + (pointer_size_in_bytes as u64 in Saturating)) as u64;
        transition covered <= current_values.len {
            true -> dispatch_by_size(
                base_address,
                current_values,
                start_offset,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
            false -> finished()
            _ -> finished()
        }
    }

    state dispatch_by_size(
        base_address: u64,
        current_values: &[u8],
        start_offset: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        transition pointer_size {
            PointerScanPointerSize::Pointer24 -> scalar_tail(
                base_address,
                current_values,
                start_offset,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
            PointerScanPointerSize::Pointer24be -> scalar_tail(
                base_address,
                current_values,
                start_offset,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
            PointerScanPointerSize::Pointer32 -> scan_region_simd_linear_u32(
                base_address,
                current_values,
                start_offset,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
            PointerScanPointerSize::Pointer32be -> scan_region_simd_linear_u32(
                base_address,
                current_values,
                start_offset,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
            PointerScanPointerSize::Pointer64 -> scan_region_simd_linear_u64(
                base_address,
                current_values,
                start_offset,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
            PointerScanPointerSize::Pointer64be -> scan_region_simd_linear_u64(
                base_address,
                current_values,
                start_offset,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
            _ -> scalar_tail(
                base_address,
                current_values,
                start_offset,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
        }
    }

    // Upstream `scan_region_simd_linear_u32`: SIMD_LANE_COUNT=16 lanes of
    // pointer_size_in_bytes=4 — one 64-byte block per batch. Upstream's
    // u32 lane comparisons (lower bound skipped when it exceeds u32, upper
    // bound clamped to u32::MAX) are exactly the range-set linear probe on
    // the zero-extended lane value, so each lane checks the same
    // `contains_value_linear` the scalar tail uses.
    state scan_region_simd_linear_u32(
        base_address: u64,
        current_values: &[u8],
        start_offset: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        batch_outer(
            base_address,
            current_values,
            start_offset,
            16,
            4,
            pointer_size,
            target_range_set,
            &mut visit_match
        )
    }

    // Upstream `scan_region_simd_linear_u64`: SIMD_LANE_COUNT=8 lanes of
    // pointer_size_in_bytes=8 — one 64-byte block per batch.
    state scan_region_simd_linear_u64(
        base_address: u64,
        current_values: &[u8],
        start_offset: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        batch_outer(
            base_address,
            current_values,
            start_offset,
            8,
            8,
            pointer_size,
            target_range_set,
            &mut visit_match
        )
    }

    // Upstream's `while offset + LANE_COUNT * width <= len` batch guard.
    // `lane_count` and `lane_width` carry the upstream per-width constants;
    // `block_bytes` is their product (always 64).
    state batch_outer(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        lane_count: u64,
        lane_width: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        let block_bytes: u64 = ((lane_count as u64 in Wrapping) * (lane_width as u64 in Wrapping)) as u64;
        let covered: u64 = ((pointer_value_offset as u64 in Saturating) + (block_bytes as u64 in Saturating)) as u64;
        transition covered <= current_values.len {
            true -> mask_build(
                base_address,
                current_values,
                pointer_value_offset,
                lane_count,
                lane_width,
                pointer_size,
                target_range_set,
                &mut visit_match,
                0,
                0
            )
            false -> scalar_tail(
                base_address,
                current_values,
                pointer_value_offset,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
            _ -> scalar_tail(
                base_address,
                current_values,
                pointer_value_offset,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
        }
    }

    // Builds upstream's `matching_lane_mask`: bit lane_index is set when the
    // lane's decoded pointer value lands inside any target range — the OR of
    // the per-range lane masks upstream accumulates vectorwise.
    state mask_build(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        lane_count: u64,
        lane_width: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor,
        lane_index: u64,
        matching_lane_mask: u64
    ) {
        transition lane_index < lane_count {
            true -> lane_probe(
                base_address,
                current_values,
                pointer_value_offset,
                lane_count,
                lane_width,
                pointer_size,
                target_range_set,
                &mut visit_match,
                lane_index,
                matching_lane_mask
            )
            false -> emit_gate(
                base_address,
                current_values,
                pointer_value_offset,
                lane_count,
                lane_width,
                pointer_size,
                target_range_set,
                &mut visit_match,
                matching_lane_mask
            )
        }
    }

    state lane_probe(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        lane_count: u64,
        lane_width: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor,
        lane_index: u64,
        matching_lane_mask: u64
    ) {
        let lane_offset: u64 = ((pointer_value_offset as u64 in Saturating)
            + (((lane_index as u64 in Wrapping) * (lane_width as u64 in Wrapping)) as u64 in Saturating)) as u64;
        let pointer_value: u64 =
            read_pointer_value_unchecked(current_values, lane_offset, pointer_size);
        transition target_range_set.contains_value_linear(pointer_value) {
            true -> lane_probe_next(
                base_address,
                current_values,
                pointer_value_offset,
                lane_count,
                lane_width,
                pointer_size,
                target_range_set,
                &mut visit_match,
                lane_index,
                matching_lane_mask | (((1 as u64 in Wrapping) << lane_index) as u64)
            )
            false -> lane_probe_next(
                base_address,
                current_values,
                pointer_value_offset,
                lane_count,
                lane_width,
                pointer_size,
                target_range_set,
                &mut visit_match,
                lane_index,
                matching_lane_mask
            )
        }
    }

    state lane_probe_next(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        lane_count: u64,
        lane_width: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor,
        lane_index: u64,
        matching_lane_mask: u64
    ) {
        mask_build(
            base_address,
            current_values,
            pointer_value_offset,
            lane_count,
            lane_width,
            pointer_size,
            target_range_set,
            &mut visit_match,
            ((lane_index as u64 in Wrapping) + 1) as u64,
            matching_lane_mask
        )
    }

    // Upstream `if matching_lane_mask != 0`: skip the emit walk entirely on
    // an empty mask, then advance the batch by one 64-byte block.
    state emit_gate(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        lane_count: u64,
        lane_width: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor,
        matching_lane_mask: u64
    ) {
        transition matching_lane_mask != 0 {
            true -> emit_lanes(
                base_address,
                current_values,
                pointer_value_offset,
                lane_count,
                lane_width,
                pointer_size,
                target_range_set,
                &mut visit_match,
                matching_lane_mask,
                0
            )
            false -> batch_advance(
                base_address,
                current_values,
                pointer_value_offset,
                lane_count,
                lane_width,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
        }
    }

    state emit_lanes(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        lane_count: u64,
        lane_width: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor,
        matching_lane_mask: u64,
        lane_index: u64
    ) {
        transition lane_index < lane_count {
            true -> emit_test(
                base_address,
                current_values,
                pointer_value_offset,
                lane_count,
                lane_width,
                pointer_size,
                target_range_set,
                &mut visit_match,
                matching_lane_mask,
                lane_index
            )
            false -> batch_advance(
                base_address,
                current_values,
                pointer_value_offset,
                lane_count,
                lane_width,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
        }
    }

    // Upstream `matching_lane_mask & (1 << lane_index) == 0 -> continue`.
    state emit_test(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        lane_count: u64,
        lane_width: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor,
        matching_lane_mask: u64,
        lane_index: u64
    ) {
        transition (matching_lane_mask & (((1 as u64 in Wrapping) << lane_index) as u64)) != 0 {
            true -> emit_visit(
                base_address,
                current_values,
                pointer_value_offset,
                lane_count,
                lane_width,
                pointer_size,
                target_range_set,
                &mut visit_match,
                matching_lane_mask,
                lane_index
            )
            false -> emit_lanes(
                base_address,
                current_values,
                pointer_value_offset,
                lane_count,
                lane_width,
                pointer_size,
                target_range_set,
                &mut visit_match,
                matching_lane_mask,
                ((lane_index as u64 in Wrapping) + 1) as u64
            )
        }
    }

    // Upstream emits `PointerScanRegionMatch::new(base + offset + lane*width,
    // lane_values[lane])`; the lane value is re-read at the same offset the
    // mask probe decoded, keeping one decode site per lane.
    state emit_visit(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        lane_count: u64,
        lane_width: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor,
        matching_lane_mask: u64,
        lane_index: u64
    ) {
        let lane_offset: u64 = ((pointer_value_offset as u64 in Saturating)
            + (((lane_index as u64 in Wrapping) * (lane_width as u64 in Wrapping)) as u64 in Saturating)) as u64;
        let pointer_value: u64 =
            read_pointer_value_unchecked(current_values, lane_offset, pointer_size);
        visit_match.visit(PointerScanRegionMatch::new(
            ((base_address as u64 in Saturating) + (lane_offset as u64 in Saturating)) as u64,
            pointer_value
        ));
        emit_lanes(
            base_address,
            current_values,
            pointer_value_offset,
            lane_count,
            lane_width,
            pointer_size,
            target_range_set,
            &mut visit_match,
            matching_lane_mask,
            ((lane_index as u64 in Wrapping) + 1) as u64
        )
    }

    state batch_advance(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        lane_count: u64,
        lane_width: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        let block_bytes: u64 = ((lane_count as u64 in Wrapping) * (lane_width as u64 in Wrapping)) as u64;
        batch_outer(
            base_address,
            current_values,
            ((pointer_value_offset as u64 in Saturating) + (block_bytes as u64 in Saturating)) as u64,
            lane_count,
            lane_width,
            pointer_size,
            target_range_set,
            &mut visit_match
        )
    }

    // The scalar tail upstream delegates to `scan_region_scalar_with_predicate`
    // with `contains_value_linear`; inlined here as the identical walk —
    // aligned start offset, pointer-size stride, same match emission — so the
    // leaf does not invent a second callback plumbing for one shared loop.
    state scalar_tail(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        let pointer_size_in_bytes: u64 = pointer_size.get_size_in_bytes();
        let covered: u64 = ((pointer_value_offset as u64 in Saturating)
            + (pointer_size_in_bytes as u64 in Saturating)) as u64;
        transition covered <= current_values.len {
            true -> tail_read(
                base_address,
                current_values,
                pointer_value_offset,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
            false -> finished()
            _ -> finished()
        }
    }

    state tail_read(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        let pointer_value: u64 =
            read_pointer_value_unchecked(current_values, pointer_value_offset, pointer_size);
        transition target_range_set.contains_value_linear(pointer_value) {
            true -> tail_emit(
                base_address,
                current_values,
                pointer_value_offset,
                pointer_size,
                target_range_set,
                &mut visit_match,
                pointer_value
            )
            false -> tail_next(
                base_address,
                current_values,
                pointer_value_offset,
                pointer_size,
                target_range_set,
                &mut visit_match
            )
        }
    }

    state tail_emit(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor,
        pointer_value: u64
    ) {
        visit_match.visit(PointerScanRegionMatch::new(
            ((base_address as u64 in Saturating) + (pointer_value_offset as u64 in Saturating)) as u64,
            pointer_value
        ));
        tail_next(
            base_address,
            current_values,
            pointer_value_offset,
            pointer_size,
            target_range_set,
            &mut visit_match
        )
    }

    state tail_next(
        base_address: u64,
        current_values: &[u8],
        pointer_value_offset: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        let pointer_size_in_bytes: u64 = pointer_size.get_size_in_bytes();
        scalar_tail(
            base_address,
            current_values,
            ((pointer_value_offset as u64 in Saturating) + (pointer_size_in_bytes as u64 in Saturating)) as u64,
            pointer_size,
            target_range_set,
            &mut visit_match
        )
    }

    state finished() {}
}
