module src::pointer_scans::search_kernels::pointer_scan_scalar_linear_search_kernel;

use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use src::pointer_scans::search_kernels::pointer_scan_scalar_region_scanner::scan_region_scalar_with_predicate;
use src::pointer_scans::search_kernels::pointer_scan_search_kernel_context::PointerScanSearchKernelContext;
use src::pointer_scans::search_kernels::pointer_scan_search_kernel_utils::ScanStartOffset;
use src::pointer_scans::search_kernels::pointer_scan_search_kernel_utils::find_scan_start_offset;
use src::pointer_scans::search_kernels::pointer_scan_simd_linear_search_kernel::PointerScanMatchVisitor;
use src::pointer_scans::structures::pointer_scan_region_match::PointerScanRegionMatch;
use src::pointer_scans::structures::pointer_scan_target_ranges::PointerScanTargetRangeSet;
use src::pointer_scans::structures::pointer_scan_target_ranges::pointer_scan_target_range_set_is_empty;

// Port of search_kernels/pointer_scan_scalar_linear_search_kernel.rs.

// Upstream's zero-field `ScalarLinearPointerScanKernel` unit struct.
pub data ScalarLinearPointerScanKernel {}

// Upstream `PointerScanSearchKernel::is_empty` default: the kernel reports
// empty exactly when the target range set carries no ranges.
pub machine ScalarLinearPointerScanKernel::is_empty(
    &self,
    pointer_scan_search_kernel_context: &PointerScanSearchKernelContext
) -> bool {
    let target_range_set: &PointerScanTargetRangeSet = pointer_scan_search_kernel_context.get_target_range_set();
    let range_set_is_empty: bool = pointer_scan_target_range_set_is_empty(target_range_set);
    range_set_is_empty
}

// Port of `scan_region_with_visitor`: aligned start offset, then the shared
// scalar region walk with `contains_value_linear` as the predicate.
pub machine ScalarLinearPointerScanKernel::scan_region_with_visitor(
    &self,
    pointer_scan_search_kernel_context: &PointerScanSearchKernelContext,
    base_address: u64,
    current_values: &[u8],
    visit_match: &mut dyn PointerScanMatchVisitor
) {
    let pointer_size: PointerScanPointerSize =
        pointer_scan_search_kernel_context.get_pointer_size();
    let target_range_set: &PointerScanTargetRangeSet =
        pointer_scan_search_kernel_context.get_target_range_set();
    let start: ScanStartOffset = find_scan_start_offset(base_address, current_values, pointer_size);
    transition (start.found) {
        true -> scan(
            base_address,
            current_values,
            start.start_offset,
            pointer_size,
            target_range_set,
            &mut visit_match
        )
        false -> finished()
    }

    state scan(
        base_address: u64,
        current_values: &[u8],
        start_offset: u64,
        pointer_size: PointerScanPointerSize,
        target_range_set: &PointerScanTargetRangeSet,
        visit_match: &mut dyn PointerScanMatchVisitor
    ) {
        scan_region_scalar_with_predicate(
            base_address,
            current_values,
            start_offset,
            pointer_size,
            target_range_set,
            false,
            &mut visit_match
        )
    }

    state finished() {}
}
