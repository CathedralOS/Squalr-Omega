module src::pointer_scans::search_kernels::pointer_scan_search_kernel_utils;

use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;

// Port of search_kernels/pointer_scan_search_kernel_utils.rs.
// `Option<usize>` ports as a found+offset carrier.

pub data ScanStartOffset [copy] {
    found: bool;
    start_offset: u64;
}

// Upstream `find_scan_start_offset`: alignment remainder folds to the
// aligned offset; returns None when the aligned pointer read would not fit
// inside `current_values` (or the values are shorter than a pointer).
pub machine find_scan_start_offset(
    base_address: u64,
    current_values: &[u8],
    pointer_size: PointerScanPointerSize
) -> ScanStartOffset {
    let pointer_size_in_bytes: u64 = pointer_size.get_size_in_bytes();
    transition (current_values.len >= pointer_size_in_bytes) {
        true -> align(base_address, current_values, pointer_size_in_bytes)
        false -> ScanStartOffset { found: false, start_offset: 0 }
    }

    state align(
        base_address: u64,
        current_values: &[u8],
        pointer_size_in_bytes: u64
    ) -> ScanStartOffset {
        let alignment_remainder: u64 = base_address % pointer_size_in_bytes;
        transition (alignment_remainder == 0) {
            true -> fits(current_values, 0, pointer_size_in_bytes)
            false -> align_up(current_values, alignment_remainder, pointer_size_in_bytes)
        }
    }

    state align_up(
        current_values: &[u8],
        alignment_remainder: u64,
        pointer_size_in_bytes: u64
    ) -> ScanStartOffset {
        let start_offset: u64 = ((pointer_size_in_bytes as u64 in Saturating) - (alignment_remainder as u64 in Saturating)) as u64;
        fits(current_values, start_offset, pointer_size_in_bytes)
    }

    state fits(
        current_values: &[u8],
        start_offset: u64,
        pointer_size_in_bytes: u64
    ) -> ScanStartOffset {
        let covered: u64 = ((start_offset as u64 in Saturating) + (pointer_size_in_bytes as u64 in Saturating)) as u64;
        transition (covered <= current_values.len) {
            true -> ScanStartOffset { found: true, start_offset: start_offset }
            false -> ScanStartOffset { found: false, start_offset: 0 }
        }
    }
}
