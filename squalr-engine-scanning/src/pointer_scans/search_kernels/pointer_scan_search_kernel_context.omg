module src::pointer_scans::search_kernels::pointer_scan_search_kernel_context;

use src::pointer_scans::structures::pointer_scan_target_ranges::PointerScanTargetRangeSet;
use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;

// Port of search_kernels/pointer_scan_search_kernel_context.rs.
// Shared per-dispatch inputs for a concrete pointer-scan search kernel.

pub data PointerScanSearchKernelContext<'ranges> {
    target_range_set: &'ranges PointerScanTargetRangeSet<'ranges>;
    pointer_size: PointerScanPointerSize;
}

pub machine PointerScanSearchKernelContext::new<'ranges>(
    target_range_set: &'ranges PointerScanTargetRangeSet<'ranges>,
    pointer_size: PointerScanPointerSize
) -> PointerScanSearchKernelContext<'ranges> {
    PointerScanSearchKernelContext {
        target_range_set: target_range_set,
        pointer_size: pointer_size
    }
}

pub machine PointerScanSearchKernelContext::get_target_range_set<'ranges>(
    &self
) -> &'ranges PointerScanTargetRangeSet<'ranges> {
    self.target_range_set
}

pub machine PointerScanSearchKernelContext::get_pointer_size(&self) -> PointerScanPointerSize {
    self.pointer_size
}
