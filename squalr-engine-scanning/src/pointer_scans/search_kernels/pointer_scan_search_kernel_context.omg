module src::pointer_scans::search_kernels::pointer_scan_search_kernel_context;

// Port of pointer_scan_search_kernel_context.rs: the borrowed target-range
// set plus the pointer size every kernel reads.
use squalr_engine_api::src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use src::pointer_scans::structures::pointer_scan_target_ranges::PointerScanTargetRangeSet;

pub data PointerScanSearchKernelContext<'a> {
    target_range_set: &'a PointerScanTargetRangeSet<'a>;
    pointer_size: PointerScanPointerSize;
}

pub machine PointerScanSearchKernelContext::new<'a>(
    target_range_set: &'a PointerScanTargetRangeSet<'a>,
    pointer_size: PointerScanPointerSize
) -> PointerScanSearchKernelContext<'a> {
    PointerScanSearchKernelContext {
        target_range_set: target_range_set,
        pointer_size: pointer_size
    }
}

pub machine PointerScanSearchKernelContext::get_target_range_set<'a>(
    &self
) -> &'a PointerScanTargetRangeSet<'a> {
    self.target_range_set
}

pub machine PointerScanSearchKernelContext::get_pointer_size(
    &self
) -> PointerScanPointerSize {
    self.pointer_size
}
