module src::pointer_scans::pointer_scan_results_builder;

use squalr_engine_api::src::structures::memory::normalized_module::NormalizedModule;
use squalr_engine_api::src::structures::scanning::plans::pointer_scan::pointer_scan_parameters::PointerScanParameters;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_address_space::PointerScanAddressSpace;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_candidate::PointerScanCandidate;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_level::PointerScanLevel;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_level_candidates::PointerScanLevelCandidates;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_node::PointerScanNode;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_node_type::PointerScanNodeType;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_results::MaterializedPageKeyEntry;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_results::PointerScanModuleName;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_results::PointerScanResults;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_target_descriptor::PointerScanTargetDescriptor;
use src::pointer_scans::structures::pointer_scan_collected_candidate::PointerScanCollectedCandidate;
use src::pointer_scans::structures::pointer_scan_collected_level::PointerScanCollectedLevel;

// Port of pointer_scan_results_builder.rs.
//
// Upstream `build_results` maps a `Vec<PointerScanCollectedLevel>` onto fresh
// Vecs and returns owned `PointerScanResults`. The omega results record
// borrows caller-owned extents, so the build is three phases driven by the
// caller (`PointerScanExecutor::collect_scan_levels`,
// `PointerScanValidator::collect_validated_levels`, then the seal):
//
//   `begin_from_modules` / `begin_from_module_names` fill the module-name
//   rows — upstream's `build_results` derives them from the live
//   `&[NormalizedModule]` table while `build_results_with_module_names` takes
//   the stored names (the validator keeps stored module indices meaningful) —
//   and start a `PointerScanResultsBuild` cursor.
//
//   `record_level` copies one collected level, in collected order, into the
//   flat `static_candidate_arena` / `heap_candidate_arena` at the cursor's
//   running fills (upstream `build_level_candidates`; candidates arrive
//   presorted from the collector, matching upstream's `new_presorted`
//   constructor) and records the `PointerScanLevel` row plus the arena span
//   the seal needs. The caller calls it once per pulled level.
//
//   `seal_results` stores one `PointerScanLevelCandidates::new_presorted`
//   per recorded span with SHARED `&arena[offset..end]` windows of the now
//   frozen arenas — N disjoint shared windows of one arena coexist, disjoint
//   `&mut` windows cannot — and assembles `PointerScanResults`.
//
// The level pull stays with the caller rather than inside the builder
// because of the checker's exact stored-reference relation: the seal
// installs borrowed arena windows into caller-owned outputs, so every call
// made by the sealing machine needs an exact normal-exit relation, and the
// kernel visitor dispatch (`dyn PointerScanMatchVisitor`) under
// `PointerScanDiscoveredLevels::next` has none. A pull loop that only copies
// values stores no borrow and may run that dispatch freely.
//
// Honest-capacity semantics: every fill is bounded by both the provider
// count and the lent extent's length, and `level_spans_out` records what was
// actually stored (callers size arenas to cover the collected extents they
// themselves lent). `levels_out`, `level_candidates_out`, and
// `level_spans_out` are expected at equal capacity; when the level rows are
// full the cursor reports `extents_full` and the caller stops pulling, so
// the stored span/level rows keep the result self-consistent (upstream's
// growable Vecs cannot overflow). Upstream iterates a pre-built Vec where
// `is_empty` decides the empty path up front; a drain that recorded no
// level seals with `module_name_count` 0, exactly as upstream's
// `create_empty_results` constructs `module_names: vec![]`.
//
// The `Value` candidate variant is not part of this build — the missing
// symbol is `structures::data_types::data_type_ref::DataTypeRef` (z2
// scalar-scan lane), matching the results-materializer deviation.
public data BuiltLevelSpan [copy] {
    static_offset: u64;
    static_count: u64;
    heap_offset: u64;
    heap_count: u64;
}

// The build cursor carried between `begin_*`, each `record_level`, and
// `seal_results`: recorded level rows, arena fills, the next candidate id,
// the filled module-name prefix, and the node totals.
public data PointerScanResultsBuild [copy] {
    level_count: u64;
    static_fill: u64;
    heap_fill: u64;
    next_candidate_id: u64;
    module_name_count: u64;
    total_static_node_count: u64;
    total_heap_node_count: u64;
    // Set once a level did not fit the row extents; the drain stops there.
    extents_full: bool;
}

public machine PointerScanResultsBuild::new(module_name_count: u64) -> PointerScanResultsBuild {
    (PointerScanResultsBuild {
        level_count: 0,
        static_fill: 0,
        heap_fill: 0,
        next_candidate_id: 1,
        module_name_count: module_name_count,
        total_static_node_count: 0,
        total_heap_node_count: 0,
        extents_full: false
    })
}

public machine PointerScanResultsBuild::mark_full(this: PointerScanResultsBuild) -> PointerScanResultsBuild {
    (PointerScanResultsBuild {
        level_count: this.level_count,
        static_fill: this.static_fill,
        heap_fill: this.heap_fill,
        next_candidate_id: this.next_candidate_id,
        module_name_count: this.module_name_count,
        total_static_node_count: this.total_static_node_count,
        total_heap_node_count: this.total_heap_node_count,
        extents_full: true
    })
}

public data PointerScanResultsBuilder {}

// Upstream `build_results` module-name leg: `modules.map(|m| m.get_module_name())`.
// The filled prefix is bounded by both extents.
public machine PointerScanResultsBuilder::begin_from_modules(
    modules: &[NormalizedModule],
    module_names_out: &mut [PointerScanModuleName]
) -> PointerScanResultsBuild {
    transition { _ -> fill(modules, module_names_out, 0) }

    machine fill(
        modules: &[NormalizedModule],
        module_names_out: &mut [PointerScanModuleName],
        module_index: u64
    ) -> PointerScanResultsBuild {
        transition (module_index < modules.len && module_index < module_names_out.len) {
            true -> store(modules, module_names_out, module_index)
            _ -> (PointerScanResultsBuild::new(module_index))
        }
    }

    machine store(
        modules: &[NormalizedModule],
        module_names_out: &mut [PointerScanModuleName],
        module_index: u64
    ) -> PointerScanResultsBuild
        requires module_index < modules.len && module_index < module_names_out.len;
    {
        let module_name: &[u8] = NormalizedModule::get_module_name(&modules[module_index]);
        module_names_out[module_index] = PointerScanModuleName::new(module_name);
        transition { _ -> fill(modules, module_names_out, module_index + 1) }
    }
}

// Upstream `build_results_with_module_names`: the stored name rows are
// copied so stored module indices keep their meaning.
public machine PointerScanResultsBuilder::begin_from_module_names(
    names: &[PointerScanModuleName],
    module_names_out: &mut [PointerScanModuleName]
) -> PointerScanResultsBuild {
    transition { _ -> fill(names, module_names_out, 0) }

    machine fill(
        names: &[PointerScanModuleName],
        module_names_out: &mut [PointerScanModuleName],
        module_index: u64
    ) -> PointerScanResultsBuild {
        transition (module_index < names.len && module_index < module_names_out.len) {
            true -> store(names, module_names_out, module_index)
            _ -> (PointerScanResultsBuild::new(module_index))
        }
    }

    machine store(
        names: &[PointerScanModuleName],
        module_names_out: &mut [PointerScanModuleName],
        module_index: u64
    ) -> PointerScanResultsBuild
        requires module_index < names.len && module_index < module_names_out.len;
    {
        PointerScanModuleName::clone_from(&mut module_names_out[module_index], &names[module_index]);
        transition { _ -> fill(names, module_names_out, module_index + 1) }
    }
}

// Upstream `for (index, level) in collected_pointer_levels.iter().enumerate()`
// body: `build_level_candidates` for the static and heap arms, then
// `pointer_scan_levels.push(PointerScanLevel::new(index + 1, ...))`. The
// span row tracks the arena window for the seal.
public machine PointerScanResultsBuilder::record_level<'candidates>(
    build: PointerScanResultsBuild,
    level: &PointerScanCollectedLevel<'candidates>,
    levels_out: &mut [PointerScanLevel],
    level_spans_out: &mut [BuiltLevelSpan],
    static_candidate_arena: &mut [PointerScanCandidate],
    heap_candidate_arena: &mut [PointerScanCandidate]
) -> PointerScanResultsBuild {
    transition (build.level_count < levels_out.len && build.level_count < level_spans_out.len) {
        true -> fill_statics(build, level, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, build.next_candidate_id, 0)
        _ -> (PointerScanResultsBuild::mark_full(build))
    }

    // Static arm: `PointerScanCandidate::new(next_candidate_id, depth, Static, ...)`,
    // `next_candidate_id = next_candidate_id.saturating_add(1)`.
    machine fill_statics(
        build: PointerScanResultsBuild,
        level: &PointerScanCollectedLevel<'candidates>,
        levels_out: &mut [PointerScanLevel],
        level_spans_out: &mut [BuiltLevelSpan],
        static_candidate_arena: &mut [PointerScanCandidate],
        heap_candidate_arena: &mut [PointerScanCandidate],
        next_candidate_id: u64,
        candidate_index: u64
    ) -> PointerScanResultsBuild {
        let write_index: u64 =
            ((build.static_fill as u64 in Saturating) + (candidate_index as u64 in Saturating)) as u64;
        let static_count: u64 = PointerScanCollectedLevel::get_static_candidate_count(level);
        transition (candidate_index < static_count && write_index < static_candidate_arena.len) {
            true -> fill_static_at(build, level, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, next_candidate_id, candidate_index, write_index)
            _ -> fill_heaps(build, level, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, next_candidate_id, candidate_index, 0)
        }
    }

    machine fill_static_at(
        build: PointerScanResultsBuild,
        level: &PointerScanCollectedLevel<'candidates>,
        levels_out: &mut [PointerScanLevel],
        level_spans_out: &mut [BuiltLevelSpan],
        static_candidate_arena: &mut [PointerScanCandidate],
        heap_candidate_arena: &mut [PointerScanCandidate],
        next_candidate_id: u64,
        candidate_index: u64,
        write_index: u64
    ) -> PointerScanResultsBuild
        requires write_index < static_candidate_arena.len;
    {
        let candidate: PointerScanCollectedCandidate =
            PointerScanCollectedLevel::get_static_candidate(level, candidate_index);
        static_candidate_arena[write_index] = PointerScanCandidate::new(
            next_candidate_id,
            ((build.level_count as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            PointerScanNodeType::Static,
            candidate.pointer_address,
            candidate.pointer_value,
            candidate.module_index,
            candidate.module_offset
        );
        transition {
            _ -> fill_statics(build, level, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, ((next_candidate_id as u64 in Saturating) + (1 as u64 in Saturating)) as u64, ((candidate_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
        }
    }

    // Heap arm: `PointerScanNodeType::Heap`, module_index 0, module_offset 0.
    machine fill_heaps(
        build: PointerScanResultsBuild,
        level: &PointerScanCollectedLevel<'candidates>,
        levels_out: &mut [PointerScanLevel],
        level_spans_out: &mut [BuiltLevelSpan],
        static_candidate_arena: &mut [PointerScanCandidate],
        heap_candidate_arena: &mut [PointerScanCandidate],
        next_candidate_id: u64,
        static_written: u64,
        candidate_index: u64
    ) -> PointerScanResultsBuild {
        let write_index: u64 =
            ((build.heap_fill as u64 in Saturating) + (candidate_index as u64 in Saturating)) as u64;
        let heap_count: u64 = PointerScanCollectedLevel::get_heap_candidate_count(level);
        transition (candidate_index < heap_count && write_index < heap_candidate_arena.len) {
            true -> fill_heap_at(build, level, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, next_candidate_id, static_written, candidate_index, write_index)
            _ -> record(build, levels_out, level_spans_out, next_candidate_id, static_written, candidate_index)
        }
    }

    machine fill_heap_at(
        build: PointerScanResultsBuild,
        level: &PointerScanCollectedLevel<'candidates>,
        levels_out: &mut [PointerScanLevel],
        level_spans_out: &mut [BuiltLevelSpan],
        static_candidate_arena: &mut [PointerScanCandidate],
        heap_candidate_arena: &mut [PointerScanCandidate],
        next_candidate_id: u64,
        static_written: u64,
        candidate_index: u64,
        write_index: u64
    ) -> PointerScanResultsBuild
        requires write_index < heap_candidate_arena.len;
    {
        let candidate: PointerScanCollectedCandidate =
            PointerScanCollectedLevel::get_heap_candidate(level, candidate_index);
        heap_candidate_arena[write_index] = PointerScanCandidate::new(
            next_candidate_id,
            ((build.level_count as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            PointerScanNodeType::Heap,
            candidate.pointer_address,
            candidate.pointer_value,
            0,
            0
        );
        transition {
            _ -> fill_heaps(build, level, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, ((next_candidate_id as u64 in Saturating) + (1 as u64 in Saturating)) as u64, static_written, ((candidate_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
        }
    }

    // The row extents were checked at entry; the facts do not cross the fill
    // states, so the row store re-establishes them here.
    machine record(
        build: PointerScanResultsBuild,
        levels_out: &mut [PointerScanLevel],
        level_spans_out: &mut [BuiltLevelSpan],
        next_candidate_id: u64,
        static_written: u64,
        heap_written: u64
    ) -> PointerScanResultsBuild {
        let level_index: u64 = build.level_count;
        transition (level_index < levels_out.len && level_index < level_spans_out.len) {
            true -> record_rows(build, levels_out, level_spans_out, next_candidate_id, static_written, heap_written, level_index)
            _ -> (PointerScanResultsBuild::mark_full(build))
        }
    }

    machine record_rows(
        build: PointerScanResultsBuild,
        levels_out: &mut [PointerScanLevel],
        level_spans_out: &mut [BuiltLevelSpan],
        next_candidate_id: u64,
        static_written: u64,
        heap_written: u64,
        level_index: u64
    ) -> PointerScanResultsBuild
        requires level_index < levels_out.len && level_index < level_spans_out.len;
    {
        levels_out[level_index] = PointerScanLevel::new(
            ((level_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            ((static_written as u64 in Saturating) + (heap_written as u64 in Saturating)) as u64,
            static_written,
            heap_written
        );
        level_spans_out[level_index] = BuiltLevelSpan {
            static_offset: build.static_fill,
            static_count: static_written,
            heap_offset: build.heap_fill,
            heap_count: heap_written
        };
        (PointerScanResultsBuild {
            level_count: ((level_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            static_fill: ((build.static_fill as u64 in Saturating) + (static_written as u64 in Saturating)) as u64,
            heap_fill: ((build.heap_fill as u64 in Saturating) + (heap_written as u64 in Saturating)) as u64,
            next_candidate_id: next_candidate_id,
            module_name_count: build.module_name_count,
            total_static_node_count: ((build.total_static_node_count as u64 in Saturating) + (static_written as u64 in Saturating)) as u64,
            total_heap_node_count: ((build.total_heap_node_count as u64 in Saturating) + (heap_written as u64 in Saturating)) as u64,
            extents_full: false
        })
    }
}

// Upstream `build_results` tail: freeze the arenas into shared per-level
// windows and construct the results (`create_empty_results` when no level
// was recorded — `module_names` is `vec![]` there, so the stored name count
// drops to 0).
public machine PointerScanResultsBuilder::seal_results<'ext, 'sh, 's, 'h>(
    build: PointerScanResultsBuild,
    pointer_scan_session_id: u64,
    pointer_scan_parameters: &PointerScanParameters,
    target_descriptor: PointerScanTargetDescriptor,
    target_addresses: &'ext mut [u64],
    target_address_count: u64,
    address_space: PointerScanAddressSpace,
    module_names_out: &'ext mut [PointerScanModuleName],
    levels_out: &'sh mut [PointerScanLevel],
    level_spans: &[BuiltLevelSpan],
    level_candidates_out: &'ext mut [PointerScanLevelCandidates<'s, 'h>],
    static_candidate_arena: &'s [PointerScanCandidate],
    heap_candidate_arena: &'h [PointerScanCandidate],
    materialized_nodes: &'ext mut [PointerScanNode],
    materialized_node_id_slab: &'ext mut [u64],
    page_key_cache: &'ext mut [MaterializedPageKeyEntry]
) -> PointerScanResults<'ext, 'sh, 's, 'h> {
    transition {
        _ -> seal_level(build, pointer_scan_session_id, pointer_scan_parameters, target_descriptor, target_addresses, target_address_count, address_space, module_names_out, levels_out, level_spans, level_candidates_out, static_candidate_arena, heap_candidate_arena, materialized_nodes, materialized_node_id_slab, page_key_cache, 0)
    }

    machine seal_level(
        build: PointerScanResultsBuild,
        pointer_scan_session_id: u64,
        pointer_scan_parameters: &PointerScanParameters,
        target_descriptor: PointerScanTargetDescriptor,
        target_addresses: &'ext mut [u64],
        target_address_count: u64,
        address_space: PointerScanAddressSpace,
        module_names_out: &'ext mut [PointerScanModuleName],
        levels_out: &'sh mut [PointerScanLevel],
        level_spans: &[BuiltLevelSpan],
        level_candidates_out: &'ext mut [PointerScanLevelCandidates<'s, 'h>],
        static_candidate_arena: &'s [PointerScanCandidate],
        heap_candidate_arena: &'h [PointerScanCandidate],
        materialized_nodes: &'ext mut [PointerScanNode],
        materialized_node_id_slab: &'ext mut [u64],
        page_key_cache: &'ext mut [MaterializedPageKeyEntry],
        seal_index: u64
    ) -> PointerScanResults<'ext, 'sh, 's, 'h> {
        transition (seal_index < build.level_count && seal_index < level_spans.len) {
            true -> seal_load(build, pointer_scan_session_id, pointer_scan_parameters, target_descriptor, target_addresses, target_address_count, address_space, module_names_out, levels_out, level_spans, level_candidates_out, static_candidate_arena, heap_candidate_arena, materialized_nodes, materialized_node_id_slab, page_key_cache, seal_index)
            _ -> finish(build, pointer_scan_session_id, pointer_scan_parameters, target_descriptor, target_addresses, target_address_count, address_space, module_names_out, levels_out, level_candidates_out, materialized_nodes, materialized_node_id_slab, page_key_cache, build.level_count)
        }
    }

    machine seal_load(
        build: PointerScanResultsBuild,
        pointer_scan_session_id: u64,
        pointer_scan_parameters: &PointerScanParameters,
        target_descriptor: PointerScanTargetDescriptor,
        target_addresses: &'ext mut [u64],
        target_address_count: u64,
        address_space: PointerScanAddressSpace,
        module_names_out: &'ext mut [PointerScanModuleName],
        levels_out: &'sh mut [PointerScanLevel],
        level_spans: &[BuiltLevelSpan],
        level_candidates_out: &'ext mut [PointerScanLevelCandidates<'s, 'h>],
        static_candidate_arena: &'s [PointerScanCandidate],
        heap_candidate_arena: &'h [PointerScanCandidate],
        materialized_nodes: &'ext mut [PointerScanNode],
        materialized_node_id_slab: &'ext mut [u64],
        page_key_cache: &'ext mut [MaterializedPageKeyEntry],
        seal_index: u64
    ) -> PointerScanResults<'ext, 'sh, 's, 'h>
        requires seal_index < level_spans.len;
    {
        let span: BuiltLevelSpan = level_spans[seal_index];
        let static_end: u64 =
            ((span.static_offset as u64 in Saturating) + (span.static_count as u64 in Saturating)) as u64;
        let heap_end: u64 =
            ((span.heap_offset as u64 in Saturating) + (span.heap_count as u64 in Saturating)) as u64;
        // A span past the arenas or the candidate rows ends the seal early;
        // the level count stored below then covers only the sealed prefix.
        transition (seal_index < level_candidates_out.len && span.static_offset <= static_end && static_end <= static_candidate_arena.len && span.heap_offset <= heap_end && heap_end <= heap_candidate_arena.len) {
            true -> seal_store(build, pointer_scan_session_id, pointer_scan_parameters, target_descriptor, target_addresses, target_address_count, address_space, module_names_out, levels_out, level_spans, level_candidates_out, static_candidate_arena, heap_candidate_arena, materialized_nodes, materialized_node_id_slab, page_key_cache, seal_index, span.static_offset, static_end, span.heap_offset, heap_end)
            _ -> finish(build, pointer_scan_session_id, pointer_scan_parameters, target_descriptor, target_addresses, target_address_count, address_space, module_names_out, levels_out, level_candidates_out, materialized_nodes, materialized_node_id_slab, page_key_cache, seal_index)
        }
    }

    machine seal_store(
        build: PointerScanResultsBuild,
        pointer_scan_session_id: u64,
        pointer_scan_parameters: &PointerScanParameters,
        target_descriptor: PointerScanTargetDescriptor,
        target_addresses: &'ext mut [u64],
        target_address_count: u64,
        address_space: PointerScanAddressSpace,
        module_names_out: &'ext mut [PointerScanModuleName],
        levels_out: &'sh mut [PointerScanLevel],
        level_spans: &[BuiltLevelSpan],
        level_candidates_out: &'ext mut [PointerScanLevelCandidates<'s, 'h>],
        static_candidate_arena: &'s [PointerScanCandidate],
        heap_candidate_arena: &'h [PointerScanCandidate],
        materialized_nodes: &'ext mut [PointerScanNode],
        materialized_node_id_slab: &'ext mut [u64],
        page_key_cache: &'ext mut [MaterializedPageKeyEntry],
        seal_index: u64,
        static_offset: u64,
        static_end: u64,
        heap_offset: u64,
        heap_end: u64
    ) -> PointerScanResults<'ext, 'sh, 's, 'h>
        requires seal_index < level_candidates_out.len && static_offset <= static_end && static_end <= static_candidate_arena.len && heap_offset <= heap_end && heap_end <= heap_candidate_arena.len;
    {
        level_candidates_out[seal_index] = PointerScanLevelCandidates::new_presorted(
            ((seal_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            &static_candidate_arena[static_offset..static_end],
            static_end - static_offset,
            &heap_candidate_arena[heap_offset..heap_end],
            heap_end - heap_offset
        );
        transition {
            _ -> seal_level(build, pointer_scan_session_id, pointer_scan_parameters, target_descriptor, target_addresses, target_address_count, address_space, module_names_out, levels_out, level_spans, level_candidates_out, static_candidate_arena, heap_candidate_arena, materialized_nodes, materialized_node_id_slab, page_key_cache, seal_index + 1)
        }
    }

    machine finish(
        build: PointerScanResultsBuild,
        pointer_scan_session_id: u64,
        pointer_scan_parameters: &PointerScanParameters,
        target_descriptor: PointerScanTargetDescriptor,
        target_addresses: &'ext mut [u64],
        target_address_count: u64,
        address_space: PointerScanAddressSpace,
        module_names_out: &'ext mut [PointerScanModuleName],
        levels_out: &'sh mut [PointerScanLevel],
        level_candidates_out: &'ext mut [PointerScanLevelCandidates<'s, 'h>],
        materialized_nodes: &'ext mut [PointerScanNode],
        materialized_node_id_slab: &'ext mut [u64],
        page_key_cache: &'ext mut [MaterializedPageKeyEntry],
        level_count: u64
    ) -> PointerScanResults<'ext, 'sh, 's, 'h> {
        let effective_name_count: u64 = PointerScanResultsBuilder::effective_module_name_count(
            level_count,
            build.module_name_count
        );
        (PointerScanResults::new(
            pointer_scan_session_id,
            target_descriptor,
            target_addresses,
            target_address_count,
            address_space,
            PointerScanParameters::get_pointer_size(pointer_scan_parameters),
            PointerScanParameters::get_max_depth(pointer_scan_parameters),
            PointerScanParameters::get_offset_radius(pointer_scan_parameters),
            module_names_out,
            effective_name_count,
            &levels_out[..],
            level_count,
            level_candidates_out,
            level_count,
            build.total_static_node_count,
            build.total_heap_node_count,
            materialized_nodes,
            materialized_node_id_slab,
            page_key_cache
        ))
    }
}

// Scalar selection of the effective module-name count: zero when no level
// was recorded (upstream `create_empty_results`).
machine PointerScanResultsBuilder::effective_module_name_count(level_count: u64, module_name_count: u64) -> u64 {
    transition (level_count == 0) {
        true -> (0)
        _ -> (module_name_count)
    }
}
