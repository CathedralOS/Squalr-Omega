module src::pointer_scans::pointer_scan_executor_task;

use squalr_engine_api::src::structures::memory::normalized_module::NormalizedModule;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_address_space::PointerScanAddressSpace;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_results::PointerScanResults;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_target_descriptor::PointerScanTargetDescriptor;
use squalr_engine_api::src::structures::scanning::plans::pointer_scan::pointer_scan_parameters::PointerScanParameters;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use src::pointer_scans::pointer_scan_level_collector::PointerScanDiscoveredLevels;
use src::pointer_scans::pointer_scan_level_collector::PointerScanLevelCollector;
use src::pointer_scans::pointer_scan_results_builder::PointerScanBuiltLevels;
use src::pointer_scans::pointer_scan_results_builder::PointerScanResultsBuilder;

// Port of pointer_scan_executor_task.rs.
//
// Upstream wraps each snapshot in `Arc<RwLock<Snapshot>>`, reads both locks,
// forms `snapshots = [&*guard(..)]`, and runs the `build_session` closure —
// `discover_pointer_levels` + `build_results` — inside it. Read locks, ref
// cells, and `Arc::ptr_eq` are Rust ownership spellings; in Omega the caller
// (engine surface / recorded-snapshot provider) supplies the locked snapshot
// references as `&'a [&'a Snapshot]` — one or two entries exactly as the
// upstream slice — and owns acquisition failure. When snapshots cannot be
// acquired it calls `PointerScanResultsBuilder::create_empty_results`,
// matching upstream's lock-error branches.
//
// Upstream's `if modules.is_empty() && with_logging { debug! }` branch is
// semantics-neutral (it only logs) and rides the same deferred logging
// surface as the rest of the collector's emissions.
//
// The results' view contract forces one structural split: `built_levels`
// arrives caller-owned through `&'x mut` so `PointerScanResults<'x>` can
// borrow the driver for as long as the caller's 'x — a locally-constructed
// driver could never satisfy the returned view's binder.
pub data PointerScanExecutor {}

pub machine PointerScanExecutor::discover_pointer_levels<'a, 'b>(
    &self,
    snapshots: &'a [&'a Snapshot],
    target_addresses: &[u64],
    pointer_scan_parameters: &'b PointerScanParameters,
    modules: &[NormalizedModule],
    with_logging: bool
) -> PointerScanDiscoveredLevels<'a, 'b> {
    let level_collector: PointerScanLevelCollector = PointerScanLevelCollector {};
    level_collector.discover_pointer_levels(
        snapshots,
        target_addresses,
        pointer_scan_parameters,
        modules,
        with_logging
    )
}

// Upstream `execute_scan` -> `build_session_from_collected_values` ->
// `with_pointer_scan_snapshots` -> `build_session(snapshots)`: the closure's
// results-building half.
pub machine PointerScanExecutor::execute_scan<'x, 'a, 'c, 'd>(
    &self,
    built_levels: &'x mut PointerScanBuiltLevels<'a>,
    pointer_scan_session_id: u64,
    pointer_scan_parameters: &PointerScanParameters,
    target_descriptor: PointerScanTargetDescriptor,
    target_addresses: &'c [u64],
    address_space: PointerScanAddressSpace,
    modules: &'d [NormalizedModule],
    with_logging: bool
) -> PointerScanResults<'x, 'c, 'd> {
    let results_builder: PointerScanResultsBuilder = PointerScanResultsBuilder {};
    results_builder.build_results(
        pointer_scan_session_id,
        pointer_scan_parameters,
        target_descriptor,
        target_addresses,
        address_space,
        modules,
        built_levels,
        with_logging
    )
}
