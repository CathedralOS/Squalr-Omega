module src::pointer_scans::pointer_scan_executor_task;

use squalr_engine_api::src::structures::memory::normalized_module::NormalizedModule;
use squalr_engine_api::src::structures::memory::normalized_region;
use squalr_engine_api::src::structures::scanning::plans::pointer_scan::pointer_scan_parameters::PointerScanParameters;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_candidate::PointerScanCandidate;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_level::PointerScanLevel;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_results::PointerScanModuleName;
use squalr_engine_api::src::structures::pointer_scans::pointer_scan_results::PointerScanResults;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use src::pointer_scans::pointer_scan_level_collector::PointerScanDiscoveredLevels;
use src::pointer_scans::pointer_scan_level_collector::EmittedDiscoveredLevel;
use src::pointer_scans::pointer_scan_level_collector::PointerScanLevelCollector;
use src::pointer_scans::pointer_scan_results_builder::BuiltLevelSpan;
use src::pointer_scans::pointer_scan_results_builder::PointerScanResultsBuilder;
use src::pointer_scans::pointer_scan_results_builder::PointerScanResultsBuild;
use src::pointer_scans::structures::pointer_scan_collected_level::PointerScanCollectedLevel;
use src::pointer_scans::structures::pointer_scan_target_ranges::PointerScanTargetRangeBucket;
use src::pointer_scans::structures::snapshot_region_scan_task::SnapshotRegionScanTask;

// Port of pointer_scan_executor_task.rs.
//
// Upstream `execute_scan` takes `Arc<RwLock<Snapshot>>` pair and acquires
// read locks inside `with_pointer_scan_snapshots`, turning lock failures
// into `create_empty_results`. Arc/RwLock do not exist under the
// caller-owned-extents model: the caller holds the snapshot guard and lends
// `snapshots: &[&Snapshot]` (one element covering the shared statics+heaps
// snapshot — the `Arc::ptr_eq` branch — two for split). The upstream
// lock-failure empty-results branch collapses onto the collector's
// `Done`-at-first-pull path, which yields the same zero-count results.
//
// Upstream `execute_scan` then runs `discover_pointer_levels` and
// `build_results` in one call. Omega splits that call at the results seal:
// `collect_scan_levels` discovers the levels through the local
// `PointerScanDiscoveredLevels` pull driver and copies each one into the
// caller's candidate arenas (`PointerScanResultsBuilder::record_level`), and
// the caller seals the arenas into `PointerScanResults` with
// `PointerScanResultsBuilder::seal_results`. The split is forced by the
// checker's exact stored-reference relation: the seal installs borrowed
// arena windows into caller-owned outputs, so every call in the sealing
// machine needs an exact relation, and the kernel visitor dispatch (`dyn
// PointerScanMatchVisitor`) inside discovery has none. These two calls are
// the surface the L7 headless leg drives.
public data PointerScanExecutor {}

public machine PointerScanExecutor::collect_scan_levels<'frontier, 'tasks, 'values, 'params, 'candidates>(
    this: &PointerScanExecutor,
    snapshots: &[&Snapshot],
    pointer_scan_parameters: &'params PointerScanParameters,
    target_addresses: &[u64],
    modules: &[NormalizedModule],
    with_logging: bool,
    sorted_scratch: &'frontier mut [u64],
    target_ranges: &'frontier mut [normalized_region::NormalizedRegion],
    lower_bounds: &'frontier mut [u64],
    upper_bounds: &'frontier mut [u64],
    target_range_buckets: &'frontier mut [PointerScanTargetRangeBucket],
    tasks_scratch: &'tasks mut [SnapshotRegionScanTask],
    byte_arena: &'values mut [u8],
    module_order_scratch: &mut [u64],
    level_out: PointerScanCollectedLevel<'candidates>,
    heap_address_scratch: &mut [u64],
    module_names_out: &mut [PointerScanModuleName],
    levels_out: &mut [PointerScanLevel],
    level_spans_out: &mut [BuiltLevelSpan],
    static_candidate_arena: &mut [PointerScanCandidate],
    heap_candidate_arena: &mut [PointerScanCandidate]
) -> PointerScanResultsBuild {
    let level_collector: PointerScanLevelCollector = PointerScanLevelCollector {};
    let discovered_pointer_levels: PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params> =
        PointerScanLevelCollector::discover_pointer_levels(&level_collector, snapshots,
            target_addresses,
            pointer_scan_parameters,
            modules,
            with_logging,
            sorted_scratch,
            target_ranges,
            lower_bounds,
            upper_bounds,
            target_range_buckets,
            tasks_scratch,
            byte_arena,
            module_order_scratch);
    // Upstream takes `get_module_names()` of previous results only on the
    // validation path; discovery derives the names from the live module table.
    let build: PointerScanResultsBuild = PointerScanResultsBuilder::begin_from_modules(modules, module_names_out);
    transition {
        _ -> drain(discovered_pointer_levels, level_out, heap_address_scratch, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, build)
    }

    // Upstream `for (index, level) in collected_pointer_levels.iter().enumerate()`
    // — one `next` per iteration, recorded as it arrives. The pull driver is
    // owned by these states: the loans its kernels install land in storage this
    // machine owns, so no caller has to relate them.
    machine drain(
        mut discovered_pointer_levels: PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params>,
        mut level_out: PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        levels_out: &mut [PointerScanLevel],
        level_spans_out: &mut [BuiltLevelSpan],
        static_candidate_arena: &mut [PointerScanCandidate],
        heap_candidate_arena: &mut [PointerScanCandidate],
        build: PointerScanResultsBuild
    ) -> PointerScanResultsBuild {
        let emission: EmittedDiscoveredLevel =
            PointerScanDiscoveredLevels::next(&mut discovered_pointer_levels, &mut level_out, heap_address_scratch);
        let emitted_level: bool = EmittedDiscoveredLevel::is_level(&emission);
        transition emitted_level {
            true -> record(discovered_pointer_levels, level_out, heap_address_scratch, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, build)
            _ -> (build)
        }
    }

    machine record(
        discovered_pointer_levels: PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params>,
        level_out: PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        levels_out: &mut [PointerScanLevel],
        level_spans_out: &mut [BuiltLevelSpan],
        static_candidate_arena: &mut [PointerScanCandidate],
        heap_candidate_arena: &mut [PointerScanCandidate],
        build: PointerScanResultsBuild
    ) -> PointerScanResultsBuild {
        let recorded: PointerScanResultsBuild = PointerScanResultsBuilder::record_level(build, &level_out, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena);
        transition recorded.extents_full {
            true -> (recorded)
            _ -> drain(discovered_pointer_levels, level_out, heap_address_scratch, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, recorded)
        }
    }
}

// Upstream PointerScanLevelCollector::discover_pointer_levels call surface —
// exposed for callers that compose discovery and building themselves
// (upstream's `build_session_from_collected_values` closure boundary).
public machine PointerScanExecutor::discover_pointer_levels<'frontier, 'tasks, 'values, 'params>(
    this: &PointerScanExecutor,
    snapshots: &[&Snapshot],
    target_addresses: &[u64],
    pointer_scan_parameters: &'params PointerScanParameters,
    modules: &[NormalizedModule],
    with_logging: bool,
    sorted_scratch: &'frontier mut [u64],
    target_ranges: &'frontier mut [normalized_region::NormalizedRegion],
    lower_bounds: &'frontier mut [u64],
    upper_bounds: &'frontier mut [u64],
    target_range_buckets: &'frontier mut [PointerScanTargetRangeBucket],
    tasks_scratch: &'tasks mut [SnapshotRegionScanTask],
    byte_arena: &'values mut [u8],
    module_order_scratch: &mut [u64]
) -> PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params> {
    let level_collector: PointerScanLevelCollector = PointerScanLevelCollector {};
    let hoist2: PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params> = PointerScanLevelCollector::discover_pointer_levels(&level_collector, snapshots,
        target_addresses,
        pointer_scan_parameters,
        modules,
        with_logging,
        sorted_scratch,
        target_ranges,
        lower_bounds,
        upper_bounds,
        target_range_buckets,
        tasks_scratch,
        byte_arena,
        module_order_scratch);
    (hoist2)
}
