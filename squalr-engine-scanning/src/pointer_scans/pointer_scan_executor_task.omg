use {squalr_engine_api}/src/structures/memory/normalized_module.omg;
use {squalr_engine_api}/src/structures/memory/normalized_region.omg;
use {squalr_engine_api}/src/structures/scanning/plans/pointer_scan/pointer_scan_parameters.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_candidate.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_level.omg;
use {squalr_engine_api}/src/structures/pointer_scans/pointer_scan_results.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;
use src/pointer_scans/pointer_scan_level_collector.omg;
use src/pointer_scans/pointer_scan_results_builder.omg;
use src/pointer_scans/structures/pointer_scan_collected_level.omg;
use src/pointer_scans/structures/pointer_scan_target_ranges.omg;
use src/pointer_scans/structures/snapshot_region_scan_task.omg;

// Port of pointer_scan_executor_task.rs.
//
// Upstream `execute_scan` takes `Arc<RwLock<Snapshot>>` pair and acquires
// read locks inside `with_pointer_scan_snapshots`, turning lock failures
// into `create_empty_results`. Arc/RwLock do not exist under the
// caller-owned-extents model: the caller holds the snapshot guard and lends
// `snapshots: &[&Snapshot]` (one element covering the shared statics+heaps
// snapshot — the `Arc::ptr_eq` branch — two for split). The upstream
// lock-failure empty-results branch collapses onto the collector's
// `Done`-at-first-pull path, which yields the same zero-count results.
//
// Upstream `execute_scan` then runs `discover_pointer_levels` and
// `build_results` in one call. Omega splits that call at the results seal:
// `collect_scan_levels` discovers the levels through the local
// `PointerScanDiscoveredLevels` pull driver and copies each one into the
// caller's candidate arenas (`PointerScanResultsBuilder::record_level`), and
// the caller seals the arenas into `PointerScanResults` with
// `PointerScanResultsBuilder::seal_results`. The split is forced by the
// checker's exact stored-reference relation: the seal installs borrowed
// arena windows into caller-owned outputs, so every call in the sealing
// machine needs an exact relation, and the kernel visitor dispatch (`dyn
// PointerScanMatchVisitor`) inside discovery has none. These two calls are
// the surface the L7 headless leg drives.
public data PointerScanExecutor {}

public machine PointerScanExecutor::collect_scan_levels<'frontier, 'tasks, 'values, 'params, 'candidates>(
    this: &PointerScanExecutor,
    snapshots: &[&|snapshot|::Snapshot],
    pointer_scan_parameters: &'params |pointer_scan_parameters|::PointerScanParameters,
    target_addresses: &[u64],
    modules: &[|normalized_module|::NormalizedModule],
    with_logging: bool,
    sorted_scratch: &'frontier mut [u64],
    target_ranges: &'frontier mut [|normalized_region|::NormalizedRegion],
    lower_bounds: &'frontier mut [u64],
    upper_bounds: &'frontier mut [u64],
    target_range_buckets: &'frontier mut [|pointer_scan_target_ranges|::PointerScanTargetRangeBucket],
    tasks_scratch: &'tasks mut [|snapshot_region_scan_task|::SnapshotRegionScanTask],
    byte_arena: &'values mut [u8],
    module_order_scratch: &mut [u64],
    level_out: |pointer_scan_collected_level|::PointerScanCollectedLevel<'candidates>,
    heap_address_scratch: &mut [u64],
    module_names_out: &mut [|pointer_scan_results|::PointerScanModuleName],
    levels_out: &mut [|pointer_scan_level|::PointerScanLevel],
    level_spans_out: &mut [|pointer_scan_results_builder|::BuiltLevelSpan],
    static_candidate_arena: &mut [|pointer_scan_candidate|::PointerScanCandidate],
    heap_candidate_arena: &mut [|pointer_scan_candidate|::PointerScanCandidate]
) -> |pointer_scan_results_builder|::PointerScanResultsBuild {
    let level_collector: |pointer_scan_level_collector|::PointerScanLevelCollector = |pointer_scan_level_collector|::PointerScanLevelCollector {};
    let discovered_pointer_levels: |pointer_scan_level_collector|::PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params> =
        |pointer_scan_level_collector|::PointerScanLevelCollector::discover_pointer_levels(&level_collector, snapshots,
            target_addresses,
            pointer_scan_parameters,
            modules,
            with_logging,
            sorted_scratch,
            target_ranges,
            lower_bounds,
            upper_bounds,
            target_range_buckets,
            tasks_scratch,
            byte_arena,
            module_order_scratch);
    // Upstream takes `get_module_names()` of previous results only on the
    // validation path; discovery derives the names from the live module table.
    let build: |pointer_scan_results_builder|::PointerScanResultsBuild = |pointer_scan_results_builder|::PointerScanResultsBuilder::begin_from_modules(modules, module_names_out);
    transition {
        _ -> drain(discovered_pointer_levels, level_out, heap_address_scratch, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, build)
    }

    // Upstream `for (index, level) in collected_pointer_levels.iter().enumerate()`
    // — one `next` per iteration, recorded as it arrives. The pull driver is
    // owned by these states: the loans its kernels install land in storage this
    // machine owns, so no caller has to relate them.
    machine drain(
        mut discovered_pointer_levels: |pointer_scan_level_collector|::PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params>,
        mut level_out: |pointer_scan_collected_level|::PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        levels_out: &mut [|pointer_scan_level|::PointerScanLevel],
        level_spans_out: &mut [|pointer_scan_results_builder|::BuiltLevelSpan],
        static_candidate_arena: &mut [|pointer_scan_candidate|::PointerScanCandidate],
        heap_candidate_arena: &mut [|pointer_scan_candidate|::PointerScanCandidate],
        build: |pointer_scan_results_builder|::PointerScanResultsBuild
    ) -> |pointer_scan_results_builder|::PointerScanResultsBuild {
        let emission: |pointer_scan_level_collector|::EmittedDiscoveredLevel =
            |pointer_scan_level_collector|::PointerScanDiscoveredLevels::next(&mut discovered_pointer_levels, &mut level_out, heap_address_scratch);
        let emitted_level: bool = |pointer_scan_level_collector|::EmittedDiscoveredLevel::is_level(&emission);
        transition emitted_level {
            true -> record(discovered_pointer_levels, level_out, heap_address_scratch, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, build)
            _ -> (build)
        }
    }

    machine record(
        discovered_pointer_levels: |pointer_scan_level_collector|::PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params>,
        level_out: |pointer_scan_collected_level|::PointerScanCollectedLevel<'candidates>,
        heap_address_scratch: &mut [u64],
        levels_out: &mut [|pointer_scan_level|::PointerScanLevel],
        level_spans_out: &mut [|pointer_scan_results_builder|::BuiltLevelSpan],
        static_candidate_arena: &mut [|pointer_scan_candidate|::PointerScanCandidate],
        heap_candidate_arena: &mut [|pointer_scan_candidate|::PointerScanCandidate],
        build: |pointer_scan_results_builder|::PointerScanResultsBuild
    ) -> |pointer_scan_results_builder|::PointerScanResultsBuild {
        let recorded: |pointer_scan_results_builder|::PointerScanResultsBuild = |pointer_scan_results_builder|::PointerScanResultsBuilder::record_level(build, &level_out, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena);
        transition recorded.extents_full {
            true -> (recorded)
            _ -> drain(discovered_pointer_levels, level_out, heap_address_scratch, levels_out, level_spans_out, static_candidate_arena, heap_candidate_arena, recorded)
        }
    }
}

// Upstream PointerScanLevelCollector::discover_pointer_levels call surface —
// exposed for callers that compose discovery and building themselves
// (upstream's `build_session_from_collected_values` closure boundary).
public machine PointerScanExecutor::discover_pointer_levels<'frontier, 'tasks, 'values, 'params>(
    this: &PointerScanExecutor,
    snapshots: &[&|snapshot|::Snapshot],
    target_addresses: &[u64],
    pointer_scan_parameters: &'params |pointer_scan_parameters|::PointerScanParameters,
    modules: &[|normalized_module|::NormalizedModule],
    with_logging: bool,
    sorted_scratch: &'frontier mut [u64],
    target_ranges: &'frontier mut [|normalized_region|::NormalizedRegion],
    lower_bounds: &'frontier mut [u64],
    upper_bounds: &'frontier mut [u64],
    target_range_buckets: &'frontier mut [|pointer_scan_target_ranges|::PointerScanTargetRangeBucket],
    tasks_scratch: &'tasks mut [|snapshot_region_scan_task|::SnapshotRegionScanTask],
    byte_arena: &'values mut [u8],
    module_order_scratch: &mut [u64]
) -> |pointer_scan_level_collector|::PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params> {
    let level_collector: |pointer_scan_level_collector|::PointerScanLevelCollector = |pointer_scan_level_collector|::PointerScanLevelCollector {};
    let hoist2: |pointer_scan_level_collector|::PointerScanDiscoveredLevels<'frontier, 'tasks, 'values, 'params> = |pointer_scan_level_collector|::PointerScanLevelCollector::discover_pointer_levels(&level_collector, snapshots,
        target_addresses,
        pointer_scan_parameters,
        modules,
        with_logging,
        sorted_scratch,
        target_ranges,
        lower_bounds,
        upper_bounds,
        target_range_buckets,
        tasks_scratch,
        byte_arena,
        module_order_scratch);
    (hoist2)
}
