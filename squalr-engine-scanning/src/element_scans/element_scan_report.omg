module src::element_scans::element_scan_report;

// Port of upstream `ElementScanReport`. Upstream `scan_duration` is a
// `Duration` from `Instant::elapsed`; this pin of Omega exposes no monotonic
// clock surface, so the headless scalar path records the field as caller-
// supplied nanoseconds (deviation: 0 when the caller has no clock).

pub data ElementScanReport {
    scanned_byte_count: u64;
    processed_region_count: u64;
    result_count: u64;
    committed_deleted_result_count: u64;
    scan_duration_nanoseconds: u64;
}

pub machine ElementScanReport::new(
    scanned_byte_count: u64,
    processed_region_count: u64,
    result_count: u64,
    committed_deleted_result_count: u64,
    scan_duration_nanoseconds: u64
) -> ElementScanReport {
    ElementScanReport {
        scanned_byte_count: scanned_byte_count,
        processed_region_count: processed_region_count,
        result_count: result_count,
        committed_deleted_result_count: committed_deleted_result_count,
        scan_duration_nanoseconds: scan_duration_nanoseconds,
    }
}

pub machine ElementScanReport::get_scanned_byte_count(&self) -> u64 {
    self.scanned_byte_count
}

pub machine ElementScanReport::get_processed_region_count(&self) -> u64 {
    self.processed_region_count
}

pub machine ElementScanReport::get_result_count(&self) -> u64 {
    self.result_count
}

pub machine ElementScanReport::get_committed_deleted_result_count(&self) -> u64 {
    self.committed_deleted_result_count
}

pub machine ElementScanReport::get_scan_duration_nanoseconds(&self) -> u64 {
    self.scan_duration_nanoseconds
}
