use {omega}/language/core/float_operations.omg;
use {squalr_engine_api}/src/structures/data_types/data_type_ref.omg;
use {squalr_engine_api}/src/structures/memory/memory_alignment.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot_region.omg;
use {squalr_engine_api}/src/structures/results/snapshot_region_scan_results.omg;
use {squalr_engine_api}/src/structures/scanning/filters/snapshot_region_filter.omg;
use {squalr_engine_api}/src/structures/scanning/filters/snapshot_region_filter_collection.omg;
use {squalr_engine_api}/src/structures/scanning/plans/element_scan/element_scan_plan.omg;
use {squalr_engine_api}/src/structures/scanning/plans/element_scan/snapshot_filter_element_scan_plan.omg;
use {squalr_engine_api}/src/structures/snapshots/snapshot.omg;
use src/element_scans/element_scan_report.omg;
use src/scanners/element_scan_dispatcher.omg;
use src/scanners/scan_control.omg;

// Port of upstream `ElementScanner::scan_snapshot` (element_scanner.rs).
// Upstream fans regions out over `par_iter_mut`/`iter_mut`; the serial shape
// is the same iteration upstream takes when `is_single_thread_scan` or a
// single region is configured, which is the only form this pin executes.
//
// Storage layout (upstream owns vectors; Omega lends caller slabs — deviation
// per AGENTS.md): for R regions and D plan data types the caller supplies
// seed_filters[R*D], collection_seeds[R*D], collection_results[R*D],
// filter_out[F] — all 'r-backed so stored result views survive — plus
// scratch current_elements/previous_elements[E], driver_cell[1] and
// round_a/round_b[F]. The seed collection for region i, data type j lives at
// i*D+j: upstream's `vec![vec![Filter::new(base, size)]]` built inside
// `initialize_scan_results`. Seeds are written first so
// `initialize_scan_results` can install them; upstream's no-op when a region
// already carries results is preserved, which is what makes a reused
// snapshot's existing collections the successive-scan input.
//
// `regions` carries the snapshot's region slab through the pre-dispatch
// states so that per-region element borrows originate from a parameter
// (borrows derived from a `&mut` receiver's field cannot co-travel with that
// receiver across states in this pin); inside the dispatch loop the owned
// region clone and the scan-results view travel without `regions`, and the
// region index is re-proven against `snapshot.regions.len` when the
// stored results are installed back.

public data ElementScanner {
}

public machine ElementScanner::scan_snapshot<'a, 'p, 'r, 't, 'd, 'c>(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter]
    ) -> |element_scan_report|::ElementScanReport
crashes Abort
{
    // The deleted-index set ships with the delete command leg; until then
    // results stay append-only and the committed-deleted count is zero.
    let committed_deleted: u64 = 0;
    let total_regions: u64 = |snapshot|::Snapshot::get_region_count(&snapshot);
    let total_data_types: u64 = |element_scan_plan|::ElementScanPlan::get_data_type_ref_count(&element_scan_plan);
    transition { _ -> guard_region(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            0,
            0,
            0,
            0,
            0,
            total_regions,
            total_data_types,
            committed_deleted,
            0,
            0,
            0
        ) }

    // Upstream checks `scan_control.should_cancel()` once per region.
    machine guard_region(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> |element_scan_report|::ElementScanReport {
        let hoist1: bool = |scan_control|::ScanControl::should_cancel(&scan_control);
        transition hoist1 {
            true -> finish(snapshot, processed_region_count, committed_deleted_result_count)
            false -> bound_region(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            _ -> bound_region(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
        }
    }

    machine bound_region(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> |element_scan_report|::ElementScanReport {
        transition region_index < region_count && region_index < snapshot.region_count {
            true -> read_region(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            false -> finish(snapshot, processed_region_count, committed_deleted_result_count)
            _ -> finish(snapshot, processed_region_count, committed_deleted_result_count)
        }
    }

    // Shared element read for the seed bounds; the borrow is released
    // in-state so `snapshot` and `regions` keep flowing.
    machine read_region(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> |element_scan_report|::ElementScanReport {
        let region: |snapshot_region|::SnapshotRegion =
            |snapshot|::Snapshot::get_region(&snapshot, region_index);
        let base: u64 = |snapshot_region|::SnapshotRegion::get_base_address(&region);
        let size: u64 = |snapshot_region|::SnapshotRegion::get_region_size(&region);
        let cursor: u64 = ((region_index as u64 in Saturating)
            * (data_type_count as u64 in Saturating)) as u64;
        let refs: |snapshot_region|::DataTypeRefSet =
            |element_scan_plan|::ElementScanPlan::clone_data_type_refs(&element_scan_plan);
        transition { _ -> seed_each(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            0,
            cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            base,
            size,
            collection_count,
            refs
        ) }
    }

    // Per-data-type seeding for region `region_index` (upstream
    // `initialize_scan_results` builds one single-filter collection per
    // data type; here the backing is caller-lent at slot i*D+j).
    machine seed_each(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: |snapshot_region|::DataTypeRefSet
    ) -> |element_scan_report|::ElementScanReport {
        transition collection_index < data_type_count {
            true -> seed_bound(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                data_type_refs
            )
            false -> initialize_head(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            _ -> initialize_head(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
        }
    }

    machine seed_bound(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: |snapshot_region|::DataTypeRefSet
    ) -> |element_scan_report|::ElementScanReport {
        let slot_index: u64 = ((collection_cursor as u64 in Saturating)
            + (collection_index as u64 in Saturating)) as u64;
        let slot_end: u64 = ((slot_index as u64 in Saturating)
            + (1 as u64 in Saturating)) as u64;
        let seed_filter: |snapshot_region_filter|::SnapshotRegionFilter =
            |snapshot_region_filter|::SnapshotRegionFilter::new(seed_base, seed_size);
        transition { _ -> seed_idx_guard(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            data_type_refs,
            slot_index,
            slot_end,
            seed_filter
        ) }
    }

    // Atomic index facts decompose and propagate further than the state
    // edge — the element write and the collection-slot write both read them.
    machine seed_idx_guard(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: |snapshot_region|::DataTypeRefSet,
        slot_index: u64,
        slot_end: u64,
        seed_filter: |snapshot_region_filter|::SnapshotRegionFilter
    ) -> |element_scan_report|::ElementScanReport {
        let hoist2: u64 = |snapshot_region|::DataTypeRefSet::get_count(&data_type_refs);
        transition collection_index < hoist2
            && slot_index < seed_filters.len {
            true -> seed_elem_write(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                data_type_refs,
                slot_index,
                slot_end,
                seed_filter
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    machine seed_elem_write(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: |snapshot_region|::DataTypeRefSet,
        slot_index: u64,
        slot_end: u64,
        seed_filter: |snapshot_region_filter|::SnapshotRegionFilter
    ) -> |element_scan_report|::ElementScanReport {
        let data_type_ref: |data_type_ref|::DataTypeRef =
            |snapshot_region|::DataTypeRefSet::get(&data_type_refs, collection_index);
        seed_filters[slot_index] = seed_filter;
        let data_type_id: &[u8] = |data_type_ref|::DataTypeRef::get_data_type_id(&data_type_ref);
        let memory_alignment: |memory_alignment|::MemoryAlignment =
            |element_scan_plan|::ElementScanPlan::get_memory_alignment(&element_scan_plan);
        let fallback_unit_size: u64 = |memory_alignment|::MemoryAlignment::get_size_in_bytes(&memory_alignment);
        let unit_size: u64 = ElementScanner::unit_size_for(
            element_scan_plan,
            data_type_id,
            fallback_unit_size
        );
        transition { _ -> seed_view_guard(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            data_type_refs,
            slot_index,
            slot_end,
            data_type_id,
            memory_alignment,
            unit_size
        ) }
    }

    // The `view_filter_range` requires-conjunction is re-established after
    // the element write — mutations drop the guarded slice's facts, so the
    // exact-shape scrutinee sits immediately before its consumer.
    machine seed_view_guard(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: |snapshot_region|::DataTypeRefSet,
        slot_index: u64,
        slot_end: u64,
        data_type_id: &'t [u8],
        memory_alignment: |memory_alignment|::MemoryAlignment,
        unit_size: u64
    ) -> |element_scan_report|::ElementScanReport {
        transition slot_index <= slot_end && slot_end <= seed_filters.len {
            true -> seed_coll_idx_guard(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                data_type_refs,
                slot_index,
                slot_end,
                data_type_id,
                memory_alignment,
                unit_size
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    machine seed_coll_idx_guard(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: |snapshot_region|::DataTypeRefSet,
        slot_index: u64,
        slot_end: u64,
        data_type_id: &'t [u8],
        memory_alignment: |memory_alignment|::MemoryAlignment,
        unit_size: u64
    ) -> |element_scan_report|::ElementScanReport {
        transition slot_index < collection_seeds.len {
            true -> seed_coll_write(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                data_type_refs,
                slot_index,
                slot_end,
                data_type_id,
                memory_alignment,
                unit_size
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    machine seed_coll_write(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: |snapshot_region|::DataTypeRefSet,
        slot_index: u64,
        slot_end: u64,
        data_type_id: &'t [u8],
        memory_alignment: |memory_alignment|::MemoryAlignment,
        unit_size: u64
    ) -> |element_scan_report|::ElementScanReport {
        let seed_data_type_ref: |data_type_ref|::DataTypeRef = |data_type_ref|::DataTypeRef::new(data_type_id);
        collection_seeds[slot_index] =
            |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::from_single_filter(
                &seed_filters[slot_index],
                &seed_data_type_ref,
                memory_alignment,
                unit_size
            );
        transition { _ -> seed_each(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            ((collection_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            data_type_refs
        ) }
    }

    machine initialize_head(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> |element_scan_report|::ElementScanReport {
        let seed_end: u64 = ((collection_cursor as u64 in Saturating)
            + (data_type_count as u64 in Saturating)) as u64;
        transition { _ -> init_idx_guard(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            seed_end
        ) }
    }

    machine init_idx_guard(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        seed_end: u64
    ) -> |element_scan_report|::ElementScanReport {
        transition region_index < snapshot.region_count {
            true -> init_view_guard(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                seed_end
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    machine init_view_guard(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        seed_end: u64
    ) -> |element_scan_report|::ElementScanReport {
        transition collection_cursor <= seed_end && seed_end <= collection_seeds.len {
            true -> do_initialize(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                seed_end
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    machine do_initialize(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        seed_end: u64
    ) -> |element_scan_report|::ElementScanReport {
        // Upstream installs the freshly seeded collections through
        // `snapshot_region.initialize_scan_results`; the `&mut`-receiver /
        // borrowed-argument composition does not cross the package boundary,
        // so the snapshot-level entry performs it inside the api package.
        // The pre-written seed slab (collection_seeds[cursor..seed_end]) is
        // the external mirror of the same seeds this entry builds — kept for
        // the signature, unused by the in-package path.
        let data_type_refs: |snapshot_region|::DataTypeRefSet = |element_scan_plan|::ElementScanPlan::clone_data_type_refs(&element_scan_plan);
        let memory_alignment: |memory_alignment|::MemoryAlignment = |element_scan_plan|::ElementScanPlan::get_memory_alignment(&element_scan_plan);
        |snapshot|::Snapshot::initialize_region_scan_results(&mut snapshot, region_index,
            data_type_refs,
            memory_alignment);
        transition { _ -> dispatch_guard(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            0,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            0
        ) }
    }

    // One-hop guard so the `regions` index fact reaches the load.
    machine dispatch_guard(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> |element_scan_report|::ElementScanReport {
        transition region_index < snapshot.region_count {
            true -> dispatch_load(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    // The dispatch loop owns a region clone: element borrows of `regions`
    // cannot flow onward while `snapshot`/`regions` are forwarded, so the
    // clone — which reads the same 'a/'p/'r/'t-backed bytes as upstream's
    // &mut region — is the value that travels.
    machine dispatch_load(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> |element_scan_report|::ElementScanReport {
        let region: |snapshot_region|::SnapshotRegion =
            |snapshot|::Snapshot::get_region(&snapshot, region_index);
        let scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults =
            |snapshot_region|::SnapshotRegion::get_scan_results(&region);
        let total_collections: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_collection_count(&scan_results);
        transition { _ -> dispatch_each(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            0,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            total_collections,
            region,
            scan_results
        ) }
    }

    machine dispatch_each(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        region: |snapshot_region|::SnapshotRegion,
        scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults
    ) -> |element_scan_report|::ElementScanReport {
        transition collection_index < collection_count {
            true -> collection_bound(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                region,
                scan_results
            )
            false -> install_head(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            _ -> install_head(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
        }
    }

    machine collection_bound(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        region: |snapshot_region|::SnapshotRegion,
        scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults
    ) -> |element_scan_report|::ElementScanReport {
        let slot_index: u64 = ((collection_cursor as u64 in Saturating)
            + (collection_index as u64 in Saturating)) as u64;
        transition { _ -> fetch_collection(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            region,
            scan_results,
            slot_index
        ) }
    }

    machine fetch_collection(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        region: |snapshot_region|::SnapshotRegion,
        scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults,
        slot_index: u64
    ) -> |element_scan_report|::ElementScanReport {
        let collection: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection =
            |snapshot_region_scan_results|::SnapshotRegionScanResults::get_filter_collection(&scan_results, collection_index);
        let hoist3: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_collection_count(&scan_results);
        transition collection_index < hoist3 {
            true -> collection_idx_guard(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                region,
                &collection,
                slot_index,
                scan_results
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    // The result-slot index fact is established after the collection match —
    // guard facts must sit one state before the write that reads them.
    machine collection_idx_guard(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        region: |snapshot_region|::SnapshotRegion,
        collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        slot_index: u64,
        scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults
    ) -> |element_scan_report|::ElementScanReport {
        transition slot_index < collection_results.len
            && out_cursor <= filter_out.len {
            true -> run_dispatch(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                region,
                collection,
                slot_index,
                scan_results
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    machine run_dispatch(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        region: |snapshot_region|::SnapshotRegion,
        collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection,
        slot_index: u64,
        scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults
    ) -> |element_scan_report|::ElementScanReport {
        let data_type_ref: |data_type_ref|::DataTypeRef = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_data_type_ref(&collection);
        let data_type_id: &[u8] = |data_type_ref|::DataTypeRef::get_data_type_id(&data_type_ref);
        let result: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection =
            |element_scan_dispatcher|::ElementScanDispatcher::dispatch_scan(
                &region,
                collection,
                data_type_id,
                element_scan_plan,
                current_elements,
                previous_elements,
                driver_cell,
                filter_out,
                round_a,
                round_b,
                out_cursor
            );
        // The result is an owned collection — it can cross the store guard
        // that bounds `slot_index` for the `collection_results` write.
        let written_count: u64 = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_number_of_results(&result);
        let next_out_cursor: u64 = ((out_cursor as u64 in Saturating)
            + (written_count as u64 in Saturating)) as u64;
        let next_collection_index: u64 = ((collection_index as u64 in Saturating)
            + (1 as u64 in Saturating)) as u64;
        transition slot_index < collection_results.len {
            true -> dispatch_store(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                next_collection_index,
                collection_cursor,
                next_out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                region,
                scan_results,
                slot_index,
                result
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    machine dispatch_store(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        region: |snapshot_region|::SnapshotRegion,
        scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults,
        slot_index: u64,
        result: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection
    ) -> |element_scan_report|::ElementScanReport {
        collection_results[slot_index] = result;
        transition { _ -> dispatch_each(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            region,
            scan_results
        ) }
    }

    machine install_head(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> |element_scan_report|::ElementScanReport {
        let result_end: u64 = ((collection_cursor as u64 in Saturating)
            + (collection_count as u64 in Saturating)) as u64;
        transition { _ -> install_idx_guard(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            result_end
        ) }
    }

    machine install_idx_guard(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        result_end: u64
    ) -> |element_scan_report|::ElementScanReport {
        transition region_index < snapshot.region_count {
            true -> install_view_guard(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                result_end
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    machine install_view_guard(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        result_end: u64
    ) -> |element_scan_report|::ElementScanReport {
        transition collection_cursor <= result_end
            && result_end <= collection_results.len {
            true -> install_results(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                result_end
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    // `set_scan_results` rewrites the region's stored results to the just-
    // scanned collections and collapses the value windows (resize_to_filters).
    machine install_results(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        result_end: u64
    ) -> |element_scan_report|::ElementScanReport {
        // Upstream installs `SnapshotRegion::set_scan_results(&mut collections)` then
        // `resize_to_filters`; the `&mut`-receiver / borrowed-argument
        // composition does not cross the package boundary, so the snapshot
        // performs the staged install inside the api package — reset, push
        // each dispatched collection, resize.
        |snapshot|::Snapshot::reset_region_scan_results(&mut snapshot, region_index);
        let next_processed: u64 = ((processed_region_count as u64 in Saturating)
            + (1 as u64 in Saturating)) as u64;
        transition { _ -> install_each(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            next_processed,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            collection_cursor,
            result_end
        ) }
    }

    machine install_each(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        push_cursor: u64,
        result_end: u64
    ) -> |element_scan_report|::ElementScanReport {
        transition push_cursor < result_end && push_cursor < collection_results.len {
            true -> install_push(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                push_cursor,
                result_end
            )
            false -> install_resize(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            _ -> abort_scan()
        }
    }

    machine install_push(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        push_cursor: u64,
        result_end: u64
    ) -> |element_scan_report|::ElementScanReport {
        let collection: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection =
            |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::clone(&collection_results[push_cursor]);
        let pushed: bool = |snapshot|::Snapshot::push_region_scan_result_collection(&mut snapshot, region_index,
            collection);
        transition pushed {
            true -> install_each(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                ((push_cursor as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
                result_end
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    machine install_resize(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> |element_scan_report|::ElementScanReport {
        |snapshot|::Snapshot::resize_region_to_filters(&mut snapshot, region_index);
        transition { _ -> progress_head(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count
        ) }
    }

    // Upstream reports every 32 processed regions: `(index % 32 == 0) &&
    // total > 0`, percent = processed*100/total — the u64 percent replaces
    // the f32 progress callback (the ScanControl comment records it).
    machine progress_head(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> |element_scan_report|::ElementScanReport {
        transition (processed_region_count % 32) == 0 && region_count > 0 {
            true -> report_progress(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            false -> next_region(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            _ -> next_region(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
        }
    }

    machine report_progress(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> |element_scan_report|::ElementScanReport {
        let progress_percent: f32 =
            (|float_operations|::F32::from_u64(processed_region_count) / |float_operations|::F32::from_u64(region_count)) * 100.0;
        |scan_control|::ScanControl::report_progress(&mut scan_control, progress_percent);
        transition { _ -> next_region(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count
        ) }
    }

    machine next_region(
        snapshot: &mut |snapshot|::Snapshot,
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        scan_control: &mut |scan_control|::ScanControl,
        seed_filters: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        collection_seeds: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        collection_results: &'r mut [|snapshot_region_filter_collection|::SnapshotRegionFilterCollection],
        filter_out: &'r mut [|snapshot_region_filter|::SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [|element_scan_dispatcher|::ScalarRegionScan],
        round_a: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        round_b: &mut [|snapshot_region_filter|::SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> |element_scan_report|::ElementScanReport {
        transition { _ -> guard_region(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            ((region_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            0,
            0,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            0,
            0,
            0
        ) }
    }

    // Upstream order: `discard_empty_regions` runs before the report
    // fields are read, so byte/result counts see the compacted snapshot.
    machine finish(
        snapshot: &mut |snapshot|::Snapshot,
        processed_region_count: u64,
        committed_deleted_result_count: u64
    ) -> |element_scan_report|::ElementScanReport {
        |snapshot|::Snapshot::discard_empty_regions(&mut snapshot);
        let scanned_byte_count: u64 = |snapshot|::Snapshot::get_collected_byte_count(&snapshot);
        let result_count: u64 = |snapshot|::Snapshot::get_number_of_results(&snapshot);
        |element_scan_report|::ElementScanReport::new(
            scanned_byte_count,
            processed_region_count,
            result_count,
            committed_deleted_result_count,
            0
        )
    }

    machine abort_scan() -> |element_scan_report|::ElementScanReport {
        crash Abort;
    }
}

// Seed unit size: upstream resolves `symbol_registry.get_unit_size_in_bytes`
// (the data type's element width); the finalized unit rides the plan entry,
// so the first plan supplies it here. A data type with no plans yields an
// inert seed collection — dispatch drops unconstrained input filters
// upstream — and the alignment is the fallback (deviation: registry-less
// equivalent of "unit size unknown").
public machine ElementScanner::unit_size_for<'t, 'c>(
    element_scan_plan: &|element_scan_plan|::ElementScanPlan,
    data_type_id: &[u8],
    fallback_size: u64
) -> u64
crashes Abort
{
    let data_type_ref: |data_type_ref|::DataTypeRef = |data_type_ref|::DataTypeRef::new(data_type_id);
    let plan_list: |element_scan_plan|::TypePlanList = |element_scan_plan|::ElementScanPlan::get_plan_list_for(&element_scan_plan, &data_type_ref);
    let constraint_count: u64 = |element_scan_plan|::TypePlanList::get_plan_count(&plan_list);
    transition constraint_count > 0 {
        true -> first_match(element_scan_plan, data_type_id)
        false -> (fallback_size)
        _ -> (fallback_size)
    }

    machine first_match(
        element_scan_plan: &|element_scan_plan|::ElementScanPlan,
        data_type_id: &[u8]
    ) -> u64 {
        let data_type_ref: |data_type_ref|::DataTypeRef = |data_type_ref|::DataTypeRef::new(data_type_id);
        let plan_list: |element_scan_plan|::TypePlanList = |element_scan_plan|::ElementScanPlan::get_plan_list_for(&element_scan_plan, &data_type_ref);
        let plan: |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan = |element_scan_plan|::TypePlanList::get_plan(&plan_list, 0);
        let hoist4: u64 = |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_unit_size_in_bytes(&plan);
        (hoist4)
    }
}
