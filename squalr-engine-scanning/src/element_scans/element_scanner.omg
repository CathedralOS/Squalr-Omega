module src::element_scans::element_scanner;

use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::results::snapshot_region_scan_results::CollectionRef;
use squalr_engine_api::src::structures::results::snapshot_region_scan_results::SnapshotRegionScanResults;
use squalr_engine_api::src::structures::scanning::constraints::scan_constraint_finalized::ScanConstraintFinalized;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter_collection::SnapshotRegionFilterCollection;
use squalr_engine_api::src::structures::scanning::plans::element_scan::element_scan_plan::ElementScanPlan;
use squalr_engine_api::src::structures::snapshots::snapshot::Snapshot;
use squalr_engine_api::src::structures::snapshots::snapshot_region::SnapshotRegion;
use src::element_scans::element_scan_report::ElementScanReport;
use src::scanners::element_scan_dispatcher::ElementScanDispatcher;
use src::scanners::element_scan_dispatcher::ScalarRegionScan;
use src::scanners::scan_control::ScanControl;

// Port of upstream `ElementScanner::scan_snapshot` (element_scanner.rs).
// Upstream fans regions out over `par_iter_mut`/`iter_mut`; the serial shape
// is the same iteration upstream takes when `is_single_thread_scan` or a
// single region is configured, which is the only form this pin executes.
//
// Storage layout (upstream owns vectors; Omega lends caller slabs — deviation
// per AGENTS.md): for R regions and D plan data types the caller supplies
// seed_filters[R*D], collection_seeds[R*D], collection_results[R*D],
// filter_out[F] — all 'r-backed so stored result views survive — plus
// scratch current_elements/previous_elements[E], driver_cell[1] and
// round_a/round_b[F]. The seed collection for region i, data type j lives at
// i*D+j: upstream's `vec![vec![Filter::new(base, size)]]` built inside
// `initialize_scan_results`. Seeds are written first so
// `initialize_scan_results` can install them; upstream's no-op when a region
// already carries results is preserved, which is what makes a reused
// snapshot's existing collections the successive-scan input.
//
// `regions` carries the snapshot's region slab through the pre-dispatch
// states so that per-region element borrows originate from a parameter
// (borrows derived from a `&mut` receiver's field cannot co-travel with that
// receiver across states in this pin); inside the dispatch loop the owned
// region clone and the scan-results view travel without `regions`, and the
// region index is re-proven against `snapshot.snapshot_regions.len` when the
// stored results are installed back.

pub data ElementScanner {
}

pub machine ElementScanner::scan_snapshot<'a, 'p, 'r, 't, 'd, 'c>(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter]
    ) -> ElementScanReport
crashes Abort
{
    let committed_deleted: u64 =
        snapshot.commit_deleted_scan_result_indices();
    let total_regions: u64 = snapshot.get_region_count();
    let total_data_types: u64 = element_scan_plan.get_data_type_refs().len;
    transition { _ -> guard_region(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            0,
            0,
            0,
            0,
            0,
            total_regions,
            total_data_types,
            committed_deleted,
            0,
            0,
            0
        ) }

    // Upstream checks `scan_control.should_cancel()` once per region.
    state guard_region(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> ElementScanReport {
        transition scan_control.should_cancel() {
            true -> finish(snapshot, processed_region_count, committed_deleted_result_count)
            false -> bound_region(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                snapshot.snapshot_regions,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            _ -> bound_region(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                snapshot.snapshot_regions,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
        }
    }

    state bound_region(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> ElementScanReport {
        transition region_index < region_count && region_index < regions.len {
            true -> read_region(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                snapshot.snapshot_regions,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            false -> finish(snapshot, processed_region_count, committed_deleted_result_count)
            _ -> finish(snapshot, processed_region_count, committed_deleted_result_count)
        }
    }

    // Shared element read for the seed bounds; the borrow is released
    // in-state so `snapshot` and `regions` keep flowing.
    state read_region(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> ElementScanReport {
        let region_ref: &SnapshotRegion<'a, 'p, 'r, 't> =
            Snapshot::get_regions(regions, region_index);
        let base: u64 = region_ref.get_base_address();
        let size: u64 = region_ref.get_region_size();
        let cursor: u64 = ((region_index as u64 in Saturating)
            * (data_type_count as u64 in Saturating)) as u64;
        let refs: &'t [DataTypeRef<'t>] =
            element_scan_plan.get_data_type_refs();
        transition { _ -> seed_each(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            regions,
            region_index,
            0,
            cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            base,
            size,
            collection_count,
            refs
        ) }
    }

    // Per-data-type seeding for region `region_index` (upstream
    // `initialize_scan_results` builds one single-filter collection per
    // data type; here the backing is caller-lent at slot i*D+j).
    state seed_each(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: &'t [DataTypeRef<'t>]
    ) -> ElementScanReport {
        transition collection_index < data_type_count {
            true -> seed_bound(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                snapshot.snapshot_regions,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                data_type_refs
            )
            false -> initialize_head(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                snapshot.snapshot_regions,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            _ -> initialize_head(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                snapshot.snapshot_regions,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
        }
    }

    state seed_bound(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: &'t [DataTypeRef<'t>]
    ) -> ElementScanReport {
        let slot_index: u64 = ((collection_cursor as u64 in Saturating)
            + (collection_index as u64 in Saturating)) as u64;
        let slot_end: u64 = ((slot_index as u64 in Saturating)
            + (1 as u64 in Saturating)) as u64;
        let seed_filter: SnapshotRegionFilter =
            SnapshotRegionFilter::new(seed_base, seed_size);
        transition { _ -> seed_idx_guard(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            regions,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            data_type_refs,
            slot_index,
            slot_end,
            seed_filter
        ) }
    }

    // Atomic index facts decompose and propagate further than the state
    // edge — the element write and the collection-slot write both read them.
    state seed_idx_guard(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: &'t [DataTypeRef<'t>],
        slot_index: u64,
        slot_end: u64,
        seed_filter: SnapshotRegionFilter
    ) -> ElementScanReport {
        transition collection_index < data_type_refs.len
            && slot_index < seed_filters.len {
            true -> seed_elem_write(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                snapshot.snapshot_regions,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                data_type_refs,
                slot_index,
                slot_end,
                seed_filter
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    state seed_elem_write(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: &'t [DataTypeRef<'t>],
        slot_index: u64,
        slot_end: u64,
        seed_filter: SnapshotRegionFilter
    ) -> ElementScanReport {
        let data_type_ref: &'t DataTypeRef<'t> =
            &data_type_refs[collection_index];
        seed_filters[slot_index] = seed_filter;
        let data_type_id: &'t [u8] = data_type_ref.get_data_type_id();
        let memory_alignment: MemoryAlignment =
            element_scan_plan.get_memory_alignment();
        let fallback_unit_size: u64 = memory_alignment.get_size_in_bytes();
        let unit_size: u64 = ElementScanner::unit_size_for(
            element_scan_plan,
            data_type_id,
            fallback_unit_size
        );
        transition { _ -> seed_view_guard(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            regions,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            data_type_refs,
            slot_index,
            slot_end,
            data_type_id,
            memory_alignment,
            unit_size
        ) }
    }

    // The `view_filter_range` requires-conjunction is re-established after
    // the element write — mutations drop the guarded slice's facts, so the
    // exact-shape scrutinee sits immediately before its consumer.
    state seed_view_guard(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: &'t [DataTypeRef<'t>],
        slot_index: u64,
        slot_end: u64,
        data_type_id: &'t [u8],
        memory_alignment: MemoryAlignment,
        unit_size: u64
    ) -> ElementScanReport {
        transition slot_index <= slot_end && slot_end <= seed_filters.len {
            true -> seed_coll_idx_guard(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                snapshot.snapshot_regions,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                data_type_refs,
                slot_index,
                slot_end,
                data_type_id,
                memory_alignment,
                unit_size
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    state seed_coll_idx_guard(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: &'t [DataTypeRef<'t>],
        slot_index: u64,
        slot_end: u64,
        data_type_id: &'t [u8],
        memory_alignment: MemoryAlignment,
        unit_size: u64
    ) -> ElementScanReport {
        transition slot_index < collection_seeds.len {
            true -> seed_coll_write(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                snapshot.snapshot_regions,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                data_type_refs,
                slot_index,
                slot_end,
                data_type_id,
                memory_alignment,
                unit_size
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    state seed_coll_write(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        data_type_refs: &'t [DataTypeRef<'t>],
        slot_index: u64,
        slot_end: u64,
        data_type_id: &'t [u8],
        memory_alignment: MemoryAlignment,
        unit_size: u64
    ) -> ElementScanReport {
        let seed_filter_view: &'r [SnapshotRegionFilter] =
            ElementScanDispatcher::view_filter_range(
                seed_filters,
                slot_index,
                slot_end
            );
        let seed_data_type_ref: DataTypeRef<'t> = DataTypeRef::new(data_type_id);
        collection_seeds[slot_index] = SnapshotRegionFilterCollection::new(
            seed_filter_view,
            seed_data_type_ref,
            memory_alignment,
            unit_size
        );
        transition { _ -> seed_each(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            regions,
            region_index,
            ((collection_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            data_type_refs
        ) }
    }

    state initialize_head(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> ElementScanReport {
        let seed_end: u64 = ((collection_cursor as u64 in Saturating)
            + (data_type_count as u64 in Saturating)) as u64;
        transition { _ -> init_idx_guard(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            regions,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            seed_end
        ) }
    }

    state init_idx_guard(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        seed_end: u64
    ) -> ElementScanReport {
        transition region_index < regions.len {
            true -> init_view_guard(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                snapshot.snapshot_regions,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                seed_end
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    state init_view_guard(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        seed_end: u64
    ) -> ElementScanReport {
        transition collection_cursor <= seed_end && seed_end <= collection_seeds.len {
            true -> do_initialize(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                snapshot.snapshot_regions,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                seed_end
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    state do_initialize(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        seed_end: u64
    ) -> ElementScanReport {
        let seed_view: &'r [SnapshotRegionFilterCollection<'r, 't>] =
            ElementScanDispatcher::view_collection_range(
                collection_seeds,
                collection_cursor,
                seed_end
            );
        let seeded: SnapshotRegionScanResults<'r, 't> =
            SnapshotRegionScanResults::new(seed_view);
        let region_mut: &mut SnapshotRegion<'a, 'p, 'r, 't> =
            Snapshot::get_region(regions, region_index);
        SnapshotRegion::initialize_scan_results(region_mut, seeded);
        transition { _ -> dispatch_guard(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            regions,
            region_index,
            0,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            0
        ) }
    }

    // One-hop guard so the `regions` index fact reaches the load.
    state dispatch_guard(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> ElementScanReport {
        transition region_index < regions.len {
            true -> dispatch_load(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                snapshot.snapshot_regions,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    // The dispatch loop owns a region clone: element borrows of `regions`
    // cannot flow onward while `snapshot`/`regions` are forwarded, so the
    // clone — which reads the same 'a/'p/'r/'t-backed bytes as upstream's
    // &mut region — is the value that travels.
    state dispatch_load(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        regions: &'a mut [SnapshotRegion<'a, 'p, 'r, 't>],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> ElementScanReport {
        let region_ref: &SnapshotRegion<'a, 'p, 'r, 't> =
            Snapshot::get_regions(regions, region_index);
        let region: SnapshotRegion<'a, 'p, 'r, 't> = region_ref.clone_region();
        let scan_results: SnapshotRegionScanResults<'r, 't> =
            region.get_scan_results();
        let total_collections: u64 = scan_results.get_collection_count();
        transition { _ -> dispatch_each(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            0,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            total_collections,
            region,
            scan_results
        ) }
    }

    state dispatch_each(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        region: SnapshotRegion<'a, 'p, 'r, 't>,
        scan_results: SnapshotRegionScanResults<'r, 't>
    ) -> ElementScanReport {
        transition collection_index < collection_count {
            true -> collection_bound(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                region,
                scan_results
            )
            false -> install_head(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            _ -> install_head(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
        }
    }

    state collection_bound(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        region: SnapshotRegion<'a, 'p, 'r, 't>,
        scan_results: SnapshotRegionScanResults<'r, 't>
    ) -> ElementScanReport {
        let slot_index: u64 = ((collection_cursor as u64 in Saturating)
            + (collection_index as u64 in Saturating)) as u64;
        transition { _ -> fetch_collection(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            region,
            scan_results,
            slot_index
        ) }
    }

    state fetch_collection(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        region: SnapshotRegion<'a, 'p, 'r, 't>,
        scan_results: SnapshotRegionScanResults<'r, 't>,
        slot_index: u64
    ) -> ElementScanReport {
        transition scan_results.get_collection(collection_index) {
            CollectionRef::Found { collection } -> collection_idx_guard(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                region,
                collection,
                slot_index,
                scan_results
            )
            CollectionRef::Missing -> abort_scan()
            _ -> abort_scan()
        }
    }

    // The result-slot index fact is established after the collection match —
    // guard facts must sit one state before the write that reads them.
    state collection_idx_guard(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        region: SnapshotRegion<'a, 'p, 'r, 't>,
        collection: &SnapshotRegionFilterCollection<'r, 't>,
        slot_index: u64,
        scan_results: SnapshotRegionScanResults<'r, 't>
    ) -> ElementScanReport {
        transition slot_index < collection_results.len
            && out_cursor <= filter_out.len {
            true -> run_dispatch(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                region,
                collection,
                slot_index,
                scan_results
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    state run_dispatch(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        region: SnapshotRegion<'a, 'p, 'r, 't>,
        collection: &SnapshotRegionFilterCollection<'r, 't>,
        slot_index: u64,
        scan_results: SnapshotRegionScanResults<'r, 't>
    ) -> ElementScanReport {
        let data_type_ref: DataTypeRef<'t> = collection.get_data_type_ref();
        let data_type_id: &'t [u8] = data_type_ref.get_data_type_id();
        let result: SnapshotRegionFilterCollection<'r, 't> =
            ElementScanDispatcher::dispatch_scan(
                &region,
                collection,
                data_type_id,
                element_scan_plan,
                current_elements,
                previous_elements,
                driver_cell,
                filter_out,
                round_a,
                round_b,
                out_cursor
            );
        // The result borrows `filter_out` ('r) and must be consumed here —
        // forwarding it onward while `filter_out` is passed mut conflicts.
        // `number_of_results` is a stored scalar — a machine call on the
        // 'r-bound `result` drops the outstanding 'r index facts in this pin.
        let written_count: u64 = result.number_of_results;
        collection_results[slot_index] = result;
        let next_out_cursor: u64 = ((out_cursor as u64 in Saturating)
            + (written_count as u64 in Saturating)) as u64;
        let next_collection_index: u64 = ((collection_index as u64 in Saturating)
            + (1 as u64 in Saturating)) as u64;
        transition { _ -> dispatch_each(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            next_collection_index,
            collection_cursor,
            next_out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            region,
            scan_results
        ) }
    }

    state install_head(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> ElementScanReport {
        let result_end: u64 = ((collection_cursor as u64 in Saturating)
            + (collection_count as u64 in Saturating)) as u64;
        transition { _ -> install_idx_guard(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count,
            result_end
        ) }
    }

    state install_idx_guard(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        result_end: u64
    ) -> ElementScanReport {
        transition region_index < snapshot.snapshot_regions.len {
            true -> install_view_guard(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                result_end
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    state install_view_guard(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        result_end: u64
    ) -> ElementScanReport {
        transition collection_cursor <= result_end
            && result_end <= collection_results.len {
            true -> install_results(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count,
                result_end
            )
            false -> abort_scan()
            _ -> abort_scan()
        }
    }

    // `set_scan_results` rewrites the region's stored results to the just-
    // scanned collections and collapses the value windows (resize_to_filters).
    state install_results(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64,
        result_end: u64
    ) -> ElementScanReport {
        let result_view: &'r [SnapshotRegionFilterCollection<'r, 't>] =
            ElementScanDispatcher::view_collection_range(
                collection_results,
                collection_cursor,
                result_end
            );
        let scan_results: SnapshotRegionScanResults<'r, 't> =
            SnapshotRegionScanResults::new(result_view);
        let region_mut: &mut SnapshotRegion<'a, 'p, 'r, 't> =
            Snapshot::get_region(snapshot.snapshot_regions, region_index);
        SnapshotRegion::set_scan_results(region_mut, scan_results);
        let next_processed: u64 = ((processed_region_count as u64 in Saturating)
            + (1 as u64 in Saturating)) as u64;
        transition { _ -> progress_head(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            next_processed,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count
        ) }
    }

    // Upstream reports every 32 processed regions: `(index % 32 == 0) &&
    // total > 0`, percent = processed*100/total — the u64 percent replaces
    // the f32 progress callback (the ScanControl comment records it).
    state progress_head(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> ElementScanReport {
        transition (processed_region_count % 32) == 0 && region_count > 0 {
            true -> report_progress(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            false -> next_region(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
            _ -> next_region(
                snapshot,
                element_scan_plan,
                scan_control,
                seed_filters,
                collection_seeds,
                collection_results,
                filter_out,
                current_elements,
                previous_elements,
                driver_cell,
                round_a,
                round_b,
                region_index,
                collection_index,
                collection_cursor,
                out_cursor,
                processed_region_count,
                region_count,
                data_type_count,
                committed_deleted_result_count,
                seed_base,
                seed_size,
                collection_count
            )
        }
    }

    state report_progress(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> ElementScanReport {
        let scaled_count: u64 = ((processed_region_count as u64 in Saturating)
            * (100 as u64 in Saturating)) as u64;
        let progress_percent: u64 = scaled_count / region_count;
        scan_control.report_progress(progress_percent);
        transition { _ -> next_region(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            region_index,
            collection_index,
            collection_cursor,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            seed_base,
            seed_size,
            collection_count
        ) }
    }

    state next_region(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        scan_control: &mut ScanControl,
        seed_filters: &'r mut [SnapshotRegionFilter],
        collection_seeds: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        collection_results: &'r mut [SnapshotRegionFilterCollection<'r, 't>],
        filter_out: &'r mut [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        region_index: u64,
        collection_index: u64,
        collection_cursor: u64,
        out_cursor: u64,
        processed_region_count: u64,
        region_count: u64,
        data_type_count: u64,
        committed_deleted_result_count: u64,
        seed_base: u64,
        seed_size: u64,
        collection_count: u64
    ) -> ElementScanReport {
        transition { _ -> guard_region(
            snapshot,
            element_scan_plan,
            scan_control,
            seed_filters,
            collection_seeds,
            collection_results,
            filter_out,
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            round_b,
            ((region_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            0,
            0,
            out_cursor,
            processed_region_count,
            region_count,
            data_type_count,
            committed_deleted_result_count,
            0,
            0,
            0
        ) }
    }

    // Upstream order: `discard_empty_regions` runs before the report
    // fields are read, so byte/result counts see the compacted snapshot.
    state finish(
        snapshot: &mut Snapshot<'a, 'p, 'r, 't, 'd>,
        processed_region_count: u64,
        committed_deleted_result_count: u64
    ) -> ElementScanReport {
        Snapshot::discard_empty_regions(snapshot);
        let scanned_byte_count: u64 = snapshot.get_byte_count();
        let result_count: u64 = snapshot.get_number_of_results();
        ElementScanReport::new(
            scanned_byte_count,
            processed_region_count,
            result_count,
            committed_deleted_result_count,
            0
        )
    }

    state abort_scan() -> ElementScanReport {
        crash Abort;
    }
}

// Seed unit size: upstream resolves `symbol_registry.get_unit_size_in_bytes`
// (the data type's element width); each finalized constraint already carries
// it, so the first matching constraint supplies it here. A data type with no
// constraints yields an inert seed collection — dispatch drops unconstrained
// input filters upstream — and the alignment is the fallback (deviation:
// registry-less equivalent of "unit size unknown").
pub machine ElementScanner::unit_size_for<'t, 'c>(
    element_scan_plan: &ElementScanPlan<'t, 'c>,
    data_type_id: &[u8],
    fallback_size: u64
) -> u64
crashes Abort
{
    let constraint_count: u64 =
        element_scan_plan.count_constraints_for(data_type_id);
    transition constraint_count > 0 {
        true -> first_match(element_scan_plan, data_type_id)
        false -> (fallback_size)
        _ -> (fallback_size)
    }

    state first_match(
        element_scan_plan: &ElementScanPlan<'t, 'c>,
        data_type_id: &[u8]
    ) -> u64 {
        let constraint_index: u64 =
            element_scan_plan.constraint_index_for(data_type_id, 0);
        let constraint: ScanConstraintFinalized<'c> =
            element_scan_plan.get_constraint(constraint_index);
        constraint.get_unit_size_in_bytes()
    }
}
