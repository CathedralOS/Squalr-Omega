module src::scanners::scan_control;

// Port of upstream `ScanControl` ({cancellation_token: Option<Arc<AtomicBool>>,
// progress_reporter: Option<Arc<dyn Fn(f32)>>}). Omega has no shared
// atomics/closures in the scalar leg: cancellation is a plain flag a caller
// flips between scans, and progress is retained as the last reported integer
// percent for the caller to poll rather than pushed through a callback.

pub data ScanControl {
    cancellation_requested: bool;
    last_progress_percent: u64;
}

pub machine ScanControl::new() -> ScanControl {
    ScanControl {
        cancellation_requested: false,
        last_progress_percent: 0,
    }
}

// Upstream `should_cancel`.
pub machine ScanControl::should_cancel(&self) -> bool {
    self.cancellation_requested
}

// The AtomicBool's `store(true)` surface for the borrowed-flag model.
pub machine ScanControl::set_cancellation_requested(
    &mut self,
    cancellation_requested: bool
) {
    self.cancellation_requested = cancellation_requested;
}

// Upstream `report_progress` — retains the last percent for caller polling
// instead of invoking a reporter callback (u64 percent rather than f32).
pub machine ScanControl::report_progress(&mut self, progress_percent: u64) {
    self.last_progress_percent = progress_percent;
}

pub machine ScanControl::get_last_progress_percent(&self) -> u64 {
    self.last_progress_percent
}
