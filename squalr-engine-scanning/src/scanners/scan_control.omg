module src::scanners::scan_control;

// Port of scanners/scan_control.rs.
//
// Upstream carries `cancellation_token: Option<Arc<AtomicBool>>` plus a
// `progress_reporter: Option<Arc<dyn Fn(f32) + Send + Sync>>` — shared
// atomics and stored closures have no Omega counterpart (named deviation):
// the port keeps cancellation as a plain flag the caller sets and omits the
// progress reporter. Callers that never cancel use `ScanControl::default`.
pub data ScanControl {
    cancellation_requested: bool;
}

// Upstream `ScanControl::new(cancellation_token, progress_reporter)`.
pub machine ScanControl::new(
    cancellation_requested: bool
) -> ScanControl {
    ScanControl {
        cancellation_requested: cancellation_requested
    }
}

// Upstream `ScanControl::default` (no token, never cancels).
pub machine ScanControl::default() -> ScanControl {
    ScanControl {
        cancellation_requested: false
    }
}

// Upstream `should_cancel` — the token load SeqCst read.
pub machine ScanControl::should_cancel(&self) -> bool {
    self.cancellation_requested
}
