module src::scanners::scan_control;

// Port of ScanControl. Upstream shares an Arc<AtomicBool> cancellation token
// and an Arc<dyn Fn(f32)> progress callback; Omega has no shared closures or
// atomic cells, so the driver owns the control value outright: cancellation is
// a flag the caller sets between region dispatches, and progress reports land
// in a stored field the caller may read between calls. Semantics are
// identical at the scan loop: should_cancel is consulted per region and
// report_progress fires every 32 processed regions.
pub data ScanControl {
    cancel_requested: bool;
    last_reported_progress_percent: u64;
}

pub machine ScanControl::new(cancel_requested: bool) -> ScanControl {
    (ScanControl {
        cancel_requested: cancel_requested,
        last_reported_progress_percent: 0,
    })
}

pub machine ScanControl::should_cancel(&self) -> bool {
    (self.cancel_requested)
}

pub machine ScanControl::request_cancel(&mut self) {
    self.cancel_requested = true;
}

// Upstream takes f32; fixed-point whole-percent reporting is sufficient for
// the CLI surface and keeps the report value exact.
pub machine ScanControl::report_progress(&mut self, progress_percent: u64) {
    self.last_reported_progress_percent = progress_percent;
}

pub machine ScanControl::get_last_reported_progress_percent(&self) -> u64 {
    (self.last_reported_progress_percent)
}
