module src::scanners::scan_control;

// Port of scanners/scan_control.rs.
//
// Upstream carries `cancellation_token: Option<Arc<AtomicBool>>` plus a
// `progress_reporter: Option<Arc<dyn Fn(f32) + Send + Sync>>` — shared
// atomics and stored closures have no Omega counterpart (named deviation):
// the port keeps cancellation as a plain flag the caller sets and replaces
// the optional reporter with the last reported value recorded on the
// control object, which is the observable surface both callers and tests
// read. Callers that never cancel use `ScanControl::default`.
pub data ScanControl {
    cancellation_requested: bool;
    last_reported_progress: f32;
    debug_mismatch_count: u64;
}

// Upstream `ScanControl::new(cancellation_token, progress_reporter)`.
pub machine ScanControl::new(
    cancellation_requested: bool
) -> ScanControl {
    ScanControl {
        cancellation_requested: cancellation_requested,
        last_reported_progress: 0.0,
        debug_mismatch_count: 0
    }
}

// Upstream `ScanControl::default` (no token, never cancels).
pub machine ScanControl::default() -> ScanControl {
    ScanControl {
        cancellation_requested: false,
        last_reported_progress: 0.0,
        debug_mismatch_count: 0
    }
}

// Upstream `should_cancel` — the token load SeqCst read.
pub machine ScanControl::should_cancel(scan_control: &ScanControl) -> bool {
    scan_control.cancellation_requested
}

// The owned-model equivalent of the AtomicBool store upstream's caller
// performs on the shared token — the single write surface a driver, CLI
// interrupt handler, or task supervisor uses to request cancellation.
pub machine ScanControl::set_cancellation_requested(
    scan_control: &mut ScanControl,
    requested: bool
) {
    scan_control.cancellation_requested = requested;
}

// Upstream `report_progress` — upstream invokes the optional reporter
// closure; the port records the value on the control object since stored
// closures have no Omega counterpart. Same call sites, same timing.
pub machine ScanControl::report_progress(
    scan_control: &mut ScanControl,
    progress: f32
) {
    scan_control.last_reported_progress = progress;
}

// Companion to `report_progress`: the recorded value the caller reads.
pub machine ScanControl::get_last_reported_progress(scan_control: &ScanControl) -> f32 {
    scan_control.last_reported_progress
}

// Upstream `perform_debug_scan` reports each validation disagreement with
// `log::error!`; the engine has no log sink, so the owned-model carrier
// counts them here — callers read `get_debug_mismatch_count` after the
// scan, the observable surface the log lines served.
pub machine ScanControl::note_debug_mismatch(scan_control: &mut ScanControl) {
    scan_control.debug_mismatch_count = ((scan_control.debug_mismatch_count as u64 in Wrapping)
        + (1 as u64 in Wrapping)) as u64;
}

pub machine ScanControl::get_debug_mismatch_count(scan_control: &ScanControl) -> u64 {
    scan_control.debug_mismatch_count
}
