module src::scanners::vector::scanner_vector_overlapping_bytewise_staggered;

use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use squalr_engine_api::src::structures::scanning::comparisons::scan_compare_type_immediate::ScanCompareTypeImmediate;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_api::src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use squalr_engine_api::src::structures::scanning::plans::plan_types::planned_scan_vectorization_size::PlannedScanVectorizationSize;
use src::scanners::snapshot_scanner::Scanner;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::EmittedRegion;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::SnapshotRegionFilterRunLengthEncoder;

// Port of ScannerVectorOverlappingBytewiseStaggered — unreachable upstream
// (the dispatcher's dedicated arm is commented out; the plan kind routes to
// ScannerVectorOverlapping), ported faithfully as a working scanner anyway:
// upstream still compiles and ships the body.
//
// Upstream walks BYTE lanes (the "JIRA: Memory alignment!" quirk — vector
// candidates step 1 byte regardless of the scan's memory alignment): each
// group covers `vector_compare_size = N - data_type_size` consecutive byte
// candidate positions, and lane l matches when the `data_type_size` bytes
// starting at the lane's position equal the pattern (AND of per-byte
// compares, upstream's rotate-and-AND fold; NotEqual ANDs per-byte
// not-equal compares — upstream literally implements "every pattern byte
// differs", not "the element differs"). The pointer advances
// `vector_compare_size` per group, `vectorizable_iterations` groups total,
// then upstream falls back to the scalar compare at
// element_index * alignment for the leftover element candidates.
//
// On the byte-window element model the caller supplies the filter's raw
// bytes as one-u64-per-byte elements (the dispatcher's unit-1/alignment-1
// fill — same window upstream's `get_current_values_filter_pointer` reads).
// `lane_results` plays upstream's compare_result mask between the compare
// and encode passes; the group fast paths fold `vector_compare_size` lanes,
// tail groups (a partial group or the element remainder) encode per lane.
pub data VectorBytewiseStaggeredScan {
    encoder: SnapshotRegionFilterRunLengthEncoder;
    byte_index: u64;
    byte_candidate_count: u64;
    vector_compare_size: u64;
    element_index: u64;
    element_count: u64;
    vectorizable_element_count: u64;
    stride_bytes: u64;
    data_type_size_bytes: u64;
    length_padding: u64;
    check_equal: bool;
    operand_value: u64;
    supported: bool;
    finalized_tail: bool;
    lane_results: [u8; 64];
}

pub machine VectorBytewiseStaggeredScan::new(
    snapshot_region_filter: &SnapshotRegionFilter,
    plan: &SnapshotFilterElementScanPlan,
    vectorization_size: PlannedScanVectorizationSize
) -> VectorBytewiseStaggeredScan
crashes Abort
{
    transition vectorization_size {
        PlannedScanVectorizationSize::Vector16 -> compare_gate(
            snapshot_region_filter, plan, 16)
        PlannedScanVectorizationSize::Vector32 -> compare_gate(
            snapshot_region_filter, plan, 32)
        PlannedScanVectorizationSize::Vector64 -> compare_gate(
            snapshot_region_filter, plan, 64)
    }

    // Upstream accepts only Immediate compares; anything else is the
    // error-and-empty arm.
    state compare_gate(
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        vector_size_in_bytes: u64
    ) -> VectorBytewiseStaggeredScan {
        transition SnapshotFilterElementScanPlan::get_scan_compare_type(plan) {
            ScanCompareType::Immediate { compare_type } -> equal_gate(
                compare_type, snapshot_region_filter, plan, vector_size_in_bytes)
            _ -> (VectorBytewiseStaggeredScan::unsupported(snapshot_region_filter))
        }
    }

    state equal_gate(
        compare_type: ScanCompareTypeImmediate,
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        vector_size_in_bytes: u64
    ) -> VectorBytewiseStaggeredScan {
        transition compare_type {
            ScanCompareTypeImmediate::Equal -> dtype_gate(
                snapshot_region_filter, plan, vector_size_in_bytes, true)
            ScanCompareTypeImmediate::NotEqual -> dtype_gate(
                snapshot_region_filter, plan, vector_size_in_bytes, false)
            _ -> (VectorBytewiseStaggeredScan::unsupported(snapshot_region_filter))
        }
    }

    // Upstream's `match data_type_size { 2|4|8 => ..., _ => error+empty }`.
    state dtype_gate(
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        vector_size_in_bytes: u64,
        check_equal: bool
    ) -> VectorBytewiseStaggeredScan {
        let data_type_size: u64 = SnapshotFilterElementScanPlan::get_unit_size_in_bytes(plan);
        transition data_type_size == 2 || data_type_size == 4 || data_type_size == 8 {
            true -> build(
                snapshot_region_filter, plan, vector_size_in_bytes, check_equal)
            _ -> (VectorBytewiseStaggeredScan::unsupported(snapshot_region_filter))
        }
    }

    state build(
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        vector_size_in_bytes: u64,
        check_equal: bool
    ) -> VectorBytewiseStaggeredScan {
        let memory_alignment: MemoryAlignment = SnapshotFilterElementScanPlan::get_memory_alignment(plan);
        let memory_alignment_size: u64 = MemoryAlignment::get_size_in_bytes(&memory_alignment);
        let data_type_size: u64 = SnapshotFilterElementScanPlan::get_unit_size_in_bytes(plan);
        let region_size: u64 = SnapshotRegionFilter::get_region_size(snapshot_region_filter);
        // `plan_vector_scan` geometry with stride = alignment: element_count
        // = valid/stride, iterations = element_count/epv — upstream drives
        // the byte-lane groups off that same iteration count.
        let stride: u64 = max(memory_alignment_size, 1);
        let trailing: u64 = ((data_type_size as u64 in Saturating)
            - (stride as u64 in Saturating)) as u64;
        let valid_bytes: u64 = ((region_size as u64 in Saturating)
            - (trailing as u64 in Saturating)) as u64;
        let window_element_count: u64 = valid_bytes / stride;
        let elements_per_vec: u64 = vector_size_in_bytes / stride;
        transition elements_per_vec > 0 {
            true -> iterations(
                snapshot_region_filter, plan, vector_size_in_bytes, check_equal,
                stride, data_type_size, window_element_count, elements_per_vec)
            _ -> (VectorBytewiseStaggeredScan::unsupported(snapshot_region_filter))
        }
    }

    state iterations(
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        vector_size_in_bytes: u64,
        check_equal: bool,
        stride: u64,
        data_type_size: u64,
        element_count: u64,
        elements_per_vec: u64
    ) -> VectorBytewiseStaggeredScan {
        let vectorizable_iterations: u64 = element_count / elements_per_vec;
        let vectorized_element_count: u64 = ((vectorizable_iterations as u64 in Wrapping)
            * (elements_per_vec as u64 in Wrapping)) as u64;
        let compare_size_bytes: u64 = ((vector_size_in_bytes as u64 in Saturating)
            - (data_type_size as u64 in Saturating)) as u64;
        let byte_candidate_total: u64 = ((vectorizable_iterations as u64 in Wrapping)
            * (compare_size_bytes as u64 in Wrapping)) as u64;
        VectorBytewiseStaggeredScan {
            encoder: SnapshotRegionFilterRunLengthEncoder::new(
                SnapshotRegionFilter::get_base_address(snapshot_region_filter)
            ),
            byte_index: 0,
            byte_candidate_count: byte_candidate_total,
            vector_compare_size: compare_size_bytes,
            element_index: vectorized_element_count,
            element_count: element_count,
            vectorizable_element_count: vectorized_element_count,
            stride_bytes: stride,
            data_type_size_bytes: data_type_size,
            length_padding: ((data_type_size as u64 in Saturating)
                - (stride as u64 in Saturating)) as u64,
            check_equal: check_equal,
            operand_value: SnapshotFilterElementScanPlan::get_operand_value(plan),
            supported: true,
            finalized_tail: false,
        }
    }
}

// The empty-result shape upstream's error arms (`vec![]`) produce; the pull
// driver yields EmittedRegion::Empty immediately via `supported = false`
// and `finalized_tail = true`.
pub machine VectorBytewiseStaggeredScan::unsupported(
    snapshot_region_filter: &SnapshotRegionFilter
) -> VectorBytewiseStaggeredScan {
    VectorBytewiseStaggeredScan {
        encoder: SnapshotRegionFilterRunLengthEncoder::new(
            SnapshotRegionFilter::get_base_address(snapshot_region_filter)
        ),
        byte_index: 0,
        byte_candidate_count: 0,
        vector_compare_size: 0,
        element_index: 0,
        element_count: 0,
        vectorizable_element_count: 0,
        stride_bytes: 1,
        data_type_size_bytes: 0,
        length_padding: 0,
        check_equal: true,
        operand_value: 0,
        supported: false,
        finalized_tail: true,
    }
}

// Pulls the next emitted region. Phase one walks byte-lane groups of
// `vector_compare_size` (upstream's vector loop); phase two walks the
// element remainder at stride steps (upstream's scalar-path fallback). Both
// share the two-pass compare/encode shape the element driver uses.
pub machine VectorBytewiseStaggeredScan::next(
    vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
    current_values: &[u64],
    previous_values: &[u64]
) -> EmittedRegion satisfies Scanner::next {
    transition vector_bytewise_staggered_scan.supported && !vector_bytewise_staggered_scan.finalized_tail {
        true -> pump(vector_bytewise_staggered_scan, current_values, previous_values)
        _ -> (EmittedRegion::Empty)
    }

    state pump(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64]
    ) -> EmittedRegion {
        transition vector_bytewise_staggered_scan.byte_index < vector_bytewise_staggered_scan.byte_candidate_count {
            true -> group(vector_bytewise_staggered_scan, current_values, previous_values)
            false -> remainder_pump(vector_bytewise_staggered_scan, current_values, previous_values)
        }
    }

    // Vector phase: byte lanes [byte_index, byte_index + vcs) — a whole
    // group at a time (upstream advances the pointer by vcs per iteration).
    state group(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64]
    ) -> EmittedRegion {
        let remaining: u64 = ((vector_bytewise_staggered_scan.byte_candidate_count as u64 in Saturating)
            - (vector_bytewise_staggered_scan.byte_index as u64 in Saturating)) as u64;
        let lane_count: u64 = min(remaining, vector_bytewise_staggered_scan.vector_compare_size);
        transition { _ -> compare_lane(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, 0, 0) }
    }

    state compare_lane(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64,
        hit_count: u64
    ) -> EmittedRegion {
        transition lane_index < lane_count {
            true -> lane_eval(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, lane_index, hit_count)
            false -> decide(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, hit_count)
        }
    }

    // Lane l: AND over pattern byte positions of (window[l+i] vs pattern[i])
    // — eq per position for Equal, ne per position for NotEqual, upstream's
    // rotate-folded AND verbatim.
    state lane_eval(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64,
        hit_count: u64
    ) -> EmittedRegion {
        transition { _ -> byte_fold(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, lane_index, hit_count, 0, true) }
    }

    state byte_fold(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64,
        hit_count: u64,
        byte_offset: u64,
        fold: bool
    ) -> EmittedRegion {
        transition byte_offset < vector_bytewise_staggered_scan.data_type_size_bytes && fold {
            true -> byte_position(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count, byte_offset)
            false -> lane_mark(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count, fold)
            _ -> lane_mark(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count, fold)
        }
    }

    state byte_position(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64,
        hit_count: u64,
        byte_offset: u64
    ) -> EmittedRegion {
        let byte_at: u64 = ((vector_bytewise_staggered_scan.byte_index as u64 in Saturating)
            + (lane_index as u64 in Saturating) + (byte_offset as u64 in Saturating)) as u64;
        transition byte_at < current_values.len {
            true -> byte_compare(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count, byte_offset, byte_at)
            // Out-of-window bytes compare false — the AND fold dies,
            // matching upstream's unaligned tail load semantics.
            false -> lane_mark(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count, false)
            _ -> lane_mark(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count, false)
        }
    }

    state byte_compare(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64,
        hit_count: u64,
        byte_offset: u64,
        byte_at: u64
    ) -> EmittedRegion
    requires 0 <= byte_at && byte_at < current_values.len;
    {
        let window_byte: u64 = current_values[byte_at] % 256;
        let pattern_byte: u64 =
            staggered_pattern_byte(vector_bytewise_staggered_scan.operand_value, vector_bytewise_staggered_scan.data_type_size_bytes, byte_offset) as u64;
        transition vector_bytewise_staggered_scan.check_equal {
            true -> byte_eq(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count,
                byte_offset, window_byte, pattern_byte)
            false -> byte_ne(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count,
                byte_offset, window_byte, pattern_byte)
            _ -> lane_mark(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count, false)
        }
    }

    state byte_eq(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64,
        hit_count: u64,
        byte_offset: u64,
        window_byte: u64,
        pattern_byte: u64
    ) -> EmittedRegion {
        transition window_byte == pattern_byte {
            true -> byte_fold(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count,
                sat_inc(byte_offset), true)
            false -> lane_mark(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count, false)
            _ -> lane_mark(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count, false)
        }
    }

    state byte_ne(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64,
        hit_count: u64,
        byte_offset: u64,
        window_byte: u64,
        pattern_byte: u64
    ) -> EmittedRegion {
        transition window_byte != pattern_byte {
            true -> byte_fold(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count,
                sat_inc(byte_offset), true)
            false -> lane_mark(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count, false)
            _ -> lane_mark(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, hit_count, false)
        }
    }

    state lane_mark(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64,
        hit_count: u64,
        matched: bool
    ) -> EmittedRegion {
        transition matched && lane_index < 64 {
            true -> lane_hit_write(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, lane_index, hit_count)
            false -> lane_miss_write_gate(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, lane_index, hit_count)
            _ -> lane_miss_write_gate(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, lane_index, hit_count)
        }
    }

    state lane_hit_write(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64,
        hit_count: u64
    ) -> EmittedRegion
    requires 0 <= lane_index && lane_index < 64;
    {
        vector_bytewise_staggered_scan.lane_results[lane_index] = 1;
        let next_lane: u64 = sat_inc(lane_index);
        let next_hits: u64 = sat_inc(hit_count);
        transition { _ -> compare_lane(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, next_lane, next_hits) }
    }

    state lane_miss_write_gate(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64,
        hit_count: u64
    ) -> EmittedRegion {
        transition lane_index < 64 {
            true -> lane_miss_write(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, lane_index, hit_count)
            _ -> compare_lane(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, sat_inc(lane_index), hit_count)
        }
    }

    state lane_miss_write(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64,
        hit_count: u64
    ) -> EmittedRegion
    requires 0 <= lane_index && lane_index < 64;
    {
        vector_bytewise_staggered_scan.lane_results[lane_index] = 0;
        let next_lane: u64 = sat_inc(lane_index);
        transition { _ -> compare_lane(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, next_lane, hit_count) }
    }

    // Upstream's encode_results: all-true -> encode_range(vcs); all-false ->
    // finalize_with_padding(vcs, padding); mixed -> per-lane
    // encode_range(1)/finalize_with_padding(1, padding). A partial tail
    // group also encodes per lane.
    state decide(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        hit_count: u64
    ) -> EmittedRegion {
        transition lane_count == vector_bytewise_staggered_scan.vector_compare_size && hit_count == lane_count {
            true -> encode_all(vector_bytewise_staggered_scan, current_values, previous_values, lane_count)
            false -> decide_miss(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, hit_count)
            _ -> decide_miss(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, hit_count)
        }
    }

    state decide_miss(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        hit_count: u64
    ) -> EmittedRegion {
        transition lane_count == vector_bytewise_staggered_scan.vector_compare_size && hit_count == 0 {
            true -> encode_none(vector_bytewise_staggered_scan, current_values, previous_values, lane_count)
            false -> encode_lane(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, 0)
            _ -> encode_lane(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, 0)
        }
    }

    state encode_all(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64
    ) -> EmittedRegion {
        SnapshotRegionFilterRunLengthEncoder::encode_range(&mut vector_bytewise_staggered_scan.encoder, vector_bytewise_staggered_scan.vector_compare_size);
        vector_bytewise_staggered_scan.byte_index = ((vector_bytewise_staggered_scan.byte_index as u64 in Saturating)
            + (lane_count as u64 in Saturating)) as u64;
        transition { _ -> pump(vector_bytewise_staggered_scan, current_values, previous_values) }
    }

    state encode_none(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64
    ) -> EmittedRegion {
        let emitted: EmittedRegion = vector_bytewise_staggered_scan
            .encoder
            .finalize_current_encode_with_padding(vector_bytewise_staggered_scan.vector_compare_size, vector_bytewise_staggered_scan.length_padding);
        vector_bytewise_staggered_scan.byte_index = ((vector_bytewise_staggered_scan.byte_index as u64 in Saturating)
            + (lane_count as u64 in Saturating)) as u64;
        transition { _ -> emit_or_pump(vector_bytewise_staggered_scan, current_values, previous_values, emitted) }
    }

    state encode_lane(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64
    ) -> EmittedRegion {
        transition lane_index < lane_count {
            true -> encode_lane_read(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, lane_index)
            false -> group_done(vector_bytewise_staggered_scan, current_values, previous_values, lane_count)
        }
    }

    state encode_lane_read(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64
    ) -> EmittedRegion {
        transition lane_index < 64 {
            true -> encode_lane_take(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, lane_index)
            _ -> encode_lane_miss(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, lane_index)
        }
    }

    state encode_lane_take(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64
    ) -> EmittedRegion
    requires 0 <= lane_index && lane_index < 64;
    {
        let lane_result: u8 = vector_bytewise_staggered_scan.lane_results[lane_index];
        transition lane_result == 1 {
            true -> encode_lane_hit(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, lane_index)
            false -> encode_lane_miss(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, lane_index)
            _ -> encode_lane_miss(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, lane_index)
        }
    }

    // Upstream's per-byte lane encode: encode_range(1) on hit,
    // finalize_with_padding(1, padding) on miss.
    state encode_lane_hit(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64
    ) -> EmittedRegion {
        SnapshotRegionFilterRunLengthEncoder::encode_range(&mut vector_bytewise_staggered_scan.encoder, 1);
        let next_lane: u64 = sat_inc(lane_index);
        transition { _ -> encode_lane(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, next_lane) }
    }

    state encode_lane_miss(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64
    ) -> EmittedRegion {
        let emitted: EmittedRegion = vector_bytewise_staggered_scan
            .encoder
            .finalize_current_encode_with_padding(1, vector_bytewise_staggered_scan.length_padding);
        // Payload moves out of the union — the case split rides a
        // param-position scrutinee in a hop state.
        transition {
            _ -> emitted_kind(vector_bytewise_staggered_scan, 
                emitted, current_values, previous_values, lane_count, lane_index)
        }
    }

    state emitted_kind(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        emitted: EmittedRegion,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64
    ) -> EmittedRegion {
        transition emitted {
            EmittedRegion::Region { region } -> emit_advance(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, lane_index, region)
            EmittedRegion::Empty -> encode_lane(vector_bytewise_staggered_scan, 
                current_values, previous_values, lane_count, sat_inc(lane_index))
            _ -> encode_lane(vector_bytewise_staggered_scan, current_values, previous_values, lane_count, sat_inc(lane_index))
        }
    }

    state emit_advance(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64,
        lane_index: u64,
        region: SnapshotRegionFilter
    ) -> EmittedRegion {
        vector_bytewise_staggered_scan.byte_index = ((vector_bytewise_staggered_scan.byte_index as u64 in Saturating)
            + (lane_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        (EmittedRegion::Region { region: region })
    }

    state group_done(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        lane_count: u64
    ) -> EmittedRegion {
        vector_bytewise_staggered_scan.byte_index = ((vector_bytewise_staggered_scan.byte_index as u64 in Saturating)
            + (lane_count as u64 in Saturating)) as u64;
        transition { _ -> pump(vector_bytewise_staggered_scan, current_values, previous_values) }
    }

    // Remainder phase: upstream's scalar-path fallback — element candidates
    // index..element_count at byte offset index*alignment, encoding
    // `alignment` bytes per candidate with the same padding fold. The
    // compare is upstream's scalar compare_func: the assembled element vs
    // operand — for Equal the same all-bytes fold; for NotEqual upstream's
    // scalar fn is the real "element differs" (some byte differs), NOT the
    // vector lanes' every-byte-differs fold.
    state remainder_pump(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64]
    ) -> EmittedRegion {
        transition vector_bytewise_staggered_scan.element_index < vector_bytewise_staggered_scan.element_count {
            true -> remainder_fold(vector_bytewise_staggered_scan, current_values, previous_values, 0, true)
            false -> finish(vector_bytewise_staggered_scan)
        }
    }

    state remainder_fold(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        byte_offset: u64,
        fold: bool
    ) -> EmittedRegion {
        transition byte_offset < vector_bytewise_staggered_scan.data_type_size_bytes && fold {
            true -> remainder_byte(vector_bytewise_staggered_scan, current_values, previous_values, byte_offset)
            false -> remainder_mark(vector_bytewise_staggered_scan, current_values, previous_values, fold)
            _ -> remainder_mark(vector_bytewise_staggered_scan, current_values, previous_values, fold)
        }
    }

    state remainder_byte(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        byte_offset: u64
    ) -> EmittedRegion {
        let element_base: u64 = ((vector_bytewise_staggered_scan.element_index as u64 in Saturating)
            * (vector_bytewise_staggered_scan.stride_bytes as u64 in Saturating)) as u64;
        let byte_at: u64 = ((element_base as u64 in Saturating)
            + (byte_offset as u64 in Saturating)) as u64;
        transition byte_at < current_values.len {
            true -> remainder_compare(vector_bytewise_staggered_scan, 
                current_values, previous_values, byte_offset, byte_at)
            false -> remainder_mark(vector_bytewise_staggered_scan, current_values, previous_values, false)
            _ -> remainder_mark(vector_bytewise_staggered_scan, current_values, previous_values, false)
        }
    }

    state remainder_compare(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        byte_offset: u64,
        byte_at: u64
    ) -> EmittedRegion
    requires 0 <= byte_at && byte_at < current_values.len;
    {
        let window_byte: u64 = current_values[byte_at] % 256;
        let pattern_byte: u64 =
            staggered_pattern_byte(vector_bytewise_staggered_scan.operand_value, vector_bytewise_staggered_scan.data_type_size_bytes, byte_offset) as u64;
        transition window_byte == pattern_byte {
            true -> remainder_fold(vector_bytewise_staggered_scan, current_values, previous_values, sat_inc(byte_offset), true)
            false -> remainder_mark(vector_bytewise_staggered_scan, current_values, previous_values, false)
            _ -> remainder_mark(vector_bytewise_staggered_scan, current_values, previous_values, false)
        }
    }

    // Equal keeps the all-match fold; NotEqual inverts it (upstream's
    // scalar compare is the real element inequality here).
    state remainder_mark(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        fold: bool
    ) -> EmittedRegion {
        transition fold == vector_bytewise_staggered_scan.check_equal {
            true -> remainder_hit(vector_bytewise_staggered_scan, current_values, previous_values)
            false -> remainder_miss(vector_bytewise_staggered_scan, current_values, previous_values)
            _ -> remainder_miss(vector_bytewise_staggered_scan, current_values, previous_values)
        }
    }

    state remainder_hit(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64]
    ) -> EmittedRegion {
        SnapshotRegionFilterRunLengthEncoder::encode_range(&mut vector_bytewise_staggered_scan.encoder, vector_bytewise_staggered_scan.stride_bytes);
        vector_bytewise_staggered_scan.element_index = ((vector_bytewise_staggered_scan.element_index as u64 in Saturating)
            + (1 as u64 in Saturating)) as u64;
        transition { _ -> remainder_pump(vector_bytewise_staggered_scan, current_values, previous_values) }
    }

    state remainder_miss(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64]
    ) -> EmittedRegion {
        let emitted: EmittedRegion = vector_bytewise_staggered_scan
            .encoder
            .finalize_current_encode_with_padding(vector_bytewise_staggered_scan.stride_bytes, vector_bytewise_staggered_scan.length_padding);
        vector_bytewise_staggered_scan.element_index = ((vector_bytewise_staggered_scan.element_index as u64 in Saturating)
            + (1 as u64 in Saturating)) as u64;
        transition { _ -> emit_or_remainder(vector_bytewise_staggered_scan, current_values, previous_values, emitted) }
    }

    state emit_or_remainder(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        emitted: EmittedRegion
    ) -> EmittedRegion {
        transition emitted {
            EmittedRegion::Region { region } -> (EmittedRegion::Region { region: region })
            EmittedRegion::Empty -> remainder_pump(vector_bytewise_staggered_scan, current_values, previous_values)
            _ -> remainder_pump(vector_bytewise_staggered_scan, current_values, previous_values)
        }
    }

    state emit_or_pump(
        vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan,
        current_values: &[u64],
        previous_values: &[u64],
        emitted: EmittedRegion
    ) -> EmittedRegion {
        transition emitted {
            EmittedRegion::Region { region } -> (EmittedRegion::Region { region: region })
            EmittedRegion::Empty -> pump(vector_bytewise_staggered_scan, current_values, previous_values)
            _ -> pump(vector_bytewise_staggered_scan, current_values, previous_values)
        }
    }

    state finish(vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan) -> EmittedRegion {
        transition vector_bytewise_staggered_scan.finalized_tail {
            true -> arm_result_744_0()
            false -> tail_finalize(vector_bytewise_staggered_scan)
            _ -> tail_finalize(vector_bytewise_staggered_scan)
        }
    }

    // Upstream's post-loop `finalize_current_encode_with_padding(0, pad)`.
    state tail_finalize(vector_bytewise_staggered_scan: &mut VectorBytewiseStaggeredScan) -> EmittedRegion {
        vector_bytewise_staggered_scan.finalized_tail = true;
        let emitted: EmittedRegion = vector_bytewise_staggered_scan
            .encoder
            .finalize_current_encode_with_padding(0, vector_bytewise_staggered_scan.length_padding);
        let emitted_has_region: bool = EmittedRegion::is_region(&emitted);
        transition emitted_has_region {
            true -> (emitted)
            _ -> (EmittedRegion::Empty)
        }
    }
    state arm_result_744_0() -> EmittedRegion
    {
        (EmittedRegion::Empty)
    }
}

// Upstream `get_scanner_name` (`"Vector Overlapping (Bytewise Staggered)"`,
// 39 bytes) — len/byte pair per the borrowed-string convention.
pub machine VectorBytewiseStaggeredScan::get_scanner_name_len(vector_bytewise_staggered_scan: &VectorBytewiseStaggeredScan) -> u64
satisfies Scanner::get_scanner_name_len
{
    39
}

pub machine VectorBytewiseStaggeredScan::get_scanner_name_byte(
    vector_bytewise_staggered_scan: &VectorBytewiseStaggeredScan,
    position: u64
) -> u8
satisfies Scanner::get_scanner_name_byte
{
    transition position < 39 {
        true -> read(vector_bytewise_staggered_scan, position)
        _ -> (0)
    }

    state read(vector_bytewise_staggered_scan: &VectorBytewiseStaggeredScan, position: u64) -> u8 {
        transition position < 39 {
            true -> take(vector_bytewise_staggered_scan, position)
            _ -> (0)
        }
    }

    state take(vector_bytewise_staggered_scan: &VectorBytewiseStaggeredScan, position: u64) -> u8
    requires 0 <= position && position < 39;
    {
        "Vector Overlapping (Bytewise Staggered)"[position]
    }
}

// Unit receiver carrying upstream's `ScannerVectorOverlappingBytewiseStaggered::<N>`
// namespace — the constructor the commented-out dispatch arm would have used.
pub data ScannerVectorOverlappingBytewiseStaggered {}

pub machine ScannerVectorOverlappingBytewiseStaggered::new(
    snapshot_region_filter: &SnapshotRegionFilter,
    snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan,
    vectorization_size: PlannedScanVectorizationSize
) -> VectorBytewiseStaggeredScan
crashes Abort
{
    VectorBytewiseStaggeredScan::new(
        snapshot_region_filter,
        snapshot_filter_element_scan_plan,
        vectorization_size
    )
}

// Pattern byte `byte_index` of the packed operand (little-endian element
// view, like the byte-array scan's `byte_array_operand_byte`).
machine staggered_pattern_byte(
    operand_value: u64,
    value_size_in_bytes: u64,
    byte_index: u64
) -> u8 {
    transition byte_index < value_size_in_bytes && byte_index < 8 {
        true -> take(operand_value, byte_index)
        _ -> (0)
    }

    state take(operand_value: u64, byte_index: u64) -> u8 {
        transition byte_index < 8 {
            true -> read(operand_value, byte_index)
            _ -> (0)
        }
    }

    state read(operand_value: u64, byte_index: u64) -> u8
    requires 0 <= byte_index && byte_index < 8;
    {
        let divisor: u64 = pow256(byte_index);
        let shifted: u64 =
            ((operand_value as u64 in Wrapping) / (divisor as u64 in Wrapping)) as u64;
        (shifted % 256) as u8
    }
}

machine pow256(byte_index: u64) -> u64
requires 0 <= byte_index && byte_index < 8;
{
    transition byte_index {
        0 -> 1
        1 -> 256
        2 -> 65536
        3 -> 16777216
        4 -> 4294967296
        5 -> 1099511627776
        6 -> 281474976710656
        7 -> 72057594037927936
        _ -> 1
    }
}

// Saturating single-step for unbounded u64 counters (lane/pattern indexes):
// the compare/encode loops only ever reach their caller-bounded lane count,
// but the param types carry no proof — upstream's plain `+1` would trip the
// exact-arithmetic overflow check.
machine sat_inc(value: u64) -> u64 {
    ((value as u64 in Saturating) + (1 as u64 in Saturating)) as u64
}
