module src::scanners::vector::scanner_vector_byte_array_booyer_moore;

use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_api::src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use src::scanners::scalar::scanner_scalar_byte_array_booyer_moore::ScalarByteArrayScan;
use src::scanners::snapshot_scanner::Scanner;

// Port of ScannerVectorByteArrayBooyerMoore. Upstream's "vector" byte-array
// scanner performs no SIMD operations at all — its scan_region is the
// scalar Boyer-Moore loop verbatim (same table, same overlap-preserving
// candidate-stride shifts, same padding). The port therefore reuses the
// shared `ScalarByteArrayScan` driver with `has_mask = false`, and this
// file carries only the upstream unit's constructor and name.
//
// Unreachable like upstream: the dispatcher's `aquire_scanner_instance`
// match has no arm for a vector byte-array plan kind, so this scanner is
// registered but never selected.
pub data ScannerVectorByteArrayBooyerMoore {}

pub machine ScannerVectorByteArrayBooyerMoore::new(
    snapshot_region_filter: &SnapshotRegionFilter,
    snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan
) -> ScalarByteArrayScan {
    ScalarByteArrayScan::new(
        snapshot_region_filter,
        snapshot_filter_element_scan_plan,
        false
    )
}

// Upstream `get_scanner_name` (`"Vector Byte Array (Booyer Moore)"`, 31
// bytes) — len/byte pair per the borrowed-string convention.
pub machine ScannerVectorByteArrayBooyerMoore::get_scanner_name_len(&self) -> u64
satisfies Scanner::get_scanner_name_len
{
    31
}

pub machine ScannerVectorByteArrayBooyerMoore::get_scanner_name_byte(
    &self,
    position: u64
) -> u8
satisfies Scanner::get_scanner_name_byte
{
    transition position < 31 {
        true -> read(position)
        _ -> (0)
    }

    state read(&self, position: u64) -> u8 {
        transition position < 31 {
            true -> take(position)
            _ -> (0)
        }
    }

    state take(&self, position: u64 [0..31]) -> u8 {
        "Vector Byte Array (Booyer Moore)"[position]
    }
}
