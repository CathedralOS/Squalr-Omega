use {squalr_engine_api}/src/structures/scanning/filters/snapshot_region_filter.omg;
use {squalr_engine_api}/src/structures/scanning/plans/element_scan/snapshot_filter_element_scan_plan.omg;
use src/scanners/scalar/scanner_scalar_byte_array_booyer_moore.omg;
use src/scanners/snapshot_scanner.omg;

// Port of ScannerVectorByteArrayBooyerMoore. Upstream's "vector" byte-array
// scanner performs no SIMD operations at all — its scan_region is the
// scalar Boyer-Moore loop verbatim (same table, same overlap-preserving
// candidate-stride shifts, same padding). The port therefore reuses the
// shared `ScalarByteArrayScan` driver with `has_mask = false`, and this
// file carries only the upstream unit's constructor and name.
//
// Unreachable like upstream: the dispatcher's `aquire_scanner_instance`
// match has no arm for a vector byte-array plan kind, so this scanner is
// registered but never selected.
public data ScannerVectorByteArrayBooyerMoore {}

public machine ScannerVectorByteArrayBooyerMoore::new(
    snapshot_region_filter: &|snapshot_region_filter|::SnapshotRegionFilter,
    snapshot_filter_element_scan_plan: &|snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan
) -> |scanner_scalar_byte_array_booyer_moore|::ScalarByteArrayScan {
    |scanner_scalar_byte_array_booyer_moore|::ScalarByteArrayScan::new(snapshot_region_filter,
        snapshot_filter_element_scan_plan,
        false
    )
}

// Upstream `get_scanner_name` (`"Vector Byte Array (Booyer Moore)"`, 31
// bytes) — len/byte pair per the borrowed-string convention.
public machine ScannerVectorByteArrayBooyerMoore::get_scanner_name_len(this: &ScannerVectorByteArrayBooyerMoore) -> u64
satisfies |snapshot_scanner|::Scanner<ScannerVectorByteArrayBooyerMoore>::get_scanner_name_len
{
    31
}

public machine ScannerVectorByteArrayBooyerMoore::get_scanner_name_byte(
    this: &ScannerVectorByteArrayBooyerMoore,
    position: u64
) -> u8
satisfies |snapshot_scanner|::Scanner<ScannerVectorByteArrayBooyerMoore>::get_scanner_name_byte
{
    transition position < 31 {
        true -> read(this, position)
        _ -> (0)
    }

    machine read(this: &ScannerVectorByteArrayBooyerMoore, position: u64) -> u8 {
        transition position < 31 {
            true -> take(this, position)
            _ -> (0)
        }
    }

    machine take(this: &ScannerVectorByteArrayBooyerMoore, position: u64) -> u8
    requires 0 <= position && position < 31;
    {
        "Vector Byte Array (Booyer Moore)"[position]
    }
}
