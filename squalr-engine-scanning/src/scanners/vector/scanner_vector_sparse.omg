use {squalr_engine_api}/src/structures/scanning/filters/snapshot_region_filter.omg;
use {squalr_engine_api}/src/structures/scanning/plans/element_scan/snapshot_filter_element_scan_plan.omg;
use {squalr_engine_api}/src/structures/scanning/plans/plan_types/planned_scan_type_vector.omg;
use {squalr_engine_api}/src/structures/scanning/plans/plan_types/planned_scan_vectorization_size.omg;
use src/scanners/vector/scanner_vector_aligned.omg;

// Port of ScannerVectorSparse — upstream's arm for `data_type_size <
// memory_alignment` (its `debug_assert!`). Upstream ANDs the compare mask
// with a sparse mask keeping every (alignment/dtype)-th byte lane; on the
// element model every window element is already a sparse candidate, so the
// sparse mask is a no-op and the driver's Aligned-equivalent encode applies
// verbatim (plain `finalize_current_encode` misses, no padding).
public data ScannerVectorSparse {}

public machine ScannerVectorSparse::new(
    snapshot_region_filter: &|snapshot_region_filter|::SnapshotRegionFilter,
    snapshot_filter_element_scan_plan: &|snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan,
    vectorization_size: |planned_scan_vectorization_size|::PlannedScanVectorizationSize
) -> |scanner_vector_aligned|::VectorElementScan
crashes Abort
{
    |scanner_vector_aligned|::VectorElementScan::new(snapshot_region_filter,
        snapshot_filter_element_scan_plan,
        |planned_scan_type_vector|::PlannedScanTypeVector::Sparse,
        vectorization_size
    )
}
