module src::scanners::vector::scanner_vector_overlapping;

use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_api::src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use squalr_engine_api::src::structures::scanning::plans::plan_types::planned_scan_type_vector::PlannedScanTypeVector;
use squalr_engine_api::src::structures::scanning::plans::plan_types::planned_scan_vectorization_size::PlannedScanVectorizationSize;
use src::scanners::vector::scanner_vector_aligned::VectorElementScan;

// Port of ScannerVectorOverlapping — upstream's arm for `data_type_size >
// memory_alignment` (its `debug_assert!`) and the dispatch target upstream
// routes the bytewise-staggered/periodic plan kinds to (the dedicated arms
// are commented out in upstream's `aquire_scanner_instance`). Upstream ORs
// the per-overlap shifted compares back into one lane mask; on the element
// model each candidate is evaluated once at its stride offset, which is the
// net of those ORs — identical coverage. Misses carry
// `data_type_size_padding` on every finalize, exactly as upstream's
// `finalize_current_encode_with_padding(_, padding)` writes them.
pub data ScannerVectorOverlapping {}

pub machine ScannerVectorOverlapping::new(
    snapshot_region_filter: &SnapshotRegionFilter,
    snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan,
    vectorization_size: PlannedScanVectorizationSize
) -> VectorElementScan
crashes Abort
{
    VectorElementScan::new(
        snapshot_region_filter,
        snapshot_filter_element_scan_plan,
        PlannedScanTypeVector::Overlapping,
        vectorization_size
    )
}
