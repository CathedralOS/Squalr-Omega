module src::scanners::element_scan_runner;

use squalr_engine_api::src::structures::data_types::data_type_ref::DataTypeRef;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter_collection::SnapshotRegionFilterCollection;
use squalr_engine_api::src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use squalr_engine_api::src::structures::scanning::plans::plan_types::planned_scan_type::PlannedScanType;
use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::scanning::plans::plan_types::planned_scan_type_byte_array::PlannedScanTypeByteArray;
use squalr_engine_api::src::structures::scanning::plans::plan_types::planned_scan_type_scalar::PlannedScanTypeScalar;
use squalr_engine_api::src::structures::scanning::plans::plan_types::planned_scan_type_vector::PlannedScanTypeVector;
use squalr_engine_api::src::structures::scanning::plans::plan_types::planned_scan_vectorization_size::PlannedScanVectorizationSize;
use squalr_engine_api::src::structures::snapshots::snapshot_region::SnapshotRegion;
use src::scanners::scalar::scanner_scalar_byte_array_booyer_moore::ScalarByteArrayScan;
use src::scanners::scalar::scanner_scalar_byte_array_booyer_moore::ScannerScalarByteArrayBooyerMoore;
use src::scanners::scalar::scanner_scalar_byte_array_booyer_moore_masked::ScannerScalarByteArrayBooyerMooreMasked;
use src::scanners::scalar::scanner_scalar_iterative::ScalarIterativeScan;
use src::scanners::scalar::scanner_scalar_single_element::ScannerScalarSingleElement;
use src::scanners::vector::scanner_vector_aligned::ScannerVectorAligned;
use src::scanners::vector::scanner_vector_aligned::VectorElementScan;
use src::scanners::vector::scanner_vector_overlapping::ScannerVectorOverlapping;
use src::scanners::vector::scanner_vector_sparse::ScannerVectorSparse;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::EmittedRegion;

// The in-package drain of `ElementScanDispatcher`'s pull contract. Upstream
// `dispatch_scan_for_snapshot_filter` acquires a scanner per plan and calls
// `scan_region(snapshot_region, snapshot_region_filter, plan)`, which walks
// the filter's element window via the region's filter-relative value
// pointers. The port slices `region`'s element windows at the filter's first
// element index — identical coverage since a window begins at the region
// base and elements step by the scan's memory alignment.
//
// `Optional<ScalarRegionScan>` is unmatchable even in-package, so the runner
// replicates the dispatcher's plan routing: a Scalar plan drains
// `ScalarIterativeScan` (or resolves SingleElement through the dedicated
// one-shot scanner), a Vector plan drains the element-window vector driver
// at the plan's kind/width (bytewise plan kinds route to the overlapping
// driver exactly like the dispatcher's upstream-parity arms); other plan
// kinds yield an empty collection exactly as upstream's unplanned case does.
// Drained filters are bounded at the collection's capacity — upstream grows
// without bound; overflow truncates (a named deviation at the bounded
// carrier, not a semantic change to which filters the scanner emits).
// Empty receiver carrying the runner's machines — mirrors upstream's
// `impl` namespace.
pub data ElementScanRunner {}

pub machine ElementScanRunner::run_region(
    snapshot_region: &SnapshotRegion,
    snapshot_region_filter: &SnapshotRegionFilter,
    plan: &SnapshotFilterElementScanPlan,
    data_type_ref: &DataTypeRef
) -> SnapshotRegionFilterCollection
crashes Abort
{
    let result: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::empty(
        DataTypeRef::clone(data_type_ref),
        plan.get_memory_alignment(),
        plan.get_unit_size_in_bytes());
    transition plan.get_planned_scan_type() {
        PlannedScanType::Scalar { scan_type } -> scalar(
            scan_type, snapshot_region, snapshot_region_filter, plan, result)
        PlannedScanType::Invalid -> (result)
        PlannedScanType::Vector { scan_type, vectorization_size } -> vector(
            scan_type, vectorization_size, snapshot_region, snapshot_region_filter, plan, result)
        PlannedScanType::ByteArray { scan_type } -> byte_array(
            scan_type, snapshot_region, snapshot_region_filter, plan, result)
        _ -> (result)
    }

    // Byte-array plans scan the filter's raw byte window — the same window
    // the dispatcher fills at unit 1 / alignment 1 (upstream's
    // get_current_values_filter_pointer view). `previous_values` is unused by
    // the byte-array scan; `current_values` stands in for the unused param.
    state byte_array(
        scan_type: PlannedScanTypeByteArray,
        snapshot_region: &SnapshotRegion,
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        result: SnapshotRegionFilterCollection
    ) -> SnapshotRegionFilterCollection
    {
        let base_difference: u64 = ((snapshot_region_filter.get_base_address() as u64 in Saturating)
            - (snapshot_region.get_base_address() as u64 in Saturating)) as u64;
        let count: u64 = snapshot_region_filter.get_element_count(
            1,
            MemoryAlignment::Alignment1);
        let current_values: &[u64] = snapshot_region.get_current_values_slice(
            base_difference, count);
        transition scan_type {
            PlannedScanTypeByteArray::ByteArrayBooyerMoore -> drain(
                snapshot_region, snapshot_region_filter, plan, current_values, result, false)
            PlannedScanTypeByteArray::ByteArrayBooyerMooreMasked -> drain(
                snapshot_region, snapshot_region_filter, plan, current_values, result, true)
        }
    }

    state drain(
        snapshot_region: &SnapshotRegion,
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        current_values: &[u64],
        result: SnapshotRegionFilterCollection,
        has_mask: bool
    ) -> SnapshotRegionFilterCollection
    {
        let mut scan: ScalarByteArrayScan = ScalarByteArrayScan::new(
            snapshot_region_filter, plan, has_mask);
        let mut collected: SnapshotRegionFilterCollection = result;
        ElementScanRunner::drain_byte_array(
            &mut scan, current_values, &mut collected);
        (collected)
    }

    // Vector plans drain the element-window driver — the same decoded
    // element windows the scalar path fills (unit-sized elements at the
    // scan alignment). The dispatcher's kind routing is mirrored: the
    // bytewise plan kinds select the overlapping driver, per upstream's
    // commented-out dispatch arms.
    state vector(
        scan_type: PlannedScanTypeVector,
        vectorization_size: PlannedScanVectorizationSize,
        snapshot_region: &SnapshotRegion,
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        result: SnapshotRegionFilterCollection
    ) -> SnapshotRegionFilterCollection
    {
        let base_difference: u64 = ((snapshot_region_filter.get_base_address() as u64 in Saturating)
            - (snapshot_region.get_base_address() as u64 in Saturating)) as u64;
        let memory_alignment: MemoryAlignment = plan.get_memory_alignment();
        let alignment_size: u64 = memory_alignment.get_size_in_bytes();
        let start: u64 = ((base_difference as u64 in Saturating)
            / (alignment_size as u64 in Saturating)) as u64;
        let count: u64 = snapshot_region_filter.get_element_count(
            plan.get_unit_size_in_bytes(),
            plan.get_memory_alignment());
        let current_values: &[u64] = snapshot_region.get_current_values_slice(start, count);
        let previous_values: &[u64] = snapshot_region.get_previous_values_slice(start, count);
        transition scan_type {
            PlannedScanTypeVector::Overlapping -> drain_overlapping(
                snapshot_region_filter, plan, vectorization_size,
                current_values, previous_values, result)
            PlannedScanTypeVector::Aligned -> drain_aligned(
                snapshot_region_filter, plan, vectorization_size,
                current_values, previous_values, result)
            PlannedScanTypeVector::Sparse -> drain_sparse(
                snapshot_region_filter, plan, vectorization_size,
                current_values, previous_values, result)
            PlannedScanTypeVector::OverlappingBytewiseStaggered -> drain_overlapping(
                snapshot_region_filter, plan, vectorization_size,
                current_values, previous_values, result)
            PlannedScanTypeVector::OverlappingBytewisePeriodic -> drain_overlapping(
                snapshot_region_filter, plan, vectorization_size,
                current_values, previous_values, result)
        }
    }

    state drain_aligned(
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        vectorization_size: PlannedScanVectorizationSize,
        current_values: &[u64],
        previous_values: &[u64],
        result: SnapshotRegionFilterCollection
    ) -> SnapshotRegionFilterCollection
    {
        let mut scan: VectorElementScan = ScannerVectorAligned::new(
            snapshot_region_filter, plan, vectorization_size);
        let mut collected: SnapshotRegionFilterCollection = result;
        ElementScanRunner::drain_vector(&mut scan, current_values, previous_values, &mut collected);
        (collected)
    }

    state drain_sparse(
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        vectorization_size: PlannedScanVectorizationSize,
        current_values: &[u64],
        previous_values: &[u64],
        result: SnapshotRegionFilterCollection
    ) -> SnapshotRegionFilterCollection
    {
        let mut scan: VectorElementScan = ScannerVectorSparse::new(
            snapshot_region_filter, plan, vectorization_size);
        let mut collected: SnapshotRegionFilterCollection = result;
        ElementScanRunner::drain_vector(&mut scan, current_values, previous_values, &mut collected);
        (collected)
    }

    state drain_overlapping(
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        vectorization_size: PlannedScanVectorizationSize,
        current_values: &[u64],
        previous_values: &[u64],
        result: SnapshotRegionFilterCollection
    ) -> SnapshotRegionFilterCollection
    {
        let mut scan: VectorElementScan = ScannerVectorOverlapping::new(
            snapshot_region_filter, plan, vectorization_size);
        let mut collected: SnapshotRegionFilterCollection = result;
        ElementScanRunner::drain_vector(&mut scan, current_values, previous_values, &mut collected);
        (collected)
    }

    state scalar(
        scan_type: PlannedScanTypeScalar,
        snapshot_region: &SnapshotRegion,
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        result: SnapshotRegionFilterCollection
    ) -> SnapshotRegionFilterCollection
    {
        transition scan_type {
            PlannedScanTypeScalar::ScalarIterative -> iterative(
                snapshot_region, snapshot_region_filter, plan, result)
            PlannedScanTypeScalar::SingleElement -> single(
                snapshot_region, snapshot_region_filter, plan, result)
        }
    }

    // The filter's window-relative element index — upstream derives the
    // pointer offset as `filter.base - region.base` bytes; the element model
    // divides that byte offset by the scan alignment to index the decoded
    // window.
    state iterative(
        snapshot_region: &SnapshotRegion,
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        result: SnapshotRegionFilterCollection
    ) -> SnapshotRegionFilterCollection
    {
        let mut scan: ScalarIterativeScan = ScalarIterativeScan::new(snapshot_region_filter, plan);
        let mut collected: SnapshotRegionFilterCollection = result;
        let base_difference: u64 = ((snapshot_region_filter.get_base_address() as u64 in Saturating)
            - (snapshot_region.get_base_address() as u64 in Saturating)) as u64;
        let memory_alignment: MemoryAlignment = plan.get_memory_alignment();
        let alignment_size: u64 = memory_alignment.get_size_in_bytes();
        let start: u64 = ((base_difference as u64 in Saturating)
            / (alignment_size as u64 in Saturating)) as u64;
        let count: u64 = snapshot_region_filter.get_element_count(
            plan.get_unit_size_in_bytes(),
            plan.get_memory_alignment());
        let current_values: &[u64] = snapshot_region.get_current_values_slice(start, count);
        let previous_values: &[u64] = snapshot_region.get_previous_values_slice(start, count);
        ElementScanRunner::drain_iterative(&mut scan, current_values, previous_values, &mut collected);
        (collected)
    }

    // Upstream `scalar_single_element_scan`: compares the filter's single
    // element and emits either the whole-filter region or nothing — the same
    // one-or-empty result the dispatcher's pending path yields.
    state single(
        snapshot_region: &SnapshotRegion,
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        result: SnapshotRegionFilterCollection
    ) -> SnapshotRegionFilterCollection
    {
        let mut collected: SnapshotRegionFilterCollection = result;
        let base_difference: u64 = ((snapshot_region_filter.get_base_address() as u64 in Saturating)
            - (snapshot_region.get_base_address() as u64 in Saturating)) as u64;
        let memory_alignment: MemoryAlignment = plan.get_memory_alignment();
        let alignment_size: u64 = memory_alignment.get_size_in_bytes();
        let start: u64 = ((base_difference as u64 in Saturating)
            / (alignment_size as u64 in Saturating)) as u64;
        let count: u64 = snapshot_region_filter.get_element_count(
            plan.get_unit_size_in_bytes(),
            plan.get_memory_alignment());
        let current_values: &[u64] = snapshot_region.get_current_values_slice(start, count);
        let previous_values: &[u64] = snapshot_region.get_previous_values_slice(start, count);
        transition current_values.len > 0 && previous_values.len > 0 {
            true -> eval(current_values, previous_values, snapshot_region_filter, plan, collected)
            false -> (collected)
            _ -> (collected)
        }
    }

    state eval(
        current_values: &[u64],
        previous_values: &[u64],
        snapshot_region_filter: &SnapshotRegionFilter,
        plan: &SnapshotFilterElementScanPlan,
        collected: SnapshotRegionFilterCollection
    ) -> SnapshotRegionFilterCollection {
        let emitted: EmittedRegion = ScannerScalarSingleElement::scan_region(
            snapshot_region_filter,
            plan,
            current_values[0],
            previous_values[0]);
        let mut collected_inner: SnapshotRegionFilterCollection = collected;
        transition emitted {
            EmittedRegion::Region { region } -> push(collected_inner, region)
            EmittedRegion::Empty -> (collected_inner)
            _ -> (collected_inner)
        }
    }

    state push(
        collected: SnapshotRegionFilterCollection,
        region: SnapshotRegionFilter
    ) -> SnapshotRegionFilterCollection {
        let mut inner: SnapshotRegionFilterCollection = collected;
        let pushed: bool = inner.push_filter(&region);
        transition pushed {
            true -> (inner)
            false -> (inner)
            _ -> (inner)
        }
    }
}

// Upstream `scalar_iterative_scan`'s driver loop: pull `next` until
// `EmittedRegion::Empty`, appending each emitted region in order. Kept as a
// sibling machine so the mutable scanner and collection can ride `&mut`
// params through the state chain — state params cannot hold mutable locals.
pub machine ElementScanRunner::drain_iterative(
    scan: &mut ScalarIterativeScan,
    current_values: &[u64],
    previous_values: &[u64],
    collected: &mut SnapshotRegionFilterCollection
) {
    transition { _ -> pump(scan, current_values, previous_values, collected) }

    state pump(
        scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        collected: &mut SnapshotRegionFilterCollection
    ) {
        let emitted: EmittedRegion = scan.next(current_values, previous_values);
        transition emitted {
            EmittedRegion::Region { region } -> collect(
                scan, current_values, previous_values, collected, region)
            EmittedRegion::Empty -> done()
            _ -> done()
        }
    }

    state collect(
        scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        collected: &mut SnapshotRegionFilterCollection,
        region: SnapshotRegionFilter
    ) {
        let pushed: bool = collected.push_filter(&region);
        transition pushed {
            true -> pump(scan, current_values, previous_values, collected)
            false -> done()
            _ -> done()
        }
    }

    state done() {
    }
}

// Upstream's vector scanner drain (`take_result_regions` at end of
// scan_region): pull `next` until `Empty`, appending each emitted region —
// the vector drivers consume the same decoded element windows as the
// iterative drain.
pub machine ElementScanRunner::drain_vector(
    scan: &mut VectorElementScan,
    current_values: &[u64],
    previous_values: &[u64],
    collected: &mut SnapshotRegionFilterCollection
) {
    transition { _ -> pump(scan, current_values, previous_values, collected) }

    state pump(
        scan: &mut VectorElementScan,
        current_values: &[u64],
        previous_values: &[u64],
        collected: &mut SnapshotRegionFilterCollection
    ) {
        let emitted: EmittedRegion = scan.next(current_values, previous_values);
        transition emitted {
            EmittedRegion::Region { region } -> collect(
                scan, current_values, previous_values, collected, region)
            EmittedRegion::Empty -> done()
            _ -> done()
        }
    }

    state collect(
        scan: &mut VectorElementScan,
        current_values: &[u64],
        previous_values: &[u64],
        collected: &mut SnapshotRegionFilterCollection,
        region: SnapshotRegionFilter
    ) {
        let pushed: bool = collected.push_filter(&region);
        transition pushed {
            true -> pump(scan, current_values, previous_values, collected)
            false -> done()
            _ -> done()
        }
    }

    state done() {
    }
}

// Upstream's byte-array scanner drain (`take_result_regions` at end of
// scan_region): pull `next` until `Empty`, appending each emitted region.
// The byte-array scan ignores previous values; `current_values` fills both
// slots — the dispatcher's same-convention arm documents the window itself.
pub machine ElementScanRunner::drain_byte_array(
    scan: &mut ScalarByteArrayScan,
    current_values: &[u64],
    collected: &mut SnapshotRegionFilterCollection
) {
    transition { _ -> pump(scan, current_values, collected) }

    state pump(
        scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        collected: &mut SnapshotRegionFilterCollection
    ) {
        let emitted: EmittedRegion = scan.next(current_values, current_values);
        transition emitted {
            EmittedRegion::Region { region } -> collect(
                scan, current_values, collected, region)
            EmittedRegion::Empty -> done()
            _ -> done()
        }
    }

    state collect(
        scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        collected: &mut SnapshotRegionFilterCollection,
        region: SnapshotRegionFilter
    ) {
        let pushed: bool = collected.push_filter(&region);
        transition pushed {
            true -> pump(scan, current_values, collected)
            false -> done()
            _ -> done()
        }
    }

    state done() {
    }
}
