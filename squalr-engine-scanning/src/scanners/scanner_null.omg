module src::scanners::scanner_null;

use src::scanners::snapshot_scanner::Scanner;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::EmittedRegion;

// Port of scanners/scanner_null.rs: the scanner `acquire_scanner_instance`
// binds for `PlannedScanType::Invalid` — produces no results for any
// region.
pub data ScannerNull {
}

pub machine ScannerNull::new() -> ScannerNull {
    ScannerNull {
    }
}

pub machine ScannerNull::next(
    &mut self,
    current_values: &[u64],
    previous_values: &[u64]
) -> EmittedRegion
satisfies Scanner::next
{
    EmittedRegion::Empty
}

// Upstream `get_scanner_name` (`"Null Scanner"`, 12 bytes) — surfaced as the
// owned len/byte pair per the borrowed-string convention.
pub machine ScannerNull::get_scanner_name_len(&self) -> u64
satisfies Scanner::get_scanner_name_len
{
    12
}

pub machine ScannerNull::get_scanner_name_byte(
    &self,
    position: u64
) -> u8
satisfies Scanner::get_scanner_name_byte
{
    transition position < 12 {
        true -> read(position)
        _ -> (0)
    }

    state read(&self, position: u64) -> u8 {
        transition position < 12 {
            true -> take(position)
            _ -> (0)
        }
    }

    state take(&self, position: u64 [0..12]) -> u8 {
        "Null Scanner"[position]
    }
}
