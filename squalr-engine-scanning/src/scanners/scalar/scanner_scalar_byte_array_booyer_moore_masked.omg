module src::scanners::scalar::scanner_scalar_byte_array_booyer_moore_masked;

use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_api::src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use src::scanners::snapshot_scanner::Scanner;
use src::scanners::scalar::scanner_scalar_byte_array_booyer_moore::ScalarByteArrayScan;

// Port of scalar/scanner_scalar_byte_array_booyer_moore_masked.rs: the masked
// byte-array scan. Upstream's scanner shares the unmasked file's algorithm
// verbatim except its shift is recomputed per mismatch by the backward
// mask-aware walk — here that is the same `ScalarByteArrayScan` driver with
// `has_mask` set (see scanner_scalar_byte_array_booyer_moore.omg for the
// record + `masked_safe_mismatch_shift`), and its `scan_mask` carries the
// constraint's mask word unpacked little-endian like the pattern.
//
// Upstream also validates `scan_pattern.len() == scan_mask.len()` and the
// mask's presence before scanning; both are already guaranteed by the
// `supported`/`has_mask` construction gate — a masked plan without mask
// bytes selects the unmasked driver upstream only via its log-and-empty
// error arms, which `supported: false` reproduces.
pub data ScannerScalarByteArrayBooyerMooreMasked {}

pub machine ScannerScalarByteArrayBooyerMooreMasked::new(
    snapshot_region_filter: &SnapshotRegionFilter,
    snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan
) -> ScalarByteArrayScan {
    ScalarByteArrayScan::new(
        snapshot_region_filter,
        snapshot_filter_element_scan_plan,
        true
    )
}

// Upstream `get_scanner_name` (`"Byte Array (Masked Booyer-Moore)"`, 32
// bytes) — len/byte pair per the borrowed-string convention.
pub machine ScannerScalarByteArrayBooyerMooreMasked::get_scanner_name_len(&self) -> u64
satisfies Scanner::get_scanner_name_len
{
    32
}

pub machine ScannerScalarByteArrayBooyerMooreMasked::get_scanner_name_byte(
    &self,
    position: u64
) -> u8
satisfies Scanner::get_scanner_name_byte
{
    transition position < 32 {
        true -> read(position)
        _ -> (0)
    }

    state read(&self, position: u64) -> u8 {
        transition position < 32 {
            true -> take(position)
            _ -> (0)
        }
    }

    state take(&self, position: u64 [0..32]) -> u8 {
        "Byte Array (Masked Booyer-Moore)"[position]
    }
}
