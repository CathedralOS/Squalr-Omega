use {squalr_engine_api}/src/structures/data_types/floating_point_tolerance.omg;
use {squalr_engine_api}/src/structures/scanning/comparisons/scan_compare_type.omg;
use {squalr_engine_api}/src/structures/scanning/comparisons/scan_function_scalar.omg;
use {squalr_engine_api}/src/structures/scanning/filters/snapshot_region_filter.omg;
use {squalr_engine_api}/src/structures/scanning/plans/element_scan/snapshot_filter_element_scan_plan.omg;
use src/scanners/structures/snapshot_region_filter_run_length_encoder.omg;

// Port of ScannerScalarSingleElement::scan_region: compare one supplied element
// and emit the caller-provided region exactly when it matches — upstream
// discards the encoder-produced run and returns the input region wholesale.
// Upstream ScannerScalarSingleElement is a unit struct used as a namespace;
// a marker field keeps it constructible under data declarations.
public data ScannerScalarSingleElement [copy] {
    marker: bool;
}

public machine ScannerScalarSingleElement::scan_region(
    snapshot_region_filter: &|snapshot_region_filter|::SnapshotRegionFilter,
    snapshot_filter_element_scan_plan: &|snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan,
    current_value: u64,
    previous_value: u64
) -> |snapshot_region_filter_run_length_encoder|::EmittedRegion {
    let hoist1: bool = |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::has_scan_function_scalar(&snapshot_filter_element_scan_plan);
    transition hoist1 {
        true -> by_kind(
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_scan_function_scalar(&snapshot_filter_element_scan_plan),
            snapshot_region_filter,
            snapshot_filter_element_scan_plan,
            current_value,
            previous_value
        )
        _ -> (|snapshot_region_filter_run_length_encoder|::EmittedRegion::Empty)
    }

    machine by_kind(
        scalar_function: |scan_function_scalar|::ScanFunctionScalar,
        snapshot_region_filter: &|snapshot_region_filter|::SnapshotRegionFilter,
        snapshot_filter_element_scan_plan: &|snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan,
        current_value: u64,
        previous_value: u64
    ) -> |snapshot_region_filter_run_length_encoder|::EmittedRegion {
        transition scalar_function {
            |scan_function_scalar|::ScanFunctionScalar::Immediate -> eval_immediate(
                snapshot_region_filter,
                snapshot_filter_element_scan_plan,
                current_value
            )
            |scan_function_scalar|::ScanFunctionScalar::RelativeOrDelta -> eval_relative(
                snapshot_region_filter,
                snapshot_filter_element_scan_plan,
                current_value,
                previous_value
            )
        }
    }

    machine eval_immediate(
        snapshot_region_filter: &|snapshot_region_filter|::SnapshotRegionFilter,
        snapshot_filter_element_scan_plan: &|snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan,
        current_value: u64
    ) -> |snapshot_region_filter_run_length_encoder|::EmittedRegion {
        let compare_type: |scan_compare_type|::ScanCompareType =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_scan_compare_type(&snapshot_filter_element_scan_plan);
        let operand_value: u64 =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_operand_value(&snapshot_filter_element_scan_plan);
        let is_signed: bool =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_is_signed(&snapshot_filter_element_scan_plan);
        let is_floating_point: bool =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_is_floating_point(&snapshot_filter_element_scan_plan);
        let floating_point_tolerance: |floating_point_tolerance|::FloatingPointTolerance =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_floating_point_tolerance(&snapshot_filter_element_scan_plan);
        let element_size_in_bytes: u64 =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_unit_size_in_bytes(&snapshot_filter_element_scan_plan);
        let matched: bool = |scan_compare_type|::ScanCompareType::compare_typed(&compare_type, current_value,
            0,
            operand_value,
            is_signed,
            is_floating_point,
            floating_point_tolerance,
            element_size_in_bytes);
        transition matched {
            true -> hit(snapshot_region_filter)
            false -> miss()
        }
    }

    machine eval_relative(
        snapshot_region_filter: &|snapshot_region_filter|::SnapshotRegionFilter,
        snapshot_filter_element_scan_plan: &|snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan,
        current_value: u64,
        previous_value: u64
    ) -> |snapshot_region_filter_run_length_encoder|::EmittedRegion {
        let compare_type: |scan_compare_type|::ScanCompareType =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_scan_compare_type(&snapshot_filter_element_scan_plan);
        let operand_value: u64 =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_operand_value(&snapshot_filter_element_scan_plan);
        let is_signed: bool =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_is_signed(&snapshot_filter_element_scan_plan);
        let is_floating_point: bool =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_is_floating_point(&snapshot_filter_element_scan_plan);
        let floating_point_tolerance: |floating_point_tolerance|::FloatingPointTolerance =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_floating_point_tolerance(&snapshot_filter_element_scan_plan);
        let element_size_in_bytes: u64 =
            |snapshot_filter_element_scan_plan|::SnapshotFilterElementScanPlan::get_unit_size_in_bytes(&snapshot_filter_element_scan_plan);
        let matched: bool = |scan_compare_type|::ScanCompareType::compare_typed(&compare_type, current_value,
            previous_value,
            operand_value,
            is_signed,
            is_floating_point,
            floating_point_tolerance,
            element_size_in_bytes);
        transition matched {
            true -> hit(snapshot_region_filter)
            false -> miss()
        }
    }

    machine hit(snapshot_region_filter: &|snapshot_region_filter|::SnapshotRegionFilter) -> |snapshot_region_filter_run_length_encoder|::EmittedRegion {
        let hoist2: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_region_size(&snapshot_region_filter);
        |snapshot_region_filter_run_length_encoder|::EmittedRegion::Region {
            region: |snapshot_region_filter|::SnapshotRegionFilter::new(
                |snapshot_region_filter|::SnapshotRegionFilter::get_base_address(&snapshot_region_filter),
                hoist2
            )
        }
    }

    machine miss() -> |snapshot_region_filter_run_length_encoder|::EmittedRegion {
        |snapshot_region_filter_run_length_encoder|::EmittedRegion::Empty
    }
}
