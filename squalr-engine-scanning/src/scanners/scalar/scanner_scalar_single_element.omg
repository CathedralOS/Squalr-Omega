module src::scanners::scalar::scanner_scalar_single_element;

use squalr_engine_api::src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use squalr_engine_api::src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use squalr_engine_api::src::structures::scanning::comparisons::scan_function_scalar::ScanFunctionScalar;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_api::src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::EmittedRegion;

// Port of ScannerScalarSingleElement::scan_region: compare one supplied element
// and emit the caller-provided region exactly when it matches — upstream
// discards the encoder-produced run and returns the input region wholesale.
// Upstream ScannerScalarSingleElement is a unit struct used as a namespace;
// a marker field keeps it constructible under data declarations.
pub data ScannerScalarSingleElement [copy] {
    marker: bool;
}

pub machine ScannerScalarSingleElement::scan_region(
    snapshot_region_filter: &SnapshotRegionFilter,
    snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan,
    current_value: u64,
    previous_value: u64
) -> EmittedRegion {
    transition SnapshotFilterElementScanPlan::has_scan_function_scalar(snapshot_filter_element_scan_plan) {
        true -> by_kind(
            SnapshotFilterElementScanPlan::get_scan_function_scalar(snapshot_filter_element_scan_plan),
            snapshot_region_filter,
            snapshot_filter_element_scan_plan,
            current_value,
            previous_value
        )
        _ -> (EmittedRegion::Empty)
    }

    state by_kind(
        scalar_function: ScanFunctionScalar,
        snapshot_region_filter: &SnapshotRegionFilter,
        snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan,
        current_value: u64,
        previous_value: u64
    ) -> EmittedRegion {
        transition scalar_function {
            ScanFunctionScalar::Immediate -> eval_immediate(
                snapshot_region_filter,
                snapshot_filter_element_scan_plan,
                current_value
            )
            ScanFunctionScalar::RelativeOrDelta -> eval_relative(
                snapshot_region_filter,
                snapshot_filter_element_scan_plan,
                current_value,
                previous_value
            )
        }
    }

    state eval_immediate(
        snapshot_region_filter: &SnapshotRegionFilter,
        snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan,
        current_value: u64
    ) -> EmittedRegion {
        let compare_type: ScanCompareType =
            SnapshotFilterElementScanPlan::get_scan_compare_type(snapshot_filter_element_scan_plan);
        let operand_value: u64 =
            SnapshotFilterElementScanPlan::get_operand_value(snapshot_filter_element_scan_plan);
        let is_signed: bool =
            SnapshotFilterElementScanPlan::get_is_signed(snapshot_filter_element_scan_plan);
        let is_floating_point: bool =
            SnapshotFilterElementScanPlan::get_is_floating_point(snapshot_filter_element_scan_plan);
        let floating_point_tolerance: FloatingPointTolerance =
            SnapshotFilterElementScanPlan::get_floating_point_tolerance(snapshot_filter_element_scan_plan);
        let element_size_in_bytes: u64 =
            SnapshotFilterElementScanPlan::get_unit_size_in_bytes(snapshot_filter_element_scan_plan);
        let matched: bool = ScanCompareType::compare_typed(&compare_type, 
            current_value,
            0,
            operand_value,
            is_signed,
            is_floating_point,
            floating_point_tolerance,
            element_size_in_bytes
        );
        transition matched {
            true -> hit(snapshot_region_filter)
            false -> miss()
        }
    }

    state eval_relative(
        snapshot_region_filter: &SnapshotRegionFilter,
        snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan,
        current_value: u64,
        previous_value: u64
    ) -> EmittedRegion {
        let compare_type: ScanCompareType =
            SnapshotFilterElementScanPlan::get_scan_compare_type(snapshot_filter_element_scan_plan);
        let operand_value: u64 =
            SnapshotFilterElementScanPlan::get_operand_value(snapshot_filter_element_scan_plan);
        let is_signed: bool =
            SnapshotFilterElementScanPlan::get_is_signed(snapshot_filter_element_scan_plan);
        let is_floating_point: bool =
            SnapshotFilterElementScanPlan::get_is_floating_point(snapshot_filter_element_scan_plan);
        let floating_point_tolerance: FloatingPointTolerance =
            SnapshotFilterElementScanPlan::get_floating_point_tolerance(snapshot_filter_element_scan_plan);
        let element_size_in_bytes: u64 =
            SnapshotFilterElementScanPlan::get_unit_size_in_bytes(snapshot_filter_element_scan_plan);
        let matched: bool = ScanCompareType::compare_typed(&compare_type, 
            current_value,
            previous_value,
            operand_value,
            is_signed,
            is_floating_point,
            floating_point_tolerance,
            element_size_in_bytes
        );
        transition matched {
            true -> hit(snapshot_region_filter)
            false -> miss()
        }
    }

    state hit(snapshot_region_filter: &SnapshotRegionFilter) -> EmittedRegion {
        EmittedRegion::Region {
            region: SnapshotRegionFilter::new(
                SnapshotRegionFilter::get_base_address(snapshot_region_filter),
                SnapshotRegionFilter::get_region_size(snapshot_region_filter)
            )
        }
    }

    state miss() -> EmittedRegion {
        EmittedRegion::Empty
    }
}
