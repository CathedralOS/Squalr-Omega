module src::scanners::scalar::scanner_scalar_iterative;

use squalr_engine_api::src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use squalr_engine_api::src::structures::scanning::comparisons::scan_function_scalar::ScanFunctionScalar;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_api::src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use src::scanners::snapshot_scanner::Scanner;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::EmittedRegion;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::SnapshotRegionFilterRunLengthEncoder;

// Port of ScannerScalarIterative over a typed u64 element window. Upstream
// walks raw bytes by memory_alignment and reinterpret-loads each element;
// here the caller supplies the decoded element views, so one iteration covers
// one element (unit_size bytes) of the window — the byte-level decode and
// sub-unit alignment reads land with the snapshot/value layer.
//
// Upstream returns `Vec<SnapshotRegionFilter>` eagerly. Vec construction does
// not exist in Omega yet (Allocation<T>/Arena surface), so the scan is a pull
// driver: `next` walks elements until the encoder emits a region or the window
// is exhausted, and the caller drains until EmittedRegion::Empty. The emitted
// regions are identical and in the same order; nothing is capacity-truncated.
//
// Sibling-length bounds (`index: u64 [0..current_values.len]`) make each
// element load a proven index; every leaf state is entered under a guard
// restating the bound the callee declares.
pub data ScalarIterativeScan {
    encoder: SnapshotRegionFilterRunLengthEncoder;
    index: u64;
    element_count: u64;
    stride_bytes: u64;
    length_padding: u64;
    compare_type: ScanCompareType;
    operand_value: u64;
    has_scan_function: bool;
    scan_function: ScanFunctionScalar;
    // Element interpretation for the typed compare — upstream's
    // PrimitiveType closure parameters (signedness, float-ness, element
    // width) carried as fields since the closure's capture becomes the
    // scanner's own record here.
    is_signed: bool;
    is_floating_point: bool;
    floating_point_tolerance: FloatingPointTolerance;
    element_size_in_bytes: u64;
    finalized_tail: bool;
}

pub machine ScalarIterativeScan::new(
    snapshot_region_filter: &SnapshotRegionFilter,
    plan: &SnapshotFilterElementScanPlan
) -> ScalarIterativeScan
crashes Abort
{
    let memory_alignment: MemoryAlignment = SnapshotFilterElementScanPlan::get_memory_alignment(plan);
    let memory_alignment_size: u64 = MemoryAlignment::get_size_in_bytes(&memory_alignment);
    let data_type_size: u64 = SnapshotFilterElementScanPlan::get_unit_size_in_bytes(plan);
    ScalarIterativeScan {
        encoder: SnapshotRegionFilterRunLengthEncoder::new(
            SnapshotRegionFilter::get_base_address(snapshot_region_filter)
        ),
        index: 0,
        element_count: SnapshotRegionFilter::get_element_count(snapshot_region_filter, 
            data_type_size,
            memory_alignment
        ),
        // Upstream advances the encoder by memory_alignment_size per element
        // (candidate stride), not the data-type width.
        stride_bytes: memory_alignment_size as u64,
        length_padding: ((data_type_size as u64 in Saturating)
            - (memory_alignment_size as u64 in Saturating)) as u64,
        compare_type: SnapshotFilterElementScanPlan::get_scan_compare_type(plan),
        operand_value: SnapshotFilterElementScanPlan::get_operand_value(plan),
        has_scan_function: SnapshotFilterElementScanPlan::has_scan_function_scalar(plan),
        scan_function: SnapshotFilterElementScanPlan::get_scan_function_scalar(plan),
        is_signed: SnapshotFilterElementScanPlan::get_is_signed(plan),
        is_floating_point: SnapshotFilterElementScanPlan::get_is_floating_point(plan),
        floating_point_tolerance: SnapshotFilterElementScanPlan::get_floating_point_tolerance(plan),
        element_size_in_bytes: data_type_size,
        finalized_tail: false,
    }
}

// Pulls the next emitted region. `current` is the decoded element window of the
// filter's memory and `previous` the prior scan's values for relative/delta
// compares (pass `current` for immediate scans). Elements beyond the shorter
// input simply do not match.
pub machine ScalarIterativeScan::next(
    scalar_iterative_scan: &mut ScalarIterativeScan,
    current_values: &[u64],
    previous_values: &[u64]
) -> EmittedRegion satisfies Scanner::next {
    transition scalar_iterative_scan.finalized_tail {
        true -> arm_result_80_0()
        false -> pump(scalar_iterative_scan, current_values, previous_values)
        _ -> pump(scalar_iterative_scan, current_values, previous_values)
    }

    state pump(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64]
    ) -> EmittedRegion {
        transition scalar_iterative_scan.index < scalar_iterative_scan.element_count {
            true -> in_bounds(scalar_iterative_scan, current_values, previous_values)
            false -> finish(scalar_iterative_scan)
        }
    }

    state in_bounds(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64]
    ) -> EmittedRegion {
        transition scalar_iterative_scan.index < current_values.len {
            true -> step(scalar_iterative_scan, current_values, previous_values, scalar_iterative_scan.index)
            false -> finish(scalar_iterative_scan)
            _ -> finish(scalar_iterative_scan)
        }
    }

    state step(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition scalar_iterative_scan.has_scan_function {
            true -> by_kind(scalar_iterative_scan, current_values, previous_values, index)
            false -> miss_gate(scalar_iterative_scan, current_values, previous_values, index)
            _ -> miss_gate(scalar_iterative_scan, current_values, previous_values, index)
        }
    }

    state by_kind(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition scalar_iterative_scan.scan_function {
            ScanFunctionScalar::Immediate -> immediate_gate(scalar_iterative_scan, 
                current_values,
                previous_values,
                index
            )
            ScanFunctionScalar::RelativeOrDelta -> relative_gate(scalar_iterative_scan, 
                current_values,
                previous_values,
                index
            )
        }
    }

    state immediate_gate(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition index < current_values.len {
            true -> eval_immediate(scalar_iterative_scan, current_values, previous_values, index)
            _ -> finish(scalar_iterative_scan)
        }
    }

    state relative_gate(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition index < previous_values.len {
            true -> relative_gate_current(scalar_iterative_scan, current_values, previous_values, index, index)
            false -> miss_gate(scalar_iterative_scan, current_values, previous_values, index)
            _ -> miss_gate(scalar_iterative_scan, current_values, previous_values, index)
        }
    }

    state relative_gate_current(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64,
        previous_index: u64
    ) -> EmittedRegion
    requires 0 <= previous_index && previous_index < previous_values.len;
    {
        // previous_index's bound was established on relative_gate's arm; here
        // the element is already read so only `index` needs its current guard.
        let previous_element: u64 = previous_values[previous_index];
        transition index < current_values.len {
            true -> eval_relative(scalar_iterative_scan, current_values, previous_values, index, previous_element)
            _ -> finish(scalar_iterative_scan)
        }
    }

    state eval_immediate(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion
    requires 0 <= index && index < current_values.len;
    {
        let matched: bool = ScanCompareType::compare_typed(&scalar_iterative_scan.compare_type, 
            current_values[index],
            0,
            scalar_iterative_scan.operand_value,
            scalar_iterative_scan.is_signed,
            scalar_iterative_scan.is_floating_point,
            scalar_iterative_scan.floating_point_tolerance,
            scalar_iterative_scan.element_size_in_bytes);
        transition matched {
            true -> hit_gate(scalar_iterative_scan, current_values, previous_values, index)
            false -> miss_gate(scalar_iterative_scan, current_values, previous_values, index)
        }
    }

    state eval_relative(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64,
        previous_element: u64
    ) -> EmittedRegion
    requires 0 <= index && index < current_values.len;
    {
        let matched: bool = ScanCompareType::compare_typed(&scalar_iterative_scan.compare_type, 
            current_values[index],
            previous_element,
            scalar_iterative_scan.operand_value,
            scalar_iterative_scan.is_signed,
            scalar_iterative_scan.is_floating_point,
            scalar_iterative_scan.floating_point_tolerance,
            scalar_iterative_scan.element_size_in_bytes
        );
        transition matched {
            true -> hit_gate(scalar_iterative_scan, current_values, previous_values, index)
            false -> miss_gate(scalar_iterative_scan, current_values, previous_values, index)
        }
    }

    state hit_gate(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition index < current_values.len {
            true -> hit(scalar_iterative_scan, current_values, previous_values, index)
            _ -> finish(scalar_iterative_scan)
        }
    }

    state miss_gate(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition index < current_values.len {
            true -> miss(scalar_iterative_scan, current_values, previous_values, index)
            _ -> finish(scalar_iterative_scan)
        }
    }

    state hit(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion
    requires 0 <= index && index < current_values.len;
    {
        SnapshotRegionFilterRunLengthEncoder::encode_range(&mut scalar_iterative_scan.encoder, scalar_iterative_scan.stride_bytes);
        scalar_iterative_scan.index = index + 1;
        transition { _ -> pump(scalar_iterative_scan, current_values, previous_values) }
    }

    state miss(
        scalar_iterative_scan: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion
    requires 0 <= index && index < current_values.len;
    {
        let emitted: EmittedRegion = scalar_iterative_scan
            .encoder
            .finalize_current_encode_with_padding(scalar_iterative_scan.stride_bytes, scalar_iterative_scan.length_padding);
        scalar_iterative_scan.index = index + 1;
        let emitted_has_region: bool = EmittedRegion::is_region(&emitted);
        transition emitted_has_region {
            true -> (emitted)
            _ -> pump(scalar_iterative_scan, current_values, previous_values)
        }
    }

    state finish(scalar_iterative_scan: &mut ScalarIterativeScan) -> EmittedRegion {
        transition scalar_iterative_scan.finalized_tail {
            true -> arm_result_278_0()
            false -> tail_finalize(scalar_iterative_scan)
            _ -> tail_finalize(scalar_iterative_scan)
        }
    }

    state tail_finalize(scalar_iterative_scan: &mut ScalarIterativeScan) -> EmittedRegion {
        // One-shot tail emission: upstream's post-loop finalize. An open run at
        // end-of-window is closed and emitted; afterwards `next` is done
        // regardless of further calls.
        scalar_iterative_scan.finalized_tail = true;
        let emitted: EmittedRegion = scalar_iterative_scan
            .encoder
            .finalize_current_encode_with_padding(scalar_iterative_scan.stride_bytes, scalar_iterative_scan.length_padding);
        let emitted_has_region: bool = EmittedRegion::is_region(&emitted);
        transition emitted_has_region {
            true -> (emitted)
            _ -> (EmittedRegion::Empty)
        }
    }
    state arm_result_80_0() -> EmittedRegion
    {
        (EmittedRegion::Empty)
    }
    state arm_result_278_0() -> EmittedRegion
    {
        (EmittedRegion::Empty)
    }
}

// Upstream `get_scanner_name` (`"Scalar Iterative"`, 16 bytes) — len/byte
// pair per the borrowed-string convention.
pub machine ScalarIterativeScan::get_scanner_name_len(scalar_iterative_scan: &ScalarIterativeScan) -> u64
satisfies Scanner::get_scanner_name_len
{
    16
}

pub machine ScalarIterativeScan::get_scanner_name_byte(
    scalar_iterative_scan: &ScalarIterativeScan,
    position: u64
) -> u8
satisfies Scanner::get_scanner_name_byte
{
    transition position < 16 {
        true -> read(scalar_iterative_scan, position)
        _ -> (0)
    }

    state read(scalar_iterative_scan: &ScalarIterativeScan, position: u64) -> u8 {
        transition position < 16 {
            true -> take(scalar_iterative_scan, position)
            _ -> (0)
        }
    }

    state take(scalar_iterative_scan: &ScalarIterativeScan, position: u64) -> u8
    requires 0 <= position && position < 16;
    {
        "Scalar Iterative"[position]
    }
}
