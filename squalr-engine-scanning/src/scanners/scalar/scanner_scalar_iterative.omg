module src::scanners::scalar::scanner_scalar_iterative;

use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use squalr_engine_api::src::structures::scanning::comparisons::scan_function_scalar::ScanFunctionScalar;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_api::src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::EmittedRegion;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::SnapshotRegionFilterRunLengthEncoder;

// Port of ScannerScalarIterative over a typed u64 element window. Upstream
// walks raw bytes by memory_alignment and reinterpret-loads each element;
// here the caller supplies the decoded element views, so one iteration covers
// one element (unit_size bytes) of the window — the byte-level decode and
// sub-unit alignment reads land with the snapshot/value layer.
//
// Upstream returns `Vec<SnapshotRegionFilter>` eagerly. Vec construction does
// not exist in Omega yet (Allocation<T>/Arena surface), so the scan is a pull
// driver: `next` walks elements until the encoder emits a region or the window
// is exhausted, and the caller drains until EmittedRegion::Empty. The emitted
// regions are identical and in the same order; nothing is capacity-truncated.
//
// Sibling-length bounds (`index: u64 [0..current_values.len]`) make each
// element load a proven index; every leaf state is entered under a guard
// restating the bound the callee declares.
pub data ScalarIterativeScan {
    encoder: SnapshotRegionFilterRunLengthEncoder;
    index: u64;
    element_count: u64;
    stride_bytes: u64;
    length_padding: u64;
    compare_type: ScanCompareType;
    operand_value: u64;
    has_scan_function: bool;
    scan_function: ScanFunctionScalar;
    finalized_tail: bool;
}

pub machine ScalarIterativeScan::new(
    snapshot_region_filter: &SnapshotRegionFilter,
    plan: &SnapshotFilterElementScanPlan
) -> ScalarIterativeScan
crashes Abort
{
    let memory_alignment: MemoryAlignment = plan.get_memory_alignment();
    let memory_alignment_size: u64 = memory_alignment.get_size_in_bytes();
    let data_type_size: u64 = plan.get_unit_size_in_bytes();
    ScalarIterativeScan {
        encoder: SnapshotRegionFilterRunLengthEncoder::new(
            snapshot_region_filter.get_base_address()
        ),
        index: 0,
        element_count: snapshot_region_filter.get_element_count(
            data_type_size,
            memory_alignment
        ),
        stride_bytes: data_type_size,
        length_padding: ((data_type_size as u64 in Saturating)
            - (memory_alignment_size as u64 in Saturating)) as u64,
        compare_type: plan.get_scan_compare_type(),
        operand_value: plan.get_operand_value(),
        has_scan_function: plan.has_scan_function_scalar(),
        scan_function: plan.get_scan_function_scalar(),
        finalized_tail: false,
    }
}

// Pulls the next emitted region. `current` is the decoded element window of the
// filter's memory and `previous` the prior scan's values for relative/delta
// compares (pass `current` for immediate scans). Elements beyond the shorter
// input simply do not match.
pub machine ScalarIterativeScan::next(
    &mut self,
    current_values: &[u64],
    previous_values: &[u64]
) -> EmittedRegion {
    transition self.finalized_tail {
        true -> (EmittedRegion::Empty)
        false -> pump(current_values, previous_values)
        _ -> pump(current_values, previous_values)
    }

    state pump(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64]
    ) -> EmittedRegion {
        transition self.index < self.element_count {
            true -> in_bounds(current_values, previous_values)
            false -> finish()
        }
    }

    state in_bounds(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64]
    ) -> EmittedRegion {
        transition self.index < current_values.len {
            true -> step(current_values, previous_values, self.index)
            false -> finish()
            _ -> finish()
        }
    }

    state step(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition self.has_scan_function {
            true -> by_kind(current_values, previous_values, index)
            false -> miss_gate(current_values, previous_values, index)
            _ -> miss_gate(current_values, previous_values, index)
        }
    }

    state by_kind(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition self.scan_function {
            ScanFunctionScalar::Immediate -> immediate_gate(
                current_values,
                previous_values,
                index
            )
            ScanFunctionScalar::RelativeOrDelta -> relative_gate(
                current_values,
                previous_values,
                index
            )
        }
    }

    state immediate_gate(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition index < current_values.len {
            true -> eval_immediate(current_values, previous_values, index)
            _ -> finish()
        }
    }

    state relative_gate(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition index < previous_values.len {
            true -> relative_gate_current(current_values, previous_values, index, index)
            false -> miss_gate(current_values, previous_values, index)
            _ -> miss_gate(current_values, previous_values, index)
        }
    }

    state relative_gate_current(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64,
        previous_index: u64 [0..previous_values.len]
    ) -> EmittedRegion {
        // previous_index's bound was established on relative_gate's arm; here
        // the element is already read so only `index` needs its current guard.
        let previous_element: u64 = previous_values[previous_index];
        transition index < current_values.len {
            true -> eval_relative(current_values, previous_values, index, previous_element)
            _ -> finish()
        }
    }

    state eval_immediate(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64 [0..current_values.len]
    ) -> EmittedRegion {
        let matched: bool =
            self.compare_type.compare(current_values[index], 0, self.operand_value);
        transition matched {
            true -> hit_gate(current_values, previous_values, index)
            false -> miss_gate(current_values, previous_values, index)
        }
    }

    state eval_relative(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64 [0..current_values.len],
        previous_element: u64
    ) -> EmittedRegion {
        let matched: bool = self.compare_type.compare(
            current_values[index],
            previous_element,
            self.operand_value
        );
        transition matched {
            true -> hit_gate(current_values, previous_values, index)
            false -> miss_gate(current_values, previous_values, index)
        }
    }

    state hit_gate(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition index < current_values.len {
            true -> hit(current_values, previous_values, index)
            _ -> finish()
        }
    }

    state miss_gate(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition index < current_values.len {
            true -> miss(current_values, previous_values, index)
            _ -> finish()
        }
    }

    state hit(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64 [0..current_values.len]
    ) -> EmittedRegion {
        self.encoder.encode_range(self.stride_bytes);
        self.index = index + 1;
        pump(current_values, previous_values)
    }

    state miss(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64 [0..current_values.len]
    ) -> EmittedRegion {
        let emitted: EmittedRegion = self
            .encoder
            .finalize_current_encode_with_padding(self.stride_bytes, self.length_padding);
        self.index = index + 1;
        transition emitted {
            EmittedRegion::Region { region } -> (EmittedRegion::Region { region: region })
            EmittedRegion::Empty -> pump(current_values, previous_values)
            _ -> pump(current_values, previous_values)
        }
    }

    state finish(&mut self) -> EmittedRegion {
        transition self.finalized_tail {
            true -> (EmittedRegion::Empty)
            false -> tail_finalize()
            _ -> tail_finalize()
        }
    }

    state tail_finalize(&mut self) -> EmittedRegion {
        // One-shot tail emission: upstream's post-loop finalize. An open run at
        // end-of-window is closed and emitted; afterwards `next` is done
        // regardless of further calls.
        self.finalized_tail = true;
        let emitted: EmittedRegion = self
            .encoder
            .finalize_current_encode(self.stride_bytes);
        transition emitted {
            EmittedRegion::Region { region } -> (EmittedRegion::Region { region: region })
            EmittedRegion::Empty -> (EmittedRegion::Empty)
            _ -> (EmittedRegion::Empty)
        }
    }
}
