module src::scanners::scalar::scanner_scalar_iterative;

use squalr_engine_api::src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use squalr_engine_api::src::structures::scanning::comparisons::scan_function_scalar::ScanFunctionScalar;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_api::src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use src::scanners::snapshot_scanner::Scanner;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::EmittedRegion;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::SnapshotRegionFilterRunLengthEncoder;

// Port of ScannerScalarIterative over a typed u64 element window. Upstream
// walks raw bytes by memory_alignment and reinterpret-loads each element;
// here the caller supplies the decoded element views, so one iteration covers
// one element (unit_size bytes) of the window — the byte-level decode and
// sub-unit alignment reads land with the snapshot/value layer.
//
// Upstream returns `Vec<SnapshotRegionFilter>` eagerly. Vec construction does
// not exist in Omega yet (Allocation<T>/Arena surface), so the scan is a pull
// driver: `next` walks elements until the encoder emits a region or the window
// is exhausted, and the caller drains until EmittedRegion::Empty. The emitted
// regions are identical and in the same order; nothing is capacity-truncated.
//
// Sibling-length bounds (`index: u64 [0..current_values.len]`) make each
// element load a proven index; every leaf state is entered under a guard
// restating the bound the callee declares.
pub data ScalarIterativeScan {
    encoder: SnapshotRegionFilterRunLengthEncoder;
    index: u64;
    element_count: u64;
    stride_bytes: u64;
    length_padding: u64;
    compare_type: ScanCompareType;
    operand_value: u64;
    has_scan_function: bool;
    scan_function: ScanFunctionScalar;
    // Element interpretation for the typed compare — upstream's
    // PrimitiveType closure parameters (signedness, float-ness, element
    // width) carried as fields since the closure's capture becomes the
    // scanner's own record here.
    is_signed: bool;
    is_floating_point: bool;
    floating_point_tolerance: FloatingPointTolerance;
    element_size_in_bytes: u64;
    finalized_tail: bool;
}

pub machine ScalarIterativeScan::new(
    snapshot_region_filter: &SnapshotRegionFilter,
    plan: &SnapshotFilterElementScanPlan
) -> ScalarIterativeScan
crashes Abort
{
    let hoist9: FloatingPointTolerance = SnapshotFilterElementScanPlan::get_floating_point_tolerance(&plan);
    let hoist8: bool = SnapshotFilterElementScanPlan::get_is_floating_point(&plan);
    let hoist7: bool = SnapshotFilterElementScanPlan::get_is_signed(&plan);
    let hoist6: ScanFunctionScalar = SnapshotFilterElementScanPlan::get_scan_function_scalar(&plan);
    let hoist5: bool = SnapshotFilterElementScanPlan::has_scan_function_scalar(&plan);
    let hoist4: u64 = SnapshotFilterElementScanPlan::get_operand_value(&plan);
    let hoist3: ScanCompareType = SnapshotFilterElementScanPlan::get_scan_compare_type(&plan);
    let hoist2: u64 = SnapshotRegionFilter::get_element_count(&snapshot_region_filter, data_type_size,
            memory_alignment);
    let memory_alignment: MemoryAlignment = SnapshotFilterElementScanPlan::get_memory_alignment(&plan);
    let memory_alignment_size: u64 = MemoryAlignment::get_size_in_bytes(&memory_alignment);
    let data_type_size: u64 = SnapshotFilterElementScanPlan::get_unit_size_in_bytes(&plan);
    ScalarIterativeScan {
        let hoist1: u64 = SnapshotRegionFilter::get_base_address(&snapshot_region_filter);
        encoder: SnapshotRegionFilterRunLengthEncoder::new(hoist1),
        index: 0,
        element_count: hoist2,
        // Upstream advances the encoder by memory_alignment_size per element
        // (candidate stride), not the data-type width.
        stride_bytes: memory_alignment_size as u64,
        length_padding: ((data_type_size as u64 in Saturating)
            - (memory_alignment_size as u64 in Saturating)) as u64,
        compare_type: hoist3,
        operand_value: hoist4,
        has_scan_function: hoist5,
        scan_function: hoist6,
        is_signed: hoist7,
        is_floating_point: hoist8,
        floating_point_tolerance: hoist9,
        element_size_in_bytes: data_type_size,
        finalized_tail: false,
    }
}

// Pulls the next emitted region. `current` is the decoded element window of the
// filter's memory and `previous` the prior scan's values for relative/delta
// compares (pass `current` for immediate scans). Elements beyond the shorter
// input simply do not match.
pub machine ScalarIterativeScan::next(
    this: &mut ScalarIterativeScan,
    current_values: &[u64],
    previous_values: &[u64]
) -> EmittedRegion satisfies Scanner<ScalarIterativeScan>::next {
    transition this.finalized_tail {
        true -> arm_result_80_0()
        false -> pump(this, current_values, previous_values)
        _ -> pump(this, current_values, previous_values)
    }

    state pump(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64]
    ) -> EmittedRegion {
        transition this.index < this.element_count {
            true -> in_bounds(this, current_values, previous_values)
            false -> finish(this)
        }
    }

    state in_bounds(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64]
    ) -> EmittedRegion {
        transition this.index < current_values.len {
            true -> step(this, current_values, previous_values, this.index)
            false -> finish(this)
            _ -> finish(this)
        }
    }

    state step(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition this.has_scan_function {
            true -> by_kind(this, current_values, previous_values, index)
            false -> miss_gate(this, current_values, previous_values, index)
            _ -> miss_gate(this, current_values, previous_values, index)
        }
    }

    state by_kind(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition this.scan_function {
            ScanFunctionScalar::Immediate -> immediate_gate(this, 
                current_values,
                previous_values,
                index
            )
            ScanFunctionScalar::RelativeOrDelta -> relative_gate(this, 
                current_values,
                previous_values,
                index
            )
        }
    }

    state immediate_gate(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition index < current_values.len {
            true -> eval_immediate(this, current_values, previous_values, index)
            _ -> finish(this)
        }
    }

    state relative_gate(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition index < previous_values.len {
            true -> relative_gate_current(this, current_values, previous_values, index, index)
            false -> miss_gate(this, current_values, previous_values, index)
            _ -> miss_gate(this, current_values, previous_values, index)
        }
    }

    state relative_gate_current(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64,
        previous_index: u64
    ) -> EmittedRegion
    requires 0 <= previous_index && previous_index < previous_values.len;
    {
        // previous_index's bound was established on relative_gate's arm; here
        // the element is already read so only `index` needs its current guard.
        let previous_element: u64 = previous_values[previous_index];
        transition index < current_values.len {
            true -> eval_relative(this, current_values, previous_values, index, previous_element)
            _ -> finish(this)
        }
    }

    state eval_immediate(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion
    requires 0 <= index && index < current_values.len;
    {
        let matched: bool = ScanCompareType::compare_typed(&this.compare_type, current_values[index],
            0,
            this.operand_value,
            this.is_signed,
            this.is_floating_point,
            this.floating_point_tolerance,
            this.element_size_in_bytes);
        transition matched {
            true -> hit_gate(this, current_values, previous_values, index)
            false -> miss_gate(this, current_values, previous_values, index)
        }
    }

    state eval_relative(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64,
        previous_element: u64
    ) -> EmittedRegion
    requires 0 <= index && index < current_values.len;
    {
        let matched: bool = ScanCompareType::compare_typed(&this.compare_type, current_values[index],
            previous_element,
            this.operand_value,
            this.is_signed,
            this.is_floating_point,
            this.floating_point_tolerance,
            this.element_size_in_bytes);
        transition matched {
            true -> hit_gate(this, current_values, previous_values, index)
            false -> miss_gate(this, current_values, previous_values, index)
        }
    }

    state hit_gate(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition index < current_values.len {
            true -> hit(this, current_values, previous_values, index)
            _ -> finish(this)
        }
    }

    state miss_gate(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion {
        transition index < current_values.len {
            true -> miss(this, current_values, previous_values, index)
            _ -> finish(this)
        }
    }

    state hit(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion
    requires 0 <= index && index < current_values.len;
    {
        SnapshotRegionFilterRunLengthEncoder::encode_range(&mut this.encoder, this.stride_bytes);
        this.index = index + 1;
        transition { _ -> pump(this, current_values, previous_values) }
    }

    state miss(
        this: &mut ScalarIterativeScan,
        current_values: &[u64],
        previous_values: &[u64],
        index: u64
    ) -> EmittedRegion
    requires 0 <= index && index < current_values.len;
    {
        let emitted: EmittedRegion = this
            .encoder
            .finalize_current_encode_with_padding(this.stride_bytes, this.length_padding);
        this.index = index + 1;
        let emitted_has_region: bool = EmittedRegion::is_region(&emitted);
        transition emitted_has_region {
            true -> (emitted)
            _ -> pump(this, current_values, previous_values)
        }
    }

    state finish(this: &mut ScalarIterativeScan) -> EmittedRegion {
        transition this.finalized_tail {
            true -> arm_result_278_0()
            false -> tail_finalize(this)
            _ -> tail_finalize(this)
        }
    }

    state tail_finalize(this: &mut ScalarIterativeScan) -> EmittedRegion {
        // One-shot tail emission: upstream's post-loop finalize. An open run at
        // end-of-window is closed and emitted; afterwards `next` is done
        // regardless of further calls.
        this.finalized_tail = true;
        let emitted: EmittedRegion = this
            .encoder
            .finalize_current_encode_with_padding(this.stride_bytes, this.length_padding);
        let emitted_has_region: bool = EmittedRegion::is_region(&emitted);
        transition emitted_has_region {
            true -> (emitted)
            _ -> (EmittedRegion::Empty)
        }
    }
    state arm_result_80_0() -> EmittedRegion
    {
        (EmittedRegion::Empty)
    }
    state arm_result_278_0() -> EmittedRegion
    {
        (EmittedRegion::Empty)
    }
}

// Upstream `get_scanner_name` (`"Scalar Iterative"`, 16 bytes) — len/byte
// pair per the borrowed-string convention.
pub machine ScalarIterativeScan::get_scanner_name_len(this: &ScalarIterativeScan) -> u64
satisfies Scanner<ScalarIterativeScan>::get_scanner_name_len
{
    16
}

pub machine ScalarIterativeScan::get_scanner_name_byte(
    this: &ScalarIterativeScan,
    position: u64
) -> u8
satisfies Scanner<ScalarIterativeScan>::get_scanner_name_byte
{
    transition position < 16 {
        true -> read(this, position)
        _ -> (0)
    }

    state read(this: &ScalarIterativeScan, position: u64) -> u8 {
        transition position < 16 {
            true -> take(this, position)
            _ -> (0)
        }
    }

    state take(this: &ScalarIterativeScan, position: u64) -> u8
    requires 0 <= position && position < 16;
    {
        "Scalar Iterative"[position]
    }
}
