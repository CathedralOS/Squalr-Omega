module src::scanners::scalar::scanner_scalar_byte_array_booyer_moore;

use squalr_engine_api::src::structures::memory::memory_alignment::MemoryAlignment;
use squalr_engine_api::src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use squalr_engine_api::src::structures::scanning::comparisons::scan_compare_type_immediate::ScanCompareTypeImmediate;
use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use squalr_engine_api::src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use src::scanners::snapshot_scanner::Scanner;
use src::scanners::structures::boyer_moore_table::OptionalIndex;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::EmittedRegion;
use src::scanners::structures::snapshot_region_filter_run_length_encoder::SnapshotRegionFilterRunLengthEncoder;

// Port of scalar/scanner_scalar_byte_array_booyer_moore.rs (with the masked
// sibling's shared shape — see scanner_scalar_byte_array_booyer_moore_masked
// for the masked constructor): the overlap-preserving Boyer-Moore byte-array
// scan over a region's captured current bytes.
//
// Storage notes (deviations, per AGENTS.md recorded here):
//  * Upstream's `DataValue` carries the scan pattern as a `Vec<u8>` of
//    arbitrary length. The port bounds the record's inline pattern/mask at
//    4096 (the same capacity `DataValue`'s byte store uses, so every pattern
//    a `DataValue` can express is scannable); `new_supplied` takes the
//    caller's `pattern: &[u8]`/`mask: &[u8]` spans and `pattern_length`
//    tracks `pattern.len`, exactly `scan_pattern.len` upstream. Patterns
//    beyond the capacity — and masked
//    patterns whose mask length differs — report upstream's unsupported-shape
//    result (empty stream), matching its `scan_pattern.len() !=
//    scan_mask.len()` / error-log-and-empty arms.
//  * The plan-driven `new` still reads the u64-packed operand
//    (`get_operand_value`): the plan has no byte-span surface yet (the api
//    leg lands separately), so that path remains capped at 8 pattern bytes.
//    The supplied entry is the caller-provided-byte-array path.
//  * Upstream's `BoyerMooreTable` heap-owns its suffix-shift Vec; the ported
//    table takes a caller-lent `&mut [u64]` backing which cannot ride inside
//    this pull-driver record, so the tables live inline on the scan instead
//    (`mismatch_index_table: [OptionalIndex; 256]` mirrors upstream's
//    fixed-256 Vec<Option<usize>>; `matching_suffix_shift_table: [u64; 4096]`
//    covers every pattern length the record can express). The
//    table-build states below are upstream `BoyerMooreTable::build_table`
//    (`is_prefix`/`suffix_length`/`round_up_to_alignment` helpers included)
//    with `self.scan_pattern`/`self.pattern_length` standing in for the
//    borrowed `scan_pattern`/`scan_pattern.len`.
//  * Upstream drains the encoder's `take_result_regions()` eagerly; the
//    pull-model `next` walks until one emission per call, same order and
//    content, and the post-loop `finalize_current_encode_with_padding(0,
//    padding)` is the one-shot tail (`finalized_tail`).
//  * `current_values` is the caller's decoded byte window (unit 1, alignment
//    1 — the dispatcher fills it via read_current_elements at byte stride,
//    matching upstream's `get_current_values_filter_pointer` byte view). A
//    window shorter than the region ends the scan at the covered prefix —
//    upstream always reads a full window; under the lent-slab model a short
//    scratch reports the covered prefix and closes (the dispatcher's
//    abort-on-undersize convention applied read-side).
//  * Upstream's unsupported-compare-type arms log and return an empty Vec;
//    here `supported` gates `next` to the same empty result stream.
pub data ScalarByteArrayScan {
    encoder: SnapshotRegionFilterRunLengthEncoder;
    scan_index: u64;
    region_size: u64;
    scan_pattern: [u8; 4096];
    pattern_length: u64;
    scan_mask: [u8; 4096];
    has_mask: bool;
    memory_alignment_size: u64;
    data_type_size_padding: u64;
    mismatch_index_table: [OptionalIndex; 256];
    matching_suffix_shift_table: [u64; 4096];
    supported: bool;
    finalized_tail: bool;
}

// Upstream `acquire_scanner_instance`'s `&ScannerScalarByteArrayBooyerMoore`
// unit — kept as the constructor namespace; the returned record is the
// pull driver the caller drains.
pub data ScannerScalarByteArrayBooyerMoore {}

pub machine ScannerScalarByteArrayBooyerMoore::new(
    snapshot_region_filter: &SnapshotRegionFilter,
    snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan
) -> ScalarByteArrayScan {
    ScalarByteArrayScan::new(
        snapshot_region_filter,
        snapshot_filter_element_scan_plan,
        false
    )
}

// Upstream `get_scanner_name` (`"Byte Array (Booyer-Moore)"`, 25 bytes) —
// len/byte pair per the borrowed-string convention.
pub machine ScannerScalarByteArrayBooyerMoore::get_scanner_name_len(scanner_scalar_byte_array_booyer_moore: &ScannerScalarByteArrayBooyerMoore) -> u64
satisfies Scanner::get_scanner_name_len
{
    25
}

pub machine ScannerScalarByteArrayBooyerMoore::get_scanner_name_byte(
    scanner_scalar_byte_array_booyer_moore: &ScannerScalarByteArrayBooyerMoore,
    position: u64
) -> u8
satisfies Scanner::get_scanner_name_byte
{
    transition position < 25 {
        true -> read(scanner_scalar_byte_array_booyer_moore, position)
        _ -> (0)
    }

    state read(scanner_scalar_byte_array_booyer_moore: &ScannerScalarByteArrayBooyerMoore, position: u64) -> u8 {
        transition position < 25 {
            true -> take(scanner_scalar_byte_array_booyer_moore, position)
            _ -> (0)
        }
    }

    state take(scanner_scalar_byte_array_booyer_moore: &ScannerScalarByteArrayBooyerMoore, position: u64) -> u8
    requires 0 <= position && position < 25;
    {
        "Byte Array (Booyer-Moore)"[position]
    }
}

// Upstream's scan_region prelude: Immediate(Equal) is the only compare type
// byte-array scans support; anything else is the empty upstream arm.
pub machine ScalarByteArrayScan::new(
    snapshot_region_filter: &SnapshotRegionFilter,
    snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan,
    has_mask: bool
) -> ScalarByteArrayScan {
    transition SnapshotFilterElementScanPlan::get_scan_compare_type(snapshot_filter_element_scan_plan) {
        ScanCompareType::Immediate { compare_type } -> immediate(
            compare_type,
            snapshot_region_filter,
            snapshot_filter_element_scan_plan,
            has_mask
        )
        _ -> (ScalarByteArrayScan::unsupported(snapshot_region_filter))
    }

    state immediate(
        compare_type: ScanCompareTypeImmediate,
        snapshot_region_filter: &SnapshotRegionFilter,
        snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan,
        has_mask: bool
    ) -> ScalarByteArrayScan {
        transition compare_type {
            ScanCompareTypeImmediate::Equal -> build(
                snapshot_region_filter,
                snapshot_filter_element_scan_plan,
                has_mask
            )
            _ -> (ScalarByteArrayScan::unsupported(snapshot_region_filter))
        }
    }

    state build(
        snapshot_region_filter: &SnapshotRegionFilter,
        snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan,
        has_mask: bool
    ) -> ScalarByteArrayScan {
        let align_size: u64 =
            SnapshotFilterElementScanPlan::get_memory_alignment(snapshot_filter_element_scan_plan).get_size_in_bytes();
        let pat_len: u64 =
            SnapshotFilterElementScanPlan::get_unit_size_in_bytes(snapshot_filter_element_scan_plan);
        // The u64-carried operand bounds the pattern to 8 bytes; upstream's
        // `if scan_pattern.len() != scan_mask.len()` and zero-length pattern
        // collapse into `supported` — both yield upstream's empty result.
        let is_supported: bool = pat_len >= 1 && pat_len <= 8;
        let mut scan: ScalarByteArrayScan = ScalarByteArrayScan {
            encoder: SnapshotRegionFilterRunLengthEncoder::new(
                SnapshotRegionFilter::get_base_address(snapshot_region_filter)
            ),
            scan_index: 0,
            region_size: SnapshotRegionFilter::get_region_size(snapshot_region_filter),
            pattern_length: pat_len,
            has_mask: has_mask,
            memory_alignment_size: align_size,
            data_type_size_padding: ((pat_len as u64 in Saturating)
                - (align_size as u64 in Saturating)) as u64,
            supported: is_supported,
            finalized_tail: false,
        };
        transition is_supported {
            true -> fill(scan, snapshot_filter_element_scan_plan)
            _ -> (scan)
        }
    }

    state fill(
        scan: ScalarByteArrayScan,
        snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan
    ) -> ScalarByteArrayScan {
        let mut filled: ScalarByteArrayScan = scan;
        ScalarByteArrayScan::fill_bytes(&mut filled, 
            SnapshotFilterElementScanPlan::get_operand_value(snapshot_filter_element_scan_plan),
            SnapshotFilterElementScanPlan::get_mask_value(snapshot_filter_element_scan_plan),
            0
        );
        // Upstream's masked variant never builds the Boyer-Moore tables — its
        // shift walk replaces them — so table-build runs only unmasked.
        transition filled.has_mask {
            false -> tables(filled)
            _ -> (filled)
        }
    }

    state tables(scan: ScalarByteArrayScan) -> ScalarByteArrayScan {
        let mut built: ScalarByteArrayScan = scan;
        ScalarByteArrayScan::build_tables(&mut built);
        built
    }
}

// The supplied-pattern entry: the caller hands the scan its byte array (and
// its mask, when masking) as spans — upstream's `data_value`/`get_mask`
// element views without the plan's u64 packing. Pattern bytes land in the
// record's bounded stores; `pattern_length` is the span's own length, so the
// walk/table/compare machinery runs patterns of any length it can hold.
pub machine ScalarByteArrayScan::new_supplied(
    snapshot_region_filter: &SnapshotRegionFilter,
    snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan,
    has_mask: bool,
    pattern: &[u8],
    mask: &[u8]
) -> ScalarByteArrayScan {
    transition SnapshotFilterElementScanPlan::get_scan_compare_type(snapshot_filter_element_scan_plan) {
        ScanCompareType::Immediate { compare_type } -> immediate(
            compare_type,
            snapshot_region_filter,
            snapshot_filter_element_scan_plan,
            has_mask,
            pattern,
            mask
        )
        _ -> (ScalarByteArrayScan::unsupported(snapshot_region_filter))
    }

    state immediate(
        compare_type: ScanCompareTypeImmediate,
        snapshot_region_filter: &SnapshotRegionFilter,
        snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan,
        has_mask: bool,
        pattern: &[u8],
        mask: &[u8]
    ) -> ScalarByteArrayScan {
        transition compare_type {
            ScanCompareTypeImmediate::Equal -> build(
                snapshot_region_filter,
                snapshot_filter_element_scan_plan,
                has_mask,
                pattern,
                mask
            )
            _ -> (ScalarByteArrayScan::unsupported(snapshot_region_filter))
        }
    }

    state build(
        snapshot_region_filter: &SnapshotRegionFilter,
        snapshot_filter_element_scan_plan: &SnapshotFilterElementScanPlan,
        has_mask: bool,
        pattern: &[u8],
        mask: &[u8]
    ) -> ScalarByteArrayScan {
        let align_size: u64 =
            SnapshotFilterElementScanPlan::get_memory_alignment(snapshot_filter_element_scan_plan).get_size_in_bytes();
        let pat_len: u64 = pattern.len;
        // Upstream validates `scan_pattern.len() >= 1` and (masked)
        // `scan_pattern.len() == scan_mask.len()`; the record's bounded
        // stores add the capacity bound — out-of-capacity patterns report
        // upstream's unsupported-shape result (empty stream).
        let is_supported: bool = pat_len >= 1 && pat_len <= 4096
            && (!has_mask || mask.len == pat_len);
        let mut scan: ScalarByteArrayScan = ScalarByteArrayScan {
            encoder: SnapshotRegionFilterRunLengthEncoder::new(
                SnapshotRegionFilter::get_base_address(snapshot_region_filter)
            ),
            scan_index: 0,
            region_size: SnapshotRegionFilter::get_region_size(snapshot_region_filter),
            pattern_length: pat_len,
            has_mask: has_mask,
            memory_alignment_size: align_size,
            data_type_size_padding: ((pat_len as u64 in Saturating)
                - (align_size as u64 in Saturating)) as u64,
            supported: is_supported,
            finalized_tail: false,
        };
        transition is_supported {
            true -> fill(scan, pattern, mask, has_mask)
            _ -> (scan)
        }
    }

    state fill(
        scan: ScalarByteArrayScan,
        pattern: &[u8],
        mask: &[u8], has_mask: bool) -> ScalarByteArrayScan {




        let mut filled: ScalarByteArrayScan = scan;
        ScalarByteArrayScan::fill_span(&mut filled, pattern, mask, 0);
        // Upstream's masked variant never builds the Boyer-Moore tables — its
        // shift walk replaces them — so table-build runs only unmasked.
        transition filled.has_mask {
            true -> (filled)
            false -> tables(filled)
            _ -> (filled)
        }
    }

    state tables(scan: ScalarByteArrayScan) -> ScalarByteArrayScan {
        let mut built: ScalarByteArrayScan = scan;
        ScalarByteArrayScan::build_tables(&mut built);
        built
    }
}

// Copies the supplied pattern/mask spans into the record's inline stores.
// Masked scans write the mask word per byte; unmasked scans leave `scan_mask`
// at the identity fill (the compare path never reads it).
machine ScalarByteArrayScan::fill_span(
    scalar_byte_array_scan: &mut ScalarByteArrayScan,
    pattern: &[u8],
    mask: &[u8],
    index: u64
) {
    transition index < scalar_byte_array_scan.pattern_length && index < pattern.len && index < 4096 {
        true -> write_span(scalar_byte_array_scan, pattern, mask, index)
        _ -> done(scalar_byte_array_scan)
    }

    // Re-guarding loop state — the head transition runs once; `walk` carries
    // the iteration afterward (same idiom as `fill_bytes`' store arm).
    state walk(scalar_byte_array_scan: &mut ScalarByteArrayScan, pattern: &[u8], mask: &[u8], index: u64) {
        transition index < scalar_byte_array_scan.pattern_length && index < pattern.len && index < 4096 {
            true -> write_span(scalar_byte_array_scan, pattern, mask, index)
            _ -> done(scalar_byte_array_scan)
        }
    }

    state done(scalar_byte_array_scan: &mut ScalarByteArrayScan) {
    }

    state write_span(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        pattern: &[u8],
        mask: &[u8],
        index: u64
    )
    requires 0 <= index && index < 4096 && index < pattern.len;
    {
        scalar_byte_array_scan.scan_pattern[index] = pattern[index];
        transition { _ -> write_mask(scalar_byte_array_scan, pattern, mask, index) }
    }

    state write_mask(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        pattern: &[u8],
        mask: &[u8],
        index: u64
    )
    requires 0 <= index && index < 4096 && index < pattern.len;
    {
        transition scalar_byte_array_scan.has_mask && index < mask.len {
            true -> store_mask(scalar_byte_array_scan, pattern, mask, index)
            _ -> advance(scalar_byte_array_scan, pattern, mask, index)
        }
    }

    state store_mask(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        pattern: &[u8],
        mask: &[u8],
        index: u64
    )
    requires 0 <= index && index < 4096 && index < mask.len;
    {
        scalar_byte_array_scan.scan_mask[index] = mask[index];
        transition { _ -> advance(scalar_byte_array_scan, pattern, mask, index) }
    }

    state advance(scalar_byte_array_scan: &mut ScalarByteArrayScan, pattern: &[u8], mask: &[u8], index: u64) {
        transition { _ -> walk(scalar_byte_array_scan, pattern, mask,
            ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64) }
    }
}

// The dead byte-array payload carried by `ScalarRegionScan` whenever the
// selected scanner is not byte-array (and by fixtures declaring the union
// cell). Array fields default-omit; the scan is never driven.
pub machine ScalarByteArrayScan::dead() -> ScalarByteArrayScan {
    ScalarByteArrayScan {
        encoder: SnapshotRegionFilterRunLengthEncoder::new(0),
        scan_index: 0,
        region_size: 0,
        pattern_length: 0,
        has_mask: false,
        memory_alignment_size: 1,
        data_type_size_padding: 0,
        supported: false,
        finalized_tail: false,
    }
}

// The empty-result shape upstream's unsupported arms (`vec![]`) produce —
// also the union's dead-driver payload for non-byte-array selections.
pub machine ScalarByteArrayScan::unsupported(
    snapshot_region_filter: &SnapshotRegionFilter
) -> ScalarByteArrayScan {
    ScalarByteArrayScan {
        encoder: SnapshotRegionFilterRunLengthEncoder::new(
            SnapshotRegionFilter::get_base_address(snapshot_region_filter)
        ),
        scan_index: 0,
        region_size: SnapshotRegionFilter::get_region_size(snapshot_region_filter),
        pattern_length: 0,
        has_mask: false,
        memory_alignment_size: 1,
        data_type_size_padding: 0,
        supported: false,
        finalized_tail: false,
    }
}

// Unpacks the operand (and, for the masked variant, the packed mask word)
// into the byte arrays — upstream's `data_value.get_value_bytes()` /
// `get_mask()` element views, little-endian per the operand packing.
machine ScalarByteArrayScan::fill_bytes(
    scalar_byte_array_scan: &mut ScalarByteArrayScan,
    operand_value: u64,
    mask_value: u64,
    index: u64
) {
    transition index < scalar_byte_array_scan.pattern_length && index < 4096 {
        true -> store(scalar_byte_array_scan, operand_value, mask_value, index)
        _ -> done(scalar_byte_array_scan)
    }

    state store(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        operand_value: u64,
        mask_value: u64,
        index: u64
    ) {
        transition index < scalar_byte_array_scan.pattern_length && index < 4096 {
            true -> write(scalar_byte_array_scan, operand_value, mask_value, index)
            _ -> done(scalar_byte_array_scan)
        }
    }

    state done(scalar_byte_array_scan: &mut ScalarByteArrayScan) {
    }

    state write(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        operand_value: u64,
        mask_value: u64,
        index: u64
    )
    requires 0 <= index && index < 4096;
    {
        scalar_byte_array_scan.scan_pattern[index] =
            byte_array_operand_byte(operand_value, scalar_byte_array_scan.pattern_length, index);
        scalar_byte_array_scan.scan_mask[index] =
            byte_array_operand_byte(mask_value, scalar_byte_array_scan.pattern_length, index);
        // The byte walk is a state-graph loop (constant stack, bounded by
        // index < 4096) — the same idiom as the table-build passes below.
        transition { _ -> store(scalar_byte_array_scan, operand_value, mask_value,
            ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Upstream `BoyerMooreTable::build_table` on the record's inline pattern and
// tables — identical passes: bad-character forward fill, suffix table seeded
// with the aligned whole-pattern shift, prefix-allowed minima, then the
// suffix-match minima.
machine ScalarByteArrayScan::build_tables(scalar_byte_array_scan: &mut ScalarByteArrayScan) {
    transition { _ -> mismatch_fill(scalar_byte_array_scan, 0) }

    state mismatch_fill(scalar_byte_array_scan: &mut ScalarByteArrayScan, index: u64) {
        transition index < scalar_byte_array_scan.pattern_length && index < 4096 {
            true -> mismatch_store(scalar_byte_array_scan, index)
            false -> shift_init(scalar_byte_array_scan, 0)
            _ -> shift_init(scalar_byte_array_scan, 0)
        }
    }

    state mismatch_store(scalar_byte_array_scan: &mut ScalarByteArrayScan, index: u64) {
        transition index < scalar_byte_array_scan.pattern_length && index < 4096 {
            true -> mismatch_byte(scalar_byte_array_scan, index)
            _ -> shift_init(scalar_byte_array_scan, 0)
        }
    }

    state mismatch_byte(scalar_byte_array_scan: &mut ScalarByteArrayScan, index: u64)
    requires 0 <= index && index < 4096;
    {
        let byte: u64 = scalar_byte_array_scan.scan_pattern[index] as u64;
        transition byte < 256 {
            true -> mismatch_commit(scalar_byte_array_scan, index, byte)
            _ -> shift_init(scalar_byte_array_scan, 0)
        }
    }

    state mismatch_commit(scalar_byte_array_scan: &mut ScalarByteArrayScan, index: u64, byte: u64)
    requires 0 <= byte && byte < 256;
    {
        scalar_byte_array_scan.mismatch_index_table[byte] = OptionalIndex::Present { index: index };
        transition { _ -> mismatch_fill(scalar_byte_array_scan, 
            ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64
        ) }
    }

    state shift_init(scalar_byte_array_scan: &mut ScalarByteArrayScan, index: u64) {
        let aligned_length: u64 = byte_array_round_up_to_alignment(
            scalar_byte_array_scan.pattern_length,
            scalar_byte_array_scan.memory_alignment_size
        );
        transition index < scalar_byte_array_scan.pattern_length && index < 4096 {
            true -> shift_store(scalar_byte_array_scan, index, aligned_length)
            false -> prefix_probe(scalar_byte_array_scan)
            _ -> prefix_probe(scalar_byte_array_scan)
        }
    }

    state shift_store(scalar_byte_array_scan: &mut ScalarByteArrayScan, index: u64, aligned_length: u64) {
        transition index < 4096 {
            true -> shift_write(scalar_byte_array_scan, index, aligned_length)
            _ -> prefix_probe(scalar_byte_array_scan)
        }
    }

    state shift_write(scalar_byte_array_scan: &mut ScalarByteArrayScan, index: u64, aligned_length: u64)
    requires 0 <= index && index < 4096;
    {
        scalar_byte_array_scan.matching_suffix_shift_table[index] = aligned_length;
        transition { _ -> shift_init(scalar_byte_array_scan, 
            ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64
        ) }
    }

    // Upstream `for start_index in (0..pattern_length).rev()`.
    state prefix_probe(scalar_byte_array_scan: &mut ScalarByteArrayScan) {
        transition scalar_byte_array_scan.pattern_length > 0 {
            true -> prefix_pass(scalar_byte_array_scan, 
                ((scalar_byte_array_scan.pattern_length as u64 in Saturating) - (1 as u64 in Saturating)) as u64
            )
            _ -> suffix_pass(scalar_byte_array_scan, 0)
        }
    }

    state prefix_pass(scalar_byte_array_scan: &mut ScalarByteArrayScan, start_index: u64) {
        transition start_index < scalar_byte_array_scan.pattern_length && start_index <= scalar_byte_array_scan.pattern_length
            && start_index < 4096 {
            true -> prefix_check(scalar_byte_array_scan, start_index)
            _ -> suffix_pass(scalar_byte_array_scan, 0)
        }
    }

    state prefix_check(scalar_byte_array_scan: &mut ScalarByteArrayScan, start_index: u64) {
        transition ScalarByteArrayScan::is_prefix(scalar_byte_array_scan, start_index) {
            true -> prefix_min(scalar_byte_array_scan, start_index)
            _ -> prefix_next(scalar_byte_array_scan, start_index)
        }
    }

    // A suffix that is also a prefix allows shift = pattern_length - start.
    state prefix_min(scalar_byte_array_scan: &mut ScalarByteArrayScan, start_index: u64) {
        let raw_shift: u64 =
            ((scalar_byte_array_scan.pattern_length as u64 in Saturating) - (start_index as u64 in Saturating)) as u64;
        let aligned_shift: u64 = byte_array_round_up_to_alignment(
            raw_shift,
            scalar_byte_array_scan.memory_alignment_size
        );
        transition start_index < 4096 {
            true -> prefix_min_write(scalar_byte_array_scan, start_index, aligned_shift)
            _ -> prefix_next(scalar_byte_array_scan, start_index)
        }
    }

    state prefix_min_write(scalar_byte_array_scan: &mut ScalarByteArrayScan, start_index: u64, aligned_shift: u64) {
        transition start_index < 4096 {
            true -> prefix_min_store(scalar_byte_array_scan, start_index, aligned_shift)
            _ -> prefix_next(scalar_byte_array_scan, start_index)
        }
    }

    state prefix_min_store(scalar_byte_array_scan: &mut ScalarByteArrayScan, start_index: u64, aligned_shift: u64)
    requires 0 <= start_index && start_index < 4096;
    {
        let current: u64 = scalar_byte_array_scan.matching_suffix_shift_table[start_index];
        scalar_byte_array_scan.matching_suffix_shift_table[start_index] =
            byte_array_u64_min(current, aligned_shift);
        transition { _ -> prefix_next(scalar_byte_array_scan, start_index) }
    }

    state prefix_next(scalar_byte_array_scan: &mut ScalarByteArrayScan, start_index: u64) {
        transition start_index > 0 {
            true -> prefix_pass(scalar_byte_array_scan, 
                ((start_index as u64 in Saturating) - (1 as u64 in Saturating)) as u64
            )
            _ -> suffix_pass(scalar_byte_array_scan, 0)
        }
    }

    // Second pass over 0..pattern_length_minus_one: shifts from actual
    // suffix matches, taking the smaller of the two upstream options.
    state suffix_pass(scalar_byte_array_scan: &mut ScalarByteArrayScan, pattern_index: u64) {
        let pattern_length_minus_one: u64 =
            ((scalar_byte_array_scan.pattern_length as u64 in Saturating) - (1 as u64 in Saturating)) as u64;
        transition pattern_index < pattern_length_minus_one
            && pattern_index < scalar_byte_array_scan.pattern_length && pattern_index < 4096 {
            true -> suffix_step(scalar_byte_array_scan, pattern_index, pattern_length_minus_one)
            _ -> done(scalar_byte_array_scan)
        }
    }

    state suffix_step(scalar_byte_array_scan: &mut ScalarByteArrayScan, pattern_index: u64, pattern_length_minus_one: u64) {
        let matching_suffix_len: u64 = ScalarByteArrayScan::suffix_length(scalar_byte_array_scan, pattern_index);
        let shift_table_index: u64 =
            ((pattern_length_minus_one as u64 in Saturating) - (matching_suffix_len as u64 in Saturating)) as u64;
        let option_a: u64 =
            ((scalar_byte_array_scan.pattern_length as u64 in Saturating) - (matching_suffix_len as u64 in Saturating)) as u64;
        let option_b_span: u64 =
            ((pattern_length_minus_one as u64 in Saturating) - (pattern_index as u64 in Saturating)) as u64;
        let option_b: u64 =
            ((option_b_span as u64 in Saturating) + (matching_suffix_len as u64 in Saturating)) as u64;
        let shift: u64 = byte_array_u64_min(option_a, option_b);
        let aligned_shift: u64 = byte_array_round_up_to_alignment(
            shift,
            scalar_byte_array_scan.memory_alignment_size
        );
        transition shift_table_index < 4096 {
            true -> suffix_min_write(scalar_byte_array_scan, pattern_index, shift_table_index, aligned_shift)
            _ -> suffix_pass(scalar_byte_array_scan, 
                ((pattern_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64
            )
        }
    }

    state suffix_min_write(scalar_byte_array_scan: &mut ScalarByteArrayScan, pattern_index: u64, shift_table_index: u64, aligned_shift: u64) {
        transition shift_table_index < 4096 {
            true -> suffix_min_store(scalar_byte_array_scan, pattern_index, shift_table_index, aligned_shift)
            _ -> suffix_pass(scalar_byte_array_scan, 
                ((pattern_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64
            )
        }
    }

    state suffix_min_store(scalar_byte_array_scan: &mut ScalarByteArrayScan, pattern_index: u64, shift_table_index: u64, aligned_shift: u64)
    requires 0 <= shift_table_index && shift_table_index < 4096;
    {
        let current: u64 = scalar_byte_array_scan.matching_suffix_shift_table[shift_table_index];
        scalar_byte_array_scan.matching_suffix_shift_table[shift_table_index] =
            byte_array_u64_min(current, aligned_shift);
        transition { _ -> suffix_pass(scalar_byte_array_scan, 
            ((pattern_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64
        ) }
    }

    state done(scalar_byte_array_scan: &mut ScalarByteArrayScan) {
    }
}

// Upstream `BoyerMooreTable::is_prefix` on `self.scan_pattern`: whether the
// suffix starting at suffix_start is also a prefix.
machine ScalarByteArrayScan::is_prefix(
    scalar_byte_array_scan: &mut ScalarByteArrayScan,
    suffix_start: u64
) -> bool
requires
    suffix_start <= scalar_byte_array_scan.pattern_length
{
    transition {
        _ -> walk(scalar_byte_array_scan, 
            suffix_start,
            ((scalar_byte_array_scan.pattern_length as u64 in Saturating) - (suffix_start as u64 in Saturating)) as u64,
            0
        )
    }

    state walk(scalar_byte_array_scan: &mut ScalarByteArrayScan, reverse: u64, suffix_len: u64, forward: u64) -> bool {
        transition forward < suffix_len && forward < 4096 && reverse < 4096
            && forward < scalar_byte_array_scan.pattern_length && reverse < scalar_byte_array_scan.pattern_length {
            true -> compare(scalar_byte_array_scan, reverse, suffix_len, forward)
            _ -> (true)
        }
    }

    state compare(scalar_byte_array_scan: &mut ScalarByteArrayScan, reverse: u64, suffix_len: u64, forward: u64) -> bool
    requires 0 <= reverse && reverse < 4096 && 0 <= forward && forward < 4096;
    {
        transition scalar_byte_array_scan.scan_pattern[forward] != scalar_byte_array_scan.scan_pattern[reverse] {
            true -> (false)
            false -> walk(scalar_byte_array_scan, 
                ((reverse as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
                suffix_len,
                ((forward as u64 in Saturating) + (1 as u64 in Saturating)) as u64
            )
            _ -> walk(scalar_byte_array_scan, 
                ((reverse as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
                suffix_len,
                ((forward as u64 in Saturating) + (1 as u64 in Saturating)) as u64
            )
        }
    }
}

// Upstream `BoyerMooreTable::suffix_length`: length of the suffix match
// ending at match_pos, comparing backward from the pattern's last byte.
machine ScalarByteArrayScan::suffix_length(
    scalar_byte_array_scan: &mut ScalarByteArrayScan,
    match_pos: u64
) -> u64
requires
    match_pos < scalar_byte_array_scan.pattern_length
{
    transition {
        _ -> walk(scalar_byte_array_scan, 
            match_pos,
            ((scalar_byte_array_scan.pattern_length as u64 in Saturating) - (1 as u64 in Saturating)) as u64,
            0
        )
    }

    state walk(scalar_byte_array_scan: &mut ScalarByteArrayScan, suffix_index: u64, pattern_end_index: u64, length: u64) -> u64 {
        transition suffix_index < scalar_byte_array_scan.pattern_length && pattern_end_index < scalar_byte_array_scan.pattern_length
            && suffix_index < 4096 && pattern_end_index < 4096 {
            true -> compare(scalar_byte_array_scan, suffix_index, pattern_end_index, length)
            _ -> (length)
        }
    }

    state compare(scalar_byte_array_scan: &mut ScalarByteArrayScan, suffix_index: u64, pattern_end_index: u64, length: u64) -> u64
    requires 0 <= suffix_index && suffix_index < 4096 && 0 <= pattern_end_index && pattern_end_index < 4096;
    {
        transition scalar_byte_array_scan.scan_pattern[suffix_index] == scalar_byte_array_scan.scan_pattern[pattern_end_index] {
            true -> step(scalar_byte_array_scan, suffix_index, pattern_end_index, length)
            _ -> (length)
        }
    }

    // Upstream increments before the zero-edge break, then walks both indexes
    // down while bytes keep matching.
    state step(scalar_byte_array_scan: &mut ScalarByteArrayScan, suffix_index: u64, pattern_end_index: u64, length: u64) -> u64 {
        let next_length: u64 = ((length as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        transition suffix_index == 0 || pattern_end_index == 0 {
            true -> (next_length)
            _ -> walk(scalar_byte_array_scan, 
                ((suffix_index as u64 in Saturating) - (1 as u64 in Saturating)) as u64,
                ((pattern_end_index as u64 in Saturating) - (1 as u64 in Saturating)) as u64,
                next_length
            )
        }
    }
}

// Upstream `ScannerScalarByteArrayBooyerMooreMasked::get_safe_mismatch_shift`:
// walk pattern positions before the mismatch downward for a byte that is
// mask-equal to the mismatching byte; the first gives the smallest safe
// (alignment-rounded) shift, else mismatch + 1 rounded up. Masked scans only.
machine ScalarByteArrayScan::masked_safe_mismatch_shift(
    scalar_byte_array_scan: &mut ScalarByteArrayScan,
    mismatched_byte: u8,
    mismatch_pattern_index: u64
) -> u64 {
    transition mismatch_pattern_index > 0 {
        true -> walk(scalar_byte_array_scan, mismatched_byte, mismatch_pattern_index,
            ((mismatch_pattern_index as u64 in Saturating) - (1 as u64 in Saturating)) as u64)
        _ -> fallback(scalar_byte_array_scan, mismatch_pattern_index)
    }

    state walk(scalar_byte_array_scan: &mut ScalarByteArrayScan, mismatched_byte: u8, mismatch_pattern_index: u64, compatible_pattern_index: u64) -> u64 {
        transition compatible_pattern_index < mismatch_pattern_index && compatible_pattern_index < 4096 {
            true -> test(scalar_byte_array_scan, mismatched_byte, mismatch_pattern_index, compatible_pattern_index)
            _ -> fallback(scalar_byte_array_scan, mismatch_pattern_index)
        }
    }

    state test(scalar_byte_array_scan: &mut ScalarByteArrayScan, mismatched_byte: u8, mismatch_pattern_index: u64, compatible_pattern_index: u64) -> u64 {
        transition compatible_pattern_index < 4096 {
            true -> bounded(scalar_byte_array_scan, mismatched_byte, mismatch_pattern_index, compatible_pattern_index)
            _ -> fallback(scalar_byte_array_scan, mismatch_pattern_index)
        }
    }

    state bounded(scalar_byte_array_scan: &mut ScalarByteArrayScan, mismatched_byte: u8, mismatch_pattern_index: u64, compatible_pattern_index: u64) -> u64
    requires 0 <= compatible_pattern_index && compatible_pattern_index < 4096;
    {
        let pattern_mask: u8 = scalar_byte_array_scan.scan_mask[compatible_pattern_index];
        let masked_pattern_byte: u8 = scalar_byte_array_scan.scan_pattern[compatible_pattern_index] & pattern_mask;
        let masked_mismatched_byte: u8 = mismatched_byte & pattern_mask;
        transition masked_mismatched_byte == masked_pattern_byte {
            true -> found(scalar_byte_array_scan, mismatch_pattern_index, compatible_pattern_index)
            _ -> step(scalar_byte_array_scan, mismatched_byte, mismatch_pattern_index, compatible_pattern_index)
        }
    }

    state found(scalar_byte_array_scan: &mut ScalarByteArrayScan, mismatch_pattern_index: u64, compatible_pattern_index: u64) -> u64 {
        let raw_shift: u64 =
            ((mismatch_pattern_index as u64 in Saturating) - (compatible_pattern_index as u64 in Saturating)) as u64;
        let capped_shift: u64 = byte_array_u64_max(raw_shift, 1);
        byte_array_round_up_to_alignment(
            capped_shift,
            scalar_byte_array_scan.memory_alignment_size
        )
    }

    state step(scalar_byte_array_scan: &mut ScalarByteArrayScan, mismatched_byte: u8, mismatch_pattern_index: u64, compatible_pattern_index: u64) -> u64 {
        transition compatible_pattern_index > 0 {
            true -> walk(scalar_byte_array_scan, 
                mismatched_byte,
                mismatch_pattern_index,
                ((compatible_pattern_index as u64 in Saturating) - (1 as u64 in Saturating)) as u64
            )
            _ -> fallback(scalar_byte_array_scan, mismatch_pattern_index)
        }
    }

    state fallback(scalar_byte_array_scan: &mut ScalarByteArrayScan, mismatch_pattern_index: u64) -> u64 {
        byte_array_round_up_to_alignment(
            ((mismatch_pattern_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            scalar_byte_array_scan.memory_alignment_size
        )
    }
}

// The scan's pull driver: each call walks upstream's `while scan_index <=
// region_size - pattern_length` loop until the run-length encoder yields a
// region, then suspends; `Empty` once the tail finalize has run.
pub machine ScalarByteArrayScan::next(
    scalar_byte_array_scan: &mut ScalarByteArrayScan,
    current_values: &[u64],
    previous_values: &[u64]
) -> EmittedRegion
satisfies Scanner::next
{
    transition scalar_byte_array_scan.supported && !scalar_byte_array_scan.finalized_tail {
        true -> pump(scalar_byte_array_scan, current_values)
        _ -> (EmittedRegion::Empty)
    }

    state pump(scalar_byte_array_scan: &mut ScalarByteArrayScan, current_values: &[u64]) -> EmittedRegion {
        let window_end: u64 = ((scalar_byte_array_scan.region_size as u64 in Saturating)
            - (scalar_byte_array_scan.pattern_length as u64 in Saturating)) as u64;
        transition scalar_byte_array_scan.scan_index <= window_end {
            true -> probe(scalar_byte_array_scan, current_values)
            _ -> tail(scalar_byte_array_scan)
        }
    }

    // The byte window is shorter than the region only when the caller's
    // lent scratch undersizes it — scanning the covered prefix and closing
    // preserves upstream's result ordering over that prefix.
    state probe(scalar_byte_array_scan: &mut ScalarByteArrayScan, current_values: &[u64]) -> EmittedRegion {
        let last: u64 =
            ((scalar_byte_array_scan.pattern_length as u64 in Saturating) - (1 as u64 in Saturating)) as u64;
        transition { _ -> compare_gate(scalar_byte_array_scan, current_values, last) }
    }

    state compare_gate(scalar_byte_array_scan: &mut ScalarByteArrayScan, current_values: &[u64], inverse_index: u64) -> EmittedRegion {
        let byte_offset: u64 = ((scalar_byte_array_scan.scan_index as u64 in Saturating)
            + (inverse_index as u64 in Saturating)) as u64;
        transition byte_offset < current_values.len && inverse_index < 4096
            && inverse_index < scalar_byte_array_scan.pattern_length {
            true -> compare_byte(scalar_byte_array_scan, current_values, inverse_index, byte_offset)
            _ -> tail(scalar_byte_array_scan)
        }
    }

    state compare_byte(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        inverse_index: u64,
        byte_offset: u64
    ) -> EmittedRegion {
        transition byte_offset < current_values.len && inverse_index < 4096 {
            true -> compare_load(scalar_byte_array_scan, current_values, inverse_index, byte_offset)
            _ -> tail(scalar_byte_array_scan)
        }
    }

    state compare_load(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        inverse_index: u64,
        byte_offset: u64
    ) -> EmittedRegion
    requires 0 <= inverse_index && inverse_index < 4096 && 0 <= byte_offset && byte_offset < current_values.len;
    {
        let byte_word: u64 = current_values[byte_offset];
        let current_byte: u8 =
            (((byte_word as u64 in Wrapping) % (256 as u64 in Wrapping)) as u8);
        transition scalar_byte_array_scan.has_mask {
            true -> compare_masked(scalar_byte_array_scan, current_values, inverse_index, current_byte)
            _ -> compare_plain(scalar_byte_array_scan, current_values, inverse_index, current_byte)
        }
    }

    state compare_plain(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        inverse_index: u64,
        current_byte: u8
    ) -> EmittedRegion
    requires 0 <= inverse_index && inverse_index < 4096;
    {
        transition current_byte == scalar_byte_array_scan.scan_pattern[inverse_index] {
            true -> match_step(scalar_byte_array_scan, current_values, inverse_index)
            _ -> shift_bad_char(scalar_byte_array_scan, current_values, inverse_index, current_byte)
        }
    }

    state compare_masked(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        inverse_index: u64,
        current_byte: u8
    ) -> EmittedRegion
    requires 0 <= inverse_index && inverse_index < 4096;
    {
        let masked_current_byte: u8 = current_byte & scalar_byte_array_scan.scan_mask[inverse_index];
        let masked_pattern_byte: u8 = scalar_byte_array_scan.scan_pattern[inverse_index] & scalar_byte_array_scan.scan_mask[inverse_index];
        transition masked_current_byte == masked_pattern_byte {
            true -> match_step(scalar_byte_array_scan, current_values, inverse_index)
            _ -> shift_masked(scalar_byte_array_scan, current_values, inverse_index, current_byte)
        }
    }

    state match_step(scalar_byte_array_scan: &mut ScalarByteArrayScan, current_values: &[u64], inverse_index: u64) -> EmittedRegion {
        transition inverse_index > 0 {
            true -> compare_gate(scalar_byte_array_scan, 
                current_values,
                ((inverse_index as u64 in Saturating) - (1 as u64 in Saturating)) as u64
            )
            _ -> match_hit(scalar_byte_array_scan, current_values)
        }
    }

    // Upstream: `scan_index += memory_alignment_size` +
    // `encode_range(memory_alignment_size)` — the candidate stride, not the
    // pattern width, is what makes overlapping matches reportable.
    state match_hit(scalar_byte_array_scan: &mut ScalarByteArrayScan, current_values: &[u64]) -> EmittedRegion {
        SnapshotRegionFilterRunLengthEncoder::encode_range(&mut scalar_byte_array_scan.encoder, scalar_byte_array_scan.memory_alignment_size);
        scalar_byte_array_scan.scan_index = ((scalar_byte_array_scan.scan_index as u64 in Saturating)
            + (scalar_byte_array_scan.memory_alignment_size as u64 in Saturating)) as u64;
        transition { _ -> pump(scalar_byte_array_scan, current_values) }
    }

    // Unmasked: upstream `boyer_moore_table.get_safe_mismatch_shift` — the
    // bad-character rule first, then the good-suffix rule combined under the
    // same guards upstream's getters apply.
    state shift_bad_char(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        inverse_index: u64,
        current_byte: u8
    ) -> EmittedRegion {
        transition (current_byte as u64) < 256 {
            true -> shift_bad_load(scalar_byte_array_scan, 
                current_values,
                inverse_index,
                current_byte as u64
            )
            _ -> shift_good_suffix(scalar_byte_array_scan, current_values, inverse_index,
                byte_array_round_up_to_alignment(
                    byte_array_u64_max(
                        ((inverse_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
                        1
                    ),
                    scalar_byte_array_scan.memory_alignment_size
                ))
        }
    }

    state shift_bad_load(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        inverse_index: u64,
        byte_index: u64
    ) -> EmittedRegion
    requires 0 <= byte_index && byte_index < 256;
    {
        transition { _ -> shift_bad_entry(scalar_byte_array_scan, current_values, inverse_index, scalar_byte_array_scan.mismatch_index_table[byte_index]) }
    }

    state shift_bad_entry(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        inverse_index: u64,
        entry: OptionalIndex
    ) -> EmittedRegion {
        transition entry {
            OptionalIndex::Present { index } -> shift_bad_present(scalar_byte_array_scan, 
                current_values,
                inverse_index,
                index
            )
            _ -> shift_good_suffix(scalar_byte_array_scan, current_values, inverse_index,
                byte_array_round_up_to_alignment(
                    byte_array_u64_max(
                        ((inverse_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
                        1
                    ),
                    scalar_byte_array_scan.memory_alignment_size
                ))
        }
    }

    state shift_bad_present(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        inverse_index: u64,
        rightmost: u64
    ) -> EmittedRegion {
        transition rightmost < inverse_index {
            true -> shift_good_suffix(scalar_byte_array_scan, current_values, inverse_index,
                byte_array_round_up_to_alignment(
                    byte_array_u64_max(
                        ((inverse_index as u64 in Saturating) - (rightmost as u64 in Saturating)) as u64,
                        1
                    ),
                    scalar_byte_array_scan.memory_alignment_size
                ))
            _ -> shift_good_suffix(scalar_byte_array_scan, current_values, inverse_index,
                byte_array_round_up_to_alignment(1, scalar_byte_array_scan.memory_alignment_size))
        }
    }

    // Upstream `get_good_suffix_shift(mismatch + 1)`: reads
    // matching_suffix_shift_table[mismatch + 1] only when
    // (mismatch + 1) + 1 < pattern_length.
    state shift_good_suffix(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        inverse_index: u64,
        bad_char_shift: u64
    ) -> EmittedRegion {
        let good_index: u64 =
            ((inverse_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        let index_after: u64 =
            ((good_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        transition index_after < scalar_byte_array_scan.pattern_length && good_index < 4096 {
            true -> shift_good_read(scalar_byte_array_scan, current_values, inverse_index, bad_char_shift, good_index)
            _ -> shift_combine(scalar_byte_array_scan, current_values, bad_char_shift, 0)
        }
    }

    state shift_good_read(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        inverse_index: u64,
        bad_char_shift: u64,
        good_index: u64
    ) -> EmittedRegion {
        transition good_index < 4096 {
            true -> shift_good_bounded(scalar_byte_array_scan, current_values, bad_char_shift, good_index)
            _ -> shift_combine(scalar_byte_array_scan, current_values, bad_char_shift, 0)
        }
    }

    state shift_good_bounded(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        bad_char_shift: u64,
        good_index: u64
    ) -> EmittedRegion
    requires 0 <= good_index && good_index < 4096;
    {
        let good_suffix_shift: u64 = scalar_byte_array_scan.matching_suffix_shift_table[good_index];
        transition { _ -> shift_combine(scalar_byte_array_scan, current_values, bad_char_shift, good_suffix_shift) }
    }

    // Upstream: `if good_suffix_shift > 0 { max(min(bad, good), alignment) }
    // else { max(bad, alignment) }`.
    state shift_combine(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        bad_char_shift: u64,
        good_suffix_shift: u64
    ) -> EmittedRegion {
        transition good_suffix_shift > 0 {
            true -> shift_out(scalar_byte_array_scan, 
                current_values,
                byte_array_u64_max(
                    byte_array_u64_min(bad_char_shift, good_suffix_shift),
                    scalar_byte_array_scan.memory_alignment_size
                )
            )
            _ -> shift_out(scalar_byte_array_scan, 
                current_values,
                byte_array_u64_max(bad_char_shift, scalar_byte_array_scan.memory_alignment_size)
            )
        }
    }

    state shift_masked(
        scalar_byte_array_scan: &mut ScalarByteArrayScan,
        current_values: &[u64],
        inverse_index: u64,
        current_byte: u8
    ) -> EmittedRegion {
        let shift: u64 = ScalarByteArrayScan::masked_safe_mismatch_shift(scalar_byte_array_scan, current_byte, inverse_index);
        transition { _ -> shift_out(scalar_byte_array_scan, current_values, shift) }
    }

    // `finalize_current_encode_with_padding(shift, data_type_size_padding)`
    // then `scan_index += shift` — upstream's mismatch advance.
    state shift_out(scalar_byte_array_scan: &mut ScalarByteArrayScan, current_values: &[u64], shift: u64) -> EmittedRegion {
        let emitted: EmittedRegion = SnapshotRegionFilterRunLengthEncoder::finalize_current_encode_with_padding(&mut scalar_byte_array_scan.encoder, 
            shift,
            scalar_byte_array_scan.data_type_size_padding
        );
        scalar_byte_array_scan.scan_index =
            ((scalar_byte_array_scan.scan_index as u64 in Wrapping) + (shift as u64 in Wrapping)) as u64;
        let emitted_has_region: bool = EmittedRegion::is_region(&emitted);
        transition emitted_has_region {
            true -> (emitted)
            _ -> pump(scalar_byte_array_scan, current_values)
        }
    }

    // Upstream's post-loop `finalize_current_encode_with_padding(0, padding)`
    // — one-shot tail emission closing an open run at end of window.
    state tail(scalar_byte_array_scan: &mut ScalarByteArrayScan) -> EmittedRegion {
        scalar_byte_array_scan.finalized_tail = true;
        let emitted: EmittedRegion = SnapshotRegionFilterRunLengthEncoder::finalize_current_encode_with_padding(&mut scalar_byte_array_scan.encoder, 
            0,
            scalar_byte_array_scan.data_type_size_padding
        );
        let emitted_has_region: bool = EmittedRegion::is_region(&emitted);
        transition emitted_has_region {
            true -> (emitted)
            _ -> (EmittedRegion::Empty)
        }
    }
}

// Little-endian byte `byte_index` of a packed u64 word (operand or mask);
// indexes past `value_size_in_bytes` read as 0 — same convention as
// ScanConstraintFinalized's operand_byte.
machine byte_array_operand_byte(
    value: u64,
    value_size_in_bytes: u64,
    byte_index: u64
) -> u8 {
    transition byte_index < value_size_in_bytes {
        true -> shift(value, byte_index)
        _ -> (0)
    }

    state shift(value: u64, byte_index: u64) -> u8 {
        transition byte_index < 8 {
            true -> bounded(value, byte_index)
            _ -> (0)
        }
    }

    state bounded(value: u64, byte_index: u64) -> u8 {
        let shift_bits: u64 = ((byte_index as u64 in Saturating) * (8 as u64 in Saturating)) as u64;
        let shifted: u64 = value >> shift_bits;
        ((shifted as u64 in Wrapping) % (256 as u64 in Wrapping)) as u8
    }
}

// Upstream `round_up_to_alignment`: value + (alignment - remainder) %
// alignment (requires alignment > 0 — the supported gate guarantees it since
// memory_alignment_size comes from a MemoryAlignment).
machine byte_array_round_up_to_alignment(value: u64, alignment: u64) -> u64 {
    let remainder: u64 = ((value as u64 in Saturating) % (alignment as u64 in Saturating)) as u64;
    ((value as u64 in Saturating)
        + (((alignment as u64 in Saturating) - (remainder as u64 in Saturating))
            % (alignment as u64 in Saturating))) as u64
}

machine byte_array_u64_min(a: u64, b: u64) -> u64 {
    transition a < b {
        true -> a
        _ -> (b)
    }
}

machine byte_array_u64_max(a: u64, b: u64) -> u64 {
    transition a > b {
        true -> a
        _ -> (b)
    }
}
