module src::scanners::snapshot_scanner;

use src::scanners::structures::snapshot_region_filter_run_length_encoder::EmittedRegion;

// Port of scanners/snapshot_scanner.rs: upstream's `Scanner` trait — the
// `&'static dyn Scanner` surface `acquire_scanner_instance` returns. Upstream
// `scan_region(&SnapshotRegion, &SnapshotRegionFilter,
// &SnapshotFilterElementScanPlan) -> Vec<SnapshotRegionFilter>` collects
// every emitted sub-region eagerly; Omega has no Vec construction, so the
// same contract is expressed pull-style: the caller drains `next` over the
// decoded element windows until `EmittedRegion::Empty` — identical regions,
// in the same order, streamed. `get_scanner_name` returns `&'static str`
// upstream; the owned port surfaces the name as a length + byte accessor
// pair (the `AnonymousValueString` borrowed-string convention).
pub trait Scanner {
    machine next(
        &mut self,
        current_values: &[u64],
        previous_values: &[u64]
    ) -> EmittedRegion;

    machine get_scanner_name_len(&self) -> u64;
    machine get_scanner_name_byte(&self, position: u64) -> u8;
}
