module src::scanners::structures::snapshot_region_filter_run_length_encoder;

use squalr_engine_api::src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;

// Port of SnapshotRegionFilterRunLengthEncoder: run-length encodes passing
// elements into SnapshotRegionFilter ranges. Upstream queues emitted regions
// in a Vec and drains through take_result_regions; Omega has no growable owner
// (Vec construction waits on the Allocation<T>/Arena surface), so each
// finalize_* returns the emitted region directly — identical emission points,
// order, and content, streamed to the caller. take_result_regions is not
// ported: nothing can accumulate. EmittedRegion is a local enum because
// Optional<foreign-package type> is not matchable downstream.
pub data EmittedRegion {
    case Region(region: SnapshotRegionFilter);
    case Empty;
}

// Kind query on the union — `transition self` is admitted on self while a
// let-bound union scrutinee is not, so consumers hoist the bool. Sites that
// move the non-copy `region` payload still need a param-position scrutinee.
pub machine EmittedRegion::is_region(emitted_region: &EmittedRegion) -> bool {
    transition emitted_region {
        EmittedRegion::Region { region } -> (true)
        _ -> (false)
    }
}

pub data SnapshotRegionFilterRunLengthEncoder {
    run_length_current_address: u64;
    is_encoding: bool;
    run_length: u64;
}

pub machine SnapshotRegionFilterRunLengthEncoder::new(
    run_length_current_address: u64
) -> SnapshotRegionFilterRunLengthEncoder {
    SnapshotRegionFilterRunLengthEncoder {
        run_length_current_address: run_length_current_address,
        is_encoding: false,
        run_length: 0,
    }
}

pub machine SnapshotRegionFilterRunLengthEncoder::get_current_address(snapshot_region_filter_run_length_encoder: &SnapshotRegionFilterRunLengthEncoder) -> u64 {
    snapshot_region_filter_run_length_encoder.run_length_current_address
}

pub machine SnapshotRegionFilterRunLengthEncoder::get_current_run_length(snapshot_region_filter_run_length_encoder: &SnapshotRegionFilterRunLengthEncoder) -> u64 {
    snapshot_region_filter_run_length_encoder.run_length
}

pub machine SnapshotRegionFilterRunLengthEncoder::is_encoding(snapshot_region_filter_run_length_encoder: &SnapshotRegionFilterRunLengthEncoder) -> bool {
    snapshot_region_filter_run_length_encoder.is_encoding
}

// Encodes the next N bytes as passing the scan (memory alignment for scalar
// scans). Address arithmetic saturates like the upstream u64 fields.
pub machine SnapshotRegionFilterRunLengthEncoder::encode_range(
    snapshot_region_filter_run_length_encoder: &mut SnapshotRegionFilterRunLengthEncoder,
    byte_advance_count: u64
) {
    snapshot_region_filter_run_length_encoder.run_length =
        ((snapshot_region_filter_run_length_encoder.run_length as u64 in Saturating) + (byte_advance_count as u64 in Saturating)) as u64;
    snapshot_region_filter_run_length_encoder.is_encoding = true;
}

// Completes the current run and yields a region when one was open, then always
// advances the tracked address by byte_advance_count.
pub machine SnapshotRegionFilterRunLengthEncoder::finalize_current_encode(
    snapshot_region_filter_run_length_encoder: &mut SnapshotRegionFilterRunLengthEncoder,
    byte_advance_count: u64
) -> EmittedRegion {
    transition snapshot_region_filter_run_length_encoder.is_encoding && snapshot_region_filter_run_length_encoder.run_length > 0 {
        true -> emit(snapshot_region_filter_run_length_encoder, byte_advance_count)
        false -> advance(snapshot_region_filter_run_length_encoder, byte_advance_count)
    }

    state emit(snapshot_region_filter_run_length_encoder: &mut SnapshotRegionFilterRunLengthEncoder, byte_advance_count: u64) -> EmittedRegion {
        let emitted: EmittedRegion = EmittedRegion::Region {
            region: SnapshotRegionFilter::new(snapshot_region_filter_run_length_encoder.run_length_current_address, snapshot_region_filter_run_length_encoder.run_length)
        };
        snapshot_region_filter_run_length_encoder.run_length_current_address =
            ((snapshot_region_filter_run_length_encoder.run_length_current_address as u64 in Saturating)
                + (snapshot_region_filter_run_length_encoder.run_length as u64 in Saturating)) as u64;
        snapshot_region_filter_run_length_encoder.run_length = 0;
        snapshot_region_filter_run_length_encoder.is_encoding = false;
        snapshot_region_filter_run_length_encoder.run_length_current_address =
            ((snapshot_region_filter_run_length_encoder.run_length_current_address as u64 in Saturating)
                + (byte_advance_count as u64 in Saturating)) as u64;
        emitted
    }

    state advance(snapshot_region_filter_run_length_encoder: &mut SnapshotRegionFilterRunLengthEncoder, byte_advance_count: u64) -> EmittedRegion {
        snapshot_region_filter_run_length_encoder.run_length_current_address =
            ((snapshot_region_filter_run_length_encoder.run_length_current_address as u64 in Saturating)
                + (byte_advance_count as u64 in Saturating)) as u64;
        EmittedRegion::Empty
    }
}

// Same emission with the produced region padded by the element tail bytes
// (overlapping candidates keep their trailing payload).
pub machine SnapshotRegionFilterRunLengthEncoder::finalize_current_encode_with_padding(
    snapshot_region_filter_run_length_encoder: &mut SnapshotRegionFilterRunLengthEncoder,
    byte_advance_count: u64,
    length_padding: u64
) -> EmittedRegion {
    transition snapshot_region_filter_run_length_encoder.is_encoding && snapshot_region_filter_run_length_encoder.run_length > 0 {
        true -> emit_padded(snapshot_region_filter_run_length_encoder, byte_advance_count, length_padding)
        false -> advance(snapshot_region_filter_run_length_encoder, byte_advance_count)
    }

    state emit_padded(
        snapshot_region_filter_run_length_encoder: &mut SnapshotRegionFilterRunLengthEncoder,
        byte_advance_count: u64,
        length_padding: u64
    ) -> EmittedRegion {
        let emitted: EmittedRegion = EmittedRegion::Region {
            region: SnapshotRegionFilter::new(
                snapshot_region_filter_run_length_encoder.run_length_current_address,
                ((snapshot_region_filter_run_length_encoder.run_length as u64 in Saturating) + (length_padding as u64 in Saturating))
                    as u64
            )
        };
        snapshot_region_filter_run_length_encoder.run_length_current_address =
            ((snapshot_region_filter_run_length_encoder.run_length_current_address as u64 in Saturating)
                + (snapshot_region_filter_run_length_encoder.run_length as u64 in Saturating)) as u64;
        snapshot_region_filter_run_length_encoder.run_length = 0;
        snapshot_region_filter_run_length_encoder.is_encoding = false;
        snapshot_region_filter_run_length_encoder.run_length_current_address =
            ((snapshot_region_filter_run_length_encoder.run_length_current_address as u64 in Saturating)
                + (byte_advance_count as u64 in Saturating)) as u64;
        emitted
    }

    state advance(snapshot_region_filter_run_length_encoder: &mut SnapshotRegionFilterRunLengthEncoder, byte_advance_count: u64) -> EmittedRegion {
        snapshot_region_filter_run_length_encoder.run_length_current_address =
            ((snapshot_region_filter_run_length_encoder.run_length_current_address as u64 in Saturating)
                + (byte_advance_count as u64 in Saturating)) as u64;
        EmittedRegion::Empty
    }
}

// Same emission, discarding runs shorter than minimum_size.
pub machine SnapshotRegionFilterRunLengthEncoder::finalize_current_encode_with_minimum_size_filtering(
    snapshot_region_filter_run_length_encoder: &mut SnapshotRegionFilterRunLengthEncoder,
    byte_advance_count: u64,
    minimum_size: u64
) -> EmittedRegion {
    transition snapshot_region_filter_run_length_encoder.is_encoding && snapshot_region_filter_run_length_encoder.run_length > 0 && snapshot_region_filter_run_length_encoder.run_length >= minimum_size {
        true -> emit(snapshot_region_filter_run_length_encoder, byte_advance_count)
        false -> advance(snapshot_region_filter_run_length_encoder, byte_advance_count)
    }

    state emit(snapshot_region_filter_run_length_encoder: &mut SnapshotRegionFilterRunLengthEncoder, byte_advance_count: u64) -> EmittedRegion {
        let emitted: EmittedRegion = EmittedRegion::Region {
            region: SnapshotRegionFilter::new(snapshot_region_filter_run_length_encoder.run_length_current_address, snapshot_region_filter_run_length_encoder.run_length)
        };
        snapshot_region_filter_run_length_encoder.run_length_current_address =
            ((snapshot_region_filter_run_length_encoder.run_length_current_address as u64 in Saturating)
                + (snapshot_region_filter_run_length_encoder.run_length as u64 in Saturating)) as u64;
        snapshot_region_filter_run_length_encoder.run_length = 0;
        snapshot_region_filter_run_length_encoder.is_encoding = false;
        snapshot_region_filter_run_length_encoder.run_length_current_address =
            ((snapshot_region_filter_run_length_encoder.run_length_current_address as u64 in Saturating)
                + (byte_advance_count as u64 in Saturating)) as u64;
        emitted
    }

    state advance(snapshot_region_filter_run_length_encoder: &mut SnapshotRegionFilterRunLengthEncoder, byte_advance_count: u64) -> EmittedRegion {
        transition snapshot_region_filter_run_length_encoder.is_encoding && snapshot_region_filter_run_length_encoder.run_length > 0 {
            true -> close_open_run(snapshot_region_filter_run_length_encoder, byte_advance_count)
            false -> just_advance(snapshot_region_filter_run_length_encoder, byte_advance_count)
        }
    }

    state close_open_run(snapshot_region_filter_run_length_encoder: &mut SnapshotRegionFilterRunLengthEncoder, byte_advance_count: u64) -> EmittedRegion {
        snapshot_region_filter_run_length_encoder.run_length_current_address =
            ((snapshot_region_filter_run_length_encoder.run_length_current_address as u64 in Saturating)
                + (snapshot_region_filter_run_length_encoder.run_length as u64 in Saturating)) as u64;
        snapshot_region_filter_run_length_encoder.run_length = 0;
        snapshot_region_filter_run_length_encoder.is_encoding = false;
        snapshot_region_filter_run_length_encoder.run_length_current_address =
            ((snapshot_region_filter_run_length_encoder.run_length_current_address as u64 in Saturating)
                + (byte_advance_count as u64 in Saturating)) as u64;
        EmittedRegion::Empty
    }

    state just_advance(snapshot_region_filter_run_length_encoder: &mut SnapshotRegionFilterRunLengthEncoder, byte_advance_count: u64) -> EmittedRegion {
        snapshot_region_filter_run_length_encoder.run_length_current_address =
            ((snapshot_region_filter_run_length_encoder.run_length_current_address as u64 in Saturating)
                + (byte_advance_count as u64 in Saturating)) as u64;
        EmittedRegion::Empty
    }
}
