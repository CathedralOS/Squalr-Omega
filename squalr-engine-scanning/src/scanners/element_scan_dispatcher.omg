        transition scan_result {
            ScalarScanSlot::Ready { scan } -> drain_call_b(filter, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, constraint_index, b_count, chain_cursor, a_count, scan)
            ScalarScanSlot::NoScan -> next_b(filter, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, constraint_index, b_count, chain_cursor, a_count)
            _ -> next_b(filter, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, constraint_index, b_count, chain_cursor, a_count)
