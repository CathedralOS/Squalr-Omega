    state drain_call_b(
        filter: &SnapshotRegionFilter,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        constraint_index: u64,
        b_count: u64,
        chain_cursor: u64,
        a_count: u64,
        scan_in: ScalarRegionScan
    ) -> FilterScanOutcome {
        let mut scan: ScalarRegionScan = scan_in;
        let emitted_to: u64 = drain_scan(&mut scan, &mut chain_a, a_count, &mut scratch_current, &mut scratch_previous);
        transition {
            _ -> next_b(filter, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, constraint_index, b_count, chain_cursor, emitted_to)
        }
    }
    state next_b(
        filter: &SnapshotRegionFilter,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        constraint_index: u64,
        b_count: u64,
        chain_cursor: u64,
        a_count: u64
    ) -> FilterScanOutcome {
        let next_cursor: u64 = ((chain_cursor as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        transition {
            _ -> per_b(filter, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, constraint_index, b_count, next_cursor, a_count)
        }
    }
    state done_b(
        filter: &SnapshotRegionFilter,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        constraint_index: u64,
        a_count: u64
    ) -> FilterScanOutcome {
        transition a_count > 0 {
            true -> fold_a(filter, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, ((constraint_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64, a_count)
            _ -> (FilterScanOutcome { filter_count: 0, from_chain_a: false })
        }
    }
}

// Writes a finished chain into the caller-owned output extents: one filter
// slot per surviving filter starting at filter_base, then one run length at
// run_base. Returns the post-write cursors relative to the caller's windows.
machine commit_chain<'chain>(
    source_chain: &'chain [SnapshotRegionFilter],
    filter_count: u64,
    out_filters: &mut [SnapshotRegionFilter],
    filter_base: u64,
    out_runs: &mut [u64],
    run_base: u64
) -> u64 {
    transition {
        _ -> copy_gate(source_chain, &mut out_filters, filter_base, 0, filter_count, &mut out_runs, run_base)
    }
    state copy_gate(
        source_chain: &'chain [SnapshotRegionFilter],
        out_filters: &mut [SnapshotRegionFilter],
        filter_base: u64,
        copy_cursor: u64,
        filter_count: u64,
        out_runs: &mut [u64],
        run_base: u64
    ) -> u64 {
        transition copy_cursor < filter_count {
            true -> bound_copy(source_chain, &mut out_filters, filter_base, copy_cursor, filter_count, &mut out_runs, run_base)
            _ -> commit_run(&mut out_runs, run_base, filter_count, ((filter_base as u64 in Saturating) + (filter_count as u64 in Saturating)) as u64)
        }
    }
    state bound_copy(
        source_chain: &'chain [SnapshotRegionFilter],
        out_filters: &mut [SnapshotRegionFilter],
        filter_base: u64,
        copy_cursor: u64,
        filter_count: u64,
        out_runs: &mut [u64],
        run_base: u64
    ) -> u64 {
        let out_slot: u64 = ((filter_base as u64 in Saturating) + (copy_cursor as u64 in Saturating)) as u64;
        transition copy_cursor < source_chain.len {
            true -> copy_one(source_chain, &mut out_filters, filter_base, copy_cursor, filter_count, &mut out_runs, run_base)
            _ -> commit_run(&mut out_runs, run_base, filter_count, out_slot)
        }
    }
    state copy_one(
        source_chain: &'chain [SnapshotRegionFilter],
        out_filters: &mut [SnapshotRegionFilter],
        filter_base: u64,
        copy_cursor: u64 [0..source_chain.len],
        filter_count: u64,
        out_runs: &mut [u64],
        run_base: u64
    ) -> u64 {
        let out_slot: u64 = ((filter_base as u64 in Saturating) + (copy_cursor as u64 in Saturating)) as u64;
        let copied_filter: SnapshotRegionFilter = SnapshotRegionFilter::clone(&source_chain[copy_cursor]);
        transition out_slot < out_filters.len {
            true -> write_one(&mut out_filters, out_slot, copied_filter, source_chain, filter_base, copy_cursor, filter_count, &mut out_runs, run_base)
            _ -> copy_gate(source_chain, &mut out_filters, filter_base, ((copy_cursor as u64 in Saturating) + (1 as u64 in Saturating)) as u64, filter_count, &mut out_runs, run_base)
        }
    }
    state write_one(
        out_filters: &mut [SnapshotRegionFilter],
        out_slot: u64 [0..out_filters.len],
        copied_filter: SnapshotRegionFilter,
        source_chain: &'chain [SnapshotRegionFilter],
        filter_base: u64,
        copy_cursor: u64,
        filter_count: u64,
        out_runs: &mut [u64],
        run_base: u64
    ) -> u64 {
        out_filters[out_slot] = copied_filter;
        let next_copy: u64 = ((copy_cursor as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        transition {
            _ -> copy_gate(source_chain, &mut out_filters, filter_base, next_copy, filter_count, &mut out_runs, run_base)
        }
    }
    state commit_run(
        out_runs: &mut [u64],
        run_base: u64,
        filter_count: u64,
        next_filter_offset: u64
    ) -> u64 {
        transition run_base < out_runs.len {
            true -> write_run(&mut out_runs, run_base, filter_count, next_filter_offset)
            _ -> (next_filter_offset)
        }
    }
    state write_run(
        out_runs: &mut [u64],
        run_base: u64 [0..out_runs.len],
        filter_count: u64,
        next_filter_offset: u64
    ) -> u64 {
        out_runs[run_base] = filter_count;
        (next_filter_offset)
    }
}

// Per-collection dispatch: ANDs each input filter through the constraint
// chain and commits the survivors under (filter_base, run_base) in the
// caller-owned output extents.
pub machine ElementScanDispatcher::dispatch_scan<'type_id, 'filters, 'runs, 'bytes, 'mask>(
    input_collection: &SnapshotRegionFilterCollection<'type_id, 'filters, 'runs>,
    constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
    constraint_count: u64,
    memory_alignment: MemoryAlignment,
    has_current_values: bool,
    has_previous_values: bool,
    region_current_bytes: &[u8],
    region_previous_bytes: &[u8],
    region_base_address: u64,
    scratch_current: &mut [u64],
    scratch_previous: &mut [u64],
    chain_a: &mut [SnapshotRegionFilter],
    chain_b: &mut [SnapshotRegionFilter],
    out_filters: &mut [SnapshotRegionFilter],
    filter_base: u64,
    out_runs: &mut [u64],
    run_base: u64
) -> BatchScanOutcome
{
    transition has_current_values {
        true -> filter_loop(input_collection, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, &mut out_filters, &mut out_runs, 0, filter_base, run_base)
        _ -> (BatchScanOutcome { output_filter_count: 0, output_run_count: 0 })
    }
    state filter_loop(
        input_collection: &SnapshotRegionFilterCollection<'type_id, 'filters, 'runs>,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        out_filters: &mut [SnapshotRegionFilter],
        out_runs: &mut [u64],
        filter_index: u64,
        out_filter_cursor: u64,
        out_run_cursor: u64
    ) -> BatchScanOutcome {
        let input_filter_count: u64 = input_collection.get_filter_count();
        transition filter_index < input_filter_count {
            true -> load_filter(input_collection, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, &mut out_filters, &mut out_runs, filter_index, out_filter_cursor, out_run_cursor)
            _ -> (BatchScanOutcome { output_filter_count: out_filter_cursor, output_run_count: out_run_cursor })
        }
    }
    state load_filter(
        input_collection: &SnapshotRegionFilterCollection<'type_id, 'filters, 'runs>,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        out_filters: &mut [SnapshotRegionFilter],
        out_runs: &mut [u64],
        filter_index: u64,
        out_filter_cursor: u64,
        out_run_cursor: u64
    ) -> BatchScanOutcome {
        let filter_result: FilterSlot = input_collection.get_filter_at(filter_index);
        transition filter_result {
            FilterSlot::Present { filter } -> chain_filter(input_collection, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, &mut out_filters, &mut out_runs, filter_index, out_filter_cursor, out_run_cursor, filter)
            FilterSlot::Missing -> (BatchScanOutcome { output_filter_count: out_filter_cursor, output_run_count: out_run_cursor })
            _ -> (BatchScanOutcome { output_filter_count: out_filter_cursor, output_run_count: out_run_cursor })
        }
    }
    state chain_filter(
        input_collection: &SnapshotRegionFilterCollection<'type_id, 'filters, 'runs>,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        out_filters: &mut [SnapshotRegionFilter],
        out_runs: &mut [u64],
        filter_index: u64,
        out_filter_cursor: u64,
        out_run_cursor: u64,
        filter: &SnapshotRegionFilter
    ) -> BatchScanOutcome {
        let outcome: FilterScanOutcome = run_filter_constraint_chain(
            filter,
            constraints,
            constraint_count,
            memory_alignment,
            has_previous_values,
            region_current_bytes,
            region_previous_bytes,
            region_base_address,
            scratch_current,
            scratch_previous,
            chain_a,
            chain_b
        );
        transition outcome.from_chain_a {
            true -> emit_a(input_collection, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, &mut out_filters, &mut out_runs, filter_index, out_filter_cursor, out_run_cursor, outcome)
            _ -> emit_b(input_collection, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, &mut out_filters, &mut out_runs, filter_index, out_filter_cursor, out_run_cursor, outcome)
        }
    }
    state emit_a(
        input_collection: &SnapshotRegionFilterCollection<'type_id, 'filters, 'runs>,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        out_filters: &mut [SnapshotRegionFilter],
        out_runs: &mut [u64],
        filter_index: u64,
        out_filter_cursor: u64,
        out_run_cursor: u64,
        outcome: FilterScanOutcome
    ) -> BatchScanOutcome {
        transition outcome.filter_count > 0 {
            true -> copy_a(input_collection, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, &mut out_filters, &mut out_runs, filter_index, out_filter_cursor, out_run_cursor, outcome)
            _ -> next_filter(input_collection, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, &mut out_filters, &mut out_runs, filter_index, out_filter_cursor, out_run_cursor)
        }
    }
    state copy_a(
        input_collection: &SnapshotRegionFilterCollection<'type_id, 'filters, 'runs>,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        out_filters: &mut [SnapshotRegionFilter],
        out_runs: &mut [u64],
        filter_index: u64,
        out_filter_cursor: u64,
        out_run_cursor: u64,
        outcome: FilterScanOutcome
    ) -> BatchScanOutcome {
        let next_filters: u64 = commit_chain(
            chain_a,
            outcome.filter_count,
            out_filters,
            out_filter_cursor,
            out_runs,
            out_run_cursor
        );
        let next_runs: u64 = ((out_run_cursor as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        transition {
            _ -> next_filter(input_collection, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, &mut out_filters, &mut out_runs, filter_index, next_filters, next_runs)
        }
    }
    state emit_b(
        input_collection: &SnapshotRegionFilterCollection<'type_id, 'filters, 'runs>,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        out_filters: &mut [SnapshotRegionFilter],
        out_runs: &mut [u64],
        filter_index: u64,
        out_filter_cursor: u64,
        out_run_cursor: u64,
        outcome: FilterScanOutcome
    ) -> BatchScanOutcome {
        transition outcome.filter_count > 0 {
            true -> copy_b(input_collection, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, &mut out_filters, &mut out_runs, filter_index, out_filter_cursor, out_run_cursor, outcome)
            _ -> next_filter(input_collection, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, &mut out_filters, &mut out_runs, filter_index, out_filter_cursor, out_run_cursor)
        }
    }
    state copy_b(
        input_collection: &SnapshotRegionFilterCollection<'type_id, 'filters, 'runs>,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        out_filters: &mut [SnapshotRegionFilter],
        out_runs: &mut [u64],
        filter_index: u64,
        out_filter_cursor: u64,
        out_run_cursor: u64,
        outcome: FilterScanOutcome
    ) -> BatchScanOutcome {
        let next_filters: u64 = commit_chain(
            chain_b,
            outcome.filter_count,
            out_filters,
            out_filter_cursor,
            out_runs,
            out_run_cursor
        );
        let next_runs: u64 = ((out_run_cursor as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        transition {
            _ -> next_filter(input_collection, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, &mut out_filters, &mut out_runs, filter_index, next_filters, next_runs)
        }
    }
    state next_filter(
        input_collection: &SnapshotRegionFilterCollection<'type_id, 'filters, 'runs>,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        out_filters: &mut [SnapshotRegionFilter],
        out_runs: &mut [u64],
        filter_index: u64,
        out_filter_cursor: u64,
        out_run_cursor: u64
    ) -> BatchScanOutcome {
        let next_index: u64 = ((filter_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        transition {
            _ -> filter_loop(input_collection, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, &mut out_filters, &mut out_runs, next_index, out_filter_cursor, out_run_cursor)
        }
    }
}
