        }
    }
    state compare_b(
        filter: &SnapshotRegionFilter,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        constraint_index: u64 [0..constraints.len],
        b_count: u64,
        chain_cursor: u64,
        a_count: u64
    ) -> FilterScanOutcome {
        let compare_type: ScanCompareType = constraints[constraint_index].get_scan_compare_type();
        let needs_previous: bool = compare_needs_previous(compare_type);
        transition needs_previous && !has_previous_values {
            true -> (FilterScanOutcome { filter_count: 0, from_chain_a: false })
            _ -> decode_b(filter, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, constraint_index, b_count, chain_cursor, a_count)
        }
    }
    state cgate_b(
        filter: &SnapshotRegionFilter,
        constraints: &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        has_previous_values: bool,
        region_current_bytes: &[u8],
        region_previous_bytes: &[u8],
        region_base_address: u64,
        scratch_current: &mut [u64],
        scratch_previous: &mut [u64],
        chain_a: &mut [SnapshotRegionFilter],
        chain_b: &mut [SnapshotRegionFilter],
        constraint_index: u64,
        b_count: u64,
        chain_cursor: u64,
        a_count: u64
    ) -> FilterScanOutcome {
        transition constraint_index < constraints.len {
            true -> compare_b(filter, constraints, constraint_count, memory_alignment, has_previous_values, region_current_bytes, region_previous_bytes, region_base_address, &mut scratch_current, &mut scratch_previous, &mut chain_a, &mut chain_b, constraint_index, b_count, chain_cursor, a_count)
            _ -> (FilterScanOutcome { filter_count: 0, from_chain_a: false })
        }
