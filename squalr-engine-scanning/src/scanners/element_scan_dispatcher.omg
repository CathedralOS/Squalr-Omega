    ) -> u64 {
        let constraint_index: u64 = element_scan_plan.constraint_index_for(
            data_type_id,
            constraint_ordinal
        );
        let next_dst_len: u64 = apply_constraint(
            snapshot_region,
            result_value_size_in_bytes,
            element_scan_plan,
            constraint_index,
            &round_a[source_index],
            current_elements,
            previous_elements,
            driver_cell,
            dst,
            dst_len
        );
        transition { _ -> each_a_out(
            constraint_ordinal,
            a_count,
            ((source_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            next_dst_len,
            snapshot_region,
            result_value_size_in_bytes,
            element_scan_plan,
            data_type_id,
            constraint_count,
            current_elements,
            previous_elements,
            driver_cell,
            dst,
            round_a,
            round_b
        ) }
    }

    state round_b(
        constraint_ordinal: u64,
        b_count: u64,
        dst_len: u64,
        snapshot_region: &SnapshotRegion,
        result_value_size_in_bytes: u64,
        element_scan_plan: &ElementScanPlan,
        data_type_id: &'t [u8],
        constraint_count: u64,
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        dst: &mut [SnapshotRegionFilter],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter]
    ) -> u64 {
        transition constraint_ordinal < constraint_count {
            true -> last_b(constraint_ordinal, b_count, dst_len,
                snapshot_region,
                result_value_size_in_bytes,
                element_scan_plan,
                data_type_id,
                constraint_count,
                current_elements,
                previous_elements,
                driver_cell,
                dst,
                round_a,
                round_b
            )
            false -> (dst_len)
            _ -> (dst_len)
        }
    }

    state last_b(
        constraint_ordinal: u64,
        b_count: u64,
        dst_len: u64,
        snapshot_region: &SnapshotRegion,
        result_value_size_in_bytes: u64,
        element_scan_plan: &ElementScanPlan,
        data_type_id: &'t [u8],
        constraint_count: u64,
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        dst: &mut [SnapshotRegionFilter],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter]
    ) -> u64 {
        let next_ordinal: u64 = ((constraint_ordinal as u64 in Saturating)
            + (1 as u64 in Saturating)) as u64;
        transition next_ordinal == constraint_count {
            true -> each_b_out(constraint_ordinal, b_count, 0, dst_len,
                snapshot_region,
                result_value_size_in_bytes,
                element_scan_plan,
                data_type_id,
                constraint_count,
                current_elements,
                previous_elements,
                driver_cell,
                dst,
                round_a,
                round_b
            )
            false -> each_b_a(constraint_ordinal, b_count, 0, 0, dst_len,
                snapshot_region,
                result_value_size_in_bytes,
                element_scan_plan,
                data_type_id,
                constraint_count,
                current_elements,
                previous_elements,
                driver_cell,
                dst,
                round_a,
                round_b
            )
            _ -> each_b_a(constraint_ordinal, b_count, 0, 0, dst_len,
                snapshot_region,
                result_value_size_in_bytes,
                element_scan_plan,
                data_type_id,
                constraint_count,
                current_elements,
                previous_elements,
                driver_cell,
                dst,
                round_a,
                round_b
            )
        }
    }

    state each_b_a(
        constraint_ordinal: u64,
        b_count: u64,
        source_index: u64,
        a_count: u64,
        dst_len: u64,
        snapshot_region: &SnapshotRegion,
        result_value_size_in_bytes: u64,
        element_scan_plan: &ElementScanPlan,
        data_type_id: &'t [u8],
        constraint_count: u64,
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        dst: &mut [SnapshotRegionFilter],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter]
    ) -> u64 {
        transition source_index < b_count && source_index < round_b.len {
            true -> apply_b_a(constraint_ordinal, b_count, source_index, a_count, dst_len,
                snapshot_region,
                result_value_size_in_bytes,
                element_scan_plan,
                data_type_id,
                constraint_count,
                current_elements,
                previous_elements,
                driver_cell,
                dst,
                round_a,
                round_b
            )
            false -> round_a(
                ((constraint_ordinal as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
                a_count, dst_len,
                snapshot_region,
                result_value_size_in_bytes,
                element_scan_plan,
                data_type_id,
                constraint_count,
                current_elements,
                previous_elements,
                driver_cell,
                dst,
                round_a,
                round_b
            )
            _ -> round_a(
                ((constraint_ordinal as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
                a_count, dst_len,
                snapshot_region,
                result_value_size_in_bytes,
                element_scan_plan,
                data_type_id,
                constraint_count,
                current_elements,
                previous_elements,
                driver_cell,
                dst,
                round_a,
                round_b
            )
        }
    }

    state apply_b_a(
        constraint_ordinal: u64,
        b_count: u64,
        source_index: u64,
        a_count: u64,
        dst_len: u64,
        snapshot_region: &SnapshotRegion,
        result_value_size_in_bytes: u64,
        element_scan_plan: &ElementScanPlan,
        data_type_id: &'t [u8],
        constraint_count: u64,
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        dst: &mut [SnapshotRegionFilter],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter]
    ) -> u64 {
        let constraint_index: u64 = element_scan_plan.constraint_index_for(
            data_type_id,
            constraint_ordinal
        );
        let next_a_count: u64 = apply_constraint(
            snapshot_region,
            result_value_size_in_bytes,
            element_scan_plan,
            constraint_index,
            &round_b[source_index],
            current_elements,
            previous_elements,
            driver_cell,
            round_a,
            a_count
        );
        transition { _ -> each_b_a(
            constraint_ordinal,
            b_count,
            ((source_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            next_a_count,
            dst_len,
            snapshot_region,
            result_value_size_in_bytes,
            element_scan_plan,
            data_type_id,
            constraint_count,
            current_elements,
            previous_elements,
            driver_cell,
            dst,
            round_a,
            round_b
        ) }
    }

    state each_b_out(
        constraint_ordinal: u64,
        b_count: u64,
        source_index: u64,
        dst_len: u64,
        snapshot_region: &SnapshotRegion,
        result_value_size_in_bytes: u64,
        element_scan_plan: &ElementScanPlan,
        data_type_id: &'t [u8],
        constraint_count: u64,
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        dst: &mut [SnapshotRegionFilter],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter]
    ) -> u64 {
        transition source_index < b_count && source_index < round_b.len {
            true -> apply_b_out(constraint_ordinal, b_count, source_index, dst_len,
                snapshot_region,
                result_value_size_in_bytes,
                element_scan_plan,
                data_type_id,
                constraint_count,
                current_elements,
                previous_elements,
                driver_cell,
                dst,
                round_a,
                round_b
            )
            false -> (dst_len)
            _ -> (dst_len)
        }
    }

    state apply_b_out(
        constraint_ordinal: u64,
        b_count: u64,
        source_index: u64,
        dst_len: u64,
        snapshot_region: &SnapshotRegion,
        result_value_size_in_bytes: u64,
        element_scan_plan: &ElementScanPlan,
        data_type_id: &'t [u8],
        constraint_count: u64,
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        dst: &mut [SnapshotRegionFilter],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter]
    ) -> u64 {
        let constraint_index: u64 = element_scan_plan.constraint_index_for(
            data_type_id,
            constraint_ordinal
        );
        let next_dst_len: u64 = apply_constraint(
            snapshot_region,
            result_value_size_in_bytes,
            element_scan_plan,
            constraint_index,
            &round_b[source_index],
            current_elements,
            previous_elements,
            driver_cell,
            dst,
            dst_len
        );
        transition { _ -> each_b_out(
            constraint_ordinal,
            b_count,
            ((source_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            next_dst_len,
            snapshot_region,
            result_value_size_in_bytes,
            element_scan_plan,
            data_type_id,
            constraint_count,
            current_elements,
            previous_elements,
            driver_cell,
            dst,
            round_a,
            round_b
        ) }
    }

    state abort_run(dst_len: u64) -> u64 {
        crash Abort;
    }
}

// Upstream `resolve_result_value_size_in_bytes`: the collection's own value
// size unless a matching constraint's operand is larger.
machine resolve_result_value_size<'d, 'c>(
    element_scan_plan: &ElementScanPlan,
    data_type_id: &[u8],
    constraint_count: u64,
    default_size: u64
) -> u64 {
    transition { _ -> walk(
        element_scan_plan,
        data_type_id,
        constraint_count,
        default_size,
        0
    ) }

    state walk(
        element_scan_plan: &ElementScanPlan,
        data_type_id: &[u8],
        constraint_count: u64,
        best: u64,
        constraint_ordinal: u64
    ) -> u64 {
        transition constraint_ordinal < constraint_count {
            true -> probe(
                element_scan_plan,
                data_type_id,
                constraint_count,
                best,
                constraint_ordinal
            )
            false -> (best)
            _ -> (best)
        }
    }

    state probe(
        element_scan_plan: &ElementScanPlan,
        data_type_id: &[u8],
        constraint_count: u64,
        best: u64,
        constraint_ordinal: u64
    ) -> u64 {
        let constraint_index: u64 = element_scan_plan.constraint_index_for(
            data_type_id,
            constraint_ordinal
        );
        let constraint: ScanConstraintFinalized<'c> =
            element_scan_plan.get_constraint(constraint_index);
        let operand_size: u64 = constraint.get_operand_size_in_bytes();
        transition operand_size > best {
            true -> walk(
                element_scan_plan,
                data_type_id,
                constraint_count,
                operand_size,
                ((constraint_ordinal as u64 in Saturating) + (1 as u64 in Saturating)) as u64
            )
            false -> walk(
                element_scan_plan,
                data_type_id,
                constraint_count,
                best,
                ((constraint_ordinal as u64 in Saturating) + (1 as u64 in Saturating)) as u64
            )
            _ -> walk(
                element_scan_plan,
                data_type_id,
                constraint_count,
                best,
                ((constraint_ordinal as u64 in Saturating) + (1 as u64 in Saturating)) as u64
            )
        }
    }
}

// Upstream `resolve_result_container_type`: the first matching constraint's
// Array/ArrayFixed container type, else None.
machine resolve_result_container_type<'d, 'c>(
    element_scan_plan: &ElementScanPlan,
    data_type_id: &[u8],
    constraint_count: u64
) -> ContainerType {
    transition { _ -> walk(element_scan_plan, data_type_id, constraint_count, 0) }

    state walk(
        element_scan_plan: &ElementScanPlan,
        data_type_id: &[u8],
        constraint_count: u64,
        constraint_ordinal: u64
    ) -> ContainerType {
        transition constraint_ordinal < constraint_count {
            true -> probe(
                element_scan_plan,
                data_type_id,
                constraint_count,
                constraint_ordinal
            )
            false -> (ContainerType::None)
            _ -> (ContainerType::None)
        }
    }

    state probe(
        element_scan_plan: &ElementScanPlan,
        data_type_id: &[u8],
        constraint_count: u64,
        constraint_ordinal: u64
    ) -> ContainerType {
        let constraint_index: u64 = element_scan_plan.constraint_index_for(
            data_type_id,
            constraint_ordinal
        );
        let constraint: ScanConstraintFinalized<'c> =
            element_scan_plan.get_constraint(constraint_index);
        let scan_constraint: ScanConstraint<'c> = constraint.get_scan_constraint();
        let container_type: ContainerType =
            scan_constraint.get_result_container_type();
        transition container_type {
            ContainerType::Array -> (container_type)
            ContainerType::ArrayFixed { length } -> (container_type)
            _ -> walk(
                element_scan_plan,
                data_type_id,
                constraint_count,
                ((constraint_ordinal as u64 in Saturating) + (1 as u64 in Saturating)) as u64
            )
        }
    }
}

// `&'r` view of a range of the lent result slab — the only shape the
// prover accepts for a caller-lent view (subslice end bounds do not
// propagate through state edges; the requires contract does).
pub machine ElementScanDispatcher::view_filter_range<'r>(
    filter_out: &'r mut [SnapshotRegionFilter],
    lo: u64,
    hi: u64
) -> &'r [SnapshotRegionFilter]
requires lo <= hi && hi <= filter_out.len
{
    &filter_out[lo..hi]
}

// Same 'r view shape over a caller-lent collection slab (seeds and results
// are built into lent `&'r mut` storage so the stored `&'r` views survive).
pub machine ElementScanDispatcher::view_collection_range<'r, 't>(
    collections: &'r mut [SnapshotRegionFilterCollection],
    lo: u64,
    hi: u64
) -> &'r [SnapshotRegionFilterCollection]
requires lo <= hi && hi <= collections.len
{
    &collections[lo..hi]
}

// Upstream `dispatch_scan` — the per-collection driver upstream maps over
// `snapshot_region.get_scan_results().get_filter_collections()`. Returns the
// freshly written result collection viewing `filter_out[out_cursor..]`.
pub machine ElementScanDispatcher::dispatch_scan<'a, 'p, 'r, 't, 'd, 'c, 'f>(
    snapshot_region: &SnapshotRegion,
    snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
    data_type_id: &'t [u8],
    element_scan_plan: &ElementScanPlan,
    current_elements: &mut [u64],
    previous_elements: &mut [u64],
    driver_cell: &mut [ScalarRegionScan],
    filter_out: &'r mut [SnapshotRegionFilter],
    round_a: &mut [SnapshotRegionFilter],
    round_b: &mut [SnapshotRegionFilter],
    out_cursor: u64
) -> SnapshotRegionFilterCollection
crashes Abort
{
    let constraint_count: u64 =
        element_scan_plan.count_constraints_for(data_type_id);
    let memory_alignment: MemoryAlignment =
        snapshot_region_filter_collection.get_memory_alignment();
    let default_size: u64 =
        snapshot_region_filter_collection.get_result_value_size_in_bytes();
    let result_value_size: u64 = resolve_result_value_size(
        element_scan_plan,
        data_type_id,
        constraint_count,
        default_size
    );
    transition constraint_count == 0 {
        true -> no_constraints(
            snapshot_region_filter_collection,
            data_type_id,
            memory_alignment,
            result_value_size,
            filter_out,
            out_cursor
        )
        false -> scan_input(
            snapshot_region,
            snapshot_region_filter_collection,
            element_scan_plan,
            data_type_id,
            constraint_count,
            memory_alignment,
            result_value_size,
            0,
            current_elements,
            previous_elements,
            driver_cell,
            filter_out,
            round_a,
            round_b,
            out_cursor,
            out_cursor
        )
        _ -> scan_input(
            snapshot_region,
            snapshot_region_filter_collection,
            element_scan_plan,
            data_type_id,
            constraint_count,
            memory_alignment,
            result_value_size,
            0,
            current_elements,
            previous_elements,
            driver_cell,
            filter_out,
            round_a,
            round_b,
            out_cursor,
            out_cursor
        )
    }

    // Upstream `None` from get(): a data type without constraints yields no
    // result filters — the returned collection is empty but still carries the
    // collection identity.
    state no_constraints(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        data_type_id: &'t [u8],
        memory_alignment: MemoryAlignment,
        result_value_size_in_bytes: u64,
        filter_out: &'r mut [SnapshotRegionFilter],
        out_cursor: u64
    ) -> SnapshotRegionFilterCollection {
        transition out_cursor <= out_cursor && out_cursor <= filter_out.len {
            true -> make_empty(
                data_type_id,
                memory_alignment,
                result_value_size_in_bytes,
                filter_out,
                out_cursor
            )
            false -> abort_scan(filter_out, data_type_id)
            _ -> abort_scan(filter_out, data_type_id)
        }
    }

    state make_empty(
        data_type_id: &'t [u8],
        memory_alignment: MemoryAlignment,
        result_value_size_in_bytes: u64,
        filter_out: &'r mut [SnapshotRegionFilter],
        out_cursor: u64
    ) -> SnapshotRegionFilterCollection {
        let empty_view: &'r [SnapshotRegionFilter] = ElementScanDispatcher::view_filter_range(
            filter_out,
            out_cursor,
            out_cursor
        );
        SnapshotRegionFilterCollection::new_with_result_size(
            empty_view,
            DataTypeRef::new(data_type_id),
            memory_alignment,
            result_value_size_in_bytes,
            0
        )
    }

    state scan_input(
        snapshot_region: &SnapshotRegion,
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        element_scan_plan: &ElementScanPlan,
        data_type_id: &'t [u8],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        result_value_size_in_bytes: u64,
        filter_index: u64,
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        filter_out: &'r mut [SnapshotRegionFilter],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        out_cursor: u64,
        out_len: u64
    ) -> SnapshotRegionFilterCollection {
        let filters: &'r [SnapshotRegionFilter] =
            snapshot_region_filter_collection.get_filters();
        transition filter_index < filters.len {
            true -> copy_in(
                snapshot_region,
                snapshot_region_filter_collection,
                element_scan_plan,
                data_type_id,
                constraint_count,
                memory_alignment,
                result_value_size_in_bytes,
                filter_index,
                current_elements,
                previous_elements,
                driver_cell,
                filter_out,
                round_a,
                round_b,
                out_cursor,
                out_len
            )
            false -> build_collection(
                snapshot_region_filter_collection,
                element_scan_plan,
                data_type_id,
                constraint_count,
                memory_alignment,
                result_value_size_in_bytes,
                filter_out,
                out_cursor,
                out_len
            )
            _ -> build_collection(
                snapshot_region_filter_collection,
                element_scan_plan,
                data_type_id,
                constraint_count,
                memory_alignment,
                result_value_size_in_bytes,
                filter_out,
                out_cursor,
                out_len
            )
        }
    }

    // Clone the input filter before the chain: an element borrow of the
    // collection's `&'r` filter view carried through the chain would share
    // 'r with `filter_out` in the returned collection — a form the checker
    // rejects. The clone is a value; the seed slab stays read-only here.
    state copy_in(
        snapshot_region: &SnapshotRegion,
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        element_scan_plan: &ElementScanPlan,
        data_type_id: &'t [u8],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        result_value_size_in_bytes: u64,
        filter_index: u64,
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        filter_out: &'r mut [SnapshotRegionFilter],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        out_cursor: u64,
        out_len: u64
    ) -> SnapshotRegionFilterCollection {
        let filters: &'r [SnapshotRegionFilter] =
            snapshot_region_filter_collection.get_filters();
        transition filter_index < filters.len {
            true -> clone_input(
                snapshot_region,
                snapshot_region_filter_collection,
                element_scan_plan,
                data_type_id,
                constraint_count,
                memory_alignment,
                result_value_size_in_bytes,
                filter_index,
                filters,
                current_elements,
                previous_elements,
                driver_cell,
                filter_out,
                round_a,
                round_b,
                out_cursor,
                out_len
            )
            false -> build_collection(
                snapshot_region_filter_collection,
                element_scan_plan,
                data_type_id,
                constraint_count,
                memory_alignment,
                result_value_size_in_bytes,
                filter_out,
                out_cursor,
                out_len
            )
            _ -> build_collection(
                snapshot_region_filter_collection,
                element_scan_plan,
                data_type_id,
                constraint_count,
                memory_alignment,
                result_value_size_in_bytes,
                filter_out,
                out_cursor,
                out_len
            )
        }
    }

    state clone_input(
        snapshot_region: &SnapshotRegion,
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        element_scan_plan: &ElementScanPlan,
        data_type_id: &'t [u8],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        result_value_size_in_bytes: u64,
        filter_index: u64,
        filters: &'f [SnapshotRegionFilter],
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        filter_out: &'r mut [SnapshotRegionFilter],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        out_cursor: u64,
        out_len: u64
    ) -> SnapshotRegionFilterCollection {
        let input_filter: SnapshotRegionFilter =
            SnapshotRegionFilter::clone(&filters[filter_index]);
        transition { _ -> chain(
            snapshot_region,
            snapshot_region_filter_collection,
            element_scan_plan,
            data_type_id,
            constraint_count,
            memory_alignment,
            result_value_size_in_bytes,
            filter_index,
            input_filter,
            current_elements,
            previous_elements,
            driver_cell,
            filter_out,
            round_a,
            round_b,
            out_cursor,
            out_len
        ) }
    }

    state chain(
        snapshot_region: &SnapshotRegion,
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        element_scan_plan: &ElementScanPlan,
        data_type_id: &'t [u8],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        result_value_size_in_bytes: u64,
        filter_index: u64,
        input_filter: SnapshotRegionFilter,
        current_elements: &mut [u64],
        previous_elements: &mut [u64],
        driver_cell: &mut [ScalarRegionScan],
        filter_out: &'r mut [SnapshotRegionFilter],
        round_a: &mut [SnapshotRegionFilter],
        round_b: &mut [SnapshotRegionFilter],
        out_cursor: u64,
        out_len: u64
    ) -> SnapshotRegionFilterCollection {
        let next_out_len: u64 = run_filter_chain(
            snapshot_region,
            result_value_size_in_bytes,
            element_scan_plan,
            data_type_id,
            constraint_count,
            &input_filter,
            current_elements,
            previous_elements,
            driver_cell,
            filter_out,
            out_len,
            round_a,
            round_b
        );
        transition { _ -> scan_input(
            snapshot_region,
            snapshot_region_filter_collection,
            element_scan_plan,
            data_type_id,
            constraint_count,
            memory_alignment,
            result_value_size_in_bytes,
            ((filter_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            current_elements,
            previous_elements,
            driver_cell,
            filter_out,
            round_a,
            round_b,
            out_cursor,
            next_out_len
        ) }
    }

    state build_collection(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        element_scan_plan: &ElementScanPlan,
        data_type_id: &'t [u8],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        result_value_size_in_bytes: u64,
        filter_out: &'r mut [SnapshotRegionFilter],
        out_cursor: u64,
        out_len: u64
    ) -> SnapshotRegionFilterCollection {
        transition out_cursor <= out_len && out_len <= filter_out.len {
            true -> make_collection(
                snapshot_region_filter_collection,
                element_scan_plan,
                data_type_id,
                constraint_count,
                memory_alignment,
                result_value_size_in_bytes,
                filter_out,
                out_cursor,
                out_len
            )
            false -> abort_scan(filter_out, data_type_id)
            _ -> abort_scan(filter_out, data_type_id)
        }
    }

    state make_collection(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        element_scan_plan: &ElementScanPlan,
        data_type_id: &'t [u8],
        constraint_count: u64,
        memory_alignment: MemoryAlignment,
        result_value_size_in_bytes: u64,
        filter_out: &'r mut [SnapshotRegionFilter],
        out_cursor: u64,
        out_len: u64
    ) -> SnapshotRegionFilterCollection {
        let view: &'r [SnapshotRegionFilter] = ElementScanDispatcher::view_filter_range(
            filter_out,
            out_cursor,
            out_len
        );
        let number_of_results: u64 =
            SnapshotRegionFilterCollection::count_results(
                view,
                result_value_size_in_bytes,
                memory_alignment,
                0,
                0
            );
        let data_type_ref: DataTypeRef =
            snapshot_region_filter_collection.get_data_type_ref();
        let container_type: ContainerType = resolve_result_container_type(
            element_scan_plan,
            data_type_id,
            constraint_count
        );
        let collection: SnapshotRegionFilterCollection =
            SnapshotRegionFilterCollection::new_with_result_size(
                view,
                data_type_ref,
                memory_alignment,
                result_value_size_in_bytes,
                number_of_results
            );
        collection.with_result_container_type(container_type)
    }

    state abort_scan(
        filter_out: &'r mut [SnapshotRegionFilter],
        data_type_id: &'t [u8]
    ) -> SnapshotRegionFilterCollection {
        crash Abort;
    }
}
