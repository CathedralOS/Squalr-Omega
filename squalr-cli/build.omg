// Package boundary and internal edges mirror upstream squalr-cli/Cargo.toml.
machine build(builder: &mut Build) {
    Build::application(builder, "squalr_cli");
    Build::depend(builder, Source::Path { location: "../squalr-engine" });
    Build::depend(builder, Source::Path { location: "../squalr-engine-api" });
    Build::depend(builder, Source::Path { location: "../squalr-engine-session" });
    Build::depend(builder, Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "6cd22386cbb51240d17751e61d82b88632bbcd41",
        selection: PackageSelection::Named { package: "omega_language_std" }
    });
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
}
