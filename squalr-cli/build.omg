// Package boundary and internal edges mirror upstream squalr-cli/Cargo.toml.
machine build(builder: &mut Build) {
    builder.application("squalr-cli");
    builder.depend(Source::Path { location: "../squalr-engine" });
    builder.depend(Source::Path { location: "../squalr-engine-api" });
    builder.depend(Source::Path { location: "../squalr-engine-session" });
    builder.depend(Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "56adcc62ec3ae4b403e4e2e7546680447460f4f6",
        selection: PackageSelection::Named { package: "omega-language-std" }
    });
    builder.roots.bind(windows_x86_64::ProgramEntry, Main::main);
    builder.roots.bind(linux_x86_64::ProgramEntry, Main::main);
    builder.roots.bind(linux_arm64::ProgramEntry, Main::main);
    builder.roots.bind(macos_arm64::ProgramEntry, Main::main);
}
