module src::cli;

use squalr_engine_api::src::commands::command_line::command_line_command::CommandLineCommand;
use squalr_engine_api::src::commands::command_line::command_line_parser::CommandLineParse;
use squalr_engine_api::src::commands::privileged_command::PrivilegedCommand;
use squalr_engine_api::src::commands::command_line::command_line_parser::CommandLineParser;
use squalr_engine_api::src::commands::scan_results::list::scan_results_list_response::ScanResultsListResponse;
use squalr_engine_api::src::structures::scan_results::scan_result::ScanResult;
use squalr_engine::src::squalr_engine::SqualrEngine;
use omega_language_std::console;
use omega_language_std::filesystem_host;
use omega::language::core::wait_wake;
use src::command_framer::CommandFramer;

// Port of cli.rs `Cli::run_loop` for the headless leg: read stdin lines,
// `exit`/`close`/`quit` (case-insensitive) breaks, each line parses to a
// privileged command and dispatches through the engine. Scan responses
// print nothing — upstream's empty scan handlers — and `scan-results list`
// prints one `0x<address> = <current>` line per result.
pub data Cli {
    engine: SqualrEngine;
    line_buffer: [u8; 512];
    last_list: ScanResultsListResponse;
    framer: CommandFramer;
    next_invocation_id: u64;
}

pub machine Cli::init(&mut self) {
    self.engine.init_privileged_shell();
    self.framer = CommandFramer::new();
    self.next_invocation_id = 0;
}

// `exit`/`close`/`quit` — case-insensitive per upstream.
pub machine Cli::is_exit_line(&mut self, count: u64) -> bool {
    let is_exit: bool = self.token_is_ci(count, 0, 1414092869, 4);
    let is_close: bool = self.token_is_ci(count, 0, 297750449219, 5);
    let is_quit: bool = self.token_is_ci(count, 0, 1414092113, 4);
    is_exit || is_close || is_quit
}

// Bounded view over the retained input line for `CommandLineParser::parse`
// (mirrors DataTypeRef::get_data_type_id's field-slice tail shape).
machine Cli::line_view(&self, count: u64) -> &[u8] {
    transition count <= 512 {
        true -> arm_result_38_0(count)
        _ -> (&self.line_buffer[0..0])
    }
    state arm_result_38_0(&self, count: u64) -> &[u8]
    requires count <= 512;
    {
        (&self.line_buffer[0..count])
    }
}


// One-token, case-folded compare of `line[0..count]` against `word`.
machine Cli::token_is_ci(&self, count: u64, position: u64, word_pack: u64, word_len: u64) -> bool {
    transition position < count && position < word_len {
        true -> compare(count, position, word_pack, word_len)
        false -> finish(count, position, word_pack, word_len)
        _ -> finish(count, position, word_pack, word_len)
    }
    state compare(&self, count: u64, position: u64, word_pack: u64, word_len: u64) -> bool {
        transition position < 512 {
            true -> check(count, position, word_pack, word_len)
            false -> (false)
        }
    }
    state check(&self, count: u64, position: u64, word_pack: u64, word_len: u64) -> bool
    requires 0 <= position && position < 512;
    {
        transition position < word_len && position < 8 {
            true -> matches_at(count, position, word_pack, word_len)
            false -> (false)
        }
    }
    state matches_at(&self, count: u64, position: u64, word_pack: u64, word_len: u64) -> bool
    requires 0 <= position && position < 512;
    {
        let upper: u8 = Cli::to_upper(self.line_buffer[position]);
        let expected: u8 = (((word_pack as u64 in Wrapping) >> (((position as u64 in Wrapping) * (8 as u64 in Wrapping)) as u64 in Wrapping)) & 255) as u8;
        transition upper == expected {
            true -> token_is_ci(count, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, word_pack, word_len)
            false -> (false)
        }
    }
    state finish(&self, count: u64, position: u64, word_pack: u64, word_len: u64) -> bool {
        transition position == count && position == word_len {
            true -> (true)
            false -> (false)
        }
    }
}

machine Cli::to_upper(byte: u8) -> u8 {
    transition byte >= 97 && byte <= 122 {
        true -> ((byte - 32) as u8)
        false -> (byte)
        _ -> (byte)
    }
}

// Largest power-of-ten ≤ value — the print_dec64 cursor seed.
machine Cli::dec_places(&mut self, value: u64) -> u64 {
    transition { _ -> grow(value, 1) }
    state grow(value: u64, place: u64) -> u64 {
        transition value >= 10 && place <= 1000000000000000000 {
            true -> check(value, place)
            false -> (place)
        }
    }
    state check(value: u64, place: u64) -> u64 {
        let next: u64 = ((place as u64 in Wrapping) * 10) as u64;
        transition next <= value {
            true -> grow(value, next)
            false -> (place)
        }
    }
}

// Upstream `Cli::run_loop`: read stdin lines, `exit`/`close`/`quit`
// (case-insensitive) breaks, each line parses to a privileged command and
// dispatches through the engine. Scan responses print nothing —
// upstream's empty scan handlers — and `scan-results list` prints one
// `0x<address> = <current>` line per result.
pub machine Cli::run(&mut self)
reaches Console
reaches FilesystemHost
reaches WaitWake
invokes Console;
invokes FilesystemHost;
invokes WaitWake;
blocks;
crashes Abort
crashes Trap
{
    transition { _ -> read() }

    // framer_v2: stdin arrives one byte per `Console::read_byte`; each
    // offered byte may complete a frame — its own 0x0a delimiter, or a
    // saturated pending extent (the Full-style partial boundary). The
    // framer owns the buffering `read_line` used to do; the
    // got_line/bound_count/parsed chain is unchanged.
    state read(&mut self) {
        let observed: ByteRead = block Console::read_byte();
        // Union scrutinees are admitted on params, not let-bound locals —
        // the case split rides a hop state.
        transition {
            _ -> read_kind(observed)
        }
    }

    state read_kind(&mut self, observed: ByteRead) {
        transition observed {
            ByteRead::Byte { value } -> offer_byte(value)
            ByteRead::Eof -> flush()
            _ -> read()
        }
    }

    state offer_byte(&mut self, value: i32) {
        // Offer refused means the pending extent is saturated — take emits
        // the 512-byte Full-style partial so the refused byte re-offers
        // next as the head of the retained remainder.
        let accepted: bool = self.framer.offer_byte((value as u8));
        transition accepted {
            true -> check_boundary(value)
            _ -> take_frame(false)
        }
    }

    state check_boundary(&mut self, value: i32) {
        // pending never holds a delimiter between takes (each 0x0a takes
        // immediately), so only the just-offered byte can complete a frame.
        transition value == 10 {
            true -> take_frame(false)
            _ -> read()
        }
    }

    state take_frame(&mut self, end_after: bool) {
        // The framer holds the emitted frame; bytes land in line_buffer
        // through the admitted indexed field-store shape (no `&mut self.
        // <field>` argument crosses a machine call — pad_line's deviation).
        let count: u64 = self.framer.try_take_frame();
        transition { _ -> copy_frame(0, count, end_after) }
    }

    state copy_frame(&mut self, at: u64, count: u64, end_after: bool) {
        transition at < count && at < 512 {
            true -> copy_byte(at, count, end_after)
            _ -> got_line(count, end_after)
        }
    }

    state copy_byte(&mut self, at: u64, count: u64, end_after: bool)
        requires at < 512;
    {
        let byte: u8 = self.framer.get_frame_byte(at);
        self.line_buffer[at] = byte;
        transition { _ -> copy_frame(((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, count, end_after) }
    }

    state flush(&mut self) {
        // EOF: `close` flushes pending bytes as the final frame (upstream's
        // `Ok(n>0)` without the delimiter); empty pending ends the stream.
        let count: u64 = self.framer.close();
        transition count > 0 {
            true -> copy_frame(0, count, true)
            _ -> exit()
        }
    }

    state got_line(&mut self, count: u64, end_after: bool) {
        let is_exit: bool = self.is_exit_line(count);
        transition is_exit {
            true -> exit()
            false -> bound_count(count, end_after)
        }
    }

    state bound_count(&mut self, count: u64, end_after: bool) {
        transition count <= 512 {
            true -> parsed(count, end_after)
            _ -> parsed(512, end_after)
        }
    }

    state parsed(&mut self, count: u64, end_after: bool) {
        let done: bool = self.parse_line(count, end_after);
        transition done {
            true -> exit()
            _ -> read()
        }
    }

    state exit(&mut self) {
        Console::exit_process(0);
    }
}

// Named deviation: upstream `pad_line(&mut self.line_buffer, count)` passes
// the buffer as a `&mut self.<field>` argument, which the checker declines
// (`call operation: structural arguments: parameter path`) whenever a
// `Binding` capability field is reachable through the entry data type.
// The pad lives on `self` as an indexed field-element store, the admitted
// shape — kept after the capability members moved to `invokes` ceilings,
// since the trait-level calls still route through the same program.
machine Cli::pad_line(&mut self, count: u64) -> u64 {
    transition count < 512 {
        true -> pad(count)
        _ -> (0)
    }
    state pad(&mut self, position: u64) -> u64 {
        self.line_buffer[position] = 32;
        transition position + 1 < 512 {
            true -> pad(position + 1)
            _ -> (0)
        }
    }
}

machine Cli::parse_line(&mut self, count: u64, end_after: bool) -> bool
reaches Console
reaches FilesystemHost
reaches WaitWake
invokes Console;
invokes FilesystemHost;
invokes WaitWake;
crashes Abort
crashes Trap
{
    // `read_line` fills only `line_buffer[0..count]`; stale bytes past `count`
    // would extend the last token. `pad_line` spaces them out first — bound
    // exactly like Rust's `line[..count]` slice — then the whole buffer parses.
    let padded: u64 = self.pad_line(count);
    transition { _ -> parse_it(end_after) }
    state parse_it(&mut self, end_after: bool) -> bool {
        let parse: CommandLineParse = CommandLineParser::parse(&self.line_buffer);
        transition { _ -> dispatched(parse, end_after) }
    }

    state dispatched(&mut self, parse: CommandLineParse, end_after: bool) {
        // framer_v2 wire: the parse owns the command — decompose it into an
        // owned CommandLineCommand here (union payloads move out of owned
        // scrutinees only), then hand the privileged payload through the
        // send_invocation seam.
        transition parse {
            CommandLineParse::Parsed { command } -> walk(command, end_after)
            _ -> refuse(end_after)
        }
    }

    state walk(&mut self, command: CommandLineCommand, end_after: bool) {
        transition command {
            CommandLineCommand::Privileged { command } -> send(command, end_after)
        }
    }

    state send(&mut self, command: PrivilegedCommand, end_after: bool) {
        // The CommandInvocation envelope mints inside the engine boundary —
        // union construction on owned values is admitted there while union
        // values cannot cross the entry's unit-plan edge, so cli moves the
        // payload through and the envelope wraps it engine-side. The id
        // rides a cli-local counter for now: upstream's allocator is
        // `next_command_invocation_id.fetch_add(1)` on the unprivileged
        // state — filed as the next sub-leg with that port.
        let list: ScanResultsListResponse = self.engine.dispatch_invocation_list(command, self.next_invocation_id);
        self.next_invocation_id = ((self.next_invocation_id as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> storing(list, end_after) }
    }

    state storing(&mut self, list: ScanResultsListResponse, end_after: bool) {
        self.last_list.clone_from(&list);
        transition { _ -> print_head(end_after) }
    }

    state print_head(&mut self, end_after: bool) {
        let count: u64 = self.last_list.get_result_count();
        transition { _ -> print_at(count, 0, end_after) }
    }

    state print_at(&mut self, count: u64, position: u64, end_after: bool) {
        transition position < count {
            true -> print_one(count, position, end_after)
            false -> done(end_after)
        }
    }

    state print_one(&mut self, count: u64, position: u64, end_after: bool) {
        let scan_result: ScanResult = self.last_list.get_result(position);
        let is_valued: bool = scan_result.is_valued();
        let address: u64 = scan_result.get_address();
        let current: u64 = scan_result.get_current_value();
        let has_current: bool = scan_result.has_current_value();
        transition is_valued {
            true -> print_valued(address, has_current, current, count, position, end_after)
            _ -> print_next(count, position, end_after)
        }
    }

    // `0x` + 16 hex digits — the list line's address column.
    state print_valued(&mut self, address: u64, has_current: bool, current: u64, count: u64, position: u64, end_after: bool) {
        Console::write_byte(48);
        Console::write_byte(120);
        transition { _ -> hex_digit(address, 60, has_current, current, count, position, end_after) }
    }

    state hex_digit(&mut self, value: u64, shift: u64, has_current: bool, current: u64, count: u64, position: u64, end_after: bool) {
        let nibble: u64 = (((value as u64 in Wrapping) >> (shift as u64 in Wrapping)) as u64) & 15;
        transition nibble < 10 {
            true -> hex_decimal(value, shift, nibble, has_current, current, count, position, end_after)
            false -> hex_letter(value, shift, nibble, has_current, current, count, position, end_after)
        }
    }

    state hex_decimal(&mut self, value: u64, shift: u64, nibble: u64, has_current: bool, current: u64, count: u64, position: u64, end_after: bool) {
        let glyph: u8 = (nibble + 48) as u8;
        Console::write_byte(glyph as i32);
        transition { _ -> hex_next(value, shift, has_current, current, count, position, end_after) }
    }

    state hex_letter(&mut self, value: u64, shift: u64, nibble: u64, has_current: bool, current: u64, count: u64, position: u64, end_after: bool) {
        let glyph: u8 = (nibble + 87) as u8;
        Console::write_byte(glyph as i32);
        transition { _ -> hex_next(value, shift, has_current, current, count, position, end_after) }
    }

    state hex_next(&mut self, value: u64, shift: u64, has_current: bool, current: u64, count: u64, position: u64, end_after: bool) {
        transition shift > 0 {
            true -> hex_digit(value, ((shift as u64 in Wrapping) - (4 as u64 in Wrapping)) as u64, has_current, current, count, position, end_after)
            false -> hex_done(has_current, current, count, position, end_after)
        }
    }

    state hex_done(&mut self, has_current: bool, current: u64, count: u64, position: u64, end_after: bool) {
        Console::write(" = ");
        transition has_current {
            true -> dec_head(current, count, position, end_after)
            false -> print_no_value(count, position, end_after)
        }
    }

    state dec_head(&mut self, current: u64, count: u64, position: u64, end_after: bool) {
        transition current > 0 {
            true -> dec_places_head(current, count, position, end_after)
            false -> dec_zero(count, position, end_after)
        }
    }

    state dec_places_head(&mut self, current: u64, count: u64, position: u64, end_after: bool) {
        let place: u64 = self.dec_places(current);
        transition { _ -> dec_digit(current, place, count, position, end_after) }
    }

    state dec_zero(&mut self, count: u64, position: u64, end_after: bool) {
        Console::write_byte(48);
        transition { _ -> dec_done(count, position, end_after) }
    }

    state dec_digit(&mut self, value: u64, place: u64, count: u64, position: u64, end_after: bool) {
        let digit: u8 = ((((value as u64 in Wrapping) / (place as u64 in Wrapping)) as u64) % 10) as u8;
        Console::write_byte((digit + 48) as i32);
        transition place > 1 {
            true -> dec_down(value, place, count, position, end_after)
            false -> dec_done(count, position, end_after)
        }
    }

    state dec_down(&mut self, value: u64, place: u64, count: u64, position: u64, end_after: bool) {
        transition { _ -> dec_digit(value, place / 10, count, position, end_after) }
    }

    state dec_done(&mut self, count: u64, position: u64, end_after: bool) {
        Console::write_byte(10);
        transition { _ -> print_next(count, position, end_after) }
    }

    state print_no_value(&mut self, count: u64, position: u64, end_after: bool) {
        Console::write_line("?");
        transition { _ -> print_next(count, position, end_after) }
    }

    state print_next(&mut self, count: u64, position: u64, end_after: bool) {
        transition { _ -> print_at(count, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, end_after) }
    }

    state refuse(&mut self, end_after: bool) {
        Console::write_line("unrecognized command");
        transition { _ -> done(end_after) }
    }

    state done(&mut self, end_after: bool) -> bool {
        transition { _ -> (end_after) }
    }

}

// Dispatch the parsed line's command inside one machine boundary: machine-top
// `let` is the only place a call-produced `&[u8]` view can live (states jail
// affine view locals and edges refuse slice-producing args).

