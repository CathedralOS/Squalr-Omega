module src::cli;

use squalr_engine_api::src::commands::command_line::command_line_command::CommandLineCommand;
use squalr_engine_api::src::commands::command_line::command_line_parser::CommandLineParse;
use squalr_engine_api::src::commands::privileged_command::PrivilegedCommand;
use squalr_engine_api::src::commands::command_line::command_line_parser::CommandLineParser;
use squalr_engine_api::src::commands::scan_results::list::scan_results_list_response::ScanResultsListResponse;
use squalr_engine_api::src::structures::scan_results::scan_result::ScanResult;
use squalr_engine::src::squalr_engine::SqualrEngine;
use omega_language_std::console;
use omega_language_std::filesystem_host;
use omega::language::core::wait_wake;
use src::command_framer::CommandFramer;

// Port of cli.rs `Cli::run_loop` for the headless leg: read stdin lines,
// `exit`/`close`/`quit` (case-insensitive) breaks, each line parses to a
// privileged command and dispatches through the engine. Scan responses
// print nothing — upstream's empty scan handlers — and `scan-results list`
// prints one `0x<address> = <current>` line per result.
pub data Cli {
    engine: SqualrEngine;
    line_buffer: [u8; 512];
    last_list: ScanResultsListResponse;
    framer: CommandFramer;
}

pub machine Cli::init(cli: &mut Cli) {
    // Upstream cli runs `EngineMode::Standalone` — the unprivileged state
    // owns the invocation-id allocator and the dispatch pipeline rides it.
    cli.engine.init_standalone();
    cli.framer = CommandFramer::new();
}

// `exit`/`close`/`quit` — case-insensitive per upstream.
pub machine Cli::is_exit_line(cli: &mut Cli, count: u64) -> bool {
    let is_exit: bool = Cli::token_is_ci(cli, count, 0, 1414092869, 4);
    let is_close: bool = Cli::token_is_ci(cli, count, 0, 297750449219, 5);
    let is_quit: bool = Cli::token_is_ci(cli, count, 0, 1414092113, 4);
    is_exit || is_close || is_quit
}

// Bounded view over the retained input line for `CommandLineParser::parse`
// (mirrors DataTypeRef::get_data_type_id's field-slice tail shape).
machine Cli::line_view(cli: &Cli, count: u64) -> &[u8] {
    transition count <= 512 {
        true -> arm_result_38_0(cli, count)
        _ -> (&cli.line_buffer[0..0])
    }
    state arm_result_38_0(cli: &Cli, count: u64) -> &[u8]
    requires count <= 512;
    {
        (&cli.line_buffer[0..count])
    }
}


// One-token, case-folded compare of `line[0..count]` against `word`.
machine Cli::token_is_ci(cli: &Cli, count: u64, position: u64, word_pack: u64, word_len: u64) -> bool {
    transition position < count && position < word_len {
        true -> compare(cli, count, position, word_pack, word_len)
        false -> finish(cli, count, position, word_pack, word_len)
        _ -> finish(cli, count, position, word_pack, word_len)
    }
    state compare(cli: &Cli, count: u64, position: u64, word_pack: u64, word_len: u64) -> bool {
        transition position < 512 {
            true -> check(cli, count, position, word_pack, word_len)
            false -> (false)
        }
    }
    state check(cli: &Cli, count: u64, position: u64, word_pack: u64, word_len: u64) -> bool
    requires 0 <= position && position < 512;
    {
        transition position < word_len && position < 8 {
            true -> matches_at(cli, count, position, word_pack, word_len)
            false -> (false)
        }
    }
    state matches_at(cli: &Cli, count: u64, position: u64, word_pack: u64, word_len: u64) -> bool
    requires 0 <= position && position < 512;
    {
        let upper: u8 = Cli::to_upper(cli.line_buffer[position]);
        let expected: u8 = (((word_pack as u64 in Wrapping) >> (((position as u64 in Wrapping) * (8 as u64 in Wrapping)) as u64 in Wrapping)) & 255) as u8;
        transition upper == expected {
            true -> Cli::token_is_ci(cli, count, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, word_pack, word_len)
            false -> (false)
        }
    }
    state finish(cli: &Cli, count: u64, position: u64, word_pack: u64, word_len: u64) -> bool {
        transition position == count && position == word_len {
            true -> (true)
            false -> (false)
        }
    }
}

machine Cli::to_upper(byte: u8) -> u8 {
    transition byte >= 97 && byte <= 122 {
        true -> ((byte - 32) as u8)
        false -> (byte)
        _ -> (byte)
    }
}

// Largest power-of-ten ≤ value — the print_dec64 cursor seed.
machine Cli::dec_places(cli: &mut Cli, value: u64) -> u64 {
    transition { _ -> grow(value, 1, cli) }
    state grow(value: u64, place: u64, cli: &mut Cli) -> u64 {
        transition value >= 10 && place <= 1000000000000000000 {
            true -> check(cli, value, place, cli)
            false -> (place)
        }
    }
    state check(value: u64, place: u64, cli: &mut Cli) -> u64 {
        let next: u64 = ((place as u64 in Wrapping) * 10) as u64;
        transition next <= value {
            true -> grow(value, next, cli)
            false -> (place)
        }
    }
}

// Upstream `Cli::run_loop`: read stdin lines, `exit`/`close`/`quit`
// (case-insensitive) breaks, each line parses to a privileged command and
// dispatches through the engine. Scan responses print nothing —
// upstream's empty scan handlers — and `scan-results list` prints one
// `0x<address> = <current>` line per result.
pub machine Cli::run(cli: &mut Cli)
reaches Console
reaches FilesystemHost
reaches WaitWake
invokes Console;
invokes FilesystemHost;
invokes WaitWake;
blocks;
crashes Abort
crashes Trap
{
    transition { _ -> read(cli) }

    // framer_v2: stdin arrives one byte per `Console::read_byte`; each
    // offered byte may complete a frame — its own 0x0a delimiter, or a
    // saturated pending extent (the Full-style partial boundary). The
    // framer owns the buffering `read_line` used to do; the
    // got_line/bound_count/parsed chain is unchanged.
    state read(cli: &mut Cli) {
        let observed: ByteRead = block Console::read_byte();
        // Union scrutinees are admitted on params, not let-bound locals —
        // the case split rides a hop state.
        transition {
            _ -> read_kind(cli, observed)
        }
    }

    state read_kind(cli: &mut Cli, observed: ByteRead) {
        transition observed {
            ByteRead::Byte { value } -> offer_byte(cli, value)
            ByteRead::Eof -> flush(cli)
            _ -> read(cli)
        }
    }

    state offer_byte(cli: &mut Cli, value: i32) {
        // Offer refused means the pending extent is saturated — take emits
        // the 512-byte Full-style partial so the refused byte re-offers
        // next as the head of the retained remainder.
        let accepted: bool = CommandFramer::offer_byte(&mut cli.framer, (value as u8));
        transition accepted {
            true -> check_boundary(cli, value)
            _ -> take_frame(cli, false)
        }
    }

    state check_boundary(cli: &mut Cli, value: i32) {
        // pending never holds a delimiter between takes (each 0x0a takes
        // immediately), so only the just-offered byte can complete a frame.
        transition value == 10 {
            true -> take_frame(cli, false)
            _ -> read(cli)
        }
    }

    state take_frame(cli: &mut Cli, end_after: bool) {
        // The framer holds the emitted frame; bytes land in line_buffer
        // through the admitted indexed field-store shape (no `&mut self.
        // <field>` argument crosses a machine call — pad_line's deviation).
        let count: u64 = CommandFramer::try_take_frame(&mut cli.framer);
        transition { _ -> copy_frame(cli, 0, count, end_after) }
    }

    state copy_frame(cli: &mut Cli, at: u64, count: u64, end_after: bool) {
        transition at < count && at < 512 {
            true -> copy_byte(cli, at, count, end_after)
            _ -> got_line(cli, count, end_after)
        }
    }

    state copy_byte(cli: &mut Cli, at: u64, count: u64, end_after: bool)
        requires at < 512;
    {
        let byte: u8 = CommandFramer::get_frame_byte(&cli.framer, at);
        cli.line_buffer[at] = byte;
        transition { _ -> copy_frame(cli, ((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, count, end_after) }
    }

    state flush(cli: &mut Cli) {
        // EOF: `close` flushes pending bytes as the final frame (upstream's
        // `Ok(n>0)` without the delimiter); empty pending ends the stream.
        let count: u64 = CommandFramer::close(&mut cli.framer);
        transition count > 0 {
            true -> copy_frame(cli, 0, count, true)
            _ -> exit(cli)
        }
    }

    state got_line(cli: &mut Cli, count: u64, end_after: bool) {
        let is_exit: bool = Cli::is_exit_line(cli, count);
        transition is_exit {
            true -> exit(cli)
            false -> bound_count(cli, count, end_after)
        }
    }

    state bound_count(cli: &mut Cli, count: u64, end_after: bool) {
        transition count <= 512 {
            true -> parsed(cli, count, end_after)
            _ -> parsed(cli, 512, end_after)
        }
    }

    state parsed(cli: &mut Cli, count: u64, end_after: bool) {
        let done: bool = Cli::parse_line(cli, count, end_after);
        transition done {
            true -> exit(cli)
            _ -> read(cli)
        }
    }

    state exit(cli: &mut Cli) {
        Console::exit_process(0);
    }
}

// Named deviation: upstream `pad_line(&mut self.line_buffer, count)` passes
// the buffer as a `&mut self.<field>` argument, which the checker declines
// (`call operation: structural arguments: parameter path`) whenever a
// `Binding` capability field is reachable through the entry data type.
// The pad lives on `self` as an indexed field-element store, the admitted
// shape — kept after the capability members moved to `invokes` ceilings,
// since the trait-level calls still route through the same program.
machine Cli::pad_line(cli: &mut Cli, count: u64) -> u64 {
    transition count < 512 {
        true -> pad(cli, count)
        _ -> (0)
    }
    state pad(cli: &mut Cli, position: u64) -> u64 {
        cli.line_buffer[position] = 32;
        transition position + 1 < 512 {
            true -> pad(cli, position + 1)
            _ -> (0)
        }
    }
}

machine Cli::parse_line(cli: &mut Cli, count: u64, end_after: bool) -> bool
reaches Console
reaches FilesystemHost
reaches WaitWake
invokes Console;
invokes FilesystemHost;
invokes WaitWake;
crashes Abort
crashes Trap
{
    // `read_line` fills only `line_buffer[0..count]`; stale bytes past `count`
    // would extend the last token. `pad_line` spaces them out first — bound
    // exactly like Rust's `line[..count]` slice — then the whole buffer parses.
    let padded: u64 = Cli::pad_line(cli, count);
    transition { _ -> parse_it(cli, end_after, count) }
    state parse_it(cli: &mut Cli, end_after: bool, count: u64) -> bool {
        let parse: CommandLineParse = CommandLineParser::parse(&cli.line_buffer);
        transition { _ -> dispatched(cli, parse, end_after, count) }
    }

    state dispatched(cli: &mut Cli, parse: CommandLineParse, end_after: bool, count: u64) {
        // framer_v2 wire: the parse owns the command — decompose it into an
        // owned CommandLineCommand here (union payloads move out of owned
        // scrutinees only), then hand the privileged payload through the
        // send_invocation seam.
        transition parse {
            CommandLineParse::Parsed { command } -> walk(cli, command, end_after, count)
            _ -> refuse(cli, end_after)
        }
    }

    state walk(cli: &mut Cli, command: CommandLineCommand, end_after: bool, count: u64) {
        transition command {
            CommandLineCommand::Privileged { command } -> send(cli, command, end_after, count)
        }
    }

    state send(cli: &mut Cli, command: PrivilegedCommand, end_after: bool, count: u64) {
        // The CommandInvocation envelope mints inside the engine boundary —
        // union construction on owned values is admitted there while union
        // values cannot cross the entry's unit-plan edge, so cli moves the
        // payload through and the envelope wraps it engine-side. The id
        // allocates on the unprivileged state's fetch_add counter, same as
        // upstream's `create_command_invocation`.
        let list: ScanResultsListResponse = cli.engine.dispatch_invocation_list(command);
        transition { _ -> storing(cli, list, end_after, count) }
    }

    state storing(cli: &mut Cli, list: ScanResultsListResponse, end_after: bool, count: u64) {
        ScanResultsListResponse::clone_from(&mut cli.last_list, &list);
        transition { _ -> print_head(cli, end_after, count) }
    }

    state print_head(cli: &mut Cli, end_after: bool, count: u64) {
        let count: u64 = ScanResultsListResponse::get_result_count(&cli.last_list);
        transition { _ -> print_at(cli, count, 0, end_after) }
    }

    state print_at(cli: &mut Cli, count: u64, position: u64, end_after: bool) {
        transition position < count {
            true -> print_one(cli, count, position, end_after)
            false -> done(cli, end_after)
        }
    }

    state print_one(cli: &mut Cli, count: u64, position: u64, end_after: bool) {
        let scan_result: ScanResult = ScanResultsListResponse::get_result(&cli.last_list, position);
        let is_valued: bool = ScanResult::is_valued(&scan_result);
        let address: u64 = ScanResult::get_address(&scan_result);
        let current: u64 = ScanResult::get_current_value(&scan_result);
        let has_current: bool = ScanResult::has_current_value(&scan_result);
        transition is_valued {
            true -> print_valued(cli, address, has_current, current, count, position, end_after)
            _ -> print_next(cli, count, position, end_after)
        }
    }

    // `0x` + 16 hex digits — the list line's address column.
    state print_valued(cli: &mut Cli, address: u64, has_current: bool, current: u64, count: u64, position: u64, end_after: bool) {
        Console::write_byte(48);
        Console::write_byte(120);
        transition { _ -> hex_digit(cli, address, 60, has_current, current, count, position, end_after) }
    }

    state hex_digit(cli: &mut Cli, value: u64, shift: u64, has_current: bool, current: u64, count: u64, position: u64, end_after: bool) {
        let nibble: u64 = (((value as u64 in Wrapping) >> (shift as u64 in Wrapping)) as u64) & 15;
        transition nibble < 10 {
            true -> hex_decimal(cli, value, shift, nibble, has_current, current, count, position, end_after)
            false -> hex_letter(cli, value, shift, nibble, has_current, current, count, position, end_after)
        }
    }

    state hex_decimal(cli: &mut Cli, value: u64, shift: u64, nibble: u64, has_current: bool, current: u64, count: u64, position: u64, end_after: bool) {
        let glyph: u8 = (nibble + 48) as u8;
        Console::write_byte(glyph as i32);
        transition { _ -> hex_next(cli, value, shift, has_current, current, count, position, end_after) }
    }

    state hex_letter(cli: &mut Cli, value: u64, shift: u64, nibble: u64, has_current: bool, current: u64, count: u64, position: u64, end_after: bool) {
        let glyph: u8 = (nibble + 87) as u8;
        Console::write_byte(glyph as i32);
        transition { _ -> hex_next(cli, value, shift, has_current, current, count, position, end_after) }
    }

    state hex_next(cli: &mut Cli, value: u64, shift: u64, has_current: bool, current: u64, count: u64, position: u64, end_after: bool) {
        transition shift > 0 {
            true -> hex_digit(cli, value, ((shift as u64 in Wrapping) - (4 as u64 in Wrapping)) as u64, has_current, current, count, position, end_after)
            false -> hex_done(cli, has_current, current, count, position, end_after)
        }
    }

    state hex_done(cli: &mut Cli, has_current: bool, current: u64, count: u64, position: u64, end_after: bool) {
        Console::write(" = ");
        transition has_current {
            true -> dec_head(cli, current, count, position, end_after)
            false -> print_no_value(cli, count, position, end_after)
        }
    }

    state dec_head(cli: &mut Cli, current: u64, count: u64, position: u64, end_after: bool) {
        transition current > 0 {
            true -> dec_places_head(cli, current, count, position, end_after)
            false -> dec_zero(cli, count, position, end_after)
        }
    }

    state dec_places_head(cli: &mut Cli, current: u64, count: u64, position: u64, end_after: bool) {
        let place: u64 = Cli::dec_places(cli, current);
        transition { _ -> dec_digit(cli, current, place, count, position, end_after) }
    }

    state dec_zero(cli: &mut Cli, count: u64, position: u64, end_after: bool) {
        Console::write_byte(48);
        transition { _ -> dec_done(cli, count, position, end_after) }
    }

    state dec_digit(cli: &mut Cli, value: u64, place: u64, count: u64, position: u64, end_after: bool) {
        let digit: u8 = ((((value as u64 in Wrapping) / (place as u64 in Wrapping)) as u64) % 10) as u8;
        Console::write_byte((digit + 48) as i32);
        transition place > 1 {
            true -> dec_down(cli, value, place, count, position, end_after)
            false -> dec_done(cli, count, position, end_after)
        }
    }

    state dec_down(cli: &mut Cli, value: u64, place: u64, count: u64, position: u64, end_after: bool) {
        transition { _ -> dec_digit(cli, value, place / 10, count, position, end_after) }
    }

    state dec_done(cli: &mut Cli, count: u64, position: u64, end_after: bool) {
        Console::write_byte(10);
        transition { _ -> print_next(cli, count, position, end_after) }
    }

    state print_no_value(cli: &mut Cli, count: u64, position: u64, end_after: bool) {
        Console::write_line("?");
        transition { _ -> print_next(cli, count, position, end_after) }
    }

    state print_next(cli: &mut Cli, count: u64, position: u64, end_after: bool) {
        transition { _ -> print_at(cli, count, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, end_after) }
    }

    state refuse(cli: &mut Cli, end_after: bool) {
        Console::write_line("unrecognized command");
        transition { _ -> done(cli, end_after) }
    }

    state done(cli: &mut Cli, end_after: bool) -> bool {
        transition { _ -> (end_after) }
    }

}

// Dispatch the parsed line's command inside one machine boundary: machine-top
// `let` is the only place a call-produced `&[u8]` view can live (states jail
// affine view locals and edges refuse slice-producing args).

