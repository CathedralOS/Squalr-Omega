module src::main;

use omega::language::core::filesystem_authority;
use omega_language_std::console;
use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use omega_language_std::posix_filesystem_host;
use src::cli::Cli;

// Port of main.rs + cli.rs for the headless leg. Upstream guards the loop
// behind `--ipc-mode`/`--cli` dispatch; this ships the interactive loop as
// the only entry. The whole read/dispatch/print flow lives inside
// `Cli::run`, mirroring the dungeon_crawler_cli entry shape: the entry
// machine stays thin and the service-holding driver runs in its own unit.
public data Main {
    cli: Cli;
}

public machine Main::main(this: &mut Main)
reaches Console + PosixFilesystemHost + FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation + DirectoryEnumeration + FilesystemNamespaceMutation + WaitWake
invokes Console;
invokes PosixFilesystemHost;
invokes WaitWake;
blocks;
crashes Abort
crashes Trap
{
    transition { _ -> boot(this) }

    machine boot(this: &mut Main) {
        Cli::init(&mut this.cli);
        transition { _ -> run(this) }
    }

    machine run(this: &mut Main) {
        block Cli::run(&mut this.cli);
        transition { _ -> done(this) }
    }

    machine done(this: &mut Main) {
    }
}
