module src::main;

use omega::language::core::binding;
use omega_language_std::console;
use src::cli::Cli;

// Port of main.rs + cli.rs for the headless leg. Upstream guards the loop
// behind `--ipc-mode`/`--cli` dispatch; this ships the interactive loop as
// the only entry. The whole read/dispatch/print flow lives inside
// `Cli::run`, mirroring the dungeon_crawler_cli entry shape: the entry
// machine stays thin and the service-holding driver runs in its own unit.
pub data Main {
    cli: Cli;
}

pub linux_x86_64 machine Main::main(&mut self)
reaches Console
invokes Console;
suspends; blocks;
crashes Abort
crashes Trap
{
    transition { _ -> boot() }

    state boot(&mut self) {
        self.cli.init();
        transition { _ -> run() }
    }

    state run(&mut self) {
        suspend block self.cli.run();
        transition { _ -> done() }
    }

    state done(&mut self) {
    }
}
