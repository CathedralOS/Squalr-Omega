use {omega}/language/core/filesystem_authority.omg;
use {omega_language_std}/console.omg;
use {omega}/language/core/wait_wake.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use src/cli.omg;

// Port of main.rs + cli.rs for the headless leg. Upstream guards the loop
// behind `--ipc-mode`/`--cli` dispatch; this ships the interactive loop as
// the only entry. The whole read/dispatch/print flow lives inside
// `Cli::run`, mirroring the dungeon_crawler_cli entry shape: the entry
// machine stays thin and the service-holding driver runs in its own unit.
public data Main {
    cli: |cli|::Cli;
}

public machine Main::main(this: &mut Main)
reaches |console|::Console + |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation + |wait_wake|::WaitWake
invokes |console|::Console;
invokes |posix_filesystem_host|::PosixFilesystemHost;
invokes |wait_wake|::WaitWake;
blocks;
crashes Abort
crashes Trap
{
    transition { _ -> boot(this) }

    machine boot(this: &mut Main) {
        |cli|::Cli::init(&mut this.cli);
        transition { _ -> run(this) }
    }

    machine run(this: &mut Main) {
        block |cli|::Cli::run(&mut this.cli);
        transition { _ -> done(this) }
    }

    machine done(this: &mut Main) {
    }
}
