module src::response_handlers::project_symbols_response_handler;

use omega_language_std::console;
use squalr_engine_api::src::commands::project_symbols::project_symbols_response::ProjectSymbolsResponse;
use squalr_engine_api::src::commands::project_symbols::create::project_symbols_create_response::ProjectSymbolsCreateResponse;
use squalr_engine_api::src::commands::project_symbols::create_module::project_symbols_create_module_response::ProjectSymbolsCreateModuleResponse;
use squalr_engine_api::src::commands::project_symbols::delete::project_symbols_delete_response::ProjectSymbolsDeleteResponse;
use squalr_engine_api::src::commands::project_symbols::delete_layout::project_symbols_delete_layout_response::ProjectSymbolsDeleteLayoutResponse;
use squalr_engine_api::src::commands::project_symbols::delete_resolver::project_symbols_delete_resolver_response::ProjectSymbolsDeleteResolverResponse;
use squalr_engine_api::src::commands::project_symbols::execute_plugin_action::project_symbols_execute_plugin_action_response::ProjectSymbolsExecutePluginActionResponse;
use squalr_engine_api::src::commands::project_symbols::list::project_symbols_list_response::ProjectSymbolsListResponse;
use squalr_engine_api::src::commands::project_symbols::rename::project_symbols_rename_response::ProjectSymbolsRenameResponse;
use squalr_engine_api::src::commands::project_symbols::rename_module::project_symbols_rename_module_response::ProjectSymbolsRenameModuleResponse;
use squalr_engine_api::src::commands::project_symbols::update::project_symbols_update_response::ProjectSymbolsUpdateResponse;
use squalr_engine_api::src::commands::project_symbols::upsert_layout::project_symbols_upsert_layout_response::ProjectSymbolsUpsertLayoutResponse;
use squalr_engine_api::src::commands::project_symbols::upsert_resolver::project_symbols_upsert_resolver_response::ProjectSymbolsUpsertResolverResponse;
use squalr_engine_api::src::commands::project_symbols::write_value::project_symbols_write_value_response::ProjectSymbolsWriteValueResponse;
use squalr_engine_api::src::registries::symbols::struct_layout_descriptor::StructLayoutDescriptor;
use squalr_engine_api::src::structures::projects::project_info::ProjectInfo;
use squalr_engine_api::src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;
use squalr_engine_api::src::structures::projects::project_symbol_claim::ProjectSymbolClaim;
use squalr_engine_api::src::structures::projects::project_symbol_claim::ProjectSymbolClaimMetadataEntry;
use squalr_engine_api::src::structures::projects::project_symbol_locator::ProjectSymbolLocator;
use squalr_engine_api::src::structures::projects::project_symbol_module::ProjectSymbolModule;
use squalr_engine_api::src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;
use src::cli_print::CliPrint;

// Port of response_handlers/project_symbols/mod.rs — upstream's
// log::info!/log::error! lines print to the console here.
pub data ProjectSymbolsResponseHandler {}

pub machine ProjectSymbolsResponseHandler::handle(response: ProjectSymbolsResponse)
reaches Console
{
    transition response {
        ProjectSymbolsResponse::Create { response } -> create(&response)
        ProjectSymbolsResponse::CreateModule { response } -> create_module(&response)
        ProjectSymbolsResponse::Delete { response } -> delete(&response)
        ProjectSymbolsResponse::DeleteLayout { response } -> delete_layout(&response)
        ProjectSymbolsResponse::DeleteResolver { response } -> delete_resolver(&response)
        ProjectSymbolsResponse::ExecutePluginAction { response } -> plugin(&response)
        ProjectSymbolsResponse::List { response } -> list(&response)
        ProjectSymbolsResponse::Rename { response } -> rename(&response)
        ProjectSymbolsResponse::RenameModule { response } -> rename_module(&response)
        ProjectSymbolsResponse::Update { response } -> update(&response)
        ProjectSymbolsResponse::UpsertLayout { response } -> upsert_layout(&response)
        ProjectSymbolsResponse::UpsertResolver { response } -> upsert_resolver(&response)
        ProjectSymbolsResponse::WriteValue { response } -> write_value(&response)
    }

    state create(response: &ProjectSymbolsCreateResponse) {
        Console::write("created symbol claim: success=");
        let success: bool = ProjectSymbolsCreateResponse::get_success(response);
        write_bool_text(success);
        Console::write(", symbol_locator_key=");
        let locator_key: &[u8] = ProjectSymbolsCreateResponse::get_symbol_locator_key(response);
        Console::write_line(locator_key);
    }
    state create_module(response: &ProjectSymbolsCreateModuleResponse) {
        Console::write("created module root: success=");
        let success: bool = ProjectSymbolsCreateModuleResponse::get_success(response);
        write_bool_text(success);
        Console::write(", module=");
        let module_name: &[u8] = ProjectSymbolsCreateModuleResponse::get_module_name(response);
        Console::write_line(module_name);
    }
    state delete(response: &ProjectSymbolsDeleteResponse) {
        let success: bool = ProjectSymbolsDeleteResponse::get_success(response);
        let modules: u64 = ProjectSymbolsDeleteResponse::get_deleted_module_count(response);
        let claims: u64 = ProjectSymbolsDeleteResponse::get_deleted_symbol_count(response);
        Console::write("deleted project symbols: success=");
        write_bool_text(success);
        Console::write(", modules=");
        CliPrint::write_dec(modules);
        Console::write(", claims=");
        CliPrint::write_dec(claims);
        Console::write_byte(10);
    }
    state delete_layout(response: &ProjectSymbolsDeleteLayoutResponse) {
        let success: bool = ProjectSymbolsDeleteLayoutResponse::get_success(response);
        let id: &[u8] = ProjectSymbolsDeleteLayoutResponse::get_struct_layout_id(response);
        Console::write("deleted symbol layout: success=");
        transition success {
            true -> delete_layout_ok(id)
            _ -> delete_layout_err(response, id)
        }
    }
    state delete_layout_ok(id: &[u8]) {
        write_bool_text(true);
        Console::write(", id=");
        Console::write_line(id);
    }
    state delete_layout_err(response: &ProjectSymbolsDeleteLayoutResponse, id: &[u8]) {
        transition ProjectSymbolsDeleteLayoutResponse::has_error(response) {
            true -> delete_layout_err_text(response)
            _ -> done()
        }
    }
    state delete_layout_err_text(response: &ProjectSymbolsDeleteLayoutResponse) {
        let error: &[u8] = ProjectSymbolsDeleteLayoutResponse::get_error(response);
        write_error_tail(error);
    }
    state delete_resolver(response: &ProjectSymbolsDeleteResolverResponse) {
        let success: bool = ProjectSymbolsDeleteResolverResponse::get_success(response);
        let id: &[u8] = ProjectSymbolsDeleteResolverResponse::get_resolver_id(response);
        Console::write("deleted symbol resolver: success=");
        transition success {
            true -> delete_resolver_ok(id)
            _ -> delete_resolver_err(response)
        }
    }
    state delete_resolver_ok(id: &[u8]) {
        write_bool_text(true);
        Console::write(", id=");
        Console::write_line(id);
    }
    state delete_resolver_err(response: &ProjectSymbolsDeleteResolverResponse) {
        transition ProjectSymbolsDeleteResolverResponse::has_error(response) {
            true -> delete_resolver_err_text(response)
            _ -> done()
        }
    }
    state delete_resolver_err_text(response: &ProjectSymbolsDeleteResolverResponse) {
        let error: &[u8] = ProjectSymbolsDeleteResolverResponse::get_error(response);
        write_error_tail(error);
    }
    state plugin(response: &ProjectSymbolsExecutePluginActionResponse) {
        let success: bool = ProjectSymbolsExecutePluginActionResponse::get_success(response);
        Console::write("executed symbol plugin action: success=");
        transition success {
            true -> plugin_ok()
            _ -> plugin_err(response)
        }
    }
    state plugin_ok() {
        write_bool_text(true);
        Console::write_byte(10);
    }
    state plugin_err(response: &ProjectSymbolsExecutePluginActionResponse) {
        transition ProjectSymbolsExecutePluginActionResponse::has_error(response) {
            true -> plugin_err_text(response)
            _ -> done()
        }
    }
    state plugin_err_text(response: &ProjectSymbolsExecutePluginActionResponse) {
        let error: &[u8] = ProjectSymbolsExecutePluginActionResponse::get_error(response);
        write_error_tail(error);
    }

    // `project: <name>, module count: <n>, symbol field count: <n>,
    // symbol type count: <n>` then module/claim/layout blocks.
    state list(response: &ProjectSymbolsListResponse) {
        Console::write("project: ");
        transition ProjectSymbolsListResponse::has_opened_project_info(response) {
            true -> list_name(response)
            _ -> list_no_project(response)
        }
    }
    state list_name(response: &ProjectSymbolsListResponse) {
        let opened_project_info: &ProjectInfo = ProjectSymbolsListResponse::get_opened_project_info(response);
        let name: &[u8] = ProjectInfo::get_name(opened_project_info);
        Console::write(name);
        transition { _ -> list_counts(response) }
    }
    state list_no_project(response: &ProjectSymbolsListResponse) {
        Console::write("(no project)");
        transition { _ -> list_counts(response) }
    }
    state list_counts(response: &ProjectSymbolsListResponse) {
        let catalog: &ProjectSymbolCatalog = ProjectSymbolsListResponse::get_project_symbol_catalog(response);
        let module_count: u64 = ProjectSymbolCatalog::get_symbol_module_count(catalog);
        let claim_count: u64 = ProjectSymbolCatalog::get_symbol_claim_count(catalog);
        let layout_count: u64 = ProjectSymbolCatalog::get_struct_layout_descriptor_count(catalog);
        Console::write(", module count: ");
        CliPrint::write_dec(module_count);
        Console::write(", symbol field count: ");
        CliPrint::write_dec(claim_count);
        Console::write(", symbol type count: ");
        CliPrint::write_dec(layout_count);
        Console::write_byte(10);
        transition { _ -> list_module_at(response, catalog, 0, module_count) }
    }
    state list_module_at(response: &ProjectSymbolsListResponse, catalog: &ProjectSymbolCatalog, position: u64, module_count: u64) {
        transition position < module_count {
            true -> list_module(response, catalog, position, module_count)
            false -> list_claim_at(response, catalog, 0, ProjectSymbolCatalog::get_symbol_claim_count(catalog))
        }
    }
    state list_module(response: &ProjectSymbolsListResponse, catalog: &ProjectSymbolCatalog, position: u64, module_count: u64) {
        let module: &ProjectSymbolModule = ProjectSymbolCatalog::get_symbol_module(catalog, position);
        let name: &[u8] = ProjectSymbolModule::get_module_name(module);
        let size: u64 = ProjectSymbolModule::get_size(module);
        Console::write("module: ");
        Console::write(name);
        Console::write(", size: 0x");
        CliPrint::write_hex64(size);
        Console::write_byte(10);
        transition { _ -> list_module_at(response, catalog, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, module_count) }
    }
    state list_claim_at(response: &ProjectSymbolsListResponse, catalog: &ProjectSymbolCatalog, position: u64, claim_count: u64) {
        transition position < claim_count {
            true -> list_claim(response, catalog, position, claim_count)
            false -> list_layout_at(response, catalog, 0, ProjectSymbolCatalog::get_struct_layout_descriptor_count(catalog))
        }
    }
    state list_claim(response: &ProjectSymbolsListResponse, catalog: &ProjectSymbolCatalog, position: u64, claim_count: u64) {
        let claim: &ProjectSymbolClaim = ProjectSymbolCatalog::get_symbol_claim(catalog, position);
        let display_name: &[u8] = ProjectSymbolClaim::get_display_name(claim);
        let type_id: &[u8] = ProjectSymbolClaim::get_struct_layout_id(claim);
        Console::write("symbol: ");
        Console::write(display_name);
        Console::write(", type: ");
        Console::write(type_id);
        Console::write(", locator: ");
        transition { _ -> list_claim_locator(response, catalog, claim, position, claim_count) }
    }
    state list_claim_locator(response: &ProjectSymbolsListResponse, catalog: &ProjectSymbolCatalog, claim: &ProjectSymbolClaim, position: u64, claim_count: u64) {
        let locator: &ProjectSymbolLocator = ProjectSymbolClaim::get_locator(claim);
        transition locator {
            ProjectSymbolLocator::AbsoluteAddress { address, module_name, module_name_len } -> list_claim_absolute(response, catalog, claim, position, claim_count, address)
            ProjectSymbolLocator::ModuleOffset { module_name, module_name_len, offset } -> list_claim_offset(response, catalog, claim, position, claim_count, module_name, module_name_len, offset)
        }
    }
    state list_claim_absolute(response: &ProjectSymbolsListResponse, catalog: &ProjectSymbolCatalog, claim: &ProjectSymbolClaim, position: u64, claim_count: u64, address: u64) {
        CliPrint::write_hex64(address);
        Console::write_byte(10);
        transition { _ -> list_claim_metadata(response, catalog, claim, position, claim_count, 0) }
    }
    state list_claim_offset(response: &ProjectSymbolsListResponse, catalog: &ProjectSymbolCatalog, claim: &ProjectSymbolClaim, position: u64, claim_count: u64, module_name: [u8; 256], module_name_len: u64, offset: u64) {
        transition module_name_len <= 256 {
            true -> list_claim_offset_write(response, catalog, claim, position, claim_count, module_name, module_name_len, offset)
            _ -> done()
        }
    }
    state list_claim_offset_write(response: &ProjectSymbolsListResponse, catalog: &ProjectSymbolCatalog, claim: &ProjectSymbolClaim, position: u64, claim_count: u64, module_name: [u8; 256], module_name_len: u64, offset: u64)
        requires module_name_len <= 256;
    {
        Console::write(&module_name[0..module_name_len]);
        Console::write(" + 0x");
        CliPrint::write_hex64(offset);
        Console::write_byte(10);
        transition { _ -> list_claim_metadata(response, catalog, claim, position, claim_count, 0) }
    }
    state list_claim_metadata(response: &ProjectSymbolsListResponse, catalog: &ProjectSymbolCatalog, claim: &ProjectSymbolClaim, position: u64, claim_count: u64, metadata_position: u64) {
        let metadata_count: u64 = ProjectSymbolClaim::get_metadata_count(claim);
        transition metadata_position < metadata_count {
            true -> list_claim_metadata_entry(response, catalog, claim, position, claim_count, metadata_position, metadata_count)
            false -> list_claim_at(response, catalog, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, claim_count)
        }
    }
    state list_claim_metadata_entry(response: &ProjectSymbolsListResponse, catalog: &ProjectSymbolCatalog, claim: &ProjectSymbolClaim, position: u64, claim_count: u64, metadata_position: u64, metadata_count: u64) {
        let entry: &ProjectSymbolClaimMetadataEntry = ProjectSymbolClaim::get_metadata(claim, metadata_position);
        let key: &[u8] = ProjectSymbolClaimMetadataEntry::get_key(entry);
        let value: &[u8] = ProjectSymbolClaimMetadataEntry::get_value(entry);
        Console::write("  metadata: ");
        Console::write(key);
        Console::write("=");
        Console::write(value);
        Console::write_byte(10);
        transition { _ -> list_claim_metadata(response, catalog, claim, position, claim_count, ((metadata_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state list_layout_at(response: &ProjectSymbolsListResponse, catalog: &ProjectSymbolCatalog, position: u64, layout_count: u64) {
        transition position < layout_count {
            true -> list_layout(response, catalog, position, layout_count)
            false -> done()
        }
    }
    state list_layout(response: &ProjectSymbolsListResponse, catalog: &ProjectSymbolCatalog, position: u64, layout_count: u64) {
        let descriptor: &StructLayoutDescriptor = ProjectSymbolCatalog::get_struct_layout_descriptor(catalog, position);
        let type_id: &[u8] = StructLayoutDescriptor::get_struct_layout_id(descriptor);
        let definition: &SymbolicStructDefinition = StructLayoutDescriptor::get_struct_layout_definition(descriptor);
        let field_count: u64 = SymbolicStructDefinition::get_field_count(definition);
        Console::write("type: ");
        Console::write(type_id);
        Console::write(", fields=");
        CliPrint::write_dec(field_count);
        Console::write_byte(10);
        transition { _ -> list_layout_at(response, catalog, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, layout_count) }
    }

    state rename(response: &ProjectSymbolsRenameResponse) {
        Console::write("renamed symbol claim: success=");
        let success: bool = ProjectSymbolsRenameResponse::get_success(response);
        write_bool_text(success);
        Console::write(", symbol_locator_key=");
        let locator_key: &[u8] = ProjectSymbolsRenameResponse::get_symbol_locator_key(response);
        Console::write_line(locator_key);
    }
    state rename_module(response: &ProjectSymbolsRenameModuleResponse) {
        Console::write("renamed module root: success=");
        let success: bool = ProjectSymbolsRenameModuleResponse::get_success(response);
        write_bool_text(success);
        Console::write(", module=");
        let module_name: &[u8] = ProjectSymbolsRenameModuleResponse::get_module_name(response);
        Console::write_line(module_name);
    }
    state update(response: &ProjectSymbolsUpdateResponse) {
        Console::write("updated symbol claim: success=");
        let success: bool = ProjectSymbolsUpdateResponse::get_success(response);
        write_bool_text(success);
        Console::write(", symbol_locator_key=");
        let locator_key: &[u8] = ProjectSymbolsUpdateResponse::get_symbol_locator_key(response);
        Console::write_line(locator_key);
    }
    state upsert_layout(response: &ProjectSymbolsUpsertLayoutResponse) {
        let success: bool = ProjectSymbolsUpsertLayoutResponse::get_success(response);
        let id: &[u8] = ProjectSymbolsUpsertLayoutResponse::get_struct_layout_id(response);
        Console::write("upserted symbol layout: success=");
        transition success {
            true -> upsert_layout_ok(id)
            _ -> upsert_layout_err(response)
        }
    }
    state upsert_layout_ok(id: &[u8]) {
        write_bool_text(true);
        Console::write(", id=");
        Console::write_line(id);
    }
    state upsert_layout_err(response: &ProjectSymbolsUpsertLayoutResponse) {
        transition ProjectSymbolsUpsertLayoutResponse::has_error(response) {
            true -> upsert_layout_err_text(response)
            _ -> done()
        }
    }
    state upsert_layout_err_text(response: &ProjectSymbolsUpsertLayoutResponse) {
        let error: &[u8] = ProjectSymbolsUpsertLayoutResponse::get_error(response);
        write_error_tail(error);
    }
    state upsert_resolver(response: &ProjectSymbolsUpsertResolverResponse) {
        let success: bool = ProjectSymbolsUpsertResolverResponse::get_success(response);
        let id: &[u8] = ProjectSymbolsUpsertResolverResponse::get_resolver_id(response);
        Console::write("upserted symbol resolver: success=");
        transition success {
            true -> upsert_resolver_ok(id)
            _ -> upsert_resolver_err(response)
        }
    }
    state upsert_resolver_ok(id: &[u8]) {
        write_bool_text(true);
        Console::write(", id=");
        Console::write_line(id);
    }
    state upsert_resolver_err(response: &ProjectSymbolsUpsertResolverResponse) {
        transition ProjectSymbolsUpsertResolverResponse::has_error(response) {
            true -> upsert_resolver_err_text(response)
            _ -> done()
        }
    }
    state upsert_resolver_err_text(response: &ProjectSymbolsUpsertResolverResponse) {
        let error: &[u8] = ProjectSymbolsUpsertResolverResponse::get_error(response);
        write_error_tail(error);
    }
    state write_value(response: &ProjectSymbolsWriteValueResponse) {
        let success: bool = ProjectSymbolsWriteValueResponse::get_success(response);
        Console::write("wrote project symbol value: success=");
        transition success {
            true -> write_value_ok()
            _ -> write_value_err(response)
        }
    }
    state write_value_ok() {
        write_bool_text(true);
        Console::write_byte(10);
    }
    state write_value_err(response: &ProjectSymbolsWriteValueResponse) {
        transition ProjectSymbolsWriteValueResponse::has_error(response) {
            true -> write_value_err_text(response)
            _ -> write_value_err_unknown()
        }
    }
    state write_value_err_text(response: &ProjectSymbolsWriteValueResponse) {
        let error: &[u8] = ProjectSymbolsWriteValueResponse::get_error(response);
        write_error_tail(error);
    }
    state write_value_err_unknown() {
        write_success_false_fallback("unknown error");
    }
    state done() { }
}

// Shared `true`/`false` text for the success=<bool> fields.
machine write_bool_text(value: bool)
reaches Console
{
    transition value {
        true -> yes()
        _ -> no()
    }
    state yes() {
        Console::write("true");
    }
    state no() {
        Console::write("false");
    }
}

// Shared `success=false, error=<text>` tail used by every mutating arm's
// failure line.
machine write_error_tail(text: &[u8])
reaches Console
{
    Console::write("success=false, error=");
    Console::write_line(text);
}

machine write_success_false_fallback(text: &[u8])
reaches Console
{
    Console::write("success=false, error=");
    Console::write_line(text);
}
