module src::response_handlers::response_handlers;

use omega_language_std::console;
use squalr_engine_api::src::commands::project::project_response::ProjectResponse;
use squalr_engine_api::src::commands::project_items::project_items_response::ProjectItemsResponse;
use squalr_engine_api::src::commands::project_symbols::project_symbols_response::ProjectSymbolsResponse;
use squalr_engine_api::src::commands::unprivileged_command_response::UnprivilegedCommandResponse;
use src::response_handlers::project_items_response_handler::ProjectItemsResponseHandler;
use src::response_handlers::project_symbols_response_handler::ProjectSymbolsResponseHandler;

// Port of response_handlers/mod.rs —
// `handle_unprivileged_engine_response`, the response callback cli
// registers with `dispatch_unprivileged_command`. Upstream's Project
// arm prints only through a JIRA-tagged empty handler plus debug-level
// "unhandled" lines for every other project arm, so the port routes it
// nowhere — a default-level upstream run emits nothing for project
// responses.
pub data ResponseHandlers {}

pub machine ResponseHandlers::handle_unprivileged_engine_response(response: UnprivilegedCommandResponse)
reaches Console
{
    transition response {
        UnprivilegedCommandResponse::Project { response } -> project(&response)
        UnprivilegedCommandResponse::ProjectItems { response } -> items(response)
        UnprivilegedCommandResponse::ProjectSymbols { response } -> symbols(response)
        _ -> done()
    }

    // Upstream handle_project_response: the List arm's handler is an
    // empty `log::info!("unhandled project list — unimplemented (JIRA
    // squalr-99)")` — a debug-level no-op — and every other project arm
    // takes the shared debug-unhandled arm. Nothing prints at default
    // level, so the port prints nothing.
    state project(response: &ProjectResponse) {
    }
    state items(response: ProjectItemsResponse) {
        ProjectItemsResponseHandler::handle(response);
    }
    state symbols(response: ProjectSymbolsResponse) {
        ProjectSymbolsResponseHandler::handle(response);
    }
    state done() { }
}
