module src::cli_print;

use omega_language_std::console;

// Console print helpers shared by the unprivileged response handlers —
// byte-slice text writes plus the hex/decimal number printers (same
// glyph logic as cli.omg's list printer, lifted out so each handler
// module doesn't carry its own copy).
pub data CliPrint {}

pub machine CliPrint::write_text(text: &[u8])
reaches Console
{
    Console::write(text);
}

pub machine CliPrint::write_line(text: &[u8])
reaches Console
{
    Console::write_line(text);
}

// Largest power-of-ten ≤ value — the write_dec cursor seed.
machine print_dec_places(value: u64) -> u64 {
    transition { _ -> grow(value, 1) }
    state grow(value: u64, place: u64) -> u64 {
        transition value >= 10 && place <= 1000000000000000000 {
            true -> check(value, place)
            false -> (place)
        }
    }
    state check(value: u64, place: u64) -> u64 {
        let next: u64 = ((place as u64 in Wrapping) * 10) as u64;
        transition next <= value {
            true -> grow(value, next)
            false -> (place)
        }
    }
}

pub machine CliPrint::write_dec(value: u64)
reaches Console
{
    transition value > 0 {
        true -> head(value)
        false -> zero()
        _ -> zero()
    }
    state head(value: u64) {
        let place: u64 = print_dec_places(value);
        transition { _ -> digit(value, place) }
    }
    state zero() {
        Console::write_byte(48);
    }
    state digit(value: u64, place: u64) {
        let digit: u8 = ((((value as u64 in Wrapping) / (place as u64 in Wrapping)) as u64) % 10) as u8;
        Console::write_byte((digit + 48) as i32);
        transition place > 1 {
            true -> down(value, place)
            false -> done()
            _ -> done()
        }
    }
    state down(value: u64, place: u64) {
        transition { _ -> digit(value, place / 10) }
    }
    state done() { }
}

// `0x` + 16 lowercase hex digits — the address columns the handlers print.
pub machine CliPrint::write_hex64(value: u64)
reaches Console
{
    Console::write_byte(48);
    Console::write_byte(120);
    transition { _ -> nibble(value, 60) }

    state nibble(value: u64, shift: u64) {
        let nibble: u64 = (((value as u64 in Wrapping) >> (shift as u64 in Wrapping)) as u64) & 15;
        transition nibble < 10 {
            true -> glyph_dec(value, shift, nibble)
            false -> glyph_letter(value, shift, nibble)
            _ -> glyph_letter(value, shift, nibble)
        }
    }
    state glyph_dec(value: u64, shift: u64, nibble: u64) {
        let glyph: u8 = (nibble + 48) as u8;
        Console::write_byte(glyph as i32);
        transition { _ -> next(value, shift) }
    }
    state glyph_letter(value: u64, shift: u64, nibble: u64) {
        let glyph: u8 = (nibble + 87) as u8;
        Console::write_byte(glyph as i32);
        transition { _ -> next(value, shift) }
    }
    state next(value: u64, shift: u64) {
        transition shift > 0 {
            true -> nibble(value, ((shift as u64 in Wrapping) - (4 as u64 in Wrapping)) as u64)
            false -> done()
            _ -> done()
        }
    }
    state done() { }
}
