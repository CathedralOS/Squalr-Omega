module src::command_framer;

// framer_v2 — a bounded byte-chunk command framer. v1 framing is
// capability-level: `Console::read_line` blocks for a whole LF-terminated
// line per call. The framer instead accepts byte chunks from any source
// (the stdin `read_byte` loop today, IPC socket reads later) and emits one
// `\n`-delimited frame per take, so every byte source shares one
// command-feed path. Semantics port Rust `read_line`: the delimiter is
// consumed and never emitted; EOF with pending bytes flushes one final
// frame; empty frames surface as len 0.
//
// Take sentinel choice (spec: pick one and comment): `u64::MAX` = no frame
// is buffered. One sentinel keeps the caller's loop a single compare;
// `u64::MAX` can never collide with a real frame length because pending is
// capped at 512.
//
// Self-contained emission: the taken frame lands in `frame` (a field the
// framer owns) and callers read bytes back through `get_frame_byte` — no
// `&mut` buffer arguments cross machine boundaries, the same discipline
// `pad_line` documents for capability-bearing owners. Driver states carry
// no `requires` and name every fact a worker needs in their transition
// guard; worker states carry the matching `requires`.
pub data CommandFramer {
    pending: [u8; 512];
    pending_len: u64;
    frame: [u8; 512];
    frame_len: u64;
    closed: bool;
}

pub machine CommandFramer::new() -> CommandFramer {
    CommandFramer { pending_len: 0, frame_len: 0, closed: false }
}

pub machine CommandFramer::default() -> CommandFramer {
    CommandFramer::new()
}

pub machine CommandFramer::is_empty(command_framer: &CommandFramer) -> bool {
    command_framer.pending_len == 0
}

pub machine CommandFramer::get_pending_len(command_framer: &CommandFramer) -> u64 {
    command_framer.pending_len
}

pub machine CommandFramer::get_frame_len(command_framer: &CommandFramer) -> u64 {
    command_framer.frame_len
}

pub machine CommandFramer::is_closed(command_framer: &CommandFramer) -> bool {
    command_framer.closed
}

// Frame byte at `at`; out-of-range reads answer 0 — the caller bounds by
// the returned frame length, and a defensive answer beats a contract the
// caller cannot name (`at < self.frame_len` is the framer's own fact).
pub machine CommandFramer::get_frame_byte(command_framer: &CommandFramer, at: u64) -> u8 {
    transition at < command_framer.frame_len && at < 512 {
        true -> read(command_framer, at)
        _ -> (0)
    }

    state read(command_framer: &CommandFramer, at: u64) -> u8
        requires at < 512;
    {
        (command_framer.frame[at])
    }
}

// All-or-nothing append: refuses without consuming when the chunk would
// exceed the 512-byte pending extent — a partial append would silently
// corrupt frame boundaries, and the caller may split its chunk. Offers
// after `close` refuse the same way.
pub machine CommandFramer::offer(command_framer: &mut CommandFramer, bytes: &[u8]) -> bool {
    transition !command_framer.closed && ((command_framer.pending_len as u64 in Wrapping) + (bytes.len as u64 in Wrapping)) as u64 <= 512 {
        true -> copy(command_framer, 0, bytes)
        _ -> (false)
    }

    state copy(command_framer: &mut CommandFramer, at: u64, bytes: &[u8]) -> bool {
        transition at < bytes.len && command_framer.pending_len < 512 {
            true -> store(command_framer, at, bytes)
            _ -> (true)
        }
    }

    state store(command_framer: &mut CommandFramer, at: u64, bytes: &[u8]) -> bool
        requires at < bytes.len && command_framer.pending_len < 512;
    {
        command_framer.pending[command_framer.pending_len] = bytes[at];
        command_framer.pending_len = ((command_framer.pending_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> copy(command_framer, ((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, bytes) }
    }
}

// Single-byte offer — the `Console::read_byte` loop's chunk shape. Same
// all-or-nothing discipline as `offer` (a 1-byte chunk only refuses when
// the pending extent is saturated or the framer is closed).
pub machine CommandFramer::offer_byte(command_framer: &mut CommandFramer, byte: u8) -> bool {
    transition !command_framer.closed && command_framer.pending_len < 512 {
        true -> append(command_framer, byte)
        _ -> (false)
    }

    state append(command_framer: &mut CommandFramer, byte: u8) -> bool
        requires command_framer.pending_len < 512;
    {
        command_framer.pending[command_framer.pending_len] = byte;
        command_framer.pending_len = ((command_framer.pending_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Split-take: scans `pending[0..pending_len)` for the first 0x0a; on a hit
// the frame is `pending[0..idx)` (delimiter consumed), the tail shifts
// down, and the frame length is returned. Full-style overflow: a saturated
// pending extent with no delimiter is itself a boundary — the 512-byte
// partial emits so the caller can take the refused remainder next. Returns
// `u64::MAX` when nothing frames. Emitted bytes land in `frame` with
// `frame_len` set to the returned length.
pub machine CommandFramer::try_take_frame(command_framer: &mut CommandFramer) -> u64 {
    transition { _ -> scan(command_framer, 0) }

    state scan(command_framer: &mut CommandFramer, at: u64) -> u64 {
        transition at < command_framer.pending_len && at < 512 {
            true -> test(command_framer, at)
            _ -> full_check(command_framer)
        }
    }

    state test(command_framer: &mut CommandFramer, at: u64) -> u64
        requires at < 512;
    {
        transition command_framer.pending[at] == 10 {
            true -> emit(command_framer, at)
            _ -> scan(command_framer, ((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }

    state full_check(command_framer: &mut CommandFramer) -> u64 {
        transition command_framer.pending_len == 512 {
            true -> emit_partial(command_framer)
            _ -> (18446744073709551615)
        }
    }

    // Emit `pending[0..count)` into `frame`, then drop `count` bytes
    // plus the consumed delimiter off the front of pending. `src` is the
    // tail's first retained byte (count + 1).
    state emit(command_framer: &mut CommandFramer, count: u64) -> u64 {
        let after: u64 = ((count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition count > 0 {
            true -> copy_check(command_framer, 0, count, after, count)
            _ -> shift(command_framer, 0, after, count)
        }
    }

    // Saturated-extent partial: all 512 pending bytes emit and nothing
    // shifts (no delimiter was consumed).
    state emit_partial(command_framer: &mut CommandFramer) -> u64 {
        transition { _ -> copy_check(command_framer, 0, 512, 512, 512) }
    }

    // `at` walks the frame prefix; the guard supplies copy_out's `at < 512`
    // and falls to `shift` at `count` — where `src` marks the retained
    // tail's first byte.
    state copy_check(command_framer: &mut CommandFramer, at: u64, count: u64, src: u64, reported: u64) -> u64 {
        transition at < count && at < 512 {
            true -> copy_out(command_framer, at, count, src, reported)
            _ -> shift(command_framer, 0, src, reported)
        }
    }

    state copy_out(command_framer: &mut CommandFramer, at: u64, count: u64, src: u64, reported: u64) -> u64
        requires at < 512;
    {
        command_framer.frame[at] = command_framer.pending[at];
        let next: u64 = ((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> copy_check(command_framer, next, count, src, reported) }
    }

    // `dst`/`src` walk the retained tail down: pending[src] lands at
    // pending[dst] until src reaches pending_len. The dst/src bounds are
    // named in the guard so shift_copy's `requires` discharges.
    state shift(command_framer: &mut CommandFramer, dst: u64, src: u64, reported: u64) -> u64 {
        transition src < command_framer.pending_len && dst < 512 && src < 512 {
            true -> shift_copy(command_framer, dst, src, reported)
            _ -> finish(command_framer, dst, reported)
        }
    }

    state shift_copy(command_framer: &mut CommandFramer, dst: u64, src: u64, reported: u64) -> u64
        requires dst < 512 && src < 512;
    {
        command_framer.pending[dst] = command_framer.pending[src];
        let next_dst: u64 = ((dst as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let next_src: u64 = ((src as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> shift(command_framer, next_dst, next_src, reported) }
    }

    // `dst` is exactly the number of retained bytes — it becomes the new
    // pending_len. `reported` is the frame length handed back and recorded.
    state finish(command_framer: &mut CommandFramer, dst: u64, reported: u64) -> u64 {
        command_framer.pending_len = dst;
        command_framer.frame_len = reported;
        (reported)
    }
}

// EOF flush: pending bytes emit as the final frame (upstream `read_line`
// returns `Ok(n>0)` without the delimiter) and the framer closes; empty or
// already-closed pending ends the stream with a 0-length report.
pub machine CommandFramer::close(command_framer: &mut CommandFramer) -> u64 {
    transition command_framer.closed || command_framer.pending_len == 0 {
        true -> mark(command_framer)
        _ -> copy(command_framer, 0)
    }

    state mark(command_framer: &mut CommandFramer) -> u64 {
        command_framer.closed = true;
        command_framer.frame_len = 0;
        (0)
    }

    state copy(command_framer: &mut CommandFramer, at: u64) -> u64 {
        transition at < command_framer.pending_len && at < 512 {
            true -> store(command_framer, at)
            _ -> finish(command_framer)
        }
    }

    state store(command_framer: &mut CommandFramer, at: u64) -> u64
        requires at < 512;
    {
        command_framer.frame[at] = command_framer.pending[at];
        transition { _ -> copy(command_framer, ((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }

    state finish(command_framer: &mut CommandFramer) -> u64 {
        command_framer.closed = true;
        let len: u64 = command_framer.pending_len;
        command_framer.frame_len = len;
        command_framer.pending_len = 0;
        (len)
    }
}
