module src::equatable;

// Upstream PartialEq/Eq: `==`/`!=` select the one Equatable implementation
// whose trait argument is the operand type. Implementations author their
// `equals` row: compiler synthesis is reserved for a root-declared trait,
// and a root declaration is not importable from a declared module.
public trait Equatable<Provider> {
    machine equals(provider: &Provider, other: &Provider) -> bool;
}
