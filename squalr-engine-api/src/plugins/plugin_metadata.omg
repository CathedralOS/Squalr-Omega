module src::plugins::plugin_metadata;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::bounded_slice::bounded_slice;

use src::plugins::plugin_capability::PluginCapability;
use src::plugins::plugin_permission::PluginPermission;

// Port of plugins/plugin_metadata.rs — the plugin's static identity
// {plugin_id, display_name, description, plugin_capabilities,
// plugin_permissions, is_built_in, is_enabled_by_default}. Strings ride
// the bounded [u8; 256] + live length carriers. Upstream's two Vecs are
// constructed as sorted dedup'd sets (new_with_permissions sorts on Ord):
// the port carries each set as a rank bitmask — rank-ordered unique
// membership by construction, so enumeration order is upstream's sorted
// order exactly and duplicates cannot exist.
pub data PluginMetadata {
    plugin_id: [u8; 256];
    plugin_id_len: u64;
    display_name: [u8; 256];
    display_name_len: u64;
    description: [u8; 256];
    description_len: u64;
    plugin_capability_mask: u64;
    plugin_permission_mask: u64;
    is_built_in: bool;
    is_enabled_by_default: bool;
}

// Upstream `new` — permissions default to the empty set.
pub machine PluginMetadata::new(
    plugin_id: &[u8],
    display_name: &[u8],
    description: &[u8],
    is_built_in: bool,
    is_enabled_by_default: bool
) -> PluginMetadata {
    let mut metadata: PluginMetadata = PluginMetadata {
        plugin_id_len: 0,
        display_name_len: 0,
        description_len: 0,
        plugin_capability_mask: 0,
        plugin_permission_mask: 0,
        is_built_in: is_built_in,
        is_enabled_by_default: is_enabled_by_default,
    };
    metadata.set_plugin_id(plugin_id);
    metadata.set_display_name(display_name);
    metadata.set_description(description);
    (metadata)
}

pub machine PluginMetadata::get_plugin_id(&self) -> &[u8] {
    bounded_slice(&self.plugin_id[0..256], self.plugin_id_len)
}

pub machine PluginMetadata::get_display_name(&self) -> &[u8] {
    bounded_slice(&self.display_name[0..256], self.display_name_len)
}

pub machine PluginMetadata::get_description(&self) -> &[u8] {
    bounded_slice(&self.description[0..256], self.description_len)
}

pub machine PluginMetadata::get_is_built_in(&self) -> bool {
    self.is_built_in
}

pub machine PluginMetadata::get_is_enabled_by_default(&self) -> bool {
    self.is_enabled_by_default
}

// Upstream `has_plugin_capability` — contains() over the set.
pub machine PluginMetadata::has_plugin_capability(&self, capability: PluginCapability) -> bool {
    let mut rank: u64 = capability.rank();
    (((self.plugin_capability_mask as u64 in Wrapping) >> rank) as u64 & 1) == 1
}

// Upstream's permission-set contains() (same Vec discipline).
pub machine PluginMetadata::has_plugin_permission(&self, permission: PluginPermission) -> bool {
    let mut rank: u64 = permission.rank();
    (((self.plugin_permission_mask as u64 in Wrapping) >> rank) as u64 & 1) == 1
}

// Set membership — dedup is free on a bitmask. Returns whether the
// membership bit changed (upstream's Vec insert is a no-op on duplicates).
pub machine PluginMetadata::add_plugin_capability(&mut self, capability: PluginCapability) -> bool {
    let mut rank: u64 = capability.rank();
    let mut bit: u64 = ((1 as u64 in Wrapping) << rank) as u64;
    let mut was_set: bool = (self.plugin_capability_mask & bit) != 0;
    self.plugin_capability_mask = self.plugin_capability_mask | bit;
    (!was_set)
}

pub machine PluginMetadata::add_plugin_permission(&mut self, permission: PluginPermission) -> bool {
    let mut rank: u64 = permission.rank();
    let mut bit: u64 = ((1 as u64 in Wrapping) << rank) as u64;
    let mut was_set: bool = (self.plugin_permission_mask & bit) != 0;
    self.plugin_permission_mask = self.plugin_permission_mask | bit;
    (!was_set)
}

// Set cardinalities — upstream's Vec::len.
pub machine PluginMetadata::get_plugin_capability_count(&self) -> u64 {
    transition { _ -> count(0, 0) }
    state count(&self, rank: u64, seen: u64) -> u64 {
        transition rank < 5 {
            true -> check(rank, seen)
            false -> (seen)
        }
    }
    state check(&self, rank: u64, seen: u64) -> u64 {
        transition (((self.plugin_capability_mask as u64 in Wrapping) >> rank) as u64 & 1) == 1 {
            true -> count_next(rank, ((seen as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> count_next(rank, seen)
        }
    }
    state count_next(&self, rank: u64, seen: u64) -> u64 {
        transition { _ -> count(((rank as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, seen) }
    }
}

pub machine PluginMetadata::get_plugin_permission_count(&self) -> u64 {
    transition { _ -> count(0, 0) }
    state count(&self, rank: u64, seen: u64) -> u64 {
        transition rank < 11 {
            true -> check(rank, seen)
            false -> (seen)
        }
    }
    state check(&self, rank: u64, seen: u64) -> u64 {
        transition (((self.plugin_permission_mask as u64 in Wrapping) >> rank) as u64 & 1) == 1 {
            true -> count_next(rank, ((seen as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> count_next(rank, seen)
        }
    }
    state count_next(&self, rank: u64, seen: u64) -> u64 {
        transition { _ -> count(((rank as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, seen) }
    }
}

// position-th member in upstream's sorted order — the position-th set bit.
pub machine PluginMetadata::get_plugin_capability(&self, position: u64) -> PluginCapability {
    transition { _ -> scan(0, 0, position) }
    state scan(&self, rank: u64, seen: u64, position: u64) -> PluginCapability {
        transition rank < 5 {
            true -> check(rank, seen, position)
            false -> (PluginCapability::DataType)
        }
    }
    state check(&self, rank: u64, seen: u64, position: u64) -> PluginCapability {
        transition (((self.plugin_capability_mask as u64 in Wrapping) >> rank) as u64 & 1) == 1 {
            true -> member_or_next(rank, seen, position)
            false -> next(rank, seen, position)
        }
    }
    state member_or_next(&self, rank: u64, seen: u64, position: u64) -> PluginCapability {
        transition seen == position {
            true -> pick(rank)
            false -> next(rank, ((seen as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, position)
        }
    }
    state pick(&self, rank: u64) -> PluginCapability {
        PluginCapability::from_rank(rank)
    }
    state next(&self, rank: u64, seen: u64, position: u64) -> PluginCapability {
        transition { _ -> scan(((rank as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, seen, position) }
    }
}

pub machine PluginMetadata::get_plugin_permission(&self, position: u64) -> PluginPermission {
    transition { _ -> scan(0, 0, position) }
    state scan(&self, rank: u64, seen: u64, position: u64) -> PluginPermission {
        transition rank < 11 {
            true -> check(rank, seen, position)
            false -> (PluginPermission::AttachDebugger)
        }
    }
    state check(&self, rank: u64, seen: u64, position: u64) -> PluginPermission {
        transition (((self.plugin_permission_mask as u64 in Wrapping) >> rank) as u64 & 1) == 1 {
            true -> member_or_next(rank, seen, position)
            false -> next(rank, seen, position)
        }
    }
    state member_or_next(&self, rank: u64, seen: u64, position: u64) -> PluginPermission {
        transition seen == position {
            true -> pick(rank)
            false -> next(rank, ((seen as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, position)
        }
    }
    state pick(&self, rank: u64) -> PluginPermission {
        PluginPermission::from_rank(rank)
    }
    state next(&self, rank: u64, seen: u64, position: u64) -> PluginPermission {
        transition { _ -> scan(((rank as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, seen, position) }
    }
}

pub machine PluginMetadata::set_plugin_id(&mut self, plugin_id: &[u8]) {
    self.plugin_id_len = BoundedByteCopy::copy(&mut self.plugin_id[0..256], plugin_id);
}

pub machine PluginMetadata::set_display_name(&mut self, display_name: &[u8]) {
    self.display_name_len = BoundedByteCopy::copy(&mut self.display_name[0..256], display_name);
}

pub machine PluginMetadata::set_description(&mut self, description: &[u8]) {
    self.description_len = BoundedByteCopy::copy(&mut self.description[0..256], description);
}

pub machine PluginMetadata::clone(&self) -> PluginMetadata {
    let mut clone: PluginMetadata = PluginMetadata {
        plugin_id_len: 0,
        display_name_len: 0,
        description_len: 0,
        plugin_capability_mask: 0,
        plugin_permission_mask: 0,
        is_built_in: false,
        is_enabled_by_default: false,
    };
    clone.clone_from(self);
    (clone)
}

pub machine PluginMetadata::clone_from(&mut self, source: &PluginMetadata) {
    self.set_plugin_id(source.get_plugin_id());
    self.set_display_name(source.get_display_name());
    self.set_description(source.get_description());
    self.plugin_capability_mask = source.plugin_capability_mask;
    self.plugin_permission_mask = source.plugin_permission_mask;
    self.is_built_in = source.is_built_in;
    self.is_enabled_by_default = source.is_enabled_by_default;
}
