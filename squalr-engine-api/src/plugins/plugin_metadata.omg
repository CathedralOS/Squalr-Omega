module src::plugins::plugin_metadata;

use src::plugins::plugin_capability::PluginCapability;
use src::plugins::plugin_permission::PluginPermission;

// Port of plugins/plugin_metadata.rs — the plugin's static identity
// {plugin_id, display_name, description, plugin_capabilities,
// plugin_permissions, is_built_in, is_enabled_by_default}. Strings ride
// the bounded [u8; 256] + live length carriers. Upstream's two Vecs are
// constructed as sorted dedup'd sets (new_with_permissions sorts on Ord):
// the port carries each set as a rank bitmask — rank-ordered unique
// membership by construction, so enumeration order is upstream's sorted
// order exactly and duplicates cannot exist.
pub data PluginMetadata {
    plugin_id: [u8; 256];
    plugin_id_len: u64;
    display_name: [u8; 256];
    display_name_len: u64;
    description: [u8; 256];
    description_len: u64;
    plugin_capability_mask: u64;
    plugin_permission_mask: u64;
    is_built_in: bool;
    is_enabled_by_default: bool;
}

// Upstream `new` — permissions default to the empty set.
pub machine PluginMetadata::new(
    plugin_id: &[u8],
    display_name: &[u8],
    description: &[u8],
    is_built_in: bool,
    is_enabled_by_default: bool
) -> PluginMetadata {
    let mut metadata: PluginMetadata = PluginMetadata {
        plugin_id_len: 0,
        display_name_len: 0,
        description_len: 0,
        plugin_capability_mask: 0,
        plugin_permission_mask: 0,
        is_built_in: is_built_in,
        is_enabled_by_default: is_enabled_by_default,
    };
    PluginMetadata::set_plugin_id(&mut metadata, plugin_id);
    PluginMetadata::set_display_name(&mut metadata, display_name);
    PluginMetadata::set_description(&mut metadata, description);
    (metadata)
}

pub machine PluginMetadata::get_plugin_id(this: &PluginMetadata) -> &[u8] {
    transition this.plugin_id_len <= 256 {
        true -> (&this.plugin_id[0..this.plugin_id_len])
        false -> (&this.plugin_id[0..256])
        _ -> (&this.plugin_id[0..256])
    }
}

pub machine PluginMetadata::get_display_name(this: &PluginMetadata) -> &[u8] {
    transition this.display_name_len <= 256 {
        true -> (&this.display_name[0..this.display_name_len])
        false -> (&this.display_name[0..256])
        _ -> (&this.display_name[0..256])
    }
}

pub machine PluginMetadata::get_description(this: &PluginMetadata) -> &[u8] {
    transition this.description_len <= 256 {
        true -> (&this.description[0..this.description_len])
        false -> (&this.description[0..256])
        _ -> (&this.description[0..256])
    }
}

pub machine PluginMetadata::get_is_built_in(this: &PluginMetadata) -> bool {
    this.is_built_in
}

pub machine PluginMetadata::get_is_enabled_by_default(this: &PluginMetadata) -> bool {
    this.is_enabled_by_default
}

// Upstream `has_plugin_capability` — contains() over the set.
pub machine PluginMetadata::has_plugin_capability(this: &PluginMetadata, capability: PluginCapability) -> bool {
    let mut rank: u64 = PluginCapability::rank(&capability);
    (((this.plugin_capability_mask as u64 in Wrapping) >> rank) as u64 & 1) == 1
}

// Upstream's permission-set contains() (same Vec discipline).
pub machine PluginMetadata::has_plugin_permission(this: &PluginMetadata, permission: PluginPermission) -> bool {
    let mut rank: u64 = PluginPermission::rank(&permission);
    (((this.plugin_permission_mask as u64 in Wrapping) >> rank) as u64 & 1) == 1
}

// Set membership — dedup is free on a bitmask. Returns whether the
// membership bit changed (upstream's Vec insert is a no-op on duplicates).
pub machine PluginMetadata::add_plugin_capability(this: &mut PluginMetadata, capability: PluginCapability) -> bool {
    let mut rank: u64 = PluginCapability::rank(&capability);
    let mut bit: u64 = ((1 as u64 in Wrapping) << rank) as u64;
    let mut was_set: bool = (this.plugin_capability_mask & bit) != 0;
    this.plugin_capability_mask = this.plugin_capability_mask | bit;
    (!was_set)
}

pub machine PluginMetadata::add_plugin_permission(this: &mut PluginMetadata, permission: PluginPermission) -> bool {
    let mut rank: u64 = PluginPermission::rank(&permission);
    let mut bit: u64 = ((1 as u64 in Wrapping) << rank) as u64;
    let mut was_set: bool = (this.plugin_permission_mask & bit) != 0;
    this.plugin_permission_mask = this.plugin_permission_mask | bit;
    (!was_set)
}

// Set cardinalities — upstream's Vec::len.
pub machine PluginMetadata::get_plugin_capability_count(this: &PluginMetadata) -> u64 {
    transition { _ -> count(this, 0, 0) }
    state count(this: &PluginMetadata, rank: u64, seen: u64) -> u64 {
        transition rank < 5 {
            true -> check(this, rank, seen)
            false -> (seen)
        }
    }
    state check(this: &PluginMetadata, rank: u64, seen: u64) -> u64 {
        transition (((this.plugin_capability_mask as u64 in Wrapping) >> rank) as u64 & 1) == 1 {
            true -> count_next(this, rank, ((seen as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> count_next(this, rank, seen)
        }
    }
    state count_next(this: &PluginMetadata, rank: u64, seen: u64) -> u64 {
        transition { _ -> count(this, ((rank as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, seen) }
    }
}

pub machine PluginMetadata::get_plugin_permission_count(this: &PluginMetadata) -> u64 {
    transition { _ -> count(this, 0, 0) }
    state count(this: &PluginMetadata, rank: u64, seen: u64) -> u64 {
        transition rank < 11 {
            true -> check(this, rank, seen)
            false -> (seen)
        }
    }
    state check(this: &PluginMetadata, rank: u64, seen: u64) -> u64 {
        transition (((this.plugin_permission_mask as u64 in Wrapping) >> rank) as u64 & 1) == 1 {
            true -> count_next(this, rank, ((seen as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> count_next(this, rank, seen)
        }
    }
    state count_next(this: &PluginMetadata, rank: u64, seen: u64) -> u64 {
        transition { _ -> count(this, ((rank as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, seen) }
    }
}

// position-th member in upstream's sorted order — the position-th set bit.
pub machine PluginMetadata::get_plugin_capability(this: &PluginMetadata, position: u64) -> PluginCapability {
    transition { _ -> scan(this, 0, 0, position) }
    state scan(this: &PluginMetadata, rank: u64, seen: u64, position: u64) -> PluginCapability {
        transition rank < 5 {
            true -> check(this, rank, seen, position)
            false -> (PluginCapability::DataType)
        }
    }
    state check(this: &PluginMetadata, rank: u64, seen: u64, position: u64) -> PluginCapability {
        transition (((this.plugin_capability_mask as u64 in Wrapping) >> rank) as u64 & 1) == 1 {
            true -> member_or_next(this, rank, seen, position)
            false -> next(this, rank, seen, position)
        }
    }
    state member_or_next(this: &PluginMetadata, rank: u64, seen: u64, position: u64) -> PluginCapability {
        transition seen == position {
            true -> pick(this, rank)
            false -> next(this, rank, ((seen as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, position)
        }
    }
    state pick(this: &PluginMetadata, rank: u64) -> PluginCapability {
        PluginCapability::from_rank(rank)
    }
    state next(this: &PluginMetadata, rank: u64, seen: u64, position: u64) -> PluginCapability {
        transition { _ -> scan(this, ((rank as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, seen, position) }
    }
}

pub machine PluginMetadata::get_plugin_permission(this: &PluginMetadata, position: u64) -> PluginPermission {
    transition { _ -> scan(this, 0, 0, position) }
    state scan(this: &PluginMetadata, rank: u64, seen: u64, position: u64) -> PluginPermission {
        transition rank < 11 {
            true -> check(this, rank, seen, position)
            false -> (PluginPermission::AttachDebugger)
        }
    }
    state check(this: &PluginMetadata, rank: u64, seen: u64, position: u64) -> PluginPermission {
        transition (((this.plugin_permission_mask as u64 in Wrapping) >> rank) as u64 & 1) == 1 {
            true -> member_or_next(this, rank, seen, position)
            false -> next(this, rank, seen, position)
        }
    }
    state member_or_next(this: &PluginMetadata, rank: u64, seen: u64, position: u64) -> PluginPermission {
        transition seen == position {
            true -> pick(this, rank)
            false -> next(this, rank, ((seen as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, position)
        }
    }
    state pick(this: &PluginMetadata, rank: u64) -> PluginPermission {
        PluginPermission::from_rank(rank)
    }
    state next(this: &PluginMetadata, rank: u64, seen: u64, position: u64) -> PluginPermission {
        transition { _ -> scan(this, ((rank as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, seen, position) }
    }
}

pub machine PluginMetadata::set_plugin_id(this: &mut PluginMetadata, plugin_id: &[u8]) {
    this.plugin_id_len = 0;
    transition { _ -> copy(this, plugin_id, 0) }
    state copy(this: &mut PluginMetadata, plugin_id: &[u8], position: u64) {
        transition position < plugin_id.len && position < 256 {
            true -> store(this, plugin_id, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut PluginMetadata, plugin_id: &[u8], position: u64) {
        this.plugin_id[position] = plugin_id[position];
        transition {
            _ -> copy(this, plugin_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut PluginMetadata, count: u64) {
        this.plugin_id_len = count;
    }
}

pub machine PluginMetadata::set_display_name(this: &mut PluginMetadata, display_name: &[u8]) {
    this.display_name_len = 0;
    transition { _ -> copy(this, display_name, 0) }
    state copy(this: &mut PluginMetadata, display_name: &[u8], position: u64) {
        transition position < display_name.len && position < 256 {
            true -> store(this, display_name, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut PluginMetadata, display_name: &[u8], position: u64) {
        this.display_name[position] = display_name[position];
        transition {
            _ -> copy(this, display_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut PluginMetadata, count: u64) {
        this.display_name_len = count;
    }
}

pub machine PluginMetadata::set_description(this: &mut PluginMetadata, description: &[u8]) {
    this.description_len = 0;
    transition { _ -> copy(this, description, 0) }
    state copy(this: &mut PluginMetadata, description: &[u8], position: u64) {
        transition position < description.len && position < 256 {
            true -> store(this, description, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut PluginMetadata, description: &[u8], position: u64) {
        this.description[position] = description[position];
        transition {
            _ -> copy(this, description, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut PluginMetadata, count: u64) {
        this.description_len = count;
    }
}

pub machine PluginMetadata::clone(this: &PluginMetadata) -> PluginMetadata {
    let mut clone: PluginMetadata = PluginMetadata {
        plugin_id_len: 0,
        display_name_len: 0,
        description_len: 0,
        plugin_capability_mask: 0,
        plugin_permission_mask: 0,
        is_built_in: false,
        is_enabled_by_default: false,
    };
    PluginMetadata::clone_from(&mut clone, this);
    (clone)
}

pub machine PluginMetadata::clone_from(this: &mut PluginMetadata, source: &PluginMetadata) {
    PluginMetadata::set_plugin_id(&mut this, PluginMetadata::get_plugin_id(source));
    PluginMetadata::set_display_name(&mut this, PluginMetadata::get_display_name(source));
    PluginMetadata::set_description(&mut this, PluginMetadata::get_description(source));
    this.plugin_capability_mask = source.plugin_capability_mask;
    this.plugin_permission_mask = source.plugin_permission_mask;
    this.is_built_in = source.is_built_in;
    this.is_enabled_by_default = source.is_enabled_by_default;
}
