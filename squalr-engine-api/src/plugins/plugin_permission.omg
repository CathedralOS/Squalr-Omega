module src::plugins::plugin_permission;

// Port of plugins/plugin_permission.rs — the permissions a plugin
// declares. Upstream's get_display_name is a CLI text convention —
// deferred to the CLI leg.
pub data PluginPermission [copy] {
    case AttachDebugger;
    case ControlDebuggerExecution;
    case ManageDebuggerBreakpoints;
    case ReadSymbolStore;
    case WriteSymbolStore;
    case ReadSymbolTreeWindow;
    case WriteSymbolTreeWindow;
    case ReadProcessMemory;
    case ReadRegisters;
    case WriteProcessMemory;
    case WriteRegisters;
}

pub machine PluginPermission::rank(plugin_permission: &PluginPermission) -> u64 {
    transition plugin_permission {
        PluginPermission::AttachDebugger {} -> (0)
        PluginPermission::ControlDebuggerExecution {} -> (1)
        PluginPermission::ManageDebuggerBreakpoints {} -> (2)
        PluginPermission::ReadSymbolStore {} -> (3)
        PluginPermission::WriteSymbolStore {} -> (4)
        PluginPermission::ReadSymbolTreeWindow {} -> (5)
        PluginPermission::WriteSymbolTreeWindow {} -> (6)
        PluginPermission::ReadProcessMemory {} -> (7)
        PluginPermission::ReadRegisters {} -> (8)
        PluginPermission::WriteProcessMemory {} -> (9)
        PluginPermission::WriteRegisters {} -> (10)
        _ -> (11)
    }
}

pub machine PluginPermission::from_rank(rank: u64) -> PluginPermission {
    transition rank {
        0 -> (PluginPermission::AttachDebugger)
        1 -> (PluginPermission::ControlDebuggerExecution)
        2 -> (PluginPermission::ManageDebuggerBreakpoints)
        3 -> (PluginPermission::ReadSymbolStore)
        4 -> (PluginPermission::WriteSymbolStore)
        5 -> (PluginPermission::ReadSymbolTreeWindow)
        6 -> (PluginPermission::WriteSymbolTreeWindow)
        7 -> (PluginPermission::ReadProcessMemory)
        8 -> (PluginPermission::ReadRegisters)
        9 -> (PluginPermission::WriteProcessMemory)
        10 -> (PluginPermission::WriteRegisters)
        _ -> (PluginPermission::AttachDebugger)
    }
}
