module src::plugins::plugin_capability;

// Port of plugins/plugin_capability.rs — the capability tags a plugin
// advertises. Upstream's get_cli_label/get_display_name are CLI text
// conventions — they ride the CLI leg, not the wire surface.
pub data PluginCapability [copy] {
    case DataType;
    case Debugger;
    case InstructionSet;
    case MemoryView;
    case SymbolTree;
}

// Upstream sorts capability lists on construction (enum Ord) — the rank
// orders bounded-set membership identically.
pub machine PluginCapability::rank(this: &PluginCapability) -> u64 {
    transition this {
        PluginCapability::DataType {} -> (0)
        PluginCapability::Debugger {} -> (1)
        PluginCapability::InstructionSet {} -> (2)
        PluginCapability::MemoryView {} -> (3)
        PluginCapability::SymbolTree {} -> (4)
        _ -> (5)
    }
}

// Rank -> element (the bitset's enumeration direction; unreachable ranks
// yield the upstream default case — callers only pass ranks below 5).
pub machine PluginCapability::from_rank(rank: u64) -> PluginCapability {
    transition rank {
        0 -> (PluginCapability::DataType)
        1 -> (PluginCapability::Debugger)
        2 -> (PluginCapability::InstructionSet)
        3 -> (PluginCapability::MemoryView)
        4 -> (PluginCapability::SymbolTree)
        _ -> (PluginCapability::DataType)
    }
}
