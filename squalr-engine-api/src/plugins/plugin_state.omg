use src/plugins/plugin_activation_state.omg;
use src/plugins/plugin_metadata.omg;

// Port of plugins/plugin_state.rs — {metadata, is_enabled,
// activation_state}; the activation helpers mirror upstream's matches!
// on the activation state.
public data PluginState {
    metadata: |plugin_metadata|::PluginMetadata;
    is_enabled: bool;
    activation_state: |plugin_activation_state|::PluginActivationState;
}

public machine PluginState::new(
    metadata: |plugin_metadata|::PluginMetadata,
    is_enabled: bool,
    activation_state: |plugin_activation_state|::PluginActivationState
) -> PluginState {
    PluginState {
        metadata: metadata,
        is_enabled: is_enabled,
        activation_state: activation_state,
    }
}

public machine PluginState::get_metadata(this: &PluginState) -> &|plugin_metadata|::PluginMetadata {
    &this.metadata
}

public machine PluginState::get_is_enabled(this: &PluginState) -> bool {
    this.is_enabled
}

public machine PluginState::set_is_enabled(this: &mut PluginState, is_enabled: bool) {
    this.is_enabled = is_enabled;
}

public machine PluginState::get_activation_state(this: &PluginState) -> |plugin_activation_state|::PluginActivationState {
    this.activation_state
}

// Upstream `get_can_activate_for_current_process` — matches!(Available |
// Activating | Activated).
public machine PluginState::get_can_activate_for_current_process(this: &PluginState) -> bool {
    transition this.activation_state {
        |plugin_activation_state|::PluginActivationState::Available {} -> (true)
        |plugin_activation_state|::PluginActivationState::Activating {} -> (true)
        |plugin_activation_state|::PluginActivationState::Activated {} -> (true)
        _ -> (false)
    }
}

// Upstream `get_is_active_for_current_process` — Activated only.
public machine PluginState::get_is_active_for_current_process(this: &PluginState) -> bool {
    transition this.activation_state {
        |plugin_activation_state|::PluginActivationState::Activated {} -> (true)
        _ -> (false)
    }
}

public machine PluginState::clone(this: &PluginState) -> PluginState {
    let mut clone: PluginState = PluginState {
        is_enabled: false,
        activation_state: |plugin_activation_state|::PluginActivationState::Idle,
    };
    PluginState::clone_from(&mut clone, this);
    (clone)
}

public machine PluginState::clone_from(this: &mut PluginState, source: &PluginState) {
    |plugin_metadata|::PluginMetadata::clone_from(&mut this.metadata, &source.metadata);
    this.is_enabled = source.is_enabled;
    this.activation_state = source.activation_state;
}
