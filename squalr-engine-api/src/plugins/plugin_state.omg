module src::plugins::plugin_state;

use src::plugins::plugin_activation_state::PluginActivationState;
use src::plugins::plugin_metadata::PluginMetadata;

// Port of plugins/plugin_state.rs — {metadata, is_enabled,
// activation_state}; the activation helpers mirror upstream's matches!
// on the activation state.
pub data PluginState {
    metadata: PluginMetadata;
    is_enabled: bool;
    activation_state: PluginActivationState;
}

pub machine PluginState::new(
    metadata: PluginMetadata,
    is_enabled: bool,
    activation_state: PluginActivationState
) -> PluginState {
    PluginState {
        metadata: metadata,
        is_enabled: is_enabled,
        activation_state: activation_state,
    }
}

pub machine PluginState::get_metadata(plugin_state: &PluginState) -> &PluginMetadata {
    &plugin_state.metadata
}

pub machine PluginState::get_is_enabled(plugin_state: &PluginState) -> bool {
    plugin_state.is_enabled
}

pub machine PluginState::set_is_enabled(plugin_state: &mut PluginState, is_enabled: bool) {
    plugin_state.is_enabled = is_enabled;
}

pub machine PluginState::get_activation_state(plugin_state: &PluginState) -> PluginActivationState {
    plugin_state.activation_state
}

// Upstream `get_can_activate_for_current_process` — matches!(Available |
// Activating | Activated).
pub machine PluginState::get_can_activate_for_current_process(plugin_state: &PluginState) -> bool {
    transition plugin_state.activation_state {
        PluginActivationState::Available {} -> (true)
        PluginActivationState::Activating {} -> (true)
        PluginActivationState::Activated {} -> (true)
        _ -> (false)
    }
}

// Upstream `get_is_active_for_current_process` — Activated only.
pub machine PluginState::get_is_active_for_current_process(plugin_state: &PluginState) -> bool {
    transition plugin_state.activation_state {
        PluginActivationState::Activated {} -> (true)
        _ -> (false)
    }
}

pub machine PluginState::clone(plugin_state: &PluginState) -> PluginState {
    let mut clone: PluginState = PluginState {
        is_enabled: false,
        activation_state: PluginActivationState::Idle,
    };
    PluginState::clone_from(&mut clone, plugin_state);
    (clone)
}

pub machine PluginState::clone_from(plugin_state: &mut PluginState, source: &PluginState) {
    PluginMetadata::clone_from(&mut plugin_state.metadata, &source.metadata);
    plugin_state.is_enabled = source.is_enabled;
    plugin_state.activation_state = source.activation_state;
}
