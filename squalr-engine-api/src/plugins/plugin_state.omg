module src::plugins::plugin_state;

use src::plugins::plugin_activation_state::PluginActivationState;
use src::plugins::plugin_metadata::PluginMetadata;

// Port of plugins/plugin_state.rs — {metadata, is_enabled,
// activation_state}; the activation helpers mirror upstream's matches!
// on the activation state.
pub data PluginState {
    metadata: PluginMetadata;
    is_enabled: bool;
    activation_state: PluginActivationState;
}

pub machine PluginState::new(
    metadata: PluginMetadata,
    is_enabled: bool,
    activation_state: PluginActivationState
) -> PluginState {
    PluginState {
        metadata: metadata,
        is_enabled: is_enabled,
        activation_state: activation_state,
    }
}

pub machine PluginState::get_metadata(&self) -> &PluginMetadata {
    &self.metadata
}

pub machine PluginState::get_is_enabled(&self) -> bool {
    self.is_enabled
}

pub machine PluginState::set_is_enabled(&mut self, is_enabled: bool) {
    self.is_enabled = is_enabled;
}

pub machine PluginState::get_activation_state(&self) -> PluginActivationState {
    self.activation_state
}

// Upstream `get_can_activate_for_current_process` — matches!(Available |
// Activating | Activated).
pub machine PluginState::get_can_activate_for_current_process(&self) -> bool {
    transition self.activation_state {
        PluginActivationState::Available {} -> (true)
        PluginActivationState::Activating {} -> (true)
        PluginActivationState::Activated {} -> (true)
        _ -> (false)
    }
}

// Upstream `get_is_active_for_current_process` — Activated only.
pub machine PluginState::get_is_active_for_current_process(&self) -> bool {
    transition self.activation_state {
        PluginActivationState::Activated {} -> (true)
        _ -> (false)
    }
}

pub machine PluginState::clone(&self) -> PluginState {
    let mut clone: PluginState = PluginState {
        is_enabled: false,
        activation_state: PluginActivationState::Idle,
    };
    clone.clone_from(self);
    (clone)
}

pub machine PluginState::clone_from(&mut self, source: &PluginState) {
    self.metadata.clone_from(&source.metadata);
    self.is_enabled = source.is_enabled;
    self.activation_state = source.activation_state;
}
