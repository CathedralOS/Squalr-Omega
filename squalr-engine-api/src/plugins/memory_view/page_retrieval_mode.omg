module src::plugins::memory_view::page_retrieval_mode;

// Port of plugins/memory_view/page_retrieval_mode.rs: which regions a memory
// query returns. FromSettings is the upstream Default.
public data PageRetrievalMode [copy] {
    case FromSettings;
    case FromUserMode;
    case FromNonModules;
    case FromModules;
    case FromVirtualModules;
}

public machine PageRetrievalMode::default() -> PageRetrievalMode {
    PageRetrievalMode::FromSettings
}
