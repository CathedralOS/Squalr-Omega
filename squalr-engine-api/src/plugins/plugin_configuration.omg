module src::plugins::plugin_configuration;

use src::plugins::plugin_id::PluginId;
use src::plugins::plugin_metadata::PluginMetadata;
use src::plugins::plugin_state::PluginState;
use src::commands::plugins::list::plugin_list_response::PluginListResponse;

// Port of plugins/plugin_configuration.rs — the per-project enabled/
// disabled/priority plugin-id lists persisted in ProjectInfo. Upstream's
// Vec<String> lists bound at 32 ids each (7 builtin packages ship today;
// 32 leaves headroom without a result-shaping cap). `new` keeps upstream's
// normalize semantics verbatim: enabled/disabled lists are
// retain-nonempty + sort + dedup; the priority list is retain-nonempty +
// dedup preserving order.
pub data PluginConfiguration {
    enabled_plugin_ids: [PluginId; 32];
    enabled_plugin_id_count: u64;
    disabled_plugin_ids: [PluginId; 32];
    disabled_plugin_id_count: u64;
    priority_plugin_ids: [PluginId; 32];
    priority_plugin_id_count: u64;
}

// Upstream `new` — the caller fills each list via add_* then the explicit
// normalize machines run the upstream sort/dedup pass.
pub machine PluginConfiguration::new() -> PluginConfiguration {
    PluginConfiguration {
        enabled_plugin_id_count: 0,
        disabled_plugin_id_count: 0,
        priority_plugin_id_count: 0,
    }
}

pub machine PluginConfiguration::default() -> PluginConfiguration {
    PluginConfiguration::new()
}

// Upstream `is_empty` — all three lists empty.
pub machine PluginConfiguration::is_empty(plugin_configuration: &PluginConfiguration) -> bool {
    (plugin_configuration.enabled_plugin_id_count == 0 && plugin_configuration.disabled_plugin_id_count == 0
        && plugin_configuration.priority_plugin_id_count == 0)
}

pub machine PluginConfiguration::get_enabled_plugin_id_count(plugin_configuration: &PluginConfiguration) -> u64 {
    plugin_configuration.enabled_plugin_id_count
}

pub machine PluginConfiguration::get_disabled_plugin_id_count(plugin_configuration: &PluginConfiguration) -> u64 {
    plugin_configuration.disabled_plugin_id_count
}

pub machine PluginConfiguration::get_priority_plugin_id_count(plugin_configuration: &PluginConfiguration) -> u64 {
    plugin_configuration.priority_plugin_id_count
}

pub machine PluginConfiguration::get_enabled_plugin_id(plugin_configuration: &PluginConfiguration, index: u64) -> &PluginId
    requires 0 <= index && index < 32
{
    &plugin_configuration.enabled_plugin_ids[index]
}

pub machine PluginConfiguration::get_disabled_plugin_id(plugin_configuration: &PluginConfiguration, index: u64) -> &PluginId
    requires 0 <= index && index < 32
{
    &plugin_configuration.disabled_plugin_ids[index]
}

pub machine PluginConfiguration::get_priority_plugin_id(plugin_configuration: &PluginConfiguration, index: u64) -> &PluginId
    requires 0 <= index && index < 32
{
    &plugin_configuration.priority_plugin_ids[index]
}

// Vec::push legs folded with upstream's normalize semantics: `new` runs
// retain(|id| !id.is_empty()) + sort + dedup on enabled/disabled and
// retain + order-preserving dedup on priority. `locate_*_insert` (&self
// probes — reading array elements to compare is a read edge) locates the
// sorted slot or flags the duplicate; the &mut insert then moves the tail
// via local-clone element swaps (a self.field-rooted arg cannot loan into
// a callee under &mut self — elements clone to a local first).
pub data EnabledInsertProbe {
    position: u64;
    duplicate: bool;
}

pub data DisabledInsertProbe {
    position: u64;
    duplicate: bool;
}

pub machine PluginConfiguration::locate_enabled_insert(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId) -> EnabledInsertProbe {
    transition {
        _ -> scan(plugin_configuration, plugin_id, 0)
    }
    state scan(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId, position: u64) -> EnabledInsertProbe {
        transition position < plugin_configuration.enabled_plugin_id_count && position < 32 {
            true -> compare(plugin_configuration, plugin_id, position)
            false -> (EnabledInsertProbe { position: position, duplicate: false })
        }
    }
    state compare(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId, position: u64) -> EnabledInsertProbe
        requires position < 32;
    {
        let existing: &PluginId = &plugin_configuration.enabled_plugin_ids[position];
        let duplicate: bool = plugin_id_equal(existing, plugin_id);
        transition duplicate {
            true -> (EnabledInsertProbe { position: position, duplicate: true })
            false -> advance(plugin_configuration, plugin_id, existing, position)
        }
    }
    state advance(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId, existing: &PluginId, position: u64) -> EnabledInsertProbe {
        let existing_less: bool = plugin_id_less(existing, plugin_id);
        transition existing_less {
            true -> next(plugin_configuration, plugin_id, position)
            false -> (EnabledInsertProbe { position: position, duplicate: false })
        }
    }
    state next(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId, position: u64) -> EnabledInsertProbe {
        let next_position: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition {
            _ -> scan(plugin_configuration, plugin_id, next_position)
        }
    }
}

pub machine PluginConfiguration::locate_disabled_insert(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId) -> DisabledInsertProbe {
    transition {
        _ -> scan(plugin_configuration, plugin_id, 0)
    }
    state scan(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId, position: u64) -> DisabledInsertProbe {
        transition position < plugin_configuration.disabled_plugin_id_count && position < 32 {
            true -> compare(plugin_configuration, plugin_id, position)
            false -> (DisabledInsertProbe { position: position, duplicate: false })
        }
    }
    state compare(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId, position: u64) -> DisabledInsertProbe
        requires position < 32;
    {
        let existing: &PluginId = &plugin_configuration.disabled_plugin_ids[position];
        let duplicate: bool = plugin_id_equal(existing, plugin_id);
        transition duplicate {
            true -> (DisabledInsertProbe { position: position, duplicate: true })
            false -> advance(plugin_configuration, plugin_id, existing, position)
        }
    }
    state advance(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId, existing: &PluginId, position: u64) -> DisabledInsertProbe {
        let existing_less: bool = plugin_id_less(existing, plugin_id);
        transition existing_less {
            true -> next(plugin_configuration, plugin_id, position)
            false -> (DisabledInsertProbe { position: position, duplicate: false })
        }
    }
    state next(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId, position: u64) -> DisabledInsertProbe {
        let next_position: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition {
            _ -> scan(plugin_configuration, plugin_id, next_position)
        }
    }
}

// Upstream Vec::push on the enabled list — retain+sort+dedup folded in.
pub machine PluginConfiguration::add_enabled_plugin_id(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId) -> bool {
    let id_bytes: &[u8] = PluginId::get_plugin_id(plugin_id);
    let len: u64 = id_bytes.len;
    transition len > 0 && plugin_configuration.enabled_plugin_id_count < 32 {
        true -> locate(plugin_configuration, plugin_id)
        false -> (false)
        _ -> (false)
    }
    state locate(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId) -> bool {
        let probe: EnabledInsertProbe = PluginConfiguration::locate_enabled_insert(plugin_configuration, plugin_id);
        transition probe.duplicate {
            true -> (false)
            false -> shift(plugin_configuration, plugin_id, probe.position)
        }
    }
    state shift(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId, position: u64) -> bool {
        let end: u64 = plugin_configuration.enabled_plugin_id_count;
        transition position <= end && position < 32 && end < 32 {
            true -> move_tail(plugin_configuration, plugin_id, position, end)
            false -> (false)
        }
    }
    state move_tail(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId, position: u64, cursor: u64) -> bool
        requires position < 32 && cursor < 33;
    {
        transition position < cursor && cursor < 33 && 0 < cursor {
            true -> move_one(plugin_configuration, plugin_id, position, cursor)
            false -> insert(plugin_configuration, plugin_id, position)
        }
    }
    state move_one(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId, position: u64, cursor: u64) -> bool
        requires position < 32 && cursor < 33 && 0 < cursor;
    {
        let source: u64 = cursor - 1;
        transition source < 32 && cursor < 32 {
            true -> copy_slot(plugin_configuration, plugin_id, position, cursor, source)
            false -> (false)
        }
    }
    state copy_slot(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId, position: u64, cursor: u64, source: u64) -> bool
        requires position < 32 && cursor < 32 && source < 32;
    {
        let slot: PluginId = PluginId::clone(&plugin_configuration.enabled_plugin_ids[source]);
        PluginId::clone_from(&mut plugin_configuration.enabled_plugin_ids[cursor], &slot);
        transition {
            _ -> move_tail(plugin_configuration, plugin_id, position, source)
        }
    }
    state insert(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId, position: u64) -> bool
        requires position < 32;
    {
        PluginId::clone_from(&mut plugin_configuration.enabled_plugin_ids[position], plugin_id);
        plugin_configuration.enabled_plugin_id_count = ((plugin_configuration.enabled_plugin_id_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream Vec::push on the disabled list — same retain+sort+dedup fold.
pub machine PluginConfiguration::add_disabled_plugin_id(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId) -> bool {
    let id_bytes: &[u8] = PluginId::get_plugin_id(plugin_id);
    let len: u64 = id_bytes.len;
    transition len > 0 && plugin_configuration.disabled_plugin_id_count < 32 {
        true -> locate(plugin_configuration, plugin_id)
        false -> (false)
        _ -> (false)
    }
    state locate(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId) -> bool {
        let probe: DisabledInsertProbe = PluginConfiguration::locate_disabled_insert(plugin_configuration, plugin_id);
        transition probe.duplicate {
            true -> (false)
            false -> shift(plugin_configuration, plugin_id, probe.position)
        }
    }
    state shift(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId, position: u64) -> bool {
        let end: u64 = plugin_configuration.disabled_plugin_id_count;
        transition position <= end && position < 32 && end < 32 {
            true -> move_tail(plugin_configuration, plugin_id, position, end)
            false -> (false)
        }
    }
    state move_tail(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId, position: u64, cursor: u64) -> bool
        requires position < 32 && cursor < 33;
    {
        transition position < cursor && cursor < 33 && 0 < cursor {
            true -> move_one(plugin_configuration, plugin_id, position, cursor)
            false -> insert(plugin_configuration, plugin_id, position)
        }
    }
    state move_one(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId, position: u64, cursor: u64) -> bool
        requires position < 32 && cursor < 33 && 0 < cursor;
    {
        let source: u64 = cursor - 1;
        transition source < 32 && cursor < 32 {
            true -> copy_slot(plugin_configuration, plugin_id, position, cursor, source)
            false -> (false)
        }
    }
    state copy_slot(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId, position: u64, cursor: u64, source: u64) -> bool
        requires position < 32 && cursor < 32 && source < 32;
    {
        let slot: PluginId = PluginId::clone(&plugin_configuration.disabled_plugin_ids[source]);
        PluginId::clone_from(&mut plugin_configuration.disabled_plugin_ids[cursor], &slot);
        transition {
            _ -> move_tail(plugin_configuration, plugin_id, position, source)
        }
    }
    state insert(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId, position: u64) -> bool
        requires position < 32;
    {
        PluginId::clone_from(&mut plugin_configuration.disabled_plugin_ids[position], plugin_id);
        plugin_configuration.disabled_plugin_id_count = ((plugin_configuration.disabled_plugin_id_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Priority list: order-preserving dedup — refuse empties and duplicates,
// append otherwise (upstream retain + normalize_ordered_plugin_ids). The
// membership probe is &self (reading elements to compare is a read edge).
pub machine PluginConfiguration::contains_priority_plugin_id(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId) -> bool {
    transition {
        _ -> probe(plugin_configuration, plugin_id, 0)
    }
    state probe(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId, position: u64) -> bool {
        transition position < plugin_configuration.priority_plugin_id_count && position < 32 {
            true -> compare(plugin_configuration, plugin_id, position)
            false -> (false)
        }
    }
    state compare(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId, position: u64) -> bool
        requires position < 32;
    {
        let existing: &PluginId = &plugin_configuration.priority_plugin_ids[position];
        let duplicate: bool = plugin_id_equal(existing, plugin_id);
        transition duplicate {
            true -> (true)
            false -> next(plugin_configuration, plugin_id, position)
        }
    }
    state next(plugin_configuration: &PluginConfiguration, plugin_id: &PluginId, position: u64) -> bool {
        let next_position: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition {
            _ -> probe(plugin_configuration, plugin_id, next_position)
        }
    }
}

pub machine PluginConfiguration::add_priority_plugin_id(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId) -> bool {
    let id_bytes: &[u8] = PluginId::get_plugin_id(plugin_id);
    let len: u64 = id_bytes.len;
    transition len > 0 && plugin_configuration.priority_plugin_id_count < 32 {
        true -> check(plugin_configuration, plugin_id)
        false -> (false)
        _ -> (false)
    }
    state check(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId) -> bool {
        let duplicate: bool = PluginConfiguration::contains_priority_plugin_id(plugin_configuration, plugin_id);
        transition duplicate {
            true -> (false)
            false -> append(plugin_configuration, plugin_id)
        }
    }
    state append(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId) -> bool {
        let index: u64 = plugin_configuration.priority_plugin_id_count;
        transition index < 32 {
            true -> fill(plugin_configuration, plugin_id, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill(plugin_configuration: &mut PluginConfiguration, plugin_id: &PluginId, index: u64) -> bool
        requires 0 <= index && index < 32
    {
        PluginId::clone_from(&mut plugin_configuration.priority_plugin_ids[index], plugin_id);
        plugin_configuration.priority_plugin_id_count = index + 1;
        (true)
    }
}

// Whole-record clone — element-wise through each bounded table (the
// session legs copy configurations across the project boundary).
pub machine PluginConfiguration::clone(source: &PluginConfiguration) -> PluginConfiguration {
    let mut out: PluginConfiguration = PluginConfiguration::new();
    PluginConfiguration::clone_from(&mut out, source);
    (out)
}

pub machine PluginConfiguration::clone_from(plugin_configuration: &mut PluginConfiguration, source: &PluginConfiguration) {
    plugin_configuration.enabled_plugin_id_count = source.enabled_plugin_id_count;
    plugin_configuration.disabled_plugin_id_count = source.disabled_plugin_id_count;
    plugin_configuration.priority_plugin_id_count = source.priority_plugin_id_count;
    transition {
        _ -> copy_enabled(plugin_configuration, source, 0)
    }
    state copy_enabled(plugin_configuration: &mut PluginConfiguration, source: &PluginConfiguration, index: u64) {
        transition index < source.enabled_plugin_id_count && index < 32 {
            true -> write_enabled(plugin_configuration, source, index)
            false -> copy_disabled_start(plugin_configuration, source)
        }
    }
    state write_enabled(plugin_configuration: &mut PluginConfiguration, source: &PluginConfiguration, index: u64)
        requires index < 32;
    {
        let element: PluginId = PluginId::clone(&source.enabled_plugin_ids[index]);
        PluginId::clone_from(&mut plugin_configuration.enabled_plugin_ids[index], &element);
        let next_index: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition {
            _ -> copy_enabled(plugin_configuration, source, next_index)
        }
    }
    state copy_disabled_start(plugin_configuration: &mut PluginConfiguration, source: &PluginConfiguration) {
        transition {
            _ -> copy_disabled(plugin_configuration, source, 0)
        }
    }
    state copy_disabled(plugin_configuration: &mut PluginConfiguration, source: &PluginConfiguration, index: u64) {
        transition index < source.disabled_plugin_id_count && index < 32 {
            true -> write_disabled(plugin_configuration, source, index)
            false -> copy_priority_start(plugin_configuration, source)
        }
    }
    state write_disabled(plugin_configuration: &mut PluginConfiguration, source: &PluginConfiguration, index: u64)
        requires index < 32;
    {
        let element: PluginId = PluginId::clone(&source.disabled_plugin_ids[index]);
        PluginId::clone_from(&mut plugin_configuration.disabled_plugin_ids[index], &element);
        let next_index: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition {
            _ -> copy_disabled(plugin_configuration, source, next_index)
        }
    }
    state copy_priority_start(plugin_configuration: &mut PluginConfiguration, source: &PluginConfiguration) {
        transition {
            _ -> copy_priority(plugin_configuration, source, 0)
        }
    }
    state copy_priority(plugin_configuration: &mut PluginConfiguration, source: &PluginConfiguration, index: u64) {
        transition index < source.priority_plugin_id_count && index < 32 {
            true -> write_priority(plugin_configuration, source, index)
            false -> finish(plugin_configuration)
        }
    }
    state write_priority(plugin_configuration: &mut PluginConfiguration, source: &PluginConfiguration, index: u64)
        requires index < 32;
    {
        let element: PluginId = PluginId::clone(&source.priority_plugin_ids[index]);
        PluginId::clone_from(&mut plugin_configuration.priority_plugin_ids[index], &element);
        let next_index: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition {
            _ -> copy_priority(plugin_configuration, source, next_index)
        }
    }
    state finish(plugin_configuration: &mut PluginConfiguration) {
    }
}

// plugin_id_equal — length equality plus byte equality across the live slice.
pub machine plugin_id_equal(left: &PluginId, right: &PluginId) -> bool {
    let left_bytes: &[u8] = PluginId::get_plugin_id(left);
    let right_bytes: &[u8] = PluginId::get_plugin_id(right);
    transition left_bytes.len == right_bytes.len {
        true -> scan(left_bytes, right_bytes, 0)
        false -> (false)
    }
    state scan(left_bytes: &[u8], right_bytes: &[u8], position: u64) -> bool {
        transition position < left_bytes.len && position < right_bytes.len && position < 256 {
            true -> compare(left_bytes, right_bytes, position)
            false -> (true)
        }
    }
    state compare(left_bytes: &[u8], right_bytes: &[u8], position: u64) -> bool
        requires position < left_bytes.len && position < right_bytes.len;
    {
        let left_byte: u8 = left_bytes[position];
        let right_byte: u8 = right_bytes[position];
        transition left_byte == right_byte {
            true -> next(left_bytes, right_bytes, position)
            false -> (false)
        }
    }
    state next(left_bytes: &[u8], right_bytes: &[u8], position: u64) -> bool {
        let next_position: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next_position < left_bytes.len && next_position < right_bytes.len {
            true -> compare(left_bytes, right_bytes, next_position)
            false -> (true)
        }
    }
}

// plugin_id_less — lexicographic byte order on the two ids' live slices,
// shorter-prefix-is-smaller at exhaustion (upstream sort() order on String).
pub machine plugin_id_less(left: &PluginId, right: &PluginId) -> bool {
    transition {
        _ -> differ(left, right, 0)
    }
    state differ(left: &PluginId, right: &PluginId, position: u64) -> bool {
        let left_bytes: &[u8] = PluginId::get_plugin_id(left);
        let right_bytes: &[u8] = PluginId::get_plugin_id(right);
        transition position < left_bytes.len && position < right_bytes.len && position < 256 {
            true -> compare_bytes(left_bytes, right_bytes, position)
            false -> (left_bytes.len < right_bytes.len)
        }
    }
    state compare_bytes(left_bytes: &[u8], right_bytes: &[u8], position: u64) -> bool
        requires position < left_bytes.len && position < right_bytes.len;
    {
        let left_byte: u8 = left_bytes[position];
        let right_byte: u8 = right_bytes[position];
        transition left_byte == right_byte {
            true -> next(left_bytes, right_bytes, position)
            false -> (left_byte < right_byte)
        }
    }
    state next(left_bytes: &[u8], right_bytes: &[u8], position: u64) -> bool {
        let next_position: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next_position < left_bytes.len && next_position < right_bytes.len {
            true -> compare_bytes(left_bytes, right_bytes, next_position)
            false -> (left_bytes.len < right_bytes.len)
        }
    }
}

// Upstream `from_plugin_states` — folds the current plugin states plus
// the default ordering into a project configuration: enabled ids where
// (not enabled-by-default and currently enabled), disabled ids where
// (enabled-by-default and currently disabled), and the current order as
// priority when it differs from the default order. Empty result is the
// upstream None — the probe union carries it.
pub machine PluginConfiguration::from_plugin_states(
    plugin_list_response: &PluginListResponse
) -> PluginConfigurationProbe {
    let mut configuration: PluginConfiguration = PluginConfiguration::new();
    transition { _ -> fold(configuration, plugin_list_response, 0) }
    state fold(
        mut configuration: PluginConfiguration,
        plugin_list_response: &PluginListResponse,
        position: u64
    ) -> PluginConfigurationProbe {
        transition position < PluginListResponse::get_plugin_count(plugin_list_response) && position < 64 {
            true -> bucket(configuration, plugin_list_response, position)
            _ -> order(configuration, plugin_list_response)
        }
    }
    state bucket(
        mut configuration: PluginConfiguration,
        plugin_list_response: &PluginListResponse,
        position: u64
    ) -> PluginConfigurationProbe
        requires position < 64;
    {
        let plugin_state: &PluginState = PluginListResponse::get_plugin(plugin_list_response, position);
        let metadata: &PluginMetadata = PluginState::get_metadata(plugin_state);
        let plugin_id: &[u8] = PluginMetadata::get_plugin_id(metadata);
        let mut state_id: PluginId = PluginId::new(plugin_id);
        let by_default: bool = PluginMetadata::get_is_enabled_by_default(metadata);
        let is_enabled: bool = PluginState::get_is_enabled(plugin_state);
        transition !by_default && is_enabled {
            true -> add_enabled(configuration, plugin_list_response, position, state_id)
            _ -> maybe_disabled(configuration, plugin_list_response, position, state_id, by_default, is_enabled)
        }
    }
    state add_enabled(
        mut configuration: PluginConfiguration,
        plugin_list_response: &PluginListResponse,
        position: u64,
        state_id: PluginId
    ) -> PluginConfigurationProbe
        requires position < 64;
    {
        _ = PluginConfiguration::add_enabled_plugin_id(&mut configuration, &state_id);
        transition { _ -> fold(configuration, plugin_list_response, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state maybe_disabled(
        mut configuration: PluginConfiguration,
        plugin_list_response: &PluginListResponse,
        position: u64,
        state_id: PluginId,
        by_default: bool,
        is_enabled: bool
    ) -> PluginConfigurationProbe
        requires position < 64;
    {
        transition by_default && !is_enabled {
            true -> add_disabled(configuration, plugin_list_response, position, state_id)
            _ -> fold(configuration, plugin_list_response, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state add_disabled(
        mut configuration: PluginConfiguration,
        plugin_list_response: &PluginListResponse,
        position: u64,
        state_id: PluginId
    ) -> PluginConfigurationProbe
        requires position < 64;
    {
        _ = PluginConfiguration::add_disabled_plugin_id(&mut configuration, &state_id);
        transition { _ -> fold(configuration, plugin_list_response, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    // Upstream `priority_plugin_ids = current if current != defaults
    // else []` — compare the ordered current ids to the default list.
    state order(
        mut configuration: PluginConfiguration,
        plugin_list_response: &PluginListResponse
    ) -> PluginConfigurationProbe {
        let differs: bool = plugin_order_differs(plugin_list_response);
        transition differs {
            true -> fill_order(configuration, plugin_list_response, 0)
            _ -> probe(configuration)
        }
    }
    state fill_order(
        mut configuration: PluginConfiguration,
        plugin_list_response: &PluginListResponse,
        position: u64
    ) -> PluginConfigurationProbe {
        transition position < PluginListResponse::get_plugin_count(plugin_list_response) && position < 64 {
            true -> push_order(configuration, plugin_list_response, position)
            _ -> probe(configuration)
        }
    }
    state push_order(
        mut configuration: PluginConfiguration,
        plugin_list_response: &PluginListResponse,
        position: u64
    ) -> PluginConfigurationProbe
        requires position < 64;
    {
        let plugin_state: &PluginState = PluginListResponse::get_plugin(plugin_list_response, position);
        let metadata: &PluginMetadata = PluginState::get_metadata(plugin_state);
        let mut state_id: PluginId = PluginId::new(PluginMetadata::get_plugin_id(metadata));
        _ = PluginConfiguration::add_priority_plugin_id(&mut configuration, &state_id);
        transition { _ -> fill_order(configuration, plugin_list_response, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state probe(configuration: PluginConfiguration) -> PluginConfigurationProbe {
        let mut carried: PluginConfiguration = configuration;
        transition PluginConfiguration::is_empty(&carried) {
            true -> (PluginConfigurationProbe::Absent)
            _ -> (PluginConfigurationProbe::Present { configuration: carried })
        }
    }
}

pub data PluginConfigurationProbe {
    case Absent;
    case Present(configuration: PluginConfiguration);
}

// Ordered current-ids-vs-default-ids compare — upstream
// `current_plugin_ids == default_plugin_ids`.
machine plugin_order_differs(plugin_list_response: &PluginListResponse) -> bool {
    transition PluginListResponse::get_plugin_count(plugin_list_response) == PluginListResponse::get_default_plugin_id_count(plugin_list_response) {
        true -> walk(plugin_list_response, 0)
        _ -> (true)
    }
    state walk(plugin_list_response: &PluginListResponse, position: u64) -> bool {
        transition position < PluginListResponse::get_plugin_count(plugin_list_response) && position < 64 {
            true -> compare(plugin_list_response, position)
            _ -> (false)
        }
    }
    state compare(plugin_list_response: &PluginListResponse, position: u64) -> bool
        requires position < 64;
    {
        let plugin_state: &PluginState = PluginListResponse::get_plugin(plugin_list_response, position);
        let metadata: &PluginMetadata = PluginState::get_metadata(plugin_state);
        let current_id: &[u8] = PluginMetadata::get_plugin_id(metadata);
        let mut state_id: PluginId = PluginId::new(current_id);
        let default_id: &PluginId = PluginListResponse::get_default_plugin_id(plugin_list_response, position);
        transition PluginId::equals(&state_id, default_id) {
            true -> walk(plugin_list_response, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (true)
        }
    }
}

// Content equality on the three id lists — upstream PartialEq.
pub machine PluginConfiguration::equals(
    plugin_configuration: &PluginConfiguration,
    other: &PluginConfiguration
) -> bool {
    transition plugin_configuration.enabled_plugin_id_count == other.enabled_plugin_id_count
        && plugin_configuration.disabled_plugin_id_count == other.disabled_plugin_id_count
        && plugin_configuration.priority_plugin_id_count == other.priority_plugin_id_count {
        true -> walk_enabled(plugin_configuration, other, 0)
        _ -> (false)
    }
    state walk_enabled(plugin_configuration: &PluginConfiguration, other: &PluginConfiguration, position: u64) -> bool {
        transition position < plugin_configuration.enabled_plugin_id_count && position < 32 {
            true -> compare_enabled(plugin_configuration, other, position)
            _ -> walk_disabled(plugin_configuration, other, 0)
        }
    }
    state compare_enabled(plugin_configuration: &PluginConfiguration, other: &PluginConfiguration, position: u64) -> bool
        requires position < 32;
    {
        transition PluginId::equals(&plugin_configuration.enabled_plugin_ids[position], &other.enabled_plugin_ids[position]) {
            true -> walk_enabled(plugin_configuration, other, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
    state walk_disabled(plugin_configuration: &PluginConfiguration, other: &PluginConfiguration, position: u64) -> bool {
        transition position < plugin_configuration.disabled_plugin_id_count && position < 32 {
            true -> compare_disabled(plugin_configuration, other, position)
            _ -> walk_priority(plugin_configuration, other, 0)
        }
    }
    state compare_disabled(plugin_configuration: &PluginConfiguration, other: &PluginConfiguration, position: u64) -> bool
        requires position < 32;
    {
        transition PluginId::equals(&plugin_configuration.disabled_plugin_ids[position], &other.disabled_plugin_ids[position]) {
            true -> walk_disabled(plugin_configuration, other, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
    state walk_priority(plugin_configuration: &PluginConfiguration, other: &PluginConfiguration, position: u64) -> bool {
        transition position < plugin_configuration.priority_plugin_id_count && position < 32 {
            true -> compare_priority(plugin_configuration, other, position)
            _ -> (true)
        }
    }
    state compare_priority(plugin_configuration: &PluginConfiguration, other: &PluginConfiguration, position: u64) -> bool
        requires position < 32;
    {
        transition PluginId::equals(&plugin_configuration.priority_plugin_ids[position], &other.priority_plugin_ids[position]) {
            true -> walk_priority(plugin_configuration, other, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}
