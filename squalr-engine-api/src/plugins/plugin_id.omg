module src::plugins::plugin_id;

// Bounded-string carrier for upstream's `String` plugin ids — used where
// the surface carries a Vec<String> (default_plugin_ids / plugin_ids):
// one record per entry inside the bounded list page.
pub data PluginId {
    plugin_id: [u8; 256];
    plugin_id_len: u64;
}

pub machine PluginId::new(plugin_id: &[u8]) -> PluginId {
    let mut created: PluginId = PluginId {
        plugin_id_len: 0,
    };
    PluginId::set_plugin_id(&mut created, plugin_id);
    (created)
}

pub machine PluginId::default() -> PluginId {
    PluginId {
        plugin_id_len: 0,
    }
}

pub machine PluginId::get_plugin_id(plugin_id: &PluginId) -> &[u8] {
    transition plugin_id.plugin_id_len <= 256 {
        true -> (&plugin_id.plugin_id[0..plugin_id.plugin_id_len])
        false -> (&plugin_id.plugin_id[0..256])
        _ -> (&plugin_id.plugin_id[0..256])
    }
}

pub machine PluginId::set_plugin_id(receiver: &mut PluginId, plugin_id: &[u8]) {
    receiver.plugin_id_len = 0;
    transition { _ -> copy(receiver, plugin_id, 0) }
    state copy(receiver: &mut PluginId, plugin_id: &[u8], position: u64) {
        transition position < plugin_id.len && position < 256 {
            true -> store(receiver, plugin_id, position)
            false -> finish(receiver, position)
        }
    }
    state store(receiver: &mut PluginId, plugin_id: &[u8], position: u64) {
        receiver.plugin_id[position] = plugin_id[position];
        transition {
            _ -> copy(receiver, plugin_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(receiver: &mut PluginId, count: u64) {
        receiver.plugin_id_len = count;
    }
}

pub machine PluginId::clone(plugin_id: &PluginId) -> PluginId {
    let mut clone: PluginId = PluginId::default();
    PluginId::clone_from(&mut clone, plugin_id);
    (clone)
}

pub machine PluginId::clone_from(plugin_id: &mut PluginId, source: &PluginId) {
    PluginId::set_plugin_id(plugin_id, PluginId::get_plugin_id(source));
}

// Byte-equality on the stored id — the upstream String `==` compare.
pub machine PluginId::equals(plugin_id: &PluginId, other: &PluginId) -> bool {
    let left: &[u8] = PluginId::get_plugin_id(plugin_id);
    let right: &[u8] = PluginId::get_plugin_id(other);
    transition left.len == right.len {
        true -> probe(left, right, 0)
        _ -> (false)
    }
    state probe(left: &[u8], right: &[u8], position: u64) -> bool {
        transition position < left.len && position < right.len {
            true -> compare(left, right, position)
            _ -> (true)
        }
    }
    state compare(left: &[u8], right: &[u8], position: u64) -> bool
        requires position < left.len && position < right.len;
    {
        transition left[position] == right[position] {
            true -> probe(left, right, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}
