module src::plugins::plugin_id;

// Bounded-string carrier for upstream's `String` plugin ids — used where
// the surface carries a Vec<String> (default_plugin_ids / plugin_ids):
// one record per entry inside the bounded list page.
pub data PluginId {
    plugin_id: [u8; 256];
    plugin_id_len: u64;
}

pub machine PluginId::new(plugin_id: &[u8]) -> PluginId {
    let mut created: PluginId = PluginId {
        plugin_id_len: 0,
    };
    PluginId::set_plugin_id(&mut created, plugin_id);
    (created)
}

pub machine PluginId::default() -> PluginId {
    PluginId {
        plugin_id_len: 0,
    }
}

pub machine PluginId::get_plugin_id(this: &PluginId) -> &[u8] {
    transition this.plugin_id_len <= 256 {
        true -> (&this.plugin_id[0..this.plugin_id_len])
        false -> (&this.plugin_id[0..256])
        _ -> (&this.plugin_id[0..256])
    }
}

pub machine PluginId::set_plugin_id(this: &mut PluginId, plugin_id: &[u8]) {
    this.plugin_id_len = 0;
    transition { _ -> copy(this, plugin_id, 0) }
    state copy(this: &mut PluginId, plugin_id: &[u8], position: u64) {
        transition position < plugin_id.len && position < 256 {
            true -> store(this, plugin_id, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut PluginId, plugin_id: &[u8], position: u64) {
        this.plugin_id[position] = plugin_id[position];
        transition {
            _ -> copy(this, plugin_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut PluginId, count: u64) {
        this.plugin_id_len = count;
    }
}

pub machine PluginId::clone(this: &PluginId) -> PluginId {
    let mut clone: PluginId = PluginId::default();
    PluginId::clone_from(&mut clone, this);
    (clone)
}

pub machine PluginId::clone_from(this: &mut PluginId, source: &PluginId) {
    PluginId::set_plugin_id(&mut this, PluginId::get_plugin_id(source));
}
