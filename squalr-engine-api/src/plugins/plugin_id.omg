module src::plugins::plugin_id;

use src::structures::bounded_slice::bounded_slice;

// Bounded-string carrier for upstream's `String` plugin ids — used where
// the surface carries a Vec<String> (default_plugin_ids / plugin_ids):
// one record per entry inside the bounded list page.
pub data PluginId {
    plugin_id: [u8; 256];
    plugin_id_len: u64;
}

pub machine PluginId::new(plugin_id: &[u8]) -> PluginId {
    let mut created: PluginId = PluginId {
        plugin_id_len: 0,
    };
    created.set_plugin_id(plugin_id);
    (created)
}

pub machine PluginId::default() -> PluginId {
    PluginId {
        plugin_id_len: 0,
    }
}

pub machine PluginId::get_plugin_id(&self) -> &[u8] {
    bounded_slice(&self.plugin_id[0..256], self.plugin_id_len)
}

pub machine PluginId::set_plugin_id(&mut self, plugin_id: &[u8]) {
    self.plugin_id_len = 0;
    transition { _ -> copy(plugin_id, 0) }
    state copy(&mut self, plugin_id: &[u8], position: u64) {
        transition position < plugin_id.len && position < 256 {
            true -> store(plugin_id, position)
            false -> finish(position)
        }
    }
    state store(&mut self, plugin_id: &[u8], position: u64) {
        self.plugin_id[position] = plugin_id[position];
        transition {
            _ -> copy(plugin_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.plugin_id_len = count;
    }
}

pub machine PluginId::clone(&self) -> PluginId {
    let mut clone: PluginId = PluginId::default();
    clone.clone_from(self);
    (clone)
}

pub machine PluginId::clone_from(&mut self, source: &PluginId) {
    self.set_plugin_id(source.get_plugin_id());
}
