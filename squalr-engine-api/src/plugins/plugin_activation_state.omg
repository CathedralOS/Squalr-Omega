module src::plugins::plugin_activation_state;

// Port of plugins/plugin_activation_state.rs — the plugin's lifecycle
// state for the current process.
pub data PluginActivationState [copy] {
    case Idle;
    case Available;
    case Activating;
    case Activated;
}

pub machine PluginActivationState::default() -> PluginActivationState {
    (PluginActivationState::Idle)
}
