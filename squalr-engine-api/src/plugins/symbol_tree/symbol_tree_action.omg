module src::plugins::symbol_tree::symbol_tree_action;

// Port of plugins/symbol_tree/symbol_tree_action.rs — the wire carriers
// only: the selection union an execute-plugin-action request carries plus
// the context record wrapping it. The file's upstream trait surface
// (ProjectSymbolStore, ProcessMemoryStore, SymbolTreeWindowStore — dyn
// plugin-host projections) is deferred to the plugin-host leg; no headless
// consumer exists yet.
pub data SymbolTreeActionSelection {
    case ModuleRoot(module_name: [u8; 256], module_name_len: u64);
    case SymbolLocator(symbol_locator_key: [u8; 256], symbol_locator_key_len: u64);
    case ModuleRange(module_name: [u8; 256], module_name_len: u64, offset: u64, length: u64);
    case DerivedNode(tree_node_key: [u8; 256], tree_node_key_len: u64);
}

pub data SymbolTreeActionContext {
    selection: SymbolTreeActionSelection;
}

pub machine SymbolTreeActionContext::new(selection: SymbolTreeActionSelection) -> SymbolTreeActionContext {
    (SymbolTreeActionContext {
        selection: selection,
    })
}

// Upstream `Default` — an empty DerivedNode selection.
pub machine SymbolTreeActionContext::default() -> SymbolTreeActionContext {
    (SymbolTreeActionContext {
        selection: SymbolTreeActionSelection::DerivedNode {
            tree_node_key_len: 0,
        },
    })
}

pub machine SymbolTreeActionContext::get_selection(symbol_tree_action_context: &SymbolTreeActionContext) -> &SymbolTreeActionSelection {
    (&symbol_tree_action_context.selection)
}
