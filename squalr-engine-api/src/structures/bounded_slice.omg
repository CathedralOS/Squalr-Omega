module src::structures::bounded_slice;

// One bounded-slice accessor: `length` leading bytes of the buffer when the
// recorded length is in bounds, the whole buffer when it is not — the shape
// every `get_<field>` machine on a `[u8; N]` + length pair restates.
pub machine bounded_slice(bytes: &[u8], length: u64) -> &[u8] {
    transition length <= bytes.len {
        true -> (&bytes[0..length])
        false -> (&bytes[0..bytes.len])
        _ -> (&bytes[0..bytes.len])
    }
}

// Flag-gated bounded slice: `length` leading bytes only while the carrier
// marks the field populated and the length is in bounds — the empty prefix
// otherwise, the shape `has_<field>` records restate on their getters.
pub machine flagged_bounded_slice(bytes: &[u8], length: u64, present: bool) -> &[u8] {
    transition present && length <= bytes.len {
        true -> (&bytes[0..length])
        _ -> (&bytes[0..0])
    }
}
