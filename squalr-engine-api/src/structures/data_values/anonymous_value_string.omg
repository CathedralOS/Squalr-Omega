module src::structures::data_values::anonymous_value_string;

use omega::language::core::option;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormatParse;
use src::structures::data_values::container_type::ContainerType;
use src::structures::data_values::container_type::ContainerTypeParse;

// Port of structures/data_values/anonymous_value_string.rs: a value kept as
// text together with how to interpret it and whether it is a scalar, array or
// pointer — the `value;format;container` triple command-line input produces.
//
// Authored text is a byte domain with no growable String, so the value lives
// in a bounded inline buffer plus a length — the same translation
// ProcessInfo::name uses, bounded here at 4096 bytes (upstream is unbounded;
// anonymous values beyond the bound refuse to parse rather than truncate —
// named deviation). Upstream is Clone, not Copy, so the record carries no
// [copy]. Err collapses to Optional::None, matching the package's refusal
// convention.
//
// Named deviation: `Optional<T>` can be constructed but not matched in this
// pin, so internal consumption goes through `AnonymousValueStringParse`;
// `from_str` keeps the Optional surface and `parse` is the matchable
// workhorse.
pub data AnonymousValueString {
    anonymous_value_string: [u8; 4096];
    anonymous_value_string_len: u64;
    anonymous_value_string_format: AnonymousValueStringFormat;
    container_type: ContainerType;
}

// Bespoke parse carrier: Optional is unmatchable in this pin. `Refused` is
// upstream's Err.
pub data AnonymousValueStringParse {
    case Refused;
    case Parsed(value: AnonymousValueString);
}

// Upstream `new`. The byte domain stores up to the bound; longer input
// truncates exactly as the bounded name fields in this package do — named
// deviation, since upstream String never truncates.
pub machine AnonymousValueString::new(
    anonymous_value_string: &[u8],
    anonymous_value_string_format: AnonymousValueStringFormat,
    container_type: ContainerType
) -> AnonymousValueString {
    let mut value: AnonymousValueString = AnonymousValueString {
        anonymous_value_string_len: 0,
        anonymous_value_string_format: anonymous_value_string_format,
        container_type: container_type
    };
    AnonymousValueString::fill_value(&mut value, anonymous_value_string, 0, anonymous_value_string.len);
    value
}

// Upstream `set_anonymous_value_string`, bounded like `new`.
pub machine AnonymousValueString::set_anonymous_value_string(this: &mut AnonymousValueString, text: &[u8]) {
    AnonymousValueString::fill_value(&mut this, text, 0, text.len);
}

// Windowed `new`: stores text[start..end] verbatim under the default
// format/container — the constructor callers reach when the operand arrives
// inside a larger token (e.g. the anonymous-scan-constraint prefix split).
pub machine AnonymousValueString::new_window(
    text: &[u8],
    start: u64,
    end: u64,
    anonymous_value_string_format: AnonymousValueStringFormat,
    container_type: ContainerType
) -> AnonymousValueString {
    let mut value: AnonymousValueString = AnonymousValueString {
        anonymous_value_string_len: 0,
        anonymous_value_string_format: anonymous_value_string_format,
        container_type: container_type
    };
    AnonymousValueString::fill_value(&mut value, text, start, end);
    value
}

// Copies text[start..end] into the inline buffer, clamped at the bound, and
// records the stored length — the same shape ProcessInfo::set_name uses.
machine AnonymousValueString::fill_value(this: &mut AnonymousValueString, text: &[u8], start: u64, end: u64) {
    transition { _ -> copy(this, text, start, end, 0) }
    state copy(this: &mut AnonymousValueString, text: &[u8], at: u64, end: u64, position: u64) {
        transition at < end && at < text.len && position < 4096 {
            true -> store(this, text, at, end, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut AnonymousValueString, text: &[u8], at: u64, end: u64, position: u64) {
        this.anonymous_value_string[position] = text[at];
        transition { _ -> copy(this, text, at + 1, end, position + 1) }
    }
    state finish(this: &mut AnonymousValueString, count: u64) {
        this.anonymous_value_string_len = count;
    }
}

// Upstream `get_anonymous_value_string` returns `&str`; a borrowed view of
// the inline buffer is not retainable here, so the byte-domain read is
// length + explicit copy-out into a bound-sized buffer.
// Derived `Clone` parity for moving parsed constraint operands by value.
pub machine AnonymousValueString::clone(source: &AnonymousValueString) -> AnonymousValueString {
    // A union-typed local bound from a call does not rejoin as a `new` call
    // argument on this toolchain level, so the fresh value is built as the
    // same record literal `new` constructs, then `clone_from` fills it.
    let format: AnonymousValueStringFormat = AnonymousValueString::get_anonymous_value_string_format(&source);
    let container: ContainerType = AnonymousValueString::get_container_type(&source);
    let mut value: AnonymousValueString = AnonymousValueString {
        anonymous_value_string_len: 0,
        anonymous_value_string_format: format,
        container_type: container
    };
    AnonymousValueString::clone_from(&mut value, source);
    value
}

pub machine AnonymousValueString::clone_from(this: &mut AnonymousValueString, source: &AnonymousValueString) {
    this.anonymous_value_string_len = source.anonymous_value_string_len;
    this.anonymous_value_string_format = source.anonymous_value_string_format;
    this.container_type = source.container_type;
    AnonymousValueString::copy_bytes(&mut this, source, 0);
}

machine AnonymousValueString::copy_bytes(this: &mut AnonymousValueString, source: &AnonymousValueString, position: u64) {
    transition { _ -> loop_head(this, source, position) }
    state loop_head(this: &mut AnonymousValueString, source: &AnonymousValueString, position: u64) {
        transition position < source.anonymous_value_string_len && position < 4096 {
            true -> copy(this, source, position)
            false -> done(this)
        }
    }
    state copy(this: &mut AnonymousValueString, source: &AnonymousValueString, position: u64) {
        this.anonymous_value_string[position] = source.anonymous_value_string[position];
        transition { _ -> loop_head(this, source, position + 1) }
    }
    state done(this: &mut AnonymousValueString) {
        this.anonymous_value_string_len = this.anonymous_value_string_len;
    }
}

pub machine AnonymousValueString::get_anonymous_value_string_len(this: &AnonymousValueString) -> u64 {
    this.anonymous_value_string_len
}

// Byte-domain read without borrow: callers outside the package page the
// stored operand text byte by byte (`copy_anonymous_value_string` keeps the
// bulk copy-out; its `&mut` out-buffer does not cross packages under
// selected entry establishment).
pub machine AnonymousValueString::get_anonymous_value_string_byte(this: &AnonymousValueString, position: u64) -> u8 {
    transition position < this.anonymous_value_string_len && position < 4096 {
        true -> (this.anonymous_value_string[position])
        false -> (0)
    }
}

// Copies the stored value into `out` and returns the byte count written —
// all-or-nothing: when the stored length does not fit `out` nothing is
// written and 0 is returned, never a truncated value.
pub machine AnonymousValueString::copy_anonymous_value_string(this: &AnonymousValueString, out: &mut [u8; 4096]) -> u64 {
    transition this.anonymous_value_string_len <= 4096 {
        true -> copy(this, out, 0)
        false -> (0)
    }
    state copy(this: &AnonymousValueString, out: &mut [u8; 4096], position: u64) -> u64 {
        transition position < this.anonymous_value_string_len && position < 4096 {
            true -> store(this, out, position)
            false -> done(this, position)
        }
    }
    state store(this: &AnonymousValueString, out: &mut [u8; 4096], position: u64) -> u64 {
        out[position] = this.anonymous_value_string[position];
        transition { _ -> copy(this, out, position + 1) }
    }
    state done(this: &AnonymousValueString, position: u64) -> u64 {
        transition position == this.anonymous_value_string_len {
            true -> (position)
            false -> (0)
        }
    }
}

pub machine AnonymousValueString::get_anonymous_value_string_format(this: &AnonymousValueString) -> AnonymousValueStringFormat {
    this.anonymous_value_string_format
}

pub machine AnonymousValueString::set_anonymous_value_string_format(
    this: &mut AnonymousValueString,
    new_format: AnonymousValueStringFormat
) {
    this.anonymous_value_string_format = new_format;
}

pub machine AnonymousValueString::get_container_type(this: &AnonymousValueString) -> ContainerType {
    this.container_type
}

pub machine AnonymousValueString::set_container_type(this: &mut AnonymousValueString, new_container_type: ContainerType) {
    this.container_type = new_container_type;
}

// Upstream `FromStr`: `string.rsplitn(3, ';')` must yield exactly 3 parts —
// the container spelling after the last ';', the format spelling before it,
// and the value text before that (which may itself contain ';'). One forward
// pass records the two rightmost separators. A value longer than the inline
// bound refuses rather than truncating (named deviation: upstream stores the
// full String).
pub machine AnonymousValueString::from_str(text: &[u8]) -> Optional<AnonymousValueString> {
    transition { _ -> wrap(AnonymousValueString::parse(text)) }
    state wrap(result: AnonymousValueStringParse) -> Optional<AnonymousValueString> {
        transition result {
            AnonymousValueStringParse::Parsed { value } -> (Optional::Some { value: value })
            AnonymousValueStringParse::Refused -> (Optional::None)
        }
    }
}

pub machine AnonymousValueString::parse(text: &[u8]) -> AnonymousValueStringParse {
    transition { _ -> scan(text, 0, text.len, 0, 0, 0) }
    // `separators` saturates at 2 — only "at least two" matters downstream —
    // while `second`/`first` keep the two rightmost ';' indices.
    state scan(text: &[u8], at: u64, end: u64, separators: u64, second: u64, first: u64) -> AnonymousValueStringParse {
        transition at < end && at < text.len {
            true -> probe(text, at, end, separators, second, first, text[at])
            false -> split(text, end, separators, second, first)
        }
    }
    // ';' (byte 59) shifts the two rightmost separator registers.
    state probe(text: &[u8], at: u64, end: u64, separators: u64, second: u64, first: u64, byte: u8) -> AnonymousValueStringParse {
        transition byte == 59 {
            true -> bump(text, at, end, separators, first)
            false -> scan(text, at + 1, end, separators, second, first)
        }
    }
    state bump(text: &[u8], at: u64, end: u64, separators: u64, first: u64) -> AnonymousValueStringParse {
        transition separators < 2 {
            true -> scan(text, at + 1, end, separators + 1, first, at)
            false -> scan(text, at + 1, end, separators, first, at)
        }
    }
    // Exactly-3-parts: two separators found, a nonempty format segment
    // (second < first), a nonempty container segment (first < end), and the
    // value inside the bound.
    state split(text: &[u8], end: u64, separators: u64, second: u64, first: u64) -> AnonymousValueStringParse {
        transition separators >= 2 && second <= 4096 && second < first && first < end {
            true -> parts(text, end, second, first)
            false -> (AnonymousValueStringParse::Refused)
        }
    }
    // value = text[..second]; format = text[second+1..first];
    // container = text[first+1..end] — the format and container windows may
    // be empty: an empty format refuses, an empty container parses to None.
    state parts(text: &[u8], end: u64, second: u64, first: u64) -> AnonymousValueStringParse {
        transition second <= 4096 && second < first && first < end {
            true -> split_parts(text, second, first, end)
            false -> (AnonymousValueStringParse::Refused)
        }
    }
    // Each segment parse runs in sequence: a borrowed slice cannot be passed
    // onward in the same statement that also calls through it.
    state split_parts(text: &[u8], second: u64, first: u64, end: u64) -> AnonymousValueStringParse {
        let format: AnonymousValueStringFormatParse =
            AnonymousValueStringFormat::from_str_window(text, second + 1, first);
        let container: ContainerTypeParse =
            ContainerType::from_str_window(text, first + 1, end);
        transition { _ -> with_parts(text, second, format, container) }
    }
    state with_parts(text: &[u8], second: u64,
                     format: AnonymousValueStringFormatParse,
                     container: ContainerTypeParse) -> AnonymousValueStringParse {
        transition format {
            AnonymousValueStringFormatParse::Parsed { value } -> with_container(text, second, value, container)
            AnonymousValueStringFormatParse::Refused -> (AnonymousValueStringParse::Refused)
        }
    }
    state with_container(text: &[u8], second: u64,
                         format: AnonymousValueStringFormat,
                         container: ContainerTypeParse) -> AnonymousValueStringParse {
        transition container {
            ContainerTypeParse::Parsed { value } -> build(text, second, format, value)
            ContainerTypeParse::Refused -> (AnonymousValueStringParse::Refused)
        }
    }
    state build(text: &[u8], second: u64,
                format: AnonymousValueStringFormat,
                container: ContainerType) -> AnonymousValueStringParse {
        let mut parsed: AnonymousValueString = AnonymousValueString {
            anonymous_value_string_len: 0,
            anonymous_value_string_format: format,
            container_type: container
        };
        AnonymousValueString::fill_value(&mut parsed, text, 0, second);
        AnonymousValueStringParse::Parsed { value: parsed }
    }
}

// In-package exercise: the triple form, a value containing an inner ';',
// and the refusal shapes (missing separators, unknown format, bad
// container) — kept in-package because Optional is not matchable across the
// package boundary in this pin.
pub machine AnonymousValueString::from_str_consistent() -> bool {
    // Prover-cost bound (named deviation): each parse call site is
    // re-verified, so the exercise is capped at one full triple.
    // Upstream accepts arbitrary values/formats/containers.
    let full: AnonymousValueStringParse = AnonymousValueString::parse("1234;dec;*(u64)[8]");
    let hoist2: bool = holds(full, 4, 64);
    (hoist2)
}

// The parsed triple kept its value text length and the container reports the
// upstream unit total (`*(u64)[8]` -> 64, `[]` and `None` -> the unit).
machine holds(result: AnonymousValueStringParse, value_len: u64, total: u64) -> bool {
    transition result {
        AnonymousValueStringParse::Parsed { value } -> at_parsed(result, value, value_len, total)
        AnonymousValueStringParse::Refused -> (false)
    }
    state at_parsed(result: AnonymousValueStringParse, value: AnonymousValueString, value_len: u64, total: u64) -> bool {
        let len: u64 = AnonymousValueString::get_anonymous_value_string_len(&value);
        let container: ContainerType = AnonymousValueString::get_container_type(&value);
        let size: u64 = ContainerType::get_total_size_in_bytes(&container, 1);
        (len == value_len && size == total)
    }
}

// Upstream `DataValue::new_from_string`-equivalent for the u64 leg: parses
// the stored operand as `0x`/`0X` hex or decimal — the two spellings
// upstream `u64::from_str_radix`/`str::parse` accept for scan values.
// Overflow wraps (the upstream clamp saturates into the data type — for u64
// the whole range is representable, so a wrap never happens in practice; a
// Wrapping accumulate keeps the arithmetic domain honest either way).
// [copy] record carrier — a union-typed local cannot serve as a
// transition scrutinee on this toolchain level.
pub data U64ValueParse [copy] {
    ok: bool;
    value: u64;
}

pub machine AnonymousValueString::parse_u64(this: &AnonymousValueString) -> U64ValueParse {
    transition this.anonymous_value_string_len == 0 {
        true -> (U64ValueParse { ok: false, value: 0 })
        false -> prefix(this)
    }
    state prefix(this: &AnonymousValueString) -> U64ValueParse {
        let has_hex: bool = this.anonymous_value_string_len > 2
            && this.anonymous_value_string[0] == 48
            && (this.anonymous_value_string[1] == 120 || this.anonymous_value_string[1] == 88);
        transition has_hex {
            true -> scan(this, 2, 0, 16)
            false -> scan(this, 0, 0, 10)
        }
    }
    state scan(this: &AnonymousValueString, position: u64, acc: u64, radix: u64) -> U64ValueParse {
        transition position < this.anonymous_value_string_len && position < 4096 {
            true -> digit(this, position, acc, radix)
            false -> (U64ValueParse { ok: true, value: acc })
        }
    }
    state digit(this: &AnonymousValueString, position: u64, acc: u64, radix: u64) -> U64ValueParse
        requires 0 <= position && position < 4096
    {
        let byte: u8 = this.anonymous_value_string[position];
        transition byte >= 48 && byte <= 57 {
            true -> merge(this, position, acc, radix, ((byte as u64 in Wrapping) - 48) as u64)
            false -> alpha(this, byte, position, acc, radix)
            _ -> (U64ValueParse { ok: false, value: 0 })
        }
    }
    state alpha(this: &AnonymousValueString, byte: u8, position: u64, acc: u64, radix: u64) -> U64ValueParse {
        transition radix == 16 && byte >= 97 && byte <= 102 {
            true -> merge(this, position, acc, radix, ((byte as u64 in Wrapping) - 87) as u64)
            false -> upper(this, byte, position, acc, radix)
            _ -> (U64ValueParse { ok: false, value: 0 })
        }
    }
    state upper(this: &AnonymousValueString, byte: u8, position: u64, acc: u64, radix: u64) -> U64ValueParse {
        transition radix == 16 && byte >= 65 && byte <= 70 {
            true -> merge(this, position, acc, radix, ((byte as u64 in Wrapping) - 55) as u64)
            false -> (U64ValueParse { ok: false, value: 0 })
            _ -> (U64ValueParse { ok: false, value: 0 })
        }
    }
    state merge(this: &AnonymousValueString, position: u64, acc: u64, radix: u64, digit_value: u64) -> U64ValueParse {
        transition digit_value < radix {
            true -> next(this, position, acc, radix, digit_value)
            false -> (U64ValueParse { ok: false, value: 0 })
        }
    }
    state next(this: &AnonymousValueString, position: u64, acc: u64, radix: u64, digit_value: u64) -> U64ValueParse {
        let next_acc: u64 = (((acc as u64 in Wrapping) * (radix as u64 in Wrapping))
            + (digit_value as u64 in Wrapping)) as u64;
        transition { _ -> scan(this, position + 1, next_acc, radix) }
    }
}

// Upstream derived PartialEq — string bytes + format + container type.
pub machine AnonymousValueString::equals(this: &AnonymousValueString, other: &AnonymousValueString) -> bool {
    let len_equal: bool = this.anonymous_value_string_len == other.anonymous_value_string_len;
    let format_equal: bool = AnonymousValueStringFormat::equals(&this.anonymous_value_string_format, &other.anonymous_value_string_format);
    let container_equal: bool = ContainerType::equals(&this.container_type, &other.container_type);
    transition len_equal && format_equal && container_equal {
        true -> scan(this, other, 0)
        false -> (false)
        _ -> (false)
    }
    state scan(this: &AnonymousValueString, other: &AnonymousValueString, position: u64) -> bool {
        transition position < this.anonymous_value_string_len && position < 4096 {
            true -> compare(this, other, position)
            false -> (true)
        }
    }
    state compare(this: &AnonymousValueString, other: &AnonymousValueString, position: u64) -> bool
        requires 0 <= position && position < 4096
    {
        transition this.anonymous_value_string[position] == other.anonymous_value_string[position] {
            true -> scan(this, other, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> (false)
            _ -> (false)
        }
    }
}
