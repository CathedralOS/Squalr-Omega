module src::structures::data_values::pointer_scan_pointer_size;

use src::structures::memory::endian::Endian;

// Port of PointerScanPointerSize. Upstream also maps each variant to a
// big-endian pointer data type (`get_pointer_data_type`) which requires the
// built-in pointer data types — deferred to the pointer-scan leg along with
// `get_endian`'s callers.
pub data PointerScanPointerSize [copy] {
    case Pointer24;
    case Pointer24be;
    case Pointer32;
    case Pointer32be;
    case Pointer64;
    case Pointer64be;
}

pub machine PointerScanPointerSize::get_size_in_bytes(&self) -> u64 {
    transition self {
        PointerScanPointerSize::Pointer24 -> (3)
        PointerScanPointerSize::Pointer24be -> (3)
        PointerScanPointerSize::Pointer32 -> (4)
        PointerScanPointerSize::Pointer32be -> (4)
        PointerScanPointerSize::Pointer64 -> (8)
        PointerScanPointerSize::Pointer64be -> (8)
        _ -> (8)
    }
}

pub machine PointerScanPointerSize::get_endian(&self) -> Endian {
    transition self {
        PointerScanPointerSize::Pointer24 -> (Endian::Little)
        PointerScanPointerSize::Pointer24be -> (Endian::Big)
        PointerScanPointerSize::Pointer32 -> (Endian::Little)
        PointerScanPointerSize::Pointer32be -> (Endian::Big)
        PointerScanPointerSize::Pointer64 -> (Endian::Little)
        PointerScanPointerSize::Pointer64be -> (Endian::Big)
        _ -> (Endian::Little)
    }
}
