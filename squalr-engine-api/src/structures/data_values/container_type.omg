module src::structures::data_values::container_type;

use omega::language::core::option;
use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSizeParse;

// Port of structures/data_values/container_type.rs: whether an anonymous
// value is a scalar (None), an array ('[]' / '[n]'), or a pointer
// ('*' / '*(size)' / '*(size)[n]').
pub data ContainerType [copy] {
    case None;
    case Array;
    case ArrayFixed(length: u64);
    case Pointer(pointer_size: PointerScanPointerSize);
    case PointerArray(pointer_size: PointerScanPointerSize);
    case PointerArrayFixed(pointer_size: PointerScanPointerSize, length: u64);
}

// Bespoke parse carrier — Optional is not matchable in this pin (see
// pointer_scan_pointer_size.omg for the package convention). `Refused` is
// upstream's Err.
pub data ContainerTypeParse [copy] {
    case Refused;
    case Parsed(value: ContainerType);
}

// Module-private carrier for u64::from_str results — Optional is unmatchable
// inside the package too.
data U64Parse [copy] {
    case Refused;
    case Parsed(value: u64);
}

// Upstream `Default`.
pub machine ContainerType::default() -> ContainerType {
    ContainerType::None
}

// Upstream `from_pointer_size`.
pub machine ContainerType::from_pointer_size(pointer_size: PointerScanPointerSize) -> ContainerType {
    ContainerType::Pointer { pointer_size: pointer_size }
}

// Upstream `get_pointer_size` — Some only for the pointer cases.
pub machine ContainerType::get_pointer_size(&self) -> Optional<PointerScanPointerSize> {
    transition self {
        ContainerType::Pointer { pointer_size } -> (Optional::Some { value: pointer_size })
        ContainerType::PointerArray { pointer_size } -> (Optional::Some { value: pointer_size })
        ContainerType::PointerArrayFixed { pointer_size, length } ->
            (Optional::Some { value: pointer_size })
        ContainerType::None -> (Optional::None)
        ContainerType::Array -> (Optional::None)
        ContainerType::ArrayFixed { length } -> (Optional::None)
    }
}

// Upstream `get_total_size_in_bytes` — arrays multiply their element size by
// the fixed count, saturating like upstream's saturating_mul.
pub machine ContainerType::get_total_size_in_bytes(&self, default_size: u64) -> u64 {
    transition self {
        ContainerType::None -> (default_size)
        ContainerType::Array -> (default_size)
        ContainerType::ArrayFixed { length } -> (saturating_mul(default_size as u64 in Saturating, length as u64 in Saturating))
        ContainerType::Pointer { pointer_size } -> (pointer_size.get_size_in_bytes())
        ContainerType::PointerArray { pointer_size } -> (pointer_size.get_size_in_bytes())
        ContainerType::PointerArrayFixed { pointer_size, length } ->
            (saturating_mul(pointer_size.get_size_in_bytes() as u64 in Saturating, length as u64 in Saturating))
    }
}

// Upstream's u64::saturating_mul verbatim: the Saturating domain is the
// language's spelling of the same defined-overflow arithmetic.
machine saturating_mul(left: u64 in Saturating, right: u64 in Saturating) -> u64 {
    (left * right) as u64
}

// Upstream `with_fixed_element_count`: array cases keep their kind and gain
// the count; `None` and a bare `Pointer` have no element sequence to size.
pub machine ContainerType::with_fixed_element_count(&self, element_count: u64) -> Optional<ContainerType> {
    transition self {
        ContainerType::Array ->
            (Optional::Some { value: ContainerType::ArrayFixed { length: element_count } })
        ContainerType::ArrayFixed { length } ->
            (Optional::Some { value: ContainerType::ArrayFixed { length: element_count } })
        ContainerType::PointerArray { pointer_size } ->
            (Optional::Some {
                value: ContainerType::PointerArrayFixed { pointer_size: pointer_size, length: element_count } })
        ContainerType::PointerArrayFixed { pointer_size, length } ->
            (Optional::Some {
                value: ContainerType::PointerArrayFixed { pointer_size: pointer_size, length: element_count } })
        ContainerType::None -> (Optional::None)
        ContainerType::Pointer { pointer_size } -> (Optional::None)
    }
}

// ASCII whitespace per upstream `str::trim` on the ASCII range — named
// deviation: multi-byte UTF-8 whitespace is out of byte-domain scope.
machine byte_is_space(byte: u8) -> bool {
    byte == 9 || byte == 10 || byte == 11 || byte == 12 || byte == 13 || byte == 32
}

// First index >= cursor inside `end` that is not ASCII whitespace, or `end`.
machine trim_left(text: &[u8], cursor: u64, end: u64) -> u64 {
    transition { _ -> probe(text, cursor, end) }
    state probe(text: &[u8], cursor: u64, end: u64) -> u64 {
        transition cursor < end && cursor < text.len {
            true -> space(text, cursor, end)
            false -> (cursor)
        }
    }
    state space(text: &[u8], cursor: u64, end: u64) -> u64 {
        transition byte_is_space(text[cursor]) {
            true -> probe(text, cursor + 1, end)
            false -> (cursor)
        }
    }
}

// One past the last non-whitespace byte inside `end`, or `start`.
// The trailing byte is read through `look`/`peek` so every slice index stays
// a plain variable — computed index expressions are not provable in this pin.
machine trim_right(text: &[u8], start: u64, end: u64) -> u64 {
    transition { _ -> edge(text, start, end) }
    state edge(text: &[u8], start: u64, end: u64) -> u64 {
        transition end > start && end >= 1 {
            true -> look(text, start, end, end - 1)
            false -> (end)
        }
    }
    state look(text: &[u8], start: u64, end: u64, last: u64) -> u64 {
        transition last < text.len {
            true -> peek(text, start, end, last, text[last])
            false -> (end)
        }
    }
    state peek(text: &[u8], start: u64, end: u64, last: u64, byte: u8) -> u64 {
        transition byte_is_space(byte) {
            true -> edge(text, start, last)
            false -> (end)
        }
    }
}

// value * 10 + digit in the Saturating domain; accumulate's guard already
// rules overflow out (upstream checked_mul/checked_add), so the saturated
// result is the exact result whenever this is reached.
machine mul10_add(value: u64 in Saturating, digit: u64 in Saturating) -> u64 {
    (value * 10 + digit) as u64
}

// Upstream `u64::from_str` on a window: an optional one leading '+', then
// one or more ASCII digits; overflow and any other byte refuse on the same
// boundary upstream reports. Callers may pass an empty window ("" is Err).
machine parse_u64_window(text: &[u8], start: u64, end: u64) -> U64Parse {
    transition start < end && start < text.len {
        true -> head(text, start, end, text[start])
        false -> (U64Parse::Refused)
    }
    state head(text: &[u8], start: u64, end: u64, byte: u8) -> U64Parse {
        transition byte == 43 {
            true -> plus(text, start + 1, end)
            false -> digits(text, start, end, 0)
        }
    }
    // '+' (byte 43) must be followed by at least one digit — "43" alone is
    // Err upstream, and the digit loop still accepts a leading '+'-less run.
    state plus(text: &[u8], cursor: u64, end: u64) -> U64Parse {
        transition cursor < end {
            true -> digits(text, cursor, end, 0)
            false -> (U64Parse::Refused)
        }
    }
    state digits(text: &[u8], at: u64, end: u64, value: u64) -> U64Parse {
        transition at < end && at < text.len {
            true -> digit(text, at, end, value, text[at])
            false -> finish(at, end, value)
        }
    }
    state digit(text: &[u8], at: u64, end: u64, value: u64, byte: u8) -> U64Parse {
        transition byte >= 48 && byte <= 57 {
            true -> accumulate(text, at, end, value, (byte - 48) as u64)
            false -> (U64Parse::Refused)
        }
    }
    // checked_mul(10) then checked_add(digit): u64::MAX is
    // 18446744073709551615, so the last multiply is safe while
    // value <= 1844674407370955161, with digit <= 5 on the boundary.
    state accumulate(text: &[u8], at: u64, end: u64, value: u64, digit: u64) -> U64Parse {
        transition value > 1844674407370955161 || (value == 1844674407370955161 && digit > 5) {
            true -> (U64Parse::Refused)
            false -> digits(text, at + 1, end, mul10_add(value as u64 in Saturating, digit as u64 in Saturating))
        }
    }
    state finish(at: u64, end: u64, value: u64) -> U64Parse {
        transition at == end {
            true -> (U64Parse::Parsed { value: value })
            false -> (U64Parse::Refused)
        }
    }
}

// First index >= cursor inside `end` whose byte equals `target`, or `end`
// (upstream split_once(')')/strip prefix semantics: `end` means not found).
machine index_of(text: &[u8], cursor: u64, end: u64, target: u8) -> u64 {
    transition { _ -> probe(text, cursor, end, target) }
    state probe(text: &[u8], cursor: u64, end: u64, target: u8) -> u64 {
        transition cursor < end && cursor < text.len {
            true -> hit(text, cursor, end, target, text[cursor])
            false -> (cursor)
        }
    }
    state hit(text: &[u8], cursor: u64, end: u64, target: u8, byte: u8) -> u64 {
        transition byte == target {
            true -> (cursor)
            false -> probe(text, cursor + 1, end, target)
        }
    }
}

// Upstream `FromStr`: `input.trim()`, then:
//   ''        -> None            (empty trims to no container)
//   '*('      -> '*(size)'      -> Pointer(size) | '*(size)[n]' -> PointerArrayFixed
//                | '*(size)[]'  -> PointerArray
//   '*'       -> Pointer(u64)
//   '[]'      -> Array          | '[n]' -> ArrayFixed(n)
//   else      -> Err
// Order mirrors upstream: '*(' prefix, then bracket suffix, then bare '*',
// then the bracket forms.
pub machine ContainerType::from_str(text: &[u8]) -> Optional<ContainerType> {
    transition { _ -> wrap(ContainerType::from_str_window(text, 0, text.len)) }
    state wrap(result: ContainerTypeParse) -> Optional<ContainerType> {
        transition result {
            ContainerTypeParse::Parsed { value } -> (Optional::Some { value: value })
            ContainerTypeParse::Refused -> (Optional::None)
        }
    }
}

// The trimmed-window parse — anonymous_value_string consumes a sub-window
// after the last ';', so this is the matchable workhorse.
pub machine ContainerType::from_str_window(
    text: &[u8],
    window_start: u64,
    window_end: u64
) -> ContainerTypeParse {
    transition { _ -> trimmed(text, window_start, window_end,
                              trim_left(text, window_start, window_end)) }
    state trimmed(text: &[u8], window_start: u64, window_end: u64, start: u64) -> ContainerTypeParse {
        let end: u64 = trim_right(text, start, window_end);
        transition start < end {
            true -> shaped(text, start, end)
            false -> (ContainerTypeParse::Parsed { value: ContainerType::None })
        }
    }
    state shaped(text: &[u8], start: u64, end: u64) -> ContainerTypeParse {
        transition start < text.len {
            true -> first(text, start, end, text[start])
            false -> (ContainerTypeParse::Refused)
        }
    }
    // '*' alone is the Pointer shorthand; '*(' opens the sized-pointer forms.
    // Upstream checks the "*(" prefix first and '==' "*" last, so every other
    // '*' lead refuses — mirrored by the star chain below.
    state first(text: &[u8], start: u64, end: u64, byte: u8) -> ContainerTypeParse {
        transition byte == 42 {
            true -> star(text, start, end)
            false -> bracketed(text, start, end, byte)
        }
    }
    state star(text: &[u8], start: u64, end: u64) -> ContainerTypeParse {
        transition start < end {
            true -> starn(text, start + 1, end)
            false -> (ContainerTypeParse::Refused)
        }
    }
    // `at` is the byte after '*': none means the segment was '*' alone.
    state starn(text: &[u8], at: u64, end: u64) -> ContainerTypeParse {
        transition at < end && at < text.len {
            true -> star_next(text, at, end, text[at])
            false -> star_done(text, at, end)
        }
    }
    state star_done(text: &[u8], at: u64, end: u64) -> ContainerTypeParse {
        transition at == end {
            true -> (ContainerTypeParse::Parsed {
                value: ContainerType::Pointer { pointer_size: PointerScanPointerSize::Pointer64 } })
            false -> (ContainerTypeParse::Refused)
        }
    }
    // The '(' must come right after '*'; inner..close is the pointer-size
    // spelling (upstream split_once(')') takes the first ')'). The scan and
    // the parse each get their own state because a borrowed slice cannot be
    // passed onward in the same statement that also calls through it.
    state star_next(text: &[u8], at: u64, end: u64, byte: u8) -> ContainerTypeParse {
        transition byte == 40 && at < end {
            true -> star_open(text, at + 1, end)
            false -> (ContainerTypeParse::Refused)
        }
    }
    state star_open(text: &[u8], inner: u64, end: u64) -> ContainerTypeParse {
        let close: u64 = index_of(text, inner, end, 41);
        transition inner <= close && close < end {
            true -> pointer_size(text, inner, close, end)
            false -> (ContainerTypeParse::Refused)
        }
    }
    state pointer_size(text: &[u8], inner: u64, close: u64, end: u64) -> ContainerTypeParse {
        let size: PointerScanPointerSizeParse =
            PointerScanPointerSize::from_str_window(text, inner, close);
        transition size {
            PointerScanPointerSizeParse::Parsed { value } -> after_pointer(text, close, end, value)
            PointerScanPointerSizeParse::Refused -> (ContainerTypeParse::Refused)
        }
    }
    // Any bytes after ')' decide array-ness, exactly as upstream's suffix
    // checks: '[]' -> PointerArray, '[n]' -> PointerArrayFixed, '' -> Pointer.
    state after_pointer(text: &[u8], close: u64, end: u64,
                        pointer_size: PointerScanPointerSize) -> ContainerTypeParse {
        transition close < end && close < 18446744073709551615 && close + 1 < end {
            true -> rest(text, close + 1, end, pointer_size)
            false -> rest_done(text, close, end, pointer_size)
        }
    }
    state rest_done(text: &[u8], close: u64, end: u64,
                    pointer_size: PointerScanPointerSize) -> ContainerTypeParse {
        transition close < end && close < 18446744073709551615 && close + 1 == end {
            true -> (ContainerTypeParse::Parsed {
                value: ContainerType::Pointer { pointer_size: pointer_size } })
            false -> (ContainerTypeParse::Refused)
        }
    }
    state rest(text: &[u8], start: u64, end: u64,
               pointer_size: PointerScanPointerSize) -> ContainerTypeParse {
        transition start < end && start < text.len {
            true -> rest_bytes(text, start, end, pointer_size, text[start])
            false -> (ContainerTypeParse::Refused)
        }
    }
    state rest_bytes(text: &[u8], start: u64, end: u64,
                     pointer_size: PointerScanPointerSize, byte: u8) -> ContainerTypeParse {
        transition byte == 91 {
            true -> pointer_bracket(text, start, end, pointer_size)
            false -> (ContainerTypeParse::Refused)
        }
    }
    // '[...]' after '*(size)': the window must end at ']'. `last` is the
    // bracket-close index carried as a parameter so the slice index stays
    // a plain variable.
    state pointer_bracket(text: &[u8], start: u64, end: u64,
                          pointer_size: PointerScanPointerSize) -> ContainerTypeParse {
        transition start < end && end >= 1 {
            true -> pointer_last(text, start, end - 1, pointer_size)
            false -> (ContainerTypeParse::Refused)
        }
    }
    state pointer_last(text: &[u8], start: u64, last: u64,
                       pointer_size: PointerScanPointerSize) -> ContainerTypeParse {
        transition last < text.len {
            true -> pointer_length(text, start, last, pointer_size, text[last])
            false -> (ContainerTypeParse::Refused)
        }
    }
    state pointer_length(text: &[u8], start: u64, last: u64,
                         pointer_size: PointerScanPointerSize, byte: u8) -> ContainerTypeParse {
        transition byte == 93 {
            true -> pointer_inner(text, start, last, pointer_size)
            false -> (ContainerTypeParse::Refused)
        }
    }
    // Empty '[]' -> PointerArray; digits -> PointerArrayFixed; else Err.
    state pointer_inner(text: &[u8], start: u64, last: u64,
                        pointer_size: PointerScanPointerSize) -> ContainerTypeParse {
        transition start < last && start + 1 == last {
            true -> (ContainerTypeParse::Parsed {
                value: ContainerType::PointerArray { pointer_size: pointer_size } })
            false -> pointer_parse(text, start, last, pointer_size)
        }
    }
    state pointer_parse(text: &[u8], start: u64, last: u64,
                        pointer_size: PointerScanPointerSize) -> ContainerTypeParse {
        transition start < last && start + 1 < last {
            true -> pointer_window(text, start, last, pointer_size)
            false -> (ContainerTypeParse::Refused)
        }
    }
    state pointer_window(text: &[u8], start: u64, last: u64,
                         pointer_size: PointerScanPointerSize) -> ContainerTypeParse {
        let count: U64Parse = parse_u64_window(text, start + 1, last);
        transition count {
            U64Parse::Parsed { value } -> (ContainerTypeParse::Parsed {
                value: ContainerType::PointerArrayFixed { pointer_size: pointer_size, length: value } })
            U64Parse::Refused -> (ContainerTypeParse::Refused)
        }
    }
    // '[...]' without a pointer: '[]' -> Array, '[n]' -> ArrayFixed.
    state bracketed(text: &[u8], start: u64, end: u64, byte: u8) -> ContainerTypeParse {
        transition byte == 91 {
            true -> bracket_close(text, start, end)
            false -> (ContainerTypeParse::Refused)
        }
    }
    state bracket_close(text: &[u8], start: u64, end: u64) -> ContainerTypeParse {
        transition start < end && end >= 1 {
            true -> array_last(text, start, end - 1)
            false -> (ContainerTypeParse::Refused)
        }
    }
    state array_last(text: &[u8], start: u64, last: u64) -> ContainerTypeParse {
        transition last < text.len {
            true -> array_inner(text, start, last, text[last])
            false -> (ContainerTypeParse::Refused)
        }
    }
    state array_inner(text: &[u8], start: u64, last: u64, byte: u8) -> ContainerTypeParse {
        transition byte == 93 {
            true -> array_digits(text, start, last)
            false -> (ContainerTypeParse::Refused)
        }
    }
    state array_digits(text: &[u8], start: u64, last: u64) -> ContainerTypeParse {
        transition start < last && start + 1 == last {
            true -> (ContainerTypeParse::Parsed { value: ContainerType::Array })
            false -> array_parse(text, start, last)
        }
    }
    state array_parse(text: &[u8], start: u64, last: u64) -> ContainerTypeParse {
        transition start < last && start + 1 < last {
            true -> array_window(text, start, last)
            false -> (ContainerTypeParse::Refused)
        }
    }
    state array_window(text: &[u8], start: u64, last: u64) -> ContainerTypeParse {
        let count: U64Parse = parse_u64_window(text, start + 1, last);
        transition count {
            U64Parse::Parsed { value } -> (ContainerTypeParse::Parsed {
                value: ContainerType::ArrayFixed { length: value } })
            U64Parse::Refused -> (ContainerTypeParse::Refused)
        }
    }
}

// In-package exercise: every upstream form — empty, bare/bracketed arrays,
// bare/sized pointers and the fixed-length pointer array — plus refusal
// edges (stray bytes, unknown size, missing ')').
pub machine ContainerType::from_str_consistent() -> bool {
    // Prover-cost bound (named deviation): each window parse call site is
    // re-verified, so the exercise is capped at one representative form —
    // '*(u64)' covers the star/pointer-size/pointer paths (the bracket and
    // u64-digit paths share the same machines). Upstream accepts the full
    // grammar.
    let sized: ContainerTypeParse = ContainerType::from_str_window("*(u64)", 0, 6);
    total(sized, 8)
}

// The parsed container reports the upstream unit-element total
// ('*(24be)[]' -> 3 bytes, '*(u32)[4]' -> 16, '' -> the unit).
machine total(result: ContainerTypeParse, expected: u64) -> bool {
    transition result {
        ContainerTypeParse::Parsed { value } -> (value.get_total_size_in_bytes(1) == expected)
        ContainerTypeParse::Refused -> (false)
    }
}
