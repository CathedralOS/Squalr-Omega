module src::structures::data_values::container_type;

use omega::language::core::option;
use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;

// Port of ContainerType. Six variants matching upstream: scalar results are
// None, array results carry an element count, pointer results carry the
// pointer-size descriptor used by the pointer-scan legs.
pub data ContainerType [copy] {
    case None;
    case Array;
    case ArrayFixed(array_length: u64);
    case Pointer(pointer_size: PointerScanPointerSize);
    case PointerArray(pointer_size: PointerScanPointerSize);
    case PointerArrayFixed(pointer_size: PointerScanPointerSize, array_length: u64);
}

pub machine ContainerType::from_pointer_size(pointer_size: PointerScanPointerSize) -> ContainerType {
    (ContainerType::Pointer {
        pointer_size: pointer_size,
    })
}

pub machine ContainerType::get_pointer_size(&self) -> Optional<PointerScanPointerSize> {
    transition self {
        ContainerType::Pointer { pointer_size } -> (Optional::Some { value: pointer_size })
        ContainerType::None -> (Optional::None)
        ContainerType::Array -> (Optional::None)
        ContainerType::ArrayFixed { array_length } -> (Optional::None)
        ContainerType::PointerArray { pointer_size } -> (Optional::None)
        ContainerType::PointerArrayFixed { pointer_size, array_length } -> (Optional::None)
        _ -> (Optional::None)
    }
}

pub machine ContainerType::get_total_size_in_bytes(&self, unit_size_in_bytes: u64) -> u64 {
    transition self {
        ContainerType::None -> (unit_size_in_bytes)
        ContainerType::Array -> (unit_size_in_bytes)
        ContainerType::ArrayFixed { array_length } -> scaled(unit_size_in_bytes, array_length)
        ContainerType::Pointer { pointer_size } -> (pointer_size.get_size_in_bytes())
        ContainerType::PointerArray { pointer_size } -> (pointer_size.get_size_in_bytes())
        ContainerType::PointerArrayFixed { pointer_size, array_length } ->
            scaled(pointer_size.get_size_in_bytes(), array_length)
        _ -> (unit_size_in_bytes)
    }
    state scaled(&self, unit_size_in_bytes: u64, array_length: u64) -> u64 {
        ((unit_size_in_bytes as u64 in Saturating) * (array_length as u64 in Saturating)) as u64
    }
}

// Upstream returns Option<Self>: Array and PointerArray fold into their fixed
// forms; None and Pointer keep no element count, so no fixed form exists.
pub machine ContainerType::with_fixed_element_count(&self, element_count: u64) -> Optional<ContainerType> {
    transition self {
        ContainerType::Array -> (Optional::Some { value: ContainerType::ArrayFixed { array_length: element_count } })
        ContainerType::ArrayFixed { array_length } -> (Optional::Some { value: ContainerType::ArrayFixed { array_length: element_count } })
        ContainerType::PointerArray { pointer_size } -> (Optional::Some { value: ContainerType::PointerArrayFixed { pointer_size: pointer_size, array_length: element_count } })
        ContainerType::PointerArrayFixed { pointer_size, array_length } -> (Optional::Some { value: ContainerType::PointerArrayFixed { pointer_size: pointer_size, array_length: element_count } })
        ContainerType::None -> (Optional::None)
        ContainerType::Pointer { pointer_size } -> (Optional::None)
        _ -> (Optional::None)
    }
}

pub machine ContainerType::is_array(&self) -> bool {
    transition self {
        ContainerType::Array -> (true)
        ContainerType::ArrayFixed { array_length } -> (true)
        _ -> (false)
    }
}
