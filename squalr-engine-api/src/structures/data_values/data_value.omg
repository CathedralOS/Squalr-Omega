module src::structures::data_values::data_value;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::data_types::data_type_ref::DataTypeRefParse;

// Port of structures/data_values/data_value.rs: a value for a `DataType` —
// the type identifier plus the raw value bytes the type object interprets
// (int, string, serialized bitfield and mask, ...).
//
// Upstream keeps the bytes in a growable `Vec<u8>`; the byte domain keeps
// them in a bounded inline buffer plus a length — the same translation
// ElementWindow uses, bounded here at 4096 bytes (matching
// AnonymousValueString's bound: anonymous and array values beyond it refuse
// to store rather than truncate — named deviation from upstream's unbounded
// Vec<u8>). Upstream is Clone, not Copy, so the record carries no [copy].
//
// Named deferral: `to_valued_struct*` constructors live in
// structures/structs/valued_struct_field.omg beside their target type
// (upstream places them here; the port splits the dependency the other way
// so DataValue does not import the structs module).
pub data DataValue {
    data_type_ref: DataTypeRef;
    value_bytes: [u8; 4096];
    value_bytes_len: u64;
}

// Bespoke carrier for `from_string_privileged` — upstream Err is String;
// the package's refusal convention is `Refused` (Optional is unmatchable in
// this pin).
pub data DataValueParse {
    case Refused;
    case Parsed(value: DataValue);
}

// Upstream `DataValue::new` — stores the type ref verbatim and the value
// bytes up to the bound; over-long byte input truncates (named deviation —
// callers that need the refusal check `get_size_in_bytes` against input
// length, the same contract as `copy_from_bytes`).
pub machine DataValue::new(data_type_ref: &DataTypeRef, value_bytes: &[u8]) -> DataValue {
    let mut data_value: DataValue = DataValue {
        data_type_ref: DataTypeRef::clone(data_type_ref),
        value_bytes_len: 0
    };
    DataValue::fill_bytes(&mut data_value, value_bytes);
    data_value
}

pub machine DataValue::default() -> DataValue {
    DataValue {
        data_type_ref: DataTypeRef::default(),
        value_bytes_len: 0
    }
}

pub machine DataValue::clone(source: &DataValue) -> DataValue {
    let mut data_value: DataValue = DataValue {
        data_type_ref: DataTypeRef::clone(&source.data_type_ref),
        value_bytes_len: 0
    };
    DataValue::copy_bytes_window(&mut data_value, source, 0, source.value_bytes_len);
    data_value
}

// Upstream `copy_from_bytes` — replaces the stored bytes when they differ.
// Over-long input refuses (returns false) rather than truncating: unlike
// `new`, this is the write path read/read_struct results flow through, and
// silently dropping bytes would invent a shorter value than the memory
// region supplied — named deviation, upstream's Vec<u8> always accepts.
pub machine DataValue::copy_from_bytes(this: &mut DataValue, value_bytes: &[u8]) -> bool {
    let hoist1: bool = DataValue::bytes_equal(&this, value_bytes);
    transition value_bytes.len <= 4096 && !hoist1 {
        true -> store(this, value_bytes)
        false -> decide_equal(this, value_bytes)
    }
    state store(this: &mut DataValue, value_bytes: &[u8]) -> bool {
        DataValue::fill_bytes(&mut this, value_bytes);
        true
    }
    state decide_equal(this: &mut DataValue, value_bytes: &[u8]) -> bool {
        // Upstream: unchanged bytes are a no-op success; over-long input is
        // the only refusal.
        transition value_bytes.len <= 4096 {
            true -> (true)
            false -> (false)
        }
    }
}

machine DataValue::bytes_equal(this: &DataValue, value_bytes: &[u8]) -> bool {
    transition this.value_bytes_len == value_bytes.len {
        true -> scan(this, 0, value_bytes)
        false -> (false)
    }
    state scan(this: &DataValue, position: u64, value_bytes: &[u8]) -> bool {
        transition position < this.value_bytes_len && position < value_bytes.len && position < 4096 {
            true -> compare(this, position, value_bytes)
            false -> (true)
        }
    }
    state compare(this: &DataValue, position: u64, value_bytes: &[u8]) -> bool
        requires 0 <= position && position < 4096
    {
        transition this.value_bytes[position] == value_bytes[position] {
            true -> scan(this, position + 1, value_bytes)
            false -> (false)
            _ -> (false)
        }
    }
}

machine DataValue::fill_bytes(this: &mut DataValue, value_bytes: &[u8]) {
    transition { _ -> copy(this, value_bytes, 0) }
    state copy(this: &mut DataValue, value_bytes: &[u8], position: u64) {
        transition position < value_bytes.len && position < 4096 {
            true -> store(this, value_bytes, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut DataValue, value_bytes: &[u8], position: u64) {
        this.value_bytes[position] = value_bytes[position];
        transition { _ -> copy(this, value_bytes, position + 1) }
    }
    state finish(this: &mut DataValue, count: u64) {
        this.value_bytes_len = count;
    }
}

machine DataValue::copy_bytes_window(this: &mut DataValue, source: &DataValue, start: u64, end: u64) {
    transition { _ -> copy(this, source, start, end, 0) }
    state copy(this: &mut DataValue, source: &DataValue, at: u64, end: u64, position: u64) {
        transition at < end && at < source.value_bytes_len && at < 4096 && position < 4096 {
            true -> store(this, source, at, end, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut DataValue, source: &DataValue, at: u64, end: u64, position: u64) {
        this.value_bytes[position] = source.value_bytes[at];
        transition { _ -> copy(this, source, at + 1, end, position + 1) }
    }
    state finish(this: &mut DataValue, count: u64) {
        this.value_bytes_len = count;
    }
}

// Upstream `get_data_type_ref` — the borrowed view is not retainable, so
// callers take an owned clone (upstream callers Clone the ref where they
// hold it past a mutation anyway).
pub machine DataValue::get_data_type_ref(this: &DataValue) -> DataTypeRef {
    DataTypeRef::clone(&this.data_type_ref)
}

// Upstream `set_data_type_in_place` — updates the type without touching the
// bytes.
pub machine DataValue::set_data_type_in_place(this: &mut DataValue, data_type_ref: &DataTypeRef) {
    this.data_type_ref = DataTypeRef::clone(data_type_ref);
}

// Upstream `get_data_type_id` — forwarded to the ref's bounded id view.
pub machine DataValue::get_data_type_id(this: &DataValue) -> &[u8] {
    let hoist2: &[u8] = DataTypeRef::get_data_type_id(&this.data_type_ref);
    (hoist2)
}

pub machine DataValue::get_size_in_bytes(this: &DataValue) -> u64 {
    this.value_bytes_len
}

// Upstream `get_value_bytes` — the window over the stored bytes.
pub machine DataValue::get_value_bytes(this: &DataValue) -> &[u8] {
    transition this.value_bytes_len <= 4096 {
        true -> arm_result_168_0(this)
        _ -> (&this.value_bytes[0..0])
    }
    state arm_result_168_0(this: &DataValue) -> &[u8]
    
    requires this.value_bytes_len <= 4096;
{
        (&this.value_bytes[0..this.value_bytes_len])
    }
}

// Upstream `take_value_bytes` — the drained bytes are handed to the caller
// through `out` (upstream returns the Vec; the byte domain copies into a
// caller buffer) and the value is left empty. Returns the drained count.
pub machine DataValue::take_value_bytes(this: &mut DataValue, out: &mut [u8]) -> u64 {
    transition { _ -> copy(this, out, 0) }
    state copy(this: &mut DataValue, out: &mut [u8], position: u64) -> u64 {
        transition position < this.value_bytes_len && position < out.len && position < 4096 {
            true -> store(this, out, position)
            false -> drain(this, position)
        }
    }
    state store(this: &mut DataValue, out: &mut [u8], position: u64) -> u64 {
        out[position] = this.value_bytes[position];
        transition { _ -> copy(this, out, position + 1) }
    }
    state drain(this: &mut DataValue, count: u64) -> u64 {
        this.value_bytes_len = 0;
        count
    }
}

// Upstream FromStringPrivileged: "{data_type{;container}}={value}" split on
// the first '='. The ported parse takes the pre-split halves — byte-string
// splitting machinery lives with the CLI command parser; `parse` accepts the
// type id and (unused, per upstream) value bytes. Upstream ignores the value
// half and stores empty bytes — identical here.
pub machine DataValue::parse(data_type_id: &[u8]) -> DataValueParse {
    let ref_parse: DataTypeRefParse = DataTypeRef::parse(data_type_id);
    transition { _ -> finish(ref_parse) }
    state finish(ref_parse: DataTypeRefParse) -> DataValueParse {
        transition ref_parse {
            DataTypeRefParse::Refused -> (DataValueParse::Refused)
            DataTypeRefParse::Parsed { value } -> (DataValueParse::Parsed {
                value: DataValue::new(&value, "")
            })
            _ -> (DataValueParse::Refused)
        }
    }
}
