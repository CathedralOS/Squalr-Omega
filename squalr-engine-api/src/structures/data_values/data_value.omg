module src::structures::data_values::data_value;

use src::structures::data_types::data_type_ref::DataTypeRef;

// Port of DataValue, reduced to what the scan legs consume: the owning
// data-type handle plus the raw value bytes. Upstream Vec<u8> becomes a
// caller-supplied byte extent (`value_bytes.len` is the value size), which
// preserves `get_size_in_bytes` semantics; each borrowed field names its own
// lifetime because returned views must cite a single input loan. Valued-struct
// serialization and pointer helpers ride with the pointer/results legs.
pub data DataValue<'type_id, 'bytes> {
    data_type_ref: DataTypeRef<'type_id>;
    value_bytes: &'bytes mut [u8];
}

pub machine DataValue::new<'type_id, 'bytes>(
    data_type_ref: DataTypeRef<'type_id>,
    value_bytes: &'bytes mut [u8]
) -> DataValue<'type_id, 'bytes> {
    (DataValue {
        data_type_ref: data_type_ref,
        value_bytes: value_bytes,
    })
}

pub machine DataValue::get_data_type_ref(&self) -> &DataTypeRef {
    &self.data_type_ref
}

pub machine DataValue::get_size_in_bytes(&self) -> u64 {
    self.value_bytes.len
}

// Little-endian view of up to the first eight value bytes; bytes past the
// value's end contribute zero, matching upstream's widening reads where the
// caller supplies an operand of the scan's unit size.
pub machine DataValue::get_value_as_u64(&self) -> u64 {
    transition self.value_bytes.len > 0 {
        true -> assemble(self.value_bytes, 0, 0, 0)
        _ -> (0)
    }
    state assemble(
        &self,
        value_bytes: &[u8],
        byte_index: u64,
        cursor_index: u64,
        accumulated: u64
    ) -> u64 {
        transition cursor_index < 8 && byte_index < value_bytes.len {
            true -> fold(value_bytes, byte_index, cursor_index, accumulated)
            _ -> (accumulated)
        }
    }
    state fold(
        &self,
        value_bytes: &[u8],
        byte_index: u64 [0..value_bytes.len],
        cursor_index: u64,
        accumulated: u64
    ) -> u64 {
        let shifted: u64 = ((value_bytes[byte_index] as u64 in Saturating) << ((cursor_index as u64 in Saturating) * (8 as u64 in Saturating))) as u64;
        let next_index: u64 = ((byte_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        let next_cursor: u64 = ((cursor_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        let next_accumulated: u64 = ((accumulated as u64 in Saturating) | (shifted as u64 in Saturating)) as u64;
        assemble(value_bytes, next_index, next_cursor, next_accumulated)
    }
}
