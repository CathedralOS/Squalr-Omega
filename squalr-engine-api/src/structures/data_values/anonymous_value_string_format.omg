module src::structures::data_values::anonymous_value_string_format;

use omega::language::core::option;

// Port of structures/data_values/anonymous_value_string_format.rs: how the
// text inside an anonymous value is interpreted — bool, string, the three
// numeric bases, address, data_type_ref or enumeration.
pub data AnonymousValueStringFormat [copy] {
    case Bool;
    case String;
    case Binary;
    case Decimal;
    case Hexadecimal;
    case Address;
    case DataTypeRef;
    case Enumeration;
}

// Bespoke parse carrier: Optional is not matchable in this pin (see
// pointer_scan_pointer_size.omg for the package convention). `Refused` is
// upstream's Err.
pub data AnonymousValueStringFormatParse [copy] {
    case Refused;
    case Parsed(value: AnonymousValueStringFormat);
}

// Upstream `Default`.
pub machine AnonymousValueStringFormat::default() -> AnonymousValueStringFormat {
    AnonymousValueStringFormat::String
}

// Upstream `Display` spellings, kept on the data for write paths.
pub machine AnonymousValueStringFormat::spelling(&self) -> &[u8] {
    transition self {
        AnonymousValueStringFormat::Bool -> ("boolean")
        AnonymousValueStringFormat::String -> ("string")
        AnonymousValueStringFormat::Binary -> ("binary")
        AnonymousValueStringFormat::Decimal -> ("decimal")
        AnonymousValueStringFormat::Hexadecimal -> ("hexadecimal")
        AnonymousValueStringFormat::Address -> ("address")
        AnonymousValueStringFormat::DataTypeRef -> ("data_type_ref")
        AnonymousValueStringFormat::Enumeration -> ("enumeration")
    }
}

// True when text[start..end] spells exactly `expected` — upstream's from_str
// is an exact match (no trim, no case folding), unlike the pointer-size
// spellings.
machine matches(text: &[u8], expected: &[u8], start: u64, end: u64) -> bool {
    transition { _ -> compare(text, expected, start, end, 0) }
    state compare(text: &[u8], expected: &[u8], at: u64, end: u64, offset: u64) -> bool {
        transition offset < expected.len {
            true -> window(text, expected, at, end, offset)
            false -> done(at, end)
        }
    }
    state window(text: &[u8], expected: &[u8], at: u64, end: u64, offset: u64) -> bool {
        transition at < end && at < text.len {
            true -> check(text, expected, at, end, offset, text[at], expected[offset])
            false -> (false)
        }
    }
    state check(text: &[u8], expected: &[u8], at: u64, end: u64, offset: u64,
                at_value: u8, expected_value: u8) -> bool {
        transition at_value == expected_value {
            true -> compare(text, expected, at + 1, end, offset + 1)
            false -> (false)
        }
    }
    // The spelling consumed the window exactly — no leftover bytes.
    state done(at: u64, end: u64) -> bool {
        transition at == end {
            true -> (true)
            false -> (false)
        }
    }
}

// Upstream `FromStr`: an exact match against the fixed spelling set —
// "bool"|"boolean", "string", "bin"|"binary", "dec"|"decimal",
// "hex"|"hexadecimal", "address", "data_type_ref", "enumeration". Any other
// window, including an empty one, refuses.
pub machine AnonymousValueStringFormat::from_str(
    text: &[u8]
) -> Optional<AnonymousValueStringFormat> {
    transition { _ -> wrap(AnonymousValueStringFormat::from_str_window(text, 0, text.len)) }
    state wrap(result: AnonymousValueStringFormatParse) -> Optional<AnonymousValueStringFormat> {
        transition result {
            AnonymousValueStringFormatParse::Parsed { value } -> (Optional::Some { value: value })
            AnonymousValueStringFormatParse::Refused -> (Optional::None)
        }
    }
}

// The windowed parse — anonymous_value_string consumes a sub-window inside
// the ';' triple, so this is the matchable workhorse.
pub machine AnonymousValueStringFormat::from_str_window(
    text: &[u8],
    start: u64,
    end: u64
) -> AnonymousValueStringFormatParse {
    transition { _ -> spelled(text, start, end) }
    state spelled(text: &[u8], start: u64, end: u64) -> AnonymousValueStringFormatParse {
        transition matches(text, "bool", start, end) || matches(text, "boolean", start, end) {
            true -> (AnonymousValueStringFormatParse::Parsed { value: AnonymousValueStringFormat::Bool })
            false -> string_case(text, start, end)
        }
    }
    state string_case(text: &[u8], start: u64, end: u64) -> AnonymousValueStringFormatParse {
        transition matches(text, "string", start, end) {
            true -> (AnonymousValueStringFormatParse::Parsed { value: AnonymousValueStringFormat::String })
            false -> binary(text, start, end)
        }
    }
    state binary(text: &[u8], start: u64, end: u64) -> AnonymousValueStringFormatParse {
        transition matches(text, "bin", start, end) || matches(text, "binary", start, end) {
            true -> (AnonymousValueStringFormatParse::Parsed { value: AnonymousValueStringFormat::Binary })
            false -> decimal(text, start, end)
        }
    }
    state decimal(text: &[u8], start: u64, end: u64) -> AnonymousValueStringFormatParse {
        transition matches(text, "dec", start, end) || matches(text, "decimal", start, end) {
            true -> (AnonymousValueStringFormatParse::Parsed { value: AnonymousValueStringFormat::Decimal })
            false -> hexadecimal(text, start, end)
        }
    }
    state hexadecimal(text: &[u8], start: u64, end: u64) -> AnonymousValueStringFormatParse {
        transition matches(text, "hex", start, end) || matches(text, "hexadecimal", start, end) {
            true -> (AnonymousValueStringFormatParse::Parsed { value: AnonymousValueStringFormat::Hexadecimal })
            false -> address(text, start, end)
        }
    }
    state address(text: &[u8], start: u64, end: u64) -> AnonymousValueStringFormatParse {
        transition matches(text, "address", start, end) {
            true -> (AnonymousValueStringFormatParse::Parsed { value: AnonymousValueStringFormat::Address })
            false -> data_type_ref(text, start, end)
        }
    }
    state data_type_ref(text: &[u8], start: u64, end: u64) -> AnonymousValueStringFormatParse {
        transition matches(text, "data_type_ref", start, end) {
            true -> (AnonymousValueStringFormatParse::Parsed { value: AnonymousValueStringFormat::DataTypeRef })
            false -> enumeration(text, start, end)
        }
    }
    state enumeration(text: &[u8], start: u64, end: u64) -> AnonymousValueStringFormatParse {
        transition matches(text, "enumeration", start, end) {
            true -> (AnonymousValueStringFormatParse::Parsed { value: AnonymousValueStringFormat::Enumeration })
            false -> (AnonymousValueStringFormatParse::Refused)
        }
    }
}

// In-package exercise of the window parse — exact-match edges (leading
// space, different case, empty window) refuse just like upstream.
pub machine AnonymousValueStringFormat::from_str_consistent() -> bool {
    let dec: AnonymousValueStringFormatParse =
        AnonymousValueStringFormat::from_str_window("dec", 0, 3);
    let cased: AnonymousValueStringFormatParse =
        AnonymousValueStringFormat::from_str_window("Hex", 0, 3);
    let spaced: AnonymousValueStringFormatParse =
        AnonymousValueStringFormat::from_str_window(" hex", 0, 4);
    let empty: AnonymousValueStringFormatParse =
        AnonymousValueStringFormat::from_str_window("", 0, 0);
    spelled(dec) && refused(cased) && refused(spaced) && refused(empty)
}

machine spelled(result: AnonymousValueStringFormatParse) -> bool {
    transition result {
        AnonymousValueStringFormatParse::Parsed { value } -> (true)
        AnonymousValueStringFormatParse::Refused -> (false)
    }
}

machine refused(result: AnonymousValueStringFormatParse) -> bool {
    transition result {
        AnonymousValueStringFormatParse::Parsed { value } -> (false)
        AnonymousValueStringFormatParse::Refused -> (true)
    }
}
