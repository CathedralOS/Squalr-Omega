module src::structures::tasks::trackable_task_handle;

// Port of structures/tasks/trackable_task_handle.rs. Upstream derives
// `Clone`, `Debug`, `Serialize`, `Deserialize`: the field wire-schema
// numbers give the handle the synthesized encode/decode pair (the same
// serialization parity NormalizedRegion carries), `clone` covers the
// derived Clone, and Debug has no Omega surface. The upstream owned
// `String` fields ride as borrowed `&'a [u8]` views — wire codecs frame
// slices as length varint + raw bytes — so a handle borrows the task's
// buffers and must not outlive it, the same borrowed-view translation
// `get_name` already uses. Named deviation: `clone_from` is dropped —
// storing a borrow-carrying value into a persistent field is not
// admitted; `clone` produces a fresh handle instead.
pub data TrackableTaskHandle<'a> {
    #0 name: &'a [u8];
    #1 progress: f32;
    #2 task_identifier: &'a [u8];
}

// Upstream derived `Clone` parity, split at the compiler's edges like
// NormalizedRegion::clone: the borrowed source is an explicit parameter
// whose lifetime supplies the produced views.
pub machine TrackableTaskHandle::clone<'a>(source: &'a TrackableTaskHandle<'a>) -> TrackableTaskHandle<'a> {
    TrackableTaskHandle {
        name: source.name,
        progress: source.progress,
        task_identifier: source.task_identifier
    }
}
