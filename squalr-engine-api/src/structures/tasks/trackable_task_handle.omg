module src::structures::tasks::trackable_task_handle;

// Port of structures/tasks/trackable_task_handle.rs. Upstream derives
// `Clone`, `Debug`, `Serialize`, `Deserialize`: the field wire-schema
// numbers give the handle the synthesized encode/decode pair (the same
// serialization parity NormalizedRegion carries), `clone`/`clone_from`
// cover the derived Clone, and Debug has no Omega surface. The `String`
// fields translate to the repo's bounded byte buffers beside a live
// length (Omega has no growable String); a uuid identifier text is 36
// bytes, so 256 covers every authored caller.
pub data TrackableTaskHandle {
    #0 name: [u8; 256];
    #1 name_len: u64;
    #2 progress: f32;
    #3 task_identifier: [u8; 256];
    #4 task_identifier_len: u64;
}

// Upstream derived `Clone` parity, split at the compiler's edges like
// NormalizedRegion::clone: the borrowed source is an explicit parameter.
pub machine TrackableTaskHandle::clone(source: &TrackableTaskHandle) -> TrackableTaskHandle {
    let mut handle: TrackableTaskHandle = TrackableTaskHandle {
        progress: source.progress,
        name_len: source.name_len,
        task_identifier_len: source.task_identifier_len
    };
    handle.name = source.name;
    handle.task_identifier = source.task_identifier;
    handle
}

pub machine TrackableTaskHandle::clone_from(&mut self, source: &TrackableTaskHandle) {
    self.progress = source.progress;
    self.name_len = source.name_len;
    self.task_identifier_len = source.task_identifier_len;
    self.name = source.name;
    self.task_identifier = source.task_identifier;
}
