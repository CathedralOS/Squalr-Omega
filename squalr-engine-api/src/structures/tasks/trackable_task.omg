module src::structures::tasks::trackable_task;

use omega::language::core::option;
use omega::language::core::binding;
use omega::language::core::wait_wake;
use src::structures::tasks::trackable_task_handle;

// Port of structures/tasks/trackable_task.rs @568aa758. Field-by-field:
//
//   name: String -> bounded byte buffer + live length (Omega has no
//     growable String; 256 bytes covers every authored task name).
//   progress: Arc<Mutex<f32>> -> `progress: f32`. The mutex exists only for
//     cross-thread sharing; the lock-failure log branches have no single-
//     owner analog, and `set_progress`'s interior mutation is the ordinary
//     `&mut self` attachment.
//   task_identifier: String -> bounded byte buffer + live length (a uuid
//     text is 36 bytes). Upstream `Option<String>` defaults to
//     `Uuid::new_v4()`; minting a v4 uuid awaits an entropy facility
//     (recorded as a dependency, not simulated), so `create` takes the
//     identifier bytes like upstream's `Some` leg.
//   is_canceled / is_completed: Arc<AtomicBool> -> AtomicBool fields.
//     The SeqCst stores/loads keep their GlobalOrder spellings; sharing the
//     cell is a task borrow (`get_cancellation_token` returns the observed
//     flag — a live shared cell awaits shared ownership).
//   completed_cv: Condvar -> `completion_word` plus the WaitWake substrate
//     admitted at `create` (provider admission stays a selection of the
//     caller, matching the core wait/wake contract). `notify_all` is
//     `wake_many` with an unbounded count; the wait keeps upstream's
//     completion re-check loop so a wake edge that is not completion
//     cannot end the wait early.
//   progress_sender/progress_receiver: the unbounded crossbeam channel
//     becomes a bounded 64-deep journal inside the task plus a wake word.
//     Receivers are competing claims on the one shared head, exactly like
//     crossbeam's cloned `Receiver`s; `subscribe_to_progress_updates`
//     yields that claim. A full queue declines the send — upstream's
//     `Err` send branch (whose handling is only an error log; the logging
//     surface is deferred). `recv`'s disconnect failure has no analog
//     while the task owns its queue.
//   The Arc<Self> return of `create` is the owned value; upstream's shared
//     clones are ordinary borrows at the call sites.

// The `Receiver<f32>` clone upstream hands out: a competing-consumer claim
// on the task's single shared progress queue. Stateless because every
// receiver drains the same head — claims are interchangeable.
pub data ProgressReceiver [copy] {
}

pub data TrackableTask {
    name: [u8; 256];
    name_len: u64;
    progress: f32;
    task_identifier: [u8; 256];
    task_identifier_len: u64;
    is_canceled: AtomicBool;
    is_completed: AtomicBool;
    completion_word: AtomicU64;
    progress_queue: [f32; 64];
    progress_queue_head: u64;
    progress_queue_len: u64;
    progress_queue_word: AtomicU64;
    substrate: Binding<WaitWake>;
}

// The name and identifier fields copy into their bounded byte buffers with
// per-field loops on the setters (the same shape ProcessInfo::set_name
// uses): a `&mut self.field` helper argument declines under Binding-carrying
// entry data, so the copy lives on `self` as an indexed field-element store.

// Upstream `create(name, task_identifier) -> Arc<Self>`: progress at zero,
// flags clear, channel empty. The identifier arrives caller-minted (see the
// uuid note above) and the wait/wake substrate is admitted here for the
// condvar and channel realizations.
pub machine TrackableTask::create(
    name: &[u8],
    task_identifier: &[u8],
    substrate: Binding<WaitWake>
) -> TrackableTask {
    let mut task: TrackableTask = TrackableTask {
        progress: 0.0,
        name_len: 0,
        task_identifier_len: 0,
        completion_word: 0,
        progress_queue_head: 0,
        progress_queue_len: 0,
        progress_queue_word: 0,
        substrate: substrate
    };
    TrackableTask::set_name(&mut task, name);
    TrackableTask::set_task_identifier(&mut task, task_identifier);
    task
}

// Upstream `get_task_handle`: an owned snapshot of name, progress and
// identifier. The handle's fields borrow views of this task's buffers, so
// the handle must not outlive the task.
pub machine TrackableTask::get_task_handle<'a>(this: &TrackableTask) -> trackable_task_handle::TrackableTaskHandle<'a> {
    let hoist3: &'a [u8] = TrackableTask::get_task_identifier(&this);
    let hoist2: &'a [u8] = TrackableTask::get_name(&this);
    trackable_task_handle::TrackableTaskHandle {
        name: hoist2,
        progress: this.progress,
        task_identifier: hoist3
    }
}

// Upstream `get_progress`: the guarded read. A lock failure cannot occur
// on an owned field, so the `0.0` error leg is absent by construction.
pub machine TrackableTask::get_progress(this: &TrackableTask) -> f32 {
    this.progress
}

// Upstream `set_progress`: store under the lock, then `send` on the
// progress channel. The store is an ordinary field write; the send is a
// journal append that wakes a pending receiver (crossbeam's send also
// releases one blocked `recv`). A full journal declines the send — the
// `Err` leg upstream only logs.
pub machine TrackableTask::set_progress(this: &mut TrackableTask, progress: f32)
reaches WaitWake
invokes WaitWake;
{
    this.progress = progress;
    transition this.progress_queue_len < 64 {
        true -> enqueue(this, progress)
        _ -> sent(this)
    }

    state enqueue(this: &mut TrackableTask, progress: f32) {
        let tail: u64 = (((this.progress_queue_head as u64 in Saturating) + (this.progress_queue_len as u64 in Saturating)) as u64) % 64;
        this.progress_queue[tail] = progress;
        this.progress_queue_len = ((this.progress_queue_len as u64 in Saturating) + 1) as u64;
        this.progress_queue_word = this.progress_queue_len;
        _ = WaitWake::wake_one(&this.progress_queue_word);
    }

    state sent(this: &mut TrackableTask) {
    }
}

// Upstream `subscribe_to_progress_updates`: clones the channel receiver.
pub machine TrackableTask::subscribe_to_progress_updates(this: &TrackableTask) -> ProgressReceiver {
    ProgressReceiver {}
}

// Upstream `Receiver::try_recv`: a non-blocking pull on the shared queue —
// `Optional::None` while empty, the oldest pending value otherwise.
pub machine TrackableTask::next_progress_update(
    this: &mut TrackableTask,
    receiver: &ProgressReceiver
) -> Optional<f32> {
    transition this.progress_queue_len > 0 {
        true -> head_in_bounds(this, receiver)
        _ -> (Optional::None)
    }

    state head_in_bounds(this: &mut TrackableTask, receiver: &ProgressReceiver) -> Optional<f32> {
        transition this.progress_queue_head < 64 {
            true -> take(this, receiver, this.progress_queue_head)
            _ -> (Optional::None)
        }
    }

    state take(
        this: &mut TrackableTask,
        receiver: &ProgressReceiver,
        head: u64
    ) -> Optional<f32>
        requires 0 <= head && head < 64
    {
        let value: f32 = this.progress_queue[head];
        this.progress_queue_head = (((head as u64 in Saturating) + 1) as u64) % 64;
        this.progress_queue_len = ((this.progress_queue_len as u64 in Saturating) - 1) as u64;
        this.progress_queue_word = this.progress_queue_len;
        Optional::Some { value: value }
    }
}

// Upstream `Receiver::recv`: blocks on the empty queue until a send's wake
// edge lands, then takes the oldest pending value. The re-check loop keeps
// a losing competing receiver parked — upstream's own recv waits the same
// way when another consumer claimed the message first.
pub machine TrackableTask::wait_for_progress_update(
    this: &mut TrackableTask,
    receiver: &ProgressReceiver
) -> Optional<f32>
reaches WaitWake
invokes WaitWake;
blocks;
{
    transition this.progress_queue_len > 0 {
        true -> head_in_bounds(this, receiver)
        _ -> await_message(this, receiver)
    }

    state await_message(this: &mut TrackableTask, receiver: &ProgressReceiver) -> Optional<f32> {
        // Both wait outcomes take the same re-check edge; the outcome local
        // exists only to bind the blocking call's result.
        let outcome: WaitOutcome =
            block WaitWake::wait(&this.progress_queue_word, 0);
        transition { _ -> recheck(this, receiver) }
    }

    state recheck(this: &mut TrackableTask, receiver: &ProgressReceiver) -> Optional<f32> {
        transition this.progress_queue_len > 0 {
            true -> head_in_bounds(this, receiver)
            _ -> await_message(this, receiver)
        }
    }

    state head_in_bounds(this: &mut TrackableTask, receiver: &ProgressReceiver) -> Optional<f32> {
        transition this.progress_queue_head < 64 {
            true -> take(this, receiver, this.progress_queue_head)
            _ -> (Optional::None)
        }
    }

    state take(
        this: &mut TrackableTask,
        receiver: &ProgressReceiver,
        head: u64
    ) -> Optional<f32>
        requires 0 <= head && head < 64
    {
        let value: f32 = this.progress_queue[head];
        this.progress_queue_head = (((head as u64 in Saturating) + 1) as u64) % 64;
        this.progress_queue_len = ((this.progress_queue_len as u64 in Saturating) - 1) as u64;
        this.progress_queue_word = this.progress_queue_len;
        Optional::Some { value: value }
    }
}

// Upstream `get_name` returns an owned `String` clone; the owned-copy
// shape is the buffer copy `get_task_handle` performs, so the getter
// exposes the live text as a borrowed slice.
pub machine TrackableTask::get_name<'a>(this: &TrackableTask) -> &'a [u8] {
    // The copy bound keeps name_len <= 256; `% 257` is the ranged witness
    // the subslice's end bound needs (same modulo idiom as `tail`).
    let end: u64 = this.name_len % 257;
    this.name[0..end]
}

pub machine TrackableTask::set_name(this: &mut TrackableTask, name: &[u8]) {
    transition { _ -> copy(this, name, 0) }
    state copy(this: &mut TrackableTask, name: &[u8], position: u64) {
        transition position < name.len && position < 256 {
            true -> store(this, name, position)
            false -> done(this, position)
        }
    }
    state store(this: &mut TrackableTask, name: &[u8], position: u64)
        requires 0 <= position && position < name.len && position < 256
    {
        this.name[position] = name[position];
        transition { _ -> copy(this, name, position + 1) }
    }
    state done(this: &mut TrackableTask, position: u64) {
        this.name_len = position;
    }
}

// Identifier construction half of `create` (upstream has no setter).
machine TrackableTask::set_task_identifier(this: &mut TrackableTask, task_identifier: &[u8]) {
    transition { _ -> copy(this, task_identifier, 0) }
    state copy(this: &mut TrackableTask, task_identifier: &[u8], position: u64) {
        transition position < task_identifier.len && position < 256 {
            true -> store(this, task_identifier, position)
            false -> done(this, position)
        }
    }
    state store(this: &mut TrackableTask, task_identifier: &[u8], position: u64)
        requires 0 <= position && position < task_identifier.len && position < 256
    {
        this.task_identifier[position] = task_identifier[position];
        transition { _ -> copy(this, task_identifier, position + 1) }
    }
    state done(this: &mut TrackableTask, position: u64) {
        this.task_identifier_len = position;
    }
}

// Upstream `get_task_identifier` returns an owned `String` clone; same
// borrowed-view translation as `get_name`.
pub machine TrackableTask::get_task_identifier<'a>(this: &TrackableTask) -> &'a [u8] {
    let end: u64 = this.task_identifier_len % 257;
    this.task_identifier[0..end]
}

// The `HashMap<String, _>` key lookup leg of the session's task manager:
// identifier equality is live-length equality plus byte equality over the
// live span — upstream's map `get`/`remove` on the `String` key.
pub machine TrackableTask::matches_task_identifier(
    this: &TrackableTask,
    needle: &[u8]
) -> bool {
    transition needle.len == this.task_identifier_len {
        true -> scan(this, needle, 0)
        _ -> (false)
    }

    state scan(this: &TrackableTask, needle: &[u8], position: u64) -> bool {
        transition position < needle.len && position < 256 {
            true -> compare(this, needle, position)
            _ -> (true)
        }
    }

    state compare(this: &TrackableTask, needle: &[u8], position: u64) -> bool
        requires 0 <= position && position < needle.len && position < 256
    {
        transition this.task_identifier[position] == needle[position] {
            true -> scan(this, needle, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// The same key match task-versus-task — upstream's `insert` re-key check
// when a registered identifier is already tracked.
pub machine TrackableTask::matches_task_identifier_of(
    this: &TrackableTask,
    other: &TrackableTask
) -> bool {
    transition other.task_identifier_len == this.task_identifier_len {
        true -> scan(this, other, 0)
        _ -> (false)
    }

    state scan(this: &TrackableTask, other: &TrackableTask, position: u64) -> bool {
        transition position < other.task_identifier_len && position < 256 {
            true -> compare(this, other, position)
            _ -> (true)
        }
    }

    state compare(this: &TrackableTask, other: &TrackableTask, position: u64) -> bool
        requires 0 <= position && position < other.task_identifier_len && position < 256
    {
        transition this.task_identifier[position] == other.task_identifier[position] {
            true -> scan(this, other, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// Upstream `get_cancellation_token` hands out the shared `Arc<AtomicBool>`
// for polling observation (`load(Acquire)`/`load(Relaxed)` at every
// consumer site — never stored through). Without a cloneable shared cell
// the token is the flag's current observation through a task borrow.
pub machine TrackableTask::get_cancellation_token(this: &TrackableTask) -> bool {
    let observed: bool = this.is_canceled as bool;
    observed
}

pub machine TrackableTask::is_completed(this: &TrackableTask) -> bool {
    let observed: bool = this.is_completed as bool;
    observed
}

// Upstream `cancel`: flag, then complete. The SeqCst store keeps its
// GlobalOrder spelling.
pub machine TrackableTask::cancel(this: &mut TrackableTask)
reaches WaitWake
invokes WaitWake;
{
    this.is_canceled = true;
    _ = TrackableTask::complete(this);
}

// Upstream `complete`: flag, then `completed_cv.notify_all()`. The word
// flips before the wake edge so a released wait observes completion.
pub machine TrackableTask::complete(this: &mut TrackableTask)
reaches WaitWake
invokes WaitWake;
{
    this.is_completed = true;
    this.completion_word = 1;
    let limit: u64 = 18446744073709551615;
    _ = WaitWake::wake_many(&this.completion_word, limit);
}

// Upstream `wait_for_completion`: parks on the condvar until
// `is_completed` reads true. The substrate wait releases only on a wake
// edge or an already-differing word, and the re-check loop preserves
// upstream's `while !is_completed` re-read after every wake.
pub machine TrackableTask::wait_for_completion(this: &TrackableTask)
reaches WaitWake
invokes WaitWake;
blocks;
{
    transition this.is_completed {
        true -> finished(this)
        _ -> await_completion(this)
    }

    state await_completion(this: &TrackableTask) {
        let outcome: WaitOutcome =
            block WaitWake::wait(&this.completion_word, 0);
        transition { _ -> recheck(this) }
    }

    state recheck(this: &TrackableTask) {
        transition this.is_completed {
            true -> finished(this)
            _ -> await_completion(this)
        }
    }

    state finished(this: &TrackableTask) {
    }
}
