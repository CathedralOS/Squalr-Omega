module src::structures::settings::scan_settings;

use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::scanning::memory_read_mode::MemoryReadMode;

// Port of structures/settings/scan_settings.rs — the persisted scan knobs
// the executors consult. Upstream defaults (scan_settings.rs):
//   results_page_size = 22, memory_alignment = Alignment1,
//   memory_read_mode = ReadBeforeScan, is_single_threaded_scan = false.
pub data ScanSettings [copy] {
    results_page_size: u64;
    memory_alignment: MemoryAlignment;
    memory_read_mode: MemoryReadMode;
    is_single_threaded_scan: bool;
}

pub machine ScanSettings::default() -> ScanSettings {
    ScanSettings {
        results_page_size: 22,
        memory_alignment: MemoryAlignment::Alignment1,
        memory_read_mode: MemoryReadMode::ReadBeforeScan,
        is_single_threaded_scan: false,
    }
}

pub machine ScanSettings::get_results_page_size(&self) -> u64 {
    self.results_page_size
}

pub machine ScanSettings::get_memory_alignment(&self) -> MemoryAlignment {
    self.memory_alignment
}

pub machine ScanSettings::get_memory_read_mode(&self) -> MemoryReadMode {
    self.memory_read_mode
}

pub machine ScanSettings::get_is_single_threaded_scan(&self) -> bool {
    self.is_single_threaded_scan
}
