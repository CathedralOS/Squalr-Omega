module src::structures::settings::scan_settings;

use src::plugins::memory_view::page_retrieval_mode::PageRetrievalMode;
use src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::scanning::memory_read_mode::MemoryReadMode;

// Port of structures/settings/scan_settings.rs — the persisted scan knobs
// the executors consult. Upstream defaults (scan_settings.rs):
//   page_retrieval_mode = FromSettings, results_page_size = 22,
//   results_read_interval_ms = 200, project_read_interval_ms = 200,
//   project_file_system_watch_enabled = true (upstream
//   default_project_file_system_watch_enabled), freeze_interval_ms = 50,
//   memory_alignment = Some(Alignment1), floating_point_tolerance =
//   Tolerance10E3, memory_read_mode = ReadBeforeScan,
//   is_single_threaded_scan = false, debug_perform_validation_scan = false.
// `memory_alignment` upstream is Option<MemoryAlignment>: the Option is the
// JSON file's "inherit the built-in default" mark — the owned store carries
// the resolved value, so the field stays non-Option here (request-side
// Option fidelity lives on ScanSettingsSetRequest). Upstream mutates
// settings through its JSON store (persistence leg is deferred); the
// setters keep each knob reachable on the owned surface until that
// plumbing lands.
pub data ScanSettings [copy] {
    page_retrieval_mode: PageRetrievalMode;
    results_page_size: u64;
    results_read_interval_ms: u64;
    project_read_interval_ms: u64;
    project_file_system_watch_enabled: bool;
    freeze_interval_ms: u64;
    memory_alignment: MemoryAlignment;
    memory_read_mode: MemoryReadMode;
    floating_point_tolerance: FloatingPointTolerance;
    is_single_threaded_scan: bool;
    debug_perform_validation_scan: bool;
}

pub machine ScanSettings::default() -> ScanSettings {
    ScanSettings {
        page_retrieval_mode: PageRetrievalMode::FromSettings,
        results_page_size: 22,
        results_read_interval_ms: 200,
        project_read_interval_ms: 200,
        project_file_system_watch_enabled: true,
        freeze_interval_ms: 50,
        memory_alignment: MemoryAlignment::Alignment1,
        memory_read_mode: MemoryReadMode::ReadBeforeScan,
        floating_point_tolerance: FloatingPointTolerance::default(),
        is_single_threaded_scan: false,
        debug_perform_validation_scan: false,
    }
}

pub machine ScanSettings::get_page_retrieval_mode(&self) -> PageRetrievalMode {
    self.page_retrieval_mode
}

pub machine ScanSettings::set_page_retrieval_mode(&mut self, mode: PageRetrievalMode) {
    self.page_retrieval_mode = mode;
}

pub machine ScanSettings::get_results_page_size(&self) -> u64 {
    self.results_page_size
}

pub machine ScanSettings::set_results_page_size(&mut self, page_size: u64) {
    self.results_page_size = page_size;
}

pub machine ScanSettings::get_results_read_interval_ms(&self) -> u64 {
    self.results_read_interval_ms
}

pub machine ScanSettings::set_results_read_interval_ms(&mut self, interval_ms: u64) {
    self.results_read_interval_ms = interval_ms;
}

pub machine ScanSettings::get_project_read_interval_ms(&self) -> u64 {
    self.project_read_interval_ms
}

pub machine ScanSettings::set_project_read_interval_ms(&mut self, interval_ms: u64) {
    self.project_read_interval_ms = interval_ms;
}

pub machine ScanSettings::get_project_file_system_watch_enabled(&self) -> bool {
    self.project_file_system_watch_enabled
}

pub machine ScanSettings::set_project_file_system_watch_enabled(&mut self, enabled: bool) {
    self.project_file_system_watch_enabled = enabled;
}

pub machine ScanSettings::get_freeze_interval_ms(&self) -> u64 {
    self.freeze_interval_ms
}

pub machine ScanSettings::set_freeze_interval_ms(&mut self, interval_ms: u64) {
    self.freeze_interval_ms = interval_ms;
}

pub machine ScanSettings::get_memory_alignment(&self) -> MemoryAlignment {
    self.memory_alignment
}

pub machine ScanSettings::set_memory_alignment(&mut self, alignment: MemoryAlignment) {
    self.memory_alignment = alignment;
}

pub machine ScanSettings::get_memory_read_mode(&self) -> MemoryReadMode {
    self.memory_read_mode
}

pub machine ScanSettings::set_memory_read_mode(&mut self, mode: MemoryReadMode) {
    self.memory_read_mode = mode;
}

pub machine ScanSettings::get_floating_point_tolerance(&self) -> FloatingPointTolerance {
    self.floating_point_tolerance
}

pub machine ScanSettings::set_floating_point_tolerance(&mut self, tolerance: FloatingPointTolerance) {
    self.floating_point_tolerance = tolerance;
}

pub machine ScanSettings::get_is_single_threaded_scan(&self) -> bool {
    self.is_single_threaded_scan
}

pub machine ScanSettings::set_is_single_threaded_scan(&mut self, enabled: bool) {
    self.is_single_threaded_scan = enabled;
}

// Upstream `ScanSettingsStore::get_debug_perform_validation_scan`.
pub machine ScanSettings::get_debug_perform_validation_scan(&self) -> bool {
    self.debug_perform_validation_scan
}

pub machine ScanSettings::set_debug_perform_validation_scan(
    &mut self,
    enabled: bool
) {
    self.debug_perform_validation_scan = enabled;
}
