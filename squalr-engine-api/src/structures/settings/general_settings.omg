module src::structures::settings::general_settings;

// Port of structures/settings/general_settings.rs — the single general knob.
// Upstream is Copy with `debug_engine_request_delay_ms: u64` defaulting to 0.
pub data GeneralSettings [copy] {
    debug_engine_request_delay_ms: u64;
}

pub machine GeneralSettings::new(debug_engine_request_delay_ms: u64) -> GeneralSettings {
    GeneralSettings {
        debug_engine_request_delay_ms: debug_engine_request_delay_ms
    }
}

pub machine GeneralSettings::default() -> GeneralSettings {
    GeneralSettings {
        debug_engine_request_delay_ms: 0
    }
}

pub machine GeneralSettings::get_debug_engine_request_delay_ms(general_settings: &GeneralSettings) -> u64 {
    general_settings.debug_engine_request_delay_ms
}

pub machine GeneralSettings::set_debug_engine_request_delay_ms(general_settings: &mut GeneralSettings, delay_ms: u64) {
    general_settings.debug_engine_request_delay_ms = delay_ms;
}
