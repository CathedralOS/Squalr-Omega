module src::structures::settings::project_settings;

// Port of structures/settings/project_settings.rs — the persisted project
// settings row. Upstream PathBuf carries as the package's bounded [u8; 512]+len
// path carrier; the update interval stores verbatim. serde(Debug)/to_writer
// spellings belong to the project-file codec leg, not this record.
pub data ProjectSettings {
    projects_root: [u8; 512];
    projects_root_len: u64;
    project_update_interval_ms: u64;
}

pub machine ProjectSettings::new(
    projects_root: &[u8],
    project_update_interval_ms: u64
) -> ProjectSettings {
    let mut created: ProjectSettings = ProjectSettings {
        projects_root_len: 0,
        project_update_interval_ms: project_update_interval_ms,
    };
    ProjectSettings::set_projects_root(&mut created, projects_root);
    (created)
}

// Upstream `Default` — projects root "./Squalr", update interval 200ms.
pub machine ProjectSettings::default() -> ProjectSettings {
    (ProjectSettings::new("./Squalr", 200))
}

pub machine ProjectSettings::get_projects_root(project_settings: &ProjectSettings) -> &[u8] {
    transition project_settings.projects_root_len <= 512 {
        true -> (&project_settings.projects_root[0..project_settings.projects_root_len])
        false -> (&project_settings.projects_root[0..512])
        _ -> (&project_settings.projects_root[0..512])
    }
}

pub machine ProjectSettings::set_projects_root(project_settings: &mut ProjectSettings, projects_root: &[u8]) {
    project_settings.projects_root_len = 0;
    transition {
        _ -> copy(project_settings, projects_root, 0)
    }
    state copy(project_settings: &mut ProjectSettings, projects_root: &[u8], position: u64) {
        transition position < projects_root.len && position < 512 {
            true -> store(project_settings, projects_root, position)
            false -> done(project_settings)
            _ -> done(project_settings)
        }
    }
    state store(project_settings: &mut ProjectSettings, projects_root: &[u8], position: u64)
        requires position < 512;
    {
        project_settings.projects_root[position] = projects_root[position];
        project_settings.projects_root_len = ((project_settings.projects_root_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition {
            _ -> copy(project_settings, projects_root, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state done(project_settings: &mut ProjectSettings) {
    }
}

pub machine ProjectSettings::get_project_update_interval_ms(project_settings: &ProjectSettings) -> u64 {
    (project_settings.project_update_interval_ms)
}

pub machine ProjectSettings::set_project_update_interval_ms(project_settings: &mut ProjectSettings, project_update_interval_ms: u64) {
    project_settings.project_update_interval_ms = project_update_interval_ms;
}
