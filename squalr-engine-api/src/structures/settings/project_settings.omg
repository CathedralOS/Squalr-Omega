module src::structures::settings::project_settings;

// Port of structures/settings/project_settings.rs — the persisted project
// settings row. Upstream PathBuf carries as the package's bounded [u8; 512]+len
// path carrier; the update interval stores verbatim. serde(Debug)/to_writer
// spellings belong to the project-file codec leg, not this record.
public data ProjectSettings {
    projects_root: [u8; 512];
    projects_root_len: u64;
    project_update_interval_ms: u64;
}

public machine ProjectSettings::new(
    projects_root: &[u8],
    project_update_interval_ms: u64
) -> ProjectSettings {
    let mut created: ProjectSettings = ProjectSettings {
        projects_root_len: 0,
        project_update_interval_ms: project_update_interval_ms,
    };
    ProjectSettings::set_projects_root(&mut created, projects_root);
    (created)
}

// Upstream `Default` — projects root "./Squalr", update interval 200ms.
public machine ProjectSettings::default() -> ProjectSettings {
    (ProjectSettings::new("./Squalr", 200))
}

public machine ProjectSettings::get_projects_root(this: &ProjectSettings) -> &[u8] {
    transition this.projects_root_len <= 512 {
        true -> (&this.projects_root[0..this.projects_root_len])
        false -> (&this.projects_root[0..512])
        _ -> (&this.projects_root[0..512])
    }
}

public machine ProjectSettings::set_projects_root(this: &mut ProjectSettings, projects_root: &[u8]) {
    this.projects_root_len = 0;
    transition {
        _ -> copy(this, projects_root, 0)
    }
    machine copy(this: &mut ProjectSettings, projects_root: &[u8], position: u64) {
        transition position < projects_root.len && position < 512 {
            true -> store(this, projects_root, position)
            false -> done(this)
            _ -> done(this)
        }
    }
    machine store(this: &mut ProjectSettings, projects_root: &[u8], position: u64)
        requires position < 512;
    {
        this.projects_root[position] = projects_root[position];
        this.projects_root_len = ((this.projects_root_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition {
            _ -> copy(this, projects_root, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    machine done(this: &mut ProjectSettings) {
    }
}

public machine ProjectSettings::get_project_update_interval_ms(this: &ProjectSettings) -> u64 {
    (this.project_update_interval_ms)
}

public machine ProjectSettings::set_project_update_interval_ms(this: &mut ProjectSettings, project_update_interval_ms: u64) {
    this.project_update_interval_ms = project_update_interval_ms;
}
