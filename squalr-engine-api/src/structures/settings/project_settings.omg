module src::structures::settings::project_settings;
use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::bounded_slice::bounded_slice;

// Port of structures/settings/project_settings.rs — the persisted project
// settings row. Upstream PathBuf carries as the package's bounded [u8; 512]+len
// path carrier; the update interval stores verbatim. serde(Debug)/to_writer
// spellings belong to the project-file codec leg, not this record.
pub data ProjectSettings {
    projects_root: [u8; 512];
    projects_root_len: u64;
    project_update_interval_ms: u64;
}

pub machine ProjectSettings::new(
    projects_root: &[u8],
    project_update_interval_ms: u64
) -> ProjectSettings {
    let mut created: ProjectSettings = ProjectSettings {
        projects_root_len: 0,
        project_update_interval_ms: project_update_interval_ms,
    };
    created.set_projects_root(projects_root);
    (created)
}

// Upstream `Default` — projects root "./Squalr", update interval 200ms.
pub machine ProjectSettings::default() -> ProjectSettings {
    (ProjectSettings::new("./Squalr", 200))
}

pub machine ProjectSettings::get_projects_root(&self) -> &[u8] {
    bounded_slice(&self.projects_root[0..512], self.projects_root_len)
}

pub machine ProjectSettings::set_projects_root(&mut self, projects_root: &[u8]) {
    self.projects_root_len = 0;
    self.projects_root_len = BoundedByteCopy::copy(&mut self.projects_root[0..512], projects_root);
}

pub machine ProjectSettings::get_project_update_interval_ms(&self) -> u64 {
    (self.project_update_interval_ms)
}

pub machine ProjectSettings::set_project_update_interval_ms(&mut self, project_update_interval_ms: u64) {
    self.project_update_interval_ms = project_update_interval_ms;
}
