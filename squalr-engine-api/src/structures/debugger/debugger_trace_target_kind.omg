module src::structures::debugger::debugger_trace_target_kind;

// Port of the DebuggerTraceTargetKind enum carried inside
// debugger_trace_session_descriptor.rs — upstream Default is Address.
pub data DebuggerTraceTargetKind [copy] {
    case Address;
    case Instruction;
}

pub machine DebuggerTraceTargetKind::default() -> DebuggerTraceTargetKind {
    (DebuggerTraceTargetKind::Address)
}
