module src::structures::debugger::debugger_session_state;

// Port of structures/debugger/debugger_session_state.rs — upstream Default
// is Detached.
pub data DebuggerSessionState [copy] {
    case Detached;
    case Attaching;
    case Attached;
    case Paused;
    case Running;
    case Exited;
}

pub machine DebuggerSessionState::default() -> DebuggerSessionState {
    (DebuggerSessionState::Detached)
}
