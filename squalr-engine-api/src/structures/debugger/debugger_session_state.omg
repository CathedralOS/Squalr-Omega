module src::structures::debugger::debugger_session_state;

// Port of structures/debugger/debugger_session_state.rs — upstream Default
// is Detached.
public data DebuggerSessionState [copy] {
    case Detached;
    case Attaching;
    case Attached;
    case Paused;
    case Running;
    case Exited;
}

public machine DebuggerSessionState::default() -> DebuggerSessionState {
    (DebuggerSessionState::Detached)
}
