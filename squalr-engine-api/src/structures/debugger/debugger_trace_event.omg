pub machine DebuggerTraceEvent::set_backend_message(this: &mut DebuggerTraceEvent, backend_message: &[u8]) {
    transition 0 == 0 {
        _ -> copy_message(this, backend_message, 0)
    }
    state copy_message(this: &mut DebuggerTraceEvent, backend_message: &[u8], position: u64) {
        transition position < backend_message.len && position < 256 {
            true -> store_message(this, backend_message, position)
            _ -> done_message(this, position)
        }
    }
    state store_message(this: &mut DebuggerTraceEvent, backend_message: &[u8], position: u64)
        requires position < backend_message.len && position < 256 {
        this.backend_message[position] = backend_message[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_message(this, backend_message, next)
        }
    }
    state done_message(this: &mut DebuggerTraceEvent, position: u64) {
        this.backend_message_len = position;
        this.has_backend_message = true;
        transition 0 == 0 {
            _ -> (this)
        }
    }
}

pub machine DebuggerTraceEvent::clear_backend_message(this: &mut DebuggerTraceEvent) {
    this.has_backend_message = false;
    this.backend_message_len = 0;
}

pub machine DebuggerTraceEvent::has_accessed_address(this: &DebuggerTraceEvent) -> bool {
    this.has_accessed_address
}

pub machine DebuggerTraceEvent::get_accessed_address(this: &DebuggerTraceEvent) -> u64 {
    this.accessed_address
}

// Upstream `with_accessed_address` split into set/clear pair.
pub machine DebuggerTraceEvent::set_accessed_address(this: &mut DebuggerTraceEvent, accessed_address: u64) {
    this.accessed_address = accessed_address;
    this.has_accessed_address = true;
}

pub machine DebuggerTraceEvent::clear_accessed_address(this: &mut DebuggerTraceEvent) {
    this.has_accessed_address = false;
}

pub machine DebuggerTraceEvent::clone(this: &DebuggerTraceEvent) -> DebuggerTraceEvent {
    let mut clone: DebuggerTraceEvent = DebuggerTraceEvent::new();
    DebuggerTraceEvent::clone_from(&mut clone, this);
    (clone)
}

pub machine DebuggerTraceEvent::clone_from(this: &mut DebuggerTraceEvent, source: &DebuggerTraceEvent) {
    this.has_breakpoint = source.has_breakpoint;
    DebuggerBreakpointDescriptor::clone_from(&mut this.breakpoint, &source.breakpoint);
    DebuggerRegisterSnapshot::clone_from(&mut this.register_snapshot, &source.register_snapshot);
    this.has_instruction_address = source.has_instruction_address;
    this.instruction_address = source.instruction_address;
    this.instruction_bytes_len = source.instruction_bytes_len;
    this.has_instruction_text = source.has_instruction_text;
    this.instruction_text_len = source.instruction_text_len;
    this.has_target_architecture = source.has_target_architecture;
    this.target_architecture = source.target_architecture;
    this.has_backend_message = source.has_backend_message;
    this.backend_message_len = source.backend_message_len;
    this.has_accessed_address = source.has_accessed_address;
    this.accessed_address = source.accessed_address;
    transition 0 == 0 {
        _ -> copy_bytes(this, source, 0)
    }
    state copy_bytes(this: &mut DebuggerTraceEvent, source: &DebuggerTraceEvent, position: u64) {
        transition position < source.instruction_bytes_len && position < 32 {
            true -> store_byte(this, source, position)
            _ -> copy_text(this, source, 0)
        }
    }
    state store_byte(this: &mut DebuggerTraceEvent, source: &DebuggerTraceEvent, position: u64)
        requires position < source.instruction_bytes_len && position < 32 {
        this.instruction_bytes[position] = source.instruction_bytes[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_bytes(this, source, next)
        }
    }
    state copy_text(this: &mut DebuggerTraceEvent, source: &DebuggerTraceEvent, position: u64) {
        transition position < source.instruction_text_len && position < 256 {
            true -> store_text(this, source, position)
            _ -> copy_message(this, source, 0)
        }
    }
    state store_text(this: &mut DebuggerTraceEvent, source: &DebuggerTraceEvent, position: u64)
        requires position < source.instruction_text_len && position < 256 {
        this.instruction_text[position] = source.instruction_text[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_text(this, source, next)
        }
    }
    state copy_message(this: &mut DebuggerTraceEvent, source: &DebuggerTraceEvent, position: u64) {
        transition position < source.backend_message_len && position < 256 {
            true -> store_message(this, source, position)
            _ -> (this)
        }
    }
    state store_message(this: &mut DebuggerTraceEvent, source: &DebuggerTraceEvent, position: u64)
        requires position < source.backend_message_len && position < 256 {
        this.backend_message[position] = source.backend_message[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_message(this, source, next)
        }
    }
}
