pub machine DebuggerTraceEvent::clone(&self) -> DebuggerTraceEvent {
    let mut clone: DebuggerTraceEvent = DebuggerTraceEvent::new();
    clone.clone_from(self);
    (clone)
}

pub machine DebuggerTraceEvent::clone_from(&mut self, source: &DebuggerTraceEvent) {
    self.has_breakpoint = source.has_breakpoint;
    self.breakpoint.clone_from(&source.breakpoint);
    self.register_snapshot.clone_from(&source.register_snapshot);
    self.has_instruction_address = source.has_instruction_address;
    self.instruction_address = source.instruction_address;
    self.instruction_bytes_len = source.instruction_bytes_len;
    self.has_instruction_text = source.has_instruction_text;
    self.instruction_text_len = source.instruction_text_len;
    self.has_target_architecture = source.has_target_architecture;
    self.target_architecture = source.target_architecture;
    self.has_backend_message = source.has_backend_message;
    self.backend_message_len = source.backend_message_len;
    self.has_accessed_address = source.has_accessed_address;
    self.accessed_address = source.accessed_address;
    transition 0 == 0 {
        _ -> copy_bytes(source, 0)
    }
    state copy_bytes(&mut self, source: &DebuggerTraceEvent, position: u64) {
        transition position < source.instruction_bytes_len && position < 32 {
            true -> store_byte(source, position)
            _ -> copy_text(source, 0)
        }
    }
    state store_byte(&mut self, source: &DebuggerTraceEvent, position: u64)
        requires position < source.instruction_bytes_len && position < 32 {
        self.instruction_bytes[position] = source.instruction_bytes[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_bytes(source, next)
        }
    }
    state copy_text(&mut self, source: &DebuggerTraceEvent, position: u64) {
        transition position < source.instruction_text_len && position < 256 {
            true -> store_text(source, position)
            _ -> copy_message(source, 0)
        }
    }
    state store_text(&mut self, source: &DebuggerTraceEvent, position: u64)
        requires position < source.instruction_text_len && position < 256 {
        self.instruction_text[position] = source.instruction_text[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_text(source, next)
        }
    }
    state copy_message(&mut self, source: &DebuggerTraceEvent, position: u64) {
        transition position < source.backend_message_len && position < 256 {
            true -> store_message(source, position)
            _ -> (self)
        }
    }
    state store_message(&mut self, source: &DebuggerTraceEvent, position: u64)
        requires position < source.backend_message_len && position < 256 {
        self.backend_message[position] = source.backend_message[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_message(source, next)
        }
    }
}
