module src::structures::debugger::debugger_trace_event;

use src::structures::debugger::debugger_breakpoint_descriptor::DebuggerBreakpointDescriptor;
use src::structures::debugger::debugger_breakpoint_kind::DebuggerBreakpointKind;
use src::structures::debugger::debugger_register_snapshot::DebuggerRegisterSnapshot;
use src::structures::memory::bitness::Bitness;
use src::structures::processes::target_architecture::TargetArchitecture;

// Port of structures/debugger/debugger_trace_event.rs — {breakpoint: Option,
// register_snapshot, instruction_address: Option, instruction_bytes,
// instruction_text: Option, target_architecture: Option, backend_message:
// Option, accessed_address: Option}. Option surfaces ride has_ + value;
// instruction_bytes carries a 32-byte bound (a single instruction record).
pub data DebuggerTraceEvent {
    has_breakpoint: bool;
    breakpoint: DebuggerBreakpointDescriptor;
    register_snapshot: DebuggerRegisterSnapshot;
    has_instruction_address: bool;
    instruction_address: u64;
    instruction_bytes: [u8; 32];
    instruction_bytes_len: u64;
    has_instruction_text: bool;
    instruction_text: [u8; 256];
    instruction_text_len: u64;
    has_target_architecture: bool;
    target_architecture: TargetArchitecture;
    has_backend_message: bool;
    backend_message: [u8; 256];
    backend_message_len: u64;
    has_accessed_address: bool;
    accessed_address: u64;
}

pub machine DebuggerTraceEvent::new() -> DebuggerTraceEvent {
    DebuggerTraceEvent {
        has_breakpoint: false,
        breakpoint: DebuggerBreakpointDescriptor::new(0, DebuggerBreakpointKind::Software, false),
        register_snapshot: DebuggerRegisterSnapshot::new(),
        has_instruction_address: false,
        instruction_address: 0,
        instruction_bytes_len: 0,
        has_instruction_text: false,
        instruction_text_len: 0,
        has_target_architecture: false,
        target_architecture: TargetArchitecture::default_for_bitness(Bitness::Bit64),
        has_backend_message: false,
        backend_message_len: 0,
        has_accessed_address: false,
        accessed_address: 0,
    }
}

pub machine DebuggerTraceEvent::has_breakpoint(this: &DebuggerTraceEvent) -> bool {
    this.has_breakpoint
}

pub machine DebuggerTraceEvent::get_breakpoint(this: &DebuggerTraceEvent) -> &DebuggerBreakpointDescriptor {
    (&this.breakpoint)
}

pub machine DebuggerTraceEvent::set_breakpoint(this: &mut DebuggerTraceEvent, breakpoint: DebuggerBreakpointDescriptor) {
    this.breakpoint = breakpoint;
    this.has_breakpoint = true;
}

pub machine DebuggerTraceEvent::clear_breakpoint(this: &mut DebuggerTraceEvent) {
    this.has_breakpoint = false;
}

pub machine DebuggerTraceEvent::get_register_snapshot(this: &DebuggerTraceEvent) -> &DebuggerRegisterSnapshot {
    (&this.register_snapshot)
}

pub machine DebuggerTraceEvent::set_register_snapshot(this: &mut DebuggerTraceEvent, register_snapshot: DebuggerRegisterSnapshot) {
    this.register_snapshot = register_snapshot;
}

pub machine DebuggerTraceEvent::has_instruction_address(this: &DebuggerTraceEvent) -> bool {
    this.has_instruction_address
}

pub machine DebuggerTraceEvent::get_instruction_address(this: &DebuggerTraceEvent) -> u64 {
    this.instruction_address
}

// Upstream `with_instruction_address` split into set/clear pair.
pub machine DebuggerTraceEvent::set_instruction_address(this: &mut DebuggerTraceEvent, instruction_address: u64) {
    this.instruction_address = instruction_address;
    this.has_instruction_address = true;
}

pub machine DebuggerTraceEvent::clear_instruction_address(this: &mut DebuggerTraceEvent) {
    this.has_instruction_address = false;
}

pub machine DebuggerTraceEvent::get_instruction_bytes(this: &DebuggerTraceEvent) -> &[u8] {
    transition this.instruction_bytes_len <= 32 {
        true -> (&this.instruction_bytes[0..this.instruction_bytes_len])
        _ -> (&this.instruction_bytes[0..0])
    }
}

pub machine DebuggerTraceEvent::get_instruction_bytes_len(this: &DebuggerTraceEvent) -> u64 {
    this.instruction_bytes_len
}

pub machine DebuggerTraceEvent::get_instruction_byte(this: &DebuggerTraceEvent, position: u64) -> u8
    requires position < 32 {
    transition position < 32 {
        true -> (this.instruction_bytes[position])
        _ -> (0)
    }
}

pub machine DebuggerTraceEvent::set_instruction_bytes(this: &mut DebuggerTraceEvent, instruction_bytes: &[u8]) {
    transition 0 == 0 {
        _ -> copy_bytes(this, instruction_bytes, 0)
    }
    state copy_bytes(this: &mut DebuggerTraceEvent, instruction_bytes: &[u8], position: u64) {
        transition position < instruction_bytes.len && position < 32 {
            true -> store_byte(this, instruction_bytes, position)
            _ -> done_bytes(this, position)
        }
    }
    state store_byte(this: &mut DebuggerTraceEvent, instruction_bytes: &[u8], position: u64)
        requires position < instruction_bytes.len && position < 32 {
        this.instruction_bytes[position] = instruction_bytes[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_bytes(this, instruction_bytes, next)
        }
    }
    state done_bytes(this: &mut DebuggerTraceEvent, position: u64) {
        this.instruction_bytes_len = position;
        transition 0 == 0 {
            _ -> (this)
        }
    }
}

pub machine DebuggerTraceEvent::has_instruction_text(this: &DebuggerTraceEvent) -> bool {
    this.has_instruction_text
}

pub machine DebuggerTraceEvent::get_instruction_text(this: &DebuggerTraceEvent) -> &[u8] {
    transition this.has_instruction_text && this.instruction_text_len <= 256 {
        true -> (&this.instruction_text[0..this.instruction_text_len])
        _ -> (&this.instruction_text[0..0])
    }
}

pub machine DebuggerTraceEvent::get_instruction_text_len(this: &DebuggerTraceEvent) -> u64 {
    this.instruction_text_len
}

pub machine DebuggerTraceEvent::set_instruction_text(this: &mut DebuggerTraceEvent, instruction_text: &[u8]) {
    transition 0 == 0 {
        _ -> copy_text(this, instruction_text, 0)
    }
    state copy_text(this: &mut DebuggerTraceEvent, instruction_text: &[u8], position: u64) {
        transition position < instruction_text.len && position < 256 {
            true -> store_text(this, instruction_text, position)
            _ -> done_text(this, position)
        }
    }
    state store_text(this: &mut DebuggerTraceEvent, instruction_text: &[u8], position: u64)
        requires position < instruction_text.len && position < 256 {
        this.instruction_text[position] = instruction_text[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_text(this, instruction_text, next)
        }
    }
    state done_text(this: &mut DebuggerTraceEvent, position: u64) {
        this.instruction_text_len = position;
        this.has_instruction_text = true;
        transition 0 == 0 {
            _ -> (this)
        }
    }
}

pub machine DebuggerTraceEvent::clear_instruction_text(this: &mut DebuggerTraceEvent) {
    this.has_instruction_text = false;
    this.instruction_text_len = 0;
}

pub machine DebuggerTraceEvent::has_target_architecture(this: &DebuggerTraceEvent) -> bool {
    this.has_target_architecture
}

pub machine DebuggerTraceEvent::get_target_architecture(this: &DebuggerTraceEvent) -> TargetArchitecture {
    this.target_architecture
}

// Upstream `with_target_architecture`.
pub machine DebuggerTraceEvent::set_target_architecture(this: &mut DebuggerTraceEvent, target_architecture: TargetArchitecture) {
    this.target_architecture = target_architecture;
    this.has_target_architecture = true;
}

pub machine DebuggerTraceEvent::clear_target_architecture(this: &mut DebuggerTraceEvent) {
    this.has_target_architecture = false;
}

pub machine DebuggerTraceEvent::has_backend_message(this: &DebuggerTraceEvent) -> bool {
    this.has_backend_message
}

pub machine DebuggerTraceEvent::get_backend_message(this: &DebuggerTraceEvent) -> &[u8] {
    transition this.has_backend_message && this.backend_message_len <= 256 {
