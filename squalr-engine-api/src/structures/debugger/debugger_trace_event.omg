module src::structures::debugger::debugger_trace_event;
use src::structures::bounded_slice::bounded_slice;
use src::structures::bounded_slice::flagged_bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::debugger::debugger_breakpoint_descriptor::DebuggerBreakpointDescriptor;
use src::structures::debugger::debugger_breakpoint_kind::DebuggerBreakpointKind;
use src::structures::debugger::debugger_register_snapshot::DebuggerRegisterSnapshot;
use src::structures::memory::bitness::Bitness;
use src::structures::processes::target_architecture::TargetArchitecture;

// Port of structures/debugger/debugger_trace_event.rs — {breakpoint: Option,
// register_snapshot, instruction_address: Option, instruction_bytes,
// instruction_text: Option, target_architecture: Option, backend_message:
// Option, accessed_address: Option}. Option surfaces ride has_ + value;
// instruction_bytes carries a 32-byte bound (a single instruction record).
pub data DebuggerTraceEvent {
    has_breakpoint: bool;
    breakpoint: DebuggerBreakpointDescriptor;
    register_snapshot: DebuggerRegisterSnapshot;
    has_instruction_address: bool;
    instruction_address: u64;
    instruction_bytes: [u8; 32];
    instruction_bytes_len: u64;
    has_instruction_text: bool;
    instruction_text: [u8; 256];
    instruction_text_len: u64;
    has_target_architecture: bool;
    target_architecture: TargetArchitecture;
    has_backend_message: bool;
    backend_message: [u8; 256];
    backend_message_len: u64;
    has_accessed_address: bool;
    accessed_address: u64;
}

pub machine DebuggerTraceEvent::new() -> DebuggerTraceEvent {
    DebuggerTraceEvent {
        has_breakpoint: false,
        breakpoint: DebuggerBreakpointDescriptor::new(0, DebuggerBreakpointKind::Software, false),
        register_snapshot: DebuggerRegisterSnapshot::new(),
        has_instruction_address: false,
        instruction_address: 0,
        instruction_bytes_len: 0,
        has_instruction_text: false,
        instruction_text_len: 0,
        has_target_architecture: false,
        target_architecture: TargetArchitecture::default_for_bitness(Bitness::Bit64),
        has_backend_message: false,
        backend_message_len: 0,
        has_accessed_address: false,
        accessed_address: 0,
    }
}

pub machine DebuggerTraceEvent::has_breakpoint(&self) -> bool {
    self.has_breakpoint
}

pub machine DebuggerTraceEvent::get_breakpoint(&self) -> &DebuggerBreakpointDescriptor {
    (&self.breakpoint)
}

pub machine DebuggerTraceEvent::set_breakpoint(&mut self, breakpoint: DebuggerBreakpointDescriptor) {
    self.breakpoint = breakpoint;
    self.has_breakpoint = true;
}

pub machine DebuggerTraceEvent::clear_breakpoint(&mut self) {
    self.has_breakpoint = false;
}

pub machine DebuggerTraceEvent::get_register_snapshot(&self) -> &DebuggerRegisterSnapshot {
    (&self.register_snapshot)
}

pub machine DebuggerTraceEvent::set_register_snapshot(&mut self, register_snapshot: DebuggerRegisterSnapshot) {
    self.register_snapshot = register_snapshot;
}

pub machine DebuggerTraceEvent::has_instruction_address(&self) -> bool {
    self.has_instruction_address
}

pub machine DebuggerTraceEvent::get_instruction_address(&self) -> u64 {
    self.instruction_address
}

// Upstream `with_instruction_address` split into set/clear pair.
pub machine DebuggerTraceEvent::set_instruction_address(&mut self, instruction_address: u64) {
    self.instruction_address = instruction_address;
    self.has_instruction_address = true;
}

pub machine DebuggerTraceEvent::clear_instruction_address(&mut self) {
    self.has_instruction_address = false;
}

pub machine DebuggerTraceEvent::get_instruction_bytes(&self) -> &[u8] {
    (flagged_bounded_slice(&self.instruction_bytes[0..32], self.instruction_bytes_len, self.instruction_bytes_len <= 32))
}

pub machine DebuggerTraceEvent::get_instruction_bytes_len(&self) -> u64 {
    self.instruction_bytes_len
}

pub machine DebuggerTraceEvent::get_instruction_byte(&self, position: u64) -> u8
    requires position < 32 {
    transition position < 32 {
        true -> (self.instruction_bytes[position])
        _ -> (0)
    }
}

pub machine DebuggerTraceEvent::set_instruction_bytes(&mut self, instruction_bytes: &[u8]) {
    self.instruction_bytes_len = BoundedByteCopy::copy(&mut self.instruction_bytes[0..32], instruction_bytes);
}

pub machine DebuggerTraceEvent::has_instruction_text(&self) -> bool {
    self.has_instruction_text
}

pub machine DebuggerTraceEvent::get_instruction_text(&self) -> &[u8] {
    (flagged_bounded_slice(&self.instruction_text[0..256], self.instruction_text_len, self.has_instruction_text && self.instruction_text_len <= 256))
}

pub machine DebuggerTraceEvent::get_instruction_text_len(&self) -> u64 {
    self.instruction_text_len
}

pub machine DebuggerTraceEvent::set_instruction_text(&mut self, instruction_text: &[u8]) {
    self.instruction_text_len = BoundedByteCopy::copy(&mut self.instruction_text[0..256], instruction_text);
    self.has_instruction_text = true;
}

pub machine DebuggerTraceEvent::clear_instruction_text(&mut self) {
    self.has_instruction_text = false;
    self.instruction_text_len = 0;
}

pub machine DebuggerTraceEvent::has_target_architecture(&self) -> bool {
    self.has_target_architecture
}

pub machine DebuggerTraceEvent::get_target_architecture(&self) -> TargetArchitecture {
    self.target_architecture
}

// Upstream `with_target_architecture`.
pub machine DebuggerTraceEvent::set_target_architecture(&mut self, target_architecture: TargetArchitecture) {
    self.target_architecture = target_architecture;
    self.has_target_architecture = true;
}

pub machine DebuggerTraceEvent::clear_target_architecture(&mut self) {
    self.has_target_architecture = false;
}

pub machine DebuggerTraceEvent::has_backend_message(&self) -> bool {
    self.has_backend_message
}

pub machine DebuggerTraceEvent::get_backend_message(&self) -> &[u8] {
    (flagged_bounded_slice(&self.backend_message[0..256], self.backend_message_len, self.has_backend_message && self.backend_message_len <= 256))
}

pub machine DebuggerTraceEvent::get_backend_message_len(&self) -> u64 {
    self.backend_message_len
}

pub machine DebuggerTraceEvent::set_backend_message(&mut self, backend_message: &[u8]) {
    self.backend_message_len = BoundedByteCopy::copy(&mut self.backend_message[0..256], backend_message);
    self.has_backend_message = true;
}

pub machine DebuggerTraceEvent::clear_backend_message(&mut self) {
    self.has_backend_message = false;
    self.backend_message_len = 0;
}

pub machine DebuggerTraceEvent::has_accessed_address(&self) -> bool {
    self.has_accessed_address
}

pub machine DebuggerTraceEvent::get_accessed_address(&self) -> u64 {
    self.accessed_address
}

// Upstream `with_accessed_address` split into set/clear pair.
pub machine DebuggerTraceEvent::set_accessed_address(&mut self, accessed_address: u64) {
    self.accessed_address = accessed_address;
    self.has_accessed_address = true;
}

pub machine DebuggerTraceEvent::clear_accessed_address(&mut self) {
    self.has_accessed_address = false;
}

pub machine DebuggerTraceEvent::clone(&self) -> DebuggerTraceEvent {
    let mut clone: DebuggerTraceEvent = DebuggerTraceEvent::new();
    clone.clone_from(self);
    (clone)
}

pub machine DebuggerTraceEvent::clone_from(&mut self, source: &DebuggerTraceEvent) {
    self.has_breakpoint = source.has_breakpoint;
    self.breakpoint.clone_from(&source.breakpoint);
    self.register_snapshot.clone_from(&source.register_snapshot);
    self.has_instruction_address = source.has_instruction_address;
    self.instruction_address = source.instruction_address;
    self.instruction_bytes_len = source.instruction_bytes_len;
    self.has_instruction_text = source.has_instruction_text;
    self.instruction_text_len = source.instruction_text_len;
    self.has_target_architecture = source.has_target_architecture;
    self.target_architecture = source.target_architecture;
    self.has_backend_message = source.has_backend_message;
    self.backend_message_len = source.backend_message_len;
    self.has_accessed_address = source.has_accessed_address;
    self.accessed_address = source.accessed_address;
    let _: u64 = BoundedByteCopy::copy(&mut self.instruction_bytes[0..32], bounded_slice(&source.instruction_bytes[0..32], source.instruction_bytes_len));
    let _: u64 = BoundedByteCopy::copy(&mut self.instruction_text[0..256], bounded_slice(&source.instruction_text[0..256], source.instruction_text_len));
    let _: u64 = BoundedByteCopy::copy(&mut self.backend_message[0..256], bounded_slice(&source.backend_message[0..256], source.backend_message_len));
}
