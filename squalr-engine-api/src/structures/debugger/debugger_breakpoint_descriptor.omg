module src::structures::debugger::debugger_breakpoint_descriptor;

use src::structures::debugger::debugger_breakpoint_kind::DebuggerBreakpointKind;
use src::structures::debugger::debugger_breakpoint_mechanism::DebuggerBreakpointMechanism;

// Port of structures/debugger/debugger_breakpoint_descriptor.rs —
// {breakpoint_id, address, kind, is_enabled, label: Option, mechanism}.
// Strings ride the bounded [u8; 256] + live-length convention; label is
// upstream's Option<String> via has_label + span.
pub data DebuggerBreakpointDescriptor {
    breakpoint_id: [u8; 256];
    breakpoint_id_len: u64;
    address: u64;
    kind: DebuggerBreakpointKind;
    is_enabled: bool;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
    mechanism: DebuggerBreakpointMechanism;
}

// Upstream `new` — mechanism defaults to Debugger.
pub machine DebuggerBreakpointDescriptor::new(address: u64, kind: DebuggerBreakpointKind, is_enabled: bool) -> DebuggerBreakpointDescriptor {
    DebuggerBreakpointDescriptor {
        breakpoint_id_len: 0,
        address: address,
        kind: kind,
        is_enabled: is_enabled,
        has_label: false,
        label_len: 0,
        mechanism: DebuggerBreakpointMechanism::Debugger,
    }
}

// Upstream `new_memory_patch` — mechanism is MemoryPatch (patch service
// realized breakpoints, the "patch:" id prefix family).
pub machine DebuggerBreakpointDescriptor::new_memory_patch(address: u64, kind: DebuggerBreakpointKind, is_enabled: bool) -> DebuggerBreakpointDescriptor {
    DebuggerBreakpointDescriptor {
        breakpoint_id_len: 0,
        address: address,
        kind: kind,
        is_enabled: is_enabled,
        has_label: false,
        label_len: 0,
        mechanism: DebuggerBreakpointMechanism::MemoryPatch,
    }
}

pub machine DebuggerBreakpointDescriptor::get_breakpoint_id(&self) -> &[u8] {
    transition self.breakpoint_id_len <= 256 {
        true -> (&self.breakpoint_id[0..self.breakpoint_id_len])
        _ -> (&self.breakpoint_id[0..0])
    }
}

pub machine DebuggerBreakpointDescriptor::get_breakpoint_id_len(&self) -> u64 {
    self.breakpoint_id_len
}

pub machine DebuggerBreakpointDescriptor::get_breakpoint_id_byte(&self, position: u64) -> u8
    requires position < 256 {
    transition position < 256 {
        true -> (self.breakpoint_id[position])
        _ -> (0)
    }
}

pub machine DebuggerBreakpointDescriptor::set_breakpoint_id(&mut self, breakpoint_id: &[u8]) {
    transition 0 == 0 {
        _ -> copy_id(breakpoint_id, 0)
    }
    state copy_id(&mut self, breakpoint_id: &[u8], position: u64) {
        transition position < breakpoint_id.len && position < 256 {
            true -> store_id(breakpoint_id, position)
            _ -> done_id(position)
        }
    }
    state store_id(&mut self, breakpoint_id: &[u8], position: u64)
        requires position < breakpoint_id.len && position < 256 {
        self.breakpoint_id[position] = breakpoint_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(breakpoint_id, next)
        }
    }
    state done_id(&mut self, position: u64) {
        self.breakpoint_id_len = position;
        transition 0 == 0 {
            _ -> (self)
        }
    }
}

pub machine DebuggerBreakpointDescriptor::get_address(&self) -> u64 {
    self.address
}

pub machine DebuggerBreakpointDescriptor::set_address(&mut self, address: u64) {
    self.address = address;
}

pub machine DebuggerBreakpointDescriptor::get_kind(&self) -> DebuggerBreakpointKind {
    self.kind
}

pub machine DebuggerBreakpointDescriptor::set_kind(&mut self, kind: DebuggerBreakpointKind) {
    self.kind = kind;
}

pub machine DebuggerBreakpointDescriptor::get_mechanism(&self) -> DebuggerBreakpointMechanism {
    self.mechanism
}

pub machine DebuggerBreakpointDescriptor::get_is_enabled(&self) -> bool {
    self.is_enabled
}

pub machine DebuggerBreakpointDescriptor::set_is_enabled(&mut self, is_enabled: bool) {
    self.is_enabled = is_enabled;
}

pub machine DebuggerBreakpointDescriptor::has_label(&self) -> bool {
    self.has_label
}

pub machine DebuggerBreakpointDescriptor::get_label(&self) -> &[u8] {
    transition self.has_label && self.label_len <= 256 {
        true -> (&self.label[0..self.label_len])
        _ -> (&self.label[0..0])
    }
}

pub machine DebuggerBreakpointDescriptor::get_label_len(&self) -> u64 {
    self.label_len
}

pub machine DebuggerBreakpointDescriptor::get_label_byte(&self, position: u64) -> u8
    requires position < 256 {
    transition position < 256 {
        true -> (self.label[position])
        _ -> (0)
    }
}

pub machine DebuggerBreakpointDescriptor::set_label(&mut self, label: &[u8]) {
    transition 0 == 0 {
        _ -> copy_label(label, 0)
    }
    state copy_label(&mut self, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store_label(label, position)
            _ -> done_label(position)
        }
    }
    state store_label(&mut self, label: &[u8], position: u64)
        requires position < label.len && position < 256 {
        self.label[position] = label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_label(label, next)
        }
    }
    state done_label(&mut self, position: u64) {
        self.label_len = position;
        self.has_label = true;
        transition 0 == 0 {
            _ -> (self)
        }
    }
}

pub machine DebuggerBreakpointDescriptor::clear_label(&mut self) {
    self.has_label = false;
    self.label_len = 0;
}

pub machine DebuggerBreakpointDescriptor::clone(&self) -> DebuggerBreakpointDescriptor {
    let mut clone: DebuggerBreakpointDescriptor = DebuggerBreakpointDescriptor::new(0, DebuggerBreakpointKind::Software, false);
    clone.clone_from(self);
    (clone)
}

pub machine DebuggerBreakpointDescriptor::clone_from(&mut self, source: &DebuggerBreakpointDescriptor) {
    self.breakpoint_id_len = source.breakpoint_id_len;
    self.address = source.address;
    self.kind = source.kind;
    self.is_enabled = source.is_enabled;
    self.has_label = source.has_label;
    self.label_len = source.label_len;
    self.mechanism = source.mechanism;
    transition 0 == 0 {
        _ -> copy_id(source, 0)
    }
    state copy_id(&mut self, source: &DebuggerBreakpointDescriptor, position: u64) {
        transition position < source.breakpoint_id_len && position < 256 {
            true -> store_id(source, position)
            _ -> copy_label(source, 0)
        }
    }
    state store_id(&mut self, source: &DebuggerBreakpointDescriptor, position: u64)
        requires position < source.breakpoint_id_len && position < 256 {
        self.breakpoint_id[position] = source.breakpoint_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(source, next)
        }
    }
    state copy_label(&mut self, source: &DebuggerBreakpointDescriptor, position: u64) {
        transition position < source.label_len && position < 256 {
            true -> store_label(source, position)
            _ -> (self)
        }
    }
    state store_label(&mut self, source: &DebuggerBreakpointDescriptor, position: u64)
        requires position < source.label_len && position < 256 {
        self.label[position] = source.label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_label(source, next)
        }
    }
}
