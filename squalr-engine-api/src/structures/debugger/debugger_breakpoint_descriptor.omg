module src::structures::debugger::debugger_breakpoint_descriptor;

use src::structures::debugger::debugger_breakpoint_kind::DebuggerBreakpointKind;
use src::structures::debugger::debugger_breakpoint_mechanism::DebuggerBreakpointMechanism;

// Port of structures/debugger/debugger_breakpoint_descriptor.rs —
// {breakpoint_id, address, kind, is_enabled, label: Option, mechanism}.
// Strings ride the bounded [u8; 256] + live-length convention; label is
// upstream's Option<String> via has_label + span.
pub data DebuggerBreakpointDescriptor {
    breakpoint_id: [u8; 256];
    breakpoint_id_len: u64;
    address: u64;
    kind: DebuggerBreakpointKind;
    is_enabled: bool;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
    mechanism: DebuggerBreakpointMechanism;
}

// Upstream `new` — mechanism defaults to Debugger.
pub machine DebuggerBreakpointDescriptor::new(address: u64, kind: DebuggerBreakpointKind, is_enabled: bool) -> DebuggerBreakpointDescriptor {
    DebuggerBreakpointDescriptor {
        breakpoint_id_len: 0,
        address: address,
        kind: kind,
        is_enabled: is_enabled,
        has_label: false,
        label_len: 0,
        mechanism: DebuggerBreakpointMechanism::Debugger,
    }
}

// Upstream `new_memory_patch` — mechanism is MemoryPatch (patch service
// realized breakpoints, the "patch:" id prefix family).
pub machine DebuggerBreakpointDescriptor::new_memory_patch(address: u64, kind: DebuggerBreakpointKind, is_enabled: bool) -> DebuggerBreakpointDescriptor {
    DebuggerBreakpointDescriptor {
        breakpoint_id_len: 0,
        address: address,
        kind: kind,
        is_enabled: is_enabled,
        has_label: false,
        label_len: 0,
        mechanism: DebuggerBreakpointMechanism::MemoryPatch,
    }
}

pub machine DebuggerBreakpointDescriptor::get_breakpoint_id(debugger_breakpoint_descriptor: &DebuggerBreakpointDescriptor) -> &[u8] {
    transition debugger_breakpoint_descriptor.breakpoint_id_len <= 256 {
        true -> (&debugger_breakpoint_descriptor.breakpoint_id[0..debugger_breakpoint_descriptor.breakpoint_id_len])
        _ -> (&debugger_breakpoint_descriptor.breakpoint_id[0..0])
    }
}

pub machine DebuggerBreakpointDescriptor::get_breakpoint_id_len(debugger_breakpoint_descriptor: &DebuggerBreakpointDescriptor) -> u64 {
    debugger_breakpoint_descriptor.breakpoint_id_len
}

pub machine DebuggerBreakpointDescriptor::get_breakpoint_id_byte(debugger_breakpoint_descriptor: &DebuggerBreakpointDescriptor, position: u64) -> u8
    requires position < 256 {
    transition position < 256 {
        true -> (debugger_breakpoint_descriptor.breakpoint_id[position])
        _ -> (0)
    }
}

pub machine DebuggerBreakpointDescriptor::set_breakpoint_id(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, breakpoint_id: &[u8]) {
    transition 0 == 0 {
        _ -> copy_id(debugger_breakpoint_descriptor, breakpoint_id, 0)
    }
    state copy_id(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, breakpoint_id: &[u8], position: u64) {
        transition position < breakpoint_id.len && position < 256 {
            true -> store_id(debugger_breakpoint_descriptor, breakpoint_id, position)
            _ -> done_id(debugger_breakpoint_descriptor, position)
        }
    }
    state store_id(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, breakpoint_id: &[u8], position: u64)
        requires position < breakpoint_id.len && position < 256 {
        debugger_breakpoint_descriptor.breakpoint_id[position] = breakpoint_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(debugger_breakpoint_descriptor, breakpoint_id, next)
        }
    }
    state done_id(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, position: u64) {
        debugger_breakpoint_descriptor.breakpoint_id_len = position;
        transition 0 == 0 {
            _ -> (debugger_breakpoint_descriptor)
        }
    }
}

pub machine DebuggerBreakpointDescriptor::get_address(debugger_breakpoint_descriptor: &DebuggerBreakpointDescriptor) -> u64 {
    debugger_breakpoint_descriptor.address
}

pub machine DebuggerBreakpointDescriptor::set_address(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, address: u64) {
    debugger_breakpoint_descriptor.address = address;
}

pub machine DebuggerBreakpointDescriptor::get_kind(debugger_breakpoint_descriptor: &DebuggerBreakpointDescriptor) -> DebuggerBreakpointKind {
    debugger_breakpoint_descriptor.kind
}

pub machine DebuggerBreakpointDescriptor::set_kind(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, kind: DebuggerBreakpointKind) {
    debugger_breakpoint_descriptor.kind = kind;
}

pub machine DebuggerBreakpointDescriptor::get_mechanism(debugger_breakpoint_descriptor: &DebuggerBreakpointDescriptor) -> DebuggerBreakpointMechanism {
    debugger_breakpoint_descriptor.mechanism
}

pub machine DebuggerBreakpointDescriptor::get_is_enabled(debugger_breakpoint_descriptor: &DebuggerBreakpointDescriptor) -> bool {
    debugger_breakpoint_descriptor.is_enabled
}

pub machine DebuggerBreakpointDescriptor::set_is_enabled(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, is_enabled: bool) {
    debugger_breakpoint_descriptor.is_enabled = is_enabled;
}

pub machine DebuggerBreakpointDescriptor::has_label(debugger_breakpoint_descriptor: &DebuggerBreakpointDescriptor) -> bool {
    debugger_breakpoint_descriptor.has_label
}

pub machine DebuggerBreakpointDescriptor::get_label(debugger_breakpoint_descriptor: &DebuggerBreakpointDescriptor) -> &[u8] {
    transition debugger_breakpoint_descriptor.has_label && debugger_breakpoint_descriptor.label_len <= 256 {
        true -> (&debugger_breakpoint_descriptor.label[0..debugger_breakpoint_descriptor.label_len])
        _ -> (&debugger_breakpoint_descriptor.label[0..0])
    }
}

pub machine DebuggerBreakpointDescriptor::get_label_len(debugger_breakpoint_descriptor: &DebuggerBreakpointDescriptor) -> u64 {
    debugger_breakpoint_descriptor.label_len
}

pub machine DebuggerBreakpointDescriptor::get_label_byte(debugger_breakpoint_descriptor: &DebuggerBreakpointDescriptor, position: u64) -> u8
    requires position < 256 {
    transition position < 256 {
        true -> (debugger_breakpoint_descriptor.label[position])
        _ -> (0)
    }
}

pub machine DebuggerBreakpointDescriptor::set_label(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, label: &[u8]) {
    transition 0 == 0 {
        _ -> copy_label(debugger_breakpoint_descriptor, label, 0)
    }
    state copy_label(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store_label(debugger_breakpoint_descriptor, label, position)
            _ -> done_label(debugger_breakpoint_descriptor, position)
        }
    }
    state store_label(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, label: &[u8], position: u64)
        requires position < label.len && position < 256 {
        debugger_breakpoint_descriptor.label[position] = label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_label(debugger_breakpoint_descriptor, label, next)
        }
    }
    state done_label(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, position: u64) {
        debugger_breakpoint_descriptor.label_len = position;
        debugger_breakpoint_descriptor.has_label = true;
        transition 0 == 0 {
            _ -> (debugger_breakpoint_descriptor)
        }
    }
}

pub machine DebuggerBreakpointDescriptor::clear_label(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor) {
    debugger_breakpoint_descriptor.has_label = false;
    debugger_breakpoint_descriptor.label_len = 0;
}

pub machine DebuggerBreakpointDescriptor::clone(debugger_breakpoint_descriptor: &DebuggerBreakpointDescriptor) -> DebuggerBreakpointDescriptor {
    let mut clone: DebuggerBreakpointDescriptor = DebuggerBreakpointDescriptor::new(0, DebuggerBreakpointKind::Software, false);
    DebuggerBreakpointDescriptor::clone_from(&mut clone, debugger_breakpoint_descriptor);
    (clone)
}

pub machine DebuggerBreakpointDescriptor::clone_from(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, source: &DebuggerBreakpointDescriptor) {
    debugger_breakpoint_descriptor.breakpoint_id_len = source.breakpoint_id_len;
    debugger_breakpoint_descriptor.address = source.address;
    debugger_breakpoint_descriptor.kind = source.kind;
    debugger_breakpoint_descriptor.is_enabled = source.is_enabled;
    debugger_breakpoint_descriptor.has_label = source.has_label;
    debugger_breakpoint_descriptor.label_len = source.label_len;
    debugger_breakpoint_descriptor.mechanism = source.mechanism;
    transition 0 == 0 {
        _ -> copy_id(debugger_breakpoint_descriptor, source, 0)
    }
    state copy_id(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, source: &DebuggerBreakpointDescriptor, position: u64) {
        transition position < source.breakpoint_id_len && position < 256 {
            true -> store_id(debugger_breakpoint_descriptor, source, position)
            _ -> copy_label(debugger_breakpoint_descriptor, source, 0)
        }
    }
    state store_id(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, source: &DebuggerBreakpointDescriptor, position: u64)
        requires position < source.breakpoint_id_len && position < 256 {
        debugger_breakpoint_descriptor.breakpoint_id[position] = source.breakpoint_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(debugger_breakpoint_descriptor, source, next)
        }
    }
    state copy_label(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, source: &DebuggerBreakpointDescriptor, position: u64) {
        transition position < source.label_len && position < 256 {
            true -> store_label(debugger_breakpoint_descriptor, source, position)
            _ -> (debugger_breakpoint_descriptor)
        }
    }
    state store_label(debugger_breakpoint_descriptor: &mut DebuggerBreakpointDescriptor, source: &DebuggerBreakpointDescriptor, position: u64)
        requires position < source.label_len && position < 256 {
        debugger_breakpoint_descriptor.label[position] = source.label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_label(debugger_breakpoint_descriptor, source, next)
        }
    }
}
