module src::structures::debugger::debugger_register_snapshot;

use src::structures::debugger::debugger_register_value::DebuggerRegisterValue;

// Port of structures/debugger/debugger_register_snapshot.rs —
// {instruction_pointer: Option, stack_pointer: Option, registers: Vec}.
// The register vector carries a 64-entry bound (upstream is unbounded;
// a process register file is ~40 entries on x64).
pub data DebuggerRegisterSnapshot {
    has_instruction_pointer: bool;
    instruction_pointer: u64;
    has_stack_pointer: bool;
    stack_pointer: u64;
    registers: [DebuggerRegisterValue; 64];
    register_count: u64;
}

pub machine DebuggerRegisterSnapshot::new() -> DebuggerRegisterSnapshot {
    DebuggerRegisterSnapshot {
        has_instruction_pointer: false,
        instruction_pointer: 0,
        has_stack_pointer: false,
        stack_pointer: 0,
        register_count: 0,
    }
}

pub machine DebuggerRegisterSnapshot::has_instruction_pointer(&self) -> bool {
    self.has_instruction_pointer
}

pub machine DebuggerRegisterSnapshot::get_instruction_pointer(&self) -> u64 {
    self.instruction_pointer
}

pub machine DebuggerRegisterSnapshot::set_instruction_pointer(&mut self, instruction_pointer: u64) {
    self.instruction_pointer = instruction_pointer;
    self.has_instruction_pointer = true;
}

pub machine DebuggerRegisterSnapshot::clear_instruction_pointer(&mut self) {
    self.has_instruction_pointer = false;
}

pub machine DebuggerRegisterSnapshot::has_stack_pointer(&self) -> bool {
    self.has_stack_pointer
}

pub machine DebuggerRegisterSnapshot::get_stack_pointer(&self) -> u64 {
    self.stack_pointer
}

pub machine DebuggerRegisterSnapshot::set_stack_pointer(&mut self, stack_pointer: u64) {
    self.stack_pointer = stack_pointer;
    self.has_stack_pointer = true;
}

pub machine DebuggerRegisterSnapshot::clear_stack_pointer(&mut self) {
    self.has_stack_pointer = false;
}

pub machine DebuggerRegisterSnapshot::get_register_count(&self) -> u64 {
    self.register_count
}

pub machine DebuggerRegisterSnapshot::get_register(&self, position: u64) -> &DebuggerRegisterValue
    requires position < 64 {
    (&self.registers[position])
}

// Bounded append — the service fills the snapshot from a backend register
// dump; overflow registers are dropped (documented bound).
pub machine DebuggerRegisterSnapshot::add_register(&mut self, register: &DebuggerRegisterValue) -> bool {
    transition self.register_count < 64 {
        true -> store(register)
        false -> (false)
    }
    state store(&mut self, register: &DebuggerRegisterValue) -> bool {
        self.registers[self.register_count].clone_from(register);
        self.register_count = ((self.register_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

// Upstream register-name lookup for effective-address resolution: case-
// insensitive match, returns the register's value.
pub machine DebuggerRegisterSnapshot::find_register_value(&self, name: &[u8]) -> u64 {
    let value: u64 = 0;
    transition 0 == 0 {
        _ -> scan(name, 0, false, 0)
    }
    state scan(&self, name: &[u8], position: u64, found: bool, value: u64) -> u64 {
        transition position < self.register_count && position < 64 && found == false {
            true -> check(name, position, value)
            _ -> (value)
        }
    }
    state check(&self, name: &[u8], position: u64, value: u64) -> u64 {
        let register: &DebuggerRegisterValue = &self.registers[position];
        let matches: bool = register.get_name_matches_lowercase(name);
        let next: u64 = position + 1;
        transition matches {
            true -> scan(name, next, true, register.value)
            _ -> scan(name, next, false, value)
        }
    }
}

// Whether the lookup hit — the value accessor alone cannot distinguish a
// miss from a zero-valued register.
pub machine DebuggerRegisterSnapshot::has_register_named(&self, name: &[u8]) -> bool {
    transition 0 == 0 {
        _ -> scan(name, 0)
    }
    state scan(&self, name: &[u8], position: u64) -> bool {
        transition position < self.register_count && position < 64 {
            true -> check(name, position)
            _ -> (false)
        }
    }
    state check(&self, name: &[u8], position: u64) -> bool {
        let register: &DebuggerRegisterValue = &self.registers[position];
        let matches: bool = register.get_name_matches_lowercase(name);
        transition matches {
            true -> (true)
            _ -> advance(name, position)
        }
    }
    state advance(&self, name: &[u8], position: u64) -> bool {
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> scan(name, next)
        }
    }
}

pub machine DebuggerRegisterSnapshot::clone(&self) -> DebuggerRegisterSnapshot {
    let mut clone: DebuggerRegisterSnapshot = DebuggerRegisterSnapshot::new();
    clone.clone_from(self);
    (clone)
}

pub machine DebuggerRegisterSnapshot::clone_from(&mut self, source: &DebuggerRegisterSnapshot) {
    self.has_instruction_pointer = source.has_instruction_pointer;
    self.instruction_pointer = source.instruction_pointer;
    self.has_stack_pointer = source.has_stack_pointer;
    self.stack_pointer = source.stack_pointer;
    self.register_count = source.register_count;
    transition 0 == 0 {
        _ -> copy_registers(source, 0)
    }
    state copy_registers(&mut self, source: &DebuggerRegisterSnapshot, position: u64) {
        transition position < source.register_count && position < 64 {
            true -> store(source, position)
            _ -> (self)
        }
    }
    state store(&mut self, source: &DebuggerRegisterSnapshot, position: u64)
        requires position < source.register_count && position < 64 {
        self.registers[position] = source.registers[position].clone();
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_registers(source, next)
        }
    }
}
