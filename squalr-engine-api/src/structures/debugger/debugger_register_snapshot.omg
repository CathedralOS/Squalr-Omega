module src::structures::debugger::debugger_register_snapshot;

use src::structures::debugger::debugger_register_value::DebuggerRegisterValue;

// Port of structures/debugger/debugger_register_snapshot.rs —
// {instruction_pointer: Option, stack_pointer: Option, registers: Vec}.
// The register vector carries a 64-entry bound (upstream is unbounded;
// a process register file is ~40 entries on x64).
pub data DebuggerRegisterSnapshot {
    has_instruction_pointer: bool;
    instruction_pointer: u64;
    has_stack_pointer: bool;
    stack_pointer: u64;
    registers: [DebuggerRegisterValue; 64];
    register_count: u64;
}

pub machine DebuggerRegisterSnapshot::new() -> DebuggerRegisterSnapshot {
    DebuggerRegisterSnapshot {
        has_instruction_pointer: false,
        instruction_pointer: 0,
        has_stack_pointer: false,
        stack_pointer: 0,
        register_count: 0,
    }
}

pub machine DebuggerRegisterSnapshot::has_instruction_pointer(this: &DebuggerRegisterSnapshot) -> bool {
    this.has_instruction_pointer
}

pub machine DebuggerRegisterSnapshot::get_instruction_pointer(this: &DebuggerRegisterSnapshot) -> u64 {
    this.instruction_pointer
}

pub machine DebuggerRegisterSnapshot::set_instruction_pointer(this: &mut DebuggerRegisterSnapshot, instruction_pointer: u64) {
    this.instruction_pointer = instruction_pointer;
    this.has_instruction_pointer = true;
}

pub machine DebuggerRegisterSnapshot::clear_instruction_pointer(this: &mut DebuggerRegisterSnapshot) {
    this.has_instruction_pointer = false;
}

pub machine DebuggerRegisterSnapshot::has_stack_pointer(this: &DebuggerRegisterSnapshot) -> bool {
    this.has_stack_pointer
}

pub machine DebuggerRegisterSnapshot::get_stack_pointer(this: &DebuggerRegisterSnapshot) -> u64 {
    this.stack_pointer
}

pub machine DebuggerRegisterSnapshot::set_stack_pointer(this: &mut DebuggerRegisterSnapshot, stack_pointer: u64) {
    this.stack_pointer = stack_pointer;
    this.has_stack_pointer = true;
}

pub machine DebuggerRegisterSnapshot::clear_stack_pointer(this: &mut DebuggerRegisterSnapshot) {
    this.has_stack_pointer = false;
}

pub machine DebuggerRegisterSnapshot::get_register_count(this: &DebuggerRegisterSnapshot) -> u64 {
    this.register_count
}

pub machine DebuggerRegisterSnapshot::get_register(this: &DebuggerRegisterSnapshot, position: u64) -> &DebuggerRegisterValue
    requires position < 64 {
    (&this.registers[position])
}

// Bounded append — the service fills the snapshot from a backend register
// dump; overflow registers are dropped (documented bound).
pub machine DebuggerRegisterSnapshot::add_register(this: &mut DebuggerRegisterSnapshot, register: &DebuggerRegisterValue) -> bool {
    transition this.register_count < 64 {
        true -> store(this, register)
        false -> (false)
    }
    state store(this: &mut DebuggerRegisterSnapshot, register: &DebuggerRegisterValue) -> bool {
        DebuggerRegisterValue::clone_from(&mut this.registers[this.register_count], register);
        this.register_count = ((this.register_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

// Upstream register-name lookup for effective-address resolution: case-
// insensitive match, returns the register's value.
pub machine DebuggerRegisterSnapshot::find_register_value(this: &DebuggerRegisterSnapshot, name: &[u8]) -> u64 {
    let value: u64 = 0;
    transition 0 == 0 {
        _ -> scan(this, name, 0, false, 0)
    }
    state scan(this: &DebuggerRegisterSnapshot, name: &[u8], position: u64, found: bool, value: u64) -> u64 {
        transition position < this.register_count && position < 64 && found == false {
            true -> check(this, name, position, value)
            _ -> (value)
        }
    }
    state check(this: &DebuggerRegisterSnapshot, name: &[u8], position: u64, value: u64) -> u64 {
        let register: &DebuggerRegisterValue = &this.registers[position];
        let matches: bool = DebuggerRegisterValue::get_name_matches_lowercase(&register, name);
        let next: u64 = position + 1;
        transition matches {
            true -> scan(this, name, next, true, register.value)
            _ -> scan(this, name, next, false, value)
        }
    }
}

// Whether the lookup hit — the value accessor alone cannot distinguish a
// miss from a zero-valued register.
pub machine DebuggerRegisterSnapshot::has_register_named(this: &DebuggerRegisterSnapshot, name: &[u8]) -> bool {
    transition 0 == 0 {
        _ -> scan(this, name, 0)
    }
    state scan(this: &DebuggerRegisterSnapshot, name: &[u8], position: u64) -> bool {
        transition position < this.register_count && position < 64 {
            true -> check(this, name, position)
            _ -> (false)
        }
    }
    state check(this: &DebuggerRegisterSnapshot, name: &[u8], position: u64) -> bool {
        let register: &DebuggerRegisterValue = &this.registers[position];
        let matches: bool = DebuggerRegisterValue::get_name_matches_lowercase(&register, name);
        transition matches {
            true -> (true)
            _ -> advance(this, name, position)
        }
    }
    state advance(this: &DebuggerRegisterSnapshot, name: &[u8], position: u64) -> bool {
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> scan(this, name, next)
        }
    }
}

pub machine DebuggerRegisterSnapshot::clone(this: &DebuggerRegisterSnapshot) -> DebuggerRegisterSnapshot {
    let mut clone: DebuggerRegisterSnapshot = DebuggerRegisterSnapshot::new();
    DebuggerRegisterSnapshot::clone_from(&mut clone, this);
    (clone)
}

pub machine DebuggerRegisterSnapshot::clone_from(this: &mut DebuggerRegisterSnapshot, source: &DebuggerRegisterSnapshot) {
    this.has_instruction_pointer = source.has_instruction_pointer;
    this.instruction_pointer = source.instruction_pointer;
    this.has_stack_pointer = source.has_stack_pointer;
    this.stack_pointer = source.stack_pointer;
    this.register_count = source.register_count;
    transition 0 == 0 {
        _ -> copy_registers(this, source, 0)
    }
    state copy_registers(this: &mut DebuggerRegisterSnapshot, source: &DebuggerRegisterSnapshot, position: u64) {
        transition position < source.register_count && position < 64 {
            true -> store(this, source, position)
            _ -> (this)
        }
    }
    state store(this: &mut DebuggerRegisterSnapshot, source: &DebuggerRegisterSnapshot, position: u64)
        requires position < source.register_count && position < 64 {
        this.registers[position] = DebuggerRegisterValue::clone(&source.registers[position]);
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_registers(this, source, next)
        }
    }
}
