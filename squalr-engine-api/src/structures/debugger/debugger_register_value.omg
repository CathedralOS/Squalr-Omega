module src::structures::debugger::debugger_register_value;

// Port of structures/debugger/debugger_register_value.rs — {name, value,
// bit_width}. name rides the bounded span; bit_width is upstream u16 carried
// as u64 per the toolchain's payload-width convention.
pub data DebuggerRegisterValue {
    name: [u8; 64];
    name_len: u64;
    value: u64;
    bit_width: u64;
}

pub machine DebuggerRegisterValue::new(value: u64, bit_width: u64) -> DebuggerRegisterValue {
    DebuggerRegisterValue {
        name_len: 0,
        value: value,
        bit_width: bit_width,
    }
}

pub machine DebuggerRegisterValue::get_name(this: &DebuggerRegisterValue) -> &[u8] {
    transition this.name_len <= 64 {
        true -> (&this.name[0..this.name_len])
        _ -> (&this.name[0..0])
    }
}

pub machine DebuggerRegisterValue::get_name_len(this: &DebuggerRegisterValue) -> u64 {
    this.name_len
}

pub machine DebuggerRegisterValue::get_name_byte(this: &DebuggerRegisterValue, position: u64) -> u8
    requires position < 64 {
    transition position < 64 {
        true -> (this.name[position])
        _ -> (0)
    }
}

pub machine DebuggerRegisterValue::set_name(this: &mut DebuggerRegisterValue, name: &[u8]) {
    transition 0 == 0 {
        _ -> copy_name(this, 0, name)
    }
    state copy_name(this: &mut DebuggerRegisterValue, position: u64, name: &[u8]) {
        transition position < name.len && position < 64 {
            true -> store_name(this, position, name)
            _ -> done_name(this, position)
        }
    }
    state store_name(this: &mut DebuggerRegisterValue, position: u64, name: &[u8])
        requires position < name.len && position < 64 {
        this.name[position] = name[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_name(this, next, name)
        }
    }
    state done_name(this: &mut DebuggerRegisterValue, position: u64) {
        this.name_len = position;
        transition 0 == 0 {
            _ -> (this)
        }
    }
}

// Case-insensitive name compare against a spelled byte span — the service's
// register lookup needs lowercase-insensitive equality (upstream
// to_ascii_lowercase on both sides). ASCII A-Z folds by +32 per side.
pub machine DebuggerRegisterValue::get_name_matches_lowercase(this: &DebuggerRegisterValue, name: &[u8]) -> bool {
    transition 0 == 0 {
        _ -> compare(this, name, 0, true)
    }
    state compare(this: &DebuggerRegisterValue, name: &[u8], position: u64, still_matching: bool) -> bool {
        transition position < name.len && position < this.name_len && position < 64 {
            true -> read_bytes(this, name, position, still_matching)
            _ -> finish(this, name, position, still_matching)
        }
    }
    state read_bytes(this: &DebuggerRegisterValue, name: &[u8], position: u64, still_matching: bool) -> bool {
        let self_byte: u8 = this.name[position];
        let other_byte: u8 = name[position];
        transition 0 == 0 {
            _ -> fold_self(this, self_byte, other_byte, name, position, still_matching)
        }
    }
    state fold_self(this: &DebuggerRegisterValue, self_byte: u8, other_byte: u8, name: &[u8], position: u64, still_matching: bool) -> bool {
        let self_folded: u8 = ((self_byte as u8 in Wrapping) + (32 as u8 in Wrapping)) as u8;
        transition self_byte >= 65 && self_byte <= 90 {
            true -> fold_other(this, self_folded, other_byte, name, position, still_matching)
            _ -> fold_other(this, self_byte, other_byte, name, position, still_matching)
        }
    }
    state fold_other(this: &DebuggerRegisterValue, self_lower: u8, other_byte: u8, name: &[u8], position: u64, still_matching: bool) -> bool {
        let other_folded: u8 = ((other_byte as u8 in Wrapping) + (32 as u8 in Wrapping)) as u8;
        transition other_byte >= 65 && other_byte <= 90 {
            true -> compare_byte(this, self_lower, other_folded, name, position, still_matching)
            _ -> compare_byte(this, self_lower, other_byte, name, position, still_matching)
        }
    }
    state compare_byte(this: &DebuggerRegisterValue, self_lower: u8, other_lower: u8, name: &[u8], position: u64, still_matching: bool) -> bool {
        let next: u64 = position + 1;
        transition self_lower == other_lower {
            true -> compare(this, name, next, still_matching)
            _ -> compare(this, name, next, false)
        }
    }
    state finish(this: &DebuggerRegisterValue, name: &[u8], position: u64, still_matching: bool) -> bool {
        transition position == name.len && position == this.name_len && still_matching {
            true -> (true)
            _ -> (false)
        }
    }
}

pub machine DebuggerRegisterValue::get_value(this: &DebuggerRegisterValue) -> u64 {
    this.value
}

pub machine DebuggerRegisterValue::set_value(this: &mut DebuggerRegisterValue, value: u64) {
    this.value = value;
}

pub machine DebuggerRegisterValue::get_bit_width(this: &DebuggerRegisterValue) -> u64 {
    this.bit_width
}

pub machine DebuggerRegisterValue::clone(this: &DebuggerRegisterValue) -> DebuggerRegisterValue {
    let mut clone: DebuggerRegisterValue = DebuggerRegisterValue::new(this.value, this.bit_width);
    DebuggerRegisterValue::set_name(&mut clone, DebuggerRegisterValue::get_name(this));
    (clone)
}

pub machine DebuggerRegisterValue::clone_from(this: &mut DebuggerRegisterValue, source: &DebuggerRegisterValue) {
    this.value = source.value;
    this.bit_width = source.bit_width;
    this.name_len = source.name_len;
    transition 0 == 0 {
        _ -> copy_name(this, source, 0)
    }
    state copy_name(this: &mut DebuggerRegisterValue, source: &DebuggerRegisterValue, position: u64) {
        transition position < source.name_len && position < 64 {
            true -> store_name(this, source, position)
            _ -> (this)
        }
    }
    state store_name(this: &mut DebuggerRegisterValue, source: &DebuggerRegisterValue, position: u64)
        requires position < source.name_len && position < 64 {
        this.name[position] = source.name[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_name(this, source, next)
        }
    }
}
