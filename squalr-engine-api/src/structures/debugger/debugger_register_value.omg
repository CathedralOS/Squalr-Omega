module src::structures::debugger::debugger_register_value;
use src::structures::bounded_slice::bounded_slice;
use src::structures::bounded_slice::flagged_bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of structures/debugger/debugger_register_value.rs — {name, value,
// bit_width}. name rides the bounded span; bit_width is upstream u16 carried
// as u64 per the toolchain's payload-width convention.
pub data DebuggerRegisterValue {
    name: [u8; 64];
    name_len: u64;
    value: u64;
    bit_width: u64;
}

pub machine DebuggerRegisterValue::new(value: u64, bit_width: u64) -> DebuggerRegisterValue {
    DebuggerRegisterValue {
        name_len: 0,
        value: value,
        bit_width: bit_width,
    }
}

pub machine DebuggerRegisterValue::get_name(&self) -> &[u8] {
    (flagged_bounded_slice(&self.name[0..64], self.name_len, self.name_len <= 64))
}

pub machine DebuggerRegisterValue::get_name_len(&self) -> u64 {
    self.name_len
}

pub machine DebuggerRegisterValue::get_name_byte(&self, position: u64) -> u8
    requires position < 64 {
    transition position < 64 {
        true -> (self.name[position])
        _ -> (0)
    }
}

pub machine DebuggerRegisterValue::set_name(&mut self, name: &[u8]) {
    self.name_len = BoundedByteCopy::copy(&mut self.name[0..64], name);
}

// Case-insensitive name compare against a spelled byte span — the service's
// register lookup needs lowercase-insensitive equality (upstream
// to_ascii_lowercase on both sides). ASCII A-Z folds by +32 per side.
pub machine DebuggerRegisterValue::get_name_matches_lowercase(&self, name: &[u8]) -> bool {
    transition 0 == 0 {
        _ -> compare(name, 0, true)
    }
    state compare(&self, name: &[u8], position: u64, still_matching: bool) -> bool {
        transition position < name.len && position < self.name_len && position < 64 {
            true -> read_bytes(name, position, still_matching)
            _ -> finish(name, position, still_matching)
        }
    }
    state read_bytes(&self, name: &[u8], position: u64, still_matching: bool) -> bool {
        let self_byte: u8 = self.name[position];
        let other_byte: u8 = name[position];
        transition 0 == 0 {
            _ -> fold_self(self_byte, other_byte, name, position, still_matching)
        }
    }
    state fold_self(&self, self_byte: u8, other_byte: u8, name: &[u8], position: u64, still_matching: bool) -> bool {
        let self_folded: u8 = ((self_byte as u8 in Wrapping) + (32 as u8 in Wrapping)) as u8;
        transition self_byte >= 65 && self_byte <= 90 {
            true -> fold_other(self_folded, other_byte, name, position, still_matching)
            _ -> fold_other(self_byte, other_byte, name, position, still_matching)
        }
    }
    state fold_other(&self, self_lower: u8, other_byte: u8, name: &[u8], position: u64, still_matching: bool) -> bool {
        let other_folded: u8 = ((other_byte as u8 in Wrapping) + (32 as u8 in Wrapping)) as u8;
        transition other_byte >= 65 && other_byte <= 90 {
            true -> compare_byte(self_lower, other_folded, name, position, still_matching)
            _ -> compare_byte(self_lower, other_byte, name, position, still_matching)
        }
    }
    state compare_byte(&self, self_lower: u8, other_lower: u8, name: &[u8], position: u64, still_matching: bool) -> bool {
        let next: u64 = position + 1;
        transition self_lower == other_lower {
            true -> compare(name, next, still_matching)
            _ -> compare(name, next, false)
        }
    }
    state finish(&self, name: &[u8], position: u64, still_matching: bool) -> bool {
        transition position == name.len && position == self.name_len && still_matching {
            true -> (true)
            _ -> (false)
        }
    }
}

pub machine DebuggerRegisterValue::get_value(&self) -> u64 {
    self.value
}

pub machine DebuggerRegisterValue::set_value(&mut self, value: u64) {
    self.value = value;
}

pub machine DebuggerRegisterValue::get_bit_width(&self) -> u64 {
    self.bit_width
}

pub machine DebuggerRegisterValue::clone(&self) -> DebuggerRegisterValue {
    let mut clone: DebuggerRegisterValue = DebuggerRegisterValue::new(self.value, self.bit_width);
    clone.set_name(self.get_name());
    (clone)
}

pub machine DebuggerRegisterValue::clone_from(&mut self, source: &DebuggerRegisterValue) {
    self.value = source.value;
    self.bit_width = source.bit_width;
    self.name_len = source.name_len;
    let _: u64 = BoundedByteCopy::copy(&mut self.name[0..64], bounded_slice(&source.name[0..64], source.name_len));
}
