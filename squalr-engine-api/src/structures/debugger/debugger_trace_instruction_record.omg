pub machine DebuggerTraceInstructionRecord::set_last_backend_message(this: &mut DebuggerTraceInstructionRecord, backend_message: &[u8]) {
    transition 0 == 0 {
        _ -> copy_message(this, backend_message, 0)
    }
    state copy_message(this: &mut DebuggerTraceInstructionRecord, backend_message: &[u8], position: u64) {
        transition position < backend_message.len && position < 256 {
            true -> store_message(this, backend_message, position)
