module src::structures::debugger::debugger_trace_instruction_record;
use src::structures::bounded_slice::bounded_slice;
use src::structures::bounded_slice::flagged_bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::debugger::debugger_register_snapshot::DebuggerRegisterSnapshot;
use src::structures::debugger::debugger_trace_event::DebuggerTraceEvent;
use src::structures::memory::bitness::Bitness;
use src::structures::processes::target_architecture::TargetArchitecture;

// Port of structures/debugger/debugger_trace_instruction_record.rs —
// {trace_session_id, instruction_address: Option, instruction_bytes,
// instruction_text: Option, target_architecture: Option, hit_count,
// last_register_snapshot, last_backend_message: Option, accessed_address:
// Option}. new() copies the trace event's fields; record_hit refreshes them.
pub data DebuggerTraceInstructionRecord {
    trace_session_id: [u8; 64];
    trace_session_id_len: u64;
    has_instruction_address: bool;
    instruction_address: u64;
    instruction_bytes: [u8; 32];
    instruction_bytes_len: u64;
    has_instruction_text: bool;
    instruction_text: [u8; 256];
    instruction_text_len: u64;
    has_target_architecture: bool;
    target_architecture: TargetArchitecture;
    hit_count: u64;
    last_register_snapshot: DebuggerRegisterSnapshot;
    has_last_backend_message: bool;
    last_backend_message: [u8; 256];
    last_backend_message_len: u64;
    has_accessed_address: bool;
    accessed_address: u64;
}

// Upstream `new(trace_session_id, trace_event)` — id copied by the caller
// (set_trace_session_id) since the port's spans need an explicit copy.
pub machine DebuggerTraceInstructionRecord::new(trace_event: &DebuggerTraceEvent) -> DebuggerTraceInstructionRecord {
    let mut record: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord {
        trace_session_id_len: 0,
        has_instruction_address: trace_event.has_instruction_address,
        instruction_address: trace_event.instruction_address,
        instruction_bytes_len: 0,
        has_instruction_text: trace_event.has_instruction_text,
        instruction_text_len: 0,
        has_target_architecture: trace_event.has_target_architecture,
        target_architecture: trace_event.target_architecture,
        hit_count: 1,
        last_register_snapshot: trace_event.register_snapshot.clone(),
        has_last_backend_message: trace_event.has_backend_message,
        last_backend_message_len: 0,
        has_accessed_address: trace_event.has_accessed_address,
        accessed_address: trace_event.accessed_address,
    };
    record.set_instruction_bytes(trace_event.get_instruction_bytes());
    record.set_instruction_text(trace_event.get_instruction_text());
    record.set_last_backend_message(trace_event.get_backend_message());
    (record)
}

// Upstream `record_hit` — bump + refresh from the latest event.
pub machine DebuggerTraceInstructionRecord::record_hit(&mut self, trace_event: &DebuggerTraceEvent) {
    self.hit_count = ((self.hit_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    self.has_instruction_address = trace_event.has_instruction_address;
    self.instruction_address = trace_event.instruction_address;
    self.has_instruction_text = trace_event.has_instruction_text;
    self.has_target_architecture = trace_event.has_target_architecture;
    self.target_architecture = trace_event.target_architecture;
    self.last_register_snapshot.clone_from(&trace_event.register_snapshot);
    self.has_last_backend_message = trace_event.has_backend_message;
    self.has_accessed_address = trace_event.has_accessed_address;
    self.accessed_address = trace_event.accessed_address;
    self.set_instruction_bytes(trace_event.get_instruction_bytes());
    self.set_instruction_text(trace_event.get_instruction_text());
    self.set_last_backend_message(trace_event.get_backend_message());
}

pub machine DebuggerTraceInstructionRecord::get_trace_session_id(&self) -> &[u8] {
    (flagged_bounded_slice(&self.trace_session_id[0..64], self.trace_session_id_len, self.trace_session_id_len <= 64))
}

pub machine DebuggerTraceInstructionRecord::get_trace_session_id_len(&self) -> u64 {
    self.trace_session_id_len
}

pub machine DebuggerTraceInstructionRecord::set_trace_session_id(&mut self, trace_session_id: &[u8]) {
    self.trace_session_id_len = BoundedByteCopy::copy(&mut self.trace_session_id[0..64], trace_session_id);
}

pub machine DebuggerTraceInstructionRecord::has_instruction_address(&self) -> bool {
    self.has_instruction_address
}

pub machine DebuggerTraceInstructionRecord::get_instruction_address(&self) -> u64 {
    self.instruction_address
}

pub machine DebuggerTraceInstructionRecord::get_instruction_bytes(&self) -> &[u8] {
    (flagged_bounded_slice(&self.instruction_bytes[0..32], self.instruction_bytes_len, self.instruction_bytes_len <= 32))
}

pub machine DebuggerTraceInstructionRecord::get_instruction_bytes_len(&self) -> u64 {
    self.instruction_bytes_len
}

pub machine DebuggerTraceInstructionRecord::get_instruction_byte(&self, position: u64) -> u8
    requires position < 32 {
    transition position < 32 {
        true -> (self.instruction_bytes[position])
        _ -> (0)
    }
}

pub machine DebuggerTraceInstructionRecord::set_instruction_bytes(&mut self, instruction_bytes: &[u8]) {
    self.instruction_bytes_len = BoundedByteCopy::copy(&mut self.instruction_bytes[0..32], instruction_bytes);
}

// Byte-equal compare — the address-directed dedupe keys on
// (instruction_address, instruction_bytes).
pub machine DebuggerTraceInstructionRecord::get_instruction_bytes_match(&self, instruction_bytes: &[u8]) -> bool {
    transition self.instruction_bytes_len == instruction_bytes.len {
        true -> compare(instruction_bytes, 0)
        _ -> (false)
    }
    state compare(&self, instruction_bytes: &[u8], position: u64) -> bool {
        transition position < instruction_bytes.len && position < 32 {
            true -> check(instruction_bytes, position)
            _ -> (true)
        }
    }
    state check(&self, instruction_bytes: &[u8], position: u64) -> bool
        requires position < instruction_bytes.len && position < 32 {
        let next: u64 = position + 1;
        transition self.instruction_bytes[position] == instruction_bytes[position] {
            true -> compare(instruction_bytes, next)
            _ -> (false)
        }
    }
}

pub machine DebuggerTraceInstructionRecord::has_instruction_text(&self) -> bool {
    self.has_instruction_text
}

pub machine DebuggerTraceInstructionRecord::get_instruction_text(&self) -> &[u8] {
    (flagged_bounded_slice(&self.instruction_text[0..256], self.instruction_text_len, self.has_instruction_text && self.instruction_text_len <= 256))
}

pub machine DebuggerTraceInstructionRecord::get_instruction_text_len(&self) -> u64 {
    self.instruction_text_len
}

pub machine DebuggerTraceInstructionRecord::set_instruction_text(&mut self, instruction_text: &[u8]) {
    self.instruction_text_len = BoundedByteCopy::copy(&mut self.instruction_text[0..256], instruction_text);
}

pub machine DebuggerTraceInstructionRecord::has_target_architecture(&self) -> bool {
    self.has_target_architecture
}

pub machine DebuggerTraceInstructionRecord::get_target_architecture(&self) -> TargetArchitecture {
    self.target_architecture
}

pub machine DebuggerTraceInstructionRecord::get_hit_count(&self) -> u64 {
    self.hit_count
}

pub machine DebuggerTraceInstructionRecord::get_last_register_snapshot(&self) -> &DebuggerRegisterSnapshot {
    (&self.last_register_snapshot)
}

pub machine DebuggerTraceInstructionRecord::has_last_backend_message(&self) -> bool {
    self.has_last_backend_message
}

pub machine DebuggerTraceInstructionRecord::get_last_backend_message(&self) -> &[u8] {
    (flagged_bounded_slice(&self.last_backend_message[0..256], self.last_backend_message_len, self.has_last_backend_message && self.last_backend_message_len <= 256))
}

pub machine DebuggerTraceInstructionRecord::get_last_backend_message_len(&self) -> u64 {
    self.last_backend_message_len
}

pub machine DebuggerTraceInstructionRecord::set_last_backend_message(&mut self, backend_message: &[u8]) {
    self.last_backend_message_len = BoundedByteCopy::copy(&mut self.last_backend_message[0..256], backend_message);
}

pub machine DebuggerTraceInstructionRecord::has_accessed_address(&self) -> bool {
    self.has_accessed_address
}

pub machine DebuggerTraceInstructionRecord::get_accessed_address(&self) -> u64 {
    self.accessed_address
}

// Empty shell for clone/clone_from — all spans zero-length, defaults as in
// upstream Default-adjacent construction.
pub machine DebuggerTraceInstructionRecord::empty() -> DebuggerTraceInstructionRecord {
    DebuggerTraceInstructionRecord {
        trace_session_id_len: 0,
        has_instruction_address: false,
        instruction_address: 0,
        instruction_bytes_len: 0,
        has_instruction_text: false,
        instruction_text_len: 0,
        has_target_architecture: false,
        target_architecture: TargetArchitecture::default_for_bitness(Bitness::Bit64),
        hit_count: 0,
        last_register_snapshot: DebuggerRegisterSnapshot::new(),
        has_last_backend_message: false,
        last_backend_message_len: 0,
        has_accessed_address: false,
        accessed_address: 0,
    }
}

pub machine DebuggerTraceInstructionRecord::clone(&self) -> DebuggerTraceInstructionRecord {
    let mut clone: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord::empty();
    clone.clone_from(self);
    (clone)
}

pub machine DebuggerTraceInstructionRecord::clone_from(&mut self, source: &DebuggerTraceInstructionRecord) {
    self.trace_session_id_len = source.trace_session_id_len;
    self.has_instruction_address = source.has_instruction_address;
    self.instruction_address = source.instruction_address;
    self.instruction_bytes_len = source.instruction_bytes_len;
    self.has_instruction_text = source.has_instruction_text;
    self.instruction_text_len = source.instruction_text_len;
    self.has_target_architecture = source.has_target_architecture;
    self.target_architecture = source.target_architecture;
    self.hit_count = source.hit_count;
    self.last_register_snapshot.clone_from(&source.last_register_snapshot);
    self.has_last_backend_message = source.has_last_backend_message;
    self.last_backend_message_len = source.last_backend_message_len;
    self.has_accessed_address = source.has_accessed_address;
    self.accessed_address = source.accessed_address;
    let mut copied: u64 = BoundedByteCopy::copy(&mut self.trace_session_id[0..64], bounded_slice(&source.trace_session_id[0..64], source.trace_session_id_len));
    copied = BoundedByteCopy::copy(&mut self.instruction_bytes[0..32], bounded_slice(&source.instruction_bytes[0..32], source.instruction_bytes_len));
    copied = BoundedByteCopy::copy(&mut self.instruction_text[0..256], bounded_slice(&source.instruction_text[0..256], source.instruction_text_len));
    copied = BoundedByteCopy::copy(&mut self.last_backend_message[0..256], bounded_slice(&source.last_backend_message[0..256], source.last_backend_message_len));
}
