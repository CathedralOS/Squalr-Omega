    state store_message(this: &mut DebuggerTraceInstructionRecord, backend_message: &[u8], position: u64)
        requires position < backend_message.len && position < 256 {
        this.last_backend_message[position] = backend_message[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_message(this, backend_message, next)
        }
    }
    state done_message(this: &mut DebuggerTraceInstructionRecord, position: u64) {
        this.last_backend_message_len = position;
        transition 0 == 0 {
            _ -> (this)
        }
    }
}

