// Empty shell for clone/clone_from — all spans zero-length, defaults as in
// upstream Default-adjacent construction.
pub machine DebuggerTraceInstructionRecord::empty() -> DebuggerTraceInstructionRecord {
    DebuggerTraceInstructionRecord {
        trace_session_id_len: 0,
        has_instruction_address: false,
        instruction_address: 0,
        instruction_bytes_len: 0,
        has_instruction_text: false,
        instruction_text_len: 0,
        has_target_architecture: false,
        target_architecture: TargetArchitecture::default_for_bitness(Bitness::Bit64),
        hit_count: 0,
        last_register_snapshot: DebuggerRegisterSnapshot::new(),
        has_last_backend_message: false,
        last_backend_message_len: 0,
        has_accessed_address: false,
        accessed_address: 0,
    }
}

pub machine DebuggerTraceInstructionRecord::clone(this: &DebuggerTraceInstructionRecord) -> DebuggerTraceInstructionRecord {
    let mut clone: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord::empty();
    DebuggerTraceInstructionRecord::clone_from(&mut clone, this);
    (clone)
}

pub machine DebuggerTraceInstructionRecord::clone_from(this: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord) {
    this.trace_session_id_len = source.trace_session_id_len;
    this.has_instruction_address = source.has_instruction_address;
    this.instruction_address = source.instruction_address;
    this.instruction_bytes_len = source.instruction_bytes_len;
    this.has_instruction_text = source.has_instruction_text;
    this.instruction_text_len = source.instruction_text_len;
    this.has_target_architecture = source.has_target_architecture;
    this.target_architecture = source.target_architecture;
    this.hit_count = source.hit_count;
    DebuggerRegisterSnapshot::clone_from(&mut this.last_register_snapshot, &source.last_register_snapshot);
    this.has_last_backend_message = source.has_last_backend_message;
    this.last_backend_message_len = source.last_backend_message_len;
    this.has_accessed_address = source.has_accessed_address;
    this.accessed_address = source.accessed_address;
    transition 0 == 0 {
        _ -> copy_id(this, source, 0)
    }
    state copy_id(this: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64) {
        transition position < source.trace_session_id_len && position < 64 {
            true -> store_id(this, source, position)
            _ -> copy_bytes(this, source, 0)
        }
    }
    state store_id(this: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64)
        requires position < source.trace_session_id_len && position < 64 {
        this.trace_session_id[position] = source.trace_session_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(this, source, next)
        }
    }
    state copy_bytes(this: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64) {
        transition position < source.instruction_bytes_len && position < 32 {
            true -> store_byte(this, source, position)
            _ -> copy_text(this, source, 0)
        }
    }
    state store_byte(this: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64)
        requires position < source.instruction_bytes_len && position < 32 {
        this.instruction_bytes[position] = source.instruction_bytes[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_bytes(this, source, next)
        }
    }
    state copy_text(this: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64) {
        transition position < source.instruction_text_len && position < 256 {
            true -> store_text(this, source, position)
            _ -> copy_message(this, source, 0)
        }
    }
    state store_text(this: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64)
        requires position < source.instruction_text_len && position < 256 {
        this.instruction_text[position] = source.instruction_text[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_text(this, source, next)
        }
    }
    state copy_message(this: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64) {
        transition position < source.last_backend_message_len && position < 256 {
            true -> store_message(this, source, position)
            _ -> (this)
        }
    }
    state store_message(this: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64)
        requires position < source.last_backend_message_len && position < 256 {
        this.last_backend_message[position] = source.last_backend_message[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_message(this, source, next)
        }
    }
}
