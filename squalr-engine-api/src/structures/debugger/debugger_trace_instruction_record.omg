pub machine DebuggerTraceInstructionRecord::get_instruction_byte(debugger_trace_instruction_record: &DebuggerTraceInstructionRecord, position: u64) -> u8
    requires position < 32 {
    transition position < 32 {
        true -> (debugger_trace_instruction_record.instruction_bytes[position])
        _ -> (0)
    }
}

pub machine DebuggerTraceInstructionRecord::set_instruction_bytes(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, instruction_bytes: &[u8]) {
    transition 0 == 0 {
        _ -> copy_bytes(debugger_trace_instruction_record, instruction_bytes, 0)
    }
    state copy_bytes(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, instruction_bytes: &[u8], position: u64) {
        transition position < instruction_bytes.len && position < 32 {
            true -> store_byte(debugger_trace_instruction_record, instruction_bytes, position)
            _ -> done_bytes(debugger_trace_instruction_record, position)
        }
    }
    state store_byte(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, instruction_bytes: &[u8], position: u64)
        requires position < instruction_bytes.len && position < 32 {
        debugger_trace_instruction_record.instruction_bytes[position] = instruction_bytes[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_bytes(debugger_trace_instruction_record, instruction_bytes, next)
        }
    }
    state done_bytes(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, position: u64) {
        debugger_trace_instruction_record.instruction_bytes_len = position;
        transition 0 == 0 {
            _ -> (debugger_trace_instruction_record)
        }
    }
}

// Byte-equal compare — the address-directed dedupe keys on
// (instruction_address, instruction_bytes).
pub machine DebuggerTraceInstructionRecord::get_instruction_bytes_match(debugger_trace_instruction_record: &DebuggerTraceInstructionRecord, instruction_bytes: &[u8]) -> bool {
    transition debugger_trace_instruction_record.instruction_bytes_len == instruction_bytes.len {
        true -> compare(debugger_trace_instruction_record, instruction_bytes, 0)
        _ -> (false)
    }
    state compare(debugger_trace_instruction_record: &DebuggerTraceInstructionRecord, instruction_bytes: &[u8], position: u64) -> bool {
        transition position < instruction_bytes.len && position < 32 {
            true -> check(debugger_trace_instruction_record, instruction_bytes, position)
            _ -> (true)
        }
    }
    state check(debugger_trace_instruction_record: &DebuggerTraceInstructionRecord, instruction_bytes: &[u8], position: u64) -> bool
        requires position < instruction_bytes.len && position < 32 {
        let next: u64 = position + 1;
        transition debugger_trace_instruction_record.instruction_bytes[position] == instruction_bytes[position] {
            true -> compare(debugger_trace_instruction_record, instruction_bytes, next)
            _ -> (false)
        }
    }
}

