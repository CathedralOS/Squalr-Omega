module src::structures::debugger::debugger_trace_instruction_record;

use src::structures::debugger::debugger_register_snapshot::DebuggerRegisterSnapshot;
use src::structures::debugger::debugger_trace_event::DebuggerTraceEvent;
use src::structures::memory::bitness::Bitness;
use src::structures::processes::target_architecture::TargetArchitecture;

// Port of structures/debugger/debugger_trace_instruction_record.rs —
// {trace_session_id, instruction_address: Option, instruction_bytes,
// instruction_text: Option, target_architecture: Option, hit_count,
// last_register_snapshot, last_backend_message: Option, accessed_address:
// Option}. new() copies the trace event's fields; record_hit refreshes them.
pub data DebuggerTraceInstructionRecord {
    trace_session_id: [u8; 64];
    trace_session_id_len: u64;
    has_instruction_address: bool;
    instruction_address: u64;
    instruction_bytes: [u8; 32];
    instruction_bytes_len: u64;
    has_instruction_text: bool;
    instruction_text: [u8; 256];
    instruction_text_len: u64;
    has_target_architecture: bool;
    target_architecture: TargetArchitecture;
    hit_count: u64;
    last_register_snapshot: DebuggerRegisterSnapshot;
    has_last_backend_message: bool;
    last_backend_message: [u8; 256];
    last_backend_message_len: u64;
    has_accessed_address: bool;
    accessed_address: u64;
}

// Upstream `new(trace_session_id, trace_event)` — id copied by the caller
// (set_trace_session_id) since the port's spans need an explicit copy.
pub machine DebuggerTraceInstructionRecord::new(trace_event: &DebuggerTraceEvent) -> DebuggerTraceInstructionRecord {
    let hoist1: DebuggerRegisterSnapshot = DebuggerRegisterSnapshot::clone(&trace_event.register_snapshot);
    let mut record: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord {
        trace_session_id_len: 0,
        has_instruction_address: trace_event.has_instruction_address,
        instruction_address: trace_event.instruction_address,
        instruction_bytes_len: 0,
        has_instruction_text: trace_event.has_instruction_text,
        instruction_text_len: 0,
        has_target_architecture: trace_event.has_target_architecture,
        target_architecture: trace_event.target_architecture,
        hit_count: 1,
        last_register_snapshot: hoist1,
        has_last_backend_message: trace_event.has_backend_message,
        last_backend_message_len: 0,
        has_accessed_address: trace_event.has_accessed_address,
        accessed_address: trace_event.accessed_address,
    };
    DebuggerTraceInstructionRecord::set_instruction_bytes(&mut record, DebuggerTraceEvent::get_instruction_bytes(trace_event));
    DebuggerTraceInstructionRecord::set_instruction_text(&mut record, DebuggerTraceEvent::get_instruction_text(trace_event));
    DebuggerTraceInstructionRecord::set_last_backend_message(&mut record, DebuggerTraceEvent::get_backend_message(trace_event));
    (record)
}

// Upstream `record_hit` — bump + refresh from the latest event.
pub machine DebuggerTraceInstructionRecord::record_hit(this: &mut DebuggerTraceInstructionRecord, trace_event: &DebuggerTraceEvent) {
    this.hit_count = ((this.hit_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    this.has_instruction_address = trace_event.has_instruction_address;
    this.instruction_address = trace_event.instruction_address;
    this.has_instruction_text = trace_event.has_instruction_text;
    this.has_target_architecture = trace_event.has_target_architecture;
    this.target_architecture = trace_event.target_architecture;
    DebuggerRegisterSnapshot::clone_from(&mut this.last_register_snapshot, &trace_event.register_snapshot);
    this.has_last_backend_message = trace_event.has_backend_message;
    this.has_accessed_address = trace_event.has_accessed_address;
    this.accessed_address = trace_event.accessed_address;
    DebuggerTraceInstructionRecord::set_instruction_bytes(&mut this, DebuggerTraceEvent::get_instruction_bytes(trace_event));
    DebuggerTraceInstructionRecord::set_instruction_text(&mut this, DebuggerTraceEvent::get_instruction_text(trace_event));
    DebuggerTraceInstructionRecord::set_last_backend_message(&mut this, DebuggerTraceEvent::get_backend_message(trace_event));
}

pub machine DebuggerTraceInstructionRecord::get_trace_session_id(this: &DebuggerTraceInstructionRecord) -> &[u8] {
    transition this.trace_session_id_len <= 64 {
        true -> (&this.trace_session_id[0..this.trace_session_id_len])
        _ -> (&this.trace_session_id[0..0])
    }
}

pub machine DebuggerTraceInstructionRecord::get_trace_session_id_len(this: &DebuggerTraceInstructionRecord) -> u64 {
    this.trace_session_id_len
}

pub machine DebuggerTraceInstructionRecord::set_trace_session_id(this: &mut DebuggerTraceInstructionRecord, trace_session_id: &[u8]) {
    transition 0 == 0 {
        _ -> copy_id(this, trace_session_id, 0)
    }
    state copy_id(this: &mut DebuggerTraceInstructionRecord, trace_session_id: &[u8], position: u64) {
        transition position < trace_session_id.len && position < 64 {
            true -> store_id(this, trace_session_id, position)
            _ -> done_id(this, position)
        }
    }
    state store_id(this: &mut DebuggerTraceInstructionRecord, trace_session_id: &[u8], position: u64)
        requires position < trace_session_id.len && position < 64 {
        this.trace_session_id[position] = trace_session_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(this, trace_session_id, next)
        }
    }
    state done_id(this: &mut DebuggerTraceInstructionRecord, position: u64) {
        this.trace_session_id_len = position;
        transition 0 == 0 {
            _ -> (this)
        }
    }
}

pub machine DebuggerTraceInstructionRecord::has_instruction_address(this: &DebuggerTraceInstructionRecord) -> bool {
    this.has_instruction_address
}

pub machine DebuggerTraceInstructionRecord::get_instruction_address(this: &DebuggerTraceInstructionRecord) -> u64 {
    this.instruction_address
}

pub machine DebuggerTraceInstructionRecord::get_instruction_bytes(this: &DebuggerTraceInstructionRecord) -> &[u8] {
    transition this.instruction_bytes_len <= 32 {
        true -> (&this.instruction_bytes[0..this.instruction_bytes_len])
        _ -> (&this.instruction_bytes[0..0])
    }
}

pub machine DebuggerTraceInstructionRecord::get_instruction_bytes_len(this: &DebuggerTraceInstructionRecord) -> u64 {
    this.instruction_bytes_len
}

pub machine DebuggerTraceInstructionRecord::get_instruction_byte(this: &DebuggerTraceInstructionRecord, position: u64) -> u8
    requires position < 32 {
    transition position < 32 {
        true -> (this.instruction_bytes[position])
        _ -> (0)
    }
}

pub machine DebuggerTraceInstructionRecord::set_instruction_bytes(this: &mut DebuggerTraceInstructionRecord, instruction_bytes: &[u8]) {
    transition 0 == 0 {
        _ -> copy_bytes(this, instruction_bytes, 0)
    }
    state copy_bytes(this: &mut DebuggerTraceInstructionRecord, instruction_bytes: &[u8], position: u64) {
        transition position < instruction_bytes.len && position < 32 {
            true -> store_byte(this, instruction_bytes, position)
            _ -> done_bytes(this, position)
        }
    }
    state store_byte(this: &mut DebuggerTraceInstructionRecord, instruction_bytes: &[u8], position: u64)
        requires position < instruction_bytes.len && position < 32 {
        this.instruction_bytes[position] = instruction_bytes[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_bytes(this, instruction_bytes, next)
        }
    }
    state done_bytes(this: &mut DebuggerTraceInstructionRecord, position: u64) {
        this.instruction_bytes_len = position;
        transition 0 == 0 {
            _ -> (this)
        }
    }
}

// Byte-equal compare — the address-directed dedupe keys on
// (instruction_address, instruction_bytes).
pub machine DebuggerTraceInstructionRecord::get_instruction_bytes_match(this: &DebuggerTraceInstructionRecord, instruction_bytes: &[u8]) -> bool {
    transition this.instruction_bytes_len == instruction_bytes.len {
        true -> compare(this, instruction_bytes, 0)
        _ -> (false)
    }
    state compare(this: &DebuggerTraceInstructionRecord, instruction_bytes: &[u8], position: u64) -> bool {
        transition position < instruction_bytes.len && position < 32 {
            true -> check(this, instruction_bytes, position)
            _ -> (true)
        }
    }
    state check(this: &DebuggerTraceInstructionRecord, instruction_bytes: &[u8], position: u64) -> bool
        requires position < instruction_bytes.len && position < 32 {
        let next: u64 = position + 1;
        transition this.instruction_bytes[position] == instruction_bytes[position] {
            true -> compare(this, instruction_bytes, next)
            _ -> (false)
        }
    }
}

pub machine DebuggerTraceInstructionRecord::has_instruction_text(this: &DebuggerTraceInstructionRecord) -> bool {
