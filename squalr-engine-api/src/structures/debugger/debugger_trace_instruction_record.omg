// Empty shell for clone/clone_from — all spans zero-length, defaults as in
// upstream Default-adjacent construction.
pub machine DebuggerTraceInstructionRecord::empty() -> DebuggerTraceInstructionRecord {
    DebuggerTraceInstructionRecord {
        trace_session_id_len: 0,
        has_instruction_address: false,
        instruction_address: 0,
        instruction_bytes_len: 0,
        has_instruction_text: false,
        instruction_text_len: 0,
        has_target_architecture: false,
        target_architecture: TargetArchitecture::default_for_bitness(Bitness::Bit64),
        hit_count: 0,
        last_register_snapshot: DebuggerRegisterSnapshot::new(),
        has_last_backend_message: false,
        last_backend_message_len: 0,
        has_accessed_address: false,
        accessed_address: 0,
    }
}

pub machine DebuggerTraceInstructionRecord::clone(debugger_trace_instruction_record: &DebuggerTraceInstructionRecord) -> DebuggerTraceInstructionRecord {
    let mut clone: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord::empty();
    DebuggerTraceInstructionRecord::clone_from(&mut clone, debugger_trace_instruction_record);
    (clone)
}

pub machine DebuggerTraceInstructionRecord::clone_from(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord) {
    debugger_trace_instruction_record.trace_session_id_len = source.trace_session_id_len;
    debugger_trace_instruction_record.has_instruction_address = source.has_instruction_address;
    debugger_trace_instruction_record.instruction_address = source.instruction_address;
    debugger_trace_instruction_record.instruction_bytes_len = source.instruction_bytes_len;
    debugger_trace_instruction_record.has_instruction_text = source.has_instruction_text;
    debugger_trace_instruction_record.instruction_text_len = source.instruction_text_len;
    debugger_trace_instruction_record.has_target_architecture = source.has_target_architecture;
    debugger_trace_instruction_record.target_architecture = source.target_architecture;
    debugger_trace_instruction_record.hit_count = source.hit_count;
    DebuggerRegisterSnapshot::clone_from(&mut debugger_trace_instruction_record.last_register_snapshot, &source.last_register_snapshot);
    debugger_trace_instruction_record.has_last_backend_message = source.has_last_backend_message;
    debugger_trace_instruction_record.last_backend_message_len = source.last_backend_message_len;
    debugger_trace_instruction_record.has_accessed_address = source.has_accessed_address;
    debugger_trace_instruction_record.accessed_address = source.accessed_address;
    transition 0 == 0 {
        _ -> copy_id(debugger_trace_instruction_record, source, 0)
    }
    state copy_id(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64) {
        transition position < source.trace_session_id_len && position < 64 {
            true -> store_id(debugger_trace_instruction_record, source, position)
            _ -> copy_bytes(debugger_trace_instruction_record, source, 0)
        }
    }
    state store_id(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64)
        requires position < source.trace_session_id_len && position < 64 {
        debugger_trace_instruction_record.trace_session_id[position] = source.trace_session_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(debugger_trace_instruction_record, source, next)
        }
    }
    state copy_bytes(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64) {
        transition position < source.instruction_bytes_len && position < 32 {
            true -> store_byte(debugger_trace_instruction_record, source, position)
            _ -> copy_text(debugger_trace_instruction_record, source, 0)
        }
    }
    state store_byte(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64)
        requires position < source.instruction_bytes_len && position < 32 {
        debugger_trace_instruction_record.instruction_bytes[position] = source.instruction_bytes[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_bytes(debugger_trace_instruction_record, source, next)
        }
    }
    state copy_text(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64) {
        transition position < source.instruction_text_len && position < 256 {
            true -> store_text(debugger_trace_instruction_record, source, position)
            _ -> copy_message(debugger_trace_instruction_record, source, 0)
        }
    }
    state store_text(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64)
        requires position < source.instruction_text_len && position < 256 {
        debugger_trace_instruction_record.instruction_text[position] = source.instruction_text[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_text(debugger_trace_instruction_record, source, next)
        }
    }
    state copy_message(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64) {
        transition position < source.last_backend_message_len && position < 256 {
            true -> store_message(debugger_trace_instruction_record, source, position)
            _ -> (debugger_trace_instruction_record)
        }
    }
    state store_message(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, source: &DebuggerTraceInstructionRecord, position: u64)
        requires position < source.last_backend_message_len && position < 256 {
        debugger_trace_instruction_record.last_backend_message[position] = source.last_backend_message[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_message(debugger_trace_instruction_record, source, next)
        }
    }
}
