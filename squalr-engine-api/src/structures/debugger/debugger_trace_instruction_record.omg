module src::structures::debugger::debugger_trace_instruction_record;

use src::structures::debugger::debugger_register_snapshot::DebuggerRegisterSnapshot;
use src::structures::debugger::debugger_trace_event::DebuggerTraceEvent;
use src::structures::memory::bitness::Bitness;
use src::structures::processes::target_architecture::TargetArchitecture;

// Port of structures/debugger/debugger_trace_instruction_record.rs —
// {trace_session_id, instruction_address: Option, instruction_bytes,
// instruction_text: Option, target_architecture: Option, hit_count,
// last_register_snapshot, last_backend_message: Option, accessed_address:
// Option}. new() copies the trace event's fields; record_hit refreshes them.
pub data DebuggerTraceInstructionRecord {
    trace_session_id: [u8; 64];
    trace_session_id_len: u64;
    has_instruction_address: bool;
    instruction_address: u64;
    instruction_bytes: [u8; 32];
    instruction_bytes_len: u64;
    has_instruction_text: bool;
    instruction_text: [u8; 256];
    instruction_text_len: u64;
    has_target_architecture: bool;
    target_architecture: TargetArchitecture;
    hit_count: u64;
    last_register_snapshot: DebuggerRegisterSnapshot;
    has_last_backend_message: bool;
    last_backend_message: [u8; 256];
    last_backend_message_len: u64;
    has_accessed_address: bool;
    accessed_address: u64;
}

// Upstream `new(trace_session_id, trace_event)` — id copied by the caller
// (set_trace_session_id) since the port's spans need an explicit copy.
pub machine DebuggerTraceInstructionRecord::new(trace_event: &DebuggerTraceEvent) -> DebuggerTraceInstructionRecord {
    let mut record: DebuggerTraceInstructionRecord = DebuggerTraceInstructionRecord {
        trace_session_id_len: 0,
        has_instruction_address: trace_event.has_instruction_address,
        instruction_address: trace_event.instruction_address,
        instruction_bytes_len: 0,
        has_instruction_text: trace_event.has_instruction_text,
        instruction_text_len: 0,
        has_target_architecture: trace_event.has_target_architecture,
        target_architecture: trace_event.target_architecture,
        hit_count: 1,
        last_register_snapshot: DebuggerRegisterSnapshot::clone(&trace_event.register_snapshot),
        has_last_backend_message: trace_event.has_backend_message,
        last_backend_message_len: 0,
        has_accessed_address: trace_event.has_accessed_address,
        accessed_address: trace_event.accessed_address,
    };
    DebuggerTraceInstructionRecord::set_instruction_bytes(&mut record, DebuggerTraceEvent::get_instruction_bytes(trace_event));
    DebuggerTraceInstructionRecord::set_instruction_text(&mut record, DebuggerTraceEvent::get_instruction_text(trace_event));
    DebuggerTraceInstructionRecord::set_last_backend_message(&mut record, DebuggerTraceEvent::get_backend_message(trace_event));
    (record)
}

// Upstream `record_hit` — bump + refresh from the latest event.
pub machine DebuggerTraceInstructionRecord::record_hit(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, trace_event: &DebuggerTraceEvent) {
    debugger_trace_instruction_record.hit_count = ((debugger_trace_instruction_record.hit_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    debugger_trace_instruction_record.has_instruction_address = trace_event.has_instruction_address;
    debugger_trace_instruction_record.instruction_address = trace_event.instruction_address;
    debugger_trace_instruction_record.has_instruction_text = trace_event.has_instruction_text;
    debugger_trace_instruction_record.has_target_architecture = trace_event.has_target_architecture;
    debugger_trace_instruction_record.target_architecture = trace_event.target_architecture;
    DebuggerRegisterSnapshot::clone_from(&mut debugger_trace_instruction_record.last_register_snapshot, &trace_event.register_snapshot);
    debugger_trace_instruction_record.has_last_backend_message = trace_event.has_backend_message;
    debugger_trace_instruction_record.has_accessed_address = trace_event.has_accessed_address;
    debugger_trace_instruction_record.accessed_address = trace_event.accessed_address;
    DebuggerTraceInstructionRecord::set_instruction_bytes(debugger_trace_instruction_record, DebuggerTraceEvent::get_instruction_bytes(trace_event));
    DebuggerTraceInstructionRecord::set_instruction_text(debugger_trace_instruction_record, DebuggerTraceEvent::get_instruction_text(trace_event));
    DebuggerTraceInstructionRecord::set_last_backend_message(debugger_trace_instruction_record, DebuggerTraceEvent::get_backend_message(trace_event));
}

pub machine DebuggerTraceInstructionRecord::get_trace_session_id(debugger_trace_instruction_record: &DebuggerTraceInstructionRecord) -> &[u8] {
    transition debugger_trace_instruction_record.trace_session_id_len <= 64 {
        true -> (&debugger_trace_instruction_record.trace_session_id[0..debugger_trace_instruction_record.trace_session_id_len])
        _ -> (&debugger_trace_instruction_record.trace_session_id[0..0])
    }
}

pub machine DebuggerTraceInstructionRecord::get_trace_session_id_len(debugger_trace_instruction_record: &DebuggerTraceInstructionRecord) -> u64 {
    debugger_trace_instruction_record.trace_session_id_len
}

pub machine DebuggerTraceInstructionRecord::set_trace_session_id(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, trace_session_id: &[u8]) {
    transition 0 == 0 {
        _ -> copy_id(debugger_trace_instruction_record, trace_session_id, 0)
    }
    state copy_id(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, trace_session_id: &[u8], position: u64) {
        transition position < trace_session_id.len && position < 64 {
            true -> store_id(debugger_trace_instruction_record, trace_session_id, position)
            _ -> done_id(debugger_trace_instruction_record, position)
        }
    }
    state store_id(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, trace_session_id: &[u8], position: u64)
        requires position < trace_session_id.len && position < 64 {
        debugger_trace_instruction_record.trace_session_id[position] = trace_session_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(debugger_trace_instruction_record, trace_session_id, next)
        }
    }
    state done_id(debugger_trace_instruction_record: &mut DebuggerTraceInstructionRecord, position: u64) {
        debugger_trace_instruction_record.trace_session_id_len = position;
        transition 0 == 0 {
            _ -> (debugger_trace_instruction_record)
        }
    }
}

