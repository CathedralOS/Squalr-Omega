module src::structures::debugger::debugger_data_breakpoint_access;

// Port of structures/debugger/debugger_data_breakpoint_access.rs —
// Read/Write/ReadWrite with the CLI label surface. FromStr stays with the
// CLI arg-parsing leg (it is a text convention, not a payload field).
pub data DebuggerDataBreakpointAccess [copy] {
    case Read;
    case Write;
    case ReadWrite;
}

pub machine DebuggerDataBreakpointAccess::default() -> DebuggerDataBreakpointAccess {
    (DebuggerDataBreakpointAccess::Read)
}

pub machine DebuggerDataBreakpointAccess::get_cli_label(debugger_data_breakpoint_access: &DebuggerDataBreakpointAccess) -> &[u8] {
    transition debugger_data_breakpoint_access {
        DebuggerDataBreakpointAccess::Read -> ("read")
        DebuggerDataBreakpointAccess::Write -> ("write")
        DebuggerDataBreakpointAccess::ReadWrite -> ("read-write")
        _ -> ("read")
    }
}
