module src::structures::debugger::debugger_command_status;
use src::structures::bounded_slice::bounded_slice;
use src::structures::bounded_slice::flagged_bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of structures/debugger/debugger_command_status.rs — {success,
// message: Option<String>} with the success()/failure() builders.
pub data DebuggerCommandStatus {
    success: bool;
    has_message: bool;
    message: [u8; 256];
    message_len: u64;
}

pub machine DebuggerCommandStatus::success() -> DebuggerCommandStatus {
    DebuggerCommandStatus {
        success: true,
        has_message: false,
        message_len: 0,
    }
}

// Upstream `failure(message)` — callers build the value first
// (set_message), since message text is a bounded span in the port.
pub machine DebuggerCommandStatus::failure() -> DebuggerCommandStatus {
    DebuggerCommandStatus {
        success: false,
        has_message: false,
        message_len: 0,
    }
}

pub machine DebuggerCommandStatus::get_success(&self) -> bool {
    self.success
}

pub machine DebuggerCommandStatus::has_message(&self) -> bool {
    self.has_message
}

pub machine DebuggerCommandStatus::get_message(&self) -> &[u8] {
    (flagged_bounded_slice(&self.message[0..256], self.message_len, self.has_message && self.message_len <= 256))
}

pub machine DebuggerCommandStatus::get_message_len(&self) -> u64 {
    self.message_len
}

pub machine DebuggerCommandStatus::get_message_byte(&self, position: u64) -> u8
    requires position < 256 {
    transition position < 256 {
        true -> (self.message[position])
        _ -> (0)
    }
}

pub machine DebuggerCommandStatus::set_message(&mut self, message: &[u8]) {
    self.message_len = BoundedByteCopy::copy(&mut self.message[0..256], message);
    self.has_message = true;
}

pub machine DebuggerCommandStatus::clone(&self) -> DebuggerCommandStatus {
    let mut clone: DebuggerCommandStatus = DebuggerCommandStatus::success();
    clone.clone_from(self);
    (clone)
}

pub machine DebuggerCommandStatus::clone_from(&mut self, source: &DebuggerCommandStatus) {
    self.success = source.success;
    self.has_message = source.has_message;
    self.message_len = source.message_len;
    let mut copied: u64 = BoundedByteCopy::copy(&mut self.message[0..256], bounded_slice(&source.message[0..256], source.message_len));
}
