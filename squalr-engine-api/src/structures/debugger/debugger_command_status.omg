module src::structures::debugger::debugger_command_status;

// Port of structures/debugger/debugger_command_status.rs — {success,
// message: Option<String>} with the success()/failure() builders.
pub data DebuggerCommandStatus {
    success: bool;
    has_message: bool;
    message: [u8; 256];
    message_len: u64;
}

pub machine DebuggerCommandStatus::success() -> DebuggerCommandStatus {
    DebuggerCommandStatus {
        success: true,
        has_message: false,
        message_len: 0,
    }
}

// Upstream `failure(message)` — callers build the value first
// (set_message), since message text is a bounded span in the port.
pub machine DebuggerCommandStatus::failure() -> DebuggerCommandStatus {
    DebuggerCommandStatus {
        success: false,
        has_message: false,
        message_len: 0,
    }
}

pub machine DebuggerCommandStatus::get_success(debugger_command_status: &DebuggerCommandStatus) -> bool {
    debugger_command_status.success
}

pub machine DebuggerCommandStatus::has_message(debugger_command_status: &DebuggerCommandStatus) -> bool {
    debugger_command_status.has_message
}

pub machine DebuggerCommandStatus::get_message(debugger_command_status: &DebuggerCommandStatus) -> &[u8] {
    transition debugger_command_status.has_message && debugger_command_status.message_len <= 256 {
        true -> (&debugger_command_status.message[0..debugger_command_status.message_len])
        _ -> (&debugger_command_status.message[0..0])
    }
}

pub machine DebuggerCommandStatus::get_message_len(debugger_command_status: &DebuggerCommandStatus) -> u64 {
    debugger_command_status.message_len
}

pub machine DebuggerCommandStatus::get_message_byte(debugger_command_status: &DebuggerCommandStatus, position: u64) -> u8
    requires position < 256 {
    transition position < 256 {
        true -> (debugger_command_status.message[position])
        _ -> (0)
    }
}

pub machine DebuggerCommandStatus::set_message(debugger_command_status: &mut DebuggerCommandStatus, message: &[u8]) {
    transition 0 == 0 {
        _ -> copy_message(debugger_command_status, message, 0)
    }
    state copy_message(debugger_command_status: &mut DebuggerCommandStatus, message: &[u8], position: u64) {
        transition position < message.len && position < 256 {
            true -> store_message(debugger_command_status, message, position)
            _ -> done_message(debugger_command_status, position)
        }
    }
    state store_message(debugger_command_status: &mut DebuggerCommandStatus, message: &[u8], position: u64)
        requires position < message.len && position < 256 {
        debugger_command_status.message[position] = message[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_message(debugger_command_status, message, next)
        }
    }
    state done_message(debugger_command_status: &mut DebuggerCommandStatus, position: u64) {
        debugger_command_status.message_len = position;
        debugger_command_status.has_message = true;
        transition 0 == 0 {
            _ -> (debugger_command_status)
        }
    }
}

pub machine DebuggerCommandStatus::clone(debugger_command_status: &DebuggerCommandStatus) -> DebuggerCommandStatus {
    let mut clone: DebuggerCommandStatus = DebuggerCommandStatus::success();
    DebuggerCommandStatus::clone_from(&mut clone, debugger_command_status);
    (clone)
}

pub machine DebuggerCommandStatus::clone_from(debugger_command_status: &mut DebuggerCommandStatus, source: &DebuggerCommandStatus) {
    debugger_command_status.success = source.success;
    debugger_command_status.has_message = source.has_message;
    debugger_command_status.message_len = source.message_len;
    transition 0 == 0 {
        _ -> copy_message(debugger_command_status, source, 0)
    }
    state copy_message(debugger_command_status: &mut DebuggerCommandStatus, source: &DebuggerCommandStatus, position: u64) {
        transition position < source.message_len && position < 256 {
            true -> store_message(debugger_command_status, source, position)
            _ -> (debugger_command_status)
        }
    }
    state store_message(debugger_command_status: &mut DebuggerCommandStatus, source: &DebuggerCommandStatus, position: u64)
        requires position < source.message_len && position < 256 {
        debugger_command_status.message[position] = source.message[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_message(debugger_command_status, source, next)
        }
    }
}
