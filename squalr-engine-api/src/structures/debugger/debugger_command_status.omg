module src::structures::debugger::debugger_command_status;

// Port of structures/debugger/debugger_command_status.rs — {success,
// message: Option<String>} with the success()/failure() builders.
pub data DebuggerCommandStatus {
    success: bool;
    has_message: bool;
    message: [u8; 256];
    message_len: u64;
}

pub machine DebuggerCommandStatus::success() -> DebuggerCommandStatus {
    DebuggerCommandStatus {
        success: true,
        has_message: false,
        message_len: 0,
    }
}

// Upstream `failure(message)` — callers build the value first
// (set_message), since message text is a bounded span in the port.
pub machine DebuggerCommandStatus::failure() -> DebuggerCommandStatus {
    DebuggerCommandStatus {
        success: false,
        has_message: false,
        message_len: 0,
    }
}

pub machine DebuggerCommandStatus::get_success(this: &DebuggerCommandStatus) -> bool {
    this.success
}

pub machine DebuggerCommandStatus::has_message(this: &DebuggerCommandStatus) -> bool {
    this.has_message
}

pub machine DebuggerCommandStatus::get_message(this: &DebuggerCommandStatus) -> &[u8] {
    transition this.has_message && this.message_len <= 256 {
        true -> (&this.message[0..this.message_len])
        _ -> (&this.message[0..0])
    }
}

pub machine DebuggerCommandStatus::get_message_len(this: &DebuggerCommandStatus) -> u64 {
    this.message_len
}

pub machine DebuggerCommandStatus::get_message_byte(this: &DebuggerCommandStatus, position: u64) -> u8
    requires position < 256 {
    transition position < 256 {
        true -> (this.message[position])
        _ -> (0)
    }
}

pub machine DebuggerCommandStatus::set_message(this: &mut DebuggerCommandStatus, message: &[u8]) {
    transition 0 == 0 {
        _ -> copy_message(this, message, 0)
    }
    state copy_message(this: &mut DebuggerCommandStatus, message: &[u8], position: u64) {
        transition position < message.len && position < 256 {
            true -> store_message(this, message, position)
            _ -> done_message(this, position)
        }
    }
    state store_message(this: &mut DebuggerCommandStatus, message: &[u8], position: u64)
        requires position < message.len && position < 256 {
        this.message[position] = message[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_message(this, message, next)
        }
    }
    state done_message(this: &mut DebuggerCommandStatus, position: u64) {
        this.message_len = position;
        this.has_message = true;
        transition 0 == 0 {
            _ -> (this)
        }
    }
}

pub machine DebuggerCommandStatus::clone(this: &DebuggerCommandStatus) -> DebuggerCommandStatus {
    let mut clone: DebuggerCommandStatus = DebuggerCommandStatus::success();
    DebuggerCommandStatus::clone_from(&mut clone, this);
    (clone)
}

pub machine DebuggerCommandStatus::clone_from(this: &mut DebuggerCommandStatus, source: &DebuggerCommandStatus) {
    this.success = source.success;
    this.has_message = source.has_message;
    this.message_len = source.message_len;
    transition 0 == 0 {
        _ -> copy_message(this, source, 0)
    }
    state copy_message(this: &mut DebuggerCommandStatus, source: &DebuggerCommandStatus, position: u64) {
        transition position < source.message_len && position < 256 {
            true -> store_message(this, source, position)
            _ -> (this)
        }
    }
    state store_message(this: &mut DebuggerCommandStatus, source: &DebuggerCommandStatus, position: u64)
        requires position < source.message_len && position < 256 {
        this.message[position] = source.message[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_message(this, source, next)
        }
    }
}
