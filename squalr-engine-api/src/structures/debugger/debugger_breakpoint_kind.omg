module src::structures::debugger::debugger_breakpoint_kind;

use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;

// Port of structures/debugger/debugger_breakpoint_kind.rs — Software,
// HardwareData{access,size_in_bytes}, HardwareExecute.
pub data DebuggerBreakpointKind [copy] {
    case Software;
    case HardwareData(access: DebuggerDataBreakpointAccess, size_in_bytes: u64);
    case HardwareExecute;
}

// Upstream `hardware_data` constructor. size_in_bytes is upstream u8 carried
// as u64 (the toolchain keeps u8/u16 out of most payload surfaces).
pub machine DebuggerBreakpointKind::hardware_data(access: DebuggerDataBreakpointAccess, size_in_bytes: u64) -> DebuggerBreakpointKind {
    (DebuggerBreakpointKind::HardwareData {
        access: access,
        size_in_bytes: size_in_bytes,
    })
}

// Upstream `hardware_execute` constructor.
pub machine DebuggerBreakpointKind::hardware_execute() -> DebuggerBreakpointKind {
    (DebuggerBreakpointKind::HardwareExecute)
}

pub machine DebuggerBreakpointKind::get_is_software(this: &DebuggerBreakpointKind) -> bool {
    transition this {
        DebuggerBreakpointKind::Software -> (true)
        _ -> (false)
    }
}

pub machine DebuggerBreakpointKind::get_is_hardware_execute(this: &DebuggerBreakpointKind) -> bool {
    transition this {
        DebuggerBreakpointKind::HardwareExecute -> (true)
        _ -> (false)
    }
}

pub machine DebuggerBreakpointKind::get_is_hardware_data(this: &DebuggerBreakpointKind) -> bool {
    transition this {
        DebuggerBreakpointKind::HardwareData { access, size_in_bytes } -> (true)
        _ -> (false)
    }
}

// Payload reads used by trace-session bookkeeping.
pub machine DebuggerBreakpointKind::get_hardware_data_access(this: &DebuggerBreakpointKind) -> DebuggerDataBreakpointAccess {
    transition this {
        DebuggerBreakpointKind::HardwareData { access, size_in_bytes } -> (access)
        _ -> (DebuggerDataBreakpointAccess::Read)
    }
}

pub machine DebuggerBreakpointKind::get_hardware_data_size_in_bytes(this: &DebuggerBreakpointKind) -> u64 {
    transition this {
        DebuggerBreakpointKind::HardwareData { access, size_in_bytes } -> (size_in_bytes)
        _ -> (0)
    }
}
