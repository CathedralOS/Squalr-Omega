module src::structures::debugger::debugger_breakpoint_mechanism;

// Port of the DebuggerBreakpointMechanism enum carried inside
// debugger_breakpoint_descriptor.rs — Debugger is the default; MemoryPatch
// marks software breakpoints realized through the patch service.
pub data DebuggerBreakpointMechanism [copy] {
    case Debugger;
    case MemoryPatch;
}

pub machine DebuggerBreakpointMechanism::default() -> DebuggerBreakpointMechanism {
    (DebuggerBreakpointMechanism::Debugger)
}
