module src::structures::debugger::debugger_trace_session_descriptor;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::debugger::debugger_breakpoint_descriptor::DebuggerBreakpointDescriptor;
use src::structures::debugger::debugger_breakpoint_kind::DebuggerBreakpointKind;
use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use src::structures::debugger::debugger_trace_target_kind::DebuggerTraceTargetKind;

// Port of structures/debugger/debugger_trace_session_descriptor.rs —
// {trace_session_id, address, size_in_bytes, access, breakpoint, label:
// Option, is_active, target_kind}. new() is the address-directed shape;
// new_for_instruction() the instruction-directed one (size_in_bytes 0,
// target_kind Instruction).
pub data DebuggerTraceSessionDescriptor {
    trace_session_id: [u8; 64];
    trace_session_id_len: u64;
    address: u64;
    size_in_bytes: u64;
    access: DebuggerDataBreakpointAccess;
    breakpoint: DebuggerBreakpointDescriptor;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
    is_active: bool;
    target_kind: DebuggerTraceTargetKind;
}

// Upstream `new` (address-directed). The trace_session_id + breakpoint +
// label are applied by callers via setters (bounded spans need explicit
// copies in the port).
pub machine DebuggerTraceSessionDescriptor::new(address: u64, size_in_bytes: u64, access: DebuggerDataBreakpointAccess, is_active: bool) -> DebuggerTraceSessionDescriptor {
    DebuggerTraceSessionDescriptor {
        trace_session_id_len: 0,
        address: address,
        size_in_bytes: size_in_bytes,
        access: access,
        breakpoint: DebuggerBreakpointDescriptor::new(0, DebuggerBreakpointKind::Software, false),
        has_label: false,
        label_len: 0,
        is_active: is_active,
        target_kind: DebuggerTraceTargetKind::Address,
    }
}

// Upstream `new_for_instruction` (instruction-directed: address is the
// instruction's address, size_in_bytes 0).
pub machine DebuggerTraceSessionDescriptor::new_for_instruction(instruction_address: u64, access: DebuggerDataBreakpointAccess, is_active: bool) -> DebuggerTraceSessionDescriptor {
    DebuggerTraceSessionDescriptor {
        trace_session_id_len: 0,
        address: instruction_address,
        size_in_bytes: 0,
        access: access,
        breakpoint: DebuggerBreakpointDescriptor::new(0, DebuggerBreakpointKind::Software, false),
        has_label: false,
        label_len: 0,
        is_active: is_active,
        target_kind: DebuggerTraceTargetKind::Instruction,
    }
}

pub machine DebuggerTraceSessionDescriptor::get_target_kind(&self) -> DebuggerTraceTargetKind {
    self.target_kind
}

pub machine DebuggerTraceSessionDescriptor::get_trace_session_id(&self) -> &[u8] {
    transition self.trace_session_id_len <= 64 {
        true -> (&self.trace_session_id[0..self.trace_session_id_len])
        _ -> (&self.trace_session_id[0..0])
    }
}

pub machine DebuggerTraceSessionDescriptor::get_trace_session_id_len(&self) -> u64 {
    self.trace_session_id_len
}

pub machine DebuggerTraceSessionDescriptor::get_trace_session_id_byte(&self, position: u64) -> u8
    requires position < 64 {
    transition position < 64 {
        true -> (self.trace_session_id[position])
        _ -> (0)
    }
}

pub machine DebuggerTraceSessionDescriptor::set_trace_session_id(&mut self, trace_session_id: &[u8]) {
    self.trace_session_id_len = BoundedByteCopy::copy(&mut self.trace_session_id[0..64], trace_session_id);
}

// Byte-equal id compare for session lookup (bounded-table find).
pub machine DebuggerTraceSessionDescriptor::get_trace_session_id_matches(&self, trace_session_id: &[u8]) -> bool {
    transition self.trace_session_id_len == trace_session_id.len {
        true -> compare(trace_session_id, 0)
        _ -> (false)
    }
    state compare(&self, trace_session_id: &[u8], position: u64) -> bool {
        transition position < trace_session_id.len && position < 64 {
            true -> check(trace_session_id, position)
            _ -> (true)
        }
    }
    state check(&self, trace_session_id: &[u8], position: u64) -> bool
        requires position < trace_session_id.len && position < 64 {
        let next: u64 = position + 1;
        transition self.trace_session_id[position] == trace_session_id[position] {
            true -> compare(trace_session_id, next)
            _ -> (false)
        }
    }
}

pub machine DebuggerTraceSessionDescriptor::get_address(&self) -> u64 {
    self.address
}

pub machine DebuggerTraceSessionDescriptor::get_size_in_bytes(&self) -> u64 {
    self.size_in_bytes
}

pub machine DebuggerTraceSessionDescriptor::get_access(&self) -> DebuggerDataBreakpointAccess {
    self.access
}

pub machine DebuggerTraceSessionDescriptor::get_breakpoint(&self) -> &DebuggerBreakpointDescriptor {
    (&self.breakpoint)
}

pub machine DebuggerTraceSessionDescriptor::set_breakpoint(&mut self, breakpoint: DebuggerBreakpointDescriptor) {
    self.breakpoint = breakpoint;
}

pub machine DebuggerTraceSessionDescriptor::has_label(&self) -> bool {
    self.has_label
}

pub machine DebuggerTraceSessionDescriptor::get_label(&self) -> &[u8] {
    transition self.has_label && self.label_len <= 256 {
        true -> (&self.label[0..self.label_len])
        _ -> (&self.label[0..0])
    }
}

pub machine DebuggerTraceSessionDescriptor::get_label_len(&self) -> u64 {
    self.label_len
}

pub machine DebuggerTraceSessionDescriptor::set_label(&mut self, label: &[u8]) {
    self.label_len = BoundedByteCopy::copy(&mut self.label[0..256], label);
    self.has_label = true;
}

pub machine DebuggerTraceSessionDescriptor::clear_label(&mut self) {
    self.has_label = false;
    self.label_len = 0;
}

pub machine DebuggerTraceSessionDescriptor::get_is_active(&self) -> bool {
    self.is_active
}

pub machine DebuggerTraceSessionDescriptor::set_is_active(&mut self, is_active: bool) {
    self.is_active = is_active;
}

pub machine DebuggerTraceSessionDescriptor::clone(&self) -> DebuggerTraceSessionDescriptor {
    let mut clone: DebuggerTraceSessionDescriptor = DebuggerTraceSessionDescriptor::new(0, 0, DebuggerDataBreakpointAccess::Read, false);
    clone.clone_from(self);
    (clone)
}

pub machine DebuggerTraceSessionDescriptor::clone_from(&mut self, source: &DebuggerTraceSessionDescriptor) {
    self.trace_session_id_len = source.trace_session_id_len;
    self.address = source.address;
    self.size_in_bytes = source.size_in_bytes;
    self.access = source.access;
    self.breakpoint.clone_from(&source.breakpoint);
    self.has_label = source.has_label;
    self.label_len = source.label_len;
    self.is_active = source.is_active;
    self.target_kind = source.target_kind;
    transition 0 == 0 {
        _ -> copy_id(source, 0)
    }
    state copy_id(&mut self, source: &DebuggerTraceSessionDescriptor, position: u64) {
        transition position < source.trace_session_id_len && position < 64 {
            true -> store_id(source, position)
            _ -> copy_label(source, 0)
        }
    }
    state store_id(&mut self, source: &DebuggerTraceSessionDescriptor, position: u64)
        requires position < source.trace_session_id_len && position < 64 {
        self.trace_session_id[position] = source.trace_session_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(source, next)
        }
    }
    state copy_label(&mut self, source: &DebuggerTraceSessionDescriptor, position: u64) {
        transition position < source.label_len && position < 256 {
            true -> store_label(source, position)
            _ -> (self)
        }
    }
    state store_label(&mut self, source: &DebuggerTraceSessionDescriptor, position: u64)
        requires position < source.label_len && position < 256 {
        self.label[position] = source.label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_label(source, next)
        }
    }
}
