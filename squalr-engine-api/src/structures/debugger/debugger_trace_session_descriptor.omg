module src::structures::debugger::debugger_trace_session_descriptor;

use src::structures::debugger::debugger_breakpoint_descriptor::DebuggerBreakpointDescriptor;
use src::structures::debugger::debugger_breakpoint_kind::DebuggerBreakpointKind;
use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use src::structures::debugger::debugger_trace_target_kind::DebuggerTraceTargetKind;

// Port of structures/debugger/debugger_trace_session_descriptor.rs —
// {trace_session_id, address, size_in_bytes, access, breakpoint, label:
// Option, is_active, target_kind}. new() is the address-directed shape;
// new_for_instruction() the instruction-directed one (size_in_bytes 0,
// target_kind Instruction).
pub data DebuggerTraceSessionDescriptor {
    trace_session_id: [u8; 64];
    trace_session_id_len: u64;
    address: u64;
    size_in_bytes: u64;
    access: DebuggerDataBreakpointAccess;
    breakpoint: DebuggerBreakpointDescriptor;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
    is_active: bool;
    target_kind: DebuggerTraceTargetKind;
}

// Upstream `new` (address-directed). The trace_session_id + breakpoint +
// label are applied by callers via setters (bounded spans need explicit
// copies in the port).
pub machine DebuggerTraceSessionDescriptor::new(address: u64, size_in_bytes: u64, access: DebuggerDataBreakpointAccess, is_active: bool) -> DebuggerTraceSessionDescriptor {
    DebuggerTraceSessionDescriptor {
        trace_session_id_len: 0,
        address: address,
        size_in_bytes: size_in_bytes,
        access: access,
        breakpoint: DebuggerBreakpointDescriptor::new(0, DebuggerBreakpointKind::Software, false),
        has_label: false,
        label_len: 0,
        is_active: is_active,
        target_kind: DebuggerTraceTargetKind::Address,
    }
}

// Upstream `new_for_instruction` (instruction-directed: address is the
// instruction's address, size_in_bytes 0).
pub machine DebuggerTraceSessionDescriptor::new_for_instruction(instruction_address: u64, access: DebuggerDataBreakpointAccess, is_active: bool) -> DebuggerTraceSessionDescriptor {
    DebuggerTraceSessionDescriptor {
        trace_session_id_len: 0,
        address: instruction_address,
        size_in_bytes: 0,
        access: access,
        breakpoint: DebuggerBreakpointDescriptor::new(0, DebuggerBreakpointKind::Software, false),
        has_label: false,
        label_len: 0,
        is_active: is_active,
        target_kind: DebuggerTraceTargetKind::Instruction,
    }
}

pub machine DebuggerTraceSessionDescriptor::get_target_kind(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor) -> DebuggerTraceTargetKind {
    debugger_trace_session_descriptor.target_kind
}

pub machine DebuggerTraceSessionDescriptor::get_trace_session_id(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor) -> &[u8] {
    transition debugger_trace_session_descriptor.trace_session_id_len <= 64 {
        true -> (&debugger_trace_session_descriptor.trace_session_id[0..debugger_trace_session_descriptor.trace_session_id_len])
        _ -> (&debugger_trace_session_descriptor.trace_session_id[0..0])
    }
}

pub machine DebuggerTraceSessionDescriptor::get_trace_session_id_len(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor) -> u64 {
    debugger_trace_session_descriptor.trace_session_id_len
}

pub machine DebuggerTraceSessionDescriptor::get_trace_session_id_byte(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor, position: u64) -> u8
    requires position < 64 {
    transition position < 64 {
        true -> (debugger_trace_session_descriptor.trace_session_id[position])
        _ -> (0)
    }
}

pub machine DebuggerTraceSessionDescriptor::set_trace_session_id(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, trace_session_id: &[u8]) {
    transition 0 == 0 {
        _ -> copy_id(debugger_trace_session_descriptor, trace_session_id, 0)
    }
    state copy_id(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, trace_session_id: &[u8], position: u64) {
        transition position < trace_session_id.len && position < 64 {
            true -> store_id(debugger_trace_session_descriptor, trace_session_id, position)
            _ -> done_id(debugger_trace_session_descriptor, position)
        }
    }
    state store_id(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, trace_session_id: &[u8], position: u64)
        requires position < trace_session_id.len && position < 64 {
        debugger_trace_session_descriptor.trace_session_id[position] = trace_session_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(debugger_trace_session_descriptor, trace_session_id, next)
        }
    }
    state done_id(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, position: u64) {
        debugger_trace_session_descriptor.trace_session_id_len = position;
        transition 0 == 0 {
            _ -> (debugger_trace_session_descriptor)
        }
    }
}

// Byte-equal id compare for session lookup (bounded-table find).
pub machine DebuggerTraceSessionDescriptor::get_trace_session_id_matches(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor, trace_session_id: &[u8]) -> bool {
    transition debugger_trace_session_descriptor.trace_session_id_len == trace_session_id.len {
        true -> compare(debugger_trace_session_descriptor, trace_session_id, 0)
        _ -> (false)
    }
    state compare(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor, trace_session_id: &[u8], position: u64) -> bool {
        transition position < trace_session_id.len && position < 64 {
            true -> check(debugger_trace_session_descriptor, trace_session_id, position)
            _ -> (true)
        }
    }
    state check(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor, trace_session_id: &[u8], position: u64) -> bool
        requires position < trace_session_id.len && position < 64 {
        let next: u64 = position + 1;
        transition debugger_trace_session_descriptor.trace_session_id[position] == trace_session_id[position] {
            true -> compare(debugger_trace_session_descriptor, trace_session_id, next)
            _ -> (false)
        }
    }
}

pub machine DebuggerTraceSessionDescriptor::get_address(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor) -> u64 {
    debugger_trace_session_descriptor.address
}

pub machine DebuggerTraceSessionDescriptor::get_size_in_bytes(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor) -> u64 {
    debugger_trace_session_descriptor.size_in_bytes
}

pub machine DebuggerTraceSessionDescriptor::get_access(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor) -> DebuggerDataBreakpointAccess {
    debugger_trace_session_descriptor.access
}

pub machine DebuggerTraceSessionDescriptor::get_breakpoint(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor) -> &DebuggerBreakpointDescriptor {
    (&debugger_trace_session_descriptor.breakpoint)
}

pub machine DebuggerTraceSessionDescriptor::set_breakpoint(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, breakpoint: DebuggerBreakpointDescriptor) {
    debugger_trace_session_descriptor.breakpoint = breakpoint;
}

pub machine DebuggerTraceSessionDescriptor::has_label(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor) -> bool {
    debugger_trace_session_descriptor.has_label
}

pub machine DebuggerTraceSessionDescriptor::get_label(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor) -> &[u8] {
    transition debugger_trace_session_descriptor.has_label && debugger_trace_session_descriptor.label_len <= 256 {
        true -> (&debugger_trace_session_descriptor.label[0..debugger_trace_session_descriptor.label_len])
        _ -> (&debugger_trace_session_descriptor.label[0..0])
    }
}

pub machine DebuggerTraceSessionDescriptor::get_label_len(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor) -> u64 {
    debugger_trace_session_descriptor.label_len
}

pub machine DebuggerTraceSessionDescriptor::set_label(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, label: &[u8]) {
    transition 0 == 0 {
        _ -> copy_label(debugger_trace_session_descriptor, label, 0)
    }
    state copy_label(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store_label(debugger_trace_session_descriptor, label, position)
            _ -> done_label(debugger_trace_session_descriptor, position)
        }
    }
    state store_label(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, label: &[u8], position: u64)
        requires position < label.len && position < 256 {
        debugger_trace_session_descriptor.label[position] = label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_label(debugger_trace_session_descriptor, label, next)
        }
    }
    state done_label(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, position: u64) {
        debugger_trace_session_descriptor.label_len = position;
        debugger_trace_session_descriptor.has_label = true;
        transition 0 == 0 {
            _ -> (debugger_trace_session_descriptor)
        }
    }
}

pub machine DebuggerTraceSessionDescriptor::clear_label(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor) {
    debugger_trace_session_descriptor.has_label = false;
    debugger_trace_session_descriptor.label_len = 0;
}

pub machine DebuggerTraceSessionDescriptor::get_is_active(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor) -> bool {
    debugger_trace_session_descriptor.is_active
}

pub machine DebuggerTraceSessionDescriptor::set_is_active(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, is_active: bool) {
    debugger_trace_session_descriptor.is_active = is_active;
}

pub machine DebuggerTraceSessionDescriptor::clone(debugger_trace_session_descriptor: &DebuggerTraceSessionDescriptor) -> DebuggerTraceSessionDescriptor {
    let mut clone: DebuggerTraceSessionDescriptor = DebuggerTraceSessionDescriptor::new(0, 0, DebuggerDataBreakpointAccess::Read, false);
    DebuggerTraceSessionDescriptor::clone_from(&mut clone, debugger_trace_session_descriptor);
    (clone)
}

pub machine DebuggerTraceSessionDescriptor::clone_from(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, source: &DebuggerTraceSessionDescriptor) {
    debugger_trace_session_descriptor.trace_session_id_len = source.trace_session_id_len;
    debugger_trace_session_descriptor.address = source.address;
    debugger_trace_session_descriptor.size_in_bytes = source.size_in_bytes;
    debugger_trace_session_descriptor.access = source.access;
    DebuggerBreakpointDescriptor::clone_from(&mut debugger_trace_session_descriptor.breakpoint, &source.breakpoint);
    debugger_trace_session_descriptor.has_label = source.has_label;
    debugger_trace_session_descriptor.label_len = source.label_len;
    debugger_trace_session_descriptor.is_active = source.is_active;
    debugger_trace_session_descriptor.target_kind = source.target_kind;
    transition 0 == 0 {
        _ -> copy_id(debugger_trace_session_descriptor, source, 0)
    }
    state copy_id(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, source: &DebuggerTraceSessionDescriptor, position: u64) {
        transition position < source.trace_session_id_len && position < 64 {
            true -> store_id(debugger_trace_session_descriptor, source, position)
            _ -> copy_label(debugger_trace_session_descriptor, source, 0)
        }
    }
    state store_id(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, source: &DebuggerTraceSessionDescriptor, position: u64)
        requires position < source.trace_session_id_len && position < 64 {
        debugger_trace_session_descriptor.trace_session_id[position] = source.trace_session_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(debugger_trace_session_descriptor, source, next)
        }
    }
    state copy_label(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, source: &DebuggerTraceSessionDescriptor, position: u64) {
        transition position < source.label_len && position < 256 {
            true -> store_label(debugger_trace_session_descriptor, source, position)
            _ -> (debugger_trace_session_descriptor)
        }
    }
    state store_label(debugger_trace_session_descriptor: &mut DebuggerTraceSessionDescriptor, source: &DebuggerTraceSessionDescriptor, position: u64)
        requires position < source.label_len && position < 256 {
        debugger_trace_session_descriptor.label[position] = source.label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_label(debugger_trace_session_descriptor, source, next)
        }
    }
}
