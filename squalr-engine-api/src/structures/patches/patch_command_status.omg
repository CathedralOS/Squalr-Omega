module src::structures::patches::patch_command_status;

use src::structures::bounded_slice::bounded_slice;
use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of structures/patches/patch_command_status.rs — {success: bool,
// message: Option<String>}. The Option carries upstream's `None` on success
// and `Some(detail)` on failure; `message` rides the has_ + bounded span
// respell.
pub data PatchCommandStatus {
    success: bool;
    has_message: bool;
    message: [u8; 256];
    message_len: u64;
}

// Upstream `PatchCommandStatus::success()` — no message.
pub machine PatchCommandStatus::success() -> PatchCommandStatus {
    PatchCommandStatus {
        success: true,
        has_message: false,
        message_len: 0,
    }
}

// Upstream `PatchCommandStatus::failure(message)` — Some(message).
pub machine PatchCommandStatus::failure(message: &[u8]) -> PatchCommandStatus {
    let mut status: PatchCommandStatus = PatchCommandStatus {
        success: false,
        has_message: false,
        message_len: 0,
    };
    status.set_message(message);
    (status)
}

pub machine PatchCommandStatus::get_success(&self) -> bool {
    self.success
}

pub machine PatchCommandStatus::has_message(&self) -> bool {
    self.has_message
}

// The live message span — only meaningful when has_message (upstream's
// get_message() -> Option<&str>).
pub machine PatchCommandStatus::get_message(&self) -> &[u8] {
    bounded_slice(&self.message[0..256], self.message_len)
}

pub machine PatchCommandStatus::set_message(&mut self, message: &[u8]) {
    self.message_len = BoundedByteCopy::copy(&mut self.message[0..256], message);
    self.has_message = true;
}

pub machine PatchCommandStatus::clear_message(&mut self) {
    self.has_message = false;
    self.message_len = 0;
}

pub machine PatchCommandStatus::clone(&self) -> PatchCommandStatus {
    let mut clone: PatchCommandStatus = PatchCommandStatus::success();
    clone.clone_from(self);
    (clone)
}

pub machine PatchCommandStatus::clone_from(&mut self, source: &PatchCommandStatus) {
    self.success = source.success;
    self.has_message = source.has_message;
    self.message_len = source.message_len;
    transition { _ -> copy(source, 0) }
    state copy(&mut self, source: &PatchCommandStatus, position: u64) {
        transition position < source.message_len && position < 256 {
            true -> store(source, position)
            false -> done()
        }
    }
    state store(&mut self, source: &PatchCommandStatus, position: u64) {
        self.message[position] = source.message[position];
        transition {
            _ -> copy(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state done(&mut self) {
    }
}
