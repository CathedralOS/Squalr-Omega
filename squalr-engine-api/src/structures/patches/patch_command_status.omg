module src::structures::patches::patch_command_status;

// Port of structures/patches/patch_command_status.rs — {success: bool,
// message: Option<String>}. The Option carries upstream's `None` on success
// and `Some(detail)` on failure; `message` rides the has_ + bounded span
// respell.
pub data PatchCommandStatus {
    success: bool;
    has_message: bool;
    message: [u8; 256];
    message_len: u64;
}

// Upstream `PatchCommandStatus::success()` — no message.
pub machine PatchCommandStatus::success() -> PatchCommandStatus {
    PatchCommandStatus {
        success: true,
        has_message: false,
        message_len: 0,
    }
}

// Upstream `PatchCommandStatus::failure(message)` — Some(message).
pub machine PatchCommandStatus::failure(message: &[u8]) -> PatchCommandStatus {
    let mut status: PatchCommandStatus = PatchCommandStatus {
        success: false,
        has_message: false,
        message_len: 0,
    };
    PatchCommandStatus::set_message(&mut status, message);
    (status)
}

pub machine PatchCommandStatus::get_success(patch_command_status: &PatchCommandStatus) -> bool {
    patch_command_status.success
}

pub machine PatchCommandStatus::has_message(patch_command_status: &PatchCommandStatus) -> bool {
    patch_command_status.has_message
}

// The live message span — only meaningful when has_message (upstream's
// get_message() -> Option<&str>).
pub machine PatchCommandStatus::get_message(patch_command_status: &PatchCommandStatus) -> &[u8] {
    transition patch_command_status.message_len <= 256 {
        true -> (&patch_command_status.message[0..patch_command_status.message_len])
        false -> (&patch_command_status.message[0..256])
        _ -> (&patch_command_status.message[0..256])
    }
}

pub machine PatchCommandStatus::set_message(patch_command_status: &mut PatchCommandStatus, message: &[u8]) {
    patch_command_status.message_len = 0;
    transition { _ -> copy(patch_command_status, message, 0) }
    state copy(patch_command_status: &mut PatchCommandStatus, message: &[u8], position: u64) {
        transition position < message.len && position < 256 {
            true -> store(patch_command_status, message, position)
            false -> finish(patch_command_status, position)
        }
    }
    state store(patch_command_status: &mut PatchCommandStatus, message: &[u8], position: u64) {
        patch_command_status.message[position] = message[position];
        transition {
            _ -> copy(patch_command_status, message, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(patch_command_status: &mut PatchCommandStatus, count: u64) {
        patch_command_status.message_len = count;
        patch_command_status.has_message = true;
    }
}

pub machine PatchCommandStatus::clear_message(patch_command_status: &mut PatchCommandStatus) {
    patch_command_status.has_message = false;
    patch_command_status.message_len = 0;
}

pub machine PatchCommandStatus::clone(patch_command_status: &PatchCommandStatus) -> PatchCommandStatus {
    let mut clone: PatchCommandStatus = PatchCommandStatus::success();
    PatchCommandStatus::clone_from(&mut clone, patch_command_status);
    (clone)
}

pub machine PatchCommandStatus::clone_from(patch_command_status: &mut PatchCommandStatus, source: &PatchCommandStatus) {
    patch_command_status.success = source.success;
    patch_command_status.has_message = source.has_message;
    patch_command_status.message_len = source.message_len;
    transition { _ -> copy(patch_command_status, source, 0) }
    state copy(patch_command_status: &mut PatchCommandStatus, source: &PatchCommandStatus, position: u64) {
        transition position < source.message_len && position < 256 {
            true -> store(patch_command_status, source, position)
            false -> done(patch_command_status)
        }
    }
    state store(patch_command_status: &mut PatchCommandStatus, source: &PatchCommandStatus, position: u64) {
        patch_command_status.message[position] = source.message[position];
        transition {
            _ -> copy(patch_command_status, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state done(patch_command_status: &mut PatchCommandStatus) {
    }
}
