module src::structures::patches::patch_descriptor;

use src::structures::memory::normalized_region::NormalizedRegion;
use src::structures::patches::patch_kind::PatchKind;

// Port of structures/patches/patch_descriptor.rs — one tracked patch:
// {patch_id, module_name, region, original_bytes, patched_bytes, kind,
// label: Option, is_active}. Strings ride the bounded [u8; 256] + live
// length carriers; the two byte payloads carry a 256-byte bound with an
// honest refusal (`set_*_bytes -> bool`) instead of silent truncation —
// upstream's Vec is unbounded and a truncated patch stream is wrong data.
// `label` is upstream's Option<String> via has_label + span.
pub data PatchDescriptor {
    patch_id: [u8; 256];
    patch_id_len: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    region: NormalizedRegion;
    original_bytes: [u8; 256];
    original_bytes_len: u64;
    patched_bytes: [u8; 256];
    patched_bytes_len: u64;
    kind: PatchKind;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
    is_active: bool;
}

// Upstream `PatchDescriptor::new` minus the byte payloads — those stage
// through the refusing setters so an oversized span cannot enter silently.
pub machine PatchDescriptor::new(
    patch_id: &[u8],
    module_name: &[u8],
    region: &NormalizedRegion,
    kind: PatchKind,
    is_active: bool
) -> PatchDescriptor {
    let mut descriptor: PatchDescriptor = PatchDescriptor {
        patch_id_len: 0,
        module_name_len: 0,
        original_bytes_len: 0,
        patched_bytes_len: 0,
        kind: kind,
        has_label: false,
        label_len: 0,
        is_active: is_active,
    };
    PatchDescriptor::set_patch_id(&mut descriptor, patch_id);
    PatchDescriptor::set_module_name(&mut descriptor, module_name);
    NormalizedRegion::clone_from(&mut descriptor.region, region);
    (descriptor)
}

pub machine PatchDescriptor::get_patch_id(patch_descriptor: &PatchDescriptor) -> &[u8] {
    transition patch_descriptor.patch_id_len <= 256 {
        true -> (&patch_descriptor.patch_id[0..patch_descriptor.patch_id_len])
        false -> (&patch_descriptor.patch_id[0..256])
        _ -> (&patch_descriptor.patch_id[0..256])
    }
}

pub machine PatchDescriptor::get_module_name(patch_descriptor: &PatchDescriptor) -> &[u8] {
    transition patch_descriptor.module_name_len <= 256 {
        true -> (&patch_descriptor.module_name[0..patch_descriptor.module_name_len])
        false -> (&patch_descriptor.module_name[0..256])
        _ -> (&patch_descriptor.module_name[0..256])
    }
}

pub machine PatchDescriptor::get_region(patch_descriptor: &PatchDescriptor) -> &NormalizedRegion {
    &patch_descriptor.region
}

pub machine PatchDescriptor::get_original_bytes(patch_descriptor: &PatchDescriptor) -> &[u8] {
    transition patch_descriptor.original_bytes_len <= 256 {
        true -> (&patch_descriptor.original_bytes[0..patch_descriptor.original_bytes_len])
        false -> (&patch_descriptor.original_bytes[0..256])
        _ -> (&patch_descriptor.original_bytes[0..256])
    }
}

pub machine PatchDescriptor::get_patched_bytes(patch_descriptor: &PatchDescriptor) -> &[u8] {
    transition patch_descriptor.patched_bytes_len <= 256 {
        true -> (&patch_descriptor.patched_bytes[0..patch_descriptor.patched_bytes_len])
        false -> (&patch_descriptor.patched_bytes[0..256])
        _ -> (&patch_descriptor.patched_bytes[0..256])
    }
}

pub machine PatchDescriptor::get_kind(patch_descriptor: &PatchDescriptor) -> PatchKind {
    patch_descriptor.kind
}

pub machine PatchDescriptor::has_label(patch_descriptor: &PatchDescriptor) -> bool {
    patch_descriptor.has_label
}

pub machine PatchDescriptor::get_label(patch_descriptor: &PatchDescriptor) -> &[u8] {
    transition patch_descriptor.label_len <= 256 {
        true -> (&patch_descriptor.label[0..patch_descriptor.label_len])
        false -> (&patch_descriptor.label[0..256])
        _ -> (&patch_descriptor.label[0..256])
    }
}

pub machine PatchDescriptor::get_is_active(patch_descriptor: &PatchDescriptor) -> bool {
    patch_descriptor.is_active
}

pub machine PatchDescriptor::set_is_active(patch_descriptor: &mut PatchDescriptor, is_active: bool) {
    patch_descriptor.is_active = is_active;
}

pub machine PatchDescriptor::set_patch_id(patch_descriptor: &mut PatchDescriptor, patch_id: &[u8]) {
    patch_descriptor.patch_id_len = 0;
    transition { _ -> copy(patch_descriptor, patch_id, 0) }
    state copy(patch_descriptor: &mut PatchDescriptor, patch_id: &[u8], position: u64) {
        transition position < patch_id.len && position < 256 {
            true -> store(patch_descriptor, patch_id, position)
            false -> finish(patch_descriptor, position)
        }
    }
    state store(patch_descriptor: &mut PatchDescriptor, patch_id: &[u8], position: u64) {
        patch_descriptor.patch_id[position] = patch_id[position];
        transition {
            _ -> copy(patch_descriptor, patch_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(patch_descriptor: &mut PatchDescriptor, count: u64) {
        patch_descriptor.patch_id_len = count;
    }
}

pub machine PatchDescriptor::set_module_name(patch_descriptor: &mut PatchDescriptor, module_name: &[u8]) {
    patch_descriptor.module_name_len = 0;
    transition { _ -> copy(patch_descriptor, module_name, 0) }
    state copy(patch_descriptor: &mut PatchDescriptor, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(patch_descriptor, module_name, position)
            false -> finish(patch_descriptor, position)
        }
    }
    state store(patch_descriptor: &mut PatchDescriptor, module_name: &[u8], position: u64) {
        patch_descriptor.module_name[position] = module_name[position];
        transition {
            _ -> copy(patch_descriptor, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(patch_descriptor: &mut PatchDescriptor, count: u64) {
        patch_descriptor.module_name_len = count;
    }
}

pub machine PatchDescriptor::set_label(patch_descriptor: &mut PatchDescriptor, label: &[u8]) {
    patch_descriptor.label_len = 0;
    transition { _ -> copy(patch_descriptor, label, 0) }
    state copy(patch_descriptor: &mut PatchDescriptor, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store(patch_descriptor, label, position)
            false -> finish(patch_descriptor, position)
        }
    }
    state store(patch_descriptor: &mut PatchDescriptor, label: &[u8], position: u64) {
        patch_descriptor.label[position] = label[position];
        transition {
            _ -> copy(patch_descriptor, label, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(patch_descriptor: &mut PatchDescriptor, count: u64) {
        patch_descriptor.label_len = count;
        patch_descriptor.has_label = true;
    }
}

pub machine PatchDescriptor::clear_label(patch_descriptor: &mut PatchDescriptor) {
    patch_descriptor.has_label = false;
    patch_descriptor.label_len = 0;
}

// false when the span exceeds the 256-byte carrier — no silent truncation
// of a patch payload.
pub machine PatchDescriptor::set_original_bytes(patch_descriptor: &mut PatchDescriptor, original_bytes: &[u8]) -> bool {
    transition original_bytes.len <= 256 {
        true -> copy(patch_descriptor, original_bytes)
        false -> (false)
    }
    state copy(patch_descriptor: &mut PatchDescriptor, original_bytes: &[u8]) -> bool {
        patch_descriptor.original_bytes_len = original_bytes.len;
        transition { _ -> store(patch_descriptor, original_bytes, 0) }
    }
    state store(patch_descriptor: &mut PatchDescriptor, original_bytes: &[u8], position: u64) -> bool {
        transition position < original_bytes.len && position < 256 {
            true -> store_at(patch_descriptor, original_bytes, position)
            false -> (true)
        }
    }
    state store_at(patch_descriptor: &mut PatchDescriptor, original_bytes: &[u8], position: u64) -> bool {
        patch_descriptor.original_bytes[position] = original_bytes[position];
        transition {
            _ -> store(patch_descriptor, original_bytes, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

pub machine PatchDescriptor::set_patched_bytes(patch_descriptor: &mut PatchDescriptor, patched_bytes: &[u8]) -> bool {
    transition patched_bytes.len <= 256 {
        true -> copy(patch_descriptor, patched_bytes)
        false -> (false)
    }
    state copy(patch_descriptor: &mut PatchDescriptor, patched_bytes: &[u8]) -> bool {
        patch_descriptor.patched_bytes_len = patched_bytes.len;
        transition { _ -> store(patch_descriptor, patched_bytes, 0) }
    }
    state store(patch_descriptor: &mut PatchDescriptor, patched_bytes: &[u8], position: u64) -> bool {
        transition position < patched_bytes.len && position < 256 {
            true -> store_at(patch_descriptor, patched_bytes, position)
            false -> (true)
        }
    }
    state store_at(patch_descriptor: &mut PatchDescriptor, patched_bytes: &[u8], position: u64) -> bool {
        patch_descriptor.patched_bytes[position] = patched_bytes[position];
        transition {
            _ -> store(patch_descriptor, patched_bytes, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

pub machine PatchDescriptor::clone(patch_descriptor: &PatchDescriptor) -> PatchDescriptor {
    let mut clone: PatchDescriptor = PatchDescriptor {
        patch_id_len: 0,
        module_name_len: 0,
        original_bytes_len: 0,
        patched_bytes_len: 0,
        kind: patch_descriptor.kind,
        has_label: false,
        label_len: 0,
        is_active: false,
    };
    PatchDescriptor::clone_from(&mut clone, patch_descriptor);
    (clone)
}

pub machine PatchDescriptor::clone_from(patch_descriptor: &mut PatchDescriptor, source: &PatchDescriptor) {
    PatchDescriptor::set_patch_id(patch_descriptor, PatchDescriptor::get_patch_id(source));
    PatchDescriptor::set_module_name(patch_descriptor, PatchDescriptor::get_module_name(source));
    NormalizedRegion::clone_from(&mut patch_descriptor.region, &source.region);
    _ = PatchDescriptor::set_original_bytes(patch_descriptor, PatchDescriptor::get_original_bytes(source));
    _ = PatchDescriptor::set_patched_bytes(patch_descriptor, PatchDescriptor::get_patched_bytes(source));
    patch_descriptor.kind = source.kind;
    patch_descriptor.is_active = source.is_active;
    transition source.has_label {
        true -> copy_label(patch_descriptor, source)
        false -> drop_label(patch_descriptor)
    }
    state copy_label(patch_descriptor: &mut PatchDescriptor, source: &PatchDescriptor) {
        PatchDescriptor::set_label(patch_descriptor, PatchDescriptor::get_label(source));
    }
    state drop_label(patch_descriptor: &mut PatchDescriptor) {
        PatchDescriptor::clear_label(patch_descriptor);
    }
}
