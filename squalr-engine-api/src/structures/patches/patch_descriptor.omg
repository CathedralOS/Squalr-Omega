module src::structures::patches::patch_descriptor;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::bounded_slice::bounded_slice;

use src::structures::memory::normalized_region::NormalizedRegion;
use src::structures::patches::patch_kind::PatchKind;

// Port of structures/patches/patch_descriptor.rs — one tracked patch:
// {patch_id, module_name, region, original_bytes, patched_bytes, kind,
// label: Option, is_active}. Strings ride the bounded [u8; 256] + live
// length carriers; the two byte payloads carry a 256-byte bound with an
// honest refusal (`set_*_bytes -> bool`) instead of silent truncation —
// upstream's Vec is unbounded and a truncated patch stream is wrong data.
// `label` is upstream's Option<String> via has_label + span.
pub data PatchDescriptor {
    patch_id: [u8; 256];
    patch_id_len: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    region: NormalizedRegion;
    original_bytes: [u8; 256];
    original_bytes_len: u64;
    patched_bytes: [u8; 256];
    patched_bytes_len: u64;
    kind: PatchKind;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
    is_active: bool;
}

// Upstream `PatchDescriptor::new` minus the byte payloads — those stage
// through the refusing setters so an oversized span cannot enter silently.
pub machine PatchDescriptor::new(
    patch_id: &[u8],
    module_name: &[u8],
    region: &NormalizedRegion,
    kind: PatchKind,
    is_active: bool
) -> PatchDescriptor {
    let mut descriptor: PatchDescriptor = PatchDescriptor {
        patch_id_len: 0,
        module_name_len: 0,
        original_bytes_len: 0,
        patched_bytes_len: 0,
        kind: kind,
        has_label: false,
        label_len: 0,
        is_active: is_active,
    };
    descriptor.set_patch_id(patch_id);
    descriptor.set_module_name(module_name);
    descriptor.region.clone_from(region);
    (descriptor)
}

pub machine PatchDescriptor::get_patch_id(&self) -> &[u8] {
    bounded_slice(&self.patch_id[0..256], self.patch_id_len)
}

pub machine PatchDescriptor::get_module_name(&self) -> &[u8] {
    bounded_slice(&self.module_name[0..256], self.module_name_len)
}

pub machine PatchDescriptor::get_region(&self) -> &NormalizedRegion {
    &self.region
}

pub machine PatchDescriptor::get_original_bytes(&self) -> &[u8] {
    bounded_slice(&self.original_bytes[0..256], self.original_bytes_len)
}

pub machine PatchDescriptor::get_patched_bytes(&self) -> &[u8] {
    bounded_slice(&self.patched_bytes[0..256], self.patched_bytes_len)
}

pub machine PatchDescriptor::get_kind(&self) -> PatchKind {
    self.kind
}

pub machine PatchDescriptor::has_label(&self) -> bool {
    self.has_label
}

pub machine PatchDescriptor::get_label(&self) -> &[u8] {
    bounded_slice(&self.label[0..256], self.label_len)
}

pub machine PatchDescriptor::get_is_active(&self) -> bool {
    self.is_active
}

pub machine PatchDescriptor::set_is_active(&mut self, is_active: bool) {
    self.is_active = is_active;
}

pub machine PatchDescriptor::set_patch_id(&mut self, patch_id: &[u8]) {
    self.patch_id_len = BoundedByteCopy::copy(&mut self.patch_id[0..256], patch_id);
}

pub machine PatchDescriptor::set_module_name(&mut self, module_name: &[u8]) {
    self.module_name_len = BoundedByteCopy::copy(&mut self.module_name[0..256], module_name);
}

pub machine PatchDescriptor::set_label(&mut self, label: &[u8]) {
    self.label_len = 0;
    transition { _ -> copy(label, 0) }
    state copy(&mut self, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store(label, position)
            false -> finish(position)
        }
    }
    state store(&mut self, label: &[u8], position: u64) {
        self.label[position] = label[position];
        transition {
            _ -> copy(label, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.label_len = count;
        self.has_label = true;
    }
}

pub machine PatchDescriptor::clear_label(&mut self) {
    self.has_label = false;
    self.label_len = 0;
}

// false when the span exceeds the 256-byte carrier — no silent truncation
// of a patch payload.
pub machine PatchDescriptor::set_original_bytes(&mut self, original_bytes: &[u8]) -> bool {
    transition original_bytes.len <= 256 {
        true -> copy(original_bytes)
        false -> (false)
    }
    state copy(&mut self, original_bytes: &[u8]) -> bool {
        self.original_bytes_len = BoundedByteCopy::copy(&mut self.original_bytes[0..256], original_bytes);
        (true)
    }
}

pub machine PatchDescriptor::set_patched_bytes(&mut self, patched_bytes: &[u8]) -> bool {
    transition patched_bytes.len <= 256 {
        true -> copy(patched_bytes)
        false -> (false)
    }
    state copy(&mut self, patched_bytes: &[u8]) -> bool {
        self.patched_bytes_len = BoundedByteCopy::copy(&mut self.patched_bytes[0..256], patched_bytes);
        (true)
    }
}

pub machine PatchDescriptor::clone(&self) -> PatchDescriptor {
    let mut clone: PatchDescriptor = PatchDescriptor {
        patch_id_len: 0,
        module_name_len: 0,
        original_bytes_len: 0,
        patched_bytes_len: 0,
        kind: self.kind,
        has_label: false,
        label_len: 0,
        is_active: false,
    };
    clone.clone_from(self);
    (clone)
}

pub machine PatchDescriptor::clone_from(&mut self, source: &PatchDescriptor) {
    self.set_patch_id(source.get_patch_id());
    self.set_module_name(source.get_module_name());
    self.region.clone_from(&source.region);
    _ = self.set_original_bytes(source.get_original_bytes());
    _ = self.set_patched_bytes(source.get_patched_bytes());
    self.kind = source.kind;
    self.is_active = source.is_active;
    transition source.has_label {
        true -> copy_label(source)
        false -> drop_label()
    }
    state copy_label(&mut self, source: &PatchDescriptor) {
        self.set_label(source.get_label());
    }
    state drop_label(&mut self) {
        self.clear_label();
    }
}
