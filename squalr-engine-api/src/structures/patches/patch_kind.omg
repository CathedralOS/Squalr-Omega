module src::structures::patches::patch_kind;

// Port of structures/patches/patch_kind.rs — upstream Default is Code.
// Upstream also carries fmt::Display + FromStr for CLI argument parsing;
// those are CLI-side text conventions, not payload fields, so they stay
// with the CLI arg-parsing leg rather than the command surface.
pub data PatchKind [copy] {
    case Code;
    case NoOperation;
    case SoftwareBreakpoint;
    case Generic;
}

pub machine PatchKind::default() -> PatchKind {
    (PatchKind::Code)
}
