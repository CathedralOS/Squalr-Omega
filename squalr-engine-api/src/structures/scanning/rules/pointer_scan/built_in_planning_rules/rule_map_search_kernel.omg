use src/structures/scanning/plans/pointer_scan/planned_pointer_scan_kernel_kind.omg;
use src/structures/scanning/plans/pointer_scan/pointer_scan_execution_plan.omg;
use src/structures/scanning/rules/pointer_scan_planning_rule.omg;

// Port of structures/scanning/rules/pointer_scan/built_in_planning_rules/
// rule_map_search_kernel.rs: the built-in kernel-selection rule — SIMD linear
// for small frontiers, scalar linear for medium, scalar binary for large.
public data RuleMapSearchKernel {}

public machine RuleMapSearchKernel::rule_id() -> &[u8] {
    ("map_search_kernel")
}

public machine RuleMapSearchKernel::get_id(this: &RuleMapSearchKernel) -> &[u8]
satisfies |pointer_scan_planning_rule|::PointerScanPlanningRule<RuleMapSearchKernel>::get_id
{
    RuleMapSearchKernel::rule_id()
}

public machine RuleMapSearchKernel::map_plan(
    this: &RuleMapSearchKernel,
    pointer_scan_execution_plan: &mut |pointer_scan_execution_plan|::PointerScanExecutionPlan
)
satisfies |pointer_scan_planning_rule|::PointerScanPlanningRule<RuleMapSearchKernel>::map_plan
{
    let planned_kernel_kind: |planned_pointer_scan_kernel_kind|::PlannedPointerScanKernelKind =
        RuleMapSearchKernel::select_kernel_kind(&mut pointer_scan_execution_plan);
    |pointer_scan_execution_plan|::PointerScanExecutionPlan::set_planned_kernel_kind(&mut pointer_scan_execution_plan, planned_kernel_kind);
}

// Upstream SIMD_LINEAR_RANGE_THRESHOLD (8) and
// SCALAR_LINEAR_RANGE_THRESHOLD (64).
machine RuleMapSearchKernel::select_kernel_kind(
    pointer_scan_execution_plan: &|pointer_scan_execution_plan|::PointerScanExecutionPlan
) -> |planned_pointer_scan_kernel_kind|::PlannedPointerScanKernelKind {
    let hoist_a: u64 = |pointer_scan_execution_plan|::PointerScanExecutionPlan::get_frontier_target_range_count(&pointer_scan_execution_plan);
    transition (hoist_a <= 8) {
        true -> arm_result_38_0(pointer_scan_execution_plan)
        false -> choose_scalar(pointer_scan_execution_plan)
    }
    machine choose_scalar(
        pointer_scan_execution_plan: &|pointer_scan_execution_plan|::PointerScanExecutionPlan
    ) -> |planned_pointer_scan_kernel_kind|::PlannedPointerScanKernelKind {
        let hoist_b: u64 = |pointer_scan_execution_plan|::PointerScanExecutionPlan::get_frontier_target_range_count(&pointer_scan_execution_plan);
        transition (hoist_b <= 64) {
            true -> arm_result_45_0(pointer_scan_execution_plan)
            false -> (|planned_pointer_scan_kernel_kind|::PlannedPointerScanKernelKind::ScalarBinary)
        }
    }
    machine arm_result_38_0(pointer_scan_execution_plan: &|pointer_scan_execution_plan|::PointerScanExecutionPlan) -> |planned_pointer_scan_kernel_kind|::PlannedPointerScanKernelKind
    {
        (|planned_pointer_scan_kernel_kind|::PlannedPointerScanKernelKind::SimdLinear)
    }
    machine arm_result_45_0(pointer_scan_execution_plan: &|pointer_scan_execution_plan|::PointerScanExecutionPlan) -> |planned_pointer_scan_kernel_kind|::PlannedPointerScanKernelKind
    {
        (|planned_pointer_scan_kernel_kind|::PlannedPointerScanKernelKind::ScalarLinear)
    }
}
