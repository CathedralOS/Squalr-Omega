module src::structures::scanning::rules::pointer_scan::built_in_planning_rules::rule_map_search_kernel;

use src::structures::scanning::plans::pointer_scan::planned_pointer_scan_kernel_kind::PlannedPointerScanKernelKind;
use src::structures::scanning::plans::pointer_scan::pointer_scan_execution_plan::PointerScanExecutionPlan;
use src::structures::scanning::rules::pointer_scan_planning_rule::PointerScanPlanningRule;

// Port of structures/scanning/rules/pointer_scan/built_in_planning_rules/
// rule_map_search_kernel.rs: the built-in kernel-selection rule — SIMD linear
// for small frontiers, scalar linear for medium, scalar binary for large.
pub data RuleMapSearchKernel {}

pub machine RuleMapSearchKernel::rule_id() -> &[u8] {
    ("map_search_kernel")
}

pub machine RuleMapSearchKernel::get_id(&self) -> &[u8]
satisfies PointerScanPlanningRule::get_id
{
    RuleMapSearchKernel::rule_id()
}

pub machine RuleMapSearchKernel::map_plan(
    &self,
    pointer_scan_execution_plan: &mut PointerScanExecutionPlan
)
satisfies PointerScanPlanningRule::map_plan
{
    let planned_kernel_kind: PlannedPointerScanKernelKind =
        RuleMapSearchKernel::select_kernel_kind(&mut pointer_scan_execution_plan);
    pointer_scan_execution_plan.set_planned_kernel_kind(planned_kernel_kind);
}

// Upstream SIMD_LINEAR_RANGE_THRESHOLD (8) and
// SCALAR_LINEAR_RANGE_THRESHOLD (64).
machine RuleMapSearchKernel::select_kernel_kind(
    pointer_scan_execution_plan: &PointerScanExecutionPlan
) -> PlannedPointerScanKernelKind {
    transition (pointer_scan_execution_plan.get_frontier_target_range_count() <= 8) {
        true -> (PlannedPointerScanKernelKind::SimdLinear)
        false -> choose_scalar(pointer_scan_execution_plan)
    }
    state choose_scalar(
        pointer_scan_execution_plan: &PointerScanExecutionPlan
    ) -> PlannedPointerScanKernelKind {
        transition (pointer_scan_execution_plan.get_frontier_target_range_count() <= 64) {
            true -> (PlannedPointerScanKernelKind::ScalarLinear)
            false -> (PlannedPointerScanKernelKind::ScalarBinary)
        }
    }
}
