module src::structures::scanning::rules::pointer_scan_planning_rule;

use src::structures::scanning::plans::pointer_scan::pointer_scan_execution_plan::PointerScanExecutionPlan;

// Port of structures/scanning/rules/pointer_scan_planning_rule.rs: the
// planning-rule contract — each rule maps a fresh execution plan to a
// concrete kernel kind before dispatch.
pub trait PointerScanPlanningRule {
    machine get_id(receiver: &Self) -> &[u8];

    machine map_plan(
        receiver: &Self,
        pointer_scan_execution_plan: &mut PointerScanExecutionPlan
    );
}
