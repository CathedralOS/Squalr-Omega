module src::structures::scanning::rules::element_scan::built_in_parameter_rules::rule_map_to_primitive_type;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use src::structures::scanning::constraints::scan_constraint::ScanConstraint;

pub data RuleMapToPrimitiveType {}

// Port of parameter_rule_map_to_primitive_type.rs: rewrites array-of-byte
// constraints whose byte width is a primitive size into the matching
// unsigned big-endian primitive (u8/u16be/u32be/u64be), which scans much
// faster. Upstream resolves the default unit size through SymbolRegistry;
// the scalar leg carries that as the constraint's `is_byte_array` flag — a
// byte-array operand of primitive width is exactly the case upstream's
// `size != default` check admits (named deviation until the registry and
// the array-of-bytes data type are ported).
//
// The sized primitive ids are caller-lent byte text — upstream looks them
// up statically (`DataTypeU8::get_data_type_id()` etc.); Omega records can
// only hold refs of the caller's lifetime, so the four ids arrive as
// parameters.
pub machine RuleMapToPrimitiveType::map_parameters<'a>(
    scan_constraints: &mut [ScanConstraint<'a>],
    u8_id: &'a [u8],
    u16be_id: &'a [u8],
    u32be_id: &'a [u8],
    u64be_id: &'a [u8]
) {
    transition 0 < scan_constraints.len {
        true -> walk(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, 0)
        false -> done()
        _ -> done()
    }

    state walk(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        transition index < scan_constraints.len {
            true -> remap(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            false -> done()
            _ -> done()
        }
    }

    // Upstream skips: relative/delta compares (the data type is
    // load-bearing), floating point (tolerance semantics), and
    // already-canonical sizes.
    state remap(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        transition scan_constraints[index].is_byte_array() && !scan_constraints[index].is_floating_point() {
            true -> immediate(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            false -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
        }
    }

    state immediate(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        transition scan_constraints[index].get_scan_compare_type() {
            ScanCompareType::Immediate { compare_type } -> sized(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
        }
    }

    state sized(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        let operand_size: u64 = scan_constraints[index].get_operand_size_in_bytes();
        transition operand_size {
            8 -> to_u64(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            4 -> to_u32(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            2 -> to_u16(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            1 -> to_u8(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
        }
    }

    state to_u64(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        scan_constraints[index].set_data_type_in_place(DataTypeRef::new(u64be_id));
        transition { _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index) }
    }

    state to_u32(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        scan_constraints[index].set_data_type_in_place(DataTypeRef::new(u32be_id));
        transition { _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index) }
    }

    state to_u16(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        scan_constraints[index].set_data_type_in_place(DataTypeRef::new(u16be_id));
        transition { _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index) }
    }

    state to_u8(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        scan_constraints[index].set_data_type_in_place(DataTypeRef::new(u8_id));
        transition { _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index) }
    }

    state advance(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        transition {
            _ -> walk(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
        }
    }

    state done() {
    }
}
