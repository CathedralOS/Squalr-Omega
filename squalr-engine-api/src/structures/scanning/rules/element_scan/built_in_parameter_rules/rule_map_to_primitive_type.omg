module src::structures::scanning::rules::element_scan::built_in_parameter_rules::rule_map_to_primitive_type;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use src::structures::scanning::constraints::scan_constraint::ScanConstraint;
use src::structures::scanning::constraints::scan_constraint_builder::PatternScanConstraint;

pub data RuleMapToPrimitiveType {}

// Port of parameter_rule_map_to_primitive_type.rs: rewrites
// array-of-byte constraints whose byte width is a primitive size into the
// matching unsigned big-endian primitive (u8/u16be/u32be/u64be), which
// scans much faster. Upstream resolves the default unit size through
// SymbolRegistry (`get_unit_size_in_bytes(data_type_ref)`); the port reads
// the same fact off the carried `DataTypeRef` (the flattened registry).
// Upstream's skip condition is `data_type_size == data_type_default_size &&
// size in {1,2,4,8}` — scalar primitives at their canonical width, where a
// remap would be meaningless or worse (e.g. `i16` -> `u16` would open a
// signed->unsigned trap for the `>= 0` to `!= 0` optimizations). The rule
// then dispatches on `data_type_size`: {8,4,2,1} remap, anything else is
// left alone (three/five/six/seven-byte spans stay byte-array scans).
//
// The sized primitive ids are caller-lent byte text — upstream looks them
// up statically (`DataTypeU8::get_data_type_id()` etc.); Omega records can
// only hold refs of the caller's lifetime, so the four ids arrive as
// parameters.
pub machine RuleMapToPrimitiveType::map_parameters<'a>(
    scan_constraints: &mut [ScanConstraint<'a>],
    u8_id: &'a [u8],
    u16be_id: &'a [u8],
    u32be_id: &'a [u8],
    u64be_id: &'a [u8]
) {
    transition 0 < scan_constraints.len {
        true -> walk(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, 0)
        false -> done()
        _ -> done()
    }

    state walk(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        transition index < scan_constraints.len {
            true -> remap(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            false -> done()
            _ -> done()
        }
    }

    // Upstream skips: relative/delta compares (the data type is
    // load-bearing), floating point (tolerance semantics), and
    // already-canonical sizes.
    state remap(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        let data_type_ref: DataTypeRef = ScanConstraint::get_data_type_ref(&scan_constraints[index]);
        let default_size: u64 = DataTypeRef::get_unit_size_in_bytes(&data_type_ref);
        let data_type_size: u64 = ScanConstraint::get_operand_size_in_bytes(&scan_constraints[index]);
        let canonical: bool = data_type_size == default_size
            && (data_type_size == 1 || data_type_size == 2 || data_type_size == 4 || data_type_size == 8);
        let hoist1: bool = ScanConstraint::is_floating_point(&scan_constraints[index]);
        transition !hoist1 && !canonical {
            true -> immediate(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            false -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
        }
    }

    state immediate(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        let hoist2: ScanCompareType = ScanConstraint::get_scan_compare_type(&scan_constraints[index]);
        transition hoist2 {
            ScanCompareType::Immediate { compare_type } -> sized(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
        }
    }

    state sized(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        let operand_size: u64 = ScanConstraint::get_operand_size_in_bytes(&scan_constraints[index]);
        transition operand_size {
            8 -> to_u64(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            4 -> to_u32(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            2 -> to_u16(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            1 -> to_u8(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
            _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index)
        }
    }

    state to_u64(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        let new_ref: DataTypeRef = DataTypeRef::new(u64be_id);
        ScanConstraint::set_data_type_in_place(&mut scan_constraints[index], new_ref);
        transition { _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index) }
    }

    state to_u32(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        let new_ref: DataTypeRef = DataTypeRef::new(u32be_id);
        ScanConstraint::set_data_type_in_place(&mut scan_constraints[index], new_ref);
        transition { _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index) }
    }

    state to_u16(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        let new_ref: DataTypeRef = DataTypeRef::new(u16be_id);
        ScanConstraint::set_data_type_in_place(&mut scan_constraints[index], new_ref);
        transition { _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index) }
    }

    state to_u8(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        let new_ref: DataTypeRef = DataTypeRef::new(u8_id);
        ScanConstraint::set_data_type_in_place(&mut scan_constraints[index], new_ref);
        transition { _ -> advance(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, index) }
    }

    state advance(
        scan_constraints: &mut [ScanConstraint<'a>],
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8],
        index: u64
    ) {
        transition {
            _ -> walk(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id, ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
        }
    }

    state done() {
    }
}

// The per-constraint application of `map_parameters` — upstream's fold
// applies the rule to every element of the built `Vec<ScanConstraint>`
// independently (each rule only mutates an element by its own fields), so
// single-element application is the same rewrite. Callers that do not hold
// a slice (the deanonymizer's built-constraint pipeline, the pointer
// target's `vec![constraint]` upstream equivalent) use this entry.
pub machine RuleMapToPrimitiveType::map_parameter<'a>(
    scan_constraint: &mut ScanConstraint<'a>,
    u8_id: &'a [u8],
    u16be_id: &'a [u8],
    u32be_id: &'a [u8],
    u64be_id: &'a [u8]
) {
    transition { _ -> gate(scan_constraint, u8_id, u16be_id, u32be_id, u64be_id) }

    state gate(
        scan_constraint: &mut ScanConstraint<'a>,
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8]
    ) {
        let data_type_ref: DataTypeRef = ScanConstraint::get_data_type_ref(&scan_constraint);
        let default_size: u64 = DataTypeRef::get_unit_size_in_bytes(&data_type_ref);
        let data_type_size: u64 = ScanConstraint::get_operand_size_in_bytes(&scan_constraint);
        let canonical: bool = data_type_size == default_size
            && (data_type_size == 1 || data_type_size == 2 || data_type_size == 4 || data_type_size == 8);
        let hoist3: bool = ScanConstraint::is_floating_point(&scan_constraint);
        transition !hoist3 && !canonical {
            true -> immediate(scan_constraint, u8_id, u16be_id, u32be_id, u64be_id)
            false -> done()
            _ -> done()
        }
    }

    state immediate(
        scan_constraint: &mut ScanConstraint<'a>,
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8]
    ) {
        let hoist4: ScanCompareType = ScanConstraint::get_scan_compare_type(&scan_constraint);
        transition hoist4 {
            ScanCompareType::Immediate { compare_type } -> sized(scan_constraint, u8_id, u16be_id, u32be_id, u64be_id)
            _ -> done()
        }
    }

    state sized(
        scan_constraint: &mut ScanConstraint<'a>,
        u8_id: &'a [u8],
        u16be_id: &'a [u8],
        u32be_id: &'a [u8],
        u64be_id: &'a [u8]
    ) {
        let operand_size: u64 = ScanConstraint::get_operand_size_in_bytes(&scan_constraint);
        transition operand_size {
            8 -> retype(scan_constraint, u64be_id)
            4 -> retype(scan_constraint, u32be_id)
            2 -> retype(scan_constraint, u16be_id)
            1 -> retype(scan_constraint, u8_id)
            _ -> done()
        }
    }

    state retype(
        scan_constraint: &mut ScanConstraint<'a>,
        new_id: &'a [u8]
    ) {
        let new_ref: DataTypeRef = DataTypeRef::new(new_id);
        ScanConstraint::set_data_type_in_place(&mut scan_constraint, new_ref);
        transition { _ -> done() }
    }

    state done() {
    }
}

// The pattern-carrier application. Upstream runs this rule over every built
// `ScanConstraint`, including multi-byte patterns: `data_type_size` there
// is the pattern's full span, so only spans of {1,2,4,8} bytes can remap —
// anything wider falls through the match arms untouched (a >8-byte pattern
// provably keeps its own type). Returns whether the remap fired, so the
// caller can route the now-primitive constraint down the scalar plan path
// the way upstream's finalized does.
pub machine RuleMapToPrimitiveType::map_parameter_pattern(
    pattern: &mut PatternScanConstraint,
    u8_id: &[u8],
    u16be_id: &[u8],
    u32be_id: &[u8],
    u64be_id: &[u8]
) -> bool {
    transition { _ -> gate(pattern, u8_id, u16be_id, u32be_id, u64be_id) }

    state gate(
        pattern: &mut PatternScanConstraint,
        u8_id: &[u8],
        u16be_id: &[u8],
        u32be_id: &[u8],
        u64be_id: &[u8]
    ) -> bool {
        let data_type_ref: DataTypeRef = PatternScanConstraint::get_data_type_ref(&pattern);
        let default_size: u64 = DataTypeRef::get_unit_size_in_bytes(&data_type_ref);
        let data_type_size: u64 = PatternScanConstraint::get_size_in_bytes(&pattern);
        let canonical: bool = data_type_size == default_size
            && (data_type_size == 1 || data_type_size == 2 || data_type_size == 4 || data_type_size == 8);
        let hoist5: bool = PatternScanConstraint::is_floating_point(&pattern);
        transition !hoist5 && !canonical {
            true -> immediate(pattern, u8_id, u16be_id, u32be_id, u64be_id)
            false -> (false)
            _ -> (false)
        }
    }

    state immediate(
        pattern: &mut PatternScanConstraint,
        u8_id: &[u8],
        u16be_id: &[u8],
        u32be_id: &[u8],
        u64be_id: &[u8]
    ) -> bool {
        let hoist6: ScanCompareType = PatternScanConstraint::get_scan_compare_type(&pattern);
        transition hoist6 {
            ScanCompareType::Immediate { compare_type } -> sized(pattern, u8_id, u16be_id, u32be_id, u64be_id)
            _ -> (false)
        }
    }

    state sized(
        pattern: &mut PatternScanConstraint,
        u8_id: &[u8],
        u16be_id: &[u8],
        u32be_id: &[u8],
        u64be_id: &[u8]
    ) -> bool {
        let data_type_size: u64 = PatternScanConstraint::get_size_in_bytes(&pattern);
        transition data_type_size {
            8 -> retype(pattern, u64be_id)
            4 -> retype(pattern, u32be_id)
            2 -> retype(pattern, u16be_id)
            1 -> retype(pattern, u8_id)
            _ -> (false)
        }
    }

    state retype(
        pattern: &mut PatternScanConstraint,
        new_id: &[u8]
    ) -> bool {
        let new_ref: DataTypeRef = DataTypeRef::new(new_id);
        PatternScanConstraint::set_data_type_in_place(&mut pattern, &new_ref);
        (true)
    }
}
