module src::structures::scanning::rules::element_scan::built_in_parameter_rules::rule_map_unsigned_greater_than_zero_to_not_equal;

use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use src::structures::scanning::comparisons::scan_compare_type_immediate::ScanCompareTypeImmediate;
use src::structures::scanning::constraints::scan_constraint::ScanConstraint;
use src::structures::scanning::constraints::scan_constraint_builder::PatternScanConstraint;

pub data RuleMapUnsignedGreaterThanZeroToNotEqual {}

// Port of parameter_rule_map_unsigned_greater_than_zero_to_not_equal.rs:
// rewrites `> 0` immediate compares on unsigned, non-floating, all-zero
// operands into `!=` — internally faster with identical results (an
// unsigned value is > 0 iff it is != 0). Signed/floating facts upstream
// reads from SymbolRegistry ride as the constraint's caller-set flags.
// `is_all_zero` over the operand's value bytes reduces to the decoded
// operand being zero.
pub machine RuleMapUnsignedGreaterThanZeroToNotEqual::map_parameters<'a>(
    scan_constraints: &mut [ScanConstraint<'a>]
) {
    transition 0 < scan_constraints.len {
        true -> walk(scan_constraints, 0)
        false -> done()
        _ -> done()
    }

    state walk(
        scan_constraints: &mut [ScanConstraint<'a>],
        index: u64
    ) {
        transition index < scan_constraints.len {
            true -> remap(scan_constraints, index)
            false -> done()
            _ -> done()
        }
    }

    state remap(
        scan_constraints: &mut [ScanConstraint<'a>],
        index: u64
    ) {
        let hoist3: u64 = ScanConstraint::get_operand_value(&scan_constraints[index]);
        let hoist2: bool = ScanConstraint::is_floating_point(&scan_constraints[index]);
        let hoist1: bool = ScanConstraint::is_signed(&scan_constraints[index]);
        transition !hoist1
            && !hoist2
            && hoist3 == 0
        {
            true -> immediate(scan_constraints, index)
            false -> advance(scan_constraints, index)
            _ -> advance(scan_constraints, index)
        }
    }

    state immediate(
        scan_constraints: &mut [ScanConstraint<'a>],
        index: u64
    ) {
        let hoist4: ScanCompareType = ScanConstraint::get_scan_compare_type(&scan_constraints[index]);
        transition hoist4 {
            ScanCompareType::Immediate { compare_type } -> greater(scan_constraints, index, compare_type)
            _ -> advance(scan_constraints, index)
        }
    }

    state greater(
        scan_constraints: &mut [ScanConstraint<'a>],
        index: u64,
        compare_type: ScanCompareTypeImmediate
    ) {
        transition compare_type {
            ScanCompareTypeImmediate::GreaterThan -> apply(scan_constraints, index)
            _ -> advance(scan_constraints, index)
        }
    }

    state apply(
        scan_constraints: &mut [ScanConstraint<'a>],
        index: u64
    ) {
        ScanConstraint::set_scan_compare_type(&mut scan_constraints[index], ScanCompareType::Immediate {
                compare_type: ScanCompareTypeImmediate::NotEqual
            });
        transition { _ -> advance(scan_constraints, index) }
    }

    state advance(
        scan_constraints: &mut [ScanConstraint<'a>],
        index: u64
    ) {
        transition {
            _ -> walk(scan_constraints, ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
        }
    }

    state done() {
    }
}

// The per-constraint application of `map_parameters` — upstream's fold
// touches each element independently, so single-element application is the
// same rewrite (see `RuleMapToPrimitiveType::map_parameter`).
pub machine RuleMapUnsignedGreaterThanZeroToNotEqual::map_parameter<'a>(
    scan_constraint: &mut ScanConstraint<'a>
) {
    let hoist7: u64 = ScanConstraint::get_operand_value(&scan_constraint);
    let hoist6: bool = ScanConstraint::is_floating_point(&scan_constraint);
    let hoist5: bool = ScanConstraint::is_signed(&scan_constraint);
    transition !hoist5
        && !hoist6
        && hoist7 == 0
    {
        true -> immediate(scan_constraint)
        false -> done()
        _ -> done()
    }

    state immediate(
        scan_constraint: &mut ScanConstraint<'a>
    ) {
        let hoist8: ScanCompareType = ScanConstraint::get_scan_compare_type(&scan_constraint);
        transition hoist8 {
            ScanCompareType::Immediate { compare_type } -> greater(scan_constraint, compare_type)
            _ -> done()
        }
    }

    state greater(
        scan_constraint: &mut ScanConstraint<'a>,
        compare_type: ScanCompareTypeImmediate
    ) {
        transition compare_type {
            ScanCompareTypeImmediate::GreaterThan -> apply(scan_constraint)
            _ -> done()
        }
    }

    state apply(
        scan_constraint: &mut ScanConstraint<'a>
    ) {
        ScanConstraint::set_scan_compare_type(&mut scan_constraint, ScanCompareType::Immediate {
                compare_type: ScanCompareTypeImmediate::NotEqual
            });
        transition { _ -> done() }
    }

    state done() {
    }
}

// The pattern-carrier application: upstream's `is_all_zero` reads
// `get_value_bytes().iter().all(|b| *b == 0)` — the full pattern span —
// so this checks every pattern byte rather than a packed word. Runs after
// the primitive retype in the registry fold, matching upstream's
// `built_in_rules` declaration order; a retyped pattern reads its new
// unsigned ref here, like upstream reads the registry after the swap.
pub machine RuleMapUnsignedGreaterThanZeroToNotEqual::map_parameter_pattern(
    pattern: &mut PatternScanConstraint
) {
    let hoist10: bool = PatternScanConstraint::is_floating_point(&pattern);
    let hoist9: bool = PatternScanConstraint::is_signed(&pattern);
    transition !hoist9 && !hoist10 {
        true -> all_zero(pattern)
        false -> done()
        _ -> done()
    }

    state all_zero(
        pattern: &mut PatternScanConstraint
    ) {
        let pattern_bytes: &[u8] = PatternScanConstraint::get_pattern_bytes(&pattern);
        let pattern_len: u64 = PatternScanConstraint::get_pattern_len(&pattern);
        let zeroed: bool = pattern_bytes_all_zero(pattern_bytes, pattern_len);
        transition zeroed {
            true -> immediate(pattern)
            false -> done()
            _ -> done()
        }
    }

    state immediate(
        pattern: &mut PatternScanConstraint
    ) {
        let hoist11: ScanCompareType = PatternScanConstraint::get_scan_compare_type(&pattern);
        transition hoist11 {
            ScanCompareType::Immediate { compare_type } -> greater(pattern, compare_type)
            _ -> done()
        }
    }

    state greater(
        pattern: &mut PatternScanConstraint,
        compare_type: ScanCompareTypeImmediate
    ) {
        transition compare_type {
            ScanCompareTypeImmediate::GreaterThan -> apply(pattern)
            _ -> done()
        }
    }

    state apply(
        pattern: &mut PatternScanConstraint
    ) {
        PatternScanConstraint::set_scan_compare_type(&mut pattern, ScanCompareType::Immediate {
                compare_type: ScanCompareTypeImmediate::NotEqual
            });
        transition { _ -> done() }
    }

    state done() {
    }
}

// `bytes[0..len].all(|b| *b == 0)` — upstream's `is_all_zero` over the
// value-byte span.
machine pattern_bytes_all_zero(bytes: &[u8], len: u64) -> bool {
    transition { _ -> check(bytes, len, 0) }

    state check(bytes: &[u8], len: u64, at: u64) -> bool {
        transition at < len && at < bytes.len {
            true -> one(bytes, len, at)
            false -> (true)
            _ -> (true)
        }
    }

    state one(bytes: &[u8], len: u64, at: u64) -> bool
        requires at < bytes.len
    {
        transition bytes[at] == 0 {
            true -> check(bytes, len, ((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> (false)
            _ -> (false)
        }
    }
}
