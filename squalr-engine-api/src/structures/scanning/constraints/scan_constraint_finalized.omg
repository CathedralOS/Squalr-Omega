module src::structures::scanning::constraints::scan_constraint_finalized;

use src::structures::data_values::container_type::ContainerType;
use src::structures::data_values::data_value::DataValue;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use src::structures::scanning::comparisons::scan_function_scalar::ScanFunctionScalar;
use src::structures::scanning::constraints::scan_constraint::ScanConstraint;

// Port of ScanConstraintFinalized, scalar leg. Upstream's `new` resolves the
// periodicity (byte-pattern loop), unit size (symbol registry), and per-family
// scan functions from the registry; those registries ride with the plugin
// legs, so the constructor takes the resolved values alongside the constraint.
// Vector scan functions are deferred to the vector scan leg; presence of the
// scalar function is explicit because Optional cannot cross package types.
pub data ScanConstraintFinalized<'type_id, 'bytes, 'mask> {
    scan_constraint: ScanConstraint<'type_id, 'bytes, 'mask>;
    periodicity: u64;
    unit_size_bytes: u64;
    has_scan_function_scalar: bool;
    scan_function_scalar: ScanFunctionScalar;
}

pub machine ScanConstraintFinalized::new<'type_id, 'bytes, 'mask>(
    scan_constraint: ScanConstraint<'type_id, 'bytes, 'mask>,
    periodicity: u64,
    unit_size_bytes: u64,
    has_scan_function_scalar: bool,
    scan_function_scalar: ScanFunctionScalar
) -> ScanConstraintFinalized<'type_id, 'bytes, 'mask> {
    (ScanConstraintFinalized {
        scan_constraint: scan_constraint,
        periodicity: periodicity,
        unit_size_bytes: unit_size_bytes,
        has_scan_function_scalar: has_scan_function_scalar,
        scan_function_scalar: scan_function_scalar,
    })
}

pub machine ScanConstraintFinalized::get_scan_constraint(&self) -> &ScanConstraint {
    &self.scan_constraint
}

pub machine ScanConstraintFinalized::get_scan_compare_type(&self) -> ScanCompareType {
    self.scan_constraint.get_scan_compare_type()
}

pub machine ScanConstraintFinalized::get_data_value(&self) -> &DataValue {
    self.scan_constraint.get_data_value()
}

pub machine ScanConstraintFinalized::get_periodicity(&self) -> u64 {
    self.periodicity
}

pub machine ScanConstraintFinalized::get_unit_size_in_bytes(&self) -> u64 {
    self.unit_size_bytes
}

pub machine ScanConstraintFinalized::has_scan_function_scalar(&self) -> bool {
    self.has_scan_function_scalar
}

pub machine ScanConstraintFinalized::get_scan_function_scalar(&self) -> ScanFunctionScalar {
    self.scan_function_scalar
}

pub machine ScanConstraintFinalized::get_result_container_type(&self) -> ContainerType {
    self.scan_constraint.get_result_container_type()
}
