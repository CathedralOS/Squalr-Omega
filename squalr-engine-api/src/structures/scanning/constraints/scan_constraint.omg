module src::structures::scanning::constraints::scan_constraint;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use src::structures::data_values::container_type::ContainerType;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;

// Port of structures/scanning/constraints/scan_constraint.rs, scalar leg.
// Upstream carries a full `DataValue` (data type + value bytes), a floating
// point tolerance, an optional per-byte mask, and the result container type.
// The scalar leg flattens the value to its decoded u64 operand — upstream's
// scalar compare functions consume the decoded element value plus this same
// captured operand — and the facts upstream answers through SymbolRegistry
// (signed, floating point, scan preference) arrive as caller-set flags until
// the registry is ported. The mask's byte payload rides beside the operand
// as its own u64 word (little-endian byte order, the operand's packing —
// the byte-array masked scanners read `mask_value` byte-wise exactly as
// upstream reads `get_mask()` element-wise; masks past 8 bytes wait on a
// byte-carrying operand surface). The tolerance and container type still
// ride as flags/defaults: floating-point compares are a separate leg.
pub data ScanConstraint<'a> {
    data_type_ref: DataTypeRef;
    scan_compare_type: ScanCompareType;
    operand_value: u64;
    operand_size_in_bytes: u64;
    is_signed: bool;
    is_floating_point: bool;
    prefer_type_scanner: bool;
    floating_point_tolerance: FloatingPointTolerance;
    has_mask: bool;
    mask_value: u64;
    is_byte_array: bool;
    result_container_type: ContainerType;
}

// Upstream `ScanConstraint::new`; the registry facts the upstream registry
// would supply are explicit parameters (see the storage note above).
pub machine ScanConstraint::new<'a>(
    data_type_ref: DataTypeRef,
    scan_compare_type: ScanCompareType,
    operand_value: u64,
    operand_size_in_bytes: u64,
    is_signed: bool,
    is_floating_point: bool,
    prefer_type_scanner: bool,
    floating_point_tolerance: FloatingPointTolerance
) -> ScanConstraint<'a> {
    ScanConstraint {
        data_type_ref: data_type_ref,
        scan_compare_type: scan_compare_type,
        operand_value: operand_value,
        operand_size_in_bytes: operand_size_in_bytes,
        is_signed: is_signed,
        is_floating_point: is_floating_point,
        prefer_type_scanner: prefer_type_scanner,
        floating_point_tolerance: floating_point_tolerance,
        has_mask: false,
        mask_value: 0,
        is_byte_array: false,
        result_container_type: ContainerType::None,
    }
}

// Upstream `ScanConstraint::new_masked`; `mask_value` packs the per-byte
// mask little-endian like `operand_value` packs the compared bytes.
pub machine ScanConstraint::new_masked<'a>(
    data_type_ref: DataTypeRef,
    scan_compare_type: ScanCompareType,
    operand_value: u64,
    operand_size_in_bytes: u64,
    mask_value: u64,
    is_signed: bool,
    is_floating_point: bool,
    prefer_type_scanner: bool,
    floating_point_tolerance: FloatingPointTolerance
) -> ScanConstraint<'a> {
    ScanConstraint {
        data_type_ref: data_type_ref,
        scan_compare_type: scan_compare_type,
        operand_value: operand_value,
        operand_size_in_bytes: operand_size_in_bytes,
        is_signed: is_signed,
        is_floating_point: is_floating_point,
        prefer_type_scanner: prefer_type_scanner,
        floating_point_tolerance: floating_point_tolerance,
        has_mask: true,
        mask_value: mask_value,
        is_byte_array: false,
        result_container_type: ContainerType::None,
    }
}

pub machine ScanConstraint::get_scan_compare_type(scan_constraint: &ScanConstraint) -> ScanCompareType {
    scan_constraint.scan_compare_type
}

pub machine ScanConstraint::set_scan_compare_type(
    scan_constraint: &mut ScanConstraint,
    scan_compare_type: ScanCompareType
) {
    scan_constraint.scan_compare_type = scan_compare_type;
}

pub machine ScanConstraint::get_data_type_ref<'a>(scan_constraint: &ScanConstraint) -> DataTypeRef {
    DataTypeRef::clone(&scan_constraint.data_type_ref)
}

// Upstream `get_data_value().get_size_in_bytes()` — the stored operand's
// byte width.
pub machine ScanConstraint::get_operand_value(scan_constraint: &ScanConstraint) -> u64 {
    scan_constraint.operand_value
}

pub machine ScanConstraint::get_operand_size_in_bytes(scan_constraint: &ScanConstraint) -> u64 {
    scan_constraint.operand_size_in_bytes
}

pub machine ScanConstraint::is_signed(scan_constraint: &ScanConstraint) -> bool {
    scan_constraint.is_signed
}

pub machine ScanConstraint::is_floating_point(scan_constraint: &ScanConstraint) -> bool {
    scan_constraint.is_floating_point
}

// Upstream `get_floating_point_tolerance` / `set_floating_point_tolerance`.
pub machine ScanConstraint::get_floating_point_tolerance(scan_constraint: &ScanConstraint) -> FloatingPointTolerance {
    scan_constraint.floating_point_tolerance
}

pub machine ScanConstraint::set_floating_point_tolerance(
    scan_constraint: &mut ScanConstraint,
    floating_point_tolerance: FloatingPointTolerance
) {
    scan_constraint.floating_point_tolerance = floating_point_tolerance;
}

pub machine ScanConstraint::prefers_type_scanner(scan_constraint: &ScanConstraint) -> bool {
    scan_constraint.prefer_type_scanner
}

pub machine ScanConstraint::has_mask(scan_constraint: &ScanConstraint) -> bool {
    scan_constraint.has_mask
}

// Upstream `get_mask()` — the packed mask word (little-endian byte order
// matching `operand_value`); only read when `has_mask` holds, mirroring
// upstream's Option.
pub machine ScanConstraint::get_mask_value(scan_constraint: &ScanConstraint) -> u64 {
    scan_constraint.mask_value
}

pub machine ScanConstraint::is_byte_array(scan_constraint: &ScanConstraint) -> bool {
    scan_constraint.is_byte_array
}

// Upstream `get_result_container_type` / `set_result_container_type`.
pub machine ScanConstraint::get_result_container_type(scan_constraint: &ScanConstraint) -> ContainerType {
    scan_constraint.result_container_type
}

pub machine ScanConstraint::set_result_container_type(
    scan_constraint: &mut ScanConstraint,
    result_container_type: ContainerType
) {
    scan_constraint.result_container_type = result_container_type;
}

// Upstream `set_data_type_in_place`: swap the registered type handle while
// keeping the operand bytes. `is_byte_array` clears with the swap since the
// remap lands on a primitive. Upstream resolves the type facts through the
// ref at every use site, so they follow the swap for free; the port carries
// them as fields, so the swap re-derives them from the new ref (signed,
// floating point, scan preference, result container). The ref write itself
// is a free machine — attached machines cannot write borrow-carrying
// fields (same split as `store_scan_results` in the snapshot layer).
machine scan_constraint_set_data_type_in_place<'a>(
    constraint: &mut ScanConstraint<'a>,
    data_type_ref: DataTypeRef
) {
    let signed: bool = DataTypeRef::is_signed(&data_type_ref);
    let floating: bool = DataTypeRef::is_floating_point(&data_type_ref);
    let prefer: bool = DataTypeRef::prefers_type_scanner(&data_type_ref);
    let container: ContainerType = DataTypeRef::get_result_container_type(&data_type_ref);
    constraint.data_type_ref = data_type_ref;
    constraint.is_byte_array = false;
    constraint.is_signed = signed;
    constraint.is_floating_point = floating;
    constraint.prefer_type_scanner = prefer;
    constraint.result_container_type = container;
}

pub machine ScanConstraint::set_data_type_in_place<'a>(
    scan_constraint: &mut ScanConstraint,
    data_type_ref: DataTypeRef
) {
    scan_constraint_set_data_type_in_place(&mut scan_constraint, data_type_ref);
}

// Test adapter for the byte-array remap rule: marks the operand as an array
// of bytes so `RuleMapToPrimitiveType` has a mappable input.
pub machine ScanConstraint::mark_byte_array(scan_constraint: &mut ScanConstraint) {
    scan_constraint.is_byte_array = true;
}
