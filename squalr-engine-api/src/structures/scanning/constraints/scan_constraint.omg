module src::structures::scanning::constraints::scan_constraint;

use src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use src::structures::data_values::container_type::ContainerType;
use src::structures::data_values::data_value::DataValue;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;

// Port of ScanConstraint. The `mask` Option<Vec<u8>> splits into `has_mask`
// plus a caller-supplied byte extent (`mask_bytes.len` is the mask length);
// `mask_bytes` may be an empty extent when `has_mask` is false, matching
// upstream's None arm.
pub data ScanConstraint<'type_id, 'bytes, 'mask> {
    scan_compare_type: ScanCompareType;
    data_value: DataValue<'type_id, 'bytes>;
    floating_point_tolerance: FloatingPointTolerance;
    has_mask: bool;
    mask_bytes: &'mask mut [u8];
    result_container_type: ContainerType;
}

pub machine ScanConstraint::new<'type_id, 'bytes, 'mask>(
    scan_compare_type: ScanCompareType,
    data_value: DataValue<'type_id, 'bytes>,
    floating_point_tolerance: FloatingPointTolerance,
    mask_bytes: &'mask mut [u8]
) -> ScanConstraint<'type_id, 'bytes, 'mask> {
    (ScanConstraint {
        scan_compare_type: scan_compare_type,
        data_value: data_value,
        floating_point_tolerance: floating_point_tolerance,
        has_mask: false,
        mask_bytes: mask_bytes,
        result_container_type: ContainerType::None,
    })
}

pub machine ScanConstraint::new_masked<'type_id, 'bytes, 'mask>(
    scan_compare_type: ScanCompareType,
    data_value: DataValue<'type_id, 'bytes>,
    floating_point_tolerance: FloatingPointTolerance,
    mask_bytes: &'mask mut [u8]
) -> ScanConstraint<'type_id, 'bytes, 'mask> {
    (ScanConstraint {
        scan_compare_type: scan_compare_type,
        data_value: data_value,
        floating_point_tolerance: floating_point_tolerance,
        has_mask: true,
        mask_bytes: mask_bytes,
        result_container_type: ContainerType::None,
    })
}

pub machine ScanConstraint::get_scan_compare_type(&self) -> ScanCompareType {
    self.scan_compare_type
}

pub machine ScanConstraint::set_scan_compare_type(
    &mut self,
    scan_compare_type: ScanCompareType
) {
    self.scan_compare_type = scan_compare_type;
}

pub machine ScanConstraint::get_data_value(&self) -> &DataValue {
    &self.data_value
}

pub machine ScanConstraint::get_floating_point_tolerance(&self) -> FloatingPointTolerance {
    self.floating_point_tolerance
}

pub machine ScanConstraint::has_mask(&self) -> bool {
    self.has_mask
}

pub machine ScanConstraint::get_result_container_type(&self) -> ContainerType {
    self.result_container_type
}

pub machine ScanConstraint::set_result_container_type(
    &mut self,
    result_container_type: ContainerType
) {
    self.result_container_type = result_container_type;
}
