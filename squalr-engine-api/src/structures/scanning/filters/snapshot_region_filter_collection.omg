module src::structures::scanning::filters::snapshot_region_filter_collection;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::data_values::container_type::ContainerType;
use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use src::structures::snapshots::deleted_scan_result_index_set::DeletedScanResultIndexSet;

// Port of structures/scanning/filters/snapshot_region_filter_collection.rs:
// the filters (scan results) one data type owns inside a snapshot region.
// Upstream keeps `Vec<Vec<SnapshotRegionFilter>>` — the inner vectors are
// per-parallelization batches; this port holds one flat bounded set
// (MAX_FILTERS = 64 — scans emitting more surviving ranges truncate, a
// named deviation from upstream's unbounded Vec). Parallelism is the SIMD/
// parallel leg's work, not this item's.
//
// Upstream caches `number_of_results` at construction; the port recomputes
// on read — same value, no cached copy.
pub data SnapshotRegionFilterCollection {
    snapshot_region_filters: [SnapshotRegionFilter; 64];
    filter_count: u64;
    data_type_ref: DataTypeRef;
    memory_alignment: MemoryAlignment;
    result_value_size_in_bytes: u64;
    result_container_type: ContainerType;
}

// Upstream `new_with_result_size`: retains only filters whose region can
// hold a whole logical result, then sorts. The SymbolRegistry is not part
// of this slice — `result_value_size_in_bytes` arrives already resolved.
pub machine SnapshotRegionFilterCollection::new_with_result_size(
    snapshot_region_filters: [SnapshotRegionFilter; 64],
    filter_count: u64,
    data_type_ref: DataTypeRef,
    memory_alignment: MemoryAlignment,
    result_value_size_in_bytes: u64
) -> SnapshotRegionFilterCollection {
    let mut collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection {
        filter_count: 0,
        data_type_ref: data_type_ref,
        memory_alignment: memory_alignment,
        result_value_size_in_bytes: result_value_size_in_bytes,
        result_container_type: ContainerType::None,
    };
    SnapshotRegionFilterCollection::retain_result_sized_filters(&mut collection, snapshot_region_filters, filter_count);
    SnapshotRegionFilterCollection::sort_filters(&mut collection);
    collection
}

pub machine SnapshotRegionFilterCollection::empty(
    data_type_ref: DataTypeRef,
    memory_alignment: MemoryAlignment,
    result_value_size_in_bytes: u64
) -> SnapshotRegionFilterCollection {
    SnapshotRegionFilterCollection {
        filter_count: 0,
        data_type_ref: data_type_ref,
        memory_alignment: memory_alignment,
        result_value_size_in_bytes: result_value_size_in_bytes,
        result_container_type: ContainerType::None,
    }
}

// Upstream's construction-time `retain`: trailing windows narrower than the
// logical result width cannot materialize results and are dropped here.
machine SnapshotRegionFilterCollection::retain_result_sized_filters(
    snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection,
    snapshot_region_filters: [SnapshotRegionFilter; 64],
    filter_count: u64
) {
    transition { _ -> next(snapshot_region_filter_collection, &snapshot_region_filters, filter_count, 0) }
    state next(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, snapshot_region_filters: &[SnapshotRegionFilter; 64], filter_count: u64, position: u64) {
        transition position < filter_count && position < 64 {
            true -> probe(snapshot_region_filter_collection, snapshot_region_filters, filter_count, position)
            false -> done(snapshot_region_filter_collection)
        }
    }
    state probe(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, snapshot_region_filters: &[SnapshotRegionFilter; 64], filter_count: u64, position: u64)
        requires 0 <= position && position < 64
    {
        transition SnapshotRegionFilter::get_region_size(&snapshot_region_filters[position]) >= snapshot_region_filter_collection.result_value_size_in_bytes
            && snapshot_region_filter_collection.filter_count < 64 {
            true -> keep(snapshot_region_filter_collection, snapshot_region_filters, filter_count, position)
            false -> next(snapshot_region_filter_collection, snapshot_region_filters, filter_count, position + 1)
        }
    }
    state keep(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, snapshot_region_filters: &[SnapshotRegionFilter; 64], filter_count: u64, position: u64)
        requires 0 <= position && position < 64
    {
        transition snapshot_region_filter_collection.filter_count < 64 {
            true -> store(snapshot_region_filter_collection, snapshot_region_filters, filter_count, position, snapshot_region_filter_collection.filter_count)
            false -> next(snapshot_region_filter_collection, snapshot_region_filters, filter_count, position + 1)
        }
    }
    state store(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, snapshot_region_filters: &[SnapshotRegionFilter; 64], filter_count: u64, position: u64, at: u64)
        requires 0 <= position && position < 64 && 0 <= at && at < 64
    {
        let kept: SnapshotRegionFilter = SnapshotRegionFilter::clone(&snapshot_region_filters[position]);
        SnapshotRegionFilter::clone_from(&mut snapshot_region_filter_collection.snapshot_region_filters[at], &kept);
        snapshot_region_filter_collection.filter_count = ((snapshot_region_filter_collection.filter_count as u64 in Wrapping) + 1) as u64;
        transition { _ -> next(snapshot_region_filter_collection, snapshot_region_filters, filter_count, position + 1) }
    }
    state done(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection) {
        snapshot_region_filter_collection.filter_count = snapshot_region_filter_collection.filter_count;
    }
}

// Upstream sorts each filter batch by base address (Ord on NormalizedRegion
// orders by base alone) — insertion sort over the bounded set.
pub machine SnapshotRegionFilterCollection::sort_filters(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection) {
    transition { _ -> outer(snapshot_region_filter_collection, 1) }
    state outer(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, index: u64) {
        transition index < snapshot_region_filter_collection.filter_count && index < 64 {
            true -> inner(snapshot_region_filter_collection, index, index)
            false -> done(snapshot_region_filter_collection)
        }
    }
    state inner(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, index: u64, position: u64) {
        transition position > 0 && position < 64 {
            true -> order(snapshot_region_filter_collection, index, position)
            false -> outer(snapshot_region_filter_collection, ((index as u64 in Wrapping) + 1) as u64)
        }
    }
    state order(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, index: u64, position: u64)
        requires 0 <= position && position < 64
    {
        let prior: u64 = ((position as u64 in Wrapping) - 1) as u64;
        transition prior < 64
            && SnapshotRegionFilter::get_base_address(&snapshot_region_filter_collection.snapshot_region_filters[prior])
               > SnapshotRegionFilter::get_base_address(&snapshot_region_filter_collection.snapshot_region_filters[position]) {
            true -> swap(snapshot_region_filter_collection, index, position, prior)
            false -> outer(snapshot_region_filter_collection, ((index as u64 in Wrapping) + 1) as u64)
            _ -> outer(snapshot_region_filter_collection, ((index as u64 in Wrapping) + 1) as u64)
        }
    }
    state swap(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, index: u64, position: u64, prior: u64)
        requires 0 <= position && position < 64 && 0 <= prior && prior < 64
    {
        let mut held_at: SnapshotRegionFilter = SnapshotRegionFilter::new(0, 0);
        SnapshotRegionFilter::clone_from(&mut held_at, &snapshot_region_filter_collection.snapshot_region_filters[position]);
        let mut held_prior: SnapshotRegionFilter = SnapshotRegionFilter::new(0, 0);
        SnapshotRegionFilter::clone_from(&mut held_prior, &snapshot_region_filter_collection.snapshot_region_filters[prior]);
        SnapshotRegionFilter::clone_from(&mut snapshot_region_filter_collection.snapshot_region_filters[position], &held_prior);
        SnapshotRegionFilter::clone_from(&mut snapshot_region_filter_collection.snapshot_region_filters[prior], &held_at);
        transition { _ -> inner(snapshot_region_filter_collection, index, prior) }
    }
    state done(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection) {
        snapshot_region_filter_collection.filter_count = snapshot_region_filter_collection.filter_count;
    }
}

// Single-filter seed constructor used by upstream `initialize_scan_results`:
// a fresh collection holding exactly the given filter.
pub machine SnapshotRegionFilterCollection::from_single_filter(
    seed_filter: &SnapshotRegionFilter,
    data_type_ref: &DataTypeRef,
    memory_alignment: MemoryAlignment,
    result_value_size_in_bytes: u64
) -> SnapshotRegionFilterCollection {
    let mut collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::empty(
        DataTypeRef::clone(data_type_ref), memory_alignment, result_value_size_in_bytes);
    SnapshotRegionFilter::clone_from(&mut collection.snapshot_region_filters[0], seed_filter);
    collection.filter_count = 1;
    collection
}

// Upstream's collected-byte-count clamp: the coverage this collection's
// filters claim within [window_base, window_end).
pub machine SnapshotRegionFilterCollection::covered_in_range(
    snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
    window_base: u64,
    window_end: u64
) -> u64 {
    transition { _ -> total(snapshot_region_filter_collection, 0, 0, window_base, window_end) }
    state total(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, filter_index: u64, covered: u64, window_base: u64, window_end: u64) -> u64 {
        transition filter_index < snapshot_region_filter_collection.filter_count && filter_index < 64 {
            true -> add(snapshot_region_filter_collection, filter_index, covered, window_base, window_end)
            false -> (covered)
        }
    }
    state add(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, filter_index: u64, covered: u64, window_base: u64, window_end: u64) -> u64 {
        let lo: u64 = SnapshotRegionFilter::get_base_address(&snapshot_region_filter_collection.snapshot_region_filters[filter_index]);
        let hi: u64 = ((lo as u64 in Wrapping)
            + (SnapshotRegionFilter::get_region_size(&snapshot_region_filter_collection.snapshot_region_filters[filter_index]) as u64 in Wrapping)) as u64;
        let clamped_lo: u64 = SnapshotRegionFilterCollection::clamp_lo(lo, window_base);
        let clamped_hi: u64 = SnapshotRegionFilterCollection::clamp_hi(hi, window_end);
        let added: u64 = SnapshotRegionFilterCollection::overlap(clamped_lo, clamped_hi);
        transition { _ -> total(snapshot_region_filter_collection, ((filter_index as u64 in Wrapping) + 1) as u64,
            ((covered as u64 in Saturating) + (added as u64 in Saturating)) as u64, window_base, window_end) }
    }
    state edge() -> u64 {
        0
    }
}

machine SnapshotRegionFilterCollection::clamp_lo(lo: u64, window_base: u64) -> u64 {
    transition lo >= window_base {
        true -> (lo)
        false -> (window_base)
        _ -> (window_base)
    }
}

machine SnapshotRegionFilterCollection::clamp_hi(hi: u64, window_end: u64) -> u64 {
    transition hi <= window_end {
        true -> (hi)
        false -> (window_end)
        _ -> (window_end)
    }
}

machine SnapshotRegionFilterCollection::overlap(clamped_lo: u64, clamped_hi: u64) -> u64 {
    transition clamped_hi > clamped_lo {
        true -> (clamped_hi - clamped_lo)
        false -> (0)
    }
}

// Derived `Clone` parity — element-wise copy into a fresh record.
pub machine SnapshotRegionFilterCollection::clone(
    source: &SnapshotRegionFilterCollection
) -> SnapshotRegionFilterCollection {
    let mut collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::empty(
        DataTypeRef::clone(&source.data_type_ref),
        source.memory_alignment,
        source.result_value_size_in_bytes,
    );
    collection.result_container_type = source.result_container_type;
    SnapshotRegionFilterCollection::copy_filters(&mut collection, source, 0);
    collection
}

pub machine SnapshotRegionFilterCollection::clone_from(
    snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection,
    source: &SnapshotRegionFilterCollection
) {
    DataTypeRef::clone_from(&mut snapshot_region_filter_collection.data_type_ref, &source.data_type_ref);
    snapshot_region_filter_collection.memory_alignment = source.memory_alignment;
    snapshot_region_filter_collection.result_value_size_in_bytes = source.result_value_size_in_bytes;
    snapshot_region_filter_collection.result_container_type = source.result_container_type;
    snapshot_region_filter_collection.filter_count = 0;
    SnapshotRegionFilterCollection::copy_filters(snapshot_region_filter_collection, source, 0);
}

machine SnapshotRegionFilterCollection::copy_filters(
    snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection,
    source: &SnapshotRegionFilterCollection,
    position: u64
) {
    transition position < source.filter_count && position < 64 {
        true -> copy(snapshot_region_filter_collection, source, position)
        false -> done(snapshot_region_filter_collection)
    }
    state copy(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, source: &SnapshotRegionFilterCollection, position: u64) {
        SnapshotRegionFilter::clone_from(&mut snapshot_region_filter_collection.snapshot_region_filters[position], &source.snapshot_region_filters[position]);
        snapshot_region_filter_collection.filter_count = position + 1;
        transition { _ -> SnapshotRegionFilterCollection::copy_filters(snapshot_region_filter_collection, source, position + 1) }
    }
    state done(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection) {
        snapshot_region_filter_collection.filter_count = snapshot_region_filter_collection.filter_count;
    }
}

pub machine SnapshotRegionFilterCollection::get_filter_count(snapshot_region_filter_collection: &SnapshotRegionFilterCollection) -> u64 {
    snapshot_region_filter_collection.filter_count
}

// Upstream `iter` — flat enumeration by index (callers bound the loop).
pub machine SnapshotRegionFilterCollection::get_filter(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, filter_index: u64) -> SnapshotRegionFilter {
    transition filter_index < snapshot_region_filter_collection.filter_count && filter_index < 64 {
        true -> clone_at(snapshot_region_filter_collection, filter_index)
        false -> empty(snapshot_region_filter_collection)
    }
    state clone_at(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, filter_index: u64) -> SnapshotRegionFilter {
        SnapshotRegionFilter::clone(&snapshot_region_filter_collection.snapshot_region_filters[filter_index])
    }
    state empty(snapshot_region_filter_collection: &SnapshotRegionFilterCollection) -> SnapshotRegionFilter {
        SnapshotRegionFilter::new(0, 0)
    }
}

// Upstream `snapshot_region_filters.push` — the scan drain appends emitted
// filters; capacity is the bound.
pub machine SnapshotRegionFilterCollection::push_filter(
    snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection,
    filter: &SnapshotRegionFilter
) -> bool {
    transition snapshot_region_filter_collection.filter_count < 64 {
        true -> push(snapshot_region_filter_collection, filter)
        false -> (false)
    }
    state push(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, filter: &SnapshotRegionFilter) -> bool {
        SnapshotRegionFilter::clone_from(&mut snapshot_region_filter_collection.snapshot_region_filters[snapshot_region_filter_collection.filter_count], filter);
        snapshot_region_filter_collection.filter_count = snapshot_region_filter_collection.filter_count + 1;
        true
    }
}

// Upstream `set` half of `iter_mut` — replaces one filter in place.
pub machine SnapshotRegionFilterCollection::set_filter(
    snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection,
    filter_index: u64,
    filter: &SnapshotRegionFilter
) {
    transition filter_index < snapshot_region_filter_collection.filter_count && filter_index < 64 {
        true -> store(snapshot_region_filter_collection, filter_index, filter)
        false -> done(snapshot_region_filter_collection)
    }
    state store(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, filter_index: u64, filter: &SnapshotRegionFilter) {
        SnapshotRegionFilter::clone_from(&mut snapshot_region_filter_collection.snapshot_region_filters[filter_index], filter);
        snapshot_region_filter_collection.filter_count = snapshot_region_filter_collection.filter_count;
    }
    state done(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection) {
        snapshot_region_filter_collection.filter_count = snapshot_region_filter_collection.filter_count;
    }
}

pub machine SnapshotRegionFilterCollection::get_data_type_ref(snapshot_region_filter_collection: &SnapshotRegionFilterCollection) -> DataTypeRef {
    DataTypeRef::clone(&snapshot_region_filter_collection.data_type_ref)
}

pub machine SnapshotRegionFilterCollection::get_memory_alignment(snapshot_region_filter_collection: &SnapshotRegionFilterCollection) -> MemoryAlignment {
    snapshot_region_filter_collection.memory_alignment
}

pub machine SnapshotRegionFilterCollection::get_result_value_size_in_bytes(snapshot_region_filter_collection: &SnapshotRegionFilterCollection) -> u64 {
    snapshot_region_filter_collection.result_value_size_in_bytes
}

pub machine SnapshotRegionFilterCollection::get_result_container_type(snapshot_region_filter_collection: &SnapshotRegionFilterCollection) -> ContainerType {
    snapshot_region_filter_collection.result_container_type
}

// Upstream `with_result_container_type` — respelled as a set-in-place
// mutator (the owned-return builder shape does not compose across package
// boundaries under the omega borrowing rules; same value, same timing).
pub machine SnapshotRegionFilterCollection::set_result_container_type(
    snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection,
    result_container_type: ContainerType
) {
    snapshot_region_filter_collection.result_container_type = result_container_type;
}

// `push_filter` variant taking the filter by value — the borrowed-argument
// form cannot be invoked on an api-owned `&mut` receiver from scanning.
pub machine SnapshotRegionFilterCollection::push_filter_value(
    snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection,
    filter: SnapshotRegionFilter
) -> bool {
    transition snapshot_region_filter_collection.filter_count < 64 {
        true -> push(snapshot_region_filter_collection, filter)
        false -> (false)
    }
    state push(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, filter: SnapshotRegionFilter) -> bool {
        SnapshotRegionFilter::clone_from(&mut snapshot_region_filter_collection.snapshot_region_filters[snapshot_region_filter_collection.filter_count], &filter);
        snapshot_region_filter_collection.filter_count = ((snapshot_region_filter_collection.filter_count as u64 in Wrapping) + 1) as u64;
        true
    }
}

// In-place twin of `retain_result_sized_filters` for collections assembled
// element-by-element (the by-value push path above): drops trailing windows
// narrower than the logical result width, exactly as upstream's
// construction-time retain does. `sort_filters` remains the caller's next
// step, matching `new_with_result_size`'s retain-then-sort order.
pub machine SnapshotRegionFilterCollection::finalize_result_sized(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection) {
    transition { _ -> next(snapshot_region_filter_collection, 0, 0) }
    state next(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, read: u64, kept: u64) {
        transition read < snapshot_region_filter_collection.filter_count && read < 64 {
            true -> probe(snapshot_region_filter_collection, read, kept)
            false -> done(snapshot_region_filter_collection, kept)
        }
    }
    state probe(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, read: u64, kept: u64)
        requires 0 <= read && read < 64
    {
        let region_size: u64 = SnapshotRegionFilter::get_region_size(&snapshot_region_filter_collection.snapshot_region_filters[read]);
        transition region_size >= snapshot_region_filter_collection.result_value_size_in_bytes && kept < 64 {
            true -> keep(snapshot_region_filter_collection, read, kept)
            false -> next(snapshot_region_filter_collection, read + 1, kept)
            _ -> done(snapshot_region_filter_collection, kept)
        }
    }
    state keep(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, read: u64, kept: u64)
        requires 0 <= read && read < 64 && 0 <= kept && kept < 64
    {
        let mut kept_filter: SnapshotRegionFilter = SnapshotRegionFilter::new(0, 0);
        SnapshotRegionFilter::clone_from(&mut kept_filter, &snapshot_region_filter_collection.snapshot_region_filters[read]);
        SnapshotRegionFilter::clone_from(&mut snapshot_region_filter_collection.snapshot_region_filters[kept], &kept_filter);
        transition { _ -> next(snapshot_region_filter_collection, read + 1, kept + 1) }
    }
    state done(snapshot_region_filter_collection: &mut SnapshotRegionFilterCollection, kept: u64) {
        snapshot_region_filter_collection.filter_count = kept;
    }
}

pub machine SnapshotRegionFilterCollection::get_filter_minimum_address(snapshot_region_filter_collection: &SnapshotRegionFilterCollection) -> u64 {
    transition snapshot_region_filter_collection.filter_count > 0 {
        true -> (SnapshotRegionFilter::get_base_address(&snapshot_region_filter_collection.snapshot_region_filters[0]))
        false -> (0)
    }
}

pub machine SnapshotRegionFilterCollection::get_filter_maximum_address(snapshot_region_filter_collection: &SnapshotRegionFilterCollection) -> u64 {
    transition snapshot_region_filter_collection.filter_count > 0 {
        true -> maximum(snapshot_region_filter_collection, 0)
        false -> (0)
    }
    state maximum(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, position: u64) -> u64 {
        let next: u64 = ((position as u64 in Wrapping) + 1) as u64;
        transition next < snapshot_region_filter_collection.filter_count && next < 64 && position < 64 {
            true -> compare(snapshot_region_filter_collection, position, next)
            false -> tail(snapshot_region_filter_collection, position)
            _ -> (0)
        }
    }
    state tail(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, position: u64) -> u64 {
        transition position < 64 {
            true -> (SnapshotRegionFilter::get_end_address(&snapshot_region_filter_collection.snapshot_region_filters[position]))
            false -> (0)
            _ -> (0)
        }
    }
    state compare(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, position: u64, next: u64) -> u64
        requires 0 <= position && position < 64 && 0 <= next && next < 64
    {
        transition SnapshotRegionFilter::get_end_address(&snapshot_region_filter_collection.snapshot_region_filters[next])
                 > SnapshotRegionFilter::get_end_address(&snapshot_region_filter_collection.snapshot_region_filters[position]) {
            true -> maximum(snapshot_region_filter_collection, next)
            false -> maximum_keep(snapshot_region_filter_collection, position)
        }
    }
    state maximum_keep(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, position: u64) -> u64 {
        let next: u64 = ((position as u64 in Wrapping) + 1) as u64;
        transition next < snapshot_region_filter_collection.filter_count && next < 64 && position < 64 {
            true -> keep_max(snapshot_region_filter_collection, next, SnapshotRegionFilter::get_end_address(&snapshot_region_filter_collection.snapshot_region_filters[position]))
            false -> tail(snapshot_region_filter_collection, position)
            _ -> (0)
        }
    }
    state keep_max(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, position: u64, best: u64) -> u64 {
        transition position < snapshot_region_filter_collection.filter_count && position < 64 {
            true -> keep_scan(snapshot_region_filter_collection, position, best)
            false -> (best)
        }
    }
    state keep_scan(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, position: u64, best: u64) -> u64
        requires 0 <= position && position < 64
    {
        transition SnapshotRegionFilter::get_end_address(&snapshot_region_filter_collection.snapshot_region_filters[position]) > best {
            true -> keep_max(snapshot_region_filter_collection, position + 1, SnapshotRegionFilter::get_end_address(&snapshot_region_filter_collection.snapshot_region_filters[position]))
            false -> keep_max(snapshot_region_filter_collection, position + 1, best)
        }
    }
}

// Upstream `get_number_of_results` — sum of per-filter element counts.
pub machine SnapshotRegionFilterCollection::get_number_of_results(snapshot_region_filter_collection: &SnapshotRegionFilterCollection) -> u64
crashes Abort
{
    transition { _ -> total(snapshot_region_filter_collection, 0, 0) }
    state total(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, position: u64, count: u64) -> u64 {
        transition position < snapshot_region_filter_collection.filter_count && position < 64 {
            true -> add(snapshot_region_filter_collection, position, count)
            false -> (count)
        }
    }
    state add(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, position: u64, count: u64) -> u64 {
        let elements: u64 = SnapshotRegionFilter::get_element_count(&snapshot_region_filter_collection.snapshot_region_filters[position], 
            snapshot_region_filter_collection.result_value_size_in_bytes, snapshot_region_filter_collection.memory_alignment);
        transition { _ -> total(snapshot_region_filter_collection, ((position as u64 in Wrapping) + 1) as u64,
            ((count as u64 in Saturating) + (elements as u64 in Saturating)) as u64) }
    }
}

// Upstream `get_structural_scan_result`: resolve a local result index to
// (filter_index, element_index) — the address is filter_base +
// element_index * result stride. Returns by value.
pub data LocatedResult {
    case Found(filter_index: u64, element_index: u64);
    case OutOfRange;
}

pub machine SnapshotRegionFilterCollection::locate_result(
    snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
    local_scan_result_index: u64
) -> LocatedResult
crashes Abort
{
    transition { _ -> scan(snapshot_region_filter_collection, 0, local_scan_result_index) }
    state scan(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, filter_index: u64, remaining: u64) -> LocatedResult {
        transition filter_index < snapshot_region_filter_collection.filter_count && filter_index < 64 {
            true -> within(snapshot_region_filter_collection, filter_index, remaining)
            false -> (LocatedResult::OutOfRange)
        }
    }
    state within(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, filter_index: u64, remaining: u64) -> LocatedResult {
        let elements: u64 = SnapshotRegionFilter::get_element_count(&snapshot_region_filter_collection.snapshot_region_filters[filter_index], 
            snapshot_region_filter_collection.result_value_size_in_bytes, snapshot_region_filter_collection.memory_alignment);
        transition remaining < elements {
            true -> arm_result_500_0(filter_index, remaining, elements)
            false -> scan(snapshot_region_filter_collection, ((filter_index as u64 in Wrapping) + 1) as u64, remaining - elements)
        }
    }
    state arm_result_500_0(filter_index: u64, remaining: u64, elements: u64) -> LocatedResult
    {
        (LocatedResult::Found { filter_index: filter_index, element_index: remaining })
    }
}

// Flat result index of an element within a filter — the sum of the element
// counts of the filters before it plus the element's own index. Upstream's
// `collection_result_indices` seek target and `remove_results_at_indices`
// indexing both work in this flat space.
pub machine SnapshotRegionFilterCollection::flat_result_index(
    snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
    filter_index: u64,
    element_index: u64
) -> u64
crashes Abort
{
    transition { _ -> total(snapshot_region_filter_collection, 0, element_index, filter_index) }
    state total(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, position: u64, count: u64, filter_index: u64) -> u64 {
        transition position < filter_index && position < snapshot_region_filter_collection.filter_count && position < 64 {
            true -> add(snapshot_region_filter_collection, position, count, filter_index)
            false -> (count)
        }
    }
    state add(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, position: u64, count: u64, filter_index: u64) -> u64 {
        let elements: u64 = SnapshotRegionFilter::get_element_count(&snapshot_region_filter_collection.snapshot_region_filters[position], 
            snapshot_region_filter_collection.result_value_size_in_bytes, snapshot_region_filter_collection.memory_alignment);
        transition { _ -> total(snapshot_region_filter_collection, ((position as u64 in Wrapping) + 1) as u64,
            ((count as u64 in Saturating) + (elements as u64 in Saturating)) as u64,
            filter_index) }
    }
}

// Upstream `remove_results_at_indices`: rebuilds the collection with the
// deleted flat result indices excised — each kept span becomes a new
// filter (upstream `push_filter_segments_after_deletions` /
// `create_filter_segment`), so surviving results stay address ranges, not
// per-result objects. Deleted indices arrive sorted and unique — the set
// type guarantees both upstream properties (`sort_unstable` + `dedup`).
pub machine SnapshotRegionFilterCollection::remove_results_at_indices(
    snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
    deleted_result_indices: &DeletedScanResultIndexSet
) -> SnapshotRegionFilterCollection
crashes Abort
{
    transition deleted_result_indices.count == 0 {
        true -> arm_result_546_0(snapshot_region_filter_collection, deleted_result_indices)
        false -> begin(snapshot_region_filter_collection, deleted_result_indices)
    }
    state begin(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, deleted_result_indices: &DeletedScanResultIndexSet) -> SnapshotRegionFilterCollection {
        let mut rebuilt: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::empty(
            DataTypeRef::clone(&snapshot_region_filter_collection.data_type_ref),
            snapshot_region_filter_collection.memory_alignment,
            snapshot_region_filter_collection.result_value_size_in_bytes);
        transition { _ -> each_filter(snapshot_region_filter_collection, &mut rebuilt, deleted_result_indices, 0, 0) }
    }
    // filter_index walks the filters; flat_base is the current filter's
    // first flat result index across the collection.
    state each_filter(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64
    ) -> SnapshotRegionFilterCollection {
        transition filter_index < snapshot_region_filter_collection.filter_count && filter_index < 64 {
            true -> within(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base)
            false -> (SnapshotRegionFilterCollection::clone(&mut rebuilt))
        }
    }
    state within(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64
    ) -> SnapshotRegionFilterCollection {
        let filter_results: u64 = SnapshotRegionFilter::get_element_count(&snapshot_region_filter_collection.snapshot_region_filters[filter_index], 
            snapshot_region_filter_collection.result_value_size_in_bytes, snapshot_region_filter_collection.memory_alignment);
        transition { _ -> segment(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results, 0, 0) }
    }
    // Walks the deleted set once per filter: members before the filter's
    // flat window are skipped; the first member past it ends the walk;
    // inside it, kept spans emit as new filters. `kept_start` is the local
    // (filter-relative) result index the next kept segment begins at.
    state segment(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        deleted_position: u64,
        kept_start: u64
    ) -> SnapshotRegionFilterCollection {
        transition deleted_position < deleted_result_indices.count && deleted_position < 64 {
            true -> inspect(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results, deleted_position, kept_start)
            false -> tail(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results, kept_start)
        }
    }
    state inspect(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        deleted_position: u64,
        kept_start: u64
    ) -> SnapshotRegionFilterCollection
        requires 0 <= deleted_position && deleted_position < 64
    {
        let deleted_flat: u64 = deleted_result_indices.indices[deleted_position];
        transition deleted_flat < flat_base {
            true -> segment(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
                deleted_position + 1, kept_start)
            false -> upper(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
                deleted_position, kept_start, deleted_flat)
        }
    }
    state upper(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        deleted_position: u64,
        kept_start: u64,
        deleted_flat: u64
    ) -> SnapshotRegionFilterCollection
        requires 0 <= deleted_position && deleted_position < 64
    {
        let filter_flat_end: u64 = ((flat_base as u64 in Saturating) + (filter_results as u64 in Saturating)) as u64;
        transition deleted_flat >= filter_flat_end {
            true -> tail(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results, kept_start)
            false -> excise(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
                deleted_position, kept_start, deleted_flat)
        }
    }
    state excise(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        deleted_position: u64,
        kept_start: u64,
        deleted_flat: u64
    ) -> SnapshotRegionFilterCollection
        requires 0 <= deleted_position && deleted_position < 64
    {
        let deleted_local: u64 = ((deleted_flat as u64 in Saturating) - (flat_base as u64 in Saturating)) as u64;
        transition deleted_local > kept_start {
            true -> emit(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
                deleted_position, kept_start, deleted_local)
            false -> excised(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
                deleted_position, deleted_local)
        }
    }
    state emit(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        deleted_position: u64,
        kept_start: u64,
        deleted_local: u64
    ) -> SnapshotRegionFilterCollection
        requires 0 <= deleted_position && deleted_position < 64
    {
        let segment: SnapshotRegionFilter = SnapshotRegionFilterCollection::create_filter_segment(snapshot_region_filter_collection, 
            filter_index, kept_start,
            ((deleted_local as u64 in Saturating) - (kept_start as u64 in Saturating)) as u64);
        let pushed: bool = SnapshotRegionFilterCollection::push_filter(rebuilt, &segment);
        transition { _ -> excised(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
            deleted_position, deleted_local) }
    }
    state excised(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        deleted_position: u64,
        deleted_local: u64
    ) -> SnapshotRegionFilterCollection {
        transition { _ -> segment(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
            deleted_position + 1,
            ((deleted_local as u64 in Saturating) + (1 as u64 in Saturating)) as u64) }
    }
    // No more deletions inside this filter — emit the trailing kept span
    // (or the whole filter untouched when nothing was excised).
    state tail(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        kept_start: u64
    ) -> SnapshotRegionFilterCollection {
        transition kept_start < filter_results {
            true -> emit_tail(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results, kept_start)
            false -> advance(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results)
        }
    }
    state emit_tail(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        kept_start: u64
    ) -> SnapshotRegionFilterCollection {
        transition kept_start == 0 {
            true -> keep_whole(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results)
            false -> push_tail(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results, kept_start)
        }
    }
    state keep_whole(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64
    ) -> SnapshotRegionFilterCollection {
        let filter: SnapshotRegionFilter = SnapshotRegionFilterCollection::get_filter(snapshot_region_filter_collection, filter_index);
        let pushed: bool = SnapshotRegionFilterCollection::push_filter(rebuilt, &filter);
        transition { _ -> advance(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results) }
    }
    state push_tail(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        kept_start: u64
    ) -> SnapshotRegionFilterCollection {
        let segment: SnapshotRegionFilter = SnapshotRegionFilterCollection::create_filter_segment(snapshot_region_filter_collection, 
            filter_index, kept_start,
            ((filter_results as u64 in Saturating) - (kept_start as u64 in Saturating)) as u64);
        let pushed: bool = SnapshotRegionFilterCollection::push_filter(rebuilt, &segment);
        transition { _ -> advance(snapshot_region_filter_collection, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results) }
    }
    state advance(
        snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64
    ) -> SnapshotRegionFilterCollection {
        transition { _ -> each_filter(snapshot_region_filter_collection, &mut rebuilt, deleted_result_indices,
            ((filter_index as u64 in Wrapping) + 1) as u64,
            ((flat_base as u64 in Saturating) + (filter_results as u64 in Saturating)) as u64) }
    }
    state arm_result_546_0(snapshot_region_filter_collection: &SnapshotRegionFilterCollection, deleted_result_indices: &DeletedScanResultIndexSet) -> SnapshotRegionFilterCollection
    {
        (SnapshotRegionFilterCollection::clone(snapshot_region_filter_collection))
    }
}

// Upstream `create_filter_segment`: the filter covering `segment_result_count`
// consecutive results starting `segment_start_result_index` elements into the
// source filter — base advances by index*alignment, size is
// value_size + (count-1)*alignment (the inverse of `get_element_count`).
machine SnapshotRegionFilterCollection::create_filter_segment(
    snapshot_region_filter_collection: &SnapshotRegionFilterCollection,
    filter_index: u64,
    segment_start_result_index: u64,
    segment_result_count: u64
) -> SnapshotRegionFilter
crashes Abort
{
    let filter: SnapshotRegionFilter = SnapshotRegionFilterCollection::get_filter(snapshot_region_filter_collection, filter_index);
    let alignment_bytes: u64 = MemoryAlignment::get_size_in_bytes(&snapshot_region_filter_collection.memory_alignment);
    let segment_base: u64 = ((SnapshotRegionFilter::get_base_address(&filter) as u64 in Saturating)
        + ((segment_start_result_index as u64 in Saturating) * (alignment_bytes as u64 in Saturating))) as u64;
    let segment_size: u64 = ((snapshot_region_filter_collection.result_value_size_in_bytes as u64 in Saturating)
        + (((segment_result_count as u64 in Saturating) - (1 as u64 in Saturating))
            * (alignment_bytes as u64 in Saturating))) as u64;
    SnapshotRegionFilter::new(segment_base, segment_size)
}
