module src::structures::scanning::filters::snapshot_region_filter_collection;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::data_values::container_type::ContainerType;
use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use src::structures::snapshots::deleted_scan_result_index_set::DeletedScanResultIndexSet;

// Port of structures/scanning/filters/snapshot_region_filter_collection.rs:
// the filters (scan results) one data type owns inside a snapshot region.
// Upstream keeps `Vec<Vec<SnapshotRegionFilter>>` — the inner vectors are
// per-parallelization batches; this port holds one flat bounded set
// (MAX_FILTERS = 64 — scans emitting more surviving ranges truncate, a
// named deviation from upstream's unbounded Vec). Parallelism is the SIMD/
// parallel leg's work, not this item's.
//
// Upstream caches `number_of_results` at construction; the port recomputes
// on read — same value, no cached copy.
pub data SnapshotRegionFilterCollection {
    snapshot_region_filters: [SnapshotRegionFilter; 64];
    filter_count: u64;
    data_type_ref: DataTypeRef;
    memory_alignment: MemoryAlignment;
    result_value_size_in_bytes: u64;
    result_container_type: ContainerType;
}

// Upstream `new_with_result_size`: retains only filters whose region can
// hold a whole logical result, then sorts. The SymbolRegistry is not part
// of this slice — `result_value_size_in_bytes` arrives already resolved.
pub machine SnapshotRegionFilterCollection::new_with_result_size(
    snapshot_region_filters: [SnapshotRegionFilter; 64],
    filter_count: u64,
    data_type_ref: DataTypeRef,
    memory_alignment: MemoryAlignment,
    result_value_size_in_bytes: u64
) -> SnapshotRegionFilterCollection {
    let mut collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection {
        filter_count: 0,
        data_type_ref: data_type_ref,
        memory_alignment: memory_alignment,
        result_value_size_in_bytes: result_value_size_in_bytes,
        result_container_type: ContainerType::None,
    };
    SnapshotRegionFilterCollection::retain_result_sized_filters(&mut collection, snapshot_region_filters, filter_count);
    SnapshotRegionFilterCollection::sort_filters(&mut collection);
    collection
}

pub machine SnapshotRegionFilterCollection::empty(
    data_type_ref: DataTypeRef,
    memory_alignment: MemoryAlignment,
    result_value_size_in_bytes: u64
) -> SnapshotRegionFilterCollection {
    SnapshotRegionFilterCollection {
        filter_count: 0,
        data_type_ref: data_type_ref,
        memory_alignment: memory_alignment,
        result_value_size_in_bytes: result_value_size_in_bytes,
        result_container_type: ContainerType::None,
    }
}

// Upstream's construction-time `retain`: trailing windows narrower than the
// logical result width cannot materialize results and are dropped here.
machine SnapshotRegionFilterCollection::retain_result_sized_filters(
    this: &mut SnapshotRegionFilterCollection,
    snapshot_region_filters: [SnapshotRegionFilter; 64],
    filter_count: u64
) {
    transition { _ -> next(this, &snapshot_region_filters, filter_count, 0) }
    state next(this: &mut SnapshotRegionFilterCollection, snapshot_region_filters: &[SnapshotRegionFilter; 64], filter_count: u64, position: u64) {
        transition position < filter_count && position < 64 {
            true -> probe(this, snapshot_region_filters, filter_count, position)
            false -> done(this, filter_count)
        }
    }
    state probe(this: &mut SnapshotRegionFilterCollection, snapshot_region_filters: &[SnapshotRegionFilter; 64], filter_count: u64, position: u64)
        requires 0 <= position && position < 64
    {
        let hoist1: u64 = SnapshotRegionFilter::get_region_size(&snapshot_region_filters[position]);
        transition hoist1 >= this.result_value_size_in_bytes
            && this.filter_count < 64 {
            true -> keep(this, snapshot_region_filters, filter_count, position)
            false -> next(this, snapshot_region_filters, filter_count, position + 1)
        }
    }
    state keep(this: &mut SnapshotRegionFilterCollection, snapshot_region_filters: &[SnapshotRegionFilter; 64], filter_count: u64, position: u64)
        requires 0 <= position && position < 64
    {
        transition this.filter_count < 64 {
            true -> store(this, snapshot_region_filters, filter_count, position, this.filter_count)
            false -> next(this, snapshot_region_filters, filter_count, position + 1)
        }
    }
    state store(this: &mut SnapshotRegionFilterCollection, snapshot_region_filters: &[SnapshotRegionFilter; 64], filter_count: u64, position: u64, at: u64)
        requires 0 <= position && position < 64 && 0 <= at && at < 64
    {
        let kept: SnapshotRegionFilter = SnapshotRegionFilter::clone(&snapshot_region_filters[position]);
        SnapshotRegionFilter::clone_from(&mut this.snapshot_region_filters[at], &kept);
        this.filter_count = ((this.filter_count as u64 in Wrapping) + 1) as u64;
        transition { _ -> next(this, snapshot_region_filters, filter_count, position + 1) }
    }
    state done(this: &mut SnapshotRegionFilterCollection, filter_count: u64) {
        this.filter_count = this.filter_count;
    }
}

// Upstream sorts each filter batch by base address (Ord on NormalizedRegion
// orders by base alone) — insertion sort over the bounded set.
pub machine SnapshotRegionFilterCollection::sort_filters(this: &mut SnapshotRegionFilterCollection) {
    transition { _ -> outer(this, 1) }
    state outer(this: &mut SnapshotRegionFilterCollection, index: u64) {
        transition index < this.filter_count && index < 64 {
            true -> inner(this, index, index)
            false -> done(this)
        }
    }
    state inner(this: &mut SnapshotRegionFilterCollection, index: u64, position: u64) {
        transition position > 0 && position < 64 {
            true -> order(this, index, position)
            false -> outer(this, ((index as u64 in Wrapping) + 1) as u64)
        }
    }
    state order(this: &mut SnapshotRegionFilterCollection, index: u64, position: u64)
        requires 0 <= position && position < 64
    {
        let prior: u64 = ((position as u64 in Wrapping) - 1) as u64;
        let hoist3: u64 = SnapshotRegionFilter::get_base_address(&this.snapshot_region_filters[position]);
        let hoist2: u64 = SnapshotRegionFilter::get_base_address(&this.snapshot_region_filters[prior]);
        transition prior < 64
            && hoist2
               > hoist3 {
            true -> swap(this, index, position, prior)
            false -> outer(this, ((index as u64 in Wrapping) + 1) as u64)
            _ -> outer(this, ((index as u64 in Wrapping) + 1) as u64)
        }
    }
    state swap(this: &mut SnapshotRegionFilterCollection, index: u64, position: u64, prior: u64)
        requires 0 <= position && position < 64 && 0 <= prior && prior < 64
    {
        let mut held_at: SnapshotRegionFilter = SnapshotRegionFilter::new(0, 0);
        SnapshotRegionFilter::clone_from(&mut held_at, &this.snapshot_region_filters[position]);
        let mut held_prior: SnapshotRegionFilter = SnapshotRegionFilter::new(0, 0);
        SnapshotRegionFilter::clone_from(&mut held_prior, &this.snapshot_region_filters[prior]);
        SnapshotRegionFilter::clone_from(&mut this.snapshot_region_filters[position], &held_prior);
        SnapshotRegionFilter::clone_from(&mut this.snapshot_region_filters[prior], &held_at);
        transition { _ -> inner(this, index, prior) }
    }
    state done(this: &mut SnapshotRegionFilterCollection) {
        this.filter_count = this.filter_count;
    }
}

// Single-filter seed constructor used by upstream `initialize_scan_results`:
// a fresh collection holding exactly the given filter.
pub machine SnapshotRegionFilterCollection::from_single_filter(
    seed_filter: &SnapshotRegionFilter,
    data_type_ref: &DataTypeRef,
    memory_alignment: MemoryAlignment,
    result_value_size_in_bytes: u64
) -> SnapshotRegionFilterCollection {
    let mut collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::empty(
        DataTypeRef::clone(data_type_ref), memory_alignment, result_value_size_in_bytes);
    SnapshotRegionFilter::clone_from(&mut collection.snapshot_region_filters[0], seed_filter);
    collection.filter_count = 1;
    collection
}

// Upstream's collected-byte-count clamp: the coverage this collection's
// filters claim within [window_base, window_end).
pub machine SnapshotRegionFilterCollection::covered_in_range(
    this: &SnapshotRegionFilterCollection,
    window_base: u64,
    window_end: u64
) -> u64 {
    transition { _ -> total(this, 0, 0, window_base, window_end) }
    state total(this: &SnapshotRegionFilterCollection, filter_index: u64, covered: u64, window_base: u64, window_end: u64) -> u64 {
        transition filter_index < this.filter_count && filter_index < 64 {
            true -> add(this, filter_index, covered, window_base, window_end)
            false -> (covered)
        }
    }
    state add(this: &SnapshotRegionFilterCollection, filter_index: u64, covered: u64, window_base: u64, window_end: u64) -> u64 {
        let lo: u64 = SnapshotRegionFilter::get_base_address(&this.snapshot_region_filters[filter_index]);
        let hi: u64 = ((lo as u64 in Wrapping)
            + (SnapshotRegionFilter::get_region_size(&this.snapshot_region_filters[filter_index]) as u64 in Wrapping)) as u64;
        let clamped_lo: u64 = SnapshotRegionFilterCollection::clamp_lo(lo, window_base);
        let clamped_hi: u64 = SnapshotRegionFilterCollection::clamp_hi(hi, window_end);
        let added: u64 = SnapshotRegionFilterCollection::overlap(clamped_lo, clamped_hi);
        transition { _ -> total(this, ((filter_index as u64 in Wrapping) + 1) as u64,
            ((covered as u64 in Saturating) + (added as u64 in Saturating)) as u64, window_base, window_end) }
    }
    state edge() -> u64 {
        0
    }
}

machine SnapshotRegionFilterCollection::clamp_lo(lo: u64, window_base: u64) -> u64 {
    transition lo >= window_base {
        true -> (lo)
        false -> (window_base)
        _ -> (window_base)
    }
}

machine SnapshotRegionFilterCollection::clamp_hi(hi: u64, window_end: u64) -> u64 {
    transition hi <= window_end {
        true -> (hi)
        false -> (window_end)
        _ -> (window_end)
    }
}

machine SnapshotRegionFilterCollection::overlap(clamped_lo: u64, clamped_hi: u64) -> u64 {
    transition clamped_hi > clamped_lo {
        true -> (clamped_hi - clamped_lo)
        false -> (0)
    }
}

// Derived `Clone` parity — element-wise copy into a fresh record.
pub machine SnapshotRegionFilterCollection::clone(
    source: &SnapshotRegionFilterCollection
) -> SnapshotRegionFilterCollection {
    let mut collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::empty(
        DataTypeRef::clone(&source.data_type_ref),
        source.memory_alignment,
        source.result_value_size_in_bytes,
    );
    collection.result_container_type = source.result_container_type;
    SnapshotRegionFilterCollection::copy_filters(&mut collection, source, 0);
    collection
}

pub machine SnapshotRegionFilterCollection::clone_from(
    this: &mut SnapshotRegionFilterCollection,
    source: &SnapshotRegionFilterCollection
) {
    DataTypeRef::clone_from(&mut this.data_type_ref, &source.data_type_ref);
    this.memory_alignment = source.memory_alignment;
    this.result_value_size_in_bytes = source.result_value_size_in_bytes;
    this.result_container_type = source.result_container_type;
    this.filter_count = 0;
    SnapshotRegionFilterCollection::copy_filters(&mut this, source, 0);
}

machine SnapshotRegionFilterCollection::copy_filters(
    this: &mut SnapshotRegionFilterCollection,
    source: &SnapshotRegionFilterCollection,
    position: u64
) {
    transition position < source.filter_count && position < 64 {
        true -> copy(this, source, position)
        false -> done(this)
    }
    state copy(this: &mut SnapshotRegionFilterCollection, source: &SnapshotRegionFilterCollection, position: u64) {
        SnapshotRegionFilter::clone_from(&mut this.snapshot_region_filters[position], &source.snapshot_region_filters[position]);
        this.filter_count = position + 1;
        transition { _ -> copy_filters(this, source, position + 1) }
    }
    state done(this: &mut SnapshotRegionFilterCollection) {
        this.filter_count = this.filter_count;
    }
}

pub machine SnapshotRegionFilterCollection::get_filter_count(this: &SnapshotRegionFilterCollection) -> u64 {
    this.filter_count
}

// Upstream `iter` — flat enumeration by index (callers bound the loop).
pub machine SnapshotRegionFilterCollection::get_filter(this: &SnapshotRegionFilterCollection, filter_index: u64) -> SnapshotRegionFilter {
    transition filter_index < this.filter_count && filter_index < 64 {
        true -> clone_at(this, filter_index)
        false -> empty(this)
    }
    state clone_at(this: &SnapshotRegionFilterCollection, filter_index: u64) -> SnapshotRegionFilter {
        SnapshotRegionFilter::clone(&this.snapshot_region_filters[filter_index])
    }
    state empty(this: &SnapshotRegionFilterCollection) -> SnapshotRegionFilter {
        SnapshotRegionFilter::new(0, 0)
    }
}

// Upstream `snapshot_region_filters.push` — the scan drain appends emitted
// filters; capacity is the bound.
pub machine SnapshotRegionFilterCollection::push_filter(
    this: &mut SnapshotRegionFilterCollection,
    filter: &SnapshotRegionFilter
) -> bool {
    transition this.filter_count < 64 {
        true -> push(this, filter)
        false -> (false)
    }
    state push(this: &mut SnapshotRegionFilterCollection, filter: &SnapshotRegionFilter) -> bool {
        SnapshotRegionFilter::clone_from(&mut this.snapshot_region_filters[this.filter_count], filter);
        this.filter_count = this.filter_count + 1;
        true
    }
}

// Upstream `set` half of `iter_mut` — replaces one filter in place.
pub machine SnapshotRegionFilterCollection::set_filter(
    this: &mut SnapshotRegionFilterCollection,
    filter_index: u64,
    filter: &SnapshotRegionFilter
) {
    transition filter_index < this.filter_count && filter_index < 64 {
        true -> store(this, filter_index, filter)
        false -> done(this)
    }
    state store(this: &mut SnapshotRegionFilterCollection, filter_index: u64, filter: &SnapshotRegionFilter) {
        SnapshotRegionFilter::clone_from(&mut this.snapshot_region_filters[filter_index], filter);
        this.filter_count = this.filter_count;
    }
    state done(this: &mut SnapshotRegionFilterCollection) {
        this.filter_count = this.filter_count;
    }
}

pub machine SnapshotRegionFilterCollection::get_data_type_ref(this: &SnapshotRegionFilterCollection) -> DataTypeRef {
    DataTypeRef::clone(&this.data_type_ref)
}

pub machine SnapshotRegionFilterCollection::get_memory_alignment(this: &SnapshotRegionFilterCollection) -> MemoryAlignment {
    this.memory_alignment
}

pub machine SnapshotRegionFilterCollection::get_result_value_size_in_bytes(this: &SnapshotRegionFilterCollection) -> u64 {
    this.result_value_size_in_bytes
}

pub machine SnapshotRegionFilterCollection::get_result_container_type(this: &SnapshotRegionFilterCollection) -> ContainerType {
    this.result_container_type
}

// Upstream `with_result_container_type` — respelled as a set-in-place
// mutator (the owned-return builder shape does not compose across package
// boundaries under the omega borrowing rules; same value, same timing).
pub machine SnapshotRegionFilterCollection::set_result_container_type(
    this: &mut SnapshotRegionFilterCollection,
    result_container_type: ContainerType
) {
    this.result_container_type = result_container_type;
}

// `push_filter` variant taking the filter by value — the borrowed-argument
// form cannot be invoked on an api-owned `&mut` receiver from scanning.
pub machine SnapshotRegionFilterCollection::push_filter_value(
    this: &mut SnapshotRegionFilterCollection,
    filter: SnapshotRegionFilter
) -> bool {
    transition this.filter_count < 64 {
        true -> push(this, filter)
        false -> (false)
    }
    state push(this: &mut SnapshotRegionFilterCollection, filter: SnapshotRegionFilter) -> bool {
        SnapshotRegionFilter::clone_from(&mut this.snapshot_region_filters[this.filter_count], &filter);
        this.filter_count = ((this.filter_count as u64 in Wrapping) + 1) as u64;
        true
    }
}

// In-place twin of `retain_result_sized_filters` for collections assembled
// element-by-element (the by-value push path above): drops trailing windows
// narrower than the logical result width, exactly as upstream's
// construction-time retain does. `sort_filters` remains the caller's next
// step, matching `new_with_result_size`'s retain-then-sort order.
pub machine SnapshotRegionFilterCollection::finalize_result_sized(this: &mut SnapshotRegionFilterCollection) {
    transition { _ -> next(this, 0, 0) }
    state next(this: &mut SnapshotRegionFilterCollection, read: u64, kept: u64) {
        transition read < this.filter_count && read < 64 {
            true -> probe(this, read, kept)
            false -> done(this, kept)
        }
    }
    state probe(this: &mut SnapshotRegionFilterCollection, read: u64, kept: u64)
        requires 0 <= read && read < 64
    {
        let region_size: u64 = SnapshotRegionFilter::get_region_size(&this.snapshot_region_filters[read]);
        transition region_size >= this.result_value_size_in_bytes && kept < 64 {
            true -> keep(this, read, kept)
            false -> next(this, read + 1, kept)
            _ -> done(this, kept)
        }
    }
    state keep(this: &mut SnapshotRegionFilterCollection, read: u64, kept: u64)
        requires 0 <= read && read < 64 && 0 <= kept && kept < 64
    {
        let mut kept_filter: SnapshotRegionFilter = SnapshotRegionFilter::new(0, 0);
        SnapshotRegionFilter::clone_from(&mut kept_filter, &this.snapshot_region_filters[read]);
        SnapshotRegionFilter::clone_from(&mut this.snapshot_region_filters[kept], &kept_filter);
        transition { _ -> next(this, read + 1, kept + 1) }
    }
    state done(this: &mut SnapshotRegionFilterCollection, kept: u64) {
        this.filter_count = kept;
    }
}

pub machine SnapshotRegionFilterCollection::get_filter_minimum_address(this: &SnapshotRegionFilterCollection) -> u64 {
    let hoist7: u64 = SnapshotRegionFilter::get_base_address(&this.snapshot_region_filters[0]);
    transition this.filter_count > 0 {
        true -> (hoist7)
        false -> (0)
    }
}

pub machine SnapshotRegionFilterCollection::get_filter_maximum_address(this: &SnapshotRegionFilterCollection) -> u64 {
    transition this.filter_count > 0 {
        true -> maximum(this, 0)
        false -> (0)
    }
    state maximum(this: &SnapshotRegionFilterCollection, position: u64) -> u64 {
        let next: u64 = ((position as u64 in Wrapping) + 1) as u64;
        transition next < this.filter_count && next < 64 && position < 64 {
            true -> compare(this, position, next)
            false -> tail(this, position)
            _ -> (0)
        }
    }
    state tail(this: &SnapshotRegionFilterCollection, position: u64) -> u64 {
        let hoist8: u64 = SnapshotRegionFilter::get_end_address(&this.snapshot_region_filters[position]);
        transition position < 64 {
            true -> (hoist8)
            false -> (0)
            _ -> (0)
        }
    }
    state compare(this: &SnapshotRegionFilterCollection, position: u64, next: u64) -> u64
        requires 0 <= position && position < 64 && 0 <= next && next < 64
    {
        let hoist5: u64 = SnapshotRegionFilter::get_end_address(&this.snapshot_region_filters[position]);
        let hoist4: u64 = SnapshotRegionFilter::get_end_address(&this.snapshot_region_filters[next]);
        transition hoist4
                 > hoist5 {
            true -> maximum(this, next)
            false -> maximum_keep(this, position)
        }
    }
    state maximum_keep(this: &SnapshotRegionFilterCollection, position: u64) -> u64 {
        let next: u64 = ((position as u64 in Wrapping) + 1) as u64;
        transition next < this.filter_count && next < 64 && position < 64 {
            true -> keep_max(this, next, SnapshotRegionFilter::get_end_address(&this.snapshot_region_filters[position]))
            false -> tail(this, position)
            _ -> (0)
        }
    }
    state keep_max(this: &SnapshotRegionFilterCollection, position: u64, best: u64) -> u64 {
        transition position < this.filter_count && position < 64 {
            true -> keep_scan(this, position, best)
            false -> (best)
        }
    }
    state keep_scan(this: &SnapshotRegionFilterCollection, position: u64, best: u64) -> u64
        requires 0 <= position && position < 64
    {
        let hoist6: u64 = SnapshotRegionFilter::get_end_address(&this.snapshot_region_filters[position]);
        transition hoist6 > best {
            true -> keep_max(this, position + 1, SnapshotRegionFilter::get_end_address(&this.snapshot_region_filters[position]))
            false -> keep_max(this, position + 1, best)
        }
    }
}

// Upstream `get_number_of_results` — sum of per-filter element counts.
pub machine SnapshotRegionFilterCollection::get_number_of_results(this: &SnapshotRegionFilterCollection) -> u64
crashes Abort
{
    transition { _ -> total(this, 0, 0) }
    state total(this: &SnapshotRegionFilterCollection, position: u64, count: u64) -> u64 {
        transition position < this.filter_count && position < 64 {
            true -> add(this, position, count)
            false -> (count)
        }
    }
    state add(this: &SnapshotRegionFilterCollection, position: u64, count: u64) -> u64 {
        let elements: u64 = SnapshotRegionFilter::get_element_count(&this.snapshot_region_filters[position], this.result_value_size_in_bytes, this.memory_alignment);
        transition { _ -> total(this, ((position as u64 in Wrapping) + 1) as u64,
            ((count as u64 in Saturating) + (elements as u64 in Saturating)) as u64) }
    }
}

// Upstream `get_structural_scan_result`: resolve a local result index to
// (filter_index, element_index) — the address is filter_base +
// element_index * result stride. Returns by value.
pub data LocatedResult {
    case Found(filter_index: u64, element_index: u64);
    case OutOfRange;
}

pub machine SnapshotRegionFilterCollection::locate_result(
    this: &SnapshotRegionFilterCollection,
    local_scan_result_index: u64
) -> LocatedResult
crashes Abort
{
    transition { _ -> scan(this, 0, local_scan_result_index) }
    state scan(this: &SnapshotRegionFilterCollection, filter_index: u64, remaining: u64) -> LocatedResult {
        transition filter_index < this.filter_count && filter_index < 64 {
            true -> within(this, filter_index, remaining)
            false -> (LocatedResult::OutOfRange)
        }
    }
    state within(this: &SnapshotRegionFilterCollection, filter_index: u64, remaining: u64) -> LocatedResult {
        let elements: u64 = SnapshotRegionFilter::get_element_count(&this.snapshot_region_filters[filter_index], this.result_value_size_in_bytes, this.memory_alignment);
        transition remaining < elements {
            true -> arm_result_500_0(filter_index, remaining, elements)
            false -> scan(this, ((filter_index as u64 in Wrapping) + 1) as u64, remaining - elements)
        }
    }
    state arm_result_500_0(filter_index: u64, remaining: u64, elements: u64) -> LocatedResult
    {
        (LocatedResult::Found { filter_index: filter_index, element_index: remaining })
    }
}

// Flat result index of an element within a filter — the sum of the element
// counts of the filters before it plus the element's own index. Upstream's
// `collection_result_indices` seek target and `remove_results_at_indices`
// indexing both work in this flat space.
pub machine SnapshotRegionFilterCollection::flat_result_index(
    this: &SnapshotRegionFilterCollection,
    filter_index: u64,
    element_index: u64
) -> u64
crashes Abort
{
    transition { _ -> total(this, 0, element_index, filter_index) }
    state total(this: &SnapshotRegionFilterCollection, position: u64, count: u64, filter_index: u64) -> u64 {
        transition position < filter_index && position < this.filter_count && position < 64 {
            true -> add(this, position, count, filter_index)
            false -> (count)
        }
    }
    state add(this: &SnapshotRegionFilterCollection, position: u64, count: u64, filter_index: u64) -> u64 {
        let elements: u64 = SnapshotRegionFilter::get_element_count(&this.snapshot_region_filters[position], this.result_value_size_in_bytes, this.memory_alignment);
        transition { _ -> total(this, ((position as u64 in Wrapping) + 1) as u64,
            ((count as u64 in Saturating) + (elements as u64 in Saturating)) as u64,
            filter_index) }
    }
}

// Upstream `remove_results_at_indices`: rebuilds the collection with the
// deleted flat result indices excised — each kept span becomes a new
// filter (upstream `push_filter_segments_after_deletions` /
// `create_filter_segment`), so surviving results stay address ranges, not
// per-result objects. Deleted indices arrive sorted and unique — the set
// type guarantees both upstream properties (`sort_unstable` + `dedup`).
pub machine SnapshotRegionFilterCollection::remove_results_at_indices(
    this: &SnapshotRegionFilterCollection,
    deleted_result_indices: &DeletedScanResultIndexSet
) -> SnapshotRegionFilterCollection
crashes Abort
{
    transition deleted_result_indices.count == 0 {
        true -> arm_result_546_0(this, deleted_result_indices)
        false -> begin(this, deleted_result_indices)
    }
    state begin(this: &SnapshotRegionFilterCollection, deleted_result_indices: &DeletedScanResultIndexSet) -> SnapshotRegionFilterCollection {
        let mut rebuilt: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::empty(
            DataTypeRef::clone(&this.data_type_ref),
            this.memory_alignment,
            this.result_value_size_in_bytes);
        transition { _ -> each_filter(this, &mut rebuilt, deleted_result_indices, 0, 0) }
    }
    // filter_index walks the filters; flat_base is the current filter's
    // first flat result index across the collection.
    state each_filter(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64
    ) -> SnapshotRegionFilterCollection {
        transition filter_index < this.filter_count && filter_index < 64 {
            true -> within(this, rebuilt, deleted_result_indices, filter_index, flat_base)
            false -> (SnapshotRegionFilterCollection::clone(&mut rebuilt))
        }
    }
    state within(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64
    ) -> SnapshotRegionFilterCollection {
        let filter_results: u64 = SnapshotRegionFilter::get_element_count(&this.snapshot_region_filters[filter_index], this.result_value_size_in_bytes, this.memory_alignment);
        transition { _ -> segment(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results, 0, 0) }
    }
    // Walks the deleted set once per filter: members before the filter's
    // flat window are skipped; the first member past it ends the walk;
    // inside it, kept spans emit as new filters. `kept_start` is the local
    // (filter-relative) result index the next kept segment begins at.
    state segment(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        deleted_position: u64,
        kept_start: u64
    ) -> SnapshotRegionFilterCollection {
        transition deleted_position < deleted_result_indices.count && deleted_position < 64 {
            true -> inspect(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results, deleted_position, kept_start)
            false -> tail(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results, kept_start)
        }
    }
    state inspect(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        deleted_position: u64,
        kept_start: u64
    ) -> SnapshotRegionFilterCollection
        requires 0 <= deleted_position && deleted_position < 64
    {
        let deleted_flat: u64 = deleted_result_indices.indices[deleted_position];
        transition deleted_flat < flat_base {
            true -> segment(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
                deleted_position + 1, kept_start)
            false -> upper(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
                deleted_position, kept_start, deleted_flat)
        }
    }
    state upper(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        deleted_position: u64,
        kept_start: u64,
        deleted_flat: u64
    ) -> SnapshotRegionFilterCollection
        requires 0 <= deleted_position && deleted_position < 64
    {
        let filter_flat_end: u64 = ((flat_base as u64 in Saturating) + (filter_results as u64 in Saturating)) as u64;
        transition deleted_flat >= filter_flat_end {
            true -> tail(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results, kept_start)
            false -> excise(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
                deleted_position, kept_start, deleted_flat)
        }
    }
    state excise(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        deleted_position: u64,
        kept_start: u64,
        deleted_flat: u64
    ) -> SnapshotRegionFilterCollection
        requires 0 <= deleted_position && deleted_position < 64
    {
        let deleted_local: u64 = ((deleted_flat as u64 in Saturating) - (flat_base as u64 in Saturating)) as u64;
        transition deleted_local > kept_start {
            true -> emit(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
                deleted_position, kept_start, deleted_local)
            false -> excised(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
                deleted_position, deleted_local)
        }
    }
    state emit(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        deleted_position: u64,
        kept_start: u64,
        deleted_local: u64
    ) -> SnapshotRegionFilterCollection
        requires 0 <= deleted_position && deleted_position < 64
    {
        let segment: SnapshotRegionFilter = SnapshotRegionFilterCollection::create_filter_segment(&this, filter_index, kept_start,
            ((deleted_local as u64 in Saturating) - (kept_start as u64 in Saturating)) as u64);
        let pushed: bool = SnapshotRegionFilterCollection::push_filter(&mut rebuilt, &segment);
        transition { _ -> excised(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
            deleted_position, deleted_local) }
    }
    state excised(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        deleted_position: u64,
        deleted_local: u64
    ) -> SnapshotRegionFilterCollection {
        transition { _ -> segment(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results,
            deleted_position + 1,
            ((deleted_local as u64 in Saturating) + (1 as u64 in Saturating)) as u64) }
    }
    // No more deletions inside this filter — emit the trailing kept span
    // (or the whole filter untouched when nothing was excised).
    state tail(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        kept_start: u64
    ) -> SnapshotRegionFilterCollection {
        transition kept_start < filter_results {
            true -> emit_tail(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results, kept_start)
            false -> advance(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results)
        }
    }
    state emit_tail(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        kept_start: u64
    ) -> SnapshotRegionFilterCollection {
        transition kept_start == 0 {
            true -> keep_whole(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results)
            false -> push_tail(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results, kept_start)
        }
    }
    state keep_whole(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64
    ) -> SnapshotRegionFilterCollection {
        let filter: SnapshotRegionFilter = SnapshotRegionFilterCollection::get_filter(&this, filter_index);
        let pushed: bool = SnapshotRegionFilterCollection::push_filter(&mut rebuilt, &filter);
        transition { _ -> advance(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results) }
    }
    state push_tail(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64,
        kept_start: u64
    ) -> SnapshotRegionFilterCollection {
        let segment: SnapshotRegionFilter = SnapshotRegionFilterCollection::create_filter_segment(&this, filter_index, kept_start,
            ((filter_results as u64 in Saturating) - (kept_start as u64 in Saturating)) as u64);
        let pushed: bool = SnapshotRegionFilterCollection::push_filter(&mut rebuilt, &segment);
        transition { _ -> advance(this, rebuilt, deleted_result_indices, filter_index, flat_base, filter_results) }
    }
    state advance(
        this: &SnapshotRegionFilterCollection,
        rebuilt: &mut SnapshotRegionFilterCollection,
        deleted_result_indices: &DeletedScanResultIndexSet,
        filter_index: u64,
        flat_base: u64,
        filter_results: u64
    ) -> SnapshotRegionFilterCollection {
        transition { _ -> each_filter(this, &mut rebuilt, deleted_result_indices,
            ((filter_index as u64 in Wrapping) + 1) as u64,
            ((flat_base as u64 in Saturating) + (filter_results as u64 in Saturating)) as u64) }
    }
    state arm_result_546_0(this: &SnapshotRegionFilterCollection, deleted_result_indices: &DeletedScanResultIndexSet) -> SnapshotRegionFilterCollection
    {
        (SnapshotRegionFilterCollection::clone(this))
    }
}

// Upstream `create_filter_segment`: the filter covering `segment_result_count`
// consecutive results starting `segment_start_result_index` elements into the
// source filter — base advances by index*alignment, size is
// value_size + (count-1)*alignment (the inverse of `get_element_count`).
machine SnapshotRegionFilterCollection::create_filter_segment(
    this: &SnapshotRegionFilterCollection,
    filter_index: u64,
    segment_start_result_index: u64,
    segment_result_count: u64
) -> SnapshotRegionFilter
crashes Abort
{
    let filter: SnapshotRegionFilter = SnapshotRegionFilterCollection::get_filter(&this, filter_index);
    let alignment_bytes: u64 = MemoryAlignment::get_size_in_bytes(&this.memory_alignment);
    let segment_base: u64 = ((SnapshotRegionFilter::get_base_address(&filter) as u64 in Saturating)
        + ((segment_start_result_index as u64 in Saturating) * (alignment_bytes as u64 in Saturating))) as u64;
    let segment_size: u64 = ((this.result_value_size_in_bytes as u64 in Saturating)
        + (((segment_result_count as u64 in Saturating) - (1 as u64 in Saturating))
            * (alignment_bytes as u64 in Saturating))) as u64;
    SnapshotRegionFilter::new(segment_base, segment_size)
}
