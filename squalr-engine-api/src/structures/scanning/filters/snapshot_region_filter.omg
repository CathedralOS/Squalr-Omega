module src::structures::scanning::filters::snapshot_region_filter;

use src::structures::memory::memory_alignment::MemoryAlignment;
// Numbered records dual-register a wire schema under the same name, so the
// module is imported and the type is named qualified (as in the wire corpus).
use src::structures::memory::normalized_region;
use omega::language::core::relation;

// Same nested representation and range/count operations as the Rust source.
// Public structural fields follow Omega visibility, not Rust field privacy.
// Elements are moved through lent collections by clone+write pairs: the
// checker does not admit [copy] on the numbered record underneath
// (NormalizedRegion carries #0/#1 wire fields), so element copies are
// explicit `clone` calls.
pub data SnapshotRegionFilter {
    filter_range: normalized_region::NormalizedRegion;
}

// Upstream PartialEq/Eq: `==`/`!=` select the Equatable route on this type.
pub SnapshotRegionFilterEquality satisfies Equatable<SnapshotRegionFilter> {
    Equatable::equals = SnapshotRegionFilter::equals;
}

pub machine SnapshotRegionFilter::new(base_address: u64, get_size_in_bytes: u64) -> SnapshotRegionFilter {
    SnapshotRegionFilter { filter_range: normalized_region::NormalizedRegion { base_address: base_address, region_size: get_size_in_bytes } }
}

// Equivalent of the upstream derived `Clone` impl, split at the compiler's
// edges: `clone` takes the borrowed source as an explicit parameter because
// nested calls with a runtime receiver cannot produce a record result yet,
// and `clone_from` is the mutating half (`Clone::clone_from(&mut self,
// source)`), reachable where a record result cannot be bound.
pub machine SnapshotRegionFilter::clone(source: &SnapshotRegionFilter) -> SnapshotRegionFilter {
    SnapshotRegionFilter { filter_range: normalized_region::NormalizedRegion { base_address: source.filter_range.base_address, region_size: source.filter_range.region_size } }
}

pub machine SnapshotRegionFilter::clone_from(this: &mut SnapshotRegionFilter, source: &SnapshotRegionFilter) {
    normalized_region::NormalizedRegion::clone_from(&mut this.filter_range, &source.filter_range);
}

// In-package exercise of both clone halves: a `clone` copy and a `clone_from`
// copy each compare equal to the source. Checked here because `&mut`-receiver
// calls with borrowed arguments do not cross the package boundary under
// selected ProgramEntry establishment, so squalr-tests cannot host this yet.
pub machine SnapshotRegionFilter::clone_consistent(this: &SnapshotRegionFilter) -> bool {
    let cloned: SnapshotRegionFilter = SnapshotRegionFilter::clone(this);
    let mut cloned_into: SnapshotRegionFilter = SnapshotRegionFilter::new(0, 0);
    SnapshotRegionFilter::clone_from(&mut cloned_into, &cloned);
    SnapshotRegionFilter::equals(this, &cloned) && SnapshotRegionFilter::equals(this, &cloned_into)
}

pub machine SnapshotRegionFilter::get_base_address(this: &SnapshotRegionFilter) -> u64 {
    let hoist1: u64 = normalized_region::NormalizedRegion::get_base_address(&this.filter_range);
    (hoist1)
}

pub machine SnapshotRegionFilter::set_base_address(this: &mut SnapshotRegionFilter, base_address: u64) {
    normalized_region::NormalizedRegion::set_base_address(&mut this.filter_range, base_address);
}

pub machine SnapshotRegionFilter::set_end_address(this: &mut SnapshotRegionFilter, end_address: u64) {
    normalized_region::NormalizedRegion::set_end_address(&mut this.filter_range, end_address);
}

pub machine SnapshotRegionFilter::get_end_address(this: &SnapshotRegionFilter) -> u64 {
    let hoist2: u64 = normalized_region::NormalizedRegion::get_end_address(&this.filter_range);
    (hoist2)
}

pub machine SnapshotRegionFilter::get_region_size(this: &SnapshotRegionFilter) -> u64 {
    let hoist3: u64 = normalized_region::NormalizedRegion::get_region_size(&this.filter_range);
    (hoist3)
}

// Upstream debug assertions require an aligned base and size >= value width;
// carried here as authored crash parity (Omega has no debug/release mode --
// the always-on trap is the port's form of those debug_assert! sites).
// As in upstream release code, short coverage saturates before division.
// Overlapping values need trailing payload bytes, which are not candidate starts.
pub machine SnapshotRegionFilter::get_element_count(
    this: &SnapshotRegionFilter,
    data_type_unit_size_bytes: u64,
    memory_alignment: MemoryAlignment
) -> u64
crashes Abort
{
    let alignment: u64 = MemoryAlignment::get_size_in_bytes(&memory_alignment);
    transition this.filter_range.base_address % alignment == 0 && this.filter_range.region_size >= data_type_unit_size_bytes {
        true -> count(this, data_type_unit_size_bytes, alignment)
        false -> violated(this)
    }

    state violated(this: &SnapshotRegionFilter) -> u64 {
        crash Abort;
    }

    state count(this: &SnapshotRegionFilter, width: u64, alignment: u64) -> u64
        requires 1 <= alignment && alignment <= 8
    {
        let trailing_bytes: u64 = ((width as u64 in Saturating) - (alignment as u64 in Saturating)) as u64;
        let size_in_bytes: u64 = SnapshotRegionFilter::get_region_size(&this);
        let effective_size_in_bytes: u64 = ((size_in_bytes as u64 in Saturating) - (trailing_bytes as u64 in Saturating)) as u64;
        transition { _ -> (effective_size_in_bytes / alignment) }
    }
}

// In-package check for the crash parity above (squalr-tests' first vector:
// base 4096, size 16, width 4, Alignment4 -> 4 elements) -- package callers
// cannot currently exercise it because squalr-tests' omega.lock predates the
// post-migration std pin.
machine debug_assertion_parity_smoke() -> u64
crashes Abort
{
    let filter: SnapshotRegionFilter = SnapshotRegionFilter::new(4096, 16);
    let hoist4: u64 = SnapshotRegionFilter::get_element_count(filter, 4, MemoryAlignment::Alignment4);
    (hoist4)
}

// Port of get_misaligned_starting_byte_count: bytes to add to reach the next
// alignment boundary, zero when the base is already aligned. Upstream's
// max(alignment, 1) clamp is the [1..=8] domain on get_size_in_bytes.
machine SnapshotRegionFilter::get_misaligned_starting_byte_count(
    this: &SnapshotRegionFilter,
    alignment: MemoryAlignment
) -> u64 {
    let alignment_bytes: u64 = MemoryAlignment::get_size_in_bytes(&alignment);
    let misalignment: u64 = SnapshotRegionFilter::get_base_address(&this) % (alignment_bytes as u64);
    (((alignment_bytes as u64 in Saturating) - (misalignment as u64 in Saturating)) as u64) % (alignment_bytes as u64)
}

pub machine SnapshotRegionFilter::equals(this: &SnapshotRegionFilter, other: &SnapshotRegionFilter) -> bool
{
    let hoist5: bool = normalized_region::NormalizedRegion::equals(this.filter_range, &other.filter_range);
    (hoist5)
}
