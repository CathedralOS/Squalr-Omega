module src::structures::scanning::filters::snapshot_region_filter;

use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::memory::normalized_region::NormalizedRegion;

// Same nested representation and range/count operations as the Rust source.
// Public structural fields follow Omega visibility, not Rust field privacy.
pub data SnapshotRegionFilter {
    filter_range: NormalizedRegion;
}

pub machine SnapshotRegionFilter::new(base_address: u64, get_size_in_bytes: u64) -> SnapshotRegionFilter {
    SnapshotRegionFilter { filter_range: NormalizedRegion::new(base_address, get_size_in_bytes) }
}

pub machine SnapshotRegionFilter::get_base_address(&self) -> u64 {
    self.filter_range.get_base_address()
}

pub machine SnapshotRegionFilter::set_base_address(&mut self, base_address: u64) {
    self.filter_range.set_base_address(base_address);
}

pub machine SnapshotRegionFilter::set_end_address(&mut self, end_address: u64) {
    self.filter_range.set_end_address(end_address);
}

pub machine SnapshotRegionFilter::get_end_address(&self) -> u64 {
    self.filter_range.get_end_address()
}

pub machine SnapshotRegionFilter::get_region_size(&self) -> u64 {
    self.filter_range.get_region_size()
}

// Upstream's debug_assert!s require an aligned base, size >= value width, and
// size >= the trailing tail. `memory_alignment > 0` is discharged by the
// [1..=8] domain on get_size_in_bytes. The remaining checks are debug-only
// upstream and cannot be expressed in a native-admitted scalar callee today:
// crash routes and `crashes` contracts are outside the value-machine
// production vocabulary, and `in Trapping` arithmetic has no terminal
// realization (the checking/no-op assertion selection the spec describes is
// still an open build-level-exclusions frontier). Recorded intentional
// deviation: the release-equivalent port performs no runtime check, matching
// upstream release behavior. As in upstream release code, short coverage
// saturates before division; overlapping values need trailing payload bytes,
// which are not candidate starts.
pub machine SnapshotRegionFilter::get_element_count(
    &self,
    data_type_unit_size_bytes: u64,
    memory_alignment: MemoryAlignment
) -> u64 {
    let alignment: u64 [1..=8] = memory_alignment.get_size_in_bytes();
    let trailing_bytes: u64 = ((data_type_unit_size_bytes as u64 in Saturating) - (alignment as u64 in Saturating)) as u64;
    let size_in_bytes: u64 = self.get_region_size();
    let effective_size_in_bytes: u64 = ((size_in_bytes as u64 in Saturating) - (trailing_bytes as u64 in Saturating)) as u64;
    effective_size_in_bytes / alignment
}

// Port of get_misaligned_starting_byte_count: bytes to add to reach the next
// alignment boundary, zero when the base is already aligned. Upstream's
// max(alignment, 1) clamp is the [1..=8] domain on get_size_in_bytes.
machine SnapshotRegionFilter::get_misaligned_starting_byte_count(
    &self,
    alignment: MemoryAlignment
) -> u64 {
    let alignment_bytes: u64 [1..=8] = alignment.get_size_in_bytes();
    let misalignment: u64 = self.get_base_address() % (alignment_bytes as u64);
    (((alignment_bytes as u64 in Saturating) - (misalignment as u64 in Saturating)) as u64) % (alignment_bytes as u64)
}

pub machine SnapshotRegionFilter::equals(&self, other: &SnapshotRegionFilter) -> bool {
    self.filter_range.equals(&other.filter_range)
}
