module src::structures::scanning::memory_read_mode;

// Port of MemoryReadMode. Two variants matching upstream: Skip for scans that
// do not refresh bytes, ReadBeforeScan (the default) for scans that read
// current values first.
pub data MemoryReadMode [copy] {
    case Skip;
    case ReadBeforeScan;
}

pub machine MemoryReadMode::default() -> MemoryReadMode {
    (MemoryReadMode::ReadBeforeScan)
}
