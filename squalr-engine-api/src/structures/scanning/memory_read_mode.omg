module src::structures::scanning::memory_read_mode;

// Upstream `MemoryReadMode` (structures/scanning/memory_read_mode.rs): whether
// a scan collects element values from live memory before comparing. The port
// keeps the two modes; the `SerializationInterlude` interlude variant is a
// GUI-import concern outside the CLI command surface.
pub data MemoryReadMode [copy] {
    // `ReadBeforeScan` leads so zero-initialized state equals the upstream
    // default (union field stores are unavailable in the entry unit plan;
    // case order carries no wire semantics).
    case ReadBeforeScan;
    case Skip;
}

// Upstream `Default` is `ReadBeforeScan`.
pub machine MemoryReadMode::default() -> MemoryReadMode {
    MemoryReadMode::ReadBeforeScan
}

pub data MemoryReadModeParse {
    case Parsed(mode: MemoryReadMode);
    case Invalid;
}

// Upstream `FromStr`: "s" -> Skip, "b" -> ReadBeforeScan.
pub machine MemoryReadMode::from_str(text: &[u8]) -> MemoryReadModeParse {
    transition text.len == 1 && 0 < text.len {
        true -> digit(text[0])
        false -> (MemoryReadModeParse::Invalid)
    }
    state digit(value: u8) -> MemoryReadModeParse {
        transition value {
            115 -> (MemoryReadModeParse::Parsed { mode: MemoryReadMode::Skip })
            98 -> (MemoryReadModeParse::Parsed { mode: MemoryReadMode::ReadBeforeScan })
            _ -> (MemoryReadModeParse::Invalid)
        }
    }
}
