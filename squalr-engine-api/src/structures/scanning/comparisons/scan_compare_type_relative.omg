module src::structures::scanning::comparisons::scan_compare_type_relative;

use src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use src::structures::scanning::comparisons::scan_compare_type::bits_to_f32;
use src::structures::scanning::comparisons::scan_compare_type::bits_to_f64;
use src::structures::scanning::comparisons::scan_compare_type::element_width_mask_u64;
use src::structures::scanning::comparisons::scan_compare_type::sign_extend_u64;
use src::structures::scanning::comparisons::scan_compare_type::signed_less_u64;

// Port of ScanCompareTypeRelative: current-vs-previous relations. Upstream
// closes over nothing and compares two unaligned typed loads.
pub data ScanCompareTypeRelative [copy] {
    case Changed;
    case Unchanged;
    case Increased;
    case Decreased;
}

pub machine ScanCompareTypeRelative::compare(&self, current_value: u64, previous_value: u64) -> bool {
    transition self {
        ScanCompareTypeRelative::Changed -> (current_value != previous_value)
        ScanCompareTypeRelative::Unchanged -> (current_value == previous_value)
        ScanCompareTypeRelative::Increased -> (current_value > previous_value)
        ScanCompareTypeRelative::Decreased -> (current_value < previous_value)
    }
}

// The typed compare — Changed/Unchanged are element-width bit equality;
// Increased/Decreased order the masked values unsigned-ly for unsigned
// types and sign-extended for signed types (upstream's typed `>`/`<` on the
// two loads).
pub machine ScanCompareTypeRelative::compare_typed(
    &self,
    current_value: u64,
    previous_value: u64,
    is_signed: bool,
    is_floating_point: bool,
    floating_point_tolerance: FloatingPointTolerance,
    element_size_in_bytes: u64
) -> bool {
    transition is_floating_point {
        true -> float_typed(current_value, previous_value,
            element_size_in_bytes)
        false -> integer_typed(current_value, previous_value, is_signed,
            element_size_in_bytes)
        _ -> integer_typed(current_value, previous_value, is_signed,
            element_size_in_bytes)
    }
    // Upstream `ScalarComparisonsFloat` relative compares — PartialEq /
    // PartialOrd on the decoded floats (no tolerance: upstream's Changed /
    // Unchanged / Increased / Decreased read `!=` `==` `>` `<` directly, so
    // a NaN element answers Changed=true and everything else false).
    state float_typed(
        &self,
        current_value: u64,
        previous_value: u64,
        element_size_in_bytes: u64
    ) -> bool {
        transition element_size_in_bytes == 4 {
            true -> float32_typed(current_value, previous_value)
            false -> float64_typed(current_value, previous_value)
            _ -> float64_typed(current_value, previous_value)
        }
    }
    state float32_typed(
        &self,
        current_value: u64,
        previous_value: u64
    ) -> bool {
        let current: f32 = bits_to_f32(current_value);
        let previous: f32 = bits_to_f32(previous_value);
        transition self {
            ScanCompareTypeRelative::Changed -> (current != previous)
            ScanCompareTypeRelative::Unchanged -> (current == previous)
            ScanCompareTypeRelative::Increased -> (current > previous)
            ScanCompareTypeRelative::Decreased -> (current < previous)
        }
    }
    state float64_typed(
        &self,
        current_value: u64,
        previous_value: u64
    ) -> bool {
        let current: f64 = bits_to_f64(current_value);
        let previous: f64 = bits_to_f64(previous_value);
        transition self {
            ScanCompareTypeRelative::Changed -> (current != previous)
            ScanCompareTypeRelative::Unchanged -> (current == previous)
            ScanCompareTypeRelative::Increased -> (current > previous)
            ScanCompareTypeRelative::Decreased -> (current < previous)
        }
    }
    state integer_typed(
        &self,
        current_value: u64,
        previous_value: u64,
        is_signed: bool,
        element_size_in_bytes: u64
    ) -> bool {
        let width_mask: u64 = element_width_mask_u64(element_size_in_bytes);
        let current_masked: u64 = ((current_value as u64 in Wrapping)
            & (width_mask as u64 in Wrapping)) as u64;
        let previous_masked: u64 = ((previous_value as u64 in Wrapping)
            & (width_mask as u64 in Wrapping)) as u64;
        transition self {
            ScanCompareTypeRelative::Changed -> (current_masked != previous_masked)
            ScanCompareTypeRelative::Unchanged -> (current_masked == previous_masked)
            _ -> ordering(current_masked, previous_masked, is_signed,
                element_size_in_bytes)
        }
    }
    state ordering(
        &self,
        current_masked: u64,
        previous_masked: u64,
        is_signed: bool,
        element_size_in_bytes: u64
    ) -> bool {
        let extended_current: u64 =
            sign_extend_u64(current_masked, element_size_in_bytes);
        let extended_previous: u64 =
            sign_extend_u64(previous_masked, element_size_in_bytes);
        let signed_increase: bool =
            signed_less_u64(extended_previous, extended_current);
        let signed_decrease: bool =
            signed_less_u64(extended_current, extended_previous);
        transition is_signed {
            true -> pick_signed(signed_increase, signed_decrease)
            false -> pick_unsigned(current_masked, previous_masked)
            _ -> pick_unsigned(current_masked, previous_masked)
        }
    }
    state pick_signed(
        &self,
        signed_increase: bool,
        signed_decrease: bool
    ) -> bool {
        transition self {
            ScanCompareTypeRelative::Increased -> (signed_increase)
            ScanCompareTypeRelative::Decreased -> (signed_decrease)
            _ -> (false)
        }
    }
    state pick_unsigned(
        &self,
        current_masked: u64,
        previous_masked: u64
    ) -> bool {
        transition self {
            ScanCompareTypeRelative::Increased -> (current_masked > previous_masked)
            ScanCompareTypeRelative::Decreased -> (current_masked < previous_masked)
            _ -> (false)
        }
    }
}
