module src::structures::scanning::comparisons::scan_compare_type_delta;

use src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use src::structures::scanning::comparisons::scan_compare_type::arithmetic_shift_right_u64;
use src::structures::scanning::comparisons::scan_compare_type::bits_to_f32;
use src::structures::scanning::comparisons::scan_compare_type::bits_to_f64;
use src::structures::scanning::comparisons::scan_compare_type::effective_shift_u64;
use src::structures::scanning::comparisons::scan_compare_type::element_width_mask_u64;
use src::structures::scanning::comparisons::scan_compare_type::f32_to_bits;
use src::structures::scanning::comparisons::scan_compare_type::f64_to_bits;
use src::structures::scanning::comparisons::scan_compare_type::float_abs_diff_le_tolerance_f32;
use src::structures::scanning::comparisons::scan_compare_type::float_abs_diff_le_tolerance_f64;
use src::structures::scanning::comparisons::scan_compare_type::float_mod_f32;
use src::structures::scanning::comparisons::scan_compare_type::float_mod_f64;
use src::structures::scanning::comparisons::scan_compare_type::sign_extend_u64;
use src::structures::scanning::comparisons::scan_compare_type::signed_divide_u64;
use src::structures::scanning::comparisons::scan_compare_type::signed_remainder_u64;

// Port of ScanCompareTypeDelta: each case checks `current == previous <op> delta`
// under the data type's wrapping arithmetic (upstream ScalarComparisonsInteger
// uses WrappingAdd/Sub/Mul/Div/Rem/Shl/Shr and bitwise ops). `u64 in Wrapping`
// preserves the deliberate overflow-dropping semantics of those operators.
pub data ScanCompareTypeDelta [copy] {
    case IncreasedByX;
    case DecreasedByX;
    case MultipliedByX;
    case DividedByX;
    case ModuloByX;
    case ShiftLeftByX;
    case ShiftRightByX;
    case LogicalAndByX;
    case LogicalOrByX;
    case LogicalXorByX;
}

pub machine ScanCompareTypeDelta::compare(
    this: &ScanCompareTypeDelta,
    current_value: u64,
    previous_value: u64,
    delta_value: u64
) -> bool {
    let previous: u64 in Wrapping = previous_value as u64 in Wrapping;
    let delta: u64 in Wrapping = delta_value as u64 in Wrapping;
    transition this {
        ScanCompareTypeDelta::IncreasedByX -> (current_value == ((previous + delta) as u64))
        ScanCompareTypeDelta::DecreasedByX -> (current_value == ((previous - delta) as u64))
        ScanCompareTypeDelta::MultipliedByX -> (current_value == ((previous * delta) as u64))
        ScanCompareTypeDelta::DividedByX -> divide(current_value, previous, delta)
        ScanCompareTypeDelta::ModuloByX -> modulo(current_value, previous, delta)
        ScanCompareTypeDelta::ShiftLeftByX -> (current_value == ((previous << delta) as u64))
        ScanCompareTypeDelta::ShiftRightByX -> (current_value == ((previous >> delta) as u64))
        ScanCompareTypeDelta::LogicalAndByX -> (current_value == ((previous & delta) as u64))
        ScanCompareTypeDelta::LogicalOrByX -> (current_value == ((previous | delta) as u64))
        ScanCompareTypeDelta::LogicalXorByX -> (current_value == ((previous ^ delta) as u64))
    }
    // Upstream refuses a zero divisor at construction; the nonzero discharge
    // lives in the arm the guard admits (facts do not cross state hops).
    state divide(current_value: u64, previous: u64 in Wrapping, delta: u64 in Wrapping) -> bool {
        transition delta != 0 {
            true -> (current_value == ((previous / delta) as u64))
            false -> (false)
            _ -> (false)
        }
    }
    state modulo(current_value: u64, previous: u64 in Wrapping, delta: u64 in Wrapping) -> bool {
        transition delta != 0 {
            true -> (current_value == ((previous % delta) as u64))
            false -> (false)
            _ -> (false)
        }
    }
}

// Upstream refuses the constraint at compare construction when the divisor
// is zero (`delta_value == PrimitiveType::default()` -> `None`).
pub machine ScanCompareTypeDelta::requires_nonzero_delta(this: &ScanCompareTypeDelta) -> bool {
    transition this {
        ScanCompareTypeDelta::DividedByX -> (true)
        ScanCompareTypeDelta::ModuloByX -> (true)
        _ -> (false)
    }
}

// Upstream's float ScalarComparable impls return `None` for these delta
// kinds — the shift/logical ops have no float arithmetic (the plan drops
// the scalar function the same way it drops a zero divisor).
pub machine ScanCompareTypeDelta::requires_integer_delta(this: &ScanCompareTypeDelta) -> bool {
    transition this {
        ScanCompareTypeDelta::ShiftLeftByX -> (true)
        ScanCompareTypeDelta::ShiftRightByX -> (true)
        ScanCompareTypeDelta::LogicalAndByX -> (true)
        ScanCompareTypeDelta::LogicalOrByX -> (true)
        ScanCompareTypeDelta::LogicalXorByX -> (true)
        _ -> (false)
    }
}

// The typed compare: every operand masks to element width and every result
// wraps at element width — upstream evaluates `previous <op> delta` on
// PrimitiveType-width words and compares it against the typed current load.
// Add/subtract/multiply and the logical ops are bit-sign-agnostic, so a
// masked u64 word is exactly the per-type wrap; divide/modulo keep signed
// truncation semantics for signed types and shift-right is arithmetic for
// signed types, plain logical for unsigned. Shift distance is `delta mod
// (8*element_size)`, matching upstream's amount-masking `shl`/`shr`.
pub machine ScanCompareTypeDelta::compare_typed(
    this: &ScanCompareTypeDelta,
    current_value: u64,
    previous_value: u64,
    delta_value: u64,
    is_signed: bool,
    is_floating_point: bool,
    floating_point_tolerance: FloatingPointTolerance,
    element_size_in_bytes: u64
) -> bool {
    transition is_floating_point {
        true -> float_typed(this, current_value, previous_value, delta_value,
            floating_point_tolerance, element_size_in_bytes)
        false -> integer_typed(this, current_value, previous_value, delta_value,
            is_signed, element_size_in_bytes)
        _ -> integer_typed(this, current_value, previous_value, delta_value,
            is_signed, element_size_in_bytes)
    }
    // Upstream `ScalarComparisonsFloat` delta compares: the float target is
    // `previous <op> delta` evaluated on decoded floats, and the check is
    // `|current - target| <= tolerance`. The shift/logical kinds are
    // unreachable here — the plan refuses them on floating-point types
    // upstream (`ScalarComparable::None`) and they answer false locally.
    state float_typed(
        this: &ScanCompareTypeDelta,
        current_value: u64,
        previous_value: u64,
        delta_value: u64,
        floating_point_tolerance: FloatingPointTolerance,
        element_size_in_bytes: u64
    ) -> bool {
        let tolerance_bits: u64 =
            FloatingPointTolerance::get_value_bits(&floating_point_tolerance, element_size_in_bytes);
        transition element_size_in_bytes == 4 {
            true -> float32_typed(this, 
                current_value, previous_value, delta_value, tolerance_bits)
            false -> float64_typed(this, 
                current_value, previous_value, delta_value, tolerance_bits)
            _ -> float64_typed(this, 
                current_value, previous_value, delta_value, tolerance_bits)
        }
    }
    state float32_typed(
        this: &ScanCompareTypeDelta,
        current_value: u64,
        previous_value: u64,
        delta_value: u64,
        tolerance_bits: u64
    ) -> bool {
        let previous: f32 = bits_to_f32(previous_value);
        let delta: f32 = bits_to_f32(delta_value);
        transition this {
            ScanCompareTypeDelta::IncreasedByX -> float32_target(
                current_value, previous + delta, tolerance_bits)
            ScanCompareTypeDelta::DecreasedByX -> float32_target(
                current_value, previous - delta, tolerance_bits)
            ScanCompareTypeDelta::MultipliedByX -> float32_target(
                current_value, previous * delta, tolerance_bits)
            ScanCompareTypeDelta::DividedByX -> float32_target(
                current_value, previous / delta, tolerance_bits)
            ScanCompareTypeDelta::ModuloByX -> float32_mod_target(
                current_value, previous, delta, tolerance_bits)
            _ -> (false)
        }
    }
    state float32_target(
        current_value: u64,
        target: f32,
        tolerance_bits: u64
    ) -> bool {
        let target_bits: u64 = f32_to_bits(target);
        let hoist1: bool = float_abs_diff_le_tolerance_f32(
            current_value, target_bits, tolerance_bits);
        (hoist1)
    }
    state float32_mod_target(
        current_value: u64,
        previous: f32,
        delta: f32,
        tolerance_bits: u64
    ) -> bool {
        let remainder: f32 = float_mod_f32(previous, delta);
        let target_bits: u64 = f32_to_bits(remainder);
        let hoist2: bool = float_abs_diff_le_tolerance_f32(
            current_value, target_bits, tolerance_bits);
        (hoist2)
    }
    state float64_typed(
        this: &ScanCompareTypeDelta,
        current_value: u64,
        previous_value: u64,
        delta_value: u64,
        tolerance_bits: u64
    ) -> bool {
        let previous: f64 = bits_to_f64(previous_value);
        let delta: f64 = bits_to_f64(delta_value);
        transition this {
            ScanCompareTypeDelta::IncreasedByX -> float64_target(
                current_value, previous + delta, tolerance_bits)
            ScanCompareTypeDelta::DecreasedByX -> float64_target(
                current_value, previous - delta, tolerance_bits)
            ScanCompareTypeDelta::MultipliedByX -> float64_target(
                current_value, previous * delta, tolerance_bits)
            ScanCompareTypeDelta::DividedByX -> float64_target(
                current_value, previous / delta, tolerance_bits)
            ScanCompareTypeDelta::ModuloByX -> float64_mod_target(
                current_value, previous, delta, tolerance_bits)
            _ -> (false)
        }
    }
    state float64_target(
        current_value: u64,
        target: f64,
        tolerance_bits: u64
    ) -> bool {
        let target_bits: u64 = f64_to_bits(target);
        let hoist3: bool = float_abs_diff_le_tolerance_f64(
            current_value, target_bits, tolerance_bits);
        (hoist3)
    }
    state float64_mod_target(
        current_value: u64,
        previous: f64,
        delta: f64,
        tolerance_bits: u64
    ) -> bool {
        let remainder: f64 = float_mod_f64(previous, delta);
        let target_bits: u64 = f64_to_bits(remainder);
        let hoist4: bool = float_abs_diff_le_tolerance_f64(
            current_value, target_bits, tolerance_bits);
        (hoist4)
    }
    state integer_typed(
        this: &ScanCompareTypeDelta,
        current_value: u64,
        previous_value: u64,
        delta_value: u64,
        is_signed: bool,
        element_size_in_bytes: u64
    ) -> bool {
    let width_mask: u64 = element_width_mask_u64(element_size_in_bytes);
    let current_masked: u64 = ((current_value as u64 in Wrapping)
        & (width_mask as u64 in Wrapping)) as u64;
    let previous_masked: u64 = ((previous_value as u64 in Wrapping)
        & (width_mask as u64 in Wrapping)) as u64;
    let delta_masked: u64 = ((delta_value as u64 in Wrapping)
        & (width_mask as u64 in Wrapping)) as u64;
    let previous_wrapped: u64 in Wrapping = previous_masked as u64 in Wrapping;
    let delta_wrapped: u64 in Wrapping = delta_masked as u64 in Wrapping;
    transition this {
        ScanCompareTypeDelta::IncreasedByX -> (current_masked ==
            (((previous_wrapped + delta_wrapped)
                & (width_mask as u64 in Wrapping)) as u64))
        ScanCompareTypeDelta::DecreasedByX -> (current_masked ==
            (((previous_wrapped - delta_wrapped)
                & (width_mask as u64 in Wrapping)) as u64))
        ScanCompareTypeDelta::MultipliedByX -> (current_masked ==
            (((previous_wrapped * delta_wrapped)
                & (width_mask as u64 in Wrapping)) as u64))
        ScanCompareTypeDelta::DividedByX -> divided(
            current_masked, previous_masked, delta_masked,
            is_signed, element_size_in_bytes, width_mask)
        ScanCompareTypeDelta::ModuloByX -> modulo(
            current_masked, previous_masked, delta_masked,
            is_signed, element_size_in_bytes, width_mask)
        ScanCompareTypeDelta::ShiftLeftByX -> shifted_left(
            current_masked, previous_masked, delta_masked,
            element_size_in_bytes, width_mask)
        ScanCompareTypeDelta::ShiftRightByX -> shifted_right(
            current_masked, previous_masked, delta_masked,
            is_signed, element_size_in_bytes, width_mask)
        ScanCompareTypeDelta::LogicalAndByX -> (current_masked ==
            ((previous_wrapped & delta_wrapped) as u64))
        ScanCompareTypeDelta::LogicalOrByX -> (current_masked ==
            ((previous_wrapped | delta_wrapped) as u64))
        ScanCompareTypeDelta::LogicalXorByX -> (current_masked ==
            ((previous_wrapped ^ delta_wrapped) as u64))
    }
    }

    state divided(
        current_masked: u64,
        previous_masked: u64,
        delta_masked: u64,
        is_signed: bool,
        element_size_in_bytes: u64,
        width_mask: u64
    ) -> bool {
        // Zero divisor is unreachable — construction refuses it upstream
        // and the plan drops the scalar function — the guard keeps the
        // machine's own division honest regardless.
        transition delta_masked == 0 {
            true -> (current_masked == 0)
            false -> divide_by(current_masked, previous_masked,
                delta_masked, is_signed, element_size_in_bytes, width_mask)
            _ -> divide_by(current_masked, previous_masked,
                delta_masked, is_signed, element_size_in_bytes, width_mask)
        }
    }
    state divide_by(
        current_masked: u64,
        previous_masked: u64,
        delta_masked: u64,
        is_signed: bool,
        element_size_in_bytes: u64,
        width_mask: u64
    ) -> bool {
        transition is_signed {
            true -> divide_signed(current_masked, previous_masked,
                delta_masked, element_size_in_bytes, width_mask)
            false -> (current_masked == (((previous_masked / delta_masked)
                as u64 in Wrapping) & (width_mask as u64 in Wrapping)) as u64)
            _ -> (current_masked == (((previous_masked / delta_masked)
                as u64 in Wrapping) & (width_mask as u64 in Wrapping)) as u64)
        }
    }
    state divide_signed(
        current_masked: u64,
        previous_masked: u64,
        delta_masked: u64,
        element_size_in_bytes: u64,
        width_mask: u64
    ) -> bool {
        let extended_previous: u64 =
            sign_extend_u64(previous_masked, element_size_in_bytes);
        let extended_delta: u64 =
            sign_extend_u64(delta_masked, element_size_in_bytes);
        let quotient_extended: u64 =
            signed_divide_u64(extended_previous, extended_delta);
        let quotient: u64 = ((quotient_extended as u64 in Wrapping)
            & (width_mask as u64 in Wrapping)) as u64;
        (current_masked == quotient)
    }

    state modulo(
        current_masked: u64,
        previous_masked: u64,
        delta_masked: u64,
        is_signed: bool,
        element_size_in_bytes: u64,
        width_mask: u64
    ) -> bool {
        transition delta_masked == 0 {
            true -> (current_masked == 0)
            false -> modulo_by(current_masked, previous_masked,
                delta_masked, is_signed, element_size_in_bytes, width_mask)
            _ -> modulo_by(current_masked, previous_masked,
                delta_masked, is_signed, element_size_in_bytes, width_mask)
        }
    }
    state modulo_by(
        current_masked: u64,
        previous_masked: u64,
        delta_masked: u64,
        is_signed: bool,
        element_size_in_bytes: u64,
        width_mask: u64
    ) -> bool {
        transition is_signed {
            true -> modulo_signed(current_masked, previous_masked,
                delta_masked, element_size_in_bytes, width_mask)
            false -> (current_masked == (((previous_masked % delta_masked)
                as u64 in Wrapping) & (width_mask as u64 in Wrapping)) as u64)
            _ -> (current_masked == (((previous_masked % delta_masked)
                as u64 in Wrapping) & (width_mask as u64 in Wrapping)) as u64)
        }
    }
    state modulo_signed(
        current_masked: u64,
        previous_masked: u64,
        delta_masked: u64,
        element_size_in_bytes: u64,
        width_mask: u64
    ) -> bool {
        let extended_previous: u64 =
            sign_extend_u64(previous_masked, element_size_in_bytes);
        let extended_delta: u64 =
            sign_extend_u64(delta_masked, element_size_in_bytes);
        let remainder_extended: u64 =
            signed_remainder_u64(extended_previous, extended_delta);
        let remainder: u64 = ((remainder_extended as u64 in Wrapping)
            & (width_mask as u64 in Wrapping)) as u64;
        (current_masked == remainder)
    }

    state shifted_left(
        current_masked: u64,
        previous_masked: u64,
        delta_masked: u64,
        element_size_in_bytes: u64,
        width_mask: u64
    ) -> bool {
        let shift: u64 =
            effective_shift_u64(delta_masked, element_size_in_bytes);
        let previous_wrapped: u64 in Wrapping = previous_masked as u64 in Wrapping;
        let shift_wrapped: u64 in Wrapping = shift as u64 in Wrapping;
        let shifted: u64 = (((previous_wrapped << shift_wrapped)
            & (width_mask as u64 in Wrapping)) as u64);
        (current_masked == shifted)
    }

    state shifted_right(
        current_masked: u64,
        previous_masked: u64,
        delta_masked: u64,
        is_signed: bool,
        element_size_in_bytes: u64,
        width_mask: u64
    ) -> bool {
        let shift: u64 =
            effective_shift_u64(delta_masked, element_size_in_bytes);
        transition is_signed {
            true -> shift_right_signed(current_masked, previous_masked,
                shift, element_size_in_bytes, width_mask)
            false -> shift_right_unsigned(current_masked, previous_masked,
                shift, width_mask)
            _ -> shift_right_unsigned(current_masked, previous_masked,
                shift, width_mask)
        }
    }
    state shift_right_unsigned(
        current_masked: u64,
        previous_masked: u64,
        shift: u64,
        width_mask: u64
    ) -> bool {
        let previous_wrapped: u64 in Wrapping = previous_masked as u64 in Wrapping;
        let shift_wrapped: u64 in Wrapping = shift as u64 in Wrapping;
        let shifted: u64 = (((previous_wrapped >> shift_wrapped)
            & (width_mask as u64 in Wrapping)) as u64);
        (current_masked == shifted)
    }
    state shift_right_signed(
        current_masked: u64,
        previous_masked: u64,
        shift: u64,
        element_size_in_bytes: u64,
        width_mask: u64
    ) -> bool {
        let extended_previous: u64 =
            sign_extend_u64(previous_masked, element_size_in_bytes);
        let shifted_extended: u64 =
            arithmetic_shift_right_u64(extended_previous, shift);
        let shifted: u64 = ((shifted_extended as u64 in Wrapping)
            & (width_mask as u64 in Wrapping)) as u64;
        (current_masked == shifted)
    }
}
