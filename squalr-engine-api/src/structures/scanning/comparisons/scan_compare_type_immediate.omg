module src::structures::scanning::comparisons::scan_compare_type_immediate;

// Port of ScanCompareTypeImmediate: the six immediate (current-vs-operand)
// comparisons. Upstream builds a `*const u8 -> bool` closure per data type that
// captures the scan operand; the closure capture and the unaligned typed load
// translate to explicit `scan_value`/loaded `current_value` arguments here.
pub data ScanCompareTypeImmediate [copy] {
    case Equal;
    case NotEqual;
    case GreaterThan;
    case GreaterThanOrEqual;
    case LessThan;
    case LessThanOrEqual;
}

pub machine ScanCompareTypeImmediate::compare(&self, current_value: u64, scan_value: u64) -> bool {
    transition self {
        ScanCompareTypeImmediate::Equal -> (current_value == scan_value)
        ScanCompareTypeImmediate::NotEqual -> (current_value != scan_value)
        ScanCompareTypeImmediate::GreaterThan -> (current_value > scan_value)
        ScanCompareTypeImmediate::GreaterThanOrEqual -> (current_value >= scan_value)
        ScanCompareTypeImmediate::LessThan -> (current_value < scan_value)
        ScanCompareTypeImmediate::LessThanOrEqual -> (current_value <= scan_value)
    }
}
