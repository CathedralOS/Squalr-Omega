module src::structures::scanning::comparisons::scan_compare_type_immediate;

use src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use src::structures::scanning::comparisons::scan_compare_type::bits_to_f32;
use src::structures::scanning::comparisons::scan_compare_type::bits_to_f64;
use src::structures::scanning::comparisons::scan_compare_type::element_width_mask_u64;
use src::structures::scanning::comparisons::scan_compare_type::float_abs_diff_gt_tolerance_f32;
use src::structures::scanning::comparisons::scan_compare_type::float_abs_diff_gt_tolerance_f64;
use src::structures::scanning::comparisons::scan_compare_type::float_abs_diff_le_tolerance_f32;
use src::structures::scanning::comparisons::scan_compare_type::float_abs_diff_le_tolerance_f64;
use src::structures::scanning::comparisons::scan_compare_type::sign_extend_u64;
use src::structures::scanning::comparisons::scan_compare_type::signed_less_u64;

// Port of ScanCompareTypeImmediate: the six immediate (current-vs-operand)
// comparisons. Upstream builds a `*const u8 -> bool` closure per data type that
// captures the scan operand; the closure capture and the unaligned typed load
// translate to explicit `scan_value`/loaded `current_value` arguments here.
pub data ScanCompareTypeImmediate [copy] {
    case Equal;
    case NotEqual;
    case GreaterThan;
    case GreaterThanOrEqual;
    case LessThan;
    case LessThanOrEqual;
}

pub machine ScanCompareTypeImmediate::compare(this: &ScanCompareTypeImmediate, current_value: u64, scan_value: u64) -> bool {
    transition this {
        ScanCompareTypeImmediate::Equal -> (current_value == scan_value)
        ScanCompareTypeImmediate::NotEqual -> (current_value != scan_value)
        ScanCompareTypeImmediate::GreaterThan -> (current_value > scan_value)
        ScanCompareTypeImmediate::GreaterThanOrEqual -> (current_value >= scan_value)
        ScanCompareTypeImmediate::LessThan -> (current_value < scan_value)
        ScanCompareTypeImmediate::LessThanOrEqual -> (current_value <= scan_value)
    }
}

// The typed compare — upstream's closure loads `current` as the element's
// PrimitiveType and compares with native ordering. On the u64 slot model:
// equality is element-width bit equality (upstream's own note on the
// big-endian twin — "no endian byte swap required for immediate or current
// values" — holds: equal widths compare equal bits); ordering is masked
// unsigned order for unsigned types and sign-extended signed order for
// signed types, so `i8 -1` orders below `i8 0` exactly as upstream's typed
// `>` reads it.
pub machine ScanCompareTypeImmediate::compare_typed(
    this: &ScanCompareTypeImmediate,
    current_value: u64,
    scan_value: u64,
    is_signed: bool,
    is_floating_point: bool,
    floating_point_tolerance: FloatingPointTolerance,
    element_size_in_bytes: u64
) -> bool {
    transition is_floating_point {
        true -> float_typed(this, 
            current_value, scan_value, floating_point_tolerance,
            element_size_in_bytes)
        false -> integer_typed(this, 
            current_value, scan_value, is_signed, element_size_in_bytes)
        _ -> integer_typed(this, 
            current_value, scan_value, is_signed, element_size_in_bytes)
    }
    state integer_typed(
        this: &ScanCompareTypeImmediate,
        current_value: u64,
        scan_value: u64,
        is_signed: bool,
        element_size_in_bytes: u64
    ) -> bool {
        let width_mask: u64 = element_width_mask_u64(element_size_in_bytes);
        let current_masked: u64 = ((current_value as u64 in Wrapping)
            & (width_mask as u64 in Wrapping)) as u64;
        let scan_masked: u64 = ((scan_value as u64 in Wrapping)
            & (width_mask as u64 in Wrapping)) as u64;
        transition this {
            ScanCompareTypeImmediate::Equal -> (current_masked == scan_masked)
            ScanCompareTypeImmediate::NotEqual -> (current_masked != scan_masked)
            _ -> ordering(this, current_masked, scan_masked, is_signed, element_size_in_bytes)
        }
    }
    state ordering(
        this: &ScanCompareTypeImmediate,
        current_masked: u64,
        scan_masked: u64,
        is_signed: bool,
        element_size_in_bytes: u64
    ) -> bool {
        let hoist3: bool = ScanCompareTypeImmediate::compare(&this, current_masked, scan_masked);
        let hoist2: bool = ScanCompareTypeImmediate::compare(&this, current_masked, scan_masked);
        let hoist1: bool = ScanCompareTypeImmediate::compare_signed(&this, current_masked, scan_masked, element_size_in_bytes);
        transition is_signed {
            true -> (hoist1)
            false -> (hoist2)
            _ -> (hoist3)
        }
    }
    // Upstream `ScalarComparisonsFloat` immediate compares: equal/not_equal
    // test `|current - scan| <= tolerance` (`get_floating_point_tolerance`
    // resolved to the element width's constant), ordering rides the plain
    // partial order (a NaN operand or element misses like upstream).
    state float_typed(
        this: &ScanCompareTypeImmediate,
        current_value: u64,
        scan_value: u64,
        floating_point_tolerance: FloatingPointTolerance,
        element_size_in_bytes: u64
    ) -> bool {
        let tolerance_bits: u64 =
            FloatingPointTolerance::get_value_bits(&floating_point_tolerance, element_size_in_bytes);
        transition element_size_in_bytes == 4 {
            true -> float32_typed(this, 
                current_value, scan_value, tolerance_bits)
            false -> float64_typed(this, 
                current_value, scan_value, tolerance_bits)
            _ -> float64_typed(this, 
                current_value, scan_value, tolerance_bits)
        }
    }
    state float32_typed(
        this: &ScanCompareTypeImmediate,
        current_value: u64,
        scan_value: u64,
        tolerance_bits: u64
    ) -> bool {
        let hoist5: bool = float_abs_diff_gt_tolerance_f32(
                current_value, scan_value, tolerance_bits);
        let hoist4: bool = float_abs_diff_le_tolerance_f32(
                current_value, scan_value, tolerance_bits);
        transition this {
            ScanCompareTypeImmediate::Equal -> (hoist4)
            ScanCompareTypeImmediate::NotEqual -> (hoist5)
            _ -> float32_ordering(this, current_value, scan_value)
        }
    }
    state float32_ordering(
        this: &ScanCompareTypeImmediate,
        current_value: u64,
        scan_value: u64
    ) -> bool {
        let current: f32 = bits_to_f32(current_value);
        let scan: f32 = bits_to_f32(scan_value);
        transition this {
            ScanCompareTypeImmediate::GreaterThan -> (current > scan)
            ScanCompareTypeImmediate::GreaterThanOrEqual -> (current >= scan)
            ScanCompareTypeImmediate::LessThan -> (current < scan)
            ScanCompareTypeImmediate::LessThanOrEqual -> (current <= scan)
            _ -> (current == scan)
        }
    }
    state float64_typed(
        this: &ScanCompareTypeImmediate,
        current_value: u64,
        scan_value: u64,
        tolerance_bits: u64
    ) -> bool {
        let hoist7: bool = float_abs_diff_gt_tolerance_f64(
                current_value, scan_value, tolerance_bits);
        let hoist6: bool = float_abs_diff_le_tolerance_f64(
                current_value, scan_value, tolerance_bits);
        transition this {
            ScanCompareTypeImmediate::Equal -> (hoist6)
            ScanCompareTypeImmediate::NotEqual -> (hoist7)
            _ -> float64_ordering(this, current_value, scan_value)
        }
    }
    state float64_ordering(
        this: &ScanCompareTypeImmediate,
        current_value: u64,
        scan_value: u64
    ) -> bool {
        let current: f64 = bits_to_f64(current_value);
        let scan: f64 = bits_to_f64(scan_value);
        transition this {
            ScanCompareTypeImmediate::GreaterThan -> (current > scan)
            ScanCompareTypeImmediate::GreaterThanOrEqual -> (current >= scan)
            ScanCompareTypeImmediate::LessThan -> (current < scan)
            ScanCompareTypeImmediate::LessThanOrEqual -> (current <= scan)
            _ -> (current == scan)
        }
    }
}

machine ScanCompareTypeImmediate::compare_signed(
    this: &ScanCompareTypeImmediate,
    current_masked: u64,
    scan_masked: u64,
    element_size_in_bytes: u64
) -> bool {
    let extended_current: u64 =
        sign_extend_u64(current_masked, element_size_in_bytes);
    let extended_scan: u64 =
        sign_extend_u64(scan_masked, element_size_in_bytes);
    let current_less_scan: bool =
        signed_less_u64(extended_current, extended_scan);
    let scan_less_current: bool =
        signed_less_u64(extended_scan, extended_current);
    transition this {
        ScanCompareTypeImmediate::Equal -> (extended_current == extended_scan)
        ScanCompareTypeImmediate::NotEqual -> (extended_current != extended_scan)
        ScanCompareTypeImmediate::GreaterThan -> (scan_less_current)
        ScanCompareTypeImmediate::GreaterThanOrEqual -> (!current_less_scan)
        ScanCompareTypeImmediate::LessThan -> (current_less_scan)
        ScanCompareTypeImmediate::LessThanOrEqual -> (!scan_less_current)
    }
}
