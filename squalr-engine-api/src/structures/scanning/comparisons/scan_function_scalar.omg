module src::structures::scanning::comparisons::scan_function_scalar;

// Port of ScanFunctionScalar's variant set. Upstream wraps a typed closure
// (`Immediate: Fn(*const u8) -> bool`, `RelativeOrDelta: Fn(*const u8, *const u8)
// -> bool`); the closure translation keeps the arity marker and carries the
// captured operand on the constraint instead.
pub data ScanFunctionScalar [copy] {
    case Immediate;
    case RelativeOrDelta;
}
