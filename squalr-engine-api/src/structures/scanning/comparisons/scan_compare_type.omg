module src::structures::scanning::comparisons::scan_compare_type;

use src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use src::structures::scanning::comparisons::scan_compare_type_delta::ScanCompareTypeDelta;
use src::structures::scanning::comparisons::scan_compare_type_immediate::ScanCompareTypeImmediate;
use src::structures::scanning::comparisons::scan_compare_type_relative::ScanCompareTypeRelative;

// Port of ScanCompareType: the comparison selector shared by constraints,
// including `FromStr` for the CLI's "==", "!=", "+x", ... spellings.
pub data ScanCompareType [copy] {
    case Immediate(compare_type: ScanCompareTypeImmediate);
    case Relative(compare_type: ScanCompareTypeRelative);
    case Delta(compare_type: ScanCompareTypeDelta);
}

// The single dispatch upstream reaches through trait-object closures. The
// operand is upstream's constraint `data_value` narrowed to the element width;
// `previous_value` is ignored by immediate compares.
pub machine ScanCompareType::compare(
    scan_compare_type: &ScanCompareType,
    current_value: u64,
    previous_value: u64,
    operand_value: u64
) -> bool {
    transition scan_compare_type {
        ScanCompareType::Immediate { compare_type } -> (
            ScanCompareTypeImmediate::compare(&compare_type, current_value, operand_value)
        )
        ScanCompareType::Relative { compare_type } -> (
            ScanCompareTypeRelative::compare(&compare_type, current_value, previous_value)
        )
        ScanCompareType::Delta { compare_type } -> (
            ScanCompareTypeDelta::compare(&compare_type, current_value, previous_value, operand_value)
        )
    }
}

// The typed dispatch — the port of upstream's per-data-type closure selection
// (`ScalarComparisonsInteger<PrimitiveType>` and its big-endian sibling).
// Element slots and the operand word carry a value's numeric form in their
// low `element_size_in_bytes`, so:
//   * equality is element-width bit equality — identical for signed and
//     unsigned types and for the big-endian variants (upstream's
//     "no endian byte swap required" arm),
//   * ordering is unsigned order on the masked value for unsigned types and
//     sign-extended order for signed types,
//   * delta arithmetic wraps at element width, mirroring upstream's
//     per-primitive Wrapping* / plain operator calls at PrimitiveType width.
// `is_floating_point` selects the float semantics of
// `ScalarComparisonsFloat<PrimitiveType>` — equality tests are tolerance
// comparisons and ordering/delta ops ride real f32/f64 arithmetic on the
// reinterpreted slot bits.
pub machine ScanCompareType::compare_typed(
    scan_compare_type: &ScanCompareType,
    current_value: u64,
    previous_value: u64,
    operand_value: u64,
    is_signed: bool,
    is_floating_point: bool,
    floating_point_tolerance: FloatingPointTolerance,
    element_size_in_bytes: u64
) -> bool {
    transition scan_compare_type {
        ScanCompareType::Immediate { compare_type } -> (
            ScanCompareTypeImmediate::compare_typed(&compare_type, 
                current_value, operand_value, is_signed,
                is_floating_point, floating_point_tolerance,
                element_size_in_bytes)
        )
        ScanCompareType::Relative { compare_type } -> (
            ScanCompareTypeRelative::compare_typed(&compare_type, 
                current_value, previous_value, is_signed,
                is_floating_point, floating_point_tolerance,
                element_size_in_bytes)
        )
        ScanCompareType::Delta { compare_type } -> (
            ScanCompareTypeDelta::compare_typed(&compare_type, 
                current_value, previous_value, operand_value,
                is_signed, is_floating_point, floating_point_tolerance,
                element_size_in_bytes)
        )
    }
}

// Upstream refuses the divide/modulo-by-zero delta constraint at compare
// construction (`delta_value == PrimitiveType::default()` -> `None` from
// `get_compare_divided_by` / `get_compare_modulo_by`), which removes the
// whole scalar function for that constraint.
pub machine ScanCompareType::requires_nonzero_delta(scan_compare_type: &ScanCompareType) -> bool {
    transition scan_compare_type {
        ScanCompareType::Delta { compare_type } -> (
            ScanCompareTypeDelta::requires_nonzero_delta(&compare_type))
        _ -> (false)
    }
}

// Upstream's float DataType table returns `None` for the bitwise delta
// ops (data_type_f32_scalar_comparisons.rs shift/logical arms) — the
// constraint's scalar function is absent for float types on these kinds,
// which is the same plan-level refusal as the integer zero-divisor.
pub machine ScanCompareType::requires_integer_delta(scan_compare_type: &ScanCompareType) -> bool {
    transition scan_compare_type {
        ScanCompareType::Delta { compare_type } -> (
            ScanCompareTypeDelta::requires_integer_delta(&compare_type))
        _ -> (false)
    }
}

// Low `element_size_in_bytes` byte mask — element-width bit identity. Width
// zero or >= 8 yields the full u64 (slots are never wider).
pub machine element_width_mask_u64(element_size_in_bytes: u64) -> u64 {
    transition element_size_in_bytes >= 1 && element_size_in_bytes < 8 {
        true -> narrow(element_size_in_bytes)
        false -> (((0 as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64)
        _ -> (((0 as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64)
    }
    state narrow(element_size_in_bytes: u64) -> u64
        requires element_size_in_bytes >= 1 && element_size_in_bytes < 8
    {
        let bits: u64 = ((element_size_in_bytes as u64 in Wrapping)
            * (8 as u64 in Wrapping)) as u64;
        let full_place: u64 = ((1 as u64 in Wrapping)
            << (bits as u64 in Wrapping)) as u64;
        (((full_place as u64 in Saturating) - (1 as u64 in Saturating)) as u64)
    }
}

// Sign-extend the low `element_size_in_bytes` of `value` across the full u64.
// An already-sign-extended value is left alone (its low `8*size` bits are the
// value either way), so raw-zero-extended and pre-extended slots normalize to
// the same i64 bit pattern.
pub machine sign_extend_u64(value: u64, element_size_in_bytes: u64) -> u64 {
    transition element_size_in_bytes >= 1 && element_size_in_bytes < 8 {
        true -> narrow(value, element_size_in_bytes)
        false -> (value)
        _ -> (value)
    }
    state narrow(value: u64, element_size_in_bytes: u64) -> u64
        requires element_size_in_bytes >= 1 && element_size_in_bytes < 8
    {
        let bits: u64 = ((element_size_in_bytes as u64 in Wrapping)
            * (8 as u64 in Wrapping)) as u64;
        let sign_bit_index: u64 = ((bits as u64 in Saturating)
            - (1 as u64 in Saturating)) as u64;
        let sign_place: u64 = ((1 as u64 in Wrapping)
            << (sign_bit_index as u64 in Wrapping)) as u64;
        let full_place: u64 = ((1 as u64 in Wrapping)
            << (bits as u64 in Wrapping)) as u64;
        transition sign_place <= value && value < full_place {
            true -> (((value as u64 in Wrapping)
                - (full_place as u64 in Wrapping)) as u64)
            false -> (value)
            _ -> (value)
        }
    }
}

// Signed less-than as unsigned less-than: biasing both operands by 2^63
// flips the sign bit, a monotonic map from i64 order onto u64 order.
pub machine signed_less_u64(extended_left: u64, extended_right: u64) -> bool {
    let bias: u64 = ((1 as u64 in Wrapping) << (63 as u64 in Wrapping)) as u64;
    let biased_left: u64 = ((extended_left as u64 in Wrapping)
        + (bias as u64 in Wrapping)) as u64;
    let biased_right: u64 = ((extended_right as u64 in Wrapping)
        + (bias as u64 in Wrapping)) as u64;
    biased_left < biased_right
}

// Wrapping two's-complement negation — `0 - value` mod 2^64.
pub machine negate_wrapping_u64(value: u64) -> u64 {
    (((0 as u64 in Wrapping) - (value as u64 in Wrapping)) as u64)
}

// The typed shift distance — upstream applies `shl`/`shr` at PrimitiveType
// width, which masks the amount to `delta mod (8*element_size)`.
pub machine effective_shift_u64(shift_value: u64, element_size_in_bytes: u64) -> u64 {
    let bits: u64 = ((element_size_in_bytes as u64 in Wrapping)
        * (8 as u64 in Wrapping)) as u64;
    transition bits == 0 {
        true -> (0)
        false -> (((shift_value as u64 in Wrapping)
            % (bits as u64 in Wrapping)) as u64)
        _ -> (0)
    }
}

// Signed truncating division on sign-extended words via magnitudes —
// `sign(a)^sign(b)` scales `|a|/|b|`; division by zero is refused upstream
// at construction, so a zero divisor yields 0 here as the unreachable-safe
// answer.
pub machine signed_divide_u64(dividend_extended: u64, divisor_extended: u64) -> u64 {
    transition divisor_extended == 0 {
        true -> (0)
        false -> gate(dividend_extended, divisor_extended)
        _ -> (0)
    }
    state gate(dividend_extended: u64, divisor_extended: u64) -> u64 {
        let high_bit: u64 = ((1 as u64 in Wrapping)
            << (63 as u64 in Wrapping)) as u64;
        transition dividend_extended >= high_bit {
            true -> dividend_negative(dividend_extended, divisor_extended, high_bit)
            false -> divisor_gate(dividend_extended, divisor_extended, high_bit)
            _ -> divisor_gate(dividend_extended, divisor_extended, high_bit)
        }
    }
    state dividend_negative(
        dividend_extended: u64,
        divisor_extended: u64,
        high_bit: u64
    ) -> u64 {
        let dividend_magnitude: u64 = negate_wrapping_u64(dividend_extended);
        transition divisor_extended >= high_bit {
            true -> emit(dividend_magnitude,
                negate_wrapping_u64(divisor_extended), false)
            false -> emit(dividend_magnitude, divisor_extended, true)
            _ -> emit(dividend_magnitude, divisor_extended, true)
        }
    }
    state divisor_gate(
        dividend_extended: u64,
        divisor_extended: u64,
        high_bit: u64
    ) -> u64 {
        transition divisor_extended >= high_bit {
            true -> emit(dividend_extended,
                negate_wrapping_u64(divisor_extended), true)
            false -> emit(dividend_extended, divisor_extended, false)
            _ -> emit(dividend_extended, divisor_extended, false)
        }
    }
    state emit(
        dividend_magnitude: u64,
        divisor_magnitude: u64,
        negate: bool
    ) -> u64 {
        let quotient: u64 = dividend_magnitude / divisor_magnitude;
        transition negate {
            true -> (negate_wrapping_u64(quotient))
            false -> (quotient)
            _ -> (quotient)
        }
    }
}

// Signed remainder keeps the dividend's sign (Rust `%` truncates toward zero)
// — `sign(a) * (|a| mod |b|)`; a zero divisor yields 0 (refused upstream at
// construction).
pub machine signed_remainder_u64(dividend_extended: u64, divisor_extended: u64) -> u64 {
    transition divisor_extended == 0 {
        true -> (0)
        false -> gate(dividend_extended, divisor_extended)
        _ -> (0)
    }
    state gate(dividend_extended: u64, divisor_extended: u64) -> u64 {
        let high_bit: u64 = ((1 as u64 in Wrapping)
            << (63 as u64 in Wrapping)) as u64;
        let dividend_magnitude: u64 =
            magnitude_of_extended(dividend_extended, high_bit);
        let divisor_magnitude: u64 =
            magnitude_of_extended(divisor_extended, high_bit);
        let remainder: u64 = dividend_magnitude % divisor_magnitude;
        transition dividend_extended >= high_bit {
            true -> (negate_wrapping_u64(remainder))
            false -> (remainder)
            _ -> (remainder)
        }
    }
}

// |x| of a sign-extended word — negate only when the sign bit reads set.
pub machine magnitude_of_extended(extended: u64, high_bit: u64) -> u64 {
    transition extended >= high_bit {
        true -> (negate_wrapping_u64(extended))
        false -> (extended)
        _ -> (extended)
    }
}

// Arithmetic shift right on a sign-extended word — complement before the
// logical shift so sign bits fill from the top; complement again after.
// `shift_amount` is already width-masked by the caller.
pub machine arithmetic_shift_right_u64(value_extended: u64, shift_amount: u64) -> u64 {
    let high_bit: u64 = ((1 as u64 in Wrapping)
        << (63 as u64 in Wrapping)) as u64;
    transition value_extended >= high_bit {
        true -> negative(value_extended, shift_amount)
        false -> (((value_extended as u64 in Wrapping)
            >> (shift_amount as u64 in Wrapping)) as u64)
        _ -> (((value_extended as u64 in Wrapping)
            >> (shift_amount as u64 in Wrapping)) as u64)
    }
    state negative(value_extended: u64, shift_amount: u64) -> u64 {
        let max_u64: u64 = (((0 as u64 in Wrapping)
            - (1 as u64 in Wrapping)) as u64);
        let complemented: u64 = ((max_u64 as u64 in Wrapping)
            ^ (value_extended as u64 in Wrapping)) as u64;
        let shifted: u64 = ((complemented as u64 in Wrapping)
            >> (shift_amount as u64 in Wrapping)) as u64;
        (((max_u64 as u64 in Wrapping)
            ^ (shifted as u64 in Wrapping)) as u64)
    }
}

// Upstream `FromStr`: the parse result, with `Invalid` first so an untouched
// value reads as failure (the OpenResult zero-case convention). Upstream's
// `ParseScanCompareTypeError` is a unit struct whose only payload is the
// Display text "Invalid comparison type"; `Invalid` drops that message —
// named deviation.
pub data ScanCompareTypeParseResult [copy] {
    case Invalid;
    case Parsed(compare_type: ScanCompareType);
}

// Upstream `FromStr::from_str`: only the spelled byte strings "=="/"!="/">"/
// ">="/"<"/"<="/"c"/"u"/"+"/"-"/"+x"/"-x" parse; every other length or byte is
// the `_` refusal. Authored text is a byte domain in Omega, so spellings
// match on byte values ('!' 33, '+' 43, '-' 45, '<' 60, '=' 61, '>' 62,
// 'c' 99, 'u' 117, 'x' 120).
pub machine ScanCompareType::from_str(text: &[u8]) -> ScanCompareTypeParseResult {
    transition text.len > 0 {
        true -> nonempty(text[0], text)
        false -> invalid()
    }
    state nonempty(head: u8, text: &[u8]) -> ScanCompareTypeParseResult {
        transition text.len >= 2 {
            true -> spelled(head, text[1], text)
            false -> single(head)
        }
    }
    state spelled(head: u8, second: u8, text: &[u8]) -> ScanCompareTypeParseResult {
        transition text.len >= 3 {
            true -> invalid()
            false -> double(head, second)
        }
    }
    state single(byte: u8) -> ScanCompareTypeParseResult {
        transition byte {
            62 -> parsed(ScanCompareType::Immediate { compare_type: ScanCompareTypeImmediate::GreaterThan })
            60 -> parsed(ScanCompareType::Immediate { compare_type: ScanCompareTypeImmediate::LessThan })
            99 -> parsed(ScanCompareType::Relative { compare_type: ScanCompareTypeRelative::Changed })
            117 -> parsed(ScanCompareType::Relative { compare_type: ScanCompareTypeRelative::Unchanged })
            43 -> parsed(ScanCompareType::Relative { compare_type: ScanCompareTypeRelative::Increased })
            45 -> parsed(ScanCompareType::Relative { compare_type: ScanCompareTypeRelative::Decreased })
            _ -> invalid()
        }
    }
    state double(first: u8, second: u8) -> ScanCompareTypeParseResult {
        transition first {
            61 -> tail(second, 61, ScanCompareType::Immediate { compare_type: ScanCompareTypeImmediate::Equal })
            33 -> tail(second, 61, ScanCompareType::Immediate { compare_type: ScanCompareTypeImmediate::NotEqual })
            62 -> tail(second, 61, ScanCompareType::Immediate { compare_type: ScanCompareTypeImmediate::GreaterThanOrEqual })
            60 -> tail(second, 61, ScanCompareType::Immediate { compare_type: ScanCompareTypeImmediate::LessThanOrEqual })
            43 -> tail(second, 120, ScanCompareType::Delta { compare_type: ScanCompareTypeDelta::IncreasedByX })
            45 -> tail(second, 120, ScanCompareType::Delta { compare_type: ScanCompareTypeDelta::DecreasedByX })
            _ -> invalid()
        }
    }
    state tail(second: u8, want: u8, matched: ScanCompareType) -> ScanCompareTypeParseResult {
        transition second == want {
            true -> parsed(matched)
            false -> invalid()
        }
    }
    state parsed(compare_type: ScanCompareType) -> ScanCompareTypeParseResult {
        ScanCompareTypeParseResult::Parsed { compare_type: compare_type }
    }
    state invalid() -> ScanCompareTypeParseResult { ScanCompareTypeParseResult::Invalid }
}

// Exercise support: a flat discriminant over the parse result so the
// consistency check can name each expected variant without nested payload
// patterns (unsupported at this pin). Invalid and the eight delta variants
// `from_str` never produces share probe 0; the 12 producible variants are
// numbered in upstream match-arm order.
machine ScanCompareTypeParseResult::variant_probe(scan_compare_type_parse_result: &ScanCompareTypeParseResult) -> u64 {
    transition scan_compare_type_parse_result {
        ScanCompareTypeParseResult::Invalid -> (0)
        ScanCompareTypeParseResult::Parsed { compare_type } -> outer(compare_type)
    }
    state outer(compare_type: ScanCompareType) -> u64 {
        transition compare_type {
            ScanCompareType::Immediate { compare_type } -> immediate(compare_type)
            ScanCompareType::Relative { compare_type } -> relative(compare_type)
            ScanCompareType::Delta { compare_type } -> delta(compare_type)
        }
    }
    state immediate(inner: ScanCompareTypeImmediate) -> u64 {
        transition inner {
            ScanCompareTypeImmediate::Equal -> (1)
            ScanCompareTypeImmediate::NotEqual -> (2)
            ScanCompareTypeImmediate::GreaterThan -> (3)
            ScanCompareTypeImmediate::GreaterThanOrEqual -> (4)
            ScanCompareTypeImmediate::LessThan -> (5)
            ScanCompareTypeImmediate::LessThanOrEqual -> (6)
        }
    }
    state relative(inner: ScanCompareTypeRelative) -> u64 {
        transition inner {
            ScanCompareTypeRelative::Changed -> (7)
            ScanCompareTypeRelative::Unchanged -> (8)
            ScanCompareTypeRelative::Increased -> (9)
            ScanCompareTypeRelative::Decreased -> (10)
        }
    }
    state delta(inner: ScanCompareTypeDelta) -> u64 {
        transition inner {
            ScanCompareTypeDelta::IncreasedByX -> (11)
            ScanCompareTypeDelta::DecreasedByX -> (12)
            _ -> (0)
        }
    }
}

// In-package exercise: every spelled byte string parses to its variant and
// each refusal shape (unknown head byte, wrong tail byte, wrong length)
// returns Invalid. Checked here because `&`-receiver calls on byte slices do
// not cross the package boundary under selected ProgramEntry establishment,
// so squalr-tests cannot host this yet — same edge the alignment exercise
// names.

// Probes the variant index `text` parses to — binds the by-value parse
// result so the `&`-receiver probe machine has a place to read.
machine ScanCompareType::probe_variant(text: &[u8], expected: u64) -> bool {
    let parsed: ScanCompareTypeParseResult = ScanCompareType::from_str(text);
    ScanCompareTypeParseResult::variant_probe(&parsed) == expected
}

pub machine ScanCompareType::from_str_consistent() -> bool {
    let eq: [u8; 2] = [61, 61];
    let not_eq: [u8; 2] = [33, 61];
    let gt: [u8; 1] = [62];
    let gte: [u8; 2] = [62, 61];
    let lt: [u8; 1] = [60];
    let lte: [u8; 2] = [60, 61];
    let changed: [u8; 1] = [99];
    let unchanged: [u8; 1] = [117];
    let increased: [u8; 1] = [43];
    let decreased: [u8; 1] = [45];
    let increased_by: [u8; 2] = [43, 120];
    let decreased_by: [u8; 2] = [45, 120];
    let bad_head: [u8; 1] = [122];
    let bad_tail: [u8; 2] = [61, 120];
    let bad_length: [u8; 3] = [61, 61, 61];
    ScanCompareType::probe_variant(&eq, 1) &&
    ScanCompareType::probe_variant(&not_eq, 2) &&
    ScanCompareType::probe_variant(&gt, 3) &&
    ScanCompareType::probe_variant(&gte, 4) &&
    ScanCompareType::probe_variant(&lt, 5) &&
    ScanCompareType::probe_variant(&lte, 6) &&
    ScanCompareType::probe_variant(&changed, 7) &&
    ScanCompareType::probe_variant(&unchanged, 8) &&
    ScanCompareType::probe_variant(&increased, 9) &&
    ScanCompareType::probe_variant(&decreased, 10) &&
    ScanCompareType::probe_variant(&increased_by, 11) &&
    ScanCompareType::probe_variant(&decreased_by, 12) &&
    ScanCompareType::probe_variant(&bad_head, 0) &&
    ScanCompareType::probe_variant(&bad_tail, 0) &&
    ScanCompareType::probe_variant(&bad_length, 0)
}

// Float legs of the typed dispatch — the port of
// `ScalarComparisonsFloat<PrimitiveType>`. Element slots carry the raw IEEE
// bit pattern in their low `element_size_in_bytes`, so the compares decode
// to real f32/f64 and run upstream's operators natively: float equality is
// `|current - operand| <= tolerance`, relative ordering is PartialOrd
// (NaN misses like upstream), and delta targets evaluate the operator on
// the previous value. `%` has no float form — `float_mod_*` reproduces
// `std`'s `a % b = a - trunc(a / b) * b` through a saturating trunc cast
// (named deviation: |a / b| >= 2^63 saturates to i64::MIN/MAX where upstream
// keeps the finite quotient; a miss in either form only narrows matches).

// Reinterpret a slot's low 32 bits as f32 — the inverse of upstream's
// `&left as &u32` bit pattern convention.
pub machine bits_to_f32(slot: u64) -> f32 {
    let narrowed: u32 = (slot as u32 in Wrapping) as u32;
    ((&narrowed) as &f32)
}

// Reinterpret a slot as f64.
pub machine bits_to_f64(slot: u64) -> f64 {
    ((&slot) as &f64)
}

// Upstream `.abs()` on the difference — manual to keep the float path
// primitive (the standard absolute value rides FloatMeaning carriers).
pub machine float_abs_f32(difference: f32) -> f32 {
    transition difference < 0.0 {
        true -> (0.0 - difference)
        false -> (difference)
        _ -> (difference)
    }
}

pub machine float_abs_f64(difference: f64) -> f64 {
    transition difference < 0.0 {
        true -> (0.0 - difference)
        false -> (difference)
        _ -> (difference)
    }
}

// Upstream `a % b` on floats = a - trunc(a / b) * b. The trunc cast uses
// the saturating mode — Rust's `as` semantics (NaN -> 0, clamp out of
// range), which upstream would panic-free evaluate the same way.
pub machine float_mod_f32(dividend: f32, divisor: f32) -> f32 {
    let quotient: f32 = dividend / divisor;
    let truncated: i64 = (quotient as i64 in Saturating) as i64;
    let scaled: f32 = ((truncated as f32) as f32) * divisor;
    (dividend - scaled)
}

pub machine float_mod_f64(dividend: f64, divisor: f64) -> f64 {
    let quotient: f64 = dividend / divisor;
    let truncated: i64 = (quotient as i64 in Saturating) as i64;
    let scaled: f64 = ((truncated as f64) as f64) * divisor;
    (dividend - scaled)
}

// Decode the slot and the tolerance word into the element's float width —
// `element_size_in_bytes == 4` picks f32, anything else f64 (the element
// dispatch only calls these on a real floating-point plan).
pub machine float_abs_diff_le_tolerance_f32(
    current_value: u64,
    target_bits: u64,
    tolerance_bits: u64
) -> bool {
    let current: f32 = bits_to_f32(current_value);
    let target: f32 = bits_to_f32(target_bits);
    let tolerance: f32 = bits_to_f32(tolerance_bits);
    (float_abs_f32(current - target) <= tolerance)
}

pub machine float_abs_diff_le_tolerance_f64(
    current_value: u64,
    target_bits: u64,
    tolerance_bits: u64
) -> bool {
    let current: f64 = bits_to_f64(current_value);
    let target: f64 = bits_to_f64(target_bits);
    let tolerance: f64 = bits_to_f64(tolerance_bits);
    (float_abs_f64(current - target) <= tolerance)
}

// The strict side of the tolerance compare — upstream NotEqual is
// `(current - scan).abs() > tolerance`, which is false on a NaN difference;
// negating the <= form would turn NaN into a match.
pub machine float_abs_diff_gt_tolerance_f32(
    current_value: u64,
    target_bits: u64,
    tolerance_bits: u64
) -> bool {
    let current: f32 = bits_to_f32(current_value);
    let target: f32 = bits_to_f32(target_bits);
    let tolerance: f32 = bits_to_f32(tolerance_bits);
    (float_abs_f32(current - target) > tolerance)
}

pub machine float_abs_diff_gt_tolerance_f64(
    current_value: u64,
    target_bits: u64,
    tolerance_bits: u64
) -> bool {
    let current: f64 = bits_to_f64(current_value);
    let target: f64 = bits_to_f64(target_bits);
    let tolerance: f64 = bits_to_f64(tolerance_bits);
    (float_abs_f64(current - target) > tolerance)
}

// Re-encode a computed float target back into the slot's bit convention —
// the inverse of `bits_to_f32`/`bits_to_f64` (upstream's `as &u32` reads).
pub machine f32_to_bits(value: f32) -> u64 {
    let narrowed: u32 = ((&value) as &u32);
    ((narrowed as u64) as u64)
}

pub machine f64_to_bits(value: f64) -> u64 {
    ((&value) as &u64)
}
