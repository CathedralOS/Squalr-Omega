module src::structures::scanning::plans::plan_types::planned_scan_type_vector;

// Port of PlannedScanTypeVector: vectorized scan families. Their scanners are
// unported (SIMD leg of the port plan); the variants exist so planned types
// stay faithful to upstream.
pub data PlannedScanTypeVector [copy] {
    case Overlapping;
    case Aligned;
    case Sparse;
    case OverlappingBytewiseStaggered;
    case OverlappingBytewisePeriodic;
}
