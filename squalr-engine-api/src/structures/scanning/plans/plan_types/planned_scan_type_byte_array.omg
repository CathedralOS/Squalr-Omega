module src::structures::scanning::plans::plan_types::planned_scan_type_byte_array;

// Port of PlannedScanTypeByteArray: the Boyer-Moore byte-pattern scanners.
// Their implementations are a separate leg; the variants exist so planned
// types stay faithful to upstream.
pub data PlannedScanTypeByteArray [copy] {
    case ByteArrayBooyerMoore;
    case ByteArrayBooyerMooreMasked;
}
