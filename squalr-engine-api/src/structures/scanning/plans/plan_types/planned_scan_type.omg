use src/structures/scanning/plans/plan_types/planned_scan_type_byte_array.omg;
use src/structures/scanning/plans/plan_types/planned_scan_type_scalar.omg;
use src/structures/scanning/plans/plan_types/planned_scan_type_vector.omg;
use src/structures/scanning/plans/plan_types/planned_scan_vectorization_size.omg;

// Port of PlannedScanType: the scan implementation a finalized plan selects.
public data PlannedScanType [copy] {
    case Invalid;
    case Scalar(scan_type: |planned_scan_type_scalar|::PlannedScanTypeScalar);
    case Vector(scan_type: |planned_scan_type_vector|::PlannedScanTypeVector, vectorization_size: |planned_scan_vectorization_size|::PlannedScanVectorizationSize);
    case ByteArray(scan_type: |planned_scan_type_byte_array|::PlannedScanTypeByteArray);
}
