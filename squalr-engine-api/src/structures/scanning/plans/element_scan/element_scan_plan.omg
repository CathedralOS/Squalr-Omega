module src::structures::scanning::plans::element_scan::element_scan_plan;

use omega::language::core::option;
use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use src::structures::scanning::constraints::scan_constraint_finalized::ScanConstraintFinalized;
use src::structures::scanning::memory_read_mode::MemoryReadMode;
use src::structures::memory::memory_alignment::MemoryAlignment;

// Port of the one HashMap value in ElementScanPlan's map: a data type with
// its finalized constraint list. Upstream HashMap<DataTypeRef, Vec<...>> is
// keyed lookup; Omega carries an extent of these entries keyed by `equals`.
pub data DataTypeScanConstraints<'type_id, 'bytes, 'mask, 'cons> {
    data_type_ref: DataTypeRef<'type_id>;
    constraints: &'cons mut [ScanConstraintFinalized<'type_id, 'bytes, 'mask>];
    constraint_count: u64;
}

pub machine DataTypeScanConstraints::get_data_type_ref<'type_id, 'bytes, 'mask, 'cons>(&self) -> &DataTypeRef {
    &self.data_type_ref
}

pub machine DataTypeScanConstraints::get_constraint_count<'type_id, 'bytes, 'mask, 'cons>(&self) -> u64 {
    (self.constraint_count)
}

pub machine DataTypeScanConstraints::get_constraints<'type_id, 'bytes, 'mask, 'cons>(
    &self
) -> &[ScanConstraintFinalized<'type_id, 'bytes, 'mask>] {
    (self.constraints)
}

// Port of ElementScanPlan. The scan-constraints map flattens to a
// caller-supplied extent of DataTypeScanConstraints plus a live count;
// `get_scan_constraints_by_data_type` resolves by sequential `equals` match,
// returning the matching index rather than an Option reference so callers can
// index the extent themselves.
pub data ElementScanPlan<'type_id, 'bytes, 'mask, 'cons, 'sets> {
    scan_constraints_by_data_type: &'sets mut [DataTypeScanConstraints<'type_id, 'bytes, 'mask, 'cons>];
    constraint_set_count: u64;
    memory_alignment: MemoryAlignment;
    floating_point_tolerance: FloatingPointTolerance;
    memory_read_mode: MemoryReadMode;
    is_single_thread_scan: bool;
    debug_perform_validation_scan: bool;
}

pub machine ElementScanPlan::new<'type_id, 'bytes, 'mask, 'cons, 'sets>(
    scan_constraints_by_data_type: &'sets mut [DataTypeScanConstraints<'type_id, 'bytes, 'mask, 'cons>],
    constraint_set_count: u64,
    memory_alignment: MemoryAlignment,
    floating_point_tolerance: FloatingPointTolerance,
    memory_read_mode: MemoryReadMode,
    is_single_thread_scan: bool,
    debug_perform_validation_scan: bool
) -> ElementScanPlan<'type_id, 'bytes, 'mask, 'cons, 'sets> {
    (ElementScanPlan {
        scan_constraints_by_data_type: scan_constraints_by_data_type,
        constraint_set_count: constraint_set_count,
        memory_alignment: memory_alignment,
        floating_point_tolerance: floating_point_tolerance,
        memory_read_mode: memory_read_mode,
        is_single_thread_scan: is_single_thread_scan,
        debug_perform_validation_scan: debug_perform_validation_scan,
    })
}

pub machine ElementScanPlan::get_constraint_set_count(&self) -> u64 {
    self.constraint_set_count
}

// Index of the constraint set keyed by the given data type, or None; callers
// then use `get_constraint_set_at` to read or mutate the set.
// DEVIATION (language): Optional<u64> cannot be destructured by callers (the
// Optional payload scrutinee fails to type), so the hit arrives as IndexSlot.
pub data IndexSlot [copy] {
    case Found(index: u64);
    case Missing;
}

pub machine ElementScanPlan::find_constraint_set_index(&self, data_type: &DataTypeRef) -> IndexSlot {
    transition self.constraint_set_count > 0 {
        true -> scan(self.scan_constraints_by_data_type, 0, data_type)
        _ -> (Optional::None)
    }
    state scan(
        &self,
        sets: &[DataTypeScanConstraints<'type_id, 'bytes, 'mask, 'cons>],
        set_index: u64,
        data_type: &DataTypeRef
    ) -> IndexSlot {
        transition set_index < self.constraint_set_count {
            true -> check_set(sets, set_index, data_type)
            _ -> (Optional::None)
        }
    }
    state check_set(
        &self,
        sets: &[DataTypeScanConstraints<'type_id, 'bytes, 'mask, 'cons>],
        set_index: u64,
        data_type: &DataTypeRef
    ) -> IndexSlot {
        transition set_index < sets.len {
            true -> matched(sets, set_index, data_type)
            _ -> (Optional::None)
        }
    }
    state matched(
        &self,
        sets: &[DataTypeScanConstraints<'type_id, 'bytes, 'mask, 'cons>],
        set_index: u64 [0..sets.len],
        data_type: &DataTypeRef
    ) -> IndexSlot {
        transition sets[set_index].data_type_ref.equals(data_type) {
            true -> (Optional::Some { value: set_index as u64 })
            _ -> scan_next(sets, set_index, data_type)
        }
    }
    state scan_next(
        &self,
        sets: &[DataTypeScanConstraints<'type_id, 'bytes, 'mask, 'cons>],
        set_index: u64,
        data_type: &DataTypeRef
    ) -> IndexSlot {
        let next_index: u64 = ((set_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        scan(sets, next_index, data_type)
    }
}

// Read access to a constraint set by index (as returned by
// find_constraint_set_index).
// DEVIATION (language): same Optional scrutinee failure; the set slot is
// returned as ConstraintSetSlot instead of Option<&_>.
pub data ConstraintSetSlot<'s, 'type_id, 'bytes, 'mask, 'cons> {
    case Present(set: &'s DataTypeScanConstraints<'type_id, 'bytes, 'mask, 'cons>);
    case Missing;
}

pub machine ElementScanPlan::get_constraint_set_at<'type_id, 'bytes, 'mask, 'cons>(&self, set_index: u64) -> ConstraintSetSlot<'cons, 'type_id, 'bytes, 'mask, 'cons> {
    transition set_index < self.constraint_set_count && set_index < self.scan_constraints_by_data_type.len {
        true -> some(self.scan_constraints_by_data_type, set_index)
        _ -> (ConstraintSetSlot::Missing)
    }
    state some(
        &self,
        sets: &'cons [DataTypeScanConstraints<'type_id, 'bytes, 'mask, 'cons>],
        set_index: u64 [0..sets.len]
    ) -> ConstraintSetSlot<'cons, 'type_id, 'bytes, 'mask, 'cons> {
        (ConstraintSetSlot::Present { set: &sets[set_index] })
    }
}

pub machine ElementScanPlan::get_memory_alignment(&self) -> MemoryAlignment {
    self.memory_alignment
}

pub machine ElementScanPlan::get_floating_point_tolerance(&self) -> FloatingPointTolerance {
    self.floating_point_tolerance
}

pub machine ElementScanPlan::get_memory_read_mode(&self) -> MemoryReadMode {
    self.memory_read_mode
}

pub machine ElementScanPlan::get_is_single_thread_scan(&self) -> bool {
    self.is_single_thread_scan
}

pub machine ElementScanPlan::get_debug_perform_validation_scan(&self) -> bool {
    self.debug_perform_validation_scan
}
