module src::structures::scanning::plans::element_scan::element_scan_plan;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::scanning::constraints::scan_constraint_finalized::ScanConstraintFinalized;

// Port of structures/scanning/plans/element_scan/element_scan_plan.rs,
// scalar leg. Upstream stores `HashMap<DataTypeRef, Vec<ScanConstraintFinalized>>`
// keyed by data type; Omega has no growable map yet, so the same association
// lands as a caller-lent `data_type_refs` list plus a flat
// `scan_constraints` list where each finalized constraint carries its own
// DataTypeRef (the upstream map's Vec order is preserved by list position).
// `get_data_type_refs_iterator` becomes the distinct-types view; constraint
// lookup by type is an equality scan rather than a hash probe.
//
// Upstream also carries `floating_point_tolerance` and `memory_read_mode`;
// both are deferred to their own legs (floating compares and the memory-read
// path the fixture does not exercise).
pub data ElementScanPlan<'d, 'c> {
    data_type_refs: &'d [DataTypeRef<'d>];
    scan_constraints: &'c [ScanConstraintFinalized<'c>];
    memory_alignment: MemoryAlignment;
    is_single_thread_scan: bool;
    debug_perform_validation_scan: bool;
}

pub machine ElementScanPlan::new<'d, 'c>(
    data_type_refs: &'d [DataTypeRef<'d>],
    scan_constraints: &'c [ScanConstraintFinalized<'c>],
    memory_alignment: MemoryAlignment,
    is_single_thread_scan: bool,
    debug_perform_validation_scan: bool
) -> ElementScanPlan<'d, 'c> {
    ElementScanPlan {
        data_type_refs: data_type_refs,
        scan_constraints: scan_constraints,
        memory_alignment: memory_alignment,
        is_single_thread_scan: is_single_thread_scan,
        debug_perform_validation_scan: debug_perform_validation_scan,
    }
}

// Upstream `get_scan_constraints_by_data_type(...).get(data_type_ref)`:
// the matching constraint count for this data type (upstream's Vec length).
// The dispatcher then pulls each match by ordinal via `constraint_index_for`.
pub machine ElementScanPlan::count_constraints_for<'c>(
    &self,
    data_type: &DataTypeRef<'c>
) -> u64 {
    ElementScanPlan::count_matching(self.scan_constraints, data_type, 0, 0)
}

machine ElementScanPlan::count_matching<'c>(
    constraints: &'c [ScanConstraintFinalized<'c>],
    data_type: &DataTypeRef<'c>,
    index: u64,
    found: u64
) -> u64 {
    transition index < constraints.len {
        true -> probe(constraints, data_type, index, found)
        false -> (found)
        _ -> (found)
    }

    state probe(
        constraints: &'c [ScanConstraintFinalized<'c>],
        data_type: &DataTypeRef<'c>,
        index: u64,
        found: u64
    ) -> u64 {
        let entry: ScanConstraintFinalized<'c> = ElementScanPlan::constraint_at(constraints, index);
        let entry_type: DataTypeRef<'c> = entry.get_data_type_ref();
        transition entry_type.equals(data_type) {
            true -> bump(constraints, data_type, index, found)
            false -> ElementScanPlan::count_matching(constraints, data_type, ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64, found)
            _ -> ElementScanPlan::count_matching(constraints, data_type, ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64, found)
        }
    }

    state bump(
        constraints: &'c [ScanConstraintFinalized<'c>],
        data_type: &DataTypeRef<'c>,
        index: u64,
        found: u64
    ) -> u64 {
        ElementScanPlan::count_matching(
            constraints,
            data_type,
            ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            ((found as u64 in Saturating) + (1 as u64 in Saturating)) as u64
        )
    }
}

// Position of the `nth` (0-based) constraint matching `data_type` — the
// upstream map's Vec indexing. Callers guard with `count_constraints_for`.
pub machine ElementScanPlan::constraint_index_for<'c>(
    &self,
    data_type: &DataTypeRef<'c>,
    nth: u64
) -> u64 {
    ElementScanPlan::find_matching(self.scan_constraints, data_type, nth, 0, 0)
}

machine ElementScanPlan::find_matching<'c>(
    constraints: &'c [ScanConstraintFinalized<'c>],
    data_type: &DataTypeRef<'c>,
    nth: u64,
    index: u64,
    found: u64
) -> u64 {
    transition index < constraints.len {
        true -> probe(constraints, data_type, nth, index, found)
        false -> (0)
        _ -> (0)
    }

    state probe(
        constraints: &'c [ScanConstraintFinalized<'c>],
        data_type: &DataTypeRef<'c>,
        nth: u64,
        index: u64,
        found: u64
    ) -> u64 {
        let entry: ScanConstraintFinalized<'c> = ElementScanPlan::constraint_at(constraints, index);
        let entry_type: DataTypeRef<'c> = entry.get_data_type_ref();
        transition entry_type.equals(data_type) {
            true -> counted(constraints, data_type, nth, index, found)
            false -> ElementScanPlan::find_matching(constraints, data_type, nth, ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64, found)
            _ -> ElementScanPlan::find_matching(constraints, data_type, nth, ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64, found)
        }
    }

    state counted(
        constraints: &'c [ScanConstraintFinalized<'c>],
        data_type: &DataTypeRef<'c>,
        nth: u64,
        index: u64,
        found: u64
    ) -> u64 {
        transition found == nth {
            true -> (index)
            false -> ElementScanPlan::find_matching(constraints, data_type, nth, ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64, ((found as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
            _ -> ElementScanPlan::find_matching(constraints, data_type, nth, ((index as u64 in Saturating) + (1 as u64 in Saturating)) as u64, ((found as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
        }
    }
}

// Element read of a finalized constraint as a rebuilt value (the record is
// not [copy] — DataTypeRef holds a borrow — so index access rebuilds through
// the borrowed element, same as the region clone pattern).
pub machine ElementScanPlan::constraint_at<'c>(
    constraints: &'c [ScanConstraintFinalized<'c>],
    index: u64
) -> ScanConstraintFinalized<'c>
requires index < constraints.len
{
    let entry: &'c ScanConstraintFinalized<'c> = &constraints[index];
    ScanConstraintFinalized {
        scan_constraint: entry.get_scan_constraint(),
        periodicity: entry.get_periodicity(),
        unit_size_in_bytes: entry.get_unit_size_in_bytes(),
        has_scan_function_scalar: entry.has_scan_function_scalar(),
        scan_function_scalar: entry.get_scan_function_scalar(),
    }
}

// Upstream `get_data_type_refs_iterator`.
pub machine ElementScanPlan::get_data_type_refs<'d>(&self) -> &'d [DataTypeRef<'d>] {
    self.data_type_refs
}

pub machine ElementScanPlan::get_memory_alignment(&self) -> MemoryAlignment {
    self.memory_alignment
}

pub machine ElementScanPlan::get_is_single_thread_scan(&self) -> bool {
    self.is_single_thread_scan
}

pub machine ElementScanPlan::get_debug_perform_validation_scan(&self) -> bool {
    self.debug_perform_validation_scan
}
