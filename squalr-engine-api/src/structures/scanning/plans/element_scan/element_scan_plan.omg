module src::structures::scanning::plans::element_scan::element_scan_plan;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use src::structures::scanning::comparisons::scan_compare_type_immediate::ScanCompareTypeImmediate;
use src::structures::data_values::container_type::ContainerType;
use src::structures::scanning::comparisons::scan_function_scalar::ScanFunctionScalar;
use src::structures::scanning::memory_read_mode::MemoryReadMode;
use src::structures::scanning::plans::plan_types::planned_scan_type::PlannedScanType;
use src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use src::structures::snapshots::snapshot_region::DataTypeRefSet;

// Port of structures/scanning/plans/element_scan/element_scan_plan.rs, scalar
// leg: the finalized plan set the element scan executor builds by
// deanonymizing anonymous constraints per data type. Upstream keeps
// `HashMap<DataTypeRef, Vec<ScanConstraintFinalized>>`; the port keeps the
// same shape as a bounded per-type plan list (MAX_TYPES = 4 types, up to 4
// constraints each — a named deviation; the CLI surface accepts more
// spellings but truncates).
//
// Upstream also carries `floating_point_tolerance` — deferred to its own
// board leg (a carrier field upstream; no comparator consumes it).
pub data TypePlanList {
    plans: [SnapshotFilterElementScanPlan; 4];
    plan_count: u64;
}

pub data ElementScanPlan {
    data_type_refs: DataTypeRefSet;
    plan_lists: [TypePlanList; 4];
    memory_alignment: MemoryAlignment;
    memory_read_mode: MemoryReadMode;
    is_single_threaded_scan: bool;
    debug_perform_validation_scan: bool;
}

pub machine TypePlanList::empty() -> TypePlanList {
    TypePlanList { plan_count: 0 }
}

pub machine TypePlanList::clear(type_plan_list: &mut TypePlanList) {
    type_plan_list.plan_count = 0;
}

pub machine TypePlanList::push(type_plan_list: &mut TypePlanList, plan: &SnapshotFilterElementScanPlan) -> bool {
    transition type_plan_list.plan_count < 4 {
        true -> store(type_plan_list, plan)
        false -> (false)
    }
    state store(type_plan_list: &mut TypePlanList, plan: &SnapshotFilterElementScanPlan) -> bool {
        SnapshotFilterElementScanPlan::clone_from(&mut type_plan_list.plans[type_plan_list.plan_count], plan);
        type_plan_list.plan_count = type_plan_list.plan_count + 1;
        true
    }
}

pub machine TypePlanList::get_plan_count(type_plan_list: &TypePlanList) -> u64 {
    type_plan_list.plan_count
}

// Fixture-side companion of `insert_profiled`: installs the finalized plan
// in place on the stored member slot — a plan cannot be constructed in the
// caller frame and handed in.
pub machine TypePlanList::install_profiled(
    type_plan_list: &mut TypePlanList,
    scan_compare_type: ScanCompareType,
    operand_value: u64,
    unit_size_in_bytes: u64,
    has_scan_function_scalar: bool,
    scan_function_scalar: ScanFunctionScalar,
    memory_alignment: MemoryAlignment,
    periodicity: u64,
    is_floating_point: bool,
    is_signed: bool,
    prefer_type_scanner: bool,
    floating_point_tolerance: FloatingPointTolerance,
    has_mask: bool,
    mask_value: u64,
    result_container_type: ContainerType,
    planned_scan_type: PlannedScanType
) {
    type_plan_list.plan_count = 1;
    SnapshotFilterElementScanPlan::set_scan_descriptor(&mut type_plan_list.plans[0], 
        scan_compare_type, operand_value, unit_size_in_bytes,
        has_scan_function_scalar, scan_function_scalar, memory_alignment);
    SnapshotFilterElementScanPlan::set_scan_profile(&mut type_plan_list.plans[0], 
        periodicity, is_floating_point, is_signed, prefer_type_scanner,
        floating_point_tolerance, has_mask, mask_value,
        result_container_type);
    SnapshotFilterElementScanPlan::set_planned_scan_type(&mut type_plan_list.plans[0], planned_scan_type);
}

pub machine TypePlanList::get_plan(type_plan_list: &TypePlanList, plan_index: u64) -> SnapshotFilterElementScanPlan {
    transition plan_index < type_plan_list.plan_count && plan_index < 4 {
        true -> found(type_plan_list, plan_index)
        false -> (SnapshotFilterElementScanPlan::new(
            ScanCompareType::Immediate { compare_type: ScanCompareTypeImmediate::Equal },
            0, 0, false, ScanFunctionScalar::Immediate, MemoryAlignment::Alignment1))
    }
    state found(type_plan_list: &TypePlanList, plan_index: u64) -> SnapshotFilterElementScanPlan
        requires 0 <= plan_index && plan_index < 4
    {
        SnapshotFilterElementScanPlan::clone(&type_plan_list.plans[plan_index])
    }
}

pub machine TypePlanList::clone_from(type_plan_list: &mut TypePlanList, source: &TypePlanList) {
    type_plan_list.plan_count = source.plan_count;
    transition { _ -> copy(type_plan_list, source, 0) }
    state copy(type_plan_list: &mut TypePlanList, source: &TypePlanList, position: u64) {
        transition position < source.plan_count && position < 4 {
            true -> store(type_plan_list, source, position)
            false -> done(type_plan_list)
        }
    }
    state store(type_plan_list: &mut TypePlanList, source: &TypePlanList, position: u64)
        requires 0 <= position && position < 4
    {
        SnapshotFilterElementScanPlan::clone_from(&mut type_plan_list.plans[position], &source.plans[position]);
        transition { _ -> copy(type_plan_list, source, position + 1) }
    }
    state done(type_plan_list: &mut TypePlanList) {
        type_plan_list.plan_count = type_plan_list.plan_count;
    }
}

pub machine TypePlanList::clone(source: &TypePlanList) -> TypePlanList {
    let mut copy: TypePlanList = TypePlanList::empty();
    TypePlanList::clone_from(&mut copy, source);
    copy
}

// Upstream `ElementScanPlan::new` defaults; the executor fills plan lists per
// deanonymized type afterwards.
pub machine ElementScanPlan::new(
    memory_alignment: MemoryAlignment,
    memory_read_mode: MemoryReadMode,
    is_single_threaded_scan: bool,
    debug_perform_validation_scan: bool
) -> ElementScanPlan {
    // Zero-init covers `plan_lists` — equal to TypePlanList::empty() slots.
    ElementScanPlan {
        data_type_refs: DataTypeRefSet::empty(),
        memory_alignment: memory_alignment,
        memory_read_mode: memory_read_mode,
        is_single_threaded_scan: is_single_threaded_scan,
        debug_perform_validation_scan: debug_perform_validation_scan,
    }
}

// Append one data type with its finalized plan list — upstream's
// `scan_constraints_by_data_type.insert(data_type_ref, constraints)`.
pub machine ElementScanPlan::push_type_plans(
    element_scan_plan: &mut ElementScanPlan,
    data_type_ref: &DataTypeRef,
    plan_list: &TypePlanList
) -> bool {
    transition element_scan_plan.data_type_refs.count < 4 {
        true -> store(element_scan_plan, data_type_ref, plan_list)
        false -> (false)
    }
    state store(element_scan_plan: &mut ElementScanPlan, data_type_ref: &DataTypeRef, plan_list: &TypePlanList) -> bool {
        let pushed: bool = DataTypeRefSet::push(&mut element_scan_plan.data_type_refs, data_type_ref);
        let last: u64 = ((element_scan_plan.data_type_refs.count as u64 in Wrapping) - 1) as u64;
        transition pushed && last < 4 {
            true -> install(element_scan_plan, last, plan_list)
            false -> (pushed)
            _ -> (pushed)
        }
    }
    state install(element_scan_plan: &mut ElementScanPlan, last: u64, plan_list: &TypePlanList) -> bool
        requires 0 <= last && last < 4
    {
        TypePlanList::clone_from(&mut element_scan_plan.plan_lists[last], plan_list);
        true
    }
}

// Upstream `scan_constraints_by_data_type.insert` with a one-plan list —
// the fixture-side adapter: a plan cannot be built in the caller frame and
// handed in (its binding is not checked-structural), so the descriptor and
// profile install onto the stored member place here instead.
pub machine ElementScanPlan::insert_profiled(
    element_scan_plan: &mut ElementScanPlan,
    data_type_ref: &DataTypeRef,
    scan_compare_type: ScanCompareType,
    operand_value: u64,
    unit_size_in_bytes: u64,
    has_scan_function_scalar: bool,
    scan_function_scalar: ScanFunctionScalar,
    memory_alignment: MemoryAlignment,
    periodicity: u64,
    is_floating_point: bool,
    is_signed: bool,
    prefer_type_scanner: bool,
    floating_point_tolerance: FloatingPointTolerance,
    has_mask: bool,
    mask_value: u64,
    result_container_type: ContainerType,
    planned_scan_type: PlannedScanType
) -> bool {
    transition element_scan_plan.data_type_refs.count < 4 {
        true -> store(element_scan_plan, 
            data_type_ref, scan_compare_type, operand_value, unit_size_in_bytes,
            has_scan_function_scalar, scan_function_scalar, memory_alignment,
            periodicity, is_floating_point, is_signed, prefer_type_scanner,
            floating_point_tolerance, has_mask, mask_value,
            result_container_type, planned_scan_type)
        false -> (false)
    }
    state store(
        element_scan_plan: &mut ElementScanPlan,
        data_type_ref: &DataTypeRef,
        scan_compare_type: ScanCompareType,
        operand_value: u64,
        unit_size_in_bytes: u64,
        has_scan_function_scalar: bool,
        scan_function_scalar: ScanFunctionScalar,
        memory_alignment: MemoryAlignment,
        periodicity: u64,
        is_floating_point: bool,
        is_signed: bool,
        prefer_type_scanner: bool,
        floating_point_tolerance: FloatingPointTolerance,
        has_mask: bool,
        mask_value: u64,
        result_container_type: ContainerType,
        planned_scan_type: PlannedScanType
    ) -> bool {
        let pushed: bool = DataTypeRefSet::push(&mut element_scan_plan.data_type_refs, data_type_ref);
        let last: u64 = ((element_scan_plan.data_type_refs.count as u64 in Wrapping) - 1) as u64;
        transition pushed && last < 4 {
            true -> install(element_scan_plan, 
                last, scan_compare_type, operand_value, unit_size_in_bytes,
                has_scan_function_scalar, scan_function_scalar, memory_alignment,
                periodicity, is_floating_point, is_signed, prefer_type_scanner,
                floating_point_tolerance, has_mask, mask_value,
                result_container_type, planned_scan_type)
            false -> (pushed)
            _ -> (pushed)
        }
    }
    state install(
        element_scan_plan: &mut ElementScanPlan,
        last: u64,
        scan_compare_type: ScanCompareType,
        operand_value: u64,
        unit_size_in_bytes: u64,
        has_scan_function_scalar: bool,
        scan_function_scalar: ScanFunctionScalar,
        memory_alignment: MemoryAlignment,
        periodicity: u64,
        is_floating_point: bool,
        is_signed: bool,
        prefer_type_scanner: bool,
        floating_point_tolerance: FloatingPointTolerance,
        has_mask: bool,
        mask_value: u64,
        result_container_type: ContainerType,
        planned_scan_type: PlannedScanType
    ) -> bool
        requires 0 <= last && last < 4
    {
        TypePlanList::install_profiled(&mut element_scan_plan.plan_lists[last], 
            scan_compare_type, operand_value, unit_size_in_bytes,
            has_scan_function_scalar, scan_function_scalar, memory_alignment,
            periodicity, is_floating_point, is_signed, prefer_type_scanner,
            floating_point_tolerance, has_mask, mask_value,
            result_container_type, planned_scan_type);
        true
    }
}

// Member-place configuration: `new` cannot seed a plan established by an
// entry or member place, so the three scalar fields install through a
// mutating machine instead.
pub machine ElementScanPlan::configure(
    element_scan_plan: &mut ElementScanPlan,
    memory_alignment: MemoryAlignment,
    memory_read_mode: MemoryReadMode,
    is_single_threaded_scan: bool,
    debug_perform_validation_scan: bool
) {
    element_scan_plan.memory_alignment = memory_alignment;
    element_scan_plan.memory_read_mode = memory_read_mode;
    element_scan_plan.is_single_threaded_scan = is_single_threaded_scan;
    element_scan_plan.debug_perform_validation_scan = debug_perform_validation_scan;
}

pub machine ElementScanPlan::clear(element_scan_plan: &mut ElementScanPlan) {
    DataTypeRefSet::clear(&mut element_scan_plan.data_type_refs);
    TypePlanList::clear(&mut element_scan_plan.plan_lists[0]);
    TypePlanList::clear(&mut element_scan_plan.plan_lists[1]);
    TypePlanList::clear(&mut element_scan_plan.plan_lists[2]);
    TypePlanList::clear(&mut element_scan_plan.plan_lists[3]);
}

pub machine ElementScanPlan::get_data_type_ref_count(element_scan_plan: &ElementScanPlan) -> u64 {
    element_scan_plan.data_type_refs.count
}

pub machine ElementScanPlan::get_data_type_ref(element_scan_plan: &ElementScanPlan, position: u64) -> DataTypeRef {
    DataTypeRefSet::get(&element_scan_plan.data_type_refs, position)
}

pub machine ElementScanPlan::get_plan_list(element_scan_plan: &ElementScanPlan, type_index: u64) -> TypePlanList {
    transition type_index < element_scan_plan.data_type_refs.count && type_index < 4 {
        true -> found(element_scan_plan, type_index)
        false -> (TypePlanList::empty())
    }
    state found(element_scan_plan: &ElementScanPlan, type_index: u64) -> TypePlanList
        requires 0 <= type_index && type_index < 4
    {
        TypePlanList::clone(&element_scan_plan.plan_lists[type_index])
    }
}

pub machine ElementScanPlan::get_memory_alignment(element_scan_plan: &ElementScanPlan) -> MemoryAlignment {
    element_scan_plan.memory_alignment
}

pub machine ElementScanPlan::get_memory_read_mode(element_scan_plan: &ElementScanPlan) -> MemoryReadMode {
    element_scan_plan.memory_read_mode
}

pub machine ElementScanPlan::get_is_single_threaded_scan(element_scan_plan: &ElementScanPlan) -> bool {
    element_scan_plan.is_single_threaded_scan
}

// Upstream `get_debug_perform_validation_scan` — read by the dispatcher's
// per-filter debug leg (upstream `dispatch_scan_for_snapshot_filter`).
pub machine ElementScanPlan::get_debug_perform_validation_scan(element_scan_plan: &ElementScanPlan) -> bool {
    element_scan_plan.debug_perform_validation_scan
}

pub machine ElementScanPlan::clone_data_type_refs(element_scan_plan: &ElementScanPlan) -> DataTypeRefSet {
    transition { _ -> each(element_scan_plan, DataTypeRefSet::empty(), 0) }
    state each(element_scan_plan: &ElementScanPlan, copy: DataTypeRefSet, position: u64) -> DataTypeRefSet {
        transition position < element_scan_plan.data_type_refs.count && position < 4 {
            true -> push(element_scan_plan, copy, position)
            false -> (copy)
        }
    }
    state push(element_scan_plan: &ElementScanPlan, copy: DataTypeRefSet, position: u64) -> DataTypeRefSet
        requires 0 <= position && position < 4
    {
        let data_type_ref: DataTypeRef = DataTypeRefSet::get(&element_scan_plan.data_type_refs, position);
        let mut carried: DataTypeRefSet = copy;
        let pushed: bool = DataTypeRefSet::push(&mut carried, &data_type_ref);
        transition { _ -> each(element_scan_plan, carried, position + 1) }
    }
}

// Upstream `get_scan_constraints_by_data_type().get(data_type_ref)` — the
// plan list registered for the collection's data type, or empty.
pub machine ElementScanPlan::get_plan_list_for(element_scan_plan: &ElementScanPlan, data_type_ref: &DataTypeRef) -> TypePlanList {
    transition { _ -> seek(element_scan_plan, data_type_ref, 0) }
    state seek(element_scan_plan: &ElementScanPlan, data_type_ref: &DataTypeRef, position: u64) -> TypePlanList {
        transition position < element_scan_plan.data_type_refs.count && position < 4 {
            true -> compare(element_scan_plan, data_type_ref, position)
            false -> (TypePlanList::empty())
        }
    }
    state compare(element_scan_plan: &ElementScanPlan, data_type_ref: &DataTypeRef, position: u64) -> TypePlanList
        requires 0 <= position && position < 4
    {
        let candidate: DataTypeRef = DataTypeRefSet::get(&element_scan_plan.data_type_refs, position);
        transition DataTypeRef::equals(&candidate, data_type_ref) {
            true -> found(element_scan_plan, position)
            false -> seek(element_scan_plan, data_type_ref, position + 1)
        }
    }
    state found(element_scan_plan: &ElementScanPlan, position: u64) -> TypePlanList
        requires 0 <= position && position < 4
    {
        TypePlanList::clone(&element_scan_plan.plan_lists[position])
    }
}
