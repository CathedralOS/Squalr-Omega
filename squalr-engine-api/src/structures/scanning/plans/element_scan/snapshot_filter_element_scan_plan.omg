module src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan;
use src::structures::bounded_byte_copy::guarded_bounded_copy;

use omega::language::core::option;
use src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use src::structures::data_values::container_type::ContainerType;
use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use src::structures::scanning::comparisons::scan_compare_type_immediate::ScanCompareTypeImmediate;
use src::structures::scanning::comparisons::scan_function_scalar::ScanFunctionScalar;
use src::structures::scanning::plans::plan_types::planned_scan_type::PlannedScanType;

// Port of SnapshotFilterElementScanPlan, scalar leg. Upstream borrows the
// finalized constraint and asks it for the compare type, data value, unit
// size, and optional scalar function; since ScanConstraintFinalized is not yet
// ported, those finalized values live here directly. The floating-point
// tolerance field is deferred to the floating-point scan leg.
pub data SnapshotFilterElementScanPlan {
    scan_compare_type: ScanCompareType;
    operand_value: u64;
    unit_size_in_bytes: u64;
    // Upstream Option<ScanFunctionScalar> is split: Optional over a foreign
    // package type cannot be matched by downstream packages, so presence is a
    // flag beside the copy payload. Callers gate get_scan_function_scalar on
    // has_scan_function_scalar.
    has_scan_function_scalar: bool;
    scan_function_scalar: ScanFunctionScalar;
    memory_alignment: MemoryAlignment;
    planned_scan_type: PlannedScanType;
    // Constraint-derived scalars the upstream rules read off
    // `ScanConstraintFinalized`/`ScanConstraint`: the finalized constraint is
    // a borrowed view and cannot be stored on the owned plan, so the plan
    // builder carries the derived values here instead (deviation — upstream
    // computes periodicity into the plan via its periodicity rule and reads
    // the flag triple from the constraint at rule time).
    periodicity: u64;
    is_floating_point: bool;
    // Upstream `ScanConstraint::is_signed()` — the data type's signedness,
    // read at typed-compare dispatch (signed ordering, arithmetic shift,
    // truncating signed division) — and by the same consumers that read
    // `is_floating_point`/`prefer_type_scanner`.
    is_signed: bool;
    prefer_type_scanner: bool;
    // Upstream `ScanConstraint::floating_point_tolerance` — the tolerance
    // the float compare fns read off the constraint (`get_value_bits`
    // carries the constant in the element's width).
    floating_point_tolerance: FloatingPointTolerance;
    has_mask: bool;
    // Upstream `ScanConstraint::get_mask()` — the per-byte mask payload,
    // packed little-endian in a u64 word the way `operand_value` packs the
    // compared bytes (the byte-array masked scanner reads it byte-wise).
    mask_value: u64;
    // Upstream `ScanConstraint::result_container_type` — the data type's
    // result layout, resolved by the plan builder per data type.
    result_container_type: ContainerType;
    // The byte-pattern carrier for `BuiltPattern` constraints — upstream's
    // plan reads `get_data_value().get_value_bytes()` and `get_mask()` off
    // the borrowed finalized constraint; the owned plan stores the bytes
    // instead (bounded 4096, the package's Vec respell — over-bound input
    // refuses rather than truncates). `operand_value`/`mask_value` remain
    // the <=8-byte fast path the scalar/byte-array scanners read.
    has_pattern_bytes: bool;
    pattern_bytes: [u8; 4096];
    pattern_bytes_len: u64;
    pattern_mask_bytes: [u8; 4096];
    pattern_mask_bytes_len: u64;
}

pub machine SnapshotFilterElementScanPlan::new(
    scan_compare_type: ScanCompareType,
    operand_value: u64,
    unit_size_in_bytes: u64,
    has_scan_function_scalar: bool,
    scan_function_scalar: ScanFunctionScalar,
    memory_alignment: MemoryAlignment
) -> SnapshotFilterElementScanPlan {
    SnapshotFilterElementScanPlan {
        scan_compare_type: scan_compare_type,
        operand_value: operand_value,
        unit_size_in_bytes: unit_size_in_bytes,
        has_scan_function_scalar: has_scan_function_scalar,
        scan_function_scalar: scan_function_scalar,
        memory_alignment: memory_alignment,
        planned_scan_type: PlannedScanType::Invalid,
        periodicity: 0,
        is_floating_point: false,
        is_signed: false,
        prefer_type_scanner: false,
        floating_point_tolerance: FloatingPointTolerance::Tolerance10E3,
        has_mask: false,
        mask_value: 0,
        result_container_type: ContainerType::default(),
        has_pattern_bytes: false,
        pattern_bytes_len: 0,
        pattern_mask_bytes_len: 0,
    }
}

pub machine SnapshotFilterElementScanPlan::get_scan_compare_type(&self) -> ScanCompareType {
    self.scan_compare_type
}

pub machine SnapshotFilterElementScanPlan::get_operand_value(&self) -> u64 {
    self.operand_value
}

pub machine SnapshotFilterElementScanPlan::get_unit_size_in_bytes(&self) -> u64 {
    self.unit_size_in_bytes
}

pub machine SnapshotFilterElementScanPlan::has_scan_function_scalar(&self) -> bool {
    self.has_scan_function_scalar
}

// Meaningful only when has_scan_function_scalar; matches upstream callers that
// unwrap the Option only after a presence check.
pub machine SnapshotFilterElementScanPlan::get_scan_function_scalar(&self) -> ScanFunctionScalar {
    self.scan_function_scalar
}

pub machine SnapshotFilterElementScanPlan::get_memory_alignment(&self) -> MemoryAlignment {
    self.memory_alignment
}

pub machine SnapshotFilterElementScanPlan::get_planned_scan_type(&self) -> PlannedScanType {
    self.planned_scan_type
}

pub machine SnapshotFilterElementScanPlan::get_periodicity(&self) -> u64 {
    self.periodicity
}

pub machine SnapshotFilterElementScanPlan::get_is_floating_point(&self) -> bool {
    self.is_floating_point
}

pub machine SnapshotFilterElementScanPlan::get_is_signed(&self) -> bool {
    self.is_signed
}

// Upstream `get_floating_point_tolerance` on the finalized constraint the
// plan carries — consumed by the float compare dispatch.
pub machine SnapshotFilterElementScanPlan::get_floating_point_tolerance(&self) -> FloatingPointTolerance {
    self.floating_point_tolerance
}

pub machine SnapshotFilterElementScanPlan::get_prefer_type_scanner(&self) -> bool {
    self.prefer_type_scanner
}

pub machine SnapshotFilterElementScanPlan::get_has_mask(&self) -> bool {
    self.has_mask
}

// Upstream `get_scan_constraint().get_mask()` — the packed mask word; only
// meaningful when `has_mask` holds.
pub machine SnapshotFilterElementScanPlan::get_mask_value(&self) -> u64 {
    self.mask_value
}

pub machine SnapshotFilterElementScanPlan::get_result_container_type(&self) -> ContainerType {
    self.result_container_type
}

// Upstream's fixture-side plan build — `new` + `set_scan_profile` +
// `set_planned_scan_type` — composed into one constructor: a plan mutated in
// place cannot then be `&`-read by the caller in this pin.
pub machine SnapshotFilterElementScanPlan::new_profiled(
    scan_compare_type: ScanCompareType,
    operand_value: u64,
    unit_size_in_bytes: u64,
    has_scan_function_scalar: bool,
    scan_function_scalar: ScanFunctionScalar,
    memory_alignment: MemoryAlignment,
    periodicity: u64,
    is_floating_point: bool,
    is_signed: bool,
    prefer_type_scanner: bool,
    floating_point_tolerance: FloatingPointTolerance,
    has_mask: bool,
    mask_value: u64,
    result_container_type: ContainerType,
    planned_scan_type: PlannedScanType
) -> SnapshotFilterElementScanPlan {
    let mut plan: SnapshotFilterElementScanPlan = SnapshotFilterElementScanPlan::new(
        scan_compare_type,
        operand_value,
        unit_size_in_bytes,
        has_scan_function_scalar,
        scan_function_scalar,
        memory_alignment);
    plan.set_scan_profile(
        periodicity,
        is_floating_point,
        is_signed,
        prefer_type_scanner,
        floating_point_tolerance,
        has_mask,
        mask_value,
        result_container_type);
    plan.set_planned_scan_type(planned_scan_type);
    plan
}

// The constraint descriptor half of `new` as a mutation — installed on
// member-place plans that cannot be constructed in a caller frame (upstream
// builds the same fields through `new`).
pub machine SnapshotFilterElementScanPlan::set_scan_descriptor(
    &mut self,
    scan_compare_type: ScanCompareType,
    operand_value: u64,
    unit_size_in_bytes: u64,
    has_scan_function_scalar: bool,
    scan_function_scalar: ScanFunctionScalar,
    memory_alignment: MemoryAlignment
) {
    self.scan_compare_type = scan_compare_type;
    self.operand_value = operand_value;
    self.unit_size_in_bytes = unit_size_in_bytes;
    self.has_scan_function_scalar = has_scan_function_scalar;
    self.scan_function_scalar = scan_function_scalar;
    self.memory_alignment = memory_alignment;
}

// The constraint-derived scalars, installed by the plan builder at
// deanonymize time (upstream reads them off the finalized constraint that
// the owned plan cannot store).
pub machine SnapshotFilterElementScanPlan::set_scan_profile(
    &mut self,
    periodicity: u64,
    is_floating_point: bool,
    is_signed: bool,
    prefer_type_scanner: bool,
    floating_point_tolerance: FloatingPointTolerance,
    has_mask: bool,
    mask_value: u64,
    result_container_type: ContainerType
) {
    self.periodicity = periodicity;
    self.is_floating_point = is_floating_point;
    self.is_signed = is_signed;
    self.prefer_type_scanner = prefer_type_scanner;
    self.floating_point_tolerance = floating_point_tolerance;
    self.has_mask = has_mask;
    self.mask_value = mask_value;
    self.result_container_type = result_container_type;
}

pub machine SnapshotFilterElementScanPlan::set_planned_scan_type(
    &mut self,
    planned_scan_type: PlannedScanType
) {
    self.planned_scan_type = planned_scan_type;
}

// Upstream `Default`/`Clone` parity — the plan-list collection copies plans
// element-wise.
pub machine SnapshotFilterElementScanPlan::default() -> SnapshotFilterElementScanPlan {
    SnapshotFilterElementScanPlan {
        scan_compare_type: ScanCompareType::Immediate { compare_type: ScanCompareTypeImmediate::Equal },
        operand_value: 0,
        unit_size_in_bytes: 0,
        has_scan_function_scalar: false,
        scan_function_scalar: ScanFunctionScalar::Immediate,
        memory_alignment: MemoryAlignment::Alignment1,
        planned_scan_type: PlannedScanType::Invalid,
        periodicity: 0,
        is_floating_point: false,
        is_signed: false,
        prefer_type_scanner: false,
        floating_point_tolerance: FloatingPointTolerance::Tolerance10E3,
        has_mask: false,
        mask_value: 0,
        result_container_type: ContainerType::None,
        has_pattern_bytes: false,
        pattern_bytes_len: 0,
        pattern_mask_bytes_len: 0,
    }
}

pub machine SnapshotFilterElementScanPlan::clone(source: &SnapshotFilterElementScanPlan) -> SnapshotFilterElementScanPlan {
    let mut plan: SnapshotFilterElementScanPlan = SnapshotFilterElementScanPlan::default();
    plan.clone_from(source);
    (plan)
}

// The constraint-derived scalars ride clone_from through the same field copy
// as the plan scalars.
pub machine SnapshotFilterElementScanPlan::clone_from(&mut self, source: &SnapshotFilterElementScanPlan) {
    self.scan_compare_type = source.scan_compare_type;
    self.operand_value = source.operand_value;
    self.unit_size_in_bytes = source.unit_size_in_bytes;
    self.has_scan_function_scalar = source.has_scan_function_scalar;
    self.scan_function_scalar = source.scan_function_scalar;
    self.periodicity = source.periodicity;
    self.is_floating_point = source.is_floating_point;
    self.is_signed = source.is_signed;
    self.prefer_type_scanner = source.prefer_type_scanner;
    self.floating_point_tolerance = source.floating_point_tolerance;
    self.has_mask = source.has_mask;
    self.mask_value = source.mask_value;
    self.result_container_type = source.result_container_type;
    self.memory_alignment = source.memory_alignment;
    self.planned_scan_type = source.planned_scan_type;
    self.has_pattern_bytes = source.has_pattern_bytes;
    self.pattern_bytes_len = source.pattern_bytes_len;
    self.pattern_mask_bytes_len = source.pattern_mask_bytes_len;
    transition { _ -> copy_pattern(source, 0) }
    state copy_pattern(&mut self, source: &SnapshotFilterElementScanPlan, position: u64) {
        transition position < source.pattern_bytes_len && position < 4096 {
            true -> one_pattern(source, position)
            false -> copy_mask(source, 0)
        }
    }
    state one_pattern(&mut self, source: &SnapshotFilterElementScanPlan, position: u64)
        requires position < 4096
    {
        self.pattern_bytes[position] = source.pattern_bytes[position];
        transition { _ -> copy_pattern(source, position + 1) }
    }
    state copy_mask(&mut self, source: &SnapshotFilterElementScanPlan, position: u64) {
        transition position < source.pattern_mask_bytes_len && position < 4096 {
            true -> one_mask(source, position)
            false -> done()
        }
    }
    state done(&mut self) {
        self.has_pattern_bytes = self.has_pattern_bytes;
    }
    state one_mask(&mut self, source: &SnapshotFilterElementScanPlan, position: u64)
        requires position < 4096
    {
        self.pattern_mask_bytes[position] = source.pattern_mask_bytes[position];
        transition { _ -> copy_mask(source, position + 1) }
    }
}

// The pattern-carrier write — upstream `set_data_value` on the constraint.
// Over-bound input refuses (returns false) rather than truncates; the
// `has_pattern_bytes` flag marks the constraint as byte-pattern-carried so
// byte-array scanners know to read the carriers instead of the u64 operand.
pub machine SnapshotFilterElementScanPlan::set_pattern_bytes(&mut self, bytes: &[u8]) -> bool {
    let ok: bool = guarded_bounded_copy(&mut self.pattern_bytes[0..4096], &mut self.pattern_bytes_len, bytes);
    self.has_pattern_bytes = self.has_pattern_bytes || ok;
    (ok)
}

pub machine SnapshotFilterElementScanPlan::set_pattern_mask_bytes(&mut self, bytes: &[u8]) -> bool {
    (guarded_bounded_copy(&mut self.pattern_mask_bytes[0..4096], &mut self.pattern_mask_bytes_len, bytes))
}

pub machine SnapshotFilterElementScanPlan::has_pattern_bytes(&self) -> bool {
    self.has_pattern_bytes
}

pub machine SnapshotFilterElementScanPlan::get_pattern_bytes_len(&self) -> u64 {
    self.pattern_bytes_len
}

// Upstream `get_data_value().get_value_bytes()` — the pattern bytes as a
// span; absent patterns yield the empty span.
pub machine SnapshotFilterElementScanPlan::get_pattern_bytes(&self) -> &[u8] {
    transition self.pattern_bytes_len <= 4096 && self.has_pattern_bytes {
        true -> (&self.pattern_bytes[0..self.pattern_bytes_len])
        false -> (&self.pattern_bytes[0..0])
        _ -> (&self.pattern_bytes[0..0])
    }
}

// Upstream `get_scan_constraint().get_mask()` pattern-byte form; absent
// masks yield the empty span.
pub machine SnapshotFilterElementScanPlan::get_pattern_mask_bytes(&self) -> &[u8] {
    transition self.pattern_mask_bytes_len <= 4096 && self.has_pattern_bytes {
        true -> (&self.pattern_mask_bytes[0..self.pattern_mask_bytes_len])
        false -> (&self.pattern_mask_bytes[0..0])
        _ -> (&self.pattern_mask_bytes[0..0])
    }
}

pub machine SnapshotFilterElementScanPlan::get_pattern_mask_bytes_len(&self) -> u64 {
    self.pattern_mask_bytes_len
}
