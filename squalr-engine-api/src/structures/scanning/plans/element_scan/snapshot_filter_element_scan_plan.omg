module src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan;

use omega::language::core::option;
use src::structures::data_values::container_type::ContainerType;
use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use src::structures::scanning::comparisons::scan_compare_type_immediate::ScanCompareTypeImmediate;
use src::structures::scanning::comparisons::scan_function_scalar::ScanFunctionScalar;
use src::structures::scanning::plans::plan_types::planned_scan_type::PlannedScanType;

// Port of SnapshotFilterElementScanPlan, scalar leg. Upstream borrows the
// finalized constraint and asks it for the compare type, data value, unit
// size, and optional scalar function; since ScanConstraintFinalized is not yet
// ported, those finalized values live here directly. The floating-point
// tolerance field is deferred to the floating-point scan leg.
pub data SnapshotFilterElementScanPlan {
    scan_compare_type: ScanCompareType;
    operand_value: u64;
    unit_size_in_bytes: u64;
    // Upstream Option<ScanFunctionScalar> is split: Optional over a foreign
    // package type cannot be matched by downstream packages, so presence is a
    // flag beside the copy payload. Callers gate get_scan_function_scalar on
    // has_scan_function_scalar.
    has_scan_function_scalar: bool;
    scan_function_scalar: ScanFunctionScalar;
    memory_alignment: MemoryAlignment;
    planned_scan_type: PlannedScanType;
    // Constraint-derived scalars the upstream rules read off
    // `ScanConstraintFinalized`/`ScanConstraint`: the finalized constraint is
    // a borrowed view and cannot be stored on the owned plan, so the plan
    // builder carries the derived values here instead (deviation — upstream
    // computes periodicity into the plan via its periodicity rule and reads
    // the flag triple from the constraint at rule time).
    periodicity: u64;
    is_floating_point: bool;
    prefer_type_scanner: bool;
    has_mask: bool;
    // Upstream `ScanConstraint::result_container_type` — the data type's
    // result layout, resolved by the plan builder per data type.
    result_container_type: ContainerType;
}

pub machine SnapshotFilterElementScanPlan::new(
    scan_compare_type: ScanCompareType,
    operand_value: u64,
    unit_size_in_bytes: u64,
    has_scan_function_scalar: bool,
    scan_function_scalar: ScanFunctionScalar,
    memory_alignment: MemoryAlignment
) -> SnapshotFilterElementScanPlan {
    SnapshotFilterElementScanPlan {
        scan_compare_type: scan_compare_type,
        operand_value: operand_value,
        unit_size_in_bytes: unit_size_in_bytes,
        has_scan_function_scalar: has_scan_function_scalar,
        scan_function_scalar: scan_function_scalar,
        memory_alignment: memory_alignment,
        planned_scan_type: PlannedScanType::Invalid,
        periodicity: 0,
        is_floating_point: false,
        prefer_type_scanner: false,
        has_mask: false,
        result_container_type: ContainerType::default(),
    }
}

pub machine SnapshotFilterElementScanPlan::get_scan_compare_type(&self) -> ScanCompareType {
    self.scan_compare_type
}

pub machine SnapshotFilterElementScanPlan::get_operand_value(&self) -> u64 {
    self.operand_value
}

pub machine SnapshotFilterElementScanPlan::get_unit_size_in_bytes(&self) -> u64 {
    self.unit_size_in_bytes
}

pub machine SnapshotFilterElementScanPlan::has_scan_function_scalar(&self) -> bool {
    self.has_scan_function_scalar
}

// Meaningful only when has_scan_function_scalar; matches upstream callers that
// unwrap the Option only after a presence check.
pub machine SnapshotFilterElementScanPlan::get_scan_function_scalar(&self) -> ScanFunctionScalar {
    self.scan_function_scalar
}

pub machine SnapshotFilterElementScanPlan::get_memory_alignment(&self) -> MemoryAlignment {
    self.memory_alignment
}

pub machine SnapshotFilterElementScanPlan::get_planned_scan_type(&self) -> PlannedScanType {
    self.planned_scan_type
}

pub machine SnapshotFilterElementScanPlan::get_periodicity(&self) -> u64 {
    self.periodicity
}

pub machine SnapshotFilterElementScanPlan::get_is_floating_point(&self) -> bool {
    self.is_floating_point
}

pub machine SnapshotFilterElementScanPlan::get_prefer_type_scanner(&self) -> bool {
    self.prefer_type_scanner
}

pub machine SnapshotFilterElementScanPlan::get_has_mask(&self) -> bool {
    self.has_mask
}

pub machine SnapshotFilterElementScanPlan::get_result_container_type(&self) -> ContainerType {
    self.result_container_type
}

// The constraint-derived scalars, installed by the plan builder at
// deanonymize time (upstream reads them off the finalized constraint that
// the owned plan cannot store).
pub machine SnapshotFilterElementScanPlan::set_scan_profile(
    &mut self,
    periodicity: u64,
    is_floating_point: bool,
    prefer_type_scanner: bool,
    has_mask: bool,
    result_container_type: ContainerType
) {
    self.periodicity = periodicity;
    self.is_floating_point = is_floating_point;
    self.prefer_type_scanner = prefer_type_scanner;
    self.has_mask = has_mask;
    self.result_container_type = result_container_type;
}

pub machine SnapshotFilterElementScanPlan::set_planned_scan_type(
    &mut self,
    planned_scan_type: PlannedScanType
) {
    self.planned_scan_type = planned_scan_type;
}

// Upstream `Default`/`Clone` parity — the plan-list collection copies plans
// element-wise.
pub machine SnapshotFilterElementScanPlan::default() -> SnapshotFilterElementScanPlan {
    SnapshotFilterElementScanPlan {
        scan_compare_type: ScanCompareType::Immediate { compare_type: ScanCompareTypeImmediate::Equal },
        operand_value: 0,
        unit_size_in_bytes: 0,
        has_scan_function_scalar: false,
        scan_function_scalar: ScanFunctionScalar::Immediate,
        memory_alignment: MemoryAlignment::Alignment1,
        planned_scan_type: PlannedScanType::Invalid,
        periodicity: 0,
        is_floating_point: false,
        prefer_type_scanner: false,
        has_mask: false,
        result_container_type: ContainerType::None,
    }
}

pub machine SnapshotFilterElementScanPlan::clone(source: &SnapshotFilterElementScanPlan) -> SnapshotFilterElementScanPlan {
    SnapshotFilterElementScanPlan {
        scan_compare_type: source.scan_compare_type,
        operand_value: source.operand_value,
        unit_size_in_bytes: source.unit_size_in_bytes,
        has_scan_function_scalar: source.has_scan_function_scalar,
        scan_function_scalar: source.scan_function_scalar,
        memory_alignment: source.memory_alignment,
        planned_scan_type: source.planned_scan_type,
        periodicity: source.periodicity,
        is_floating_point: source.is_floating_point,
        prefer_type_scanner: source.prefer_type_scanner,
        has_mask: source.has_mask,
        result_container_type: source.result_container_type,
    }
}

// The constraint-derived scalars ride clone_from through the same field copy
// as the plan scalars.
pub machine SnapshotFilterElementScanPlan::clone_from(&mut self, source: &SnapshotFilterElementScanPlan) {
    self.scan_compare_type = source.scan_compare_type;
    self.operand_value = source.operand_value;
    self.unit_size_in_bytes = source.unit_size_in_bytes;
    self.has_scan_function_scalar = source.has_scan_function_scalar;
    self.scan_function_scalar = source.scan_function_scalar;
    self.periodicity = source.periodicity;
    self.is_floating_point = source.is_floating_point;
    self.prefer_type_scanner = source.prefer_type_scanner;
    self.has_mask = source.has_mask;
    self.result_container_type = source.result_container_type;
    self.memory_alignment = source.memory_alignment;
    self.planned_scan_type = source.planned_scan_type;
}
