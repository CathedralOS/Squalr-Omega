module src::structures::scanning::plans::struct_scan::struct_scan_parameters;

use src::structures::data_types::floating_point_tolerance::FloatingPointTolerance;
use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use src::structures::scanning::memory_read_mode::MemoryReadMode;
use src::structures::structs::valued_struct::ValuedStruct;

// Port of structures/scanning/plans/struct_scan/struct_scan_parameters.rs —
// the scan argument bundle for an element-wise struct scan.
//
// Upstream is Clone, not Copy — ValuedStruct carries bounded arenas, so the
// record carries no [copy] and rides by value like its siblings. The two
// `usize` flags arrive as u64/bool per the payload convention.
pub data StructScanParameters {
    compare_type: ScanCompareType;
    valued_struct: ValuedStruct;
    memory_alignment: MemoryAlignment;
    floating_point_tolerance: FloatingPointTolerance;
    memory_read_mode: MemoryReadMode;
    is_single_thread_scan: bool;
    debug_perform_validation_scan: bool;
}

pub machine StructScanParameters::new(
    compare_type: ScanCompareType,
    valued_struct: ValuedStruct,
    memory_alignment: MemoryAlignment,
    floating_point_tolerance: FloatingPointTolerance,
    memory_read_mode: MemoryReadMode,
    is_single_thread_scan: bool,
    debug_perform_validation_scan: bool
) -> StructScanParameters {
    (StructScanParameters {
        compare_type: compare_type,
        valued_struct: valued_struct,
        memory_alignment: memory_alignment,
        floating_point_tolerance: floating_point_tolerance,
        memory_read_mode: memory_read_mode,
        is_single_thread_scan: is_single_thread_scan,
        debug_perform_validation_scan: debug_perform_validation_scan,
    })
}

// Upstream clones the compare type out; ScanCompareType is [copy] here, so
// the plain read is the clone.
pub machine StructScanParameters::get_compare_type(this: &StructScanParameters) -> ScanCompareType {
    (this.compare_type)
}

pub machine StructScanParameters::get_valued_struct(this: &StructScanParameters) -> &ValuedStruct {
    (&this.valued_struct)
}

pub machine StructScanParameters::get_memory_alignment(this: &StructScanParameters) -> MemoryAlignment {
    (this.memory_alignment)
}

pub machine StructScanParameters::get_floating_point_tolerance(this: &StructScanParameters) -> FloatingPointTolerance {
    (this.floating_point_tolerance)
}

pub machine StructScanParameters::get_memory_read_mode(this: &StructScanParameters) -> MemoryReadMode {
    (this.memory_read_mode)
}

pub machine StructScanParameters::is_single_thread_scan(this: &StructScanParameters) -> bool {
    (this.is_single_thread_scan)
}

pub machine StructScanParameters::get_debug_perform_validation_scan(this: &StructScanParameters) -> bool {
    (this.debug_perform_validation_scan)
}
