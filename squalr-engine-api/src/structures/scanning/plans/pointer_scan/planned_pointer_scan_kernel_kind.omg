module src::structures::scanning::plans::pointer_scan::planned_pointer_scan_kernel_kind;

// Port of structures/scanning/plans/pointer_scan/
// planned_pointer_scan_kernel_kind.rs: the kernel a planning rule selects for
// a pointer-scan traversal pass.
pub data PlannedPointerScanKernelKind [copy] {
    case ScalarLinear;
    case ScalarBinary;
    case SimdLinear;
}

// Upstream `get_display_name` — UI-facing spellings for the chosen kernel.
pub machine PlannedPointerScanKernelKind::get_display_name(&self) -> &[u8] {
    transition self {
        PlannedPointerScanKernelKind::ScalarLinear -> ("Scalar Linear")
        PlannedPointerScanKernelKind::ScalarBinary -> ("Scalar Binary")
        PlannedPointerScanKernelKind::SimdLinear -> ("SIMD Linear")
    }
}
