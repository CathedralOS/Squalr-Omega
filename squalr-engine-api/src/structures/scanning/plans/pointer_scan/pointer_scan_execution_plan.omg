module src::structures::scanning::plans::pointer_scan::pointer_scan_execution_plan;

use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use src::structures::scanning::plans::pointer_scan::planned_pointer_scan_kernel_kind::PlannedPointerScanKernelKind;

// Port of structures/scanning/plans/pointer_scan/
// pointer_scan_execution_plan.rs: the execution plan for a single
// pointer-scan traversal pass. Planning rules mutate
// planned_kernel_kind before dispatch.
pub data PointerScanExecutionPlan [copy] {
    pointer_size: PointerScanPointerSize;
    frontier_target_range_count: u64;
    scan_region_byte_count: u64;
    planned_kernel_kind: PlannedPointerScanKernelKind;
}

pub machine PointerScanExecutionPlan::new(
    pointer_size: PointerScanPointerSize,
    frontier_target_range_count: u64,
    scan_region_byte_count: u64
) -> PointerScanExecutionPlan {
    PointerScanExecutionPlan {
        pointer_size: pointer_size,
        frontier_target_range_count: frontier_target_range_count,
        scan_region_byte_count: scan_region_byte_count,
        planned_kernel_kind: PlannedPointerScanKernelKind::ScalarBinary,
    }
}

pub machine PointerScanExecutionPlan::get_pointer_size(pointer_scan_execution_plan: &PointerScanExecutionPlan) -> PointerScanPointerSize {
    pointer_scan_execution_plan.pointer_size
}

pub machine PointerScanExecutionPlan::get_frontier_target_range_count(pointer_scan_execution_plan: &PointerScanExecutionPlan) -> u64 {
    pointer_scan_execution_plan.frontier_target_range_count
}

pub machine PointerScanExecutionPlan::get_scan_region_byte_count(pointer_scan_execution_plan: &PointerScanExecutionPlan) -> u64 {
    pointer_scan_execution_plan.scan_region_byte_count
}

pub machine PointerScanExecutionPlan::get_planned_kernel_kind(pointer_scan_execution_plan: &PointerScanExecutionPlan) -> PlannedPointerScanKernelKind {
    pointer_scan_execution_plan.planned_kernel_kind
}

pub machine PointerScanExecutionPlan::set_planned_kernel_kind(
    pointer_scan_execution_plan: &mut PointerScanExecutionPlan,
    planned_kernel_kind: PlannedPointerScanKernelKind
) {
    pointer_scan_execution_plan.planned_kernel_kind = planned_kernel_kind;
}
