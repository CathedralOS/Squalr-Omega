module src::structures::scanning::plans::pointer_scan::pointer_scan_parameters;

use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;

// Port of structures/scanning/plans/pointer_scan/pointer_scan_parameters.rs:
// the scan arguments for a pointer scan.
pub data PointerScanParameters [copy] {
    pointer_size: PointerScanPointerSize;
    offset_radius: u64;
    max_depth: u64;
    is_single_thread_scan: bool;
    // Upstream debug flag: when provided the scan is performed twice, once
    // with a specialized scan and once with the default scan, and the results
    // are asserted identical.
    debug_perform_validation_scan: bool;
}

pub machine PointerScanParameters::new(
    pointer_size: PointerScanPointerSize,
    offset_radius: u64,
    max_depth: u64,
    is_single_thread_scan: bool,
    debug_perform_validation_scan: bool
) -> PointerScanParameters {
    PointerScanParameters {
        pointer_size: pointer_size,
        offset_radius: offset_radius,
        max_depth: max_depth,
        is_single_thread_scan: is_single_thread_scan,
        debug_perform_validation_scan: debug_perform_validation_scan,
    }
}

pub machine PointerScanParameters::get_pointer_size(pointer_scan_parameters: &PointerScanParameters) -> PointerScanPointerSize {
    pointer_scan_parameters.pointer_size
}

pub machine PointerScanParameters::get_offset_radius(pointer_scan_parameters: &PointerScanParameters) -> u64 {
    pointer_scan_parameters.offset_radius
}

pub machine PointerScanParameters::get_max_depth(pointer_scan_parameters: &PointerScanParameters) -> u64 {
    pointer_scan_parameters.max_depth
}

pub machine PointerScanParameters::get_is_single_thread_scan(pointer_scan_parameters: &PointerScanParameters) -> bool {
    pointer_scan_parameters.is_single_thread_scan
}

pub machine PointerScanParameters::get_debug_perform_validation_scan(pointer_scan_parameters: &PointerScanParameters) -> bool {
    pointer_scan_parameters.debug_perform_validation_scan
}
