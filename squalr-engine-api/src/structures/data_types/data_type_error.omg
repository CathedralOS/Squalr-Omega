module src::structures::data_types::data_type_error;

use src::structures::data_values::container_type::ContainerType;

// Port of structures/data_types/data_type_error.rs: the shared failure
// channel for the data-type layer. Upstream is a thiserror enum; variants
// whose payloads were formatted Strings or inner errors lose that payload
// here — callers test the class, matching the package's Refused convention
// (named deviation). Structured non-String fields are kept:
// InvalidByteCount's counts, UnsupportedContainerType's kind, and
// ValueParseError's is_value_hex flag.
pub data DataTypeError {
    case ParseError;
    case InvalidByteCount(expected: u64, actual: u64);
    case NoBytes;
    case InvalidDataTypeRef;
    case UnsupportedContainerType(container_type: ContainerType);
    case InvalidMetaData;
    case UnsupportedDisplayType;
    case DecodingError;
    case DataValueMergeError;
    case ValueParseError(is_value_hex: bool);
}
