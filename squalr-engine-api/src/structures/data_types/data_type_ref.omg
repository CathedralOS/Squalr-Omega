module src::structures::data_types::data_type_ref;

use src::structures::data_values::container_type::ContainerType;
use src::structures::memory::endian::Endian;

// Port of structures/data_types/data_type_ref.rs. Upstream keeps the type
// identifier in a growable String; the byte domain keeps it in a bounded
// inline buffer plus a length — the same translation ProcessInfo::name and
// AnonymousValueString use, bounded at 32 bytes ("f32 [4]" style ids are far
// shorter; longer ids refuse to parse rather than truncate — named
// deviation).
//
// Upstream is Clone, not Copy, so the record carries no [copy]. Parse
// failure collapses to `DataTypeRefParse::Refused`, matching the package's
// refusal convention (Optional<T> is unmatchable downstream in this pin).
pub data DataTypeRef {
    data_type_id: [u8; 32];
    data_type_id_len: u64;
}

pub data DataTypeRefParse {
    case Refused;
    case Parsed(value: DataTypeRef);
}

// Upstream `DataTypeRef::new` — stores the id verbatim.
pub machine DataTypeRef::new(data_type_id: &[u8]) -> DataTypeRef {
    let mut data_type_ref: DataTypeRef = DataTypeRef { data_type_id_len: 0 };
    data_type_ref.set_data_type_id(data_type_id);
    data_type_ref
}

pub machine DataTypeRef::default() -> DataTypeRef {
    DataTypeRef { data_type_id_len: 0 }
}

// Upstream FromStr surface for the CLI parser: any nonempty id within the
// bound parses; an empty or over-long id refuses.
pub machine DataTypeRef::parse(text: &[u8]) -> DataTypeRefParse {
    transition 0 < text.len && text.len <= 32{
        true -> arm_result_39_0(text)
        false -> (DataTypeRefParse::Refused)
    }
    state arm_result_39_0(text: &[u8]) -> DataTypeRefParse
    {
        (DataTypeRefParse::Parsed { value: DataTypeRef::new(text) })
    }
}

pub machine DataTypeRef::clone(source: &DataTypeRef) -> DataTypeRef {
    DataTypeRef::new_from_window(source, 0, source.data_type_id_len)
}

// Builds a ref whose id is a byte window of an existing ref's stored id.
pub machine DataTypeRef::new_from_window(
    source: &DataTypeRef,
    start: u64,
    end: u64
) -> DataTypeRef {
    let mut data_type_ref: DataTypeRef = DataTypeRef { data_type_id_len: 0 };
    data_type_ref.copy_id_window(source, start, end);
    data_type_ref
}

pub machine DataTypeRef::clone_from(&mut self, source: &DataTypeRef) {
    self.copy_id_window(source, 0, source.data_type_id_len);
}

machine DataTypeRef::copy_id_window(&mut self, source: &DataTypeRef, start: u64, end: u64) {
    transition { _ -> copy(source, start, end, 0) }
    state copy(&mut self, source: &DataTypeRef, at: u64, end: u64, position: u64) {
        transition at < end && at < source.data_type_id_len && at < 32 && position < 32 {
            true -> store(source, at, end, position)
            false -> finish(position)
        }
    }
    state store(&mut self, source: &DataTypeRef, at: u64, end: u64, position: u64) {
        self.data_type_id[position] = source.data_type_id[at];
        transition { _ -> copy(source, at + 1, end, position + 1) }
    }
    state finish(&mut self, count: u64) {
        self.data_type_id_len = count;
    }
}

// Upstream `set_data_type_id` / `get_data_type_id` — the borrowed &str view
// is not retainable, so reads are length + per-byte access.
pub machine DataTypeRef::set_data_type_id(&mut self, data_type_id: &[u8]) {
    transition { _ -> copy(data_type_id, 0) }
    state copy(&mut self, data_type_id: &[u8], position: u64) {
        transition position < data_type_id.len && position < 32 {
            true -> store(data_type_id, position)
            false -> finish(position)
        }
    }
    state store(&mut self, data_type_id: &[u8], position: u64) {
        self.data_type_id[position] = data_type_id[position];
        transition { _ -> copy(data_type_id, position + 1) }
    }
    state finish(&mut self, count: u64) {
        self.data_type_id_len = count;
    }
}

pub machine DataTypeRef::get_data_type_id_len(&self) -> u64 {
    self.data_type_id_len
}

pub machine DataTypeRef::get_data_type_id_byte(&self, position: u64) -> u8 {
    transition position < self.data_type_id_len && position < 32 {
        true -> (self.data_type_id[position])
        false -> (0)
    }
}

// View over the stored identifier bytes for callers matching on `&[u8]`.
pub machine DataTypeRef::get_data_type_id(&self) -> &[u8] {
    transition self.data_type_id_len <= 32 {
        true -> arm_result_113_0()
        _ -> (&self.data_type_id[0..0])
    }
    state arm_result_113_0(&self) -> &[u8]
    
    requires self.data_type_id_len <= 32;
{
        (&self.data_type_id[0..self.data_type_id_len])
    }
}

// Upstream `PartialEq` for DataTypeRef — compares the stored ids.
pub machine DataTypeRef::equals(&self, other: &DataTypeRef) -> bool {
    transition self.data_type_id_len == other.data_type_id_len {
        true -> scan(0, other)
        false -> (false)
    }
    state scan(&self, position: u64, other: &DataTypeRef) -> bool {
        transition position < self.data_type_id_len && position < 32 {
            true -> compare(position, other)
            false -> (true)
        }
    }
    state compare(&self, position: u64, other: &DataTypeRef) -> bool
        requires 0 <= position && position < 32
    {
        transition self.data_type_id[position] == other.data_type_id[position] {
            true -> scan(position + 1, other)
            false -> (false)
            _ -> (false)
        }
    }
}

// Upstream `get_base_data_type_id` — for generics the id is written
// "name{arg,...}"; the base is the prefix before '{'. Here the flag depth is
// reported instead of slicing the buffer: callers compare the base by window.
pub machine DataTypeRef::get_base_data_type_id_len(&self) -> u64 {
    transition { _ -> scan(0) }
    state scan(&self, position: u64) -> u64 {
        transition position < self.data_type_id_len && position < 32 {
            true -> probe(position)
            false -> (self.data_type_id_len)
        }
    }
    // '{' (byte 123) starts the generic argument list; the base ends there.
    state probe(&self, position: u64) -> u64
        requires 0 <= position && position < 32
    {
        transition self.data_type_id[position] == 123 {
            true -> (position)
            false -> scan(position + 1)
            _ -> scan(position + 1)
        }
    }
}

// The element byte width this ref carries in a scan — upstream's
// `SymbolRegistry::get_unit_size_in_bytes(data_type_ref)` reads the
// registered `DataType::get_unit_size_in_bytes`; the port flattens the
// registered matrix onto the id: 1-byte ids are u8/i8/bool8/string, 2-byte
// u16/i16 (+be), 3-byte the u24/i24 plugin ids (+be), 4-byte u32/i32/f32/
// bool32 (+be), 8-byte u64/i64/f64 (+be). Any other id yields 0, which
// callers treat as unsupported.
pub machine DataTypeRef::get_unit_size_in_bytes(&self) -> u64 {
    let u8_: bool = self.id_is("u8");
    let i8_: bool = self.id_is("i8");
    let bool8_: bool = self.id_is("bool8");
    let string_: bool = self.id_is("string");
    let one: bool = u8_ || i8_ || bool8_ || string_;
    transition one {
        true -> (1)
        false -> two_or_more()
    }
    state two_or_more(&self) -> u64 {
        let u16_: bool = self.id_is("u16");
        let i16_: bool = self.id_is("i16");
        let u16be_: bool = self.id_is("u16be");
        let i16be_: bool = self.id_is("i16be");
        let two: bool = u16_ || i16_ || u16be_ || i16be_;
        transition two {
            true -> (2)
            false -> three_or_more()
        }
    }
    state three_or_more(&self) -> u64 {
        let u24_: bool = self.id_is("u24");
        let i24_: bool = self.id_is("i24");
        let u24be_: bool = self.id_is("u24be");
        let i24be_: bool = self.id_is("i24be");
        let three: bool = u24_ || i24_ || u24be_ || i24be_;
        transition three {
            true -> (3)
            false -> four_or_more()
        }
    }
    state four_or_more(&self) -> u64 {
        let u32_: bool = self.id_is("u32");
        let i32_: bool = self.id_is("i32");
        let f32_: bool = self.id_is("f32");
        let bool32_: bool = self.id_is("bool32");
        let u32be_: bool = self.id_is("u32be");
        let i32be_: bool = self.id_is("i32be");
        let f32be_: bool = self.id_is("f32be");
        let four: bool = u32_ || i32_ || f32_ || bool32_
            || u32be_ || i32be_ || f32be_;
        transition four {
            true -> (4)
            false -> eight_or_zero()
        }
    }
    state eight_or_zero(&self) -> u64 {
        let u64_: bool = self.id_is("u64");
        let i64_: bool = self.id_is("i64");
        let f64_: bool = self.id_is("f64");
        let u64be_: bool = self.id_is("u64be");
        let i64be_: bool = self.id_is("i64be");
        let f64be_: bool = self.id_is("f64be");
        let eight: bool = u64_ || i64_ || f64_ || u64be_ || i64be_ || f64be_;
        transition eight {
            true -> (8)
            false -> (0)
        }
    }
}

// Upstream `DataType::get_endian` — the *be id suffix is the big-endian
// registration; everything else upstream registers little.
pub machine DataTypeRef::get_endian(&self) -> Endian {
    transition self.is_big_endian() {
        true -> (Endian::Big)
        false -> (Endian::Little)
        _ -> (Endian::Little)
    }
}

// The 'b','e' suffix distinguishes the big-endian registrations.
pub machine DataTypeRef::is_big_endian(&self) -> bool {
    transition self.data_type_id_len >= 2 && self.data_type_id_len <= 32 {
        true -> tail(self.data_type_id_len - 2)
        false -> (false)
    }
    state tail(&self, at: u64) -> bool {
        let second: u64 = ((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition at < 32 && second < 32 {
            true -> read(at, second)
            false -> (false)
            _ -> (false)
        }
    }
    state read(&self, at: u64, second: u64) -> bool
        requires at < 32 && second < 32
    {
        transition self.data_type_id[at] == 98 && self.data_type_id[second] == 101 {
            true -> (true)
            false -> (false)
            _ -> (false)
        }
    }
}

// Upstream's signed/unsigned distinction: the i* and f* ids are the signed
// numerics (integers and floats); u*, bool*, string are unsigned.
pub machine DataTypeRef::is_signed(&self) -> bool {
    transition self.data_type_id_len > 0 && self.data_type_id_len <= 32 {
        true -> head()
        false -> (false)
    }
    state head(&self) -> bool {
        transition self.data_type_id[0] == 105 || self.data_type_id[0] == 102 {
            true -> (true)
            false -> (false)
            _ -> (false)
        }
    }
}

// Upstream `symbol_registry.is_floating_point(data_type_ref)`: the float
// types registered upstream are exactly the f-prefixed ids — f32/f32be/
// f64/f64be. Plugin float types land with the plugin type leg.
pub machine DataTypeRef::is_floating_point(&self) -> bool {
    let f32: bool = self.id_is("f32");
    let f32be: bool = self.id_is("f32be");
    let f64: bool = self.id_is("f64");
    let f64be: bool = self.id_is("f64be");
    f32 || f32be || f64 || f64be
}

// Upstream `symbol_registry.get_scan_preference(data_type_ref) ==
// PreferTypeScanner`: only the 24-bit plugin data types opt in upstream —
// the four i/u24 ids.
pub machine DataTypeRef::prefers_type_scanner(&self) -> bool {
    let i24: bool = self.id_is("i24");
    let u24: bool = self.id_is("u24");
    let i24be: bool = self.id_is("i24be");
    let u24be: bool = self.id_is("u24be");
    i24 || u24 || i24be || u24be
}

// Upstream resolves the result container through the symbol registry's
// `DataType::container_type`. Every data type registered at this leg is a
// built-in scalar, whose container upstream is `Array` (fixed-length and
// pointer containers land with their type legs).
pub machine DataTypeRef::get_result_container_type(&self) -> ContainerType {
    ContainerType::Array
}

pub machine DataTypeRef::id_is(&self, text: &[u8]) -> bool {
    transition self.data_type_id_len == text.len && text.len <= 32 {
        true -> scan(0, text)
        false -> (false)
    }
    state scan(&self, position: u64, text: &[u8]) -> bool {
        transition position < self.data_type_id_len && position < text.len && position < 32 {
            true -> compare(position, text)
            false -> tail(position)
        }
    }
    state compare(&self, position: u64, text: &[u8]) -> bool
        requires 0 <= position && position < text.len
    {
        transition position < 32 && self.data_type_id[position] == text[position] {
            true -> next(position, text)
            false -> (false)
            _ -> (false)
        }
    }
    state next(&self, position: u64, text: &[u8]) -> bool {
        transition { _ -> scan(position + 1, text) }
    }
    state tail(&self, position: u64) -> bool {
        transition position >= self.data_type_id_len {
            true -> (true)
            false -> (false)
        }
    }
}

// Upstream `PartialEq` for DataTypeRef — compares the stored ids.
