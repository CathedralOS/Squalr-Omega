module src::structures::data_types::data_type_ref;

// Port of DataTypeRef. Upstream wraps a String identity used for equality and
// map keying (HashMap<DataTypeRef, ...> in scan plans and registries); Omega
// has no heap String or hash map, so the identifier is a caller-supplied byte
// extent whose `.len` is the identifier length, and keying is a sequential
// `equals` scan over the constraint sets. Flag parsing (`{...}` parameter
// text) and serialization live with the plugin/data-type legs.
pub data DataTypeRef<'a> {
    data_type_id: &'a mut [u8];
}

pub machine DataTypeRef::new<'a>(data_type_id: &'a mut [u8]) -> DataTypeRef<'a> {
    (DataTypeRef {
        data_type_id: data_type_id,
    })
}

pub machine DataTypeRef::get_data_type_id_len(&self) -> u64 {
    self.data_type_id.len
}

// Upstream `get_base_data_type_id` splits `{...}` parameter text off; the base
// identity length ends at the first `{` byte (or covers the whole id).
pub machine DataTypeRef::get_base_data_type_id_len(&self) -> u64 {
    transition self.data_type_id.len > 0 {
        true -> scan(self.data_type_id, 0)
        _ -> (0)
    }
    state scan(&self, data_type_id: &[u8], byte_index: u64) -> u64 {
        transition byte_index < data_type_id.len {
            true -> check(data_type_id, byte_index)
            _ -> (data_type_id.len)
        }
    }
    state check(
        &self,
        data_type_id: &[u8],
        byte_index: u64 [0..data_type_id.len]
    ) -> u64 {
        transition data_type_id[byte_index] == 123 {
            true -> (byte_index)
            _ -> scan_next(data_type_id, byte_index)
        }
    }
    state scan_next(&self, data_type_id: &[u8], byte_index: u64) -> u64 {
        let next_index: u64 = ((byte_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        scan(data_type_id, next_index)
    }
}

pub machine DataTypeRef::equals(&self, other: &DataTypeRef) -> bool {
    transition self.data_type_id.len == other.data_type_id.len {
        true -> compare(self.data_type_id, other.data_type_id, 0, 0)
        _ -> (false)
    }
    state compare(
        &self,
        left: &[u8],
        right: &[u8],
        left_index: u64,
        right_index: u64
    ) -> bool {
        transition left_index < left.len && right_index < right.len {
            true -> compare_byte(left, right, left_index, right_index)
            _ -> (true)
        }
    }
    state compare_byte(
        &self,
        left: &[u8],
        right: &[u8],
        left_index: u64 [0..left.len],
        right_index: u64 [0..right.len]
    ) -> bool {
        transition left[left_index] == right[right_index] {
            true -> compare_next(left, right, left_index, right_index)
            _ -> (false)
        }
    }
    state compare_next(
        &self,
        left: &[u8],
        right: &[u8],
        left_index: u64,
        right_index: u64
    ) -> bool {
        let next_left_index: u64 = ((left_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        let next_right_index: u64 = ((right_index as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        compare(left, right, next_left_index, next_right_index)
    }
}
