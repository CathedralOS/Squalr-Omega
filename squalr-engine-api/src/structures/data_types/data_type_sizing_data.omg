module src::structures::data_types::data_type_sizing_data;

// Port of structures/data_types/data_type_sizing_data.rs — whether a data
// type's size is fixed by its id or resolved per value.
//
// `VariableSize(Option<u64>)` carries the option payload as the
// (has_size, size) pair — the package's Option<T> convention; a
// VariableSize with has_size=false is upstream's VariableSize(None).
pub data DataTypeSizingData [copy] {
    case FixedSize;
    case VariableSize(has_size: bool, size: u64);
}

// Upstream `get_size_in_bytes` shape: callers wanting the known size read
// the pair; FixedSize means consult the type's own unit size instead.
pub machine DataTypeSizingData::is_fixed_size(data_type_sizing_data: &DataTypeSizingData) -> bool {
    transition data_type_sizing_data {
        DataTypeSizingData::FixedSize -> (true)
        DataTypeSizingData::VariableSize { has_size, size } -> (false)
        _ -> (false)
    }
}
