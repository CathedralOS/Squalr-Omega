module src::structures::data_types::floating_point_tolerance;

// Port of FloatingPointTolerance. The variant set and the upstream default
// of Tolerance10E3 are preserved; `get_value_bits` is `get_value`'s bit
// carrier — upstream returns the tolerance as the element's PrimitiveType
// (f32 rounding for f32 elements, f64 for f64), so the same constant is
// delivered here as IEEE bits in the element's width.
pub data FloatingPointTolerance [copy] {
    case Tolerance10E1;
    case Tolerance10E2;
    case Tolerance10E3;
    case Tolerance10E4;
    case Tolerance10E5;
    case ToleranceEpsilon;
}

pub machine FloatingPointTolerance::default() -> FloatingPointTolerance {
    (FloatingPointTolerance::Tolerance10E3)
}

// Upstream `get_value::<PrimitiveType>`: the tolerance typed in the
// element's float width, carried as IEEE bits (low 32 for `element_size` 4,
// full 64 for 8 — matches the element/operand slot convention).
// f32 constants: 0.1 -> 0x3DCCCCCD, 0.01 -> 0x3C23D70A, 0.001 -> 0x3A83126F,
// 0.0001 -> 0x38D1B717, 0.00001 -> 0x3727C5AC, epsilon (2^-23) -> 0x34000000.
// f64 constants: 0.1 -> 0x3FB999999999999A, 0.01 -> 0x3F847AE147AE147B,
// 0.001 -> 0x3F50624DD2F1A9FC, 0.0001 -> 0x3F1A36E2EB1C432D,
// 0.00001 -> 0x3EE4F8B588E368F1, epsilon (2^-52) -> 0x3CB0000000000000.
pub machine FloatingPointTolerance::get_value_bits(
    this: &FloatingPointTolerance,
    element_size_in_bytes: u64
) -> u64 {
    let hoist3: u64 = FloatingPointTolerance::value_f64_bits(&this);
    let hoist2: u64 = FloatingPointTolerance::value_f64_bits(&this);
    let hoist1: u64 = FloatingPointTolerance::value_f32_bits(&this);
    transition element_size_in_bytes == 4 {
        true -> (hoist1)
        false -> (hoist2)
        _ -> (hoist3)
    }
}

machine FloatingPointTolerance::value_f32_bits(this: &FloatingPointTolerance) -> u64 {
    transition this {
        FloatingPointTolerance::Tolerance10E1 -> (1036831949)
        FloatingPointTolerance::Tolerance10E2 -> (1008981770)
        FloatingPointTolerance::Tolerance10E3 -> (981668463)
        FloatingPointTolerance::Tolerance10E4 -> (953267991)
        FloatingPointTolerance::Tolerance10E5 -> (925353388)
        FloatingPointTolerance::ToleranceEpsilon -> (872415232)
    }
}

machine FloatingPointTolerance::value_f64_bits(this: &FloatingPointTolerance) -> u64 {
    transition this {
        FloatingPointTolerance::Tolerance10E1 -> (4596373779694328218)
        FloatingPointTolerance::Tolerance10E2 -> (4576918229304087675)
        FloatingPointTolerance::Tolerance10E3 -> (4562254508917369340)
        FloatingPointTolerance::Tolerance10E4 -> (4547007122018943789)
        FloatingPointTolerance::Tolerance10E5 -> (4532020583610935537)
        FloatingPointTolerance::ToleranceEpsilon -> (4372995238176751616)
    }
}
