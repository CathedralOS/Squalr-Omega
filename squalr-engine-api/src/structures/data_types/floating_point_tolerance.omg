module src::structures::data_types::floating_point_tolerance;

// Port of FloatingPointTolerance. Upstream's `get_value` returns a typed
// float constant — deferred to the floating-point scan legs; the Omega leg
// preserves the variant set and the upstream default of Tolerance10E3.
pub data FloatingPointTolerance [copy] {
    case Tolerance10E1;
    case Tolerance10E2;
    case Tolerance10E3;
    case Tolerance10E4;
    case Tolerance10E5;
    case ToleranceEpsilon;
}

pub machine FloatingPointTolerance::default() -> FloatingPointTolerance {
    (FloatingPointTolerance::Tolerance10E3)
}
