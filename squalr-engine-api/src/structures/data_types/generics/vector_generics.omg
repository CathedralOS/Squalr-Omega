module src::structures::data_types::generics::vector_generics;

use src::structures::data_types::generics::vectorization_plan;

// Port of VectorGenerics: the upstream unit struct namespaces the SIMD
// helpers and this geometry entry under `impl VectorGenerics`. The
// transmute/transmute_mask and rotate-with-discard helpers are scanner-side
// SIMD concerns and stay unported until the SIMD leg of the scan port.
pub data VectorGenerics {}

// Upstream `VectorGenerics::plan_vector_scan<const N: usize>`; the const
// lane count of the `Simd<u8, N>` the caller drives is the vector width in
// bytes, kept as the const binder so `plan_vector_scan<16>` selects a
// specialization like the upstream application. Stride floors at 1 before
// the geometry divisions, matching `element_stride_bytes.max(1)`, and the
// two saturating subs carry the same released semantics as upstream.
pub machine VectorGenerics::plan_vector_scan<const N: u64>(
    region_size: u64,
    data_type_size_bytes: u64,
    element_stride_bytes: u64
) -> vectorization_plan::VectorizationPlan {
    let vector_size_in_bytes: u64 = N;
    let stride: u64 = max(element_stride_bytes, 1);
    let trailing_bytes: u64 = ((data_type_size_bytes as u64 in Saturating) - (stride as u64 in Saturating)) as u64;
    let valid_bytes: u64 = ((region_size as u64 in Saturating) - (trailing_bytes as u64 in Saturating)) as u64;
    let element_count: u64 = valid_bytes / stride;
    let elements_per_vector: u64 = vector_size_in_bytes / stride;
    vectorization_plan::VectorizationPlan {
        vector_size_in_bytes: vector_size_in_bytes,
        element_stride_bytes: stride,
        valid_bytes: valid_bytes,
        element_count: element_count,
        elements_per_vector: elements_per_vector
    }
}
