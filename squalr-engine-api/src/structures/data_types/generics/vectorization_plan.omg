module src::structures::data_types::generics::vectorization_plan;

// Port of VectorizationPlan: pure scan geometry computed once per region.
// Field order and meanings match the upstream record. Upstream derives
// Debug/Clone/Copy/PartialEq/Eq; the port carries `[copy]` for Copy,
// `equals` for PartialEq, and the clone/clone_from pair for Clone, split
// at the same compiler edges as NormalizedRegion's (`clone` takes the
// borrowed source explicitly; `clone_from` is the mutating half).
// The type is not serialized upstream, so no wire schema numbers.
pub data VectorizationPlan [copy] {
    // Vector width in bytes (ie 16/32/64).
    vector_size_in_bytes: u64;

    // Stride between candidate element starts (usually memory_alignment as u64).
    element_stride_bytes: u64;

    // Bytes that are valid as *starting positions* (region_size minus trailing bytes).
    valid_bytes: u64;

    // Count of candidate element starts.
    element_count: u64;

    // How many elements fit per vector load (vector_bytes / stride).
    elements_per_vector: u64;
}

pub machine VectorizationPlan::clone(source: &VectorizationPlan) -> VectorizationPlan {
    VectorizationPlan {
        vector_size_in_bytes: source.vector_size_in_bytes,
        element_stride_bytes: source.element_stride_bytes,
        valid_bytes: source.valid_bytes,
        element_count: source.element_count,
        elements_per_vector: source.elements_per_vector
    }
}

pub machine VectorizationPlan::clone_from(this: &mut VectorizationPlan, source: &VectorizationPlan) {
    this.vector_size_in_bytes = source.vector_size_in_bytes;
    this.element_stride_bytes = source.element_stride_bytes;
    this.valid_bytes = source.valid_bytes;
    this.element_count = source.element_count;
    this.elements_per_vector = source.elements_per_vector;
}

pub machine VectorizationPlan::equals(this: &VectorizationPlan, other: &VectorizationPlan) -> bool {
    this.vector_size_in_bytes == other.vector_size_in_bytes
        && this.element_stride_bytes == other.element_stride_bytes
        && this.valid_bytes == other.valid_bytes
        && this.element_count == other.element_count
        && this.elements_per_vector == other.elements_per_vector
}

pub machine VectorizationPlan::is_valid(this: &VectorizationPlan) -> bool {
    this.elements_per_vector > 0 && this.element_count >= this.elements_per_vector
}

pub machine VectorizationPlan::get_vectorizable_iterations(this: &VectorizationPlan) -> u64 {
    transition this.elements_per_vector == 0 {
        true -> 0
        false -> (this.element_count / this.elements_per_vector)
    }
}

pub machine VectorizationPlan::get_vectorizable_element_count(this: &VectorizationPlan) -> u64 {
    ((VectorizationPlan::get_vectorizable_iterations(&this) as u64 in Wrapping) * (this.elements_per_vector as u64 in Wrapping)) as u64
}

pub machine VectorizationPlan::get_remainder_elements(this: &VectorizationPlan) -> u64 {
    ((this.element_count as u64 in Wrapping) - (VectorizationPlan::get_vectorizable_element_count(&this) as u64 in Wrapping)) as u64
}

// Tail bytes that remain after full vector iterations, measured in *valid bytes* space.
pub machine VectorizationPlan::get_remainder_bytes(this: &VectorizationPlan) -> u64 {
    let _nc0: u64 = VectorizationPlan::get_vectorizable_iterations(&this);
    let iterated_bytes: u64 = ((_nc0 as u64 in Wrapping) * (this.vector_size_in_bytes as u64 in Wrapping)) as u64;
    ((this.valid_bytes as u64 in Wrapping) - (iterated_bytes as u64 in Wrapping)) as u64
}

// Byte offset where the non-vectorizable elements begin; upstream saturates
// the subtraction inside the remainder-present arm.
pub machine VectorizationPlan::get_remainder_ptr_offset(this: &VectorizationPlan) -> u64 {
    let _nc1: u64 = VectorizationPlan::get_remainder_bytes(&this);
    transition _nc1 > 0 {
        true -> (((this.valid_bytes as u64 in Saturating) - (this.vector_size_in_bytes as u64 in Saturating)) as u64)
        false -> 0
    }
}
