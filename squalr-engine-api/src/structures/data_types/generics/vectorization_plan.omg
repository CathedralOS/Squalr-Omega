module src::structures::data_types::generics::vectorization_plan;

// Port of VectorizationPlan: pure scan geometry computed once per region.
// Field order and meanings match the upstream record. Upstream derives
// Debug/Clone/Copy/PartialEq/Eq; the port carries `[copy]` for Copy,
// `equals` for PartialEq, and the clone/clone_from pair for Clone, split
// at the same compiler edges as NormalizedRegion's (`clone` takes the
// borrowed source explicitly; `clone_from` is the mutating half).
// The type is not serialized upstream, so no wire schema numbers.
pub data VectorizationPlan [copy] {
    // Vector width in bytes (ie 16/32/64).
    vector_size_in_bytes: u64;

    // Stride between candidate element starts (usually memory_alignment as u64).
    element_stride_bytes: u64;

    // Bytes that are valid as *starting positions* (region_size minus trailing bytes).
    valid_bytes: u64;

    // Count of candidate element starts.
    element_count: u64;

    // How many elements fit per vector load (vector_bytes / stride).
    elements_per_vector: u64;
}

pub machine VectorizationPlan::clone(source: &VectorizationPlan) -> VectorizationPlan {
    VectorizationPlan {
        vector_size_in_bytes: source.vector_size_in_bytes,
        element_stride_bytes: source.element_stride_bytes,
        valid_bytes: source.valid_bytes,
        element_count: source.element_count,
        elements_per_vector: source.elements_per_vector
    }
}

pub machine VectorizationPlan::clone_from(&mut self, source: &VectorizationPlan) {
    self.vector_size_in_bytes = source.vector_size_in_bytes;
    self.element_stride_bytes = source.element_stride_bytes;
    self.valid_bytes = source.valid_bytes;
    self.element_count = source.element_count;
    self.elements_per_vector = source.elements_per_vector;
}

pub machine VectorizationPlan::equals(&self, other: &VectorizationPlan) -> bool {
    self.vector_size_in_bytes == other.vector_size_in_bytes
        && self.element_stride_bytes == other.element_stride_bytes
        && self.valid_bytes == other.valid_bytes
        && self.element_count == other.element_count
        && self.elements_per_vector == other.elements_per_vector
}

pub machine VectorizationPlan::is_valid(&self) -> bool {
    self.elements_per_vector > 0 && self.element_count >= self.elements_per_vector
}

pub machine VectorizationPlan::get_vectorizable_iterations(&self) -> u64 {
    transition self.elements_per_vector == 0 {
        true -> 0
        false -> (self.element_count / self.elements_per_vector)
    }
}

pub machine VectorizationPlan::get_vectorizable_element_count(&self) -> u64 {
    ((self.get_vectorizable_iterations() as u64 in Wrapping) * (self.elements_per_vector as u64 in Wrapping)) as u64
}

pub machine VectorizationPlan::get_remainder_elements(&self) -> u64 {
    ((self.element_count as u64 in Wrapping) - (self.get_vectorizable_element_count() as u64 in Wrapping)) as u64
}

// Tail bytes that remain after full vector iterations, measured in *valid bytes* space.
pub machine VectorizationPlan::get_remainder_bytes(&self) -> u64 {
    let iterated_bytes: u64 = ((self.get_vectorizable_iterations() as u64 in Wrapping) * (self.vector_size_in_bytes as u64 in Wrapping)) as u64;
    ((self.valid_bytes as u64 in Wrapping) - (iterated_bytes as u64 in Wrapping)) as u64
}

// Byte offset where the non-vectorizable elements begin; upstream saturates
// the subtraction inside the remainder-present arm.
pub machine VectorizationPlan::get_remainder_ptr_offset(&self) -> u64 {
    transition self.get_remainder_bytes() > 0 {
        true -> (((self.valid_bytes as u64 in Saturating) - (self.vector_size_in_bytes as u64 in Saturating)) as u64)
        false -> 0
    }
}
