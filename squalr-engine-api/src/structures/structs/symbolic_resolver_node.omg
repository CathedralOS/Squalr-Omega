module src::structures::structs::symbolic_resolver_node;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::structs::owned_symbolic_pointer_chain::OwnedSymbolicPointerChain;
use src::structures::structs::symbolic_resolver_binary_operator::SymbolicResolverBinaryOperator;
use src::structures::structs::symbolic_resolver_relative_symbol_path::SymbolicResolverRelativeSymbolPath;

// Port of structures/structs/symbolic_resolver_definition.rs's
// `SymbolicResolverNode` — upstream's recursive Box'd expression tree.
//
// Deviations:
//  - Recursive data has no runtime layout in this pin (unions cannot
//    carry themselves), so Binary/Conditional children ride arena indices
//    into the owning SymbolicResolverDefinition's bounded node list —
//    upstream's Box indirection replaced by positional handles (the
//    codebase's generational/arena convention).
//  - `Literal(i128)` carries the i128 bit pattern as two u64 words
//    (two's-complement hi/lo) — no i128 primitive exists.
//  - String fields ride bounded spans; pointer chains ride the owned
//    projection (OwnedSymbolicPointerChain — the 'links view cannot be
//    stored in an owned record).
pub data SymbolicResolverNode {
    case Literal(literal_lo: u64, literal_hi: u64);
    case LocalField(field_name: [u8; 256], field_name_len: u64);
    case RelativeSymbolField(symbol_path: SymbolicResolverRelativeSymbolPath);
    case GlobalSymbolField(module_name: [u8; 256], module_name_len: u64, symbol_path: SymbolicResolverRelativeSymbolPath);
    case RelativePointerChain(pointer_chain: OwnedSymbolicPointerChain);
    case GlobalPointerChain(pointer_chain: OwnedSymbolicPointerChain);
    case TypeSize(data_type_ref: DataTypeRef);
    case Binary(operator: SymbolicResolverBinaryOperator, left_node_index: u64, right_node_index: u64);
    case Conditional(condition_node_index: u64, true_node_index: u64, false_node_index: u64);
}

pub machine SymbolicResolverNode::default() -> SymbolicResolverNode {
    (SymbolicResolverNode::Literal { literal_lo: 0, literal_hi: 0 })
}

pub machine SymbolicResolverNode::new_literal(literal_lo: u64, literal_hi: u64) -> SymbolicResolverNode {
    (SymbolicResolverNode::Literal { literal_lo: literal_lo, literal_hi: literal_hi })
}

pub machine SymbolicResolverNode::new_local_field(field_name: &[u8]) -> SymbolicResolverNode {
    let mut name: [u8; 256];
    let name_len: u64 = copy_bounded_span(&mut name, field_name);
    (SymbolicResolverNode::LocalField { field_name: name, field_name_len: name_len })
}

pub machine SymbolicResolverNode::new_relative_symbol_field(symbol_path: &SymbolicResolverRelativeSymbolPath) -> SymbolicResolverNode {
    let mut path: SymbolicResolverRelativeSymbolPath = SymbolicResolverRelativeSymbolPath::default();
    SymbolicResolverRelativeSymbolPath::clone_from(&mut path, symbol_path);
    (SymbolicResolverNode::RelativeSymbolField { symbol_path: path })
}

pub machine SymbolicResolverNode::new_global_symbol_field(module_name: &[u8], symbol_path: &SymbolicResolverRelativeSymbolPath) -> SymbolicResolverNode {
    let mut name: [u8; 256];
    let name_len: u64 = copy_bounded_span(&mut name, module_name);
    let mut path: SymbolicResolverRelativeSymbolPath = SymbolicResolverRelativeSymbolPath::default();
    SymbolicResolverRelativeSymbolPath::clone_from(&mut path, symbol_path);
    (SymbolicResolverNode::GlobalSymbolField {
        module_name: name,
        module_name_len: name_len,
        symbol_path: path,
    })
}

pub machine SymbolicResolverNode::new_relative_pointer_chain(pointer_chain: &OwnedSymbolicPointerChain) -> SymbolicResolverNode {
    let mut chain: OwnedSymbolicPointerChain = OwnedSymbolicPointerChain::default();
    OwnedSymbolicPointerChain::clone_from(&mut chain, pointer_chain);
    (SymbolicResolverNode::RelativePointerChain { pointer_chain: chain })
}

pub machine SymbolicResolverNode::new_global_pointer_chain(pointer_chain: &OwnedSymbolicPointerChain) -> SymbolicResolverNode {
    let mut chain: OwnedSymbolicPointerChain = OwnedSymbolicPointerChain::default();
    OwnedSymbolicPointerChain::clone_from(&mut chain, pointer_chain);
    (SymbolicResolverNode::GlobalPointerChain { pointer_chain: chain })
}

pub machine SymbolicResolverNode::new_type_size(data_type_ref: &DataTypeRef) -> SymbolicResolverNode {
    let data_type: DataTypeRef = DataTypeRef::clone(data_type_ref);
    (SymbolicResolverNode::TypeSize { data_type_ref: data_type })
}

// Upstream's `Binary {operator, left_node, right_node}` — child boxes are
// arena indices into the owning definition.
pub machine SymbolicResolverNode::new_binary(operator: SymbolicResolverBinaryOperator, left_node_index: u64, right_node_index: u64) -> SymbolicResolverNode {
    (SymbolicResolverNode::Binary {
        operator: operator,
        left_node_index: left_node_index,
        right_node_index: right_node_index,
    })
}

// Upstream's `Conditional {condition_node, true_node, false_node}` —
// arena indices likewise.
pub machine SymbolicResolverNode::new_conditional(condition_node_index: u64, true_node_index: u64, false_node_index: u64) -> SymbolicResolverNode {
    (SymbolicResolverNode::Conditional {
        condition_node_index: condition_node_index,
        true_node_index: true_node_index,
        false_node_index: false_node_index,
    })
}

pub machine SymbolicResolverNode::is_binary(symbolic_resolver_node: &SymbolicResolverNode) -> bool {
    transition symbolic_resolver_node {
        SymbolicResolverNode::Binary { operator, left_node_index, right_node_index } -> (true)
        _ -> (false)
    }
}

pub machine SymbolicResolverNode::is_conditional(symbolic_resolver_node: &SymbolicResolverNode) -> bool {
    transition symbolic_resolver_node {
        SymbolicResolverNode::Conditional { condition_node_index, true_node_index, false_node_index } -> (true)
        _ -> (false)
    }
}

// Arena indices carried by a Binary/Conditional arm — callers read them
// through these projections (none on other arms).
pub machine SymbolicResolverNode::get_left_node_index(symbolic_resolver_node: &SymbolicResolverNode) -> u64 {
    transition symbolic_resolver_node {
        SymbolicResolverNode::Binary { operator, left_node_index, right_node_index } -> (left_node_index)
        _ -> (0)
    }
}

pub machine SymbolicResolverNode::get_right_node_index(symbolic_resolver_node: &SymbolicResolverNode) -> u64 {
    transition symbolic_resolver_node {
        SymbolicResolverNode::Binary { operator, left_node_index, right_node_index } -> (right_node_index)
        _ -> (0)
    }
}

// Upstream `Clone` — every arm rebuilds through its payload's own clone.
pub machine SymbolicResolverNode::clone(symbolic_resolver_node: &SymbolicResolverNode) -> SymbolicResolverNode {
    transition symbolic_resolver_node {
        SymbolicResolverNode::Literal { literal_lo, literal_hi } -> clone_literal(symbolic_resolver_node, literal_lo, literal_hi)
        SymbolicResolverNode::LocalField { field_name, field_name_len } -> clone_local_field(symbolic_resolver_node, &field_name[0..256], field_name_len)
        SymbolicResolverNode::RelativeSymbolField { symbol_path } -> clone_relative_symbol_field(symbolic_resolver_node, &symbol_path)
        SymbolicResolverNode::GlobalSymbolField { module_name, module_name_len, symbol_path } -> clone_global_symbol_field(symbolic_resolver_node, &module_name[0..256], module_name_len, &symbol_path)
        SymbolicResolverNode::RelativePointerChain { pointer_chain } -> clone_relative_chain(symbolic_resolver_node, &pointer_chain)
        SymbolicResolverNode::GlobalPointerChain { pointer_chain } -> clone_global_chain(symbolic_resolver_node, &pointer_chain)
        SymbolicResolverNode::TypeSize { data_type_ref } -> clone_type_size(symbolic_resolver_node, &data_type_ref)
        SymbolicResolverNode::Binary { operator, left_node_index, right_node_index } -> clone_binary(symbolic_resolver_node, operator, left_node_index, right_node_index)
        SymbolicResolverNode::Conditional { condition_node_index, true_node_index, false_node_index } -> clone_conditional(symbolic_resolver_node, condition_node_index, true_node_index, false_node_index)
    }
    state clone_literal(symbolic_resolver_node: &SymbolicResolverNode, literal_lo: u64, literal_hi: u64) -> SymbolicResolverNode {
        (SymbolicResolverNode::Literal { literal_lo: literal_lo, literal_hi: literal_hi })
    }
    state clone_local_field(symbolic_resolver_node: &SymbolicResolverNode, field_name: &[u8], field_name_len: u64) -> SymbolicResolverNode {
        let mut name: [u8; 256];
        _ = copy_bounded_span(&mut name, field_name);
        (SymbolicResolverNode::LocalField { field_name: name, field_name_len: field_name_len })
    }
    state clone_relative_symbol_field(symbolic_resolver_node: &SymbolicResolverNode, symbol_path: &SymbolicResolverRelativeSymbolPath) -> SymbolicResolverNode {
        let mut path: SymbolicResolverRelativeSymbolPath = SymbolicResolverRelativeSymbolPath::default();
        SymbolicResolverRelativeSymbolPath::clone_from(&mut path, symbol_path);
        (SymbolicResolverNode::RelativeSymbolField { symbol_path: path })
    }
    state clone_global_symbol_field(symbolic_resolver_node: &SymbolicResolverNode, module_name: &[u8], module_name_len: u64, symbol_path: &SymbolicResolverRelativeSymbolPath) -> SymbolicResolverNode {
        let mut name: [u8; 256];
        _ = copy_bounded_span(&mut name, module_name);
        let mut path: SymbolicResolverRelativeSymbolPath = SymbolicResolverRelativeSymbolPath::default();
        SymbolicResolverRelativeSymbolPath::clone_from(&mut path, symbol_path);
        (SymbolicResolverNode::GlobalSymbolField {
            module_name: name,
            module_name_len: module_name_len,
            symbol_path: path,
        })
    }
    state clone_relative_chain(symbolic_resolver_node: &SymbolicResolverNode, pointer_chain: &OwnedSymbolicPointerChain) -> SymbolicResolverNode {
        let mut chain: OwnedSymbolicPointerChain = OwnedSymbolicPointerChain::default();
        OwnedSymbolicPointerChain::clone_from(&mut chain, pointer_chain);
        (SymbolicResolverNode::RelativePointerChain { pointer_chain: chain })
    }
    state clone_global_chain(symbolic_resolver_node: &SymbolicResolverNode, pointer_chain: &OwnedSymbolicPointerChain) -> SymbolicResolverNode {
        let mut chain: OwnedSymbolicPointerChain = OwnedSymbolicPointerChain::default();
        OwnedSymbolicPointerChain::clone_from(&mut chain, pointer_chain);
        (SymbolicResolverNode::GlobalPointerChain { pointer_chain: chain })
    }
    state clone_type_size(symbolic_resolver_node: &SymbolicResolverNode, data_type_ref: &DataTypeRef) -> SymbolicResolverNode {
        let data_type: DataTypeRef = DataTypeRef::clone(data_type_ref);
        (SymbolicResolverNode::TypeSize { data_type_ref: data_type })
    }
    state clone_binary(symbolic_resolver_node: &SymbolicResolverNode, operator: SymbolicResolverBinaryOperator, left_node_index: u64, right_node_index: u64) -> SymbolicResolverNode {
        (SymbolicResolverNode::Binary {
            operator: operator,
            left_node_index: left_node_index,
            right_node_index: right_node_index,
        })
    }
    state clone_conditional(symbolic_resolver_node: &SymbolicResolverNode, condition_node_index: u64, true_node_index: u64, false_node_index: u64) -> SymbolicResolverNode {
        (SymbolicResolverNode::Conditional {
            condition_node_index: condition_node_index,
            true_node_index: true_node_index,
            false_node_index: false_node_index,
        })
    }
}

pub machine SymbolicResolverNode::clone_from(symbolic_resolver_node: &mut SymbolicResolverNode, source: &SymbolicResolverNode) {
    let cloned: SymbolicResolverNode = SymbolicResolverNode::clone(source);
    symbolic_resolver_node = cloned;
}

machine copy_bounded_span(out: &mut [u8; 256], text: &[u8]) -> u64 {
    transition {
        _ -> copy(out, text, 0)
    }
    state copy(out: &mut [u8; 256], text: &[u8], position: u64) -> u64 {
        transition (position < text.len && position < 256) {
            true -> store(out, text, position)
            false -> (position)
        }
    }
    state store(out: &mut [u8; 256], text: &[u8], position: u64) -> u64
        requires 0 <= position && position < text.len
    {
        out[position] = text[position];
        transition {
            _ -> copy(out, text, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}
