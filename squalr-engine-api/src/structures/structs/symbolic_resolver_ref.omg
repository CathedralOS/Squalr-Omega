module src::structures::structs::symbolic_resolver_ref;

// Port of structures/structs/symbolic_resolver_definition.rs's
// `SymbolicResolverRef` — the resolver identity key.
// `resolver_id: String` -> bounded [u8; 256] + live length (authored-text
// carrier). Upstream `new` trims then rejects empty via `Option` — here a
// flag+payload carrier (`found: false` = upstream None).
pub data SymbolicResolverRef {
    resolver_id: [u8; 256];
    resolver_id_len: u64;
}

// Flag+payload carrier for upstream's `Option<SymbolicResolverRef>`.
pub data SymbolicResolverRefResult {
    found: bool;
    resolver_ref: SymbolicResolverRef;
}

pub machine SymbolicResolverRef::new(resolver_id: &[u8]) -> SymbolicResolverRefResult {
    let start: u64 = trim_left(resolver_id, 0, resolver_id.len);
    let end: u64 = trim_right(resolver_id, start, resolver_id.len);
    let width: u64 = ((end as u64 in Wrapping) - (start as u64 in Wrapping)) as u64;
    transition width > 0 && width <= 256 {
        true -> accept(resolver_id, start, width)
        false -> (SymbolicResolverRefResult { found: false, resolver_ref: (SymbolicResolverRef { resolver_id_len: 0 }) })
    }
    state accept(resolver_id: &[u8], start: u64, width: u64) -> SymbolicResolverRefResult {
        let mut created: SymbolicResolverRef = (SymbolicResolverRef { resolver_id_len: 0 });
        let copied: u64 = copy_span_window(&mut created.resolver_id, resolver_id, start, width);
        created.resolver_id_len = copied;
        (SymbolicResolverRefResult { found: true, resolver_ref: created })
    }
}

pub machine SymbolicResolverRef::get_resolver_id(&self) -> &[u8] {
    transition (self.resolver_id_len <= 256) {
        true -> (&self.resolver_id[0..self.resolver_id_len])
        false -> (&self.resolver_id[0..0])
        _ -> (&self.resolver_id[0..0])
    }
}

// ASCII whitespace edges (same idiom as the other span carriers).
machine byte_is_space(byte: u8) -> bool {
    (byte == 9 || byte == 10 || byte == 11 || byte == 12 || byte == 13 || byte == 32)
}

machine trim_left(text: &[u8], cursor: u64, end: u64) -> u64 {
    transition { _ -> probe(text, cursor, end) }
    state probe(text: &[u8], cursor: u64, end: u64) -> u64 {
        transition cursor < end && cursor < text.len {
            true -> space(text, cursor, end)
            false -> (cursor)
        }
    }
    state space(text: &[u8], cursor: u64, end: u64) -> u64 {
        transition byte_is_space(text[cursor]) {
            true -> probe(text, ((cursor as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, end)
            false -> (cursor)
        }
    }
}

machine trim_right(text: &[u8], start: u64, end: u64) -> u64 {
    transition { _ -> edge(text, start, end) }
    state edge(text: &[u8], start: u64, end: u64) -> u64 {
        transition end > start && end >= 1 {
            true -> look(text, start, end, ((end as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64)
            false -> (end)
        }
    }
    state look(text: &[u8], start: u64, end: u64, last: u64) -> u64 {
        transition last < text.len {
            true -> peek(text, start, end, last, text[last])
            false -> (end)
        }
    }
    state peek(text: &[u8], start: u64, end: u64, last: u64, byte: u8) -> u64 {
        transition byte_is_space(byte) {
            true -> edge(text, start, last)
            false -> (end)
        }
    }
}

// Bounded copy of text[start..start+width) — writes `width` bytes, returns
// the count written (bounded by the destination).
machine copy_span_window(out: &mut [u8; 256], text: &[u8], start: u64, width: u64) -> u64 {
    transition width <= 256 {
        true -> write(out, text, start, width, 0)
        false -> (0)
    }
    state write(out: &mut [u8; 256], text: &[u8], start: u64, width: u64, position: u64) -> u64 {
        transition position < width {
            true -> write_byte(out, text, start, width, position)
            false -> (position)
        }
    }
    state write_byte(out: &mut [u8; 256], text: &[u8], start: u64, width: u64, position: u64) -> u64 {
        let read_at: u64 = ((start as u64 in Wrapping) + (position as u64 in Wrapping)) as u64;
        transition read_at < text.len && position < out.len {
            true -> copy_byte(out, text, start, width, position, read_at)
            false -> (position)
        }
    }
    state copy_byte(out: &mut [u8; 256], text: &[u8], start: u64, width: u64, position: u64, read_at: u64) -> u64 {
        out[position] = text[read_at];
        transition { _ -> write(out, text, start, width, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Clone pair — upstream derives Clone.
pub machine SymbolicResolverRef::clone(source: &SymbolicResolverRef) -> SymbolicResolverRef {
    transition source.resolver_id_len <= 256 {
        true -> build(&source.resolver_id[0..source.resolver_id_len])
        false -> build(&source.resolver_id[0..256])
    }
    state build(resolver_id: &[u8]) -> SymbolicResolverRef {
        let mut copy: SymbolicResolverRef = (SymbolicResolverRef { resolver_id_len: 0 });
        let written: u64 = copy_span(copy.resolver_id, resolver_id);
        copy.resolver_id_len = written;
        (copy)
    }
}

pub machine SymbolicResolverRef::clone_from(&mut self, source: &SymbolicResolverRef) {
    let cloned: SymbolicResolverRef = SymbolicResolverRef::clone(source);
    self = cloned;
}

machine copy_span(out: &mut [u8; 256], text: &[u8]) -> u64 {
    transition {
        _ -> copy(out, text, 0)
    }
    state copy(out: &mut [u8; 256], text: &[u8], position: u64) -> u64 {
        transition position < text.len && position < 256 {
            true -> store(out, text, position)
            false -> (position)
        }
    }
    state store(out: &mut [u8; 256], text: &[u8], position: u64) -> u64
        requires position < text.len && position < 256
    {
        out[position] = text[position];
        transition {
            _ -> copy(out, text, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}
