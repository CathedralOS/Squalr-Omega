module src::structures::structs::symbolic_resolver_definition;

use src::structures::structs::symbolic_resolver_node::SymbolicResolverNode;

// Port of structures/structs/symbolic_resolver_definition.rs's
// `SymbolicResolverDefinition` {root_node} — upstream's owned expression
// tree. Deviation: recursion is proof-only in this pin, so nodes live in
// a bounded arena (128 entries, refusal past the bound) and
// root_node/Binary/Conditional children are arena indices — upstream's
// Box tree becomes position-handled. `SymbolicResolverRef` (a bare
// {resolver_id} carrier used by the project_symbols surface) rides that
// domain's leg; the evaluate*/resolve machinery rides the resolver leg.
pub data SymbolicResolverDefinition {
    nodes: [SymbolicResolverNode; 128];
    node_count: u64;
    root_node_index: u64;
}

pub machine SymbolicResolverDefinition::default() -> SymbolicResolverDefinition {
    (SymbolicResolverDefinition {
        node_count: 0,
        root_node_index: 0,
    })
}

// Upstream `new(root_node)`: arena position 0 is the root.
pub machine SymbolicResolverDefinition::new(root_node: SymbolicResolverNode) -> SymbolicResolverDefinition {
    let mut definition: SymbolicResolverDefinition = SymbolicResolverDefinition::default();
    _ = definition.add_node(root_node);
    definition.root_node_index = 0;
    (definition)
}

pub machine SymbolicResolverDefinition::new_empty() -> SymbolicResolverDefinition {
    (SymbolicResolverDefinition::default())
}

// Push a node into the arena; the return is its index. A return equal to
// node_count is upstream's unrepresentable overflow — refused.
pub machine SymbolicResolverDefinition::add_node(&mut self, node: SymbolicResolverNode) -> u64 {
    transition self.node_count < 128 {
        true -> store(node)
        false -> (self.node_count)
    }
    state store(&mut self, node: SymbolicResolverNode) -> u64 {
        self.nodes[self.node_count] = node;
        let position: u64 = self.node_count;
        self.node_count = ((self.node_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (position)
    }
}

pub machine SymbolicResolverDefinition::clone(&self) -> SymbolicResolverDefinition {
    let mut cloned: SymbolicResolverDefinition = SymbolicResolverDefinition::default();
    cloned.clone_from(self);
    (cloned)
}

pub machine SymbolicResolverDefinition::clone_from(&mut self, source: &SymbolicResolverDefinition) {
    self.node_count = 0;
    self.root_node_index = source.root_node_index;
    transition {
        _ -> copy_nodes(source, 0)
    }
    state copy_nodes(&mut self, source: &SymbolicResolverDefinition, position: u64) {
        transition position < source.node_count && position < 128 {
            true -> store_node(source, position)
            false -> finish_nodes(source)
        }
    }
    state store_node(&mut self, source: &SymbolicResolverDefinition, position: u64)
        requires position < source.node_count && position < 128
    {
        self.nodes[position].clone_from(&source.nodes[position]);
        transition {
            _ -> copy_nodes(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_nodes(&mut self, source: &SymbolicResolverDefinition) {
        self.node_count = source.node_count;
    }
}

pub machine SymbolicResolverDefinition::get_node_count(&self) -> u64 {
    (self.node_count)
}

// Upstream `get_root_node` — the node at root_node_index.
pub machine SymbolicResolverDefinition::get_root_node_index(&self) -> u64 {
    (self.root_node_index)
}

pub machine SymbolicResolverDefinition::set_root_node_index(&mut self, root_node_index: u64)
    requires root_node_index < self.node_count && root_node_index < 128
{
    self.root_node_index = root_node_index;
}

pub machine SymbolicResolverDefinition::get_node(&self, position: u64) -> &SymbolicResolverNode
    requires position < self.node_count && position < 128
{
    (&self.nodes[position])
}
