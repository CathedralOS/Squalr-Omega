module src::structures::structs::valued_struct;

use src::structures::data_values::data_value::DataValue;
use src::structures::structs::symbolic_struct_definition::SymbolicLayoutKind;
use src::structures::structs::symbolic_struct_ref::SymbolicStructRef;
use src::structures::structs::valued_struct_error::ValuedStructError;
use src::structures::structs::valued_struct_field::ValuedStructField;
use src::structures::structs::valued_struct_field::ValuedStructFieldData;
use src::structures::structs::valued_struct_field::copy_value_bytes;

// Port of structures/structs/valued_struct.rs: a struct's materialized
// values — a symbolic struct reference, a layout kind, and the editable
// fields produced by resolving the struct's symbol definition.
//
// Storage deviations (both follow the package's bounded-inline convention):
// - `fields: Vec<ValuedStructField>` becomes `[ValuedStructField; 64]` plus
//   `field_count` — a named deviation: structs wider than 64 fields truncate
//   on `set_field_data` append (upstream Vec is unbounded).
// - `ValuedStructFieldData::NestedStruct(Box<ValuedStruct>)` becomes an index
//   into `ValuedStructPool`, a bounded flat arena of ValuedStructs
//   ([ValuedStruct; 32]) — a direct inline `ValuedStruct` member would be
//   infinitely recursive retained storage, so the indirection lands as pool
//   indices (same translation as PointerScanNode::child_node_ids). Every
//   upstream method that dereferences the Box takes the pool explicitly.
// - The recursive upstream walks (`get_size_in_bytes`, `get_bytes`,
//   `copy_from_bytes`) are non-tail — runtime recursion is tail-only in this
//   pin, and measured call cycles admit same-`self` receivers only, so the
//   pool-resident descents run through an explicit pending stack of
//   `StructCursor` frames (bounded at the arena's 32 slots — a chain deeper
//   than the arena cannot exist). At the bound the descent refuses instead
//   of diverging or smashing the stack.
//
// Named deferral: `get_struct_layout` (SymbolResolver::get_struct_layout /
// Arc<SymbolicStructDefinition>) and `Display`/`FromStringPrivileged` string
// surfaces belong to the symbol-registry and CLI-formatter legs
// respectively; the resolver trait and struct-definition type ship with the
// former.
pub data ValuedStruct {
    symbolic_struct_ref: SymbolicStructRef;
    layout_kind: SymbolicLayoutKind;
    fields: [ValuedStructField; 64];
    field_count: u64;
}

// Flat arena of nested structs — indices carried by
// ValuedStructFieldData::NestedStruct. The pool's own ValuedStructs may host
// further NestedStruct indices into the same pool, giving arbitrary depth
// within the 32-struct bound.
pub data ValuedStructPool {
    structs: [ValuedStruct; 32];
    struct_count: u64;
}

// One paused ancestor level of the depth-first pool walk: which arena slot,
// which field to resume at, the base offset the level writes/reads at, and
// the running fold (sum for struct layout, max for union layout).
pub data StructCursor where 0 <= index, index < 32 {
    index: u64;
    resume_at: u64;
    base: u64;
    accum: u64;
}

pub machine ValuedStruct::new(
    symbolic_struct_ref: &SymbolicStructRef,
    fields: &[ValuedStructField]
) -> ValuedStruct {
    ValuedStruct::new_with_layout_kind(symbolic_struct_ref, SymbolicLayoutKind::Struct, fields)
}

// Upstream `new_with_layout_kind`.
pub machine ValuedStruct::new_with_layout_kind(
    symbolic_struct_ref: &SymbolicStructRef,
    layout_kind: SymbolicLayoutKind,
    fields: &[ValuedStructField]
) -> ValuedStruct {
    let mut valued_struct: ValuedStruct = ValuedStruct {
        symbolic_struct_ref: SymbolicStructRef::clone(symbolic_struct_ref),
        layout_kind: layout_kind,
        field_count: 0
    };
    ValuedStruct::fill_fields(&mut valued_struct, fields);
    valued_struct
}

// Upstream `new_anonymous`.
pub machine ValuedStruct::new_anonymous(fields: &[ValuedStructField]) -> ValuedStruct {
    ValuedStruct::new(&SymbolicStructRef::new_anonymous(), fields)
}

// Upstream `new_anonymous_with_layout_kind`.
pub machine ValuedStruct::new_anonymous_with_layout_kind(
    layout_kind: SymbolicLayoutKind,
    fields: &[ValuedStructField]
) -> ValuedStruct {
    ValuedStruct::new_with_layout_kind(&SymbolicStructRef::new_anonymous(), layout_kind, fields)
}

pub machine ValuedStruct::default() -> ValuedStruct {
    ValuedStruct::new_anonymous(&[])
}

pub machine ValuedStruct::clone_from(this: &mut ValuedStruct, source: &ValuedStruct) {
    this = ValuedStruct::clone(source);
}

pub machine ValuedStruct::clone(source: &ValuedStruct) -> ValuedStruct {
    let mut valued_struct: ValuedStruct = ValuedStruct {
        symbolic_struct_ref: SymbolicStructRef::clone(&source.symbolic_struct_ref),
        layout_kind: source.layout_kind,
        field_count: 0
    };
    ValuedStruct::copy_fields_window(&mut valued_struct, source, 0, source.field_count);
    valued_struct
}

machine ValuedStruct::fill_fields(this: &mut ValuedStruct, fields: &[ValuedStructField]) {
    transition { _ -> copy(this, fields, 0) }
    state copy(this: &mut ValuedStruct, fields: &[ValuedStructField], position: u64) {
        transition position < fields.len && position < 64 {
            true -> store(this, fields, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ValuedStruct, fields: &[ValuedStructField], position: u64)
        requires 0 <= position && position < 64
    {
        this.fields[position] = ValuedStructField::clone(&fields[position]);
        transition { _ -> copy(this, fields, position + 1) }
    }
    state finish(this: &mut ValuedStruct, count: u64) {
        this.field_count = count;
    }
}

machine ValuedStruct::copy_fields_window(this: &mut ValuedStruct, source: &ValuedStruct, start: u64, end: u64) {
    transition { _ -> copy(this, source, start, end, 0) }
    state copy(this: &mut ValuedStruct, source: &ValuedStruct, at: u64, end: u64, position: u64) {
        transition at < end && at < source.field_count && at < 64 && position < 64 {
            true -> store(this, source, at, end, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ValuedStruct, source: &ValuedStruct, at: u64, end: u64, position: u64)
        requires 0 <= at && at < 64 && 0 <= position && position < 64
    {
        this.fields[position] = ValuedStructField::clone(&source.fields[at]);
        transition { _ -> copy(this, source, at + 1, end, position + 1) }
    }
    state finish(this: &mut ValuedStruct, count: u64) {
        this.field_count = count;
    }
}

pub machine ValuedStruct::get_symbolic_struct_ref(this: &ValuedStruct) -> SymbolicStructRef {
    SymbolicStructRef::clone(&this.symbolic_struct_ref)
}

pub machine ValuedStruct::get_layout_kind(this: &ValuedStruct) -> SymbolicLayoutKind {
    this.layout_kind
}

pub machine ValuedStruct::get_field_count(this: &ValuedStruct) -> u64 {
    this.field_count
}

// Upstream `get_fields` — index access replaces the borrowed slice view.
pub machine ValuedStruct::get_field_at(this: &ValuedStruct, position: u64) -> ValuedStructField {
    transition position < this.field_count && position < 64 {
        true -> arm_result_165_0(this, position)
        _ -> (ValuedStructField::default())
    }
    state arm_result_165_0(this: &ValuedStruct, position: u64) -> ValuedStructField
    
    requires position < this.field_count && position < 64;
{
        (ValuedStructField::clone(&this.fields[position]))
    }
}

// Upstream `get_fields_mut` — caller mutates a slot in place.
pub machine ValuedStruct::set_field_at(this: &mut ValuedStruct, position: u64, field: &ValuedStructField) {
    transition position < this.field_count && position < 64 {
        true -> store(this, position, field)
        false -> done(this)
    }
    state store(this: &mut ValuedStruct, position: u64, field: &ValuedStructField)
        requires 0 <= position && position < 64
    {
        this.fields[position] = ValuedStructField::clone(field);
    }
    state done(this: &mut ValuedStruct) {
    }
}

// Upstream `get_size_in_bytes` — sum of field sizes, or max for unions.
// NestedStruct fields delegate to the pool's worklist walk.
pub machine ValuedStruct::get_size_in_bytes(this: &ValuedStruct, pool: &ValuedStructPool) -> u64 {
    let layout: SymbolicLayoutKind = this.layout_kind;
    transition layout {
        SymbolicLayoutKind::Union -> union_scan(this, 0, 0, pool)
        _ -> struct_scan(this, 0, 0, pool)
    }
    state union_scan(this: &ValuedStruct, position: u64, best: u64, pool: &ValuedStructPool) -> u64 {
        let count: u64 = this.field_count;
        transition position < count && position < 64 {
            true -> union_probe(this, position, best, pool)
            false -> (best)
        }
    }
    state union_probe(this: &ValuedStruct, position: u64, best: u64, pool: &ValuedStructPool) -> u64
        requires 0 <= position && position < 64
    {
        let field_size: u64 = ValuedStructField::get_size_in_bytes(&this.fields[position], pool);
        transition field_size > best {
            true -> union_scan(this, position + 1, field_size, pool)
            false -> union_scan(this, position + 1, best, pool)
            _ -> union_scan(this, position + 1, best, pool)
        }
    }
    state struct_scan(this: &ValuedStruct, position: u64, total: u64, pool: &ValuedStructPool) -> u64 {
        let count: u64 = this.field_count;
        transition position < count && position < 64 {
            true -> struct_probe(this, position, total, pool)
            false -> (total)
        }
    }
    state struct_probe(this: &ValuedStruct, position: u64, total: u64, pool: &ValuedStructPool) -> u64
        requires 0 <= position && position < 64
    {
        let field_size: u64 = ValuedStructField::get_size_in_bytes(&this.fields[position], pool);
        transition { _ -> struct_scan(this, position + 1, ((total as u64 in Wrapping) + (field_size as u64 in Wrapping)) as u64, pool) }
    }
}

// Upstream `get_field(field_name)` / `get_field_mut` — the borrowed-index
// surface is `(found, index)` plus slot access via get_field_at / set_at.
pub data ValuedStructFieldLookup [copy] {
    case Missing;
    case Found(index: u64);
}

pub machine ValuedStruct::find_field(this: &ValuedStruct, field_name: &[u8]) -> ValuedStructFieldLookup {
    transition { _ -> scan(this, 0, field_name) }
    state scan(this: &ValuedStruct, position: u64, field_name: &[u8]) -> ValuedStructFieldLookup {
        transition position < this.field_count && position < 64 {
            true -> compare(this, position, field_name)
            false -> (ValuedStructFieldLookup::Missing)
        }
    }
    state compare(this: &ValuedStruct, position: u64, field_name: &[u8]) -> ValuedStructFieldLookup
        requires 0 <= position && position < 64
    {
        let hoist1: bool = ValuedStructField::name_equals(&this.fields[position], field_name);
        transition hoist1 {
            true -> arm_result_245_0(position, field_name)
            false -> scan(this, position + 1, field_name)
            _ -> scan(this, position + 1, field_name)
        }
    }
    state arm_result_245_0(position: u64, field_name: &[u8]) -> ValuedStructFieldLookup
    {
        (ValuedStructFieldLookup::Found { index: position })
    }
}

// Upstream `set_field_data` — update in place when the name exists, else
// push a new field (bounded: appends at the 64-field bound truncate).
pub machine ValuedStruct::set_field_data(
    this: &mut ValuedStruct,
    field_name: &[u8],
    valued_field_data: &ValuedStructFieldData,
    is_read_only: bool
) {
    let lookup: ValuedStructFieldLookup = ValuedStruct::find_field(&this, field_name);
    transition lookup {
        ValuedStructFieldLookup::Found { index } -> check_found(this, index, valued_field_data)
        ValuedStructFieldLookup::Missing -> push(this, field_name, valued_field_data, is_read_only)
        _ -> done(this)
    }
    state check_found(this: &mut ValuedStruct, index: u64, valued_field_data: &ValuedStructFieldData) {
        transition index < this.field_count && index < 64 {
            true -> update(this, index, valued_field_data)
            false -> done(this)
            _ -> done(this)
        }
    }
    state update(this: &mut ValuedStruct, index: u64, valued_field_data: &ValuedStructFieldData)
        requires 0 <= index && index < 64
    {
        ValuedStructField::set_field_data(&mut this.fields[index], valued_field_data);
    }
    state push(this: &mut ValuedStruct, field_name: &[u8], valued_field_data: &ValuedStructFieldData, is_read_only: bool) {
        transition this.field_count < 64 {
            true -> append(this, field_name, valued_field_data, is_read_only)
            false -> done(this)
        }
    }
    state append(this: &mut ValuedStruct, field_name: &[u8], valued_field_data: &ValuedStructFieldData, is_read_only: bool) {
        // `this.field_count < 64` dominates this state through `push`, so the
        // index expression and the count store are both provably in range.
        this.fields[this.field_count] = ValuedStructField::new(field_name, valued_field_data, is_read_only);
        this.field_count = this.field_count + 1;
    }
    state done(this: &mut ValuedStruct) {
    }
}

// Upstream `remove_field` — drop the first name match and shift the tail.
pub machine ValuedStruct::remove_field(this: &mut ValuedStruct, field_name: &[u8]) -> bool {
    let lookup: ValuedStructFieldLookup = ValuedStruct::find_field(&this, field_name);
    transition lookup {
        ValuedStructFieldLookup::Found { index } -> check_index(this, index)
        ValuedStructFieldLookup::Missing -> (false)
        _ -> (false)
    }
    state check_index(this: &mut ValuedStruct, index: u64) -> bool {
        transition index < this.field_count && index < 64 {
            true -> shift(this, index)
            false -> (false)
            _ -> (false)
        }
    }
    state shift(this: &mut ValuedStruct, index: u64) -> bool
        requires 0 <= index && index < 64
    {
        transition { _ -> slide(this, index, index + 1) }
    }
    state slide(this: &mut ValuedStruct, at: u64, from: u64) -> bool {
        transition at < 64 && from < this.field_count && from < 64 {
            true -> move_one(this, at, from)
            false -> finish(this, at)
        }
    }
    state move_one(this: &mut ValuedStruct, at: u64, from: u64) -> bool
        requires 0 <= at && at < 64
    {
        transition from < 64 {
            true -> apply(this, at, from)
            false -> finish(this, at)
        }
    }
    state apply(this: &mut ValuedStruct, at: u64, from: u64) -> bool
        requires 0 <= at && at < 64 && 0 <= from && from < 64
    {
        this.fields[at] = ValuedStructField::clone(&this.fields[from]);
        transition { _ -> slide(this, at + 1, from + 1) }
    }
    state finish(this: &mut ValuedStruct, kept: u64) -> bool {
        this.field_count = kept;
        true
    }
}

// Upstream `get_bytes` — concatenated field bytes, or the union overlay
// (every field writes over offset zero). Writes into `out` at `at`,
// returning the byte count written.
pub machine ValuedStruct::get_bytes(this: &ValuedStruct, pool: &ValuedStructPool, out: &mut [u8], at: u64) -> u64 {
    let layout: SymbolicLayoutKind = this.layout_kind;
    transition layout {
        SymbolicLayoutKind::Union -> union_write(this, 0, pool, out, at)
        _ -> struct_write(this, 0, 0, pool, out, at)
    }
    state struct_write(this: &ValuedStruct, position: u64, written: u64, pool: &ValuedStructPool, out: &mut [u8], at: u64) -> u64 {
        let count: u64 = this.field_count;
        transition position < count && position < 64 {
            true -> struct_write_one(this, position, written, pool, out, at)
            false -> (written)
        }
    }
    state struct_write_one(this: &ValuedStruct, position: u64, written: u64, pool: &ValuedStructPool, out: &mut [u8], at: u64) -> u64
        requires 0 <= position && position < 64
    {
        let count: u64 = ValuedStructField::get_bytes(&this.fields[position], pool, out, ((at as u64 in Wrapping) + (written as u64 in Wrapping)) as u64);
        transition { _ -> struct_write(this, position + 1, ((written as u64 in Wrapping) + (count as u64 in Wrapping)) as u64, pool, out, at) }
    }
    // Union: overlay each field's bytes starting at the same `at`; upstream
    // writes min(remaining, field_len) — the caller's `out` must already be
    // sized to the union width (upstream allocates a zeroed Vec of
    // get_size_in_bytes, which is caller-visible here).
    state union_write(this: &ValuedStruct, position: u64, pool: &ValuedStructPool, out: &mut [u8], at: u64) -> u64 {
        let count: u64 = this.field_count;
        let hoist3: u64 = ValuedStruct::get_size_in_bytes(&this, pool);
        transition position < count && position < 64 {
            true -> union_write_one(this, position, pool, out, at)
            false -> (hoist3)
        }
    }
    state union_write_one(this: &ValuedStruct, position: u64, pool: &ValuedStructPool, out: &mut [u8], at: u64) -> u64
        requires 0 <= position && position < 64
    {
        let _written: u64 = ValuedStructField::get_bytes(&this.fields[position], pool, out, at);
        transition { _ -> union_write(this, position + 1, pool, out, at) }
    }
}

// Upstream `copy_from_bytes` — writes every field's slice of `bytes`.
// Struct layout walks fields sequentially; union layout hands the full
// window to every field. Returns false on size mismatch.
pub machine ValuedStruct::copy_from_bytes(this: &mut ValuedStruct, pool: &mut ValuedStructPool, bytes: &[u8]) -> bool {
    let expected: u64 = ValuedStruct::get_size_in_bytes(&this, pool);
    transition bytes.len == expected {
        true -> dispatch(this, this.layout_kind, bytes, pool)
        false -> (false)
        _ -> (false)
    }
    state dispatch(this: &mut ValuedStruct, layout_kind: SymbolicLayoutKind, bytes: &[u8], pool: &mut ValuedStructPool) -> bool {
        transition layout_kind {
            SymbolicLayoutKind::Union -> union_copy(this, 0, bytes, pool)
            _ -> struct_copy(this, 0, 0, bytes, pool)
        }
    }
    state struct_copy(this: &mut ValuedStruct, position: u64, offset: u64, bytes: &[u8], pool: &mut ValuedStructPool) -> bool {
        let count: u64 = this.field_count;
        transition position < count && position < 64 {
            true -> struct_copy_one(this, position, offset, bytes, pool)
            false -> (true)
        }
    }
    state struct_copy_one(this: &mut ValuedStruct, position: u64, offset: u64, bytes: &[u8], pool: &mut ValuedStructPool) -> bool
        requires 0 <= position && position < 64
    {
        let field_size: u64 = ValuedStructField::get_size_in_bytes(&this.fields[position], pool);
        let window_end: u64 = ((offset as u64 in Wrapping) + (field_size as u64 in Wrapping)) as u64;
        transition window_end <= bytes.len && offset <= window_end {
            true -> store_field(this, position, &bytes[offset..window_end], window_end, bytes, pool)
            false -> (false)
            _ -> (false)
        }
    }
    // The field is moved out of `this.fields` for the mutation — the indexed
    // member path isn't a writable machine receiver — then written back.
    state store_field(this: &mut ValuedStruct, position: u64, window: &[u8], window_end: u64, bytes: &[u8], pool: &mut ValuedStructPool) -> bool
        requires 0 <= position && position < 64
    {
        let mut field: ValuedStructField = ValuedStructField::clone(&this.fields[position]);
        let stored: bool = ValuedStructField::copy_from_bytes(&mut field, pool, window);
        this.fields[position] = field;
        transition stored {
            true -> struct_copy(this, position + 1, window_end, bytes, pool)
            false -> (false)
            _ -> (false)
        }
    }
    state union_copy(this: &mut ValuedStruct, position: u64, bytes: &[u8], pool: &mut ValuedStructPool) -> bool {
        let count: u64 = this.field_count;
        transition position < count && position < 64 {
            true -> union_copy_one(this, position, bytes, pool)
            false -> (true)
        }
    }
    state union_copy_one(this: &mut ValuedStruct, position: u64, bytes: &[u8], pool: &mut ValuedStructPool) -> bool
        requires 0 <= position && position < 64
    {
        let field_size: u64 = ValuedStructField::get_size_in_bytes(&this.fields[position], pool);
        transition field_size <= bytes.len {
            true -> union_apply(this, position, &bytes[0..field_size], bytes, pool)
            false -> (false)
            _ -> (false)
        }
    }
    state union_apply(this: &mut ValuedStruct, position: u64, window: &[u8], bytes: &[u8], pool: &mut ValuedStructPool) -> bool
        requires 0 <= position && position < 64
    {
        let mut field: ValuedStructField = ValuedStructField::clone(&this.fields[position]);
        let stored: bool = ValuedStructField::copy_from_bytes(&mut field, pool, window);
        this.fields[position] = field;
        transition stored {
            true -> union_copy(this, position + 1, bytes, pool)
            false -> (false)
            _ -> (false)
        }
    }
}

// Upstream `combine_exclusive` — fields present in every input struct.
// The port takes the head struct plus the peers slice and keeps the head's
// fields whose names appear in all peers. `head` rides as a state param —
// locals do not cross states in this pin.
pub machine ValuedStruct::combine_exclusive(
    head: &ValuedStruct,
    peers: &[ValuedStruct],
    pool: &ValuedStructPool
) -> ValuedStruct {
    transition { _ -> keep(0, head, ValuedStruct::new_anonymous_with_layout_kind(head.layout_kind, &[]), peers, pool) }
    state keep(
        position: u64,
        head: &ValuedStruct,
        kept: ValuedStruct,
        peers: &[ValuedStruct],
        pool: &ValuedStructPool
    ) -> ValuedStruct {
        transition position < head.field_count && position < 64 {
            true -> probe(position, head, kept, peers, pool)
            false -> (kept)
        }
    }
    state probe(
        position: u64,
        head: &ValuedStruct,
        kept: ValuedStruct,
        peers: &[ValuedStruct],
        pool: &ValuedStructPool
    ) -> ValuedStruct
        requires 0 <= position && position < 64
    {
        let field: ValuedStructField = ValuedStructField::clone(&head.fields[position]);
        let name: &[u8] = ValuedStructField::get_name(&field);
        let hoist2: bool = all_peers_have(name, peers);
        transition hoist2 {
            true -> absorb(position, head, kept, &field, peers, pool)
            false -> keep(position + 1, head, kept, peers, pool)
            _ -> keep(position + 1, head, kept, peers, pool)
        }
    }
    state absorb(
        position: u64,
        head: &ValuedStruct,
        kept: ValuedStruct,
        field: &ValuedStructField,
        peers: &[ValuedStruct],
        pool: &ValuedStructPool
    ) -> ValuedStruct {
        // Upstream retains the head's field order and payloads.
        let mut next: ValuedStruct = kept;
        ValuedStruct::append_field(&mut next, field);
        transition { _ -> keep(((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, head, next, peers, pool) }
    }
}

pub machine ValuedStruct::append_field(this: &mut ValuedStruct, field: &ValuedStructField) {
    transition this.field_count < 64 {
        true -> append(this, field)
        false -> done(this)
    }
    state append(this: &mut ValuedStruct, field: &ValuedStructField) {
        this.fields[this.field_count] = ValuedStructField::clone(field);
        this.field_count = this.field_count + 1;
    }
    state done(this: &mut ValuedStruct) {
    }
}

// Upstream's `iter().skip(1).all(...)` peer check as a flat scan.
machine all_peers_have(name: &[u8], peers: &[ValuedStruct]) -> bool {
    transition { _ -> scan(name, peers, 0) }
    state scan(name: &[u8], peers: &[ValuedStruct], position: u64) -> bool {
        transition position < peers.len {
            true -> check_peer(name, peers, position)
            false -> (true)
        }
    }
    state check_peer(name: &[u8], peers: &[ValuedStruct], position: u64) -> bool {
        let peer: ValuedStruct = ValuedStruct::clone(&peers[position]);
        let lookup: ValuedStructFieldLookup = ValuedStruct::find_field(peer, name);
        transition lookup {
            ValuedStructFieldLookup::Found { index } -> scan(name, peers, position + 1)
            ValuedStructFieldLookup::Missing -> (false)
            _ -> (false)
        }
    }
}

// ValuedStructPool — the flat arena NestedStruct indices address.
pub machine ValuedStructPool::empty() -> ValuedStructPool {
    ValuedStructPool { struct_count: 0 }
}

// Push a nested struct into the pool, returning its index (upstream's Box
// allocation point). At the 32-struct bound returns the bound — callers see
// `index < struct_count` as the validity check (refusal convention).
pub machine ValuedStructPool::clone(source: &ValuedStructPool) -> ValuedStructPool {
    let mut cloned: ValuedStructPool = ValuedStructPool::empty();
    ValuedStructPool::clone_from(&mut cloned, source);
    (cloned)
}

// Upstream `Clone` — copies the live slots; dead tail capacity is scratch.
pub machine ValuedStructPool::clone_from(this: &mut ValuedStructPool, source: &ValuedStructPool) {
    transition {
        _ -> copy(this, source, 0)
    }
    state copy(this: &mut ValuedStructPool, source: &ValuedStructPool, position: u64) {
        transition position < source.struct_count && position < 32 {
            true -> slot(this, source, position)
            _ -> accept(this, source)
        }
    }
    state slot(this: &mut ValuedStructPool, source: &ValuedStructPool, position: u64)
        requires position < source.struct_count && position < 32;
    {
        this.structs[position] = ValuedStruct::clone(&source.structs[position]);
        transition {
            _ -> copy(this, source, position + 1)
        }
    }
    state accept(this: &mut ValuedStructPool, source: &ValuedStructPool) {
        this.struct_count = source.struct_count;
    }
}

pub machine ValuedStructPool::push(this: &mut ValuedStructPool, nested: &ValuedStruct) -> u64 {
    transition this.struct_count < 32 {
        true -> store(this, nested)
        false -> (32)
    }
    state store(this: &mut ValuedStructPool, nested: &ValuedStruct) -> u64 {
        this.structs[this.struct_count] = ValuedStruct::clone(nested);
        this.struct_count = this.struct_count + 1;
        this.struct_count - 1
    }
}

pub machine ValuedStructPool::get_struct(this: &ValuedStructPool, index: u64) -> ValuedStruct {
    transition index < this.struct_count && index < 32 {
        true -> arm_result_569_0(this, index)
        _ -> (ValuedStruct::default())
    }
    state arm_result_569_0(this: &ValuedStructPool, index: u64) -> ValuedStruct
    
    requires index < this.struct_count && index < 32;
{
        (ValuedStruct::clone(&this.structs[index]))
    }
}

pub machine ValuedStructPool::set_struct(this: &mut ValuedStructPool, index: u64, nested: &ValuedStruct) {
    transition index < this.struct_count && index < 32 {
        true -> store(this, index, nested)
        false -> done(this)
        _ -> done(this)
    }
    state done(this: &mut ValuedStructPool) {
    }
    state store(this: &mut ValuedStructPool, index: u64, nested: &ValuedStruct)
        requires 0 <= index && index < 32
    {
        this.structs[index] = ValuedStruct::clone(nested);
    }
}

// Depth-first size walk over the arena with an explicit pending stack —
// runtime recursion is tail-only, and the accumulative walk cannot be tail.
// `accum` folds each level: sum under struct layout, max under union.
// Returns 0 when the index or descent exceeds the arena bounds.
pub machine ValuedStructPool::get_struct_size_in_bytes(this: &ValuedStructPool, index: u64) -> u64 {
    transition index < this.struct_count && index < 32 {
        true -> open(this, index)
        false -> (0)
        _ -> (0)
    }
    state open(this: &ValuedStructPool, index: u64) -> u64
        requires 0 <= index && index < 32
    {
        let pending: [StructCursor; 32];
        transition { _ -> visit(this, index, 0, 0, pending, 0) }
    }
    state visit(this: &ValuedStructPool, index: u64, position: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64) -> u64
        requires 0 <= index && index < 32 && 0 <= pending_count && pending_count <= 32
    {
        let count: u64 = this.structs[index].field_count;
        transition position < count && position < 64 {
            true -> field(this, index, position, accum, pending, pending_count)
            false -> finish(this, index, accum, pending, pending_count)
            _ -> finish(this, index, accum, pending, pending_count)
        }
    }
    state field(this: &ValuedStructPool, index: u64, position: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        transition this.structs[index].fields[position].field_data {
            ValuedStructFieldData::Value { value } -> leaf(this, index, position, accum, pending, pending_count, value)
            ValuedStructFieldData::NestedStruct { nested_struct_index } -> descend(this, index, position, accum, pending, pending_count, nested_struct_index)
            _ -> (0)
        }
    }
    state leaf(this: &ValuedStructPool, index: u64, position: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, value: &DataValue) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        let field_size: u64 = DataValue::get_size_in_bytes(&value);
        let union_layout: bool = SymbolicLayoutKind::is_union(&this.structs[index].layout_kind);
        transition union_layout {
            true -> fold_union(this, index, position, accum, field_size, pending, pending_count)
            false -> advance(this, index, position, ((accum as u64 in Wrapping) + (field_size as u64 in Wrapping)) as u64, pending, pending_count)
            _ -> (0)
        }
    }
    state fold_union(this: &ValuedStructPool, index: u64, position: u64, accum: u64, field_size: u64, pending: [StructCursor; 32], pending_count: u64) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        transition field_size > accum {
            true -> advance(this, index, position, field_size, pending, pending_count)
            false -> advance(this, index, position, accum, pending, pending_count)
            _ -> advance(this, index, position, accum, pending, pending_count)
        }
    }
    state advance(this: &ValuedStructPool, index: u64, position: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        transition { _ -> visit(this, index, position + 1, accum, pending, pending_count) }
    }
    state descend(this: &ValuedStructPool, index: u64, position: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, nested_index: u64) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        let count: u64 = this.struct_count;
        transition pending_count < 32 && nested_index < count && nested_index < 32 {
            true -> push(this, index, position, accum, pending, pending_count, nested_index)
            false -> (0)
            _ -> (0)
        }
    }
    state push(this: &ValuedStructPool, index: u64, position: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, nested_index: u64) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32 && 0 <= nested_index && nested_index < 32
    {
        transition pending_count < 32 {
            true -> apply(this, index, position, accum, pending, pending_count, nested_index)
            false -> (0)
            _ -> (0)
        }
    }
    state apply(this: &ValuedStructPool, index: u64, position: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, nested_index: u64) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count < 32 && 0 <= nested_index && nested_index < 32
    {
        let mut pending_next: [StructCursor; 32] = pending;
        pending_next[pending_count] = StructCursor { index: index, resume_at: position + 1, base: 0, accum: accum };
        transition { _ -> visit(this, nested_index, 0, 0, pending_next, pending_count + 1) }
    }
    state finish(this: &ValuedStructPool, index: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64) -> u64
        requires 0 <= index && index < 32 && 0 <= pending_count && pending_count <= 32
    {
        transition pending_count > 0 {
            true -> resume(this, accum, pending, pending_count, index)
            false -> (accum)
            _ -> (accum)
        }
    }
    state resume(this: &ValuedStructPool, child_size: u64, pending: [StructCursor; 32], pending_count: u64, index: u64) -> u64
        requires 1 <= pending_count && pending_count <= 32
    {
        // `pending_count > 0` dominates from `finish`, so pending_count - 1
        // lands in [0..31] — the pending pop's own index is provable.
        let frame: StructCursor = pending[pending_count - 1];
        let parent_union: bool = SymbolicLayoutKind::is_union(&this.structs[frame.index].layout_kind);
        transition parent_union {
            true -> resume_union(this, frame, child_size, pending, pending_count - 1, index)
            false -> resume_struct(this, frame, child_size, pending, pending_count - 1, index)
            _ -> (0)
        }
    }
    state resume_union(this: &ValuedStructPool, frame: StructCursor, child_size: u64, pending: [StructCursor; 32], pending_count: u64, index: u64) -> u64
        requires 0 <= pending_count && pending_count <= 32
    {
        transition child_size > frame.accum {
            true -> visit(this, frame.index, frame.resume_at, child_size, pending, pending_count)
            false -> visit(this, frame.index, frame.resume_at, frame.accum, pending, pending_count)
            _ -> visit(this, frame.index, frame.resume_at, frame.accum, pending, pending_count)
        }
    }
    state resume_struct(this: &ValuedStructPool, frame: StructCursor, child_size: u64, pending: [StructCursor; 32], pending_count: u64, index: u64) -> u64
        requires 0 <= pending_count && pending_count <= 32
    {
        transition { _ -> visit(this, frame.index, frame.resume_at, ((frame.accum as u64 in Wrapping) + (child_size as u64 in Wrapping)) as u64, pending, pending_count) }
    }
}

// Depth-first byte write over the arena — concatenated field bytes in
// struct order; union levels overlay every field at their level's `base`.
// Returns the folded size (the written length), or 0 past the bounds.
pub machine ValuedStructPool::get_struct_bytes(this: &ValuedStructPool, index: u64, out: &mut [u8], at: u64) -> u64 {
    transition index < this.struct_count && index < 32 {
        true -> open(this, index, out, at)
        false -> (0)
        _ -> (0)
    }
    state open(this: &ValuedStructPool, index: u64, out: &mut [u8], at: u64) -> u64
        requires 0 <= index && index < 32
    {
        let pending: [StructCursor; 32];
        transition { _ -> visit(this, index, 0, at, 0, pending, 0, out) }
    }
    state visit(this: &ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, out: &mut [u8]) -> u64
        requires 0 <= index && index < 32 && 0 <= pending_count && pending_count <= 32
    {
        let count: u64 = this.structs[index].field_count;
        transition position < count && position < 64 {
            true -> field(this, index, position, base, accum, pending, pending_count, out)
            false -> finish(this, index, accum, pending, pending_count, out)
            _ -> finish(this, index, accum, pending, pending_count, out)
        }
    }
    state field(this: &ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, out: &mut [u8]) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        transition this.structs[index].fields[position].field_data {
            ValuedStructFieldData::Value { value } -> write_value(this, index, position, base, accum, pending, pending_count, value, out)
            ValuedStructFieldData::NestedStruct { nested_struct_index } -> descend(this, index, position, base, accum, pending, pending_count, nested_struct_index, out)
            _ -> (0)
        }
    }
    state write_value(this: &ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, value: &DataValue, out: &mut [u8]) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        let field_size: u64 = DataValue::get_size_in_bytes(&value);
        let union_layout: bool = SymbolicLayoutKind::is_union(&this.structs[index].layout_kind);
        transition union_layout {
            true -> write_at(this, index, position, base, accum, field_size, base, pending, pending_count, value, out)
            false -> write_at(this, index, position, base, accum, field_size, ((base as u64 in Wrapping) + (accum as u64 in Wrapping)) as u64, pending, pending_count, value, out)
            _ -> (0)
        }
    }
    state write_at(this: &ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, field_size: u64, write_at: u64, pending: [StructCursor; 32], pending_count: u64, value: &DataValue, out: &mut [u8]) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        let _written: u64 = copy_value_bytes(value, out, write_at);
        transition { _ -> fold_value(this, index, position, base, accum, field_size, pending, pending_count, out) }
    }
    state fold_value(this: &ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, field_size: u64, pending: [StructCursor; 32], pending_count: u64, out: &mut [u8]) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        let union_layout: bool = SymbolicLayoutKind::is_union(&this.structs[index].layout_kind);
        transition union_layout {
            true -> fold_union(this, index, position, base, accum, field_size, pending, pending_count, out)
            false -> visit(this, index, position + 1, base, ((accum as u64 in Wrapping) + (field_size as u64 in Wrapping)) as u64, pending, pending_count, out)
            _ -> (0)
        }
    }
    state fold_union(this: &ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, field_size: u64, pending: [StructCursor; 32], pending_count: u64, out: &mut [u8]) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        transition field_size > accum {
            true -> visit(this, index, position + 1, base, field_size, pending, pending_count, out)
            false -> visit(this, index, position + 1, base, accum, pending, pending_count, out)
            _ -> visit(this, index, position + 1, base, accum, pending, pending_count, out)
        }
    }
    state descend(this: &ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, nested_index: u64, out: &mut [u8]) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        let count: u64 = this.struct_count;
        transition pending_count < 32 && nested_index < count && nested_index < 32 {
            true -> push(this, index, position, base, accum, pending, pending_count, nested_index, out)
            false -> (0)
            _ -> (0)
        }
    }
    state push(this: &ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, nested_index: u64, out: &mut [u8]) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32 && 0 <= nested_index && nested_index < 32
    {
        transition pending_count < 32 {
            true -> apply(this, index, position, base, accum, pending, pending_count, nested_index, out)
            false -> (0)
            _ -> (0)
        }
    }
    state apply(this: &ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, nested_index: u64, out: &mut [u8]) -> u64
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count < 32 && 0 <= nested_index && nested_index < 32
    {
        let mut pending_next: [StructCursor; 32] = pending;
        let union_layout: bool = SymbolicLayoutKind::is_union(&this.structs[index].layout_kind);
        pending_next[pending_count] = StructCursor { index: index, resume_at: position + 1, base: base, accum: accum };
        transition union_layout {
            true -> visit(this, nested_index, 0, base, 0, pending_next, pending_count + 1, out)
            false -> visit(this, nested_index, 0, ((base as u64 in Wrapping) + (accum as u64 in Wrapping)) as u64, 0, pending_next, pending_count + 1, out)
            _ -> (0)
        }
    }
    state finish(this: &ValuedStructPool, index: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, out: &mut [u8]) -> u64
        requires 0 <= index && index < 32 && 0 <= pending_count && pending_count <= 32
    {
        transition pending_count > 0 {
            true -> resume(this, accum, pending, pending_count, out, index)
            false -> (accum)
            _ -> (accum)
        }
    }
    state resume(this: &ValuedStructPool, child_size: u64, pending: [StructCursor; 32], pending_count: u64, out: &mut [u8], index: u64) -> u64
        requires 1 <= pending_count && pending_count <= 32
    {
        let frame: StructCursor = pending[pending_count - 1];
        let parent_union: bool = SymbolicLayoutKind::is_union(&this.structs[frame.index].layout_kind);
        transition parent_union {
            true -> resume_union(this, frame, child_size, pending, pending_count - 1, out, index)
            false -> resume_struct(this, frame, child_size, pending, pending_count - 1, out, index)
            _ -> (0)
        }
    }
    state resume_union(this: &ValuedStructPool, frame: StructCursor, child_size: u64, pending: [StructCursor; 32], pending_count: u64, out: &mut [u8], index: u64) -> u64
        requires 0 <= pending_count && pending_count <= 32
    {
        transition child_size > frame.accum {
            true -> visit(this, frame.index, frame.resume_at, frame.base, child_size, pending, pending_count, out)
            false -> visit(this, frame.index, frame.resume_at, frame.base, frame.accum, pending, pending_count, out)
            _ -> visit(this, frame.index, frame.resume_at, frame.base, frame.accum, pending, pending_count, out)
        }
    }
    state resume_struct(this: &ValuedStructPool, frame: StructCursor, child_size: u64, pending: [StructCursor; 32], pending_count: u64, out: &mut [u8], index: u64) -> u64
        requires 0 <= pending_count && pending_count <= 32
    {
        transition { _ -> visit(this, frame.index, frame.resume_at, frame.base, ((frame.accum as u64 in Wrapping) + (child_size as u64 in Wrapping)) as u64, pending, pending_count, out) }
    }
}

// Depth-first copy into the arena — the mirror of get_struct_bytes: each
// Value field reads its slice of `bytes` at `base + accum` (struct levels)
// or `base` (union levels), matching upstream's windowed layout. Returns
// false on a window underrun or a bound refusal.
pub machine ValuedStructPool::copy_struct_from_bytes(this: &mut ValuedStructPool, index: u64, bytes: &[u8]) -> bool {
    transition index < this.struct_count && index < 32 {
        true -> open(this, index, bytes)
        false -> (false)
        _ -> (false)
    }
    state open(this: &mut ValuedStructPool, index: u64, bytes: &[u8]) -> bool
        requires 0 <= index && index < 32
    {
        let pending: [StructCursor; 32];
        transition { _ -> visit(this, index, 0, 0, 0, pending, 0, bytes) }
    }
    state visit(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8]) -> bool
        requires 0 <= index && index < 32 && 0 <= pending_count && pending_count <= 32
    {
        let count: u64 = this.structs[index].field_count;
        transition position < count && position < 64 {
            true -> field(this, index, position, base, accum, pending, pending_count, bytes)
            false -> finish(this, index, accum, pending, pending_count, bytes)
            _ -> finish(this, index, accum, pending, pending_count, bytes)
        }
    }
    state field(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8]) -> bool
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        transition this.structs[index].fields[position].field_data {
            ValuedStructFieldData::Value { value } -> measure_value(this, index, position, base, accum, pending, pending_count, bytes, DataValue::get_size_in_bytes(value))
            ValuedStructFieldData::NestedStruct { nested_struct_index } -> descend(this, index, position, base, accum, pending, pending_count, nested_struct_index, bytes)
            _ -> (false)
        }
    }
    state measure_value(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8], field_size: u64) -> bool
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        let union_layout: bool = SymbolicLayoutKind::is_union(&this.structs[index].layout_kind);
        transition union_layout {
            true -> check_window(this, index, position, base, accum, field_size, base, pending, pending_count, bytes)
            false -> check_window(this, index, position, base, accum, field_size, ((base as u64 in Wrapping) + (accum as u64 in Wrapping)) as u64, pending, pending_count, bytes)
            _ -> (false)
        }
    }
    state check_window(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, field_size: u64, read_at: u64, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8]) -> bool
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        let window_end: u64 = ((read_at as u64 in Wrapping) + (field_size as u64 in Wrapping)) as u64;
        transition window_end <= bytes.len && read_at <= bytes.len {
            true -> store_value(this, index, position, base, accum, field_size, read_at, window_end, pending, pending_count, bytes)
            false -> (false)
            _ -> (false)
        }
    }
    state store_value(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, field_size: u64, read_at: u64, window_end: u64, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8]) -> bool
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        let mut updated: DataValue = ValuedStructField::get_data_value(&this.structs[index].fields[position]);
        transition { _ -> apply_slice(this, index, position, base, accum, field_size, updated, pending, pending_count, bytes, read_at, window_end) }
    }
    state apply_slice(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, field_size: u64, updated: DataValue, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8], read_at: u64, window_end: u64) -> bool
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        transition read_at <= window_end && window_end <= bytes.len {
            true -> copy_value(this, index, position, base, accum, field_size, updated, pending, pending_count, bytes, &bytes[read_at..window_end])
            false -> (false)
            _ -> (false)
        }
    }
    state copy_value(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, field_size: u64, updated: DataValue, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8], window: &[u8]) -> bool
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        let mut written: DataValue = updated;
        let stored: bool = DataValue::copy_from_bytes(&mut written, window);
        transition stored {
            true -> writeback_value(this, index, position, base, accum, field_size, written, pending, pending_count, bytes)
            false -> (false)
            _ -> (false)
        }
    }
    state writeback_value(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, field_size: u64, updated: DataValue, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8]) -> bool
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        ValuedStructField::set_field_data(&mut this.structs[index].fields[position], &ValuedStructFieldData::Value { value: updated });
        transition { _ -> fold_value(this, index, position, base, accum, field_size, pending, pending_count, bytes) }
    }
    state fold_value(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, field_size: u64, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8]) -> bool
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        let union_layout: bool = SymbolicLayoutKind::is_union(&this.structs[index].layout_kind);
        transition union_layout {
            true -> fold_union(this, index, position, base, accum, field_size, pending, pending_count, bytes)
            false -> visit(this, index, position + 1, base, ((accum as u64 in Wrapping) + (field_size as u64 in Wrapping)) as u64, pending, pending_count, bytes)
            _ -> (false)
        }
    }
    state fold_union(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, field_size: u64, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8]) -> bool
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        transition field_size > accum {
            true -> visit(this, index, position + 1, base, field_size, pending, pending_count, bytes)
            false -> visit(this, index, position + 1, base, accum, pending, pending_count, bytes)
            _ -> visit(this, index, position + 1, base, accum, pending, pending_count, bytes)
        }
    }
    state descend(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, nested_index: u64, bytes: &[u8]) -> bool
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32
    {
        let count: u64 = this.struct_count;
        transition pending_count < 32 && nested_index < count && nested_index < 32 {
            true -> push(this, index, position, base, accum, pending, pending_count, nested_index, bytes)
            false -> (false)
            _ -> (false)
        }
    }
    state push(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, nested_index: u64, bytes: &[u8]) -> bool
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count <= 32 && 0 <= nested_index && nested_index < 32
    {
        transition pending_count < 32 {
            true -> apply(this, index, position, base, accum, pending, pending_count, nested_index, bytes)
            false -> (false)
            _ -> (false)
        }
    }
    state apply(this: &mut ValuedStructPool, index: u64, position: u64, base: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, nested_index: u64, bytes: &[u8]) -> bool
        requires 0 <= index && index < 32 && 0 <= position && position < 64 && 0 <= pending_count && pending_count < 32 && 0 <= nested_index && nested_index < 32
    {
        let mut pending_next: [StructCursor; 32] = pending;
        let union_layout: bool = SymbolicLayoutKind::is_union(&this.structs[index].layout_kind);
        pending_next[pending_count] = StructCursor { index: index, resume_at: position + 1, base: base, accum: accum };
        transition union_layout {
            true -> visit(this, nested_index, 0, base, 0, pending_next, pending_count + 1, bytes)
            false -> visit(this, nested_index, 0, ((base as u64 in Wrapping) + (accum as u64 in Wrapping)) as u64, 0, pending_next, pending_count + 1, bytes)
            _ -> (false)
        }
    }
    state finish(this: &mut ValuedStructPool, index: u64, accum: u64, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8]) -> bool
        requires 0 <= index && index < 32 && 0 <= pending_count && pending_count <= 32
    {
        transition pending_count > 0 {
            true -> resume(this, accum, pending, pending_count, bytes, index)
            false -> (true)
            _ -> (true)
        }
    }
    state resume(this: &mut ValuedStructPool, child_size: u64, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8], index: u64) -> bool
        requires 1 <= pending_count && pending_count <= 32
    {
        let frame: StructCursor = pending[pending_count - 1];
        let parent_union: bool = SymbolicLayoutKind::is_union(&this.structs[frame.index].layout_kind);
        transition parent_union {
            true -> resume_union(this, frame, child_size, pending, pending_count - 1, bytes, index)
            false -> resume_struct(this, frame, child_size, pending, pending_count - 1, bytes, index)
            _ -> (false)
        }
    }
    state resume_union(this: &mut ValuedStructPool, frame: StructCursor, child_size: u64, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8], index: u64) -> bool
        requires 0 <= pending_count && pending_count <= 32
    {
        transition child_size > frame.accum {
            true -> visit(this, frame.index, frame.resume_at, frame.base, child_size, pending, pending_count, bytes)
            false -> visit(this, frame.index, frame.resume_at, frame.base, frame.accum, pending, pending_count, bytes)
            _ -> visit(this, frame.index, frame.resume_at, frame.base, frame.accum, pending, pending_count, bytes)
        }
    }
    state resume_struct(this: &mut ValuedStructPool, frame: StructCursor, child_size: u64, pending: [StructCursor; 32], pending_count: u64, bytes: &[u8], index: u64) -> bool
        requires 0 <= pending_count && pending_count <= 32
    {
        transition { _ -> visit(this, frame.index, frame.resume_at, frame.base, ((frame.accum as u64 in Wrapping) + (child_size as u64 in Wrapping)) as u64, pending, pending_count, bytes) }
    }
}
