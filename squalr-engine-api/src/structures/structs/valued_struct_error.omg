module src::structures::structs::valued_struct_error;

use src::structures::structs::symbolic_struct_ref::SymbolicStructRef;

// Port of structures/structs/valued_struct_error.rs: the refusal reasons of
// valued-struct symbol resolution — an anonymous struct has no namespace to
// resolve, and a named struct may not be registered.
//
// Upstream is a thiserror enum; the byte domain has no error-carrier trait,
// so the port is a closed-sum data type carrying the same payload.
pub data ValuedStructError {
    case AnonymousStructReference;
    case SymbolicStructNotRegistered(symbolic_struct_namespace: SymbolicStructRef);
}

// Upstream `ValuedStructError::symbolic_struct_not_registered`.
pub machine ValuedStructError::symbolic_struct_not_registered(
    symbolic_struct_namespace: &[u8]
) -> ValuedStructError {
    ValuedStructError::SymbolicStructNotRegistered {
        symbolic_struct_namespace: SymbolicStructRef::new(symbolic_struct_namespace)
    }
}
