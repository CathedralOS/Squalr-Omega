module src::structures::structs::symbolic_resolver_callbacks;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::structs::owned_symbolic_pointer_chain::OwnedSymbolicPointerChain;
use src::structures::structs::symbolic_resolver_evaluation_error::SymbolicResolverEvaluationError;
use src::structures::structs::symbolic_resolver_relative_symbol_path::SymbolicResolverRelativeSymbolPath;

// Upstream's `lookup_local_field: Fn(&str) -> Option<i128>` — the i128
// answer carries as a {lo, hi} two's-complement pair.
pub data SymbolicResolverLookupResult [copy] {
    found: bool;
    value_lo: u64;
    value_hi: u64;
}

// Upstream's `resolve_type_size_in_bytes: Fn(&DataTypeRef) -> Option<u64>`.
pub data SymbolicResolverSizeResult [copy] {
    found: bool;
    size_in_bytes: u64;
}

// Upstream's `Result<i128, SymbolicResolverEvaluationError>` — Resolved
// carries the i128 value as a {lo, hi} pair; Failed carries the error
// union payload whole.
pub data SymbolicResolverEvaluationResult {
    case Resolved(value_lo: u64, value_hi: u64);
    case Failed(error: SymbolicResolverEvaluationError);
}

// The evaluate-time provider boundary: upstream threads six closure
// parameters (`lookup_local_field`, `resolve_type_size_in_bytes`, and the
// four relative/global symbol-field + pointer-chain resolvers) through its
// evaluate* layers. Omega has no first-class closures, so the boundary is
// a trait — each caller implements it on its own record and passes
// `&mut SymbolicResolverCallbacks` (trait-typed params dispatch to the
// concrete type's `satisfies` machines).
//
// Upstream's `FnMut` receivers map to `&mut self` (the global resolver
// tracks a visited-resolver cycle set across calls). The two required
// hooks (local-field lookup, type-size) have no upstream defaults; the
// four chain/path resolvers are where upstream's shallower wrappers
// plugged in `Unknown*` errors — callers that don't resolve a given arm
// implement that hook by returning `Failed` with the matching Unknown*
// variant, reproducing the defaulted wrapper behavior exactly.
pub trait SymbolicResolverCallbacks {
    machine lookup_local_field(
        receiver: &mut Self,
        field_name: &[u8]
    ) -> SymbolicResolverLookupResult;

    machine resolve_type_size_in_bytes(
        receiver: &mut Self,
        data_type_ref: &DataTypeRef
    ) -> SymbolicResolverSizeResult;

    machine resolve_relative_symbol_field(
        receiver: &mut Self,
        symbol_path: &SymbolicResolverRelativeSymbolPath
    ) -> SymbolicResolverEvaluationResult;

    machine resolve_global_symbol_field(
        receiver: &mut Self,
        module_name: &[u8],
        symbol_path: &SymbolicResolverRelativeSymbolPath
    ) -> SymbolicResolverEvaluationResult;

    machine resolve_relative_pointer_chain(
        receiver: &mut Self,
        pointer_chain: &OwnedSymbolicPointerChain
    ) -> SymbolicResolverEvaluationResult;

    machine resolve_global_pointer_chain(
        receiver: &mut Self,
        pointer_chain: &OwnedSymbolicPointerChain
    ) -> SymbolicResolverEvaluationResult;
}
