module src::structures::structs::symbolic_resolver_binary_operator;

use src::structures::text_windows::byte_is_space;
use src::structures::text_windows::trim_left;
use src::structures::text_windows::trim_right;

// Port of structures/structs/symbolic_resolver_definition.rs's
// `SymbolicResolverBinaryOperator` — the arithmetic/bitwise/compare
// operators a Binary resolver node can carry, upstream declaration order.
pub data SymbolicResolverBinaryOperator [copy] {
    case Add;
    case Subtract;
    case Multiply;
    case Divide;
    case Modulo;
    case BitwiseAnd;
    case BitwiseOr;
    case BitwiseXor;
    case ShiftLeft;
    case ShiftRight;
    case Minimum;
    case Maximum;
    case Equal;
    case NotEqual;
    case LessThan;
    case LessThanOrEqual;
    case GreaterThan;
    case GreaterThanOrEqual;
}

use src::structures::structs::symbolic_resolver_i128::ResolverI128;
use src::structures::structs::symbolic_resolver_i128::ResolverI128Math;
use src::structures::structs::symbolic_resolver_evaluation_error::SymbolicResolverEvaluationError;
use src::structures::structs::symbolic_resolver_callbacks::SymbolicResolverEvaluationResult;

// Upstream `SymbolicResolverBinaryOperator::ALL` — declaration order.
pub machine SymbolicResolverBinaryOperator::all() -> [SymbolicResolverBinaryOperator; 18] {
    let mut all: [SymbolicResolverBinaryOperator; 18];
    all[0] = SymbolicResolverBinaryOperator::Add;
    all[1] = SymbolicResolverBinaryOperator::Subtract;
    all[2] = SymbolicResolverBinaryOperator::Multiply;
    all[3] = SymbolicResolverBinaryOperator::Divide;
    all[4] = SymbolicResolverBinaryOperator::Modulo;
    all[5] = SymbolicResolverBinaryOperator::BitwiseAnd;
    all[6] = SymbolicResolverBinaryOperator::BitwiseOr;
    all[7] = SymbolicResolverBinaryOperator::BitwiseXor;
    all[8] = SymbolicResolverBinaryOperator::ShiftLeft;
    all[9] = SymbolicResolverBinaryOperator::ShiftRight;
    all[10] = SymbolicResolverBinaryOperator::Minimum;
    all[11] = SymbolicResolverBinaryOperator::Maximum;
    all[12] = SymbolicResolverBinaryOperator::Equal;
    all[13] = SymbolicResolverBinaryOperator::NotEqual;
    all[14] = SymbolicResolverBinaryOperator::LessThan;
    all[15] = SymbolicResolverBinaryOperator::LessThanOrEqual;
    all[16] = SymbolicResolverBinaryOperator::GreaterThan;
    all[17] = SymbolicResolverBinaryOperator::GreaterThanOrEqual;
    (all)
}

// Upstream `label()` — the display spelling of each operator.
pub machine SymbolicResolverBinaryOperator::label(&self) -> &[u8] {
    transition self {
        SymbolicResolverBinaryOperator::Add -> ("+")
        SymbolicResolverBinaryOperator::Subtract -> ("-")
        SymbolicResolverBinaryOperator::Multiply -> ("*")
        SymbolicResolverBinaryOperator::Divide -> ("/")
        SymbolicResolverBinaryOperator::Modulo -> ("%")
        SymbolicResolverBinaryOperator::BitwiseAnd -> ("&")
        SymbolicResolverBinaryOperator::BitwiseOr -> ("|")
        SymbolicResolverBinaryOperator::BitwiseXor -> ("^")
        SymbolicResolverBinaryOperator::ShiftLeft -> ("<<")
        SymbolicResolverBinaryOperator::ShiftRight -> (">>")
        SymbolicResolverBinaryOperator::Minimum -> ("min")
        SymbolicResolverBinaryOperator::Maximum -> ("max")
        SymbolicResolverBinaryOperator::Equal -> ("==")
        SymbolicResolverBinaryOperator::NotEqual -> ("!=")
        SymbolicResolverBinaryOperator::LessThan -> ("<")
        SymbolicResolverBinaryOperator::LessThanOrEqual -> ("<=")
        SymbolicResolverBinaryOperator::GreaterThan -> (">")
        SymbolicResolverBinaryOperator::GreaterThanOrEqual -> (">=")
    }
}

// Upstream `key()` — the stable serialization spelling.
pub machine SymbolicResolverBinaryOperator::key(&self) -> &[u8] {
    transition self {
        SymbolicResolverBinaryOperator::Add -> ("add")
        SymbolicResolverBinaryOperator::Subtract -> ("subtract")
        SymbolicResolverBinaryOperator::Multiply -> ("multiply")
        SymbolicResolverBinaryOperator::Divide -> ("divide")
        SymbolicResolverBinaryOperator::Modulo -> ("modulo")
        SymbolicResolverBinaryOperator::BitwiseAnd -> ("bitwise_and")
        SymbolicResolverBinaryOperator::BitwiseOr -> ("bitwise_or")
        SymbolicResolverBinaryOperator::BitwiseXor -> ("bitwise_xor")
        SymbolicResolverBinaryOperator::ShiftLeft -> ("shift_left")
        SymbolicResolverBinaryOperator::ShiftRight -> ("shift_right")
        SymbolicResolverBinaryOperator::Minimum -> ("minimum")
        SymbolicResolverBinaryOperator::Maximum -> ("maximum")
        SymbolicResolverBinaryOperator::Equal -> ("equal")
        SymbolicResolverBinaryOperator::NotEqual -> ("not_equal")
        SymbolicResolverBinaryOperator::LessThan -> ("less_than")
        SymbolicResolverBinaryOperator::LessThanOrEqual -> ("less_than_or_equal")
        SymbolicResolverBinaryOperator::GreaterThan -> ("greater_than")
        SymbolicResolverBinaryOperator::GreaterThanOrEqual -> ("greater_than_or_equal")
    }
}

pub data SymbolicResolverBinaryOperatorMatch [copy] {
    found: bool;
    operator: SymbolicResolverBinaryOperator;
}

// Upstream `from_key` — trims then finds over ALL.
pub machine SymbolicResolverBinaryOperator::from_key(key: &[u8]) -> SymbolicResolverBinaryOperatorMatch {
    let start: u64 = trim_left(key, 0, key.len);
    let end: u64 = trim_right(key, start, key.len);
    transition {
        _ -> step(key, start, end, 0)
    }
    state step(key: &[u8], start: u64, end: u64, case_index: u64) -> SymbolicResolverBinaryOperatorMatch {
        transition case_index < 18 {
            true -> compare_at(key, start, end, case_index)
            false -> (SymbolicResolverBinaryOperatorMatch { found: false, operator: SymbolicResolverBinaryOperator::Add })
        }
    }
    state compare_at(key: &[u8], start: u64, end: u64, case_index: u64) -> SymbolicResolverBinaryOperatorMatch {
        let operator: SymbolicResolverBinaryOperator = operator_at(case_index);
        let operator_key: &[u8] = operator.key();
        let same: bool = window_equals(key, start, end, operator_key);
        transition same {
            true -> (SymbolicResolverBinaryOperatorMatch { found: true, operator: operator })
            false -> step(key, start, end, ((case_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// Ordered by upstream ALL.
machine operator_at(case_index: u64) -> SymbolicResolverBinaryOperator {
    transition case_index {
        0 -> (SymbolicResolverBinaryOperator::Add)
        1 -> (SymbolicResolverBinaryOperator::Subtract)
        2 -> (SymbolicResolverBinaryOperator::Multiply)
        3 -> (SymbolicResolverBinaryOperator::Divide)
        4 -> (SymbolicResolverBinaryOperator::Modulo)
        5 -> (SymbolicResolverBinaryOperator::BitwiseAnd)
        6 -> (SymbolicResolverBinaryOperator::BitwiseOr)
        7 -> (SymbolicResolverBinaryOperator::BitwiseXor)
        8 -> (SymbolicResolverBinaryOperator::ShiftLeft)
        9 -> (SymbolicResolverBinaryOperator::ShiftRight)
        10 -> (SymbolicResolverBinaryOperator::Minimum)
        11 -> (SymbolicResolverBinaryOperator::Maximum)
        12 -> (SymbolicResolverBinaryOperator::Equal)
        13 -> (SymbolicResolverBinaryOperator::NotEqual)
        14 -> (SymbolicResolverBinaryOperator::LessThan)
        15 -> (SymbolicResolverBinaryOperator::LessThanOrEqual)
        16 -> (SymbolicResolverBinaryOperator::GreaterThan)
        _ -> (SymbolicResolverBinaryOperator::GreaterThanOrEqual)
    }
}

// Window-vs-span byte equality: text[start..end) == candidate.
machine window_equals(text: &[u8], start: u64, end: u64, candidate: &[u8]) -> bool {
    let width: u64 = ((end as u64 in Wrapping) - (start as u64 in Wrapping)) as u64;
    transition width == candidate.len && start <= end && end <= text.len {
        true -> scan(text, start, width, candidate, 0)
        false -> (false)
    }
    state scan(text: &[u8], start: u64, width: u64, candidate: &[u8], position: u64) -> bool {
        transition position < width && position < candidate.len {
            true -> compare_at(text, start, width, candidate, position)
            false -> (true)
        }
    }
    state compare_at(text: &[u8], start: u64, width: u64, candidate: &[u8], position: u64) -> bool {
        let read_at: u64 = ((start as u64 in Wrapping) + (position as u64 in Wrapping)) as u64;
        transition read_at < text.len {
            true -> match_byte(text, start, width, candidate, position, read_at)
            false -> (false)
        }
    }
    state match_byte(text: &[u8], start: u64, width: u64, candidate: &[u8], position: u64, read_at: u64) -> bool {
        transition text[read_at] == candidate[position] {
            true -> scan(text, start, width, candidate, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> (false)
        }
    }
}

// Upstream `evaluate(left, right) -> Result<i128, EvaluationError>` —
// i128 operands/results carry as ResolverI128 {lo, hi} pairs.
pub machine SymbolicResolverBinaryOperator::evaluate(
    &self,
    left: &ResolverI128,
    right: &ResolverI128
) -> SymbolicResolverEvaluationResult {
    transition self {
        SymbolicResolverBinaryOperator::Add -> eval_checked(left, right, 0)
        SymbolicResolverBinaryOperator::Subtract -> eval_checked(left, right, 1)
        SymbolicResolverBinaryOperator::Multiply -> eval_checked(left, right, 2)
        SymbolicResolverBinaryOperator::Divide -> eval_div_rem(left, right, 0)
        SymbolicResolverBinaryOperator::Modulo -> eval_div_rem(left, right, 1)
        SymbolicResolverBinaryOperator::BitwiseAnd -> eval_bitwise(left, right, 0)
        SymbolicResolverBinaryOperator::BitwiseOr -> eval_bitwise(left, right, 1)
        SymbolicResolverBinaryOperator::BitwiseXor -> eval_bitwise(left, right, 2)
        SymbolicResolverBinaryOperator::ShiftLeft -> eval_shift(left, right, 0)
        SymbolicResolverBinaryOperator::ShiftRight -> eval_shift(left, right, 1)
        SymbolicResolverBinaryOperator::Minimum -> eval_min_max(left, right, 0)
        SymbolicResolverBinaryOperator::Maximum -> eval_min_max(left, right, 1)
        SymbolicResolverBinaryOperator::Equal -> eval_compare(left, right, 0)
        SymbolicResolverBinaryOperator::NotEqual -> eval_compare(left, right, 1)
        SymbolicResolverBinaryOperator::LessThan -> eval_compare(left, right, 2)
        SymbolicResolverBinaryOperator::LessThanOrEqual -> eval_compare(left, right, 3)
        SymbolicResolverBinaryOperator::GreaterThan -> eval_compare(left, right, 4)
        SymbolicResolverBinaryOperator::GreaterThanOrEqual -> eval_compare(left, right, 5)
    }
    // Add/Subtract/Multiply — checked_* overflow -> ArithmeticOverflow.
    state eval_checked(&self, left: &ResolverI128, right: &ResolverI128, which: u64) -> SymbolicResolverEvaluationResult {
        transition which == 0 {
            true -> checked_add(left, right)
            false -> pick_sub_mul(left, right, which)
        }
    }
    state checked_add(&self, left: &ResolverI128, right: &ResolverI128) -> SymbolicResolverEvaluationResult {
        let outcome: ResolverI128Math = left.checked_add(right);
        let mapped: SymbolicResolverEvaluationResult = map_checked(outcome);
        (mapped)
    }
    state pick_sub_mul(&self, left: &ResolverI128, right: &ResolverI128, which: u64) -> SymbolicResolverEvaluationResult {
        transition which == 1 {
            true -> checked_sub(left, right)
            false -> checked_mul(left, right)
        }
    }
    state checked_sub(&self, left: &ResolverI128, right: &ResolverI128) -> SymbolicResolverEvaluationResult {
        let outcome: ResolverI128Math = left.checked_sub(right);
        let mapped: SymbolicResolverEvaluationResult = map_checked(outcome);
        (mapped)
    }
    state checked_mul(&self, left: &ResolverI128, right: &ResolverI128) -> SymbolicResolverEvaluationResult {
        let outcome: ResolverI128Math = left.checked_mul(right);
        let mapped: SymbolicResolverEvaluationResult = map_checked(outcome);
        (mapped)
    }
    // Divide/Modulo — zero divisor -> DivisionByZero before checked div/rem.
    state eval_div_rem(&self, left: &ResolverI128, right: &ResolverI128, which: u64) -> SymbolicResolverEvaluationResult {
        let zero: bool = right.is_zero();
        transition zero {
            true -> (SymbolicResolverEvaluationResult::Failed { error: SymbolicResolverEvaluationError::DivisionByZero })
            false -> pick_div_rem(left, right, which)
        }
    }
    state pick_div_rem(&self, left: &ResolverI128, right: &ResolverI128, which: u64) -> SymbolicResolverEvaluationResult {
        transition which == 0 {
            true -> checked_div(left, right)
            false -> checked_rem(left, right)
        }
    }
    state checked_div(&self, left: &ResolverI128, right: &ResolverI128) -> SymbolicResolverEvaluationResult {
        let outcome: ResolverI128Math = left.checked_div(right);
        let mapped: SymbolicResolverEvaluationResult = map_checked(outcome);
        (mapped)
    }
    state checked_rem(&self, left: &ResolverI128, right: &ResolverI128) -> SymbolicResolverEvaluationResult {
        let outcome: ResolverI128Math = left.checked_rem(right);
        let mapped: SymbolicResolverEvaluationResult = map_checked(outcome);
        (mapped)
    }
    // Bitwise ops — pure bit logic, never error.
    state eval_bitwise(&self, left: &ResolverI128, right: &ResolverI128, which: u64) -> SymbolicResolverEvaluationResult {
        transition which == 0 {
            true -> bit_and(left, right)
            false -> pick_or_xor(left, right, which)
        }
    }
    state bit_and(&self, left: &ResolverI128, right: &ResolverI128) -> SymbolicResolverEvaluationResult {
        let lo_r: u64 = ((left.lo as u64 in Wrapping) & (right.lo as u64 in Wrapping)) as u64;
        let hi_r: u64 = ((left.hi as u64 in Wrapping) & (right.hi as u64 in Wrapping)) as u64;
        (SymbolicResolverEvaluationResult::Resolved { value_lo: lo_r, value_hi: hi_r })
    }
    state pick_or_xor(&self, left: &ResolverI128, right: &ResolverI128, which: u64) -> SymbolicResolverEvaluationResult {
        transition which == 1 {
            true -> bit_or(left, right)
            false -> bit_xor(left, right)
        }
    }
    state bit_or(&self, left: &ResolverI128, right: &ResolverI128) -> SymbolicResolverEvaluationResult {
        let lo_r: u64 = ((left.lo as u64 in Wrapping) | (right.lo as u64 in Wrapping)) as u64;
        let hi_r: u64 = ((left.hi as u64 in Wrapping) | (right.hi as u64 in Wrapping)) as u64;
        (SymbolicResolverEvaluationResult::Resolved { value_lo: lo_r, value_hi: hi_r })
    }
    state bit_xor(&self, left: &ResolverI128, right: &ResolverI128) -> SymbolicResolverEvaluationResult {
        let lo_r: u64 = ((left.lo as u64 in Wrapping) ^ (right.lo as u64 in Wrapping)) as u64;
        let hi_r: u64 = ((left.hi as u64 in Wrapping) ^ (right.hi as u64 in Wrapping)) as u64;
        (SymbolicResolverEvaluationResult::Resolved { value_lo: lo_r, value_hi: hi_r })
    }
    // Shifts — upstream `u32::try_from(right)` fails below 0 or above
    // u32::MAX; `checked_shl/shr` then fail at >= 128. Both fold into one
    // invalid-window check producing InvalidShiftAmount(right).
    state eval_shift(&self, left: &ResolverI128, right: &ResolverI128, which: u64) -> SymbolicResolverEvaluationResult {
        let negative: bool = right.is_negative();
        transition negative || right.hi != 0 || right.lo >= 128 {
            true -> (SymbolicResolverEvaluationResult::Failed {
                error: (SymbolicResolverEvaluationError::InvalidShiftAmount {
                    shift_amount_lo: right.lo,
                    shift_amount_hi: right.hi,
                })
            })
            false -> apply_shift(left, right, which)
        }
    }
    state apply_shift(&self, left: &ResolverI128, right: &ResolverI128, which: u64) -> SymbolicResolverEvaluationResult {
        transition which == 0 {
            true -> shift_left(left, right)
            false -> shift_right(left, right)
        }
    }
    state shift_left(&self, left: &ResolverI128, right: &ResolverI128) -> SymbolicResolverEvaluationResult {
        let shifted: ResolverI128 = left.shift_left(right.lo);
        (SymbolicResolverEvaluationResult::Resolved { value_lo: shifted.lo, value_hi: shifted.hi })
    }
    state shift_right(&self, left: &ResolverI128, right: &ResolverI128) -> SymbolicResolverEvaluationResult {
        let shifted: ResolverI128 = left.shift_right(right.lo);
        (SymbolicResolverEvaluationResult::Resolved { value_lo: shifted.lo, value_hi: shifted.hi })
    }
    // Minimum/Maximum — the comparator picks the value.
    state eval_min_max(&self, left: &ResolverI128, right: &ResolverI128, which: u64) -> SymbolicResolverEvaluationResult {
        let ordering: i64 = left.compare(right);
        transition which == 0 {
            true -> pick_min(left, right, ordering)
            false -> pick_max(left, right, ordering)
        }
    }
    state pick_min(&self, left: &ResolverI128, right: &ResolverI128, ordering: i64) -> SymbolicResolverEvaluationResult {
        transition ordering < 0 {
            true -> (SymbolicResolverEvaluationResult::Resolved { value_lo: left.lo, value_hi: left.hi })
            false -> (SymbolicResolverEvaluationResult::Resolved { value_lo: right.lo, value_hi: right.hi })
            _ -> (SymbolicResolverEvaluationResult::Resolved { value_lo: right.lo, value_hi: right.hi })
        }
    }
    state pick_max(&self, left: &ResolverI128, right: &ResolverI128, ordering: i64) -> SymbolicResolverEvaluationResult {
        transition ordering > 0 {
            true -> (SymbolicResolverEvaluationResult::Resolved { value_lo: left.lo, value_hi: left.hi })
            false -> (SymbolicResolverEvaluationResult::Resolved { value_lo: right.lo, value_hi: right.hi })
            _ -> (SymbolicResolverEvaluationResult::Resolved { value_lo: right.lo, value_hi: right.hi })
        }
    }
    // Compares — i128::from(bool).
    state eval_compare(&self, left: &ResolverI128, right: &ResolverI128, which: u64) -> SymbolicResolverEvaluationResult {
        let ordering: i64 = left.compare(right);
        let same: bool = left.equal_to(right);
        transition which == 0 {
            true -> compare_equal(same)
            false -> pick_compare(left, right, which, ordering, same)
        }
    }
    state compare_equal(&self, same: bool) -> SymbolicResolverEvaluationResult {
        transition same {
            true -> resolved_bool(true)
            false -> resolved_bool(false)
        }
    }
    state pick_compare(&self, left: &ResolverI128, right: &ResolverI128, which: u64, ordering: i64, same: bool) -> SymbolicResolverEvaluationResult {
        transition which == 1 {
            true -> compare_not_equal(same)
            false -> pick_ordered(which, ordering, same)
        }
    }
    state compare_not_equal(&self, same: bool) -> SymbolicResolverEvaluationResult {
        transition same {
            true -> resolved_bool(false)
            false -> resolved_bool(true)
        }
    }
    state pick_ordered(&self, which: u64, ordering: i64, same: bool) -> SymbolicResolverEvaluationResult {
        transition which == 2 {
            true -> compare_less(ordering)
            false -> pick_ge(which, ordering, same)
        }
    }
    state compare_less(&self, ordering: i64) -> SymbolicResolverEvaluationResult {
        transition ordering < 0 {
            true -> resolved_bool(true)
            false -> resolved_bool(false)
        }
    }
    state pick_ge(&self, which: u64, ordering: i64, same: bool) -> SymbolicResolverEvaluationResult {
        transition which == 3 {
            true -> compare_less_equal(ordering)
            false -> pick_gt(which, ordering)
        }
    }
    state compare_less_equal(&self, ordering: i64) -> SymbolicResolverEvaluationResult {
        transition ordering <= 0 {
            true -> resolved_bool(true)
            false -> resolved_bool(false)
        }
    }
    state pick_gt(&self, which: u64, ordering: i64) -> SymbolicResolverEvaluationResult {
        transition which == 4 {
            true -> compare_greater(ordering)
            false -> compare_greater_equal(ordering)
        }
    }
    state compare_greater(&self, ordering: i64) -> SymbolicResolverEvaluationResult {
        transition ordering > 0 {
            true -> resolved_bool(true)
            false -> resolved_bool(false)
        }
    }
    state compare_greater_equal(&self, ordering: i64) -> SymbolicResolverEvaluationResult {
        transition ordering >= 0 {
            true -> resolved_bool(true)
            false -> resolved_bool(false)
        }
    }
    state resolved_bool(&self, value: bool) -> SymbolicResolverEvaluationResult {
        let resolved: ResolverI128 = ResolverI128::from_bool(value);
        (SymbolicResolverEvaluationResult::Resolved { value_lo: resolved.lo, value_hi: resolved.hi })
    }
}

// Shared checked_* -> Result mapping — None becomes ArithmeticOverflow.
machine map_checked(outcome: ResolverI128Math) -> SymbolicResolverEvaluationResult {
    transition outcome.ok {
        true -> (SymbolicResolverEvaluationResult::Resolved {
            value_lo: outcome.value.lo,
            value_hi: outcome.value.hi,
        })
        false -> (SymbolicResolverEvaluationResult::Failed {
            error: SymbolicResolverEvaluationError::ArithmeticOverflow
        })
    }
}
