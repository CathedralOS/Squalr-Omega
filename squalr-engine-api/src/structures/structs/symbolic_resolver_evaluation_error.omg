module src::structures::structs::symbolic_resolver_evaluation_error;

// Port of the `SymbolicResolverEvaluationError` enum declared in
// structures/structs/symbolic_resolver_definition.rs (upstream line ~773).
// Every variant rides 1:1; `String` payloads land on the package's bounded
// [u8; 256] + live-length carrier, and `InvalidShiftAmount(i128)` carries
// the shift operand as a {lo, hi} two's-complement pair (no i128 primitive).
pub data SymbolicResolverEvaluationError {
    case UnknownLocalField(field_name: [u8; 256], field_name_len: u64);
    case UnknownRelativeSymbolPath(symbol_path: [u8; 256], symbol_path_len: u64);
    case UnknownGlobalSymbolPath(symbol_path: [u8; 256], symbol_path_len: u64);
    case AmbiguousGlobalSymbolPath(symbol_path: [u8; 256], symbol_path_len: u64);
    case UnknownRelativePointerChain(symbol_path: [u8; 256], symbol_path_len: u64);
    case UnknownGlobalPointerChain(symbol_path: [u8; 256], symbol_path_len: u64);
    case UnknownTypeSize(data_type: [u8; 256], data_type_len: u64);
    case ResolverCycle(resolver_id: [u8; 256], resolver_id_len: u64);
    case DivisionByZero;
    case InvalidShiftAmount(shift_amount_lo: u64, shift_amount_hi: u64);
    case ArithmeticOverflow;
}
