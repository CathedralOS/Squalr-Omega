module src::structures::structs::owned_symbolic_pointer_chain;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::bounded_slice::bounded_slice;

use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use src::structures::memory::symbolic_pointer_chain::SymbolicPointerChainLink;

// Owned projection of upstream `SymbolicPointerChain` {module_name, links:
// Vec<SymbolicPointerChainLink>, pointer_size} for records that own their
// chain — resolver nodes and paths. The existing
// `SymbolicPointerChain<'links>` is a borrowed link-slice view for scan
// evaluation; an owned record cannot carry it without a provider lifetime,
// so the owned shape lives here under an Owned prefix (upstream's owned
// type is the same name — collision documented).
// Upstream's Vec carries the honest bound of 64 links with refusal.
pub data OwnedSymbolicPointerChain {
    module_name: [u8; 256];
    module_name_len: u64;
    links: [SymbolicPointerChainLink; 64];
    link_count: u64;
    pointer_size: PointerScanPointerSize;
}

pub machine OwnedSymbolicPointerChain::default() -> OwnedSymbolicPointerChain {
    (OwnedSymbolicPointerChain {
        module_name_len: 0,
        link_count: 0,
        pointer_size: PointerScanPointerSize::default(),
    })
}

pub machine OwnedSymbolicPointerChain::new(module_name: &[u8], pointer_size: PointerScanPointerSize) -> OwnedSymbolicPointerChain {
    let mut chain: OwnedSymbolicPointerChain = (OwnedSymbolicPointerChain {
        module_name_len: 0,
        link_count: 0,
        pointer_size: pointer_size,
    });
    chain.set_module_name(module_name);
    (chain)
}

pub machine OwnedSymbolicPointerChain::get_module_name(&self) -> &[u8] {
    bounded_slice(&self.module_name[0..256], self.module_name_len)
}

pub machine OwnedSymbolicPointerChain::set_module_name(&mut self, module_name: &[u8]) {
    self.module_name_len = BoundedByteCopy::copy(&mut self.module_name[0..256], module_name);
}

pub machine OwnedSymbolicPointerChain::get_link_count(&self) -> u64 {
    (self.link_count)
}

pub machine OwnedSymbolicPointerChain::get_link(&self, position: u64) -> SymbolicPointerChainLink
    requires position < self.link_count && position < 64
{
    (self.links[position])
}

pub machine OwnedSymbolicPointerChain::get_pointer_size(&self) -> PointerScanPointerSize {
    (self.pointer_size)
}

pub machine OwnedSymbolicPointerChain::set_pointer_size(&mut self, pointer_size: PointerScanPointerSize) {
    self.pointer_size = pointer_size;
}

// Upstream `links.push` — refusal past the bound.
pub machine OwnedSymbolicPointerChain::add_link(&mut self, link: SymbolicPointerChainLink) -> bool {
    transition self.link_count < 64 {
        true -> store(link)
        false -> (false)
    }
    state store(&mut self, link: SymbolicPointerChainLink) -> bool {
        self.links[self.link_count] = link;
        self.link_count = ((self.link_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine OwnedSymbolicPointerChain::clone_from(&mut self, source: &OwnedSymbolicPointerChain) {
    self.link_count = 0;
    self.pointer_size = source.pointer_size;
    let _: u64 = BoundedByteCopy::copy(&mut self.module_name[0..256], bounded_slice(&source.module_name[0..256], source.module_name_len));
    self.module_name_len = source.module_name_len;
    transition {
        _ -> copy_links(source, 0)
    }
    state copy_links(&mut self, source: &OwnedSymbolicPointerChain, position: u64) {
        transition position < source.link_count && position < 64 {
            true -> store_link(source, position)
            false -> finish_links(source)
        }
    }
    state store_link(&mut self, source: &OwnedSymbolicPointerChain, position: u64)
        requires position < source.link_count && position < 64
    {
        self.links[position] = source.links[position];
        transition {
            _ -> copy_links(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_links(&mut self, source: &OwnedSymbolicPointerChain) {
        self.link_count = source.link_count;
    }
}
