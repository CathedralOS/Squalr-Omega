module src::structures::structs::owned_symbolic_pointer_chain;

use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use src::structures::memory::symbolic_pointer_chain::SymbolicLinkOffset;
use src::structures::memory::symbolic_pointer_chain::SymbolicPointerChainLink;
use src::structures::memory::symbolic_pointer_chain::SymbolicTailOffsets;

// Owned projection of upstream `SymbolicPointerChain` {module_name, links:
// Vec<SymbolicPointerChainLink>, pointer_size} for records that own their
// chain — resolver nodes and paths. The existing
// `SymbolicPointerChain<'links>` is a borrowed link-slice view for scan
// evaluation; an owned record cannot carry it without a provider lifetime,
// so the owned shape lives here under an Owned prefix (upstream's owned
// type is the same name — collision documented).
// Upstream's Vec carries the honest bound of 64 links with refusal.
pub data OwnedSymbolicPointerChain {
    module_name: [u8; 256];
    module_name_len: u64;
    links: [SymbolicPointerChainLink; 64];
    link_count: u64;
    pointer_size: PointerScanPointerSize;
}

pub machine OwnedSymbolicPointerChain::default() -> OwnedSymbolicPointerChain {
    (OwnedSymbolicPointerChain {
        module_name_len: 0,
        link_count: 0,
        pointer_size: PointerScanPointerSize::default(),
    })
}

pub machine OwnedSymbolicPointerChain::new(module_name: &[u8], pointer_size: PointerScanPointerSize) -> OwnedSymbolicPointerChain {
    let mut chain: OwnedSymbolicPointerChain = (OwnedSymbolicPointerChain {
        module_name_len: 0,
        link_count: 0,
        pointer_size: pointer_size,
    });
    OwnedSymbolicPointerChain::set_module_name(&mut chain, module_name);
    (chain)
}

pub machine OwnedSymbolicPointerChain::get_module_name(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain) -> &[u8] {
    transition owned_symbolic_pointer_chain.module_name_len <= 256 {
        true -> (&owned_symbolic_pointer_chain.module_name[0..owned_symbolic_pointer_chain.module_name_len])
        false -> (&owned_symbolic_pointer_chain.module_name[0..256])
        _ -> (&owned_symbolic_pointer_chain.module_name[0..256])
    }
}

pub machine OwnedSymbolicPointerChain::set_module_name(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, module_name: &[u8]) {
    owned_symbolic_pointer_chain.module_name_len = 0;
    transition {
        _ -> copy(owned_symbolic_pointer_chain, module_name, 0)
    }
    state copy(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(owned_symbolic_pointer_chain, module_name, position)
            false -> finish(owned_symbolic_pointer_chain, position)
        }
    }
    state store(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, module_name: &[u8], position: u64) {
        owned_symbolic_pointer_chain.module_name[position] = module_name[position];
        transition {
            _ -> copy(owned_symbolic_pointer_chain, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, count: u64) {
        owned_symbolic_pointer_chain.module_name_len = count;
    }
}

pub machine OwnedSymbolicPointerChain::get_link_count(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain) -> u64 {
    (owned_symbolic_pointer_chain.link_count)
}

pub machine OwnedSymbolicPointerChain::get_link(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain, position: u64) -> SymbolicPointerChainLink
    requires position < 64
{
    (owned_symbolic_pointer_chain.links[position])
}

pub machine OwnedSymbolicPointerChain::get_pointer_size(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain) -> PointerScanPointerSize {
    (owned_symbolic_pointer_chain.pointer_size)
}

pub machine OwnedSymbolicPointerChain::set_pointer_size(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, pointer_size: PointerScanPointerSize) {
    owned_symbolic_pointer_chain.pointer_size = pointer_size;
}

// Upstream `links.push` — refusal past the bound.
pub machine OwnedSymbolicPointerChain::add_link(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, link: SymbolicPointerChainLink) -> bool {
    transition owned_symbolic_pointer_chain.link_count < 64 {
        true -> store(owned_symbolic_pointer_chain, link)
        false -> (false)
    }
    state store(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, link: SymbolicPointerChainLink) -> bool {
        owned_symbolic_pointer_chain.links[owned_symbolic_pointer_chain.link_count] = link;
        owned_symbolic_pointer_chain.link_count = ((owned_symbolic_pointer_chain.link_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine OwnedSymbolicPointerChain::clone_from(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain) {
    owned_symbolic_pointer_chain.link_count = 0;
    owned_symbolic_pointer_chain.pointer_size = source.pointer_size;
    transition {
        _ -> copy_name(owned_symbolic_pointer_chain, source, 0)
    }
    state copy_name(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain, position: u64) {
        transition position < source.module_name_len && position < 256 {
            true -> store_name(owned_symbolic_pointer_chain, source, position)
            false -> finish_name(owned_symbolic_pointer_chain, source)
        }
    }
    state store_name(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain, position: u64) {
        owned_symbolic_pointer_chain.module_name[position] = source.module_name[position];
        transition {
            _ -> copy_name(owned_symbolic_pointer_chain, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_name(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain) {
        owned_symbolic_pointer_chain.module_name_len = source.module_name_len;
        transition {
            _ -> copy_links(owned_symbolic_pointer_chain, source, 0)
        }
    }
    state copy_links(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain, position: u64) {
        transition position < source.link_count && position < 64 {
            true -> store_link(owned_symbolic_pointer_chain, source, position)
            false -> finish_links(owned_symbolic_pointer_chain, source)
        }
    }
    state store_link(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain, position: u64)
        requires position < source.link_count && position < 64
    {
        owned_symbolic_pointer_chain.links[position] = source.links[position];
        transition {
            _ -> copy_links(owned_symbolic_pointer_chain, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_links(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain) {
        owned_symbolic_pointer_chain.link_count = source.link_count;
    }
}

// Upstream `get_links` — live links as a slice.
pub machine OwnedSymbolicPointerChain::get_links(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain) -> &[SymbolicPointerChainLink] {
    transition owned_symbolic_pointer_chain.link_count <= 64 {
        true -> (&owned_symbolic_pointer_chain.links[0..owned_symbolic_pointer_chain.link_count])
        false -> (&owned_symbolic_pointer_chain.links[0..64])
        _ -> (&owned_symbolic_pointer_chain.links[0..64])
    }
}

// Upstream `get_numeric_root_offset` — first link's numeric offset.
pub machine OwnedSymbolicPointerChain::get_numeric_root_offset(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain) -> SymbolicLinkOffset {
    transition owned_symbolic_pointer_chain.link_count > 0 {
        true -> first(owned_symbolic_pointer_chain)
        false -> (SymbolicLinkOffset { found: false, offset: 0 })
    }
    state first(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain) -> SymbolicLinkOffset {
        let link: SymbolicPointerChainLink = owned_symbolic_pointer_chain.links[0];
        SymbolicPointerChainLink::as_offset(&link)
    }
}

// Upstream `has_symbolic_links` — any link carrying a symbol name.
pub machine OwnedSymbolicPointerChain::has_symbolic_links(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain) -> bool {
    transition {
        _ -> scan(owned_symbolic_pointer_chain, 0)
    }
    state scan(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain, index: u64) -> bool {
        transition index < owned_symbolic_pointer_chain.link_count && index < 64 {
            true -> at(owned_symbolic_pointer_chain, index)
            false -> (false)
        }
    }
    state at(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain, index: u64) -> bool
        requires index < owned_symbolic_pointer_chain.link_count && index < 64
    {
        let link: SymbolicPointerChainLink = owned_symbolic_pointer_chain.links[index];
        transition SymbolicPointerChainLink::is_symbol(&link) {
            true -> (true)
            false -> scan(owned_symbolic_pointer_chain, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// Upstream `new` — owned chain built from a name, link slice, and size;
// links copy into the bounded table with refusal past 64.
pub machine OwnedSymbolicPointerChain::new_with_links(module_name: &[u8], links: &[SymbolicPointerChainLink], pointer_size: PointerScanPointerSize) -> OwnedSymbolicPointerChain {
    let mut chain: OwnedSymbolicPointerChain = (OwnedSymbolicPointerChain {
        module_name_len: 0,
        link_count: 0,
        pointer_size: pointer_size,
    });
    OwnedSymbolicPointerChain::set_module_name(&mut chain, module_name);
    transition {
        _ -> copy_links(&mut chain, links, 0)
    }
    state copy_links(chain: &mut OwnedSymbolicPointerChain, links: &[SymbolicPointerChainLink], position: u64) -> OwnedSymbolicPointerChain {
        transition position < links.len && position < 64 {
            true -> store_link(chain, links, position)
            false -> (chain)
        }
    }
    state store_link(chain: &mut OwnedSymbolicPointerChain, links: &[SymbolicPointerChainLink], position: u64) -> OwnedSymbolicPointerChain
        requires position < links.len && position < 64
    {
        chain.links[position] = links[position];
        transition {
            _ -> count_link(chain, links, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state count_link(chain: &mut OwnedSymbolicPointerChain, links: &[SymbolicPointerChainLink], position: u64) -> OwnedSymbolicPointerChain {
        chain.link_count = position;
        transition {
            _ -> copy_links(chain, links, position)
        }
    }
}

// Upstream `PartialEq` over the chain record — module bytes, pointer
// size case, link count, then per-link payload equality.
pub machine OwnedSymbolicPointerChain::chains_equal(left: &OwnedSymbolicPointerChain, right: &OwnedSymbolicPointerChain) -> bool {
    transition left.module_name_len == right.module_name_len && left.link_count == right.link_count && left.link_count <= 64 && left.module_name_len <= 256 {
        true -> size_match(left, right)
        _ -> (false)
    }
    state size_match(left: &OwnedSymbolicPointerChain, right: &OwnedSymbolicPointerChain) -> bool {
        transition left.pointer_size {
            PointerScanPointerSize::Pointer24be -> right_24be(left, right)
            PointerScanPointerSize::Pointer24 -> right_24(left, right)
            PointerScanPointerSize::Pointer32be -> right_32be(left, right)
            PointerScanPointerSize::Pointer32 -> right_32(left, right)
            PointerScanPointerSize::Pointer64be -> right_64be(left, right)
            PointerScanPointerSize::Pointer64 -> right_64(left, right)
            _ -> (false)
        }
    }
    state right_24be(left: &OwnedSymbolicPointerChain, right: &OwnedSymbolicPointerChain) -> bool {
        transition right.pointer_size {
            PointerScanPointerSize::Pointer24be -> module_bytes(left, right, 0)
            _ -> (false)
        }
    }
    state right_24(left: &OwnedSymbolicPointerChain, right: &OwnedSymbolicPointerChain) -> bool {
        transition right.pointer_size {
            PointerScanPointerSize::Pointer24 -> module_bytes(left, right, 0)
            _ -> (false)
        }
    }
    state right_32be(left: &OwnedSymbolicPointerChain, right: &OwnedSymbolicPointerChain) -> bool {
        transition right.pointer_size {
            PointerScanPointerSize::Pointer32be -> module_bytes(left, right, 0)
            _ -> (false)
        }
    }
    state right_32(left: &OwnedSymbolicPointerChain, right: &OwnedSymbolicPointerChain) -> bool {
        transition right.pointer_size {
            PointerScanPointerSize::Pointer32 -> module_bytes(left, right, 0)
            _ -> (false)
        }
    }
    state right_64be(left: &OwnedSymbolicPointerChain, right: &OwnedSymbolicPointerChain) -> bool {
        transition right.pointer_size {
            PointerScanPointerSize::Pointer64be -> module_bytes(left, right, 0)
            _ -> (false)
        }
    }
    state right_64(left: &OwnedSymbolicPointerChain, right: &OwnedSymbolicPointerChain) -> bool {
        transition right.pointer_size {
            PointerScanPointerSize::Pointer64 -> module_bytes(left, right, 0)
            _ -> (false)
        }
    }
    state module_bytes(left: &OwnedSymbolicPointerChain, right: &OwnedSymbolicPointerChain, position: u64) -> bool {
        transition position < left.module_name_len {
            true -> module_probe(left, right, position)
            _ -> link_at(left, right, 0)
        }
    }
    state module_probe(left: &OwnedSymbolicPointerChain, right: &OwnedSymbolicPointerChain, position: u64) -> bool
        requires position < left.module_name_len;
    {
        transition position < 256 && left.module_name[position] == right.module_name[position] {
            true -> module_bytes(left, right, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
    state link_at(left: &OwnedSymbolicPointerChain, right: &OwnedSymbolicPointerChain, position: u64) -> bool {
        transition position < left.link_count {
            true -> link_probe(left, right, position)
            _ -> (true)
        }
    }
    state link_probe(left: &OwnedSymbolicPointerChain, right: &OwnedSymbolicPointerChain, position: u64) -> bool
        requires position < left.link_count;
    {
        transition position < 64 && SymbolicPointerChainLink::links_equal(&left.links[position], &right.links[position]) {
            true -> link_at(left, right, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// Upstream `SymbolicPointerChain::get_numeric_tail_offsets` on the owned
// layout — every tail link resolved numerically or the request refuses.
pub machine OwnedSymbolicPointerChain::get_numeric_tail_offsets(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain, out: &mut [i64]) -> SymbolicTailOffsets {
    let held_count: u64 = OwnedSymbolicPointerChain::get_link_count(owned_symbolic_pointer_chain);
    transition held_count > 1 {
        true -> scan(owned_symbolic_pointer_chain, out, 1, 0, held_count)
        false -> (SymbolicTailOffsets { found: true, count: 0 })
    }
    state scan(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain, out: &mut [i64], index: u64, written: u64, held_count: u64) -> SymbolicTailOffsets {
        transition index < held_count && index < 64 {
            true -> at(owned_symbolic_pointer_chain, out, index, written, held_count)
            false -> (SymbolicTailOffsets { found: true, count: written })
        }
    }
    state at(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain, out: &mut [i64], index: u64, written: u64, held_count: u64) -> SymbolicTailOffsets
        requires index < held_count && index < 64;
    {
        let link: SymbolicPointerChainLink = OwnedSymbolicPointerChain::get_link(owned_symbolic_pointer_chain, index);
        let resolved: SymbolicLinkOffset = SymbolicPointerChainLink::as_offset(&link);
        transition resolved.found {
            true -> store(owned_symbolic_pointer_chain, out, resolved.offset, index, written, held_count)
            false -> (SymbolicTailOffsets { found: false, count: 0 })
        }
    }
    state store(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain, out: &mut [i64], offset: i64, index: u64, written: u64, held_count: u64) -> SymbolicTailOffsets {
        transition written < out.len {
            true -> write(owned_symbolic_pointer_chain, out, offset, index, written, held_count)
            false -> (SymbolicTailOffsets { found: false, count: 0 })
        }
    }
    state write(owned_symbolic_pointer_chain: &OwnedSymbolicPointerChain, out: &mut [i64], offset: i64, index: u64, written: u64, held_count: u64) -> SymbolicTailOffsets
        requires written < out.len;
    {
        out[written] = offset;
        transition {
            _ -> scan(owned_symbolic_pointer_chain, out, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, ((written as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, held_count)
        }
    }
}

// Upstream chain link overwrite — rebuilds the chain carrying the same
// module name and pointer size under the new links.
pub machine OwnedSymbolicPointerChain::set_links(owned_symbolic_pointer_chain: &mut OwnedSymbolicPointerChain, links: &[SymbolicPointerChainLink]) {
    let held_name: &[u8] = OwnedSymbolicPointerChain::get_module_name(owned_symbolic_pointer_chain);
    let held_size: PointerScanPointerSize = OwnedSymbolicPointerChain::get_pointer_size(owned_symbolic_pointer_chain);
    let mut rebuilt: OwnedSymbolicPointerChain = OwnedSymbolicPointerChain::new_with_links(held_name, links, held_size);
    OwnedSymbolicPointerChain::clone_from(owned_symbolic_pointer_chain, &rebuilt);
}
