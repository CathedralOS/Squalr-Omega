module src::structures::structs::owned_symbolic_pointer_chain;

use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use src::structures::memory::symbolic_pointer_chain::SymbolicPointerChainLink;

// Owned projection of upstream `SymbolicPointerChain` {module_name, links:
// Vec<SymbolicPointerChainLink>, pointer_size} for records that own their
// chain — resolver nodes and paths. The existing
// `SymbolicPointerChain<'links>` is a borrowed link-slice view for scan
// evaluation; an owned record cannot carry it without a provider lifetime,
// so the owned shape lives here under an Owned prefix (upstream's owned
// type is the same name — collision documented).
// Upstream's Vec carries the honest bound of 64 links with refusal.
pub data OwnedSymbolicPointerChain {
    module_name: [u8; 256];
    module_name_len: u64;
    links: [SymbolicPointerChainLink; 64];
    link_count: u64;
    pointer_size: PointerScanPointerSize;
}

pub machine OwnedSymbolicPointerChain::default() -> OwnedSymbolicPointerChain {
    (OwnedSymbolicPointerChain {
        module_name_len: 0,
        link_count: 0,
        pointer_size: PointerScanPointerSize::default(),
    })
}

pub machine OwnedSymbolicPointerChain::new(module_name: &[u8], pointer_size: PointerScanPointerSize) -> OwnedSymbolicPointerChain {
    let mut chain: OwnedSymbolicPointerChain = (OwnedSymbolicPointerChain {
        module_name_len: 0,
        link_count: 0,
        pointer_size: pointer_size,
    });
    OwnedSymbolicPointerChain::set_module_name(&mut chain, module_name);
    (chain)
}

pub machine OwnedSymbolicPointerChain::get_module_name(this: &OwnedSymbolicPointerChain) -> &[u8] {
    transition this.module_name_len <= 256 {
        true -> (&this.module_name[0..this.module_name_len])
        false -> (&this.module_name[0..256])
        _ -> (&this.module_name[0..256])
    }
}

pub machine OwnedSymbolicPointerChain::set_module_name(this: &mut OwnedSymbolicPointerChain, module_name: &[u8]) {
    this.module_name_len = 0;
    transition {
        _ -> copy(this, module_name, 0)
    }
    state copy(this: &mut OwnedSymbolicPointerChain, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(this, module_name, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut OwnedSymbolicPointerChain, module_name: &[u8], position: u64) {
        this.module_name[position] = module_name[position];
        transition {
            _ -> copy(this, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut OwnedSymbolicPointerChain, count: u64) {
        this.module_name_len = count;
    }
}

pub machine OwnedSymbolicPointerChain::get_link_count(this: &OwnedSymbolicPointerChain) -> u64 {
    (this.link_count)
}

pub machine OwnedSymbolicPointerChain::get_link(this: &OwnedSymbolicPointerChain, position: u64) -> SymbolicPointerChainLink
    requires position < this.link_count && position < 64
{
    (this.links[position])
}

pub machine OwnedSymbolicPointerChain::get_pointer_size(this: &OwnedSymbolicPointerChain) -> PointerScanPointerSize {
    (this.pointer_size)
}

pub machine OwnedSymbolicPointerChain::set_pointer_size(this: &mut OwnedSymbolicPointerChain, pointer_size: PointerScanPointerSize) {
    this.pointer_size = pointer_size;
}

// Upstream `links.push` — refusal past the bound.
pub machine OwnedSymbolicPointerChain::add_link(this: &mut OwnedSymbolicPointerChain, link: SymbolicPointerChainLink) -> bool {
    transition this.link_count < 64 {
        true -> store(this, link)
        false -> (false)
    }
    state store(this: &mut OwnedSymbolicPointerChain, link: SymbolicPointerChainLink) -> bool {
        this.links[this.link_count] = link;
        this.link_count = ((this.link_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine OwnedSymbolicPointerChain::clone_from(this: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain) {
    this.link_count = 0;
    this.pointer_size = source.pointer_size;
    transition {
        _ -> copy_name(this, source, 0)
    }
    state copy_name(this: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain, position: u64) {
        transition position < source.module_name_len && position < 256 {
            true -> store_name(this, source, position)
            false -> finish_name(this, source)
        }
    }
    state store_name(this: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain, position: u64) {
        this.module_name[position] = source.module_name[position];
        transition {
            _ -> copy_name(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_name(this: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain) {
        this.module_name_len = source.module_name_len;
        transition {
            _ -> copy_links(this, source, 0)
        }
    }
    state copy_links(this: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain, position: u64) {
        transition position < source.link_count && position < 64 {
            true -> store_link(this, source, position)
            false -> finish_links(this, source)
        }
    }
    state store_link(this: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain, position: u64)
        requires position < source.link_count && position < 64
    {
        this.links[position] = source.links[position];
        transition {
            _ -> copy_links(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_links(this: &mut OwnedSymbolicPointerChain, source: &OwnedSymbolicPointerChain) {
        this.link_count = source.link_count;
    }
}
