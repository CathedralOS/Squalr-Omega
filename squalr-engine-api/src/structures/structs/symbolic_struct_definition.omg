module src::structures::structs::symbolic_struct_definition;

// Port of the SymbolicLayoutKind half of
// structures/structs/symbolic_struct_definition.rs: whether a struct's
// fields lay out sequentially or overlap at offset zero.
//
// The other half — `SymbolicStructDefinition` and its `SymbolicFieldDefinition`
// field machinery (resolver-driven offsets, `get_default_valued_struct`,
// definition-side `get_size_in_bytes`) — is symbol-resolution machinery
// owned by the symbol-registry item, not the scan-values slice. It is a
// named deferral: ValuedStruct's read/copy paths depend only on
// `SymbolicLayoutKind` and `SymbolicStructRef`.
pub data SymbolicLayoutKind [copy] {
    case Struct;
    case Union;
}

// Upstream `Default`.
pub machine SymbolicLayoutKind::default() -> SymbolicLayoutKind {
    SymbolicLayoutKind::Struct
}

// Upstream `label` — the Display label per variant.
pub machine SymbolicLayoutKind::label(this: &SymbolicLayoutKind) -> &[u8] {
    transition this {
        SymbolicLayoutKind::Struct -> ("Struct")
        SymbolicLayoutKind::Union -> ("Union")
    }
}

// Upstream `key` — the lowercase parse key per variant.
pub machine SymbolicLayoutKind::key(this: &SymbolicLayoutKind) -> &[u8] {
    transition this {
        SymbolicLayoutKind::Struct -> ("struct")
        SymbolicLayoutKind::Union -> ("union")
    }
}

// Upstream `from_key` — exact match against "struct" / "union" (upstream
// trims first; the ported caller hands trimmed windows, matching the
// package's byte-window convention).
pub data SymbolicLayoutKindParse [copy] {
    case Refused;
    case Parsed(value: SymbolicLayoutKind);
}

pub machine SymbolicLayoutKind::from_key(key: &[u8]) -> SymbolicLayoutKindParse {
    let hoist1: bool = key_is(key, "struct");
    transition hoist1 {
        true -> arm_result_48_0(key)
        false -> union_arm(key)
    }
    state union_arm(key: &[u8]) -> SymbolicLayoutKindParse {
        let hoist2: bool = key_is(key, "union");
        transition hoist2 {
            true -> arm_result_53_0(key)
            false -> (SymbolicLayoutKindParse::Refused)
        }
    }
    state arm_result_48_0(key: &[u8]) -> SymbolicLayoutKindParse
    {
        (SymbolicLayoutKindParse::Parsed { value: SymbolicLayoutKind::Struct })
    }
    state arm_result_53_0(key: &[u8]) -> SymbolicLayoutKindParse
    {
        (SymbolicLayoutKindParse::Parsed { value: SymbolicLayoutKind::Union })
    }
}

machine key_is(key: &[u8], text: &[u8]) -> bool {
    transition key.len == text.len {
        true -> scan(0, key, text)
        false -> (false)
    }
    state scan(position: u64, key: &[u8], text: &[u8]) -> bool {
        transition position < 6 && position < key.len && position < text.len {
            true -> compare(position, key, text)
            false -> (true)
        }
    }
    state compare(position: u64, key: &[u8], text: &[u8]) -> bool
        requires 0 <= position && position < 6
    {
        transition position < text.len && key[position] == text[position] {
            true -> scan(position + 1, key, text)
            false -> (false)
            _ -> (false)
        }
    }
}

pub machine SymbolicLayoutKind::is_union(this: &SymbolicLayoutKind) -> bool {
    transition this {
        SymbolicLayoutKind::Struct -> (false)
        SymbolicLayoutKind::Union -> (true)
    }
}

use src::structures::structs::symbolic_field_definition::SymbolicFieldDefinition;
use src::structures::structs::symbolic_field_definition::SymbolicFieldOffsetResolution;
use src::structures::structs::symbolic_struct_ref::SymbolicStructRef;
use src::structures::structs::valued_struct::ValuedStruct;
use src::structures::structs::valued_struct_field::ValuedStructField;
use src::structures::structs::valued_struct_field::ValuedStructFieldData;
use src::structures::data_values::data_value::DataValue;

// Port of structures/structs/symbolic_struct_definition.rs: a namespace plus
// an ordered field list, with a static layout kind and optional declared
// size. `fields: Vec<SymbolicFieldDefinition>` folds to the port's bounded
// list convention.
pub data SymbolicStructDefinition {
    symbol_namespace: [u8; 256];
    symbol_namespace_len: u64;
    layout_kind: SymbolicLayoutKind;
    has_declared_size: bool;
    declared_size_in_bytes: u64;
    fields: [SymbolicFieldDefinition; 64];
    field_count: u64;
}

pub machine SymbolicStructDefinition::new(
    symbol_namespace: &[u8],
    fields: &[SymbolicFieldDefinition]
) -> SymbolicStructDefinition {
    SymbolicStructDefinition::new_with_layout_kind(
        symbol_namespace, SymbolicLayoutKind::Struct, fields)
}

pub machine SymbolicStructDefinition::new_with_layout_kind(
    symbol_namespace: &[u8],
    layout_kind: SymbolicLayoutKind,
    fields: &[SymbolicFieldDefinition]
) -> SymbolicStructDefinition {
    let mut definition: SymbolicStructDefinition = SymbolicStructDefinition {
        symbol_namespace_len: 0,
        layout_kind: layout_kind,
        has_declared_size: false,
        declared_size_in_bytes: 0,
        field_count: 0,
    };
    SymbolicStructDefinition::set_symbol_namespace(&mut definition, symbol_namespace);
    SymbolicStructDefinition::fill_fields(&mut definition, fields);
    definition
}

pub machine SymbolicStructDefinition::get_symbol_namespace(this: &SymbolicStructDefinition) -> &[u8] {
    transition this.symbol_namespace_len <= 256 {
        true -> (&this.symbol_namespace[0..this.symbol_namespace_len])
        false -> (&this.symbol_namespace[0..256])
        _ -> (&this.symbol_namespace[0..256])
    }
}

pub machine SymbolicStructDefinition::get_layout_kind(this: &SymbolicStructDefinition) -> SymbolicLayoutKind {
    this.layout_kind
}

pub machine SymbolicStructDefinition::get_field_count(this: &SymbolicStructDefinition) -> u64 {
    this.field_count
}

pub machine SymbolicStructDefinition::get_field(this: &SymbolicStructDefinition, position: u64) -> &SymbolicFieldDefinition {
    let hoist7: &SymbolicFieldDefinition = SymbolicStructDefinition::head(&this);
    let hoist6: &SymbolicFieldDefinition = SymbolicStructDefinition::head(&this);
    transition position < this.field_count && position < 64 {
        true -> at(this, position)
        false -> (hoist6)
        _ -> (hoist7)
    }
    state at(this: &SymbolicStructDefinition, position: u64) -> &SymbolicFieldDefinition
    requires 0 <= position && position < 64;
    {
        &this.fields[position]
    }
}

machine SymbolicStructDefinition::head(this: &SymbolicStructDefinition) -> &SymbolicFieldDefinition {
    &this.fields[0]
}

// Upstream `add_field` — appends within the bounded list.
pub machine SymbolicStructDefinition::add_field(
    this: &mut SymbolicStructDefinition,
    symbolic_struct_field: &SymbolicFieldDefinition
) -> bool {
    transition this.field_count < 64 {
        true -> store(this, symbolic_struct_field)
        false -> (false)
    }
    state store(this: &mut SymbolicStructDefinition, symbolic_struct_field: &SymbolicFieldDefinition) -> bool {
        this.fields[this.field_count] = SymbolicFieldDefinition::clone(symbolic_struct_field);
        this.field_count = this.field_count + 1;
        true
    }
}

// Upstream `get_size_in_bytes`: walk fields — Static offsets are absolute,
// Sequential (and resolver-id'd, see the named deviation on
// symbolic_field_definition) lay out at the running edge or 0 under unions —
// then take the max against any declared size.
pub machine SymbolicStructDefinition::get_size_in_bytes(this: &SymbolicStructDefinition) -> u64 {
    transition { _ -> each(this, 0, 0) }
    state each(this: &SymbolicStructDefinition, position: u64, next_sequential_offset: u64) -> u64 {
        transition position < this.field_count && position < 64 {
            true -> at(this, position, next_sequential_offset)
            false -> done(this, next_sequential_offset)
            _ -> done(this, next_sequential_offset)
        }
    }
    state at(this: &SymbolicStructDefinition, position: u64, next_sequential_offset: u64) -> u64
    requires 0 <= position && position < 64;
    {
        let field_offset: u64 = SymbolicStructDefinition::resolve_field_offset(&this, position, next_sequential_offset);
        let field_size: u64 = SymbolicFieldDefinition::get_size_in_bytes(&this.fields[position]);
        let candidate: u64 = ((field_offset as u64 in Saturating)
            + (field_size as u64 in Saturating)) as u64;
        let next: u64 = max_u64(next_sequential_offset, candidate);
        transition { _ -> each(this, position + 1, next) }
    }
    state done(this: &SymbolicStructDefinition, next_sequential_offset: u64) -> u64 {
        let hoist8: u64 = max_u64(next_sequential_offset, this.declared_size_in_bytes);
        transition this.has_declared_size {
            true -> (hoist8)
            false -> (next_sequential_offset)
            _ -> (next_sequential_offset)
        }
    }
}

// Upstream's field-offset walk evaluated for a single field — the offset
// the field occupies in the layout (Static wins; Sequential lands at the
// running edge or 0 under unions).
pub machine SymbolicStructDefinition::get_field_offset(this: &SymbolicStructDefinition, field_index: u64) -> u64 {
    transition { _ -> each(this, field_index, 0, 0) }
    state each(this: &SymbolicStructDefinition, field_index: u64, position: u64, next_sequential_offset: u64) -> u64 {
        transition position < this.field_count && position < 64 {
            true -> at(this, field_index, position, next_sequential_offset)
            false -> (0)
            _ -> (0)
        }
    }
    state at(this: &SymbolicStructDefinition, field_index: u64, position: u64, next_sequential_offset: u64) -> u64
    requires 0 <= position && position < 64;
    {
        let field_offset: u64 = SymbolicStructDefinition::resolve_field_offset(&this, position, next_sequential_offset);
        let field_size: u64 = SymbolicFieldDefinition::get_size_in_bytes(&this.fields[position]);
        let next: u64 = max_u64(
            next_sequential_offset,
            ((field_offset as u64 in Saturating) + (field_size as u64 in Saturating)) as u64);
        transition position == field_index {
            true -> (field_offset)
            false -> each(this, field_index, position + 1, next)
            _ -> each(this, field_index, position + 1, next)
        }
    }
}

machine SymbolicStructDefinition::resolve_field_offset(
    this: &SymbolicStructDefinition,
    position: u64,
    next_sequential_offset: u64
) -> u64
requires 0 <= position && position < 64;
{
    let hoist3: SymbolicFieldOffsetResolution = SymbolicFieldDefinition::get_offset_resolution(&this.fields[position]);
    transition hoist3 {
        SymbolicFieldOffsetResolution::Static { offset_in_bytes } -> (offset_in_bytes)
        _ -> sequential(this, next_sequential_offset)
    }
    state sequential(this: &SymbolicStructDefinition, next_sequential_offset: u64) -> u64 {
        let hoist4: bool = SymbolicLayoutKind::is_union(&this.layout_kind);
        transition hoist4 {
            true -> (0)
            false -> (next_sequential_offset)
            _ -> (next_sequential_offset)
        }
    }
}

machine max_u64(left: u64, right: u64) -> u64 {
    transition left < right {
        true -> (right)
        false -> (left)
        _ -> (left)
    }
}

// Upstream `get_default_valued_struct`: skip unassigned spans and mint each
// defined field as a Value over the data type's default bytes. Upstream's
// `unwrap_or_default`/`or_else` fallback chain lands on `DataValue::default()`
// whenever the registry lacks the entry — the same outcome the port's
// resolver-less path produces.
pub machine SymbolicStructDefinition::get_default_valued_struct(this: &SymbolicStructDefinition) -> ValuedStruct {
    let hoist9: &[u8] = SymbolicStructDefinition::get_symbol_namespace(&this);
    let struct_ref: SymbolicStructRef = SymbolicStructRef::new(hoist9);
    let mut valued: ValuedStruct = ValuedStruct::new_with_layout_kind(
        &struct_ref, this.layout_kind, &[]);
    SymbolicStructDefinition::fill_default_fields(&this, &mut valued);
    valued
}

machine SymbolicStructDefinition::fill_default_fields(
    this: &SymbolicStructDefinition,
    valued: &mut ValuedStruct
) {
    transition { _ -> each(this, valued, 0) }
    state each(this: &SymbolicStructDefinition, valued: &mut ValuedStruct, position: u64) {
        transition position < this.field_count && position < 64 {
            true -> at(this, valued, position)
            false -> done(this, valued)
            _ -> done(this, valued)
        }
    }
    state at(this: &SymbolicStructDefinition, valued: &mut ValuedStruct, position: u64)
    requires 0 <= position && position < 64;
    {
        let hoist5: bool = SymbolicFieldDefinition::is_unassigned(&this.fields[position]);
        transition hoist5 {
            true -> each(this, valued, position + 1)
            false -> push(this, valued, position)
            _ -> each(this, valued, position + 1)
        }
    }
    state push(this: &SymbolicStructDefinition, valued: &mut ValuedStruct, position: u64)
    requires 0 <= position && position < 64;
    {
        let field: ValuedStructField = SymbolicFieldDefinition::get_valued_struct_field(&this.fields[position]);
        ValuedStruct::append_field(&mut valued, &field);
        transition { _ -> each(this, valued, position + 1) }
    }
    state done(this: &SymbolicStructDefinition, valued: &mut ValuedStruct) {
    }
}

machine SymbolicStructDefinition::set_symbol_namespace(this: &mut SymbolicStructDefinition, namespace: &[u8]) {
    let mut position: u64 = 0;
    this.symbol_namespace_len = 0;
    transition { _ -> copy(this, position, namespace) }
    state copy(this: &mut SymbolicStructDefinition, position: u64, namespace: &[u8]) {
        transition position < namespace.len && position < 256 {
            true -> step(this, position, namespace)
            false -> done(this)
        }
    }
    state step(this: &mut SymbolicStructDefinition, position: u64, namespace: &[u8]) {
        this.symbol_namespace[position] = namespace[position];
        this.symbol_namespace_len = position + 1;
        transition { _ -> copy(this, position + 1, namespace) }
    }
    state done(this: &mut SymbolicStructDefinition) {
        this.symbol_namespace_len = this.symbol_namespace_len;
    }
}

machine SymbolicStructDefinition::fill_fields(
    this: &mut SymbolicStructDefinition,
    fields: &[SymbolicFieldDefinition]
) {
    let mut position: u64 = 0;
    transition { _ -> copy(this, position, fields) }
    state copy(this: &mut SymbolicStructDefinition, position: u64, fields: &[SymbolicFieldDefinition]) {
        transition position < fields.len && position < 64 {
            true -> step(this, position, fields)
            false -> done(this)
        }
    }
    state step(this: &mut SymbolicStructDefinition, position: u64, fields: &[SymbolicFieldDefinition])
    requires 0 <= position && position < 64;
    {
        this.fields[position] = SymbolicFieldDefinition::clone(&fields[position]);
        this.field_count = position + 1;
        transition { _ -> copy(this, position + 1, fields) }
    }
    state done(this: &mut SymbolicStructDefinition) {
        this.field_count = this.field_count;
    }
}

// Upstream `Clone` — fields deep-copy element-wise; scalar fields copy.
pub machine SymbolicStructDefinition::clone(this: &SymbolicStructDefinition) -> SymbolicStructDefinition {
    let mut cloned: SymbolicStructDefinition = (SymbolicStructDefinition {
        symbol_namespace_len: 0,
        layout_kind: this.layout_kind,
        has_declared_size: this.has_declared_size,
        declared_size_in_bytes: this.declared_size_in_bytes,
        field_count: 0,
    });
    SymbolicStructDefinition::clone_from(&mut cloned, this);
    (cloned)
}

pub machine SymbolicStructDefinition::clone_from(this: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition) {
    this.layout_kind = source.layout_kind;
    this.has_declared_size = source.has_declared_size;
    this.declared_size_in_bytes = source.declared_size_in_bytes;
    this.field_count = 0;
    transition {
        _ -> copy_namespace(this, source, 0)
    }
    state copy_namespace(this: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition, position: u64) {
        transition position < source.symbol_namespace_len && position < 256 {
            true -> store_namespace(this, source, position)
            false -> finish_namespace(this, source)
        }
    }
    state store_namespace(this: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition, position: u64) {
        this.symbol_namespace[position] = source.symbol_namespace[position];
        transition {
            _ -> copy_namespace(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_namespace(this: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition) {
        this.symbol_namespace_len = source.symbol_namespace_len;
        transition {
            _ -> copy_fields(this, source, 0)
        }
    }
    state copy_fields(this: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition, position: u64) {
        transition position < source.field_count && position < 64 {
            true -> store_field(this, source, position)
            false -> finish_fields(this, source)
        }
    }
    state store_field(this: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition, position: u64)
        requires position < source.field_count && position < 64
    {
        SymbolicFieldDefinition::clone_from(&mut this.fields[position], &source.fields[position]);
        transition {
            _ -> copy_fields(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_fields(this: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition) {
        this.field_count = source.field_count;
    }
}

// Empty definition — no namespace, no fields; the record's default-able
// fields are explicit since the type has no `default()` upstream either.
pub machine SymbolicStructDefinition::empty() -> SymbolicStructDefinition {
    SymbolicStructDefinition {
        symbol_namespace_len: 0,
        layout_kind: SymbolicLayoutKind::Struct,
        has_declared_size: false,
        declared_size_in_bytes: 0,
        field_count: 0,
    }
}
