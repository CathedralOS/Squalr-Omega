module src::structures::structs::symbolic_struct_definition;

// Port of the SymbolicLayoutKind half of
// structures/structs/symbolic_struct_definition.rs: whether a struct's
// fields lay out sequentially or overlap at offset zero.
//
// The other half — `SymbolicStructDefinition` and its `SymbolicFieldDefinition`
// field machinery (resolver-driven offsets, `get_default_valued_struct`,
// definition-side `get_size_in_bytes`) — is symbol-resolution machinery
// owned by the symbol-registry item, not the scan-values slice. It is a
// named deferral: ValuedStruct's read/copy paths depend only on
// `SymbolicLayoutKind` and `SymbolicStructRef`.
pub data SymbolicLayoutKind [copy] {
    case Struct;
    case Union;
}

// Upstream `Default`.
pub machine SymbolicLayoutKind::default() -> SymbolicLayoutKind {
    SymbolicLayoutKind::Struct
}

// Upstream `label` — the Display label per variant.
pub machine SymbolicLayoutKind::label(symbolic_layout_kind: &SymbolicLayoutKind) -> &[u8] {
    transition symbolic_layout_kind {
        SymbolicLayoutKind::Struct -> ("Struct")
        SymbolicLayoutKind::Union -> ("Union")
    }
}

// Upstream `key` — the lowercase parse key per variant.
pub machine SymbolicLayoutKind::key(symbolic_layout_kind: &SymbolicLayoutKind) -> &[u8] {
    transition symbolic_layout_kind {
        SymbolicLayoutKind::Struct -> ("struct")
        SymbolicLayoutKind::Union -> ("union")
    }
}

// Upstream `from_key` — exact match against "struct" / "union" (upstream
// trims first; the ported caller hands trimmed windows, matching the
// package's byte-window convention).
pub data SymbolicLayoutKindParse [copy] {
    case Refused;
    case Parsed(value: SymbolicLayoutKind);
}

pub machine SymbolicLayoutKind::from_key(key: &[u8]) -> SymbolicLayoutKindParse {
    transition key_is(key, "struct") {
        true -> arm_result_48_0(key)
        false -> union_arm(key)
    }
    state union_arm(key: &[u8]) -> SymbolicLayoutKindParse {
        transition key_is(key, "union") {
            true -> arm_result_53_0(key)
            false -> (SymbolicLayoutKindParse::Refused)
        }
    }
    state arm_result_48_0(key: &[u8]) -> SymbolicLayoutKindParse
    {
        (SymbolicLayoutKindParse::Parsed { value: SymbolicLayoutKind::Struct })
    }
    state arm_result_53_0(key: &[u8]) -> SymbolicLayoutKindParse
    {
        (SymbolicLayoutKindParse::Parsed { value: SymbolicLayoutKind::Union })
    }
}

machine key_is(key: &[u8], text: &[u8]) -> bool {
    transition key.len == text.len {
        true -> scan(0, key, text)
        false -> (false)
    }
    state scan(position: u64, key: &[u8], text: &[u8]) -> bool {
        transition position < 6 && position < key.len && position < text.len {
            true -> compare(position, key, text)
            false -> (true)
        }
    }
    state compare(position: u64, key: &[u8], text: &[u8]) -> bool
        requires 0 <= position && position < 6
    {
        transition position < text.len && key[position] == text[position] {
            true -> scan(position + 1, key, text)
            false -> (false)
            _ -> (false)
        }
    }
}

pub machine SymbolicLayoutKind::is_union(symbolic_layout_kind: &SymbolicLayoutKind) -> bool {
    transition symbolic_layout_kind {
        SymbolicLayoutKind::Struct -> (false)
        SymbolicLayoutKind::Union -> (true)
    }
}

use src::structures::structs::symbolic_field_definition::SymbolicFieldDefinition;
use src::structures::structs::symbolic_field_definition::SymbolicFieldOffsetResolution;
use src::structures::structs::symbolic_struct_ref::SymbolicStructRef;
use src::structures::structs::valued_struct::ValuedStruct;
use src::structures::structs::valued_struct_field::ValuedStructField;
use src::structures::structs::valued_struct_field::ValuedStructFieldData;
use src::structures::data_values::data_value::DataValue;

// Port of structures/structs/symbolic_struct_definition.rs: a namespace plus
// an ordered field list, with a static layout kind and optional declared
// size. `fields: Vec<SymbolicFieldDefinition>` folds to the port's bounded
// list convention.
pub data SymbolicStructDefinition {
    symbol_namespace: [u8; 256];
    symbol_namespace_len: u64;
    layout_kind: SymbolicLayoutKind;
    has_declared_size: bool;
    declared_size_in_bytes: u64;
    fields: [SymbolicFieldDefinition; 64];
    field_count: u64;
}

pub machine SymbolicStructDefinition::new(
    symbol_namespace: &[u8],
    fields: &[SymbolicFieldDefinition]
) -> SymbolicStructDefinition {
    SymbolicStructDefinition::new_with_layout_kind(
        symbol_namespace, SymbolicLayoutKind::Struct, fields)
}

// Upstream callers pass `&[]`/`vec![]` for fieldless definitions; Omega has
// no empty-slice literal, so an explicit empty constructor fills that role.
pub machine SymbolicStructDefinition::new_empty(
    symbol_namespace: &[u8]
) -> SymbolicStructDefinition {
    let mut definition: SymbolicStructDefinition = SymbolicStructDefinition {
        symbol_namespace_len: 0,
        layout_kind: SymbolicLayoutKind::Struct,
        has_declared_size: false,
        declared_size_in_bytes: 0,
        field_count: 0,
    };
    SymbolicStructDefinition::set_symbol_namespace(&mut definition, symbol_namespace);
    definition
}

pub machine SymbolicStructDefinition::new_with_layout_kind(
    symbol_namespace: &[u8],
    layout_kind: SymbolicLayoutKind,
    fields: &[SymbolicFieldDefinition]
) -> SymbolicStructDefinition {
    let mut definition: SymbolicStructDefinition = SymbolicStructDefinition {
        symbol_namespace_len: 0,
        layout_kind: layout_kind,
        has_declared_size: false,
        declared_size_in_bytes: 0,
        field_count: 0,
    };
    SymbolicStructDefinition::set_symbol_namespace(&mut definition, symbol_namespace);
    SymbolicStructDefinition::fill_fields(&mut definition, fields);
    definition
}

// Upstream `has_declared_size_in_bytes` — the declared-size arm is
// optional; `get_declared_size_in_bytes` returns 0 when absent
// (upstream's `unwrap_or(0)` call sites).
pub machine SymbolicStructDefinition::has_declared_size_in_bytes(symbolic_struct_definition: &SymbolicStructDefinition) -> bool {
    symbolic_struct_definition.has_declared_size
}

pub machine SymbolicStructDefinition::get_declared_size_in_bytes(symbolic_struct_definition: &SymbolicStructDefinition) -> u64 {
    transition symbolic_struct_definition.has_declared_size {
        true -> (symbolic_struct_definition.declared_size_in_bytes)
        _ -> (0)
    }
}

// Upstream `with_declared_size_in_bytes` — spelled as a setter on the
// builder result.
pub machine SymbolicStructDefinition::set_declared_size_in_bytes(symbolic_struct_definition: &mut SymbolicStructDefinition, has_declared_size: bool, declared_size_in_bytes: u64) {
    symbolic_struct_definition.has_declared_size = has_declared_size;
    symbolic_struct_definition.declared_size_in_bytes = declared_size_in_bytes;
}

pub machine SymbolicStructDefinition::get_symbol_namespace(symbolic_struct_definition: &SymbolicStructDefinition) -> &[u8] {
    transition symbolic_struct_definition.symbol_namespace_len <= 256 {
        true -> (&symbolic_struct_definition.symbol_namespace[0..symbolic_struct_definition.symbol_namespace_len])
        false -> (&symbolic_struct_definition.symbol_namespace[0..256])
        _ -> (&symbolic_struct_definition.symbol_namespace[0..256])
    }
}

pub machine SymbolicStructDefinition::get_layout_kind(symbolic_struct_definition: &SymbolicStructDefinition) -> SymbolicLayoutKind {
    symbolic_struct_definition.layout_kind
}

pub machine SymbolicStructDefinition::get_field_count(symbolic_struct_definition: &SymbolicStructDefinition) -> u64 {
    symbolic_struct_definition.field_count
}

pub machine SymbolicStructDefinition::get_field(symbolic_struct_definition: &SymbolicStructDefinition, position: u64) -> &SymbolicFieldDefinition {
    transition position < symbolic_struct_definition.field_count && position < 64 {
        true -> at(symbolic_struct_definition, position)
        false -> (SymbolicStructDefinition::head(symbolic_struct_definition))
        _ -> (SymbolicStructDefinition::head(symbolic_struct_definition))
    }
    state at(symbolic_struct_definition: &SymbolicStructDefinition, position: u64) -> &SymbolicFieldDefinition
    requires 0 <= position && position < 64;
    {
        &symbolic_struct_definition.fields[position]
    }
}

machine SymbolicStructDefinition::head(symbolic_struct_definition: &SymbolicStructDefinition) -> &SymbolicFieldDefinition {
    &symbolic_struct_definition.fields[0]
}

// Upstream `add_field` — appends within the bounded list.
pub machine SymbolicStructDefinition::add_field(
    symbolic_struct_definition: &mut SymbolicStructDefinition,
    symbolic_struct_field: &SymbolicFieldDefinition
) -> bool {
    transition symbolic_struct_definition.field_count < 64 {
        true -> store(symbolic_struct_definition, symbolic_struct_field)
        false -> (false)
    }
    state store(symbolic_struct_definition: &mut SymbolicStructDefinition, symbolic_struct_field: &SymbolicFieldDefinition) -> bool {
        symbolic_struct_definition.fields[symbolic_struct_definition.field_count] = SymbolicFieldDefinition::clone(symbolic_struct_field);
        symbolic_struct_definition.field_count = symbolic_struct_definition.field_count + 1;
        true
    }
}

// Upstream `get_size_in_bytes`: walk fields — Static offsets are absolute,
// Sequential (and resolver-id'd, see the named deviation on
// symbolic_field_definition) lay out at the running edge or 0 under unions —
// then take the max against any declared size.
pub machine SymbolicStructDefinition::get_size_in_bytes(symbolic_struct_definition: &SymbolicStructDefinition) -> u64 {
    transition { _ -> each(symbolic_struct_definition, 0, 0) }
    state each(symbolic_struct_definition: &SymbolicStructDefinition, position: u64, next_sequential_offset: u64) -> u64 {
        transition position < symbolic_struct_definition.field_count && position < 64 {
            true -> at(symbolic_struct_definition, position, next_sequential_offset)
            false -> done(symbolic_struct_definition, next_sequential_offset)
            _ -> done(symbolic_struct_definition, next_sequential_offset)
        }
    }
    state at(symbolic_struct_definition: &SymbolicStructDefinition, position: u64, next_sequential_offset: u64) -> u64
    requires 0 <= position && position < 64;
    {
        let field_offset: u64 = SymbolicStructDefinition::resolve_field_offset(symbolic_struct_definition, position, next_sequential_offset);
        let field_size: u64 = SymbolicFieldDefinition::get_size_in_bytes(&symbolic_struct_definition.fields[position]);
        let candidate: u64 = ((field_offset as u64 in Saturating)
            + (field_size as u64 in Saturating)) as u64;
        let next: u64 = max_u64(next_sequential_offset, candidate);
        transition { _ -> each(symbolic_struct_definition, position + 1, next) }
    }
    state done(symbolic_struct_definition: &SymbolicStructDefinition, next_sequential_offset: u64) -> u64 {
        transition symbolic_struct_definition.has_declared_size {
            true -> (max_u64(next_sequential_offset, symbolic_struct_definition.declared_size_in_bytes))
            false -> (next_sequential_offset)
            _ -> (next_sequential_offset)
        }
    }
}

// Upstream's field-offset walk evaluated for a single field — the offset
// the field occupies in the layout (Static wins; Sequential lands at the
// running edge or 0 under unions).
pub machine SymbolicStructDefinition::get_field_offset(symbolic_struct_definition: &SymbolicStructDefinition, field_index: u64) -> u64 {
    transition { _ -> each(symbolic_struct_definition, field_index, 0, 0) }
    state each(symbolic_struct_definition: &SymbolicStructDefinition, field_index: u64, position: u64, next_sequential_offset: u64) -> u64 {
        transition position < symbolic_struct_definition.field_count && position < 64 {
            true -> at(symbolic_struct_definition, field_index, position, next_sequential_offset)
            false -> (0)
            _ -> (0)
        }
    }
    state at(symbolic_struct_definition: &SymbolicStructDefinition, field_index: u64, position: u64, next_sequential_offset: u64) -> u64
    requires 0 <= position && position < 64;
    {
        let field_offset: u64 = SymbolicStructDefinition::resolve_field_offset(symbolic_struct_definition, position, next_sequential_offset);
        let field_size: u64 = SymbolicFieldDefinition::get_size_in_bytes(&symbolic_struct_definition.fields[position]);
        let next: u64 = max_u64(
            next_sequential_offset,
            ((field_offset as u64 in Saturating) + (field_size as u64 in Saturating)) as u64);
        transition position == field_index {
            true -> (field_offset)
            false -> each(symbolic_struct_definition, field_index, position + 1, next)
            _ -> each(symbolic_struct_definition, field_index, position + 1, next)
        }
    }
}

machine SymbolicStructDefinition::resolve_field_offset(
    symbolic_struct_definition: &SymbolicStructDefinition,
    position: u64,
    next_sequential_offset: u64
) -> u64
requires 0 <= position && position < 64;
{
    transition SymbolicFieldDefinition::get_offset_resolution(&symbolic_struct_definition.fields[position]) {
        SymbolicFieldOffsetResolution::Static { offset_in_bytes } -> (offset_in_bytes)
        _ -> sequential(symbolic_struct_definition, next_sequential_offset)
    }
    state sequential(symbolic_struct_definition: &SymbolicStructDefinition, next_sequential_offset: u64) -> u64 {
        transition SymbolicLayoutKind::is_union(&symbolic_struct_definition.layout_kind) {
            true -> (0)
            false -> (next_sequential_offset)
            _ -> (next_sequential_offset)
        }
    }
}

machine max_u64(left: u64, right: u64) -> u64 {
    transition left < right {
        true -> (right)
        false -> (left)
        _ -> (left)
    }
}

// Upstream `get_default_valued_struct`: skip unassigned spans and mint each
// defined field as a Value over the data type's default bytes. Upstream's
// `unwrap_or_default`/`or_else` fallback chain lands on `DataValue::default()`
// whenever the registry lacks the entry — the same outcome the port's
// resolver-less path produces.
pub machine SymbolicStructDefinition::get_default_valued_struct(symbolic_struct_definition: &SymbolicStructDefinition) -> ValuedStruct {
    let struct_ref: SymbolicStructRef = SymbolicStructRef::new(
        SymbolicStructDefinition::get_symbol_namespace(symbolic_struct_definition));
    let mut valued: ValuedStruct = ValuedStruct::new_with_layout_kind(
        &struct_ref, symbolic_struct_definition.layout_kind, &[]);
    SymbolicStructDefinition::fill_default_fields(symbolic_struct_definition, &mut valued);
    valued
}

machine SymbolicStructDefinition::fill_default_fields(
    symbolic_struct_definition: &SymbolicStructDefinition,
    valued: &mut ValuedStruct
) {
    transition { _ -> each(symbolic_struct_definition, valued, 0) }
    state each(symbolic_struct_definition: &SymbolicStructDefinition, valued: &mut ValuedStruct, position: u64) {
        transition position < symbolic_struct_definition.field_count && position < 64 {
            true -> at(symbolic_struct_definition, valued, position)
            false -> done(symbolic_struct_definition, valued)
            _ -> done(symbolic_struct_definition, valued)
        }
    }
    state at(symbolic_struct_definition: &SymbolicStructDefinition, valued: &mut ValuedStruct, position: u64)
    requires 0 <= position && position < 64;
    {
        transition SymbolicFieldDefinition::is_unassigned(&symbolic_struct_definition.fields[position]) {
            true -> each(symbolic_struct_definition, valued, position + 1)
            false -> push(symbolic_struct_definition, valued, position)
            _ -> each(symbolic_struct_definition, valued, position + 1)
        }
    }
    state push(symbolic_struct_definition: &SymbolicStructDefinition, valued: &mut ValuedStruct, position: u64)
    requires 0 <= position && position < 64;
    {
        let field: ValuedStructField = SymbolicFieldDefinition::get_valued_struct_field(&symbolic_struct_definition.fields[position]);
        ValuedStruct::append_field(valued, &field);
        transition { _ -> each(symbolic_struct_definition, valued, position + 1) }
    }
    state done(symbolic_struct_definition: &SymbolicStructDefinition, valued: &mut ValuedStruct) {
    }
}

machine SymbolicStructDefinition::set_symbol_namespace(symbolic_struct_definition: &mut SymbolicStructDefinition, namespace: &[u8]) {
    let mut position: u64 = 0;
    symbolic_struct_definition.symbol_namespace_len = 0;
    transition { _ -> copy(symbolic_struct_definition, position, namespace) }
    state copy(symbolic_struct_definition: &mut SymbolicStructDefinition, position: u64, namespace: &[u8]) {
        transition position < namespace.len && position < 256 {
            true -> step(symbolic_struct_definition, position, namespace)
            false -> done(symbolic_struct_definition)
        }
    }
    state step(symbolic_struct_definition: &mut SymbolicStructDefinition, position: u64, namespace: &[u8]) {
        symbolic_struct_definition.symbol_namespace[position] = namespace[position];
        symbolic_struct_definition.symbol_namespace_len = position + 1;
        transition { _ -> copy(symbolic_struct_definition, position + 1, namespace) }
    }
    state done(symbolic_struct_definition: &mut SymbolicStructDefinition) {
        symbolic_struct_definition.symbol_namespace_len = symbolic_struct_definition.symbol_namespace_len;
    }
}

machine SymbolicStructDefinition::fill_fields(
    symbolic_struct_definition: &mut SymbolicStructDefinition,
    fields: &[SymbolicFieldDefinition]
) {
    let mut position: u64 = 0;
    transition { _ -> copy(symbolic_struct_definition, position, fields) }
    state copy(symbolic_struct_definition: &mut SymbolicStructDefinition, position: u64, fields: &[SymbolicFieldDefinition]) {
        transition position < fields.len && position < 64 {
            true -> step(symbolic_struct_definition, position, fields)
            false -> done(symbolic_struct_definition)
        }
    }
    state step(symbolic_struct_definition: &mut SymbolicStructDefinition, position: u64, fields: &[SymbolicFieldDefinition])
    requires 0 <= position && position < 64;
    {
        symbolic_struct_definition.fields[position] = SymbolicFieldDefinition::clone(&fields[position]);
        symbolic_struct_definition.field_count = position + 1;
        transition { _ -> copy(symbolic_struct_definition, position + 1, fields) }
    }
    state done(symbolic_struct_definition: &mut SymbolicStructDefinition) {
        symbolic_struct_definition.field_count = symbolic_struct_definition.field_count;
    }
}

// Upstream `Clone` — fields deep-copy element-wise; scalar fields copy.
pub machine SymbolicStructDefinition::clone(symbolic_struct_definition: &SymbolicStructDefinition) -> SymbolicStructDefinition {
    let mut cloned: SymbolicStructDefinition = (SymbolicStructDefinition {
        symbol_namespace_len: 0,
        layout_kind: symbolic_struct_definition.layout_kind,
        has_declared_size: symbolic_struct_definition.has_declared_size,
        declared_size_in_bytes: symbolic_struct_definition.declared_size_in_bytes,
        field_count: 0,
    });
    SymbolicStructDefinition::clone_from(&mut cloned, symbolic_struct_definition);
    (cloned)
}

pub machine SymbolicStructDefinition::clone_from(symbolic_struct_definition: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition) {
    symbolic_struct_definition.layout_kind = source.layout_kind;
    symbolic_struct_definition.has_declared_size = source.has_declared_size;
    symbolic_struct_definition.declared_size_in_bytes = source.declared_size_in_bytes;
    symbolic_struct_definition.field_count = 0;
    transition {
        _ -> copy_namespace(symbolic_struct_definition, source, 0)
    }
    state copy_namespace(symbolic_struct_definition: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition, position: u64) {
        transition position < source.symbol_namespace_len && position < 256 {
            true -> store_namespace(symbolic_struct_definition, source, position)
            false -> finish_namespace(symbolic_struct_definition, source)
        }
    }
    state store_namespace(symbolic_struct_definition: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition, position: u64) {
        symbolic_struct_definition.symbol_namespace[position] = source.symbol_namespace[position];
        transition {
            _ -> copy_namespace(symbolic_struct_definition, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_namespace(symbolic_struct_definition: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition) {
        symbolic_struct_definition.symbol_namespace_len = source.symbol_namespace_len;
        transition {
            _ -> copy_fields(symbolic_struct_definition, source, 0)
        }
    }
    state copy_fields(symbolic_struct_definition: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition, position: u64) {
        transition position < source.field_count && position < 64 {
            true -> store_field(symbolic_struct_definition, source, position)
            false -> finish_fields(symbolic_struct_definition, source)
        }
    }
    state store_field(symbolic_struct_definition: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition, position: u64)
        requires position < source.field_count && position < 64
    {
        SymbolicFieldDefinition::clone_from(&mut symbolic_struct_definition.fields[position], &source.fields[position]);
        transition {
            _ -> copy_fields(symbolic_struct_definition, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_fields(symbolic_struct_definition: &mut SymbolicStructDefinition, source: &SymbolicStructDefinition) {
        symbolic_struct_definition.field_count = source.field_count;
    }
}

// Empty definition — no namespace, no fields; the record's default-able
// fields are explicit since the type has no `default()` upstream either.
pub machine SymbolicStructDefinition::empty() -> SymbolicStructDefinition {
    SymbolicStructDefinition {
        symbol_namespace_len: 0,
        layout_kind: SymbolicLayoutKind::Struct,
        has_declared_size: false,
        declared_size_in_bytes: 0,
        field_count: 0,
    }
}
