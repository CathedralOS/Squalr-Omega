module src::structures::structs::symbolic_resolver_relative_symbol_path;

use src::structures::structs::owned_symbolic_pointer_chain::OwnedSymbolicPointerChain;

// Port of structures/structs/symbolic_resolver_definition.rs's
// `SymbolicResolverRelativeSymbolPath` {pointer_chain}.
pub data SymbolicResolverRelativeSymbolPath {
    pointer_chain: OwnedSymbolicPointerChain;
}

pub machine SymbolicResolverRelativeSymbolPath::default() -> SymbolicResolverRelativeSymbolPath {
    (SymbolicResolverRelativeSymbolPath {
        pointer_chain: OwnedSymbolicPointerChain::default(),
    })
}

pub machine SymbolicResolverRelativeSymbolPath::new(pointer_chain: &OwnedSymbolicPointerChain) -> SymbolicResolverRelativeSymbolPath {
    let mut path: SymbolicResolverRelativeSymbolPath = SymbolicResolverRelativeSymbolPath::default();
    path.pointer_chain.clone_from(pointer_chain);
    (path)
}

pub machine SymbolicResolverRelativeSymbolPath::get_pointer_chain(&self) -> &OwnedSymbolicPointerChain {
    (&self.pointer_chain)
}

pub machine SymbolicResolverRelativeSymbolPath::clone_from(&mut self, source: &SymbolicResolverRelativeSymbolPath) {
    self.pointer_chain.clone_from(&source.pointer_chain);
}

// Port of `SymbolicResolverRelativeSymbolPathSegment` — declared in the
// same upstream file; consumers resolve segments through it.
pub data SymbolicResolverRelativeSymbolPathSegment {
    field_name: [u8; 256];
    field_name_len: u64;
    offset_in_bytes: u64;
}

pub machine SymbolicResolverRelativeSymbolPathSegment::default() -> SymbolicResolverRelativeSymbolPathSegment {
    (SymbolicResolverRelativeSymbolPathSegment {
        field_name_len: 0,
        offset_in_bytes: 0,
    })
}

pub machine SymbolicResolverRelativeSymbolPathSegment::new(field_name: &[u8], offset_in_bytes: u64) -> SymbolicResolverRelativeSymbolPathSegment {
    let mut segment: SymbolicResolverRelativeSymbolPathSegment = (SymbolicResolverRelativeSymbolPathSegment {
        field_name_len: 0,
        offset_in_bytes: offset_in_bytes,
    });
    segment.set_field_name(field_name);
    (segment)
}

pub machine SymbolicResolverRelativeSymbolPathSegment::get_field_name(&self) -> &[u8] {
    transition self.field_name_len <= 256 {
        true -> (&self.field_name[0..self.field_name_len])
        false -> (&self.field_name[0..256])
        _ -> (&self.field_name[0..256])
    }
}

pub machine SymbolicResolverRelativeSymbolPathSegment::set_field_name(&mut self, field_name: &[u8]) {
    self.field_name_len = 0;
    transition {
        _ -> copy(field_name, 0)
    }
    state copy(&mut self, field_name: &[u8], position: u64) {
        transition position < field_name.len && position < 256 {
            true -> store(field_name, position)
            false -> finish(position)
        }
    }
    state store(&mut self, field_name: &[u8], position: u64) {
        self.field_name[position] = field_name[position];
        transition {
            _ -> copy(field_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.field_name_len = count;
    }
}

pub machine SymbolicResolverRelativeSymbolPathSegment::get_offset_in_bytes(&self) -> u64 {
    (self.offset_in_bytes)
}

pub machine SymbolicResolverRelativeSymbolPathSegment::set_offset_in_bytes(&mut self, offset_in_bytes: u64) {
    self.offset_in_bytes = offset_in_bytes;
}
