module src::structures::structs::symbolic_struct_ref;

// Port of structures/structs/symbolic_struct_ref.rs: a handle to a symbolic
// struct definition, carrying only the struct's symbol namespace.
//
// Upstream keeps the namespace in a growable String; the byte domain keeps it
// in a bounded inline buffer plus a length — the same translation
// DataTypeRef::data_type_id and AnonymousValueString use, bounded at 256
// bytes (namespaces are `module::path` style identifiers far shorter than the
// bound; longer namespaces refuse to store rather than truncate — named
// deviation). Upstream is Clone, not Copy, so the record carries no [copy].
pub data SymbolicStructRef {
    symbolic_struct_namespace: [u8; 256];
    symbolic_struct_namespace_len: u64;
}

// Upstream `SymbolicStructRef::new` — stores the namespace verbatim up to the
// bound; longer input is refused and stores an empty namespace (callers that
// need the refusal signal use `try_new` below, matching the package's
// refusal convention).
pub machine SymbolicStructRef::new(symbolic_struct_namespace: &[u8]) -> SymbolicStructRef {
    let mut symbolic_struct_ref: SymbolicStructRef = SymbolicStructRef {
        symbolic_struct_namespace_len: 0
    };
    symbolic_struct_ref.fill_namespace(symbolic_struct_namespace);
    symbolic_struct_ref
}

// Refusal-signalling constructor: returns false when the namespace exceeds
// the 256-byte bound, storing nothing.
pub machine SymbolicStructRef::try_new(&mut self, symbolic_struct_namespace: &[u8]) -> bool {
    transition symbolic_struct_namespace.len <= 256 {
        true -> store(symbolic_struct_namespace)
        false -> (false)
    }
    state store(&mut self, symbolic_struct_namespace: &[u8]) -> bool {
        self.fill_namespace(symbolic_struct_namespace);
        true
    }
}

// Upstream `new_anonymous` — the empty namespace marks an anonymous struct.
pub machine SymbolicStructRef::new_anonymous() -> SymbolicStructRef {
    SymbolicStructRef { symbolic_struct_namespace_len: 0 }
}

pub machine SymbolicStructRef::default() -> SymbolicStructRef {
    SymbolicStructRef::new_anonymous()
}

// Upstream FromStr: infallible, every string is a namespace — `parse` is the
// infallible surface; no parse carrier is needed.
pub machine SymbolicStructRef::parse(text: &[u8]) -> SymbolicStructRef {
    SymbolicStructRef::new(text)
}

pub machine SymbolicStructRef::clone(source: &SymbolicStructRef) -> SymbolicStructRef {
    let mut symbolic_struct_ref: SymbolicStructRef = SymbolicStructRef {
        symbolic_struct_namespace_len: 0
    };
    symbolic_struct_ref.copy_namespace_window(source, 0, source.symbolic_struct_namespace_len);
    symbolic_struct_ref
}

machine SymbolicStructRef::fill_namespace(&mut self, namespace: &[u8]) {
    transition { _ -> copy(namespace, 0) }
    state copy(&mut self, namespace: &[u8], position: u64) {
        transition position < namespace.len && position < 256 {
            true -> store(namespace, position)
            false -> finish(position)
        }
    }
    state store(&mut self, namespace: &[u8], position: u64) {
        self.symbolic_struct_namespace[position] = namespace[position];
        transition { _ -> copy(namespace, position + 1) }
    }
    state finish(&mut self, count: u64) {
        self.symbolic_struct_namespace_len = count;
    }
}

machine SymbolicStructRef::copy_namespace_window(
    &mut self,
    source: &SymbolicStructRef,
    start: u64,
    end: u64
) {
    transition { _ -> copy(source, start, end, 0) }
    state copy(&mut self, source: &SymbolicStructRef, at: u64, end: u64, position: u64) {
        transition at < end && at < source.symbolic_struct_namespace_len && at < 256 && position < 256 {
            true -> store(source, at, end, position)
            false -> finish(position)
        }
    }
    state store(&mut self, source: &SymbolicStructRef, at: u64, end: u64, position: u64) {
        self.symbolic_struct_namespace[position] = source.symbolic_struct_namespace[at];
        transition { _ -> copy(source, at + 1, end, position + 1) }
    }
    state finish(&mut self, count: u64) {
        self.symbolic_struct_namespace_len = count;
    }
}

// Upstream `get_symbolic_struct_namespace`: the borrowed &str view is not
// retainable, so reads are length + per-byte access plus a `&[u8]` window.
pub machine SymbolicStructRef::get_symbolic_struct_namespace_len(&self) -> u64 {
    self.symbolic_struct_namespace_len
}

pub machine SymbolicStructRef::get_symbolic_struct_namespace_byte(&self, position: u64) -> u8 {
    transition position < self.symbolic_struct_namespace_len && position < 256 {
        true -> (self.symbolic_struct_namespace[position])
        false -> (0)
        _ -> (0)
    }
}

pub machine SymbolicStructRef::get_symbolic_struct_namespace(&self) -> &[u8] {
    transition self.symbolic_struct_namespace_len <= 256 {
        true -> (&self.symbolic_struct_namespace[0..self.symbolic_struct_namespace_len])
        false -> (&self.symbolic_struct_namespace[0..0])
        _ -> (&self.symbolic_struct_namespace[0..0])
    }
}

// Upstream `namespace.trim().is_empty()` used by ValuedStruct::get_struct_layout.
pub machine SymbolicStructRef::is_anonymous(&self) -> bool {
    self.symbolic_struct_namespace_len == 0
}

// Upstream `PartialEq` — compares the stored namespaces.
pub machine SymbolicStructRef::equals(&self, other: &SymbolicStructRef) -> bool {
    transition self.symbolic_struct_namespace_len == other.symbolic_struct_namespace_len {
        true -> scan(0, other)
        false -> (false)
    }
    state scan(&self, position: u64, other: &SymbolicStructRef) -> bool {
        transition position < self.symbolic_struct_namespace_len && position < 256 {
            true -> compare(position, other)
            false -> (true)
        }
    }
    state compare(&self, position: u64 [0..256], other: &SymbolicStructRef) -> bool {
        transition self.symbolic_struct_namespace[position] == other.symbolic_struct_namespace[position] {
            true -> scan(position + 1, other)
            false -> (false)
            _ -> (false)
        }
    }
}
