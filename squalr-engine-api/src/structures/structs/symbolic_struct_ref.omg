module src::structures::structs::symbolic_struct_ref;

// Port of structures/structs/symbolic_struct_ref.rs: a handle to a symbolic
// struct definition, carrying only the struct's symbol namespace.
//
// Upstream keeps the namespace in a growable String; the byte domain keeps it
// in a bounded inline buffer plus a length — the same translation
// DataTypeRef::data_type_id and AnonymousValueString use, bounded at 256
// bytes (namespaces are `module::path` style identifiers far shorter than the
// bound; longer namespaces refuse to store rather than truncate — named
// deviation). Upstream is Clone, not Copy, so the record carries no [copy].
pub data SymbolicStructRef {
    symbolic_struct_namespace: [u8; 256];
    symbolic_struct_namespace_len: u64;
}

// Upstream `SymbolicStructRef::new` — stores the namespace verbatim up to the
// bound; longer input is refused and stores an empty namespace (callers that
// need the refusal signal use `try_new` below, matching the package's
// refusal convention).
pub machine SymbolicStructRef::new(symbolic_struct_namespace: &[u8]) -> SymbolicStructRef {
    let mut symbolic_struct_ref: SymbolicStructRef = SymbolicStructRef {
        symbolic_struct_namespace_len: 0
    };
    SymbolicStructRef::fill_namespace(&mut symbolic_struct_ref, symbolic_struct_namespace);
    symbolic_struct_ref
}

// Refusal-signalling constructor: returns false when the namespace exceeds
// the 256-byte bound, storing nothing.
pub machine SymbolicStructRef::try_new(this: &mut SymbolicStructRef, symbolic_struct_namespace: &[u8]) -> bool {
    transition symbolic_struct_namespace.len <= 256 {
        true -> store(this, symbolic_struct_namespace)
        false -> (false)
    }
    state store(this: &mut SymbolicStructRef, symbolic_struct_namespace: &[u8]) -> bool {
        SymbolicStructRef::fill_namespace(&mut this, symbolic_struct_namespace);
        true
    }
}

// Upstream `new_anonymous` — the empty namespace marks an anonymous struct.
pub machine SymbolicStructRef::new_anonymous() -> SymbolicStructRef {
    SymbolicStructRef { symbolic_struct_namespace_len: 0 }
}

pub machine SymbolicStructRef::default() -> SymbolicStructRef {
    SymbolicStructRef::new_anonymous()
}

// Upstream FromStr: infallible, every string is a namespace — `parse` is the
// infallible surface; no parse carrier is needed.
pub machine SymbolicStructRef::parse(text: &[u8]) -> SymbolicStructRef {
    SymbolicStructRef::new(text)
}

pub machine SymbolicStructRef::clone(source: &SymbolicStructRef) -> SymbolicStructRef {
    let mut symbolic_struct_ref: SymbolicStructRef = SymbolicStructRef {
        symbolic_struct_namespace_len: 0
    };
    SymbolicStructRef::copy_namespace_window(&mut symbolic_struct_ref, source, 0, source.symbolic_struct_namespace_len);
    symbolic_struct_ref
}

machine SymbolicStructRef::fill_namespace(this: &mut SymbolicStructRef, namespace: &[u8]) {
    transition { _ -> copy(this, namespace, 0) }
    state copy(this: &mut SymbolicStructRef, namespace: &[u8], position: u64) {
        transition position < namespace.len && position < 256 {
            true -> store(this, namespace, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut SymbolicStructRef, namespace: &[u8], position: u64) {
        this.symbolic_struct_namespace[position] = namespace[position];
        transition { _ -> copy(this, namespace, position + 1) }
    }
    state finish(this: &mut SymbolicStructRef, count: u64) {
        this.symbolic_struct_namespace_len = count;
    }
}

machine SymbolicStructRef::copy_namespace_window(
    this: &mut SymbolicStructRef,
    source: &SymbolicStructRef,
    start: u64,
    end: u64
) {
    transition { _ -> copy(this, source, start, end, 0) }
    state copy(this: &mut SymbolicStructRef, source: &SymbolicStructRef, at: u64, end: u64, position: u64) {
        transition at < end && at < source.symbolic_struct_namespace_len && at < 256 && position < 256 {
            true -> store(this, source, at, end, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut SymbolicStructRef, source: &SymbolicStructRef, at: u64, end: u64, position: u64) {
        this.symbolic_struct_namespace[position] = source.symbolic_struct_namespace[at];
        transition { _ -> copy(this, source, at + 1, end, position + 1) }
    }
    state finish(this: &mut SymbolicStructRef, count: u64) {
        this.symbolic_struct_namespace_len = count;
    }
}

// Upstream `get_symbolic_struct_namespace`: the borrowed &str view is not
// retainable, so reads are length + per-byte access plus a `&[u8]` window.
pub machine SymbolicStructRef::get_symbolic_struct_namespace_len(this: &SymbolicStructRef) -> u64 {
    this.symbolic_struct_namespace_len
}

pub machine SymbolicStructRef::get_symbolic_struct_namespace_byte(this: &SymbolicStructRef, position: u64) -> u8 {
    transition position < this.symbolic_struct_namespace_len && position < 256 {
        true -> (this.symbolic_struct_namespace[position])
        false -> (0)
        _ -> (0)
    }
}

pub machine SymbolicStructRef::get_symbolic_struct_namespace(this: &SymbolicStructRef) -> &[u8] {
    transition this.symbolic_struct_namespace_len <= 256 {
        true -> arm_result_119_0(this)
        _ -> (&this.symbolic_struct_namespace[0..0])
    }
    state arm_result_119_0(this: &SymbolicStructRef) -> &[u8]
    
    requires this.symbolic_struct_namespace_len <= 256;
{
        (&this.symbolic_struct_namespace[0..this.symbolic_struct_namespace_len])
    }
}

// Upstream `namespace.trim().is_empty()` used by ValuedStruct::get_struct_layout.
pub machine SymbolicStructRef::is_anonymous(this: &SymbolicStructRef) -> bool {
    this.symbolic_struct_namespace_len == 0
}

// Upstream `PartialEq` — compares the stored namespaces.
pub machine SymbolicStructRef::equals(this: &SymbolicStructRef, other: &SymbolicStructRef) -> bool {
    transition this.symbolic_struct_namespace_len == other.symbolic_struct_namespace_len {
        true -> scan(this, 0, other)
        false -> (false)
    }
    state scan(this: &SymbolicStructRef, position: u64, other: &SymbolicStructRef) -> bool {
        transition position < this.symbolic_struct_namespace_len && position < 256 {
            true -> compare(this, position, other)
            false -> (true)
        }
    }
    state compare(this: &SymbolicStructRef, position: u64, other: &SymbolicStructRef) -> bool
        requires 0 <= position && position < 256
    {
        transition this.symbolic_struct_namespace[position] == other.symbolic_struct_namespace[position] {
            true -> scan(this, position + 1, other)
            false -> (false)
            _ -> (false)
        }
    }
}
