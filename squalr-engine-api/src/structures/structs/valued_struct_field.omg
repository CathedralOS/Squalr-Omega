module src::structures::structs::valued_struct_field;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::data_values::data_value::DataValue;
use src::structures::structs::valued_struct::ValuedStructPool;

// Port of structures/structs/valued_struct_field.rs: an editable display
// field — a name, a payload, and a read-only flag.
//
// Upstream `ValuedStructFieldData::NestedStruct(Box<ValuedStruct>)` is heap
// indirection. The byte domain has no heap-resident inline recursion, so the
// NestedStruct case carries `nested_struct_index` — an index into the
// bounded flat `ValuedStructPool` owned by the top-level ValuedStruct the
// field belongs to (see valued_struct.omg). This preserves the tree shape
// with arbitrary depth up to the pool bound — a named deviation mirroring
// PointerScanNode::child_node_ids. A field created before its nested struct
// is pushed into the pool keeps index 0; every recursive walk takes the pool
// explicitly.
pub data ValuedStructFieldData {
    case Value(value: DataValue);
    case NestedStruct(nested_struct_index: u64);
}

pub machine ValuedStructFieldData::default() -> ValuedStructFieldData {
    ValuedStructFieldData::Value { value: DataValue::default() }
}

pub data ValuedStructField {
    name: [u8; 256];
    name_len: u64;
    field_data: ValuedStructFieldData;
    is_read_only: bool;
}

// Upstream `ValuedStructField::new` — stores the name up to the 256-byte
// bound (named deviation: longer names truncate, matching the package's
// bounded-name convention).
pub machine ValuedStructField::new(
    name: &[u8],
    field_data: &ValuedStructFieldData,
    is_read_only: bool
) -> ValuedStructField {
    let hoist9: ValuedStructFieldData = ValuedStructFieldData::clone(&field_data);
    let mut field: ValuedStructField = ValuedStructField {
        name_len: 0,
        field_data: hoist9,
        is_read_only: is_read_only
    };
    ValuedStructField::fill_name(&mut field, name);
    field
}

pub machine ValuedStructField::default() -> ValuedStructField {
    ValuedStructField {
        name_len: 0,
        field_data: ValuedStructFieldData::default(),
        is_read_only: false
    }
}

// Case-payload calls cannot mint a union result inside a transition arm
// (result ownership), so payloads move by value into states that keep
// `&self` live and construct the case in the bare tail.
pub machine ValuedStructFieldData::clone(this: &ValuedStructFieldData) -> ValuedStructFieldData {
    transition this {
        ValuedStructFieldData::Value { value } -> clone_value(this, value)
        ValuedStructFieldData::NestedStruct { nested_struct_index } -> clone_nested(this, nested_struct_index)
        _ -> (ValuedStructFieldData::NestedStruct { nested_struct_index: 0 })
    }
    state clone_value(this: &ValuedStructFieldData, value: DataValue) -> ValuedStructFieldData {
        ValuedStructFieldData::Value { value: DataValue::clone(&value) }
    }
    state clone_nested(this: &ValuedStructFieldData, nested_struct_index: u64) -> ValuedStructFieldData {
        ValuedStructFieldData::NestedStruct { nested_struct_index: nested_struct_index }
    }
}

pub machine ValuedStructField::clone(source: &ValuedStructField) -> ValuedStructField {
    let hoist10: ValuedStructFieldData = ValuedStructFieldData::clone(&source.field_data);
    let mut field: ValuedStructField = ValuedStructField {
        name_len: 0,
        field_data: hoist10,
        is_read_only: source.is_read_only
    };
    ValuedStructField::fill_name_window(&mut field, source, 0, source.name_len);
    field
}

machine ValuedStructField::fill_name(this: &mut ValuedStructField, name: &[u8]) {
    transition { _ -> copy(this, name, 0) }
    state copy(this: &mut ValuedStructField, name: &[u8], position: u64) {
        transition position < name.len && position < 256 {
            true -> store(this, name, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ValuedStructField, name: &[u8], position: u64) {
        this.name[position] = name[position];
        transition { _ -> copy(this, name, position + 1) }
    }
    state finish(this: &mut ValuedStructField, count: u64) {
        this.name_len = count;
    }
}

machine ValuedStructField::fill_name_window(this: &mut ValuedStructField, source: &ValuedStructField, start: u64, end: u64) {
    transition { _ -> copy(this, source, start, end, 0) }
    state copy(this: &mut ValuedStructField, source: &ValuedStructField, at: u64, end: u64, position: u64) {
        transition at < end && at < source.name_len && at < 256 && position < 256 {
            true -> store(this, source, at, end, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ValuedStructField, source: &ValuedStructField, at: u64, end: u64, position: u64) {
        this.name[position] = source.name[at];
        transition { _ -> copy(this, source, at + 1, end, position + 1) }
    }
    state finish(this: &mut ValuedStructField, count: u64) {
        this.name_len = count;
    }
}

// Upstream `get_name` — the borrowed &str view is not retainable; reads are
// length + per-byte plus a &[u8] window.
pub machine ValuedStructField::get_name_len(this: &ValuedStructField) -> u64 {
    this.name_len
}

pub machine ValuedStructField::get_name_byte(this: &ValuedStructField, position: u64) -> u8 {
    transition position < this.name_len && position < 256 {
        true -> (this.name[position])
        false -> (0)
        _ -> (0)
    }
}

pub machine ValuedStructField::get_name(this: &ValuedStructField) -> &[u8] {
    transition this.name_len <= 256 {
        true -> arm_result_131_0(this)
        _ -> (&this.name[0..0])
    }
    state arm_result_131_0(this: &ValuedStructField) -> &[u8]
    
    requires this.name_len <= 256;
{
        (&this.name[0..this.name_len])
    }
}

// Upstream `field.get_name() == field_name` — byte-exact name equality.
pub machine ValuedStructField::name_equals(this: &ValuedStructField, name: &[u8]) -> bool {
    transition this.name_len == name.len {
        true -> scan(this, 0, name)
        false -> (false)
    }
    state scan(this: &ValuedStructField, position: u64, name: &[u8]) -> bool {
        transition position < this.name_len && position < name.len && position < 256 {
            true -> compare(this, position, name)
            false -> (true)
        }
    }
    state compare(this: &ValuedStructField, position: u64, name: &[u8]) -> bool
        requires 0 <= position && position < 256
    {
        transition this.name[position] == name[position] {
            true -> scan(this, position + 1, name)
            false -> (false)
            _ -> (false)
        }
    }
}

// Upstream `get_data_value` — Optional<&DataValue>. Optional is unmatchable
// in this pin; the field_data transition is the matchable surface, and this
// accessor reports whether the payload is a Value.
pub machine ValuedStructField::is_value(this: &ValuedStructField) -> bool {
    transition this.field_data {
        ValuedStructFieldData::Value { value } -> (true)
        _ -> (false)
    }
}

pub machine ValuedStructField::is_nested_struct(this: &ValuedStructField) -> bool {
    transition this.field_data {
        ValuedStructFieldData::NestedStruct { nested_struct_index } -> (true)
        _ -> (false)
    }
}

// Upstream `get_data_value` for Value fields — hands the caller an owned
// clone (upstream hands &DataValue; callers that mutate write back through
// `set_field_data`).
pub machine ValuedStructField::get_data_value(this: &ValuedStructField) -> DataValue {
    transition this.field_data {
        ValuedStructFieldData::Value { value } -> (DataValue::clone(&value))
        ValuedStructFieldData::NestedStruct { nested_struct_index } -> (DataValue::default())
        _ -> (DataValue::default())
    }
}

// Upstream `NestedStruct(_)` index — the pool slot holding the child.
pub machine ValuedStructField::get_nested_struct_index(this: &ValuedStructField) -> u64 {
    transition this.field_data {
        ValuedStructFieldData::NestedStruct { nested_struct_index } -> (nested_struct_index)
        _ -> (0)
    }
}

// Upstream `get_icon_id` — the value's data-type id, or empty for nested
// structs.
pub machine ValuedStructField::get_icon_id(this: &ValuedStructField) -> &[u8] {
    transition this.field_data {
        ValuedStructFieldData::Value { value } -> (DataValue::get_data_type_id(value))
        ValuedStructFieldData::NestedStruct { nested_struct_index } -> ("")
        _ -> ("")
    }
}

pub machine ValuedStructField::get_is_read_only(this: &ValuedStructField) -> bool {
    this.is_read_only
}

// Upstream `set_field_data`.
pub machine ValuedStructField::set_field_data(this: &mut ValuedStructField, valued_field_data: &ValuedStructFieldData) {
    this.field_data = ValuedStructFieldData::clone(&valued_field_data);
}

// Upstream `get_size_in_bytes` — Value → its byte length; NestedStruct → the
// nested struct's size, resolved through the pool (upstream dereferences the
// Box; the pool is the port's indirection). The pool machine walks the arena
// with an explicit pending stack — the call graph stays acyclic.
pub machine ValuedStructField::get_size_in_bytes(this: &ValuedStructField, pool: &ValuedStructPool) -> u64 {
    transition this.field_data {
        ValuedStructFieldData::Value { value } -> (DataValue::get_size_in_bytes(&value))
        ValuedStructFieldData::NestedStruct { nested_struct_index } -> (ValuedStructPool::get_struct_size_in_bytes(&pool, nested_struct_index))
        _ -> (0)
    }
}

// Upstream `get_bytes` — appends this field's bytes into `out` at `at`,
// returning the count written. Nested structs resolve through the pool.
pub machine ValuedStructField::get_bytes(this: &ValuedStructField, pool: &ValuedStructPool, out: &mut [u8], at: u64) -> u64 {
    transition this.field_data {
        ValuedStructFieldData::Value { value } -> (copy_value_bytes(&value, out, at))
        ValuedStructFieldData::NestedStruct { nested_struct_index } -> (ValuedStructPool::get_struct_bytes(&pool, nested_struct_index, out, at))
        _ -> (0)
    }
}

pub machine copy_value_bytes(value: &DataValue, out: &mut [u8], at: u64) -> u64 {
    let bytes: &[u8] = DataValue::get_value_bytes(value);
    transition { _ -> copy(value, bytes, out, at, 0) }
    state copy(value: &DataValue, bytes: &[u8], out: &mut [u8], at: u64, position: u64) -> u64 {
        let hoist1: u64 = DataValue::get_size_in_bytes(value);
        transition position < hoist1 && position < 4096 && position < bytes.len && (((at as u64 in Wrapping) + (position as u64 in Wrapping)) as u64) < out.len {
            true -> store(value, bytes, out, at, position, (((at as u64 in Wrapping) + (position as u64 in Wrapping)) as u64))
            false -> (position)
        }
    }
    state store(value: &DataValue, bytes: &[u8], out: &mut [u8], at: u64, position: u64, write_index: u64) -> u64
        requires 0 <= position && position < 4096
    {
        out[write_index] = bytes[position];
        transition { _ -> copy(value, bytes, out, at, position + 1) }
    }
}

// Upstream `copy_from_bytes` — writes this field's leading bytes from `bytes`.
// Value fields hand the window to DataValue::copy_from_bytes; nested structs
// recurse through the pool. Returns false only on size mismatch for nested
// struct fields (upstream DataValue::copy_from_bytes never fails; the ported
// bound refusal surfaces here).
pub machine ValuedStructField::copy_from_bytes(
    this: &mut ValuedStructField,
    pool: &mut ValuedStructPool,
    bytes: &[u8]
) -> bool {
    let hoist2: bool = ValuedStructField::is_value(&this);
    transition hoist2 {
        true -> value_arm(this, bytes)
        false -> nested_arm(this, pool, bytes)
    }
    state nested_arm(this: &mut ValuedStructField, pool: &mut ValuedStructPool, bytes: &[u8]) -> bool {
        transition this.field_data {
            ValuedStructFieldData::NestedStruct { nested_struct_index } -> (ValuedStructPool::copy_struct_from_bytes(&mut pool, nested_struct_index, bytes))
            _ -> (false)
        }
    }
    // The case binding borrows the payload, so it is cloned at the arm — a
    // borrowed binding cannot ride into the `&mut this` state (alias rule).
    // `get_data_value` hands back an owned clone (`&this` borrow dies in the
    // call); the port copies into it, then writes it back into `field_data`.
    state value_arm(this: &mut ValuedStructField, bytes: &[u8]) -> bool {
        let mut updated: DataValue = ValuedStructField::get_data_value(&this);
        let stored: bool = DataValue::copy_from_bytes(&mut updated, bytes);
        this.field_data = ValuedStructFieldData::Value { value: updated };
        stored
    }
}

// Upstream `get_display_string` — the display-value formatter is owned by the
// CLI response handler in this package (same delegation as
// ScanResultValued's display vectors); nested-struct brace formatting lands
// with that leg. Named deferral.
