module src::structures::structs::symbol_resolver;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::data_values::data_value::DataValue;
use src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;

// Port of structures/structs/symbol_resolver.rs — the `SymbolResolver`
// boundary trait. Resolves symbol layouts and data type defaults for
// struct materialization operations.
//
// Deviations:
//  - `Option<DataValue>` carries as a found-flag carrier record; the
//    payload moves whole (no shared Option<T> exists in the codebase).
//  - `Option<Arc<SymbolicStructDefinition>>` carries the definition whole
//    inside the carrier — shared-ownership has no layout here, so the
//    Arc's pointed-at value materializes into the carrier instead.
//  - `&str` parameters ride bounded `&[u8]` spans.
pub data SymbolResolverDefaultValue {
    found: bool;
    value: DataValue;
}

pub data SymbolResolverStructLayout {
    found: bool;
    layout: SymbolicStructDefinition;
}

pub trait SymbolResolver<Provider> {
    machine get_default_value(
        provider: &Provider,
        data_type_ref: &DataTypeRef
    ) -> SymbolResolverDefaultValue;

    machine get_unit_size_in_bytes(
        provider: &Provider,
        data_type_ref: &DataTypeRef
    ) -> u64;

    machine get_struct_layout(
        provider: &Provider,
        symbolic_struct_namespace: &[u8]
    ) -> SymbolResolverStructLayout;
}
