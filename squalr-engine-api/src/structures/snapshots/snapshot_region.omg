module src::structures::snapshots::snapshot_region;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::memory::normalized_region::NormalizedRegion;
use src::structures::results::snapshot_region_scan_results::SnapshotRegionScanResults;
use src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use src::structures::scanning::filters::snapshot_region_filter_collection::SnapshotRegionFilterCollection;
use src::structures::snapshots::deleted_scan_result_index_set::DeletedScanResultIndexSet;
use src::structures::snapshots::element_window::ElementWindow;

// Port of structures/snapshots/snapshot_region.rs: a normalized memory span
// plus its collected values and the per-type filter results scans produce.
//
// Value model: upstream stores raw `current_values`/`previous_values` byte
// vectors; the port stores decoded element windows (ElementWindow — one u64
// per aligned element), the representation the ported scalar scanners
// consume. Byte coverage stays exact: `region_size` is bytes and element i
// covers `[base + i*8, base + i*8 + 8)`.
//
// `page_boundaries` records where adjacent pages merged into this region —
// value collection must not read across them (upstream keeps the boundary
// addresses at merge time for exactly this). Bounded at 64 boundaries.
//
// `page_boundary_tombstones` mirrors upstream's `HashSet<u64>` of failed
// range-start addresses: when a page-split read fails, its start address is
// tombstoned and excluded from `get_collected_byte_count`. Bounded at 64.
//
// No Vec/HashSet in this pin: scan results, windows and tombstones are
// bounded; overflow is a named deviation recorded at the bounded carriers.
//
// Flat mirrors of the nested scalars (`base_address`/`region_size`/
// `current_element_count`): native runtime observation admits exactly one
// field leaf after an array index, so `regions[0].normalized_region.X`
// reads cannot realize natively. Entry-side verification reads these
// mirrors; every writer below keeps them in step with the nested fields.
pub data SnapshotRegion {
    normalized_region: NormalizedRegion;
    base_address: u64;
    region_size: u64;
    current_values: ElementWindow;
    current_element_count: u64;
    previous_values: ElementWindow;
    page_boundaries: [u64; 64];
    page_boundary_count: u64;
    page_boundary_tombstones: [u64; 64];
    page_boundary_tombstone_count: u64;
    scan_results: SnapshotRegionScanResults;
}

pub machine SnapshotRegion::new(base_address: u64, region_size: u64) -> SnapshotRegion {
    SnapshotRegion {
        normalized_region: NormalizedRegion {
            base_address: base_address,
            region_size: region_size,
        },
        base_address: base_address,
        region_size: region_size,
        current_values: ElementWindow::empty(),
        current_element_count: 0,
        previous_values: ElementWindow::empty(),
        page_boundary_count: 0,
        page_boundary_tombstone_count: 0,
        scan_results: SnapshotRegionScanResults::empty(),
    }
}

// The captured-input adapter, element-domain analogue of upstream
// `SnapshotRegion::from_bytes`: caller-supplied current values with the
// region sized to their byte coverage (element stride 8). Supplied
// snapshots are the sanctioned testing adapter — the scan engine itself is
// unmodified.
pub machine SnapshotRegion::from_elements(
    base_address: u64,
    current_values: ElementWindow
) -> SnapshotRegion {
    let mut region: SnapshotRegion = SnapshotRegion::new(base_address, 0);
    let covered_bytes: u64 = ElementWindow::get_covered_byte_count(&current_values, 8);
    SnapshotRegion::set_region_size(&mut region, covered_bytes);
    SnapshotRegion::set_current_values(&mut region, &current_values);
    region
}

// Supplied-snapshot adapter: a region seeded with up to five inline u64
// elements. Upstream tests hand the region a Vec of any length; the owned
// model cannot mutate a local and then borrow it, so the window is built
// inside the call frame and the region returns fully formed.
pub machine SnapshotRegion::of_elements(
    base_address: u64,
    element_count: u64,
    e0: u64,
    e1: u64,
    e2: u64,
    e3: u64,
    e4: u64
) -> SnapshotRegion {
    let window: ElementWindow = ElementWindow::of_elements(
        element_count, e0, e1, e2, e3, e4);
    let mut region: SnapshotRegion = SnapshotRegion::new(base_address, 0);
    SnapshotRegion::set_region_size(&mut region, ElementWindow::get_covered_byte_count(&window, 1));
    SnapshotRegion::set_current_values(&mut region, &window);
    region
}

pub machine SnapshotRegion::clone(source: &SnapshotRegion) -> SnapshotRegion {
    let mut region: SnapshotRegion = SnapshotRegion::new(
        NormalizedRegion::get_base_address(&source.normalized_region),
        NormalizedRegion::get_region_size(&source.normalized_region),
    );
    SnapshotRegion::clone_from(&mut region, source);
    region
}

pub machine SnapshotRegion::clone_from(this: &mut SnapshotRegion, source: &SnapshotRegion) {
    NormalizedRegion::clone_from(&mut this.normalized_region, &source.normalized_region);
    this.base_address = source.base_address;
    this.region_size = source.region_size;
    ElementWindow::clone_from(&mut this.current_values, &source.current_values);
    this.current_element_count = source.current_element_count;
    ElementWindow::clone_from(&mut this.previous_values, &source.previous_values);
    SnapshotRegionScanResults::clone_from(&mut this.scan_results, &source.scan_results);
    this.page_boundary_count = source.page_boundary_count;
    this.page_boundary_tombstone_count = source.page_boundary_tombstone_count;
    SnapshotRegion::copy_boundaries(&mut this, source, 0);
    SnapshotRegion::copy_tombstones(&mut this, source, 0);
}

machine SnapshotRegion::copy_tombstones(this: &mut SnapshotRegion, source: &SnapshotRegion, position: u64) {
    transition position < source.page_boundary_tombstone_count && position < 64 {
        true -> copy(this, source, position)
        false -> done(this)
    }
    state copy(this: &mut SnapshotRegion, source: &SnapshotRegion, position: u64) {
        this.page_boundary_tombstones[position] = source.page_boundary_tombstones[position];
        transition { _ -> copy_tombstones(this, source, position + 1) }
    }
    state done(this: &mut SnapshotRegion) {
        this.page_boundary_tombstone_count = this.page_boundary_tombstone_count;
    }
}

// Upstream `page_boundary_tombstones.clear()` at the head of every
// `read_snapshot_region_values` — stale read failures from a previous
// collection do not carry into the next.
pub machine SnapshotRegion::clear_page_boundary_tombstones(this: &mut SnapshotRegion) {
    this.page_boundary_tombstone_count = 0;
}

// Upstream `page_boundary_tombstones.insert(address)`: mark the read range
// beginning at `address` as failed. Bounded at 64 — overflow drops the
// tombstone (carrier deviation; upstream's set is unbounded).
pub machine SnapshotRegion::push_page_boundary_tombstone(this: &mut SnapshotRegion, address: u64) -> bool {
    transition this.page_boundary_tombstone_count < 64 {
        true -> push(this, address)
        false -> (false)
    }
    state push(this: &mut SnapshotRegion, address: u64) -> bool {
        this.page_boundary_tombstones[this.page_boundary_tombstone_count] = address;
        this.page_boundary_tombstone_count = this.page_boundary_tombstone_count + 1;
        true
    }
}

// Upstream `page_boundary_tombstones.contains(&address)` — the per-range
// exclusion check `get_collected_byte_count` performs.
pub machine SnapshotRegion::has_page_boundary_tombstone(this: &SnapshotRegion, address: u64) -> bool {
    transition { _ -> seek(this, 0, address) }
    state seek(this: &SnapshotRegion, position: u64, address: u64) -> bool {
        transition position < this.page_boundary_tombstone_count && position < 64 {
            true -> probe(this, position, address)
            false -> (false)
        }
    }
    state probe(this: &SnapshotRegion, position: u64, address: u64) -> bool {
        transition this.page_boundary_tombstones[position] == address {
            true -> (true)
            false -> seek(this, position + 1, address)
            _ -> seek(this, position + 1, address)
        }
    }
}

pub machine SnapshotRegion::get_page_boundary_tombstone_count(this: &SnapshotRegion) -> u64 {
    this.page_boundary_tombstone_count
}

machine SnapshotRegion::copy_boundaries(this: &mut SnapshotRegion, source: &SnapshotRegion, position: u64) {
    transition position < source.page_boundary_count && position < 64 {
        true -> copy(this, source, position)
        false -> done(this)
    }
    state copy(this: &mut SnapshotRegion, source: &SnapshotRegion, position: u64) {
        this.page_boundaries[position] = source.page_boundaries[position];
        transition { _ -> copy_boundaries(this, source, position + 1) }
    }
    state done(this: &mut SnapshotRegion) {
        this.page_boundary_count = this.page_boundary_count;
    }
}

// Upstream `clone_snapshot_for_value_target_scan`'s per-region copy:
// normalized bounds + page boundaries + current/previous values +
// page-boundary tombstones — scan results are NOT carried: upstream
// resolves a value target with a fresh scan over the cloned region's
// values, so prior-round results must not seed the temporary snapshot
// (a carried collection would turn the fresh Equal scan into a
// retained-results round).
pub machine SnapshotRegion::clone_scan_state(this: &mut SnapshotRegion, source: &SnapshotRegion) {
    NormalizedRegion::clone_from(&mut this.normalized_region, &source.normalized_region);
    this.base_address = source.base_address;
    this.region_size = source.region_size;
    ElementWindow::clone_from(&mut this.current_values, &source.current_values);
    this.current_element_count = source.current_element_count;
    ElementWindow::clone_from(&mut this.previous_values, &source.previous_values);
    this.page_boundary_count = source.page_boundary_count;
    this.page_boundary_tombstone_count = source.page_boundary_tombstone_count;
    SnapshotRegion::copy_boundaries(&mut this, source, 0);
    SnapshotRegion::copy_tombstones(&mut this, source, 0);
}

pub machine SnapshotRegion::get_base_address(this: &SnapshotRegion) -> u64 {
    let hoist6: u64 = NormalizedRegion::get_base_address(&this.normalized_region);
    (hoist6)
}

pub machine SnapshotRegion::set_base_address(this: &mut SnapshotRegion, base_address: u64) {
    NormalizedRegion::set_base_address(&mut this.normalized_region, base_address);
    this.base_address = base_address;
}

pub machine SnapshotRegion::get_end_address(this: &SnapshotRegion) -> u64 {
    let hoist7: u64 = NormalizedRegion::get_end_address(&this.normalized_region);
    (hoist7)
}

pub machine SnapshotRegion::get_region_size(this: &SnapshotRegion) -> u64 {
    let hoist8: u64 = NormalizedRegion::get_region_size(&this.normalized_region);
    (hoist8)
}

pub machine SnapshotRegion::set_region_size(this: &mut SnapshotRegion, region_size: u64) {
    NormalizedRegion::set_region_size(&mut this.normalized_region, region_size);
    this.region_size = region_size;
}

// The region's normalized span, for callers building filters over it.
pub machine SnapshotRegion::get_normalized_region(this: &SnapshotRegion) -> NormalizedRegion {
    NormalizedRegion::clone(&this.normalized_region)
}

pub machine SnapshotRegion::has_current_values(this: &SnapshotRegion) -> bool {
    !ElementWindow::is_empty(&this.current_values)
}

pub machine SnapshotRegion::get_current_element_count(this: &SnapshotRegion) -> u64 {
    let hoist9: u64 = ElementWindow::get_element_count(&this.current_values);
    (hoist9)
}

// Fixture-side counterpart — entry closures cannot descend below an
// array element into a nested record (`carrier path` wall), so seeds
// reach the element window through a flat setter.
pub machine SnapshotRegion::set_current_element_count(this: &mut SnapshotRegion, element_count: u64) {
    this.current_values.element_count = element_count;
    this.current_element_count = element_count;
}

pub machine SnapshotRegion::get_current_element(this: &SnapshotRegion, position: u64) -> u64 {
    let hoist10: u64 = ElementWindow::get_element(&this.current_values, position);
    (hoist10)
}

pub machine SnapshotRegion::get_previous_element_count(this: &SnapshotRegion) -> u64 {
    let hoist11: u64 = ElementWindow::get_element_count(&this.previous_values);
    (hoist11)
}

pub machine SnapshotRegion::get_previous_element(this: &SnapshotRegion, position: u64) -> u64 {
    let hoist12: u64 = ElementWindow::get_element(&this.previous_values, position);
    (hoist12)
}

// Upstream `has_previous_values`: the prior collection window is populated.
pub machine SnapshotRegion::has_previous_values(this: &SnapshotRegion) -> bool {
    !ElementWindow::is_empty(&this.previous_values)
}

// `read_current_elements`/`read_previous_elements` are the owned-model
// equivalent of upstream's `get_current_values_filter_pointer`: the scanner
// asks for the elements a filter's range covers. Upstream hands out raw
// byte pointers; this port copies the covered window elements into `dst`
// and returns the count written. Element indexing presumes the window's
// capture stride equals the scan's unit size — the same binding the
// collector's window model carries. The alignment parameter rides the
// signature for the alignment-strided reads the vector legs will need;
// scalar reads are element-indexed.
pub machine SnapshotRegion::read_current_elements(
    this: &SnapshotRegion,
    snapshot_region_filter: &SnapshotRegionFilter,
    unit_size_in_bytes: u64,
    memory_alignment: MemoryAlignment,
    dst: &mut [u64]
) -> u64
crashes Abort
    requires unit_size_in_bytes > 0
{
    let alignment: u64 = MemoryAlignment::get_size_in_bytes(&memory_alignment);
    let base_delta: u64 = ((SnapshotRegionFilter::get_base_address(&snapshot_region_filter) as u64 in Saturating)
        - (NormalizedRegion::get_base_address(&this.normalized_region) as u64 in Saturating)) as u64;
    // Upstream's candidate count at the filter's scan stride — trailing
    // payload bytes are not candidate starts (`get_element_count` carries
    // the aligned-base crash parity).
    let covered: u64 = SnapshotRegionFilter::get_element_count(&snapshot_region_filter, unit_size_in_bytes,
        memory_alignment);
    transition { _ -> each(this, dst, base_delta, alignment, covered, unit_size_in_bytes, 0) }
    state each(this: &SnapshotRegion, dst: &mut [u64], base_delta: u64, stride: u64, count: u64, unit: u64, position: u64) -> u64 {
        let window_count: u64 = ElementWindow::get_element_count(&this.current_values);
        transition position < count && position < dst.len {
            true -> probe(this, dst, base_delta, stride, count, unit, position, window_count)
            false -> (position)
        }
    }
    state probe(this: &SnapshotRegion, dst: &mut [u64], base_delta: u64, stride: u64, count: u64, unit: u64, position: u64, window_count: u64) -> u64
        requires unit > 0
    {
        // Candidate `position` sits `position * stride` bytes past the
        // filter base; the window stores unit-strided elements, so the
        // element index divides by the unit. Scalar-leg invariants keep
        // stride == unit and the filter base unit-aligned.
        let element_index: u64 = (((base_delta as u64 in Saturating)
            + ((position as u64 in Saturating) * (stride as u64 in Saturating))) as u64)
            / unit;
        transition element_index < window_count {
            true -> copy(this, dst, base_delta, stride, count, unit, position, element_index)
            false -> (position)
            _ -> (position)
        }
    }
    state copy(this: &SnapshotRegion, dst: &mut [u64], base_delta: u64, stride: u64, count: u64, unit: u64, position: u64, element_index: u64) -> u64 {
        dst[position] = ElementWindow::get_element(&this.current_values, element_index);
        transition { _ -> each(this, dst, base_delta, stride, count, unit, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

pub machine SnapshotRegion::read_previous_elements(
    this: &SnapshotRegion,
    snapshot_region_filter: &SnapshotRegionFilter,
    unit_size_in_bytes: u64,
    memory_alignment: MemoryAlignment,
    dst: &mut [u64]
) -> u64
crashes Abort
    requires unit_size_in_bytes > 0
{
    let alignment: u64 = MemoryAlignment::get_size_in_bytes(&memory_alignment);
    let base_delta: u64 = ((SnapshotRegionFilter::get_base_address(&snapshot_region_filter) as u64 in Saturating)
        - (NormalizedRegion::get_base_address(&this.normalized_region) as u64 in Saturating)) as u64;
    let covered: u64 = SnapshotRegionFilter::get_element_count(&snapshot_region_filter, unit_size_in_bytes,
        memory_alignment);
    transition { _ -> each(this, dst, base_delta, alignment, covered, unit_size_in_bytes, 0) }
    state each(this: &SnapshotRegion, dst: &mut [u64], base_delta: u64, stride: u64, count: u64, unit: u64, position: u64) -> u64 {
        let window_count: u64 = ElementWindow::get_element_count(&this.previous_values);
        transition position < count && position < dst.len {
            true -> probe(this, dst, base_delta, stride, count, unit, position, window_count)
            false -> (position)
        }
    }
    state probe(this: &SnapshotRegion, dst: &mut [u64], base_delta: u64, stride: u64, count: u64, unit: u64, position: u64, window_count: u64) -> u64
        requires unit > 0
    {
        let element_index: u64 = (((base_delta as u64 in Saturating)
            + ((position as u64 in Saturating) * (stride as u64 in Saturating))) as u64)
            / unit;
        transition element_index < window_count {
            true -> copy(this, dst, base_delta, stride, count, unit, position, element_index)
            false -> (position)
            _ -> (position)
        }
    }
    state copy(this: &SnapshotRegion, dst: &mut [u64], base_delta: u64, stride: u64, count: u64, unit: u64, position: u64, element_index: u64) -> u64 {
        dst[position] = ElementWindow::get_element(&this.previous_values, element_index);
        transition { _ -> each(this, dst, base_delta, stride, count, unit, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// The whole prior window — upstream reads `previous_values` directly (the
// field is `pub` upstream); value collectors need it as the baseline a
// failed read leaves in `current_values`.
pub machine SnapshotRegion::clone_previous_values(this: &SnapshotRegion) -> ElementWindow {
    ElementWindow::clone(&this.previous_values)
}

// Upstream `set_current_values`: installs a freshly collected window.
pub machine SnapshotRegion::set_current_values(this: &mut SnapshotRegion, values: &ElementWindow) {
    ElementWindow::clone_from(&mut this.current_values, values);
    this.current_element_count = this.current_values.element_count;
}

// Upstream's collect swap: current becomes previous before the next read.
pub machine SnapshotRegion::rotate_values_for_collection(this: &mut SnapshotRegion) {
    ElementWindow::clone_from(&mut this.previous_values, &this.current_values);
}

pub machine SnapshotRegion::push_page_boundary(this: &mut SnapshotRegion, address: u64) -> bool {
    transition this.page_boundary_count < 64 {
        true -> push(this, address)
        false -> (false)
    }
    state push(this: &mut SnapshotRegion, address: u64) -> bool {
        this.page_boundaries[this.page_boundary_count] = address;
        this.page_boundary_count = this.page_boundary_count + 1;
        true
    }
}

pub machine SnapshotRegion::get_page_boundary_count(this: &SnapshotRegion) -> u64 {
    this.page_boundary_count
}

pub machine SnapshotRegion::get_page_boundary(this: &SnapshotRegion, position: u64) -> u64 {
    transition position < this.page_boundary_count && position < 64 {
        true -> (this.page_boundaries[position])
        false -> (0)
    }
}

// Upstream `get_scan_results` — the whole per-type filter set.
pub machine SnapshotRegion::get_scan_results(this: &SnapshotRegion) -> SnapshotRegionScanResults {
    SnapshotRegionScanResults::clone(&this.scan_results)
}


// The bounded set of data types a scan request carries across packages.
pub data DataTypeRefSet {
    data_type_refs: [DataTypeRef; 4];
    count: u64;
}

pub machine DataTypeRefSet::empty() -> DataTypeRefSet {
    DataTypeRefSet { count: 0 }
}

pub machine DataTypeRefSet::get_count(this: &DataTypeRefSet) -> u64 {
    this.count
}

pub machine DataTypeRefSet::clear(this: &mut DataTypeRefSet) {
    this.count = 0;
}

pub machine DataTypeRefSet::push(this: &mut DataTypeRefSet, data_type_ref: &DataTypeRef) -> bool {
    transition this.count < 4 {
        true -> store(this, data_type_ref)
        false -> (false)
    }
    state store(this: &mut DataTypeRefSet, data_type_ref: &DataTypeRef) -> bool {
        DataTypeRef::clone_from(&mut this.data_type_refs[this.count], data_type_ref);
        this.count = this.count + 1;
        true
    }
}

pub machine DataTypeRefSet::get(this: &DataTypeRefSet, position: u64) -> DataTypeRef {
    transition position < this.count && position < 4 {
        true -> clone_at(this, position)
        false -> (DataTypeRef::default())
    }
    state clone_at(this: &DataTypeRefSet, position: u64) -> DataTypeRef {
        DataTypeRef::clone(&this.data_type_refs[position])
    }
}

// The set copy — upstream hands `&[DataTypeRef]` around and callers clone it
// when an owned span is needed (`self.data_type_refs.clone()`); the bounded
// set clone is the same operation.
pub machine DataTypeRefSet::clone(source: &DataTypeRefSet) -> DataTypeRefSet {
    let mut built: DataTypeRefSet = DataTypeRefSet::empty();
    DataTypeRefSet::clone_from(&mut built, source);
    (built)
}

pub machine DataTypeRefSet::clone_from(this: &mut DataTypeRefSet, source: &DataTypeRefSet) {
    this.count = 0;
    transition { _ -> each(this, source, 0) }
    state each(this: &mut DataTypeRefSet, source: &DataTypeRefSet, position: u64) {
        let hoist1: u64 = DataTypeRefSet::get_count(&source);
        transition position < hoist1 {
            true -> copy(this, source, position)
            false -> done(this)
        }
    }
    state copy(this: &mut DataTypeRefSet, source: &DataTypeRefSet, position: u64) {
        let data_type_ref: DataTypeRef = DataTypeRefSet::get(&source, position);
        let pushed: bool = DataTypeRefSet::push(&mut this, &data_type_ref);
        transition { _ -> each(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state done(this: &mut DataTypeRefSet) {
    }
}

// Upstream `initialize_scan_results`: a region with no collections gets one
// whole-region filter per requested data type; existing collections are kept.
pub machine SnapshotRegion::initialize_scan_results(
    this: &mut SnapshotRegion,
    data_type_refs: &DataTypeRefSet,
    memory_alignment: MemoryAlignment
) {
    let hoist2: u64 = SnapshotRegionScanResults::get_collection_count(&this.scan_results);
    transition hoist2 == 0 {
        true -> seed(this, data_type_refs, memory_alignment)
        false -> done(this)
    }
    state seed(this: &mut SnapshotRegion, data_type_refs: &DataTypeRefSet, memory_alignment: MemoryAlignment) {
        transition { _ -> each(this, data_type_refs, memory_alignment, 0) }
    }
    state each(this: &mut SnapshotRegion, data_type_refs: &DataTypeRefSet, memory_alignment: MemoryAlignment, position: u64) {
        let hoist3: u64 = DataTypeRefSet::get_count(&data_type_refs);
        transition position < hoist3 && position < 4 {
            true -> plant(this, data_type_refs, memory_alignment, position)
            false -> done(this)
        }
    }
    state plant(this: &mut SnapshotRegion, data_type_refs: &DataTypeRefSet, memory_alignment: MemoryAlignment, position: u64) {
        let data_type_ref: DataTypeRef = DataTypeRefSet::get(&data_type_refs, position);
        let seed_filter: SnapshotRegionFilter = SnapshotRegionFilter::new(
            NormalizedRegion::get_base_address(&this.normalized_region),
            NormalizedRegion::get_region_size(&this.normalized_region));
        // The collection's result width is the data type's unit size — the
        // ported scalar leg resolves u64 to 8; an unknown type yields an
        // empty collection upstream of plan selection.
        let unit: u64 = DataTypeRef::get_unit_size_in_bytes(&data_type_ref);
        let collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::from_single_filter(
            &seed_filter, &data_type_ref, memory_alignment, unit);
        let pushed: bool = SnapshotRegionScanResults::push_collection(&mut this.scan_results, &collection);
        transition pushed {
            true -> each(this, data_type_refs, memory_alignment, position + 1)
            false -> done(this)
            _ -> done(this)
        }
    }
    state done(this: &mut SnapshotRegion) {
        this.page_boundary_count = this.page_boundary_count;
    }
}

// Upstream `resize_to_filters`: after results narrow, the region shrinks to
// the union of surviving filters — base moves to the lowest filter start,
// size to their union coverage, and value windows realign to the new base.
// With no surviving filters the region is left empty for discard.
machine SnapshotRegion::resize_to_filters(this: &mut SnapshotRegion) {
    let bounds: FilterBounds = SnapshotRegion::compute_filter_bounds(&this);
    transition bounds.has_filters {
        true -> shrink(this, bounds)
        false -> empty_self(this)
    }
    state shrink(this: &mut SnapshotRegion, bounds: FilterBounds) {
        let base: u64 = NormalizedRegion::get_base_address(&this.normalized_region);
        // Element-space realign: surviving filters start `lead` elements in.
        let lead: u64 = (((bounds.min_address as u64 in Saturating) - (base as u64 in Saturating)) as u64) / 8;
        ElementWindow::truncate_front(&mut this.current_values, lead);
        ElementWindow::truncate_front(&mut this.previous_values, lead);
        NormalizedRegion::set_base_address(&mut this.normalized_region, bounds.min_address);
        NormalizedRegion::set_region_size(&mut this.normalized_region, ((bounds.max_address as u64 in Saturating) - (bounds.min_address as u64 in Saturating)) as u64);
        this.base_address = this.normalized_region.base_address;
        this.region_size = this.normalized_region.region_size;
        transition { _ -> clip(this) }
    }
    // Windows may extend past the surviving union — clamp the element counts
    // to the new size so stale elements are not observable as results.
    state clip(this: &mut SnapshotRegion) {
        let elements: u64 = NormalizedRegion::get_region_size(&this.normalized_region) / 8;
        ElementWindow::truncate_back(&mut this.current_values, elements);
        ElementWindow::truncate_back(&mut this.previous_values, elements);
        this.current_element_count = this.current_values.element_count;
        this.page_boundary_count = this.page_boundary_count;
    }
    state empty_self(this: &mut SnapshotRegion) {
        NormalizedRegion::set_region_size(&mut this.normalized_region, 0);
        this.region_size = 0;
        ElementWindow::clear(&mut this.current_values);
        ElementWindow::clear(&mut this.previous_values);
        this.current_element_count = 0;
    }
}

// Upstream `get_collected_byte_count`: bytes successfully collected for
// `current_values`, i.e. `current_values.len().min(region_size)` minus every
// tombstoned page range. Element-domain analogue: the window's covered
// bytes stand for the collected byte vector's length.
pub machine SnapshotRegion::get_collected_byte_count(this: &SnapshotRegion) -> u64 {
    let hoist4: bool = ElementWindow::is_empty(&this.current_values);
    transition hoist4 {
        true -> (0)
        false -> sized(this)
        _ -> sized(this)
    }

    state sized(this: &SnapshotRegion) -> u64 {
        let window_bytes: u64 = ElementWindow::get_covered_byte_count(&this.current_values, 8);
        let region_byte_size: u64 = NormalizedRegion::get_region_size(&this.normalized_region);
        let value_size: u64 = SnapshotRegion::pick_min_u64(window_bytes, region_byte_size);
        transition this.page_boundary_tombstone_count == 0 {
            true -> (value_size)
            false -> gated(this, value_size)
            _ -> gated(this, value_size)
        }
    }

    state gated(this: &SnapshotRegion, value_size: u64) -> u64 {
        transition this.page_boundary_count == 0 {
            true -> lone(this, value_size)
            false -> walk(this, value_size, 0, NormalizedRegion::get_base_address(&this.normalized_region), 0)
            _ -> walk(this, value_size, 0, NormalizedRegion::get_base_address(&this.normalized_region), 0)
        }
    }

    // Single-read region: the whole span is one range — tombstoned means
    // nothing was collected.
    state lone(this: &SnapshotRegion, value_size: u64) -> u64 {
        let base: u64 = NormalizedRegion::get_base_address(&this.normalized_region);
        let tombstoned: bool = SnapshotRegion::has_page_boundary_tombstone(&this, base);
        transition tombstoned {
            true -> (0)
            false -> (value_size)
            _ -> (value_size)
        }
    }

    // Walk the page-split ranges [base, b0), [b0, b1), ..., summing only
    // non-tombstoned range sizes — upstream's boundary loop.
    state walk(this: &SnapshotRegion, value_size: u64, boundary_index: u64, range_start: u64, collected: u64) -> u64 {
        transition boundary_index < this.page_boundary_count && boundary_index < 64 {
            true -> step(this, value_size, boundary_index, range_start, collected)
            false -> tail(this, value_size, range_start, collected)
            _ -> tail(this, value_size, range_start, collected)
        }
    }

    state step(this: &SnapshotRegion, value_size: u64, boundary_index: u64, range_start: u64, collected: u64) -> u64 {
        let next_boundary: u64 = this.page_boundaries[boundary_index];
        let tombstoned: bool = SnapshotRegion::has_page_boundary_tombstone(&this, range_start);
        transition tombstoned {
            true -> walk(this, value_size, boundary_index + 1, next_boundary, collected)
            false -> keep(this, value_size, boundary_index, next_boundary, collected, range_start)
            _ -> keep(this, value_size, boundary_index, next_boundary, collected, range_start)
        }
    }

    state keep(this: &SnapshotRegion, value_size: u64, boundary_index: u64, next_boundary: u64, collected: u64, range_start: u64) -> u64 {
        let added: u64 = ((next_boundary as u64 in Saturating) - (range_start as u64 in Saturating)) as u64;
        let next_collected: u64 = ((collected as u64 in Saturating) + (added as u64 in Saturating)) as u64;
        transition { _ -> walk(this, value_size, boundary_index + 1, next_boundary, next_collected) }
    }

    state tail(this: &SnapshotRegion, value_size: u64, range_start: u64, collected: u64) -> u64 {
        let end: u64 = NormalizedRegion::get_end_address(&this.normalized_region);
        let tombstoned: bool = SnapshotRegion::has_page_boundary_tombstone(&this, range_start);
        let added: u64 = ((end as u64 in Saturating) - (range_start as u64 in Saturating)) as u64;
        let tail_collected: u64 = ((collected as u64 in Saturating) + (added as u64 in Saturating)) as u64;
        transition tombstoned {
            true -> (SnapshotRegion::pick_min_u64(collected, value_size))
            false -> (SnapshotRegion::pick_min_u64(tail_collected, value_size))
            _ -> (SnapshotRegion::pick_min_u64(tail_collected, value_size))
        }
    }
}

machine SnapshotRegion::pick_min_u64(first: u64, second: u64) -> u64 {
    transition first <= second {
        true -> (first)
        false -> (second)
        _ -> (second)
    }
}

// In-package bounds probe used by resize: the union of all surviving
// filter addresses across collections.
pub data FilterBounds {
    has_filters: bool;
    min_address: u64;
    max_address: u64;
}

// Union of filter min/max across every collection — upstream's
// resize_to_filters reads the same union before culling the region.
machine SnapshotRegion::compute_filter_bounds(this: &SnapshotRegion) -> FilterBounds {
    transition { _ -> seek(this, 0, false, 0, 0) }
    state seek(this: &SnapshotRegion, collection_index: u64, has_filters: bool, min_address: u64, max_address: u64) -> FilterBounds {
        let hoist5: u64 = SnapshotRegionScanResults::get_collection_count(&this.scan_results);
        transition collection_index < hoist5 && collection_index < 4 {
            true -> merge(this, collection_index, has_filters, min_address, max_address)
            false -> (FilterBounds { has_filters: has_filters, min_address: min_address, max_address: max_address })
        }
    }
    state merge(this: &SnapshotRegion, collection_index: u64, has_filters: bool, min_address: u64, max_address: u64) -> FilterBounds {
        let collection: SnapshotRegionFilterCollection =
            SnapshotRegionScanResults::get_filter_collection(&this.scan_results, collection_index);
        let lo: u64 = SnapshotRegionFilterCollection::get_filter_minimum_address(&collection);
        let hi: u64 = SnapshotRegionFilterCollection::get_filter_maximum_address(&collection);
        let has_any: bool = SnapshotRegionFilterCollection::get_filter_count(&collection) > 0;
        let merged_min: u64 = SnapshotRegion::pick_min(has_filters, min_address, lo);
        let merged_max: u64 = SnapshotRegion::pick_max(has_filters, max_address, hi);
        let still_has: bool = has_filters || has_any;
        transition { _ -> seek(this, collection_index + 1, still_has, merged_min, merged_max) }
    }
}

machine SnapshotRegion::pick_min(has_filters: bool, min_address: u64, candidate: u64) -> u64 {
    transition has_filters && min_address <= candidate {
        true -> (min_address)
        false -> (candidate)
        _ -> (candidate)
    }
}

machine SnapshotRegion::pick_max(has_filters: bool, max_address: u64, candidate: u64) -> u64 {
    transition has_filters && max_address >= candidate {
        true -> (max_address)
        false -> (candidate)
        _ -> (candidate)
    }
}

// Upstream `get_current_values_filter_pointer`/`get_previous_values_filter_pointer`
// — the filter-relative element views scanners consume. `start` is the
// filter's first element index within the region window and `count` its
// element count; out-of-window requests yield an empty slice, exactly as
// upstream's clamped pointer arithmetic yields zero readable elements.
pub machine SnapshotRegion::get_current_values_slice(this: &SnapshotRegion, start: u64, count: u64) -> &[u64] {
    let hoist13: &[u64] = ElementWindow::slice(&this.current_values, start, count);
    (hoist13)
}

pub machine SnapshotRegion::get_previous_values_slice(this: &SnapshotRegion, start: u64, count: u64) -> &[u64] {
    let hoist14: &[u64] = ElementWindow::slice(&this.previous_values, start, count);
    (hoist14)
}

// Upstream `scan_results.collections.push(collection)` — the scan installs
// its dispatch output one collection at a time.
pub machine SnapshotRegion::push_scan_result_collection(
    this: &mut SnapshotRegion,
    collection: SnapshotRegionFilterCollection
) -> bool {
    let hoist15: bool = SnapshotRegionScanResults::push_collection(&mut this.scan_results, &collection);
    (hoist15)
}

// Upstream `set_scan_results`: replaces the region's result collections with
// the scan's per-collection output — the post-dispatch install step.
pub machine SnapshotRegion::set_scan_results(this: &mut SnapshotRegion, scan_results: &SnapshotRegionScanResults) {
    SnapshotRegionScanResults::clone_from(&mut this.scan_results, scan_results);
}

// Upstream `remove_scan_results_by_global_indices` on the region: excise
// the tombstone indices through the results store, then re-fit the region
// to the surviving filters (`resize_to_filters` — same ordering as
// upstream's post-remove resize).
pub machine SnapshotRegion::remove_scan_results_by_global_indices(
    this: &mut SnapshotRegion,
    region_global_scan_result_index_base: u64,
    deleted_scan_result_indices: &DeletedScanResultIndexSet
) -> u64
crashes Abort
{
    let removed: u64 = SnapshotRegionScanResults::remove_scan_results_by_global_indices(&mut this.scan_results, region_global_scan_result_index_base, deleted_scan_result_indices);
    transition removed > 0 {
        true -> shrink(this, removed)
        false -> (removed)
    }
    state shrink(this: &mut SnapshotRegion, removed: u64) -> u64 {
        SnapshotRegion::resize_to_filters(&mut this);
        transition { _ -> (removed) }
    }
}
