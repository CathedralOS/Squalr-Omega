module src::structures::snapshots::snapshot_region;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::memory::normalized_region::NormalizedRegion;
use src::structures::results::snapshot_region_scan_results::SnapshotRegionScanResults;
use src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use src::structures::scanning::filters::snapshot_region_filter_collection::SnapshotRegionFilterCollection;
use src::structures::snapshots::deleted_scan_result_index_set::DeletedScanResultIndexSet;
use src::structures::snapshots::element_window::ElementWindow;

// Port of structures/snapshots/snapshot_region.rs: a normalized memory span
// plus its collected values and the per-type filter results scans produce.
//
// Value model: upstream stores raw `current_values`/`previous_values` byte
// vectors; the port stores decoded element windows (ElementWindow — one u64
// per aligned element), the representation the ported scalar scanners
// consume. Byte coverage stays exact: `region_size` is bytes and element i
// covers `[base + i*8, base + i*8 + 8)`.
//
// `page_boundaries` records where adjacent pages merged into this region —
// value collection must not read across them (upstream keeps the boundary
// addresses at merge time for exactly this). Bounded at 64 boundaries.
//
// `page_boundary_tombstones` mirrors upstream's `HashSet<u64>` of failed
// range-start addresses: when a page-split read fails, its start address is
// tombstoned and excluded from `get_collected_byte_count`. Bounded at 64.
//
// No Vec/HashSet in this pin: scan results, windows and tombstones are
// bounded; overflow is a named deviation recorded at the bounded carriers.
//
// Flat mirrors of the nested scalars (`base_address`/`region_size`/
// `current_element_count`): native runtime observation admits exactly one
// field leaf after an array index, so `regions[0].normalized_region.X`
// reads cannot realize natively. Entry-side verification reads these
// mirrors; every writer below keeps them in step with the nested fields.
pub data SnapshotRegion {
    normalized_region: NormalizedRegion;
    base_address: u64;
    region_size: u64;
    current_values: ElementWindow;
    current_element_count: u64;
    previous_values: ElementWindow;
    page_boundaries: [u64; 64];
    page_boundary_count: u64;
    page_boundary_tombstones: [u64; 64];
    page_boundary_tombstone_count: u64;
    scan_results: SnapshotRegionScanResults;
}

pub machine SnapshotRegion::new(base_address: u64, region_size: u64) -> SnapshotRegion {
    SnapshotRegion {
        normalized_region: NormalizedRegion {
            base_address: base_address,
            region_size: region_size,
        },
        base_address: base_address,
        region_size: region_size,
        current_values: ElementWindow::empty(),
        current_element_count: 0,
        previous_values: ElementWindow::empty(),
        page_boundary_count: 0,
        page_boundary_tombstone_count: 0,
        scan_results: SnapshotRegionScanResults::empty(),
    }
}

// The captured-input adapter, element-domain analogue of upstream
// `SnapshotRegion::from_bytes`: caller-supplied current values with the
// region sized to their byte coverage (element stride 8). Supplied
// snapshots are the sanctioned testing adapter — the scan engine itself is
// unmodified.
pub machine SnapshotRegion::from_elements(
    base_address: u64,
    current_values: ElementWindow
) -> SnapshotRegion {
    let mut region: SnapshotRegion = SnapshotRegion::new(base_address, 0);
    region.set_region_size(current_values.get_covered_byte_count(8));
    region.set_current_values(&current_values);
    region
}

// Supplied-snapshot adapter: a region seeded with up to five inline u64
// elements. Upstream tests hand the region a Vec of any length; the owned
// model cannot mutate a local and then borrow it, so the window is built
// inside the call frame and the region returns fully formed.
pub machine SnapshotRegion::of_elements(
    base_address: u64,
    element_count: u64,
    e0: u64,
    e1: u64,
    e2: u64,
    e3: u64,
    e4: u64
) -> SnapshotRegion {
    let window: ElementWindow = ElementWindow::of_elements(
        element_count, e0, e1, e2, e3, e4);
    let mut region: SnapshotRegion = SnapshotRegion::new(base_address, 0);
    region.set_region_size(window.get_covered_byte_count(1));
    region.set_current_values(&window);
    region
}

pub machine SnapshotRegion::clone(source: &SnapshotRegion) -> SnapshotRegion {
    let mut region: SnapshotRegion = SnapshotRegion::new(
        source.normalized_region.get_base_address(),
        source.normalized_region.get_region_size(),
    );
    region.clone_from(source);
    region
}

pub machine SnapshotRegion::clone_from(&mut self, source: &SnapshotRegion) {
    self.normalized_region.clone_from(&source.normalized_region);
    self.base_address = source.base_address;
    self.region_size = source.region_size;
    self.current_values.clone_from(&source.current_values);
    self.current_element_count = source.current_element_count;
    self.previous_values.clone_from(&source.previous_values);
    self.scan_results.clone_from(&source.scan_results);
    self.page_boundary_count = source.page_boundary_count;
    self.page_boundary_tombstone_count = source.page_boundary_tombstone_count;
    self.copy_boundaries(source, 0);
    self.copy_tombstones(source, 0);
}

machine SnapshotRegion::copy_tombstones(&mut self, source: &SnapshotRegion, position: u64) {
    transition position < source.page_boundary_tombstone_count && position < 64 {
        true -> copy(source, position)
        false -> done()
    }
    state copy(&mut self, source: &SnapshotRegion, position: u64) {
        self.page_boundary_tombstones[position] = source.page_boundary_tombstones[position];
        transition { _ -> copy_tombstones(source, position + 1) }
    }
    state done(&mut self) {
        self.page_boundary_tombstone_count = self.page_boundary_tombstone_count;
    }
}

// Upstream `page_boundary_tombstones.clear()` at the head of every
// `read_snapshot_region_values` — stale read failures from a previous
// collection do not carry into the next.
pub machine SnapshotRegion::clear_page_boundary_tombstones(&mut self) {
    self.page_boundary_tombstone_count = 0;
}

// Upstream `page_boundary_tombstones.insert(address)`: mark the read range
// beginning at `address` as failed. Bounded at 64 — overflow drops the
// tombstone (carrier deviation; upstream's set is unbounded).
pub machine SnapshotRegion::push_page_boundary_tombstone(&mut self, address: u64) -> bool {
    transition self.page_boundary_tombstone_count < 64 {
        true -> push(address)
        false -> (false)
    }
    state push(&mut self, address: u64) -> bool {
        self.page_boundary_tombstones[self.page_boundary_tombstone_count] = address;
        self.page_boundary_tombstone_count = self.page_boundary_tombstone_count + 1;
        true
    }
}

// Upstream `page_boundary_tombstones.contains(&address)` — the per-range
// exclusion check `get_collected_byte_count` performs.
pub machine SnapshotRegion::has_page_boundary_tombstone(&self, address: u64) -> bool {
    transition { _ -> seek(0, address) }
    state seek(&self, position: u64, address: u64) -> bool {
        transition position < self.page_boundary_tombstone_count && position < 64 {
            true -> probe(position, address)
            false -> (false)
        }
    }
    state probe(&self, position: u64, address: u64) -> bool {
        transition self.page_boundary_tombstones[position] == address {
            true -> (true)
            false -> seek(position + 1, address)
            _ -> seek(position + 1, address)
        }
    }
}

pub machine SnapshotRegion::get_page_boundary_tombstone_count(&self) -> u64 {
    self.page_boundary_tombstone_count
}

machine SnapshotRegion::copy_boundaries(&mut self, source: &SnapshotRegion, position: u64) {
    transition position < source.page_boundary_count && position < 64 {
        true -> copy(source, position)
        false -> done()
    }
    state copy(&mut self, source: &SnapshotRegion, position: u64) {
        self.page_boundaries[position] = source.page_boundaries[position];
        transition { _ -> copy_boundaries(source, position + 1) }
    }
    state done(&mut self) {
        self.page_boundary_count = self.page_boundary_count;
    }
}

pub machine SnapshotRegion::get_base_address(&self) -> u64 {
    self.normalized_region.get_base_address()
}

pub machine SnapshotRegion::set_base_address(&mut self, base_address: u64) {
    self.normalized_region.set_base_address(base_address);
    self.base_address = base_address;
}

pub machine SnapshotRegion::get_end_address(&self) -> u64 {
    self.normalized_region.get_end_address()
}

pub machine SnapshotRegion::get_region_size(&self) -> u64 {
    self.normalized_region.get_region_size()
}

pub machine SnapshotRegion::set_region_size(&mut self, region_size: u64) {
    self.normalized_region.set_region_size(region_size);
    self.region_size = region_size;
}

// The region's normalized span, for callers building filters over it.
pub machine SnapshotRegion::get_normalized_region(&self) -> NormalizedRegion {
    NormalizedRegion::clone(&self.normalized_region)
}

pub machine SnapshotRegion::has_current_values(&self) -> bool {
    !self.current_values.is_empty()
}

pub machine SnapshotRegion::get_current_element_count(&self) -> u64 {
    self.current_values.get_element_count()
}

// Fixture-side counterpart — entry closures cannot descend below an
// array element into a nested record (`carrier path` wall), so seeds
// reach the element window through a flat setter.
pub machine SnapshotRegion::set_current_element_count(&mut self, element_count: u64) {
    self.current_values.element_count = element_count;
    self.current_element_count = element_count;
}

pub machine SnapshotRegion::get_current_element(&self, position: u64) -> u64 {
    self.current_values.get_element(position)
}

pub machine SnapshotRegion::get_previous_element_count(&self) -> u64 {
    self.previous_values.get_element_count()
}

pub machine SnapshotRegion::get_previous_element(&self, position: u64) -> u64 {
    self.previous_values.get_element(position)
}

// Upstream `has_previous_values`: the prior collection window is populated.
pub machine SnapshotRegion::has_previous_values(&self) -> bool {
    !self.previous_values.is_empty()
}

// `read_current_elements`/`read_previous_elements` are the owned-model
// equivalent of upstream's `get_current_values_filter_pointer`: the scanner
// asks for the elements a filter's range covers. Upstream hands out raw
// byte pointers; this port copies the covered window elements into `dst`
// and returns the count written. Element indexing presumes the window's
// capture stride equals the scan's unit size — the same binding the
// collector's window model carries. The alignment parameter rides the
// signature for the alignment-strided reads the vector legs will need;
// scalar reads are element-indexed.
pub machine SnapshotRegion::read_current_elements(
    &self,
    snapshot_region_filter: &SnapshotRegionFilter,
    unit_size_in_bytes: u64,
    memory_alignment: MemoryAlignment,
    dst: &mut [u64]
) -> u64
crashes Abort
{
    let alignment: u64 = memory_alignment.get_size_in_bytes();
    let base_delta: u64 = ((snapshot_region_filter.get_base_address() as u64 in Saturating)
        - (self.normalized_region.get_base_address() as u64 in Saturating)) as u64;
    // Upstream's candidate count at the filter's scan stride — trailing
    // payload bytes are not candidate starts (`get_element_count` carries
    // the aligned-base crash parity).
    let covered: u64 = snapshot_region_filter.get_element_count(
        unit_size_in_bytes,
        memory_alignment);
    transition { _ -> each(dst, base_delta, alignment, covered, unit_size_in_bytes, 0) }
    state each(&self, dst: &mut [u64], base_delta: u64, stride: u64, count: u64, unit: u64, position: u64) -> u64 {
        let window_count: u64 = self.current_values.get_element_count();
        transition position < count && position < dst.len {
            true -> probe(dst, base_delta, stride, count, unit, position, window_count)
            false -> (position)
        }
    }
    state probe(&self, dst: &mut [u64], base_delta: u64, stride: u64, count: u64, unit: u64, position: u64, window_count: u64) -> u64 {
        // Candidate `position` sits `position * stride` bytes past the
        // filter base; the window stores unit-strided elements, so the
        // element index divides by the unit. Scalar-leg invariants keep
        // stride == unit and the filter base unit-aligned.
        let element_index: u64 = (((base_delta as u64 in Saturating)
            + ((position as u64 in Saturating) * (stride as u64 in Saturating))) as u64)
            / unit;
        transition element_index < window_count {
            true -> copy(dst, base_delta, stride, count, unit, position, element_index)
            false -> (position)
            _ -> (position)
        }
    }
    state copy(&self, dst: &mut [u64], base_delta: u64, stride: u64, count: u64, unit: u64, position: u64, element_index: u64) -> u64 {
        dst[position] = self.current_values.get_element(element_index);
        transition { _ -> each(dst, base_delta, stride, count, unit, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

pub machine SnapshotRegion::read_previous_elements(
    &self,
    snapshot_region_filter: &SnapshotRegionFilter,
    unit_size_in_bytes: u64,
    memory_alignment: MemoryAlignment,
    dst: &mut [u64]
) -> u64
crashes Abort
{
    let alignment: u64 = memory_alignment.get_size_in_bytes();
    let base_delta: u64 = ((snapshot_region_filter.get_base_address() as u64 in Saturating)
        - (self.normalized_region.get_base_address() as u64 in Saturating)) as u64;
    let covered: u64 = snapshot_region_filter.get_element_count(
        unit_size_in_bytes,
        memory_alignment);
    transition { _ -> each(dst, base_delta, alignment, covered, unit_size_in_bytes, 0) }
    state each(&self, dst: &mut [u64], base_delta: u64, stride: u64, count: u64, unit: u64, position: u64) -> u64 {
        let window_count: u64 = self.previous_values.get_element_count();
        transition position < count && position < dst.len {
            true -> probe(dst, base_delta, stride, count, unit, position, window_count)
            false -> (position)
        }
    }
    state probe(&self, dst: &mut [u64], base_delta: u64, stride: u64, count: u64, unit: u64, position: u64, window_count: u64) -> u64 {
        let element_index: u64 = (((base_delta as u64 in Saturating)
            + ((position as u64 in Saturating) * (stride as u64 in Saturating))) as u64)
            / unit;
        transition element_index < window_count {
            true -> copy(dst, base_delta, stride, count, unit, position, element_index)
            false -> (position)
            _ -> (position)
        }
    }
    state copy(&self, dst: &mut [u64], base_delta: u64, stride: u64, count: u64, unit: u64, position: u64, element_index: u64) -> u64 {
        dst[position] = self.previous_values.get_element(element_index);
        transition { _ -> each(dst, base_delta, stride, count, unit, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// The whole prior window — upstream reads `previous_values` directly (the
// field is `pub` upstream); value collectors need it as the baseline a
// failed read leaves in `current_values`.
pub machine SnapshotRegion::clone_previous_values(&self) -> ElementWindow {
    ElementWindow::clone(&self.previous_values)
}

// Upstream `set_current_values`: installs a freshly collected window.
pub machine SnapshotRegion::set_current_values(&mut self, values: &ElementWindow) {
    self.current_values.clone_from(values);
    self.current_element_count = self.current_values.element_count;
}

// Upstream's collect swap: current becomes previous before the next read.
pub machine SnapshotRegion::rotate_values_for_collection(&mut self) {
    self.previous_values.clone_from(&self.current_values);
}

pub machine SnapshotRegion::push_page_boundary(&mut self, address: u64) -> bool {
    transition self.page_boundary_count < 64 {
        true -> push(address)
        false -> (false)
    }
    state push(&mut self, address: u64) -> bool {
        self.page_boundaries[self.page_boundary_count] = address;
        self.page_boundary_count = self.page_boundary_count + 1;
        true
    }
}

pub machine SnapshotRegion::get_page_boundary_count(&self) -> u64 {
    self.page_boundary_count
}

pub machine SnapshotRegion::get_page_boundary(&self, position: u64) -> u64 {
    transition position < self.page_boundary_count && position < 64 {
        true -> (self.page_boundaries[position])
        false -> (0)
    }
}

// Upstream `get_scan_results` — the whole per-type filter set.
pub machine SnapshotRegion::get_scan_results(&self) -> SnapshotRegionScanResults {
    SnapshotRegionScanResults::clone(&self.scan_results)
}


// The bounded set of data types a scan request carries across packages.
pub data DataTypeRefSet {
    data_type_refs: [DataTypeRef; 4];
    count: u64;
}

pub machine DataTypeRefSet::empty() -> DataTypeRefSet {
    DataTypeRefSet { count: 0 }
}

pub machine DataTypeRefSet::get_count(&self) -> u64 {
    self.count
}

pub machine DataTypeRefSet::clear(&mut self) {
    self.count = 0;
}

pub machine DataTypeRefSet::push(&mut self, data_type_ref: &DataTypeRef) -> bool {
    transition self.count < 4 {
        true -> store(data_type_ref)
        false -> (false)
    }
    state store(&mut self, data_type_ref: &DataTypeRef) -> bool {
        self.data_type_refs[self.count].clone_from(data_type_ref);
        self.count = self.count + 1;
        true
    }
}

pub machine DataTypeRefSet::get(&self, position: u64) -> DataTypeRef {
    transition position < self.count && position < 4 {
        true -> clone_at(position)
        false -> (DataTypeRef::default())
    }
    state clone_at(&self, position: u64) -> DataTypeRef {
        DataTypeRef::clone(&self.data_type_refs[position])
    }
}

// The set copy — upstream hands `&[DataTypeRef]` around and callers clone it
// when an owned span is needed (`self.data_type_refs.clone()`); the bounded
// set clone is the same operation.
pub machine DataTypeRefSet::clone(source: &DataTypeRefSet) -> DataTypeRefSet {
    let mut built: DataTypeRefSet = DataTypeRefSet::empty();
    built.clone_from(source);
    (built)
}

pub machine DataTypeRefSet::clone_from(&mut self, source: &DataTypeRefSet) {
    self.count = 0;
    transition { _ -> each(source, 0) }
    state each(&mut self, source: &DataTypeRefSet, position: u64) {
        transition position < source.get_count() {
            true -> copy(source, position)
            false -> done()
        }
    }
    state copy(&mut self, source: &DataTypeRefSet, position: u64) {
        let data_type_ref: DataTypeRef = source.get(position);
        let pushed: bool = self.push(&data_type_ref);
        transition { _ -> each(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state done(&mut self) {
    }
}

// Upstream `initialize_scan_results`: a region with no collections gets one
// whole-region filter per requested data type; existing collections are kept.
pub machine SnapshotRegion::initialize_scan_results(
    &mut self,
    data_type_refs: &DataTypeRefSet,
    memory_alignment: MemoryAlignment
) {
    transition self.scan_results.get_collection_count() == 0 {
        true -> seed(data_type_refs, memory_alignment)
        false -> done()
    }
    state seed(&mut self, data_type_refs: &DataTypeRefSet, memory_alignment: MemoryAlignment) {
        transition { _ -> each(data_type_refs, memory_alignment, 0) }
    }
    state each(&mut self, data_type_refs: &DataTypeRefSet, memory_alignment: MemoryAlignment, position: u64) {
        transition position < data_type_refs.get_count() && position < 4 {
            true -> plant(data_type_refs, memory_alignment, position)
            false -> done()
        }
    }
    state plant(&mut self, data_type_refs: &DataTypeRefSet, memory_alignment: MemoryAlignment, position: u64) {
        let data_type_ref: DataTypeRef = data_type_refs.get(position);
        let seed_filter: SnapshotRegionFilter = SnapshotRegionFilter::new(
            self.normalized_region.get_base_address(),
            self.normalized_region.get_region_size());
        // The collection's result width is the data type's unit size — the
        // ported scalar leg resolves u64 to 8; an unknown type yields an
        // empty collection upstream of plan selection.
        let unit: u64 = data_type_ref.get_unit_size_in_bytes();
        let collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::from_single_filter(
            &seed_filter, &data_type_ref, memory_alignment, unit);
        let pushed: bool = self.scan_results.push_collection(&collection);
        transition pushed {
            true -> each(data_type_refs, memory_alignment, position + 1)
            false -> done()
            _ -> done()
        }
    }
    state done(&mut self) {
        self.page_boundary_count = self.page_boundary_count;
    }
}

// Upstream `resize_to_filters`: after results narrow, the region shrinks to
// the union of surviving filters — base moves to the lowest filter start,
// size to their union coverage, and value windows realign to the new base.
// With no surviving filters the region is left empty for discard.
machine SnapshotRegion::resize_to_filters(&mut self) {
    let bounds: FilterBounds = self.compute_filter_bounds();
    transition bounds.has_filters {
        true -> shrink(bounds)
        false -> empty_self()
    }
    state shrink(&mut self, bounds: FilterBounds) {
        let base: u64 = self.normalized_region.get_base_address();
        // Element-space realign: surviving filters start `lead` elements in.
        let lead: u64 = (((bounds.min_address as u64 in Saturating) - (base as u64 in Saturating)) as u64) / 8;
        self.current_values.truncate_front(lead);
        self.previous_values.truncate_front(lead);
        self.normalized_region.set_base_address(bounds.min_address);
        self.normalized_region.set_region_size(((bounds.max_address as u64 in Saturating) - (bounds.min_address as u64 in Saturating)) as u64);
        self.base_address = self.normalized_region.base_address;
        self.region_size = self.normalized_region.region_size;
        transition { _ -> clip() }
    }
    // Windows may extend past the surviving union — clamp the element counts
    // to the new size so stale elements are not observable as results.
    state clip(&mut self) {
        let elements: u64 = self.normalized_region.get_region_size() / 8;
        self.current_values.truncate_back(elements);
        self.previous_values.truncate_back(elements);
        self.current_element_count = self.current_values.element_count;
        self.page_boundary_count = self.page_boundary_count;
    }
    state empty_self(&mut self) {
        self.normalized_region.set_region_size(0);
        self.region_size = 0;
        self.current_values.clear();
        self.previous_values.clear();
        self.current_element_count = 0;
    }
}

// Upstream `get_collected_byte_count`: bytes successfully collected for
// `current_values`, i.e. `current_values.len().min(region_size)` minus every
// tombstoned page range. Element-domain analogue: the window's covered
// bytes stand for the collected byte vector's length.
pub machine SnapshotRegion::get_collected_byte_count(&self) -> u64 {
    transition self.current_values.is_empty() {
        true -> (0)
        false -> sized()
        _ -> sized()
    }

    state sized(&self) -> u64 {
        let window_bytes: u64 = self.current_values.get_covered_byte_count(8);
        let region_byte_size: u64 = self.normalized_region.get_region_size();
        let value_size: u64 = SnapshotRegion::pick_min_u64(window_bytes, region_byte_size);
        transition self.page_boundary_tombstone_count == 0 {
            true -> (value_size)
            false -> gated(value_size)
            _ -> gated(value_size)
        }
    }

    state gated(&self, value_size: u64) -> u64 {
        transition self.page_boundary_count == 0 {
            true -> lone(value_size)
            false -> walk(value_size, 0, self.normalized_region.get_base_address(), 0)
            _ -> walk(value_size, 0, self.normalized_region.get_base_address(), 0)
        }
    }

    // Single-read region: the whole span is one range — tombstoned means
    // nothing was collected.
    state lone(&self, value_size: u64) -> u64 {
        let base: u64 = self.normalized_region.get_base_address();
        let tombstoned: bool = self.has_page_boundary_tombstone(base);
        transition tombstoned {
            true -> (0)
            false -> (value_size)
            _ -> (value_size)
        }
    }

    // Walk the page-split ranges [base, b0), [b0, b1), ..., summing only
    // non-tombstoned range sizes — upstream's boundary loop.
    state walk(&self, value_size: u64, boundary_index: u64, range_start: u64, collected: u64) -> u64 {
        transition boundary_index < self.page_boundary_count && boundary_index < 64 {
            true -> step(value_size, boundary_index, range_start, collected)
            false -> tail(value_size, range_start, collected)
            _ -> tail(value_size, range_start, collected)
        }
    }

    state step(&self, value_size: u64, boundary_index: u64, range_start: u64, collected: u64) -> u64 {
        let next_boundary: u64 = self.page_boundaries[boundary_index];
        let tombstoned: bool = self.has_page_boundary_tombstone(range_start);
        transition tombstoned {
            true -> walk(value_size, boundary_index + 1, next_boundary, collected)
            false -> keep(value_size, boundary_index, next_boundary, collected, range_start)
            _ -> keep(value_size, boundary_index, next_boundary, collected, range_start)
        }
    }

    state keep(&self, value_size: u64, boundary_index: u64, next_boundary: u64, collected: u64, range_start: u64) -> u64 {
        let added: u64 = ((next_boundary as u64 in Saturating) - (range_start as u64 in Saturating)) as u64;
        let next_collected: u64 = ((collected as u64 in Saturating) + (added as u64 in Saturating)) as u64;
        transition { _ -> walk(value_size, boundary_index + 1, next_boundary, next_collected) }
    }

    state tail(&self, value_size: u64, range_start: u64, collected: u64) -> u64 {
        let end: u64 = self.normalized_region.get_end_address();
        let tombstoned: bool = self.has_page_boundary_tombstone(range_start);
        let added: u64 = ((end as u64 in Saturating) - (range_start as u64 in Saturating)) as u64;
        let tail_collected: u64 = ((collected as u64 in Saturating) + (added as u64 in Saturating)) as u64;
        transition tombstoned {
            true -> (SnapshotRegion::pick_min_u64(collected, value_size))
            false -> (SnapshotRegion::pick_min_u64(tail_collected, value_size))
            _ -> (SnapshotRegion::pick_min_u64(tail_collected, value_size))
        }
    }
}

machine SnapshotRegion::pick_min_u64(first: u64, second: u64) -> u64 {
    transition first <= second {
        true -> (first)
        false -> (second)
        _ -> (second)
    }
}

// In-package bounds probe used by resize: the union of all surviving
// filter addresses across collections.
pub data FilterBounds {
    has_filters: bool;
    min_address: u64;
    max_address: u64;
}

// Union of filter min/max across every collection — upstream's
// resize_to_filters reads the same union before culling the region.
machine SnapshotRegion::compute_filter_bounds(&self) -> FilterBounds {
    transition { _ -> seek(0, false, 0, 0) }
    state seek(&self, collection_index: u64, has_filters: bool, min_address: u64, max_address: u64) -> FilterBounds {
        transition collection_index < self.scan_results.get_collection_count() && collection_index < 4 {
            true -> merge(collection_index, has_filters, min_address, max_address)
            false -> (FilterBounds { has_filters: has_filters, min_address: min_address, max_address: max_address })
        }
    }
    state merge(&self, collection_index: u64, has_filters: bool, min_address: u64, max_address: u64) -> FilterBounds {
        let collection: SnapshotRegionFilterCollection =
            self.scan_results.get_filter_collection(collection_index);
        let lo: u64 = collection.get_filter_minimum_address();
        let hi: u64 = collection.get_filter_maximum_address();
        let has_any: bool = collection.get_filter_count() > 0;
        let merged_min: u64 = SnapshotRegion::pick_min(has_filters, min_address, lo);
        let merged_max: u64 = SnapshotRegion::pick_max(has_filters, max_address, hi);
        let still_has: bool = has_filters || has_any;
        transition { _ -> seek(collection_index + 1, still_has, merged_min, merged_max) }
    }
}

machine SnapshotRegion::pick_min(has_filters: bool, min_address: u64, candidate: u64) -> u64 {
    transition has_filters && min_address <= candidate {
        true -> (min_address)
        false -> (candidate)
        _ -> (candidate)
    }
}

machine SnapshotRegion::pick_max(has_filters: bool, max_address: u64, candidate: u64) -> u64 {
    transition has_filters && max_address >= candidate {
        true -> (max_address)
        false -> (candidate)
        _ -> (candidate)
    }
}

// Upstream `get_current_values_filter_pointer`/`get_previous_values_filter_pointer`
// — the filter-relative element views scanners consume. `start` is the
// filter's first element index within the region window and `count` its
// element count; out-of-window requests yield an empty slice, exactly as
// upstream's clamped pointer arithmetic yields zero readable elements.
pub machine SnapshotRegion::get_current_values_slice(&self, start: u64, count: u64) -> &[u64] {
    self.current_values.slice(start, count)
}

pub machine SnapshotRegion::get_previous_values_slice(&self, start: u64, count: u64) -> &[u64] {
    self.previous_values.slice(start, count)
}

// Upstream `scan_results.collections.push(collection)` — the scan installs
// its dispatch output one collection at a time.
pub machine SnapshotRegion::push_scan_result_collection(
    &mut self,
    collection: SnapshotRegionFilterCollection
) -> bool {
    self.scan_results.push_collection(&collection)
}

// Upstream `set_scan_results`: replaces the region's result collections with
// the scan's per-collection output — the post-dispatch install step.
pub machine SnapshotRegion::set_scan_results(&mut self, scan_results: &SnapshotRegionScanResults) {
    self.scan_results.clone_from(scan_results);
}

// Upstream `remove_scan_results_by_global_indices` on the region: excise
// the tombstone indices through the results store, then re-fit the region
// to the surviving filters (`resize_to_filters` — same ordering as
// upstream's post-remove resize).
pub machine SnapshotRegion::remove_scan_results_by_global_indices(
    &mut self,
    region_global_scan_result_index_base: u64,
    deleted_scan_result_indices: &DeletedScanResultIndexSet
) -> u64
crashes Abort
{
    let removed: u64 = self.scan_results.remove_scan_results_by_global_indices(
        region_global_scan_result_index_base, deleted_scan_result_indices);
    transition removed > 0 {
        true -> shrink(removed)
        false -> (removed)
    }
    state shrink(&mut self, removed: u64) -> u64 {
        self.resize_to_filters();
        transition { _ -> (removed) }
    }
}
