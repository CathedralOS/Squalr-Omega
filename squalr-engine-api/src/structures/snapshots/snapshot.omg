    transition hoist1 {
        true -> arm_result_471_0(global_scan_result_index)
        false -> seek(this, 0, global_scan_result_index, global_scan_result_index)
    }
    machine seek(this: &Snapshot, position: u64, global_index: u64, local_index: u64) -> |snapshot_region_scan_results|::StructuralResult {
        transition position < this.region_count && position < 1 {
            true -> within(this, position, global_index, local_index)
            false -> (|snapshot_region_scan_results|::StructuralResult::Missing)
        }
    }
    machine within(this: &Snapshot, position: u64, global_index: u64, local_index: u64) -> |snapshot_region_scan_results|::StructuralResult
        requires 0 <= position && position < 1
    {
        let results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&this.regions[position]);
        let region_results: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_number_of_results(&results);
        transition local_index < region_results {
            true -> found(this, position, global_index, local_index)
            false -> seek(this, position + 1, global_index,
                ((local_index as u64 in Saturating) - (region_results as u64 in Saturating)) as u64)
        }
    }
    machine found(this: &Snapshot, position: u64, global_index: u64, local_index: u64) -> |snapshot_region_scan_results|::StructuralResult
        requires 0 <= position && position < 1
    {
        let region: |snapshot_region|::SnapshotRegion = |snapshot_region|::SnapshotRegion::clone(&this.regions[position]);
        let results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&region);
        let hoist10: |snapshot_region_scan_results|::StructuralResult = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_structural_scan_result(&results, &region, global_index, local_index);
        (hoist10)
    }
    machine arm_result_471_0(global_scan_result_index: u64) -> |snapshot_region_scan_results|::StructuralResult
    {
        (|snapshot_region_scan_results|::StructuralResult::Missing)
    }
}

// Upstream `delete_scan_results`: mark the provided global indices as
// tombstones; indices outside the structural result space are skipped and
// already-deleted indices do not recount.
public machine Snapshot::delete_scan_results(
    this: &mut Snapshot,
    deleted_scan_result_indices: &|deleted_scan_result_index_set|::DeletedScanResultIndexSet
) -> u64
crashes Abort
{
    let structural_total: u64 = Snapshot::get_structural_number_of_results(&this);
    transition { _ -> each(this, deleted_scan_result_indices, structural_total, 0, 0) }
    machine each(this: &mut Snapshot, indices: &|deleted_scan_result_index_set|::DeletedScanResultIndexSet, structural_total: u64, position: u64, deleted: u64) -> u64 {
        transition position < indices.count && position < 64 {
            true -> inspect(this, indices, structural_total, position, deleted)
            false -> (deleted)
        }
    }
    machine inspect(this: &mut Snapshot, indices: &|deleted_scan_result_index_set|::DeletedScanResultIndexSet, structural_total: u64, position: u64, deleted: u64) -> u64
        requires 0 <= position && position < 64
    {
        let member: u64 = indices.indices[position];
        transition member < structural_total {
            true -> mark(this, indices, structural_total, position, deleted, member)
            false -> each(this, indices, structural_total, position + 1, deleted)
        }
    }
    machine mark(this: &mut Snapshot, indices: &|deleted_scan_result_index_set|::DeletedScanResultIndexSet, structural_total: u64, position: u64, deleted: u64, member: u64) -> u64
        requires 0 <= position && position < 64
    {
        let fresh: bool = |deleted_scan_result_index_set|::DeletedScanResultIndexSet::insert(&mut this.deleted_indices, member);
        transition fresh {
            true -> each(this, indices, structural_total, position + 1,
                ((deleted as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
            false -> each(this, indices, structural_total, position + 1, deleted)
        }
    }
}

// Upstream's per-row delete loop callsite — a single-index tombstone.
