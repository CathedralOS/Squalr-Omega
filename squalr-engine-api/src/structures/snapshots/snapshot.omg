// Port of structures/snapshots/snapshot.rs: the ordered set of regions a
// scan operates over, plus the tombstone set of manually deleted global
// scan-result indices. Upstream holds `Vec<SnapshotRegion>` plus a
// `BTreeSet<u64>`; the port bounds regions at 1 — the supplied-snapshot
// leg needs one and the native backend caps structural types at 64KiB
// (one region is already ~23KiB) — named deviation, see
// tools/native_probe_resume.md. The tombstone set is the bounded
// `DeletedScanResultIndexSet` (64 entries — the CLI delete surface's row
// selection bound; same named deviation family as PageElementList).
pub data Snapshot {
    regions: [SnapshotRegion; 1];
    region_count: u64;
    deleted_indices: DeletedScanResultIndexSet;
}

pub machine Snapshot::new() -> Snapshot {
    Snapshot {
        region_count: 0,
        deleted_indices: DeletedScanResultIndexSet::empty(),
    }
}

pub machine Snapshot::get_region_count(snapshot: &Snapshot) -> u64 {
    snapshot.region_count
}

// Flat fixture assertions — deep member receivers (more than three
// path segments) mint no unit plan in entry closures, so the supplied-
// snapshot seed leg reads region state through plain machines here.
pub machine Snapshot::get_region_base_address(snapshot: &Snapshot) -> u64 {
    SnapshotRegion::get_base_address(&snapshot.regions[0])
}

pub machine Snapshot::get_region_size(snapshot: &Snapshot) -> u64 {
    SnapshotRegion::get_region_size(&snapshot.regions[0])
}

pub machine Snapshot::get_region_element_count(snapshot: &Snapshot) -> u64 {
    SnapshotRegion::get_current_element_count(&snapshot.regions[0])
}

pub machine Snapshot::region_has_current_values(snapshot: &Snapshot) -> bool {
    SnapshotRegion::has_current_values(&snapshot.regions[0])
}

// Tombstone seed for the supplied-snapshot fixture — writes the layout
// `delete_scan_results`'s row loop leaves for a deleted index.
pub machine Snapshot::seed_deleted_scan_result_index(snapshot: &mut Snapshot, index: u64) {
    snapshot.deleted_indices.indices[0] = index;
    snapshot.deleted_indices.count = 1;
}

// Flat single-member read — `get(position)` mints a transition, which
// no callee in an entry closure can plan, so the seed leg reads the
// seeded tombstone member through this plain accessor.
pub machine Snapshot::get_first_deleted_scan_result_index(snapshot: &Snapshot) -> u64 {
    snapshot.deleted_indices.indices[0]
}

pub machine Snapshot::get_region(snapshot: &Snapshot, region_index: u64) -> SnapshotRegion {
    transition region_index < snapshot.region_count && region_index < 1 {
        true -> clone_at(snapshot, region_index)
        false -> (SnapshotRegion::new(0, 0))
    }
    state clone_at(snapshot: &Snapshot, region_index: u64) -> SnapshotRegion {
        SnapshotRegion::clone(&snapshot.regions[region_index])
    }
}

// Upstream `set_region`: replace the stored region — value collection and
// scan writes funnel through it.
pub machine Snapshot::set_region(snapshot: &mut Snapshot, region_index: u64, region: SnapshotRegion) {
    transition region_index < snapshot.region_count && region_index < 1 {
        true -> store(snapshot, region_index, region)
        false -> done(snapshot)
    }
    state store(snapshot: &mut Snapshot, region_index: u64, region: SnapshotRegion) {
        SnapshotRegion::clone_from(&mut snapshot.regions[region_index], &region);
        snapshot.region_count = snapshot.region_count;
    }
    state done(snapshot: &mut Snapshot) {
        snapshot.region_count = snapshot.region_count;
    }
}

// Upstream `set_snapshot_regions`: replaces the full region set (the scan-new
// path replaces the snapshot outright).
pub machine Snapshot::set_snapshot_regions(snapshot: &mut Snapshot, regions: &[SnapshotRegion; 1], region_count: u64) {
    snapshot.region_count = 0;
    Snapshot::store_regions(snapshot, regions, region_count, 0);
}

machine Snapshot::store_regions(snapshot: &mut Snapshot, regions: &[SnapshotRegion; 1], region_count: u64, position: u64) {
    transition position < region_count && position < 1 {
        true -> store(snapshot, regions, region_count, position)
        false -> done(snapshot, region_count)
    }
    state store(snapshot: &mut Snapshot, regions: &[SnapshotRegion; 1], region_count: u64, position: u64) {
        let source: SnapshotRegion = SnapshotRegion::clone(&regions[position]);
        SnapshotRegion::clone_from(&mut snapshot.regions[position], &source);
        snapshot.region_count = position + 1;
        transition { _ -> Snapshot::store_regions(snapshot, regions, region_count, position + 1) }
    }
    state done(snapshot: &mut Snapshot, region_count: u64) {
        snapshot.region_count = snapshot.region_count;
    }
}

// Upstream `push` — `snapshot.regions.push(region)` at build/merge sites.
pub machine Snapshot::push_region(snapshot: &mut Snapshot, region: SnapshotRegion) -> bool {
    transition snapshot.region_count < 1 {
        true -> push(snapshot, region)
        false -> (false)
    }
    state push(snapshot: &mut Snapshot, region: SnapshotRegion) -> bool {
        SnapshotRegion::clone_from(&mut snapshot.regions[snapshot.region_count], &region);
        snapshot.region_count = snapshot.region_count + 1;
        true
    }
}

// Upstream `clear`: `scan reset` empties the snapshot.
pub machine Snapshot::clear(snapshot: &mut Snapshot) {
    snapshot.region_count = 0;
}

// Upstream `discard_empty_regions`: regions whose size reached zero (post
// resize) are dropped, keeping address order.
pub machine Snapshot::discard_empty_regions(snapshot: &mut Snapshot) {
    let mut kept: Snapshot = Snapshot::new();
    transition { _ -> each(snapshot, kept, 0) }
    state each(snapshot: &mut Snapshot, kept: Snapshot, position: u64) {
        transition position < snapshot.region_count && position < 1 {
            true -> inspect(snapshot, kept, position)
            false -> install(snapshot, kept)
        }
    }
    state inspect(snapshot: &mut Snapshot, kept: Snapshot, position: u64)
        requires 0 <= position && position < 1
    {
        let is_nonempty: bool = SnapshotRegion::get_region_size(&snapshot.regions[position]) > 0;
        transition is_nonempty {
            true -> keep(snapshot, kept, position)
            false -> each(snapshot, kept, position + 1)
        }
    }
    state keep(snapshot: &mut Snapshot, kept: Snapshot, position: u64)
        requires 0 <= position && position < 1
    {
        let region: SnapshotRegion = SnapshotRegion::clone(&snapshot.regions[position]);
        let mut carried: Snapshot = kept;
        let pushed: bool = Snapshot::push_region(&mut carried, region);
        transition pushed {
            true -> each(snapshot, carried, position + 1)
            false -> install(snapshot, carried)
            _ -> install(snapshot, carried)
        }
    }
    state install(snapshot: &mut Snapshot, kept: Snapshot) {
        Snapshot::clone_from(snapshot, &kept);
    }
}

// ————— Cross-package scan step entries —————
// `initialize_scan_results`, `set_scan_results`, `resize_to_filters`,
// `rotate_values_for_collection` and `set_current_values` are `&mut`-receiver
// machines with borrowed arguments, which do not compose across package
// boundaries. These snapshot-level batch machines perform the same steps
// inside this package so squalr-engine can drive them per region.

// boundaries. These snapshot-level batch machines perform the same steps
// inside this package so squalr-engine can drive them per region.

// Upstream `snapshot_region.initialize_scan_results` for one region — seeds
// a whole-region filter collection per requested data type where the region
// has none yet (existing collections are kept — the successive-scan input).
pub machine Snapshot::initialize_region_scan_results(
    snapshot: &mut Snapshot,
    region_index: u64,
    data_type_refs: DataTypeRefSet,
    memory_alignment: MemoryAlignment
) {
    transition region_index < snapshot.region_count && region_index < 1 {
        true -> plant(snapshot, region_index, data_type_refs, memory_alignment)
        false -> done(snapshot)
    }
    state plant(snapshot: &mut Snapshot, region_index: u64, data_type_refs: DataTypeRefSet, memory_alignment: MemoryAlignment)
        requires 0 <= region_index && region_index < 1
    {
        SnapshotRegion::initialize_scan_results(&mut snapshot.regions[region_index], &data_type_refs, memory_alignment);
    }
    state done(snapshot: &mut Snapshot) {
        snapshot.region_count = snapshot.region_count;
    }
}

// Upstream `set_scan_results` staged for the scan's install step: the fresh
// result set starts empty, the scan pushes each dispatched collection
// through `push_region_scan_result_collection`, then
// `resize_region_to_filters` collapses value coverage to the survivors.
pub machine Snapshot::reset_region_scan_results(snapshot: &mut Snapshot, region_index: u64) {
    transition region_index < snapshot.region_count && region_index < 1 {
        true -> store(snapshot, region_index)
        false -> done(snapshot)
    }
    state store(snapshot: &mut Snapshot, region_index: u64)
        requires 0 <= region_index && region_index < 1
    {
        let empty_results: SnapshotRegionScanResults = SnapshotRegionScanResults::empty();
        SnapshotRegion::set_scan_results(&mut snapshot.regions[region_index], &empty_results);
    }
    state done(snapshot: &mut Snapshot) {
        snapshot.region_count = snapshot.region_count;
    }
}

pub machine Snapshot::push_region_scan_result_collection(
    snapshot: &mut Snapshot,
    region_index: u64,
    collection: SnapshotRegionFilterCollection
) -> bool {
    transition region_index < snapshot.region_count && region_index < 1 {
        true -> push(snapshot, region_index, collection)
        false -> (false)
    }
    state push(snapshot: &mut Snapshot, region_index: u64, collection: SnapshotRegionFilterCollection) -> bool
        requires 0 <= region_index && region_index < 1
    {
        SnapshotRegion::push_scan_result_collection(&mut snapshot.regions[region_index], collection)
    }
}

// Upstream `resize_to_filters` — shrink the region's value coverage to the
// union of surviving filters after the install completes.
pub machine Snapshot::resize_region_to_filters(snapshot: &mut Snapshot, region_index: u64) {
    transition region_index < snapshot.region_count && region_index < 1 {
        true -> resize(snapshot, region_index)
        false -> done(snapshot)
    }
    state resize(snapshot: &mut Snapshot, region_index: u64)
        requires 0 <= region_index && region_index < 1
    {
        SnapshotRegion::resize_to_filters(&mut snapshot.regions[region_index]);
    }
    state done(snapshot: &mut Snapshot) {
        snapshot.region_count = snapshot.region_count;
    }
}


// Upstream `snapshot_region.initialize_scan_results` over every region —
// seeds a whole-region filter collection per requested data type where a
// Upstream `snapshot_region.initialize_scan_results` over every region —
// seeds a whole-region filter collection per requested data type where a
// region has none yet.
pub machine Snapshot::initialize_all_scan_results(
    snapshot: &mut Snapshot,
    data_type_refs: DataTypeRefSet,
    memory_alignment: MemoryAlignment
) {
    transition { _ -> each(snapshot, data_type_refs, memory_alignment, 0) }
    state each(snapshot: &mut Snapshot, data_type_refs: DataTypeRefSet, memory_alignment: MemoryAlignment, position: u64) {
        transition position < snapshot.region_count && position < 1 {
            true -> plant(snapshot, data_type_refs, memory_alignment, position)
            false -> done(snapshot)
        }
    }
    state plant(snapshot: &mut Snapshot, data_type_refs: DataTypeRefSet, memory_alignment: MemoryAlignment, position: u64)
        requires 0 <= position && position < 1
    {
        SnapshotRegion::initialize_scan_results(&mut snapshot.regions[position], &data_type_refs, memory_alignment);
        transition { _ -> each(snapshot, data_type_refs, memory_alignment, position + 1) }
    }
    state done(snapshot: &mut Snapshot) {
        snapshot.region_count = snapshot.region_count;
    }
}

// Upstream `snapshot_region.set_scan_results` + `resize_to_filters` for one
// region — installs the dispatch-produced collections and shrinks the
// region's value coverage to the surviving filters.
pub machine Snapshot::apply_region_scan_results(
    snapshot: &mut Snapshot,
    region_index: u64,
    scan_results: SnapshotRegionScanResults
) {
    transition region_index < snapshot.region_count && region_index < 1 {
        true -> store(snapshot, region_index, scan_results)
        false -> done(snapshot)
    }
    state store(snapshot: &mut Snapshot, region_index: u64, scan_results: SnapshotRegionScanResults)
        requires 0 <= region_index && region_index < 1
    {
        SnapshotRegion::set_scan_results(&mut snapshot.regions[region_index], &scan_results);
        SnapshotRegion::resize_to_filters(&mut snapshot.regions[region_index]);
    }
    state done(snapshot: &mut Snapshot) {
        snapshot.region_count = snapshot.region_count;
    }
}

// Upstream `SnapshotValueCollector`'s per-region write: rotate the current
// values into previous, then install the freshly collected elements.
pub machine Snapshot::collect_region_values(
    snapshot: &mut Snapshot,
    region_index: u64,
    elements: ElementWindow
) {
    transition region_index < snapshot.region_count && region_index < 1 {
        true -> store(snapshot, region_index, elements)
        false -> done(snapshot)
    }
    state store(snapshot: &mut Snapshot, region_index: u64, elements: ElementWindow)
        requires 0 <= region_index && region_index < 1
    {
        SnapshotRegion::rotate_values_for_collection(&mut snapshot.regions[region_index]);
        SnapshotRegion::set_current_values(&mut snapshot.regions[region_index], &elements);
    }
    state done(snapshot: &mut Snapshot) {
        snapshot.region_count = snapshot.region_count;
    }
}

// Upstream `snapshot_region.page_boundary_tombstones.clear()` — the
// collector resets each region's failed-range marks before reading; the
// per-region write rides the same api-side entry as `collect_region_values`.
pub machine Snapshot::clear_region_tombstones(
    snapshot: &mut Snapshot,
    region_index: u64
) {
    transition region_index < snapshot.region_count && region_index < 1 {
        true -> store(snapshot, region_index)
        false -> done(snapshot)
    }
    state store(snapshot: &mut Snapshot, region_index: u64)
        requires 0 <= region_index && region_index < 1
    {
        SnapshotRegion::clear_page_boundary_tombstones(&mut snapshot.regions[region_index]);
    }
    state done(snapshot: &mut Snapshot) {
        snapshot.region_count = snapshot.region_count;
    }
}

// Upstream `snapshot_region.page_boundary_tombstones.insert(address)` — a
// failed page-split read marks its range-start address so byte accounting
// excludes that range.
pub machine Snapshot::push_region_tombstone(
    snapshot: &mut Snapshot,
    region_index: u64,
    address: u64
) -> bool {
    transition region_index < snapshot.region_count && region_index < 1 {
        true -> store(snapshot, region_index, address)
        false -> (false)
        _ -> (false)
    }
    state store(snapshot: &mut Snapshot, region_index: u64, address: u64) -> bool
        requires 0 <= region_index && region_index < 1
    {
        SnapshotRegion::push_page_boundary_tombstone(&mut snapshot.regions[region_index], address)
    }
}

// Deep copy parity — `Snapshot::clone`/`clone_from` per region, matching
// upstream's `#[derive(Clone)]`.
pub machine Snapshot::clone(source: &Snapshot) -> Snapshot {
    let mut copy: Snapshot = Snapshot::new();
    Snapshot::clone_from(&mut copy, source);
    copy
}

pub machine Snapshot::clone_from(snapshot: &mut Snapshot, source: &Snapshot) {
    snapshot.region_count = source.region_count;
    DeletedScanResultIndexSet::clone_from(&mut snapshot.deleted_indices, &source.deleted_indices);
    transition { _ -> copy(snapshot, source, 0) }
    state copy(snapshot: &mut Snapshot, source: &Snapshot, position: u64) {
        transition position < source.region_count && position < 1 {
            true -> store(snapshot, source, position)
            false -> done(snapshot)
        }
    }
    state store(snapshot: &mut Snapshot, source: &Snapshot, position: u64)
        requires 0 <= position && position < 1
    {
        SnapshotRegion::clone_from(&mut snapshot.regions[position], &source.regions[position]);
        transition { _ -> copy(snapshot, source, position + 1) }
    }
    state done(snapshot: &mut Snapshot) {
        snapshot.region_count = snapshot.region_count;
    }
}

// Upstream `clone_snapshot_for_value_target_scan`: a fresh snapshot holding
// each region's bounds + collected values + page-boundary tombstones, but
// NOT the scan results — the value-target element scan must run as a fresh
// scan, not a retained-results round. `deleted_indices` is upstream's
// fresh-Snapshot state too (clone carries no tombstones).
pub machine Snapshot::clone_for_value_target_scan(source: &Snapshot) -> Snapshot {
    let mut copy: Snapshot = Snapshot::new();
    copy.region_count = source.region_count;
    transition { _ -> each(&mut copy, source, 0) }
    state each(copy: &mut Snapshot, source: &Snapshot, position: u64) -> Snapshot {
        transition position < source.region_count && position < 1 {
            true -> store(copy, source, position)
            false -> (Snapshot::clone(copy))
        }
    }
    state store(copy: &mut Snapshot, source: &Snapshot, position: u64) -> Snapshot
        requires 0 <= position && position < 1
    {
        SnapshotRegion::clone_scan_state(&mut copy.regions[position], &source.regions[position]);
        transition { _ -> each(copy, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}


// Upstream `get_collected_byte_count`: total byte coverage of the surviving
// regions — the report's `scanned_byte_count` source.
pub machine Snapshot::get_collected_byte_count(snapshot: &Snapshot) -> u64 {
    transition { _ -> each(snapshot, 0, 0) }
    state each(snapshot: &Snapshot, position: u64, total: u64) -> u64 {
        transition position < snapshot.region_count && position < 1 {
            true -> tally(snapshot, position, total)
            false -> (total)
        }
    }
    state tally(snapshot: &Snapshot, position: u64, total: u64) -> u64
        requires 0 <= position && position < 1
    {
        let next_total: u64 = ((total as u64 in Saturating)
            + (SnapshotRegion::get_collected_byte_count(&snapshot.regions[position]) as u64 in Saturating)) as u64;
        transition { _ -> each(snapshot, position + 1, next_total) }
    }
}

// ————— Scan-results materialization + tombstones —————
// Upstream `Snapshot`'s result surface: the deleted-index tombstone set,
// the visibility-adjusted counts, the address-ascending global page merge,
// and the delete/commit lifecycle that rewrites filters so tombstones
// become structural.

// Upstream `get_scan_result`: the result at a global merged-order index —
// tombstoned and out-of-range indices both answer Missing (upstream's
// Option is the `StructuralResult` union).
pub machine Snapshot::get_scan_result(
    snapshot: &Snapshot,
    global_scan_result_index: u64
) -> StructuralResult
crashes Abort
{
    transition DeletedScanResultIndexSet::contains(&snapshot.deleted_indices, global_scan_result_index) {
        true -> arm_result_471_0(global_scan_result_index)
        false -> seek(snapshot, 0, global_scan_result_index, global_scan_result_index)
    }
    state seek(snapshot: &Snapshot, position: u64, global_index: u64, local_index: u64) -> StructuralResult {
        transition position < snapshot.region_count && position < 1 {
            true -> within(snapshot, position, global_index, local_index)
            false -> (StructuralResult::Missing)
        }
    }
    state within(snapshot: &Snapshot, position: u64, global_index: u64, local_index: u64) -> StructuralResult
        requires 0 <= position && position < 1
    {
        let results: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&snapshot.regions[position]);
        let region_results: u64 = SnapshotRegionScanResults::get_number_of_results(&results);
        transition local_index < region_results {
            true -> found(snapshot, position, global_index, local_index)
            false -> seek(snapshot, position + 1, global_index,
                ((local_index as u64 in Saturating) - (region_results as u64 in Saturating)) as u64)
        }
    }
    state found(snapshot: &Snapshot, position: u64, global_index: u64, local_index: u64) -> StructuralResult
        requires 0 <= position && position < 1
    {
        let region: SnapshotRegion = SnapshotRegion::clone(&snapshot.regions[position]);
        let results: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&region);
        SnapshotRegionScanResults::get_structural_scan_result(&results, &region, global_index, local_index)
    }
    state arm_result_471_0(global_scan_result_index: u64) -> StructuralResult
    {
        (StructuralResult::Missing)
    }
}

// Upstream `delete_scan_results`: mark the provided global indices as
// tombstones; indices outside the structural result space are skipped and
// already-deleted indices do not recount.
pub machine Snapshot::delete_scan_results(
    snapshot: &mut Snapshot,
    deleted_scan_result_indices: &DeletedScanResultIndexSet
) -> u64
crashes Abort
{
    let structural_total: u64 = Snapshot::get_structural_number_of_results(snapshot);
    transition { _ -> each(snapshot, deleted_scan_result_indices, structural_total, 0, 0) }
    state each(snapshot: &mut Snapshot, indices: &DeletedScanResultIndexSet, structural_total: u64, position: u64, deleted: u64) -> u64 {
        transition position < indices.count && position < 64 {
            true -> inspect(snapshot, indices, structural_total, position, deleted)
            false -> (deleted)
        }
    }
    state inspect(snapshot: &mut Snapshot, indices: &DeletedScanResultIndexSet, structural_total: u64, position: u64, deleted: u64) -> u64
        requires 0 <= position && position < 64
    {
        let member: u64 = indices.indices[position];
        transition member < structural_total {
            true -> mark(snapshot, indices, structural_total, position, deleted, member)
            false -> each(snapshot, indices, structural_total, position + 1, deleted)
        }
    }
    state mark(snapshot: &mut Snapshot, indices: &DeletedScanResultIndexSet, structural_total: u64, position: u64, deleted: u64, member: u64) -> u64
        requires 0 <= position && position < 64
    {
        let fresh: bool = DeletedScanResultIndexSet::insert(&mut snapshot.deleted_indices, member);
        transition fresh {
            true -> each(snapshot, indices, structural_total, position + 1,
                ((deleted as u64 in Saturating) + (1 as u64 in Saturating)) as u64)
            false -> each(snapshot, indices, structural_total, position + 1, deleted)
        }
    }
}

// Upstream's per-row delete loop callsite — a single-index tombstone.
pub machine Snapshot::delete_scan_result(snapshot: &mut Snapshot, global_scan_result_index: u64) -> bool
crashes Abort
{
    let _nc0: u64 = Snapshot::get_structural_number_of_results(snapshot);
    transition global_scan_result_index < _nc0 {
        true -> (DeletedScanResultIndexSet::insert(&mut snapshot.deleted_indices, global_scan_result_index))
        false -> (false)
    }
}

// Upstream `clear_deleted_scan_result_indices`.
pub machine Snapshot::clear_deleted_scan_result_indices(snapshot: &mut Snapshot) {
    DeletedScanResultIndexSet::clear(&mut snapshot.deleted_indices);
}

// Upstream `get_deleted_scan_result_index_count`.
pub machine Snapshot::get_deleted_scan_result_index_count(snapshot: &Snapshot) -> u64 {
    DeletedScanResultIndexSet::get_count(&snapshot.deleted_indices)
}

// Upstream `commit_deleted_scan_result_indices`: rebuild every region's
// filters so the tombstones become the structural layout, then clear the
// set. Upstream takes `symbol_registry` — the port's collections carry the
// resolved `result_value_size_in_bytes`, so no registry is threaded
// (deviation recorded in the results file).
pub machine Snapshot::commit_deleted_scan_result_indices(snapshot: &mut Snapshot) -> u64
crashes Abort
{
    transition snapshot.deleted_indices.count == 0 {
        true -> (0)
        false -> commit(snapshot)
    }
    state commit(snapshot: &mut Snapshot) -> u64 {
        let deleted: DeletedScanResultIndexSet = DeletedScanResultIndexSet::clone(&snapshot.deleted_indices);
        transition { _ -> each(snapshot, &deleted, 0, 0, 0) }
    }
    state each(snapshot: &mut Snapshot, deleted: &DeletedScanResultIndexSet, removed: u64, position: u64, region_base: u64) -> u64 {
        transition position < snapshot.region_count && position < 1 {
            true -> excise(snapshot, deleted, removed, position, region_base)
            false -> finish(snapshot, removed)
        }
    }
    state excise(snapshot: &mut Snapshot, deleted: &DeletedScanResultIndexSet, removed: u64, position: u64, region_base: u64) -> u64
        requires 0 <= position && position < 1
    {
        let region_results: u64 = SnapshotRegionScanResults::get_number_of_results(SnapshotRegion::get_scan_results(&snapshot.regions[position]));
        let region_removed: u64 = SnapshotRegion::remove_scan_results_by_global_indices(&mut snapshot.regions[position], region_base, deleted);
        transition { _ -> each(snapshot, deleted,
            ((removed as u64 in Saturating) + (region_removed as u64 in Saturating)) as u64,
            position + 1,
            ((region_base as u64 in Saturating) + (region_results as u64 in Saturating)) as u64) }
    }
    state finish(snapshot: &mut Snapshot, removed: u64) -> u64 {
        DeletedScanResultIndexSet::clear(&mut snapshot.deleted_indices);
        transition { _ -> (removed) }
    }
}

// Upstream `get_structural_number_of_results` — the count before tombstones.
pub machine Snapshot::get_structural_number_of_results(snapshot: &Snapshot) -> u64
crashes Abort
{
    transition { _ -> each(snapshot, 0, 0) }
    state each(snapshot: &Snapshot, position: u64, total: u64) -> u64 {
        transition position < snapshot.region_count && position < 1 {
            true -> tally(snapshot, position, total)
            false -> (total)
        }
    }
    state tally(snapshot: &Snapshot, position: u64, total: u64) -> u64
        requires 0 <= position && position < 1
    {
        let region_results: u64 = SnapshotRegionScanResults::get_number_of_results(SnapshotRegion::get_scan_results(&snapshot.regions[position]));
        transition { _ -> each(snapshot, position + 1,
            ((total as u64 in Saturating) + (region_results as u64 in Saturating)) as u64) }
    }
}

// Upstream `get_number_of_results` — the visible count (structural minus
// tombstones inside each region's global window).
pub machine Snapshot::get_number_of_results(snapshot: &Snapshot) -> u64
crashes Abort
{
    transition { _ -> each(snapshot, 0, 0, 0) }
    state each(snapshot: &Snapshot, position: u64, total: u64, region_base: u64) -> u64 {
        transition position < snapshot.region_count && position < 1 {
            true -> tally(snapshot, position, total, region_base)
            false -> (total)
        }
    }
    state tally(snapshot: &Snapshot, position: u64, total: u64, region_base: u64) -> u64
        requires 0 <= position && position < 1
    {
        let results: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&snapshot.regions[position]);
        let structural: u64 = SnapshotRegionScanResults::get_number_of_results(&results);
        let visible: u64 = SnapshotRegionScanResults::get_visible_result_count(&results, region_base, &snapshot.deleted_indices);
        transition { _ -> each(snapshot, position + 1,
            ((total as u64 in Saturating) + (visible as u64 in Saturating)) as u64,
            ((region_base as u64 in Saturating) + (structural as u64 in Saturating)) as u64) }
    }
}

// Upstream `get_number_of_results_for_data_types` — visible count over the
// selected data types only.
pub machine Snapshot::get_number_of_results_for_data_types(
    snapshot: &Snapshot,
    filtered_data_types: &DataTypeRefSet
) -> u64
crashes Abort
{
    transition { _ -> each(snapshot, 0, 0, 0, filtered_data_types) }
    state each(snapshot: &Snapshot, position: u64, total: u64, region_base: u64, filtered_data_types: &DataTypeRefSet) -> u64 {
        transition position < snapshot.region_count && position < 1 {
            true -> tally(snapshot, position, total, region_base, filtered_data_types)
            false -> (total)
        }
    }
    state tally(snapshot: &Snapshot, position: u64, total: u64, region_base: u64, filtered_data_types: &DataTypeRefSet) -> u64
        requires 0 <= position && position < 1
    {
        let results: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&snapshot.regions[position]);
        let structural: u64 = SnapshotRegionScanResults::get_number_of_results(&results);
        let visible: u64 = SnapshotRegionScanResults::get_visible_result_count_for_data_types(&results, 
            filtered_data_types, region_base, &snapshot.deleted_indices);
        transition { _ -> each(snapshot, position + 1,
            ((total as u64 in Saturating) + (visible as u64 in Saturating)) as u64,
            ((region_base as u64 in Saturating) + (structural as u64 in Saturating)) as u64,
            filtered_data_types) }
    }
}

// Upstream `get_result_counts_by_data_type` — visible counts merged across
// regions (same-type entries fold into one tally).
pub machine Snapshot::get_result_counts_by_data_type(snapshot: &Snapshot) -> DataTypeResultCounts
crashes Abort
{
    let mut merged: DataTypeResultCounts = DataTypeResultCounts::empty();
    transition { _ -> each(snapshot, &mut merged, 0, 0) }
    state each(snapshot: &Snapshot, merged: &mut DataTypeResultCounts, position: u64, region_base: u64) -> DataTypeResultCounts {
        transition position < snapshot.region_count && position < 1 {
            true -> fold(snapshot, merged, position, region_base)
            false -> (DataTypeResultCounts::clone(&mut merged))
        }
    }
    state fold(snapshot: &Snapshot, merged: &mut DataTypeResultCounts, position: u64, region_base: u64) -> DataTypeResultCounts
        requires 0 <= position && position < 1
    {
        let results: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&snapshot.regions[position]);
        let structural: u64 = SnapshotRegionScanResults::get_number_of_results(&results);
        let region_counts: DataTypeResultCounts = SnapshotRegionScanResults::get_visible_result_counts_by_data_type(&results, 
            region_base, &snapshot.deleted_indices);
        DataTypeResultCounts::merge_from(merged, &region_counts);
        transition { _ -> each(snapshot, merged, position + 1,
            ((region_base as u64 in Saturating) + (structural as u64 in Saturating)) as u64) }
    }
}

// Upstream `get_scan_results_page`: one address-ascending page of results
// across the whole snapshot — page_index clamps to the last real page,
// skip/capacity walk each region's visible window in order.
pub machine Snapshot::get_scan_results_page(
    snapshot: &Snapshot,
    filtered_data_types: &DataTypeRefSet,
    page_index: u64,
    page_size: u64
) -> ScanResultsPage
crashes Abort
{
    let total_filtered: u64 = Snapshot::get_number_of_results_for_data_types(snapshot, filtered_data_types);
    transition { _ -> begin(snapshot, filtered_data_types, page_index, page_size, total_filtered) }
    state begin(snapshot: &Snapshot, filtered_data_types: &DataTypeRefSet, page_index: u64, page_size: u64, total_filtered: u64) -> ScanResultsPage {
        let stride: u64 = max(page_size, 1);
        transition total_filtered == 0 {
            true -> arm_result_712_0(total_filtered)
            false -> clamp(snapshot, filtered_data_types, page_index, stride, total_filtered)
        }
    }
    state clamp(snapshot: &Snapshot, filtered_data_types: &DataTypeRefSet, page_index: u64, stride: u64, total_filtered: u64) -> ScanResultsPage {
        let last_page: u64 = ((total_filtered as u64 in Saturating) - (1 as u64 in Saturating)) as u64 / stride;
        let effective: u64 = min(page_index, last_page);
        let skip: u64 = ((effective as u64 in Saturating) * (stride as u64 in Saturating)) as u64;
        let mut out: ScanResultValuedList = ScanResultValuedList::empty();
        transition { _ -> walk_regions(snapshot, 
            filtered_data_types, effective, skip, stride, &mut out, 0, 0) }
    }
    state walk_regions(
        snapshot: &Snapshot,
        filtered_data_types: &DataTypeRefSet,
        effective: u64,
        skip: u64,
        capacity: u64,
        out: &mut ScanResultValuedList,
        position: u64,
        region_base: u64
    ) -> ScanResultsPage {
        transition position < snapshot.region_count && position < 1 && capacity > 0 {
            true -> inspect(snapshot, filtered_data_types, effective, skip, capacity, out, position, region_base)
            false -> (ScanResultsPage { effective_page_index: effective, results: ScanResultValuedList::clone(&mut out) })
        }
    }
    state inspect(
        snapshot: &Snapshot,
        filtered_data_types: &DataTypeRefSet,
        effective: u64,
        skip: u64,
        capacity: u64,
        out: &mut ScanResultValuedList,
        position: u64,
        region_base: u64
    ) -> ScanResultsPage
        requires 0 <= position && position < 1
    {
        let results: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&snapshot.regions[position]);
        let structural: u64 = SnapshotRegionScanResults::get_number_of_results(&results);
        let region_visible: u64 = SnapshotRegionScanResults::get_visible_result_count_for_data_types(&results, 
            filtered_data_types, region_base, &snapshot.deleted_indices);
        transition skip >= region_visible {
            true -> pass(snapshot, filtered_data_types, effective, skip, capacity, out, position, region_base, structural, region_visible)
            false -> take(snapshot, filtered_data_types, effective, skip, capacity, out, position, region_base, structural)
        }
    }
    state pass(
        snapshot: &Snapshot,
        filtered_data_types: &DataTypeRefSet,
        effective: u64,
        skip: u64,
        capacity: u64,
        out: &mut ScanResultValuedList,
        position: u64,
        region_base: u64,
        structural: u64,
        region_visible: u64
    ) -> ScanResultsPage
        requires 0 <= position && position < 1
    {
        transition { _ -> walk_regions(snapshot, filtered_data_types, effective,
            ((skip as u64 in Saturating) - (region_visible as u64 in Saturating)) as u64,
            capacity, &mut out, position + 1,
            ((region_base as u64 in Saturating) + (structural as u64 in Saturating)) as u64) }
    }
    state take(
        snapshot: &Snapshot,
        filtered_data_types: &DataTypeRefSet,
        effective: u64,
        skip: u64,
        capacity: u64,
        out: &mut ScanResultValuedList,
        position: u64,
        region_base: u64,
        structural: u64
    ) -> ScanResultsPage
        requires 0 <= position && position < 1
    {
        let region: SnapshotRegion = SnapshotRegion::clone(&snapshot.regions[position]);
        let results: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&region);
        let region_page: ScanResultValuedList = SnapshotRegionScanResults::get_scan_results_page(&results, 
            &region, filtered_data_types, region_base, skip, capacity, &snapshot.deleted_indices);
        let emitted: u64 = ScanResultValuedList::get_result_count(&region_page);
        let mut merged: ScanResultValuedList = region_page;
        transition { _ -> append(snapshot, filtered_data_types, effective, capacity, out, position, region_base, structural, emitted, &mut merged, 0) }
    }
    state append(
        snapshot: &Snapshot,
        filtered_data_types: &DataTypeRefSet,
        effective: u64,
        capacity: u64,
        out: &mut ScanResultValuedList,
        position: u64,
        region_base: u64,
        structural: u64,
        emitted: u64,
        merged: &mut ScanResultValuedList,
        element_position: u64
    ) -> ScanResultsPage
        requires 0 <= position && position < 1
    {
        transition element_position < merged.result_count && element_position < 64 {
            true -> append_one(snapshot, filtered_data_types, effective, capacity, out, position, region_base, structural, emitted, merged, element_position)
            false -> advance(snapshot, filtered_data_types, effective, capacity, out, position, region_base, structural, emitted)
        }
    }
    state append_one(
        snapshot: &Snapshot,
        filtered_data_types: &DataTypeRefSet,
        effective: u64,
        capacity: u64,
        out: &mut ScanResultValuedList,
        position: u64,
        region_base: u64,
        structural: u64,
        emitted: u64,
        merged: &mut ScanResultValuedList,
        element_position: u64
    ) -> ScanResultsPage
        requires 0 <= position && position < 1 && 0 <= element_position && element_position < 64
    {
        let valued: ScanResultValued = ScanResultValuedList::get(merged, element_position);
        let pushed: bool = ScanResultValuedList::push(out, &valued);
        transition { _ -> append(snapshot, filtered_data_types, effective, capacity, out, position, region_base, structural, emitted, merged, element_position + 1) }
    }
    state advance(
        snapshot: &Snapshot,
        filtered_data_types: &DataTypeRefSet,
        effective: u64,
        capacity: u64,
        out: &mut ScanResultValuedList,
        position: u64,
        region_base: u64,
        structural: u64,
        emitted: u64
    ) -> ScanResultsPage
        requires 0 <= position && position < 1
    {
        transition { _ -> walk_regions(snapshot, filtered_data_types, effective, 0,
            ((capacity as u64 in Saturating) - (emitted as u64 in Saturating)) as u64,
            out, position + 1,
            ((region_base as u64 in Saturating) + (structural as u64 in Saturating)) as u64) }
    }
    state arm_result_712_0(total_filtered: u64) -> ScanResultsPage
    {
        (ScanResultsPage {
                effective_page_index: 0,
                results: ScanResultValuedList::empty(),
            })
    }
}

// Upstream `collect_scan_result_addresses_for_data_type`: every surviving
// result address of one data type, region order then merged order.
pub machine Snapshot::collect_scan_result_addresses_for_data_type(
    snapshot: &Snapshot,
    data_type_ref: &DataTypeRef
) -> ScanResultAddresses
crashes Abort
{
    let mut out: ScanResultAddresses = ScanResultAddresses::empty();
    transition { _ -> each(snapshot, &mut out, data_type_ref, 0) }
    state each(snapshot: &Snapshot, out: &mut ScanResultAddresses, data_type_ref: &DataTypeRef, position: u64) -> ScanResultAddresses {
        transition position < snapshot.region_count && position < 1 {
            true -> within(snapshot, out, data_type_ref, position)
            false -> (ScanResultAddresses::clone(&mut out))
        }
    }
    state within(snapshot: &Snapshot, out: &mut ScanResultAddresses, data_type_ref: &DataTypeRef, position: u64) -> ScanResultAddresses
        requires 0 <= position && position < 1
    {
        let region: SnapshotRegion = SnapshotRegion::clone(&snapshot.regions[position]);
        let results: SnapshotRegionScanResults = SnapshotRegion::get_scan_results(&region);
        let collection_index: u64 = SnapshotRegionScanResults::get_scan_results_by_data_type(&results, data_type_ref);
        transition collection_index < SnapshotRegionScanResults::get_collection_count(&results) && collection_index < 4 {
            true -> collect(snapshot, out, data_type_ref, position, region, results, collection_index)
            false -> each(snapshot, out, data_type_ref, position + 1)
        }
    }
    state collect(snapshot: &Snapshot, out: &mut ScanResultAddresses, data_type_ref: &DataTypeRef, position: u64, region: SnapshotRegion, results: SnapshotRegionScanResults, collection_index: u64) -> ScanResultAddresses
        requires 0 <= position && position < 1 && 0 <= collection_index && collection_index < 4
    {
        let collection: SnapshotRegionFilterCollection = SnapshotRegionScanResults::get_filter_collection(&results, collection_index);
        let memory_alignment: MemoryAlignment = SnapshotRegionFilterCollection::get_memory_alignment(&collection);
        let alignment: u64 = max(MemoryAlignment::get_size_in_bytes(&memory_alignment), 1);
        transition { _ -> each_filter(snapshot, out, data_type_ref, position, results, collection_index, &collection, alignment, 0) }
    }
    state each_filter(snapshot: &Snapshot, out: &mut ScanResultAddresses, data_type_ref: &DataTypeRef, position: u64, results: SnapshotRegionScanResults, collection_index: u64, collection: &SnapshotRegionFilterCollection, alignment: u64, filter_index: u64) -> ScanResultAddresses
        requires 0 <= position && position < 1 && 0 <= collection_index && collection_index < 4
    {
        transition filter_index < collection.filter_count && filter_index < 64 {
            true -> collect_filter(snapshot, out, data_type_ref, position, results, collection_index, collection, alignment, filter_index)
            false -> each(snapshot, out, data_type_ref, position + 1)
        }
    }
    state collect_filter(snapshot: &Snapshot, out: &mut ScanResultAddresses, data_type_ref: &DataTypeRef, position: u64, results: SnapshotRegionScanResults, collection_index: u64, collection: &SnapshotRegionFilterCollection, alignment: u64, filter_index: u64) -> ScanResultAddresses
        requires 0 <= position && position < 1 && 0 <= collection_index && collection_index < 4 && 0 <= filter_index && filter_index < 64
    {
        let filter: SnapshotRegionFilter = SnapshotRegionFilterCollection::get_filter(collection, filter_index);
        let filter_base: u64 = SnapshotRegionFilter::get_base_address(&filter);
        let filter_results: u64 = SnapshotRegionFilter::get_element_count(&filter, 
            SnapshotRegionFilterCollection::get_result_value_size_in_bytes(collection), SnapshotRegionFilterCollection::get_memory_alignment(collection));
        transition { _ -> each_result(snapshot, out, data_type_ref, position, results, collection_index, collection, alignment, filter_index, filter_base, filter_results, 0) }
    }
    state each_result(snapshot: &Snapshot, out: &mut ScanResultAddresses, data_type_ref: &DataTypeRef, position: u64, results: SnapshotRegionScanResults, collection_index: u64, collection: &SnapshotRegionFilterCollection, alignment: u64, filter_index: u64, filter_base: u64, filter_results: u64, result_index: u64) -> ScanResultAddresses
        requires 0 <= position && position < 1 && 0 <= collection_index && collection_index < 4 && 0 <= filter_index && filter_index < 64
    {
        transition result_index < filter_results {
            true -> push_result(snapshot, out, data_type_ref, position, results, collection_index, collection, alignment, filter_index, filter_base, filter_results, result_index)
            false -> each_filter(snapshot, out, data_type_ref, position, results, collection_index, collection, alignment, filter_index + 1)
        }
    }
    state push_result(snapshot: &Snapshot, out: &mut ScanResultAddresses, data_type_ref: &DataTypeRef, position: u64, results: SnapshotRegionScanResults, collection_index: u64, collection: &SnapshotRegionFilterCollection, alignment: u64, filter_index: u64, filter_base: u64, filter_results: u64, result_index: u64) -> ScanResultAddresses
        requires 0 <= position && position < 1 && 0 <= collection_index && collection_index < 4 && 0 <= filter_index && filter_index < 64
    {
        let address: u64 = ((filter_base as u64 in Saturating)
            + ((result_index as u64 in Saturating) * (alignment as u64 in Saturating))) as u64;
        let pushed: bool = ScanResultAddresses::push(out, address);
        transition { _ -> each_result(snapshot, out, data_type_ref, position, results, collection_index, collection, alignment, filter_index, filter_base, filter_results, result_index + 1) }
    }
}
