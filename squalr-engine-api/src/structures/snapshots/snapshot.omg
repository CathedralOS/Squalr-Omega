// Port of structures/snapshots/snapshot.rs: the ordered set of regions a
// scan operates over, plus the tombstone set of manually deleted global
// scan-result indices. Upstream holds `Vec<SnapshotRegion>` plus a
// `BTreeSet<u64>`; the port bounds regions at 1 — the supplied-snapshot
// leg needs one and the native backend caps structural types at 64KiB
// (one region is already ~23KiB) — named deviation, see
// tools/native_probe_resume.md. The tombstone set is the bounded
// `DeletedScanResultIndexSet` (64 entries — the CLI delete surface's row
// selection bound; same named deviation family as PageElementList).
public data Snapshot {
    regions: [|snapshot_region|::SnapshotRegion; 1];
    region_count: u64;
    deleted_indices: |deleted_scan_result_index_set|::DeletedScanResultIndexSet;
}

public machine Snapshot::new() -> Snapshot {
    Snapshot {
        region_count: 0,
        deleted_indices: |deleted_scan_result_index_set|::DeletedScanResultIndexSet::empty(),
    }
}

public machine Snapshot::get_region_count(this: &Snapshot) -> u64 {
    this.region_count
}

// Flat fixture assertions — deep member receivers (more than three
// path segments) mint no unit plan in entry closures, so the supplied-
// snapshot seed leg reads region state through plain machines here.
public machine Snapshot::get_region_base_address(this: &Snapshot) -> u64 {
    let hoist4: u64 = |snapshot_region|::SnapshotRegion::get_base_address(&this.regions[0]);
    (hoist4)
}

public machine Snapshot::get_region_size(this: &Snapshot) -> u64 {
    let hoist5: u64 = |snapshot_region|::SnapshotRegion::get_region_size(&this.regions[0]);
    (hoist5)
}

public machine Snapshot::get_region_element_count(this: &Snapshot) -> u64 {
    let hoist6: u64 = |snapshot_region|::SnapshotRegion::get_current_element_count(&this.regions[0]);
    (hoist6)
}

public machine Snapshot::region_has_current_values(this: &Snapshot) -> bool {
    let hoist7: bool = |snapshot_region|::SnapshotRegion::has_current_values(&this.regions[0]);
    (hoist7)
}

// Tombstone seed for the supplied-snapshot fixture — writes the layout
// `delete_scan_results`'s row loop leaves for a deleted index.
public machine Snapshot::seed_deleted_scan_result_index(this: &mut Snapshot, index: u64) {
    this.deleted_indices.indices[0] = index;
    this.deleted_indices.count = 1;
}

// Flat single-member read — `get(position)` mints a transition, which
// no callee in an entry closure can plan, so the seed leg reads the
// seeded tombstone member through this plain accessor.
public machine Snapshot::get_first_deleted_scan_result_index(this: &Snapshot) -> u64 {
    this.deleted_indices.indices[0]
}

public machine Snapshot::get_region(this: &Snapshot, region_index: u64) -> |snapshot_region|::SnapshotRegion {
    transition region_index < this.region_count && region_index < 1 {
        true -> clone_at(this, region_index)
        false -> (|snapshot_region|::SnapshotRegion::new(0, 0))
    }
    machine clone_at(this: &Snapshot, region_index: u64) -> |snapshot_region|::SnapshotRegion {
        |snapshot_region|::SnapshotRegion::clone(&this.regions[region_index])
    }
}

// Upstream `set_region`: replace the stored region — value collection and
// scan writes funnel through it.
public machine Snapshot::set_region(this: &mut Snapshot, region_index: u64, region: |snapshot_region|::SnapshotRegion) {
    transition region_index < this.region_count && region_index < 1 {
        true -> store(this, region_index, region)
        false -> done(this)
    }
    machine store(this: &mut Snapshot, region_index: u64, region: |snapshot_region|::SnapshotRegion) {
        |snapshot_region|::SnapshotRegion::clone_from(&mut this.regions[region_index], &region);
        this.region_count = this.region_count;
    }
    machine done(this: &mut Snapshot) {
        this.region_count = this.region_count;
    }
}

// Upstream `set_snapshot_regions`: replaces the full region set (the scan-new
// path replaces the snapshot outright).
public machine Snapshot::set_snapshot_regions(this: &mut Snapshot, regions: &[|snapshot_region|::SnapshotRegion; 1], region_count: u64) {
    this.region_count = 0;
    Snapshot::store_regions(&mut this, regions, region_count, 0);
}

machine Snapshot::store_regions(this: &mut Snapshot, regions: &[|snapshot_region|::SnapshotRegion; 1], region_count: u64, position: u64) {
    transition position < region_count && position < 1 {
        true -> store(this, regions, region_count, position)
        false -> done(this, region_count)
    }
    machine store(this: &mut Snapshot, regions: &[|snapshot_region|::SnapshotRegion; 1], region_count: u64, position: u64) {
        let source: |snapshot_region|::SnapshotRegion = |snapshot_region|::SnapshotRegion::clone(&regions[position]);
        |snapshot_region|::SnapshotRegion::clone_from(&mut this.regions[position], &source);
        this.region_count = position + 1;
        transition { _ -> Snapshot::store_regions(this, regions, region_count, position + 1) }
    }
    machine done(this: &mut Snapshot, region_count: u64) {
        this.region_count = this.region_count;
    }
}

// Upstream `push` — `snapshot.regions.push(region)` at build/merge sites.
public machine Snapshot::push_region(this: &mut Snapshot, region: |snapshot_region|::SnapshotRegion) -> bool {
    transition this.region_count < 1 {
        true -> push(this, region)
        false -> (false)
    }
    machine push(this: &mut Snapshot, region: |snapshot_region|::SnapshotRegion) -> bool {
        |snapshot_region|::SnapshotRegion::clone_from(&mut this.regions[this.region_count], &region);
        this.region_count = this.region_count + 1;
        true
    }
}

// Upstream `clear`: `scan reset` empties the snapshot.
public machine Snapshot::clear(this: &mut Snapshot) {
    this.region_count = 0;
}

// Upstream `discard_empty_regions`: regions whose size reached zero (post
// resize) are dropped, keeping address order.
public machine Snapshot::discard_empty_regions(this: &mut Snapshot) {
    let mut kept: Snapshot = Snapshot::new();
    transition { _ -> each(this, kept, 0) }
    machine each(this: &mut Snapshot, kept: Snapshot, position: u64) {
        transition position < this.region_count && position < 1 {
            true -> inspect(this, kept, position)
            false -> install(this, kept)
        }
    }
    machine inspect(this: &mut Snapshot, kept: Snapshot, position: u64)
        requires 0 <= position && position < 1
    {
        let is_nonempty: bool = |snapshot_region|::SnapshotRegion::get_region_size(&this.regions[position]) > 0;
        transition is_nonempty {
            true -> keep(this, kept, position)
            false -> each(this, kept, position + 1)
        }
    }
    machine keep(this: &mut Snapshot, kept: Snapshot, position: u64)
        requires 0 <= position && position < 1
    {
        let region: |snapshot_region|::SnapshotRegion = |snapshot_region|::SnapshotRegion::clone(&this.regions[position]);
        let mut carried: Snapshot = kept;
        let pushed: bool = Snapshot::push_region(&mut carried, region);
        transition pushed {
            true -> each(this, carried, position + 1)
            false -> install(this, carried)
            _ -> install(this, carried)
        }
    }
    machine install(this: &mut Snapshot, kept: Snapshot) {
        Snapshot::clone_from(&mut this, &kept);
    }
}

