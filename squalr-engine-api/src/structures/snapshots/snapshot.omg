// Deep copy parity — `Snapshot::clone`/`clone_from` per region, matching
// upstream's `#[derive(Clone)]`.
public machine Snapshot::clone(source: &Snapshot) -> Snapshot {
    let mut copy: Snapshot = Snapshot::new();
    Snapshot::clone_from(&mut copy, source);
    copy
}

public machine Snapshot::clone_from(this: &mut Snapshot, source: &Snapshot) {
    this.region_count = source.region_count;
    |deleted_scan_result_index_set|::DeletedScanResultIndexSet::clone_from(&mut this.deleted_indices, &source.deleted_indices);
    transition { _ -> copy(this, source, 0) }
    machine copy(this: &mut Snapshot, source: &Snapshot, position: u64) {
        transition position < source.region_count && position < 1 {
            true -> store(this, source, position)
            false -> done(this)
        }
    }
    machine store(this: &mut Snapshot, source: &Snapshot, position: u64)
        requires 0 <= position && position < 1
    {
        |snapshot_region|::SnapshotRegion::clone_from(&mut this.regions[position], &source.regions[position]);
        transition { _ -> copy(this, source, position + 1) }
    }
    machine done(this: &mut Snapshot) {
        this.region_count = this.region_count;
    }
}

// Upstream `clone_snapshot_for_value_target_scan`: a fresh snapshot holding
// each region's bounds + collected values + page-boundary tombstones, but
// NOT the scan results — the value-target element scan must run as a fresh
// scan, not a retained-results round. `deleted_indices` is upstream's
// fresh-Snapshot state too (clone carries no tombstones).
public machine Snapshot::clone_for_value_target_scan(source: &Snapshot) -> Snapshot {
    let mut copy: Snapshot = Snapshot::new();
    copy.region_count = source.region_count;
    transition { _ -> each(&mut copy, source, 0) }
    machine each(copy: &mut Snapshot, source: &Snapshot, position: u64) -> Snapshot {
        transition position < source.region_count && position < 1 {
            true -> store(copy, source, position)
            false -> (Snapshot::clone(copy))
        }
    }
    machine store(copy: &mut Snapshot, source: &Snapshot, position: u64) -> Snapshot
        requires 0 <= position && position < 1
    {
        |snapshot_region|::SnapshotRegion::clone_scan_state(&mut copy.regions[position], &source.regions[position]);
        transition { _ -> each(copy, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}


// Upstream `get_collected_byte_count`: total byte coverage of the surviving
// regions — the report's `scanned_byte_count` source.
public machine Snapshot::get_collected_byte_count(this: &Snapshot) -> u64 {
    transition { _ -> each(this, 0, 0) }
    machine each(this: &Snapshot, position: u64, total: u64) -> u64 {
        transition position < this.region_count && position < 1 {
            true -> tally(this, position, total)
            false -> (total)
        }
    }
    machine tally(this: &Snapshot, position: u64, total: u64) -> u64
        requires 0 <= position && position < 1
    {
        let next_total: u64 = ((total as u64 in Saturating)
            + (|snapshot_region|::SnapshotRegion::get_collected_byte_count(&this.regions[position]) as u64 in Saturating)) as u64;
        transition { _ -> each(this, position + 1, next_total) }
    }
}

// ————— Scan-results materialization + tombstones —————
// Upstream `Snapshot`'s result surface: the deleted-index tombstone set,
// the visibility-adjusted counts, the address-ascending global page merge,
// and the delete/commit lifecycle that rewrites filters so tombstones
// become structural.

// Upstream `get_scan_result`: the result at a global merged-order index —
// tombstoned and out-of-range indices both answer Missing (upstream's
// Option is the `StructuralResult` union).
public machine Snapshot::get_scan_result(
    this: &Snapshot,
    global_scan_result_index: u64
) -> |snapshot_region_scan_results|::StructuralResult
crashes Abort
{
