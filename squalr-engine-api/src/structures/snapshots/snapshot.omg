public machine Snapshot::initialize_all_scan_results(
    this: &mut Snapshot,
    data_type_refs: |snapshot_region|::DataTypeRefSet,
    memory_alignment: |memory_alignment|::MemoryAlignment
) {
    transition { _ -> each(this, data_type_refs, memory_alignment, 0) }
    machine each(this: &mut Snapshot, data_type_refs: |snapshot_region|::DataTypeRefSet, memory_alignment: |memory_alignment|::MemoryAlignment, position: u64) {
        transition position < this.region_count && position < 1 {
            true -> plant(this, data_type_refs, memory_alignment, position)
            false -> done(this)
        }
