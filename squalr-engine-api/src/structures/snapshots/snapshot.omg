    transition region_index < this.region_count && region_index < 1 {
        true -> store(this, region_index, elements)
        false -> done(this)
    }
    machine store(this: &mut Snapshot, region_index: u64, elements: |element_window|::ElementWindow)
        requires 0 <= region_index && region_index < 1
    {
        |snapshot_region|::SnapshotRegion::rotate_values_for_collection(&mut this.regions[region_index]);
        |snapshot_region|::SnapshotRegion::set_current_values(&mut this.regions[region_index], &elements);
    }
    machine done(this: &mut Snapshot) {
        this.region_count = this.region_count;
    }
}

