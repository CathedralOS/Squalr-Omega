// Upstream `snapshot_region.initialize_scan_results` for one region — seeds
// a whole-region filter collection per requested data type where the region
// has none yet (existing collections are kept — the successive-scan input).
public machine Snapshot::initialize_region_scan_results(
    this: &mut Snapshot,
    region_index: u64,
    data_type_refs: |snapshot_region|::DataTypeRefSet,
    memory_alignment: |memory_alignment|::MemoryAlignment
) {
    transition region_index < this.region_count && region_index < 1 {
        true -> plant(this, region_index, data_type_refs, memory_alignment)
        false -> done(this)
    }
    machine plant(this: &mut Snapshot, region_index: u64, data_type_refs: |snapshot_region|::DataTypeRefSet, memory_alignment: |memory_alignment|::MemoryAlignment)
        requires 0 <= region_index && region_index < 1
    {
        |snapshot_region|::SnapshotRegion::initialize_scan_results(&mut this.regions[region_index], &data_type_refs, memory_alignment);
    }
    machine done(this: &mut Snapshot) {
        this.region_count = this.region_count;
    }
}

// Upstream `set_scan_results` staged for the scan's install step: the fresh
// result set starts empty, the scan pushes each dispatched collection
// through `push_region_scan_result_collection`, then
// `resize_region_to_filters` collapses value coverage to the survivors.
public machine Snapshot::reset_region_scan_results(this: &mut Snapshot, region_index: u64) {
    transition region_index < this.region_count && region_index < 1 {
        true -> store(this, region_index)
        false -> done(this)
    }
    machine store(this: &mut Snapshot, region_index: u64)
        requires 0 <= region_index && region_index < 1
    {
        let empty_results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region_scan_results|::SnapshotRegionScanResults::empty();
        |snapshot_region|::SnapshotRegion::set_scan_results(&mut this.regions[region_index], &empty_results);
    }
    machine done(this: &mut Snapshot) {
        this.region_count = this.region_count;
    }
}

public machine Snapshot::push_region_scan_result_collection(
    this: &mut Snapshot,
    region_index: u64,
    collection: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection
) -> bool {
    transition region_index < this.region_count && region_index < 1 {
        true -> push(this, region_index, collection)
        false -> (false)
    }
    machine push(this: &mut Snapshot, region_index: u64, collection: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection) -> bool
        requires 0 <= region_index && region_index < 1
    {
        let hoist8: bool = |snapshot_region|::SnapshotRegion::push_scan_result_collection(&mut this.regions[region_index], collection);
        (hoist8)
    }
}

// Upstream `resize_to_filters` — shrink the region's value coverage to the
// union of surviving filters after the install completes.
public machine Snapshot::resize_region_to_filters(this: &mut Snapshot, region_index: u64) {
    transition region_index < this.region_count && region_index < 1 {
        true -> resize(this, region_index)
        false -> done(this)
    }
    machine resize(this: &mut Snapshot, region_index: u64)
        requires 0 <= region_index && region_index < 1
    {
        |snapshot_region|::SnapshotRegion::resize_to_filters(&mut this.regions[region_index]);
    }
    machine done(this: &mut Snapshot) {
        this.region_count = this.region_count;
    }
}


// Upstream `snapshot_region.initialize_scan_results` over every region —
// seeds a whole-region filter collection per requested data type where a
// Upstream `snapshot_region.initialize_scan_results` over every region —
// seeds a whole-region filter collection per requested data type where a
