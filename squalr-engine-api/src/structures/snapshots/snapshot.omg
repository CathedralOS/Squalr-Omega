    machine plant(this: &mut Snapshot, data_type_refs: |snapshot_region|::DataTypeRefSet, memory_alignment: |memory_alignment|::MemoryAlignment, position: u64)
        requires 0 <= position && position < 1
    {
        |snapshot_region|::SnapshotRegion::initialize_scan_results(&mut this.regions[position], &data_type_refs, memory_alignment);
        transition { _ -> each(this, data_type_refs, memory_alignment, position + 1) }
