// Upstream `snapshot_region.set_scan_results` + `resize_to_filters` for one
// region — installs the dispatch-produced collections and shrinks the
// region's value coverage to the surviving filters.
public machine Snapshot::apply_region_scan_results(
    this: &mut Snapshot,
    region_index: u64,
    scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults
) {
    transition region_index < this.region_count && region_index < 1 {
        true -> store(this, region_index, scan_results)
        false -> done(this)
    }
    machine store(this: &mut Snapshot, region_index: u64, scan_results: |snapshot_region_scan_results|::SnapshotRegionScanResults)
        requires 0 <= region_index && region_index < 1
    {
        |snapshot_region|::SnapshotRegion::set_scan_results(&mut this.regions[region_index], &scan_results);
        |snapshot_region|::SnapshotRegion::resize_to_filters(&mut this.regions[region_index]);
    }
    machine done(this: &mut Snapshot) {
        this.region_count = this.region_count;
    }
}

// Upstream `SnapshotValueCollector`'s per-region write: rotate the current
// values into previous, then install the freshly collected elements.
public machine Snapshot::collect_region_values(
    this: &mut Snapshot,
    region_index: u64,
