// Upstream `clear_deleted_scan_result_indices`.
public machine Snapshot::clear_deleted_scan_result_indices(this: &mut Snapshot) {
    |deleted_scan_result_index_set|::DeletedScanResultIndexSet::clear(&mut this.deleted_indices);
}

// Upstream `get_deleted_scan_result_index_count`.
public machine Snapshot::get_deleted_scan_result_index_count(this: &Snapshot) -> u64 {
    let hoist11: u64 = |deleted_scan_result_index_set|::DeletedScanResultIndexSet::get_count(&this.deleted_indices);
    (hoist11)
}

// Upstream `commit_deleted_scan_result_indices`: rebuild every region's
// filters so the tombstones become the structural layout, then clear the
// set. Upstream takes `symbol_registry` — the port's collections carry the
// resolved `result_value_size_in_bytes`, so no registry is threaded
// (deviation recorded in the results file).
public machine Snapshot::commit_deleted_scan_result_indices(this: &mut Snapshot) -> u64
crashes Abort
{
    transition this.deleted_indices.count == 0 {
        true -> (0)
        false -> commit(this)
    }
    machine commit(this: &mut Snapshot) -> u64 {
        let deleted: |deleted_scan_result_index_set|::DeletedScanResultIndexSet = |deleted_scan_result_index_set|::DeletedScanResultIndexSet::clone(&this.deleted_indices);
        transition { _ -> each(this, &deleted, 0, 0, 0) }
    }
    machine each(this: &mut Snapshot, deleted: &|deleted_scan_result_index_set|::DeletedScanResultIndexSet, removed: u64, position: u64, region_base: u64) -> u64 {
        transition position < this.region_count && position < 1 {
            true -> excise(this, deleted, removed, position, region_base)
            false -> finish(this, removed)
        }
    }
    machine excise(this: &mut Snapshot, deleted: &|deleted_scan_result_index_set|::DeletedScanResultIndexSet, removed: u64, position: u64, region_base: u64) -> u64
        requires 0 <= position && position < 1
    {
        let region_results: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_number_of_results(&|snapshot_region|::SnapshotRegion::get_scan_results(&this.regions[position]));
        let region_removed: u64 = |snapshot_region|::SnapshotRegion::remove_scan_results_by_global_indices(&mut this.regions[position], region_base, deleted);
        transition { _ -> each(this, deleted,
            ((removed as u64 in Saturating) + (region_removed as u64 in Saturating)) as u64,
            position + 1,
            ((region_base as u64 in Saturating) + (region_results as u64 in Saturating)) as u64) }
    }
    machine finish(this: &mut Snapshot, removed: u64) -> u64 {
        |deleted_scan_result_index_set|::DeletedScanResultIndexSet::clear(&mut this.deleted_indices);
        transition { _ -> (removed) }
    }
}

// Upstream `get_structural_number_of_results` — the count before tombstones.
public machine Snapshot::get_structural_number_of_results(this: &Snapshot) -> u64
crashes Abort
{
    transition { _ -> each(this, 0, 0) }
    machine each(this: &Snapshot, position: u64, total: u64) -> u64 {
        transition position < this.region_count && position < 1 {
            true -> tally(this, position, total)
            false -> (total)
        }
    }
    machine tally(this: &Snapshot, position: u64, total: u64) -> u64
        requires 0 <= position && position < 1
    {
        let region_results: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_number_of_results(&|snapshot_region|::SnapshotRegion::get_scan_results(&this.regions[position]));
        transition { _ -> each(this, position + 1,
            ((total as u64 in Saturating) + (region_results as u64 in Saturating)) as u64) }
    }
}

// Upstream `get_number_of_results` — the visible count (structural minus
// tombstones inside each region's global window).
public machine Snapshot::get_number_of_results(this: &Snapshot) -> u64
crashes Abort
{
    transition { _ -> each(this, 0, 0, 0) }
    machine each(this: &Snapshot, position: u64, total: u64, region_base: u64) -> u64 {
        transition position < this.region_count && position < 1 {
            true -> tally(this, position, total, region_base)
            false -> (total)
        }
    }
    machine tally(this: &Snapshot, position: u64, total: u64, region_base: u64) -> u64
        requires 0 <= position && position < 1
    {
        let results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&this.regions[position]);
        let structural: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_number_of_results(&results);
        let visible: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_visible_result_count(&results, region_base, &this.deleted_indices);
        transition { _ -> each(this, position + 1,
            ((total as u64 in Saturating) + (visible as u64 in Saturating)) as u64,
            ((region_base as u64 in Saturating) + (structural as u64 in Saturating)) as u64) }
    }
}

// Upstream `get_number_of_results_for_data_types` — visible count over the
// selected data types only.
public machine Snapshot::get_number_of_results_for_data_types(
    this: &Snapshot,
    filtered_data_types: &|snapshot_region|::DataTypeRefSet
) -> u64
crashes Abort
{
    transition { _ -> each(this, 0, 0, 0, filtered_data_types) }
    machine each(this: &Snapshot, position: u64, total: u64, region_base: u64, filtered_data_types: &|snapshot_region|::DataTypeRefSet) -> u64 {
        transition position < this.region_count && position < 1 {
            true -> tally(this, position, total, region_base, filtered_data_types)
            false -> (total)
        }
    }
    machine tally(this: &Snapshot, position: u64, total: u64, region_base: u64, filtered_data_types: &|snapshot_region|::DataTypeRefSet) -> u64
        requires 0 <= position && position < 1
    {
        let results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&this.regions[position]);
        let structural: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_number_of_results(&results);
        let visible: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_visible_result_count_for_data_types(&results, filtered_data_types, region_base, &this.deleted_indices);
        transition { _ -> each(this, position + 1,
            ((total as u64 in Saturating) + (visible as u64 in Saturating)) as u64,
            ((region_base as u64 in Saturating) + (structural as u64 in Saturating)) as u64,
            filtered_data_types) }
    }
}

// Upstream `get_result_counts_by_data_type` — visible counts merged across
// regions (same-type entries fold into one tally).
public machine Snapshot::get_result_counts_by_data_type(this: &Snapshot) -> |snapshot_region_scan_results|::DataTypeResultCounts
crashes Abort
{
    let mut merged: |snapshot_region_scan_results|::DataTypeResultCounts = |snapshot_region_scan_results|::DataTypeResultCounts::empty();
    transition { _ -> each(this, &mut merged, 0, 0) }
    machine each(this: &Snapshot, merged: &mut |snapshot_region_scan_results|::DataTypeResultCounts, position: u64, region_base: u64) -> |snapshot_region_scan_results|::DataTypeResultCounts {
        transition position < this.region_count && position < 1 {
            true -> fold(this, merged, position, region_base)
            false -> (|snapshot_region_scan_results|::DataTypeResultCounts::clone(&mut merged))
        }
    }
    machine fold(this: &Snapshot, merged: &mut |snapshot_region_scan_results|::DataTypeResultCounts, position: u64, region_base: u64) -> |snapshot_region_scan_results|::DataTypeResultCounts
        requires 0 <= position && position < 1
    {
        let results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&this.regions[position]);
        let structural: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_number_of_results(&results);
        let region_counts: |snapshot_region_scan_results|::DataTypeResultCounts = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_visible_result_counts_by_data_type(&results, region_base, &this.deleted_indices);
        |snapshot_region_scan_results|::DataTypeResultCounts::merge_from(&mut merged, &region_counts);
        transition { _ -> each(this, merged, position + 1,
            ((region_base as u64 in Saturating) + (structural as u64 in Saturating)) as u64) }
    }
}

// Upstream `get_scan_results_page`: one address-ascending page of results
// across the whole snapshot — page_index clamps to the last real page,
// skip/capacity walk each region's visible window in order.
public machine Snapshot::get_scan_results_page(
    this: &Snapshot,
    filtered_data_types: &|snapshot_region|::DataTypeRefSet,
    page_index: u64,
    page_size: u64
) -> |snapshot_region_scan_results|::ScanResultsPage
crashes Abort
{
    let total_filtered: u64 = Snapshot::get_number_of_results_for_data_types(&this, filtered_data_types);
    transition { _ -> begin(this, filtered_data_types, page_index, page_size, total_filtered) }
    machine begin(this: &Snapshot, filtered_data_types: &|snapshot_region|::DataTypeRefSet, page_index: u64, page_size: u64, total_filtered: u64) -> |snapshot_region_scan_results|::ScanResultsPage {
        let stride: u64 = |u64_bounds|::u64_max(page_size, 1);
        transition total_filtered == 0 {
            true -> arm_result_712_0(total_filtered)
            false -> clamp(this, filtered_data_types, page_index, stride, total_filtered)
        }
    }
    machine clamp(this: &Snapshot, filtered_data_types: &|snapshot_region|::DataTypeRefSet, page_index: u64, stride: u64, total_filtered: u64) -> |snapshot_region_scan_results|::ScanResultsPage
    requires stride >= 1;
    {
        let last_page: u64 = ((total_filtered as u64 in Saturating) - (1 as u64 in Saturating)) as u64 / stride;
        let effective: u64 = |u64_bounds|::u64_min(page_index, last_page);
        let skip: u64 = ((effective as u64 in Saturating) * (stride as u64 in Saturating)) as u64;
        let mut out: |snapshot_region_scan_results|::ScanResultValuedList = |snapshot_region_scan_results|::ScanResultValuedList::empty();
        transition { _ -> walk_regions(this, 
            filtered_data_types, effective, skip, stride, &mut out, 0, 0) }
    }
    machine walk_regions(
        this: &Snapshot,
        filtered_data_types: &|snapshot_region|::DataTypeRefSet,
        effective: u64,
        skip: u64,
        capacity: u64,
        out: &mut |snapshot_region_scan_results|::ScanResultValuedList,
        position: u64,
        region_base: u64
    ) -> |snapshot_region_scan_results|::ScanResultsPage {
        transition position < this.region_count && position < 1 && capacity > 0 {
            true -> inspect(this, filtered_data_types, effective, skip, capacity, out, position, region_base)
            false -> (|snapshot_region_scan_results|::ScanResultsPage { effective_page_index: effective, results: |snapshot_region_scan_results|::ScanResultValuedList::clone(&mut out) })
        }
    }
    machine inspect(
        this: &Snapshot,
        filtered_data_types: &|snapshot_region|::DataTypeRefSet,
        effective: u64,
        skip: u64,
        capacity: u64,
        out: &mut |snapshot_region_scan_results|::ScanResultValuedList,
        position: u64,
        region_base: u64
    ) -> |snapshot_region_scan_results|::ScanResultsPage
        requires 0 <= position && position < 1
    {
        let results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&this.regions[position]);
        let structural: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_number_of_results(&results);
        let region_visible: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_visible_result_count_for_data_types(&results, filtered_data_types, region_base, &this.deleted_indices);
        transition skip >= region_visible {
            true -> pass(this, filtered_data_types, effective, skip, capacity, out, position, region_base, structural, region_visible)
            false -> take(this, filtered_data_types, effective, skip, capacity, out, position, region_base, structural)
        }
    }
    machine pass(
        this: &Snapshot,
        filtered_data_types: &|snapshot_region|::DataTypeRefSet,
        effective: u64,
        skip: u64,
        capacity: u64,
        out: &mut |snapshot_region_scan_results|::ScanResultValuedList,
        position: u64,
        region_base: u64,
        structural: u64,
        region_visible: u64
    ) -> |snapshot_region_scan_results|::ScanResultsPage
        requires 0 <= position && position < 1
    {
        transition { _ -> walk_regions(this, filtered_data_types, effective,
            ((skip as u64 in Saturating) - (region_visible as u64 in Saturating)) as u64,
            capacity, &mut out, position + 1,
            ((region_base as u64 in Saturating) + (structural as u64 in Saturating)) as u64) }
    }
    machine take(
        this: &Snapshot,
        filtered_data_types: &|snapshot_region|::DataTypeRefSet,
        effective: u64,
        skip: u64,
        capacity: u64,
        out: &mut |snapshot_region_scan_results|::ScanResultValuedList,
        position: u64,
        region_base: u64,
        structural: u64
    ) -> |snapshot_region_scan_results|::ScanResultsPage
        requires 0 <= position && position < 1
    {
        let region: |snapshot_region|::SnapshotRegion = |snapshot_region|::SnapshotRegion::clone(&this.regions[position]);
        let results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&region);
        let region_page: |snapshot_region_scan_results|::ScanResultValuedList = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_scan_results_page(&results, &region, filtered_data_types, region_base, skip, capacity, &this.deleted_indices);
        let emitted: u64 = |snapshot_region_scan_results|::ScanResultValuedList::get_result_count(&region_page);
        let mut merged: |snapshot_region_scan_results|::ScanResultValuedList = region_page;
        transition { _ -> append(this, filtered_data_types, effective, capacity, out, position, region_base, structural, emitted, &mut merged, 0) }
    }
    machine append(
        this: &Snapshot,
        filtered_data_types: &|snapshot_region|::DataTypeRefSet,
        effective: u64,
        capacity: u64,
        out: &mut |snapshot_region_scan_results|::ScanResultValuedList,
        position: u64,
        region_base: u64,
        structural: u64,
        emitted: u64,
        merged: &mut |snapshot_region_scan_results|::ScanResultValuedList,
        element_position: u64
    ) -> |snapshot_region_scan_results|::ScanResultsPage
        requires 0 <= position && position < 1
    {
        transition element_position < merged.result_count && element_position < 64 {
            true -> append_one(this, filtered_data_types, effective, capacity, out, position, region_base, structural, emitted, merged, element_position)
            false -> advance(this, filtered_data_types, effective, capacity, out, position, region_base, structural, emitted)
        }
    }
    machine append_one(
        this: &Snapshot,
        filtered_data_types: &|snapshot_region|::DataTypeRefSet,
        effective: u64,
        capacity: u64,
        out: &mut |snapshot_region_scan_results|::ScanResultValuedList,
        position: u64,
        region_base: u64,
        structural: u64,
        emitted: u64,
        merged: &mut |snapshot_region_scan_results|::ScanResultValuedList,
        element_position: u64
    ) -> |snapshot_region_scan_results|::ScanResultsPage
        requires 0 <= position && position < 1 && 0 <= element_position && element_position < 64
    {
        let valued: |scan_result_valued|::ScanResultValued = |snapshot_region_scan_results|::ScanResultValuedList::get(&merged, element_position);
        let pushed: bool = |snapshot_region_scan_results|::ScanResultValuedList::push(&mut out, &valued);
        transition { _ -> append(this, filtered_data_types, effective, capacity, out, position, region_base, structural, emitted, merged, element_position + 1) }
    }
    machine advance(
        this: &Snapshot,
        filtered_data_types: &|snapshot_region|::DataTypeRefSet,
        effective: u64,
        capacity: u64,
        out: &mut |snapshot_region_scan_results|::ScanResultValuedList,
        position: u64,
        region_base: u64,
        structural: u64,
        emitted: u64
    ) -> |snapshot_region_scan_results|::ScanResultsPage
        requires 0 <= position && position < 1
    {
        transition { _ -> walk_regions(this, filtered_data_types, effective, 0,
            ((capacity as u64 in Saturating) - (emitted as u64 in Saturating)) as u64,
            out, position + 1,
            ((region_base as u64 in Saturating) + (structural as u64 in Saturating)) as u64) }
    }
    machine arm_result_712_0(total_filtered: u64) -> |snapshot_region_scan_results|::ScanResultsPage
    {
        (|snapshot_region_scan_results|::ScanResultsPage {
                effective_page_index: 0,
                results: |snapshot_region_scan_results|::ScanResultValuedList::empty(),
            })
    }
}

// Upstream `collect_scan_result_addresses_for_data_type`: every surviving
// result address of one data type, region order then merged order.
public machine Snapshot::collect_scan_result_addresses_for_data_type(
    this: &Snapshot,
    data_type_ref: &|data_type_ref|::DataTypeRef
) -> |snapshot_region_scan_results|::ScanResultAddresses
crashes Abort
{
    let mut out: |snapshot_region_scan_results|::ScanResultAddresses = |snapshot_region_scan_results|::ScanResultAddresses::empty();
    transition { _ -> each(this, &mut out, data_type_ref, 0) }
    machine each(this: &Snapshot, out: &mut |snapshot_region_scan_results|::ScanResultAddresses, data_type_ref: &|data_type_ref|::DataTypeRef, position: u64) -> |snapshot_region_scan_results|::ScanResultAddresses {
        transition position < this.region_count && position < 1 {
            true -> within(this, out, data_type_ref, position)
            false -> (|snapshot_region_scan_results|::ScanResultAddresses::clone(&mut out))
        }
    }
    machine within(this: &Snapshot, out: &mut |snapshot_region_scan_results|::ScanResultAddresses, data_type_ref: &|data_type_ref|::DataTypeRef, position: u64) -> |snapshot_region_scan_results|::ScanResultAddresses
        requires 0 <= position && position < 1
    {
        let region: |snapshot_region|::SnapshotRegion = |snapshot_region|::SnapshotRegion::clone(&this.regions[position]);
        let results: |snapshot_region_scan_results|::SnapshotRegionScanResults = |snapshot_region|::SnapshotRegion::get_scan_results(&region);
        let collection_index: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_scan_results_by_data_type(&results, data_type_ref);
        let hoist2: u64 = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_collection_count(&results);
        transition collection_index < hoist2 && collection_index < 4 {
            true -> collect(this, out, data_type_ref, position, region, results, collection_index)
            false -> each(this, out, data_type_ref, position + 1)
        }
    }
    machine collect(this: &Snapshot, out: &mut |snapshot_region_scan_results|::ScanResultAddresses, data_type_ref: &|data_type_ref|::DataTypeRef, position: u64, region: |snapshot_region|::SnapshotRegion, results: |snapshot_region_scan_results|::SnapshotRegionScanResults, collection_index: u64) -> |snapshot_region_scan_results|::ScanResultAddresses
        requires 0 <= position && position < 1 && 0 <= collection_index && collection_index < 4
    {
        let collection: |snapshot_region_filter_collection|::SnapshotRegionFilterCollection = |snapshot_region_scan_results|::SnapshotRegionScanResults::get_filter_collection(&results, collection_index);
        let alignment_kind: |memory_alignment|::MemoryAlignment = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_memory_alignment(&collection);
        let alignment_size: u64 = |memory_alignment|::MemoryAlignment::get_size_in_bytes(&alignment_kind);
        let alignment: u64 = |u64_bounds|::u64_max(alignment_size, 1);
        transition { _ -> each_filter(this, out, data_type_ref, position, results, collection_index, &collection, alignment, 0) }
    }
    machine each_filter(this: &Snapshot, out: &mut |snapshot_region_scan_results|::ScanResultAddresses, data_type_ref: &|data_type_ref|::DataTypeRef, position: u64, results: |snapshot_region_scan_results|::SnapshotRegionScanResults, collection_index: u64, collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection, alignment: u64, filter_index: u64) -> |snapshot_region_scan_results|::ScanResultAddresses
        requires 0 <= position && position < 1 && 0 <= collection_index && collection_index < 4
    {
        transition filter_index < collection.filter_count && filter_index < 64 {
            true -> collect_filter(this, out, data_type_ref, position, results, collection_index, collection, alignment, filter_index)
            false -> each(this, out, data_type_ref, position + 1)
        }
    }
    machine collect_filter(this: &Snapshot, out: &mut |snapshot_region_scan_results|::ScanResultAddresses, data_type_ref: &|data_type_ref|::DataTypeRef, position: u64, results: |snapshot_region_scan_results|::SnapshotRegionScanResults, collection_index: u64, collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection, alignment: u64, filter_index: u64) -> |snapshot_region_scan_results|::ScanResultAddresses
        requires 0 <= position && position < 1 && 0 <= collection_index && collection_index < 4 && 0 <= filter_index && filter_index < 64
    {
        let filter: |snapshot_region_filter|::SnapshotRegionFilter = |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_filter(&collection, filter_index);
        let filter_base: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_base_address(&filter);
        let filter_results: u64 = |snapshot_region_filter|::SnapshotRegionFilter::get_element_count(&filter, |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_result_value_size_in_bytes(collection), |snapshot_region_filter_collection|::SnapshotRegionFilterCollection::get_memory_alignment(collection));
        transition { _ -> each_result(this, out, data_type_ref, position, results, collection_index, collection, alignment, filter_index, filter_base, filter_results, 0) }
    }
    machine each_result(this: &Snapshot, out: &mut |snapshot_region_scan_results|::ScanResultAddresses, data_type_ref: &|data_type_ref|::DataTypeRef, position: u64, results: |snapshot_region_scan_results|::SnapshotRegionScanResults, collection_index: u64, collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection, alignment: u64, filter_index: u64, filter_base: u64, filter_results: u64, result_index: u64) -> |snapshot_region_scan_results|::ScanResultAddresses
        requires 0 <= position && position < 1 && 0 <= collection_index && collection_index < 4 && 0 <= filter_index && filter_index < 64
    {
        transition result_index < filter_results {
            true -> push_result(this, out, data_type_ref, position, results, collection_index, collection, alignment, filter_index, filter_base, filter_results, result_index)
            false -> each_filter(this, out, data_type_ref, position, results, collection_index, collection, alignment, filter_index + 1)
        }
    }
    machine push_result(this: &Snapshot, out: &mut |snapshot_region_scan_results|::ScanResultAddresses, data_type_ref: &|data_type_ref|::DataTypeRef, position: u64, results: |snapshot_region_scan_results|::SnapshotRegionScanResults, collection_index: u64, collection: &|snapshot_region_filter_collection|::SnapshotRegionFilterCollection, alignment: u64, filter_index: u64, filter_base: u64, filter_results: u64, result_index: u64) -> |snapshot_region_scan_results|::ScanResultAddresses
        requires 0 <= position && position < 1 && 0 <= collection_index && collection_index < 4 && 0 <= filter_index && filter_index < 64
    {
        let address: u64 = ((filter_base as u64 in Saturating)
            + ((result_index as u64 in Saturating) * (alignment as u64 in Saturating))) as u64;
        let pushed: bool = |snapshot_region_scan_results|::ScanResultAddresses::push(&mut out, address);
        transition { _ -> each_result(this, out, data_type_ref, position, results, collection_index, collection, alignment, filter_index, filter_base, filter_results, result_index + 1) }
    }
}
