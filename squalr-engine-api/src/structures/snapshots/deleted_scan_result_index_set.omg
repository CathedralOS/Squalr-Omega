module src::structures::snapshots::deleted_scan_result_index_set;

// Port of upstream `BTreeSet<u64>` deleted_scan_result_indices: the
// tombstone set of manually deleted global scan-result indices. Bounded at
// 64 — the CLI delete surface carries a row selection, matching the
// PageElementList bound (named deviation from unbounded BTreeSet growth;
// deletions past the bound are declined by `insert` returning false).
// Members stay sorted and unique, so range counting is a linear scan that
// stops at the first index past the end.
pub data DeletedScanResultIndexSet {
    indices: [u64; 64];
    count: u64;
}

pub machine DeletedScanResultIndexSet::empty() -> DeletedScanResultIndexSet {
    DeletedScanResultIndexSet { count: 0 }
}

pub machine DeletedScanResultIndexSet::is_empty(this: &DeletedScanResultIndexSet) -> bool {
    this.count == 0
}

pub machine DeletedScanResultIndexSet::get_count(this: &DeletedScanResultIndexSet) -> u64 {
    this.count
}

// Upstream `BTreeSet::insert`: absent and within the bound stores sorted —
// returns true; already-present or full returns false (upstream's `false`
// for duplicates; the bound is the named deviation).
pub machine DeletedScanResultIndexSet::insert(this: &mut DeletedScanResultIndexSet, index: u64) -> bool {
    transition { _ -> seek(this, 0, index) }
    state seek(this: &mut DeletedScanResultIndexSet, position: u64, index: u64) -> bool {
        transition position < this.count && position < 64 {
            true -> compare(this, position, index)
            false -> append(this, position, index)
        }
    }
    state compare(this: &mut DeletedScanResultIndexSet, position: u64, index: u64) -> bool
        requires 0 <= position && position < 64
    {
        transition this.indices[position] == index {
            true -> (false)
            false -> order(this, position, index)
        }
    }
    state order(this: &mut DeletedScanResultIndexSet, position: u64, index: u64) -> bool
        requires 0 <= position && position < 64
    {
        transition this.indices[position] < index {
            true -> seek(this, position + 1, index)
            false -> shift(this, position, index)
        }
    }
    state shift(this: &mut DeletedScanResultIndexSet, position: u64, index: u64) -> bool
        requires 0 <= position && position < 64
    {
        transition this.count < 64 {
            true -> move_tail(this, position, index, this.count)
            false -> (false)
        }
    }
    // Walk `tail` down from `count`, copying indices[prev] into indices[tail],
    // until the insertion slot at `position` is open. Both index operands
    // arrive bounded — the guard `tail > position` also proves tail >= 1 so
    // `tail - 1` stays in range.
    state move_tail(this: &mut DeletedScanResultIndexSet, position: u64, index: u64, tail: u64) -> bool
        requires 0 <= position && position < 64 && 0 <= tail && tail < 64
    {
        transition tail > position {
            true -> step(this, position, index, tail,
                ((tail as u64 in Saturating) - (1 as u64 in Saturating)) as u64)
            false -> plant(this, position, index)
        }
    }
    // `previous` arrived unbounded (a computed argument carries no static
    // range) — the guard narrows it before `write` takes it as a bounded
    // index.
    state step(this: &mut DeletedScanResultIndexSet, position: u64, index: u64, tail: u64, previous: u64) -> bool
        requires 0 <= position && position < 64 && 0 <= tail && tail < 64
    {
        transition previous < 64 {
            true -> write(this, position, index, tail, previous)
            false -> plant(this, position, index)
        }
    }
    state write(this: &mut DeletedScanResultIndexSet, position: u64, index: u64, tail: u64, previous: u64) -> bool
        requires 0 <= position && position < 64 && 0 <= tail && tail < 64 && 0 <= previous && previous < 64
    {
        this.indices[tail] = this.indices[previous];
        transition { _ -> move_tail(this, position, index, previous) }
    }
    state plant(this: &mut DeletedScanResultIndexSet, position: u64, index: u64) -> bool
        requires 0 <= position && position < 64
    {
        this.indices[position] = index;
        this.count = ((this.count as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        true
    }
    state append(this: &mut DeletedScanResultIndexSet, position: u64, index: u64) -> bool {
        transition this.count < 64 {
            true -> store(this, index, this.count)
            false -> (false)
        }
    }
    state store(this: &mut DeletedScanResultIndexSet, index: u64, at: u64) -> bool
        requires 0 <= at && at < 64
    {
        this.indices[at] = index;
        this.count = ((this.count as u64 in Saturating) + (1 as u64 in Saturating)) as u64;
        true
    }
}

// Upstream `BTreeSet::contains`.
pub machine DeletedScanResultIndexSet::contains(this: &DeletedScanResultIndexSet, index: u64) -> bool {
    transition { _ -> seek(this, 0, index) }
    state seek(this: &DeletedScanResultIndexSet, position: u64, index: u64) -> bool {
        transition position < this.count && position < 64 {
            true -> compare(this, position, index)
            false -> (false)
        }
    }
    state compare(this: &DeletedScanResultIndexSet, position: u64, index: u64) -> bool
        requires 0 <= position && position < 64
    {
        transition this.indices[position] == index {
            true -> (true)
            false -> skip(this, position, index)
        }
    }
    state skip(this: &DeletedScanResultIndexSet, position: u64, index: u64) -> bool
        requires 0 <= position && position < 64
    {
        transition this.indices[position] < index {
            true -> seek(this, position + 1, index)
            false -> (false)
        }
    }
}

pub machine DeletedScanResultIndexSet::clear(this: &mut DeletedScanResultIndexSet) {
    this.count = 0;
}

// In-order read of the sorted members — the `range(base..end)` walks below
// iterate positions [0, count) and filter by bounds.
pub machine DeletedScanResultIndexSet::get(this: &DeletedScanResultIndexSet, position: u64) -> u64 {
    transition position < this.count && position < 64 {
        true -> (this.indices[position])
        false -> (0)
    }
}

// Upstream `deleted_scan_result_indices.range(base..base+count).count()`:
// sorted members let the scan stop once it passes the end bound.
pub machine DeletedScanResultIndexSet::count_in_range(
    this: &DeletedScanResultIndexSet,
    range_base: u64,
    range_end: u64
) -> u64 {
    transition { _ -> seek(this, 0, 0, range_base, range_end) }
    state seek(this: &DeletedScanResultIndexSet, position: u64, found: u64, range_base: u64, range_end: u64) -> u64 {
        transition position < this.count && position < 64 {
            true -> inspect(this, position, found, range_base, range_end)
            false -> (found)
        }
    }
    state inspect(this: &DeletedScanResultIndexSet, position: u64, found: u64, range_base: u64, range_end: u64) -> u64
        requires 0 <= position && position < 64
    {
        transition this.indices[position] >= range_end {
            true -> (found)
            false -> bound(this, position, found, range_base, range_end)
        }
    }
    state bound(this: &DeletedScanResultIndexSet, position: u64, found: u64, range_base: u64, range_end: u64) -> u64
        requires 0 <= position && position < 64
    {
        transition this.indices[position] >= range_base {
            true -> tally(this, position, found, range_base, range_end)
            false -> seek(this, position + 1, found, range_base, range_end)
        }
    }
    state tally(this: &DeletedScanResultIndexSet, position: u64, found: u64, range_base: u64, range_end: u64) -> u64
        requires 0 <= position && position < 64
    {
        transition { _ -> seek(this, position + 1,
            ((found as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            range_base, range_end) }
    }
}

pub machine DeletedScanResultIndexSet::clone(source: &DeletedScanResultIndexSet) -> DeletedScanResultIndexSet {
    let mut copy: DeletedScanResultIndexSet = DeletedScanResultIndexSet::empty();
    DeletedScanResultIndexSet::clone_from(&mut copy, source);
    copy
}

pub machine DeletedScanResultIndexSet::clone_from(this: &mut DeletedScanResultIndexSet, source: &DeletedScanResultIndexSet) {
    this.count = source.count;
    transition { _ -> copy(this, source, 0) }
    state copy(this: &mut DeletedScanResultIndexSet, source: &DeletedScanResultIndexSet, position: u64) {
        transition position < source.count && position < 64 {
            true -> store(this, source, position)
            false -> done(this)
        }
    }
    state store(this: &mut DeletedScanResultIndexSet, source: &DeletedScanResultIndexSet, position: u64)
        requires 0 <= position && position < 64
    {
        this.indices[position] = source.indices[position];
        transition { _ -> copy(this, source, position + 1) }
    }
    state done(this: &mut DeletedScanResultIndexSet) {
        this.count = this.count;
    }
}
