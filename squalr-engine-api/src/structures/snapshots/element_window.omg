module src::structures::snapshots::element_window;

// Port-local value window: the snapshot's per-region current/previous value
// storage. Upstream stores raw bytes (`current_values: Vec<u8>`) and the
// scalar scanners reinterpret-load elements; the ported scanners consume
// decoded `&[u64]` element views, so the window stores one u64 per aligned
// element — the byte-level decode the ported scanner comments delegate to
// "the snapshot/value layer". A region covering `region_size` bytes at unit
// size 8 holds `region_size / 8` elements.
//
// No growable Vec exists in this pin: the window is a bounded inline buffer
// plus a length (MAX_ELEMENTS = 1024 elements = 8 KiB of covered memory per
// region — regions wider than that truncate their collected values, a named
// deviation from upstream's unbounded Vec<u8>; live capture sources bound
// their supplied windows accordingly).
pub data ElementWindow {
    elements: [u64; 1024];
    element_count: u64;
}

pub machine ElementWindow::empty() -> ElementWindow {
    ElementWindow { element_count: 0 }
}

pub machine ElementWindow::of_length(element_count: u64) -> ElementWindow {
    transition element_count <= 1024 {
        true -> arm_result_26_0(element_count)
        false -> (ElementWindow { element_count: 1024 })
    }
    state arm_result_26_0(element_count: u64) -> ElementWindow
    {
        (ElementWindow { element_count: element_count })
    }
}

// Supplied-snapshot test adapter: upstream builds windows from Vec contents
// of any length; the owned model spells up to five elements inline. Writes
// below the authored count carry the fixture data; writes at or beyond it
// land past the bound and `truncate_back` restores `element_count` so the
// window keeps its authored coverage.
pub machine ElementWindow::of_elements(
    element_count: u64,
    e0: u64,
    e1: u64,
    e2: u64,
    e3: u64,
    e4: u64
) -> ElementWindow {
    let mut window: ElementWindow = ElementWindow { element_count: element_count };
    ElementWindow::set_element(&mut window, 0, e0);
    ElementWindow::set_element(&mut window, 1, e1);
    ElementWindow::set_element(&mut window, 2, e2);
    ElementWindow::set_element(&mut window, 3, e3);
    ElementWindow::set_element(&mut window, 4, e4);
    ElementWindow::truncate_back(&mut window, element_count);
    window
}

pub machine ElementWindow::clone(source: &ElementWindow) -> ElementWindow {
    let mut window: ElementWindow = ElementWindow { element_count: source.element_count };
    ElementWindow::copy_from(&mut window, source, 0);
    window
}

pub machine ElementWindow::clone_from(element_window: &mut ElementWindow, source: &ElementWindow) {
    element_window.element_count = source.element_count;
    ElementWindow::copy_from(element_window, source, 0);
}

machine ElementWindow::copy_from(element_window: &mut ElementWindow, source: &ElementWindow, position: u64) {
    transition position < source.element_count && position < 1024 {
        true -> copy(element_window, source, position)
        false -> done(element_window)
    }
    state copy(element_window: &mut ElementWindow, source: &ElementWindow, position: u64) {
        element_window.elements[position] = source.elements[position];
        transition { _ -> ElementWindow::copy_from(element_window, source, position + 1) }
    }
    state done(element_window: &mut ElementWindow) {
        element_window.element_count = element_window.element_count;
    }
}

pub machine ElementWindow::get_element_count(element_window: &ElementWindow) -> u64 {
    element_window.element_count
}

pub machine ElementWindow::is_empty(element_window: &ElementWindow) -> bool {
    element_window.element_count == 0
}

pub machine ElementWindow::get_element(element_window: &ElementWindow, position: u64) -> u64 {
    transition position < element_window.element_count && position < 1024 {
        true -> (element_window.elements[position])
        false -> (0)
    }
}

pub machine ElementWindow::set_element(element_window: &mut ElementWindow, position: u64, value: u64) {
    transition position < 1024 {
        true -> store(element_window, position, value)
        false -> done(element_window)
    }
    state store(element_window: &mut ElementWindow, position: u64, value: u64) {
        element_window.elements[position] = value;
        // Writes extend the window only at the tail — scattered writes past
        // the stored length still record their byte but do not move `count`.
        transition position == element_window.element_count {
            true -> grow(element_window, position)
            false -> done(element_window)
        }
    }
    state grow(element_window: &mut ElementWindow, position: u64) {
        element_window.element_count = position + 1;
    }
    state done(element_window: &mut ElementWindow) {
        element_window.element_count = element_window.element_count;
    }
}

// Drops the first `element_index` elements and shifts the remainder down —
// the element-space half of SnapshotRegion::resize_to_filters moving the
// window base to the surviving filter union.
pub machine ElementWindow::truncate_front(element_window: &mut ElementWindow, element_index: u64) {
    // A drop point at or past the window's bound empties it — same verdict
    // the loop's `finish(0)` yields, short-circuited at entry.
    transition element_index < 1024 {
        true -> shift(element_window, element_index, 0)
        false -> finish(element_window, 0)
    }
    state shift(element_window: &mut ElementWindow, element_index: u64, position: u64)
        requires 0 <= element_index && element_index < 1024
    {
        let source: u64 = ((element_index as u64 in Saturating) + (position as u64 in Saturating)) as u64;
        transition source < element_window.element_count && source < 1024 && position < 1024 {
            true -> move_one(element_window, element_index, position, source)
            false -> finish(element_window, position)
        }
    }
    state move_one(element_window: &mut ElementWindow, element_index: u64, position: u64, source: u64)
        requires 0 <= element_index && element_index < 1024 && 0 <= position && position < 1024 && 0 <= source && source < 1024
    {
        element_window.elements[position] = element_window.elements[source];
        transition { _ -> shift(element_window, element_index, position + 1) }
    }
    state finish(element_window: &mut ElementWindow, kept: u64) {
        element_window.element_count = kept;
    }
}

// Upstream byte-count surface: the window covers `element_count * unit`
// bytes of the region.
pub machine ElementWindow::get_covered_byte_count(element_window: &ElementWindow, unit_size_in_bytes: u64) -> u64 {
    ((element_window.element_count as u64 in Saturating) * (unit_size_in_bytes as u64 in Saturating)) as u64
}

// Upstream Vec::clear parity — drop the window back to empty.
pub machine ElementWindow::clear(element_window: &mut ElementWindow) {
    element_window.element_count = 0;
}

// Clamp the window to at most `element_count` trailing elements — the
// resize-to-filters back-edge cull. Larger inputs keep all elements.
pub machine ElementWindow::truncate_back(element_window: &mut ElementWindow, element_count: u64) {
    transition element_window.element_count > element_count {
        true -> clamp(element_window, element_count)
        false -> keep(element_window, element_count)
    }
    state clamp(element_window: &mut ElementWindow, element_count: u64) {
        element_window.element_count = element_count;
    }
    state keep(element_window: &mut ElementWindow, element_count: u64) {
        element_window.element_count = element_window.element_count;
    }
}

// Upstream's filter-relative value views — `&window.elements[start..end]`.
// The dominating `start <= 1024 - count` proves the subslice bound; the
// returned slice's length is opaque to callers, so downstream indexing is
// guarded against `slice.len` as the scanner legs already do.
pub machine ElementWindow::slice(element_window: &ElementWindow, start: u64, count: u64) -> &[u64] {
    transition count <= 1024 && start < 1024 && start <= 1024 - count {
        true -> windowed(element_window, start, count)
        _ -> (&element_window.elements[0..0])
    }
    state windowed(element_window: &ElementWindow, start: u64, count: u64) -> &[u64]
        requires 0 <= start && start < 1024 && 0 <= count && count < 1025
    {
        let end: u64 = start + count;
        transition start <= end && end <= 1024 {
            true -> arm_result_187_0(element_window, start, end)
            _ -> (&element_window.elements[0..0])
        }
    }
    state arm_result_187_0(element_window: &ElementWindow, start: u64, end: u64) -> &[u64]
    requires start <= end && end <= 1024;
    {
        (&element_window.elements[start..end])
    }
}

// Upstream `Vec::push` on the decoded element list — appends one element,
// truncating at the window bound (the carrier's named deviation).
pub machine ElementWindow::push_element(element_window: &mut ElementWindow, value: u64) -> bool {
    transition element_window.element_count < 1024 {
        true -> store(element_window, value)
        false -> (false)
    }
    state store(element_window: &mut ElementWindow, value: u64) -> bool {
        element_window.elements[element_window.element_count] = value;
        element_window.element_count = element_window.element_count + 1;
        true
    }
}
