module src::structures::processes::target_architecture;

use src::structures::memory::bitness::Bitness;

// Port of structures/processes/target_architecture.rs. Upstream stores a pair
// of registry identifiers (instruction_set_id / instruction_data_type_id) per
// architecture; here the identity is the case and the pointer width is the
// explicit mapping. Default-for-bitness mirrors upstream's `default_for_bitness`
// (x86 for 32-bit, x64 for 64-bit).
pub data TargetArchitecture [copy] {
    // `X64` leads so zero-initialized state equals the Bit64 companion
    // architecture (union field stores are unavailable in the entry unit
    // plan; case order carries no wire semantics).
    case X64;
    case X86;
    case Arm32;
    case Arm64;
}

pub machine TargetArchitecture::default_for_bitness(bitness: Bitness) -> TargetArchitecture {
    transition bitness {
        Bitness::Bit32 -> (TargetArchitecture::X86)
        Bitness::Bit64 -> (TargetArchitecture::X64)
    }
}

pub machine TargetArchitecture::x64() -> TargetArchitecture {
    TargetArchitecture::X64
}

pub machine TargetArchitecture::x86() -> TargetArchitecture {
    TargetArchitecture::X86
}

pub machine TargetArchitecture::arm64() -> TargetArchitecture {
    TargetArchitecture::Arm64
}

pub machine TargetArchitecture::get_pointer_width(&self) -> Bitness {
    transition self {
        TargetArchitecture::X86 -> (Bitness::Bit32)
        TargetArchitecture::X64 -> (Bitness::Bit64)
        TargetArchitecture::Arm32 -> (Bitness::Bit32)
        TargetArchitecture::Arm64 -> (Bitness::Bit64)
    }
}
