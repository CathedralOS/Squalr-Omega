module src::structures::processes::process_name;

// The bounded process-name copy shared by the process records. Both
// ProcessInfo and OpenedProcessInfo port upstream `name: String` as a
// [u8; 256] buffer beside a length (Linux comm caps at TASK_COMM_LEN = 16,
// so 256 bytes cannot truncate a real enumeration entry). `limit` is the
// caller-supplied name bound main's copy loops already honor. The copy
// writes through the caller's borrowed buffer and returns the stored count,
// which the caller assigns to its own name_len; the buffer is never read
// back.
pub machine copy_process_name(name: &mut [u8; 256], text: &[u8], limit: u64) -> u64 {
    transition { _ -> copy(name, text, limit, 0) }
    state copy(name: &mut [u8; 256], text: &[u8], limit: u64, position: u64) -> u64 {
        transition position < text.len && position < limit && position < 256 {
            true -> store(name, text, limit, position)
            false -> (position)
        }
    }
    state store(name: &mut [u8; 256], text: &[u8], limit: u64, position: u64) -> u64 {
        name[position] = text[position];
        transition { _ -> copy(name, text, limit, position + 1) }
    }
}
