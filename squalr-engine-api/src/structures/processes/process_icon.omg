module src::structures::processes::process_icon;

// Port of structures/processes/process_icon.rs.
// `bytes_rgba: Vec<u8>` -> bounded [u8; 16384] + live length — RGBA icons are
// small (16384 = a 64x64 RGBA image, over every real process-list icon);
// the copy stores min(len, 16384) rather than silently wrapping.
// `width`/`height` carry through as u32.
pub data ProcessIcon {
    bytes_rgba: [u8; 16384];
    bytes_rgba_len: u64;
    width: u32;
    height: u32;
}

pub machine ProcessIcon::new(bytes_rgba: &[u8], width: u32, height: u32) -> ProcessIcon {
    let mut icon: ProcessIcon = ProcessIcon {
        bytes_rgba_len: 0,
        width: width,
        height: height
    };
    ProcessIcon::set_bytes_rgba(&mut icon, bytes_rgba);
    (icon)
}

pub machine ProcessIcon::default() -> ProcessIcon {
    ProcessIcon {
        bytes_rgba_len: 0,
        width: 0,
        height: 0
    }
}

pub machine ProcessIcon::get_bytes_rgba(process_icon: &ProcessIcon) -> &[u8] {
    transition process_icon.bytes_rgba_len <= 16384 {
        true -> (&process_icon.bytes_rgba[0..process_icon.bytes_rgba_len])
        false -> (&process_icon.bytes_rgba[0..16384])
        _ -> (&process_icon.bytes_rgba[0..16384])
    }
}

pub machine ProcessIcon::get_width(process_icon: &ProcessIcon) -> u32 {
    process_icon.width
}

pub machine ProcessIcon::get_height(process_icon: &ProcessIcon) -> u32 {
    process_icon.height
}

pub machine ProcessIcon::clone_from(process_icon: &mut ProcessIcon, source: &ProcessIcon) {
    let source_bytes: &[u8] = ProcessIcon::get_bytes_rgba(source);
    ProcessIcon::set_bytes_rgba(process_icon, source_bytes);
    process_icon.width = source.width;
    process_icon.height = source.height;
}

pub machine ProcessIcon::set_bytes_rgba(process_icon: &mut ProcessIcon, bytes_rgba: &[u8]) {
    process_icon.bytes_rgba_len = 0;
    transition { _ -> copy(process_icon, bytes_rgba, 0) }
    state copy(process_icon: &mut ProcessIcon, bytes_rgba: &[u8], position: u64) {
        transition position < bytes_rgba.len && position < 16384 {
            true -> store(process_icon, bytes_rgba, position)
            false -> finish(process_icon, position)
        }
    }
    state store(process_icon: &mut ProcessIcon, bytes_rgba: &[u8], position: u64) {
        process_icon.bytes_rgba[position] = bytes_rgba[position];
        transition {
            _ -> copy(process_icon, bytes_rgba, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(process_icon: &mut ProcessIcon, count: u64) {
        process_icon.bytes_rgba_len = count;
    }
}
