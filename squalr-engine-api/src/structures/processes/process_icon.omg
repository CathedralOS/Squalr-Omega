module src::structures::processes::process_icon;

// Port of structures/processes/process_icon.rs.
// `bytes_rgba: Vec<u8>` -> bounded [u8; 16384] + live length — RGBA icons are
// small (16384 = a 64x64 RGBA image, over every real process-list icon);
// the copy stores min(len, 16384) rather than silently wrapping.
// `width`/`height` carry through as u32.
pub data ProcessIcon {
    bytes_rgba: [u8; 16384];
    bytes_rgba_len: u64;
    width: u32;
    height: u32;
}

pub machine ProcessIcon::new(bytes_rgba: &[u8], width: u32, height: u32) -> ProcessIcon {
    let mut icon: ProcessIcon = ProcessIcon {
        bytes_rgba_len: 0,
        width: width,
        height: height
    };
    icon.set_bytes_rgba(bytes_rgba);
    (icon)
}

pub machine ProcessIcon::default() -> ProcessIcon {
    ProcessIcon {
        bytes_rgba_len: 0,
        width: 0,
        height: 0
    }
}

pub machine ProcessIcon::get_bytes_rgba(&self) -> &[u8] {
    transition self.bytes_rgba_len <= 16384 {
        true -> (&self.bytes_rgba[0..self.bytes_rgba_len])
        false -> (&self.bytes_rgba[0..16384])
        _ -> (&self.bytes_rgba[0..16384])
    }
}

pub machine ProcessIcon::get_width(&self) -> u32 {
    self.width
}

pub machine ProcessIcon::get_height(&self) -> u32 {
    self.height
}

pub machine ProcessIcon::set_bytes_rgba(&mut self, bytes_rgba: &[u8]) {
    self.bytes_rgba_len = 0;
    transition { _ -> copy(bytes_rgba, 0) }
    state copy(&mut self, bytes_rgba: &[u8], position: u64) {
        transition position < bytes_rgba.len && position < 16384 {
            true -> store(bytes_rgba, position)
            false -> finish(position)
        }
    }
    state store(&mut self, bytes_rgba: &[u8], position: u64) {
        self.bytes_rgba[position] = bytes_rgba[position];
        transition {
            _ -> copy(bytes_rgba, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.bytes_rgba_len = count;
    }
}
