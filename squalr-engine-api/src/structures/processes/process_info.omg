module src::structures::processes::process_info;

use src::structures::processes::process_name;

// Port of structures/processes/process_info.rs. Upstream fields:
//   process_id: u32, name: String, is_windowed: bool, icon: Option<ProcessIcon>.
// Translations: `name` is a bounded byte buffer (Omega has no growable String;
// Linux comm is kernel-capped at TASK_COMM_LEN = 16, so 256 bytes cannot
// truncate a real enumeration entry — a name field, not a growable result).
// `icon` is omitted: icons are GUI-facing and the payload type is unported.
pub data ProcessInfo {
    process_id: u32;
    name: [u8; 256];
    name_len: u64;
    is_windowed: bool;
}

pub machine ProcessInfo::new(process_id: u32, is_windowed: bool) -> ProcessInfo {
    ProcessInfo {
        process_id: process_id,
        name_len: 0,
        is_windowed: is_windowed
    }
}

pub machine ProcessInfo::new_named(process_id: u32, name: &[u8], is_windowed: bool) -> ProcessInfo {
    let mut info: ProcessInfo = ProcessInfo::new(process_id, is_windowed);
    info.set_name(name);
    info
}

pub machine ProcessInfo::set_name(&mut self, name: &[u8]) {
    self.name_len = process_name::copy_process_name(&mut self.name, name);
}

pub machine ProcessInfo::get_process_id(&self) -> u32 {
    self.process_id
}

pub machine ProcessInfo::get_process_id_raw(&self) -> u32 {
    self.process_id
}

pub machine ProcessInfo::get_name_len(&self) -> u64 {
    self.name_len
}

pub machine ProcessInfo::get_is_windowed(&self) -> bool {
    self.is_windowed
}
