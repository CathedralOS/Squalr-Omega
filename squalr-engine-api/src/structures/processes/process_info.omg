module src::structures::processes::process_info;

// Port of structures/processes/process_info.rs. Upstream fields:
//   process_id: u32, name: String, is_windowed: bool, icon: Option<ProcessIcon>.
// Translations: `name` is a bounded byte buffer (Omega has no growable String;
// Linux comm is kernel-capped at TASK_COMM_LEN = 16, so 256 bytes cannot
// truncate a real enumeration entry — a name field, not a growable result).
// `icon` is omitted: icons are GUI-facing and the payload type is unported.
pub data ProcessInfo {
    process_id: u32;
    name: [u8; 256];
    name_len: u64;
    is_windowed: bool;
}

pub machine ProcessInfo::new(process_id: u32, is_windowed: bool) -> ProcessInfo {
    ProcessInfo {
        process_id: process_id,
        name_len: 0,
        is_windowed: is_windowed
    }
}

pub machine ProcessInfo::new_named(process_id: u32, name: &[u8], name_len: u64, is_windowed: bool) -> ProcessInfo {
    let mut info: ProcessInfo = ProcessInfo::new(process_id, is_windowed);
    ProcessInfo::set_name(&mut info, name, name_len);
    info
}

pub machine ProcessInfo::set_name(process_info: &mut ProcessInfo, name: &[u8], limit: u64) {
    // Named deviation: upstream copies through the shared bounded-buffer
    // helper `copy_process_name(&mut self.name, ...)`, but a `&mut self.field`
    // structural argument is declined by the checker (`call operation:
    // structural arguments: parameter path`) in any program whose entry
    // machine's data carries a `Binding` capability field — i.e. every real
    // program. The same copy is spelled here as an indexed field-element
    // store on `self`, the admitted shape.
    transition { _ -> copy(process_info, name, limit, 0) }
    state copy(process_info: &mut ProcessInfo, name: &[u8], limit: u64, position: u64) {
        transition position < name.len && position < limit && position < 256 {
            true -> store(process_info, name, limit, position)
            false -> done(process_info, position)
        }
    }
    state store(process_info: &mut ProcessInfo, name: &[u8], limit: u64, position: u64)
        requires 0 <= position && position < name.len && position < limit && position < 256
    {
        process_info.name[position] = name[position];
        transition { _ -> copy(process_info, name, limit, position + 1) }
    }
    state done(process_info: &mut ProcessInfo, position: u64) {
        process_info.name_len = position;
    }
}

pub machine ProcessInfo::get_process_id(process_info: &ProcessInfo) -> u32 {
    process_info.process_id
}

pub machine ProcessInfo::get_process_id_raw(process_info: &ProcessInfo) -> u32 {
    process_info.process_id
}

pub machine ProcessInfo::get_name_len(process_info: &ProcessInfo) -> u64 {
    process_info.name_len
}

pub machine ProcessInfo::get_is_windowed(process_info: &ProcessInfo) -> bool {
    process_info.is_windowed
}
