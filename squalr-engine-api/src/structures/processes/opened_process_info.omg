module src::structures::processes::opened_process_info;

use src::structures::memory::bitness::Bitness;
use src::structures::processes::process_name;
use src::structures::processes::target_architecture::TargetArchitecture;

// Port of structures/processes/opened_process_info.rs. `handle` is the
// provider's opened-process token (Linux keeps upstream's convention: the raw
// process id; the read surface still opens /proc/<pid>/mem per read, matching
// upstream's process_vm_readv which needs no descriptor). `name` is the same
// bounded-256 translation as ProcessInfo; `icon` is omitted pending the icon
// payload type (GUI-facing).
pub data OpenedProcessInfo [copy] {
    process_id: u32;
    name: [u8; 256];
    name_len: u64;
    handle: u64;
    bitness: Bitness;
    target_architecture: TargetArchitecture;
}

pub machine OpenedProcessInfo::new(
    process_id: u32,
    name: &[u8],
    handle: u64,
    bitness: Bitness
) -> OpenedProcessInfo {
    let mut info: OpenedProcessInfo = OpenedProcessInfo {
        process_id: process_id,
        name_len: 0,
        handle: handle,
        bitness: bitness,
        target_architecture: TargetArchitecture::default_for_bitness(bitness)
    };
    info.set_name(name);
    info
}

pub machine OpenedProcessInfo::set_name(&mut self, name: &[u8]) {
    self.name_len = process_name::copy_process_name(&mut self.name, name);
}

// Upstream `with_target_architecture`: an explicit override that also rewrites
// `bitness` from the architecture's pointer width.
pub machine OpenedProcessInfo::with_target_architecture(
    &mut self,
    target_architecture: TargetArchitecture
) {
    self.target_architecture = target_architecture;
    self.bitness = target_architecture.get_pointer_width();
}

pub machine OpenedProcessInfo::get_process_id(&self) -> u32 {
    self.process_id
}

pub machine OpenedProcessInfo::get_process_id_raw(&self) -> u32 {
    self.process_id
}

pub machine OpenedProcessInfo::get_name_len(&self) -> u64 {
    self.name_len
}

pub machine OpenedProcessInfo::get_handle(&self) -> u64 {
    self.handle
}

pub machine OpenedProcessInfo::get_bitness(&self) -> Bitness {
    self.bitness
}

pub machine OpenedProcessInfo::get_pointer_width(&self) -> u64 {
    self.bitness.get_pointer_width()
}

pub machine OpenedProcessInfo::get_target_architecture(&self) -> TargetArchitecture {
    self.target_architecture
}
