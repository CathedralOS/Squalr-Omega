module src::structures::processes::opened_process_info;

use src::structures::memory::bitness::Bitness;
use src::structures::processes::target_architecture::TargetArchitecture;

// Port of structures/processes/opened_process_info.rs. `handle` is the
// provider's opened-process token (Linux keeps upstream's convention: the raw
// process id; the read surface still opens /proc/<pid>/mem per read, matching
// upstream's process_vm_readv which needs no descriptor). `name` is the same
// bounded-256 translation as ProcessInfo; `icon` is omitted pending the icon
// payload type (GUI-facing).
pub data OpenedProcessInfo [copy] {
    process_id: u32;
    name: [u8; 256];
    name_len: u64;
    handle: u64;
    bitness: Bitness;
    target_architecture: TargetArchitecture;
}

pub machine OpenedProcessInfo::new(
    process_id: u32,
    name: &[u8],
    name_len: u64,
    handle: u64,
    bitness: Bitness
) -> OpenedProcessInfo {
    let mut info: OpenedProcessInfo = OpenedProcessInfo {
        process_id: process_id,
        name_len: 0,
        handle: handle,
        bitness: bitness,
        target_architecture: TargetArchitecture::default_for_bitness(bitness)
    };
    OpenedProcessInfo::set_name(&mut info, name, name_len);
    info
}

pub machine OpenedProcessInfo::set_name(this: &mut OpenedProcessInfo, name: &[u8], limit: u64) {
    // Same named deviation as ProcessInfo::set_name: the `&mut this.name`
    // helper argument declines under Binding-carrying entry data, so the
    // copy is an indexed field-element store on `this`.
    transition { _ -> copy(this, name, limit, 0) }
    state copy(this: &mut OpenedProcessInfo, name: &[u8], limit: u64, position: u64) {
        transition position < name.len && position < limit && position < 256 {
            true -> store(this, name, limit, position)
            false -> done(this, position)
        }
    }
    state store(this: &mut OpenedProcessInfo, name: &[u8], limit: u64, position: u64)
        requires 0 <= position && position < name.len && position < limit && position < 256
    {
        this.name[position] = name[position];
        transition { _ -> copy(this, name, limit, position + 1) }
    }
    state done(this: &mut OpenedProcessInfo, position: u64) {
        this.name_len = position;
    }
}

// Upstream `with_target_architecture`: an explicit override that also rewrites
// `bitness` from the architecture's pointer width.
pub machine OpenedProcessInfo::with_target_architecture(
    this: &mut OpenedProcessInfo,
    target_architecture: TargetArchitecture
) {
    this.target_architecture = target_architecture;
    this.bitness = TargetArchitecture::get_pointer_width(&target_architecture);
}

pub machine OpenedProcessInfo::get_process_id(this: &OpenedProcessInfo) -> u32 {
    this.process_id
}

pub machine OpenedProcessInfo::get_process_id_raw(this: &OpenedProcessInfo) -> u32 {
    this.process_id
}

pub machine OpenedProcessInfo::get_name_len(this: &OpenedProcessInfo) -> u64 {
    this.name_len
}

// Bounded byte read for name comparisons (the debugger service's cached
// process-identity match) — same shape as `get_instruction_byte`.
pub machine OpenedProcessInfo::get_name_byte(this: &OpenedProcessInfo, position: u64) -> u8
    requires position < 256 {
    transition position < this.name_len {
        true -> (this.name[position])
        _ -> (0)
    }
}

pub machine OpenedProcessInfo::get_handle(this: &OpenedProcessInfo) -> u64 {
    this.handle
}

pub machine OpenedProcessInfo::get_bitness(this: &OpenedProcessInfo) -> Bitness {
    this.bitness
}

// Scalar proxy for `bitness` — a `u8` carrier so structural callers can case on
// the width without binding the enum. `self.bitness` is read as the transition
// subject directly, which keeps the machine on the scalar route.
pub machine OpenedProcessInfo::get_bitness_tag(this: &OpenedProcessInfo) -> u8 {
    transition this.bitness {
        Bitness::Bit32 -> (1)
        Bitness::Bit64 -> (0)
    }
}

pub machine OpenedProcessInfo::get_pointer_width(this: &OpenedProcessInfo) -> u64 {
    let hoist1: u64 = Bitness::get_pointer_width(&this.bitness);
    (hoist1)
}

pub machine OpenedProcessInfo::get_target_architecture(this: &OpenedProcessInfo) -> TargetArchitecture {
    this.target_architecture
}
