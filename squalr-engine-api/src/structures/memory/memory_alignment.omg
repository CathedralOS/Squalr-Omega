module src::structures::memory::memory_alignment;

// Port of MemoryAlignment's variants, Default, From<i32>, and FromStr
// behavior. Omega cases are not numeric discriminants; get_size_in_bytes is
// the explicit mapping. `[copy]` covers the upstream Clone/Copy derives.
// Upstream `Serialize`/`Deserialize` have no Omega equivalent yet: the
// synthesized wire codec only accepts record data, not case-bearing types —
// named deviation.
pub data MemoryAlignment [copy] {
    case Alignment1;
    case Alignment2;
    case Alignment4;
    case Alignment8;
}

pub machine MemoryAlignment::default() -> MemoryAlignment {
    MemoryAlignment::Alignment4
}

pub machine MemoryAlignment::from(size: i32) -> MemoryAlignment {
    transition size {
        1 -> (MemoryAlignment::Alignment1)
        2 -> (MemoryAlignment::Alignment2)
        4 -> (MemoryAlignment::Alignment4)
        8 -> (MemoryAlignment::Alignment8)
        _ -> (MemoryAlignment::Alignment1)
    }
}

pub machine MemoryAlignment::get_size_in_bytes(&self) -> u64 [1..=8] {
    transition self {
        MemoryAlignment::Alignment1 -> (1)
        MemoryAlignment::Alignment2 -> (2)
        MemoryAlignment::Alignment4 -> (4)
        MemoryAlignment::Alignment8 -> (8)
    }
}

// Upstream `FromStr`: the parse result, with `Invalid` first so an untouched
// value reads as failure (the OpenResult zero-case convention). Upstream's
// `Err` echoes the authored text; a data case cannot retain a borrowed byte
// view, so `Invalid` drops the echo — named deviation.
pub data AlignmentParseResult [copy] {
    case Invalid;
    case Parsed(alignment: MemoryAlignment);
}

// The parsed size in bytes, or 0 when the text did not parse. `Invalid` has
// no upstream size; 0 keeps the result domain refusal-shaped rather than
// aliasing a real alignment.
pub machine AlignmentParseResult::parsed_size(&self) -> u64 {
    transition self {
        AlignmentParseResult::Parsed { alignment } -> sized(alignment)
        _ -> refused()
    }
    state sized(alignment: MemoryAlignment) -> u64 { alignment.get_size_in_bytes() }
    state refused() -> u64 { 0 }
}

// Upstream `FromStr::from_str`: only the spelled byte strings "1"/"2"/"4"/"8"
// parse. Authored text is a byte domain in Omega, so the single-byte spellings
// match on the byte values 49/50/52/56 ('1'/'2'/'4'/'8'); every other length
// or byte is the upstream `_` refusal.
pub machine MemoryAlignment::from_str(text: &[u8]) -> AlignmentParseResult {
    transition text.len > 0 {
        true -> head(text[0], text.len)
        false -> invalid()
    }
    state head(byte: u8, len: u64) -> AlignmentParseResult {
        transition len == 1 {
            true -> digit(byte)
            false -> invalid()
        }
    }
    state digit(byte: u8) -> AlignmentParseResult {
        transition byte {
            49 -> parsed(MemoryAlignment::Alignment1)
            50 -> parsed(MemoryAlignment::Alignment2)
            52 -> parsed(MemoryAlignment::Alignment4)
            56 -> parsed(MemoryAlignment::Alignment8)
            _ -> invalid()
        }
    }
    state parsed(alignment: MemoryAlignment) -> AlignmentParseResult {
        AlignmentParseResult::Parsed { alignment: alignment }
    }
    state invalid() -> AlignmentParseResult { AlignmentParseResult::Invalid }
}

// In-package exercise: every spelled byte parses to its alignment size and
// both refusal shapes (wrong byte, wrong length) return Invalid. Checked
// here because `&`-receiver calls on byte slices do not cross the package
// boundary under selected ProgramEntry establishment, so squalr-tests cannot
// host this yet — same edge the wire-codec exercise names.
pub machine MemoryAlignment::from_str_consistent() -> bool {
    let one: [u8; 1] = [49];
    let two: [u8; 1] = [50];
    let four: [u8; 1] = [52];
    let eight: [u8; 1] = [56];
    let three: [u8; 1] = [51];
    let wide: [u8; 2] = [56, 56];
    let r1: AlignmentParseResult = MemoryAlignment::from_str(&one);
    let r2: AlignmentParseResult = MemoryAlignment::from_str(&two);
    let r4: AlignmentParseResult = MemoryAlignment::from_str(&four);
    let r8: AlignmentParseResult = MemoryAlignment::from_str(&eight);
    let r_bad: AlignmentParseResult = MemoryAlignment::from_str(&three);
    let r_wide: AlignmentParseResult = MemoryAlignment::from_str(&wide);
    let s1: u64 = r1.parsed_size();
    let s2: u64 = r2.parsed_size();
    let s4: u64 = r4.parsed_size();
    let s8: u64 = r8.parsed_size();
    let s_bad: u64 = r_bad.parsed_size();
    let s_wide: u64 = r_wide.parsed_size();
    s1 == 1 && s2 == 2 && s4 == 4 && s8 == 8 && s_bad == 0 && s_wide == 0
}
