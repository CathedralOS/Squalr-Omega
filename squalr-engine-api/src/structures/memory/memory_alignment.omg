module src::structures::memory::memory_alignment;

// Port of MemoryAlignment's variants, Default, and From<i32> behavior.
// Omega cases are not numeric discriminants; get_size_in_bytes is the explicit mapping.
pub data MemoryAlignment [copy] {
    case Alignment1;
    case Alignment2;
    case Alignment4;
    case Alignment8;
}

pub machine MemoryAlignment::default() -> MemoryAlignment {
    MemoryAlignment::Alignment4
}

pub machine MemoryAlignment::from(size: i32) -> MemoryAlignment {
    transition size {
        1 -> (MemoryAlignment::Alignment1)
        2 -> (MemoryAlignment::Alignment2)
        4 -> (MemoryAlignment::Alignment4)
        8 -> (MemoryAlignment::Alignment8)
        _ -> (MemoryAlignment::Alignment1)
    }
}

pub machine MemoryAlignment::get_size_in_bytes(&self) -> u64 [1..=8] {
    transition self {
        MemoryAlignment::Alignment1 -> (1)
        MemoryAlignment::Alignment2 -> (2)
        MemoryAlignment::Alignment4 -> (4)
        MemoryAlignment::Alignment8 -> (8)
    }
}

// Port of FromStr. Rust takes `&str`; composed machines cannot pass borrowed
// `&[u8]` slices into unit-machine calls, so the spelling arrives as owned
// bytes on a record. Only the one-byte spellings "1", "2", "4" and "8" are
// valid upstream, so the carrier needs just the first two bytes plus the
// length: every longer or empty input lands on Invalid exactly as from_str's
// Err would. Rust's Err echoes the input in a String; Omega has no owned
// String, so Invalid carries no echoed input.
pub data AlignmentSpelling {
    first: u8;
    second: u8;
    len: u64;
}

pub machine AlignmentSpelling::of(first: u8, second: u8, len: u64) -> AlignmentSpelling {
    AlignmentSpelling { first: first, second: second, len: len }
}

pub data MemoryAlignmentParse {
    ok: bool;
    size: u64;
}

pub machine MemoryAlignmentParse::is_ok(&self) -> bool {
    self.ok
}

pub machine MemoryAlignmentParse::get_size(&self) -> u64 {
    self.size
}

// '1'..'8' byte values: 49, 50, 52, 56.
pub machine AlignmentSpelling::parse(&self) -> MemoryAlignmentParse {
    transition {
        self.len == 1 && self.first == 49 -> (MemoryAlignmentParse { ok: true, size: 1 })
        self.len == 1 && self.first == 50 -> (MemoryAlignmentParse { ok: true, size: 2 })
        self.len == 1 && self.first == 52 -> (MemoryAlignmentParse { ok: true, size: 4 })
        self.len == 1 && self.first == 56 -> (MemoryAlignmentParse { ok: true, size: 8 })
        _ -> (MemoryAlignmentParse { ok: false, size: 0 })
    }
}
