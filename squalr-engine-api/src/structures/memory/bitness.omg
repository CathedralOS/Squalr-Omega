module src::structures::memory::bitness;

// Port of structures/memory/bitness.rs: the process bitness enum. Omega cases
// carry no numeric discriminant; get_pointer_width is the explicit mapping.
// `is_64bit`/`is_32bit` upstream are covered by the equality canary usage of
// the two cases.
pub data Bitness [copy] {
    // `Bit64` leads so zero-initialized state equals `OpenedProcessInfo::new`'s
    // nominal bitness (union field stores are unavailable in the entry unit
    // plan; case order carries no wire semantics).
    case Bit64;
    case Bit32;
}

pub machine Bitness::get_pointer_width(&self) -> u64 {
    transition self {
        Bitness::Bit32 -> (4)
        Bitness::Bit64 -> (8)
    }
}
