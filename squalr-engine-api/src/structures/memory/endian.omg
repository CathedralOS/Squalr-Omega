module src::structures::memory::endian;

// Port of structures/memory/endian.rs: the byte order a scanned process uses.
// Little is the default for most systems; Big is the default for GameCube and
// its emulators.
pub data Endian [copy] {
    case Little;
    case Big;
}

// Upstream `Default` — little endian.
pub machine Endian::default() -> Endian {
    Endian::Little
}

// Upstream `Display` — "le" / "be".
pub machine Endian::get_label(this: &Endian) -> u8 {
    transition this {
        Endian::Little -> (108)
        Endian::Big -> (98)
    }
}

// Upstream `PartialEq` parity for the `transition`-free equality routes.
pub machine Endian::equals(this: &Endian, other: &Endian) -> bool {
    transition this {
        Endian::Little -> is_little(this, other)
        Endian::Big -> is_big(this, other)
    }
    state is_little(this: &Endian, other: &Endian) -> bool {
        transition other {
            Endian::Little -> (true)
            Endian::Big -> (false)
        }
    }
    state is_big(this: &Endian, other: &Endian) -> bool {
        transition other {
            Endian::Big -> (true)
            Endian::Little -> (false)
        }
    }
}
