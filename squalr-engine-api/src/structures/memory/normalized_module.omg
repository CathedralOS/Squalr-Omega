module src::structures::memory::normalized_module;
use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::memory::normalized_region;

// Port of structures/memory/normalized_module.rs: a named, normalized address
// span for one loaded module. `module_name` upstream is String; Omega keeps
// authored text in a bounded inline buffer plus a live length — the same
// translation ProcessInfo::name and AnonymousValueString use (bounded at
// 256 bytes — upstream unbounded; named deviation).
pub data ModuleAddressDisplay [copy] {
    case ModuleRelative;
    case AbsoluteAddress;
}

pub data NormalizedModule {
    base_region: normalized_region::NormalizedRegion;
    module_name: [u8; 256];
    module_name_len: u64;
    module_address_display: ModuleAddressDisplay;
}

// Upstream `NormalizedModule::new`.
pub machine NormalizedModule::new(module_name: &[u8], base_address: u64, size: u64) -> NormalizedModule {
    let mut module: NormalizedModule = NormalizedModule {
        base_region: normalized_region::NormalizedRegion { base_address: base_address, region_size: size },
        module_name_len: 0,
        module_address_display: ModuleAddressDisplay::ModuleRelative,
    };
    module.set_module_name(module_name);
    (module)
}

// `Clone::clone_from` — the pointer-scan executors need an owned modules
// copy that can outlive the store's arena borrows (a shared slice of the
// source record cannot coexist with them under borrow discipline).
pub machine NormalizedModule::clone_from(&mut self, source: &NormalizedModule) {
    self.base_region.clone_from(&source.base_region);
    self.module_name_len = source.module_name_len;
    self.module_address_display = source.module_address_display;
    let module_name_view: &[u8] = bounded_slice(&source.module_name[0..256], source.module_name_len);
    let _: u64 = BoundedByteCopy::copy(&mut self.module_name[0..256], module_name_view);
}

// Upstream `NormalizedModule::new_with_display`.
pub machine NormalizedModule::new_with_display(
    module_name: &[u8],
    base_address: u64,
    size: u64,
    module_address_display: ModuleAddressDisplay
) -> NormalizedModule {
    let mut module: NormalizedModule = NormalizedModule {
        base_region: normalized_region::NormalizedRegion { base_address: base_address, region_size: size },
        module_name_len: 0,
        module_address_display: module_address_display,
    };
    module.set_module_name(module_name);
    (module)
}

// Upstream `NormalizedModule::new_from_normalized_region`.
pub machine NormalizedModule::new_from_normalized_region(
    normalized_region: normalized_region::NormalizedRegion,
    module_name: &[u8]
 ) -> NormalizedModule {
    NormalizedModule::new_from_normalized_region_with_display(
        normalized_region,
        module_name,
        ModuleAddressDisplay::ModuleRelative
    )
}

// Upstream `NormalizedModule::new_from_normalized_region_with_display`.
pub machine NormalizedModule::new_from_normalized_region_with_display(
    normalized_region: normalized_region::NormalizedRegion,
    module_name: &[u8],
    module_address_display: ModuleAddressDisplay
) -> NormalizedModule {
    let mut module: NormalizedModule = NormalizedModule {
        base_region: normalized_region,
        module_name_len: 0,
        module_address_display: module_address_display,
    };
    module.set_module_name(module_name);
    (module)
}

// Upstream `into_base_region`. Omega has no `self`-move destructuring on
// records, so this clones the geometry — same values the upstream move hands
// back (named deviation: consume-on-read becomes copy-on-read).
pub machine NormalizedModule::into_base_region(&self) -> normalized_region::NormalizedRegion {
    normalized_region::NormalizedRegion { base_address: self.base_region.get_base_address(), region_size: self.base_region.get_region_size() }
}

// Upstream `get_module_name`.
pub machine NormalizedModule::get_module_name(&self) -> &[u8] {
    transition self.module_name_len <= 256 {
        true -> arm_result_110_0()
        false -> (self.module_name[0..256])
    }
    state arm_result_110_0(&self) -> &[u8]
    
    requires self.module_name_len <= 256;
{
        (self.module_name[0..self.module_name_len])
    }
}

// Upstream `get_base_address`.
pub machine NormalizedModule::get_base_address(&self) -> u64 {
    self.base_region.get_base_address()
}

// Upstream `set_base_address`.
pub machine NormalizedModule::set_base_address(&mut self, base_address: u64) {
    self.base_region.set_base_address(base_address);
}

// Upstream `get_region_size`.
pub machine NormalizedModule::get_region_size(&self) -> u64 {
    self.base_region.get_region_size()
}

// Upstream `set_region_size`.
pub machine NormalizedModule::set_region_size(&mut self, region_size: u64) {
    self.base_region.set_region_size(region_size);
}

// Upstream `contains_address`.
pub machine NormalizedModule::contains_address(&self, address: u64) -> bool {
    self.base_region.contains_address(address)
}

// Upstream `get_base_region`.
pub machine NormalizedModule::get_base_region(&self) -> normalized_region::NormalizedRegion {
    normalized_region::NormalizedRegion { base_address: self.base_region.get_base_address(), region_size: self.base_region.get_region_size() }
}

// Upstream `get_module_address_display`.
pub machine NormalizedModule::get_module_address_display(&self) -> ModuleAddressDisplay {
    self.module_address_display
}

// Name setter: copies up to the inline bound, storing the live length.
pub machine NormalizedModule::set_module_name(&mut self, module_name: &[u8]) {
    self.module_name_len = BoundedByteCopy::copy(&mut self.module_name[0..256], module_name);
}
