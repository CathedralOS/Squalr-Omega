module src::structures::memory::normalized_module;

use src::structures::memory::normalized_region;
use src::structures::memory::normalized_region::NormalizedRegion;

// Port of structures/memory/normalized_module.rs: a named, normalized address
// span for one loaded module. `module_name` upstream is String; Omega keeps
// authored text in a bounded inline buffer plus a live length — the same
// translation ProcessInfo::name and AnonymousValueString use (bounded at
// 256 bytes — upstream unbounded; named deviation).
pub data ModuleAddressDisplay [copy] {
    case ModuleRelative;
    case AbsoluteAddress;
}

pub data NormalizedModule {
    base_region: normalized_region::NormalizedRegion;
    module_name: [u8; 256];
    module_name_len: u64;
    module_address_display: ModuleAddressDisplay;
}

// Upstream `NormalizedModule::new`.
pub machine NormalizedModule::new(module_name: &[u8], base_address: u64, size: u64) -> NormalizedModule {
    let mut module: NormalizedModule = NormalizedModule {
        base_region: normalized_region::NormalizedRegion { base_address: base_address, region_size: size },
        module_name_len: 0,
        module_address_display: ModuleAddressDisplay::ModuleRelative,
    };
    NormalizedModule::set_module_name(&mut module, module_name);
    (module)
}

// `Clone::clone_from` — the pointer-scan executors need an owned modules
// copy that can outlive the store's arena borrows (a shared slice of the
// source record cannot coexist with them under borrow discipline).
pub machine NormalizedModule::clone_from(normalized_module: &mut NormalizedModule, source: &NormalizedModule) {
    NormalizedRegion::clone_from(&mut normalized_module.base_region, &source.base_region);
    normalized_module.module_name_len = source.module_name_len;
    normalized_module.module_address_display = source.module_address_display;
    transition { _ -> copy(normalized_module, source, 0) }
    state copy(normalized_module: &mut NormalizedModule, source: &NormalizedModule, position: u64) {
        transition position < source.module_name_len && position < 256 {
            true -> store(normalized_module, source, position)
            false -> done()
            _ -> done()
        }
    }
    state store(normalized_module: &mut NormalizedModule, source: &NormalizedModule, position: u64)
        requires 0 <= position && position < 256
    {
        normalized_module.module_name[position] = source.module_name[position];
        transition { _ -> copy(normalized_module, source, position + 1) }
    }
    state done() {
    }
}

// Upstream `NormalizedModule::new_with_display`.
pub machine NormalizedModule::new_with_display(
    module_name: &[u8],
    base_address: u64,
    size: u64,
    module_address_display: ModuleAddressDisplay
) -> NormalizedModule {
    let mut module: NormalizedModule = NormalizedModule {
        base_region: normalized_region::NormalizedRegion { base_address: base_address, region_size: size },
        module_name_len: 0,
        module_address_display: module_address_display,
    };
    NormalizedModule::set_module_name(&mut module, module_name);
    (module)
}

// Upstream `NormalizedModule::new_from_normalized_region`.
pub machine NormalizedModule::new_from_normalized_region(
    normalized_region: normalized_region::NormalizedRegion,
    module_name: &[u8]
 ) -> NormalizedModule {
    NormalizedModule::new_from_normalized_region_with_display(
        normalized_region,
        module_name,
        ModuleAddressDisplay::ModuleRelative
    )
}

// Upstream `NormalizedModule::new_from_normalized_region_with_display`.
pub machine NormalizedModule::new_from_normalized_region_with_display(
    normalized_region: normalized_region::NormalizedRegion,
    module_name: &[u8],
    module_address_display: ModuleAddressDisplay
) -> NormalizedModule {
    let mut module: NormalizedModule = NormalizedModule {
        base_region: normalized_region,
        module_name_len: 0,
        module_address_display: module_address_display,
    };
    NormalizedModule::set_module_name(&mut module, module_name);
    (module)
}

// Upstream `into_base_region`. Omega has no `self`-move destructuring on
// records, so this clones the geometry — same values the upstream move hands
// back (named deviation: consume-on-read becomes copy-on-read).
pub machine NormalizedModule::into_base_region(normalized_module: &NormalizedModule) -> normalized_region::NormalizedRegion {
    normalized_region::NormalizedRegion { base_address: NormalizedRegion::get_base_address(&normalized_module.base_region), region_size: NormalizedRegion::get_region_size(&normalized_module.base_region) }
}

// Upstream `get_module_name`.
pub machine NormalizedModule::get_module_name(normalized_module: &NormalizedModule) -> &[u8] {
    transition normalized_module.module_name_len <= 256 {
        true -> arm_result_110_0(normalized_module)
        false -> (normalized_module.module_name[0..256])
    }
    state arm_result_110_0(normalized_module: &NormalizedModule) -> &[u8]
    
    requires normalized_module.module_name_len <= 256;
{
        (normalized_module.module_name[0..normalized_module.module_name_len])
    }
}

// Upstream `get_base_address`.
pub machine NormalizedModule::get_base_address(normalized_module: &NormalizedModule) -> u64 {
    NormalizedRegion::get_base_address(&normalized_module.base_region)
}

// Upstream `set_base_address`.
pub machine NormalizedModule::set_base_address(normalized_module: &mut NormalizedModule, base_address: u64) {
    NormalizedRegion::set_base_address(&mut normalized_module.base_region, base_address);
}

// Upstream `get_region_size`.
pub machine NormalizedModule::get_region_size(normalized_module: &NormalizedModule) -> u64 {
    NormalizedRegion::get_region_size(&normalized_module.base_region)
}

// Upstream `set_region_size`.
pub machine NormalizedModule::set_region_size(normalized_module: &mut NormalizedModule, region_size: u64) {
    NormalizedRegion::set_region_size(&mut normalized_module.base_region, region_size);
}

// Upstream `contains_address`.
pub machine NormalizedModule::contains_address(normalized_module: &NormalizedModule, address: u64) -> bool {
    NormalizedRegion::contains_address(&normalized_module.base_region, address)
}

// Upstream `get_base_region`.
pub machine NormalizedModule::get_base_region(normalized_module: &NormalizedModule) -> normalized_region::NormalizedRegion {
    normalized_region::NormalizedRegion { base_address: NormalizedRegion::get_base_address(&normalized_module.base_region), region_size: NormalizedRegion::get_region_size(&normalized_module.base_region) }
}

// Upstream `get_module_address_display`.
pub machine NormalizedModule::get_module_address_display(normalized_module: &NormalizedModule) -> ModuleAddressDisplay {
    normalized_module.module_address_display
}

// Name setter: copies up to the inline bound, storing the live length.
pub machine NormalizedModule::set_module_name(normalized_module: &mut NormalizedModule, module_name: &[u8]) {
    normalized_module.module_name_len = 0;
    transition {
        _ -> copy_name(normalized_module, module_name, 0)
    }
    state copy_name(normalized_module: &mut NormalizedModule, module_name: &[u8], position: u64) {
        transition (position < module_name.len && position < 256) {
            true -> store_name(normalized_module, module_name, position)
            false -> finish(normalized_module, position)
        }
    }
    state store_name(normalized_module: &mut NormalizedModule, module_name: &[u8], position: u64) {
        normalized_module.module_name[position] = module_name[position];
        transition {
            _ -> copy_name(normalized_module, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(normalized_module: &mut NormalizedModule, count: u64) {
        normalized_module.module_name_len = count;
    }
}
