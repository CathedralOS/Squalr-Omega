module src::structures::memory::pointer_chain_segment;

use src::structures::memory::symbolic_pointer_chain::SymbolicPointerChainLink;
use src::structures::memory::symbolic_pointer_chain::PointerChainSymbol;

// Port of structures/memory/pointer_chain_segment.rs. Upstream
// `PointerChainSegment` is a `pub use` re-export of
// `SymbolicPointerChainLink`; Omega has no type alias, so consumers use
// `SymbolicPointerChainLink` directly (named deviation — the segment name
// remains documentation-only here). What this file does port is the
// `IntoPointerChainSegments` behavior for `Vec<i64>`/`&[i64]`: filling a
// caller-lent link extent with `Offset` links from authored offsets.

// `IntoPointerChainSegments for &[i64]` — writes `offsets.len` Offset links
// into `out` (bounded by `out.len`); returns the count written.
pub machine offsets_to_pointer_chain_segments(offsets: &[i64], out: &mut [SymbolicPointerChainLink]) -> u64 {
    transition {
        _ -> fill(offsets, out, 0)
    }
    state fill(offsets: &[i64], out: &mut [SymbolicPointerChainLink], index: u64) -> u64 {
        transition (index < offsets.len && index < out.len) {
            true -> store(offsets, out, index)
            false -> (index)
        }
    }
    state store(offsets: &[i64], out: &mut [SymbolicPointerChainLink], index: u64) -> u64 {
        out[index] = SymbolicPointerChainLink::Offset { offset: offsets[index] };
        transition {
            _ -> fill(offsets, out, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}
