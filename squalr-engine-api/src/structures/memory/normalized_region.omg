module src::structures::memory::normalized_region;

use src::structures::memory::memory_alignment::MemoryAlignment;

// Port of the geometry used by SnapshotRegionFilter. Serialization, ordering,
// and hashing are not implemented in this seed.
pub data NormalizedRegion [copy] {
    base_address: u64;
    region_size: u64;
}

pub machine NormalizedRegion::new(base_address: u64, region_size: u64) -> NormalizedRegion {
    NormalizedRegion { base_address: base_address, region_size: region_size }
}

pub machine NormalizedRegion::get_base_address(&self) -> u64 {
    self.base_address
}

pub machine NormalizedRegion::set_base_address(&mut self, base_address: u64) {
    self.base_address = base_address;
}

pub machine NormalizedRegion::get_region_size(&self) -> u64 {
    self.region_size
}

pub machine NormalizedRegion::set_region_size(&mut self, region_size: u64) {
    self.region_size = region_size;
}

pub machine NormalizedRegion::get_end_address(&self) -> u64 {
    ((self.base_address as u64 in Saturating) + (self.region_size as u64 in Saturating)) as u64
}

pub machine NormalizedRegion::set_end_address(&mut self, end_address: u64) {
    self.region_size = ((end_address as u64 in Saturating) - (self.base_address as u64 in Saturating)) as u64;
}

pub machine NormalizedRegion::set_base_address_retain_end_address(&mut self, base_address: u64) {
    let end_address: u64 = self.get_end_address();
    self.base_address = base_address;
    self.set_end_address(end_address);
}

// Upstream returns early when the base is already aligned, otherwise moves it
// to the next multiple. Adding `(alignment - base % alignment) % alignment`
// matches both cases: it is 0 for an aligned base and the forward distance
// otherwise. Wrapping mirrors the released upstream add at the address edge.
pub machine NormalizedRegion::set_alignment(&mut self, alignment: MemoryAlignment) {
    let alignment_size: u64 [1..=8] = alignment.get_size_in_bytes();
    let end_address: u64 = self.get_end_address();
    let forward: u64 = (((alignment_size as u64 in Saturating) - ((self.base_address % alignment_size) as u64 in Saturating)) as u64) % alignment_size;
    self.base_address = ((self.base_address as u64 in Wrapping) + (forward as u64 in Wrapping)) as u64;
    self.set_end_address(end_address);
}

// Upstream saturates the base subtraction; the released multiply wraps before
// the saturating size addition.
pub machine NormalizedRegion::expand(&mut self, expand_size: u64) {
    self.base_address = ((self.base_address as u64 in Saturating) - (expand_size as u64 in Saturating)) as u64;
    let doubled: u64 = ((expand_size as u64 in Wrapping) * 2) as u64;
    self.region_size = ((self.region_size as u64 in Saturating) + (doubled as u64 in Saturating)) as u64;
}

// The upstream region includes its end address in this predicate.
pub machine NormalizedRegion::contains_address(&self, address: u64) -> bool {
    address >= self.base_address && address <= self.get_end_address()
}

pub machine NormalizedRegion::equals(&self, other: &NormalizedRegion) -> bool {
    self.base_address == other.base_address && self.region_size == other.region_size
}
