module src::structures::memory::normalized_region;

use src::structures::memory::memory_alignment::MemoryAlignment;
use omega::language::core::float_order;
use omega::language::core::relation;

// Port of the geometry used by SnapshotRegionFilter. Hashing is not
// implemented in this seed. Parity: the fields carry wire schema numbers,
// so the synthesized `NormalizedRegion::encode`/`decode` pair is this
// type's serialization (upstream `Serialize`/`Deserialize`); `clone` is
// the authored equivalent of the derived `Clone` impl, and the ordering
// below ports Ord/PartialOrd.
// Copyable pure-value pair (two u64s): callers read elements out of lent
// slices by copy, which matches the value semantics the upstream range
// objects rely on.
pub data NormalizedRegion {
    base_address: u64;
    region_size: u64;
}

// The dispatchable decode verdict: Invalid is the zero case, so an untouched
// verdict reads as failure (the decode contract requires this exact shape).
data WireVerdict {
    case Invalid;
    case Sound;
}

// Upstream PartialEq/Eq: `==`/`!=` select the Equatable route on this type.
pub NormalizedRegionEquality satisfies Equatable<NormalizedRegion> { }

pub machine NormalizedRegion::new(base_address: u64, region_size: u64) -> NormalizedRegion {
    NormalizedRegion { base_address: base_address, region_size: region_size }
}

// Upstream derived `Clone` parity, split at the compiler's edges: `clone`
// takes the borrowed source as an explicit parameter because nested calls
// with a runtime receiver cannot produce a record result yet, and
// `clone_from` is the mutating half used where a record result cannot be
// bound at all (`Clone::clone_from(&mut self, source)` reads the same).
pub machine NormalizedRegion::clone(source: &NormalizedRegion) -> NormalizedRegion {
    NormalizedRegion { base_address: source.base_address, region_size: source.region_size }
}

pub machine NormalizedRegion::clone_from(this: &mut NormalizedRegion, source: &NormalizedRegion) {
    this.base_address = source.base_address;
    this.region_size = source.region_size;
}

pub machine NormalizedRegion::get_base_address(this: &NormalizedRegion) -> u64 {
    this.base_address
}

pub machine NormalizedRegion::set_base_address(this: &mut NormalizedRegion, base_address: u64) {
    this.base_address = base_address;
}

pub machine NormalizedRegion::get_region_size(this: &NormalizedRegion) -> u64 {
    this.region_size
}

pub machine NormalizedRegion::set_region_size(this: &mut NormalizedRegion, region_size: u64) {
    this.region_size = region_size;
}

pub machine NormalizedRegion::get_end_address(this: &NormalizedRegion) -> u64 {
    ((this.base_address as u64 in Saturating) + (this.region_size as u64 in Saturating)) as u64
}

pub machine NormalizedRegion::set_end_address(this: &mut NormalizedRegion, end_address: u64) {
    this.region_size = ((end_address as u64 in Saturating) - (this.base_address as u64 in Saturating)) as u64;
}

pub machine NormalizedRegion::set_base_address_retain_end_address(this: &mut NormalizedRegion, base_address: u64) {
    let end_address: u64 = NormalizedRegion::get_end_address(&this);
    this.base_address = base_address;
    NormalizedRegion::set_end_address(&mut this, end_address);
}

// Upstream returns early when the base is already aligned, otherwise moves it
// to the next multiple. Adding `(alignment - base % alignment) % alignment`
// matches both cases: it is 0 for an aligned base and the forward distance
// otherwise. Wrapping mirrors the released upstream add at the address edge.
pub machine NormalizedRegion::set_alignment(this: &mut NormalizedRegion, alignment: MemoryAlignment) {
    let alignment_size: u64 = MemoryAlignment::get_size_in_bytes(&alignment);
    let end_address: u64 = NormalizedRegion::get_end_address(&this);
    let forward: u64 = (((alignment_size as u64 in Saturating) - ((this.base_address % alignment_size) as u64 in Saturating)) as u64) % alignment_size;
    this.base_address = ((this.base_address as u64 in Wrapping) + (forward as u64 in Wrapping)) as u64;
    NormalizedRegion::set_end_address(&mut this, end_address);
}

// Upstream saturates the base subtraction; the released multiply wraps before
// the saturating size addition.
pub machine NormalizedRegion::expand(this: &mut NormalizedRegion, expand_size: u64) {
    this.base_address = ((this.base_address as u64 in Saturating) - (expand_size as u64 in Saturating)) as u64;
    let doubled: u64 = ((expand_size as u64 in Wrapping) * 2) as u64;
    this.region_size = ((this.region_size as u64 in Saturating) + (doubled as u64 in Saturating)) as u64;
}

// The upstream region includes its end address in this predicate.
pub machine NormalizedRegion::contains_address(this: &NormalizedRegion, address: u64) -> bool {
    address >= this.base_address && address <= NormalizedRegion::get_end_address(&this)
}

pub machine NormalizedRegion::equals(this: &NormalizedRegion, other: &NormalizedRegion) -> bool {
    this.base_address == other.base_address && this.region_size == other.region_size
}


// Upstream `impl Ord for NormalizedRegion` compares only the base address, so
// same-base regions order-equal even when their sizes differ; upstream
// PartialOrd forwards `Some(cmp)`, the same total order. `base_address_order`
// is the callable spelling exercised by squalr-tests; `TotalOrder` is the
// named `Order` conformance a trait-selected sort binds. The four fixed-token
// operators below declare the upstream operator surface but are unreachable
// from application code today: `<`/`<=`/`>`/`>=` require owned operands and
// by-value data arguments do not cross the selected ProgramEntry boundary
// (checked-diagnosed: "rejoins 0 Terminal attachment identities"). `Hash`
// stays unported until a hash-keyed region collection is ported.
pub machine NormalizedRegion::base_address_order(this: &NormalizedRegion, other: &NormalizedRegion) -> bool {
    this.base_address < other.base_address
}

pub machine NormalizedRegion::TotalOrder(left: NormalizedRegion, right: NormalizedRegion) -> bool
satisfies Order::before
{
    left.base_address < right.base_address
}

pub machine < NormalizedRegion::less(left: NormalizedRegion, right: NormalizedRegion) -> bool {
    left.base_address < right.base_address
}

pub machine <= NormalizedRegion::less_or_equal(left: NormalizedRegion, right: NormalizedRegion) -> bool {
    left.base_address <= right.base_address
}

pub machine > NormalizedRegion::greater(left: NormalizedRegion, right: NormalizedRegion) -> bool {
    left.base_address > right.base_address
}

pub machine >= NormalizedRegion::greater_or_equal(left: NormalizedRegion, right: NormalizedRegion) -> bool {
    left.base_address >= right.base_address
}
