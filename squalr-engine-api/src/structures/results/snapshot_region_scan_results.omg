module src::structures::results::snapshot_region_scan_results;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::memory::memory_alignment::MemoryAlignment;
use src::structures::scanning::filters::snapshot_region_filter::SnapshotRegionFilter;
use src::structures::scanning::filters::snapshot_region_filter_collection::SnapshotRegionFilterCollection;
use src::structures::scan_results::scan_result_base::ScanResultBase;
use src::structures::scan_results::scan_result_data_type_count::ScanResultDataTypeCount;
use src::structures::scan_results::scan_result_ref::ScanResultRef;
use src::structures::scan_results::scan_result_valued::ScanResultValued;
use src::structures::snapshots::deleted_scan_result_index_set::DeletedScanResultIndexSet;
use src::structures::snapshots::snapshot_region::DataTypeRefSet;
use src::structures::snapshots::snapshot_region::FilterBounds;
use src::structures::snapshots::snapshot_region::SnapshotRegion;

// Port of structures/results/snapshot_region_scan_results.rs: the per-type
// filter collections a snapshot region owns. Upstream holds
// `Vec<SnapshotRegionFilterCollection>`; the port bounds it
// (MAX_COLLECTIONS = 4 — more requested data types truncate, a named
// deviation).
//
// Result ordering: upstream pages results by walking a min-heap of
// per-collection cursors, so the visible order is ascending address merged
// across collections. The port keeps that order via an explicit min-address
// pick over bounded collection cursors — same output, no heap.
pub data SnapshotRegionScanResults {
    snapshot_region_filter_collections: [SnapshotRegionFilterCollection; 4];
    collection_count: u64;
}

pub machine SnapshotRegionScanResults::new(
    snapshot_region_filter_collections: [SnapshotRegionFilterCollection; 4],
    collection_count: u64
) -> SnapshotRegionScanResults {
    transition { _ -> clamp(snapshot_region_filter_collections, collection_count) }
    state clamp(
        snapshot_region_filter_collections: [SnapshotRegionFilterCollection; 4],
        collection_count: u64
    ) -> SnapshotRegionScanResults {
        transition collection_count <= 4 {
            true -> arm_result_40_0(collection_count, snapshot_region_filter_collections)
            false -> (SnapshotRegionScanResults {
                collection_count: 4,
                snapshot_region_filter_collections: snapshot_region_filter_collections,
            })
        }
    }
    state arm_result_40_0(collection_count: u64, snapshot_region_filter_collections: [SnapshotRegionFilterCollection; 4]) -> SnapshotRegionScanResults
    {
        (SnapshotRegionScanResults {
                collection_count: collection_count,
                snapshot_region_filter_collections: snapshot_region_filter_collections,
            })
    }
}

pub machine SnapshotRegionScanResults::empty() -> SnapshotRegionScanResults {
    SnapshotRegionScanResults { collection_count: 0 }
}

pub machine SnapshotRegionScanResults::clone(source: &SnapshotRegionScanResults) -> SnapshotRegionScanResults {
    let mut results: SnapshotRegionScanResults = SnapshotRegionScanResults::empty();
    SnapshotRegionScanResults::clone_from(&mut results, source);
    results
}

pub machine SnapshotRegionScanResults::clone_from(snapshot_region_scan_results: &mut SnapshotRegionScanResults, source: &SnapshotRegionScanResults) {
    snapshot_region_scan_results.collection_count = source.collection_count;
    SnapshotRegionScanResults::copy_collections(snapshot_region_scan_results, source, 0);
}

machine SnapshotRegionScanResults::copy_collections(snapshot_region_scan_results: &mut SnapshotRegionScanResults, source: &SnapshotRegionScanResults, position: u64) {
    transition position < source.collection_count && position < 4 {
        true -> copy(snapshot_region_scan_results, source, position)
        false -> done(snapshot_region_scan_results)
    }
    state copy(snapshot_region_scan_results: &mut SnapshotRegionScanResults, source: &SnapshotRegionScanResults, position: u64) {
        SnapshotRegionFilterCollection::clone_from(&mut snapshot_region_scan_results.snapshot_region_filter_collections[position], 
            &source.snapshot_region_filter_collections[position]);
        transition { _ -> SnapshotRegionScanResults::copy_collections(snapshot_region_scan_results, source, position + 1) }
    }
    state done(snapshot_region_scan_results: &mut SnapshotRegionScanResults) {
        snapshot_region_scan_results.collection_count = snapshot_region_scan_results.collection_count;
    }
}

pub machine SnapshotRegionScanResults::get_collection_count(snapshot_region_scan_results: &SnapshotRegionScanResults) -> u64 {
    snapshot_region_scan_results.collection_count
}

// Upstream `get_filter_collections()` — indexed access over the flat set.
pub machine SnapshotRegionScanResults::get_filter_collection(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    collection_index: u64
) -> SnapshotRegionFilterCollection {
    transition collection_index < snapshot_region_scan_results.collection_count && collection_index < 4 {
        true -> arm_result_92_0(snapshot_region_scan_results, collection_index)
        false -> (SnapshotRegionFilterCollection::empty(
            DataTypeRef::default(),
            MemoryAlignment::Alignment1,
            0))
    }
    state arm_result_92_0(snapshot_region_scan_results: &SnapshotRegionScanResults, collection_index: u64) -> SnapshotRegionFilterCollection
    
    requires collection_index < snapshot_region_scan_results.collection_count && collection_index < 4;
{
        // Upstream `Vec::index` + the derived Clone — a fresh copy of the
        // element. The element borrow must come from a bound param, not
        // self-index under a &self state, so the copy rides clone into a
        // fresh local like fill's store state.
        let collection: SnapshotRegionFilterCollection =
            SnapshotRegionFilterCollection::clone(&snapshot_region_scan_results.snapshot_region_filter_collections[collection_index]);
        (collection)
    }
}

// Replace one collection (the element scanner writes narrowed results back).
pub machine SnapshotRegionScanResults::set_filter_collection(
    snapshot_region_scan_results: &mut SnapshotRegionScanResults,
    collection_index: u64,
    collection: &SnapshotRegionFilterCollection
) {
    transition collection_index < snapshot_region_scan_results.collection_count && collection_index < 4 {
        true -> store(snapshot_region_scan_results, collection_index, collection)
        false -> done(snapshot_region_scan_results)
    }
    state store(snapshot_region_scan_results: &mut SnapshotRegionScanResults, collection_index: u64, collection: &SnapshotRegionFilterCollection) {
        SnapshotRegionFilterCollection::clone_from(&mut snapshot_region_scan_results.snapshot_region_filter_collections[collection_index], collection);
        snapshot_region_scan_results.collection_count = snapshot_region_scan_results.collection_count;
    }
    state done(snapshot_region_scan_results: &mut SnapshotRegionScanResults) {
        snapshot_region_scan_results.collection_count = snapshot_region_scan_results.collection_count;
    }
}

// Push a new collection (initialize_scan_results seeds one per data type).
pub machine SnapshotRegionScanResults::push_collection(
    snapshot_region_scan_results: &mut SnapshotRegionScanResults,
    collection: &SnapshotRegionFilterCollection
) -> bool {
    transition snapshot_region_scan_results.collection_count < 4 {
        true -> push(snapshot_region_scan_results, collection)
        false -> (false)
    }
    state push(snapshot_region_scan_results: &mut SnapshotRegionScanResults, collection: &SnapshotRegionFilterCollection) -> bool {
        SnapshotRegionFilterCollection::clone_from(&mut snapshot_region_scan_results.snapshot_region_filter_collections[snapshot_region_scan_results.collection_count], collection);
        snapshot_region_scan_results.collection_count = snapshot_region_scan_results.collection_count + 1;
        true
    }
}

// Upstream `get_number_of_results` — total across collections.
pub machine SnapshotRegionScanResults::get_number_of_results(snapshot_region_scan_results: &SnapshotRegionScanResults) -> u64
crashes Abort
{
    transition { _ -> total(snapshot_region_scan_results, 0, 0) }
    state total(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, count: u64) -> u64 {
        transition position < snapshot_region_scan_results.collection_count && position < 4 {
            true -> add(snapshot_region_scan_results, position, count)
            false -> (count)
        }
    }
    state add(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, count: u64) -> u64 {
        let collection: SnapshotRegionFilterCollection =
            SnapshotRegionFilterCollection::clone(&snapshot_region_scan_results.snapshot_region_filter_collections[position]);
        transition { _ -> total(snapshot_region_scan_results, position + 1, ((count as u64 in Saturating) + (SnapshotRegionFilterCollection::get_number_of_results(&collection) as u64 in Saturating)) as u64) }
    }
}

// Upstream `get_result_counts_by_data_type` — one ScanResultDataTypeCount
// per collection.
pub machine SnapshotRegionScanResults::get_result_counts_by_data_type(
    snapshot_region_scan_results: &SnapshotRegionScanResults
) -> DataTypeResultCounts
crashes Abort
{
    let mut counts: DataTypeResultCounts = DataTypeResultCounts { count: 0 };
    DataTypeResultCounts::fill(&mut counts, snapshot_region_scan_results, 0);
    counts
}

pub data DataTypeResultCounts {
    counts: [ScanResultDataTypeCount; 4];
    count: u64;
}

machine DataTypeResultCounts::fill(data_type_result_counts: &mut DataTypeResultCounts, source: &SnapshotRegionScanResults, position: u64)
crashes Abort
{
    transition position < source.collection_count && position < 4 {
        true -> store(data_type_result_counts, source, position)
        false -> done(data_type_result_counts)
    }
    state store(data_type_result_counts: &mut DataTypeResultCounts, source: &SnapshotRegionScanResults, position: u64)
        requires 0 <= position && position < 4
    {
        let collection: SnapshotRegionFilterCollection =
            SnapshotRegionFilterCollection::clone(&source.snapshot_region_filter_collections[position]);
        DataTypeRef::clone_from(&mut data_type_result_counts.counts[position].data_type_ref, &collection.data_type_ref);
        data_type_result_counts.counts[position].count = SnapshotRegionFilterCollection::get_number_of_results(&collection);
        data_type_result_counts.count = position + 1;
        transition { _ -> DataTypeResultCounts::fill(data_type_result_counts, source, position + 1) }
    }
    state done(data_type_result_counts: &mut DataTypeResultCounts) {
        data_type_result_counts.count = data_type_result_counts.count;
    }
}

pub machine DataTypeResultCounts::get_count(data_type_result_counts: &DataTypeResultCounts) -> u64 {
    data_type_result_counts.count
}

pub machine DataTypeResultCounts::get(data_type_result_counts: &DataTypeResultCounts, position: u64) -> ScanResultDataTypeCount {
    transition position < data_type_result_counts.count && position < 4 {
        true -> arm_result_198_0(data_type_result_counts, position)
        false -> (ScanResultDataTypeCount::default())
    }
    state arm_result_198_0(data_type_result_counts: &DataTypeResultCounts, position: u64) -> ScanResultDataTypeCount
    
    requires position < data_type_result_counts.count && position < 4;
{
        // Same upstream Vec-index clone as get_filter_collection — the
        // copy materializes through clone into a fresh local.
        let element: ScanResultDataTypeCount =
            ScanResultDataTypeCount::clone(&data_type_result_counts.counts[position]);
        (element)
    }
}

// Upstream `get_number_of_results_for_data_types` — total over the selected
// data types only (empty filter set = all types selected).
pub machine SnapshotRegionScanResults::get_number_of_results_for_data_types(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    filtered_data_types: &[DataTypeRef],
    filtered_data_type_count: u64
) -> u64
crashes Abort
{
    transition { _ -> total(snapshot_region_scan_results, 0, 0, filtered_data_types, filtered_data_type_count) }
    state total(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, count: u64, filtered_data_types: &[DataTypeRef], filtered_data_type_count: u64) -> u64 {
        transition position < snapshot_region_scan_results.collection_count && position < 4 {
            true -> add(snapshot_region_scan_results, position, count, filtered_data_types, filtered_data_type_count)
            false -> (count)
        }
    }
    state add(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, count: u64, filtered_data_types: &[DataTypeRef], filtered_data_type_count: u64) -> u64 {
        let collection: SnapshotRegionFilterCollection =
            SnapshotRegionFilterCollection::clone(&snapshot_region_scan_results.snapshot_region_filter_collections[position]);
        let selected: bool = is_data_type_selected(&collection.data_type_ref, filtered_data_types, filtered_data_type_count);
        transition selected {
            true -> total(snapshot_region_scan_results, position + 1, ((count as u64 in Saturating) + (SnapshotRegionFilterCollection::get_number_of_results(&collection) as u64 in Saturating)) as u64, filtered_data_types, filtered_data_type_count)
            false -> total(snapshot_region_scan_results, position + 1, count, filtered_data_types, filtered_data_type_count)
        }
    }
}

// Upstream `is_data_type_selected`: an empty filter list selects every type;
// otherwise the collection's own data type must appear.
pub machine is_data_type_selected(
    data_type_ref: &DataTypeRef,
    filtered_data_types: &[DataTypeRef],
    filtered_data_type_count: u64
) -> bool {
    transition filtered_data_type_count == 0 {
        true -> (true)
        false -> scan(data_type_ref, filtered_data_types, filtered_data_type_count, 0)
    }
    state scan(data_type_ref: &DataTypeRef, filtered_data_types: &[DataTypeRef], filtered_data_type_count: u64, position: u64) -> bool {
        transition position < filtered_data_type_count && position < filtered_data_types.len {
            true -> compare(data_type_ref, filtered_data_types, filtered_data_type_count, position)
            false -> (false)
        }
    }
    state compare(data_type_ref: &DataTypeRef, filtered_data_types: &[DataTypeRef], filtered_data_type_count: u64, position: u64) -> bool {
        transition DataTypeRef::equals(data_type_ref, &filtered_data_types[position]) {
            true -> (true)
            false -> scan(data_type_ref, filtered_data_types, filtered_data_type_count, position + 1)
        }
    }
}

// Result merge cursor — where one collection's enumeration stands. Upstream
// ScanResultsPageCursor holds the same (collection, filter, element offset)
// triple behind its heap entries; `finished` mirrors the iterator returning
// None.
pub data ResultCursor {
    finished: bool;
    collection_index: u64;
    filter_index: u64;
    element_index: u64;
    // Upstream `ScanResultsPageCursor::is_selected` — set when the cursor's
    // collection survives the page's data-type filter. `enumerate_page`
    // only seeds selected cursors; `enumerate_page_deleted` seeds every
    // non-empty collection and reads this flag per merged element, exactly
    // as upstream's deleted-aware merge does.
    selected: bool;
}

pub machine ResultCursor::active(collection_index: u64, selected: bool) -> ResultCursor {
    ResultCursor {
        finished: false,
        collection_index: collection_index,
        filter_index: 0,
        element_index: 0,
        selected: selected,
    }
}

pub machine ResultCursor::finished(collection_index: u64) -> ResultCursor {
    ResultCursor {
        finished: true,
        collection_index: collection_index,
        filter_index: 0,
        element_index: 0,
        selected: false,
    }
}

pub machine ResultCursor::clone(source: &ResultCursor) -> ResultCursor {
    ResultCursor {
        finished: source.finished,
        collection_index: source.collection_index,
        filter_index: source.filter_index,
        element_index: source.element_index,
        selected: source.selected,
    }
}

pub machine ResultCursor::clone_from(result_cursor: &mut ResultCursor, source: &ResultCursor) {
    result_cursor.finished = source.finished;
    result_cursor.collection_index = source.collection_index;
    result_cursor.filter_index = source.filter_index;
    result_cursor.element_index = source.element_index;
    result_cursor.selected = source.selected;
}

// Bounded cursor set — one entry per collection slot (MAX_COLLECTIONS = 4).
pub data MergeCursors {
    cursors: [ResultCursor; 4];
}

pub machine MergeCursors::unfinished() -> MergeCursors {
    transition { _ -> fill(MergeCursors {}, 0) }
    state fill(out: MergeCursors, position: u64) -> MergeCursors {
        transition position < 4 {
            true -> store(out, position)
            false -> (out)
        }
    }
    state store(out: MergeCursors, position: u64) -> MergeCursors
        requires 0 <= position && position < 4
    {
        let mut carried: MergeCursors = out;
        carried.cursors[position] = ResultCursor::active(position, false);
        transition { _ -> fill(carried, position + 1) }
    }
}

pub machine MergeCursors::get_cursor(merge_cursors: &MergeCursors, cursor_index: u64) -> ResultCursor {
    transition cursor_index < 4 {
        true -> arm_result_334_0(merge_cursors, cursor_index)
        false -> (ResultCursor::finished(0))
    }
    state arm_result_334_0(merge_cursors: &MergeCursors, cursor_index: u64) -> ResultCursor
    requires cursor_index < 4;
    {
        (ResultCursor::clone(&merge_cursors.cursors[cursor_index]))
    }
}

pub machine MergeCursors::set_cursor(merge_cursors: &mut MergeCursors, cursor_index: u64, cursor: &ResultCursor) {
    transition cursor_index < 4 {
        true -> store(merge_cursors, cursor_index, cursor)
        false -> done(merge_cursors)
    }
    state store(merge_cursors: &mut MergeCursors, cursor_index: u64, cursor: &ResultCursor)
        requires 0 <= cursor_index && cursor_index < 4
    {
        ResultCursor::clone_from(&mut merge_cursors.cursors[cursor_index], cursor);
    }
    state done(merge_cursors: &mut MergeCursors) {
        merge_cursors.cursors = merge_cursors.cursors;
    }
}

// One candidate address in the merge — upstream's `Reverse((address, index))`
// heap entries.
pub data CursorProbe {
    active: bool;
    owner: u64;
    address: u64;
}

pub machine CursorProbe::inactive() -> CursorProbe {
    CursorProbe { active: false, owner: 0, address: 0 }
}

// The smaller live probe wins; ties fall to the lower collection slot.
pub machine CursorProbe::smaller(a: &CursorProbe, b: &CursorProbe) -> CursorProbe {
    transition a.active && b.active {
        true -> both(a, b)
        false -> either(a, b)
    }
    state both(a: &CursorProbe, b: &CursorProbe) -> CursorProbe {
        transition b.address < a.address {
            true -> arm_result_374_0(b, a)
            false -> (CursorProbe { active: true, owner: a.owner, address: a.address })
        }
    }
    state either(a: &CursorProbe, b: &CursorProbe) -> CursorProbe {
        transition a.active {
            true -> arm_result_380_0(a)
            false -> (CursorProbe { active: b.active, owner: b.owner, address: b.address })
        }
    }
    state arm_result_374_0(b: &CursorProbe, a: &CursorProbe) -> CursorProbe
    {
        (CursorProbe { active: true, owner: b.owner, address: b.address })
    }
    state arm_result_380_0(a: &CursorProbe) -> CursorProbe
    {
        (CursorProbe { active: true, owner: a.owner, address: a.address })
    }
}

// One enumerated page element — upstream materializes a ScanResult here; the
// port keeps the merge-visible fields and lets the executor materialize the
// current/previous values from the owning region's element windows.
pub data PageElement {
    address: u64;
    collection_index: u64;
    filter_index: u64;
    element_index: u64;
    data_type_ref: DataTypeRef;
}

pub machine PageElement::of(
    address: u64,
    collection_index: u64,
    filter_index: u64,
    element_index: u64,
    data_type_ref: DataTypeRef
) -> PageElement {
    PageElement {
        address: address,
        collection_index: collection_index,
        filter_index: filter_index,
        element_index: element_index,
        data_type_ref: data_type_ref,
    }
}

// Page results buffer — bounded at 64 (the CLI page surface is 22; extra
// results on the final page drop off, a named deviation from Vec growth).
pub data PageElementList {
    page_elements: [PageElement; 64];
    element_count: u64;
}

pub machine PageElementList::empty() -> PageElementList {
    // Zero-init — element slots are dead until insert_sorted writes them.
    PageElementList { element_count: 0 }
}

pub machine PageElementList::get_element_count(page_element_list: &PageElementList) -> u64 {
    page_element_list.element_count
}

pub machine PageElementList::clone(source: &PageElementList) -> PageElementList {
    let mut copy: PageElementList = PageElementList::empty();
    PageElementList::copy_from(&mut copy, source);
    copy
}

machine PageElementList::copy_from(page_element_list: &mut PageElementList, source: &PageElementList) {
    page_element_list.element_count = source.element_count;
    transition { _ -> copy(page_element_list, source, 0) }
    state copy(page_element_list: &mut PageElementList, source: &PageElementList, position: u64) {
        transition position < source.element_count && position < 64 {
            true -> store(page_element_list, source, position)
            false -> done(page_element_list)
        }
    }
    state store(page_element_list: &mut PageElementList, source: &PageElementList, position: u64)
        requires 0 <= position && position < 64
    {
        PageElement::clone_from(&mut page_element_list.page_elements[position], &source.page_elements[position]);
        transition { _ -> copy(page_element_list, source, position + 1) }
    }
    state done(page_element_list: &mut PageElementList) {
        page_element_list.element_count = page_element_list.element_count;
    }
}

pub machine PageElementList::get_page_element(page_element_list: &PageElementList, element_index: u64) -> PageElement {
    transition element_index < page_element_list.element_count && element_index < 64 {
        true -> found(page_element_list, element_index)
        false -> empty(page_element_list)
    }
    state found(page_element_list: &PageElementList, element_index: u64) -> PageElement
        requires 0 <= element_index && element_index < 64
    {
        let mut page_element: PageElement = PageElement::of(0, 0, 0, 0, DataTypeRef::default());
        PageElement::clone_from(&mut page_element, &page_element_list.page_elements[element_index]);
        page_element
    }
    state empty(page_element_list: &PageElementList) -> PageElement {
        PageElement::of(0, 0, 0, 0, DataTypeRef::default())
    }
}

pub machine PageElementList::push(page_element_list: &mut PageElementList, page_element: &PageElement) -> bool {
    transition page_element_list.element_count < 64 {
        true -> store(page_element_list, page_element)
        false -> (false)
    }
    state store(page_element_list: &mut PageElementList, page_element: &PageElement) -> bool {
        PageElement::clone_from(&mut page_element_list.page_elements[page_element_list.element_count], page_element);
        page_element_list.element_count = page_element_list.element_count + 1;
        true
    }
}

pub machine PageElement::clone_from(page_element: &mut PageElement, source: &PageElement) {
    page_element.address = source.address;
    page_element.collection_index = source.collection_index;
    page_element.filter_index = source.filter_index;
    page_element.element_index = source.element_index;
    DataTypeRef::clone_from(&mut page_element.data_type_ref, &source.data_type_ref);
}

// The address a live cursor would emit next — upstream's
// `ScanResultsPageCursor::get_current_address` = filter base + element
// offset * stride, where stride is `max(memory_alignment, 1)`.
pub machine SnapshotRegionScanResults::probe_cursor(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    cursor: &ResultCursor
) -> CursorProbe {
    transition cursor.finished {
        true -> arm_result_500_0(cursor)
        false -> bound_collection(snapshot_region_scan_results, cursor)
    }
    state bound_collection(snapshot_region_scan_results: &SnapshotRegionScanResults, cursor: &ResultCursor) -> CursorProbe {
        transition cursor.collection_index < snapshot_region_scan_results.collection_count && cursor.collection_index < 4 {
            true -> bound_filter(snapshot_region_scan_results, cursor, cursor.collection_index)
            false -> (CursorProbe::inactive())
        }
    }
    state bound_filter(snapshot_region_scan_results: &SnapshotRegionScanResults, cursor: &ResultCursor, collection_index: u64) -> CursorProbe
        requires 0 <= collection_index && collection_index < 4
    {
        let collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::clone(
            &snapshot_region_scan_results.snapshot_region_filter_collections[collection_index]);
        transition cursor.filter_index < collection.filter_count && cursor.filter_index < 64 {
            true -> locate(snapshot_region_scan_results, &collection, cursor.filter_index, cursor.element_index, collection_index)
            false -> (CursorProbe::inactive())
        }
    }
    state locate(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        collection: &SnapshotRegionFilterCollection,
        filter_index: u64,
        element_index: u64,
        owner: u64
    ) -> CursorProbe
        requires 0 <= filter_index && filter_index < 64
    {
        let filter: SnapshotRegionFilter = SnapshotRegionFilterCollection::get_filter(collection, filter_index);
        let stride: u64 = MemoryAlignment::get_size_in_bytes(&collection.memory_alignment);
        let address: u64 = ((SnapshotRegionFilter::get_base_address(&filter) as u64 in Wrapping)
            + ((element_index as u64 in Wrapping) * (stride as u64 in Wrapping))) as u64;
        transition { _ -> (CursorProbe { active: true, owner: owner, address: address }) }
    }
    state arm_result_500_0(cursor: &ResultCursor) -> CursorProbe
    {
        (CursorProbe::inactive())
    }
}

// Upstream `advance_results(1)`: step the element offset inside the current
// filter, rolling to the next filter when its element count is spent, and to
// finished when the collection's filters are spent.
machine SnapshotRegionScanResults::advance_cursor(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    cursors: &mut MergeCursors,
    owner: u64
)
crashes Abort
{
    transition owner < 4 {
        true -> bound(snapshot_region_scan_results, cursors, owner)
        false -> done(snapshot_region_scan_results)
    }
    state bound(snapshot_region_scan_results: &SnapshotRegionScanResults, cursors: &mut MergeCursors, owner: u64)
        requires 0 <= owner && owner < 4
    {
        let cursor: ResultCursor = MergeCursors::get_cursor(cursors, owner);
        let collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::clone(
            &snapshot_region_scan_results.snapshot_region_filter_collections[owner]);
        transition cursor.filter_index < collection.filter_count && cursor.filter_index < 64 {
            true -> within(snapshot_region_scan_results, &collection, cursors, owner, cursor)
            false -> finish(snapshot_region_scan_results, cursors, owner, cursor)
        }
    }
    state within(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        collection: &SnapshotRegionFilterCollection,
        cursors: &mut MergeCursors,
        owner: u64,
        cursor: ResultCursor
    ) {
        let filter: SnapshotRegionFilter = SnapshotRegionFilterCollection::get_filter(collection, cursor.filter_index);
        let elements: u64 = SnapshotRegionFilter::get_element_count(&filter, 
            collection.result_value_size_in_bytes,
            collection.memory_alignment);
        let next_element: u64 = ((cursor.element_index as u64 in Wrapping) + 1) as u64;
        transition next_element < elements {
            true -> bump_element(snapshot_region_scan_results, cursors, owner, cursor, next_element)
            false -> bump_filter(snapshot_region_scan_results, collection, cursors, owner, cursor)
        }
    }
    state bump_element(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        cursors: &mut MergeCursors,
        owner: u64,
        cursor: ResultCursor,
        next_element: u64
    ) {
        let mut updated: ResultCursor = ResultCursor::clone(&cursor);
        updated.element_index = next_element;
        MergeCursors::set_cursor(cursors, owner, &updated);
    }
    state bump_filter(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        collection: &SnapshotRegionFilterCollection,
        cursors: &mut MergeCursors,
        owner: u64,
        cursor: ResultCursor
    ) {
        let next_filter: u64 = ((cursor.filter_index as u64 in Wrapping) + 1) as u64;
        transition next_filter < collection.filter_count {
            true -> next_filter(snapshot_region_scan_results, cursors, owner, cursor, next_filter)
            false -> finish(snapshot_region_scan_results, cursors, owner, cursor)
        }
    }
    state next_filter(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        cursors: &mut MergeCursors,
        owner: u64,
        cursor: ResultCursor,
        next_filter: u64
    ) {
        let mut updated: ResultCursor = ResultCursor::clone(&cursor);
        updated.filter_index = next_filter;
        updated.element_index = 0;
        MergeCursors::set_cursor(cursors, owner, &updated);
    }
    state finish(snapshot_region_scan_results: &SnapshotRegionScanResults, cursors: &mut MergeCursors, owner: u64, cursor: ResultCursor) {
        let mut updated: ResultCursor = ResultCursor::clone(&cursor);
        updated.finished = true;
        MergeCursors::set_cursor(cursors, owner, &updated);
    }
    state done(snapshot_region_scan_results: &SnapshotRegionScanResults) {
    }
}

// Whether the collection's data type survives the filter list — set-scoped
// version of `is_data_type_selected`.
pub machine SnapshotRegionScanResults::is_data_type_in_set(
    data_type_ref: &DataTypeRef,
    filtered_data_types: &DataTypeRefSet
) -> bool {
    transition filtered_data_types.count == 0 {
        true -> (true)
        false -> scan(data_type_ref, filtered_data_types, 0)
    }
    state scan(data_type_ref: &DataTypeRef, filtered_data_types: &DataTypeRefSet, position: u64) -> bool {
        transition position < filtered_data_types.count && position < 4 {
            true -> compare(data_type_ref, filtered_data_types, position)
            false -> (false)
        }
    }
    state compare(data_type_ref: &DataTypeRef, filtered_data_types: &DataTypeRefSet, position: u64) -> bool
        requires 0 <= position && position < 4
    {
        transition DataTypeRef::equals(data_type_ref, &filtered_data_types.data_type_refs[position]) {
            true -> (true)
            false -> again(data_type_ref, filtered_data_types, position)
            _ -> (false)
        }
    }
    state again(data_type_ref: &DataTypeRef, filtered_data_types: &DataTypeRefSet, position: u64) -> bool {
        transition { _ -> scan(data_type_ref, filtered_data_types, position + 1) }
    }
}

// Upstream `get_scan_results_page`'s cursor merge: seed one cursor per
// selected non-empty collection, then repeatedly take the smallest live
// address — upstream pops a BinaryHeap; the port picks the smallest of the
// four bounded probes, which yields the same ascending-address order.
pub machine SnapshotRegionScanResults::enumerate_page(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    results_to_skip: u64,
    page_size: u64,
    filtered_data_types: &DataTypeRefSet
) -> PageElementList
crashes Abort
{
    let mut page: PageElementList = PageElementList::empty();
    let mut cursors: MergeCursors = MergeCursors::unfinished();
    transition { _ -> seed(snapshot_region_scan_results, 0, &mut cursors, filtered_data_types, results_to_skip, page_size, &mut page) }
    state seed(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        position: u64,
        cursors: &mut MergeCursors,
        filtered_data_types: &DataTypeRefSet,
        skip: u64,
        take: u64,
        page: &mut PageElementList
    ) -> PageElementList {
        transition position < snapshot_region_scan_results.collection_count && position < 4 {
            true -> seed_one(snapshot_region_scan_results, position, cursors, filtered_data_types, skip, take, page)
            false -> step(snapshot_region_scan_results, cursors, filtered_data_types, skip, take, page)
        }
    }
    state seed_one(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        position: u64,
        cursors: &mut MergeCursors,
        filtered_data_types: &DataTypeRefSet,
        skip: u64,
        take: u64,
        page: &mut PageElementList
    ) -> PageElementList
        requires 0 <= position && position < 4
    {
        let collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::clone(
            &snapshot_region_scan_results.snapshot_region_filter_collections[position]);
        let selected: bool = SnapshotRegionScanResults::is_data_type_in_set(
            &collection.data_type_ref, filtered_data_types);
        transition selected && collection.filter_count > 0 {
            true -> activate(snapshot_region_scan_results, position, selected, cursors, filtered_data_types, skip, take, page)
            false -> seed(snapshot_region_scan_results, position + 1, cursors, filtered_data_types, skip, take, page)
        }
    }
    state activate(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        position: u64,
        selected: bool,
        cursors: &mut MergeCursors,
        filtered_data_types: &DataTypeRefSet,
        skip: u64,
        take: u64,
        page: &mut PageElementList
    ) -> PageElementList
        requires 0 <= position && position < 4
    {
        let cursor: ResultCursor = ResultCursor::active(position, selected);
        MergeCursors::set_cursor(cursors, position, &cursor);
        transition { _ -> seed(snapshot_region_scan_results, position + 1, cursors, filtered_data_types, skip, take, page) }
    }
    state step(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        cursors: &mut MergeCursors,
        filtered_data_types: &DataTypeRefSet,
        skip: u64,
        take: u64,
        page: &mut PageElementList
    ) -> PageElementList {
        transition take > 0 {
            true -> probe(snapshot_region_scan_results, cursors, filtered_data_types, skip, take, page)
            false -> (PageElementList::clone(&mut page))
        }
    }
    state probe(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        cursors: &mut MergeCursors,
        filtered_data_types: &DataTypeRefSet,
        skip: u64,
        take: u64,
        page: &mut PageElementList
    ) -> PageElementList {
        let c0: ResultCursor = MergeCursors::get_cursor(cursors, 0);
        let c1: ResultCursor = MergeCursors::get_cursor(cursors, 1);
        let c2: ResultCursor = MergeCursors::get_cursor(cursors, 2);
        let c3: ResultCursor = MergeCursors::get_cursor(cursors, 3);
        let p0: CursorProbe = SnapshotRegionScanResults::probe_cursor(snapshot_region_scan_results, &c0);
        let p1: CursorProbe = SnapshotRegionScanResults::probe_cursor(snapshot_region_scan_results, &c1);
        let p2: CursorProbe = SnapshotRegionScanResults::probe_cursor(snapshot_region_scan_results, &c2);
        let p3: CursorProbe = SnapshotRegionScanResults::probe_cursor(snapshot_region_scan_results, &c3);
        let m01: CursorProbe = CursorProbe::smaller(&p0, &p1);
        let m23: CursorProbe = CursorProbe::smaller(&p2, &p3);
        let best: CursorProbe = CursorProbe::smaller(&m01, &m23);
        transition best.active {
            true -> emit(snapshot_region_scan_results, best, cursors, filtered_data_types, skip, take, page)
            false -> (PageElementList::clone(&mut page))
        }
    }
    state emit(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        best: CursorProbe,
        cursors: &mut MergeCursors,
        filtered_data_types: &DataTypeRefSet,
        skip: u64,
        take: u64,
        page: &mut PageElementList
    ) -> PageElementList {
        transition skip > 0 {
            true -> advance_skip(snapshot_region_scan_results, best, cursors, filtered_data_types, skip, take, page)
            false -> emit_element(snapshot_region_scan_results, best, cursors, filtered_data_types, take, page)
        }
    }
    state advance_skip(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        best: CursorProbe,
        cursors: &mut MergeCursors,
        filtered_data_types: &DataTypeRefSet,
        skip: u64,
        take: u64,
        page: &mut PageElementList
    ) -> PageElementList {
        SnapshotRegionScanResults::advance_cursor(snapshot_region_scan_results, &mut cursors, best.owner);
        transition { _ -> step(snapshot_region_scan_results, cursors, filtered_data_types, ((skip as u64 in Wrapping) - 1) as u64, take, &mut page) }
    }
    state emit_element(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        best: CursorProbe,
        cursors: &mut MergeCursors,
        filtered_data_types: &DataTypeRefSet,
        take: u64,
        page: &mut PageElementList
    ) -> PageElementList {
        transition best.owner < snapshot_region_scan_results.collection_count && best.owner < 4 {
            true -> store_element(snapshot_region_scan_results, best, best.owner, cursors, filtered_data_types, take, page)
            false -> step(snapshot_region_scan_results, cursors, filtered_data_types, 0, take, page)
        }
    }
    state store_element(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        best: CursorProbe,
        owner: u64,
        cursors: &mut MergeCursors,
        filtered_data_types: &DataTypeRefSet,
        take: u64,
        page: &mut PageElementList
    ) -> PageElementList
        requires 0 <= owner && owner < 4
    {
        let collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::clone(
            &snapshot_region_scan_results.snapshot_region_filter_collections[owner]);
        let cursor: ResultCursor = MergeCursors::get_cursor(cursors, best.owner);
        let page_element: PageElement = PageElement::of(
            best.address,
            best.owner,
            cursor.filter_index,
            cursor.element_index,
            DataTypeRef::clone(&collection.data_type_ref));
        let pushed: bool = PageElementList::push(page, &page_element);
        SnapshotRegionScanResults::advance_cursor(snapshot_region_scan_results, &mut cursors, best.owner);
        transition pushed {
            true -> step(snapshot_region_scan_results, cursors, filtered_data_types, 0, ((take as u64 in Wrapping) - 1) as u64, &mut page)
            false -> step(snapshot_region_scan_results, cursors, filtered_data_types, 0, 0, page)
            _ -> (PageElementList::clone(&mut page))
        }
    }
}

// Address-sorted insertion — upstream's BinaryHeap ordering kept on the
// bounded page carrier. Shifts elements down to open the slot; the bound
// truncates past-capacity inserts (named deviation).
pub machine PageElementList::insert_sorted(page_element_list: &mut PageElementList, page_element: &PageElement) -> bool {
    transition page_element_list.element_count < 64 {
        true -> seek(page_element_list, page_element, 0)
        false -> (false)
    }
    state seek(page_element_list: &mut PageElementList, page_element: &PageElement, position: u64) -> bool {
        transition position < page_element_list.element_count && position < 64 {
            true -> compare(page_element_list, page_element, position)
            false -> store(page_element_list, page_element, position)
        }
    }
    state compare(page_element_list: &mut PageElementList, page_element: &PageElement, position: u64) -> bool
        requires 0 <= position && position < 64
    {
        transition page_element_list.page_elements[position].address < page_element.address {
            true -> seek(page_element_list, page_element, position + 1)
            false -> store(page_element_list, page_element, position)
        }
    }
    // Shift the tail down one slot starting from the back, then write.
    state store(page_element_list: &mut PageElementList, page_element: &PageElement, position: u64) -> bool {
        PageElementList::shift_down(page_element_list, page_element_list.element_count, position);
        transition position < 64 {
            true -> write(page_element_list, page_element, position)
            false -> (false)
        }
    }
    state write(page_element_list: &mut PageElementList, page_element: &PageElement, position: u64) -> bool
        requires 0 <= position && position < 64
    {
        PageElement::clone_from(&mut page_element_list.page_elements[position], page_element);
        page_element_list.element_count = ((page_element_list.element_count as u64 in Wrapping) + 1) as u64;
        true
    }
}

// `insert_sorted`'s tail shift: copy `page_elements[prior]` up to
// `page_elements[prior+1]` while `prior >= low`. `at` enters at
// `element_count` ≤ 63 (proven by the insert guard), so `at < 64` holds.
pub machine PageElementList::shift_down(page_element_list: &mut PageElementList, at: u64, low: u64) {
    transition at > low && at > 0 && at < 64 {
        true -> step(page_element_list, at, low)
        false -> done(page_element_list)
        _ -> done(page_element_list)
    }
    state step(page_element_list: &mut PageElementList, at: u64, low: u64)
        requires 0 <= at && at < 64
    {
        let prior: u64 = ((at as u64 in Wrapping) - 1) as u64;
        transition { _ -> copy_slot(page_element_list, prior, at, low) }
    }
    state copy_slot(page_element_list: &mut PageElementList, prior: u64, at: u64, low: u64)
        requires 0 <= at && at < 64
    {
        transition prior < 64 {
            true -> write_slot(page_element_list, prior, at, low)
            false -> done(page_element_list)
        }
    }
    state write_slot(page_element_list: &mut PageElementList, prior: u64, at: u64, low: u64)
        requires 0 <= prior && prior < 64 && 0 <= at && at < 64
    {
        let element: PageElement = PageElement::clone(&page_element_list.page_elements[prior]);
        PageElement::clone_from(&mut page_element_list.page_elements[at], &element);
        transition { _ -> PageElementList::shift_down(page_element_list, prior, low) }
    }
    state done(page_element_list: &mut PageElementList) {
        page_element_list.element_count = page_element_list.element_count;
    }
}

pub machine PageElement::clone(source: &PageElement) -> PageElement {
    let mut copy: PageElement = PageElement::of(0, 0, 0, 0, DataTypeRef::default());
    PageElement::clone_from(&mut copy, source);
    copy
}

// Upstream response aggregate — fold one region's counts into another.
// Same data type merges counts; new types append (bounded at 4).
pub machine DataTypeResultCounts::merge_from(data_type_result_counts: &mut DataTypeResultCounts, source: &DataTypeResultCounts) {
    transition { _ -> each(data_type_result_counts, source, 0) }
    state each(data_type_result_counts: &mut DataTypeResultCounts, source: &DataTypeResultCounts, position: u64) {
        transition position < source.count && position < 4 {
            true -> merge_one(data_type_result_counts, source, position)
            false -> done(data_type_result_counts)
        }
    }
    state merge_one(data_type_result_counts: &mut DataTypeResultCounts, source: &DataTypeResultCounts, position: u64)
        requires 0 <= position && position < 4
    {
        let entry: ScanResultDataTypeCount = DataTypeResultCounts::get(source, position);
        transition { _ -> seek(data_type_result_counts, &entry, 0) }
    }
    state seek(data_type_result_counts: &mut DataTypeResultCounts, entry: &ScanResultDataTypeCount, position: u64) {
        transition position < data_type_result_counts.count && position < 4 {
            true -> compare(data_type_result_counts, entry, position)
            false -> append(data_type_result_counts, entry)
        }
    }
    state compare(data_type_result_counts: &mut DataTypeResultCounts, entry: &ScanResultDataTypeCount, position: u64)
        requires 0 <= position && position < 4
    {
        transition DataTypeRef::equals(&data_type_result_counts.counts[position].data_type_ref, &entry.data_type_ref) {
            true -> add(data_type_result_counts, entry, position)
            false -> seek(data_type_result_counts, entry, position + 1)
        }
    }
    state add(data_type_result_counts: &mut DataTypeResultCounts, entry: &ScanResultDataTypeCount, position: u64)
        requires 0 <= position && position < 4
    {
        data_type_result_counts.counts[position].count = ((data_type_result_counts.counts[position].count as u64 in Saturating)
            + (entry.count as u64 in Saturating)) as u64;
        transition { _ -> done(data_type_result_counts) }
    }
    state append(data_type_result_counts: &mut DataTypeResultCounts, entry: &ScanResultDataTypeCount) {
        transition data_type_result_counts.count < 4 {
            true -> store(data_type_result_counts, entry)
            false -> done(data_type_result_counts)
        }
    }
    state store(data_type_result_counts: &mut DataTypeResultCounts, entry: &ScanResultDataTypeCount) {
        ScanResultDataTypeCount::clone_from(&mut data_type_result_counts.counts[data_type_result_counts.count], entry);
        data_type_result_counts.count = data_type_result_counts.count + 1;
        transition { _ -> done(data_type_result_counts) }
    }
    state done(data_type_result_counts: &mut DataTypeResultCounts) {
        data_type_result_counts.count = data_type_result_counts.count;
    }
}

pub machine DataTypeResultCounts::empty() -> DataTypeResultCounts {
    DataTypeResultCounts { count: 0 }
}

// ————— Tombstone-aware layer — upstream's deleted-index visibility —————
// Upstream `Snapshot` keeps a `BTreeSet<u64>` of deleted global result
// indices; every count/page API below subtracts or skips the tombstones
// inside this region's global window [base, base + structural count).

// Upstream `get_scan_results_by_data_type` — the Option<&collection> is
// folded to an index sentinel: the collection's own index, or
// `collection_count` when no collection owns the data type.
pub machine SnapshotRegionScanResults::get_scan_results_by_data_type(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    data_type_ref: &DataTypeRef
) -> u64 {
    transition { _ -> seek(snapshot_region_scan_results, 0, data_type_ref) }
    state seek(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, data_type_ref: &DataTypeRef) -> u64 {
        transition position < snapshot_region_scan_results.collection_count && position < 4 {
            true -> compare(snapshot_region_scan_results, position, data_type_ref)
            false -> (snapshot_region_scan_results.collection_count)
        }
    }
    state compare(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, data_type_ref: &DataTypeRef) -> u64
        requires 0 <= position && position < 4
    {
        transition DataTypeRef::equals(&snapshot_region_scan_results.snapshot_region_filter_collections[position].data_type_ref, data_type_ref) {
            true -> (position)
            false -> seek(snapshot_region_scan_results, position + 1, data_type_ref)
        }
    }
}

pub machine SnapshotRegionScanResults::has_scan_results_for_data_type(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    data_type_ref: &DataTypeRef
) -> bool {
    SnapshotRegionScanResults::get_scan_results_by_data_type(snapshot_region_scan_results, data_type_ref) < snapshot_region_scan_results.collection_count
}

// Upstream `get_filter_bounds`: the (lowest, highest) filter addresses
// across every non-empty collection — `resize_to_filters`'s own probe
// (`SnapshotRegion::compute_filter_bounds`) reads the same union.
pub machine SnapshotRegionScanResults::get_filter_bounds(snapshot_region_scan_results: &SnapshotRegionScanResults) -> FilterBounds
crashes Abort
{
    transition { _ -> seek(snapshot_region_scan_results, 0, false, 0, 0) }
    state seek(snapshot_region_scan_results: &SnapshotRegionScanResults, collection_index: u64, has_filters: bool, min_address: u64, max_address: u64) -> FilterBounds {
        transition collection_index < snapshot_region_scan_results.collection_count && collection_index < 4 {
            true -> merge(snapshot_region_scan_results, collection_index, has_filters, min_address, max_address)
            false -> (FilterBounds { has_filters: has_filters, min_address: min_address, max_address: max_address })
        }
    }
    state merge(snapshot_region_scan_results: &SnapshotRegionScanResults, collection_index: u64, has_filters: bool, min_address: u64, max_address: u64) -> FilterBounds
        requires 0 <= collection_index && collection_index < 4
    {
        let collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::clone(
            &snapshot_region_scan_results.snapshot_region_filter_collections[collection_index]);
        transition SnapshotRegionFilterCollection::get_number_of_results(&collection) > 0 {
            true -> include(snapshot_region_scan_results, collection_index, has_filters, min_address, max_address, &collection)
            false -> seek(snapshot_region_scan_results, collection_index + 1, has_filters, min_address, max_address)
        }
    }
    state include(snapshot_region_scan_results: &SnapshotRegionScanResults, collection_index: u64, has_filters: bool, min_address: u64, max_address: u64, collection: &SnapshotRegionFilterCollection) -> FilterBounds
        requires 0 <= collection_index && collection_index < 4
    {
        let lo: u64 = SnapshotRegionFilterCollection::get_filter_minimum_address(collection);
        let hi: u64 = SnapshotRegionFilterCollection::get_filter_maximum_address(collection);
        transition has_filters {
            true -> fold(snapshot_region_scan_results, collection_index, min_address, max_address, lo, hi)
            false -> first(snapshot_region_scan_results, collection_index, lo, hi)
        }
    }
    state first(snapshot_region_scan_results: &SnapshotRegionScanResults, collection_index: u64, lo: u64, hi: u64) -> FilterBounds
        requires 0 <= collection_index && collection_index < 4
    {
        transition { _ -> seek(snapshot_region_scan_results, collection_index + 1, true, lo, hi) }
    }
    state fold(snapshot_region_scan_results: &SnapshotRegionScanResults, collection_index: u64, min_address: u64, max_address: u64, lo: u64, hi: u64) -> FilterBounds
        requires 0 <= collection_index && collection_index < 4
    {
        let next_min: u64 = min(min_address, lo);
        let next_max: u64 = max(max_address, hi);
        transition { _ -> seek(snapshot_region_scan_results, collection_index + 1, true, next_min, next_max) }
    }
}

// Upstream `get_visible_result_count`.
pub machine SnapshotRegionScanResults::get_visible_result_count(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    region_global_scan_result_index_base: u64,
    deleted_scan_result_indices: &DeletedScanResultIndexSet
) -> u64
crashes Abort
{
    transition deleted_scan_result_indices.count == 0 {
        true -> (SnapshotRegionScanResults::get_number_of_results(snapshot_region_scan_results))
        false -> visible(snapshot_region_scan_results, region_global_scan_result_index_base, deleted_scan_result_indices)
    }
    state visible(snapshot_region_scan_results: &SnapshotRegionScanResults, region_global_scan_result_index_base: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet) -> u64 {
        let total: u64 = SnapshotRegionScanResults::get_number_of_results(snapshot_region_scan_results);
        let range_end: u64 = ((region_global_scan_result_index_base as u64 in Saturating)
            + (total as u64 in Saturating)) as u64;
        let tombstones: u64 = DeletedScanResultIndexSet::count_in_range(deleted_scan_result_indices, 
            region_global_scan_result_index_base, range_end);
        ((total as u64 in Saturating) - (tombstones as u64 in Saturating)) as u64
    }
}

// `get_number_of_results_for_data_types` over the bounded Set carrier —
// same loop as the slice-taking sibling (empty set selects everything).
pub machine SnapshotRegionScanResults::get_number_of_results_for_set(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    filtered_data_types: &DataTypeRefSet
) -> u64
crashes Abort
{
    transition { _ -> total(snapshot_region_scan_results, 0, 0, filtered_data_types) }
    state total(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, count: u64, filtered_data_types: &DataTypeRefSet) -> u64 {
        transition position < snapshot_region_scan_results.collection_count && position < 4 {
            true -> add(snapshot_region_scan_results, position, count, filtered_data_types)
            false -> (count)
        }
    }
    state add(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, count: u64, filtered_data_types: &DataTypeRefSet) -> u64
        requires 0 <= position && position < 4
    {
        let collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::clone(
            &snapshot_region_scan_results.snapshot_region_filter_collections[position]);
        let selected: bool = SnapshotRegionScanResults::is_data_type_in_set(
            &collection.data_type_ref, filtered_data_types);
        transition selected {
            true -> total(snapshot_region_scan_results, position + 1,
                ((count as u64 in Saturating) + (SnapshotRegionFilterCollection::get_number_of_results(&collection) as u64 in Saturating)) as u64,
                filtered_data_types)
            false -> total(snapshot_region_scan_results, position + 1, count, filtered_data_types)
        }
    }
}

// Upstream `get_visible_result_count_for_data_types`.
pub machine SnapshotRegionScanResults::get_visible_result_count_for_data_types(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    filtered_data_types: &DataTypeRefSet,
    region_global_scan_result_index_base: u64,
    deleted_scan_result_indices: &DeletedScanResultIndexSet
) -> u64
crashes Abort
{
    transition deleted_scan_result_indices.count == 0 {
        true -> (SnapshotRegionScanResults::get_number_of_results_for_set(snapshot_region_scan_results, filtered_data_types))
        false -> visible(snapshot_region_scan_results, filtered_data_types, region_global_scan_result_index_base, deleted_scan_result_indices)
    }
    state visible(snapshot_region_scan_results: &SnapshotRegionScanResults, filtered_data_types: &DataTypeRefSet, region_global_scan_result_index_base: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet) -> u64 {
        let structural: u64 = SnapshotRegionScanResults::get_number_of_results_for_set(snapshot_region_scan_results, filtered_data_types);
        let tombstoned: u64 = SnapshotRegionScanResults::get_deleted_result_count_for_data_types(snapshot_region_scan_results, 
            filtered_data_types, region_global_scan_result_index_base, deleted_scan_result_indices);
        ((structural as u64 in Saturating) - (tombstoned as u64 in Saturating)) as u64
    }
}

// Upstream `get_deleted_result_count_for_data_types`: for each tombstone in
// this region's global window, the merged-order seek resolves its data
// type; it counts against the total when that type is selected.
pub machine SnapshotRegionScanResults::get_deleted_result_count_for_data_types(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    filtered_data_types: &DataTypeRefSet,
    region_global_scan_result_index_base: u64,
    deleted_scan_result_indices: &DeletedScanResultIndexSet
) -> u64
crashes Abort
{
    transition deleted_scan_result_indices.count == 0 {
        true -> (0)
        false -> begin(snapshot_region_scan_results, filtered_data_types, region_global_scan_result_index_base, deleted_scan_result_indices)
    }
    state begin(snapshot_region_scan_results: &SnapshotRegionScanResults, filtered_data_types: &DataTypeRefSet, region_global_scan_result_index_base: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet) -> u64 {
        let range_end: u64 = ((region_global_scan_result_index_base as u64 in Saturating)
            + (SnapshotRegionScanResults::get_number_of_results(snapshot_region_scan_results) as u64 in Saturating)) as u64;
        transition { _ -> walk(snapshot_region_scan_results, 0, 0, filtered_data_types, region_global_scan_result_index_base, range_end, deleted_scan_result_indices) }
    }
    state walk(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, found: u64, filtered_data_types: &DataTypeRefSet, region_base: u64, range_end: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet) -> u64 {
        transition position < deleted_scan_result_indices.count && position < 64 {
            true -> inspect(snapshot_region_scan_results, position, found, filtered_data_types, region_base, range_end, deleted_scan_result_indices)
            false -> (found)
        }
    }
    state inspect(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, found: u64, filtered_data_types: &DataTypeRefSet, region_base: u64, range_end: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet) -> u64
        requires 0 <= position && position < 64
    {
        let member: u64 = deleted_scan_result_indices.indices[position];
        transition member >= range_end {
            true -> (found)
            false -> inside(snapshot_region_scan_results, position, found, filtered_data_types, region_base, range_end, deleted_scan_result_indices, member)
        }
    }
    state inside(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, found: u64, filtered_data_types: &DataTypeRefSet, region_base: u64, range_end: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet, member: u64) -> u64
        requires 0 <= position && position < 64
    {
        transition member >= region_base {
            true -> locate(snapshot_region_scan_results, position, found, filtered_data_types, region_base, range_end, deleted_scan_result_indices, member)
            false -> walk(snapshot_region_scan_results, position + 1, found, filtered_data_types, region_base, range_end, deleted_scan_result_indices)
        }
    }
    state locate(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, found: u64, filtered_data_types: &DataTypeRefSet, region_base: u64, range_end: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet, member: u64) -> u64
        requires 0 <= position && position < 64
    {
        let local_index: u64 = ((member as u64 in Saturating) - (region_base as u64 in Saturating)) as u64;
        let probe: SoughtElement = SnapshotRegionScanResults::seek_by_local_index(snapshot_region_scan_results, local_index);
        transition probe {
            SoughtElement::Found { element } -> tally(snapshot_region_scan_results, position, found, filtered_data_types, region_base, range_end, deleted_scan_result_indices, element)
            _ -> (found)
        }
    }
    state tally(snapshot_region_scan_results: &SnapshotRegionScanResults, position: u64, found: u64, filtered_data_types: &DataTypeRefSet, region_base: u64, range_end: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet, element: PageElement) -> u64
        requires 0 <= position && position < 64
    {
        let selected: bool = SnapshotRegionScanResults::is_data_type_in_set(&element.data_type_ref, filtered_data_types);
        transition selected {
            true -> walk(snapshot_region_scan_results, position + 1,
                ((found as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
                filtered_data_types, region_base, range_end, deleted_scan_result_indices)
            false -> walk(snapshot_region_scan_results, position + 1, found, filtered_data_types, region_base, range_end, deleted_scan_result_indices)
        }
    }
}

// Upstream `get_visible_result_counts_by_data_type`: the structural
// per-type counts minus each tombstone's resolved type; zeroed entries
// drop like upstream's `retain`.
pub machine SnapshotRegionScanResults::get_visible_result_counts_by_data_type(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    region_global_scan_result_index_base: u64,
    deleted_scan_result_indices: &DeletedScanResultIndexSet
) -> DataTypeResultCounts
crashes Abort
{
    let mut counts: DataTypeResultCounts = SnapshotRegionScanResults::get_result_counts_by_data_type(snapshot_region_scan_results);
    transition deleted_scan_result_indices.count == 0 {
        true -> arm_result_1196_0(counts, deleted_scan_result_indices)
        false -> walk(snapshot_region_scan_results, &mut counts, region_global_scan_result_index_base, deleted_scan_result_indices)
    }
    state walk(snapshot_region_scan_results: &SnapshotRegionScanResults, counts: &mut DataTypeResultCounts, region_base: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet) -> DataTypeResultCounts {
        let range_end: u64 = ((region_base as u64 in Saturating)
            + (SnapshotRegionScanResults::get_number_of_results(snapshot_region_scan_results) as u64 in Saturating)) as u64;
        transition { _ -> each(snapshot_region_scan_results, counts, 0, region_base, range_end, deleted_scan_result_indices) }
    }
    state each(snapshot_region_scan_results: &SnapshotRegionScanResults, counts: &mut DataTypeResultCounts, position: u64, region_base: u64, range_end: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet) -> DataTypeResultCounts {
        transition position < deleted_scan_result_indices.count && position < 64 {
            true -> inspect(snapshot_region_scan_results, counts, position, region_base, range_end, deleted_scan_result_indices)
            false -> finish(snapshot_region_scan_results, counts)
        }
    }
    state inspect(snapshot_region_scan_results: &SnapshotRegionScanResults, counts: &mut DataTypeResultCounts, position: u64, region_base: u64, range_end: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet) -> DataTypeResultCounts
        requires 0 <= position && position < 64
    {
        let member: u64 = deleted_scan_result_indices.indices[position];
        transition member >= range_end {
            true -> finish(snapshot_region_scan_results, counts)
            false -> inside(snapshot_region_scan_results, counts, position, region_base, range_end, deleted_scan_result_indices, member)
        }
    }
    state inside(snapshot_region_scan_results: &SnapshotRegionScanResults, counts: &mut DataTypeResultCounts, position: u64, region_base: u64, range_end: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet, member: u64) -> DataTypeResultCounts
        requires 0 <= position && position < 64
    {
        transition member >= region_base {
            true -> locate(snapshot_region_scan_results, counts, position, region_base, range_end, deleted_scan_result_indices, member)
            false -> each(snapshot_region_scan_results, counts, position + 1, region_base, range_end, deleted_scan_result_indices)
        }
    }
    state locate(snapshot_region_scan_results: &SnapshotRegionScanResults, counts: &mut DataTypeResultCounts, position: u64, region_base: u64, range_end: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet, member: u64) -> DataTypeResultCounts
        requires 0 <= position && position < 64
    {
        let local_index: u64 = ((member as u64 in Saturating) - (region_base as u64 in Saturating)) as u64;
        let probe: SoughtElement = SnapshotRegionScanResults::seek_by_local_index(snapshot_region_scan_results, local_index);
        transition probe {
            SoughtElement::Found { element } -> drop(snapshot_region_scan_results, counts, position, region_base, range_end, deleted_scan_result_indices, element)
            _ -> (DataTypeResultCounts::clone(&mut counts))
        }
    }
    state drop(snapshot_region_scan_results: &SnapshotRegionScanResults, counts: &mut DataTypeResultCounts, position: u64, region_base: u64, range_end: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet, element: PageElement) -> DataTypeResultCounts
        requires 0 <= position && position < 64
    {
        DataTypeResultCounts::decrement_for(counts, &element.data_type_ref);
        transition { _ -> each(snapshot_region_scan_results, counts, position + 1, region_base, range_end, deleted_scan_result_indices) }
    }
    state finish(snapshot_region_scan_results: &SnapshotRegionScanResults, counts: &mut DataTypeResultCounts) -> DataTypeResultCounts {
        DataTypeResultCounts::retain_positive(counts);
        transition { _ -> (DataTypeResultCounts::clone(&mut counts)) }
    }
    state arm_result_1196_0(counts: DataTypeResultCounts, deleted_scan_result_indices: &DeletedScanResultIndexSet) -> DataTypeResultCounts
    {
        (counts)
    }
}

// Seek probe — upstream's Option<(address, data_type)> / Option<(collection,
// result index)> folded to a case union; Found carries the located element.
pub data SoughtElement {
    case Found(element: PageElement);
    case Missing;
}

// Resolves a merged-order local result index to its element — the
// address-ascending merge with every collection selected, skipped by the
// local index. Upstream walks `ScanResultsPageCursor`s with batched
// alignment advances; the port enumerates to the same ordering
// element-wise.
machine SnapshotRegionScanResults::seek_by_local_index(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    local_scan_result_index: u64
) -> SoughtElement
crashes Abort
{
    let all_types: DataTypeRefSet = DataTypeRefSet::empty();
    let page: PageElementList = SnapshotRegionScanResults::enumerate_page(snapshot_region_scan_results, local_scan_result_index, 1, &all_types);
    transition 0 < page.element_count{
        true -> arm_result_1270_0(page)
        false -> (SoughtElement::Missing)
    }
    state arm_result_1270_0(page: PageElementList) -> SoughtElement
    {
        (SoughtElement::Found { element: PageElementList::get_page_element(&page, 0) })
    }
}

// Structural lookup result — upstream's Option<ScanResultValued>.
pub data StructuralResult {
    case Found(valued_result: ScanResultValued);
    case Missing;
}

// Bounded valued-result carrier for the materialization paths — same 64-slot
// bound as PageElementList (named deviation; the CLI page surface is 22).
pub data ScanResultValuedList {
    valued_results: [ScanResultValued; 64];
    result_count: u64;
}

pub machine ScanResultValuedList::empty() -> ScanResultValuedList {
    ScanResultValuedList { result_count: 0 }
}

pub machine ScanResultValuedList::get_result_count(scan_result_valued_list: &ScanResultValuedList) -> u64 {
    scan_result_valued_list.result_count
}

pub machine ScanResultValuedList::push(scan_result_valued_list: &mut ScanResultValuedList, valued_result: &ScanResultValued) -> bool {
    transition scan_result_valued_list.result_count < 64 {
        true -> store(scan_result_valued_list, valued_result)
        false -> (false)
    }
    state store(scan_result_valued_list: &mut ScanResultValuedList, valued_result: &ScanResultValued) -> bool {
        ScanResultValued::clone_from(&mut scan_result_valued_list.valued_results[scan_result_valued_list.result_count], valued_result);
        scan_result_valued_list.result_count = scan_result_valued_list.result_count + 1;
        true
    }
}

pub machine ScanResultValuedList::get(scan_result_valued_list: &ScanResultValuedList, position: u64) -> ScanResultValued {
    transition position < scan_result_valued_list.result_count && position < 64 {
        true -> clone_at(scan_result_valued_list, position)
        false -> (ScanResultValued::default())
    }
    state clone_at(scan_result_valued_list: &ScanResultValuedList, position: u64) -> ScanResultValued
        requires 0 <= position && position < 64
    {
        ScanResultValued::clone(&scan_result_valued_list.valued_results[position])
    }
}

pub machine ScanResultValuedList::clone(source: &ScanResultValuedList) -> ScanResultValuedList {
    let mut copy: ScanResultValuedList = ScanResultValuedList::empty();
    ScanResultValuedList::copy_from(&mut copy, source);
    copy
}

machine ScanResultValuedList::copy_from(scan_result_valued_list: &mut ScanResultValuedList, source: &ScanResultValuedList) {
    scan_result_valued_list.result_count = source.result_count;
    transition { _ -> copy(scan_result_valued_list, source, 0) }
    state copy(scan_result_valued_list: &mut ScanResultValuedList, source: &ScanResultValuedList, position: u64) {
        transition position < source.result_count && position < 64 {
            true -> store(scan_result_valued_list, source, position)
            false -> done(scan_result_valued_list)
        }
    }
    state store(scan_result_valued_list: &mut ScanResultValuedList, source: &ScanResultValuedList, position: u64)
        requires 0 <= position && position < 64
    {
        ScanResultValued::clone_from(&mut scan_result_valued_list.valued_results[position], &source.valued_results[position]);
        transition { _ -> copy(scan_result_valued_list, source, position + 1) }
    }
    state done(scan_result_valued_list: &mut ScanResultValuedList) {
        scan_result_valued_list.result_count = scan_result_valued_list.result_count;
    }
}

// One materialized scan result — upstream `ScanResultsPageCursor::
// build_scan_result`. Values come from the region's element windows at
// (address - base) / 8 — the port's u64-element value model (a named
// deviation from upstream's byte arrays; sub-8-byte offsets inside one
// window element share the slot).
machine SnapshotRegionScanResults::build_scan_result(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    snapshot_region: &SnapshotRegion,
    global_scan_result_index: u64,
    element: &PageElement
) -> ScanResultValued
{
    let region_base: u64 = SnapshotRegion::get_base_address(snapshot_region);
    let byte_offset: u64 = ((element.address as u64 in Saturating)
        - (region_base as u64 in Saturating)) as u64;
    let window_index: u64 = byte_offset / 8;
    let has_current: bool = SnapshotRegion::has_current_values(snapshot_region)
        && window_index < SnapshotRegion::get_current_element_count(snapshot_region);
    let has_previous: bool = window_index < SnapshotRegion::get_previous_element_count(snapshot_region);
    transition { _ -> value(snapshot_region_scan_results, has_current, window_index, has_previous, snapshot_region, global_scan_result_index, element) }
    state value(snapshot_region_scan_results: &SnapshotRegionScanResults, has_current: bool, window_index: u64, has_previous: bool, snapshot_region: &SnapshotRegion, global_scan_result_index: u64, element: &PageElement) -> ScanResultValued {
        transition has_current {
            true -> current(snapshot_region_scan_results, window_index, has_previous, snapshot_region, global_scan_result_index, element)
            false -> absent_current(snapshot_region_scan_results, window_index, has_previous, snapshot_region, global_scan_result_index, element)
        }
    }
    state current(snapshot_region_scan_results: &SnapshotRegionScanResults, window_index: u64, has_previous: bool, snapshot_region: &SnapshotRegion, global_scan_result_index: u64, element: &PageElement) -> ScanResultValued {
        let current_value: u64 = SnapshotRegion::get_current_element(snapshot_region, window_index);
        transition { _ -> previous(snapshot_region_scan_results, true, current_value, window_index, has_previous, snapshot_region, global_scan_result_index, element) }
    }
    state absent_current(snapshot_region_scan_results: &SnapshotRegionScanResults, window_index: u64, has_previous: bool, snapshot_region: &SnapshotRegion, global_scan_result_index: u64, element: &PageElement) -> ScanResultValued {
        transition { _ -> previous(snapshot_region_scan_results, false, 0, window_index, has_previous, snapshot_region, global_scan_result_index, element) }
    }
    state previous(snapshot_region_scan_results: &SnapshotRegionScanResults, has_current: bool, current_value: u64, window_index: u64, has_previous: bool, snapshot_region: &SnapshotRegion, global_scan_result_index: u64, element: &PageElement) -> ScanResultValued {
        transition has_previous {
            true -> prior(snapshot_region_scan_results, has_current, current_value, window_index, snapshot_region, global_scan_result_index, element)
            false -> finish(snapshot_region_scan_results, has_current, current_value, false, 0, global_scan_result_index, element)
        }
    }
    state prior(snapshot_region_scan_results: &SnapshotRegionScanResults, has_current: bool, current_value: u64, window_index: u64, snapshot_region: &SnapshotRegion, global_scan_result_index: u64, element: &PageElement) -> ScanResultValued {
        let previous_value: u64 = SnapshotRegion::get_previous_element(snapshot_region, window_index);
        transition { _ -> finish(snapshot_region_scan_results, has_current, current_value, true, previous_value, global_scan_result_index, element) }
    }
    state finish(snapshot_region_scan_results: &SnapshotRegionScanResults, has_current: bool, current_value: u64, has_previous: bool, previous_value: u64, global_scan_result_index: u64, element: &PageElement) -> ScanResultValued {
        let base: ScanResultBase = ScanResultBase::new(
            element.address,
            DataTypeRef::clone(&element.data_type_ref),
            ScanResultRef::new(global_scan_result_index, false));
        ScanResultValued::new(base, has_current, current_value, has_previous, previous_value)
    }
}

// Upstream `get_structural_scan_result` — the single element at a local
// merged-order index, materialized against the region's values.
pub machine SnapshotRegionScanResults::get_structural_scan_result(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    snapshot_region: &SnapshotRegion,
    global_scan_result_index: u64,
    local_scan_result_index: u64
) -> StructuralResult
crashes Abort
{
    let probe: SoughtElement = SnapshotRegionScanResults::seek_by_local_index(snapshot_region_scan_results, local_scan_result_index);
    transition probe {
        SoughtElement::Found { element } -> found(snapshot_region_scan_results, global_scan_result_index, element, snapshot_region)
        _ -> (StructuralResult::Missing)
    }
    state found(snapshot_region_scan_results: &SnapshotRegionScanResults, global_scan_result_index: u64, element: PageElement, snapshot_region: &SnapshotRegion) -> StructuralResult {
        StructuralResult::Found { valued_result: SnapshotRegionScanResults::build_scan_result(snapshot_region_scan_results, snapshot_region, global_scan_result_index, &element) }
    }
}

// Upstream `get_scan_results_page` — BOTH upstream branches share this
// merge: every non-empty collection seeds a flagged cursor, each merged
// element consumes one global result index regardless of selection, and
// only selected+untombstoned elements emit. With an empty tombstone set
// this reduces to upstream's structural path verbatim.
pub machine SnapshotRegionScanResults::get_scan_results_page(
    snapshot_region_scan_results: &SnapshotRegionScanResults,
    snapshot_region: &SnapshotRegion,
    filtered_data_types: &DataTypeRefSet,
    region_global_scan_result_index_base: u64,
    filtered_scan_result_index_offset: u64,
    page_size: u64,
    deleted_scan_result_indices: &DeletedScanResultIndexSet
) -> ScanResultValuedList
crashes Abort
{
    let mut out: ScanResultValuedList = ScanResultValuedList::empty();
    let mut cursors: MergeCursors = MergeCursors::unfinished();
    transition page_size > 0 {
        true -> seed(snapshot_region_scan_results, 0, &mut cursors, snapshot_region, filtered_data_types, region_global_scan_result_index_base, filtered_scan_result_index_offset, page_size, deleted_scan_result_indices, &mut out)
        false -> (ScanResultValuedList::empty())
    }
    state seed(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        position: u64,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        skip: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList {
        transition position < snapshot_region_scan_results.collection_count && position < 4 {
            true -> seed_one(snapshot_region_scan_results, position, cursors, snapshot_region, filtered_data_types, next_global, skip, take, deleted_scan_result_indices, out)
            false -> step(snapshot_region_scan_results, cursors, snapshot_region, filtered_data_types, next_global, skip, take, deleted_scan_result_indices, out)
        }
    }
    state seed_one(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        position: u64,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        skip: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList
        requires 0 <= position && position < 4
    {
        let collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::clone(
            &snapshot_region_scan_results.snapshot_region_filter_collections[position]);
        let selected: bool = SnapshotRegionScanResults::is_data_type_in_set(
            &collection.data_type_ref, filtered_data_types);
        transition collection.filter_count > 0 {
            true -> plant(snapshot_region_scan_results, position, selected, cursors, snapshot_region, filtered_data_types, next_global, skip, take, deleted_scan_result_indices, out)
            false -> seed(snapshot_region_scan_results, position + 1, cursors, snapshot_region, filtered_data_types, next_global, skip, take, deleted_scan_result_indices, out)
        }
    }
    state plant(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        position: u64,
        selected: bool,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        skip: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList
        requires 0 <= position && position < 4
    {
        let cursor: ResultCursor = ResultCursor::active(position, selected);
        MergeCursors::set_cursor(cursors, position, &cursor);
        transition { _ -> seed(snapshot_region_scan_results, position + 1, cursors, snapshot_region, filtered_data_types, next_global, skip, take, deleted_scan_result_indices, out) }
    }
    state step(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        skip: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList {
        transition take > 0 {
            true -> probe(snapshot_region_scan_results, cursors, snapshot_region, filtered_data_types, next_global, skip, take, deleted_scan_result_indices, out)
            false -> (ScanResultValuedList::clone(&mut out))
        }
    }
    state probe(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        skip: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList {
        let c0: ResultCursor = MergeCursors::get_cursor(cursors, 0);
        let c1: ResultCursor = MergeCursors::get_cursor(cursors, 1);
        let c2: ResultCursor = MergeCursors::get_cursor(cursors, 2);
        let c3: ResultCursor = MergeCursors::get_cursor(cursors, 3);
        let p0: CursorProbe = SnapshotRegionScanResults::probe_cursor(snapshot_region_scan_results, &c0);
        let p1: CursorProbe = SnapshotRegionScanResults::probe_cursor(snapshot_region_scan_results, &c1);
        let p2: CursorProbe = SnapshotRegionScanResults::probe_cursor(snapshot_region_scan_results, &c2);
        let p3: CursorProbe = SnapshotRegionScanResults::probe_cursor(snapshot_region_scan_results, &c3);
        let m01: CursorProbe = CursorProbe::smaller(&p0, &p1);
        let m23: CursorProbe = CursorProbe::smaller(&p2, &p3);
        let best: CursorProbe = CursorProbe::smaller(&m01, &m23);
        transition best.active {
            true -> merged(snapshot_region_scan_results, best, cursors, snapshot_region, filtered_data_types, next_global, skip, take, deleted_scan_result_indices, out)
            false -> (ScanResultValuedList::clone(&mut out))
        }
    }
    state merged(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        best: CursorProbe,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        skip: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList {
        let cursor: ResultCursor = MergeCursors::get_cursor(cursors, best.owner);
        transition cursor.selected {
            true -> selected(snapshot_region_scan_results, best, cursors, snapshot_region, filtered_data_types, next_global, skip, take, deleted_scan_result_indices, out)
            false -> pass(snapshot_region_scan_results, best, cursors, snapshot_region, filtered_data_types, next_global, skip, take, deleted_scan_result_indices, out)
        }
    }
    // Unselected collections still consume global result-index space —
    // upstream advances them by the consecutive batch; the port steps one
    // element at a time to the same merged order.
    state pass(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        best: CursorProbe,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        skip: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList {
        SnapshotRegionScanResults::advance_cursor(snapshot_region_scan_results, &mut cursors, best.owner);
        transition { _ -> step(snapshot_region_scan_results, cursors, snapshot_region, filtered_data_types,
            ((next_global as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            skip, take, deleted_scan_result_indices, &mut out) }
    }
    state selected(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        best: CursorProbe,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        skip: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList {
        let tombstoned: bool = DeletedScanResultIndexSet::contains(deleted_scan_result_indices, next_global);
        transition tombstoned {
            true -> skip_tombstoned(snapshot_region_scan_results, best, cursors, snapshot_region, filtered_data_types, next_global, skip, take, deleted_scan_result_indices, out)
            false -> visible(snapshot_region_scan_results, best, cursors, snapshot_region, filtered_data_types, next_global, skip, take, deleted_scan_result_indices, out)
        }
    }
    state skip_tombstoned(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        best: CursorProbe,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        skip: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList {
        SnapshotRegionScanResults::advance_cursor(snapshot_region_scan_results, &mut cursors, best.owner);
        transition { _ -> step(snapshot_region_scan_results, cursors, snapshot_region, filtered_data_types,
            ((next_global as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            skip, take, deleted_scan_result_indices, &mut out) }
    }
    state visible(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        best: CursorProbe,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        skip: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList {
        transition skip > 0 {
            true -> skip_visible(snapshot_region_scan_results, best, cursors, snapshot_region, filtered_data_types, next_global, skip, take, deleted_scan_result_indices, out)
            false -> emit(snapshot_region_scan_results, best, cursors, snapshot_region, filtered_data_types, next_global, take, deleted_scan_result_indices, out)
        }
    }
    state skip_visible(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        best: CursorProbe,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        skip: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList {
        SnapshotRegionScanResults::advance_cursor(snapshot_region_scan_results, &mut cursors, best.owner);
        transition { _ -> step(snapshot_region_scan_results, cursors, snapshot_region, filtered_data_types,
            ((next_global as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            ((skip as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64,
            take, deleted_scan_result_indices, &mut out) }
    }
    state emit(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        best: CursorProbe,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList {
        transition best.owner < snapshot_region_scan_results.collection_count && best.owner < 4 {
            true -> emit_element(snapshot_region_scan_results, best, best.owner, cursors, snapshot_region, filtered_data_types, next_global, take, deleted_scan_result_indices, out)
            false -> step(snapshot_region_scan_results, cursors, snapshot_region, filtered_data_types, next_global, 0, take, deleted_scan_result_indices, out)
        }
    }
    state emit_element(
        snapshot_region_scan_results: &SnapshotRegionScanResults,
        best: CursorProbe,
        owner: u64,
        cursors: &mut MergeCursors,
        snapshot_region: &SnapshotRegion,
        filtered_data_types: &DataTypeRefSet,
        next_global: u64,
        take: u64,
        deleted_scan_result_indices: &DeletedScanResultIndexSet,
        out: &mut ScanResultValuedList
    ) -> ScanResultValuedList
        requires 0 <= owner && owner < 4
    {
        let collection: SnapshotRegionFilterCollection = SnapshotRegionFilterCollection::clone(
            &snapshot_region_scan_results.snapshot_region_filter_collections[owner]);
        let cursor: ResultCursor = MergeCursors::get_cursor(cursors, owner);
        let element: PageElement = PageElement::of(
            best.address,
            owner,
            cursor.filter_index,
            cursor.element_index,
            DataTypeRef::clone(&collection.data_type_ref));
        let valued: ScanResultValued = SnapshotRegionScanResults::build_scan_result(snapshot_region_scan_results, snapshot_region, next_global, &element);
        let pushed: bool = ScanResultValuedList::push(out, &valued);
        SnapshotRegionScanResults::advance_cursor(snapshot_region_scan_results, &mut cursors, owner);
        transition pushed {
            true -> step(snapshot_region_scan_results, cursors, snapshot_region, filtered_data_types,
                ((next_global as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
                0,
                ((take as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64,
                deleted_scan_result_indices, &mut out)
            _ -> (ScanResultValuedList::clone(&mut out))
        }
    }
}

// Per-collection deleted flat indices — upstream's
// `vec![Vec<u64>; collections.len()]` folded to the 4-collection bound.
pub data CollectionDeletions {
    sets: [DeletedScanResultIndexSet; 4];
}

pub machine CollectionDeletions::empty() -> CollectionDeletions {
    CollectionDeletions {}
}

pub machine CollectionDeletions::insert(collection_deletions: &mut CollectionDeletions, collection_index: u64, flat_result_index: u64) -> bool {
    transition collection_index == 0 {
        true -> (DeletedScanResultIndexSet::insert(&mut collection_deletions.sets[0], flat_result_index))
        false -> one(collection_deletions, collection_index, flat_result_index)
    }
    state one(collection_deletions: &mut CollectionDeletions, collection_index: u64, flat_result_index: u64) -> bool {
        transition collection_index == 1 {
            true -> (DeletedScanResultIndexSet::insert(&mut collection_deletions.sets[1], flat_result_index))
            false -> two(collection_deletions, collection_index, flat_result_index)
        }
    }
    state two(collection_deletions: &mut CollectionDeletions, collection_index: u64, flat_result_index: u64) -> bool {
        transition collection_index == 2 {
            true -> (DeletedScanResultIndexSet::insert(&mut collection_deletions.sets[2], flat_result_index))
            false -> three(collection_deletions, collection_index, flat_result_index)
        }
    }
    state three(collection_deletions: &mut CollectionDeletions, collection_index: u64, flat_result_index: u64) -> bool {
        transition collection_index == 3 {
            true -> (DeletedScanResultIndexSet::insert(&mut collection_deletions.sets[3], flat_result_index))
            false -> (false)
        }
    }
}

pub machine CollectionDeletions::get(collection_deletions: &CollectionDeletions, collection_index: u64) -> DeletedScanResultIndexSet {
    transition collection_index < 4 {
        true -> clone_at(collection_deletions, collection_index)
        false -> (DeletedScanResultIndexSet::empty())
    }
    state clone_at(collection_deletions: &CollectionDeletions, collection_index: u64) -> DeletedScanResultIndexSet
        requires 0 <= collection_index && collection_index < 4
    {
        DeletedScanResultIndexSet::clone(&collection_deletions.sets[collection_index])
    }
}

// Upstream `remove_scan_results_by_global_indices`: tombstones inside this
// region's global window resolve through the merged-order seek to flat
// collection result indices, then each collection rebuilds its filters
// minus those indices.
pub machine SnapshotRegionScanResults::remove_scan_results_by_global_indices(
    snapshot_region_scan_results: &mut SnapshotRegionScanResults,
    region_global_scan_result_index_base: u64,
    deleted_scan_result_indices: &DeletedScanResultIndexSet
) -> u64
crashes Abort
{
    transition deleted_scan_result_indices.count == 0 {
        true -> (0)
        false -> begin(snapshot_region_scan_results, region_global_scan_result_index_base, deleted_scan_result_indices)
    }
    state begin(snapshot_region_scan_results: &mut SnapshotRegionScanResults, region_base: u64, deleted_scan_result_indices: &DeletedScanResultIndexSet) -> u64 {
        let range_end: u64 = ((region_base as u64 in Saturating)
            + (SnapshotRegionScanResults::get_number_of_results(snapshot_region_scan_results) as u64 in Saturating)) as u64;
        let mut deletions: CollectionDeletions = CollectionDeletions::empty();
        transition { _ -> walk(snapshot_region_scan_results, deleted_scan_result_indices, &mut deletions, 0, 0, region_base, range_end) }
    }
    state walk(snapshot_region_scan_results: &mut SnapshotRegionScanResults, deleted_scan_result_indices: &DeletedScanResultIndexSet, deletions: &mut CollectionDeletions, position: u64, removed: u64, region_base: u64, range_end: u64) -> u64 {
        transition position < deleted_scan_result_indices.count && position < 64 {
            true -> inspect(snapshot_region_scan_results, deleted_scan_result_indices, deletions, position, removed, region_base, range_end)
            false -> rebuild(snapshot_region_scan_results, deletions, removed, 0)
        }
    }
    state inspect(snapshot_region_scan_results: &mut SnapshotRegionScanResults, deleted_scan_result_indices: &DeletedScanResultIndexSet, deletions: &mut CollectionDeletions, position: u64, removed: u64, region_base: u64, range_end: u64) -> u64
        requires 0 <= position && position < 64
    {
        let member: u64 = deleted_scan_result_indices.indices[position];
        transition member >= range_end {
            true -> rebuild(snapshot_region_scan_results, deletions, removed, 0)
            false -> inside(snapshot_region_scan_results, deleted_scan_result_indices, deletions, position, removed, region_base, range_end, member)
        }
    }
    state inside(snapshot_region_scan_results: &mut SnapshotRegionScanResults, deleted_scan_result_indices: &DeletedScanResultIndexSet, deletions: &mut CollectionDeletions, position: u64, removed: u64, region_base: u64, range_end: u64, member: u64) -> u64
        requires 0 <= position && position < 64
    {
        transition member >= region_base {
            true -> locate(snapshot_region_scan_results, deleted_scan_result_indices, deletions, position, removed, region_base, range_end, member)
            false -> walk(snapshot_region_scan_results, deleted_scan_result_indices, deletions, position + 1, removed, region_base, range_end)
        }
    }
    state locate(snapshot_region_scan_results: &mut SnapshotRegionScanResults, deleted_scan_result_indices: &DeletedScanResultIndexSet, deletions: &mut CollectionDeletions, position: u64, removed: u64, region_base: u64, range_end: u64, member: u64) -> u64
        requires 0 <= position && position < 64
    {
        let local_index: u64 = ((member as u64 in Saturating) - (region_base as u64 in Saturating)) as u64;
        let probe: SoughtElement = SnapshotRegionScanResults::seek_by_local_index(snapshot_region_scan_results, local_index);
        transition probe {
            SoughtElement::Found { element } -> record(snapshot_region_scan_results, deleted_scan_result_indices, deletions, position, removed, region_base, range_end, element)
            _ -> rebuild(snapshot_region_scan_results, deletions, removed, 0)
        }
    }
    state record(snapshot_region_scan_results: &mut SnapshotRegionScanResults, deleted_scan_result_indices: &DeletedScanResultIndexSet, deletions: &mut CollectionDeletions, position: u64, removed: u64, region_base: u64, range_end: u64, element: PageElement) -> u64
        requires 0 <= position && position < 64
    {
        transition element.collection_index < snapshot_region_scan_results.collection_count && element.collection_index < 4 {
            true -> flat(snapshot_region_scan_results, deleted_scan_result_indices, deletions, position, removed, region_base, range_end, element.collection_index, element)
            false -> walk(snapshot_region_scan_results, deleted_scan_result_indices, deletions, position + 1, removed, region_base, range_end)
        }
    }
    state flat(snapshot_region_scan_results: &mut SnapshotRegionScanResults, deleted_scan_result_indices: &DeletedScanResultIndexSet, deletions: &mut CollectionDeletions, position: u64, removed: u64, region_base: u64, range_end: u64, collection_index: u64, element: PageElement) -> u64
        requires 0 <= position && position < 64 && 0 <= collection_index && collection_index < 4
    {
        let flat_index: u64 = SnapshotRegionFilterCollection::flat_result_index(&snapshot_region_scan_results.snapshot_region_filter_collections[collection_index], 
            element.filter_index, element.element_index);
        let recorded: bool = DeletedScanResultIndexSet::insert(&mut deletions.sets[collection_index], flat_index);
        transition { _ -> walk(snapshot_region_scan_results, deleted_scan_result_indices, deletions, position + 1,
            ((removed as u64 in Saturating) + (1 as u64 in Saturating)) as u64,
            region_base, range_end) }
    }
    state rebuild(snapshot_region_scan_results: &mut SnapshotRegionScanResults, deletions: &mut CollectionDeletions, removed: u64, collection_index: u64) -> u64 {
        transition collection_index < snapshot_region_scan_results.collection_count && collection_index < 4 {
            true -> rebuild_one(snapshot_region_scan_results, deletions, removed, collection_index)
            false -> (removed)
        }
    }
    state rebuild_one(snapshot_region_scan_results: &mut SnapshotRegionScanResults, deletions: &mut CollectionDeletions, removed: u64, collection_index: u64) -> u64
        requires 0 <= collection_index && collection_index < 4
    {
        transition deletions.sets[collection_index].count > 0 {
            true -> apply(snapshot_region_scan_results, deletions, removed, collection_index)
            false -> rebuild(snapshot_region_scan_results, deletions, removed, collection_index + 1)
        }
    }
    state apply(snapshot_region_scan_results: &mut SnapshotRegionScanResults, deletions: &mut CollectionDeletions, removed: u64, collection_index: u64) -> u64
        requires 0 <= collection_index && collection_index < 4
    {
        let rebuilt: SnapshotRegionFilterCollection =
            SnapshotRegionFilterCollection::remove_results_at_indices(&snapshot_region_scan_results.snapshot_region_filter_collections[collection_index], 
                &deletions.sets[collection_index]);
        SnapshotRegionFilterCollection::clone_from(&mut snapshot_region_scan_results.snapshot_region_filter_collections[collection_index], &rebuilt);
        transition { _ -> rebuild(snapshot_region_scan_results, deletions, removed, collection_index + 1) }
    }
}

// `get_visible_result_counts_by_data_type` support: drop one surviving
// count for the tombstone's resolved type; drop emptied entries like
// upstream's `retain(count > 0)`.
machine DataTypeResultCounts::decrement_for(data_type_result_counts: &mut DataTypeResultCounts, data_type_ref: &DataTypeRef) {
    transition { _ -> seek(data_type_result_counts, data_type_ref, 0) }
    state seek(data_type_result_counts: &mut DataTypeResultCounts, data_type_ref: &DataTypeRef, position: u64) {
        transition position < data_type_result_counts.count && position < 4 {
            true -> compare(data_type_result_counts, data_type_ref, position)
            false -> done(data_type_result_counts)
        }
    }
    state compare(data_type_result_counts: &mut DataTypeResultCounts, data_type_ref: &DataTypeRef, position: u64)
        requires 0 <= position && position < 4
    {
        transition DataTypeRef::equals(&data_type_result_counts.counts[position].data_type_ref, data_type_ref) {
            true -> drop(data_type_result_counts, position)
            false -> seek(data_type_result_counts, data_type_ref, position + 1)
        }
    }
    state drop(data_type_result_counts: &mut DataTypeResultCounts, position: u64)
        requires 0 <= position && position < 4
    {
        data_type_result_counts.counts[position].count = ((data_type_result_counts.counts[position].count as u64 in Saturating)
            - (1 as u64 in Saturating)) as u64;
        transition { _ -> done(data_type_result_counts) }
    }
    state done(data_type_result_counts: &mut DataTypeResultCounts) {
        data_type_result_counts.count = data_type_result_counts.count;
    }
}

// Upstream's `retain(result_count > 0)` — in-place compaction.
machine DataTypeResultCounts::retain_positive(data_type_result_counts: &mut DataTypeResultCounts) {
    transition { _ -> compact(data_type_result_counts, 0, 0) }
    state compact(data_type_result_counts: &mut DataTypeResultCounts, read_position: u64, write_position: u64) {
        transition read_position < data_type_result_counts.count && read_position < 4 && write_position < 4 {
            true -> inspect(data_type_result_counts, read_position, write_position)
            false -> finish(data_type_result_counts, write_position)
        }
    }
    state inspect(data_type_result_counts: &mut DataTypeResultCounts, read_position: u64, write_position: u64)
        requires 0 <= read_position && read_position < 4 && 0 <= write_position && write_position < 4
    {
        transition data_type_result_counts.counts[read_position].count > 0 {
            true -> keep(data_type_result_counts, read_position, write_position)
            false -> compact(data_type_result_counts, read_position + 1, write_position)
        }
    }
    state keep(data_type_result_counts: &mut DataTypeResultCounts, read_position: u64, write_position: u64)
        requires 0 <= read_position && read_position < 4 && 0 <= write_position && write_position < 4
    {
        let held: ScanResultDataTypeCount = ScanResultDataTypeCount::clone(&data_type_result_counts.counts[read_position]);
        ScanResultDataTypeCount::clone_from(&mut data_type_result_counts.counts[write_position], &held);
        transition { _ -> compact(data_type_result_counts, read_position + 1, write_position + 1) }
    }
    state finish(data_type_result_counts: &mut DataTypeResultCounts, write_position: u64) {
        data_type_result_counts.count = write_position;
    }
}

// A filtered page of scan results — upstream `Snapshot::get_scan_results_page`
// returns `(effective_page_index, Vec<ScanResultValued>)`; the port returns
// them on one record.
pub data ScanResultsPage {
    effective_page_index: u64;
    results: ScanResultValuedList;
}

pub machine ScanResultsPage::empty() -> ScanResultsPage {
    ScanResultsPage {
        effective_page_index: 0,
        results: ScanResultValuedList::empty(),
    }
}

// Upstream `collect_scan_result_addresses_for_data_type`'s Vec<u64> — the
// bounded carrier (64, same family as the page bound).
pub data ScanResultAddresses {
    addresses: [u64; 64];
    address_count: u64;
}

pub machine ScanResultAddresses::empty() -> ScanResultAddresses {
    ScanResultAddresses { address_count: 0 }
}

pub machine ScanResultAddresses::get_address_count(scan_result_addresses: &ScanResultAddresses) -> u64 {
    scan_result_addresses.address_count
}

pub machine ScanResultAddresses::get(scan_result_addresses: &ScanResultAddresses, position: u64) -> u64 {
    transition position < scan_result_addresses.address_count && position < 64 {
        true -> (scan_result_addresses.addresses[position])
        false -> (0)
    }
}

pub machine ScanResultAddresses::push(scan_result_addresses: &mut ScanResultAddresses, address: u64) -> bool {
    transition scan_result_addresses.address_count < 64 {
        true -> store(scan_result_addresses, address)
        false -> (false)
    }
    state store(scan_result_addresses: &mut ScanResultAddresses, address: u64) -> bool {
        scan_result_addresses.addresses[scan_result_addresses.address_count] = address;
        scan_result_addresses.address_count = scan_result_addresses.address_count + 1;
        true
    }
}

pub machine ScanResultAddresses::clone(source: &ScanResultAddresses) -> ScanResultAddresses {
    let mut copy: ScanResultAddresses = ScanResultAddresses::empty();
    ScanResultAddresses::clone_from(&mut copy, source);
    copy
}

pub machine ScanResultAddresses::clone_from(scan_result_addresses: &mut ScanResultAddresses, source: &ScanResultAddresses) {
    scan_result_addresses.address_count = source.address_count;
    transition { _ -> copy(scan_result_addresses, source, 0) }
    state copy(scan_result_addresses: &mut ScanResultAddresses, source: &ScanResultAddresses, position: u64) {
        transition position < source.address_count && position < 64 {
            true -> store(scan_result_addresses, source, position)
            false -> done(scan_result_addresses)
        }
    }
    state store(scan_result_addresses: &mut ScanResultAddresses, source: &ScanResultAddresses, position: u64)
        requires 0 <= position && position < 64
    {
        scan_result_addresses.addresses[position] = source.addresses[position];
        transition { _ -> copy(scan_result_addresses, source, position + 1) }
    }
    state done(scan_result_addresses: &mut ScanResultAddresses) {
        scan_result_addresses.address_count = scan_result_addresses.address_count;
    }
}

// Deep copy parity — used when a computed tally is returned from a state.
pub machine DataTypeResultCounts::clone(source: &DataTypeResultCounts) -> DataTypeResultCounts {
    let mut copy: DataTypeResultCounts = DataTypeResultCounts::empty();
    DataTypeResultCounts::clone_from(&mut copy, source);
    copy
}

pub machine DataTypeResultCounts::clone_from(data_type_result_counts: &mut DataTypeResultCounts, source: &DataTypeResultCounts) {
    data_type_result_counts.count = source.count;
    transition { _ -> copy(data_type_result_counts, source, 0) }
    state copy(data_type_result_counts: &mut DataTypeResultCounts, source: &DataTypeResultCounts, position: u64) {
        transition position < source.count && position < 4 {
            true -> store(data_type_result_counts, source, position)
            false -> done(data_type_result_counts)
        }
    }
    state store(data_type_result_counts: &mut DataTypeResultCounts, source: &DataTypeResultCounts, position: u64)
        requires 0 <= position && position < 4
    {
        ScanResultDataTypeCount::clone_from(&mut data_type_result_counts.counts[position], &source.counts[position]);
        transition { _ -> copy(data_type_result_counts, source, position + 1) }
    }
    state done(data_type_result_counts: &mut DataTypeResultCounts) {
        data_type_result_counts.count = data_type_result_counts.count;
    }
}
