module src::structures::u64_extrema;

// Shared u64 min/max clamps — the one-condition pick helpers each file used
// to vendor under its own name (byte_array_u64_min, pick_min_u64, ...).
pub machine min_u64(a: u64, b: u64) -> u64 {
    transition a <= b {
        true -> (a)
        false -> (b)
        _ -> (b)
    }
}

pub machine max_u64(a: u64, b: u64) -> u64 {
    transition a >= b {
        true -> (a)
        false -> (b)
        _ -> (b)
    }
}
