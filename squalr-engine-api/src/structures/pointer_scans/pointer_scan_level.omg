module src::structures::pointer_scans::pointer_scan_level;

// Port of PointerScanLevel.
public data PointerScanLevel [copy] {
    depth: u64;
    node_count: u64;
    static_node_count: u64;
    heap_node_count: u64;
}

public machine PointerScanLevel::new(depth: u64, node_count: u64, static_node_count: u64, heap_node_count: u64) -> PointerScanLevel {
    (PointerScanLevel {
        depth: depth,
        node_count: node_count,
        static_node_count: static_node_count,
        heap_node_count: heap_node_count,
    })
}

public machine PointerScanLevel::get_depth(this: &PointerScanLevel) -> u64 { this.depth }
public machine PointerScanLevel::get_node_count(this: &PointerScanLevel) -> u64 { this.node_count }
public machine PointerScanLevel::get_static_node_count(this: &PointerScanLevel) -> u64 { this.static_node_count }
public machine PointerScanLevel::get_heap_node_count(this: &PointerScanLevel) -> u64 { this.heap_node_count }
