module src::structures::pointer_scans::pointer_scan_level;

// Port of PointerScanLevel.
pub data PointerScanLevel [copy] {
    depth: u64;
    node_count: u64;
    static_node_count: u64;
    heap_node_count: u64;
}

pub machine PointerScanLevel::new(depth: u64, node_count: u64, static_node_count: u64, heap_node_count: u64) -> PointerScanLevel {
    (PointerScanLevel {
        depth: depth,
        node_count: node_count,
        static_node_count: static_node_count,
        heap_node_count: heap_node_count,
    })
}

pub machine PointerScanLevel::get_depth(&self) -> u64 { self.depth }
pub machine PointerScanLevel::get_node_count(&self) -> u64 { self.node_count }
pub machine PointerScanLevel::get_static_node_count(&self) -> u64 { self.static_node_count }
pub machine PointerScanLevel::get_heap_node_count(&self) -> u64 { self.heap_node_count }
