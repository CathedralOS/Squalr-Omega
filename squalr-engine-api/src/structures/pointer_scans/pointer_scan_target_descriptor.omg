module src::structures::pointer_scans::pointer_scan_target_descriptor;

// Port of structures/pointer_scans/pointer_scan_target_descriptor.rs.
//
// Named deviation: upstream's second variant
//   Value { target_value: AnonymousValueString,
//           data_type_ref: DataTypeRef,
//           target_address_count: u64 }
// is NOT ported yet: it needs `structures::data_types::data_type_ref::DataTypeRef`,
// which exists only on z2's unmerged lane `leaf/supplied-bytes-scan`
// (`data_types/data_type_ref.omg`). `AnonymousValueString` already exists.
// Everything that pattern-matches `Value` (multi-target terminal
// materialization in the results materializer) currently reduces to the
// Address path; `is_value_descriptor` is kept as the single seam so the
// variant slots back in without touching call sites.
//
// `fmt::Display` is not ported: there is no formatting surface yet; the
// value-side text joins land with the Value variant.

pub data PointerScanTargetDescriptor [copy] {
    case Address(target_address: u64);
}

// Upstream derives PartialEq/Eq: `==`/`!=` select the Equatable route on this
// type.
trait Equatable {
    machine equals(&self, other: &Self) -> bool;
}

PointerScanTargetDescriptorEquatable: PointerScanTargetDescriptor satisfies Equatable;

// Upstream derived PartialEq. Address-only today (see header): two
// descriptors are equal when the carried target address matches. Revisit
// when the Value variant lands.
pub machine PointerScanTargetDescriptor::equals(&self, other: &PointerScanTargetDescriptor) -> bool {
    let self_address: u64 = self.get_target_address();
    let other_address: u64 = other.get_target_address();
    (self_address == other_address)
}

// Upstream `PointerScanTargetDescriptor::address`.
pub machine PointerScanTargetDescriptor::address(target_address: u64) -> PointerScanTargetDescriptor {
    PointerScanTargetDescriptor::Address { target_address: target_address }
}

// Upstream `get_target_address`: Option<u64> -> has_target_address + address.
pub machine PointerScanTargetDescriptor::has_target_address(&self) -> bool {
    transition self {
        PointerScanTargetDescriptor::Address { target_address } -> (true)
        _ -> (false)
    }
}

pub machine PointerScanTargetDescriptor::get_target_address(&self) -> u64 {
    transition self {
        PointerScanTargetDescriptor::Address { target_address } -> (target_address)
        _ -> (0)
    }
}

// Upstream `get_target_address_count`: 1 for Address, count for Value.
pub machine PointerScanTargetDescriptor::get_target_address_count(&self) -> u64 {
    transition self {
        PointerScanTargetDescriptor::Address { target_address } -> (1)
        _ -> (0)
    }
}

// Seam for upstream `matches!(descriptor, Value { .. })` checks — the
// materializer's multi-target terminal path keys off this until the Value
// variant exists.
pub machine PointerScanTargetDescriptor::is_value_descriptor(&self) -> bool {
    transition self {
        PointerScanTargetDescriptor::Address { target_address } -> (false)
        _ -> (true)
    }
}
