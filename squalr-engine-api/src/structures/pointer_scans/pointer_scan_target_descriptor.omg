module src::structures::pointer_scans::pointer_scan_target_descriptor;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::data_values::anonymous_value_string::AnonymousValueString;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use src::structures::data_values::container_type::ContainerType;

// Port of structures/pointer_scans/pointer_scan_target_descriptor.rs — both
// upstream variants: Address (resolved absolute address) and Value (named
// value target resolved through the element-scan query path, carrying the
// parsed value string + data type + resolved target count).
//
// `fmt::Display` is not ported: there is no formatting surface yet.
// Value carries by-value records, so the union is no longer [copy] —
// upstream derives Clone, mirrored by `clone` below.

pub data PointerScanTargetDescriptor {
    case Address(target_address: u64);
    case Value(
        target_value: AnonymousValueString,
        data_type_ref: DataTypeRef,
        target_address_count: u64
    );
}

// Upstream derived Clone. Case-payload calls cannot mint a union result
// inside a transition arm (result ownership), so payloads move by value
// into states that keep `&self` live and construct the case in the bare
// tail.
pub machine PointerScanTargetDescriptor::clone(this: &PointerScanTargetDescriptor) -> PointerScanTargetDescriptor {
    transition this {
        PointerScanTargetDescriptor::Address { target_address } -> clone_address(this, target_address)
        PointerScanTargetDescriptor::Value { target_value, data_type_ref, target_address_count } -> clone_value(this, target_value, data_type_ref, target_address_count)
        _ -> (PointerScanTargetDescriptor::Address { target_address: 0 })
    }
    state clone_address(this: &PointerScanTargetDescriptor, target_address: u64) -> PointerScanTargetDescriptor {
        PointerScanTargetDescriptor::Address { target_address: target_address }
    }
    state clone_value(this: &PointerScanTargetDescriptor, target_value: AnonymousValueString, data_type_ref: DataTypeRef, target_address_count: u64) -> PointerScanTargetDescriptor {
        PointerScanTargetDescriptor::Value {
            target_value: AnonymousValueString::clone(&target_value),
            data_type_ref: DataTypeRef::clone(&data_type_ref),
            target_address_count: target_address_count }
    }
}

// Upstream derived PartialEq: Address compares the address; Value compares
// value string + data type + address count. Union-payload bindings cannot
// cross a state boundary as `&` args, so the Value arm re-reads `self`'s
// fields through the owned getters in the target state.
pub machine PointerScanTargetDescriptor::equals(this: &PointerScanTargetDescriptor, other: &PointerScanTargetDescriptor) -> bool {
    transition this {
        PointerScanTargetDescriptor::Address { target_address } -> address_case(target_address, other)
        PointerScanTargetDescriptor::Value { target_value, data_type_ref, target_address_count } -> value_case(this, other, target_address_count)
        _ -> (false)
    }
    state address_case(target_address: u64, other: &PointerScanTargetDescriptor) -> bool {
        transition other {
            PointerScanTargetDescriptor::Address { target_address } -> self_equal(target_address, other)
            _ -> (false)
        }
    }
    state self_equal(target_address: u64, other: &PointerScanTargetDescriptor) -> bool {
        (target_address == PointerScanTargetDescriptor::get_target_address(&other))
    }
    state value_case(this: &PointerScanTargetDescriptor, other: &PointerScanTargetDescriptor, self_count: u64) -> bool {
        // Transition scrutinees cannot be calls on this toolchain level;
        // hoist the case query into a plain bool.
        let other_is_value: bool = PointerScanTargetDescriptor::is_value_descriptor(&other);
        transition other_is_value {
            true -> value_match(this, other, self_count)
            false -> (false)
            _ -> (false)
        }
    }
    state value_match(
        this: &PointerScanTargetDescriptor,
        other: &PointerScanTargetDescriptor,
        self_count: u64
    ) -> bool {
        let self_value: AnonymousValueString = PointerScanTargetDescriptor::get_target_value(&this);
        let self_type: DataTypeRef = PointerScanTargetDescriptor::get_target_data_type_ref(&this);
        let other_value: AnonymousValueString = PointerScanTargetDescriptor::get_target_value(&other);
        let other_type: DataTypeRef = PointerScanTargetDescriptor::get_target_data_type_ref(&other);
        let other_count: u64 = PointerScanTargetDescriptor::get_target_address_count(&other);
        let strings_equal: bool = AnonymousValueString::equals(&self_value, &other_value);
        let types_equal: bool = DataTypeRef::equals(&self_type, &other_type);
        (strings_equal && types_equal && self_count == other_count)
    }
}

// Upstream `PointerScanTargetDescriptor::address`.
pub machine PointerScanTargetDescriptor::address(target_address: u64) -> PointerScanTargetDescriptor {
    PointerScanTargetDescriptor::Address { target_address: target_address }
}

// Upstream `PointerScanTargetDescriptor::value`.
pub machine PointerScanTargetDescriptor::value(
    target_value: AnonymousValueString,
    data_type_ref: DataTypeRef,
    target_address_count: u64
) -> PointerScanTargetDescriptor {
    PointerScanTargetDescriptor::Value {
        target_value: target_value,
        data_type_ref: data_type_ref,
        target_address_count: target_address_count
    }
}

// Upstream `get_target_address`: Option<u64> -> has_target_address + address.
pub machine PointerScanTargetDescriptor::has_target_address(this: &PointerScanTargetDescriptor) -> bool {
    transition this {
        PointerScanTargetDescriptor::Address { target_address } -> (true)
        _ -> (false)
    }
}

pub machine PointerScanTargetDescriptor::get_target_address(this: &PointerScanTargetDescriptor) -> u64 {
    transition this {
        PointerScanTargetDescriptor::Address { target_address } -> (target_address)
        _ -> (0)
    }
}

// Upstream `get_target_address_count`: 1 for Address, count for Value.
pub machine PointerScanTargetDescriptor::get_target_address_count(this: &PointerScanTargetDescriptor) -> u64 {
    transition this {
        PointerScanTargetDescriptor::Address { target_address } -> (1)
        PointerScanTargetDescriptor::Value { target_value, data_type_ref, target_address_count } -> (target_address_count)
        _ -> (0)
    }
}

// Upstream `get_target_value`: Option<&AnonymousValueString> — the owned
// port returns a clone for Value, the empty value string for Address
// (upstream's None arm).
pub machine PointerScanTargetDescriptor::get_target_value(this: &PointerScanTargetDescriptor) -> AnonymousValueString {
    transition this {
        PointerScanTargetDescriptor::Value { target_value, data_type_ref, target_address_count } -> copy_target_value(this, target_value)
        _ -> empty_target_value(this)
    }
    state copy_target_value(this: &PointerScanTargetDescriptor, target_value: AnonymousValueString) -> AnonymousValueString {
        AnonymousValueString::clone(&target_value)
    }
    state empty_target_value(this: &PointerScanTargetDescriptor) -> AnonymousValueString {
        // Calls cannot sit inside an arm's value expression (result
        // ownership), and union-typed locals do not rejoin as `new` call
        // arguments — the upstream None arm's empty value is the same
        // record literal `new` builds.
        AnonymousValueString {
            anonymous_value_string_len: 0,
            anonymous_value_string_format: AnonymousValueStringFormat::default(),
            container_type: ContainerType::default()
        }
    }
}

// Upstream `get_target_data_type_ref`: Option<&DataTypeRef> — the owned
// port returns a clone for Value, the default ref for Address.
pub machine PointerScanTargetDescriptor::get_target_data_type_ref(this: &PointerScanTargetDescriptor) -> DataTypeRef {
    transition this {
        PointerScanTargetDescriptor::Value { target_value, data_type_ref, target_address_count } -> copy_data_type_ref(this, data_type_ref)
        _ -> default_data_type_ref(this)
    }
    state copy_data_type_ref(this: &PointerScanTargetDescriptor, data_type_ref: DataTypeRef) -> DataTypeRef {
        DataTypeRef::clone(&data_type_ref)
    }
    state default_data_type_ref(this: &PointerScanTargetDescriptor) -> DataTypeRef {
        DataTypeRef::default()
    }
}

// Upstream `matches!(descriptor, Value { .. })` — the materializer's
// multi-target terminal path keys off this.
pub machine PointerScanTargetDescriptor::is_value_descriptor(this: &PointerScanTargetDescriptor) -> bool {
    transition this {
        PointerScanTargetDescriptor::Address { target_address } -> (false)
        _ -> (true)
    }
}
