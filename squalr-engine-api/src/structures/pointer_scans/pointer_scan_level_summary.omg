module src::structures::pointer_scans::pointer_scan_level_summary;

// Port of PointerScanLevelSummary.
pub data PointerScanLevelSummary [copy] {
    depth: u64;
    node_count: u64;
    static_node_count: u64;
    heap_node_count: u64;
}

pub machine PointerScanLevelSummary::new(depth: u64, node_count: u64, static_node_count: u64, heap_node_count: u64) -> PointerScanLevelSummary {
    (PointerScanLevelSummary {
        depth: depth,
        node_count: node_count,
        static_node_count: static_node_count,
        heap_node_count: heap_node_count,
    })
}

pub machine PointerScanLevelSummary::get_depth(pointer_scan_level_summary: &PointerScanLevelSummary) -> u64 { pointer_scan_level_summary.depth }
pub machine PointerScanLevelSummary::get_node_count(pointer_scan_level_summary: &PointerScanLevelSummary) -> u64 { pointer_scan_level_summary.node_count }
pub machine PointerScanLevelSummary::get_static_node_count(pointer_scan_level_summary: &PointerScanLevelSummary) -> u64 { pointer_scan_level_summary.static_node_count }
pub machine PointerScanLevelSummary::get_heap_node_count(pointer_scan_level_summary: &PointerScanLevelSummary) -> u64 { pointer_scan_level_summary.heap_node_count }
