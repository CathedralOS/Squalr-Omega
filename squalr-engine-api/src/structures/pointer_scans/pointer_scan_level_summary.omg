module src::structures::pointer_scans::pointer_scan_level_summary;

// Port of PointerScanLevelSummary.
pub data PointerScanLevelSummary [copy] {
    depth: u64;
    node_count: u64;
    static_node_count: u64;
    heap_node_count: u64;
}

pub machine PointerScanLevelSummary::new(depth: u64, node_count: u64, static_node_count: u64, heap_node_count: u64) -> PointerScanLevelSummary {
    (PointerScanLevelSummary {
        depth: depth,
        node_count: node_count,
        static_node_count: static_node_count,
        heap_node_count: heap_node_count,
    })
}

pub machine PointerScanLevelSummary::get_depth(this: &PointerScanLevelSummary) -> u64 { this.depth }
pub machine PointerScanLevelSummary::get_node_count(this: &PointerScanLevelSummary) -> u64 { this.node_count }
pub machine PointerScanLevelSummary::get_static_node_count(this: &PointerScanLevelSummary) -> u64 { this.static_node_count }
pub machine PointerScanLevelSummary::get_heap_node_count(this: &PointerScanLevelSummary) -> u64 { this.heap_node_count }
