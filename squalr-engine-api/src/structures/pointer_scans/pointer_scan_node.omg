module src::structures::pointer_scans::pointer_scan_node;

use src::structures::memory::address_display::format_module_address;
use src::structures::pointer_scans::pointer_scan_node_type::PointerScanNodeType;

// Port of PointerScanNode. Upstream fields that have no Omega spelling map
// as follows: `parent_node_id: Option<u64>` -> has_parent_node_id flag +
// payload; `module_name: String` -> inline [u8; 256] buffer + length
// (ProcessInfo name capacity); `child_node_ids: Vec<u64>` -> caller-supplied
// extent + live count. `new` copies the name text into the node.
pub data PointerScanNode<'children> {
    node_id: u64;
    graph_node_id: u64;
    discovery_depth: u64;
    branch_total_depth: u64;
    has_parent_node_id: bool;
    parent_node_id: u64;
    pointer_scan_node_type: PointerScanNodeType;
    depth: u64;
    pointer_address: u64;
    pointer_value: u64;
    resolved_target_address: u64;
    pointer_offset: i64;
    module_name: [u8; 256];
    module_name_len: u64;
    module_offset: u64;
    child_node_ids: &'children mut [u64];
    child_node_count: u64;
    has_children: bool;
}

pub machine PointerScanNode::new<'children>(
    node_id: u64,
    has_parent_node_id: bool,
    parent_node_id: u64,
    pointer_scan_node_type: PointerScanNodeType,
    depth: u64,
    pointer_address: u64,
    pointer_value: u64,
    resolved_target_address: u64,
    pointer_offset: i64,
    module_name: &[u8],
    module_offset: u64,
    child_node_ids: &'children mut [u64],
    child_node_count: u64
) -> PointerScanNode<'children> {
    // Upstream sets has_children = !child_node_ids.is_empty() and mirrors
    // graph/discovery/branch fields off depth/node_id.
    let mut node: PointerScanNode<'children> = PointerScanNode {
        node_id: node_id,
        graph_node_id: node_id,
        discovery_depth: depth,
        branch_total_depth: depth,
        has_parent_node_id: has_parent_node_id,
        parent_node_id: parent_node_id,
        pointer_scan_node_type: pointer_scan_node_type,
        depth: depth,
        pointer_address: pointer_address,
        pointer_value: pointer_value,
        resolved_target_address: resolved_target_address,
        pointer_offset: pointer_offset,
        module_name_len: 0,
        module_offset: module_offset,
        child_node_ids: child_node_ids,
        child_node_count: child_node_count,
        has_children: child_node_count > 0,
    };
    node.set_module_name(module_name);
    (node)
}

// Upstream module_name: String copies into the node's buffer.
pub machine PointerScanNode::set_module_name<'children>(&mut self, module_name: &[u8]) {
    transition {
        _ -> copy(module_name, 0)
    }
    state copy(&mut self, module_name: &[u8], position: u64) {
        transition (position < module_name.len && position < 256) {
            true -> store(module_name, position)
            false -> finish(position)
        }
    }
    state store(&mut self, module_name: &[u8], position: u64) {
        self.module_name[position] = module_name[position];
        transition {
            _ -> copy(module_name, ((position as u64 in Wrapping) + 1) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.module_name_len = count;
    }
}

pub machine PointerScanNode::new_materialized<'children>(
    node_id: u64,
    graph_node_id: u64,
    discovery_depth: u64,
    branch_total_depth: u64,
    depth: u64,
    has_parent_node_id: bool,
    parent_node_id: u64,
    pointer_scan_node_type: PointerScanNodeType,
    pointer_address: u64,
    pointer_value: u64,
    resolved_target_address: u64,
    pointer_offset: i64,
    module_name: &[u8],
    module_offset: u64,
    child_node_ids: &'children mut [u64],
    has_children: bool
) -> PointerScanNode<'children> {
    let mut node: PointerScanNode<'children> = PointerScanNode {
        node_id: node_id,
        graph_node_id: graph_node_id,
        discovery_depth: discovery_depth,
        branch_total_depth: branch_total_depth,
        has_parent_node_id: has_parent_node_id,
        parent_node_id: parent_node_id,
        pointer_scan_node_type: pointer_scan_node_type,
        depth: depth,
        pointer_address: pointer_address,
        pointer_value: pointer_value,
        resolved_target_address: resolved_target_address,
        pointer_offset: pointer_offset,
        module_name_len: 0,
        module_offset: module_offset,
        child_node_ids: child_node_ids,
        child_node_count: 0,
        has_children: has_children,
    };
    node.set_module_name(module_name);
    (node)
}

pub machine PointerScanNode::get_node_id<'children>(&self) -> u64 { self.node_id }
pub machine PointerScanNode::get_graph_node_id<'children>(&self) -> u64 { self.graph_node_id }
pub machine PointerScanNode::get_discovery_depth<'children>(&self) -> u64 { self.discovery_depth }
pub machine PointerScanNode::get_branch_total_depth<'children>(&self) -> u64 { self.branch_total_depth }

// Upstream returns Option<u64>; presence is inspected through the flag
// accessors so callers never need to destructure an Optional payload.
pub machine PointerScanNode::has_parent_node_id<'children>(&self) -> bool { self.has_parent_node_id }
pub machine PointerScanNode::get_parent_node_id<'children>(&self) -> u64 { self.parent_node_id }

pub machine PointerScanNode::get_pointer_scan_node_type<'children>(&self) -> PointerScanNodeType { self.pointer_scan_node_type }
pub machine PointerScanNode::get_depth<'children>(&self) -> u64 { self.depth }
pub machine PointerScanNode::set_depth<'children>(&mut self, depth: u64) { self.depth = depth; }
pub machine PointerScanNode::set_discovery_depth<'children>(&mut self, discovery_depth: u64) { self.discovery_depth = discovery_depth; }
pub machine PointerScanNode::set_branch_total_depth<'children>(&mut self, branch_total_depth: u64) { self.branch_total_depth = branch_total_depth; }
pub machine PointerScanNode::get_pointer_address<'children>(&self) -> u64 { self.pointer_address }
pub machine PointerScanNode::get_pointer_value<'children>(&self) -> u64 { self.pointer_value }
pub machine PointerScanNode::get_resolved_target_address<'children>(&self) -> u64 { self.resolved_target_address }
pub machine PointerScanNode::get_pointer_offset<'children>(&self) -> i64 { self.pointer_offset }
pub machine PointerScanNode::get_module_name<'children>(&self) -> &[u8] {
    transition (self.module_name_len <= 256) {
        true -> (self.module_name[0..self.module_name_len])
        false -> (self.module_name[0..256])
    }
}
pub machine PointerScanNode::get_module_offset<'children>(&self) -> u64 { self.module_offset }

// Upstream get_module_display_text: "<module_name>+0x<offset>" into `out`;
// returns the produced length.
pub machine PointerScanNode::get_module_display_text<'children>(&self, out: &mut [u8; 512]) -> u64 {
    transition (self.module_name_len <= 256) {
        true -> slice_text(out)
        false -> full_text(out)
    }
    state slice_text(&self, out: &mut [u8; 512]) -> u64 {
        format_module_address(out, self.module_name[0..self.module_name_len], self.module_offset)
    }
    state full_text(&self, out: &mut [u8; 512]) -> u64 {
        format_module_address(out, self.module_name[0..256], self.module_offset)
    }
}

pub machine PointerScanNode::get_child_node_ids<'children>(&self) -> &[u64] {
    transition (self.child_node_count <= self.child_node_ids.len) {
        true -> (self.child_node_ids[0..self.child_node_count])
        false -> (self.child_node_ids[0..self.child_node_ids.len])
    }
}


pub machine PointerScanNode::has_children<'children>(&self) -> bool { self.has_children }
