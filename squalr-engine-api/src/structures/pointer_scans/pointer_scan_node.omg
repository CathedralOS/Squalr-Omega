module src::structures::pointer_scans::pointer_scan_node;

use src::structures::pointer_scans::pointer_scan_node_type::PointerScanNodeType;
use src::structures::memory::address_display::format_module_address;

// Port of structures/pointer_scans/pointer_scan_node.rs.
//
// Named deviation: upstream `child_node_ids: Vec<u64>` is unbounded; the port
// carries a bounded inline list of 64 ids. The results materializer only ever
// constructs nodes with empty child lists (has_children is passed
// explicitly), and GUI expansion writes through `set_child_node_ids`; calls
// attaching more than 64 ids retain the first 64 — beyond that the stored id
// list truncates while `child_node_count`/`has_children` still reflect the
// requested count.

pub data PointerScanNode [copy] {
    node_id: u64;
    graph_node_id: u64;
    discovery_depth: u64;
    branch_total_depth: u64;
    has_parent_node_id: bool;
    parent_node_id: u64;
    pointer_scan_node_type: PointerScanNodeType;
    depth: u64;
    pointer_address: u64;
    pointer_value: u64;
    resolved_target_address: u64;
    pointer_offset: i64;
    module_name: [u8; 256];
    module_name_len: u64;
    module_offset: u64;
    child_node_ids: [u64; 64];
    child_node_count: u64;
    has_children: bool;
}

pub machine PointerScanNode::new(
    node_id: u64,
    has_parent_node_id: bool,
    parent_node_id: u64,
    pointer_scan_node_type: PointerScanNodeType,
    depth: u64,
    pointer_address: u64,
    pointer_value: u64,
    resolved_target_address: u64,
    pointer_offset: i64,
    module_name: &[u8],
    module_offset: u64,
    child_node_ids: &[u64],
    child_node_count: u64
) -> PointerScanNode {
    // Upstream sets has_children = !child_node_ids.is_empty() and mirrors
    // graph/discovery/branch fields off depth/node_id.
    let mut node: PointerScanNode = PointerScanNode {
        node_id: node_id,
        graph_node_id: node_id,
        discovery_depth: depth,
        branch_total_depth: depth,
        has_parent_node_id: has_parent_node_id,
        parent_node_id: parent_node_id,
        pointer_scan_node_type: pointer_scan_node_type,
        depth: depth,
        pointer_address: pointer_address,
        pointer_value: pointer_value,
        resolved_target_address: resolved_target_address,
        pointer_offset: pointer_offset,
        module_name_len: 0,
        module_offset: module_offset,

        child_node_count: child_node_count,
        has_children: child_node_count > 0,
    };
    PointerScanNode::set_module_name(&mut node, module_name);
    PointerScanNode::set_child_node_ids(&mut node, child_node_ids);
    (node)
}

// Zeroed node — upstream `PointerScanNode::default()`-style absent slot for
// bounded carriers (expand response page arrays).
pub machine PointerScanNode::empty() -> PointerScanNode {
    PointerScanNode {
        node_id: 0,
        graph_node_id: 0,
        discovery_depth: 0,
        branch_total_depth: 0,
        has_parent_node_id: false,
        parent_node_id: 0,
        pointer_scan_node_type: PointerScanNodeType::Heap,
        depth: 0,
        pointer_address: 0,
        pointer_value: 0,
        resolved_target_address: 0,
        pointer_offset: 0,
        module_name_len: 0,
        module_offset: 0,
        child_node_count: 0,
        has_children: false,
    }
}

// Upstream module_name: String copies into the node's buffer.
pub machine PointerScanNode::set_module_name(this: &mut PointerScanNode, module_name: &[u8]) {
    transition {
        _ -> copy(this, module_name, 0)
    }
    state copy(this: &mut PointerScanNode, module_name: &[u8], position: u64) {
        transition (position < module_name.len && position < 256) {
            true -> store(this, module_name, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut PointerScanNode, module_name: &[u8], position: u64)
        requires 0 <= position && position < module_name.len
    {
        this.module_name[position] = module_name[position];
        transition {
            _ -> copy(this, module_name, ((position as u64 in Wrapping) + 1) as u64)
        }
    }
    state finish(this: &mut PointerScanNode, count: u64) {
        this.module_name_len = count;
    }
}

// Upstream set_child_node_ids: replaces the id list and refreshes
// has_children. Bounded inline storage keeps the first 64 ids (see header).
pub machine PointerScanNode::set_child_node_ids(this: &mut PointerScanNode, child_node_ids: &[u64]) {
    transition {
        _ -> count_ids(this, child_node_ids)
    }
    state count_ids(this: &mut PointerScanNode, child_node_ids: &[u64]) {
        transition (child_node_ids.len <= 64) {
            true -> copy(this, child_node_ids, 0, child_node_ids.len)
            false -> copy(this, child_node_ids, 0, 64)
        }
    }
    state copy(this: &mut PointerScanNode, child_node_ids: &[u64], position: u64, count: u64) {
        transition (position < count && position < child_node_ids.len && position < 64) {
            true -> store(this, child_node_ids, position, count)
            false -> finish(this, count)
        }
    }
    state store(this: &mut PointerScanNode, child_node_ids: &[u64], position: u64, count: u64)
        requires 0 <= position && position < child_node_ids.len
    {
        this.child_node_ids[position] = child_node_ids[position];
        transition {
            _ -> copy(this, child_node_ids, ((position as u64 in Wrapping) + 1) as u64, count)
        }
    }
    state finish(this: &mut PointerScanNode, count: u64) {
        this.child_node_count = count;
        this.has_children = count > 0;
    }
}

pub machine PointerScanNode::new_materialized(
    node_id: u64,
    graph_node_id: u64,
    discovery_depth: u64,
    branch_total_depth: u64,
    depth: u64,
    has_parent_node_id: bool,
    parent_node_id: u64,
    pointer_scan_node_type: PointerScanNodeType,
    pointer_address: u64,
    pointer_value: u64,
    resolved_target_address: u64,
    pointer_offset: i64,
    module_name: &[u8],
    module_offset: u64,
    has_children: bool
) -> PointerScanNode {
    // Upstream new_materialized: child_node_ids starts empty and
    // has_children is supplied by the caller.
    let mut node: PointerScanNode = PointerScanNode {
        node_id: node_id,
        graph_node_id: graph_node_id,
        discovery_depth: discovery_depth,
        branch_total_depth: branch_total_depth,
        has_parent_node_id: has_parent_node_id,
        parent_node_id: parent_node_id,
        pointer_scan_node_type: pointer_scan_node_type,
        depth: depth,
        pointer_address: pointer_address,
        pointer_value: pointer_value,
        resolved_target_address: resolved_target_address,
        pointer_offset: pointer_offset,
        module_name_len: 0,
        module_offset: module_offset,

        child_node_count: 0,
        has_children: has_children,
    };
    PointerScanNode::set_module_name(&mut node, module_name);
    (node)
}

pub machine PointerScanNode::get_node_id(this: &PointerScanNode) -> u64 { this.node_id }
pub machine PointerScanNode::get_graph_node_id(this: &PointerScanNode) -> u64 { this.graph_node_id }
pub machine PointerScanNode::get_discovery_depth(this: &PointerScanNode) -> u64 { this.discovery_depth }
pub machine PointerScanNode::get_branch_total_depth(this: &PointerScanNode) -> u64 { this.branch_total_depth }
// Upstream Option<u64>: the port exposes has_parent_node_id/get_parent_node_id.
pub machine PointerScanNode::has_parent_node_id(this: &PointerScanNode) -> bool { this.has_parent_node_id }
pub machine PointerScanNode::get_parent_node_id(this: &PointerScanNode) -> u64 { this.parent_node_id }

pub machine PointerScanNode::get_pointer_scan_node_type(this: &PointerScanNode) -> PointerScanNodeType { this.pointer_scan_node_type }
pub machine PointerScanNode::get_depth(this: &PointerScanNode) -> u64 { this.depth }
pub machine PointerScanNode::set_depth(this: &mut PointerScanNode, depth: u64) { this.depth = depth; }
pub machine PointerScanNode::set_discovery_depth(this: &mut PointerScanNode, discovery_depth: u64) { this.discovery_depth = discovery_depth; }
pub machine PointerScanNode::set_branch_total_depth(this: &mut PointerScanNode, branch_total_depth: u64) { this.branch_total_depth = branch_total_depth; }
pub machine PointerScanNode::get_pointer_address(this: &PointerScanNode) -> u64 { this.pointer_address }
pub machine PointerScanNode::get_pointer_value(this: &PointerScanNode) -> u64 { this.pointer_value }
pub machine PointerScanNode::get_resolved_target_address(this: &PointerScanNode) -> u64 { this.resolved_target_address }
pub machine PointerScanNode::get_pointer_offset(this: &PointerScanNode) -> i64 { this.pointer_offset }
pub machine PointerScanNode::get_module_name(this: &PointerScanNode) -> &[u8] {
    transition (this.module_name_len <= 256) {
        true -> arm_result_217_0(this)
        false -> (this.module_name[0..256])
    }
    state arm_result_217_0(this: &PointerScanNode) -> &[u8]
    
    requires (this.module_name_len <= 256);
{
        (this.module_name[0..this.module_name_len])
    }
}

pub machine PointerScanNode::get_module_offset(this: &PointerScanNode) -> u64 { this.module_offset }

// Upstream get_module_display_text: "<module_name>+0x<offset>" into `out`;
// returns the produced length.
pub machine PointerScanNode::get_module_display_text(this: &PointerScanNode, out: &mut [u8; 512]) -> u64 {
    transition (this.module_name_len <= 256) {
        true -> slice_text(this, out)
        false -> full_text(this, out)
    }
    state slice_text(this: &PointerScanNode, out: &mut [u8; 512]) -> u64 {
        let hoist1: u64 = format_module_address(&mut out, this.module_name[0..this.module_name_len], this.module_offset);
        (hoist1)
    }
    state full_text(this: &PointerScanNode, out: &mut [u8; 512]) -> u64 {
        let hoist2: u64 = format_module_address(&mut out, this.module_name[0..256], this.module_offset);
        (hoist2)
    }
}

pub machine PointerScanNode::get_child_node_ids(this: &PointerScanNode) -> &[u64] {
    transition (this.child_node_count <= 64) {
        true -> arm_result_241_0(this)
        false -> (this.child_node_ids[0..64])
    }
    state arm_result_241_0(this: &PointerScanNode) -> &[u64]
    
    requires (this.child_node_count <= 64);
{
        (this.child_node_ids[0..this.child_node_count])
    }
}


pub machine PointerScanNode::has_children(this: &PointerScanNode) -> bool { this.has_children }
