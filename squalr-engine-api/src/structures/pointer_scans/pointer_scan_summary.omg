module src::structures::pointer_scans::pointer_scan_summary;

use src::structures::pointer_scans::pointer_scan_address_space::PointerScanAddressSpace;
use src::structures::pointer_scans::pointer_scan_level_summary::PointerScanLevelSummary;
use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use src::structures::pointer_scans::pointer_scan_target_descriptor::PointerScanTargetDescriptor;

// Port of structures/pointer_scans/pointer_scan_summary.rs.
// Upstream `pointer_scan_level_summaries: Vec<PointerScanLevelSummary>` is a
// caller-lent slice: summaries are read-only views, callers keep the storage.

pub data PointerScanSummary<'summaries> {
    session_id: u64;
    target_descriptor: PointerScanTargetDescriptor;
    address_space: PointerScanAddressSpace;
    pointer_size: PointerScanPointerSize;
    max_depth: u64;
    offset_radius: u64;
    root_node_count: u64;
    total_node_count: u64;
    total_static_node_count: u64;
    total_heap_node_count: u64;
    pointer_scan_level_summaries: &'summaries [PointerScanLevelSummary];
}

pub machine PointerScanSummary::new<'summaries>(
    session_id: u64,
    target_descriptor: PointerScanTargetDescriptor,
    address_space: PointerScanAddressSpace,
    pointer_size: PointerScanPointerSize,
    max_depth: u64,
    offset_radius: u64,
    root_node_count: u64,
    total_node_count: u64,
    total_static_node_count: u64,
    total_heap_node_count: u64,
    pointer_scan_level_summaries: &'summaries [PointerScanLevelSummary]
) -> PointerScanSummary<'summaries> {
    PointerScanSummary {
        session_id: session_id,
        target_descriptor: target_descriptor,
        address_space: address_space,
        pointer_size: pointer_size,
        max_depth: max_depth,
        offset_radius: offset_radius,
        root_node_count: root_node_count,
        total_node_count: total_node_count,
        total_static_node_count: total_static_node_count,
        total_heap_node_count: total_heap_node_count,
        pointer_scan_level_summaries: pointer_scan_level_summaries
    }
}

pub machine PointerScanSummary::get_session_id(&self) -> u64 { self.session_id }

pub machine PointerScanSummary::get_target_descriptor(&self) -> PointerScanTargetDescriptor {
    self.target_descriptor
}

pub machine PointerScanSummary::get_address_space(&self) -> PointerScanAddressSpace { self.address_space }

pub machine PointerScanSummary::get_pointer_size(&self) -> PointerScanPointerSize { self.pointer_size }

pub machine PointerScanSummary::get_max_depth(&self) -> u64 { self.max_depth }

pub machine PointerScanSummary::get_offset_radius(&self) -> u64 { self.offset_radius }

pub machine PointerScanSummary::get_root_node_count(&self) -> u64 { self.root_node_count }

pub machine PointerScanSummary::get_total_node_count(&self) -> u64 { self.total_node_count }

pub machine PointerScanSummary::get_total_static_node_count(&self) -> u64 { self.total_static_node_count }

pub machine PointerScanSummary::get_total_heap_node_count(&self) -> u64 { self.total_heap_node_count }

pub machine PointerScanSummary::get_pointer_scan_level_summaries<'summaries>(
    &self
) -> &'summaries [PointerScanLevelSummary] {
    self.pointer_scan_level_summaries
}
