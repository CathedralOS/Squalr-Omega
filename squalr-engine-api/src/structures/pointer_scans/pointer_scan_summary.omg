module src::structures::pointer_scans::pointer_scan_summary;

use src::structures::pointer_scans::pointer_scan_address_space::PointerScanAddressSpace;
use src::structures::pointer_scans::pointer_scan_level_summary::PointerScanLevelSummary;
use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use src::structures::pointer_scans::pointer_scan_target_descriptor::PointerScanTargetDescriptor;

// Port of structures/pointer_scans/pointer_scan_summary.rs.
// Upstream `pointer_scan_level_summaries: Vec<PointerScanLevelSummary>` is a
// caller-lent slice: summaries are read-only views, callers keep the storage.

pub data PointerScanSummary<'summaries> {
    session_id: u64;
    target_descriptor: PointerScanTargetDescriptor;
    address_space: PointerScanAddressSpace;
    pointer_size: PointerScanPointerSize;
    max_depth: u64;
    offset_radius: u64;
    root_node_count: u64;
    total_node_count: u64;
    total_static_node_count: u64;
    total_heap_node_count: u64;
    pointer_scan_level_summaries: &'summaries [PointerScanLevelSummary];
}

pub machine PointerScanSummary::new<'summaries>(
    session_id: u64,
    target_descriptor: PointerScanTargetDescriptor,
    address_space: PointerScanAddressSpace,
    pointer_size: PointerScanPointerSize,
    max_depth: u64,
    offset_radius: u64,
    root_node_count: u64,
    total_node_count: u64,
    total_static_node_count: u64,
    total_heap_node_count: u64,
    pointer_scan_level_summaries: &'summaries [PointerScanLevelSummary]
) -> PointerScanSummary<'summaries> {
    PointerScanSummary {
        session_id: session_id,
        target_descriptor: target_descriptor,
        address_space: address_space,
        pointer_size: pointer_size,
        max_depth: max_depth,
        offset_radius: offset_radius,
        root_node_count: root_node_count,
        total_node_count: total_node_count,
        total_static_node_count: total_static_node_count,
        total_heap_node_count: total_heap_node_count,
        pointer_scan_level_summaries: pointer_scan_level_summaries
    }
}

pub machine PointerScanSummary::get_session_id(&self) -> u64 { self.session_id }

pub machine PointerScanSummary::get_target_descriptor(&self) -> PointerScanTargetDescriptor {
    self.target_descriptor
}

pub machine PointerScanSummary::get_address_space(&self) -> PointerScanAddressSpace { self.address_space }

pub machine PointerScanSummary::get_pointer_size(&self) -> PointerScanPointerSize { self.pointer_size }

pub machine PointerScanSummary::get_max_depth(&self) -> u64 { self.max_depth }

pub machine PointerScanSummary::get_offset_radius(&self) -> u64 { self.offset_radius }

pub machine PointerScanSummary::get_root_node_count(&self) -> u64 { self.root_node_count }

pub machine PointerScanSummary::get_total_node_count(&self) -> u64 { self.total_node_count }

pub machine PointerScanSummary::get_total_static_node_count(&self) -> u64 { self.total_static_node_count }

pub machine PointerScanSummary::get_total_heap_node_count(&self) -> u64 { self.total_heap_node_count }

pub machine PointerScanSummary::get_pointer_scan_level_summaries<'summaries>(
    &self
) -> &'summaries [PointerScanLevelSummary] {
    self.pointer_scan_level_summaries
}

// Owned counterpart of PointerScanSummary for command responses — upstream
// `Option<PointerScanSummary>` on the wire must outlive the summary borrow,
// so the bounded list is embedded here (8 levels bounds upstream's
// `max_depth`-sized Vec; deeper scans truncate the summary list, a named
// deviation; the scalar counts stay exact).
pub data StoredPointerScanSummary {
    session_id: u64;
    target_descriptor: PointerScanTargetDescriptor;
    address_space: PointerScanAddressSpace;
    pointer_size: PointerScanPointerSize;
    max_depth: u64;
    offset_radius: u64;
    root_node_count: u64;
    total_node_count: u64;
    total_static_node_count: u64;
    total_heap_node_count: u64;
    level_summaries: [PointerScanLevelSummary; 8];
    level_summary_count: u64;
}

pub machine StoredPointerScanSummary::empty() -> StoredPointerScanSummary {
    StoredPointerScanSummary { level_summary_count: 0 }
}

pub machine StoredPointerScanSummary::capture(
    pointer_scan_summary: &PointerScanSummary
) -> StoredPointerScanSummary {
    let mut stored: StoredPointerScanSummary = StoredPointerScanSummary {
        session_id: pointer_scan_summary.get_session_id(),
        target_descriptor: pointer_scan_summary.get_target_descriptor(),
        address_space: pointer_scan_summary.get_address_space(),
        pointer_size: pointer_scan_summary.get_pointer_size(),
        max_depth: pointer_scan_summary.get_max_depth(),
        offset_radius: pointer_scan_summary.get_offset_radius(),
        root_node_count: pointer_scan_summary.get_root_node_count(),
        total_node_count: pointer_scan_summary.get_total_node_count(),
        total_static_node_count: pointer_scan_summary.get_total_static_node_count(),
        total_heap_node_count: pointer_scan_summary.get_total_heap_node_count(),
        level_summary_count: 0,
    };
    transition { _ -> fill(stored, pointer_scan_summary.get_pointer_scan_level_summaries(), 0) }

    state fill(
        stored: StoredPointerScanSummary,
        level_summaries: &[PointerScanLevelSummary],
        position: u64
    ) -> StoredPointerScanSummary {
        transition position < level_summaries.len && position < 8 {
            true -> copy(stored, level_summaries, position)
            false -> (stored)
            _ -> (stored)
        }
    }
    state copy(
        stored: StoredPointerScanSummary,
        level_summaries: &[PointerScanLevelSummary],
        position: u64 [0..8]
    ) -> StoredPointerScanSummary {
        let mut next: StoredPointerScanSummary = stored;
        next.level_summaries[position] = level_summaries[position];
        next.level_summary_count = ((next.level_summary_count as u64 in Wrapping) + 1) as u64;
        transition { _ -> fill(next, level_summaries, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

// Scalar-fields variant of `capture` — same fill loop, for callers that
// already hold the summary's scalars without a live `PointerScanSummary`
// view (the start/validate executors, where the results' borrowed extents
// are torn down before the response is built).
pub machine StoredPointerScanSummary::of_scalars(
    session_id: u64,
    target_descriptor: PointerScanTargetDescriptor,
    address_space: PointerScanAddressSpace,
    pointer_size: PointerScanPointerSize,
    max_depth: u64,
    offset_radius: u64,
    root_node_count: u64,
    total_node_count: u64,
    total_static_node_count: u64,
    total_heap_node_count: u64,
    level_summaries: &[PointerScanLevelSummary; 8],
    level_count: u64
) -> StoredPointerScanSummary {
    let mut stored: StoredPointerScanSummary = StoredPointerScanSummary {
        session_id: session_id,
        target_descriptor: target_descriptor,
        address_space: address_space,
        pointer_size: pointer_size,
        max_depth: max_depth,
        offset_radius: offset_radius,
        root_node_count: root_node_count,
        total_node_count: total_node_count,
        total_static_node_count: total_static_node_count,
        total_heap_node_count: total_heap_node_count,
        level_summary_count: 0,
    };
    transition { _ -> fill(stored, level_summaries, level_count, 0) }

    state fill(
        stored: StoredPointerScanSummary,
        level_summaries: &[PointerScanLevelSummary; 8],
        level_count: u64,
        position: u64
    ) -> StoredPointerScanSummary {
        transition position < level_count && position < 8 {
            true -> copy(stored, level_summaries, level_count, position)
            false -> (stored)
            _ -> (stored)
        }
    }
    state copy(
        stored: StoredPointerScanSummary,
        level_summaries: &[PointerScanLevelSummary; 8],
        level_count: u64,
        position: u64 [0..8]
    ) -> StoredPointerScanSummary {
        let mut next: StoredPointerScanSummary = stored;
        next.level_summaries[position] = level_summaries[position];
        next.level_summary_count = ((next.level_summary_count as u64 in Wrapping) + 1) as u64;
        transition { _ -> fill(next, level_summaries, level_count, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

pub machine StoredPointerScanSummary::get_session_id(&self) -> u64 { self.session_id }

pub machine StoredPointerScanSummary::get_target_descriptor(&self) -> PointerScanTargetDescriptor {
    self.target_descriptor
}

pub machine StoredPointerScanSummary::get_root_node_count(&self) -> u64 { self.root_node_count }

pub machine StoredPointerScanSummary::get_total_node_count(&self) -> u64 { self.total_node_count }

pub machine StoredPointerScanSummary::get_total_static_node_count(&self) -> u64 {
    self.total_static_node_count
}

pub machine StoredPointerScanSummary::get_total_heap_node_count(&self) -> u64 {
    self.total_heap_node_count
}

pub machine StoredPointerScanSummary::get_level_summary_count(&self) -> u64 {
    self.level_summary_count
}

pub machine StoredPointerScanSummary::get_level_summary(&self, position: u64) -> PointerScanLevelSummary {
    transition position < self.level_summary_count && position < 8 {
        true -> (self.level_summaries[position])
        false -> (PointerScanLevelSummary::new(0, 0, 0, 0))
        _ -> (PointerScanLevelSummary::new(0, 0, 0, 0))
    }
}
