module src::structures::pointer_scans::pointer_scan_address_space;


// Port of PointerScanAddressSpace. Upstream label()/Display differ; both are
// ported. from_str returns the Parse carrier since Optional payloads cannot
// be destructured in this pin.
pub data PointerScanAddressSpace [copy] {
    case Auto;
    case GameMemory;
    case EmulatorMemory;
}

// Display labels ("Auto" / "Virtual memory" / "Host memory").
pub machine PointerScanAddressSpace::get_label(&self) -> &[u8] {
    transition self {
        PointerScanAddressSpace::Auto -> ("Auto")
        PointerScanAddressSpace::GameMemory -> ("Virtual memory")
        PointerScanAddressSpace::EmulatorMemory -> ("Host memory")
    }
}

// Display lowercase spellings ("auto" / "virtual" / "host").
pub machine PointerScanAddressSpace::get_display_name(&self) -> &[u8] {
    transition self {
        PointerScanAddressSpace::Auto -> ("auto")
        PointerScanAddressSpace::GameMemory -> ("virtual")
        PointerScanAddressSpace::EmulatorMemory -> ("host")
    }
}

// Upstream FromStr's Result<Self, String> is nameable here.
pub data PointerScanAddressSpaceParse [copy] {
    case Parsed(address_space: PointerScanAddressSpace);
    case Unsupported;
}

pub machine PointerScanAddressSpace::from_str(text: &[u8]) -> PointerScanAddressSpaceParse {
    transition {
        _ -> try_auto(text)
    }
    state try_auto(text: &[u8]) -> PointerScanAddressSpaceParse {
        transition (ascii_eq(text, ("auto")) || ascii_eq(text, ("default"))) {
            true -> (PointerScanAddressSpaceParse::Parsed { address_space: PointerScanAddressSpace::Auto })
            false -> try_game(text)
        }
    }
    state try_game(text: &[u8]) -> PointerScanAddressSpaceParse {
        transition (ascii_eq(text, ("game")) || ascii_eq(text, ("guest")) || ascii_eq(text, ("virtual")) || ascii_eq(text, ("virtual-modules")) || ascii_eq(text, ("virtualmodules"))) {
            true -> (PointerScanAddressSpaceParse::Parsed { address_space: PointerScanAddressSpace::GameMemory })
            false -> try_host(text)
        }
    }
    state try_host(text: &[u8]) -> PointerScanAddressSpaceParse {
        transition (ascii_eq(text, ("emulator")) || ascii_eq(text, ("host")) || ascii_eq(text, ("raw")) || ascii_eq(text, ("usermode")) || ascii_eq(text, ("user-mode"))) {
            true -> (PointerScanAddressSpaceParse::Parsed { address_space: PointerScanAddressSpace::EmulatorMemory })
            false -> (PointerScanAddressSpaceParse::Unsupported)
        }
    }
}

// Upstream trims then lowercases before matching; lowercasing is ported.
// Recorded deviation: ASCII whitespace trimming is not spelled — callers pass
// the already-trimmed token (the CLI tokenizers produce trimmed input).
machine ascii_eq(text: &[u8], expected: &[u8]) -> bool {
    transition {
        _ -> fold(text, expected, 0)
    }
    state fold(text: &[u8], expected: &[u8], position: u64) -> bool {
        transition (position < expected.len) {
            true -> inspect(text, expected, position)
            false -> (text.len == expected.len)
        }
    }
    state inspect(text: &[u8], expected: &[u8], position: u64) -> bool {
        transition (position >= text.len) {
            true -> (false)
            false -> compare(text, expected, position)
        }
    }
    state compare(text: &[u8], expected: &[u8], position: u64) -> bool {
        let lower: u8 = lower_of(text[position]);
        transition (lower != expected[position]) {
            true -> (false)
            false -> fold(text, expected, position + 1)
        }
    }
}

machine lower_of(byte: u8) -> u8 {
    transition (byte >= 65 && byte <= 90) {
        true -> (byte + 32)
        false -> (byte)
    }
}
