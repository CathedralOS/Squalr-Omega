module src::structures::pointer_scans::pointer_scan_candidate;

use src::structures::pointer_scans::pointer_scan_node_type::PointerScanNodeType;

// Port of PointerScanCandidate (usize -> u64 as elsewhere).
public data PointerScanCandidate [copy] {
    candidate_id: u64;
    discovery_depth: u64;
    pointer_scan_node_type: PointerScanNodeType;
    pointer_address: u64;
    pointer_value: u64;
    module_index: u64;
    module_offset: u64;
}

public machine PointerScanCandidate::new(
    candidate_id: u64,
    discovery_depth: u64,
    pointer_scan_node_type: PointerScanNodeType,
    pointer_address: u64,
    pointer_value: u64,
    module_index: u64,
    module_offset: u64
) -> PointerScanCandidate {
    (PointerScanCandidate {
        candidate_id: candidate_id,
        discovery_depth: discovery_depth,
        pointer_scan_node_type: pointer_scan_node_type,
        pointer_address: pointer_address,
        pointer_value: pointer_value,
        module_index: module_index,
        module_offset: module_offset,
    })
}

public machine PointerScanCandidate::get_candidate_id(this: &PointerScanCandidate) -> u64 { this.candidate_id }
public machine PointerScanCandidate::get_discovery_depth(this: &PointerScanCandidate) -> u64 { this.discovery_depth }
public machine PointerScanCandidate::get_pointer_scan_node_type(this: &PointerScanCandidate) -> PointerScanNodeType { this.pointer_scan_node_type }
public machine PointerScanCandidate::get_pointer_address(this: &PointerScanCandidate) -> u64 { this.pointer_address }
public machine PointerScanCandidate::get_pointer_value(this: &PointerScanCandidate) -> u64 { this.pointer_value }
public machine PointerScanCandidate::get_module_index(this: &PointerScanCandidate) -> u64 { this.module_index }
public machine PointerScanCandidate::get_module_offset(this: &PointerScanCandidate) -> u64 { this.module_offset }
