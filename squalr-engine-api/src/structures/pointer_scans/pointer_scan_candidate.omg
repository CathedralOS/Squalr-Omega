module src::structures::pointer_scans::pointer_scan_candidate;

use src::structures::pointer_scans::pointer_scan_node_type::PointerScanNodeType;

// Port of PointerScanCandidate (usize -> u64 as elsewhere).
pub data PointerScanCandidate [copy] {
    candidate_id: u64;
    discovery_depth: u64;
    pointer_scan_node_type: PointerScanNodeType;
    pointer_address: u64;
    pointer_value: u64;
    module_index: u64;
    module_offset: u64;
}

pub machine PointerScanCandidate::new(
    candidate_id: u64,
    discovery_depth: u64,
    pointer_scan_node_type: PointerScanNodeType,
    pointer_address: u64,
    pointer_value: u64,
    module_index: u64,
    module_offset: u64
) -> PointerScanCandidate {
    (PointerScanCandidate {
        candidate_id: candidate_id,
        discovery_depth: discovery_depth,
        pointer_scan_node_type: pointer_scan_node_type,
        pointer_address: pointer_address,
        pointer_value: pointer_value,
        module_index: module_index,
        module_offset: module_offset,
    })
}

pub machine PointerScanCandidate::get_candidate_id(pointer_scan_candidate: &PointerScanCandidate) -> u64 { pointer_scan_candidate.candidate_id }
pub machine PointerScanCandidate::get_discovery_depth(pointer_scan_candidate: &PointerScanCandidate) -> u64 { pointer_scan_candidate.discovery_depth }
pub machine PointerScanCandidate::get_pointer_scan_node_type(pointer_scan_candidate: &PointerScanCandidate) -> PointerScanNodeType { pointer_scan_candidate.pointer_scan_node_type }
pub machine PointerScanCandidate::get_pointer_address(pointer_scan_candidate: &PointerScanCandidate) -> u64 { pointer_scan_candidate.pointer_address }
pub machine PointerScanCandidate::get_pointer_value(pointer_scan_candidate: &PointerScanCandidate) -> u64 { pointer_scan_candidate.pointer_value }
pub machine PointerScanCandidate::get_module_index(pointer_scan_candidate: &PointerScanCandidate) -> u64 { pointer_scan_candidate.module_index }
pub machine PointerScanCandidate::get_module_offset(pointer_scan_candidate: &PointerScanCandidate) -> u64 { pointer_scan_candidate.module_offset }
