module src::structures::pointer_scans::pointer_scan_candidate;

use src::structures::pointer_scans::pointer_scan_node_type::PointerScanNodeType;

// Port of PointerScanCandidate (usize -> u64 as elsewhere).
pub data PointerScanCandidate [copy] {
    candidate_id: u64;
    discovery_depth: u64;
    pointer_scan_node_type: PointerScanNodeType;
    pointer_address: u64;
    pointer_value: u64;
    module_index: u64;
    module_offset: u64;
}

pub machine PointerScanCandidate::new(
    candidate_id: u64,
    discovery_depth: u64,
    pointer_scan_node_type: PointerScanNodeType,
    pointer_address: u64,
    pointer_value: u64,
    module_index: u64,
    module_offset: u64
) -> PointerScanCandidate {
    (PointerScanCandidate {
        candidate_id: candidate_id,
        discovery_depth: discovery_depth,
        pointer_scan_node_type: pointer_scan_node_type,
        pointer_address: pointer_address,
        pointer_value: pointer_value,
        module_index: module_index,
        module_offset: module_offset,
    })
}

pub machine PointerScanCandidate::get_candidate_id(&self) -> u64 { self.candidate_id }
pub machine PointerScanCandidate::get_discovery_depth(&self) -> u64 { self.discovery_depth }
pub machine PointerScanCandidate::get_pointer_scan_node_type(&self) -> PointerScanNodeType { self.pointer_scan_node_type }
pub machine PointerScanCandidate::get_pointer_address(&self) -> u64 { self.pointer_address }
pub machine PointerScanCandidate::get_pointer_value(&self) -> u64 { self.pointer_value }
pub machine PointerScanCandidate::get_module_index(&self) -> u64 { self.module_index }
pub machine PointerScanCandidate::get_module_offset(&self) -> u64 { self.module_offset }
