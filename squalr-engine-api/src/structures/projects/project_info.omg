module src::structures::projects::project_info;

use src::plugins::plugin_configuration::PluginConfiguration;
use src::structures::processes::process_icon::ProcessIcon;
use src::structures::projects::project_manifest::ProjectManifest;
use src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;

// Port of structures/projects/project_info.rs — project identity plus its
// persisted metadata. Carriers: `project_name`/`project_file_path` carry
// upstream's String/PathBuf as bounded bytes + len; `project_icon_rgba` is
// the has_/value Option pair; `plugin_configuration` likewise (upstream
// `set_plugin_configuration` also filters an empty config to None — kept
// as a clear on is_empty).
pub data ProjectInfo {
    project_name: [u8; 256];
    project_name_len: u64;
    project_file_path: [u8; 512];
    project_file_path_len: u64;
    has_project_icon_rgba: bool;
    project_icon_rgba: ProcessIcon;
    project_manifest: ProjectManifest;
    project_symbol_catalog: ProjectSymbolCatalog;
    has_plugin_configuration: bool;
    plugin_configuration: PluginConfiguration;
    has_unsaved_changes: bool;
}

// Upstream `new` — the stored name is the parent directory's final
// component of project_file_path (upstream derives it eagerly at
// construction); callers fill the name through set_project_name using
// that same derived segment, mirroring `ProjectItemRef`'s component walk.
pub machine ProjectInfo::new(
    project_file_path: &[u8],
    project_icon_rgba: &ProcessIcon,
    project_manifest: ProjectManifest
) -> ProjectInfo {
    let mut created: ProjectInfo = ProjectInfo {
        project_name_len: 0,
        project_file_path_len: 0,
        has_project_icon_rgba: true,
        project_icon_rgba: ProcessIcon::default(),
        project_manifest: project_manifest,
        project_symbol_catalog: ProjectSymbolCatalog::new(),
        has_plugin_configuration: false,
        plugin_configuration: PluginConfiguration::new(),
        has_unsaved_changes: true,
    };
    ProcessIcon::clone_from(&mut created.project_icon_rgba, project_icon_rgba);
    ProjectInfo::set_project_file_path(&mut created, project_file_path);
    (created)
}

// Upstream `ProjectInfo::new_with_symbol_catalog` — `new` delegates here
// upstream; the icon's Option rides the package's has_/value pair so the
// deserializer's absent-icon arm constructs without inventing pixels. The
// name is upstream's eager derivation — the parent directory's final
// component, copied into `project_name` (upstream derives at construction;
// the buffered spelling keeps `set_project_name`'s borrow off `self`).
pub machine ProjectInfo::new_with_symbol_catalog(
    project_file_path: &[u8],
    has_project_icon_rgba: bool,
    project_icon_rgba: &ProcessIcon,
    project_manifest: ProjectManifest,
    project_symbol_catalog: ProjectSymbolCatalog
) -> ProjectInfo {
    let mut created: ProjectInfo = ProjectInfo {
        project_name_len: 0,
        project_file_path_len: 0,
        has_project_icon_rgba: has_project_icon_rgba,
        project_icon_rgba: ProcessIcon::default(),
        project_manifest: project_manifest,
        project_symbol_catalog: project_symbol_catalog,
        has_plugin_configuration: false,
        plugin_configuration: PluginConfiguration::new(),
        has_unsaved_changes: true,
    };
    // Upstream `Option<ProcessIcon>` — the absent arm leaves the default
    // pixels under has_=false, so the clone runs unconditionally.
    ProcessIcon::clone_from(&mut created.project_icon_rgba, project_icon_rgba);
    ProjectInfo::set_project_file_path(&mut created, project_file_path);
    let mut name_buffer: [u8; 256];
    let name_len: u64 = ProjectInfo::copy_derived_project_name(&created, &mut name_buffer);
    transition name_len <= 256 {
        true -> named(created, name_buffer, name_len)
        false -> (created)
        _ -> (created)
    }
    state named(created: ProjectInfo, name_buffer: [u8; 256], name_len: u64) -> ProjectInfo
        requires name_len <= 256;
    {
        let mut carried: ProjectInfo = created;
        let name_view: &[u8] = &name_buffer[0..name_len];
        ProjectInfo::set_project_name(&mut carried, name_view);
        (carried)
    }
}

// The parent directory's final path component, copied into the caller's
// buffer — upstream `project_file_path.parent().file_name()` at
// construction: the trailing separator ends the file component at `end`,
// and the component bounded by the separator before it names the parent
// ("<Unknown project name>" when no name-bearing component exists,
// matching upstream's fallback). Fill-spelling like
// `ProjectItemRef::copy_file_or_directory_name`.
pub machine ProjectInfo::copy_derived_project_name(project_info: &ProjectInfo, out_name: &mut [u8; 256]) -> u64 {
    transition {
        _ -> scan_end(project_info, out_name, project_info.project_file_path_len)
    }
    // scan_end — walk back for the separator that ends the file component;
    // its index is the parent path's end.
    state scan_end(project_info: &ProjectInfo, out_name: &mut [u8; 256], position: u64) -> u64 {
        transition 0 < position && position <= project_info.project_file_path_len {
            true -> probe_end(project_info, out_name, position)
            false -> unknown(project_info, out_name)
            _ -> unknown(project_info, out_name)
        }
    }
    state probe_end(project_info: &ProjectInfo, out_name: &mut [u8; 256], position: u64) -> u64 {
        let index: u64 = position - 1;
        transition index < project_info.project_file_path_len && index < 512 {
            true -> inspect_end(project_info, out_name, index)
            false -> unknown(project_info, out_name)
            _ -> unknown(project_info, out_name)
        }
    }
    state inspect_end(project_info: &ProjectInfo, out_name: &mut [u8; 256], index: u64) -> u64
        requires index < 512 && index < project_info.project_file_path_len;
    {
        let byte: u8 = project_info.project_file_path[index];
        transition byte == 47 || byte == 92 {
            true -> scan_start(project_info, out_name, index, index)
            false -> scan_end(project_info, out_name, index)
            _ -> unknown(project_info, out_name)
        }
    }
    // scan_start — walk back from the parent end for the separator that
    // opens the parent's own name; no second separator means the name
    // starts at 0 (a relative one-level path like "./dir/file").
    state scan_start(project_info: &ProjectInfo, out_name: &mut [u8; 256], cursor: u64, end: u64) -> u64
        requires cursor <= end && end <= 512 && end <= project_info.project_file_path_len;
    {
        transition 0 < cursor {
            true -> probe_start(project_info, out_name, cursor, end)
            false -> emit(project_info, out_name, 0, end)
            _ -> emit(project_info, out_name, 0, end)
        }
    }
    state probe_start(project_info: &ProjectInfo, out_name: &mut [u8; 256], cursor: u64, end: u64) -> u64
        requires 0 < cursor && cursor <= end && end <= 512 && end <= project_info.project_file_path_len;
    {
        let position: u64 = cursor - 1;
        transition position < 512 && position < project_info.project_file_path_len {
            true -> inspect_start(project_info, out_name, position, cursor, end)
            false -> emit(project_info, out_name, 0, end)
            _ -> emit(project_info, out_name, 0, end)
        }
    }
    state inspect_start(project_info: &ProjectInfo, out_name: &mut [u8; 256], position: u64, cursor: u64, end: u64) -> u64
        requires position < 512 && cursor <= end && end <= 512 && end <= project_info.project_file_path_len;
    {
        let byte: u8 = project_info.project_file_path[position];
        transition byte == 47 || byte == 92 {
            true -> emit(project_info, out_name, cursor, end)
            false -> guard_walk(project_info, out_name, position, end)
            _ -> emit(project_info, out_name, 0, end)
        }
    }
    // The walk's `position = cursor - 1` origin cannot state `position <=
    // end` as a contract fact, so the recursion enters through a guard.
    state guard_walk(project_info: &ProjectInfo, out_name: &mut [u8; 256], position: u64, end: u64) -> u64
        requires position < 512 && end <= 512 && end <= project_info.project_file_path_len;
    {
        transition position <= end && end <= 512 && end <= project_info.project_file_path_len {
            true -> scan_start(project_info, out_name, position, end)
            false -> emit(project_info, out_name, 0, end)
            _ -> emit(project_info, out_name, 0, end)
        }
    }
    state emit(project_info: &ProjectInfo, out_name: &mut [u8; 256], start: u64, end: u64) -> u64
        requires start <= end && end <= 512 && end <= project_info.project_file_path_len;
    {
        transition {
            _ -> fill(project_info, out_name, start, end, 0)
        }
    }
    state fill(project_info: &ProjectInfo, out_name: &mut [u8; 256], cursor: u64, end: u64, copied: u64) -> u64
        requires cursor <= end && end <= 512 && end <= project_info.project_file_path_len;
    {
        transition cursor < end && copied < 256 {
            true -> store_name(project_info, out_name, cursor, end, copied)
            false -> (copied)
            _ -> (copied)
        }
    }
    state store_name(project_info: &ProjectInfo, out_name: &mut [u8; 256], cursor: u64, end: u64, copied: u64) -> u64
        requires cursor < 512 && copied < 256;
    {
        out_name[copied] = project_info.project_file_path[cursor];
        transition cursor + 1 <= end && end <= 512 && end <= project_info.project_file_path_len {
            true -> fill(project_info, out_name, cursor + 1, end, copied + 1)
            false -> (copied + 1)
            _ -> (copied + 1)
        }
    }
    state unknown(project_info: &ProjectInfo, out_name: &mut [u8; 256]) -> u64 {
        let label: &[u8] = "<Unknown project name>";
        transition {
            _ -> fill_unknown(project_info, out_name, label, 0)
        }
    }
    state fill_unknown(project_info: &ProjectInfo, out_name: &mut [u8; 256], label: &[u8], position: u64) -> u64 {
        transition position < label.len && position < 256 {
            true -> store_unknown(project_info, out_name, label, position)
            false -> (position)
            _ -> (position)
        }
    }
    state store_unknown(project_info: &ProjectInfo, out_name: &mut [u8; 256], label: &[u8], position: u64) -> u64
        requires position < 256 && position < label.len;
    {
        out_name[position] = label[position];
        transition {
            _ -> fill_unknown(project_info, out_name, label, position + 1)
        }
    }
}

pub machine ProjectInfo::default() -> ProjectInfo {
    (ProjectInfo {
        project_name_len: 0,
        project_file_path_len: 0,
        has_project_icon_rgba: false,
        project_icon_rgba: ProcessIcon::default(),
        project_manifest: ProjectManifest::default(),
        project_symbol_catalog: ProjectSymbolCatalog::new(),
        has_plugin_configuration: false,
        plugin_configuration: PluginConfiguration::new(),
        has_unsaved_changes: false,
    })
}

pub machine ProjectInfo::get_name(project_info: &ProjectInfo) -> &[u8] {
    transition project_info.project_name_len <= 256 {
        true -> (&project_info.project_name[0..project_info.project_name_len])
        false -> (&project_info.project_name[0..256])
        _ -> (&project_info.project_name[0..256])
    }
}

pub machine ProjectInfo::set_project_name(project_info: &mut ProjectInfo, project_name: &[u8]) {
    project_info.project_name_len = 0;
    transition {
        _ -> copy_name(project_info, project_name, 0)
    }
    state copy_name(project_info: &mut ProjectInfo, project_name: &[u8], position: u64) {
        transition position < project_name.len && position < 256 {
            true -> store_name(project_info, project_name, position)
            false -> finish_name(project_info, position)
        }
    }
    state store_name(project_info: &mut ProjectInfo, project_name: &[u8], position: u64) {
        project_info.project_name[position] = project_name[position];
        transition {
            _ -> copy_name(project_info, project_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_name(project_info: &mut ProjectInfo, count: u64) {
        project_info.project_name_len = count;
    }
}

pub machine ProjectInfo::get_project_file_path(project_info: &ProjectInfo) -> &[u8] {
    transition project_info.project_file_path_len <= 512 {
        true -> (&project_info.project_file_path[0..project_info.project_file_path_len])
        false -> (&project_info.project_file_path[0..512])
        _ -> (&project_info.project_file_path[0..512])
    }
}

pub machine ProjectInfo::set_project_file_path(project_info: &mut ProjectInfo, project_file_path: &[u8]) {
    project_info.project_file_path_len = 0;
    transition {
        _ -> copy_path(project_info, project_file_path, 0)
    }
    state copy_path(project_info: &mut ProjectInfo, project_file_path: &[u8], position: u64) {
        transition position < project_file_path.len && position < 512 {
            true -> store_path(project_info, project_file_path, position)
            false -> finish_path(project_info, position)
        }
    }
    state store_path(project_info: &mut ProjectInfo, project_file_path: &[u8], position: u64) {
        project_info.project_file_path[position] = project_file_path[position];
        transition {
            _ -> copy_path(project_info, project_file_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_path(project_info: &mut ProjectInfo, count: u64) {
        project_info.project_file_path_len = count;
    }
}

pub machine ProjectInfo::has_project_icon_rgba(project_info: &ProjectInfo) -> bool {
    project_info.has_project_icon_rgba
}

pub machine ProjectInfo::get_project_icon_rgba(project_info: &ProjectInfo) -> &ProcessIcon {
    &project_info.project_icon_rgba
}

// Upstream `set_project_icon(Option<ProcessIcon>)` — the set leg stores the
// icon; clear_project_icon_rgba is the None leg.
pub machine ProjectInfo::set_project_icon(project_info: &mut ProjectInfo, project_icon: &ProcessIcon) {
    ProcessIcon::clone_from(&mut project_info.project_icon_rgba, project_icon);
    project_info.has_project_icon_rgba = true;
}

pub machine ProjectInfo::clear_project_icon_rgba(project_info: &mut ProjectInfo) {
    project_info.has_project_icon_rgba = false;
}

pub machine ProjectInfo::get_project_manifest(project_info: &ProjectInfo) -> &ProjectManifest {
    (&project_info.project_manifest)
}

pub machine ProjectInfo::borrow_project_manifest_mut(project_info: &mut ProjectInfo) -> &mut ProjectManifest {
    (&mut project_info.project_manifest)
}

pub machine ProjectInfo::get_project_symbol_catalog(project_info: &ProjectInfo) -> &ProjectSymbolCatalog {
    (&project_info.project_symbol_catalog)
}

pub machine ProjectInfo::borrow_project_symbol_catalog_mut(project_info: &mut ProjectInfo) -> &mut ProjectSymbolCatalog {
    (&mut project_info.project_symbol_catalog)
}

pub machine ProjectInfo::has_plugin_configuration(project_info: &ProjectInfo) -> bool {
    project_info.has_plugin_configuration
}

pub machine ProjectInfo::get_plugin_configuration(project_info: &ProjectInfo) -> &PluginConfiguration {
    &project_info.plugin_configuration
}

// Upstream `set_plugin_configuration` — stores the config; upstream's
// `filter(|config| !config.is_empty())` maps an empty config to the absent
// leg, mirrored by the is_empty check here.
pub machine ProjectInfo::set_plugin_configuration(project_info: &mut ProjectInfo, plugin_configuration: &PluginConfiguration) {
    let is_empty: bool = PluginConfiguration::is_empty(plugin_configuration);
    transition is_empty {
        true -> clear(project_info)
        false -> store(project_info, plugin_configuration)
    }
    state clear(project_info: &mut ProjectInfo) {
        project_info.has_plugin_configuration = false;
    }
    state store(project_info: &mut ProjectInfo, plugin_configuration: &PluginConfiguration) {
        PluginConfiguration::clone_from(&mut project_info.plugin_configuration, plugin_configuration);
        project_info.has_plugin_configuration = true;
    }
}

pub machine ProjectInfo::clear_plugin_configuration(project_info: &mut ProjectInfo) {
    project_info.has_plugin_configuration = false;
}

pub machine ProjectInfo::get_has_unsaved_changes(project_info: &ProjectInfo) -> bool {
    project_info.has_unsaved_changes
}

pub machine ProjectInfo::set_has_unsaved_changes(project_info: &mut ProjectInfo, has_unsaved_changes: bool) {
    project_info.has_unsaved_changes = has_unsaved_changes;
}

pub machine ProjectInfo::clone(source: &ProjectInfo) -> ProjectInfo {
    let mut cloned: ProjectInfo = ProjectInfo::default();
    ProjectInfo::clone_from(&mut cloned, source);
    (cloned)
}

pub machine ProjectInfo::clone_from(project_info: &mut ProjectInfo, source: &ProjectInfo) {
    ProjectInfo::set_project_name(project_info, ProjectInfo::get_name(source));
    ProjectInfo::set_project_file_path(project_info, ProjectInfo::get_project_file_path(source));
    project_info.has_project_icon_rgba = source.has_project_icon_rgba;
    ProcessIcon::clone_from(&mut project_info.project_icon_rgba, &source.project_icon_rgba);
    ProjectManifest::clone_from(&mut project_info.project_manifest, &source.project_manifest);
    ProjectSymbolCatalog::clone_from(&mut project_info.project_symbol_catalog, &source.project_symbol_catalog);
    project_info.has_plugin_configuration = source.has_plugin_configuration;
    PluginConfiguration::clone_from(&mut project_info.plugin_configuration, &source.plugin_configuration);
    project_info.has_unsaved_changes = source.has_unsaved_changes;
}

// Upstream `get_project_directory` — the file path's parent component,
// i.e. every byte up to (not including) the last '/' or '\\'. Empty when
// the file path carries no separator.
pub machine ProjectInfo::get_project_directory(project_info: &ProjectInfo, project_directory: &mut [u8; 512]) -> bool {
    let end: u64 = project_info.project_file_path_len;
    transition end > 0 && end <= 512 {
        true -> walk(project_info, project_directory, end)
        false -> (false)
        _ -> (false)
    }
    state walk(project_info: &ProjectInfo, project_directory: &mut [u8; 512], position: u64) -> bool
        requires position > 0;
    {
        let previous: u64 = position - 1;
        transition previous < 512 {
            true -> probe(project_info, project_directory, previous)
            false -> (false)
        }
    }
    state probe(project_info: &ProjectInfo, project_directory: &mut [u8; 512], previous: u64) -> bool
        requires previous < 512;
    {
        let byte: u8 = project_info.project_file_path[previous];
        transition byte == 47 || byte == 92 {
            true -> finish(project_info, project_directory, previous)
            false -> step(project_info, project_directory, previous)
        }
    }
    state step(project_info: &ProjectInfo, project_directory: &mut [u8; 512], previous: u64) -> bool
        requires previous < 512;
    {
        transition previous > 0 {
            true -> walk(project_info, project_directory, previous)
            false -> (false)
        }
    }
    state finish(project_info: &ProjectInfo, project_directory: &mut [u8; 512], end: u64) -> bool {
        transition { _ -> copy(project_info, project_directory, end, 0) }
    }
    state copy(project_info: &ProjectInfo, project_directory: &mut [u8; 512], end: u64, position: u64) -> bool {
        transition position < end && position < 512 {
            true -> write(project_info, project_directory, end, position)
            false -> (true)
        }
    }
    state write(project_info: &ProjectInfo, project_directory: &mut [u8; 512], end: u64, position: u64) -> bool
        requires position < 512;
    {
        project_directory[position] = project_info.project_file_path[position];
        transition { _ -> copy(project_info, project_directory, end, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}
