module src::structures::projects::project_info;

use src::plugins::plugin_configuration::PluginConfiguration;
use src::structures::processes::process_icon::ProcessIcon;
use src::structures::projects::project_manifest::ProjectManifest;
use src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;

// Port of structures/projects/project_info.rs — project identity plus its
// persisted metadata. Carriers: `project_name`/`project_file_path` carry
// upstream's String/PathBuf as bounded bytes + len; `project_icon_rgba` is
// the has_/value Option pair; `plugin_configuration` likewise (upstream
// `set_plugin_configuration` also filters an empty config to None — kept
// as a clear on is_empty).
pub data ProjectInfo {
    project_name: [u8; 256];
    project_name_len: u64;
    project_file_path: [u8; 512];
    project_file_path_len: u64;
    has_project_icon_rgba: bool;
    project_icon_rgba: ProcessIcon;
    project_manifest: ProjectManifest;
    project_symbol_catalog: ProjectSymbolCatalog;
    has_plugin_configuration: bool;
    plugin_configuration: PluginConfiguration;
    has_unsaved_changes: bool;
}

// Upstream `new` — the stored name is the parent directory's final
// component of project_file_path (upstream derives it eagerly at
// construction); callers fill the name through set_project_name using
// that same derived segment, mirroring `ProjectItemRef`'s component walk.
pub machine ProjectInfo::new(
    project_file_path: &[u8],
    project_icon_rgba: &ProcessIcon,
    project_manifest: ProjectManifest
) -> ProjectInfo {
    let mut created: ProjectInfo = ProjectInfo {
        project_name_len: 0,
        project_file_path_len: 0,
        has_project_icon_rgba: true,
        project_icon_rgba: ProcessIcon::default(),
        project_manifest: project_manifest,
        project_symbol_catalog: ProjectSymbolCatalog::new(),
        has_plugin_configuration: false,
        plugin_configuration: PluginConfiguration::new(),
        has_unsaved_changes: true,
    };
    created.project_icon_rgba.clone_from(project_icon_rgba);
    created.set_project_file_path(project_file_path);
    (created)
}

// Upstream `ProjectInfo::new_with_symbol_catalog` — `new` delegates here
// upstream; the icon's Option rides the package's has_/value pair so the
// deserializer's absent-icon arm constructs without inventing pixels. The
// name is upstream's eager derivation — the parent directory's final
// component, copied into `project_name` (upstream derives at construction;
// the buffered spelling keeps `set_project_name`'s borrow off `self`).
pub machine ProjectInfo::new_with_symbol_catalog(
    project_file_path: &[u8],
    has_project_icon_rgba: bool,
    project_icon_rgba: &ProcessIcon,
    project_manifest: ProjectManifest,
    project_symbol_catalog: ProjectSymbolCatalog
) -> ProjectInfo {
    let mut created: ProjectInfo = ProjectInfo {
        project_name_len: 0,
        project_file_path_len: 0,
        has_project_icon_rgba: has_project_icon_rgba,
        project_icon_rgba: ProcessIcon::default(),
        project_manifest: project_manifest,
        project_symbol_catalog: project_symbol_catalog,
        has_plugin_configuration: false,
        plugin_configuration: PluginConfiguration::new(),
        has_unsaved_changes: true,
    };
    // Upstream `Option<ProcessIcon>` — the absent arm leaves the default
    // pixels under has_=false, so the clone runs unconditionally.
    created.project_icon_rgba.clone_from(project_icon_rgba);
    created.set_project_file_path(project_file_path);
    let mut name_buffer: [u8; 256];
    let name_len: u64 = created.copy_derived_project_name(&mut name_buffer);
    transition name_len <= 256 {
        true -> named(created, name_buffer, name_len)
        false -> (created)
        _ -> (created)
    }
    state named(created: ProjectInfo, name_buffer: [u8; 256], name_len: u64) -> ProjectInfo
        requires name_len <= 256;
    {
        let mut carried: ProjectInfo = created;
        let name_view: &[u8] = &name_buffer[0..name_len];
        carried.set_project_name(name_view);
        (carried)
    }
}

// The parent directory's final path component, copied into the caller's
// buffer — upstream `project_file_path.parent().file_name()` at
// construction: the trailing separator ends the file component at `end`,
// and the component bounded by the separator before it names the parent
// ("<Unknown project name>" when no name-bearing component exists,
// matching upstream's fallback). Fill-spelling like
// `ProjectItemRef::copy_file_or_directory_name`.
pub machine ProjectInfo::copy_derived_project_name(&self, out_name: &mut [u8; 256]) -> u64 {
    transition {
        _ -> scan_end(out_name, self.project_file_path_len)
    }
    // scan_end — walk back for the separator that ends the file component;
    // its index is the parent path's end.
    state scan_end(&self, out_name: &mut [u8; 256], position: u64) -> u64 {
        transition 0 < position && position <= self.project_file_path_len {
            true -> probe_end(out_name, position)
            false -> unknown(out_name)
            _ -> unknown(out_name)
        }
    }
    state probe_end(&self, out_name: &mut [u8; 256], position: u64) -> u64 {
        let index: u64 = position - 1;
        transition index < self.project_file_path_len && index < 512 {
            true -> inspect_end(out_name, index)
            false -> unknown(out_name)
            _ -> unknown(out_name)
        }
    }
    state inspect_end(&self, out_name: &mut [u8; 256], index: u64) -> u64
        requires index < 512 && index < self.project_file_path_len;
    {
        let byte: u8 = self.project_file_path[index];
        transition byte == 47 || byte == 92 {
            true -> scan_start(out_name, index, index)
            false -> scan_end(out_name, index)
            _ -> unknown(out_name)
        }
    }
    // scan_start — walk back from the parent end for the separator that
    // opens the parent's own name; no second separator means the name
    // starts at 0 (a relative one-level path like "./dir/file").
    state scan_start(&self, out_name: &mut [u8; 256], cursor: u64, end: u64) -> u64
        requires cursor <= end && end <= 512 && end <= self.project_file_path_len;
    {
        transition 0 < cursor {
            true -> probe_start(out_name, cursor, end)
            false -> emit(out_name, 0, end)
            _ -> emit(out_name, 0, end)
        }
    }
    state probe_start(&self, out_name: &mut [u8; 256], cursor: u64, end: u64) -> u64
        requires 0 < cursor && cursor <= end && end <= 512 && end <= self.project_file_path_len;
    {
        let position: u64 = cursor - 1;
        transition position < 512 && position < self.project_file_path_len {
            true -> inspect_start(out_name, position, cursor, end)
            false -> emit(out_name, 0, end)
            _ -> emit(out_name, 0, end)
        }
    }
    state inspect_start(&self, out_name: &mut [u8; 256], position: u64, cursor: u64, end: u64) -> u64
        requires position < 512 && cursor <= end && end <= 512 && end <= self.project_file_path_len;
    {
        let byte: u8 = self.project_file_path[position];
        transition byte == 47 || byte == 92 {
            true -> emit(out_name, cursor, end)
            false -> guard_walk(out_name, position, end)
            _ -> emit(out_name, 0, end)
        }
    }
    // The walk's `position = cursor - 1` origin cannot state `position <=
    // end` as a contract fact, so the recursion enters through a guard.
    state guard_walk(&self, out_name: &mut [u8; 256], position: u64, end: u64) -> u64
        requires position < 512 && end <= 512 && end <= self.project_file_path_len;
    {
        transition position <= end && end <= 512 && end <= self.project_file_path_len {
            true -> scan_start(out_name, position, end)
            false -> emit(out_name, 0, end)
            _ -> emit(out_name, 0, end)
        }
    }
    state emit(&self, out_name: &mut [u8; 256], start: u64, end: u64) -> u64
        requires start <= end && end <= 512 && end <= self.project_file_path_len;
    {
        transition {
            _ -> fill(out_name, start, end, 0)
        }
    }
    state fill(&self, out_name: &mut [u8; 256], cursor: u64, end: u64, copied: u64) -> u64
        requires cursor <= end && end <= 512 && end <= self.project_file_path_len;
    {
        transition cursor < end && copied < 256 {
            true -> store_name(out_name, cursor, end, copied)
            false -> (copied)
            _ -> (copied)
        }
    }
    state store_name(&self, out_name: &mut [u8; 256], cursor: u64, end: u64, copied: u64) -> u64
        requires cursor < 512 && copied < 256;
    {
        out_name[copied] = self.project_file_path[cursor];
        transition cursor + 1 <= end && end <= 512 && end <= self.project_file_path_len {
            true -> fill(out_name, cursor + 1, end, copied + 1)
            false -> (copied + 1)
            _ -> (copied + 1)
        }
    }
    state unknown(&self, out_name: &mut [u8; 256]) -> u64 {
        let label: &[u8] = "<Unknown project name>";
        transition {
            _ -> fill_unknown(out_name, label, 0)
        }
    }
    state fill_unknown(&self, out_name: &mut [u8; 256], label: &[u8], position: u64) -> u64 {
        transition position < label.len && position < 256 {
            true -> store_unknown(out_name, label, position)
            false -> (position)
            _ -> (position)
        }
    }
    state store_unknown(&self, out_name: &mut [u8; 256], label: &[u8], position: u64) -> u64
        requires position < 256 && position < label.len;
    {
        out_name[position] = label[position];
        transition {
            _ -> fill_unknown(out_name, label, position + 1)
        }
    }
}

pub machine ProjectInfo::default() -> ProjectInfo {
    (ProjectInfo {
        project_name_len: 0,
        project_file_path_len: 0,
        has_project_icon_rgba: false,
        project_icon_rgba: ProcessIcon::default(),
        project_manifest: ProjectManifest::default(),
        project_symbol_catalog: ProjectSymbolCatalog::new(),
        has_plugin_configuration: false,
        plugin_configuration: PluginConfiguration::new(),
        has_unsaved_changes: false,
    })
}

pub machine ProjectInfo::get_name(&self) -> &[u8] {
    transition self.project_name_len <= 256 {
        true -> (&self.project_name[0..self.project_name_len])
        false -> (&self.project_name[0..256])
        _ -> (&self.project_name[0..256])
    }
}

pub machine ProjectInfo::set_project_name(&mut self, project_name: &[u8]) {
    self.project_name_len = 0;
    transition {
        _ -> copy_name(project_name, 0)
    }
    state copy_name(&mut self, project_name: &[u8], position: u64) {
        transition position < project_name.len && position < 256 {
            true -> store_name(project_name, position)
            false -> finish_name(position)
        }
    }
    state store_name(&mut self, project_name: &[u8], position: u64) {
        self.project_name[position] = project_name[position];
        transition {
            _ -> copy_name(project_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_name(&mut self, count: u64) {
        self.project_name_len = count;
    }
}

pub machine ProjectInfo::get_project_file_path(&self) -> &[u8] {
    transition self.project_file_path_len <= 512 {
        true -> (&self.project_file_path[0..self.project_file_path_len])
        false -> (&self.project_file_path[0..512])
        _ -> (&self.project_file_path[0..512])
    }
}

pub machine ProjectInfo::set_project_file_path(&mut self, project_file_path: &[u8]) {
    self.project_file_path_len = 0;
    transition {
        _ -> copy_path(project_file_path, 0)
    }
    state copy_path(&mut self, project_file_path: &[u8], position: u64) {
        transition position < project_file_path.len && position < 512 {
            true -> store_path(project_file_path, position)
            false -> finish_path(position)
        }
    }
    state store_path(&mut self, project_file_path: &[u8], position: u64) {
        self.project_file_path[position] = project_file_path[position];
        transition {
            _ -> copy_path(project_file_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_path(&mut self, count: u64) {
        self.project_file_path_len = count;
    }
}

pub machine ProjectInfo::has_project_icon_rgba(&self) -> bool {
    self.has_project_icon_rgba
}

pub machine ProjectInfo::get_project_icon_rgba(&self) -> &ProcessIcon {
    &self.project_icon_rgba
}

// Upstream `set_project_icon(Option<ProcessIcon>)` — the set leg stores the
// icon; clear_project_icon_rgba is the None leg.
pub machine ProjectInfo::set_project_icon(&mut self, project_icon: &ProcessIcon) {
    self.project_icon_rgba.clone_from(project_icon);
    self.has_project_icon_rgba = true;
}

pub machine ProjectInfo::clear_project_icon_rgba(&mut self) {
    self.has_project_icon_rgba = false;
}

pub machine ProjectInfo::get_project_manifest(&self) -> &ProjectManifest {
    (&self.project_manifest)
}

pub machine ProjectInfo::borrow_project_manifest_mut(&mut self) -> &mut ProjectManifest {
    (&mut self.project_manifest)
}

pub machine ProjectInfo::get_project_symbol_catalog(&self) -> &ProjectSymbolCatalog {
    (&self.project_symbol_catalog)
}

pub machine ProjectInfo::borrow_project_symbol_catalog_mut(&mut self) -> &mut ProjectSymbolCatalog {
    (&mut self.project_symbol_catalog)
}

pub machine ProjectInfo::has_plugin_configuration(&self) -> bool {
    self.has_plugin_configuration
}

pub machine ProjectInfo::get_plugin_configuration(&self) -> &PluginConfiguration {
    &self.plugin_configuration
}

// Upstream `set_plugin_configuration` — stores the config; upstream's
// `filter(|config| !config.is_empty())` maps an empty config to the absent
// leg, mirrored by the is_empty check here.
pub machine ProjectInfo::set_plugin_configuration(&mut self, plugin_configuration: &PluginConfiguration) {
    let is_empty: bool = plugin_configuration.is_empty();
    transition is_empty {
        true -> clear()
        false -> store(plugin_configuration)
    }
    state clear(&mut self) {
        self.has_plugin_configuration = false;
    }
    state store(&mut self, plugin_configuration: &PluginConfiguration) {
        self.plugin_configuration.clone_from(plugin_configuration);
        self.has_plugin_configuration = true;
    }
}

pub machine ProjectInfo::clear_plugin_configuration(&mut self) {
    self.has_plugin_configuration = false;
}

pub machine ProjectInfo::get_has_unsaved_changes(&self) -> bool {
    self.has_unsaved_changes
}

pub machine ProjectInfo::set_has_unsaved_changes(&mut self, has_unsaved_changes: bool) {
    self.has_unsaved_changes = has_unsaved_changes;
}

pub machine ProjectInfo::clone(source: &ProjectInfo) -> ProjectInfo {
    let mut cloned: ProjectInfo = ProjectInfo::default();
    cloned.clone_from(source);
    (cloned)
}

pub machine ProjectInfo::clone_from(&mut self, source: &ProjectInfo) {
    self.set_project_name(source.get_name());
    self.set_project_file_path(source.get_project_file_path());
    self.has_project_icon_rgba = source.has_project_icon_rgba;
    self.project_icon_rgba.clone_from(&source.project_icon_rgba);
    self.project_manifest.clone_from(&source.project_manifest);
    self.project_symbol_catalog.clone_from(&source.project_symbol_catalog);
    self.has_plugin_configuration = source.has_plugin_configuration;
    self.plugin_configuration.clone_from(&source.plugin_configuration);
    self.has_unsaved_changes = source.has_unsaved_changes;
}

// Upstream `get_project_directory` — the file path's parent component,
// i.e. every byte up to (not including) the last '/' or '\\'. Empty when
// the file path carries no separator.
pub machine ProjectInfo::get_project_directory(&self, project_directory: &mut [u8; 512]) -> bool {
    let end: u64 = self.project_file_path_len;
    transition end > 0 && end <= 512 {
        true -> walk(project_directory, end)
        false -> (false)
        _ -> (false)
    }
    state walk(&self, project_directory: &mut [u8; 512], position: u64) -> bool
        requires position > 0;
    {
        let previous: u64 = position - 1;
        transition previous < 512 {
            true -> probe(project_directory, previous)
            false -> (false)
        }
    }
    state probe(&self, project_directory: &mut [u8; 512], previous: u64) -> bool
        requires previous < 512;
    {
        let byte: u8 = self.project_file_path[previous];
        transition byte == 47 || byte == 92 {
            true -> finish(project_directory, previous)
            false -> step(project_directory, previous)
        }
    }
    state step(&self, project_directory: &mut [u8; 512], previous: u64) -> bool
        requires previous < 512;
    {
        transition previous > 0 {
            true -> walk(project_directory, previous)
            false -> (false)
        }
    }
    state finish(&self, project_directory: &mut [u8; 512], end: u64) -> bool {
        transition { _ -> copy(project_directory, end, 0) }
    }
    state copy(&self, project_directory: &mut [u8; 512], end: u64, position: u64) -> bool {
        transition position < end && position < 512 {
            true -> write(project_directory, end, position)
            false -> (true)
        }
    }
    state write(&self, project_directory: &mut [u8; 512], end: u64, position: u64) -> bool
        requires position < 512;
    {
        project_directory[position] = self.project_file_path[position];
        transition { _ -> copy(project_directory, end, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}
