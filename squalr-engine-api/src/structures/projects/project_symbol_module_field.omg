module src::structures::projects::project_symbol_module_field;

use src::structures::projects::project_symbol_locator::ProjectSymbolLocator;

// Port of structures/projects/project_symbol_module_field.rs — one
// display-named field at an offset inside a symbol module.
pub data ProjectSymbolModuleField {
    display_name: [u8; 256];
    display_name_len: u64;
    offset: u64;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
}

pub machine ProjectSymbolModuleField::default() -> ProjectSymbolModuleField {
    (ProjectSymbolModuleField {
        display_name_len: 0,
        offset: 0,
        struct_layout_id_len: 0,
    })
}

pub machine ProjectSymbolModuleField::new(display_name: &[u8], offset: u64, struct_layout_id: &[u8]) -> ProjectSymbolModuleField {
    let mut field: ProjectSymbolModuleField = (ProjectSymbolModuleField {
        display_name_len: 0,
        offset: offset,
        struct_layout_id_len: 0,
    });
    ProjectSymbolModuleField::set_display_name(&mut field, display_name);
    ProjectSymbolModuleField::set_struct_layout_id(&mut field, struct_layout_id);
    (field)
}

pub machine ProjectSymbolModuleField::get_display_name(this: &ProjectSymbolModuleField) -> &[u8] {
    transition this.display_name_len <= 256 {
        true -> (&this.display_name[0..this.display_name_len])
        false -> (&this.display_name[0..256])
        _ -> (&this.display_name[0..256])
    }
}

pub machine ProjectSymbolModuleField::set_display_name(this: &mut ProjectSymbolModuleField, display_name: &[u8]) {
    this.display_name_len = 0;
    transition {
        _ -> copy(this, display_name, 0)
    }
    state copy(this: &mut ProjectSymbolModuleField, display_name: &[u8], position: u64) {
        transition position < display_name.len && position < 256 {
            true -> store(this, display_name, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ProjectSymbolModuleField, display_name: &[u8], position: u64) {
        this.display_name[position] = display_name[position];
        transition {
            _ -> copy(this, display_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut ProjectSymbolModuleField, count: u64) {
        this.display_name_len = count;
    }
}

pub machine ProjectSymbolModuleField::get_offset(this: &ProjectSymbolModuleField) -> u64 {
    (this.offset)
}

pub machine ProjectSymbolModuleField::set_offset(this: &mut ProjectSymbolModuleField, offset: u64) {
    this.offset = offset;
}

pub machine ProjectSymbolModuleField::get_struct_layout_id(this: &ProjectSymbolModuleField) -> &[u8] {
    transition this.struct_layout_id_len <= 256 {
        true -> (&this.struct_layout_id[0..this.struct_layout_id_len])
        false -> (&this.struct_layout_id[0..256])
        _ -> (&this.struct_layout_id[0..256])
    }
}

pub machine ProjectSymbolModuleField::set_struct_layout_id(this: &mut ProjectSymbolModuleField, struct_layout_id: &[u8]) {
    this.struct_layout_id_len = 0;
    transition {
        _ -> copy(this, struct_layout_id, 0)
    }
    state copy(this: &mut ProjectSymbolModuleField, struct_layout_id: &[u8], position: u64) {
        transition position < struct_layout_id.len && position < 256 {
            true -> store(this, struct_layout_id, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ProjectSymbolModuleField, struct_layout_id: &[u8], position: u64) {
        this.struct_layout_id[position] = struct_layout_id[position];
        transition {
            _ -> copy(this, struct_layout_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut ProjectSymbolModuleField, count: u64) {
        this.struct_layout_id_len = count;
    }
}

pub machine ProjectSymbolModuleField::clone_from(this: &mut ProjectSymbolModuleField, source: &ProjectSymbolModuleField) {
    this.offset = source.offset;
    transition {
        _ -> copy_display_name(this, source, 0)
    }
    state copy_display_name(this: &mut ProjectSymbolModuleField, source: &ProjectSymbolModuleField, position: u64) {
        transition position < source.display_name_len && position < 256 {
            true -> store_display_name(this, source, position)
            false -> copy_layout_id(this, source, 0)
        }
    }
    state store_display_name(this: &mut ProjectSymbolModuleField, source: &ProjectSymbolModuleField, position: u64) {
        this.display_name[position] = source.display_name[position];
        transition {
            _ -> copy_display_name(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state copy_layout_id(this: &mut ProjectSymbolModuleField, source: &ProjectSymbolModuleField, position: u64) {
        this.display_name_len = source.display_name_len;
        transition position < source.struct_layout_id_len && position < 256 {
            true -> store_layout_id(this, source, position)
            false -> finish_layout_id(this, source)
        }
    }
    state store_layout_id(this: &mut ProjectSymbolModuleField, source: &ProjectSymbolModuleField, position: u64) {
        this.struct_layout_id[position] = source.struct_layout_id[position];
        transition {
            _ -> copy_layout_id(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_layout_id(this: &mut ProjectSymbolModuleField, source: &ProjectSymbolModuleField) {
        this.struct_layout_id_len = source.struct_layout_id_len;
    }
}

// Upstream `get_symbol_locator_key` — "module:{name}:{:X}" built from the
// owning module's name and this field's offset.
pub machine ProjectSymbolModuleField::get_symbol_locator_key(this: &ProjectSymbolModuleField, module_name: &[u8], out: &mut [u8; 256]) -> u64 {
    let locator: ProjectSymbolLocator = ProjectSymbolLocator::new_module_offset(module_name, this.offset);
    let hoist1: u64 = ProjectSymbolLocator::to_locator_key(&locator, out);
    (hoist1)
}
