module src::structures::projects::project_symbol_module_field;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::bounded_slice::bounded_slice;

use src::structures::projects::project_symbol_locator::ProjectSymbolLocator;

// Port of structures/projects/project_symbol_module_field.rs — one
// display-named field at an offset inside a symbol module.
pub data ProjectSymbolModuleField {
    display_name: [u8; 256];
    display_name_len: u64;
    offset: u64;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
}

pub machine ProjectSymbolModuleField::default() -> ProjectSymbolModuleField {
    (ProjectSymbolModuleField {
        display_name_len: 0,
        offset: 0,
        struct_layout_id_len: 0,
    })
}

pub machine ProjectSymbolModuleField::new(display_name: &[u8], offset: u64, struct_layout_id: &[u8]) -> ProjectSymbolModuleField {
    let mut field: ProjectSymbolModuleField = (ProjectSymbolModuleField {
        display_name_len: 0,
        offset: offset,
        struct_layout_id_len: 0,
    });
    field.set_display_name(display_name);
    field.set_struct_layout_id(struct_layout_id);
    (field)
}

pub machine ProjectSymbolModuleField::get_display_name(&self) -> &[u8] {
    bounded_slice(&self.display_name[0..256], self.display_name_len)
}

pub machine ProjectSymbolModuleField::set_display_name(&mut self, display_name: &[u8]) {
    self.display_name_len = BoundedByteCopy::copy(&mut self.display_name[0..256], display_name);
}

pub machine ProjectSymbolModuleField::get_offset(&self) -> u64 {
    (self.offset)
}

pub machine ProjectSymbolModuleField::set_offset(&mut self, offset: u64) {
    self.offset = offset;
}

pub machine ProjectSymbolModuleField::get_struct_layout_id(&self) -> &[u8] {
    bounded_slice(&self.struct_layout_id[0..256], self.struct_layout_id_len)
}

pub machine ProjectSymbolModuleField::set_struct_layout_id(&mut self, struct_layout_id: &[u8]) {
    self.struct_layout_id_len = BoundedByteCopy::copy(&mut self.struct_layout_id[0..256], struct_layout_id);
}

pub machine ProjectSymbolModuleField::clone_from(&mut self, source: &ProjectSymbolModuleField) {
    self.offset = source.offset;
    let display_name_view: &[u8] = bounded_slice(&source.display_name[0..256], source.display_name_len);
    let mut copied: u64 = BoundedByteCopy::copy(&mut self.display_name[0..256], display_name_view);
    self.display_name_len = source.display_name_len;
    let struct_layout_id_view: &[u8] = bounded_slice(&source.struct_layout_id[0..256], source.struct_layout_id_len);
    copied = BoundedByteCopy::copy(&mut self.struct_layout_id[0..256], struct_layout_id_view);
    self.struct_layout_id_len = source.struct_layout_id_len;
}

// Upstream `get_symbol_locator_key` — "module:{name}:{:X}" built from the
// owning module's name and this field's offset.
pub machine ProjectSymbolModuleField::get_symbol_locator_key(&self, module_name: &[u8], out: &mut [u8; 256]) -> u64 {
    let locator: ProjectSymbolLocator = ProjectSymbolLocator::new_module_offset(module_name, self.offset);
    (locator.to_locator_key(out))
}
