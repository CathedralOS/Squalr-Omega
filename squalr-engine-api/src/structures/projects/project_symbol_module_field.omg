module src::structures::projects::project_symbol_module_field;

// Port of structures/projects/project_symbol_module_field.rs — one
// display-named field at an offset inside a symbol module.
// Residual: get_symbol_locator_key (format! of a module+offset locator
// key) rides the locator key-format leg.
pub data ProjectSymbolModuleField {
    display_name: [u8; 256];
    display_name_len: u64;
    offset: u64;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
}

pub machine ProjectSymbolModuleField::default() -> ProjectSymbolModuleField {
    (ProjectSymbolModuleField {
        display_name_len: 0,
        offset: 0,
        struct_layout_id_len: 0,
    })
}

pub machine ProjectSymbolModuleField::new(display_name: &[u8], offset: u64, struct_layout_id: &[u8]) -> ProjectSymbolModuleField {
    let mut field: ProjectSymbolModuleField = (ProjectSymbolModuleField {
        display_name_len: 0,
        offset: offset,
        struct_layout_id_len: 0,
    });
    field.set_display_name(display_name);
    field.set_struct_layout_id(struct_layout_id);
    (field)
}

pub machine ProjectSymbolModuleField::get_display_name(&self) -> &[u8] {
    transition self.display_name_len <= 256 {
        true -> (&self.display_name[0..self.display_name_len])
        false -> (&self.display_name[0..256])
        _ -> (&self.display_name[0..256])
    }
}

pub machine ProjectSymbolModuleField::set_display_name(&mut self, display_name: &[u8]) {
    self.display_name_len = 0;
    transition {
        _ -> copy(display_name, 0)
    }
    state copy(&mut self, display_name: &[u8], position: u64) {
        transition position < display_name.len && position < 256 {
            true -> store(display_name, position)
            false -> finish(position)
        }
    }
    state store(&mut self, display_name: &[u8], position: u64) {
        self.display_name[position] = display_name[position];
        transition {
            _ -> copy(display_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.display_name_len = count;
    }
}

pub machine ProjectSymbolModuleField::get_offset(&self) -> u64 {
    (self.offset)
}

pub machine ProjectSymbolModuleField::set_offset(&mut self, offset: u64) {
    self.offset = offset;
}

pub machine ProjectSymbolModuleField::get_struct_layout_id(&self) -> &[u8] {
    transition self.struct_layout_id_len <= 256 {
        true -> (&self.struct_layout_id[0..self.struct_layout_id_len])
        false -> (&self.struct_layout_id[0..256])
        _ -> (&self.struct_layout_id[0..256])
    }
}

pub machine ProjectSymbolModuleField::set_struct_layout_id(&mut self, struct_layout_id: &[u8]) {
    self.struct_layout_id_len = 0;
    transition {
        _ -> copy(struct_layout_id, 0)
    }
    state copy(&mut self, struct_layout_id: &[u8], position: u64) {
        transition position < struct_layout_id.len && position < 256 {
            true -> store(struct_layout_id, position)
            false -> finish(position)
        }
    }
    state store(&mut self, struct_layout_id: &[u8], position: u64) {
        self.struct_layout_id[position] = struct_layout_id[position];
        transition {
            _ -> copy(struct_layout_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.struct_layout_id_len = count;
    }
}

pub machine ProjectSymbolModuleField::clone_from(&mut self, source: &ProjectSymbolModuleField) {
    self.offset = source.offset;
    transition {
        _ -> copy_display_name(source, 0)
    }
    state copy_display_name(&mut self, source: &ProjectSymbolModuleField, position: u64) {
        transition position < source.display_name_len && position < 256 {
            true -> store_display_name(source, position)
            false -> copy_layout_id(source, 0)
        }
    }
    state store_display_name(&mut self, source: &ProjectSymbolModuleField, position: u64) {
        self.display_name[position] = source.display_name[position];
        transition {
            _ -> copy_display_name(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state copy_layout_id(&mut self, source: &ProjectSymbolModuleField, position: u64) {
        self.display_name_len = source.display_name_len;
        transition position < source.struct_layout_id_len && position < 256 {
            true -> store_layout_id(source, position)
            false -> finish_layout_id(source)
        }
    }
    state store_layout_id(&mut self, source: &ProjectSymbolModuleField, position: u64) {
        self.struct_layout_id[position] = source.struct_layout_id[position];
        transition {
            _ -> copy_layout_id(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_layout_id(&mut self, source: &ProjectSymbolModuleField) {
        self.struct_layout_id_len = source.struct_layout_id_len;
    }
}
