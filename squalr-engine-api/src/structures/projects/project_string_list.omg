module src::structures::projects::project_string_list;

// Port-side bounded `Vec<String>` carrier shared by the project command
// surface (upstream's command structs carry unbounded string lists —
// symbol_locator_keys, module_names, promoted keys, field definitions).
// 64 entries of 256 bytes each; `add_string` refuses past the bound rather
// than truncating, matching the StructScanDataTypeIdList precedent.
pub data ProjectStringList {
    strings: [[u8; 256]; 64];
    string_lens: [u64; 64];
    string_count: u64;
}

pub machine ProjectStringList::default() -> ProjectStringList {
    (ProjectStringList::empty())
}

pub machine ProjectStringList::empty() -> ProjectStringList {
    ProjectStringList {
        string_count: 0,
    }
}

pub machine ProjectStringList::get_string_count(this: &ProjectStringList) -> u64 {
    this.string_count
}

// Upstream `strings[index]` — byte-slice read of one stored string;
// out-of-range reads fall back to the head entry (callers gate on
// get_string_count).
pub machine ProjectStringList::get_string(this: &ProjectStringList, position: u64) -> &[u8] {
    transition position < this.string_count && position < 64 {
        true -> at(this, position)
        false -> head(this)
        _ -> head(this)
    }
    state at(this: &ProjectStringList, position: u64) -> &[u8]
        requires 0 <= position && position < 64;
    {
        let len: u64 = this.string_lens[position];
        transition len <= 256 {
            true -> (&this.strings[position][0..len])
            false -> (&this.strings[position][0..256])
            _ -> (&this.strings[position][0..256])
        }
    }
    state head(this: &ProjectStringList) -> &[u8] {
        transition this.string_lens[0] <= 256 {
            true -> (&this.strings[0][0..this.string_lens[0]])
            false -> (&this.strings[0][0..256])
            _ -> (&this.strings[0][0..256])
        }
    }
}

// Upstream Vec::push — appends one bounded string; refuses past 64.
pub machine ProjectStringList::add_string(this: &mut ProjectStringList, text: &[u8]) -> bool {
    transition this.string_count < 64 {
        true -> store(this, text)
        false -> (false)
        _ -> (false)
    }
    state store(this: &mut ProjectStringList, text: &[u8]) -> bool {
        let index: u64 = this.string_count;
        transition index < 64 {
            true -> fill(this, text, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill(this: &mut ProjectStringList, text: &[u8], index: u64) -> bool
        requires 0 <= index && index < 64
    {
        this.string_lens[index] = 0;
        transition {
            _ -> copy(this, text, index, 0)
        }
    }
    state copy(this: &mut ProjectStringList, text: &[u8], index: u64, position: u64) -> bool
        requires 0 <= index && index < 64
    {
        transition position < text.len && position < 256 {
            true -> write(this, text, index, position)
            false -> finish(this, index, position)
        }
    }
    state write(this: &mut ProjectStringList, text: &[u8], index: u64, position: u64) -> bool
        requires 0 <= index && index < 64 && position < 256
    {
        this.strings[index][position] = text[position];
        transition {
            _ -> copy(this, text, index, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut ProjectStringList, index: u64, count: u64) -> bool
        requires 0 <= index && index < 64
    {
        this.string_lens[index] = count;
        this.string_count = index + 1;
        (true)
    }
}
