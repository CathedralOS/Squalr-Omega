module src::structures::projects::project_string_list;

// Port-side bounded `Vec<String>` carrier shared by the project command
// surface (upstream's command structs carry unbounded string lists —
// symbol_locator_keys, module_names, promoted keys, field definitions).
// 64 entries of 256 bytes each; `add_string` refuses past the bound rather
// than truncating, matching the StructScanDataTypeIdList precedent.
pub data ProjectStringList {
    strings: [[u8; 256]; 64];
    string_lens: [u64; 64];
    string_count: u64;
}

pub machine ProjectStringList::default() -> ProjectStringList {
    (ProjectStringList::empty())
}

pub machine ProjectStringList::empty() -> ProjectStringList {
    ProjectStringList {
        string_count: 0,
    }
}

pub machine ProjectStringList::get_string_count(project_string_list: &ProjectStringList) -> u64 {
    project_string_list.string_count
}

// Upstream `strings[index]` — byte-slice read of one stored string;
// out-of-range reads fall back to the head entry (callers gate on
// get_string_count).
pub machine ProjectStringList::get_string(project_string_list: &ProjectStringList, position: u64) -> &[u8] {
    transition position < project_string_list.string_count && position < 64 {
        true -> at(project_string_list, position)
        false -> head(project_string_list)
        _ -> head(project_string_list)
    }
    state at(project_string_list: &ProjectStringList, position: u64) -> &[u8]
        requires 0 <= position && position < 64;
    {
        let len: u64 = project_string_list.string_lens[position];
        transition len <= 256 {
            true -> (&project_string_list.strings[position][0..len])
            false -> (&project_string_list.strings[position][0..256])
            _ -> (&project_string_list.strings[position][0..256])
        }
    }
    state head(project_string_list: &ProjectStringList) -> &[u8] {
        transition project_string_list.string_lens[0] <= 256 {
            true -> (&project_string_list.strings[0][0..project_string_list.string_lens[0]])
            false -> (&project_string_list.strings[0][0..256])
            _ -> (&project_string_list.strings[0][0..256])
        }
    }
}

// Upstream Vec::push — appends one bounded string; refuses past 64.
pub machine ProjectStringList::add_string(project_string_list: &mut ProjectStringList, text: &[u8]) -> bool {
    transition project_string_list.string_count < 64 {
        true -> store(project_string_list, text)
        false -> (false)
        _ -> (false)
    }
    state store(project_string_list: &mut ProjectStringList, text: &[u8]) -> bool {
        let index: u64 = project_string_list.string_count;
        transition index < 64 {
            true -> fill(project_string_list, text, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill(project_string_list: &mut ProjectStringList, text: &[u8], index: u64) -> bool
        requires 0 <= index && index < 64
    {
        project_string_list.string_lens[index] = 0;
        transition {
            _ -> copy(project_string_list, text, index, 0)
        }
    }
    state copy(project_string_list: &mut ProjectStringList, text: &[u8], index: u64, position: u64) -> bool
        requires 0 <= index && index < 64
    {
        transition position < text.len && position < 256 {
            true -> write(project_string_list, text, index, position)
            false -> finish(project_string_list, index, position)
        }
    }
    state write(project_string_list: &mut ProjectStringList, text: &[u8], index: u64, position: u64) -> bool
        requires 0 <= index && index < 64 && position < 256
    {
        project_string_list.strings[index][position] = text[position];
        transition {
            _ -> copy(project_string_list, text, index, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(project_string_list: &mut ProjectStringList, index: u64, count: u64) -> bool
        requires 0 <= index && index < 64
    {
        project_string_list.string_lens[index] = count;
        project_string_list.string_count = index + 1;
        (true)
    }
}
