use src/structures/projects/project_path_list.omg;

// Port of structures/projects/project_manifest.rs — the persisted project
// item sort order. Upstream's `sort_order: Vec<PathBuf>` carries as the
// shared bounded path list.
public data ProjectManifest {
    project_item_sort_order: |project_path_list|::ProjectPathList;
}

public machine ProjectManifest::new(project_item_sort_order: |project_path_list|::ProjectPathList) -> ProjectManifest {
    (ProjectManifest {
        project_item_sort_order: project_item_sort_order,
    })
}

public machine ProjectManifest::default() -> ProjectManifest {
    (ProjectManifest {
        project_item_sort_order: |project_path_list|::ProjectPathList::empty(),
    })
}

public machine ProjectManifest::get_project_item_sort_order(this: &ProjectManifest) -> &|project_path_list|::ProjectPathList {
    (&this.project_item_sort_order)
}

public machine ProjectManifest::set_project_item_sort_order(this: &mut ProjectManifest, project_item_sort_order: |project_path_list|::ProjectPathList) {
    this.project_item_sort_order = project_item_sort_order;
}

public machine ProjectManifest::clone(source: &ProjectManifest) -> ProjectManifest {
    let hoist1: |project_path_list|::ProjectPathList = |project_path_list|::ProjectPathList::clone(&source.project_item_sort_order);
    (ProjectManifest {
        project_item_sort_order: hoist1,
    })
}

public machine ProjectManifest::clone_from(this: &mut ProjectManifest, source: &ProjectManifest) {
    |project_path_list|::ProjectPathList::clone_from(&mut this.project_item_sort_order, &source.project_item_sort_order);
}
