module src::structures::projects::project_manifest;

use src::structures::projects::project_path_list::ProjectPathList;

// Port of structures/projects/project_manifest.rs — the persisted project
// item sort order. Upstream's `sort_order: Vec<PathBuf>` carries as the
// shared bounded path list.
public data ProjectManifest {
    project_item_sort_order: ProjectPathList;
}

public machine ProjectManifest::new(project_item_sort_order: ProjectPathList) -> ProjectManifest {
    (ProjectManifest {
        project_item_sort_order: project_item_sort_order,
    })
}

public machine ProjectManifest::default() -> ProjectManifest {
    (ProjectManifest {
        project_item_sort_order: ProjectPathList::empty(),
    })
}

public machine ProjectManifest::get_project_item_sort_order(this: &ProjectManifest) -> &ProjectPathList {
    (&this.project_item_sort_order)
}

public machine ProjectManifest::set_project_item_sort_order(this: &mut ProjectManifest, project_item_sort_order: ProjectPathList) {
    this.project_item_sort_order = project_item_sort_order;
}

public machine ProjectManifest::clone(source: &ProjectManifest) -> ProjectManifest {
    let hoist1: ProjectPathList = ProjectPathList::clone(&source.project_item_sort_order);
    (ProjectManifest {
        project_item_sort_order: hoist1,
    })
}

public machine ProjectManifest::clone_from(this: &mut ProjectManifest, source: &ProjectManifest) {
    ProjectPathList::clone_from(&mut this.project_item_sort_order, &source.project_item_sort_order);
}
