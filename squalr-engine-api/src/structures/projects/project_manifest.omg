module src::structures::projects::project_manifest;

use src::structures::projects::project_path_list::ProjectPathList;

// Port of structures/projects/project_manifest.rs — the persisted project
// item sort order. Upstream's `sort_order: Vec<PathBuf>` carries as the
// shared bounded path list.
pub data ProjectManifest {
    project_item_sort_order: ProjectPathList;
}

pub machine ProjectManifest::new(project_item_sort_order: ProjectPathList) -> ProjectManifest {
    (ProjectManifest {
        project_item_sort_order: project_item_sort_order,
    })
}

pub machine ProjectManifest::default() -> ProjectManifest {
    (ProjectManifest {
        project_item_sort_order: ProjectPathList::empty(),
    })
}

pub machine ProjectManifest::get_project_item_sort_order(project_manifest: &ProjectManifest) -> &ProjectPathList {
    (&project_manifest.project_item_sort_order)
}

pub machine ProjectManifest::set_project_item_sort_order(project_manifest: &mut ProjectManifest, project_item_sort_order: ProjectPathList) {
    project_manifest.project_item_sort_order = project_item_sort_order;
}

pub machine ProjectManifest::clone(source: &ProjectManifest) -> ProjectManifest {
    (ProjectManifest {
        project_item_sort_order: ProjectPathList::clone(&source.project_item_sort_order),
    })
}

pub machine ProjectManifest::clone_from(project_manifest: &mut ProjectManifest, source: &ProjectManifest) {
    ProjectPathList::clone_from(&mut project_manifest.project_item_sort_order, &source.project_item_sort_order);
}
