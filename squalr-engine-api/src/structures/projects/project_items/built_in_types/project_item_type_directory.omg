module src::structures::projects::project_items::built_in_types::project_item_type_directory;

use src::structures::projects::project_items::project_item::ProjectItem;
use src::structures::projects::project_items::project_item_ref::ProjectItemRef;
use src::structures::projects::project_items::project_item_type_ref::ProjectItemTypeRef;

// Port of structures/projects/project_items/built_in_types/
// project_item_type_directory.rs — the directory item type. Upstream's
// `impl ProjectItemType` arms (on_activated_changed / tick) dispatch
// through registry trait objects and are commented-out bodies upstream;
// the trait-object layer is a named deviation filed on the port board —
// what lands here is the data plus the item constructor the serializer
// actually calls.
pub data ProjectItemTypeDirectory {
}

// Upstream `ProjectItemTypeDirectory::PROJECT_ITEM_TYPE_ID` — "directory".
pub machine ProjectItemTypeDirectory::get_project_item_type_id() -> &[u8] {
    ("directory")
}

// Upstream `new_project_item` — a directory item named after the final
// path component of its ref.
pub machine ProjectItemTypeDirectory::new_project_item(project_item_ref: &ProjectItemRef) -> ProjectItem {
    let project_item_type_ref: ProjectItemTypeRef = ProjectItemTypeRef::new("directory");
    let name: &[u8] = project_item_ref.get_file_or_directory_name();
    (ProjectItem::new(project_item_type_ref, name))
}
