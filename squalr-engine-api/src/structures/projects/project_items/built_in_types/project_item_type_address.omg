module src::structures::projects::project_items::built_in_types::project_item_type_address;

// Port of structures/projects/project_items/built_in_types/
// project_item_type_address.rs — the "address" built-in item type's
// field accessors over the item's property bag.
//
// Upstream `impl ProjectItemType` arms (on_activated_changed / tick)
// are commented-out bodies upstream that dispatch through registry
// trait objects — same trait-object deviation as the directory type.
//
// Storage deviations vs upstream:
// - PROPERTY_TARGET carries the address target's bounded binary codec
//   bytes, not its serde_json string (upstream had no codec; the field
//   name and semantics are identical).
// - read_string_field returns a bounded copy of the field's bytes.
//   `get_field_address`/`get_field_module` mint utf8 DataValues under
//   the `string_utf8` type id exactly like `ProjectItem::set_field_name`.

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use src::structures::structs::symbolic_field_definition::AnonymousValueStringFormatMatch;
use src::structures::structs::symbolic_struct_ref::SymbolicStructRef;
use src::structures::data_values::data_value::DataValue;
use src::structures::projects::project_items::built_in_types::project_item_type_address_target::ProjectItemAddressTarget;
use src::structures::projects::project_items::project_item::ProjectItem;
use src::structures::projects::project_items::project_item_type_ref::ProjectItemTypeRef;
use src::structures::structs::symbolic_struct_ref::SymbolicStructRef;
use src::structures::structs::valued_struct_field::ValuedStructField;
use src::structures::structs::valued_struct_field::ValuedStructFieldData;
use src::structures::memory::symbolic_pointer_chain::SymbolicLinkOffset;
use src::structures::memory::symbolic_pointer_chain::SymbolicPointerChainLink;
use src::structures::projects::project_items::built_in_types::project_item_type_address_target::AddressTargetDecode;
use src::structures::projects::project_items::built_in_types::project_item_type_address_target::decode_address_target;
use src::structures::projects::project_items::built_in_types::project_item_type_address_target::encode_address_target;
use src::structures::structs::valued_struct::ValuedStruct;
use src::structures::structs::valued_struct::ValuedStructFieldLookup;
use src::structures::structs::owned_symbolic_pointer_chain::OwnedSymbolicPointerChain;

pub data ProjectItemTypeAddress {}

pub machine ProjectItemTypeAddress::get_project_item_type_id() -> &[u8] {
    ("address")
}

// PROPERTY_TARGET codec reader — the stored bytes decode back to a
// target; a missing/malformed field yields the upstream fallback
// `new_address(0, "")`.
machine address_field_copy(field: ValuedStructField, out: &mut [u8; 512]) -> u64 {
    transition ValuedStructField::is_value(&field) {
        true -> copy(field, out)
        false -> (0)
        _ -> (0)
    }
    state copy(field: ValuedStructField, out: &mut [u8; 512]) -> u64 {
        let data_value: DataValue = ValuedStructField::get_data_value(&field);
        let bytes: &[u8] = DataValue::get_value_bytes(&data_value);
        transition {
            _ -> walk(bytes, out, 0)
        }
    }
    state walk(bytes: &[u8], out: &mut [u8; 512], position: u64) -> u64 {
        transition position < bytes.len && position < 512 {
            true -> store(bytes, out, position)
            false -> (position)
        }
    }
    state store(bytes: &[u8], out: &mut [u8; 512], position: u64) -> u64 {
        out[position] = bytes[position];
        transition {
            _ -> walk(bytes, out, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

machine address_write_string_field(project_item: &mut ProjectItem, field_name: &[u8], value: &[u8], is_read_only: bool) {
    let data_type_ref: DataTypeRef = DataTypeRef::new("string_utf8");
    let data_value: DataValue = DataValue::new(&data_type_ref, value);
    let field_data: ValuedStructFieldData = ValuedStructFieldData::Value { value: data_value };
    let properties: &mut ValuedStruct = ProjectItem::borrow_properties_mut(project_item);
    ValuedStruct::set_field_data(properties, field_name, &field_data, is_read_only);
}

pub machine ProjectItemTypeAddress::new_project_item(
    name: &[u8],
    address: u64,
    module_name: &[u8],
    description: &[u8],
    freeze_value: DataValue
) -> ProjectItem {
    let project_item_type_ref: ProjectItemTypeRef = ProjectItemTypeRef::new(ProjectItemTypeAddress::get_project_item_type_id());
    transition {
        _ -> whitespace(name, project_item_type_ref, address, module_name, description, freeze_value, 0)
    }
    // An all-whitespace name folds to the default (upstream trim).
    state whitespace(name: &[u8], project_item_type_ref: ProjectItemTypeRef, address: u64, module_name: &[u8], description: &[u8], freeze_value: DataValue, position: u64) -> ProjectItem {
        transition position < name.len {
            true -> probe(name, project_item_type_ref, address, module_name, description, freeze_value, position)
            _ -> fallback(project_item_type_ref, address, module_name, description, freeze_value)
        }
    }
    state probe(name: &[u8], project_item_type_ref: ProjectItemTypeRef, address: u64, module_name: &[u8], description: &[u8], freeze_value: DataValue, position: u64) -> ProjectItem {
        transition position < name.len {
            true -> character(name, project_item_type_ref, address, module_name, description, freeze_value, position)
            _ -> fallback(project_item_type_ref, address, module_name, description, freeze_value)
        }
    }
    state character(name: &[u8], project_item_type_ref: ProjectItemTypeRef, address: u64, module_name: &[u8], description: &[u8], freeze_value: DataValue, position: u64) -> ProjectItem
        requires position < name.len;
    {
        let byte: u8 = name[position];
        transition byte == 32 || byte == 9 || byte == 10 || byte == 11 || byte == 12 || byte == 13 {
            true -> whitespace(name, project_item_type_ref, address, module_name, description, freeze_value, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> create(name, project_item_type_ref, address, module_name, description, freeze_value)
        }
    }
    state fallback(project_item_type_ref: ProjectItemTypeRef, address: u64, module_name: &[u8], description: &[u8], freeze_value: DataValue) -> ProjectItem {
        let created: ProjectItem = ProjectItem::new(project_item_type_ref, "New Address");
        transition {
            _ -> populate(created, address, module_name, description, freeze_value)
        }
    }
    state create(name: &[u8], project_item_type_ref: ProjectItemTypeRef, address: u64, module_name: &[u8], description: &[u8], freeze_value: DataValue) -> ProjectItem {
        let created: ProjectItem = ProjectItem::new(project_item_type_ref, name);
        transition {
            _ -> populate(created, address, module_name, description, freeze_value)
        }
    }
    state populate(project_item: ProjectItem, address: u64, module_name: &[u8], description: &[u8], freeze_value: DataValue) -> ProjectItem {
        let mut carried: ProjectItem = project_item;
        address_write_string_field(&mut carried, "description", description, false);
        let address_target: ProjectItemAddressTarget = ProjectItemAddressTarget::new_address(address, module_name);
        ProjectItemTypeAddress::set_address_target(&mut carried, &address_target);
        // Default to unknown until project-item refresh reads live memory.
        ProjectItemTypeAddress::set_field_freeze_data_value_interpreter(&mut carried, "");
        ProjectItemTypeAddress::set_field_symbolic_struct_definition_reference(&mut carried, DataValue::get_data_type_id(&freeze_value));
        (carried)
    }
}

// Upstream `get_field_address` — the root link's offset as u64, 0 on
// symbolic/absent (upstream unwrap_or(0)).
pub machine ProjectItemTypeAddress::get_field_address(project_item: &mut ProjectItem) -> u64 {
    let address_target: ProjectItemAddressTarget = ProjectItemTypeAddress::get_address_target(project_item);
    let root_offset: SymbolicLinkOffset = ProjectItemAddressTarget::get_root_offset(&address_target);
    transition root_offset.found {
        true -> clamp(root_offset)
        false -> (0)
    }
    state clamp(root_offset: SymbolicLinkOffset) -> u64 {
        transition root_offset.offset >= 0 {
            true -> (((root_offset.offset as i64 in Wrapping)) as u64)
            false -> (0)
            _ -> (0)
        }
    }
}

// Upstream `set_field_address` — rewrites the FIRST chain segment's
// offset in place, preserving the tail.
pub machine ProjectItemTypeAddress::set_field_address(
        project_item: &mut ProjectItem,
    address: u64
) {
    let mut address_target: ProjectItemAddressTarget = ProjectItemTypeAddress::get_address_target(project_item);
    let link_count: u64 = ProjectItemAddressTarget::get_link_count(&address_target);
    transition link_count > 0 {
        true -> rebuild(project_item, address_target, address)
        false -> finish()
    }
    state rebuild(project_item: &mut ProjectItem, address_target: ProjectItemAddressTarget, address: u64) {
        let mut links: [SymbolicPointerChainLink; 64];
        let count: u64 = ProjectItemAddressTarget::get_link_count(&address_target);
        transition {
            _ -> copy(project_item, address_target, links, 0, count, address)
        }
    }
    state copy(project_item: &mut ProjectItem,
        address_target: ProjectItemAddressTarget,
        links: [SymbolicPointerChainLink; 64],
        position: u64,
        count: u64,
        address: u64
    ) {
        transition position < count && position < address_target.pointer_chain.link_count && position < 64 {
            true -> store(project_item, address_target, links, position, count, address)
            false -> patch_guard(project_item, address_target, links, count, address)
        }
    }
    state store(project_item: &mut ProjectItem,
        address_target: ProjectItemAddressTarget,
        links: [SymbolicPointerChainLink; 64],
        position: u64,
        count: u64,
        address: u64
    )
        requires position < address_target.pointer_chain.link_count && position < 64
    {
        let mut held: [SymbolicPointerChainLink; 64] = links;
        held[position] = OwnedSymbolicPointerChain::get_link(&address_target.pointer_chain, position);
        transition {
            _ -> copy(project_item, address_target, held, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, count, address)
        }
    }
    state patch_guard(project_item: &mut ProjectItem,
        address_target: ProjectItemAddressTarget,
        links: [SymbolicPointerChainLink; 64],
        count: u64,
        address: u64
    ) {
        transition count > 0 && count <= 64 {
            true -> patch(project_item, address_target, links, count, address)
            false -> finish()
        }
    }
    state patch(project_item: &mut ProjectItem,
        address_target: ProjectItemAddressTarget,
        links: [SymbolicPointerChainLink; 64],
        count: u64,
        address: u64
    )
        requires count > 0 && count <= 64
    {
        let mut held: [SymbolicPointerChainLink; 64] = links;
        held[0] = SymbolicPointerChainLink::new_offset(((address as i64 in Wrapping)) as i64);
        let mut carried: ProjectItemAddressTarget = address_target;
        ProjectItemAddressTarget::set_pointer_offsets(&mut carried, &held[0..count]);
        ProjectItemTypeAddress::set_address_target(project_item, &carried);
    }
    state finish() {
    }
}

// Upstream `get_field_module` — the address target's module bytes.
pub machine ProjectItemTypeAddress::get_field_module(project_item: &mut ProjectItem, out_module: &mut [u8; 256]) -> u64 {
    let address_target: ProjectItemAddressTarget = ProjectItemTypeAddress::get_address_target(project_item);
    let module: &[u8] = ProjectItemAddressTarget::get_module_name(&address_target);
    transition {
        _ -> copy(module, out_module, 0)
    }
    state copy(module: &[u8], out_module: &mut [u8; 256], position: u64) -> u64 {
        transition position < module.len && position < 256 {
            true -> store(module, out_module, position)
            false -> (position)
        }
    }
    state store(module: &[u8], out_module: &mut [u8; 256], position: u64) -> u64 {
        out_module[position] = module[position];
        transition {
            _ -> copy(module, out_module, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

pub machine ProjectItemTypeAddress::set_field_module(
    project_item: &mut ProjectItem,
    module: &[u8]
) {
    // Upstream updates the module property AND the stored target.
    address_write_string_field(project_item, "module", module, false);
    let mut address_target: ProjectItemAddressTarget = ProjectItemTypeAddress::get_address_target(project_item);
    ProjectItemAddressTarget::set_module_name(&mut address_target, module);
    ProjectItemTypeAddress::set_address_target(project_item, &address_target);
}

// Upstream `get_address_target` — decodes the stored codec field; a
// missing/malformed field falls back to `new_address(0, "")`.
pub machine ProjectItemTypeAddress::get_address_target(project_item: &ProjectItem) -> ProjectItemAddressTarget {
    let properties: &ValuedStruct = ProjectItem::get_properties(project_item);
    let lookup: ValuedStructFieldLookup = ValuedStruct::find_field(properties, "target_data");
    transition lookup {
        ValuedStructFieldLookup::Found { index } -> found(project_item, index)
        ValuedStructFieldLookup::Missing -> (ProjectItemAddressTarget::new_address(0, ""))
        _ -> (ProjectItemAddressTarget::new_address(0, ""))
    }
    state found(project_item: &ProjectItem, index: u64) -> ProjectItemAddressTarget {
        let properties: &ValuedStruct = ProjectItem::get_properties(project_item);
        let field: ValuedStructField = ValuedStruct::get_field_at(properties, index);
        let mut serialized: [u8; 512];
        let serialized_len: u64 = address_field_copy(field, &mut serialized);
        transition serialized_len <= 512 {
            true -> decode(serialized, serialized_len)
            false -> (ProjectItemAddressTarget::new_address(0, ""))
            _ -> (ProjectItemAddressTarget::new_address(0, ""))
        }
    }
    state decode(serialized: [u8; 512], serialized_len: u64) -> ProjectItemAddressTarget {
        let decoded: AddressTargetDecode = decode_address_target(&serialized, serialized_len);
        transition decoded.found {
            true -> (decoded.address_target)
            false -> (ProjectItemAddressTarget::new_address(0, ""))
            _ -> (ProjectItemAddressTarget::new_address(0, ""))
        }
    }
}

// Upstream `set_address_target` — refreshes the module property, drops
// the legacy PROPERTY_ADDRESS field, then writes the codec field.
pub machine ProjectItemTypeAddress::set_address_target(
    project_item: &mut ProjectItem,
    address_target: &ProjectItemAddressTarget
) {
    let module_name: &[u8] = ProjectItemAddressTarget::get_module_name(address_target);
    address_write_string_field(project_item, "module", module_name, false);
    let fields: &mut ValuedStruct = ProjectItem::borrow_properties_mut(project_item);
    _ = ValuedStruct::remove_field(fields, "address");
    let mut serialized: [u8; 512];
    let serialized_len: u64 = encode_address_target(address_target, &mut serialized);
    transition serialized_len <= 512 {
        true -> store(project_item, serialized, serialized_len)
        false -> finish()
        _ -> finish()
    }
    state store(project_item: &mut ProjectItem, serialized: [u8; 512], serialized_len: u64)
        requires serialized_len <= 512
    {
        address_write_string_field(project_item, "target_data", &serialized[0..serialized_len], false);
    }
    state finish() {
    }
}

pub machine ProjectItemTypeAddress::get_field_freeze_data_value_interpreter(project_item: &ProjectItem, out: &mut [u8; 256]) -> u64 {
    (address_read_string_field(project_item, "freeze_data_value_interpreter", out))
}

pub machine ProjectItemTypeAddress::set_field_freeze_data_value_interpreter(
    project_item: &mut ProjectItem,
    data_value_interpreter: &[u8]
) {
    address_write_string_field(project_item, "freeze_data_value_interpreter", data_value_interpreter, true);
}

// Upstream `get_field_freeze_display_format` — parses the stored
// display-format text; empty/unparseable folds to not-found (the
// Option folds to the Match carrier).
pub machine ProjectItemTypeAddress::get_field_freeze_display_format(project_item: &ProjectItem) -> AnonymousValueStringFormatMatch {
    let mut text: [u8; 256];
    let text_len: u64 = address_read_string_field(project_item, "freeze_display_format", &mut text);
    transition text_len <= 256 {
        true -> parse(text, text_len)
        false -> (AnonymousValueStringFormatMatch { found: false, display_format: AnonymousValueStringFormat::default() })
        _ -> (AnonymousValueStringFormatMatch { found: false, display_format: AnonymousValueStringFormat::default() })
    }
    state parse(text: [u8; 256], text_len: u64) -> AnonymousValueStringFormatMatch
        requires text_len <= 256
    {
        let parsed: Optional<AnonymousValueStringFormat> = AnonymousValueStringFormat::from_str(&text[0..text_len]);
        transition parsed {
            Optional::Some { value } -> (AnonymousValueStringFormatMatch { found: true, display_format: value })
            _ -> (AnonymousValueStringFormatMatch { found: false, display_format: AnonymousValueStringFormat::default() })
        }
    }
}

pub machine ProjectItemTypeAddress::set_field_freeze_display_format(
    project_item: &mut ProjectItem,
    display_format: AnonymousValueStringFormat
) {
    address_write_string_field(project_item, "freeze_display_format", AnonymousValueStringFormat::spelling(&display_format), true);
}

// Upstream `get_field_symbolic_struct_definition_reference` —
// `Option<SymbolicStructRef>` folds to a carrier: found + ref.
pub data SymbolicStructRefMatch {
    found: bool;
    symbolic_struct_ref: SymbolicStructRef;
}

pub machine ProjectItemTypeAddress::get_field_symbolic_struct_definition_reference(project_item: &ProjectItem) -> SymbolicStructRefMatch {
    let mut text: [u8; 256];
    let text_len: u64 = address_read_string_field(project_item, "symbolic_struct_definition_reference", &mut text);
    transition text_len > 0 && text_len <= 256 {
        true -> build(text, text_len)
        false -> (SymbolicStructRefMatch { found: false, symbolic_struct_ref: SymbolicStructRef::new_anonymous() })
        _ -> (SymbolicStructRefMatch { found: false, symbolic_struct_ref: SymbolicStructRef::new_anonymous() })
    }
    state build(text: [u8; 256], text_len: u64) -> SymbolicStructRefMatch
        requires text_len > 0 && text_len <= 256
    {
        (SymbolicStructRefMatch { found: true, symbolic_struct_ref: SymbolicStructRef::new(&text[0..text_len]) })
    }
}

pub machine ProjectItemTypeAddress::set_field_symbolic_struct_definition_reference(
    project_item: &mut ProjectItem,
    symbolic_struct_definition: &[u8]
) {
    address_write_string_field(project_item, "symbolic_struct_definition_reference", symbolic_struct_definition, false);
}

// Upstream `read_string_field` — copies the field's value bytes into
// the caller's 256 buffer; missing/nested yields 0 written.
machine address_read_string_field(project_item: &ProjectItem, field_name: &[u8], out: &mut [u8; 256]) -> u64 {
    let properties: &ValuedStruct = ProjectItem::get_properties(project_item);
    let lookup: ValuedStructFieldLookup = ValuedStruct::find_field(properties, field_name);
    transition lookup {
        ValuedStructFieldLookup::Found { index } -> found(project_item, index, out)
        ValuedStructFieldLookup::Missing -> (0)
        _ -> (0)
    }
    state found(project_item: &ProjectItem, index: u64, out: &mut [u8; 256]) -> u64 {
        let properties: &ValuedStruct = ProjectItem::get_properties(project_item);
        let field: ValuedStructField = ValuedStruct::get_field_at(properties, index);
        transition ValuedStructField::is_value(&field) {
            true -> copy(field, out)
            false -> (0)
            _ -> (0)
        }
    }
    state copy(field: ValuedStructField, out: &mut [u8; 256]) -> u64 {
        let data_value: DataValue = ValuedStructField::get_data_value(&field);
        let bytes: &[u8] = DataValue::get_value_bytes(&data_value);
        transition {
            _ -> walk(bytes, out, 0)
        }
    }
    state walk(bytes: &[u8], out: &mut [u8; 256], position: u64) -> u64 {
        transition position < bytes.len && position < 256 {
            true -> store(bytes, out, position)
            false -> (position)
        }
    }
    state store(bytes: &[u8], out: &mut [u8; 256], position: u64) -> u64 {
        out[position] = bytes[position];
        transition {
            _ -> walk(bytes, out, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}
