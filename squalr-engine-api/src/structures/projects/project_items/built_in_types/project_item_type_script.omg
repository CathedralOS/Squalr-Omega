module src::structures::projects::project_items::built_in_types::project_item_type_script;

use src::structures::projects::project_items::project_item::ProjectItem;
use src::structures::projects::project_items::project_item_type_ref::ProjectItemTypeRef;

// Port of structures/projects/project_items/built_in_types/
// project_item_type_script.rs — the script item type. Upstream's
// `impl ProjectItemType` arms are empty bodies that dispatch through
// registry trait objects; the trait-object layer is a named deviation
// filed on the port board — what lands here is the data plus the item
// constructor.
pub data ProjectItemTypeScript {
}

// Upstream `ProjectItemTypeScript::PROJECT_ITEM_TYPE_ID` — "script".
pub machine ProjectItemTypeScript::get_project_item_type_id() -> &[u8] {
    ("script")
}

// Upstream `new_project_item` — an all-whitespace name folds to the
// default ("New Script").
pub machine ProjectItemTypeScript::new_project_item(name: &[u8]) -> ProjectItem {
    let project_item_type_ref: ProjectItemTypeRef = ProjectItemTypeRef::new(ProjectItemTypeScript::get_project_item_type_id());
    transition {
        _ -> scan(project_item_type_script, name, project_item_type_ref, 0)
    }
    state scan(project_item_type_script: &mut ProjectItemTypeScript, name: &[u8], project_item_type_ref: ProjectItemTypeRef, position: u64) -> ProjectItem {
        transition position < name.len {
            true -> probe(project_item_type_script, name, project_item_type_ref, position)
            false -> (ProjectItem::new(project_item_type_ref, "New Script"))
        }
    }
    state probe(project_item_type_script: &mut ProjectItemTypeScript, name: &[u8], project_item_type_ref: ProjectItemTypeRef, position: u64) -> ProjectItem {
        let character: u8 = name[position];
        transition character == 32 || character == 9 || character == 10 || character == 13 || character == 11 || character == 12 {
            true -> scan(project_item_type_script, name, project_item_type_ref, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> (ProjectItem::new(project_item_type_ref, name))
            _ -> (ProjectItem::new(project_item_type_ref, name))
        }
    }
}
