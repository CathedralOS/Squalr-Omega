module src::structures::projects::project_items::project_item_pair;

use src::structures::projects::project_items::project_item::ProjectItem;
use src::structures::projects::project_items::project_item_ref::ProjectItemRef;

// Port-side pair carrier for upstream's `Vec<(ProjectItemRef, ProjectItem)>`
// in ProjectItemsListResponse — the tuple respells to a named record so it
// can sit in the bounded table.
pub data ProjectItemPair {
    project_item_ref: ProjectItemRef;
    project_item: ProjectItem;
}

pub machine ProjectItemPair::new(project_item_ref: ProjectItemRef, project_item: ProjectItem) -> ProjectItemPair {
    (ProjectItemPair {
        project_item_ref: project_item_ref,
        project_item: project_item,
    })
}

pub machine ProjectItemPair::default() -> ProjectItemPair {
    (ProjectItemPair {
        project_item_ref: ProjectItemRef::default(),
        project_item: ProjectItem::default(),
    })
}

pub machine ProjectItemPair::get_project_item_ref(this: &ProjectItemPair) -> &ProjectItemRef {
    (&this.project_item_ref)
}

pub machine ProjectItemPair::get_project_item(this: &ProjectItemPair) -> &ProjectItem {
    (&this.project_item)
}

// Mutable arm of `get_project_item` — `Project`'s HashMap values mutate
// through `get_mut`/`values_mut` upstream.
pub machine ProjectItemPair::borrow_project_item_mut(this: &mut ProjectItemPair) -> &mut ProjectItem {
    (&mut this.project_item)
}

pub machine ProjectItemPair::clone(source: &ProjectItemPair) -> ProjectItemPair {
    let hoist1: ProjectItemRef = ProjectItemRef::clone(&source.project_item_ref);
    (ProjectItemPair {
        project_item_ref: hoist1,
        project_item: ProjectItem::clone(&source.project_item),
    })
}

pub machine ProjectItemPair::clone_from(this: &mut ProjectItemPair, source: &ProjectItemPair) {
    ProjectItemRef::clone_from(&mut this.project_item_ref, &source.project_item_ref);
    ProjectItem::clone_from(&mut this.project_item, &source.project_item);
}
