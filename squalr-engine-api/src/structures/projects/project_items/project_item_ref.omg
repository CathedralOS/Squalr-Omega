module src::structures::projects::project_items::project_item_ref;

// Port of structures/projects/project_items/project_item_ref.rs — the
// stable handle a project item is keyed by (its path inside the project
// tree). PathBuf carries as the bounded path carrier.
pub data ProjectItemRef {
    project_item_path: [u8; 512];
    project_item_path_len: u64;
}

pub machine ProjectItemRef::new(project_item_path: &[u8]) -> ProjectItemRef {
    let mut created: ProjectItemRef = ProjectItemRef {
        project_item_path_len: 0,
    };
    ProjectItemRef::set_project_item_path(&mut created, project_item_path);
    (created)
}

pub machine ProjectItemRef::default() -> ProjectItemRef {
    ProjectItemRef {
        project_item_path_len: 0,
    }
}

pub machine ProjectItemRef::get_project_item_path(project_item_ref: &ProjectItemRef) -> &[u8] {
    transition project_item_ref.project_item_path_len <= 512 {
        true -> (&project_item_ref.project_item_path[0..project_item_ref.project_item_path_len])
        false -> (&project_item_ref.project_item_path[0..512])
        _ -> (&project_item_ref.project_item_path[0..512])
    }
}

pub machine ProjectItemRef::set_project_item_path(project_item_ref: &mut ProjectItemRef, project_item_path: &[u8]) {
    project_item_ref.project_item_path_len = 0;
    transition {
        _ -> copy(project_item_ref, project_item_path, 0)
    }
    state copy(project_item_ref: &mut ProjectItemRef, project_item_path: &[u8], position: u64) {
        transition position < project_item_path.len && position < 512 {
            true -> store(project_item_ref, project_item_path, position)
            false -> finish(project_item_ref, position)
        }
    }
    state store(project_item_ref: &mut ProjectItemRef, project_item_path: &[u8], position: u64) {
        project_item_ref.project_item_path[position] = project_item_path[position];
        transition {
            _ -> copy(project_item_ref, project_item_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(project_item_ref: &mut ProjectItemRef, count: u64) {
        project_item_ref.project_item_path_len = count;
    }
}

// Upstream `get_file_or_directory_name` — the final path component. The
// port surfaces it as a copy-out accessor (the start index is arithmetic
// on the stored len, which the subslice bounds checker cannot discharge);
// `copy_file_or_directory_name` fills `out` with the name bytes and
// returns the name length (0 when the path has no trailing component).
// A `file_name_length` machine mirrors upstream's component length for
// callers that only need the bound.
pub machine ProjectItemRef::get_file_or_directory_name_length(project_item_ref: &ProjectItemRef) -> u64 {
    transition {
        _ -> find_separator(project_item_ref, project_item_ref.project_item_path_len)
    }
    state find_separator(project_item_ref: &ProjectItemRef, position: u64) -> u64 {
        transition 0 < position && position <= project_item_ref.project_item_path_len {
            true -> probe(project_item_ref, position)
            false -> (project_item_ref.project_item_path_len)
        }
    }
    state probe(project_item_ref: &ProjectItemRef, position: u64) -> u64 {
        let index: u64 = position - 1;
        transition index < project_item_ref.project_item_path_len && index < 512 {
            true -> inspect(project_item_ref, index)
            false -> (project_item_ref.project_item_path_len)
        }
    }
    state inspect(project_item_ref: &ProjectItemRef, index: u64) -> u64
        requires index < 512;
    {
        let byte: u8 = project_item_ref.project_item_path[index];
        transition byte == 47 || byte == 92 {
            true -> emit(project_item_ref, index)
            false -> find_separator(project_item_ref, index)
        }
    }
    state emit(project_item_ref: &ProjectItemRef, index: u64) -> u64
        requires index < project_item_ref.project_item_path_len;
    {
        (project_item_ref.project_item_path_len - index - 1)
    }
}

pub machine ProjectItemRef::copy_file_or_directory_name(project_item_ref: &mut ProjectItemRef, out_file_name: &mut [u8; 512]) -> u64 {
    let name_start: u64 = ProjectItemRef::get_file_name_start(project_item_ref);
    transition {
        _ -> walk(project_item_ref, out_file_name, name_start, 0)
    }
    // walk copies project_item_path[source_index] into out[out_position]
    // while the source stays inside the live path — the source index
    // reaches project_item_path_len exactly when the name ends.
    state walk(project_item_ref: &mut ProjectItemRef, out_file_name: &mut [u8; 512], source_index: u64, out_position: u64) -> u64
        requires out_position < 512;
    {
        transition source_index < project_item_ref.project_item_path_len && source_index < 512 {
            true -> store(project_item_ref, out_file_name, source_index, out_position)
            false -> (out_position)
        }
    }
    state store(project_item_ref: &mut ProjectItemRef, out_file_name: &mut [u8; 512], source_index: u64, out_position: u64) -> u64
        requires source_index < project_item_ref.project_item_path_len && source_index < 512 && out_position < 512;
    {
        out_file_name[out_position] = project_item_ref.project_item_path[source_index];
        let next_source: u64 = ((source_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let next_out: u64 = ((out_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next_source < 512 && next_out < 512 {
            true -> walk(project_item_ref, out_file_name, next_source, next_out)
            false -> (next_out)
        }
    }
}

// get_file_name_start — index of the first byte after the final separator;
// 0 when the path has no separator, len when it ends in one (empty name —
// upstream Path::file_name agrees: a trailing separator yields no final
// component).
pub machine ProjectItemRef::get_file_name_start(project_item_ref: &ProjectItemRef) -> u64 {
    transition {
        _ -> find_separator(project_item_ref, project_item_ref.project_item_path_len)
    }
    state find_separator(project_item_ref: &ProjectItemRef, position: u64) -> u64 {
        transition 0 < position && position <= project_item_ref.project_item_path_len {
            true -> probe(project_item_ref, position)
            false -> (0)
        }
    }
    state probe(project_item_ref: &ProjectItemRef, position: u64) -> u64 {
        let index: u64 = position - 1;
        transition index < project_item_ref.project_item_path_len && index < 512 {
            true -> inspect(project_item_ref, index)
            false -> (0)
        }
    }
    state inspect(project_item_ref: &ProjectItemRef, index: u64) -> u64
        requires index < 512;
    {
        let byte: u8 = project_item_ref.project_item_path[index];
        transition byte == 47 || byte == 92 {
            true -> emit_start(project_item_ref, index)
            false -> find_separator(project_item_ref, index)
        }
    }
    state emit_start(project_item_ref: &ProjectItemRef, index: u64) -> u64
        requires index < 512;
    {
        (index + 1)
    }
}


// Upstream `get_file_or_directory_name` — the view of the final path
// component (`copy_file_or_directory_name` is the filling spelling for
// fixed receivers).
pub machine ProjectItemRef::get_file_or_directory_name(project_item_ref: &ProjectItemRef) -> &[u8] {
    let name_start: u64 = ProjectItemRef::get_file_name_start(project_item_ref);
    transition name_start <= project_item_ref.project_item_path_len && project_item_ref.project_item_path_len <= 512 {
        true -> (&project_item_ref.project_item_path[name_start..project_item_ref.project_item_path_len])
        false -> (&project_item_ref.project_item_path[0..0])
        _ -> (&project_item_ref.project_item_path[0..0])
    }
}

// Path equality for keyed lookups (`Project` stores pairs keyed by ref;
// upstream HashMap equality lands on the path bytes).
pub machine ProjectItemRef::path_equals(project_item_ref: &ProjectItemRef, other: &ProjectItemRef) -> bool {
    let other_path: &[u8] = ProjectItemRef::get_project_item_path(other);
    transition project_item_ref.project_item_path_len == other_path.len {
        true -> compare(project_item_ref, other_path, 0)
        false -> (false)
        _ -> (false)
    }
    state compare(project_item_ref: &ProjectItemRef, other_path: &[u8], position: u64) -> bool {
        transition position < project_item_ref.project_item_path_len && position < 512 {
            true -> probe(project_item_ref, other_path, position)
            false -> (true)
            _ -> (false)
        }
    }
    state probe(project_item_ref: &ProjectItemRef, other_path: &[u8], position: u64) -> bool
        requires position < 512;
    {
        transition position < other_path.len && project_item_ref.project_item_path[position] == other_path[position] {
            true -> compare(project_item_ref, other_path, position + 1)
            false -> (false)
            _ -> (false)
        }
    }
}


pub machine ProjectItemRef::clone(project_item_ref: &ProjectItemRef) -> ProjectItemRef {
    let mut cloned: ProjectItemRef = ProjectItemRef::default();
    ProjectItemRef::set_project_item_path(&mut cloned, ProjectItemRef::get_project_item_path(project_item_ref));
    (cloned)
}

pub machine ProjectItemRef::clone_from(project_item_ref: &mut ProjectItemRef, source: &ProjectItemRef) {
    ProjectItemRef::set_project_item_path(project_item_ref, ProjectItemRef::get_project_item_path(source));
}

