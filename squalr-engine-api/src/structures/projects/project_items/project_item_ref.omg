module src::structures::projects::project_items::project_item_ref;

// Port of structures/projects/project_items/project_item_ref.rs — the
// stable handle a project item is keyed by (its path inside the project
// tree). PathBuf carries as the bounded path carrier.
pub data ProjectItemRef {
    project_item_path: [u8; 512];
    project_item_path_len: u64;
}

pub machine ProjectItemRef::new(project_item_path: &[u8]) -> ProjectItemRef {
    let mut created: ProjectItemRef = ProjectItemRef {
        project_item_path_len: 0,
    };
    created.set_project_item_path(project_item_path);
    (created)
}

pub machine ProjectItemRef::default() -> ProjectItemRef {
    ProjectItemRef {
        project_item_path_len: 0,
    }
}

pub machine ProjectItemRef::get_project_item_path(&self) -> &[u8] {
    transition self.project_item_path_len <= 512 {
        true -> (&self.project_item_path[0..self.project_item_path_len])
        false -> (&self.project_item_path[0..512])
        _ -> (&self.project_item_path[0..512])
    }
}

pub machine ProjectItemRef::set_project_item_path(&mut self, project_item_path: &[u8]) {
    self.project_item_path_len = 0;
    transition {
        _ -> copy(project_item_path, 0)
    }
    state copy(&mut self, project_item_path: &[u8], position: u64) {
        transition position < project_item_path.len && position < 512 {
            true -> store(project_item_path, position)
            false -> finish(position)
        }
    }
    state store(&mut self, project_item_path: &[u8], position: u64) {
        self.project_item_path[position] = project_item_path[position];
        transition {
            _ -> copy(project_item_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.project_item_path_len = count;
    }
}

// Upstream `get_file_or_directory_name` — the final path component. The
// port surfaces it as a copy-out accessor (the start index is arithmetic
// on the stored len, which the subslice bounds checker cannot discharge);
// `copy_file_or_directory_name` fills `out` with the name bytes and
// returns the name length (0 when the path has no trailing component).
// A `file_name_length` machine mirrors upstream's component length for
// callers that only need the bound.
pub machine ProjectItemRef::get_file_or_directory_name_length(&self) -> u64 {
    transition {
        _ -> find_separator(self.project_item_path_len)
    }
    state find_separator(&self, position: u64) -> u64 {
        transition 0 < position && position <= self.project_item_path_len {
            true -> probe(position)
            false -> (self.project_item_path_len)
        }
    }
    state probe(&self, position: u64) -> u64 {
        let index: u64 = position - 1;
        transition index < self.project_item_path_len && index < 512 {
            true -> inspect(index)
            false -> (self.project_item_path_len)
        }
    }
    state inspect(&self, index: u64) -> u64
        requires index < 512;
    {
        let byte: u8 = self.project_item_path[index];
        transition byte == 47 || byte == 92 {
            true -> emit(index)
            false -> find_separator(index)
        }
    }
    state emit(&self, index: u64) -> u64
        requires index < self.project_item_path_len;
    {
        (self.project_item_path_len - index - 1)
    }
}

pub machine ProjectItemRef::copy_file_or_directory_name(&mut self, out_file_name: &mut [u8; 512]) -> u64 {
    let name_start: u64 = self.get_file_name_start();
    transition {
        _ -> walk(out_file_name, name_start, 0)
    }
    // walk copies project_item_path[source_index] into out[out_position]
    // while the source stays inside the live path — the source index
    // reaches project_item_path_len exactly when the name ends.
    state walk(&mut self, out_file_name: &mut [u8; 512], source_index: u64, out_position: u64) -> u64
        requires out_position < 512;
    {
        transition source_index < self.project_item_path_len && source_index < 512 {
            true -> store(out_file_name, source_index, out_position)
            false -> (out_position)
        }
    }
    state store(&mut self, out_file_name: &mut [u8; 512], source_index: u64, out_position: u64) -> u64
        requires source_index < self.project_item_path_len && source_index < 512 && out_position < 512;
    {
        out_file_name[out_position] = self.project_item_path[source_index];
        let next_source: u64 = ((source_index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        let next_out: u64 = ((out_position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next_source < 512 && next_out < 512 {
            true -> walk(out_file_name, next_source, next_out)
            false -> (next_out)
        }
    }
}

// get_file_name_start — index of the first byte after the final separator;
// 0 when the path has no separator, len when it ends in one (empty name —
// upstream Path::file_name agrees: a trailing separator yields no final
// component).
pub machine ProjectItemRef::get_file_name_start(&self) -> u64 {
    transition {
        _ -> find_separator(self.project_item_path_len)
    }
    state find_separator(&self, position: u64) -> u64 {
        transition 0 < position && position <= self.project_item_path_len {
            true -> probe(position)
            false -> (0)
        }
    }
    state probe(&self, position: u64) -> u64 {
        let index: u64 = position - 1;
        transition index < self.project_item_path_len && index < 512 {
            true -> inspect(index)
            false -> (0)
        }
    }
    state inspect(&self, index: u64) -> u64
        requires index < 512;
    {
        let byte: u8 = self.project_item_path[index];
        transition byte == 47 || byte == 92 {
            true -> emit_start(index)
            false -> find_separator(index)
        }
    }
    state emit_start(&self, index: u64) -> u64
        requires index < 512;
    {
        (index + 1)
    }
}


// Upstream `get_file_or_directory_name` — the view of the final path
// component (`copy_file_or_directory_name` is the filling spelling for
// fixed receivers).
pub machine ProjectItemRef::get_file_or_directory_name(&self) -> &[u8] {
    let name_start: u64 = self.get_file_name_start();
    transition name_start <= self.project_item_path_len && self.project_item_path_len <= 512 {
        true -> (&self.project_item_path[name_start..self.project_item_path_len])
        false -> (&self.project_item_path[0..0])
        _ -> (&self.project_item_path[0..0])
    }
}

// Path equality for keyed lookups (`Project` stores pairs keyed by ref;
// upstream HashMap equality lands on the path bytes).
pub machine ProjectItemRef::path_equals(&self, other: &ProjectItemRef) -> bool {
    let other_path: &[u8] = other.get_project_item_path();
    transition self.project_item_path_len == other_path.len {
        true -> compare(other_path, 0)
        false -> (false)
        _ -> (false)
    }
    state compare(&self, other_path: &[u8], position: u64) -> bool {
        transition position < self.project_item_path_len && position < 512 {
            true -> probe(other_path, position)
            false -> (true)
            _ -> (false)
        }
    }
    state probe(&self, other_path: &[u8], position: u64) -> bool
        requires position < 512;
    {
        transition position < other_path.len && self.project_item_path[position] == other_path[position] {
            true -> compare(other_path, position + 1)
            false -> (false)
            _ -> (false)
        }
    }
}


pub machine ProjectItemRef::clone(&self) -> ProjectItemRef {
    let mut cloned: ProjectItemRef = ProjectItemRef::default();
    cloned.set_project_item_path(self.get_project_item_path());
    (cloned)
}

pub machine ProjectItemRef::clone_from(&mut self, source: &ProjectItemRef) {
    self.set_project_item_path(source.get_project_item_path());
}

