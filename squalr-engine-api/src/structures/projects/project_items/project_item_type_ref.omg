module src::structures::projects::project_items::project_item_type_ref;

// Port of structures/projects/project_items/project_item_type_ref.rs —
// the handle naming which ProjectItemType a project item uses. Upstream
// `String` carries as the bounded id.
pub data ProjectItemTypeRef {
    project_item_type_id: [u8; 64];
    project_item_type_id_len: u64;
}

pub machine ProjectItemTypeRef::new(project_item_type_id: &[u8]) -> ProjectItemTypeRef {
    let mut created: ProjectItemTypeRef = ProjectItemTypeRef {
        project_item_type_id_len: 0,
    };
    ProjectItemTypeRef::set_project_item_type_id(&mut created, project_item_type_id);
    (created)
}

pub machine ProjectItemTypeRef::default() -> ProjectItemTypeRef {
    ProjectItemTypeRef {
        project_item_type_id_len: 0,
    }
}

pub machine ProjectItemTypeRef::get_project_item_type_id(this: &ProjectItemTypeRef) -> &[u8] {
    transition this.project_item_type_id_len <= 64 {
        true -> (&this.project_item_type_id[0..this.project_item_type_id_len])
        false -> (&this.project_item_type_id[0..64])
        _ -> (&this.project_item_type_id[0..64])
    }
}

pub machine ProjectItemTypeRef::set_project_item_type_id(this: &mut ProjectItemTypeRef, project_item_type_id: &[u8]) {
    this.project_item_type_id_len = 0;
    transition {
        _ -> copy(this, project_item_type_id, 0)
    }
    state copy(this: &mut ProjectItemTypeRef, project_item_type_id: &[u8], position: u64) {
        transition position < project_item_type_id.len && position < 64 {
            true -> store(this, project_item_type_id, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ProjectItemTypeRef, project_item_type_id: &[u8], position: u64) {
        this.project_item_type_id[position] = project_item_type_id[position];
        transition {
            _ -> copy(this, project_item_type_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut ProjectItemTypeRef, count: u64) {
        this.project_item_type_id_len = count;
    }
}

pub machine ProjectItemTypeRef::clone(this: &ProjectItemTypeRef) -> ProjectItemTypeRef {
    let mut cloned: ProjectItemTypeRef = ProjectItemTypeRef::default();
    ProjectItemTypeRef::set_project_item_type_id(&mut cloned, ProjectItemTypeRef::get_project_item_type_id(this));
    (cloned)
}

pub machine ProjectItemTypeRef::clone_from(this: &mut ProjectItemTypeRef, source: &ProjectItemTypeRef) {
    ProjectItemTypeRef::set_project_item_type_id(&mut this, ProjectItemTypeRef::get_project_item_type_id(source));
}
