module src::structures::projects::project_items::project_item_type_ref;

// Port of structures/projects/project_items/project_item_type_ref.rs —
// the handle naming which ProjectItemType a project item uses. Upstream
// `String` carries as the bounded id.
pub data ProjectItemTypeRef {
    project_item_type_id: [u8; 64];
    project_item_type_id_len: u64;
}

pub machine ProjectItemTypeRef::new(project_item_type_id: &[u8]) -> ProjectItemTypeRef {
    let mut created: ProjectItemTypeRef = ProjectItemTypeRef {
        project_item_type_id_len: 0,
    };
    created.set_project_item_type_id(project_item_type_id);
    (created)
}

pub machine ProjectItemTypeRef::default() -> ProjectItemTypeRef {
    ProjectItemTypeRef {
        project_item_type_id_len: 0,
    }
}

pub machine ProjectItemTypeRef::get_project_item_type_id(&self) -> &[u8] {
    transition self.project_item_type_id_len <= 64 {
        true -> (&self.project_item_type_id[0..self.project_item_type_id_len])
        false -> (&self.project_item_type_id[0..64])
        _ -> (&self.project_item_type_id[0..64])
    }
}

pub machine ProjectItemTypeRef::set_project_item_type_id(&mut self, project_item_type_id: &[u8]) {
    self.project_item_type_id_len = 0;
    transition {
        _ -> copy(project_item_type_id, 0)
    }
    state copy(&mut self, project_item_type_id: &[u8], position: u64) {
        transition position < project_item_type_id.len && position < 64 {
            true -> store(project_item_type_id, position)
            false -> finish(position)
        }
    }
    state store(&mut self, project_item_type_id: &[u8], position: u64) {
        self.project_item_type_id[position] = project_item_type_id[position];
        transition {
            _ -> copy(project_item_type_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.project_item_type_id_len = count;
    }
}
