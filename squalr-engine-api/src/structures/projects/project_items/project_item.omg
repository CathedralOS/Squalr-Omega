module src::structures::projects::project_items::project_item;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::data_values::data_value::DataValue;
use src::structures::projects::project_items::project_item_type_ref::ProjectItemTypeRef;
use src::structures::structs::valued_struct::ValuedStruct;
use src::structures::structs::valued_struct::ValuedStructFieldLookup;
use src::structures::structs::valued_struct::ValuedStructPool;
use src::structures::structs::valued_struct_field::ValuedStructField;
use src::structures::structs::valued_struct_field::ValuedStructFieldData;

// Port of structures/projects/project_items/project_item.rs — one project
// tree node: its type ref, the ValuedStruct property bag (name/icon_id/
// description live inside it upstream — the serde surface stores them as
// struct fields), and the runtime flags. The upstream machine surface that
// touches registry/bindings (`set_activated`'s on_activated_changed hook)
// is deferred to the unprivileged-state leg — the flag write stays here,
// the registry dispatch is the session's job and lands with it.
pub data ProjectItem {
    item_type: ProjectItemTypeRef;
    properties: ValuedStruct;
    // Upstream stores `NestedStruct(Box<ValuedStruct>)` children inside the
    // property fields themselves; the port's arena indirection for those
    // children (see valued_struct.omg) lives on the owning item — there is
    // no other structural owner for a single item's nested pool.
    struct_pool: ValuedStructPool;
    is_activated: bool;
    has_unsaved_changes: bool;
    current_data_value_interpreter: [u8; 256];
    current_data_value_interpreter_len: u64;
}

// Upstream `ProjectItem::new` — constructs the empty record, then stores
// the name property (`set_field_name` — the serde surface upstream stores
// name/icon_id/description inside the ValuedStruct property bag).
pub machine ProjectItem::new(item_type: ProjectItemTypeRef, name: &[u8]) -> ProjectItem {
    let mut created: ProjectItem = ProjectItem {
        item_type: item_type,
        properties: ValuedStruct::default(),
        is_activated: false,
        has_unsaved_changes: true,
        current_data_value_interpreter_len: 0,
    };
    ProjectItem::set_field_name(&mut created, name);
    (created)
}

// Upstream `set_field_name` — PROPERTY_NAME "name" rides the property bag
// as a DataValue typed `string_utf8` (DataTypeStringUtf8's id constant;
// the data-type machinery itself lands with the structures registry leg).
pub machine ProjectItem::set_field_name(project_item: &mut ProjectItem, name: &[u8]) {
    let data_type_ref: DataTypeRef = DataTypeRef::new("string_utf8");
    let name_data_value: DataValue = DataValue::new(&data_type_ref, name);
    let field_data: ValuedStructFieldData = ValuedStructFieldData::Value { value: name_data_value };
    ValuedStruct::set_field_data(&mut project_item.properties, "name", &field_data, false);
}

// Upstream `get_field_name` — reads PROPERTY_NAME back out of the bag into
// the caller's buffer; returns the byte count stored, 0 on missing/nested
// (upstream returns "" for both). Fill-spelling like
// `ProjectItemRef::copy_file_or_directory_name`.
pub machine ProjectItem::get_field_name(project_item: &ProjectItem, out_name: &mut [u8; 256]) -> u64 {
    let lookup: ValuedStructFieldLookup = ValuedStruct::find_field(&project_item.properties, "name");
    transition lookup {
        ValuedStructFieldLookup::Found { index } -> emit(project_item, index, out_name)
        ValuedStructFieldLookup::Missing -> (0)
        _ -> (0)
    }
    state emit(project_item: &ProjectItem, index: u64, out_name: &mut [u8; 256]) -> u64 {
        let field: ValuedStructField = ValuedStruct::get_field_at(&project_item.properties, index);
        transition ValuedStructField::is_value(&field) {
            true -> copy(project_item, field, out_name)
            false -> (0)
            _ -> (0)
        }
    }
    state copy(project_item: &ProjectItem, field: ValuedStructField, out_name: &mut [u8; 256]) -> u64 {
        let data_value: DataValue = ValuedStructField::get_data_value(&field);
        let bytes: &[u8] = DataValue::get_value_bytes(&data_value);
        transition {
            _ -> fill(project_item, bytes, out_name, 0)
        }
    }
    state fill(project_item: &ProjectItem, bytes: &[u8], out_name: &mut [u8; 256], position: u64) -> u64 {
        transition position < bytes.len && position < 256 {
            true -> store(project_item, bytes, out_name, position)
            false -> (position)
            _ -> (position)
        }
    }
    state store(project_item: &ProjectItem, bytes: &[u8], out_name: &mut [u8; 256], position: u64) -> u64
        requires position < 256;
    {
        out_name[position] = bytes[position];
        transition {
            _ -> fill(project_item, bytes, out_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

pub machine ProjectItem::default() -> ProjectItem {
    (ProjectItem {
        item_type: ProjectItemTypeRef::default(),
        properties: ValuedStruct::default(),
        is_activated: false,
        has_unsaved_changes: false,
        current_data_value_interpreter_len: 0,
    })
}

pub machine ProjectItem::get_item_type(project_item: &ProjectItem) -> &ProjectItemTypeRef {
    (&project_item.item_type)
}

pub machine ProjectItem::get_properties(project_item: &ProjectItem) -> &ValuedStruct {
    (&project_item.properties)
}

pub machine ProjectItem::borrow_properties_mut(project_item: &mut ProjectItem) -> &mut ValuedStruct {
    (&mut project_item.properties)
}

pub machine ProjectItem::get_has_unsaved_changes(project_item: &ProjectItem) -> bool {
    project_item.has_unsaved_changes
}

pub machine ProjectItem::set_has_unsaved_changes(project_item: &mut ProjectItem, has_unsaved_changes: bool) {
    project_item.has_unsaved_changes = has_unsaved_changes;
}

pub machine ProjectItem::get_is_activated(project_item: &ProjectItem) -> bool {
    project_item.is_activated
}

// Upstream `toggle_activated`.
pub machine ProjectItem::toggle_activated(project_item: &mut ProjectItem) {
    project_item.is_activated = !project_item.is_activated;
}

// Upstream `set_activated` minus its registry dispatch (noted above — the
// hook replays through project_item_type_registry and lands with the
// unprivileged-state leg).
pub machine ProjectItem::set_activated(project_item: &mut ProjectItem, is_activated: bool) {
    project_item.is_activated = is_activated;
}

// Upstream `get_display_string` — the cached interpreter text.
pub machine ProjectItem::get_display_string(project_item: &ProjectItem) -> &[u8] {
    transition project_item.current_data_value_interpreter_len <= 256 {
        true -> (&project_item.current_data_value_interpreter[0..project_item.current_data_value_interpreter_len])
        false -> (&project_item.current_data_value_interpreter[0..256])
        _ -> (&project_item.current_data_value_interpreter[0..256])
    }
}

pub machine ProjectItem::set_display_string(project_item: &mut ProjectItem, interpreter: &[u8]) {
    project_item.current_data_value_interpreter_len = 0;
    transition {
        _ -> copy(project_item, interpreter, 0)
    }
    state copy(project_item: &mut ProjectItem, interpreter: &[u8], position: u64) {
        transition position < interpreter.len && position < 256 {
            true -> store(project_item, interpreter, position)
            false -> finish(project_item, position)
        }
    }
    state store(project_item: &mut ProjectItem, interpreter: &[u8], position: u64) {
        project_item.current_data_value_interpreter[position] = interpreter[position];
        transition {
            _ -> copy(project_item, interpreter, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(project_item: &mut ProjectItem, count: u64) {
        project_item.current_data_value_interpreter_len = count;
    }
}

pub machine ProjectItem::clone(source: &ProjectItem) -> ProjectItem {
    let mut cloned: ProjectItem = ProjectItem::default();
    ProjectItem::clone_from(&mut cloned, source);
    (cloned)
}

pub machine ProjectItem::clone_from(project_item: &mut ProjectItem, source: &ProjectItem) {
    ProjectItemTypeRef::clone_from(&mut project_item.item_type, &source.item_type);
    ValuedStruct::clone_from(&mut project_item.properties, &source.properties);
    ValuedStructPool::clone_from(&mut project_item.struct_pool, &source.struct_pool);
    project_item.is_activated = source.is_activated;
    project_item.has_unsaved_changes = source.has_unsaved_changes;
    ProjectItem::set_display_string(project_item, ProjectItem::get_display_string(source));
}
