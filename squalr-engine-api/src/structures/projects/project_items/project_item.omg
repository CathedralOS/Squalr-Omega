module src::structures::projects::project_items::project_item;

use src::structures::projects::project_items::project_item_type_ref::ProjectItemTypeRef;
use src::structures::structs::valued_struct::ValuedStruct;

// Port of structures/projects/project_items/project_item.rs — one project
// tree node: its type ref, the ValuedStruct property bag (name/icon_id/
// description live inside it upstream — the serde surface stores them as
// struct fields), and the runtime flags. The upstream machine surface that
// touches registry/bindings (`set_activated`'s on_activated_changed hook)
// is deferred to the unprivileged-state leg — the flag write stays here,
// the registry dispatch is the session's job and lands with it.
pub data ProjectItem {
    item_type: ProjectItemTypeRef;
    properties: ValuedStruct;
    is_activated: bool;
    has_unsaved_changes: bool;
    current_data_value_interpreter: [u8; 256];
    current_data_value_interpreter_len: u64;
}

pub machine ProjectItem::new(item_type: ProjectItemTypeRef) -> ProjectItem {
    (ProjectItem {
        item_type: item_type,
        properties: ValuedStruct::default(),
        is_activated: false,
        has_unsaved_changes: true,
        current_data_value_interpreter_len: 0,
    })
}

pub machine ProjectItem::default() -> ProjectItem {
    (ProjectItem {
        item_type: ProjectItemTypeRef::default(),
        properties: ValuedStruct::default(),
        is_activated: false,
        has_unsaved_changes: false,
        current_data_value_interpreter_len: 0,
    })
}

pub machine ProjectItem::get_item_type(&self) -> &ProjectItemTypeRef {
    (&self.item_type)
}

pub machine ProjectItem::get_properties(&self) -> &ValuedStruct {
    (&self.properties)
}

pub machine ProjectItem::borrow_properties_mut(&mut self) -> &mut ValuedStruct {
    (&mut self.properties)
}

pub machine ProjectItem::get_has_unsaved_changes(&self) -> bool {
    self.has_unsaved_changes
}

pub machine ProjectItem::set_has_unsaved_changes(&mut self, has_unsaved_changes: bool) {
    self.has_unsaved_changes = has_unsaved_changes;
}

pub machine ProjectItem::get_is_activated(&self) -> bool {
    self.is_activated
}

// Upstream `toggle_activated`.
pub machine ProjectItem::toggle_activated(&mut self) {
    self.is_activated = !self.is_activated;
}

// Upstream `set_activated` minus its registry dispatch (noted above — the
// hook replays through project_item_type_registry and lands with the
// unprivileged-state leg).
pub machine ProjectItem::set_activated(&mut self, is_activated: bool) {
    self.is_activated = is_activated;
}

// Upstream `get_display_string` — the cached interpreter text.
pub machine ProjectItem::get_display_string(&self) -> &[u8] {
    transition self.current_data_value_interpreter_len <= 256 {
        true -> (&self.current_data_value_interpreter[0..self.current_data_value_interpreter_len])
        false -> (&self.current_data_value_interpreter[0..256])
        _ -> (&self.current_data_value_interpreter[0..256])
    }
}

pub machine ProjectItem::set_display_string(&mut self, interpreter: &[u8]) {
    self.current_data_value_interpreter_len = 0;
    transition {
        _ -> copy(interpreter, 0)
    }
    state copy(&mut self, interpreter: &[u8], position: u64) {
        transition position < interpreter.len && position < 256 {
            true -> store(interpreter, position)
            false -> finish(position)
        }
    }
    state store(&mut self, interpreter: &[u8], position: u64) {
        self.current_data_value_interpreter[position] = interpreter[position];
        transition {
            _ -> copy(interpreter, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.current_data_value_interpreter_len = count;
    }
}
