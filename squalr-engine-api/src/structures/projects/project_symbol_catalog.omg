// Port of structures/projects/project_symbol_catalog.rs — the project's
// symbol database: modules, layout descriptors, resolver descriptors and
// claims. Upstream's unbounded Vecs carry honest bounds with refusal.
// The 4-step upstream ctor chain (new / new_with_symbol_claims /
// new_with_modules_and_symbol_claims /
// new_with_modules_resolvers_and_symbol_claims) carries as
// `new`/`new_empty` + `add_*` push machines — upstream's Vec-taking
// ctors are equivalent to empty + push chains under bounded carriers.
//
// Residuals (the 710-line file's machinery, not its data):
// find_module_field / parse_symbol_locator_key (format! +
// span parsing), resolver materialization (resolve_*/evaluate callbacks
// into the 992-line definition methods), build_symbol_tree (3149 lines),
// the symbol_registry itself (1787) and symbol_layout_details/draft_ops
// (659/718) — all named behavior legs, none are data structure.
pub data ProjectSymbolCatalog {
    symbol_modules: [ProjectSymbolModule; 64];
    symbol_module_count: u64;
    struct_layout_descriptors: [StructLayoutDescriptor; 128];
    struct_layout_descriptor_count: u64;
    symbolic_resolver_descriptors: [SymbolicResolverDescriptor; 64];
    symbolic_resolver_descriptor_count: u64;
    symbol_claims: [ProjectSymbolClaim; 128];
    symbol_claim_count: u64;
}

pub machine ProjectSymbolCatalog::default() -> ProjectSymbolCatalog {
    (ProjectSymbolCatalog {
        symbol_module_count: 0,
        struct_layout_descriptor_count: 0,
        symbolic_resolver_descriptor_count: 0,
        symbol_claim_count: 0,
    })
}

// Upstream `new(struct_layout_descriptors)` — start empty, callers push
// layout descriptors via add_struct_layout_descriptor.
pub machine ProjectSymbolCatalog::new() -> ProjectSymbolCatalog {
    (ProjectSymbolCatalog::default())
}

pub machine ProjectSymbolCatalog::get_symbol_module_count(project_symbol_catalog: &ProjectSymbolCatalog) -> u64 {
    (project_symbol_catalog.symbol_module_count)
}

pub machine ProjectSymbolCatalog::get_symbol_module(project_symbol_catalog: &ProjectSymbolCatalog, position: u64) -> &ProjectSymbolModule
    requires position < project_symbol_catalog.symbol_module_count && position < 64
{
    (&project_symbol_catalog.symbol_modules[position])
}

// Upstream `get_symbol_modules_mut` element — caller mutates in place.
pub machine ProjectSymbolCatalog::get_symbol_module_mut(project_symbol_catalog: &mut ProjectSymbolCatalog, position: u64) -> &mut ProjectSymbolModule
    requires position < project_symbol_catalog.symbol_module_count && position < 64
{
    (&mut project_symbol_catalog.symbol_modules[position])
}

// Upstream `symbol_modules.push` — refusal past the bound.
pub machine ProjectSymbolCatalog::add_symbol_module(project_symbol_catalog: &mut ProjectSymbolCatalog, symbol_module: &ProjectSymbolModule) -> bool {
    transition project_symbol_catalog.symbol_module_count < 64 {
        true -> store(project_symbol_catalog, symbol_module)
        false -> (false)
    }
    state store(project_symbol_catalog: &mut ProjectSymbolCatalog, symbol_module: &ProjectSymbolModule) -> bool {
        ProjectSymbolModule::clone_from(&mut project_symbol_catalog.symbol_modules[project_symbol_catalog.symbol_module_count], symbol_module);
        project_symbol_catalog.symbol_module_count = ((project_symbol_catalog.symbol_module_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `find_symbol_module` — Option respell: the slot position, or
// symbol_module_count when no module's name equals the argument span.
pub machine ProjectSymbolCatalog::find_symbol_module_position(project_symbol_catalog: &ProjectSymbolCatalog, module_name: &[u8]) -> u64 {
    transition {
        _ -> scan(project_symbol_catalog, module_name, 0)
    }
    state scan(project_symbol_catalog: &ProjectSymbolCatalog, module_name: &[u8], position: u64) -> u64 {
        transition position < project_symbol_catalog.symbol_module_count && position < 64 {
            true -> compare(project_symbol_catalog, module_name, position)
            false -> (position)
        }
    }
    state compare(project_symbol_catalog: &ProjectSymbolCatalog, module_name: &[u8], position: u64) -> u64
        requires position < project_symbol_catalog.symbol_module_count && position < 64
    {
        let found: bool = bytes_equal(ProjectSymbolModule::get_module_name(&project_symbol_catalog.symbol_modules[position]), module_name);
        transition found {
            true -> (position)
            false -> (scan(project_symbol_catalog, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64))
        }
    }
}

pub machine ProjectSymbolCatalog::get_struct_layout_descriptor_count(project_symbol_catalog: &ProjectSymbolCatalog) -> u64 {
    (project_symbol_catalog.struct_layout_descriptor_count)
}

pub machine ProjectSymbolCatalog::get_struct_layout_descriptor(project_symbol_catalog: &ProjectSymbolCatalog, position: u64) -> &StructLayoutDescriptor
    requires position < project_symbol_catalog.struct_layout_descriptor_count && position < 128
{
    (&project_symbol_catalog.struct_layout_descriptors[position])
}

pub machine ProjectSymbolCatalog::add_struct_layout_descriptor(project_symbol_catalog: &mut ProjectSymbolCatalog, descriptor: &StructLayoutDescriptor) -> bool {
    transition project_symbol_catalog.struct_layout_descriptor_count < 128 {
        true -> store(project_symbol_catalog, descriptor)
        false -> (false)
    }
    state store(project_symbol_catalog: &mut ProjectSymbolCatalog, descriptor: &StructLayoutDescriptor) -> bool {
        StructLayoutDescriptor::clone_from(&mut project_symbol_catalog.struct_layout_descriptors[project_symbol_catalog.struct_layout_descriptor_count], descriptor);
        project_symbol_catalog.struct_layout_descriptor_count = ((project_symbol_catalog.struct_layout_descriptor_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine ProjectSymbolCatalog::get_symbolic_resolver_descriptor_count(project_symbol_catalog: &ProjectSymbolCatalog) -> u64 {
    (project_symbol_catalog.symbolic_resolver_descriptor_count)
}

pub machine ProjectSymbolCatalog::get_symbolic_resolver_descriptor(project_symbol_catalog: &ProjectSymbolCatalog, position: u64) -> &SymbolicResolverDescriptor
    requires position < project_symbol_catalog.symbolic_resolver_descriptor_count && position < 64
