pub machine ProjectSymbolCatalog::add_symbolic_resolver_descriptor(project_symbol_catalog: &mut ProjectSymbolCatalog, descriptor: &SymbolicResolverDescriptor) -> bool {
    transition project_symbol_catalog.symbolic_resolver_descriptor_count < 64 {
        true -> store(project_symbol_catalog, descriptor)
