module src::structures::projects::project_symbol_claim;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::bounded_slice::bounded_slice;

use src::structures::projects::project_symbol_locator::ProjectSymbolLocator;

// One key/value row of upstream's `BTreeMap<String, String>` claim
// metadata. Bounded spans per the carrier convention.
pub data ProjectSymbolClaimMetadataEntry {
    key: [u8; 256];
    key_len: u64;
    value: [u8; 256];
    value_len: u64;
}

pub machine ProjectSymbolClaimMetadataEntry::default() -> ProjectSymbolClaimMetadataEntry {
    (ProjectSymbolClaimMetadataEntry {
        key_len: 0,
        value_len: 0,
    })
}

pub machine ProjectSymbolClaimMetadataEntry::get_key(&self) -> &[u8] {
    bounded_slice(&self.key[0..256], self.key_len)
}

pub machine ProjectSymbolClaimMetadataEntry::get_value(&self) -> &[u8] {
    bounded_slice(&self.value[0..256], self.value_len)
}

pub machine ProjectSymbolClaimMetadataEntry::clone_from(&mut self, source: &ProjectSymbolClaimMetadataEntry) {
    let key_view: &[u8] = bounded_slice(&source.key[0..256], source.key_len);
    let mut copied: u64 = BoundedByteCopy::copy(&mut self.key[0..256], key_view);
    self.key_len = source.key_len;
    let value_view: &[u8] = bounded_slice(&source.value[0..256], source.value_len);
    copied = BoundedByteCopy::copy(&mut self.value[0..256], value_view);
    self.value_len = source.value_len;
}

// Port of structures/projects/project_symbol_claim.rs — a display name +
// locator + layout id for a claimed symbol. Upstream's
// `BTreeMap<String, String>` metadata carries as a bounded entry list
// (insertion order; BTreeMap key ordering rides the sort leg).
pub data ProjectSymbolClaim {
    display_name: [u8; 256];
    display_name_len: u64;
    locator: ProjectSymbolLocator;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
    metadata: [ProjectSymbolClaimMetadataEntry; 64];
    metadata_count: u64;
}

pub machine ProjectSymbolClaim::default() -> ProjectSymbolClaim {
    (ProjectSymbolClaim {
        display_name_len: 0,
        struct_layout_id_len: 0,
        metadata_count: 0,
    })
}

pub machine ProjectSymbolClaim::new(display_name: &[u8], locator: &ProjectSymbolLocator, struct_layout_id: &[u8]) -> ProjectSymbolClaim {
    let mut claim: ProjectSymbolClaim = (ProjectSymbolClaim {
        display_name_len: 0,
        struct_layout_id_len: 0,
        metadata_count: 0,
    });
    claim.set_display_name(display_name);
    claim.set_struct_layout_id(struct_layout_id);
    claim.locator.clone_from(locator);
    (claim)
}

// Upstream `new_absolute_address`.
pub machine ProjectSymbolClaim::new_absolute_address(display_name: &[u8], address: u64, struct_layout_id: &[u8]) -> ProjectSymbolClaim {
    let built_locator: ProjectSymbolLocator = ProjectSymbolLocator::new_absolute_address(address);
    (ProjectSymbolClaim::new(display_name, &built_locator, struct_layout_id))
}

// Upstream `new_module_offset`.
pub machine ProjectSymbolClaim::new_module_offset(display_name: &[u8], module_name: &[u8], offset: u64, struct_layout_id: &[u8]) -> ProjectSymbolClaim {
    let built_locator: ProjectSymbolLocator = ProjectSymbolLocator::new_module_offset(module_name, offset);
    (ProjectSymbolClaim::new(display_name, &built_locator, struct_layout_id))
}

pub machine ProjectSymbolClaim::get_display_name(&self) -> &[u8] {
    bounded_slice(&self.display_name[0..256], self.display_name_len)
}

pub machine ProjectSymbolClaim::set_display_name(&mut self, display_name: &[u8]) {
    self.display_name_len = BoundedByteCopy::copy(&mut self.display_name[0..256], display_name);
}

pub machine ProjectSymbolClaim::get_locator(&self) -> &ProjectSymbolLocator {
    (&self.locator)
}

pub machine ProjectSymbolClaim::get_struct_layout_id(&self) -> &[u8] {
    bounded_slice(&self.struct_layout_id[0..256], self.struct_layout_id_len)
}

pub machine ProjectSymbolClaim::set_struct_layout_id(&mut self, struct_layout_id: &[u8]) {
    self.struct_layout_id_len = BoundedByteCopy::copy(&mut self.struct_layout_id[0..256], struct_layout_id);
}

pub machine ProjectSymbolClaim::get_metadata_count(&self) -> u64 {
    (self.metadata_count)
}

pub machine ProjectSymbolClaim::get_metadata(&self, position: u64) -> &ProjectSymbolClaimMetadataEntry
    requires position < self.metadata_count && position < 64
{
    (&self.metadata[position])
}

// Upstream `metadata.insert` — bounded; refusal past 64 entries.
pub machine ProjectSymbolClaim::add_metadata(&mut self, key: &[u8], value: &[u8]) -> bool {
    transition self.metadata_count < 64 && key.len <= 256 && value.len <= 256 {
        true -> store(key, value)
        false -> (false)
    }
    state store(&mut self, key: &[u8], value: &[u8]) -> bool {
        let mut key_buffer: [u8; 256];
        let key_count: u64 = BoundedByteCopy::copy(&mut key_buffer[0..256], key);
        let mut value_buffer: [u8; 256];
        let value_count: u64 = BoundedByteCopy::copy(&mut value_buffer[0..256], value);
        let entry: ProjectSymbolClaimMetadataEntry = (ProjectSymbolClaimMetadataEntry {
            key: key_buffer,
            key_len: key_count,
            value: value_buffer,
            value_len: value_count,
        });
        self.metadata[self.metadata_count].clone_from(&entry);
        self.metadata_count = ((self.metadata_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `Clone` — spans + locator + metadata copy element-wise.
pub machine ProjectSymbolClaim::clone_from(&mut self, source: &ProjectSymbolClaim) {
    self.metadata_count = 0;
    self.locator.clone_from(&source.locator);
    transition {
        _ -> copy_name(source, 0)
    }
    state copy_name(&mut self, source: &ProjectSymbolClaim, position: u64) {
        transition position < source.display_name_len && position < 256 {
            true -> store_name(source, position)
            false -> finish_name(source)
        }
    }
    state store_name(&mut self, source: &ProjectSymbolClaim, position: u64) {
        self.display_name[position] = source.display_name[position];
        transition {
            _ -> copy_name(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_name(&mut self, source: &ProjectSymbolClaim) {
        self.display_name_len = source.display_name_len;
        transition {
            _ -> copy_layout(source, 0)
        }
    }
    state copy_layout(&mut self, source: &ProjectSymbolClaim, position: u64) {
        transition position < source.struct_layout_id_len && position < 256 {
            true -> store_layout(source, position)
            false -> finish_layout(source)
        }
    }
    state store_layout(&mut self, source: &ProjectSymbolClaim, position: u64) {
        self.struct_layout_id[position] = source.struct_layout_id[position];
        transition {
            _ -> copy_layout(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_layout(&mut self, source: &ProjectSymbolClaim) {
        self.struct_layout_id_len = source.struct_layout_id_len;
        transition {
            _ -> copy_metadata(source, 0)
        }
    }
    state copy_metadata(&mut self, source: &ProjectSymbolClaim, position: u64) {
        transition position < source.metadata_count && position < 64 {
            true -> store_metadata(source, position)
            false -> finish_metadata(source)
        }
    }
    state store_metadata(&mut self, source: &ProjectSymbolClaim, position: u64)
        requires position < source.metadata_count && position < 64
    {
        self.metadata[position].clone_from(&source.metadata[position]);
        transition {
            _ -> copy_metadata(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_metadata(&mut self, source: &ProjectSymbolClaim) {
        self.metadata_count = source.metadata_count;
    }
}

// Upstream `get_symbol_locator_key` — the locator's own key text.
pub machine ProjectSymbolClaim::get_symbol_locator_key(&self, out: &mut [u8; 256]) -> u64 {
    (self.locator.to_locator_key(out))
}

pub machine ProjectSymbolClaim::clone(source: &ProjectSymbolClaim) -> ProjectSymbolClaim {
    let mut cloned: ProjectSymbolClaim = ProjectSymbolClaim::default();
    cloned.clone_from(source);
    (cloned)
}
