module src::structures::projects::project_symbol_claim;

use src::structures::projects::project_symbol_locator::ProjectSymbolLocator;

// One key/value row of upstream's `BTreeMap<String, String>` claim
// metadata. Bounded spans per the carrier convention.
pub data ProjectSymbolClaimMetadataEntry {
    key: [u8; 256];
    key_len: u64;
    value: [u8; 256];
    value_len: u64;
}

pub machine ProjectSymbolClaimMetadataEntry::default() -> ProjectSymbolClaimMetadataEntry {
    (ProjectSymbolClaimMetadataEntry {
        key_len: 0,
        value_len: 0,
    })
}

pub machine ProjectSymbolClaimMetadataEntry::get_key(this: &ProjectSymbolClaimMetadataEntry) -> &[u8] {
    transition this.key_len <= 256 {
        true -> (&this.key[0..this.key_len])
        false -> (&this.key[0..256])
        _ -> (&this.key[0..256])
    }
}

pub machine ProjectSymbolClaimMetadataEntry::get_value(this: &ProjectSymbolClaimMetadataEntry) -> &[u8] {
    transition this.value_len <= 256 {
        true -> (&this.value[0..this.value_len])
        false -> (&this.value[0..256])
        _ -> (&this.value[0..256])
    }
}

pub machine ProjectSymbolClaimMetadataEntry::clone_from(this: &mut ProjectSymbolClaimMetadataEntry, source: &ProjectSymbolClaimMetadataEntry) {
    transition {
        _ -> copy_key(this, source, 0)
    }
    state copy_key(this: &mut ProjectSymbolClaimMetadataEntry, source: &ProjectSymbolClaimMetadataEntry, position: u64) {
        transition position < source.key_len && position < 256 {
            true -> store_key(this, source, position)
            false -> copy_value(this, source, 0)
        }
    }
    state store_key(this: &mut ProjectSymbolClaimMetadataEntry, source: &ProjectSymbolClaimMetadataEntry, position: u64) {
        this.key[position] = source.key[position];
        transition {
            _ -> copy_key(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state copy_value(this: &mut ProjectSymbolClaimMetadataEntry, source: &ProjectSymbolClaimMetadataEntry, position: u64) {
        this.key_len = source.key_len;
        transition position < source.value_len && position < 256 {
            true -> store_value(this, source, position)
            false -> finish(this, source)
        }
    }
    state store_value(this: &mut ProjectSymbolClaimMetadataEntry, source: &ProjectSymbolClaimMetadataEntry, position: u64) {
        this.value[position] = source.value[position];
        transition {
            _ -> copy_value(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut ProjectSymbolClaimMetadataEntry, source: &ProjectSymbolClaimMetadataEntry) {
        this.value_len = source.value_len;
    }
}

// Port of structures/projects/project_symbol_claim.rs — a display name +
// locator + layout id for a claimed symbol. Upstream's
// `BTreeMap<String, String>` metadata carries as a bounded entry list
// (insertion order; BTreeMap key ordering rides the sort leg).
pub data ProjectSymbolClaim {
    display_name: [u8; 256];
    display_name_len: u64;
    locator: ProjectSymbolLocator;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
    metadata: [ProjectSymbolClaimMetadataEntry; 64];
    metadata_count: u64;
}

pub machine ProjectSymbolClaim::default() -> ProjectSymbolClaim {
    (ProjectSymbolClaim {
        display_name_len: 0,
        struct_layout_id_len: 0,
        metadata_count: 0,
    })
}

pub machine ProjectSymbolClaim::new(display_name: &[u8], locator: &ProjectSymbolLocator, struct_layout_id: &[u8]) -> ProjectSymbolClaim {
    let mut claim: ProjectSymbolClaim = (ProjectSymbolClaim {
        display_name_len: 0,
        struct_layout_id_len: 0,
        metadata_count: 0,
    });
    ProjectSymbolClaim::set_display_name(&mut claim, display_name);
    ProjectSymbolClaim::set_struct_layout_id(&mut claim, struct_layout_id);
    ProjectSymbolLocator::clone_from(&mut claim.locator, locator);
    (claim)
}

// Upstream `new_absolute_address`.
pub machine ProjectSymbolClaim::new_absolute_address(display_name: &[u8], address: u64, struct_layout_id: &[u8]) -> ProjectSymbolClaim {
    let built_locator: ProjectSymbolLocator = ProjectSymbolLocator::new_absolute_address(address);
    (ProjectSymbolClaim::new(display_name, &built_locator, struct_layout_id))
}

// Upstream `new_module_offset`.
pub machine ProjectSymbolClaim::new_module_offset(display_name: &[u8], module_name: &[u8], offset: u64, struct_layout_id: &[u8]) -> ProjectSymbolClaim {
    let built_locator: ProjectSymbolLocator = ProjectSymbolLocator::new_module_offset(module_name, offset);
    (ProjectSymbolClaim::new(display_name, &built_locator, struct_layout_id))
}

pub machine ProjectSymbolClaim::get_display_name(this: &ProjectSymbolClaim) -> &[u8] {
    transition this.display_name_len <= 256 {
        true -> (&this.display_name[0..this.display_name_len])
        false -> (&this.display_name[0..256])
        _ -> (&this.display_name[0..256])
    }
}

pub machine ProjectSymbolClaim::set_display_name(this: &mut ProjectSymbolClaim, display_name: &[u8]) {
    this.display_name_len = 0;
    transition {
        _ -> copy(this, display_name, 0)
    }
    state copy(this: &mut ProjectSymbolClaim, display_name: &[u8], position: u64) {
        transition position < display_name.len && position < 256 {
            true -> store(this, display_name, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ProjectSymbolClaim, display_name: &[u8], position: u64) {
        this.display_name[position] = display_name[position];
        transition {
            _ -> copy(this, display_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut ProjectSymbolClaim, count: u64) {
        this.display_name_len = count;
    }
}

pub machine ProjectSymbolClaim::get_locator(this: &ProjectSymbolClaim) -> &ProjectSymbolLocator {
    (&this.locator)
}

pub machine ProjectSymbolClaim::get_struct_layout_id(this: &ProjectSymbolClaim) -> &[u8] {
    transition this.struct_layout_id_len <= 256 {
        true -> (&this.struct_layout_id[0..this.struct_layout_id_len])
        false -> (&this.struct_layout_id[0..256])
        _ -> (&this.struct_layout_id[0..256])
    }
}

pub machine ProjectSymbolClaim::set_struct_layout_id(this: &mut ProjectSymbolClaim, struct_layout_id: &[u8]) {
    this.struct_layout_id_len = 0;
    transition {
        _ -> copy(this, struct_layout_id, 0)
    }
    state copy(this: &mut ProjectSymbolClaim, struct_layout_id: &[u8], position: u64) {
        transition position < struct_layout_id.len && position < 256 {
            true -> store(this, struct_layout_id, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ProjectSymbolClaim, struct_layout_id: &[u8], position: u64) {
        this.struct_layout_id[position] = struct_layout_id[position];
        transition {
            _ -> copy(this, struct_layout_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut ProjectSymbolClaim, count: u64) {
        this.struct_layout_id_len = count;
    }
}

pub machine ProjectSymbolClaim::get_metadata_count(this: &ProjectSymbolClaim) -> u64 {
    (this.metadata_count)
}

pub machine ProjectSymbolClaim::get_metadata(this: &ProjectSymbolClaim, position: u64) -> &ProjectSymbolClaimMetadataEntry
    requires position < this.metadata_count && position < 64
{
    (&this.metadata[position])
}

// Upstream `metadata.insert` — bounded; refusal past 64 entries.
pub machine ProjectSymbolClaim::add_metadata(this: &mut ProjectSymbolClaim, key: &[u8], value: &[u8]) -> bool {
    transition this.metadata_count < 64 && key.len <= 256 && value.len <= 256 {
        true -> store(this, key, value)
        false -> (false)
    }
    state store(this: &mut ProjectSymbolClaim, key: &[u8], value: &[u8]) -> bool {
        let mut key_buffer: [u8; 256];
        let key_count: u64 = copy_bounded_span(&mut key_buffer, key);
        let mut value_buffer: [u8; 256];
        let value_count: u64 = copy_bounded_span(&mut value_buffer, value);
        let entry: ProjectSymbolClaimMetadataEntry = (ProjectSymbolClaimMetadataEntry {
            key: key_buffer,
            key_len: key_count,
            value: value_buffer,
            value_len: value_count,
        });
        ProjectSymbolClaimMetadataEntry::clone_from(&mut this.metadata[this.metadata_count], &entry);
        this.metadata_count = ((this.metadata_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `Clone` — spans + locator + metadata copy element-wise.
pub machine ProjectSymbolClaim::clone_from(this: &mut ProjectSymbolClaim, source: &ProjectSymbolClaim) {
    this.metadata_count = 0;
    ProjectSymbolLocator::clone_from(&mut this.locator, &source.locator);
    transition {
        _ -> copy_name(this, source, 0)
    }
    state copy_name(this: &mut ProjectSymbolClaim, source: &ProjectSymbolClaim, position: u64) {
        transition position < source.display_name_len && position < 256 {
            true -> store_name(this, source, position)
            false -> finish_name(this, source)
        }
    }
    state store_name(this: &mut ProjectSymbolClaim, source: &ProjectSymbolClaim, position: u64) {
        this.display_name[position] = source.display_name[position];
        transition {
            _ -> copy_name(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_name(this: &mut ProjectSymbolClaim, source: &ProjectSymbolClaim) {
        this.display_name_len = source.display_name_len;
        transition {
            _ -> copy_layout(this, source, 0)
        }
    }
    state copy_layout(this: &mut ProjectSymbolClaim, source: &ProjectSymbolClaim, position: u64) {
        transition position < source.struct_layout_id_len && position < 256 {
            true -> store_layout(this, source, position)
            false -> finish_layout(this, source)
        }
    }
    state store_layout(this: &mut ProjectSymbolClaim, source: &ProjectSymbolClaim, position: u64) {
        this.struct_layout_id[position] = source.struct_layout_id[position];
        transition {
            _ -> copy_layout(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_layout(this: &mut ProjectSymbolClaim, source: &ProjectSymbolClaim) {
        this.struct_layout_id_len = source.struct_layout_id_len;
        transition {
            _ -> copy_metadata(this, source, 0)
        }
    }
    state copy_metadata(this: &mut ProjectSymbolClaim, source: &ProjectSymbolClaim, position: u64) {
        transition position < source.metadata_count && position < 64 {
            true -> store_metadata(this, source, position)
            false -> finish_metadata(this, source)
        }
    }
    state store_metadata(this: &mut ProjectSymbolClaim, source: &ProjectSymbolClaim, position: u64)
        requires position < source.metadata_count && position < 64
    {
        ProjectSymbolClaimMetadataEntry::clone_from(&mut this.metadata[position], &source.metadata[position]);
        transition {
            _ -> copy_metadata(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_metadata(this: &mut ProjectSymbolClaim, source: &ProjectSymbolClaim) {
        this.metadata_count = source.metadata_count;
    }
}

machine copy_bounded_span(out: &mut [u8; 256], text: &[u8]) -> u64 {
    transition {
        _ -> copy(out, text, 0)
    }
    state copy(out: &mut [u8; 256], text: &[u8], position: u64) -> u64 {
        transition (position < text.len && position < 256) {
            true -> store(out, text, position)
            false -> (position)
        }
    }
    state store(out: &mut [u8; 256], text: &[u8], position: u64) -> u64
        requires 0 <= position && position < text.len
    {
        out[position] = text[position];
        transition {
            _ -> copy(out, text, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

// Upstream `get_symbol_locator_key` — the locator's own key text.
pub machine ProjectSymbolClaim::get_symbol_locator_key(this: &ProjectSymbolClaim, out: &mut [u8; 256]) -> u64 {
    let hoist1: u64 = ProjectSymbolLocator::to_locator_key(&this.locator, out);
    (hoist1)
}

pub machine ProjectSymbolClaim::clone(source: &ProjectSymbolClaim) -> ProjectSymbolClaim {
    let mut cloned: ProjectSymbolClaim = ProjectSymbolClaim::default();
    ProjectSymbolClaim::clone_from(&mut cloned, source);
    (cloned)
}
