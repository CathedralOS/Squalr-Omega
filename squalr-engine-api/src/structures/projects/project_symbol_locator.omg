module src::structures::projects::project_symbol_locator;

// Port of structures/projects/project_symbol_locator.rs — the
// absolute-address / module+offset symbol site union.
//
// Deviation: upstream's AbsoluteAddress arm has no module_name; here both
// arms carry the bounded name buffer because get_focus_module_name must
// return "" on the absolute arm and union fields cannot be shared. The
// absolute arm's module_name_len is always 0, so the accessor still
// produces exactly upstream's empty string.
// Residuals: to_locator_key / Display / rename_module need string-format
// ("absolute:{:X}") and span-equality machinery — they ride the
// key-format / rename leg, not the wire surface.
pub data ProjectSymbolLocator {
    case AbsoluteAddress(address: u64, module_name: [u8; 256], module_name_len: u64);
    case ModuleOffset(module_name: [u8; 256], module_name_len: u64, offset: u64);
}

pub machine ProjectSymbolLocator::default() -> ProjectSymbolLocator {
    (ProjectSymbolLocator::AbsoluteAddress {
        address: 0,
        module_name_len: 0,
    })
}

pub machine ProjectSymbolLocator::new_absolute_address(address: u64) -> ProjectSymbolLocator {
    (ProjectSymbolLocator::AbsoluteAddress {
        address: address,
        module_name_len: 0,
    })
}

pub machine ProjectSymbolLocator::new_module_offset(module_name: &[u8], offset: u64) -> ProjectSymbolLocator {
    let mut name: [u8; 256];
    let name_len: u64 = copy_bounded_span(&mut name, module_name);
    (ProjectSymbolLocator::ModuleOffset {
        module_name: name,
        module_name_len: name_len,
        offset: offset,
    })
}

// Upstream `get_focus_address` — the address/offset in both arms.
pub machine ProjectSymbolLocator::get_focus_address(&self) -> u64 {
    transition self {
        ProjectSymbolLocator::AbsoluteAddress { address, module_name, module_name_len } -> (address)
        ProjectSymbolLocator::ModuleOffset { module_name, module_name_len, offset } -> (offset)
    }
}

pub machine ProjectSymbolLocator::is_module_offset(&self) -> bool {
    transition self {
        ProjectSymbolLocator::ModuleOffset { module_name, module_name_len, offset } -> (true)
        _ -> (false)
    }
}

// Upstream `get_focus_module_name` — "" on the absolute arm.
pub machine ProjectSymbolLocator::get_focus_module_name(&self) -> &[u8] {
    transition self {
        ProjectSymbolLocator::ModuleOffset { module_name, module_name_len, offset } -> (&module_name[0..module_name_len])
        ProjectSymbolLocator::AbsoluteAddress { address, module_name, module_name_len } -> (&module_name[0..module_name_len])
    }
}

// Upstream `Clone` — case payloads rebuild through local span copies
// (union case fields are not mutable in place).
pub machine ProjectSymbolLocator::clone(&self) -> ProjectSymbolLocator {
    transition self {
        ProjectSymbolLocator::AbsoluteAddress { address, module_name, module_name_len } -> clone_absolute(address, &module_name[0..256], module_name_len)
        ProjectSymbolLocator::ModuleOffset { module_name, module_name_len, offset } -> clone_module(&module_name[0..256], module_name_len, offset)
    }
    state clone_absolute(&self, address: u64, source_name: &[u8], source_len: u64) -> ProjectSymbolLocator {
        let mut name: [u8; 256];
        let name_len: u64 = copy_bounded_span(&mut name, source_name);
        (ProjectSymbolLocator::AbsoluteAddress {
            address: address,
            module_name: name,
            module_name_len: source_len,
        })
    }
    state clone_module(&self, source_name: &[u8], source_len: u64, offset: u64) -> ProjectSymbolLocator {
        let mut name: [u8; 256];
        let name_len: u64 = copy_bounded_span(&mut name, source_name);
        (ProjectSymbolLocator::ModuleOffset {
            module_name: name,
            module_name_len: source_len,
            offset: offset,
        })
    }
}

pub machine ProjectSymbolLocator::clone_from(&mut self, source: &ProjectSymbolLocator) {
    let cloned: ProjectSymbolLocator = source.clone();
    self = cloned;
}

machine copy_bounded_span(out: &mut [u8; 256], text: &[u8]) -> u64 {
    transition {
        _ -> copy(out, text, 0)
    }
    state copy(out: &mut [u8; 256], text: &[u8], position: u64) -> u64 {
        transition (position < text.len && position < 256) {
            true -> store(out, text, position)
            false -> (position)
        }
    }
    state store(out: &mut [u8; 256], text: &[u8], position: u64) -> u64
        requires 0 <= position && position < text.len
    {
        out[position] = text[position];
        transition {
            _ -> copy(out, text, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}
