module src::structures::projects::project_path_list;

// Port-side bounded `Vec<PathBuf>` carrier shared by the project command
// surface (project_item_paths, duplicated paths, manifest sort order).
// 64 entries of 512 bytes each — path bound documented like the other
// bounded carriers; `add_path` refuses past the bound.
pub data ProjectPathList {
    paths: [[u8; 512]; 64];
    path_lens: [u64; 64];
    path_count: u64;
}

pub machine ProjectPathList::default() -> ProjectPathList {
    (ProjectPathList::empty())
}

pub machine ProjectPathList::empty() -> ProjectPathList {
    ProjectPathList {
        path_count: 0,
    }
}

pub machine ProjectPathList::get_path_count(project_path_list: &ProjectPathList) -> u64 {
    project_path_list.path_count
}

// Upstream `paths[index]` — byte-slice read of one stored path;
// out-of-range reads fall back to the head entry (callers gate on
// get_path_count).
pub machine ProjectPathList::get_path(project_path_list: &ProjectPathList, position: u64) -> &[u8] {
    transition position < project_path_list.path_count && position < 64 {
        true -> at(project_path_list, position)
        false -> head(project_path_list)
        _ -> head(project_path_list)
    }
    state at(project_path_list: &ProjectPathList, position: u64) -> &[u8]
        requires 0 <= position && position < 64;
    {
        let len: u64 = project_path_list.path_lens[position];
        transition len <= 512 {
            true -> (&project_path_list.paths[position][0..len])
            false -> (&project_path_list.paths[position][0..512])
            _ -> (&project_path_list.paths[position][0..512])
        }
    }
    state head(project_path_list: &ProjectPathList) -> &[u8] {
        transition project_path_list.path_lens[0] <= 512 {
            true -> (&project_path_list.paths[0][0..project_path_list.path_lens[0]])
            false -> (&project_path_list.paths[0][0..512])
            _ -> (&project_path_list.paths[0][0..512])
        }
    }
}

// Upstream Vec::clear — drops every stored path.
pub machine ProjectPathList::clear(project_path_list: &mut ProjectPathList) {
    project_path_list.path_count = 0;
}

// Upstream Vec::push — appends one bounded path; refuses past 64.
pub machine ProjectPathList::add_path(project_path_list: &mut ProjectPathList, path: &[u8]) -> bool {
    transition project_path_list.path_count < 64 {
        true -> store(project_path_list, path)
        false -> (false)
        _ -> (false)
    }
    state store(project_path_list: &mut ProjectPathList, path: &[u8]) -> bool {
        let index: u64 = project_path_list.path_count;
        transition index < 64 {
            true -> fill(project_path_list, path, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill(project_path_list: &mut ProjectPathList, path: &[u8], index: u64) -> bool
        requires 0 <= index && index < 64
    {
        project_path_list.path_lens[index] = 0;
        transition {
            _ -> copy(project_path_list, path, index, 0)
        }
    }
    state copy(project_path_list: &mut ProjectPathList, path: &[u8], index: u64, position: u64) -> bool
        requires 0 <= index && index < 64
    {
        transition position < path.len && position < 512 {
            true -> write(project_path_list, path, index, position)
            false -> finish(project_path_list, index, position)
        }
    }
    state write(project_path_list: &mut ProjectPathList, path: &[u8], index: u64, position: u64) -> bool
        requires 0 <= index && index < 64 && position < 512
    {
        project_path_list.paths[index][position] = path[position];
        transition {
            _ -> copy(project_path_list, path, index, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(project_path_list: &mut ProjectPathList, index: u64, count: u64) -> bool
        requires 0 <= index && index < 64
    {
        project_path_list.path_lens[index] = count;
        project_path_list.path_count = index + 1;
        (true)
    }
}

// Upstream `paths.insert(position, path)` — the tail shifts one slot right
// from the end down to `position`, then the path lands there; refuses past
// 64 entries or a position beyond the live count.
pub machine ProjectPathList::insert_path_at(project_path_list: &mut ProjectPathList, position: u64, path: &[u8]) -> bool {
    transition position <= project_path_list.path_count && project_path_list.path_count < 64 && position < 64 {
        true -> shift(project_path_list, project_path_list.path_count, position, path)
        _ -> (false)
    }
    state shift(project_path_list: &mut ProjectPathList, cursor: u64, position: u64, path: &[u8]) -> bool
        requires position < 64 && position <= project_path_list.path_count
    {
        transition cursor > position {
            true -> shift_step(project_path_list, cursor, position, path)
            false -> place(project_path_list, position, path)
        }
    }
    state shift_step(project_path_list: &mut ProjectPathList, cursor: u64, position: u64, path: &[u8]) -> bool
        requires cursor > 0 && cursor <= project_path_list.path_count && cursor < 64 && position < 64
    {
        let moved: [u8; 512] = project_path_list.paths[((cursor as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64];
        let moved_len: u64 = project_path_list.path_lens[((cursor as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64];
        project_path_list.paths[cursor] = moved;
        project_path_list.path_lens[cursor] = moved_len;
        transition {
            _ -> shift(project_path_list, ((cursor as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64, position, path)
        }
    }
    state place(project_path_list: &mut ProjectPathList, position: u64, path: &[u8]) -> bool
        requires position < 64 && position <= project_path_list.path_count
    {
        project_path_list.path_lens[position] = 0;
        transition {
            _ -> copy(project_path_list, position, path, 0)
        }
    }
    state copy(project_path_list: &mut ProjectPathList, position: u64, path: &[u8], at: u64) -> bool
        requires position < 64
    {
        transition at < path.len && at < 512 {
            true -> write(project_path_list, position, path, at)
            _ -> finish(project_path_list, position, at)
        }
    }
    state write(project_path_list: &mut ProjectPathList, position: u64, path: &[u8], at: u64) -> bool
        requires position < 64 && at < 512 && at < path.len
    {
        project_path_list.paths[position][at] = path[at];
        transition {
            _ -> copy(project_path_list, position, path, ((at as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(project_path_list: &mut ProjectPathList, position: u64, count: u64) -> bool
        requires position < 64
    {
        project_path_list.path_lens[position] = count;
        project_path_list.path_count = ((project_path_list.path_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine ProjectPathList::clone(project_path_list: &ProjectPathList) -> ProjectPathList {
    let mut cloned: ProjectPathList = ProjectPathList::empty();
    ProjectPathList::clone_from(&mut cloned, project_path_list);
    (cloned)
}

pub machine ProjectPathList::clone_from(project_path_list: &mut ProjectPathList, source: &ProjectPathList) {
    project_path_list.path_count = 0;
    transition { _ -> copy_path(project_path_list, source, 0) }
    state copy_path(project_path_list: &mut ProjectPathList, source: &ProjectPathList, index: u64) {
        transition index < source.path_count && index < 64 {
            true -> write_path(project_path_list, source, index)
            false -> finish(project_path_list, source, index)
        }
    }
    state write_path(project_path_list: &mut ProjectPathList, source: &ProjectPathList, index: u64)
        requires index < 64;
    {
        project_path_list.path_lens[index] = 0;
        transition { _ -> copy_byte(project_path_list, source, index, 0) }
    }
    state copy_byte(project_path_list: &mut ProjectPathList, source: &ProjectPathList, index: u64, position: u64)
        requires index < 64;
    {
        transition position < source.path_lens[index] && position < 512 {
            true -> write_byte(project_path_list, source, index, position)
            false -> finish_byte(project_path_list, source, index, position)
        }
    }
    state write_byte(project_path_list: &mut ProjectPathList, source: &ProjectPathList, index: u64, position: u64)
        requires index < 64 && position < 512;
    {
        project_path_list.paths[index][position] = source.paths[index][position];
        transition { _ -> copy_byte(project_path_list, source, index, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_byte(project_path_list: &mut ProjectPathList, source: &ProjectPathList, index: u64, count: u64)
        requires index < 64;
    {
        project_path_list.path_lens[index] = count;
        transition { _ -> copy_path(project_path_list, source, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(project_path_list: &mut ProjectPathList, source: &ProjectPathList, index: u64) {
        project_path_list.path_count = index;
    }
}
