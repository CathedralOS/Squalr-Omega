module src::structures::projects::project_path_list;

// Port-side bounded `Vec<PathBuf>` carrier shared by the project command
// surface (project_item_paths, duplicated paths, manifest sort order).
// 64 entries of 512 bytes each — path bound documented like the other
// bounded carriers; `add_path` refuses past the bound.
pub data ProjectPathList {
    paths: [[u8; 512]; 64];
    path_lens: [u64; 64];
    path_count: u64;
}

pub machine ProjectPathList::default() -> ProjectPathList {
    (ProjectPathList::empty())
}

pub machine ProjectPathList::empty() -> ProjectPathList {
    ProjectPathList {
        path_count: 0,
    }
}

pub machine ProjectPathList::get_path_count(this: &ProjectPathList) -> u64 {
    this.path_count
}

// Upstream `paths[index]` — byte-slice read of one stored path;
// out-of-range reads fall back to the head entry (callers gate on
// get_path_count).
pub machine ProjectPathList::get_path(this: &ProjectPathList, position: u64) -> &[u8] {
    transition position < this.path_count && position < 64 {
        true -> at(this, position)
        false -> head(this)
        _ -> head(this)
    }
    state at(this: &ProjectPathList, position: u64) -> &[u8]
        requires 0 <= position && position < 64;
    {
        let len: u64 = this.path_lens[position];
        transition len <= 512 {
            true -> (&this.paths[position][0..len])
            false -> (&this.paths[position][0..512])
            _ -> (&this.paths[position][0..512])
        }
    }
    state head(this: &ProjectPathList) -> &[u8] {
        transition this.path_lens[0] <= 512 {
            true -> (&this.paths[0][0..this.path_lens[0]])
            false -> (&this.paths[0][0..512])
            _ -> (&this.paths[0][0..512])
        }
    }
}

// Upstream Vec::push — appends one bounded path; refuses past 64.
pub machine ProjectPathList::add_path(this: &mut ProjectPathList, path: &[u8]) -> bool {
    transition this.path_count < 64 {
        true -> store(this, path)
        false -> (false)
        _ -> (false)
    }
    state store(this: &mut ProjectPathList, path: &[u8]) -> bool {
        let index: u64 = this.path_count;
        transition index < 64 {
            true -> fill(this, path, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill(this: &mut ProjectPathList, path: &[u8], index: u64) -> bool
        requires 0 <= index && index < 64
    {
        this.path_lens[index] = 0;
        transition {
            _ -> copy(this, path, index, 0)
        }
    }
    state copy(this: &mut ProjectPathList, path: &[u8], index: u64, position: u64) -> bool
        requires 0 <= index && index < 64
    {
        transition position < path.len && position < 512 {
            true -> write(this, path, index, position)
            false -> finish(this, index, position)
        }
    }
    state write(this: &mut ProjectPathList, path: &[u8], index: u64, position: u64) -> bool
        requires 0 <= index && index < 64 && position < 512
    {
        this.paths[index][position] = path[position];
        transition {
            _ -> copy(this, path, index, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut ProjectPathList, index: u64, count: u64) -> bool
        requires 0 <= index && index < 64
    {
        this.path_lens[index] = count;
        this.path_count = index + 1;
        (true)
    }
}

pub machine ProjectPathList::clone(this: &ProjectPathList) -> ProjectPathList {
    let mut cloned: ProjectPathList = ProjectPathList::empty();
    ProjectPathList::clone_from(&mut cloned, this);
    (cloned)
}

pub machine ProjectPathList::clone_from(this: &mut ProjectPathList, source: &ProjectPathList) {
    this.path_count = 0;
    transition { _ -> copy_path(this, source, 0) }
    state copy_path(this: &mut ProjectPathList, source: &ProjectPathList, index: u64) {
        transition index < source.path_count && index < 64 {
            true -> write_path(this, source, index)
            false -> finish(this, source, index)
        }
    }
    state write_path(this: &mut ProjectPathList, source: &ProjectPathList, index: u64)
        requires index < 64;
    {
        this.path_lens[index] = 0;
        transition { _ -> copy_byte(this, source, index, 0) }
    }
    state copy_byte(this: &mut ProjectPathList, source: &ProjectPathList, index: u64, position: u64)
        requires index < 64;
    {
        transition position < source.path_lens[index] && position < 512 {
            true -> write_byte(this, source, index, position)
            false -> finish_byte(this, source, index, position)
        }
    }
    state write_byte(this: &mut ProjectPathList, source: &ProjectPathList, index: u64, position: u64)
        requires index < 64 && position < 512;
    {
        this.paths[index][position] = source.paths[index][position];
        transition { _ -> copy_byte(this, source, index, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_byte(this: &mut ProjectPathList, source: &ProjectPathList, index: u64, count: u64)
        requires index < 64;
    {
        this.path_lens[index] = count;
        transition { _ -> copy_path(this, source, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(this: &mut ProjectPathList, source: &ProjectPathList, index: u64) {
        this.path_count = index;
    }
}
