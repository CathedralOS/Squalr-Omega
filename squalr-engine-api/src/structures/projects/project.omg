module src::structures::projects::project;

use src::structures::processes::process_icon::ProcessIcon;
use src::structures::projects::project_info::ProjectInfo;
use src::structures::projects::project_items::project_item::ProjectItem;
use src::structures::projects::project_items::project_item_pair::ProjectItemPair;
use src::structures::projects::project_items::project_item_ref::ProjectItemRef;
use src::structures::projects::project_manifest::ProjectManifest;

// Port of structures/projects/project.rs — a full project in memory plus the
// file-layout constants its serializer uses. Upstream
// `HashMap<ProjectItemRef, ProjectItem>` carries as a bounded pair table +
// count (named deviation: inserts refuse past 256 where the HashMap grows;
// HashMap iteration order is unspecified upstream, so pair order is the
// caller's insertion order). Option<&ProjectItem> lookups carry as the
// package's Found/Refused convention — Optional<T> is unmatchable in this
// pin. Machines that consume a whole record upstream (info, pair, root ref)
// take by-value parameters — the HashMap keys/values moved into upstream's
// map the same way.
pub data ProjectItemLookup {
    case Refused;
    case Found(index: u64);
}

pub data Project {
    project_info: ProjectInfo;
    project_items: [ProjectItemPair; 256];
    project_items_len: u64;
    project_root_ref: ProjectItemRef;
}

// Upstream `Project::PROJECT_FILE` — "project.json".
pub machine Project::get_project_file_name() -> &[u8] {
    ("project.json")
}

// Upstream `Project::PROJECT_DIR` — "project_items".
pub machine Project::get_project_directory_name() -> &[u8] {
    ("project_items")
}

// Upstream `Project::PROJECT_ITEM_EXTENSION` — ".json".
pub machine Project::get_project_item_extension() -> &[u8] {
    (".json")
}

// Upstream `Project::new` — the item table starts empty upstream of any
// load; `insert_project_item` plays the HashMap's `insert` role.
pub machine Project::new(
    project_info: ProjectInfo,
    project_root_ref: ProjectItemRef
) -> Project {
    (Project {
        project_info: project_info,
        project_items_len: 0,
        project_root_ref: project_root_ref,
    })
}

pub machine Project::default() -> Project {
    (Project {
        project_info: ProjectInfo::default(),
        project_items_len: 0,
        project_root_ref: ProjectItemRef::default(),
    })
}

// Upstream `HashMap::insert` — replaces the pair at a matching ref, else
// appends; refuses past the table bound (named deviation — upstream grows).
pub machine Project::insert_project_item(this: &mut Project, pair: ProjectItemPair) -> bool {
    let pair_ref: &ProjectItemRef = ProjectItemPair::get_project_item_ref(&pair);
    let lookup: ProjectItemLookup = Project::lookup_project_item_index(&this, pair_ref);
    transition lookup {
        ProjectItemLookup::Found { index } -> replace(this, index, pair)
        ProjectItemLookup::Refused -> append(this, pair)
        _ -> (false)
    }
    state replace(this: &mut Project, index: u64, pair: ProjectItemPair) -> bool {
        transition index < this.project_items_len && index < 256 {
            true -> store(this, index, pair)
            false -> (false)
            _ -> (false)
        }
    }
    state store(this: &mut Project, index: u64, pair: ProjectItemPair) -> bool
        requires 0 <= index && index < 256;
    {
        this.project_items[index] = pair;
        (true)
    }
    state append(this: &mut Project, pair: ProjectItemPair) -> bool {
        transition this.project_items_len < 256 {
            true -> grow(this, pair)
            false -> (false)
            _ -> (false)
        }
    }
    state grow(this: &mut Project, pair: ProjectItemPair) -> bool
        requires this.project_items_len < 256;
    {
        this.project_items[this.project_items_len] = pair;
        this.project_items_len = ((this.project_items_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine Project::get_name(this: &Project) -> &[u8] {
    let hoist4: &[u8] = ProjectInfo::get_name(&this.project_info);
    (hoist4)
}

pub machine Project::get_project_manifest(this: &Project) -> &ProjectManifest {
    let hoist5: &ProjectManifest = ProjectInfo::get_project_manifest(&this.project_info);
    (hoist5)
}

pub machine Project::borrow_project_manifest_mut(this: &mut Project) -> &mut ProjectManifest {
    let hoist6: &mut ProjectManifest = ProjectInfo::borrow_project_manifest_mut(&mut this.project_info);
    (hoist6)
}

pub machine Project::get_project_info(this: &Project) -> &ProjectInfo {
    (&this.project_info)
}

pub machine Project::borrow_project_info_mut(this: &mut Project) -> &mut ProjectInfo {
    (&mut this.project_info)
}

pub machine Project::set_project_info(this: &mut Project, project_info: ProjectInfo) {
    this.project_info = project_info;
}

// Upstream `set_project_icon(Option<ProcessIcon>)` — Some carries here,
// None's clear routes through `clear_project_icon` (Optional is unmatchable
// in this pin, so the empty arm keeps its own machine — named deviation).
pub machine Project::set_project_icon(this: &mut Project, project_icon: &ProcessIcon) {
    ProjectInfo::set_project_icon(&mut this.project_info, project_icon);
}

pub machine Project::clear_project_icon(this: &mut Project) {
    ProjectInfo::clear_project_icon_rgba(&mut this.project_info);
}

// Upstream `get_project_items`/`get_project_items_mut` HashMap exposure —
// the bounded table publishes count + indexed views instead (named
// deviation: no by-reference map view exists downstream of the pin).
pub machine Project::get_project_items_len(this: &Project) -> u64 {
    (this.project_items_len)
}

pub machine Project::get_project_item_pair(this: &Project, index: u64) -> &ProjectItemPair {
    transition index < this.project_items_len && index < 256 {
        true -> (&this.project_items[index])
        false -> (&this.project_items[0])
        _ -> (&this.project_items[0])
    }
}

pub machine Project::borrow_project_item_pair_mut(this: &mut Project, index: u64) -> &mut ProjectItemPair {
    transition index < this.project_items_len && index < 256 {
        true -> (&mut this.project_items[index])
        false -> (&mut this.project_items[0])
        _ -> (&mut this.project_items[0])
    }
}

// Upstream `HashMap::get` keyed by ref — linear scan on path equality.
pub machine Project::lookup_project_item_index(
    this: &Project,
    project_item_ref: &ProjectItemRef
) -> ProjectItemLookup {
    transition {
        _ -> scan(this, project_item_ref, 0)
    }
    state scan(this: &Project, project_item_ref: &ProjectItemRef, position: u64) -> ProjectItemLookup {
        transition position < this.project_items_len && position < 256 {
            true -> compare(this, project_item_ref, position)
            false -> (ProjectItemLookup::Refused)
            _ -> (ProjectItemLookup::Refused)
        }
    }
    state compare(this: &Project, project_item_ref: &ProjectItemRef, position: u64) -> ProjectItemLookup
        requires position < 256;
    {
        let stored_ref: &ProjectItemRef = ProjectItemPair::get_project_item_ref(&this.project_items[position]);
        let hoist1: bool = ProjectItemRef::path_equals(&stored_ref, project_item_ref);
        transition hoist1 {
            true -> (ProjectItemLookup::Found { index: position })
            false -> scan(this, project_item_ref, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (ProjectItemLookup::Refused)
        }
    }
}

// Upstream `get_has_unsaved_changes` — info flag OR any item flag.
pub machine Project::get_has_unsaved_changes(this: &Project) -> bool {
    let hoist2: bool = ProjectInfo::get_has_unsaved_changes(&this.project_info);
    transition hoist2 {
        true -> (true)
        false -> scan(this, 0)
        _ -> (false)
    }
    state scan(this: &Project, position: u64) -> bool {
        transition position < this.project_items_len && position < 256 {
            true -> check(this, position)
            false -> (false)
            _ -> (false)
        }
    }
    state check(this: &Project, position: u64) -> bool
        requires position < 256;
    {
        let stored_item: &ProjectItem = ProjectItemPair::get_project_item(&this.project_items[position]);
        let hoist3: bool = ProjectItem::get_has_unsaved_changes(stored_item);
        transition hoist3 {
            true -> (true)
            false -> scan(this, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// Upstream `set_has_unsaved_changes` — applies the flag to the info and
// every item.
pub machine Project::set_has_unsaved_changes(this: &mut Project, has_unsaved_changes: bool) {
    ProjectInfo::set_has_unsaved_changes(&mut this.project_info, has_unsaved_changes);
    transition {
        _ -> apply(this, has_unsaved_changes, 0)
    }
    state apply(this: &mut Project, has_unsaved_changes: bool, position: u64) {
        transition position < this.project_items_len && position < 256 {
            true -> mark(this, has_unsaved_changes, position)
            false -> done(this)
            _ -> done(this)
        }
    }
    state mark(this: &mut Project, has_unsaved_changes: bool, position: u64)
        requires position < 256;
    {
        let item: &mut ProjectItem = ProjectItemPair::borrow_project_item_mut(&mut this.project_items[position]);
        ProjectItem::set_has_unsaved_changes(item, has_unsaved_changes);
        transition {
            _ -> apply(this, has_unsaved_changes, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state done(this: &mut Project) {
    }
}

// Upstream `get_project_root` — Option<&&ProjectItem> via the stored root
// ref; Refused carries the missing-root case.
pub machine Project::get_project_root(this: &Project) -> ProjectItemLookup {
    let hoist7: ProjectItemLookup = Project::lookup_project_item_index(&this, &this.project_root_ref);
    (hoist7)
}

pub machine Project::get_project_root_ref(this: &Project) -> &ProjectItemRef {
    (&this.project_root_ref)
}

// Explicit copy — the synthesized `clone_from` selection does not emit a
// resolved occurrence on this record shape (large nested record arrays),
// so upstream's `Clone` derive is ported as a field-wise copy.
pub machine Project::copy_from(this: &mut Project, source: &Project) {
    ProjectInfo::clone_from(&mut this.project_info, &source.project_info);
    ProjectItemRef::clone_from(&mut this.project_root_ref, &source.project_root_ref);
    this.project_items_len = source.project_items_len;
    transition { _ -> copy_pairs(this, source, 0) }
    state copy_pairs(this: &mut Project, source: &Project, position: u64) {
        transition position < 256 {
            true -> copy_pair(this, source, position)
            _ -> done(this)
        }
    }
    state copy_pair(this: &mut Project, source: &Project, position: u64)
        requires position < 256;
    {
        ProjectItemPair::clone_from(&mut this.project_items[position], &source.project_items[position]);
        let next_position: u64 = position + 1;
        transition { _ -> copy_pairs(this, source, next_position) }
    }
    state done(this: &mut Project) {
    }
}
