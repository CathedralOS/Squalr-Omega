module src::structures::projects::project;

use src::structures::processes::process_icon::ProcessIcon;
use src::structures::projects::project_info::ProjectInfo;
use src::structures::projects::project_items::project_item::ProjectItem;
use src::structures::projects::project_items::project_item_pair::ProjectItemPair;
use src::structures::projects::project_items::project_item_ref::ProjectItemRef;
use src::structures::projects::project_manifest::ProjectManifest;
use src::structures::projects::project_path_list::ProjectPathList;
use src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;

// Port of structures/projects/project.rs — a full project in memory plus the
// file-layout constants its serializer uses. Upstream
// `HashMap<ProjectItemRef, ProjectItem>` carries as a bounded pair table +
// count (named deviation: inserts refuse past 256 where the HashMap grows;
// HashMap iteration order is unspecified upstream, so pair order is the
// caller's insertion order). Option<&ProjectItem> lookups carry as the
// package's Found/Refused convention — Optional<T> is unmatchable in this
// pin. Machines that consume a whole record upstream (info, pair, root ref)
// take by-value parameters — the HashMap keys/values moved into upstream's
// map the same way.
pub data ProjectItemLookup {
    case Refused;
    case Found(index: u64);
}

pub data Project {
    project_info: ProjectInfo;
    project_items: [ProjectItemPair; 256];
    project_items_len: u64;
    project_root_ref: ProjectItemRef;
}

// Upstream `Project::PROJECT_FILE` — "project.json".
pub machine Project::get_project_file_name() -> &[u8] {
    ("project.json")
}

// Upstream `Project::PROJECT_DIR` — "project_items".
pub machine Project::get_project_directory_name() -> &[u8] {
    ("project_items")
}

// Upstream `Project::PROJECT_ITEM_EXTENSION` — ".json".
pub machine Project::get_project_item_extension() -> &[u8] {
    (".json")
}

// Upstream `Project::new` — the item table starts empty upstream of any
// load; `insert_project_item` plays the HashMap's `insert` role.
pub machine Project::new(
    project_info: ProjectInfo,
    project_root_ref: ProjectItemRef
) -> Project {
    (Project {
        project_info: project_info,
        project_items_len: 0,
        project_root_ref: project_root_ref,
    })
}

pub machine Project::default() -> Project {
    (Project {
        project_info: ProjectInfo::default(),
        project_items_len: 0,
        project_root_ref: ProjectItemRef::default(),
    })
}

// Upstream `HashMap::insert` — replaces the pair at a matching ref, else
// appends; refuses past the table bound (named deviation — upstream grows).
pub machine Project::insert_project_item(project: &mut Project, pair: ProjectItemPair) -> bool {
    let pair_ref: &ProjectItemRef = ProjectItemPair::get_project_item_ref(&pair);
    let lookup: ProjectItemLookup = Project::lookup_project_item_index(project, pair_ref);
    transition lookup {
        ProjectItemLookup::Found { index } -> replace(project, index, pair)
        ProjectItemLookup::Refused -> append(project, pair)
        _ -> (false)
    }
    state replace(project: &mut Project, index: u64, pair: ProjectItemPair) -> bool {
        transition index < project.project_items_len && index < 256 {
            true -> store(project, index, pair)
            false -> (false)
            _ -> (false)
        }
    }
    state store(project: &mut Project, index: u64, pair: ProjectItemPair) -> bool
        requires 0 <= index && index < 256;
    {
        project.project_items[index] = pair;
        (true)
    }
    state append(project: &mut Project, pair: ProjectItemPair) -> bool {
        transition project.project_items_len < 256 {
            true -> grow(project, pair)
            false -> (false)
            _ -> (false)
        }
    }
    state grow(project: &mut Project, pair: ProjectItemPair) -> bool
        requires project.project_items_len < 256;
    {
        project.project_items[project.project_items_len] = pair;
        project.project_items_len = ((project.project_items_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine Project::get_name(project: &Project) -> &[u8] {
    (ProjectInfo::get_name(&project.project_info))
}

pub machine Project::get_project_manifest(project: &Project) -> &ProjectManifest {
    (ProjectInfo::get_project_manifest(&project.project_info))
}

pub machine Project::borrow_project_manifest_mut(project: &mut Project) -> &mut ProjectManifest {
    (ProjectInfo::borrow_project_manifest_mut(&mut project.project_info))
}

pub machine Project::get_project_info(project: &Project) -> &ProjectInfo {
    (&project.project_info)
}

pub machine Project::borrow_project_info_mut(project: &mut Project) -> &mut ProjectInfo {
    (&mut project.project_info)
}

pub machine Project::set_project_info(project: &mut Project, project_info: ProjectInfo) {
    project.project_info = project_info;
}

// Upstream `project.project_info().project_symbol_catalog()` — the composed
// two-level read in one call.
pub machine Project::get_project_symbol_catalog(project: &Project) -> &ProjectSymbolCatalog {
    (ProjectInfo::get_project_symbol_catalog(&project.project_info))
}

// Upstream `project.project_info_mut().project_symbol_catalog_mut()`.
pub machine Project::borrow_project_symbol_catalog_mut(project: &mut Project) -> &mut ProjectSymbolCatalog {
    (ProjectInfo::borrow_project_symbol_catalog_mut(&mut project.project_info))
}

// Upstream `project.project_info().project_manifest().project_item_sort_order()`.
pub machine Project::get_project_item_sort_order(project: &Project) -> &ProjectPathList {
    let manifest: &ProjectManifest = ProjectInfo::get_project_manifest(&project.project_info);
    (ProjectManifest::get_project_item_sort_order(manifest))
}

// Upstream `set_project_icon(Option<ProcessIcon>)` — Some carries here,
// None's clear routes through `clear_project_icon` (Optional is unmatchable
// in this pin, so the empty arm keeps its own machine — named deviation).
pub machine Project::set_project_icon(project: &mut Project, project_icon: &ProcessIcon) {
    ProjectInfo::set_project_icon(&mut project.project_info, project_icon);
}

pub machine Project::clear_project_icon(project: &mut Project) {
    ProjectInfo::clear_project_icon_rgba(&mut project.project_info);
}

// Upstream `HashMap::remove` keyed by ref — the pair's item is cloned
// out (moves can't leave the table through &mut), then the tail shifts
// left one slot. ZII-style absence stays as `false`.
pub machine Project::take_project_item(project: &mut Project, project_item_ref: &ProjectItemRef, out_project_item: &mut ProjectItem) -> bool {
    let lookup: ProjectItemLookup = Project::lookup_project_item_index(project, project_item_ref);
    transition lookup {
        ProjectItemLookup::Found { index } -> take(project, index, out_project_item)
        _ -> (false)
    }
    state take(project: &mut Project, index: u64, out_project_item: &mut ProjectItem) -> bool {
        transition index < project.project_items_len && index < 256 {
            true -> copy_out(project, index, out_project_item)
            false -> (false)
            _ -> (false)
        }
    }
    state copy_out(project: &mut Project, index: u64, out_project_item: &mut ProjectItem) -> bool
        requires index < 256;
    {
        let taken: ProjectItem = ProjectItem::clone(ProjectItemPair::get_project_item(&project.project_items[index]));
        ProjectItem::clone_from(out_project_item, &taken);
        transition { _ -> shift(project, index) }
    }
    state shift(project: &mut Project, position: u64) -> bool {
        let next: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next < project.project_items_len && position < 255 {
            true -> shift_one(project, position)
            _ -> shrink(project)
        }
    }
    state shift_one(project: &mut Project, position: u64) -> bool
        requires position < 255;
    {
        let source_index: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition source_index < 256 {
            true -> shift_copy(project, position, source_index)
            _ -> shrink(project)
        }
    }
    state shift_copy(project: &mut Project, position: u64, source_index: u64) -> bool
        requires position < 255 && source_index < 256;
    {
        let carried: ProjectItemPair = ProjectItemPair::clone(&project.project_items[source_index]);
        ProjectItemPair::clone_from(&mut project.project_items[position], &carried);
        transition { _ -> shift(project, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state shrink(project: &mut Project) -> bool {
        transition project.project_items_len > 0 {
            true -> shrink_do(project)
            _ -> (false)
        }
    }
    state shrink_do(project: &mut Project) -> bool {
        project.project_items_len = ((project.project_items_len as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `get_project_items`/`get_project_items_mut` HashMap exposure —
// the bounded table publishes count + indexed views instead (named
// deviation: no by-reference map view exists downstream of the pin).
pub machine Project::get_project_items_len(project: &Project) -> u64 {
    (project.project_items_len)
}

pub machine Project::get_project_item_pair(project: &Project, index: u64) -> &ProjectItemPair {
    transition index < project.project_items_len && index < 256 {
        true -> (&project.project_items[index])
        false -> (&project.project_items[0])
        _ -> (&project.project_items[0])
    }
}

pub machine Project::borrow_project_item_pair_mut(project: &mut Project, index: u64) -> &mut ProjectItemPair {
    transition index < project.project_items_len && index < 256 {
        true -> (&mut project.project_items[index])
        false -> (&mut project.project_items[0])
        _ -> (&mut project.project_items[0])
    }
}

// Upstream `HashMap::get` keyed by ref — linear scan on path equality.
pub machine Project::lookup_project_item_index(
    project: &Project,
    project_item_ref: &ProjectItemRef
) -> ProjectItemLookup {
    transition {
        _ -> scan(project, project_item_ref, 0)
    }
    state scan(project: &Project, project_item_ref: &ProjectItemRef, position: u64) -> ProjectItemLookup {
        transition position < project.project_items_len && position < 256 {
            true -> compare(project, project_item_ref, position)
            false -> (ProjectItemLookup::Refused)
            _ -> (ProjectItemLookup::Refused)
        }
    }
    state compare(project: &Project, project_item_ref: &ProjectItemRef, position: u64) -> ProjectItemLookup
        requires position < 256;
    {
        let stored_ref: &ProjectItemRef = ProjectItemPair::get_project_item_ref(&project.project_items[position]);
        transition ProjectItemRef::path_equals(stored_ref, project_item_ref) {
            true -> (ProjectItemLookup::Found { index: position })
            false -> scan(project, project_item_ref, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (ProjectItemLookup::Refused)
        }
    }
}

// Upstream `get_has_unsaved_changes` — info flag OR any item flag.
pub machine Project::get_has_unsaved_changes(project: &Project) -> bool {
    transition ProjectInfo::get_has_unsaved_changes(&project.project_info) {
        true -> (true)
        false -> scan(project, 0)
        _ -> (false)
    }
    state scan(project: &Project, position: u64) -> bool {
        transition position < project.project_items_len && position < 256 {
            true -> check(project, position)
            false -> (false)
            _ -> (false)
        }
    }
    state check(project: &Project, position: u64) -> bool
        requires position < 256;
    {
        let stored_item: &ProjectItem = ProjectItemPair::get_project_item(&project.project_items[position]);
        transition ProjectItem::get_has_unsaved_changes(stored_item) {
            true -> (true)
            false -> scan(project, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            _ -> (false)
        }
    }
}

// Upstream `set_has_unsaved_changes` — applies the flag to the info and
// every item.
pub machine Project::set_has_unsaved_changes(project: &mut Project, has_unsaved_changes: bool) {
    ProjectInfo::set_has_unsaved_changes(&mut project.project_info, has_unsaved_changes);
    transition {
        _ -> apply(project, has_unsaved_changes, 0)
    }
    state apply(project: &mut Project, has_unsaved_changes: bool, position: u64) {
        transition position < project.project_items_len && position < 256 {
            true -> mark(project, has_unsaved_changes, position)
            false -> done(project)
            _ -> done(project)
        }
    }
    state mark(project: &mut Project, has_unsaved_changes: bool, position: u64)
        requires position < 256;
    {
        ProjectItem::set_has_unsaved_changes(ProjectItemPair::borrow_project_item_mut(&mut project.project_items[position]), has_unsaved_changes);
        transition {
            _ -> apply(project, has_unsaved_changes, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state done(project: &mut Project) {
    }
}

// Upstream `get_project_root` — Option<&&ProjectItem> via the stored root
// ref; Refused carries the missing-root case.
pub machine Project::get_project_root(project: &Project) -> ProjectItemLookup {
    (Project::lookup_project_item_index(project, &project.project_root_ref))
}

pub machine Project::get_project_root_ref(project: &Project) -> &ProjectItemRef {
    (&project.project_root_ref)
}

// Explicit copy — the synthesized `clone_from` selection does not emit a
// resolved occurrence on this record shape (large nested record arrays),
// so upstream's `Clone` derive is ported as a field-wise copy.
pub machine Project::copy_from(project: &mut Project, source: &Project) {
    ProjectInfo::clone_from(&mut project.project_info, &source.project_info);
    ProjectItemRef::clone_from(&mut project.project_root_ref, &source.project_root_ref);
    project.project_items_len = source.project_items_len;
    transition { _ -> copy_pairs(project, source, 0) }
    state copy_pairs(project: &mut Project, source: &Project, position: u64) {
        transition position < 256 {
            true -> copy_pair(project, source, position)
            _ -> done(project)
        }
    }
    state copy_pair(project: &mut Project, source: &Project, position: u64)
        requires position < 256;
    {
        ProjectItemPair::clone_from(&mut project.project_items[position], &source.project_items[position]);
        let next_position: u64 = position + 1;
        transition { _ -> copy_pairs(project, source, next_position) }
    }
    state done(project: &mut Project) {
    }
}
