module src::structures::projects::project_symbol_module;

use src::structures::projects::project_symbol_module_field::ProjectSymbolModuleField;

// Port of structures/projects/project_symbol_module.rs — a module name
// plus its displayed fields. Upstream's Vec<ProjectSymbolModuleField>
// carries the honest bound of 64 with refusal on overflow.
pub data ProjectSymbolModule {
    module_name: [u8; 256];
    module_name_len: u64;
    size: u64;
    fields: [ProjectSymbolModuleField; 64];
    field_count: u64;
}

pub machine ProjectSymbolModule::default() -> ProjectSymbolModule {
    (ProjectSymbolModule {
        module_name_len: 0,
        size: 0,
        field_count: 0,
    })
}

pub machine ProjectSymbolModule::new(module_name: &[u8], size: u64) -> ProjectSymbolModule {
    let mut symbol_module: ProjectSymbolModule = (ProjectSymbolModule {
        module_name_len: 0,
        size: size,
        field_count: 0,
    });
    symbol_module.set_module_name(module_name);
    (symbol_module)
}

pub machine ProjectSymbolModule::get_module_name(&self) -> &[u8] {
    transition self.module_name_len <= 256 {
        true -> (&self.module_name[0..self.module_name_len])
        false -> (&self.module_name[0..256])
        _ -> (&self.module_name[0..256])
    }
}

pub machine ProjectSymbolModule::set_module_name(&mut self, module_name: &[u8]) {
    self.module_name_len = 0;
    transition {
        _ -> copy(module_name, 0)
    }
    state copy(&mut self, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(module_name, position)
            false -> finish(position)
        }
    }
    state store(&mut self, module_name: &[u8], position: u64) {
        self.module_name[position] = module_name[position];
        transition {
            _ -> copy(module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.module_name_len = count;
    }
}

pub machine ProjectSymbolModule::get_size(&self) -> u64 {
    (self.size)
}

pub machine ProjectSymbolModule::set_size(&mut self, size: u64) {
    self.size = size;
}

pub machine ProjectSymbolModule::get_field_count(&self) -> u64 {
    (self.field_count)
}

pub machine ProjectSymbolModule::get_field(&self, position: u64) -> &ProjectSymbolModuleField
    requires position < self.field_count && position < 64
{
    (&self.fields[position])
}

// Upstream `get_fields_mut` — caller mutates a slot in place.
pub machine ProjectSymbolModule::get_field_mut(&mut self, position: u64) -> &mut ProjectSymbolModuleField
    requires position < self.field_count && position < 64
{
    (&mut self.fields[position])
}

// Upstream `fields.push` — refusal past the honest bound.
pub machine ProjectSymbolModule::add_field(&mut self, field: &ProjectSymbolModuleField) -> bool {
    transition self.field_count < 64 {
        true -> store(field)
        false -> (false)
    }
    state store(&mut self, field: &ProjectSymbolModuleField) -> bool {
        self.fields[self.field_count].clone_from(field);
        self.field_count = ((self.field_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `find_field` — the Option<&field> respell returns the slot
// position; `position >= field_count` is upstream's None.
pub machine ProjectSymbolModule::find_field_position(&self, offset: u64) -> u64 {
    transition {
        _ -> scan(offset, 0)
    }
    state scan(&self, offset: u64, position: u64) -> u64 {
        transition position < self.field_count && position < 64 {
            true -> compare(offset, position)
            false -> (position)
        }
    }
    state compare(&self, offset: u64, position: u64) -> u64
        requires position < self.field_count && position < 64
    {
        let field_offset: u64 = self.fields[position].get_offset();
        transition field_offset == offset {
            true -> (position)
            false -> (scan(offset, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64))
        }
    }
}

// Upstream `Clone` — name + fields deep-copy element-wise.
pub machine ProjectSymbolModule::clone_from(&mut self, source: &ProjectSymbolModule) {
    self.size = source.size;
    self.field_count = 0;
    transition {
        _ -> copy_name(source, 0)
    }
    state copy_name(&mut self, source: &ProjectSymbolModule, position: u64) {
        transition position < source.module_name_len && position < 256 {
            true -> store_name(source, position)
            false -> finish_name(source)
        }
    }
    state store_name(&mut self, source: &ProjectSymbolModule, position: u64) {
        self.module_name[position] = source.module_name[position];
        transition {
            _ -> copy_name(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_name(&mut self, source: &ProjectSymbolModule) {
        self.module_name_len = source.module_name_len;
        transition {
            _ -> copy_fields(source, 0)
        }
    }
    state copy_fields(&mut self, source: &ProjectSymbolModule, position: u64) {
        transition position < source.field_count && position < 64 {
            true -> store_field(source, position)
            false -> finish_fields(source)
        }
    }
    state store_field(&mut self, source: &ProjectSymbolModule, position: u64)
        requires position < source.field_count && position < 64
    {
        self.fields[position].clone_from(&source.fields[position]);
        transition {
            _ -> copy_fields(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_fields(&mut self, source: &ProjectSymbolModule) {
        self.field_count = source.field_count;
    }
}

pub machine ProjectSymbolModule::clone(source: &ProjectSymbolModule) -> ProjectSymbolModule {
    let mut cloned: ProjectSymbolModule = ProjectSymbolModule::default();
    cloned.clone_from(source);
    (cloned)
}
