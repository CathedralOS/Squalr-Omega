module src::structures::projects::project_symbol_module;

use src::structures::projects::project_symbol_module_field::ProjectSymbolModuleField;

// Port of structures/projects/project_symbol_module.rs — a module name
// plus its displayed fields. Upstream's Vec<ProjectSymbolModuleField>
// carries the honest bound of 64 with refusal on overflow.
pub data ProjectSymbolModule {
    module_name: [u8; 256];
    module_name_len: u64;
    size: u64;
    fields: [ProjectSymbolModuleField; 64];
    field_count: u64;
}

pub machine ProjectSymbolModule::default() -> ProjectSymbolModule {
    (ProjectSymbolModule {
        module_name_len: 0,
        size: 0,
        field_count: 0,
    })
}

pub machine ProjectSymbolModule::new(module_name: &[u8], size: u64) -> ProjectSymbolModule {
    let mut symbol_module: ProjectSymbolModule = (ProjectSymbolModule {
        module_name_len: 0,
        size: size,
        field_count: 0,
    });
    ProjectSymbolModule::set_module_name(&mut symbol_module, module_name);
    (symbol_module)
}

pub machine ProjectSymbolModule::get_module_name(project_symbol_module: &ProjectSymbolModule) -> &[u8] {
    transition project_symbol_module.module_name_len <= 256 {
        true -> (&project_symbol_module.module_name[0..project_symbol_module.module_name_len])
        false -> (&project_symbol_module.module_name[0..256])
        _ -> (&project_symbol_module.module_name[0..256])
    }
}

pub machine ProjectSymbolModule::set_module_name(project_symbol_module: &mut ProjectSymbolModule, module_name: &[u8]) {
    project_symbol_module.module_name_len = 0;
    transition {
        _ -> copy(project_symbol_module, module_name, 0)
    }
    state copy(project_symbol_module: &mut ProjectSymbolModule, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(project_symbol_module, module_name, position)
            false -> finish(project_symbol_module, position)
        }
    }
    state store(project_symbol_module: &mut ProjectSymbolModule, module_name: &[u8], position: u64) {
        project_symbol_module.module_name[position] = module_name[position];
        transition {
            _ -> copy(project_symbol_module, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(project_symbol_module: &mut ProjectSymbolModule, count: u64) {
        project_symbol_module.module_name_len = count;
    }
}

pub machine ProjectSymbolModule::get_size(project_symbol_module: &ProjectSymbolModule) -> u64 {
    (project_symbol_module.size)
}

pub machine ProjectSymbolModule::set_size(project_symbol_module: &mut ProjectSymbolModule, size: u64) {
    project_symbol_module.size = size;
}

pub machine ProjectSymbolModule::get_field_count(project_symbol_module: &ProjectSymbolModule) -> u64 {
    (project_symbol_module.field_count)
}

pub machine ProjectSymbolModule::get_field(project_symbol_module: &ProjectSymbolModule, position: u64) -> &ProjectSymbolModuleField
    requires position < project_symbol_module.field_count && position < 64
{
    (&project_symbol_module.fields[position])
}

// Upstream `get_fields_mut` — caller mutates a slot in place.
pub machine ProjectSymbolModule::get_field_mut(project_symbol_module: &mut ProjectSymbolModule, position: u64) -> &mut ProjectSymbolModuleField
    requires position < project_symbol_module.field_count && position < 64
{
    (&mut project_symbol_module.fields[position])
}

// Upstream `fields.push` — refusal past the honest bound.
pub machine ProjectSymbolModule::add_field(project_symbol_module: &mut ProjectSymbolModule, field: &ProjectSymbolModuleField) -> bool {
    transition project_symbol_module.field_count < 64 {
        true -> store(project_symbol_module, field)
        false -> (false)
    }
    state store(project_symbol_module: &mut ProjectSymbolModule, field: &ProjectSymbolModuleField) -> bool {
        ProjectSymbolModuleField::clone_from(&mut project_symbol_module.fields[project_symbol_module.field_count], field);
        project_symbol_module.field_count = ((project_symbol_module.field_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `fields.insert(position, field)` — shift the tail right one
// slot, then place. position == field_count appends.
pub machine ProjectSymbolModule::insert_field_at(project_symbol_module: &mut ProjectSymbolModule, position: u64, field: &ProjectSymbolModuleField) -> bool {
    transition position < 64 && position <= project_symbol_module.field_count && project_symbol_module.field_count < 64 {
        true -> shift(project_symbol_module, project_symbol_module.field_count, position, field)
        false -> (false)
    }
    state shift(project_symbol_module: &mut ProjectSymbolModule, cursor: u64, position: u64, field: &ProjectSymbolModuleField) -> bool
        requires cursor < 64 && position < 64 && position <= project_symbol_module.field_count;
    {
        transition cursor > position && cursor > 0 {
            true -> shift_step(project_symbol_module, cursor, position, field)
            false -> place(project_symbol_module, position, field)
        }
    }
    state shift_step(project_symbol_module: &mut ProjectSymbolModule, cursor: u64, position: u64, field: &ProjectSymbolModuleField) -> bool
        requires cursor > 0 && cursor < 64 && position < 64 && position <= project_symbol_module.field_count;
    {
        let previous_index: u64 = ((cursor as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        transition previous_index < 64 {
            true -> copy_previous(project_symbol_module, previous_index, cursor, position, field)
            false -> (false)
        }
    }
    state copy_previous(project_symbol_module: &mut ProjectSymbolModule, previous_index: u64, cursor: u64, position: u64, field: &ProjectSymbolModuleField) -> bool
        requires previous_index < 64 && cursor < 64 && position < 64 && position <= project_symbol_module.field_count;
    {
        let previous: ProjectSymbolModuleField = ProjectSymbolModuleField::clone(&project_symbol_module.fields[previous_index]);
        ProjectSymbolModuleField::clone_from(&mut project_symbol_module.fields[cursor], &previous);
        transition {
            _ -> shift(project_symbol_module, previous_index, position, field)
        }
    }
    state place(project_symbol_module: &mut ProjectSymbolModule, position: u64, field: &ProjectSymbolModuleField) -> bool
        requires position < 64 && position <= project_symbol_module.field_count;
    {
        ProjectSymbolModuleField::clone_from(&mut project_symbol_module.fields[position], field);
        project_symbol_module.field_count = ((project_symbol_module.field_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `fields.remove(position)` — shift the tail left one slot.
pub machine ProjectSymbolModule::remove_field_at(project_symbol_module: &mut ProjectSymbolModule, position: u64) -> bool {
    transition position < project_symbol_module.field_count && position < 64 {
        true -> shift(project_symbol_module, position)
        false -> (false)
    }
    state shift(project_symbol_module: &mut ProjectSymbolModule, position: u64) -> bool
        requires position < project_symbol_module.field_count && position < 64
    {
        let next: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition next < project_symbol_module.field_count && next < 64 {
            true -> move_one(project_symbol_module, position, next)
            false -> shrink(project_symbol_module)
        }
    }
    state move_one(project_symbol_module: &mut ProjectSymbolModule, position: u64, next: u64) -> bool
        requires position < project_symbol_module.field_count && position < 64
             && next < project_symbol_module.field_count && next < 64
    {
        let moved: ProjectSymbolModuleField = ProjectSymbolModuleField::clone(&project_symbol_module.fields[next]);
        ProjectSymbolModuleField::clone_from(&mut project_symbol_module.fields[position], &moved);
        transition { _ -> shift(project_symbol_module, next) }
    }
    state shrink(project_symbol_module: &mut ProjectSymbolModule) -> bool {
        project_symbol_module.field_count = ((project_symbol_module.field_count as u64 in Saturating) - (1 as u64 in Saturating)) as u64;
        (true)
    }
}

// Upstream `find_field` — the Option<&field> respell returns the slot
// position; `position >= field_count` is upstream's None.
pub machine ProjectSymbolModule::find_field_position(project_symbol_module: &ProjectSymbolModule, offset: u64) -> u64 {
    transition {
        _ -> scan(project_symbol_module, offset, 0)
    }
    state scan(project_symbol_module: &ProjectSymbolModule, offset: u64, position: u64) -> u64 {
        transition position < project_symbol_module.field_count && position < 64 {
            true -> compare(project_symbol_module, offset, position)
            false -> (position)
        }
    }
    state compare(project_symbol_module: &ProjectSymbolModule, offset: u64, position: u64) -> u64
        requires position < project_symbol_module.field_count && position < 64
    {
        let field_offset: u64 = ProjectSymbolModuleField::get_offset(&project_symbol_module.fields[position]);
        transition field_offset == offset {
            true -> (position)
            false -> (scan(project_symbol_module, offset, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64))
        }
    }
}

// Upstream `Clone` — name + fields deep-copy element-wise.
pub machine ProjectSymbolModule::clone_from(project_symbol_module: &mut ProjectSymbolModule, source: &ProjectSymbolModule) {
    project_symbol_module.size = source.size;
    project_symbol_module.field_count = 0;
    transition {
        _ -> copy_name(project_symbol_module, source, 0)
    }
    state copy_name(project_symbol_module: &mut ProjectSymbolModule, source: &ProjectSymbolModule, position: u64) {
        transition position < source.module_name_len && position < 256 {
            true -> store_name(project_symbol_module, source, position)
            false -> finish_name(project_symbol_module, source)
        }
    }
    state store_name(project_symbol_module: &mut ProjectSymbolModule, source: &ProjectSymbolModule, position: u64) {
        project_symbol_module.module_name[position] = source.module_name[position];
        transition {
            _ -> copy_name(project_symbol_module, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_name(project_symbol_module: &mut ProjectSymbolModule, source: &ProjectSymbolModule) {
        project_symbol_module.module_name_len = source.module_name_len;
        transition {
            _ -> copy_fields(project_symbol_module, source, 0)
        }
    }
    state copy_fields(project_symbol_module: &mut ProjectSymbolModule, source: &ProjectSymbolModule, position: u64) {
        transition position < source.field_count && position < 64 {
            true -> store_field(project_symbol_module, source, position)
            false -> finish_fields(project_symbol_module, source)
        }
    }
    state store_field(project_symbol_module: &mut ProjectSymbolModule, source: &ProjectSymbolModule, position: u64)
        requires position < source.field_count && position < 64
    {
        ProjectSymbolModuleField::clone_from(&mut project_symbol_module.fields[position], &source.fields[position]);
        transition {
            _ -> copy_fields(project_symbol_module, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_fields(project_symbol_module: &mut ProjectSymbolModule, source: &ProjectSymbolModule) {
        project_symbol_module.field_count = source.field_count;
    }
}

pub machine ProjectSymbolModule::clone(source: &ProjectSymbolModule) -> ProjectSymbolModule {
    let mut cloned: ProjectSymbolModule = ProjectSymbolModule::default();
    ProjectSymbolModule::clone_from(&mut cloned, source);
    (cloned)
}
