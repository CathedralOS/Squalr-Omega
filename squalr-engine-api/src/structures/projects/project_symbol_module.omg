module src::structures::projects::project_symbol_module;

use src::structures::projects::project_symbol_module_field::ProjectSymbolModuleField;

// Port of structures/projects/project_symbol_module.rs — a module name
// plus its displayed fields. Upstream's Vec<ProjectSymbolModuleField>
// carries the honest bound of 64 with refusal on overflow.
pub data ProjectSymbolModule {
    module_name: [u8; 256];
    module_name_len: u64;
    size: u64;
    fields: [ProjectSymbolModuleField; 64];
    field_count: u64;
}

pub machine ProjectSymbolModule::default() -> ProjectSymbolModule {
    (ProjectSymbolModule {
        module_name_len: 0,
        size: 0,
        field_count: 0,
    })
}

pub machine ProjectSymbolModule::new(module_name: &[u8], size: u64) -> ProjectSymbolModule {
    let mut symbol_module: ProjectSymbolModule = (ProjectSymbolModule {
        module_name_len: 0,
        size: size,
        field_count: 0,
    });
    ProjectSymbolModule::set_module_name(&mut symbol_module, module_name);
    (symbol_module)
}

pub machine ProjectSymbolModule::get_module_name(this: &ProjectSymbolModule) -> &[u8] {
    transition this.module_name_len <= 256 {
        true -> (&this.module_name[0..this.module_name_len])
        false -> (&this.module_name[0..256])
        _ -> (&this.module_name[0..256])
    }
}

pub machine ProjectSymbolModule::set_module_name(this: &mut ProjectSymbolModule, module_name: &[u8]) {
    this.module_name_len = 0;
    transition {
        _ -> copy(this, module_name, 0)
    }
    state copy(this: &mut ProjectSymbolModule, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(this, module_name, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ProjectSymbolModule, module_name: &[u8], position: u64) {
        this.module_name[position] = module_name[position];
        transition {
            _ -> copy(this, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut ProjectSymbolModule, count: u64) {
        this.module_name_len = count;
    }
}

pub machine ProjectSymbolModule::get_size(this: &ProjectSymbolModule) -> u64 {
    (this.size)
}

pub machine ProjectSymbolModule::set_size(this: &mut ProjectSymbolModule, size: u64) {
    this.size = size;
}

pub machine ProjectSymbolModule::get_field_count(this: &ProjectSymbolModule) -> u64 {
    (this.field_count)
}

pub machine ProjectSymbolModule::get_field(this: &ProjectSymbolModule, position: u64) -> &ProjectSymbolModuleField
    requires position < this.field_count && position < 64
{
    (&this.fields[position])
}

// Upstream `get_fields_mut` — caller mutates a slot in place.
pub machine ProjectSymbolModule::get_field_mut(this: &mut ProjectSymbolModule, position: u64) -> &mut ProjectSymbolModuleField
    requires position < this.field_count && position < 64
{
    (&mut this.fields[position])
}

// Upstream `fields.push` — refusal past the honest bound.
pub machine ProjectSymbolModule::add_field(this: &mut ProjectSymbolModule, field: &ProjectSymbolModuleField) -> bool {
    transition this.field_count < 64 {
        true -> store(this, field)
        false -> (false)
    }
    state store(this: &mut ProjectSymbolModule, field: &ProjectSymbolModuleField) -> bool {
        ProjectSymbolModuleField::clone_from(&mut this.fields[this.field_count], field);
        this.field_count = ((this.field_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `find_field` — the Option<&field> respell returns the slot
// position; `position >= field_count` is upstream's None.
pub machine ProjectSymbolModule::find_field_position(this: &ProjectSymbolModule, offset: u64) -> u64 {
    transition {
        _ -> scan(this, offset, 0)
    }
    state scan(this: &ProjectSymbolModule, offset: u64, position: u64) -> u64 {
        transition position < this.field_count && position < 64 {
            true -> compare(this, offset, position)
            false -> (position)
        }
    }
    state compare(this: &ProjectSymbolModule, offset: u64, position: u64) -> u64
        requires position < this.field_count && position < 64
    {
        let field_offset: u64 = ProjectSymbolModuleField::get_offset(&this.fields[position]);
        transition field_offset == offset {
            true -> (position)
            false -> (scan(this, offset, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64))
        }
    }
}

// Upstream `Clone` — name + fields deep-copy element-wise.
pub machine ProjectSymbolModule::clone_from(this: &mut ProjectSymbolModule, source: &ProjectSymbolModule) {
    this.size = source.size;
    this.field_count = 0;
    transition {
        _ -> copy_name(this, source, 0)
    }
    state copy_name(this: &mut ProjectSymbolModule, source: &ProjectSymbolModule, position: u64) {
        transition position < source.module_name_len && position < 256 {
            true -> store_name(this, source, position)
            false -> finish_name(this, source)
        }
    }
    state store_name(this: &mut ProjectSymbolModule, source: &ProjectSymbolModule, position: u64) {
        this.module_name[position] = source.module_name[position];
        transition {
            _ -> copy_name(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_name(this: &mut ProjectSymbolModule, source: &ProjectSymbolModule) {
        this.module_name_len = source.module_name_len;
        transition {
            _ -> copy_fields(this, source, 0)
        }
    }
    state copy_fields(this: &mut ProjectSymbolModule, source: &ProjectSymbolModule, position: u64) {
        transition position < source.field_count && position < 64 {
            true -> store_field(this, source, position)
            false -> finish_fields(this, source)
        }
    }
    state store_field(this: &mut ProjectSymbolModule, source: &ProjectSymbolModule, position: u64)
        requires position < source.field_count && position < 64
    {
        ProjectSymbolModuleField::clone_from(&mut this.fields[position], &source.fields[position]);
        transition {
            _ -> copy_fields(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_fields(this: &mut ProjectSymbolModule, source: &ProjectSymbolModule) {
        this.field_count = source.field_count;
    }
}

pub machine ProjectSymbolModule::clone(source: &ProjectSymbolModule) -> ProjectSymbolModule {
    let mut cloned: ProjectSymbolModule = ProjectSymbolModule::default();
    ProjectSymbolModule::clone_from(&mut cloned, source);
    (cloned)
}
