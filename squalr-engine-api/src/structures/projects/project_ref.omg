module src::structures::projects::project_ref;

use src::structures::bounded_slice::bounded_slice;

use src::structures::projects::project_items::project_item::ProjectItem;
use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of structures/projects/project_ref.rs — the tree-shaped project
// node viewers consume (`name` + child items). Upstream children are
// `Vec<ProjectItem>` — a flat list, not recursive refs — carried port-side
// as a bounded 64-slot table matching the other project-item bounds.
pub data ProjectRef {
    name: [u8; 256];
    name_len: u64;
    children: [ProjectItem; 64];
    children_count: u64;
}

pub machine ProjectRef::default() -> ProjectRef {
    (ProjectRef {
        name_len: 0,
        children_count: 0,
    })
}

pub machine ProjectRef::new(name: &[u8]) -> ProjectRef {
    let mut created: ProjectRef = ProjectRef::default();
    created.set_name(name);
    (created)
}

pub machine ProjectRef::get_name(&self) -> &[u8] {
    bounded_slice(&self.name[0..256], self.name_len)
}

pub machine ProjectRef::set_name(&mut self, name: &[u8]) {
    self.name_len = BoundedByteCopy::copy(&mut self.name[0..256], name);
}

pub machine ProjectRef::get_children_count(&self) -> u64 {
    self.children_count
}

pub machine ProjectRef::get_child(&self, position: u64) -> &ProjectItem {
    transition position < self.children_count && position < 64 {
        true -> at(position)
        false -> head()
        _ -> head()
    }
    state at(&self, position: u64) -> &ProjectItem
        requires position < 64;
    {
        (&self.children[position])
    }
    state head(&self) -> &ProjectItem {
        (&self.children[0])
    }
}

pub machine ProjectRef::add_child(&mut self, project_item: &ProjectItem) -> bool {
    transition self.children_count < 64 {
        true -> store(project_item)
        false -> (false)
        _ -> (false)
    }
    state store(&mut self, project_item: &ProjectItem) -> bool {
        let index: u64 = self.children_count;
        transition index < 64 {
            true -> write(project_item, index)
            false -> (false)
            _ -> (false)
        }
    }
    state write(&mut self, project_item: &ProjectItem, index: u64) -> bool
        requires index < 64;
    {
        self.children[index].clone_from(project_item);
        self.children_count = index + 1;
        (true)
    }
}
