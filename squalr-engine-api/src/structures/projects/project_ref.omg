module src::structures::projects::project_ref;

use src::structures::projects::project_items::project_item::ProjectItem;

// Port of structures/projects/project_ref.rs — the tree-shaped project
// node viewers consume (`name` + child items). Upstream children are
// `Vec<ProjectItem>` — a flat list, not recursive refs — carried port-side
// as a bounded 64-slot table matching the other project-item bounds.
pub data ProjectRef {
    name: [u8; 256];
    name_len: u64;
    children: [ProjectItem; 64];
    children_count: u64;
}

pub machine ProjectRef::default() -> ProjectRef {
    (ProjectRef {
        name_len: 0,
        children_count: 0,
    })
}

pub machine ProjectRef::new(name: &[u8]) -> ProjectRef {
    let mut created: ProjectRef = ProjectRef::default();
    ProjectRef::set_name(&mut created, name);
    (created)
}

pub machine ProjectRef::get_name(this: &ProjectRef) -> &[u8] {
    transition this.name_len <= 256 {
        true -> (&this.name[0..this.name_len])
        false -> (&this.name[0..256])
        _ -> (&this.name[0..256])
    }
}

pub machine ProjectRef::set_name(this: &mut ProjectRef, name: &[u8]) {
    this.name_len = 0;
    transition { _ -> copy(this, name, 0) }
    state copy(this: &mut ProjectRef, name: &[u8], position: u64) {
        transition position < name.len && position < 256 {
            true -> store(this, name, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ProjectRef, name: &[u8], position: u64)
        requires position < 256;
    {
        this.name[position] = name[position];
        transition { _ -> copy(this, name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(this: &mut ProjectRef, count: u64) {
        this.name_len = count;
    }
}

pub machine ProjectRef::get_children_count(this: &ProjectRef) -> u64 {
    this.children_count
}

pub machine ProjectRef::get_child(this: &ProjectRef, position: u64) -> &ProjectItem {
    transition position < this.children_count && position < 64 {
        true -> at(this, position)
        false -> head(this)
        _ -> head(this)
    }
    state at(this: &ProjectRef, position: u64) -> &ProjectItem
        requires position < 64;
    {
        (&this.children[position])
    }
    state head(this: &ProjectRef) -> &ProjectItem {
        (&this.children[0])
    }
}

pub machine ProjectRef::add_child(this: &mut ProjectRef, project_item: &ProjectItem) -> bool {
    transition this.children_count < 64 {
        true -> store(this, project_item)
        false -> (false)
        _ -> (false)
    }
    state store(this: &mut ProjectRef, project_item: &ProjectItem) -> bool {
        let index: u64 = this.children_count;
        transition index < 64 {
            true -> write(this, project_item, index)
            false -> (false)
            _ -> (false)
        }
    }
    state write(this: &mut ProjectRef, project_item: &ProjectItem, index: u64) -> bool
        requires index < 64;
    {
        ProjectItem::clone_from(&mut this.children[index], project_item);
        this.children_count = index + 1;
        (true)
    }
}
