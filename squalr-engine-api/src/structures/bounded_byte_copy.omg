module src::structures::bounded_byte_copy;

// Bounded source-to-field byte copy shared by the command request/response
// and debugger descriptor setters: writes min(source.len, out.len) bytes and
// returns the written count. Each caller assigns its own `_len` field and
// any `has_` flag from the returned count.
pub data BoundedByteCopy {}

pub machine BoundedByteCopy::copy(out: &mut [u8], source: &[u8]) -> u64 {
    transition 0 == 0 {
        _ -> walk(out, source, 0)
    }
    state walk(out: &mut [u8], source: &[u8], position: u64) -> u64 {
        transition position < source.len && position < out.len {
            true -> store(out, source, position)
            _ -> done(position)
        }
    }
    state store(out: &mut [u8], source: &[u8], position: u64) -> u64
        requires position < source.len && position < out.len {
        out[position] = source[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> walk(out, source, next)
        }
    }
    state done(position: u64) -> u64 {
        (position)
    }
}
