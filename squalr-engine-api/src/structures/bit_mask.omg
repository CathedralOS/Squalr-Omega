module src::structures::bit_mask;

// Bit-mask walks over a fixed rank space: count the set bits below `ranks`,
// or find the rank of the position-th set bit. Every mask + from_rank pair on
// a `pub data` flag set restates these two walks.

// Upstream `iter().filter().count()`.
pub machine count_set_bits(mask: u64, ranks: u64) -> u64 {
    transition { _ -> count(mask, ranks, 0, 0) }
    state count(mask: u64, ranks: u64, rank: u64, seen: u64) -> u64 {
        transition rank < ranks {
            true -> check(mask, ranks, rank, seen)
            false -> (seen)
        }
    }
    state check(mask: u64, ranks: u64, rank: u64, seen: u64) -> u64 {
        transition (((mask as u64 in Wrapping) >> rank) as u64 & 1) == 1 {
            true -> count_next(mask, ranks, rank, ((seen as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
            false -> count_next(mask, ranks, rank, seen)
        }
    }
    state count_next(mask: u64, ranks: u64, rank: u64, seen: u64) -> u64 {
        transition { _ -> count(mask, ranks, ((rank as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, seen) }
    }
}

// Upstream `iter().filter().nth(position)` — rank 0 when the mask holds fewer
// than `position + 1` set bits, matching each caller's rank-0 default member.
pub machine nth_set_bit_rank(mask: u64, ranks: u64, position: u64) -> u64 {
    transition { _ -> scan(mask, ranks, position, 0, 0) }
    state scan(mask: u64, ranks: u64, position: u64, rank: u64, seen: u64) -> u64 {
        transition rank < ranks {
            true -> check(mask, ranks, position, rank, seen)
            false -> (0)
        }
    }
    state check(mask: u64, ranks: u64, position: u64, rank: u64, seen: u64) -> u64 {
        transition (((mask as u64 in Wrapping) >> rank) as u64 & 1) == 1 {
            true -> member_or_next(mask, ranks, position, rank, seen)
            false -> next(mask, ranks, position, rank, seen)
        }
    }
    state member_or_next(mask: u64, ranks: u64, position: u64, rank: u64, seen: u64) -> u64 {
        transition seen == position {
            true -> (rank)
            false -> next(mask, ranks, position, rank, ((seen as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state next(mask: u64, ranks: u64, position: u64, rank: u64, seen: u64) -> u64 {
        transition { _ -> scan(mask, ranks, position, ((rank as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, seen) }
    }
}
