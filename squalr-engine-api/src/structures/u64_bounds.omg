module src::structures::u64_bounds;

// Upstream `a.max(b)` / `a.min(b)` on u64. The bounds are stated so a caller
// can use the result as a nonzero divisor or a page clamp.
public machine u64_max(left: u64, right: u64) -> u64
ensures result >= left && result >= right
{
    transition left >= right {
        true -> (left)
        _ -> (right)
    }
}

public machine u64_min(left: u64, right: u64) -> u64
ensures result <= left && result <= right
{
    transition left <= right {
        true -> (left)
        _ -> (right)
    }
}
