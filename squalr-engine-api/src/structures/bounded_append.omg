module src::structures::bounded_append;

use src::plugins::plugin_id::PluginId;
use src::plugins::plugin_state::PluginState;
use src::registries::symbols::struct_layout_descriptor::StructLayoutDescriptor;
use src::structures::debugger::debugger_breakpoint_descriptor::DebuggerBreakpointDescriptor;
use src::structures::debugger::debugger_trace_instruction_record::DebuggerTraceInstructionRecord;
use src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;

// Capacity-bounded append: stores the item only while the bounded array has
// room and advances the paired count — the shape every `add_<item>` machine
// restates over its `[T; N]` + count field pair. The slice bound carries each
// record's own capacity.

pub machine append_debugger_breakpoint_descriptor(records: &mut [DebuggerBreakpointDescriptor], record_count: &mut u64, item: &DebuggerBreakpointDescriptor) -> bool {
    transition record_count < records.len {
        true -> store(records, record_count, item)
        false -> (false)
    }
    state store(records: &mut [DebuggerBreakpointDescriptor], record_count: &mut u64, item: &DebuggerBreakpointDescriptor) -> bool {
        records[record_count].clone_from(item);
        record_count = ((record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

