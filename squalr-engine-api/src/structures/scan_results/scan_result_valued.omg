module src::structures::scan_results::scan_result_valued;

use src::structures::scan_results::scan_result_base::ScanResultBase;

// Port of structures/scan_results/scan_result_valued.rs: a base result plus
// the materialized current/previous values. Upstream's `Option<DataValue>`
// fields are `has_*` flags beside bounded-value payloads — DataValue is not
// part of this slice, so the values are the element-window u64s the scalar
// leg materializes (the display-value vectors upstream also carries are
// formatter work owned by the CLI response handler).
pub data ScanResultValued {
    scan_result_base: ScanResultBase;
    has_current_value: bool;
    current_value: u64;
    has_previous_value: bool;
    previous_value: u64;
}

pub machine ScanResultValued::new(
    scan_result_base: ScanResultBase,
    has_current_value: bool,
    current_value: u64,
    has_previous_value: bool,
    previous_value: u64
) -> ScanResultValued {
    ScanResultValued {
        scan_result_base: scan_result_base,
        has_current_value: has_current_value,
        current_value: current_value,
        has_previous_value: has_previous_value,
        previous_value: previous_value,
    }
}

pub machine ScanResultValued::default() -> ScanResultValued {
    ScanResultValued {
        scan_result_base: ScanResultBase::default(),
        has_current_value: false,
        current_value: 0,
        has_previous_value: false,
        previous_value: 0,
    }
}

pub machine ScanResultValued::clone(source: &ScanResultValued) -> ScanResultValued {
    ScanResultValued {
        scan_result_base: ScanResultBase::clone(&source.scan_result_base),
        has_current_value: source.has_current_value,
        current_value: source.current_value,
        has_previous_value: source.has_previous_value,
        previous_value: source.previous_value,
    }
}

pub machine ScanResultValued::clone_from(&mut self, source: &ScanResultValued) {
    self.scan_result_base.clone_from(&source.scan_result_base);
    self.has_current_value = source.has_current_value;
    self.current_value = source.current_value;
    self.has_previous_value = source.has_previous_value;
    self.previous_value = source.previous_value;
}

pub machine ScanResultValued::get_base_result(&self) -> ScanResultBase {
    ScanResultBase::clone(&self.scan_result_base)
}

pub machine ScanResultValued::get_address(&self) -> u64 {
    self.scan_result_base.address
}

pub machine ScanResultValued::has_current_value(&self) -> bool {
    self.has_current_value
}

pub machine ScanResultValued::get_current_value(&self) -> u64 {
    self.current_value
}

pub machine ScanResultValued::has_previous_value(&self) -> bool {
    self.has_previous_value
}

pub machine ScanResultValued::get_previous_value(&self) -> u64 {
    self.previous_value
}
