module src::structures::scan_results::scan_result_enriched;

use src::structures::memory::normalized_module::ModuleAddressDisplay;
use src::structures::scan_results::scan_result_valued::ScanResultValued;

// Port of upstream's `ScanResult` struct (structures/scan_results/scan_result.rs) —
// the page-visible result carrying module + freeze enrichment layered over the
// stored `ScanResultValued`. Upstream names this struct `ScanResult`; here the
// `ScanResult` union already owns the page-element name, so upstream's struct
// fields live on the union's `Valued` payload type (documented deviation).
// `recently_read_value` maps to the valued payload's current-value slot;
// `recently_read_display_values` stays parked with the anonymize/display-format
// leg. `module_name` uses the same bounded [u8; 256] + live length convention
// as NormalizedModule and Pointer (upstream unbounded String).
pub data ScanResultEnriched {
    valued_result: ScanResultValued;
    module_name: [u8; 256];
    module_name_len: u64;
    module_offset: u64;
    module_address_display: ModuleAddressDisplay;
    is_frozen: bool;
}

// Upstream `ScanResult::new(valued_result, module, module_offset,
// module_address_display, recently_read_value, recently_read_display_values,
// is_frozen)` — the two value/display params ride the valued payload and the
// parked display leg respectively.
pub machine ScanResultEnriched::new(
    valued_result: ScanResultValued,
    module_name: &[u8],
    module_offset: u64,
    module_address_display: ModuleAddressDisplay,
    is_frozen: bool
) -> ScanResultEnriched {
    let mut result: ScanResultEnriched = ScanResultEnriched {
        valued_result: valued_result,
        module_name_len: 0,
        module_offset: module_offset,
        module_address_display: module_address_display,
        is_frozen: is_frozen,
    };
    result.set_module_name(module_name);
    (result)
}

pub machine ScanResultEnriched::default() -> ScanResultEnriched {
    ScanResultEnriched {
        valued_result: ScanResultValued::default(),
        module_name_len: 0,
        module_offset: 0,
        module_address_display: ModuleAddressDisplay::ModuleRelative,
        is_frozen: false,
    }
}

pub machine ScanResultEnriched::clone(source: &ScanResultEnriched) -> ScanResultEnriched {
    let mut result: ScanResultEnriched = ScanResultEnriched::default();
    result.clone_from(source);
    (result)
}

pub machine ScanResultEnriched::clone_from(&mut self, source: &ScanResultEnriched) {
    self.valued_result.clone_from(&source.valued_result);
    self.module_name_len = source.module_name_len;
    self.module_offset = source.module_offset;
    self.module_address_display = source.module_address_display;
    self.is_frozen = source.is_frozen;
    transition { _ -> copy(source, 0) }
    state copy(&mut self, source: &ScanResultEnriched, position: u64) {
        transition position < source.module_name_len && position < 256 {
            true -> store(source, position)
            false -> done()
            _ -> done()
        }
    }
    state store(&mut self, source: &ScanResultEnriched, position: u64)
        requires 0 <= position && position < 256
    {
        self.module_name[position] = source.module_name[position];
        transition { _ -> copy(source, position + 1) }
    }
    state done(&mut self) {
    }
}

// Upstream `ScanResult::get_module` — the live module_name span.
pub machine ScanResultEnriched::get_module_name(&self) -> &[u8] {
    transition self.module_name_len <= 256 {
        true -> (&self.module_name[0..self.module_name_len])
        false -> (&self.module_name[0..256])
        _ -> (&self.module_name[0..256])
    }
}

// Upstream `set_module_name`'s bounded-buffer respell (NormalizedModule /
// Pointer convention): copy bounded by the live span and the carrier width,
// then publish the copied count as the name length.
pub machine ScanResultEnriched::set_module_name(&mut self, module_name: &[u8]) {
    self.module_name_len = 0;
    transition {
        _ -> copy_name(module_name, 0)
    }
    state copy_name(&mut self, module_name: &[u8], position: u64) {
        transition (position < module_name.len && position < 256) {
            true -> store_name(module_name, position)
            false -> finish(position)
        }
    }
    state store_name(&mut self, module_name: &[u8], position: u64) {
        self.module_name[position] = module_name[position];
        transition {
            _ -> copy_name(module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.module_name_len = count;
    }
}

// Upstream `ScanResult::get_module_offset`.
pub machine ScanResultEnriched::get_module_offset(&self) -> u64 {
    self.module_offset
}

// Upstream `ScanResult::get_module_address_display`.
pub machine ScanResultEnriched::get_module_address_display(&self) -> ModuleAddressDisplay {
    self.module_address_display
}

// Upstream `ScanResult::get_is_frozen`.
pub machine ScanResultEnriched::get_is_frozen(&self) -> bool {
    self.is_frozen
}

// Upstream `ScanResult::get_valued_result` — the stored result payload.
pub machine ScanResultEnriched::get_valued_result(&self) -> &ScanResultValued {
    &self.valued_result
}

// Valued-payload projections the page consumers read through the union.
pub machine ScanResultEnriched::get_address(&self) -> u64 {
    self.valued_result.get_address()
}

pub machine ScanResultEnriched::has_current_value(&self) -> bool {
    self.valued_result.has_current_value()
}

pub machine ScanResultEnriched::get_current_value(&self) -> u64 {
    self.valued_result.get_current_value()
}

pub machine ScanResultEnriched::has_previous_value(&self) -> bool {
    self.valued_result.has_previous_value()
}

pub machine ScanResultEnriched::get_previous_value(&self) -> u64 {
    self.valued_result.get_previous_value()
}
