module src::structures::scan_results::scan_result_enriched;

use src::structures::memory::normalized_module::ModuleAddressDisplay;
use src::structures::scan_results::scan_result_valued::ScanResultValued;

// Port of upstream's `ScanResult` struct (structures/scan_results/scan_result.rs) —
// the page-visible result carrying module + freeze enrichment layered over the
// stored `ScanResultValued`. Upstream names this struct `ScanResult`; here the
// `ScanResult` union already owns the page-element name, so upstream's struct
// fields live on the union's `Valued` payload type (documented deviation).
// `recently_read_value` maps to the valued payload's current-value slot;
// `recently_read_display_values` stays parked with the anonymize/display-format
// leg. `module_name` uses the same bounded [u8; 256] + live length convention
// as NormalizedModule and Pointer (upstream unbounded String).
pub data ScanResultEnriched {
    valued_result: ScanResultValued;
    module_name: [u8; 256];
    module_name_len: u64;
    module_offset: u64;
    module_address_display: ModuleAddressDisplay;
    is_frozen: bool;
}

// Upstream `ScanResult::new(valued_result, module, module_offset,
// module_address_display, recently_read_value, recently_read_display_values,
// is_frozen)` — the two value/display params ride the valued payload and the
// parked display leg respectively.
pub machine ScanResultEnriched::new(
    valued_result: ScanResultValued,
    module_name: &[u8],
    module_offset: u64,
    module_address_display: ModuleAddressDisplay,
    is_frozen: bool
) -> ScanResultEnriched {
    let mut result: ScanResultEnriched = ScanResultEnriched {
        valued_result: valued_result,
        module_name_len: 0,
        module_offset: module_offset,
        module_address_display: module_address_display,
        is_frozen: is_frozen,
    };
    ScanResultEnriched::set_module_name(&mut result, module_name);
    (result)
}

pub machine ScanResultEnriched::default() -> ScanResultEnriched {
    ScanResultEnriched {
        valued_result: ScanResultValued::default(),
        module_name_len: 0,
        module_offset: 0,
        module_address_display: ModuleAddressDisplay::ModuleRelative,
        is_frozen: false,
    }
}

pub machine ScanResultEnriched::clone(source: &ScanResultEnriched) -> ScanResultEnriched {
    let mut result: ScanResultEnriched = ScanResultEnriched::default();
    ScanResultEnriched::clone_from(&mut result, source);
    (result)
}

pub machine ScanResultEnriched::clone_from(this: &mut ScanResultEnriched, source: &ScanResultEnriched) {
    ScanResultValued::clone_from(&mut this.valued_result, &source.valued_result);
    this.module_name_len = source.module_name_len;
    this.module_offset = source.module_offset;
    this.module_address_display = source.module_address_display;
    this.is_frozen = source.is_frozen;
    transition { _ -> copy(this, source, 0) }
    state copy(this: &mut ScanResultEnriched, source: &ScanResultEnriched, position: u64) {
        transition position < source.module_name_len && position < 256 {
            true -> store(this, source, position)
            false -> done(this)
            _ -> done(this)
        }
    }
    state store(this: &mut ScanResultEnriched, source: &ScanResultEnriched, position: u64)
        requires 0 <= position && position < 256
    {
        this.module_name[position] = source.module_name[position];
        transition { _ -> copy(this, source, position + 1) }
    }
    state done(this: &mut ScanResultEnriched) {
    }
}

// Upstream `ScanResult::get_module` — the live module_name span.
pub machine ScanResultEnriched::get_module_name(this: &ScanResultEnriched) -> &[u8] {
    transition this.module_name_len <= 256 {
        true -> (&this.module_name[0..this.module_name_len])
        false -> (&this.module_name[0..256])
        _ -> (&this.module_name[0..256])
    }
}

// Upstream `set_module_name`'s bounded-buffer respell (NormalizedModule /
// Pointer convention): copy bounded by the live span and the carrier width,
// then publish the copied count as the name length.
pub machine ScanResultEnriched::set_module_name(this: &mut ScanResultEnriched, module_name: &[u8]) {
    this.module_name_len = 0;
    transition {
        _ -> copy_name(this, module_name, 0)
    }
    state copy_name(this: &mut ScanResultEnriched, module_name: &[u8], position: u64) {
        transition (position < module_name.len && position < 256) {
            true -> store_name(this, module_name, position)
            false -> finish(this, position)
        }
    }
    state store_name(this: &mut ScanResultEnriched, module_name: &[u8], position: u64) {
        this.module_name[position] = module_name[position];
        transition {
            _ -> copy_name(this, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut ScanResultEnriched, count: u64) {
        this.module_name_len = count;
    }
}

// Upstream `ScanResult::get_module_offset`.
pub machine ScanResultEnriched::get_module_offset(this: &ScanResultEnriched) -> u64 {
    this.module_offset
}

// Upstream `ScanResult::get_module_address_display`.
pub machine ScanResultEnriched::get_module_address_display(this: &ScanResultEnriched) -> ModuleAddressDisplay {
    this.module_address_display
}

// Upstream `ScanResult::get_is_frozen`.
pub machine ScanResultEnriched::get_is_frozen(this: &ScanResultEnriched) -> bool {
    this.is_frozen
}

// Upstream `ScanResult::get_valued_result` — the stored result payload.
pub machine ScanResultEnriched::get_valued_result(this: &ScanResultEnriched) -> &ScanResultValued {
    &this.valued_result
}

// Valued-payload projections the page consumers read through the union.
pub machine ScanResultEnriched::get_address(this: &ScanResultEnriched) -> u64 {
    let hoist1: u64 = ScanResultValued::get_address(&this.valued_result);
    (hoist1)
}

pub machine ScanResultEnriched::has_current_value(this: &ScanResultEnriched) -> bool {
    let hoist2: bool = ScanResultValued::has_current_value(&this.valued_result);
    (hoist2)
}

pub machine ScanResultEnriched::get_current_value(this: &ScanResultEnriched) -> u64 {
    let hoist3: u64 = ScanResultValued::get_current_value(&this.valued_result);
    (hoist3)
}

pub machine ScanResultEnriched::has_previous_value(this: &ScanResultEnriched) -> bool {
    let hoist4: bool = ScanResultValued::has_previous_value(&this.valued_result);
    (hoist4)
}

pub machine ScanResultEnriched::get_previous_value(this: &ScanResultEnriched) -> u64 {
    let hoist5: u64 = ScanResultValued::get_previous_value(&this.valued_result);
    (hoist5)
}
