module src::structures::scan_results::scan_result_data_type_count;

use src::structures::data_types::data_type_ref::DataTypeRef;

// Port of structures/scan_results/scan_result_data_type_count.rs: one
// (data_type, count) entry in the result-count summary.
pub data ScanResultDataTypeCount {
    data_type_ref: DataTypeRef;
    count: u64;
}

pub machine ScanResultDataTypeCount::new(data_type_ref: DataTypeRef, count: u64) -> ScanResultDataTypeCount {
    ScanResultDataTypeCount { data_type_ref: data_type_ref, count: count }
}

pub machine ScanResultDataTypeCount::default() -> ScanResultDataTypeCount {
    ScanResultDataTypeCount { data_type_ref: DataTypeRef::default(), count: 0 }
}

pub machine ScanResultDataTypeCount::clone(source: &ScanResultDataTypeCount) -> ScanResultDataTypeCount {
    ScanResultDataTypeCount {
        data_type_ref: DataTypeRef::clone(&source.data_type_ref),
        count: source.count,
    }
}

pub machine ScanResultDataTypeCount::clone_from(&mut self, source: &ScanResultDataTypeCount) {
    self.data_type_ref.clone_from(&source.data_type_ref);
    self.count = source.count;
}
