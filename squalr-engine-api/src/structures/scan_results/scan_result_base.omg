module src::structures::scan_results::scan_result_base;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::scan_results::scan_result_ref::ScanResultRef;

// Port of structures/scan_results/scan_result_base.rs: address + data type +
// icon + handle — the pre-materialization result shape the list command
// turns into ScanResultValued. `icon_id` is a growable String upstream; the
// port keeps a bounded inline buffer (MAX_ICON = 16 — icon ids are short;
// named deviation).
pub data ScanResultBase {
    address: u64;
    data_type_ref: DataTypeRef;
    icon_id: [u8; 16];
    icon_id_len: u64;
    handle: ScanResultRef;
}

pub machine ScanResultBase::new(
    address: u64,
    data_type_ref: DataTypeRef,
    handle: ScanResultRef
) -> ScanResultBase {
    ScanResultBase {
        address: address,
        data_type_ref: data_type_ref,
        icon_id_len: 0,
        handle: handle,
    }
}

pub machine ScanResultBase::default() -> ScanResultBase {
    ScanResultBase {
        address: 0,
        data_type_ref: DataTypeRef::default(),
        icon_id_len: 0,
        handle: ScanResultRef::default(),
    }
}

machine ScanResultBase::copy_icon(scan_result_base: &mut ScanResultBase, source: &ScanResultBase, position: u64) {
    transition position < source.icon_id_len && position < 16 {
        true -> copy(scan_result_base, source, position)
        false -> done(scan_result_base)
    }
    state copy(scan_result_base: &mut ScanResultBase, source: &ScanResultBase, position: u64) {
        scan_result_base.icon_id[position] = source.icon_id[position];
        transition { _ -> ScanResultBase::copy_icon(scan_result_base, source, position + 1) }
    }
    state done(scan_result_base: &mut ScanResultBase) {
        scan_result_base.icon_id_len = scan_result_base.icon_id_len;
    }
}

pub machine ScanResultBase::clone(source: &ScanResultBase) -> ScanResultBase {
    let mut base: ScanResultBase = ScanResultBase {
        address: source.address,
        data_type_ref: DataTypeRef::clone(&source.data_type_ref),
        icon_id_len: source.icon_id_len,
        handle: ScanResultRef::clone(&source.handle),
    };
    ScanResultBase::copy_icon(&mut base, source, 0);
    base
}

pub machine ScanResultBase::clone_from(scan_result_base: &mut ScanResultBase, source: &ScanResultBase) {
    scan_result_base.address = source.address;
    DataTypeRef::clone_from(&mut scan_result_base.data_type_ref, &source.data_type_ref);
    ScanResultRef::clone_from(&mut scan_result_base.handle, &source.handle);
    scan_result_base.icon_id_len = source.icon_id_len;
    ScanResultBase::copy_icon(scan_result_base, source, 0);
}

pub machine ScanResultBase::get_address(scan_result_base: &ScanResultBase) -> u64 {
    scan_result_base.address
}

pub machine ScanResultBase::set_address(scan_result_base: &mut ScanResultBase, address: u64) {
    scan_result_base.address = address;
}

pub machine ScanResultBase::get_data_type_ref(scan_result_base: &ScanResultBase) -> DataTypeRef {
    DataTypeRef::clone(&scan_result_base.data_type_ref)
}

pub machine ScanResultBase::get_handle(scan_result_base: &ScanResultBase) -> ScanResultRef {
    ScanResultRef::clone(&scan_result_base.handle)
}

pub machine ScanResultBase::get_icon_id_len(scan_result_base: &ScanResultBase) -> u64 {
    scan_result_base.icon_id_len
}
