module src::structures::scan_results::scan_result_base;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::scan_results::scan_result_ref::ScanResultRef;

// Port of structures/scan_results/scan_result_base.rs: address + data type +
// icon + handle — the pre-materialization result shape the list command
// turns into ScanResultValued. `icon_id` is a growable String upstream; the
// port keeps a bounded inline buffer (MAX_ICON = 16 — icon ids are short;
// named deviation).
pub data ScanResultBase {
    address: u64;
    data_type_ref: DataTypeRef;
    icon_id: [u8; 16];
    icon_id_len: u64;
    handle: ScanResultRef;
}

pub machine ScanResultBase::new(
    address: u64,
    data_type_ref: DataTypeRef,
    handle: ScanResultRef
) -> ScanResultBase {
    ScanResultBase {
        address: address,
        data_type_ref: data_type_ref,
        icon_id_len: 0,
        handle: handle,
    }
}

pub machine ScanResultBase::default() -> ScanResultBase {
    ScanResultBase {
        address: 0,
        data_type_ref: DataTypeRef::default(),
        icon_id_len: 0,
        handle: ScanResultRef::default(),
    }
}

machine ScanResultBase::copy_icon(&mut self, source: &ScanResultBase, position: u64) {
    transition position < source.icon_id_len && position < 16 {
        true -> copy(source, position)
        false -> done()
    }
    state copy(&mut self, source: &ScanResultBase, position: u64) {
        self.icon_id[position] = source.icon_id[position];
        transition { _ -> copy_icon(source, position + 1) }
    }
    state done(&mut self) {
        self.icon_id_len = self.icon_id_len;
    }
}

pub machine ScanResultBase::clone(source: &ScanResultBase) -> ScanResultBase {
    let mut base: ScanResultBase = ScanResultBase {
        address: source.address,
        data_type_ref: DataTypeRef::clone(&source.data_type_ref),
        icon_id_len: source.icon_id_len,
        handle: ScanResultRef::clone(&source.handle),
    };
    base.copy_icon(source, 0);
    base
}

pub machine ScanResultBase::clone_from(&mut self, source: &ScanResultBase) {
    self.address = source.address;
    self.data_type_ref.clone_from(&source.data_type_ref);
    self.handle.clone_from(&source.handle);
    self.icon_id_len = source.icon_id_len;
    self.copy_icon(source, 0);
}

pub machine ScanResultBase::get_address(&self) -> u64 {
    self.address
}

pub machine ScanResultBase::set_address(&mut self, address: u64) {
    self.address = address;
}

pub machine ScanResultBase::get_data_type_ref(&self) -> DataTypeRef {
    DataTypeRef::clone(&self.data_type_ref)
}

pub machine ScanResultBase::get_handle(&self) -> ScanResultRef {
    ScanResultRef::clone(&self.handle)
}

pub machine ScanResultBase::get_icon_id_len(&self) -> u64 {
    self.icon_id_len
}
