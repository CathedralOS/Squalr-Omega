module src::structures::scan_results::scan_result;

use src::structures::scan_results::scan_result_enriched::ScanResultEnriched;

// Port of structures/scan_results/scan_result.rs: the page-visible result
// union. Upstream's `ScanResult` is a plain struct — the valued payload plus
// module/freeze enrichment — which Omega carries as `ScanResultEnriched`
// behind the union's `Valued` case (struct/property results arrive with the
// struct-scan leg). Deviation: a leading payload-less `Empty` case gives
// page arrays a zero leaf — unions whose first case carries a structural
// payload cannot mint one.
public data ScanResult {
    case Empty;
    case Valued(result: ScanResultEnriched);
}

public machine ScanResult::default() -> ScanResult {
    (ScanResult::Empty)
}

// Upstream `Clone::clone(&self)`. A case-payload call cannot mint a union
// result inside a transition arm (result ownership), so the payload moves
// by value into a state that keeps `&self` live and constructs the case in
// its bare tail.
public machine ScanResult::clone(this: &ScanResult) -> ScanResult {
    transition this {
        ScanResult::Valued { result } -> clone_valued(this, result)
        _ -> (ScanResult::default())
    }
    state clone_valued(this: &ScanResult, result: ScanResultEnriched) -> ScanResult {
        ScanResult::Valued {
            result: ScanResultEnriched::clone(&result)
        }
    }
}

public machine ScanResult::clone_from(this: &mut ScanResult, source: &ScanResult) {
    let cloned: ScanResult = ScanResult::clone(&source);
    this = cloned;
}

// Scalar projections for consumers whose unit kind lacks union-match
// terminators: 0 for cases that carry no value yet.
public machine ScanResult::is_valued(this: &ScanResult) -> bool {
    transition this {
        ScanResult::Valued { result } -> (true)
        _ -> (false)
    }
}

public machine ScanResult::get_address(this: &ScanResult) -> u64 {
    transition this {
        ScanResult::Valued { result } -> at(this, result)
        _ -> (0)
    }
    state at(this: &ScanResult, result: ScanResultEnriched) -> u64 {
        let hoist1: u64 = ScanResultEnriched::get_address(&result);
        (hoist1)
    }
}

public machine ScanResult::has_current_value(this: &ScanResult) -> bool {
    transition this {
        ScanResult::Valued { result } -> at(this, result)
        _ -> (false)
    }
    state at(this: &ScanResult, result: ScanResultEnriched) -> bool {
        let hoist2: bool = ScanResultEnriched::has_current_value(&result);
        (hoist2)
    }
}

public machine ScanResult::get_current_value(this: &ScanResult) -> u64 {
    transition this {
        ScanResult::Valued { result } -> at(this, result)
        _ -> (0)
    }
    state at(this: &ScanResult, result: ScanResultEnriched) -> u64 {
        let hoist3: u64 = ScanResultEnriched::get_current_value(&result);
        (hoist3)
    }
}

// Enrichment projections — scalar/copy returns only (a `&[u8]` off a bound
// case payload has no egress across the state edge, so module_name stays a
// `ScanResultEnriched` getter for the pre-unionization consumers).
public machine ScanResult::get_module_offset(this: &ScanResult) -> u64 {
    transition this {
        ScanResult::Valued { result } -> at(this, result)
        _ -> (0)
    }
    state at(this: &ScanResult, result: ScanResultEnriched) -> u64 {
        let hoist4: u64 = ScanResultEnriched::get_module_offset(&result);
        (hoist4)
    }
}

public machine ScanResult::get_is_frozen(this: &ScanResult) -> bool {
    transition this {
        ScanResult::Valued { result } -> at(this, result)
        _ -> (false)
    }
    state at(this: &ScanResult, result: ScanResultEnriched) -> bool {
        let hoist5: bool = ScanResultEnriched::get_is_frozen(&result);
        (hoist5)
    }
}

// Upstream `ScanResult::PROPERTY_NAME_*` string consts (scan_result.rs) —
// the `field_namespace` spellings a set-property request matches against.
// Ports return byte strings; comparison is exact like upstream's `as_str()`
// match.
public machine ScanResult::property_name_value() -> &[u8] {
    ("value")
}

public machine ScanResult::property_name_is_frozen() -> &[u8] {
    ("is_frozen")
}

public machine ScanResult::property_name_address() -> &[u8] {
    ("address")
}

public machine ScanResult::property_name_module() -> &[u8] {
    ("module")
}

public machine ScanResult::property_name_module_offset() -> &[u8] {
    ("module_offset")
}
