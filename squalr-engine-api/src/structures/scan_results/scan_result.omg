module src::structures::scan_results::scan_result;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::scan_results::scan_result_base::ScanResultBase;
use src::structures::scan_results::scan_result_enriched::ScanResultEnriched;
use src::structures::scan_results::scan_result_valued::ScanResultValued;

// Port of structures/scan_results/scan_result.rs: the page-visible result
// union. Upstream's `ScanResult` is a plain struct — the valued payload plus
// module/freeze enrichment — which Omega carries as `ScanResultEnriched`
// behind the union's `Valued` case (struct/property results arrive with the
// struct-scan leg). Deviation: a leading payload-less `Empty` case gives
// page arrays a zero leaf — unions whose first case carries a structural
// payload cannot mint one.
pub data ScanResult {
    case Empty;
    case Valued(result: ScanResultEnriched);
}

pub machine ScanResult::default() -> ScanResult {
    (ScanResult::Empty)
}

// Upstream `Clone::clone(&self)`. A case-payload call cannot mint a union
// result inside a transition arm (result ownership), so the payload moves
// by value into a state that keeps `&self` live and constructs the case in
// its bare tail.
pub machine ScanResult::clone(scan_result: &ScanResult) -> ScanResult {
    transition scan_result {
        ScanResult::Valued { result } -> clone_valued(scan_result, result)
        _ -> (ScanResult::default())
    }
    state clone_valued(scan_result: &ScanResult, result: &ScanResultEnriched) -> ScanResult {
        ScanResult::Valued {
            result: ScanResultEnriched::clone(result)
        }
    }
}

pub machine ScanResult::clone_from(scan_result: &mut ScanResult, source: &ScanResult) {
    let cloned: ScanResult = ScanResult::clone(source);
    scan_result = cloned;
}

// Scalar projections for consumers whose unit kind lacks union-match
// terminators: 0 for cases that carry no value yet.
pub machine ScanResult::is_valued(scan_result: &ScanResult) -> bool {
    transition scan_result {
        ScanResult::Valued { result } -> (true)
        _ -> (false)
    }
}

pub machine ScanResult::get_address(scan_result: &ScanResult) -> u64 {
    transition scan_result {
        ScanResult::Valued { result } -> at(scan_result, result)
        _ -> (0)
    }
    state at(scan_result: &ScanResult, result: &ScanResultEnriched) -> u64 {
        ScanResultEnriched::get_address(result)
    }
}

pub machine ScanResult::has_current_value(scan_result: &ScanResult) -> bool {
    transition scan_result {
        ScanResult::Valued { result } -> at(scan_result, result)
        _ -> (false)
    }
    state at(scan_result: &ScanResult, result: &ScanResultEnriched) -> bool {
        ScanResultEnriched::has_current_value(result)
    }
}

pub machine ScanResult::get_current_value(scan_result: &ScanResult) -> u64 {
    transition scan_result {
        ScanResult::Valued { result } -> at(scan_result, result)
        _ -> (0)
    }
    state at(scan_result: &ScanResult, result: &ScanResultEnriched) -> u64 {
        ScanResultEnriched::get_current_value(result)
    }
}

// Enrichment projections — scalar/copy returns only (a `&[u8]` off a bound
// case payload has no egress across the state edge, so module_name stays a
// `ScanResultEnriched` getter for the pre-unionization consumers).
pub machine ScanResult::get_module_offset(scan_result: &ScanResult) -> u64 {
    transition scan_result {
        ScanResult::Valued { result } -> at(scan_result, result)
        _ -> (0)
    }
    state at(scan_result: &ScanResult, result: &ScanResultEnriched) -> u64 {
        ScanResultEnriched::get_module_offset(result)
    }
}

pub machine ScanResult::get_is_frozen(scan_result: &ScanResult) -> bool {
    transition scan_result {
        ScanResult::Valued { result } -> at(scan_result, result)
        _ -> (false)
    }
    state at(scan_result: &ScanResult, result: &ScanResultEnriched) -> bool {
        ScanResultEnriched::get_is_frozen(result)
    }
}

// Upstream `ScanResult::PROPERTY_NAME_*` string consts (scan_result.rs) —
// the `field_namespace` spellings a set-property request matches against.
// Ports return byte strings; comparison is exact like upstream's `as_str()`
// match.
pub machine ScanResult::property_name_value() -> &[u8] {
    ("value")
}

pub machine ScanResult::property_name_is_frozen() -> &[u8] {
    ("is_frozen")
}

pub machine ScanResult::property_name_address() -> &[u8] {
    ("address")
}

pub machine ScanResult::property_name_module() -> &[u8] {
    ("module")
}

pub machine ScanResult::property_name_module_offset() -> &[u8] {
    ("module_offset")
}

// Upstream `get_module` — module enrichment name bytes ("" when unvalued
// or unmoduled).
pub machine ScanResult::get_module_name(scan_result: &ScanResult, out: &mut [u8; 256]) -> u64 {
    transition scan_result {
        ScanResult::Valued { result } -> at(scan_result, result, out)
        _ -> (0)
    }
    state at(scan_result: &ScanResult, result: &ScanResultEnriched, out: &mut [u8; 256]) -> u64 {
        let module_name: &[u8] = ScanResultEnriched::get_module_name(result);
        let module_name_len: u64 = module_name.len;
        transition { _ -> copy_gate(result, out, module_name_len, module_name_len) }
    }
    state copy_gate(result: &ScanResultEnriched, out: &mut [u8; 256], module_name_len: u64, source_len: u64) -> u64 {
        transition module_name_len <= 256 && source_len <= 256 {
            true -> copy_loop(result, out, module_name_len, 0, module_name_len)
            _ -> (0)
        }
    }
    state copy_loop(result: &ScanResultEnriched, out: &mut [u8; 256], module_name_len: u64, position: u64, source_len: u64) -> u64
        requires module_name_len <= 256 && source_len <= 256;
    {
        transition position < module_name_len && position < source_len {
            true -> copy_byte(result, out, module_name_len, position, source_len)
            _ -> (module_name_len)
        }
    }
    state copy_byte(result: &ScanResultEnriched, out: &mut [u8; 256], module_name_len: u64, position: u64, source_len: u64) -> u64
        requires position < source_len && position < 256 && source_len <= 256 && module_name_len <= 256;
    {
        let module_bytes: &[u8] = ScanResultEnriched::get_module_name(result);
        transition position < module_bytes.len {
            true -> put(module_bytes, result, out, module_name_len, position, source_len)
            _ -> copy_loop(result, out, module_name_len, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, source_len)
        }
    }
    state put(module_bytes: &[u8], result: &ScanResultEnriched, out: &mut [u8; 256], module_name_len: u64, position: u64, source_len: u64) -> u64
        requires position < module_bytes.len && position < source_len && position < 256 && source_len <= 256 && module_name_len <= 256;
    {
        out[position] = module_bytes[position];
        transition { _ -> copy_loop(result, out, module_name_len, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, source_len) }
    }
}

// Upstream `is_module` — module enrichment present.
pub machine ScanResult::is_module(scan_result: &ScanResult) -> bool {
    transition scan_result {
        ScanResult::Valued { result } -> at(scan_result, result)
        _ -> (false)
    }
    state at(scan_result: &ScanResult, result: &ScanResultEnriched) -> bool {
        let name_bytes: &[u8] = ScanResultEnriched::get_module_name(result);
        (name_bytes.len > 0)
    }
}

// Upstream `get_data_type_ref` — the valued payload's base ref.
pub machine ScanResult::get_data_type_ref(scan_result: &ScanResult) -> DataTypeRef {
    transition scan_result {
        ScanResult::Valued { result } -> at(scan_result, result)
        _ -> (DataTypeRef::default())
    }
    state at(scan_result: &ScanResult, result: &ScanResultEnriched) -> DataTypeRef {
        let valued: ScanResultValued = ScanResultEnriched::get_valued_result(result);
        let base: ScanResultBase = ScanResultValued::get_base_result(&valued);
        ScanResultBase::get_data_type_ref(&base)
    }
}
