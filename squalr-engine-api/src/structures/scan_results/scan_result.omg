module src::structures::scan_results::scan_result;

use src::structures::scan_results::scan_result_enriched::ScanResultEnriched;

// Port of structures/scan_results/scan_result.rs: the page-visible result
// union. Upstream's `ScanResult` is a plain struct — the valued payload plus
// module/freeze enrichment — which Omega carries as `ScanResultEnriched`
// behind the union's `Valued` case (struct/property results arrive with the
// struct-scan leg). Deviation: a leading payload-less `Empty` case gives
// page arrays a zero leaf — unions whose first case carries a structural
// payload cannot mint one.
pub data ScanResult {
    case Empty;
    case Valued(result: ScanResultEnriched);
}

pub machine ScanResult::default() -> ScanResult {
    (ScanResult::Empty)
}

// Upstream `Clone::clone(&self)`. A case-payload call cannot mint a union
// result inside a transition arm (result ownership), so the payload moves
// by value into a state that keeps `&self` live and constructs the case in
// its bare tail.
pub machine ScanResult::clone(&self) -> ScanResult {
    transition self {
        ScanResult::Valued { result } -> clone_valued(result)
        _ -> (ScanResult::default())
    }
    state clone_valued(&self, result: ScanResultEnriched) -> ScanResult {
        ScanResult::Valued {
            result: ScanResultEnriched::clone(&result)
        }
    }
}

pub machine ScanResult::clone_from(&mut self, source: &ScanResult) {
    let cloned: ScanResult = source.clone();
    self = cloned;
}

// Scalar projections for consumers whose unit kind lacks union-match
// terminators: 0 for cases that carry no value yet.
pub machine ScanResult::is_valued(&self) -> bool {
    transition self {
        ScanResult::Valued { result } -> (true)
        _ -> (false)
    }
}

pub machine ScanResult::get_address(&self) -> u64 {
    transition self {
        ScanResult::Valued { result } -> at(result)
        _ -> (0)
    }
    state at(&self, result: ScanResultEnriched) -> u64 {
        result.get_address()
    }
}

pub machine ScanResult::has_current_value(&self) -> bool {
    transition self {
        ScanResult::Valued { result } -> at(result)
        _ -> (false)
    }
    state at(&self, result: ScanResultEnriched) -> bool {
        result.has_current_value()
    }
}

pub machine ScanResult::get_current_value(&self) -> u64 {
    transition self {
        ScanResult::Valued { result } -> at(result)
        _ -> (0)
    }
    state at(&self, result: ScanResultEnriched) -> u64 {
        result.get_current_value()
    }
}

// Enrichment projections — scalar/copy returns only (a `&[u8]` off a bound
// case payload has no egress across the state edge, so module_name stays a
// `ScanResultEnriched` getter for the pre-unionization consumers).
pub machine ScanResult::get_module_offset(&self) -> u64 {
    transition self {
        ScanResult::Valued { result } -> at(result)
        _ -> (0)
    }
    state at(&self, result: ScanResultEnriched) -> u64 {
        result.get_module_offset()
    }
}

pub machine ScanResult::get_is_frozen(&self) -> bool {
    transition self {
        ScanResult::Valued { result } -> at(result)
        _ -> (false)
    }
    state at(&self, result: ScanResultEnriched) -> bool {
        result.get_is_frozen()
    }
}

// Upstream `ScanResult::PROPERTY_NAME_*` string consts (scan_result.rs) —
// the `field_namespace` spellings a set-property request matches against.
// Ports return byte strings; comparison is exact like upstream's `as_str()`
// match.
pub machine ScanResult::property_name_value() -> &[u8] {
    ("value")
}

pub machine ScanResult::property_name_is_frozen() -> &[u8] {
    ("is_frozen")
}

pub machine ScanResult::property_name_address() -> &[u8] {
    ("address")
}

pub machine ScanResult::property_name_module() -> &[u8] {
    ("module")
}

pub machine ScanResult::property_name_module_offset() -> &[u8] {
    ("module_offset")
}
