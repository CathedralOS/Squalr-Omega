module src::structures::scan_results::scan_result_ref;

// Port of structures/scan_results/scan_result_ref.rs: the stable global
// handle a scan result carries (its global index within the snapshot plus
// the struct/element discriminant).
pub data ScanResultRef {
    scan_result_index: u64;
    is_struct: bool;
}

pub machine ScanResultRef::new(scan_result_index: u64, is_struct: bool) -> ScanResultRef {
    ScanResultRef { scan_result_index: scan_result_index, is_struct: is_struct }
}

pub machine ScanResultRef::default() -> ScanResultRef {
    ScanResultRef { scan_result_index: 0, is_struct: false }
}

pub machine ScanResultRef::clone(source: &ScanResultRef) -> ScanResultRef {
    ScanResultRef {
        scan_result_index: source.scan_result_index,
        is_struct: source.is_struct,
    }
}

pub machine ScanResultRef::clone_from(scan_result_ref: &mut ScanResultRef, source: &ScanResultRef) {
    scan_result_ref.scan_result_index = source.scan_result_index;
    scan_result_ref.is_struct = source.is_struct;
}

pub machine ScanResultRef::get_scan_result_index(scan_result_ref: &ScanResultRef) -> u64 {
    scan_result_ref.scan_result_index
}

pub machine ScanResultRef::set_scan_result_index(scan_result_ref: &mut ScanResultRef, scan_result_index: u64) {
    scan_result_ref.scan_result_index = scan_result_index;
}

pub machine ScanResultRef::get_is_struct(scan_result_ref: &ScanResultRef) -> bool {
    scan_result_ref.is_struct
}

pub machine ScanResultRef::set_is_struct(scan_result_ref: &mut ScanResultRef, is_struct: bool) {
    scan_result_ref.is_struct = is_struct;
}
