module src::structures::scan_results::scan_results_metadata;

// Port of structures/scan_results/scan_results_metadata.rs. Upstream is a
// pure record (`result_count`, `total_size_in_bytes`): the response-carried
// half of the scan statistics shape, filled at response time from sibling
// snapshot counters (collect_scan_results_metadata sources
// get_number_of_results / get_collected_byte_count). Wire field numbers
// follow the upstream Serialize declaration order, so the synthesized
// `ScanResultsMetadata::encode`/`decode` pair is this type's serialization;
// `clone`/`clone_from` are the authored equivalent of the derived Clone impl
// and `default` the derived Default (ElementScanResponse's own derived
// Default calls it). `Debug` carries no port surface.
pub data ScanResultsMetadata {
    result_count: u64;
    total_size_in_bytes: u64;
}

// The dispatchable decode verdict: Invalid is the zero case, so an untouched
// verdict reads as failure (the decode contract requires this exact shape).
data WireVerdict {
    case Invalid;
    case Sound;
}

pub machine ScanResultsMetadata::default() -> ScanResultsMetadata {
    ScanResultsMetadata { result_count: 0, total_size_in_bytes: 0 }
}

pub machine ScanResultsMetadata::clone(source: &ScanResultsMetadata) -> ScanResultsMetadata {
    ScanResultsMetadata {
        result_count: source.result_count,
        total_size_in_bytes: source.total_size_in_bytes
    }
}

pub machine ScanResultsMetadata::clone_from(scan_results_metadata: &mut ScanResultsMetadata, source: &ScanResultsMetadata) {
    scan_results_metadata.result_count = source.result_count;
    scan_results_metadata.total_size_in_bytes = source.total_size_in_bytes;
}

pub machine ScanResultsMetadata::get_result_count(scan_results_metadata: &ScanResultsMetadata) -> u64 {
    scan_results_metadata.result_count
}

pub machine ScanResultsMetadata::set_result_count(scan_results_metadata: &mut ScanResultsMetadata, result_count: u64) {
    scan_results_metadata.result_count = result_count;
}

pub machine ScanResultsMetadata::get_total_size_in_bytes(scan_results_metadata: &ScanResultsMetadata) -> u64 {
    scan_results_metadata.total_size_in_bytes
}

pub machine ScanResultsMetadata::set_total_size_in_bytes(scan_results_metadata: &mut ScanResultsMetadata, total_size_in_bytes: u64) {
    scan_results_metadata.total_size_in_bytes = total_size_in_bytes;
}

// Upstream `Serialize`/`Deserialize` parity, exercised in-package: encoding
// and decoding the value through the synthesized era codec preserves it.
// Bound to this module for the same compiler edges NormalizedRegion names:
