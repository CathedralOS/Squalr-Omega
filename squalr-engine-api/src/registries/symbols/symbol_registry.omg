module src::registries::symbols::symbol_registry;

use src::registries::symbols::data_type_descriptor::DataTypeDescriptor;
use src::registries::symbols::privileged_registry_catalog::PrivilegedRegistryCatalog;
use src::registries::symbols::struct_layout_descriptor::StructLayoutDescriptor;
use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use src::structures::data_values::container_type::ContainerType;
use src::structures::memory::endian::Endian;
use src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;
use src::structures::structs::symbolic_field_definition::SymbolicFieldDefinition;
use src::structures::structs::symbolic_struct_definition::SymbolicLayoutKind;
use src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;

// Port of registries/symbols/symbol_registry.rs — the engine's symbolic
// struct and data-type descriptor tables behind `EnginePrivilegedState`.
// Named deviations, recorded once:
// - Upstream's three `HashMap<String, Arc<...>>` maps become bounded
//   insertion-ordered tables of 128 slots each (`[T; 128]` + count, the
//   freeze-list registry convention; 128 matches the wire catalog bound so
//   `apply_registry_catalog` stays infallible like upstream). Id-keyed
//   lookup is a linear scan; where upstream's map insert could not fail,
//   a full table here answers false.
// - Upstream's `data_type_registry: HashMap<String, Arc<dyn DataType>>`
//   carries dyn data types registered by plugins; dyn has no Omega
//   equivalent, so the table is dropped. Its observable surface on this
//   file is key membership — `is_registered_data_type` answers over the
//   fixed builtin id set, since builtins are the only types that can
//   register headless. Plugin-registered ids rejoin the check when the
//   Plugins domain lands (named residual).
// - Upstream guards each map with `RwLock` (and the session wraps
//   mutators in `symbol_registry_mutation_guard: Mutex<()>`); a
//   session-owned record needs neither. The lock-error arms are
//   unreachable by construction and are not ported.
// - `new` seeds the 21 upstream builtin data types — a descriptor plus
//   the anonymous single-field symbolic struct each — matching
//   `create_built_in_registries` field for field (icon id = data type id,
//   unit sizes, endianness, float/signed flags, supported anonymous
//   string formats).
// - Upstream trims the probe side of each lookup (`key.trim()`); the
//   port measures the probe's whitespace-trimmed window against stored
//   raw ids (`ids_equal`). Stored ids are never trimmed — upstream map
//   keys aren't either. Map-key equality (the merged view's shadow rule)
//   uses exact `bytes_equal`, since `HashMap::extend` compares keys
//   exactly.
// - Deferred upstream surface: `register_data_type`/`unregister_data_type`/
//   `get_data_type`/`get_data_type_registry`/`get_registered_data_type_refs`
//   (dyn-typed, plugin-fed), `get_data_type_descriptor`'s base-id dyn
//   fallback, the dyn-delegate ops (`is_valid`, `validate_value_string`,
//   `validate_scan_constraint`, `deanonymize_value_string`, `get_icon_id`,
//   `get_unit_size_in_bytes`), and `get`'s inline `from_str` struct
//   definition fallback.
pub data SymbolRegistry {
    // Upstream `symbolic_struct_registry` (the privileged/base map).
    symbolic_structs: [StructLayoutDescriptor; 128];
    symbolic_struct_count: u64;
    // Upstream `project_symbolic_struct_registry`.
    project_symbolic_structs: [StructLayoutDescriptor; 128];
    project_symbolic_struct_count: u64;
    // Upstream `data_type_descriptor_registry` (builtins seeded at `new`).
    data_type_descriptors: [DataTypeDescriptor; 128];
    data_type_descriptor_count: u64;
}

pub machine SymbolRegistry::new() -> SymbolRegistry {
    let mut registry: SymbolRegistry = SymbolRegistry {
        symbolic_struct_count: 0,
        project_symbolic_struct_count: 0,
        data_type_descriptor_count: 0,
    };
    SymbolRegistry::seed_builtins(&mut registry);
    (registry)
}

pub machine SymbolRegistry::default() -> SymbolRegistry {
    (SymbolRegistry::new())
}

// Upstream `create_built_in_registries`: the 21 builtin data types, each
// seeding a descriptor and an anonymous symbolic struct under its id.
// `built_in_data_type_ids` is their key set — see `is_builtin_data_type_id`.
machine SymbolRegistry::seed_builtins(this: &mut SymbolRegistry) {
    transition {
        _ -> seed_bool8(this)
    }
    state seed_bool8(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_bool(&mut this, "bool8", 1);
        transition { _ -> seed_bool32(this) }
    }
    state seed_bool32(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_bool(&mut this, "bool32", 4);
        transition { _ -> seed_i8(this) }
    }
    state seed_i8(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "i8", 1, Endian::Little, true);
        transition { _ -> seed_i16(this) }
    }
    state seed_i16(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "i16", 2, Endian::Little, true);
        transition { _ -> seed_i16be(this) }
    }
    state seed_i16be(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "i16be", 2, Endian::Big, true);
        transition { _ -> seed_i32(this) }
    }
    state seed_i32(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "i32", 4, Endian::Little, true);
        transition { _ -> seed_i32be(this) }
    }
    state seed_i32be(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "i32be", 4, Endian::Big, true);
        transition { _ -> seed_i64(this) }
    }
    state seed_i64(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "i64", 8, Endian::Little, true);
        transition { _ -> seed_i64be(this) }
    }
    state seed_i64be(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "i64be", 8, Endian::Big, true);
        transition { _ -> seed_u8(this) }
    }
    state seed_u8(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "u8", 1, Endian::Little, false);
        transition { _ -> seed_u16(this) }
    }
    state seed_u16(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "u16", 2, Endian::Little, false);
        transition { _ -> seed_u16be(this) }
    }
    state seed_u16be(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "u16be", 2, Endian::Big, false);
        transition { _ -> seed_u32(this) }
    }
    state seed_u32(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "u32", 4, Endian::Little, false);
        transition { _ -> seed_u32be(this) }
    }
    state seed_u32be(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "u32be", 4, Endian::Big, false);
        transition { _ -> seed_u64(this) }
    }
    state seed_u64(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "u64", 8, Endian::Little, false);
        transition { _ -> seed_u64be(this) }
    }
    state seed_u64be(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_numeric(&mut this, "u64be", 8, Endian::Big, false);
        transition { _ -> seed_f32(this) }
    }
    state seed_f32(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_float(&mut this, "f32", 4, Endian::Little);
        transition { _ -> seed_f32be(this) }
    }
    state seed_f32be(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_float(&mut this, "f32be", 4, Endian::Big);
        transition { _ -> seed_f64(this) }
    }
    state seed_f64(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_float(&mut this, "f64", 8, Endian::Little);
        transition { _ -> seed_f64be(this) }
    }
    state seed_f64be(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_float(&mut this, "f64be", 8, Endian::Big);
        transition { _ -> seed_string_utf8(this) }
    }
    state seed_string_utf8(this: &mut SymbolRegistry) {
        SymbolRegistry::seed_string(&mut this, "string_utf8", 1);
        transition { _ -> done(this) }
    }
    state done(this: &mut SymbolRegistry) {
    }
}

// `PrimitiveDataTypeBool::get_supported_anonymous_value_string_formats_bool`
// is [Bool, Binary, Decimal, Hexadecimal]; numerics drop the Bool head;
// strings carry String alone.
machine SymbolRegistry::seed_bool(this: &mut SymbolRegistry, data_type_id: &[u8], unit_size_in_bytes: u64) {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::new(
        data_type_id, data_type_id, unit_size_in_bytes,
        AnonymousValueStringFormat::Bool, Endian::Little, false, false);
    _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Bool);
    _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Binary);
    _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Decimal);
    _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Hexadecimal);
    SymbolRegistry::store_builtin_type(&mut this, &descriptor);
}

machine SymbolRegistry::seed_numeric(this: &mut SymbolRegistry, data_type_id: &[u8], unit_size_in_bytes: u64, endian: Endian, is_signed: bool) {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::new(
        data_type_id, data_type_id, unit_size_in_bytes,
        AnonymousValueStringFormat::Decimal, endian, false, is_signed);
    _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Binary);
    _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Decimal);
    _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Hexadecimal);
    SymbolRegistry::store_builtin_type(&mut this, &descriptor);
}

machine SymbolRegistry::seed_float(this: &mut SymbolRegistry, data_type_id: &[u8], unit_size_in_bytes: u64, endian: Endian) {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::new(
        data_type_id, data_type_id, unit_size_in_bytes,
        AnonymousValueStringFormat::Decimal, endian, true, true);
    _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Binary);
    _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Decimal);
    _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::Hexadecimal);
    SymbolRegistry::store_builtin_type(&mut this, &descriptor);
}

machine SymbolRegistry::seed_string(this: &mut SymbolRegistry, data_type_id: &[u8], unit_size_in_bytes: u64) {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::new(
        data_type_id, data_type_id, unit_size_in_bytes,
        AnonymousValueStringFormat::String, Endian::Little, false, false);
    _ = DataTypeDescriptor::add_supported_format(&mut descriptor, AnonymousValueStringFormat::String);
    SymbolRegistry::store_builtin_type(&mut this, &descriptor);
}

// The shared tail of every seed: descriptor into the descriptor table,
// then the anonymous single-field struct under the same id. Seeds cannot
// collide or overflow (21 < 128), so the bound arms are unreachable.
machine SymbolRegistry::store_builtin_type(this: &mut SymbolRegistry, descriptor: &DataTypeDescriptor) {
    transition this.data_type_descriptor_count < 128 {
        true -> descriptor_slot(this, descriptor, this.data_type_descriptor_count)
        false -> done(this)
    }
    state descriptor_slot(this: &mut SymbolRegistry, descriptor: &DataTypeDescriptor, position: u64)
        requires position < 128
    {
        DataTypeDescriptor::clone_from(&mut this.data_type_descriptors[position], descriptor);
        this.data_type_descriptor_count = position + 1;
        let data_type_id: &[u8] = DataTypeDescriptor::get_data_type_id(&descriptor);
        transition {
            _ -> struct_seed(this, data_type_id)
        }
    }
    state struct_seed(this: &mut SymbolRegistry, data_type_id: &[u8]) {
        _ = SymbolRegistry::insert_anonymous_data_type_struct(&mut this, data_type_id);
        transition {
            _ -> done(this)
        }
    }
    state done(this: &mut SymbolRegistry) {
    }
}

// Upstream `create_anonymous_data_type_symbolic_struct`: an anonymous
// (empty-namespace) struct of one field — `SymbolicFieldDefinition::new(
// DataTypeRef::new(data_type_id), ContainerType::None)`.
machine SymbolRegistry::insert_anonymous_data_type_struct(this: &mut SymbolRegistry, data_type_id: &[u8]) -> bool {
    let mut definition: SymbolicStructDefinition = SymbolicStructDefinition {
        symbol_namespace_len: 0,
        layout_kind: SymbolicLayoutKind::Struct,
        has_declared_size: false,
        declared_size_in_bytes: 0,
        field_count: 0,
    };
    let data_type_ref: DataTypeRef = DataTypeRef::new(data_type_id);
    let field: SymbolicFieldDefinition = SymbolicFieldDefinition::new_defined(
        "", &data_type_ref, ContainerType::None);
    _ = SymbolicStructDefinition::add_field(&mut definition, &field);
    let hoist42: bool = SymbolRegistry::insert_base_struct(&mut this, data_type_id, &definition);
    (hoist42)
}

// Upstream `HashMap::insert` replaces on exact key equality (the raw key,
// no trim); the bounded table refreshes the matching slot or appends,
// refusing only at the bound.
machine SymbolRegistry::insert_base_struct(this: &mut SymbolRegistry, struct_id: &[u8], definition: &SymbolicStructDefinition) -> bool {
    let existing: u64 = SymbolRegistry::find_base_struct_position_exact(&this, struct_id);
    transition existing == 18446744073709551615 {
        true -> append(this, struct_id, definition)
        false -> replace(this, existing, struct_id, definition)
    }
    state append(this: &mut SymbolRegistry, struct_id: &[u8], definition: &SymbolicStructDefinition) -> bool {
        transition this.symbolic_struct_count < 128 {
            true -> slot(this, struct_id, definition, this.symbolic_struct_count)
            false -> (false)
        }
    }
    state slot(this: &mut SymbolRegistry, struct_id: &[u8], definition: &SymbolicStructDefinition, position: u64) -> bool
        requires position < 128
    {
        this.symbolic_structs[position] = StructLayoutDescriptor::new(struct_id, definition);
        this.symbolic_struct_count = position + 1;
        (true)
    }
    state replace(this: &mut SymbolRegistry, position: u64, struct_id: &[u8], definition: &SymbolicStructDefinition) -> bool {
        transition position < 128 && position < this.symbolic_struct_count {
            true -> write(this, position, struct_id, definition)
            _ -> (false)
        }
    }
    state write(this: &mut SymbolRegistry, position: u64, struct_id: &[u8], definition: &SymbolicStructDefinition) -> bool
        requires position < 128 && position < this.symbolic_struct_count
    {
        this.symbolic_structs[position] = StructLayoutDescriptor::new(struct_id, definition);
        (true)
    }
}

machine SymbolRegistry::find_base_struct_position(this: &SymbolRegistry, struct_id: &[u8]) -> u64 {
    transition {
        _ -> scan(this, struct_id, 0)
    }
    state scan(this: &SymbolRegistry, struct_id: &[u8], position: u64) -> u64 {
        transition position < this.symbolic_struct_count && position < 128 {
            true -> probe(this, struct_id, position)
            false -> (18446744073709551615)
        }
    }
    state probe(this: &SymbolRegistry, struct_id: &[u8], position: u64) -> u64
        requires position < this.symbolic_struct_count && position < 128
    {
        let hoist1: bool = ids_equal(StructLayoutDescriptor::get_struct_layout_id(&this.symbolic_structs[position]), struct_id);
        transition hoist1 {
            true -> (position)
            false -> scan(this, struct_id, position + 1)
            _ -> scan(this, struct_id, position + 1)
        }
    }
}

// Exact-key variant of the base find — the probe is the raw insert key,
// matching `HashMap::insert`'s replacement rule (no trim).
machine SymbolRegistry::find_base_struct_position_exact(this: &SymbolRegistry, struct_id: &[u8]) -> u64 {
    transition {
        _ -> scan(this, struct_id, 0)
    }
    state scan(this: &SymbolRegistry, struct_id: &[u8], position: u64) -> u64 {
        transition position < this.symbolic_struct_count && position < 128 {
            true -> probe(this, struct_id, position)
            false -> (18446744073709551615)
        }
    }
    state probe(this: &SymbolRegistry, struct_id: &[u8], position: u64) -> u64
        requires position < this.symbolic_struct_count && position < 128
    {
        let descriptor_layout_id: &[u8] = StructLayoutDescriptor::get_struct_layout_id(&this.symbolic_structs[position]);
        let hoist2: bool = bytes_equal(descriptor_layout_id, struct_id);
        transition hoist2 {
            true -> (position)
            false -> scan(this, struct_id, position + 1)
            _ -> scan(this, struct_id, position + 1)
        }
    }
}

machine SymbolRegistry::find_project_struct_position(this: &SymbolRegistry, struct_id: &[u8]) -> u64 {
    transition {
        _ -> scan(this, struct_id, 0)
    }
    state scan(this: &SymbolRegistry, struct_id: &[u8], position: u64) -> u64 {
        transition position < this.project_symbolic_struct_count && position < 128 {
            true -> probe(this, struct_id, position)
            false -> (18446744073709551615)
        }
    }
    state probe(this: &SymbolRegistry, struct_id: &[u8], position: u64) -> u64
        requires position < this.project_symbolic_struct_count && position < 128
    {
        let hoist3: bool = ids_equal(StructLayoutDescriptor::get_struct_layout_id(&this.project_symbolic_structs[position]), struct_id);
        transition hoist3 {
            true -> (position)
            false -> scan(this, struct_id, position + 1)
            _ -> scan(this, struct_id, position + 1)
        }
    }
}

machine SymbolRegistry::find_data_type_descriptor_position(this: &SymbolRegistry, data_type_id: &[u8]) -> u64 {
    transition {
        _ -> scan(this, data_type_id, 0)
    }
    state scan(this: &SymbolRegistry, data_type_id: &[u8], position: u64) -> u64 {
        transition position < this.data_type_descriptor_count && position < 128 {
            true -> probe(this, data_type_id, position)
            false -> (18446744073709551615)
        }
    }
    state probe(this: &SymbolRegistry, data_type_id: &[u8], position: u64) -> u64
        requires position < this.data_type_descriptor_count && position < 128
    {
        let hoist4: bool = ids_equal(DataTypeDescriptor::get_data_type_id(this.data_type_descriptors[position]), data_type_id);
        transition hoist4 {
            true -> (position)
            false -> scan(this, data_type_id, position + 1)
            _ -> scan(this, data_type_id, position + 1)
        }
    }
}

// The membership surface of upstream's dropped `data_type_registry`: the
// builtin ids are the only registered data types a headless session can
// hold. Plugin-registered ids rejoin when the Plugins domain lands.
pub machine SymbolRegistry::is_registered_data_type(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
    let hoist43: bool = SymbolRegistry::is_builtin_data_type_id(&this, data_type_id);
    (hoist43)
}

// Upstream `built_in_data_type_ids` — the fixed key set seeded by
// `create_built_in_registries` (the dyn values it pairs with are the
// deferred residual documented on the record).
pub machine SymbolRegistry::is_builtin_data_type_id(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
    let hoist5: bool = ids_equal("bool8", data_type_id);
    transition hoist5 {
        true -> (true)
        _ -> check_bool32(this, data_type_id)
    }
    state check_bool32(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist6: bool = ids_equal("bool32", data_type_id);
        transition hoist6 {
            true -> (true)
            _ -> check_i8(this, data_type_id)
        }
    }
    state check_i8(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist7: bool = ids_equal("i8", data_type_id);
        transition hoist7 {
            true -> (true)
            _ -> check_i16(this, data_type_id)
        }
    }
    state check_i16(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist8: bool = ids_equal("i16", data_type_id);
        transition hoist8 {
            true -> (true)
            _ -> check_i16be(this, data_type_id)
        }
    }
    state check_i16be(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist9: bool = ids_equal("i16be", data_type_id);
        transition hoist9 {
            true -> (true)
            _ -> check_i32(this, data_type_id)
        }
    }
    state check_i32(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist10: bool = ids_equal("i32", data_type_id);
        transition hoist10 {
            true -> (true)
            _ -> check_i32be(this, data_type_id)
        }
    }
    state check_i32be(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist11: bool = ids_equal("i32be", data_type_id);
        transition hoist11 {
            true -> (true)
            _ -> check_i64(this, data_type_id)
        }
    }
    state check_i64(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist12: bool = ids_equal("i64", data_type_id);
        transition hoist12 {
            true -> (true)
            _ -> check_i64be(this, data_type_id)
        }
    }
    state check_i64be(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist13: bool = ids_equal("i64be", data_type_id);
        transition hoist13 {
            true -> (true)
            _ -> check_u8(this, data_type_id)
        }
    }
    state check_u8(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist14: bool = ids_equal("u8", data_type_id);
        transition hoist14 {
            true -> (true)
            _ -> check_u16(this, data_type_id)
        }
    }
    state check_u16(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist15: bool = ids_equal("u16", data_type_id);
        transition hoist15 {
            true -> (true)
            _ -> check_u16be(this, data_type_id)
        }
    }
    state check_u16be(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist16: bool = ids_equal("u16be", data_type_id);
        transition hoist16 {
            true -> (true)
            _ -> check_u32(this, data_type_id)
        }
    }
    state check_u32(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist17: bool = ids_equal("u32", data_type_id);
        transition hoist17 {
            true -> (true)
            _ -> check_u32be(this, data_type_id)
        }
    }
    state check_u32be(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist18: bool = ids_equal("u32be", data_type_id);
        transition hoist18 {
            true -> (true)
            _ -> check_u64(this, data_type_id)
        }
    }
    state check_u64(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist19: bool = ids_equal("u64", data_type_id);
        transition hoist19 {
            true -> (true)
            _ -> check_u64be(this, data_type_id)
        }
    }
    state check_u64be(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist20: bool = ids_equal("u64be", data_type_id);
        transition hoist20 {
            true -> (true)
            _ -> check_f32(this, data_type_id)
        }
    }
    state check_f32(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist21: bool = ids_equal("f32", data_type_id);
        transition hoist21 {
            true -> (true)
            _ -> check_f32be(this, data_type_id)
        }
    }
    state check_f32be(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist22: bool = ids_equal("f32be", data_type_id);
        transition hoist22 {
            true -> (true)
            _ -> check_f64(this, data_type_id)
        }
    }
    state check_f64(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist23: bool = ids_equal("f64", data_type_id);
        transition hoist23 {
            true -> (true)
            _ -> check_f64be(this, data_type_id)
        }
    }
    state check_f64be(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist24: bool = ids_equal("f64be", data_type_id);
        transition hoist24 {
            true -> (true)
            _ -> check_string_utf8(this, data_type_id)
        }
    }
    state check_string_utf8(this: &SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist25: bool = ids_equal("string_utf8", data_type_id);
        transition hoist25 {
            true -> (true)
            _ -> (false)
        }
    }
}

// Upstream `register_symbolic_struct`: refuse when the (trimmed) id names
// a registered data type, else insert/replace into the base map.
pub machine SymbolRegistry::register_symbolic_struct(this: &mut SymbolRegistry, symbolic_struct_id: &[u8], symbolic_struct_definition: &SymbolicStructDefinition) -> bool {
    let hoist26: bool = SymbolRegistry::is_registered_data_type(&this, symbolic_struct_id);
    transition hoist26 {
        true -> (false)
        _ -> insert(this, symbolic_struct_id, symbolic_struct_definition)
    }
    state insert(this: &mut SymbolRegistry, symbolic_struct_id: &[u8], symbolic_struct_definition: &SymbolicStructDefinition) -> bool {
        let hoist44: bool = SymbolRegistry::insert_base_struct(&mut this, symbolic_struct_id, symbolic_struct_definition);
        (hoist44)
    }
}

// Upstream `unregister_symbolic_struct`: same data-type guard, then
// `map.remove(trimmed).is_some()`. The table's swap-remove has no order —
// neither does the upstream map.
pub machine SymbolRegistry::unregister_symbolic_struct(this: &mut SymbolRegistry, symbolic_struct_id: &[u8]) -> bool {
    let hoist27: bool = SymbolRegistry::is_registered_data_type(&this, symbolic_struct_id);
    transition hoist27 {
        true -> (false)
        _ -> lookup(this, symbolic_struct_id)
    }
    state lookup(this: &mut SymbolRegistry, symbolic_struct_id: &[u8]) -> bool {
        let position: u64 = SymbolRegistry::find_base_struct_position(&this, symbolic_struct_id);
        transition position == 18446744073709551615 {
            true -> (false)
            _ -> remove(this, position)
        }
    }
    state remove(this: &mut SymbolRegistry, position: u64) -> bool {
        transition position < this.symbolic_struct_count && position < 128 {
            true -> swap(this, position)
            _ -> (false)
        }
    }
    state swap(this: &mut SymbolRegistry, position: u64) -> bool
        requires position < this.symbolic_struct_count && position < 128
    {
        transition 0 < this.symbolic_struct_count {
            true -> choose(this, position)
            _ -> (false)
        }
    }
    state choose(this: &mut SymbolRegistry, position: u64) -> bool
        requires position < this.symbolic_struct_count && position < 128 && 0 < this.symbolic_struct_count
    {
        transition position + 1 < this.symbolic_struct_count {
            true -> move_last(this, position)
            false -> shorten(this)
        }
    }
    // Swap-remove: the last live slot's content moves into `position`,
    // then the count drops — content-equivalent to upstream's map remove.
    state move_last(this: &mut SymbolRegistry, position: u64) -> bool
        requires position < this.symbolic_struct_count && position < 128 && 0 < this.symbolic_struct_count
    {
        let last: u64 = this.symbolic_struct_count - 1;
        transition last < 128 {
            true -> apply(this, position, last)
            _ -> (false)
        }
    }
    state apply(this: &mut SymbolRegistry, position: u64, last: u64) -> bool
        requires position < 128 && last < 128
    {
        let mut held: StructLayoutDescriptor = StructLayoutDescriptor::default();
        StructLayoutDescriptor::clone_from(&mut held, &this.symbolic_structs[last]);
        StructLayoutDescriptor::clone_from(&mut this.symbolic_structs[position], &held);
        this.symbolic_struct_count = last;
        (true)
    }
    state shorten(this: &mut SymbolRegistry) -> bool {
        transition 0 < this.symbolic_struct_count {
            true -> apply_shorten(this)
            _ -> (true)
        }
    }
    state apply_shorten(this: &mut SymbolRegistry) -> bool
        requires 0 < this.symbolic_struct_count
    {
        this.symbolic_struct_count = this.symbolic_struct_count - 1;
        (true)
    }
}

// Upstream `register_data_type_descriptor`: refuse when the (trimmed) id
// names a registered data type, else insert the descriptor plus an
// anonymous struct under the same id.
pub machine SymbolRegistry::register_data_type_descriptor(this: &mut SymbolRegistry, data_type_descriptor: &DataTypeDescriptor) -> bool {
    let hoist28: bool = SymbolRegistry::is_registered_data_type(&this, DataTypeDescriptor::get_data_type_id(data_type_descriptor));
    transition hoist28 {
        true -> (false)
        _ -> lookup(this, data_type_descriptor)
    }
    state lookup(this: &mut SymbolRegistry, data_type_descriptor: &DataTypeDescriptor) -> bool {
        transition this.data_type_descriptor_count < 128 {
            true -> store(this, data_type_descriptor, this.data_type_descriptor_count)
            false -> (false)
        }
    }
    state store(this: &mut SymbolRegistry, data_type_descriptor: &DataTypeDescriptor, position: u64) -> bool
        requires position < 128
    {
        DataTypeDescriptor::clone_from(&mut this.data_type_descriptors[position], data_type_descriptor);
        this.data_type_descriptor_count = position + 1;
        let hoist45: bool = SymbolRegistry::insert_anonymous_data_type_struct(&mut this, DataTypeDescriptor::get_data_type_id(data_type_descriptor));
        (hoist45)
    }
}

// Upstream `unregister_data_type_descriptor`: refuse when the (trimmed)
// id names a registered data type, else remove the descriptor and the
// anonymous struct it rode in on. Upstream's swap semantics: the map has
// no order; the table's swap-remove is the same content.
pub machine SymbolRegistry::unregister_data_type_descriptor(this: &mut SymbolRegistry, data_type_id: &[u8]) -> bool {
    let hoist29: bool = SymbolRegistry::is_registered_data_type(&this, data_type_id);
    transition hoist29 {
        true -> (false)
        _ -> lookup(this, data_type_id)
    }
    state lookup(this: &mut SymbolRegistry, data_type_id: &[u8]) -> bool {
        let position: u64 = SymbolRegistry::find_data_type_descriptor_position(&this, data_type_id);
        transition position == 18446744073709551615 {
            true -> (false)
            _ -> remove(this, position, data_type_id)
        }
    }
    state remove(this: &mut SymbolRegistry, position: u64, data_type_id: &[u8]) -> bool {
        transition position < this.data_type_descriptor_count && position < 128 {
            true -> swap(this, position, data_type_id)
            _ -> (false)
        }
    }
    state swap(this: &mut SymbolRegistry, position: u64, data_type_id: &[u8]) -> bool
        requires position < this.data_type_descriptor_count && position < 128
    {
        transition 0 < this.data_type_descriptor_count {
            true -> choose(this, position, data_type_id)
            _ -> (false)
        }
    }
    state choose(this: &mut SymbolRegistry, position: u64, data_type_id: &[u8]) -> bool
        requires position < this.data_type_descriptor_count && position < 128 && 0 < this.data_type_descriptor_count
    {
        transition position + 1 < this.data_type_descriptor_count {
            true -> move_last(this, position, data_type_id)
            false -> shorten(this, data_type_id)
        }
    }
    state move_last(this: &mut SymbolRegistry, position: u64, data_type_id: &[u8]) -> bool
        requires position < this.data_type_descriptor_count && position < 128 && 0 < this.data_type_descriptor_count
    {
        let last: u64 = this.data_type_descriptor_count - 1;
        transition last < 128 {
            true -> apply(this, position, last, data_type_id)
            _ -> (false)
        }
    }
    state apply(this: &mut SymbolRegistry, position: u64, last: u64, data_type_id: &[u8]) -> bool
        requires position < 128 && last < 128
    {
        let mut held: DataTypeDescriptor = DataTypeDescriptor::default();
        DataTypeDescriptor::clone_from(&mut held, &this.data_type_descriptors[last]);
        DataTypeDescriptor::clone_from(&mut this.data_type_descriptors[position], &held);
        this.data_type_descriptor_count = last;
        let hoist46: bool = SymbolRegistry::unregister_symbolic_struct(&mut this, data_type_id);
        (hoist46)
    }
    state shorten(this: &mut SymbolRegistry, data_type_id: &[u8]) -> bool {
        let hoist47: bool = SymbolRegistry::unregister_symbolic_struct(&mut this, data_type_id);
        transition 0 < this.data_type_descriptor_count {
            true -> apply_shorten(this, data_type_id)
            _ -> (hoist47)
        }
    }
    state apply_shorten(this: &mut SymbolRegistry, data_type_id: &[u8]) -> bool
        requires 0 < this.data_type_descriptor_count
    {
        this.data_type_descriptor_count = this.data_type_descriptor_count - 1;
        let hoist48: bool = SymbolRegistry::unregister_symbolic_struct(&mut this, data_type_id);
        (hoist48)
    }
}

// Upstream `get` — base map first, then project (the lookup side keeps
// upstream's read order; only the merged enumeration is project-wins).
// The `parse_inline_symbolic_struct_definition` fallback is a named
// residual (it needs the definition's `from_str`).
pub machine SymbolRegistry::get_symbolic_struct_definition(this: &SymbolRegistry, symbolic_struct_id: &[u8], out: &mut SymbolicStructDefinition) -> bool {
    let base_position: u64 = SymbolRegistry::find_base_struct_position(&this, symbolic_struct_id);
    transition base_position == 18446744073709551615 {
        true -> project(this, symbolic_struct_id, out)
        false -> base(this, base_position, out)
    }
    state base(this: &SymbolRegistry, position: u64, out: &mut SymbolicStructDefinition) -> bool {
        transition position < 128 && position < this.symbolic_struct_count {
            true -> read_base(this, position, out)
            _ -> (false)
        }
    }
    state read_base(this: &SymbolRegistry, position: u64, out: &mut SymbolicStructDefinition) -> bool
        requires position < 128 && position < this.symbolic_struct_count
    {
        SymbolicStructDefinition::clone_from(&mut out, StructLayoutDescriptor::get_struct_layout_definition(this.symbolic_structs[position]));
        (true)
    }
    state project(this: &SymbolRegistry, symbolic_struct_id: &[u8], out: &mut SymbolicStructDefinition) -> bool {
        let project_position: u64 = SymbolRegistry::find_project_struct_position(&this, symbolic_struct_id);
        transition project_position == 18446744073709551615 {
            true -> (false)
            _ -> found(this, project_position, out)
        }
    }
    state found(this: &SymbolRegistry, position: u64, out: &mut SymbolicStructDefinition) -> bool {
        transition position < 128 && position < this.project_symbolic_struct_count {
            true -> read_project(this, position, out)
            _ -> (false)
        }
    }
    state read_project(this: &SymbolRegistry, position: u64, out: &mut SymbolicStructDefinition) -> bool
        requires position < 128 && position < this.project_symbolic_struct_count
    {
        SymbolicStructDefinition::clone_from(&mut out, StructLayoutDescriptor::get_struct_layout_definition(this.project_symbolic_structs[position]));
        (true)
    }
}

// Upstream `set_project_symbol_catalog`: build the next project map from
// the catalog's struct-layout descriptors, skipping empty ids and ids
// colliding with the data-type registry or a base symbolic struct, then
// replace wholesale. The port counts the accepted descriptors first so a
// bound overflow refuses without mutating (upstream's unbounded map
// cannot refuse — the only false arm upstream is the lock failure).
// Accepted ids store trimmed, matching upstream's `trim().to_string()`
// map keys.
pub machine SymbolRegistry::set_project_symbol_catalog(this: &mut SymbolRegistry, project_symbol_catalog: &ProjectSymbolCatalog) -> bool {
    let accepted: u64 = SymbolRegistry::count_accepted_project_descriptors(&this, project_symbol_catalog);
    transition accepted <= 128 {
        true -> replace(this, project_symbol_catalog)
        false -> (false)
    }
    state replace(this: &mut SymbolRegistry, project_symbol_catalog: &ProjectSymbolCatalog) -> bool {
        this.project_symbolic_struct_count = 0;
        transition {
            _ -> each(this, project_symbol_catalog, 0)
        }
    }
    state each(this: &mut SymbolRegistry, project_symbol_catalog: &ProjectSymbolCatalog, position: u64) -> bool {
        transition position < project_symbol_catalog.struct_layout_descriptor_count && position < 128 {
            true -> consider(this, project_symbol_catalog, position)
            false -> (true)
        }
    }
    state consider(this: &mut SymbolRegistry, project_symbol_catalog: &ProjectSymbolCatalog, position: u64) -> bool
        requires position < 128 && position < project_symbol_catalog.struct_layout_descriptor_count
    {
        let descriptor: &StructLayoutDescriptor = ProjectSymbolCatalog::get_struct_layout_descriptor(&project_symbol_catalog, position);
        let hoist30: bool = SymbolRegistry::accepts_project_descriptor(&this, StructLayoutDescriptor::get_struct_layout_id(&descriptor));
        transition hoist30 {
            true -> store(this, project_symbol_catalog, position)
            false -> each(this, project_symbol_catalog, position + 1)
            _ -> each(this, project_symbol_catalog, position + 1)
        }
    }
    state store(this: &mut SymbolRegistry, project_symbol_catalog: &ProjectSymbolCatalog, position: u64) -> bool
        requires position < 128 && position < project_symbol_catalog.struct_layout_descriptor_count
    {
        let descriptor: &StructLayoutDescriptor = ProjectSymbolCatalog::get_struct_layout_descriptor(&project_symbol_catalog, position);
        transition this.project_symbolic_struct_count < 128 {
            true -> slot(this, descriptor, this.project_symbolic_struct_count, position, project_symbol_catalog)
            false -> (false)
        }
    }
    state slot(this: &mut SymbolRegistry, descriptor: &StructLayoutDescriptor, target: u64, position: u64, project_symbol_catalog: &ProjectSymbolCatalog) -> bool
        requires target < 128 && position < 128
    {
        // Upstream keys the project map on the trimmed id — the stored
        // descriptor carries that trimmed window so later lookups/catalog
        // emission see the same id.
        let raw_id: &[u8] = StructLayoutDescriptor::get_struct_layout_id(&descriptor);
        let id_start: u64 = count_leading_whitespace(raw_id);
        let id_end: u64 = find_trim_end(raw_id, id_start);
        transition id_start <= id_end && id_end <= raw_id.len {
            true -> apply_trim(this, descriptor, target, raw_id, id_start, id_end, project_symbol_catalog, position)
            _ -> each(this, project_symbol_catalog, position + 1)
        }
    }
    state apply_trim(this: &mut SymbolRegistry, descriptor: &StructLayoutDescriptor, target: u64, raw_id: &[u8], id_start: u64, id_end: u64, project_symbol_catalog: &ProjectSymbolCatalog, position: u64) -> bool
        requires target < 128 && position < 128 && id_start <= id_end && id_end <= raw_id.len
    {
        StructLayoutDescriptor::clone_from(&mut this.project_symbolic_structs[target], descriptor);
        StructLayoutDescriptor::set_struct_layout_id(&mut this.project_symbolic_structs[target], &raw_id[id_start..id_end]);
        this.project_symbolic_struct_count = target + 1;
        transition {
            _ -> each(this, project_symbol_catalog, position + 1)
        }
    }
}

machine SymbolRegistry::count_accepted_project_descriptors(this: &SymbolRegistry, project_symbol_catalog: &ProjectSymbolCatalog) -> u64 {
    transition {
        _ -> each(this, project_symbol_catalog, 0, 0)
    }
    state each(this: &SymbolRegistry, project_symbol_catalog: &ProjectSymbolCatalog, position: u64, accepted: u64) -> u64
        requires accepted <= position
    {
        transition position < project_symbol_catalog.struct_layout_descriptor_count && position < 128 {
            true -> consider(this, project_symbol_catalog, position, accepted)
            false -> (accepted)
        }
    }
    state consider(this: &SymbolRegistry, project_symbol_catalog: &ProjectSymbolCatalog, position: u64, accepted: u64) -> u64
        requires position < 128 && position < project_symbol_catalog.struct_layout_descriptor_count && accepted <= position
    {
        let descriptor: &StructLayoutDescriptor = ProjectSymbolCatalog::get_struct_layout_descriptor(&project_symbol_catalog, position);
        let hoist31: bool = SymbolRegistry::accepts_project_descriptor(&this, StructLayoutDescriptor::get_struct_layout_id(&descriptor));
        transition hoist31 {
            true -> each(this, project_symbol_catalog, position + 1, accepted + 1)
            false -> each(this, project_symbol_catalog, position + 1, accepted)
            _ -> each(this, project_symbol_catalog, position + 1, accepted)
        }
    }
}

// The `set_project_symbol_catalog` filter, upstream order: drop ids empty
// after trim, then ids colliding with the data-type registry, then ids
// colliding with a base symbolic struct.
machine SymbolRegistry::accepts_project_descriptor(this: &SymbolRegistry, struct_id: &[u8]) -> bool {
    let hoist32: bool = is_empty_after_trim(struct_id);
    transition hoist32 {
        true -> (false)
        _ -> check_data_type(this, struct_id)
    }
    state check_data_type(this: &SymbolRegistry, struct_id: &[u8]) -> bool {
        let hoist33: bool = SymbolRegistry::is_registered_data_type(&this, struct_id);
        transition hoist33 {
            true -> (false)
            _ -> check_base(this, struct_id)
        }
    }
    state check_base(this: &SymbolRegistry, struct_id: &[u8]) -> bool {
        let hoist34: u64 = SymbolRegistry::find_base_struct_position(&this, struct_id);
        transition hoist34 == 18446744073709551615 {
            true -> (true)
            _ -> (false)
        }
    }
}

// Upstream `create_registry_catalog(generation)`: collect the descriptor
// table and the merged symbolic-struct view, each sorted by id. The
// merged view is upstream `get_registry` — base map extended by the
// project map, so project entries shadow base entries on exact key
// collision; the base pass here skips ids the project table shadows.
pub machine SymbolRegistry::create_registry_catalog(this: &SymbolRegistry, generation: u64) -> PrivilegedRegistryCatalog {
    let mut catalog: PrivilegedRegistryCatalog = PrivilegedRegistryCatalog::new(generation);
    transition {
        _ -> data_types(this, &mut catalog, 0)
    }
    state data_types(this: &SymbolRegistry, catalog: &mut PrivilegedRegistryCatalog, position: u64) -> PrivilegedRegistryCatalog {
        transition position < this.data_type_descriptor_count && position < 128 {
            true -> add_type(this, catalog, position)
            false -> structs(this, catalog, 0)
        }
    }
    state add_type(this: &SymbolRegistry, catalog: &mut PrivilegedRegistryCatalog, position: u64) -> PrivilegedRegistryCatalog
        requires position < 128 && position < this.data_type_descriptor_count
    {
        _ = PrivilegedRegistryCatalog::add_data_type_descriptor(&mut catalog, &this.data_type_descriptors[position]);
        transition {
            _ -> data_types(this, catalog, position + 1)
        }
    }
    state structs(this: &SymbolRegistry, catalog: &mut PrivilegedRegistryCatalog, position: u64) -> PrivilegedRegistryCatalog {
        transition position < this.symbolic_struct_count && position < 128 {
            true -> maybe_add_base(this, catalog, position)
            false -> projects(this, catalog, 0)
        }
    }
    state maybe_add_base(this: &SymbolRegistry, catalog: &mut PrivilegedRegistryCatalog, position: u64) -> PrivilegedRegistryCatalog
        requires position < 128 && position < this.symbolic_struct_count
    {
        let hoist35: bool = SymbolRegistry::is_shadowed_by_project(&this, StructLayoutDescriptor::get_struct_layout_id(&this.symbolic_structs[position]));
        transition hoist35 {
            true -> structs(this, catalog, position + 1)
            false -> add_base(this, catalog, position)
            _ -> structs(this, catalog, position + 1)
        }
    }
    state add_base(this: &SymbolRegistry, catalog: &mut PrivilegedRegistryCatalog, position: u64) -> PrivilegedRegistryCatalog
        requires position < 128 && position < this.symbolic_struct_count
    {
        _ = PrivilegedRegistryCatalog::add_struct_layout_descriptor(&mut catalog, &this.symbolic_structs[position]);
        transition {
            _ -> structs(this, catalog, position + 1)
        }
    }
    state projects(this: &SymbolRegistry, catalog: &mut PrivilegedRegistryCatalog, position: u64) -> PrivilegedRegistryCatalog {
        transition position < this.project_symbolic_struct_count && position < 128 {
            true -> add_project(this, catalog, position)
            false -> finish(this, catalog)
        }
    }
    state add_project(this: &SymbolRegistry, catalog: &mut PrivilegedRegistryCatalog, position: u64) -> PrivilegedRegistryCatalog
        requires position < 128 && position < this.project_symbolic_struct_count
    {
        _ = PrivilegedRegistryCatalog::add_struct_layout_descriptor(&mut catalog, &this.project_symbolic_structs[position]);
        transition {
            _ -> projects(this, catalog, position + 1)
        }
    }
    state finish(this: &SymbolRegistry, catalog: &mut PrivilegedRegistryCatalog) -> PrivilegedRegistryCatalog {
        PrivilegedRegistryCatalog::sort_data_type_descriptors(&mut catalog);
        PrivilegedRegistryCatalog::sort_struct_layout_descriptors(&mut catalog);
        let mut sorted: PrivilegedRegistryCatalog = PrivilegedRegistryCatalog::default();
        PrivilegedRegistryCatalog::clone_from(&mut sorted, catalog);
        transition {
            _ -> (sorted)
        }
    }
}

// Exact-key shadow check for the merged view (`HashMap::extend` compares
// keys exactly — no trim).
machine SymbolRegistry::is_shadowed_by_project(this: &SymbolRegistry, struct_id: &[u8]) -> bool {
    transition {
        _ -> scan(this, struct_id, 0)
    }
    state scan(this: &SymbolRegistry, struct_id: &[u8], position: u64) -> bool {
        transition position < this.project_symbolic_struct_count && position < 128 {
            true -> probe(this, struct_id, position)
            false -> (false)
        }
    }
    state probe(this: &SymbolRegistry, struct_id: &[u8], position: u64) -> bool
        requires position < 128 && position < this.project_symbolic_struct_count
    {
        let project_layout_id: &[u8] = StructLayoutDescriptor::get_struct_layout_id(&this.project_symbolic_structs[position]);
        let hoist36: bool = bytes_equal(project_layout_id, struct_id);
        transition hoist36 {
            true -> (true)
            false -> scan(this, struct_id, position + 1)
            _ -> scan(this, struct_id, position + 1)
        }
    }
}

// Upstream `apply_registry_catalog`: replace the project map with the
// catalog's struct-layout descriptors that do not collide with base ids,
// and replace the descriptor table with the catalog's. Both writes are
// wholesale; the 128-slot tables match the catalog's bounds, so the
// upstream infallibility holds.
pub machine SymbolRegistry::apply_registry_catalog(this: &mut SymbolRegistry, privileged_registry_catalog: &PrivilegedRegistryCatalog) {
    let accepted: u64 = SymbolRegistry::count_catalog_accepted_structs(&this, privileged_registry_catalog);
    transition {
        _ -> replace_projects(this, privileged_registry_catalog, 0)
    }
    state replace_projects(this: &mut SymbolRegistry, privileged_registry_catalog: &PrivilegedRegistryCatalog, position: u64) {
        transition position < privileged_registry_catalog.struct_layout_descriptor_count && position < 128 {
            true -> consider(this, privileged_registry_catalog, position)
            false -> descriptors(this, privileged_registry_catalog)
        }
    }
    state consider(this: &mut SymbolRegistry, privileged_registry_catalog: &PrivilegedRegistryCatalog, position: u64)
        requires position < 128 && position < privileged_registry_catalog.struct_layout_descriptor_count
    {
        let descriptor: &StructLayoutDescriptor = PrivilegedRegistryCatalog::get_struct_layout_descriptor(&privileged_registry_catalog, position);
        let hoist37: u64 = SymbolRegistry::find_base_struct_position(&this, StructLayoutDescriptor::get_struct_layout_id(&descriptor));
        transition hoist37 == 18446744073709551615 {
            true -> store(this, privileged_registry_catalog, position)
            _ -> replace_projects(this, privileged_registry_catalog, position + 1)
        }
    }
    state store(this: &mut SymbolRegistry, privileged_registry_catalog: &PrivilegedRegistryCatalog, position: u64)
        requires position < 128 && position < privileged_registry_catalog.struct_layout_descriptor_count
    {
        transition this.project_symbolic_struct_count < 128 {
            true -> slot(this, privileged_registry_catalog, position, this.project_symbolic_struct_count)
            false -> replace_projects(this, privileged_registry_catalog, position + 1)
        }
    }
    state slot(this: &mut SymbolRegistry, privileged_registry_catalog: &PrivilegedRegistryCatalog, position: u64, target: u64)
        requires target < 128 && position < 128 && position < privileged_registry_catalog.struct_layout_descriptor_count
    {
        StructLayoutDescriptor::clone_from(&mut this.project_symbolic_structs[target], PrivilegedRegistryCatalog::get_struct_layout_descriptor(&privileged_registry_catalog, position));
        this.project_symbolic_struct_count = target + 1;
        transition {
            _ -> replace_projects(this, privileged_registry_catalog, position + 1)
        }
    }
    state descriptors(this: &mut SymbolRegistry, privileged_registry_catalog: &PrivilegedRegistryCatalog) {
        this.data_type_descriptor_count = 0;
        transition {
            _ -> each_descriptor(this, privileged_registry_catalog, 0)
        }
    }
    state each_descriptor(this: &mut SymbolRegistry, privileged_registry_catalog: &PrivilegedRegistryCatalog, position: u64) {
        transition position < privileged_registry_catalog.data_type_descriptor_count && position < 128 {
            true -> store_descriptor(this, privileged_registry_catalog, position)
            false -> done(this)
        }
    }
    state store_descriptor(this: &mut SymbolRegistry, privileged_registry_catalog: &PrivilegedRegistryCatalog, position: u64)
        requires position < 128 && position < privileged_registry_catalog.data_type_descriptor_count
    {
        transition this.data_type_descriptor_count < 128 {
            true -> apply(this, privileged_registry_catalog, position, this.data_type_descriptor_count)
            false -> each_descriptor(this, privileged_registry_catalog, position + 1)
        }
    }
    state apply(this: &mut SymbolRegistry, privileged_registry_catalog: &PrivilegedRegistryCatalog, position: u64, target: u64)
        requires target < 128 && position < 128 && position < privileged_registry_catalog.data_type_descriptor_count
    {
        // Direct field read — `get_data_type_descriptor`'s requires
        // instantiates as `this.data_type_descriptor_count`, which collides
        // with this registry's own field and can't be proved; the enclosing
        // transition already bounds `position` by the same count.
        DataTypeDescriptor::clone_from(&mut this.data_type_descriptors[target], &privileged_registry_catalog.data_type_descriptors[position]);
        this.data_type_descriptor_count = target + 1;
        transition {
            _ -> each_descriptor(this, privileged_registry_catalog, position + 1)
        }
    }
    state done(this: &mut SymbolRegistry) {
    }
}

// Counts the catalog struct descriptors that survive the base-id filter —
// the pre-pass that keeps `apply_registry_catalog`'s project replace
// atomic over the bounded table.
machine SymbolRegistry::count_catalog_accepted_structs(this: &SymbolRegistry, privileged_registry_catalog: &PrivilegedRegistryCatalog) -> u64 {
    transition {
        _ -> each(this, privileged_registry_catalog, 0, 0)
    }
    state each(this: &SymbolRegistry, privileged_registry_catalog: &PrivilegedRegistryCatalog, position: u64, accepted: u64) -> u64
        requires accepted <= position
    {
        transition position < privileged_registry_catalog.struct_layout_descriptor_count && position < 128 {
            true -> consider(this, privileged_registry_catalog, position, accepted)
            false -> (accepted)
        }
    }
    state consider(this: &SymbolRegistry, privileged_registry_catalog: &PrivilegedRegistryCatalog, position: u64, accepted: u64) -> u64
        requires position < 128 && position < privileged_registry_catalog.struct_layout_descriptor_count && accepted <= position
    {
        let descriptor: &StructLayoutDescriptor = PrivilegedRegistryCatalog::get_struct_layout_descriptor(&privileged_registry_catalog, position);
        let hoist38: u64 = SymbolRegistry::find_base_struct_position(&this, StructLayoutDescriptor::get_struct_layout_id(&descriptor));
        transition hoist38 == 18446744073709551615 {
            true -> each(this, privileged_registry_catalog, position + 1, accepted + 1)
            _ -> each(this, privileged_registry_catalog, position + 1, accepted)
        }
    }
}

// Table sizes for the session-facing surface.
pub machine SymbolRegistry::get_symbolic_struct_count(this: &SymbolRegistry) -> u64 {
    (this.symbolic_struct_count)
}

pub machine SymbolRegistry::get_project_symbolic_struct_count(this: &SymbolRegistry) -> u64 {
    (this.project_symbolic_struct_count)
}

pub machine SymbolRegistry::get_data_type_descriptor_count(this: &SymbolRegistry) -> u64 {
    (this.data_type_descriptor_count)
}

// Upstream `.trim()` semantics on the probe side of a lookup: whitespace
// is the byte-domain subset of char::is_whitespace (9/10/11/12/13/32),
// same as the numeric parser's split predicate.
machine is_whitespace_byte(byte: u8) -> bool {
    (byte == 32 || byte == 9 || byte == 10 || byte == 11 || byte == 12 || byte == 13)
}

machine count_leading_whitespace(value: &[u8]) -> u64 {
    transition {
        _ -> scan(value, 0)
    }
    state scan(value: &[u8], position: u64) -> u64 {
        transition position < value.len {
            true -> probe(value, position)
            false -> (value.len)
        }
    }
    state probe(value: &[u8], position: u64) -> u64
        requires position < value.len
    {
        let hoist39: bool = is_whitespace_byte(value[position]);
        transition hoist39 {
            true -> scan(value, position + 1)
            _ -> (position)
        }
    }
}

// Forward-walker shape of upstream `end -= 1 while whitespace`: keeps the
// boundary one past the last non-whitespace byte in [start, len) — the
// result is identical and the slice probe stays on param indices.
machine find_trim_end(value: &[u8], start: u64) -> u64 {
    transition {
        _ -> scan(value, start, start)
    }
    state scan(value: &[u8], position: u64, last_end: u64) -> u64 {
        transition position < value.len {
            true -> probe(value, position, last_end)
            false -> (last_end)
        }
    }
    state probe(value: &[u8], position: u64, last_end: u64) -> u64
        requires position < value.len
    {
        let hoist40: bool = is_whitespace_byte(value[position]);
        transition hoist40 {
            true -> scan(value, position + 1, last_end)
            _ -> scan(value, position + 1, position + 1)
        }
    }
}

machine is_empty_after_trim(value: &[u8]) -> bool {
    let start: u64 = count_leading_whitespace(value);
    let end: u64 = find_trim_end(value, start);
    (end == start)
}

// The lookup equality used everywhere upstream writes `map.get(key.trim())`:
// stored ids compare raw; the probe compares its trimmed window.
machine ids_equal(stored: &[u8], key: &[u8]) -> bool {
    let key_start: u64 = count_leading_whitespace(key);
    let key_end: u64 = find_trim_end(key, key_start);
    transition {
        _ -> compare(stored, key, key_end, 0, key_start)
    }
    state compare(stored: &[u8], key: &[u8], key_end: u64, offset: u64, key_position: u64) -> bool {
        transition offset < stored.len && key_position < key_end && key_position < key.len {
            true -> step(stored, key, key_end, offset, key_position)
            false -> finish(stored, key_end, offset, key_position)
        }
    }
    state step(stored: &[u8], key: &[u8], key_end: u64, offset: u64, key_position: u64) -> bool
        requires offset < stored.len && key_position < key.len
    {
        transition stored[offset] == key[key_position] {
            true -> compare(stored, key, key_end, offset + 1, key_position + 1)
            _ -> (false)
        }
    }
    state finish(stored: &[u8], key_end: u64, offset: u64, key_position: u64) -> bool {
        (offset == stored.len && key_position == key_end)
    }
}

// Exact byte equality for the merged view's shadow rule — upstream map
// key equality trims nothing.
machine bytes_equal(left: &[u8], right: &[u8]) -> bool {
    transition (left.len == right.len) {
        true -> scan(left, right, 0)
        false -> (false)
    }
    state scan(left: &[u8], right: &[u8], position: u64) -> bool {
        transition (position < left.len && position < right.len) {
            true -> compare(left, right, position)
            false -> (true)
        }
    }
    state compare(left: &[u8], right: &[u8], position: u64) -> bool
        requires 0 <= position && position < left.len && position < right.len
    {
        transition (left[position] == right[position]) {
            true -> (scan(left, right, position + 1))
            false -> (false)
            _ -> (false)
        }
    }
}

// Upstream `find_data_type_descriptor` — probe the base descriptor table
// by id; out-param copy of the hit (Option<&> respelled as bool + out).
pub machine SymbolRegistry::find_data_type_descriptor(this: &SymbolRegistry, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor) -> bool {
    transition { _ -> probe(this, data_type_id, out_descriptor, 0) }
    state probe(this: &SymbolRegistry, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor, position: u64) -> bool {
        transition position < this.data_type_descriptor_count && position < 128 {
            true -> compare(this, data_type_id, out_descriptor, position)
            false -> (false)
        }
    }
    state compare(this: &SymbolRegistry, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor, position: u64) -> bool {
        transition position < 128 {
            true -> hit(this, data_type_id, out_descriptor, position)
            false -> (false)
        }
    }
    state hit(this: &SymbolRegistry, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor, position: u64) -> bool
        requires position < 128;
    {
        let hoist41: bool = ids_equal(DataTypeDescriptor::get_data_type_id(this.data_type_descriptors[position]), data_type_id);
        transition hoist41 {
            true -> fill(this, out_descriptor, position)
            false -> probe(this, data_type_id, out_descriptor, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state fill(this: &SymbolRegistry, out_descriptor: &mut DataTypeDescriptor, position: u64) -> bool
        requires position < 128;
    {
        DataTypeDescriptor::clone_from(&mut out_descriptor, &this.data_type_descriptors[position]);
        (true)
    }
}

// Upstream `get_registered_data_type_refs` — position-indexed access over
// the base table (caller materializes refs; matches the Vec iteration
// upstream callers perform without a second bounded list carrier).
pub machine SymbolRegistry::get_registered_data_type_descriptor_at(this: &SymbolRegistry, position: u64, out_descriptor: &mut DataTypeDescriptor) -> bool {
    transition position < this.data_type_descriptor_count && position < 128 {
        true -> at(this, position, out_descriptor)
        false -> (false)
    }
    state at(this: &SymbolRegistry, position: u64, out_descriptor: &mut DataTypeDescriptor) -> bool
        requires position < 128;
    {
        DataTypeDescriptor::clone_from(&mut out_descriptor, &this.data_type_descriptors[position]);
        (true)
    }
}
