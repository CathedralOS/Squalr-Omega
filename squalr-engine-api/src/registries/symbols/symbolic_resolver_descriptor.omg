module src::registries::symbols::symbolic_resolver_descriptor;

use src::structures::structs::symbolic_resolver_definition::SymbolicResolverDefinition;

// Port of registries/symbols/symbolic_resolver_descriptor.rs — a resolver
// id + its symbolic resolver definition.
pub data SymbolicResolverDescriptor {
    resolver_id: [u8; 256];
    resolver_id_len: u64;
    resolver_definition: SymbolicResolverDefinition;
}

pub machine SymbolicResolverDescriptor::default() -> SymbolicResolverDescriptor {
    (SymbolicResolverDescriptor {
        resolver_id_len: 0,
        resolver_definition: SymbolicResolverDefinition::default(),
    })
}

pub machine SymbolicResolverDescriptor::new(resolver_id: &[u8], resolver_definition: &SymbolicResolverDefinition) -> SymbolicResolverDescriptor {
    let mut descriptor: SymbolicResolverDescriptor = SymbolicResolverDescriptor::default();
    SymbolicResolverDescriptor::set_resolver_id(&mut descriptor, resolver_id);
    SymbolicResolverDefinition::clone_from(&mut descriptor.resolver_definition, resolver_definition);
    (descriptor)
}

pub machine SymbolicResolverDescriptor::get_resolver_id(this: &SymbolicResolverDescriptor) -> &[u8] {
    transition this.resolver_id_len <= 256 {
        true -> (&this.resolver_id[0..this.resolver_id_len])
        false -> (&this.resolver_id[0..256])
        _ -> (&this.resolver_id[0..256])
    }
}

pub machine SymbolicResolverDescriptor::set_resolver_id(this: &mut SymbolicResolverDescriptor, resolver_id: &[u8]) {
    this.resolver_id_len = 0;
    transition {
        _ -> copy(this, resolver_id, 0)
    }
    state copy(this: &mut SymbolicResolverDescriptor, resolver_id: &[u8], position: u64) {
        transition position < resolver_id.len && position < 256 {
            true -> store(this, resolver_id, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut SymbolicResolverDescriptor, resolver_id: &[u8], position: u64) {
        this.resolver_id[position] = resolver_id[position];
        transition {
            _ -> copy(this, resolver_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut SymbolicResolverDescriptor, count: u64) {
        this.resolver_id_len = count;
    }
}

pub machine SymbolicResolverDescriptor::get_resolver_definition(this: &SymbolicResolverDescriptor) -> &SymbolicResolverDefinition {
    (&this.resolver_definition)
}

pub machine SymbolicResolverDescriptor::clone_from(this: &mut SymbolicResolverDescriptor, source: &SymbolicResolverDescriptor) {
    SymbolicResolverDefinition::clone_from(&mut this.resolver_definition, &source.resolver_definition);
    transition {
        _ -> copy(this, source, 0)
    }
    state copy(this: &mut SymbolicResolverDescriptor, source: &SymbolicResolverDescriptor, position: u64) {
        transition position < source.resolver_id_len && position < 256 {
            true -> store(this, source, position)
            false -> finish(this, source)
        }
    }
    state store(this: &mut SymbolicResolverDescriptor, source: &SymbolicResolverDescriptor, position: u64) {
        this.resolver_id[position] = source.resolver_id[position];
        transition {
            _ -> copy(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut SymbolicResolverDescriptor, source: &SymbolicResolverDescriptor) {
        this.resolver_id_len = source.resolver_id_len;
    }
}

pub machine SymbolicResolverDescriptor::clone(source: &SymbolicResolverDescriptor) -> SymbolicResolverDescriptor {
    let mut cloned: SymbolicResolverDescriptor = SymbolicResolverDescriptor::default();
    SymbolicResolverDescriptor::clone_from(&mut cloned, source);
    (cloned)
}
