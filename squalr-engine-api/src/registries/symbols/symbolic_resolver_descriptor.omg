module src::registries::symbols::symbolic_resolver_descriptor;

use src::structures::structs::symbolic_resolver_definition::SymbolicResolverDefinition;

// Port of registries/symbols/symbolic_resolver_descriptor.rs — a resolver
// id + its symbolic resolver definition.
pub data SymbolicResolverDescriptor {
    resolver_id: [u8; 256];
    resolver_id_len: u64;
    resolver_definition: SymbolicResolverDefinition;
}

pub machine SymbolicResolverDescriptor::default() -> SymbolicResolverDescriptor {
    (SymbolicResolverDescriptor {
        resolver_id_len: 0,
        resolver_definition: SymbolicResolverDefinition::default(),
    })
}

pub machine SymbolicResolverDescriptor::new(resolver_id: &[u8], resolver_definition: &SymbolicResolverDefinition) -> SymbolicResolverDescriptor {
    let mut descriptor: SymbolicResolverDescriptor = SymbolicResolverDescriptor::default();
    descriptor.set_resolver_id(resolver_id);
    descriptor.resolver_definition.clone_from(resolver_definition);
    (descriptor)
}

pub machine SymbolicResolverDescriptor::get_resolver_id(&self) -> &[u8] {
    transition self.resolver_id_len <= 256 {
        true -> (&self.resolver_id[0..self.resolver_id_len])
        false -> (&self.resolver_id[0..256])
        _ -> (&self.resolver_id[0..256])
    }
}

pub machine SymbolicResolverDescriptor::set_resolver_id(&mut self, resolver_id: &[u8]) {
    self.resolver_id_len = 0;
    transition {
        _ -> copy(resolver_id, 0)
    }
    state copy(&mut self, resolver_id: &[u8], position: u64) {
        transition position < resolver_id.len && position < 256 {
            true -> store(resolver_id, position)
            false -> finish(position)
        }
    }
    state store(&mut self, resolver_id: &[u8], position: u64) {
        self.resolver_id[position] = resolver_id[position];
        transition {
            _ -> copy(resolver_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.resolver_id_len = count;
    }
}

pub machine SymbolicResolverDescriptor::get_resolver_definition(&self) -> &SymbolicResolverDefinition {
    (&self.resolver_definition)
}

pub machine SymbolicResolverDescriptor::clone_from(&mut self, source: &SymbolicResolverDescriptor) {
    self.resolver_definition.clone_from(&source.resolver_definition);
    transition {
        _ -> copy(source, 0)
    }
    state copy(&mut self, source: &SymbolicResolverDescriptor, position: u64) {
        transition position < source.resolver_id_len && position < 256 {
            true -> store(source, position)
            false -> finish(source)
        }
    }
    state store(&mut self, source: &SymbolicResolverDescriptor, position: u64) {
        self.resolver_id[position] = source.resolver_id[position];
        transition {
            _ -> copy(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, source: &SymbolicResolverDescriptor) {
        self.resolver_id_len = source.resolver_id_len;
    }
}
