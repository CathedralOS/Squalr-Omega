module src::registries::symbols::struct_layout_descriptor;

use src::structures::structs::symbolic_struct_definition::SymbolicLayoutKind;
use src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;

// Port of registries/symbols/struct_layout_descriptor.rs — a layout id +
// its symbolic struct definition.
pub data StructLayoutDescriptor {
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
    struct_layout_definition: SymbolicStructDefinition;
}

pub machine StructLayoutDescriptor::default() -> StructLayoutDescriptor {
    (StructLayoutDescriptor {
        struct_layout_id_len: 0,
        struct_layout_definition: (SymbolicStructDefinition {
            symbol_namespace_len: 0,
            layout_kind: SymbolicLayoutKind::default(),
            has_declared_size: false,
            declared_size_in_bytes: 0,
            field_count: 0,
        }),
    })
}

pub machine StructLayoutDescriptor::new(struct_layout_id: &[u8], struct_layout_definition: &SymbolicStructDefinition) -> StructLayoutDescriptor {
    let mut descriptor: StructLayoutDescriptor = StructLayoutDescriptor::default();
    StructLayoutDescriptor::set_struct_layout_id(&mut descriptor, struct_layout_id);
    SymbolicStructDefinition::clone_from(&mut descriptor.struct_layout_definition, struct_layout_definition);
    (descriptor)
}

pub machine StructLayoutDescriptor::get_struct_layout_id(this: &StructLayoutDescriptor) -> &[u8] {
    transition this.struct_layout_id_len <= 256 {
        true -> (&this.struct_layout_id[0..this.struct_layout_id_len])
        false -> (&this.struct_layout_id[0..256])
        _ -> (&this.struct_layout_id[0..256])
    }
}

pub machine StructLayoutDescriptor::set_struct_layout_id(this: &mut StructLayoutDescriptor, struct_layout_id: &[u8]) {
    this.struct_layout_id_len = 0;
    transition {
        _ -> copy(this, struct_layout_id, 0)
    }
    state copy(this: &mut StructLayoutDescriptor, struct_layout_id: &[u8], position: u64) {
        transition position < struct_layout_id.len && position < 256 {
            true -> store(this, struct_layout_id, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut StructLayoutDescriptor, struct_layout_id: &[u8], position: u64) {
        this.struct_layout_id[position] = struct_layout_id[position];
        transition {
            _ -> copy(this, struct_layout_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut StructLayoutDescriptor, count: u64) {
        this.struct_layout_id_len = count;
    }
}

pub machine StructLayoutDescriptor::get_struct_layout_definition(this: &StructLayoutDescriptor) -> &SymbolicStructDefinition {
    (&this.struct_layout_definition)
}

pub machine StructLayoutDescriptor::clone_from(this: &mut StructLayoutDescriptor, source: &StructLayoutDescriptor) {
    SymbolicStructDefinition::clone_from(&mut this.struct_layout_definition, &source.struct_layout_definition);
    transition {
        _ -> copy(this, source, 0)
    }
    state copy(this: &mut StructLayoutDescriptor, source: &StructLayoutDescriptor, position: u64) {
        transition position < source.struct_layout_id_len && position < 256 {
            true -> store(this, source, position)
            false -> finish(this, source)
        }
    }
    state store(this: &mut StructLayoutDescriptor, source: &StructLayoutDescriptor, position: u64) {
        this.struct_layout_id[position] = source.struct_layout_id[position];
        transition {
            _ -> copy(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut StructLayoutDescriptor, source: &StructLayoutDescriptor) {
        this.struct_layout_id_len = source.struct_layout_id_len;
    }
}

pub machine StructLayoutDescriptor::clone(source: &StructLayoutDescriptor) -> StructLayoutDescriptor {
    let mut cloned: StructLayoutDescriptor = StructLayoutDescriptor::default();
    StructLayoutDescriptor::clone_from(&mut cloned, source);
    (cloned)
}
