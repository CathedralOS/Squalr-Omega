module src::registries::symbols::struct_layout_descriptor;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::bounded_slice::bounded_slice;

use src::structures::structs::symbolic_struct_definition::SymbolicLayoutKind;
use src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;

// Port of registries/symbols/struct_layout_descriptor.rs — a layout id +
// its symbolic struct definition.
pub data StructLayoutDescriptor {
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
    struct_layout_definition: SymbolicStructDefinition;
}

pub machine StructLayoutDescriptor::default() -> StructLayoutDescriptor {
    (StructLayoutDescriptor {
        struct_layout_id_len: 0,
        struct_layout_definition: (SymbolicStructDefinition {
            symbol_namespace_len: 0,
            layout_kind: SymbolicLayoutKind::default(),
            has_declared_size: false,
            declared_size_in_bytes: 0,
            field_count: 0,
        }),
    })
}

pub machine StructLayoutDescriptor::new(struct_layout_id: &[u8], struct_layout_definition: &SymbolicStructDefinition) -> StructLayoutDescriptor {
    let mut descriptor: StructLayoutDescriptor = StructLayoutDescriptor::default();
    descriptor.set_struct_layout_id(struct_layout_id);
    descriptor.struct_layout_definition.clone_from(struct_layout_definition);
    (descriptor)
}

pub machine StructLayoutDescriptor::get_struct_layout_id(&self) -> &[u8] {
    bounded_slice(&self.struct_layout_id[0..256], self.struct_layout_id_len)
}

pub machine StructLayoutDescriptor::set_struct_layout_id(&mut self, struct_layout_id: &[u8]) {
    self.struct_layout_id_len = BoundedByteCopy::copy(&mut self.struct_layout_id[0..256], struct_layout_id);
}

pub machine StructLayoutDescriptor::get_struct_layout_definition(&self) -> &SymbolicStructDefinition {
    (&self.struct_layout_definition)
}

pub machine StructLayoutDescriptor::clone_from(&mut self, source: &StructLayoutDescriptor) {
    self.struct_layout_definition.clone_from(&source.struct_layout_definition);
    let struct_layout_id_view: &[u8] = bounded_slice(&source.struct_layout_id[0..256], source.struct_layout_id_len);
    let _: u64 = BoundedByteCopy::copy(&mut self.struct_layout_id[0..256], struct_layout_id_view);
    self.struct_layout_id_len = source.struct_layout_id_len;
}

pub machine StructLayoutDescriptor::clone(source: &StructLayoutDescriptor) -> StructLayoutDescriptor {
    let mut cloned: StructLayoutDescriptor = StructLayoutDescriptor::default();
    cloned.clone_from(source);
    (cloned)
}
