module src::registries::symbols::data_type_descriptor;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::bounded_slice::bounded_slice;

use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use src::structures::memory::endian::Endian;

// Port of registries/symbols/data_type_descriptor.rs — the registry's
// per-type descriptor. Upstream's Vec<AnonymousValueStringFormat> carries
// the honest bound of 8 (the format union's case count — the set of
// distinct formats cannot exceed it) with refusal past the bound.
// Deviation: upstream's `from_data_type(&dyn DataType)` construction is
// trait-object projection — it rides the data-type registry leg; the
// owned field-for-field `new` + `with_data_type_id` carry the same data.
pub data DataTypeDescriptor {
    data_type_id: [u8; 256];
    data_type_id_len: u64;
    icon_id: [u8; 256];
    icon_id_len: u64;
    unit_size_in_bytes: u64;
    supported_anonymous_value_string_formats: [AnonymousValueStringFormat; 8];
    supported_format_count: u64;
    default_anonymous_value_string_format: AnonymousValueStringFormat;
    endian: Endian;
    is_floating_point: bool;
    is_signed: bool;
}

pub machine DataTypeDescriptor::default() -> DataTypeDescriptor {
    (DataTypeDescriptor {
        data_type_id_len: 0,
        icon_id_len: 0,
        unit_size_in_bytes: 0,
        supported_format_count: 0,
        default_anonymous_value_string_format: AnonymousValueStringFormat::default(),
        endian: Endian::default(),
        is_floating_point: false,
        is_signed: false,
    })
}

pub machine DataTypeDescriptor::new(data_type_id: &[u8], icon_id: &[u8], unit_size_in_bytes: u64, default_anonymous_value_string_format: AnonymousValueStringFormat, endian: Endian, is_floating_point: bool, is_signed: bool) -> DataTypeDescriptor {
    let mut descriptor: DataTypeDescriptor = (DataTypeDescriptor {
        data_type_id_len: 0,
        icon_id_len: 0,
        unit_size_in_bytes: unit_size_in_bytes,
        supported_format_count: 0,
        default_anonymous_value_string_format: default_anonymous_value_string_format,
        endian: endian,
        is_floating_point: is_floating_point,
        is_signed: is_signed,
    });
    descriptor.set_data_type_id(data_type_id);
    descriptor.set_icon_id(icon_id);
    (descriptor)
}

// Upstream `with_data_type_id` — the same descriptor under a different id.
pub machine DataTypeDescriptor::with_data_type_id(&self, data_type_id: &[u8]) -> DataTypeDescriptor {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
    descriptor.clone_from(self);
    descriptor.set_data_type_id(data_type_id);
    (descriptor)
}

pub machine DataTypeDescriptor::get_data_type_id(&self) -> &[u8] {
    bounded_slice(&self.data_type_id[0..256], self.data_type_id_len)
}

pub machine DataTypeDescriptor::set_data_type_id(&mut self, data_type_id: &[u8]) {
    self.data_type_id_len = BoundedByteCopy::copy(&mut self.data_type_id[0..256], data_type_id);
}

pub machine DataTypeDescriptor::get_icon_id(&self) -> &[u8] {
    bounded_slice(&self.icon_id[0..256], self.icon_id_len)
}

pub machine DataTypeDescriptor::set_icon_id(&mut self, icon_id: &[u8]) {
    self.icon_id_len = BoundedByteCopy::copy(&mut self.icon_id[0..256], icon_id);
}

pub machine DataTypeDescriptor::get_unit_size_in_bytes(&self) -> u64 {
    (self.unit_size_in_bytes)
}

pub machine DataTypeDescriptor::get_supported_format_count(&self) -> u64 {
    (self.supported_format_count)
}

pub machine DataTypeDescriptor::get_supported_format(&self, position: u64) -> AnonymousValueStringFormat
    requires position < self.supported_format_count && position < 8
{
    (self.supported_anonymous_value_string_formats[position])
}

// Upstream's Vec push — order preserved, refusal past the bound.
pub machine DataTypeDescriptor::add_supported_format(&mut self, format: AnonymousValueStringFormat) -> bool {
    transition self.supported_format_count < 8 {
        true -> store(format)
        false -> (false)
    }
    state store(&mut self, format: AnonymousValueStringFormat) -> bool {
        self.supported_anonymous_value_string_formats[self.supported_format_count] = format;
        self.supported_format_count = ((self.supported_format_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine DataTypeDescriptor::get_default_anonymous_value_string_format(&self) -> AnonymousValueStringFormat {
    (self.default_anonymous_value_string_format)
}

pub machine DataTypeDescriptor::get_endian(&self) -> Endian {
    (self.endian)
}

pub machine DataTypeDescriptor::get_is_floating_point(&self) -> bool {
    (self.is_floating_point)
}

pub machine DataTypeDescriptor::get_is_signed(&self) -> bool {
    (self.is_signed)
}

pub machine DataTypeDescriptor::clone_from(&mut self, source: &DataTypeDescriptor) {
    self.unit_size_in_bytes = source.unit_size_in_bytes;
    self.supported_format_count = 0;
    self.default_anonymous_value_string_format = source.default_anonymous_value_string_format;
    self.endian = source.endian;
    self.is_floating_point = source.is_floating_point;
    self.is_signed = source.is_signed;
    let data_type_id_view: &[u8] = bounded_slice(&source.data_type_id[0..256], source.data_type_id_len);
    let mut copied: u64 = BoundedByteCopy::copy(&mut self.data_type_id[0..256], data_type_id_view);
    self.data_type_id_len = source.data_type_id_len;
    let icon_id_view: &[u8] = bounded_slice(&source.icon_id[0..256], source.icon_id_len);
    copied = BoundedByteCopy::copy(&mut self.icon_id[0..256], icon_id_view);
    self.icon_id_len = source.icon_id_len;
    transition {
        _ -> copy_formats(source, 0)
    }
    state copy_formats(&mut self, source: &DataTypeDescriptor, position: u64) {
        transition position < source.supported_format_count && position < 8 {
            true -> store_format(source, position)
            false -> finish_formats(source)
        }
    }
    state store_format(&mut self, source: &DataTypeDescriptor, position: u64)
        requires position < source.supported_format_count && position < 8
    {
        self.supported_anonymous_value_string_formats[position] = source.supported_anonymous_value_string_formats[position];
        transition {
            _ -> copy_formats(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_formats(&mut self, source: &DataTypeDescriptor) {
        self.supported_format_count = source.supported_format_count;
    }
}
