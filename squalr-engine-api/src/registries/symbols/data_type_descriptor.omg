module src::registries::symbols::data_type_descriptor;

use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use src::structures::memory::endian::Endian;

// Port of registries/symbols/data_type_descriptor.rs — the registry's
// per-type descriptor. Upstream's Vec<AnonymousValueStringFormat> carries
// the honest bound of 8 (the format union's case count — the set of
// distinct formats cannot exceed it) with refusal past the bound.
// Deviation: upstream's `from_data_type(&dyn DataType)` construction is
// trait-object projection — it rides the data-type registry leg; the
// owned field-for-field `new` + `with_data_type_id` carry the same data.
pub data DataTypeDescriptor {
    data_type_id: [u8; 256];
    data_type_id_len: u64;
    icon_id: [u8; 256];
    icon_id_len: u64;
    unit_size_in_bytes: u64;
    supported_anonymous_value_string_formats: [AnonymousValueStringFormat; 8];
    supported_format_count: u64;
    default_anonymous_value_string_format: AnonymousValueStringFormat;
    endian: Endian;
    is_floating_point: bool;
    is_signed: bool;
}

pub machine DataTypeDescriptor::default() -> DataTypeDescriptor {
    (DataTypeDescriptor {
        data_type_id_len: 0,
        icon_id_len: 0,
        unit_size_in_bytes: 0,
        supported_format_count: 0,
        default_anonymous_value_string_format: AnonymousValueStringFormat::default(),
        endian: Endian::default(),
        is_floating_point: false,
        is_signed: false,
    })
}

pub machine DataTypeDescriptor::new(data_type_id: &[u8], icon_id: &[u8], unit_size_in_bytes: u64, default_anonymous_value_string_format: AnonymousValueStringFormat, endian: Endian, is_floating_point: bool, is_signed: bool) -> DataTypeDescriptor {
    let mut descriptor: DataTypeDescriptor = (DataTypeDescriptor {
        data_type_id_len: 0,
        icon_id_len: 0,
        unit_size_in_bytes: unit_size_in_bytes,
        supported_format_count: 0,
        default_anonymous_value_string_format: default_anonymous_value_string_format,
        endian: endian,
        is_floating_point: is_floating_point,
        is_signed: is_signed,
    });
    DataTypeDescriptor::set_data_type_id(&mut descriptor, data_type_id);
    DataTypeDescriptor::set_icon_id(&mut descriptor, icon_id);
    (descriptor)
}

// Upstream `with_data_type_id` — the same descriptor under a different id.
pub machine DataTypeDescriptor::with_data_type_id(data_type_descriptor: &DataTypeDescriptor, data_type_id: &[u8]) -> DataTypeDescriptor {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
    DataTypeDescriptor::clone_from(&mut descriptor, data_type_descriptor);
    DataTypeDescriptor::set_data_type_id(&mut descriptor, data_type_id);
    (descriptor)
}

pub machine DataTypeDescriptor::get_data_type_id(data_type_descriptor: &DataTypeDescriptor) -> &[u8] {
    transition data_type_descriptor.data_type_id_len <= 256 {
        true -> (&data_type_descriptor.data_type_id[0..data_type_descriptor.data_type_id_len])
        false -> (&data_type_descriptor.data_type_id[0..256])
        _ -> (&data_type_descriptor.data_type_id[0..256])
    }
}

pub machine DataTypeDescriptor::set_data_type_id(data_type_descriptor: &mut DataTypeDescriptor, data_type_id: &[u8]) {
    data_type_descriptor.data_type_id_len = 0;
    transition {
        _ -> copy(data_type_descriptor, data_type_id, 0)
    }
    state copy(data_type_descriptor: &mut DataTypeDescriptor, data_type_id: &[u8], position: u64) {
        transition position < data_type_id.len && position < 256 {
            true -> store(data_type_descriptor, data_type_id, position)
            false -> finish(data_type_descriptor, position)
        }
    }
    state store(data_type_descriptor: &mut DataTypeDescriptor, data_type_id: &[u8], position: u64) {
        data_type_descriptor.data_type_id[position] = data_type_id[position];
        transition {
            _ -> copy(data_type_descriptor, data_type_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(data_type_descriptor: &mut DataTypeDescriptor, count: u64) {
        data_type_descriptor.data_type_id_len = count;
    }
}

pub machine DataTypeDescriptor::get_icon_id(data_type_descriptor: &DataTypeDescriptor) -> &[u8] {
    transition data_type_descriptor.icon_id_len <= 256 {
        true -> (&data_type_descriptor.icon_id[0..data_type_descriptor.icon_id_len])
        false -> (&data_type_descriptor.icon_id[0..256])
        _ -> (&data_type_descriptor.icon_id[0..256])
    }
}

pub machine DataTypeDescriptor::set_icon_id(data_type_descriptor: &mut DataTypeDescriptor, icon_id: &[u8]) {
    data_type_descriptor.icon_id_len = 0;
    transition {
        _ -> copy(data_type_descriptor, icon_id, 0)
    }
    state copy(data_type_descriptor: &mut DataTypeDescriptor, icon_id: &[u8], position: u64) {
        transition position < icon_id.len && position < 256 {
            true -> store(data_type_descriptor, icon_id, position)
            false -> finish(data_type_descriptor, position)
        }
    }
    state store(data_type_descriptor: &mut DataTypeDescriptor, icon_id: &[u8], position: u64) {
        data_type_descriptor.icon_id[position] = icon_id[position];
        transition {
            _ -> copy(data_type_descriptor, icon_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(data_type_descriptor: &mut DataTypeDescriptor, count: u64) {
        data_type_descriptor.icon_id_len = count;
    }
}

pub machine DataTypeDescriptor::get_unit_size_in_bytes(data_type_descriptor: &DataTypeDescriptor) -> u64 {
    (data_type_descriptor.unit_size_in_bytes)
}

pub machine DataTypeDescriptor::get_supported_format_count(data_type_descriptor: &DataTypeDescriptor) -> u64 {
    (data_type_descriptor.supported_format_count)
}

pub machine DataTypeDescriptor::get_supported_format(data_type_descriptor: &DataTypeDescriptor, position: u64) -> AnonymousValueStringFormat
    requires position < data_type_descriptor.supported_format_count && position < 8
{
    (data_type_descriptor.supported_anonymous_value_string_formats[position])
}

// Upstream's Vec push — order preserved, refusal past the bound.
pub machine DataTypeDescriptor::add_supported_format(data_type_descriptor: &mut DataTypeDescriptor, format: AnonymousValueStringFormat) -> bool {
    transition data_type_descriptor.supported_format_count < 8 {
        true -> store(data_type_descriptor, format)
        false -> (false)
    }
    state store(data_type_descriptor: &mut DataTypeDescriptor, format: AnonymousValueStringFormat) -> bool {
        data_type_descriptor.supported_anonymous_value_string_formats[data_type_descriptor.supported_format_count] = format;
        data_type_descriptor.supported_format_count = ((data_type_descriptor.supported_format_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine DataTypeDescriptor::get_default_anonymous_value_string_format(data_type_descriptor: &DataTypeDescriptor) -> AnonymousValueStringFormat {
    (data_type_descriptor.default_anonymous_value_string_format)
}

pub machine DataTypeDescriptor::get_endian(data_type_descriptor: &DataTypeDescriptor) -> Endian {
    (data_type_descriptor.endian)
}

pub machine DataTypeDescriptor::get_is_floating_point(data_type_descriptor: &DataTypeDescriptor) -> bool {
    (data_type_descriptor.is_floating_point)
}

pub machine DataTypeDescriptor::get_is_signed(data_type_descriptor: &DataTypeDescriptor) -> bool {
    (data_type_descriptor.is_signed)
}

pub machine DataTypeDescriptor::clone_from(data_type_descriptor: &mut DataTypeDescriptor, source: &DataTypeDescriptor) {
    data_type_descriptor.unit_size_in_bytes = source.unit_size_in_bytes;
    data_type_descriptor.supported_format_count = 0;
    data_type_descriptor.default_anonymous_value_string_format = source.default_anonymous_value_string_format;
    data_type_descriptor.endian = source.endian;
    data_type_descriptor.is_floating_point = source.is_floating_point;
    data_type_descriptor.is_signed = source.is_signed;
    transition {
        _ -> copy_id(data_type_descriptor, source, 0)
    }
    state copy_id(data_type_descriptor: &mut DataTypeDescriptor, source: &DataTypeDescriptor, position: u64) {
        transition position < source.data_type_id_len && position < 256 {
            true -> store_id(data_type_descriptor, source, position)
            false -> finish_id(data_type_descriptor, source)
        }
    }
    state store_id(data_type_descriptor: &mut DataTypeDescriptor, source: &DataTypeDescriptor, position: u64) {
        data_type_descriptor.data_type_id[position] = source.data_type_id[position];
        transition {
            _ -> copy_id(data_type_descriptor, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_id(data_type_descriptor: &mut DataTypeDescriptor, source: &DataTypeDescriptor) {
        data_type_descriptor.data_type_id_len = source.data_type_id_len;
        transition {
            _ -> copy_icon(data_type_descriptor, source, 0)
        }
    }
    state copy_icon(data_type_descriptor: &mut DataTypeDescriptor, source: &DataTypeDescriptor, position: u64) {
        transition position < source.icon_id_len && position < 256 {
            true -> store_icon(data_type_descriptor, source, position)
            false -> finish_icon(data_type_descriptor, source)
        }
    }
    state store_icon(data_type_descriptor: &mut DataTypeDescriptor, source: &DataTypeDescriptor, position: u64) {
        data_type_descriptor.icon_id[position] = source.icon_id[position];
        transition {
            _ -> copy_icon(data_type_descriptor, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_icon(data_type_descriptor: &mut DataTypeDescriptor, source: &DataTypeDescriptor) {
        data_type_descriptor.icon_id_len = source.icon_id_len;
        transition {
            _ -> copy_formats(data_type_descriptor, source, 0)
        }
    }
    state copy_formats(data_type_descriptor: &mut DataTypeDescriptor, source: &DataTypeDescriptor, position: u64) {
        transition position < source.supported_format_count && position < 8 {
            true -> store_format(data_type_descriptor, source, position)
            false -> finish_formats(data_type_descriptor, source)
        }
    }
    state store_format(data_type_descriptor: &mut DataTypeDescriptor, source: &DataTypeDescriptor, position: u64)
        requires position < source.supported_format_count && position < 8
    {
        data_type_descriptor.supported_anonymous_value_string_formats[position] = source.supported_anonymous_value_string_formats[position];
        transition {
            _ -> copy_formats(data_type_descriptor, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_formats(data_type_descriptor: &mut DataTypeDescriptor, source: &DataTypeDescriptor) {
        data_type_descriptor.supported_format_count = source.supported_format_count;
    }
}
