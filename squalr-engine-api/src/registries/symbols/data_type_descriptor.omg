module src::registries::symbols::data_type_descriptor;

use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use src::structures::memory::endian::Endian;

// Port of registries/symbols/data_type_descriptor.rs — the registry's
// per-type descriptor. Upstream's Vec<AnonymousValueStringFormat> carries
// the honest bound of 8 (the format union's case count — the set of
// distinct formats cannot exceed it) with refusal past the bound.
// Deviation: upstream's `from_data_type(&dyn DataType)` construction is
// trait-object projection — it rides the data-type registry leg; the
// owned field-for-field `new` + `with_data_type_id` carry the same data.
pub data DataTypeDescriptor {
    data_type_id: [u8; 256];
    data_type_id_len: u64;
    icon_id: [u8; 256];
    icon_id_len: u64;
    unit_size_in_bytes: u64;
    supported_anonymous_value_string_formats: [AnonymousValueStringFormat; 8];
    supported_format_count: u64;
    default_anonymous_value_string_format: AnonymousValueStringFormat;
    endian: Endian;
    is_floating_point: bool;
    is_signed: bool;
}

pub machine DataTypeDescriptor::default() -> DataTypeDescriptor {
    (DataTypeDescriptor {
        data_type_id_len: 0,
        icon_id_len: 0,
        unit_size_in_bytes: 0,
        supported_format_count: 0,
        default_anonymous_value_string_format: AnonymousValueStringFormat::default(),
        endian: Endian::default(),
        is_floating_point: false,
        is_signed: false,
    })
}

pub machine DataTypeDescriptor::new(data_type_id: &[u8], icon_id: &[u8], unit_size_in_bytes: u64, default_anonymous_value_string_format: AnonymousValueStringFormat, endian: Endian, is_floating_point: bool, is_signed: bool) -> DataTypeDescriptor {
    let mut descriptor: DataTypeDescriptor = (DataTypeDescriptor {
        data_type_id_len: 0,
        icon_id_len: 0,
        unit_size_in_bytes: unit_size_in_bytes,
        supported_format_count: 0,
        default_anonymous_value_string_format: default_anonymous_value_string_format,
        endian: endian,
        is_floating_point: is_floating_point,
        is_signed: is_signed,
    });
    DataTypeDescriptor::set_data_type_id(&mut descriptor, data_type_id);
    DataTypeDescriptor::set_icon_id(&mut descriptor, icon_id);
    (descriptor)
}

// Upstream `with_data_type_id` — the same descriptor under a different id.
pub machine DataTypeDescriptor::with_data_type_id(this: &DataTypeDescriptor, data_type_id: &[u8]) -> DataTypeDescriptor {
    let mut descriptor: DataTypeDescriptor = DataTypeDescriptor::default();
    DataTypeDescriptor::clone_from(&mut descriptor, this);
    DataTypeDescriptor::set_data_type_id(&mut descriptor, data_type_id);
    (descriptor)
}

pub machine DataTypeDescriptor::get_data_type_id(this: &DataTypeDescriptor) -> &[u8] {
    transition this.data_type_id_len <= 256 {
        true -> (&this.data_type_id[0..this.data_type_id_len])
        false -> (&this.data_type_id[0..256])
        _ -> (&this.data_type_id[0..256])
    }
}

pub machine DataTypeDescriptor::set_data_type_id(this: &mut DataTypeDescriptor, data_type_id: &[u8]) {
    this.data_type_id_len = 0;
    transition {
        _ -> copy(this, data_type_id, 0)
    }
    state copy(this: &mut DataTypeDescriptor, data_type_id: &[u8], position: u64) {
        transition position < data_type_id.len && position < 256 {
            true -> store(this, data_type_id, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut DataTypeDescriptor, data_type_id: &[u8], position: u64) {
        this.data_type_id[position] = data_type_id[position];
        transition {
            _ -> copy(this, data_type_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut DataTypeDescriptor, count: u64) {
        this.data_type_id_len = count;
    }
}

pub machine DataTypeDescriptor::get_icon_id(this: &DataTypeDescriptor) -> &[u8] {
    transition this.icon_id_len <= 256 {
        true -> (&this.icon_id[0..this.icon_id_len])
        false -> (&this.icon_id[0..256])
        _ -> (&this.icon_id[0..256])
    }
}

pub machine DataTypeDescriptor::set_icon_id(this: &mut DataTypeDescriptor, icon_id: &[u8]) {
    this.icon_id_len = 0;
    transition {
        _ -> copy(this, icon_id, 0)
    }
    state copy(this: &mut DataTypeDescriptor, icon_id: &[u8], position: u64) {
        transition position < icon_id.len && position < 256 {
            true -> store(this, icon_id, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut DataTypeDescriptor, icon_id: &[u8], position: u64) {
        this.icon_id[position] = icon_id[position];
        transition {
            _ -> copy(this, icon_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut DataTypeDescriptor, count: u64) {
        this.icon_id_len = count;
    }
}

pub machine DataTypeDescriptor::get_unit_size_in_bytes(this: &DataTypeDescriptor) -> u64 {
    (this.unit_size_in_bytes)
}

pub machine DataTypeDescriptor::get_supported_format_count(this: &DataTypeDescriptor) -> u64 {
    (this.supported_format_count)
}

pub machine DataTypeDescriptor::get_supported_format(this: &DataTypeDescriptor, position: u64) -> AnonymousValueStringFormat
    requires position < this.supported_format_count && position < 8
{
    (this.supported_anonymous_value_string_formats[position])
}

// Upstream's Vec push — order preserved, refusal past the bound.
pub machine DataTypeDescriptor::add_supported_format(this: &mut DataTypeDescriptor, format: AnonymousValueStringFormat) -> bool {
    transition this.supported_format_count < 8 {
        true -> store(this, format)
        false -> (false)
    }
    state store(this: &mut DataTypeDescriptor, format: AnonymousValueStringFormat) -> bool {
        this.supported_anonymous_value_string_formats[this.supported_format_count] = format;
        this.supported_format_count = ((this.supported_format_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine DataTypeDescriptor::get_default_anonymous_value_string_format(this: &DataTypeDescriptor) -> AnonymousValueStringFormat {
    (this.default_anonymous_value_string_format)
}

pub machine DataTypeDescriptor::get_endian(this: &DataTypeDescriptor) -> Endian {
    (this.endian)
}

pub machine DataTypeDescriptor::get_is_floating_point(this: &DataTypeDescriptor) -> bool {
    (this.is_floating_point)
}

pub machine DataTypeDescriptor::get_is_signed(this: &DataTypeDescriptor) -> bool {
    (this.is_signed)
}

pub machine DataTypeDescriptor::clone_from(this: &mut DataTypeDescriptor, source: &DataTypeDescriptor) {
    this.unit_size_in_bytes = source.unit_size_in_bytes;
    this.supported_format_count = 0;
    this.default_anonymous_value_string_format = source.default_anonymous_value_string_format;
    this.endian = source.endian;
    this.is_floating_point = source.is_floating_point;
    this.is_signed = source.is_signed;
    transition {
        _ -> copy_id(this, source, 0)
    }
    state copy_id(this: &mut DataTypeDescriptor, source: &DataTypeDescriptor, position: u64) {
        transition position < source.data_type_id_len && position < 256 {
            true -> store_id(this, source, position)
            false -> finish_id(this, source)
        }
    }
    state store_id(this: &mut DataTypeDescriptor, source: &DataTypeDescriptor, position: u64) {
        this.data_type_id[position] = source.data_type_id[position];
        transition {
            _ -> copy_id(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_id(this: &mut DataTypeDescriptor, source: &DataTypeDescriptor) {
        this.data_type_id_len = source.data_type_id_len;
        transition {
            _ -> copy_icon(this, source, 0)
        }
    }
    state copy_icon(this: &mut DataTypeDescriptor, source: &DataTypeDescriptor, position: u64) {
        transition position < source.icon_id_len && position < 256 {
            true -> store_icon(this, source, position)
            false -> finish_icon(this, source)
        }
    }
    state store_icon(this: &mut DataTypeDescriptor, source: &DataTypeDescriptor, position: u64) {
        this.icon_id[position] = source.icon_id[position];
        transition {
            _ -> copy_icon(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_icon(this: &mut DataTypeDescriptor, source: &DataTypeDescriptor) {
        this.icon_id_len = source.icon_id_len;
        transition {
            _ -> copy_formats(this, source, 0)
        }
    }
    state copy_formats(this: &mut DataTypeDescriptor, source: &DataTypeDescriptor, position: u64) {
        transition position < source.supported_format_count && position < 8 {
            true -> store_format(this, source, position)
            false -> finish_formats(this, source)
        }
    }
    state store_format(this: &mut DataTypeDescriptor, source: &DataTypeDescriptor, position: u64)
        requires position < source.supported_format_count && position < 8
    {
        this.supported_anonymous_value_string_formats[position] = source.supported_anonymous_value_string_formats[position];
        transition {
            _ -> copy_formats(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_formats(this: &mut DataTypeDescriptor, source: &DataTypeDescriptor) {
        this.supported_format_count = source.supported_format_count;
    }
}
