module src::registries::symbols::privileged_registry_catalog;

use src::registries::symbols::data_type_descriptor::DataTypeDescriptor;
use src::registries::symbols::struct_layout_descriptor::StructLayoutDescriptor;

// Port of registries/symbols/privileged_registry_catalog.rs — the
// generation-stamped descriptor bundle the privileged registry publishes.
// Upstream's unbounded Vecs carry honest bounds (128 descriptors each)
// with refusal past the bound.
pub data PrivilegedRegistryCatalog {
    generation: u64;
    data_type_descriptors: [DataTypeDescriptor; 128];
    data_type_descriptor_count: u64;
    struct_layout_descriptors: [StructLayoutDescriptor; 128];
    struct_layout_descriptor_count: u64;
}

pub machine PrivilegedRegistryCatalog::default() -> PrivilegedRegistryCatalog {
    (PrivilegedRegistryCatalog {
        generation: 0,
        data_type_descriptor_count: 0,
        struct_layout_descriptor_count: 0,
    })
}

pub machine PrivilegedRegistryCatalog::new(generation: u64) -> PrivilegedRegistryCatalog {
    (PrivilegedRegistryCatalog {
        generation: generation,
        data_type_descriptor_count: 0,
        struct_layout_descriptor_count: 0,
    })
}

pub machine PrivilegedRegistryCatalog::get_generation(this: &PrivilegedRegistryCatalog) -> u64 {
    (this.generation)
}

pub machine PrivilegedRegistryCatalog::set_generation(this: &mut PrivilegedRegistryCatalog, generation: u64) {
    this.generation = generation;
}

pub machine PrivilegedRegistryCatalog::get_data_type_descriptor_count(this: &PrivilegedRegistryCatalog) -> u64 {
    (this.data_type_descriptor_count)
}

pub machine PrivilegedRegistryCatalog::get_data_type_descriptor(this: &PrivilegedRegistryCatalog, position: u64) -> &DataTypeDescriptor
    requires position < this.data_type_descriptor_count && position < 128
{
    (&this.data_type_descriptors[position])
}

pub machine PrivilegedRegistryCatalog::add_data_type_descriptor(this: &mut PrivilegedRegistryCatalog, descriptor: &DataTypeDescriptor) -> bool {
    transition this.data_type_descriptor_count < 128 {
        true -> store(this, descriptor)
        false -> (false)
    }
    state store(this: &mut PrivilegedRegistryCatalog, descriptor: &DataTypeDescriptor) -> bool {
        DataTypeDescriptor::clone_from(&mut this.data_type_descriptors[this.data_type_descriptor_count], descriptor);
        this.data_type_descriptor_count = ((this.data_type_descriptor_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine PrivilegedRegistryCatalog::get_struct_layout_descriptor_count(this: &PrivilegedRegistryCatalog) -> u64 {
    (this.struct_layout_descriptor_count)
}

pub machine PrivilegedRegistryCatalog::get_struct_layout_descriptor(this: &PrivilegedRegistryCatalog, position: u64) -> &StructLayoutDescriptor
    requires position < this.struct_layout_descriptor_count && position < 128
{
    (&this.struct_layout_descriptors[position])
}

pub machine PrivilegedRegistryCatalog::add_struct_layout_descriptor(this: &mut PrivilegedRegistryCatalog, descriptor: &StructLayoutDescriptor) -> bool {
    transition this.struct_layout_descriptor_count < 128 {
        true -> store(this, descriptor)
        false -> (false)
    }
    state store(this: &mut PrivilegedRegistryCatalog, descriptor: &StructLayoutDescriptor) -> bool {
        StructLayoutDescriptor::clone_from(&mut this.struct_layout_descriptors[this.struct_layout_descriptor_count], descriptor);
        this.struct_layout_descriptor_count = ((this.struct_layout_descriptor_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `create_registry_catalog` sorts each collected Vec by id before
// constructing the catalog; the port adds in collection order then orders
// the bounded tables in place — the emitted catalog is identically sorted.
// Insertion sort over byte-wise id order (Rust `str::cmp` for these ids is
// the same byte order).
// `clone_from` for callers holding a `&mut` to a catalog they must hand
// back by value (upstream's `#[derive(Clone)]`-style copy).
pub machine PrivilegedRegistryCatalog::clone_from(this: &mut PrivilegedRegistryCatalog, source: &PrivilegedRegistryCatalog) {
    this.generation = source.generation;
    this.data_type_descriptor_count = source.data_type_descriptor_count;
    this.struct_layout_descriptor_count = source.struct_layout_descriptor_count;
    transition {
        _ -> types(this, source, 0)
    }
    state types(this: &mut PrivilegedRegistryCatalog, source: &PrivilegedRegistryCatalog, position: u64) {
        transition position < source.data_type_descriptor_count && position < 128 {
            true -> copy_type(this, source, position)
            false -> structs(this, source, 0)
        }
    }
    state copy_type(this: &mut PrivilegedRegistryCatalog, source: &PrivilegedRegistryCatalog, position: u64)
        requires position < 128
    {
        DataTypeDescriptor::clone_from(&mut this.data_type_descriptors[position], &source.data_type_descriptors[position]);
        transition {
            _ -> types(this, source, position + 1)
        }
    }
    state structs(this: &mut PrivilegedRegistryCatalog, source: &PrivilegedRegistryCatalog, position: u64) {
        transition position < source.struct_layout_descriptor_count && position < 128 {
            true -> copy_struct(this, source, position)
            false -> done(this)
        }
    }
    state copy_struct(this: &mut PrivilegedRegistryCatalog, source: &PrivilegedRegistryCatalog, position: u64)
        requires position < 128
    {
        StructLayoutDescriptor::clone_from(&mut this.struct_layout_descriptors[position], &source.struct_layout_descriptors[position]);
        transition {
            _ -> structs(this, source, position + 1)
        }
    }
    state done(this: &mut PrivilegedRegistryCatalog) {
    }
}

pub machine PrivilegedRegistryCatalog::sort_data_type_descriptors(this: &mut PrivilegedRegistryCatalog) {
    transition {
        _ -> outer(this, 1)
    }
    state outer(this: &mut PrivilegedRegistryCatalog, position: u64) {
        transition position < this.data_type_descriptor_count && position < 128 {
            true -> walk(this, position, position)
            false -> done(this)
        }
    }
    state walk(this: &mut PrivilegedRegistryCatalog, position: u64, cursor: u64)
        requires position < 128 && cursor < 128
    {
        transition cursor > 0 {
            true -> probe(this, position, cursor)
            false -> outer(this, position + 1)
        }
    }
    state probe(this: &mut PrivilegedRegistryCatalog, position: u64, cursor: u64)
        requires position < 128 && 0 < cursor && cursor < 128
    {
        transition {
            _ -> compare(this, position, cursor, cursor - 1)
        }
    }
    state compare(this: &mut PrivilegedRegistryCatalog, position: u64, cursor: u64, prior: u64)
        requires position < 128 && cursor < 128 && prior < 128
    {
        let hoist1: bool = descriptor_id_less(DataTypeDescriptor::get_data_type_id(&this.data_type_descriptors[cursor]), DataTypeDescriptor::get_data_type_id(&this.data_type_descriptors[prior]));
        transition hoist1 {
            true -> swap_descriptors(this, position, cursor, prior)
            false -> outer(this, position + 1)
            _ -> outer(this, position + 1)
        }
    }
    state swap_descriptors(this: &mut PrivilegedRegistryCatalog, position: u64, cursor: u64, prior: u64)
        requires position < 128 && cursor < 128 && prior < 128
    {
        let mut prior_copy: DataTypeDescriptor = DataTypeDescriptor::default();
        DataTypeDescriptor::clone_from(&mut prior_copy, &this.data_type_descriptors[prior]);
        let mut cursor_copy: DataTypeDescriptor = DataTypeDescriptor::default();
        DataTypeDescriptor::clone_from(&mut cursor_copy, &this.data_type_descriptors[cursor]);
        DataTypeDescriptor::clone_from(&mut this.data_type_descriptors[cursor], &prior_copy);
        DataTypeDescriptor::clone_from(&mut this.data_type_descriptors[prior], &cursor_copy);
        transition {
            _ -> walk(this, position, prior)
        }
    }
    state done(this: &mut PrivilegedRegistryCatalog) {
    }
}

pub machine PrivilegedRegistryCatalog::sort_struct_layout_descriptors(this: &mut PrivilegedRegistryCatalog) {
    transition {
        _ -> outer(this, 1)
    }
    state outer(this: &mut PrivilegedRegistryCatalog, position: u64) {
        transition position < this.struct_layout_descriptor_count && position < 128 {
            true -> walk(this, position, position)
            false -> done(this)
        }
    }
    state walk(this: &mut PrivilegedRegistryCatalog, position: u64, cursor: u64)
        requires position < 128 && cursor < 128
    {
        transition cursor > 0 {
            true -> probe(this, position, cursor)
            false -> outer(this, position + 1)
        }
    }
    state probe(this: &mut PrivilegedRegistryCatalog, position: u64, cursor: u64)
        requires position < 128 && 0 < cursor && cursor < 128
    {
        transition {
            _ -> compare(this, position, cursor, cursor - 1)
        }
    }
    state compare(this: &mut PrivilegedRegistryCatalog, position: u64, cursor: u64, prior: u64)
        requires position < 128 && cursor < 128 && prior < 128
    {
        let hoist2: bool = descriptor_id_less(StructLayoutDescriptor::get_struct_layout_id(&this.struct_layout_descriptors[cursor]), StructLayoutDescriptor::get_struct_layout_id(&this.struct_layout_descriptors[prior]));
        transition hoist2 {
            true -> swap_descriptors(this, position, cursor, prior)
            false -> outer(this, position + 1)
            _ -> outer(this, position + 1)
        }
    }
    state swap_descriptors(this: &mut PrivilegedRegistryCatalog, position: u64, cursor: u64, prior: u64)
        requires position < 128 && cursor < 128 && prior < 128
    {
        let mut prior_copy: StructLayoutDescriptor = StructLayoutDescriptor::default();
        StructLayoutDescriptor::clone_from(&mut prior_copy, &this.struct_layout_descriptors[prior]);
        let mut cursor_copy: StructLayoutDescriptor = StructLayoutDescriptor::default();
        StructLayoutDescriptor::clone_from(&mut cursor_copy, &this.struct_layout_descriptors[cursor]);
        StructLayoutDescriptor::clone_from(&mut this.struct_layout_descriptors[cursor], &prior_copy);
        StructLayoutDescriptor::clone_from(&mut this.struct_layout_descriptors[prior], &cursor_copy);
        transition {
            _ -> walk(this, position, prior)
        }
    }
    state done(this: &mut PrivilegedRegistryCatalog) {
    }
}

// Byte-order less-than over id windows — `str::cmp` on ASCII ids is the
// same order.
machine descriptor_id_less(left: &[u8], right: &[u8]) -> bool {
    transition {
        _ -> scan(left, right, 0)
    }
    state scan(left: &[u8], right: &[u8], position: u64) -> bool {
        transition position < left.len && position < right.len {
            true -> probe(left, right, position)
            false -> (left.len < right.len)
        }
    }
    state probe(left: &[u8], right: &[u8], position: u64) -> bool
        requires position < left.len && position < right.len
    {
        transition left[position] < right[position] {
            true -> (true)
            false -> check_equal(left, right, position)
            _ -> check_equal(left, right, position)
        }
    }
    state check_equal(left: &[u8], right: &[u8], position: u64) -> bool
        requires position < left.len && position < right.len
    {
        transition left[position] == right[position] {
            true -> scan(left, right, position + 1)
            _ -> (false)
        }
    }
}

// Upstream `get_data_type_descriptors().iter().find` — probe the catalog's
// descriptor table by id; out-param copy on a hit.
pub machine PrivilegedRegistryCatalog::find_data_type_descriptor(this: &PrivilegedRegistryCatalog, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor) -> bool {
    transition { _ -> probe(this, data_type_id, out_descriptor, 0) }
    state probe(this: &PrivilegedRegistryCatalog, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor, position: u64) -> bool {
        transition position < this.data_type_descriptor_count && position < 128 {
            true -> compare(this, data_type_id, out_descriptor, position)
            false -> (false)
        }
    }
    state compare(this: &PrivilegedRegistryCatalog, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor, position: u64) -> bool {
        transition position < 128 {
            true -> hit(this, data_type_id, out_descriptor, position)
            false -> (false)
        }
    }
    state hit(this: &PrivilegedRegistryCatalog, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor, position: u64) -> bool
        requires position < 128;
    {
        let stored: &[u8] = DataTypeDescriptor::get_data_type_id(&this.data_type_descriptors[position]);
        let hoist3: bool = catalog_ids_equal(stored, data_type_id);
        transition hoist3 {
            true -> fill(this, out_descriptor, position)
            false -> probe(this, data_type_id, out_descriptor, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state fill(this: &PrivilegedRegistryCatalog, out_descriptor: &mut DataTypeDescriptor, position: u64) -> bool
        requires position < 128;
    {
        DataTypeDescriptor::clone_from(&mut out_descriptor, &this.data_type_descriptors[position]);
        (true)
    }
}

// Upstream `get_struct_layout_descriptors().iter().find` — same probe over
// the layout table by struct layout id.
pub machine PrivilegedRegistryCatalog::find_struct_layout_descriptor(this: &PrivilegedRegistryCatalog, symbolic_struct_id: &[u8], out_descriptor: &mut StructLayoutDescriptor) -> bool {
    transition { _ -> probe(this, symbolic_struct_id, out_descriptor, 0) }
    state probe(this: &PrivilegedRegistryCatalog, symbolic_struct_id: &[u8], out_descriptor: &mut StructLayoutDescriptor, position: u64) -> bool {
        transition position < this.struct_layout_descriptor_count && position < 128 {
            true -> compare(this, symbolic_struct_id, out_descriptor, position)
            false -> (false)
        }
    }
    state compare(this: &PrivilegedRegistryCatalog, symbolic_struct_id: &[u8], out_descriptor: &mut StructLayoutDescriptor, position: u64) -> bool {
        transition position < 128 {
            true -> hit(this, symbolic_struct_id, out_descriptor, position)
            false -> (false)
        }
    }
    state hit(this: &PrivilegedRegistryCatalog, symbolic_struct_id: &[u8], out_descriptor: &mut StructLayoutDescriptor, position: u64) -> bool
        requires position < 128;
    {
        let stored: &[u8] = StructLayoutDescriptor::get_struct_layout_id(&this.struct_layout_descriptors[position]);
        let hoist4: bool = catalog_ids_equal(stored, symbolic_struct_id);
        transition hoist4 {
            true -> fill(this, out_descriptor, position)
            false -> probe(this, symbolic_struct_id, out_descriptor, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state fill(this: &PrivilegedRegistryCatalog, out_descriptor: &mut StructLayoutDescriptor, position: u64) -> bool
        requires position < 128;
    {
        StructLayoutDescriptor::clone_from(&mut out_descriptor, &this.struct_layout_descriptors[position]);
        (true)
    }
}

machine catalog_ids_equal(stored: &[u8], key: &[u8]) -> bool {
    transition stored.len == key.len {
        true -> walk(stored, key, 0)
        false -> (false)
    }
    state walk(stored: &[u8], key: &[u8], position: u64) -> bool {
        transition position < stored.len && position < key.len {
            true -> compare(stored, key, position)
            false -> (true)
        }
    }
    state compare(stored: &[u8], key: &[u8], position: u64) -> bool
        requires position < stored.len && position < key.len
    {
        transition stored[position] != key[position] {
            true -> (false)
            false -> walk(stored, key, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}
