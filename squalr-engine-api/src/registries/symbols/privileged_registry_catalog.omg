module src::registries::symbols::privileged_registry_catalog;

use src::registries::symbols::data_type_descriptor::DataTypeDescriptor;
use src::registries::symbols::struct_layout_descriptor::StructLayoutDescriptor;
use src::structures::span_equality::spans_equal;

// Port of registries/symbols/privileged_registry_catalog.rs — the
// generation-stamped descriptor bundle the privileged registry publishes.
// Upstream's unbounded Vecs carry honest bounds (128 descriptors each)
// with refusal past the bound.
pub data PrivilegedRegistryCatalog {
    generation: u64;
    data_type_descriptors: [DataTypeDescriptor; 128];
    data_type_descriptor_count: u64;
    struct_layout_descriptors: [StructLayoutDescriptor; 128];
    struct_layout_descriptor_count: u64;
}

pub machine PrivilegedRegistryCatalog::default() -> PrivilegedRegistryCatalog {
    (PrivilegedRegistryCatalog {
        generation: 0,
        data_type_descriptor_count: 0,
        struct_layout_descriptor_count: 0,
    })
}

pub machine PrivilegedRegistryCatalog::new(generation: u64) -> PrivilegedRegistryCatalog {
    (PrivilegedRegistryCatalog {
        generation: generation,
        data_type_descriptor_count: 0,
        struct_layout_descriptor_count: 0,
    })
}

pub machine PrivilegedRegistryCatalog::get_generation(&self) -> u64 {
    (self.generation)
}

pub machine PrivilegedRegistryCatalog::set_generation(&mut self, generation: u64) {
    self.generation = generation;
}

pub machine PrivilegedRegistryCatalog::get_data_type_descriptor_count(&self) -> u64 {
    (self.data_type_descriptor_count)
}

pub machine PrivilegedRegistryCatalog::get_data_type_descriptor(&self, position: u64) -> &DataTypeDescriptor
    requires position < self.data_type_descriptor_count && position < 128
{
    (&self.data_type_descriptors[position])
}

pub machine PrivilegedRegistryCatalog::add_data_type_descriptor(&mut self, descriptor: &DataTypeDescriptor) -> bool {
    transition self.data_type_descriptor_count < 128 {
        true -> store(descriptor)
        false -> (false)
    }
    state store(&mut self, descriptor: &DataTypeDescriptor) -> bool {
        self.data_type_descriptors[self.data_type_descriptor_count].clone_from(descriptor);
        self.data_type_descriptor_count = ((self.data_type_descriptor_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

pub machine PrivilegedRegistryCatalog::get_struct_layout_descriptor_count(&self) -> u64 {
    (self.struct_layout_descriptor_count)
}

pub machine PrivilegedRegistryCatalog::get_struct_layout_descriptor(&self, position: u64) -> &StructLayoutDescriptor
    requires position < self.struct_layout_descriptor_count && position < 128
{
    (&self.struct_layout_descriptors[position])
}

pub machine PrivilegedRegistryCatalog::add_struct_layout_descriptor(&mut self, descriptor: &StructLayoutDescriptor) -> bool {
    transition self.struct_layout_descriptor_count < 128 {
        true -> store(descriptor)
        false -> (false)
    }
    state store(&mut self, descriptor: &StructLayoutDescriptor) -> bool {
        self.struct_layout_descriptors[self.struct_layout_descriptor_count].clone_from(descriptor);
        self.struct_layout_descriptor_count = ((self.struct_layout_descriptor_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        (true)
    }
}

// Upstream `create_registry_catalog` sorts each collected Vec by id before
// constructing the catalog; the port adds in collection order then orders
// the bounded tables in place — the emitted catalog is identically sorted.
// Insertion sort over byte-wise id order (Rust `str::cmp` for these ids is
// the same byte order).
// `clone_from` for callers holding a `&mut` to a catalog they must hand
// back by value (upstream's `#[derive(Clone)]`-style copy).
pub machine PrivilegedRegistryCatalog::clone_from(&mut self, source: &PrivilegedRegistryCatalog) {
    self.generation = source.generation;
    self.data_type_descriptor_count = source.data_type_descriptor_count;
    self.struct_layout_descriptor_count = source.struct_layout_descriptor_count;
    transition {
        _ -> types(source, 0)
    }
    state types(&mut self, source: &PrivilegedRegistryCatalog, position: u64) {
        transition position < source.data_type_descriptor_count && position < 128 {
            true -> copy_type(source, position)
            false -> structs(source, 0)
        }
    }
    state copy_type(&mut self, source: &PrivilegedRegistryCatalog, position: u64)
        requires position < 128
    {
        self.data_type_descriptors[position].clone_from(&source.data_type_descriptors[position]);
        transition {
            _ -> types(source, position + 1)
        }
    }
    state structs(&mut self, source: &PrivilegedRegistryCatalog, position: u64) {
        transition position < source.struct_layout_descriptor_count && position < 128 {
            true -> copy_struct(source, position)
            false -> done()
        }
    }
    state copy_struct(&mut self, source: &PrivilegedRegistryCatalog, position: u64)
        requires position < 128
    {
        self.struct_layout_descriptors[position].clone_from(&source.struct_layout_descriptors[position]);
        transition {
            _ -> structs(source, position + 1)
        }
    }
    state done(&mut self) {
    }
}

pub machine PrivilegedRegistryCatalog::sort_data_type_descriptors(&mut self) {
    transition {
        _ -> outer(1)
    }
    state outer(&mut self, position: u64) {
        transition position < self.data_type_descriptor_count && position < 128 {
            true -> walk(position, position)
            false -> done()
        }
    }
    state walk(&mut self, position: u64, cursor: u64)
        requires position < 128 && cursor < 128
    {
        transition cursor > 0 {
            true -> probe(position, cursor)
            false -> outer(position + 1)
        }
    }
    state probe(&mut self, position: u64, cursor: u64)
        requires position < 128 && 0 < cursor && cursor < 128
    {
        transition {
            _ -> compare(position, cursor, cursor - 1)
        }
    }
    state compare(&mut self, position: u64, cursor: u64, prior: u64)
        requires position < 128 && cursor < 128 && prior < 128
    {
        transition descriptor_id_less(self.data_type_descriptors[cursor].get_data_type_id(), self.data_type_descriptors[prior].get_data_type_id()) {
            true -> swap_descriptors(position, cursor, prior)
            false -> outer(position + 1)
            _ -> outer(position + 1)
        }
    }
    state swap_descriptors(&mut self, position: u64, cursor: u64, prior: u64)
        requires position < 128 && cursor < 128 && prior < 128
    {
        let mut prior_copy: DataTypeDescriptor = DataTypeDescriptor::default();
        prior_copy.clone_from(&self.data_type_descriptors[prior]);
        let mut cursor_copy: DataTypeDescriptor = DataTypeDescriptor::default();
        cursor_copy.clone_from(&self.data_type_descriptors[cursor]);
        self.data_type_descriptors[cursor].clone_from(&prior_copy);
        self.data_type_descriptors[prior].clone_from(&cursor_copy);
        transition {
            _ -> walk(position, prior)
        }
    }
    state done(&mut self) {
    }
}

pub machine PrivilegedRegistryCatalog::sort_struct_layout_descriptors(&mut self) {
    transition {
        _ -> outer(1)
    }
    state outer(&mut self, position: u64) {
        transition position < self.struct_layout_descriptor_count && position < 128 {
            true -> walk(position, position)
            false -> done()
        }
    }
    state walk(&mut self, position: u64, cursor: u64)
        requires position < 128 && cursor < 128
    {
        transition cursor > 0 {
            true -> probe(position, cursor)
            false -> outer(position + 1)
        }
    }
    state probe(&mut self, position: u64, cursor: u64)
        requires position < 128 && 0 < cursor && cursor < 128
    {
        transition {
            _ -> compare(position, cursor, cursor - 1)
        }
    }
    state compare(&mut self, position: u64, cursor: u64, prior: u64)
        requires position < 128 && cursor < 128 && prior < 128
    {
        transition descriptor_id_less(self.struct_layout_descriptors[cursor].get_struct_layout_id(), self.struct_layout_descriptors[prior].get_struct_layout_id()) {
            true -> swap_descriptors(position, cursor, prior)
            false -> outer(position + 1)
            _ -> outer(position + 1)
        }
    }
    state swap_descriptors(&mut self, position: u64, cursor: u64, prior: u64)
        requires position < 128 && cursor < 128 && prior < 128
    {
        let mut prior_copy: StructLayoutDescriptor = StructLayoutDescriptor::default();
        prior_copy.clone_from(&self.struct_layout_descriptors[prior]);
        let mut cursor_copy: StructLayoutDescriptor = StructLayoutDescriptor::default();
        cursor_copy.clone_from(&self.struct_layout_descriptors[cursor]);
        self.struct_layout_descriptors[cursor].clone_from(&prior_copy);
        self.struct_layout_descriptors[prior].clone_from(&cursor_copy);
        transition {
            _ -> walk(position, prior)
        }
    }
    state done(&mut self) {
    }
}

// Byte-order less-than over id windows — `str::cmp` on ASCII ids is the
// same order.
machine descriptor_id_less(left: &[u8], right: &[u8]) -> bool {
    transition {
        _ -> scan(left, right, 0)
    }
    state scan(left: &[u8], right: &[u8], position: u64) -> bool {
        transition position < left.len && position < right.len {
            true -> probe(left, right, position)
            false -> (left.len < right.len)
        }
    }
    state probe(left: &[u8], right: &[u8], position: u64) -> bool
        requires position < left.len && position < right.len
    {
        transition left[position] < right[position] {
            true -> (true)
            false -> check_equal(left, right, position)
            _ -> check_equal(left, right, position)
        }
    }
    state check_equal(left: &[u8], right: &[u8], position: u64) -> bool
        requires position < left.len && position < right.len
    {
        transition left[position] == right[position] {
            true -> scan(left, right, position + 1)
            _ -> (false)
        }
    }
}

// Upstream `get_data_type_descriptors().iter().find` — probe the catalog's
// descriptor table by id; out-param copy on a hit.
pub machine PrivilegedRegistryCatalog::find_data_type_descriptor(&self, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor) -> bool {
    transition { _ -> probe(data_type_id, out_descriptor, 0) }
    state probe(&self, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor, position: u64) -> bool {
        transition position < self.data_type_descriptor_count && position < 128 {
            true -> compare(data_type_id, out_descriptor, position)
            false -> (false)
        }
    }
    state compare(&self, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor, position: u64) -> bool {
        transition position < 128 {
            true -> hit(data_type_id, out_descriptor, position)
            false -> (false)
        }
    }
    state hit(&self, data_type_id: &[u8], out_descriptor: &mut DataTypeDescriptor, position: u64) -> bool
        requires position < 128;
    {
        let stored: &[u8] = self.data_type_descriptors[position].get_data_type_id();
        transition catalog_ids_equal(stored, data_type_id) {
            true -> fill(out_descriptor, position)
            false -> probe(data_type_id, out_descriptor, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state fill(&self, out_descriptor: &mut DataTypeDescriptor, position: u64) -> bool
        requires position < 128;
    {
        out_descriptor.clone_from(&self.data_type_descriptors[position]);
        (true)
    }
}

// Upstream `get_struct_layout_descriptors().iter().find` — same probe over
// the layout table by struct layout id.
pub machine PrivilegedRegistryCatalog::find_struct_layout_descriptor(&self, symbolic_struct_id: &[u8], out_descriptor: &mut StructLayoutDescriptor) -> bool {
    transition { _ -> probe(symbolic_struct_id, out_descriptor, 0) }
    state probe(&self, symbolic_struct_id: &[u8], out_descriptor: &mut StructLayoutDescriptor, position: u64) -> bool {
        transition position < self.struct_layout_descriptor_count && position < 128 {
            true -> compare(symbolic_struct_id, out_descriptor, position)
            false -> (false)
        }
    }
    state compare(&self, symbolic_struct_id: &[u8], out_descriptor: &mut StructLayoutDescriptor, position: u64) -> bool {
        transition position < 128 {
            true -> hit(symbolic_struct_id, out_descriptor, position)
            false -> (false)
        }
    }
    state hit(&self, symbolic_struct_id: &[u8], out_descriptor: &mut StructLayoutDescriptor, position: u64) -> bool
        requires position < 128;
    {
        let stored: &[u8] = self.struct_layout_descriptors[position].get_struct_layout_id();
        transition catalog_ids_equal(stored, symbolic_struct_id) {
            true -> fill(out_descriptor, position)
            false -> probe(symbolic_struct_id, out_descriptor, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state fill(&self, out_descriptor: &mut StructLayoutDescriptor, position: u64) -> bool
        requires position < 128;
    {
        out_descriptor.clone_from(&self.struct_layout_descriptors[position]);
        (true)
    }
}

machine catalog_ids_equal(stored: &[u8], key: &[u8]) -> bool {
    spans_equal(stored, key)
}
