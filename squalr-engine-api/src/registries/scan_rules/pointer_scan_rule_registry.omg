module src::registries::scan_rules::pointer_scan_rule_registry;

use src::structures::scanning::plans::pointer_scan::pointer_scan_execution_plan::PointerScanExecutionPlan;
use src::structures::scanning::rules::pointer_scan::built_in_planning_rules::rule_map_search_kernel::RuleMapSearchKernel;

// Port of registries/scan_rules/pointer_scan_rule_registry.rs: the registry
// of pointer-scan planning rules. Upstream stores
// HashMap<String, Arc<dyn PointerScanPlanningRule>> behind a `get_instance`
// singleton and callers iterate the map's values calling `rule.map_plan`
// on each fresh execution plan. Trait-object iteration cannot be spelled in
// Omega, so the built-in insertion order (`RuleMapSearchKernel` is the only
// built-in rule) is applied by `map_pointer_scan_execution_plan` — the same
// mapping sequence the loop performs.
pub data PointerScanRuleRegistry {}

pub machine PointerScanRuleRegistry::new() -> PointerScanRuleRegistry {
    PointerScanRuleRegistry {}
}

// Upstream `get_instance`: the singleton is stateless, so construction per
// call is equivalent.
pub machine PointerScanRuleRegistry::get_instance() -> PointerScanRuleRegistry {
    PointerScanRuleRegistry::new()
}

// Upstream `get_pointer_scan_planning_rule_registry().iter()` +
// `rule.map_plan(&mut plan)` folded into the built-in order.
pub machine PointerScanRuleRegistry::map_pointer_scan_execution_plan(
    &self,
    pointer_scan_execution_plan: &mut PointerScanExecutionPlan
) {
    let rule_map_search_kernel: RuleMapSearchKernel = RuleMapSearchKernel {};
    rule_map_search_kernel.map_plan(pointer_scan_execution_plan);
}
