module src::registries::scan_rules::element_scan_rule_registry;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use src::structures::scanning::constraints::scan_constraint::ScanConstraint;
use src::structures::scanning::plans::element_scan::snapshot_filter_element_scan_plan::SnapshotFilterElementScanPlan;
use src::structures::scanning::rules::element_scan::built_in_filter_rules::rule_map_scan_type::RuleMapScanType;
use src::structures::scanning::rules::element_scan::built_in_parameter_rules::rule_map_to_primitive_type::RuleMapToPrimitiveType;
use src::structures::scanning::rules::element_scan::built_in_parameter_rules::rule_map_unsigned_greater_than_zero_to_not_equal::RuleMapUnsignedGreaterThanZeroToNotEqual;

pub data ElementScanRuleRegistry {}

// Port of registries/scan_rules/element_scan_rule_registry.rs. Upstream
// holds two singleton HashMap registries of trait objects; the built-in set
// is fixed at compile time (two parameter rules, one filter rule), so the
// registry collapses to the two apply entry points — same traversal order,
// same rule list. `get_instance` has no Omega analog needed yet; the rules
// are stateless.
//
// Upstream `dispatch_scan` iterates the parameters-rule registry over the
// scan constraints before finalization, then iterates the filter-rule
// registry per (filter, finalized constraint) pair.
pub machine ElementScanRuleRegistry::apply_parameters_rules<'a>(
    scan_constraints: &mut [ScanConstraint<'a>],
    u8_id: &'a [u8],
    u16be_id: &'a [u8],
    u32be_id: &'a [u8],
    u64be_id: &'a [u8]
) {
    RuleMapToPrimitiveType::map_parameters(scan_constraints, u8_id, u16be_id, u32be_id, u64be_id);
    RuleMapUnsignedGreaterThanZeroToNotEqual::map_parameters(scan_constraints);
}

// Upstream's `get_scan_filter_rule_registry().iter()` fold — one built-in
// rule today.
pub machine ElementScanRuleRegistry::apply_filter_rules(
    scan_compare_type: ScanCompareType,
    has_current_values: bool,
    has_previous_values: bool,
    region_size: u64,
    data_type_size_bytes: u64,
    is_floating_point: bool,
    prefer_type_scanner: bool,
    memory_alignment_size: u64,
    periodicity: u64,
    has_mask: bool,
    plan: &mut SnapshotFilterElementScanPlan
) {
    RuleMapScanType::map_parameters(
        scan_compare_type,
        has_current_values,
        has_previous_values,
        region_size,
        data_type_size_bytes,
        is_floating_point,
        prefer_type_scanner,
        memory_alignment_size,
        periodicity,
        has_mask,
        plan
    );
}
