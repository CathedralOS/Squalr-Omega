module src::engine::engine_event_envelope;

use src::events::engine_event::EngineEvent;
use src::events::logging::log_level::LogLevel;

// Port of engine/engine_event_envelope.rs — the per-event generation stamp
// upstream attaches so listeners can detect a stale privileged registry
// catalog. `{ registry_generation: u64, engine_event: EngineEvent }`.
//
// Deviation: upstream wraps the event at EMIT time inside a RwLock-locked
// publish; port-side the queue carries raw EngineEvent values and the
// currency check happens at route time against the caller-supplied
// generation — the collapse is documented on EngineUnprivilegedState.
pub data EngineEventEnvelope {
    registry_generation: u64;
    engine_event: EngineEvent;
}

pub machine EngineEventEnvelope::default() -> EngineEventEnvelope {
    (EngineEventEnvelope {
        registry_generation: 0,
        engine_event: EngineEvent::default(),
    })
}

pub machine EngineEventEnvelope::new(registry_generation: u64, engine_event: EngineEvent) -> EngineEventEnvelope {
    (EngineEventEnvelope {
        registry_generation: registry_generation,
        engine_event: engine_event,
    })
}

pub machine EngineEventEnvelope::get_registry_generation(engine_event_envelope: &EngineEventEnvelope) -> u64 {
    engine_event_envelope.registry_generation
}

pub machine EngineEventEnvelope::get_engine_event(engine_event_envelope: &EngineEventEnvelope) -> &EngineEvent {
    (&engine_event_envelope.engine_event)
}

pub machine EngineEventEnvelope::clone(engine_event_envelope: &EngineEventEnvelope) -> EngineEventEnvelope {
    (EngineEventEnvelope {
        registry_generation: engine_event_envelope.registry_generation,
        engine_event: EngineEvent::clone(&engine_event_envelope.engine_event),
    })
}

pub machine EngineEventEnvelope::clone_from(engine_event_envelope: &mut EngineEventEnvelope, source: &EngineEventEnvelope) {
    engine_event_envelope.registry_generation = source.registry_generation;
    EngineEvent::clone_from(&mut engine_event_envelope.engine_event, &source.engine_event);
}

// Bounded queue of envelopes — the port-side carrier the unprivileged
// bindings surface hands to subscribers (upstream: crossbeam channel of
// envelopes; port: bounded insertion-order ring drained by route calls).
pub data EngineEventEnvelopeQueue {
    envelopes: [EngineEventEnvelope; 64];
    envelope_count: u64;
}

pub machine EngineEventEnvelopeQueue::default() -> EngineEventEnvelopeQueue {
    (EngineEventEnvelopeQueue {
        envelope_count: 0,
    })
}

pub machine EngineEventEnvelopeQueue::empty() -> EngineEventEnvelopeQueue {
    (EngineEventEnvelopeQueue::default())
}

pub machine EngineEventEnvelopeQueue::get_envelope_count(engine_event_envelope_queue: &EngineEventEnvelopeQueue) -> u64 {
    engine_event_envelope_queue.envelope_count
}

pub machine EngineEventEnvelopeQueue::get_envelope(engine_event_envelope_queue: &EngineEventEnvelopeQueue, position: u64) -> &EngineEventEnvelope {
    transition position < engine_event_envelope_queue.envelope_count && position < 64 {
        true -> at(engine_event_envelope_queue, position)
        false -> head(engine_event_envelope_queue)
        _ -> head(engine_event_envelope_queue)
    }
    state at(engine_event_envelope_queue: &EngineEventEnvelopeQueue, position: u64) -> &EngineEventEnvelope
        requires position < 64;
    {
        (&engine_event_envelope_queue.envelopes[position])
    }
    state head(engine_event_envelope_queue: &EngineEventEnvelopeQueue) -> &EngineEventEnvelope {
        (&engine_event_envelope_queue.envelopes[0])
    }
}

// Upstream `Sender::send` — appends; refuses past the bound (bounded-table
// discipline; a full queue drops the event, matching "lossy under
// backpressure" semantics upstream's try_send has at capacity).
pub machine EngineEventEnvelopeQueue::push(engine_event_envelope_queue: &mut EngineEventEnvelopeQueue, engine_event: &EngineEventEnvelope) -> bool {
    transition engine_event_envelope_queue.envelope_count < 64 {
        true -> store(engine_event_envelope_queue, engine_event)
        false -> (false)
        _ -> (false)
    }
    state store(engine_event_envelope_queue: &mut EngineEventEnvelopeQueue, engine_event: &EngineEventEnvelope) -> bool {
        let index: u64 = engine_event_envelope_queue.envelope_count;
        transition index < 64 {
            true -> write(engine_event_envelope_queue, engine_event, index)
            false -> (false)
            _ -> (false)
        }
    }
    state write(engine_event_envelope_queue: &mut EngineEventEnvelopeQueue, engine_event: &EngineEventEnvelope, index: u64) -> bool
        requires index < 64;
    {
        EngineEventEnvelope::clone_from(&mut engine_event_envelope_queue.envelopes[index], engine_event);
        engine_event_envelope_queue.envelope_count = index + 1;
        (true)
    }
}

pub machine EngineEventEnvelopeQueue::clear(engine_event_envelope_queue: &mut EngineEventEnvelopeQueue) {
    engine_event_envelope_queue.envelope_count = 0;
}
