module src::engine::engine_event_envelope;

use src::events::engine_event::EngineEvent;
use src::events::logging::log_level::LogLevel;

// Port of engine/engine_event_envelope.rs — the per-event generation stamp
// upstream attaches so listeners can detect a stale privileged registry
// catalog. `{ registry_generation: u64, engine_event: EngineEvent }`.
//
// Deviation: upstream wraps the event at EMIT time inside a RwLock-locked
// publish; port-side the queue carries raw EngineEvent values and the
// currency check happens at route time against the caller-supplied
// generation — the collapse is documented on EngineUnprivilegedState.
pub data EngineEventEnvelope {
    registry_generation: u64;
    engine_event: EngineEvent;
}

pub machine EngineEventEnvelope::default() -> EngineEventEnvelope {
    (EngineEventEnvelope {
        registry_generation: 0,
        engine_event: EngineEvent::default(),
    })
}

pub machine EngineEventEnvelope::new(registry_generation: u64, engine_event: EngineEvent) -> EngineEventEnvelope {
    (EngineEventEnvelope {
        registry_generation: registry_generation,
        engine_event: engine_event,
    })
}

pub machine EngineEventEnvelope::get_registry_generation(this: &EngineEventEnvelope) -> u64 {
    this.registry_generation
}

pub machine EngineEventEnvelope::get_engine_event(this: &EngineEventEnvelope) -> &EngineEvent {
    (&this.engine_event)
}

pub machine EngineEventEnvelope::clone(this: &EngineEventEnvelope) -> EngineEventEnvelope {
    let hoist1: EngineEvent = EngineEvent::clone(&this.engine_event);
    (EngineEventEnvelope {
        registry_generation: this.registry_generation,
        engine_event: hoist1,
    })
}

pub machine EngineEventEnvelope::clone_from(this: &mut EngineEventEnvelope, source: &EngineEventEnvelope) {
    this.registry_generation = source.registry_generation;
    EngineEvent::clone_from(&mut this.engine_event, &source.engine_event);
}

// Bounded queue of envelopes — the port-side carrier the unprivileged
// bindings surface hands to subscribers (upstream: crossbeam channel of
// envelopes; port: bounded insertion-order ring drained by route calls).
pub data EngineEventEnvelopeQueue {
    envelopes: [EngineEventEnvelope; 64];
    envelope_count: u64;
}

pub machine EngineEventEnvelopeQueue::default() -> EngineEventEnvelopeQueue {
    (EngineEventEnvelopeQueue {
        envelope_count: 0,
    })
}

pub machine EngineEventEnvelopeQueue::empty() -> EngineEventEnvelopeQueue {
    (EngineEventEnvelopeQueue::default())
}

pub machine EngineEventEnvelopeQueue::get_envelope_count(this: &EngineEventEnvelopeQueue) -> u64 {
    this.envelope_count
}

pub machine EngineEventEnvelopeQueue::get_envelope(this: &EngineEventEnvelopeQueue, position: u64) -> &EngineEventEnvelope {
    transition position < this.envelope_count && position < 64 {
        true -> at(this, position)
        false -> head(this)
        _ -> head(this)
    }
    state at(this: &EngineEventEnvelopeQueue, position: u64) -> &EngineEventEnvelope
        requires position < 64;
    {
        (&this.envelopes[position])
    }
    state head(this: &EngineEventEnvelopeQueue) -> &EngineEventEnvelope {
        (&this.envelopes[0])
    }
}

// Upstream `Sender::send` — appends; refuses past the bound (bounded-table
// discipline; a full queue drops the event, matching "lossy under
// backpressure" semantics upstream's try_send has at capacity).
pub machine EngineEventEnvelopeQueue::push(this: &mut EngineEventEnvelopeQueue, engine_event: &EngineEventEnvelope) -> bool {
    transition this.envelope_count < 64 {
        true -> store(this, engine_event)
        false -> (false)
        _ -> (false)
    }
    state store(this: &mut EngineEventEnvelopeQueue, engine_event: &EngineEventEnvelope) -> bool {
        let index: u64 = this.envelope_count;
        transition index < 64 {
            true -> write(this, engine_event, index)
            false -> (false)
            _ -> (false)
        }
    }
    state write(this: &mut EngineEventEnvelopeQueue, engine_event: &EngineEventEnvelope, index: u64) -> bool
        requires index < 64;
    {
        EngineEventEnvelope::clone_from(&mut this.envelopes[index], engine_event);
        this.envelope_count = index + 1;
        (true)
    }
}

pub machine EngineEventEnvelopeQueue::clear(this: &mut EngineEventEnvelopeQueue) {
    this.envelope_count = 0;
}
