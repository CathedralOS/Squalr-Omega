module src::engine::engine_api_unprivileged_bindings;

use omega::language::core::wait_wake;
use omega_language_std::filesystem_host;
use src::commands::privileged_command::PrivilegedCommand;
use src::commands::unprivileged_command::UnprivilegedCommand;
use src::engine::privileged_response_mailbox::PrivilegedResponseMailbox;
use src::engine::unprivileged_response_mailbox::UnprivilegedResponseMailbox;
use src::engine::engine_event_envelope::EngineEventEnvelopeQueue;

// Port of engine/engine_api_unprivileged_bindings.rs. Upstream is a dyn
// trait injected into EngineUnprivilegedState (`Arc<RwLock<dyn ...>>`)
// whose dispatch_unprivileged_command takes the execution context itself —
// a re-entrant callback shape with no port analog. Port-side: static
// `satisfies` conformance on the concrete bindings record; unprivileged
// execution happens INSIDE the session (executors take
// &mut EngineUnprivilegedState), so only the privileged hop and the event
// subscription remain on the trait.
pub trait EngineApiUnprivilegedBindings {
    // Upstream dispatch_privileged_command(command, callback) — the
    // callback respells as the caller-owned mailbox the composition root
    // writes into. Returns false on the EngineUnavailable route.
    machine dispatch_privileged_command(&mut self, command: &PrivilegedCommand, mailbox: &mut PrivilegedResponseMailbox) -> bool
    invokes WaitWake;
    invokes FilesystemHost;
    // Upstream subscribe_to_engine_events() -> Receiver<EngineEventEnvelope>
    // — the channel receiver respells as a bounded queue drained on demand.
    machine drain_engine_events(&mut self, out: &mut EngineEventEnvelopeQueue) -> bool;
}
