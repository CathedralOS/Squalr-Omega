use {omega}/language/core/filesystem_authority.omg;
use {omega}/language/core/wait_wake.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use src/commands/privileged_command.omg;
use src/commands/unprivileged_command.omg;
use src/engine/privileged_response_mailbox.omg;
use src/engine/unprivileged_response_mailbox.omg;
use src/engine/engine_event_envelope.omg;

// Port of engine/engine_api_unprivileged_bindings.rs. Upstream is a dyn
// trait injected into EngineUnprivilegedState (`Arc<RwLock<dyn ...>>`)
// whose dispatch_unprivileged_command takes the execution context itself —
// a re-entrant callback shape with no port analog. Port-side: static
// `satisfies` conformance on the concrete bindings record; unprivileged
// execution happens INSIDE the session (executors take
// &mut EngineUnprivilegedState), so only the privileged hop and the event
// subscription remain on the trait.
public trait EngineApiUnprivilegedBindings<Provider> {
    // Upstream dispatch_privileged_command(command, callback) — the
    // callback respells as the caller-owned mailbox the composition root
    // writes into. Returns false on the EngineUnavailable route.
    machine dispatch_privileged_command(provider: &mut Provider, command: &|privileged_command|::PrivilegedCommand, mailbox: &mut |privileged_response_mailbox|::PrivilegedResponseMailbox) -> bool
    reaches |wait_wake|::WaitWake + |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
    invokes |wait_wake|::WaitWake;
    invokes |posix_filesystem_host|::PosixFilesystemHost;
    // Upstream subscribe_to_engine_events() -> Receiver<EngineEventEnvelope>
    // — the channel receiver respells as a bounded queue drained on demand.
    machine drain_engine_events(provider: &mut Provider, out: &mut |engine_event_envelope|::EngineEventEnvelopeQueue) -> bool;
}
