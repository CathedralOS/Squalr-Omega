module src::engine::engine_execution_context;

use src::events::engine_event::EngineEvent;

// Port of engine/engine_execution_context.rs. Upstream is the dyn trait
// unprivileged commands execute against (13 members spanning plugin
// registry, project manager, symbol registry, symbol resolution, and
// event emission). Its members name session-package types
// (EngineUnprivilegedState's own fields), so the trait cannot spell its
// full upstream signature in this package — port-side the execution
// context is the concrete EngineUnprivilegedState itself, and the members
// below are the api-nameable surface shared by every consumer: event
// emission plus the project-symbol-catalog read the snapshot resolver
// needs. The full member list is enforced by the session type's public
// machines, not by this trait.
pub trait EngineExecutionContext {
    // Upstream emit_engine_event — routes the event through listener
    // dispatch and pending queues.
    machine emit_engine_event(receiver: &mut Self, engine_event: &EngineEvent) -> bool;
}
