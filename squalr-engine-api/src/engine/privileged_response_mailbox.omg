module src::engine::privileged_response_mailbox;

use src::commands::privileged_command_response::PrivilegedCommandResponse;

// Port-side callback carrier for upstream's Box<dyn Fn> dispatch callback —
// the composition root delivers the response whole into this mailbox and
// the caller drains it by value (no union clone machinery on the response
// types).
pub data PrivilegedResponseMailbox {
    case Empty;
    case Delivered(response: PrivilegedCommandResponse);
}

pub machine PrivilegedResponseMailbox::default() -> PrivilegedResponseMailbox {
    (PrivilegedResponseMailbox::Empty)
}

pub machine PrivilegedResponseMailbox::get_has_response(this: &PrivilegedResponseMailbox) -> bool {
    transition this {
        PrivilegedResponseMailbox::Delivered { response } -> (true)
        _ -> (false)
    }
}

// Upstream callback delivery — moves the response into the mailbox.
pub machine PrivilegedResponseMailbox::deliver(this: &mut PrivilegedResponseMailbox, response: PrivilegedCommandResponse) {
    this = PrivilegedResponseMailbox::Delivered { response: response };
}

// Upstream `callback(response)` consumption — drains the mailbox and
// hands the response back by value through the returned union.
pub machine PrivilegedResponseMailbox::take(this: &mut PrivilegedResponseMailbox) -> PrivilegedResponseMailbox {
    transition this {
        PrivilegedResponseMailbox::Delivered { response } -> take_response(this, response)
        _ -> (PrivilegedResponseMailbox::Empty)
    }
    state take_response(this: &mut PrivilegedResponseMailbox, response: PrivilegedCommandResponse) -> PrivilegedResponseMailbox {
        this = PrivilegedResponseMailbox::Empty;
        (PrivilegedResponseMailbox::Delivered { response: response })
    }
}

