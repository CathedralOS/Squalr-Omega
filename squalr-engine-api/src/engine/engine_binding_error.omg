module src::engine::engine_binding_error;

// Port of engine/engine_binding_error.rs. Upstream is a 3-case enum whose
// cases carry String payloads; port-side the case index rides as a copy
// enum beside shared bounded context/details buffers (unused context is
// empty on EngineUnavailable/LockFailure — mirrors upstream's absent field).
pub data EngineBindingErrorKind [copy] {
    case EngineUnavailable;
    case LockFailure;
    case OperationFailed;
}

pub data EngineBindingError {
    kind: EngineBindingErrorKind;
    context: [u8; 256];
    context_len: u64;
    details: [u8; 256];
    details_len: u64;
}

pub machine EngineBindingError::default() -> EngineBindingError {
    (EngineBindingError {
        kind: EngineBindingErrorKind::EngineUnavailable,
        context_len: 0,
        details_len: 0,
    })
}

pub machine EngineBindingError::engine_unavailable(details: &[u8]) -> EngineBindingError {
    let mut created: EngineBindingError = EngineBindingError {
        kind: EngineBindingErrorKind::EngineUnavailable,
        context_len: 0,
        details_len: 0,
    };
    EngineBindingError::set_details(&mut created, details);
    (created)
}

pub machine EngineBindingError::lock_failure(details: &[u8]) -> EngineBindingError {
    let mut created: EngineBindingError = EngineBindingError {
        kind: EngineBindingErrorKind::LockFailure,
        context_len: 0,
        details_len: 0,
    };
    EngineBindingError::set_details(&mut created, details);
    (created)
}

pub machine EngineBindingError::operation_failed(context: &[u8], details: &[u8]) -> EngineBindingError {
    let mut created: EngineBindingError = EngineBindingError {
        kind: EngineBindingErrorKind::OperationFailed,
        context_len: 0,
        details_len: 0,
    };
    EngineBindingError::set_context(&mut created, context);
    EngineBindingError::set_details(&mut created, details);
    (created)
}

pub machine EngineBindingError::get_kind(engine_binding_error: &EngineBindingError) -> EngineBindingErrorKind {
    engine_binding_error.kind
}

pub machine EngineBindingError::get_context(engine_binding_error: &EngineBindingError) -> &[u8] {
    transition engine_binding_error.context_len <= 256 {
        true -> (&engine_binding_error.context[0..engine_binding_error.context_len])
        false -> (&engine_binding_error.context[0..256])
        _ -> (&engine_binding_error.context[0..256])
    }
}

pub machine EngineBindingError::set_context(engine_binding_error: &mut EngineBindingError, context: &[u8]) {
    engine_binding_error.context_len = 0;
    transition { _ -> copy_context(engine_binding_error, context, 0) }
    state copy_context(engine_binding_error: &mut EngineBindingError, context: &[u8], position: u64) {
        transition position < context.len && position < 256 {
            true -> store_context(engine_binding_error, context, position)
            false -> finish_context(engine_binding_error, position)
        }
    }
    state store_context(engine_binding_error: &mut EngineBindingError, context: &[u8], position: u64)
        requires position < 256;
    {
        engine_binding_error.context[position] = context[position];
        transition { _ -> copy_context(engine_binding_error, context, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_context(engine_binding_error: &mut EngineBindingError, count: u64) {
        engine_binding_error.context_len = count;
    }
}

pub machine EngineBindingError::get_details(engine_binding_error: &EngineBindingError) -> &[u8] {
    transition engine_binding_error.details_len <= 256 {
        true -> (&engine_binding_error.details[0..engine_binding_error.details_len])
        false -> (&engine_binding_error.details[0..256])
        _ -> (&engine_binding_error.details[0..256])
    }
}

pub machine EngineBindingError::set_details(engine_binding_error: &mut EngineBindingError, details: &[u8]) {
    engine_binding_error.details_len = 0;
    transition { _ -> copy_details(engine_binding_error, details, 0) }
    state copy_details(engine_binding_error: &mut EngineBindingError, details: &[u8], position: u64) {
        transition position < details.len && position < 256 {
            true -> store_details(engine_binding_error, details, position)
            false -> finish_details(engine_binding_error, position)
        }
    }
    state store_details(engine_binding_error: &mut EngineBindingError, details: &[u8], position: u64)
        requires position < 256;
    {
        engine_binding_error.details[position] = details[position];
        transition { _ -> copy_details(engine_binding_error, details, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_details(engine_binding_error: &mut EngineBindingError, count: u64) {
        engine_binding_error.details_len = count;
    }
}

pub machine EngineBindingError::clone(engine_binding_error: &EngineBindingError) -> EngineBindingError {
    let mut cloned: EngineBindingError = EngineBindingError {
        kind: engine_binding_error.kind,
        context_len: 0,
        details_len: 0,
    };
    EngineBindingError::set_context(&mut cloned, EngineBindingError::get_context(engine_binding_error));
    EngineBindingError::set_details(&mut cloned, EngineBindingError::get_details(engine_binding_error));
    (cloned)
}

pub machine EngineBindingError::clone_from(engine_binding_error: &mut EngineBindingError, source: &EngineBindingError) {
    engine_binding_error.kind = source.kind;
    EngineBindingError::set_context(engine_binding_error, EngineBindingError::get_context(source));
    EngineBindingError::set_details(engine_binding_error, EngineBindingError::get_details(source));
}
