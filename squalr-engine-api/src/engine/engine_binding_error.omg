module src::engine::engine_binding_error;

use src::structures::bounded_slice::bounded_slice;

// Port of engine/engine_binding_error.rs. Upstream is a 3-case enum whose
// cases carry String payloads; port-side the case index rides as a copy
// enum beside shared bounded context/details buffers (unused context is
// empty on EngineUnavailable/LockFailure — mirrors upstream's absent field).
pub data EngineBindingErrorKind [copy] {
    case EngineUnavailable;
    case LockFailure;
    case OperationFailed;
}

pub data EngineBindingError {
    kind: EngineBindingErrorKind;
    context: [u8; 256];
    context_len: u64;
    details: [u8; 256];
    details_len: u64;
}

pub machine EngineBindingError::default() -> EngineBindingError {
    (EngineBindingError {
        kind: EngineBindingErrorKind::EngineUnavailable,
        context_len: 0,
        details_len: 0,
    })
}

pub machine EngineBindingError::engine_unavailable(details: &[u8]) -> EngineBindingError {
    let mut created: EngineBindingError = EngineBindingError {
        kind: EngineBindingErrorKind::EngineUnavailable,
        context_len: 0,
        details_len: 0,
    };
    created.set_details(details);
    (created)
}

pub machine EngineBindingError::lock_failure(details: &[u8]) -> EngineBindingError {
    let mut created: EngineBindingError = EngineBindingError {
        kind: EngineBindingErrorKind::LockFailure,
        context_len: 0,
        details_len: 0,
    };
    created.set_details(details);
    (created)
}

pub machine EngineBindingError::operation_failed(context: &[u8], details: &[u8]) -> EngineBindingError {
    let mut created: EngineBindingError = EngineBindingError {
        kind: EngineBindingErrorKind::OperationFailed,
        context_len: 0,
        details_len: 0,
    };
    created.set_context(context);
    created.set_details(details);
    (created)
}

pub machine EngineBindingError::get_kind(&self) -> EngineBindingErrorKind {
    self.kind
}

pub machine EngineBindingError::get_context(&self) -> &[u8] {
    bounded_slice(&self.context[0..256], self.context_len)
}

pub machine EngineBindingError::set_context(&mut self, context: &[u8]) {
    self.context_len = 0;
    transition { _ -> copy_context(context, 0) }
    state copy_context(&mut self, context: &[u8], position: u64) {
        transition position < context.len && position < 256 {
            true -> store_context(context, position)
            false -> finish_context(position)
        }
    }
    state store_context(&mut self, context: &[u8], position: u64)
        requires position < 256;
    {
        self.context[position] = context[position];
        transition { _ -> copy_context(context, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_context(&mut self, count: u64) {
        self.context_len = count;
    }
}

pub machine EngineBindingError::get_details(&self) -> &[u8] {
    bounded_slice(&self.details[0..256], self.details_len)
}

pub machine EngineBindingError::set_details(&mut self, details: &[u8]) {
    self.details_len = 0;
    transition { _ -> copy_details(details, 0) }
    state copy_details(&mut self, details: &[u8], position: u64) {
        transition position < details.len && position < 256 {
            true -> store_details(details, position)
            false -> finish_details(position)
        }
    }
    state store_details(&mut self, details: &[u8], position: u64)
        requires position < 256;
    {
        self.details[position] = details[position];
        transition { _ -> copy_details(details, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_details(&mut self, count: u64) {
        self.details_len = count;
    }
}

pub machine EngineBindingError::clone(&self) -> EngineBindingError {
    let mut cloned: EngineBindingError = EngineBindingError {
        kind: self.kind,
        context_len: 0,
        details_len: 0,
    };
    cloned.set_context(self.get_context());
    cloned.set_details(self.get_details());
    (cloned)
}

pub machine EngineBindingError::clone_from(&mut self, source: &EngineBindingError) {
    self.kind = source.kind;
    self.set_context(source.get_context());
    self.set_details(source.get_details());
}
