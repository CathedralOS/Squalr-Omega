module src::engine::engine_binding_error;

// Port of engine/engine_binding_error.rs. Upstream is a 3-case enum whose
// cases carry String payloads; port-side the case index rides as a copy
// enum beside shared bounded context/details buffers (unused context is
// empty on EngineUnavailable/LockFailure — mirrors upstream's absent field).
pub data EngineBindingErrorKind [copy] {
    case EngineUnavailable;
    case LockFailure;
    case OperationFailed;
}

pub data EngineBindingError {
    kind: EngineBindingErrorKind;
    context: [u8; 256];
    context_len: u64;
    details: [u8; 256];
    details_len: u64;
}

pub machine EngineBindingError::default() -> EngineBindingError {
    (EngineBindingError {
        kind: EngineBindingErrorKind::EngineUnavailable,
        context_len: 0,
        details_len: 0,
    })
}

pub machine EngineBindingError::engine_unavailable(details: &[u8]) -> EngineBindingError {
    let mut created: EngineBindingError = EngineBindingError {
        kind: EngineBindingErrorKind::EngineUnavailable,
        context_len: 0,
        details_len: 0,
    };
    EngineBindingError::set_details(&mut created, details);
    (created)
}

pub machine EngineBindingError::lock_failure(details: &[u8]) -> EngineBindingError {
    let mut created: EngineBindingError = EngineBindingError {
        kind: EngineBindingErrorKind::LockFailure,
        context_len: 0,
        details_len: 0,
    };
    EngineBindingError::set_details(&mut created, details);
    (created)
}

pub machine EngineBindingError::operation_failed(context: &[u8], details: &[u8]) -> EngineBindingError {
    let mut created: EngineBindingError = EngineBindingError {
        kind: EngineBindingErrorKind::OperationFailed,
        context_len: 0,
        details_len: 0,
    };
    EngineBindingError::set_context(&mut created, context);
    EngineBindingError::set_details(&mut created, details);
    (created)
}

pub machine EngineBindingError::get_kind(this: &EngineBindingError) -> EngineBindingErrorKind {
    this.kind
}

pub machine EngineBindingError::get_context(this: &EngineBindingError) -> &[u8] {
    transition this.context_len <= 256 {
        true -> (&this.context[0..this.context_len])
        false -> (&this.context[0..256])
        _ -> (&this.context[0..256])
    }
}

pub machine EngineBindingError::set_context(this: &mut EngineBindingError, context: &[u8]) {
    this.context_len = 0;
    transition { _ -> copy_context(this, context, 0) }
    state copy_context(this: &mut EngineBindingError, context: &[u8], position: u64) {
        transition position < context.len && position < 256 {
            true -> store_context(this, context, position)
            false -> finish_context(this, position)
        }
    }
    state store_context(this: &mut EngineBindingError, context: &[u8], position: u64)
        requires position < 256;
    {
        this.context[position] = context[position];
        transition { _ -> copy_context(this, context, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_context(this: &mut EngineBindingError, count: u64) {
        this.context_len = count;
    }
}

pub machine EngineBindingError::get_details(this: &EngineBindingError) -> &[u8] {
    transition this.details_len <= 256 {
        true -> (&this.details[0..this.details_len])
        false -> (&this.details[0..256])
        _ -> (&this.details[0..256])
    }
}

pub machine EngineBindingError::set_details(this: &mut EngineBindingError, details: &[u8]) {
    this.details_len = 0;
    transition { _ -> copy_details(this, details, 0) }
    state copy_details(this: &mut EngineBindingError, details: &[u8], position: u64) {
        transition position < details.len && position < 256 {
            true -> store_details(this, details, position)
            false -> finish_details(this, position)
        }
    }
    state store_details(this: &mut EngineBindingError, details: &[u8], position: u64)
        requires position < 256;
    {
        this.details[position] = details[position];
        transition { _ -> copy_details(this, details, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_details(this: &mut EngineBindingError, count: u64) {
        this.details_len = count;
    }
}

pub machine EngineBindingError::clone(this: &EngineBindingError) -> EngineBindingError {
    let mut cloned: EngineBindingError = EngineBindingError {
        kind: this.kind,
        context_len: 0,
        details_len: 0,
    };
    EngineBindingError::set_context(&mut cloned, EngineBindingError::get_context(this));
    EngineBindingError::set_details(&mut cloned, EngineBindingError::get_details(this));
    (cloned)
}

pub machine EngineBindingError::clone_from(this: &mut EngineBindingError, source: &EngineBindingError) {
    this.kind = source.kind;
    EngineBindingError::set_context(&mut this, EngineBindingError::get_context(source));
    EngineBindingError::set_details(&mut this, EngineBindingError::get_details(source));
}
