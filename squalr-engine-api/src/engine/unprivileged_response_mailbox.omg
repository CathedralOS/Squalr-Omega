module src::engine::unprivileged_response_mailbox;

use src::commands::unprivileged_command_response::UnprivilegedCommandResponse;

// Port-side callback carrier for upstream's Box<dyn Fn> dispatch callback —
// the composition root delivers the response whole into this mailbox and
// the caller drains it by value (no union clone machinery on the response
// types).
pub data UnprivilegedResponseMailbox {
    case Empty;
    case Delivered(response: UnprivilegedCommandResponse);
}

pub machine UnprivilegedResponseMailbox::default() -> UnprivilegedResponseMailbox {
    (UnprivilegedResponseMailbox::Empty)
}

pub machine UnprivilegedResponseMailbox::get_has_response(&self) -> bool {
    transition self {
        UnprivilegedResponseMailbox::Delivered { response } -> (true)
        _ -> (false)
    }
}

// Upstream callback delivery — moves the response into the mailbox.
pub machine UnprivilegedResponseMailbox::deliver(&mut self, response: UnprivilegedCommandResponse) {
    self = UnprivilegedResponseMailbox::Delivered { response: response };
}

// Upstream `callback(response)` consumption — drains the mailbox and
// hands the response back by value through the returned union.
pub machine UnprivilegedResponseMailbox::take(&mut self) -> UnprivilegedResponseMailbox {
    transition self {
        UnprivilegedResponseMailbox::Delivered { response } -> take_response(response)
        _ -> (UnprivilegedResponseMailbox::Empty)
    }
    state take_response(&mut self, response: UnprivilegedCommandResponse) -> UnprivilegedResponseMailbox {
        self = UnprivilegedResponseMailbox::Empty;
        (UnprivilegedResponseMailbox::Delivered { response: response })
    }
}

