module src::engine::unprivileged_response_mailbox;

use src::commands::unprivileged_command_response::UnprivilegedCommandResponse;

// Port-side callback carrier for upstream's Box<dyn Fn> dispatch callback —
// the composition root delivers the response whole into this mailbox and
// the caller drains it by value (no union clone machinery on the response
// types).
public data UnprivilegedResponseMailbox {
    case Empty;
    case Delivered(response: UnprivilegedCommandResponse);
}

public machine UnprivilegedResponseMailbox::default() -> UnprivilegedResponseMailbox {
    (UnprivilegedResponseMailbox::Empty)
}

public machine UnprivilegedResponseMailbox::get_has_response(this: &UnprivilegedResponseMailbox) -> bool {
    transition this {
        UnprivilegedResponseMailbox::Delivered { response } -> (true)
        _ -> (false)
    }
}

// Upstream callback delivery — moves the response into the mailbox.
public machine UnprivilegedResponseMailbox::deliver(this: &mut UnprivilegedResponseMailbox, response: UnprivilegedCommandResponse) {
    this = UnprivilegedResponseMailbox::Delivered { response: response };
}

// Upstream `callback(response)` consumption — drains the mailbox and
// hands the response back by value through the returned union.
public machine UnprivilegedResponseMailbox::take(this: &mut UnprivilegedResponseMailbox) -> UnprivilegedResponseMailbox {
    // Upstream `std::mem::take`: the delivered response moves out whole and
    // the mailbox is left Empty; an Empty mailbox yields Empty unchanged.
    let taken: UnprivilegedResponseMailbox = this;
    this = UnprivilegedResponseMailbox::Empty;
    (taken)
}

