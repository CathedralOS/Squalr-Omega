module src::conversions::conversions_from_primitives;

use src::conversions::base_system_conversions::BaseSystemConversions;
use src::conversions::base_system_conversions::RadixParse;

// Port of conversions/conversions_from_primitives.rs: formatting helpers
// for primitive values and the hex-or-decimal command-line integer parse.
//
// Named deviations:
// - Upstream's generic width comes from size_of::<T>; the port takes the
//   pad width explicitly (bit_width / hex_width parameters).
// - Formatting lands in a caller buffer and returns the count written, the
//   repo's read_all convention for unowned text.
// - parse_hex_or_int returns the shared RadixParse carrier: upstream's
//   ParseIntError classes all surface as Failed.
pub data Conversions {}

// Upstream parse_hex_or_int: a 0x/0X prefix selects radix 16, otherwise 10.
pub machine Conversions::parse_hex_or_int(text: &[u8], start: u64, end: u64) -> RadixParse {
    let second: u64 = ((start as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    transition start < text.len && second < text.len && second < end {
        true -> probe(text, start, second, end)
        false -> decimal(text, start, end)
    }
    state probe(text: &[u8], start: u64, second: u64, end: u64) -> RadixParse {
        let after_prefix: u64 = ((second as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition text[start] == 48 && (text[second] == 120 || text[second] == 88) {
            true -> hexadecimal(text, after_prefix, end)
            false -> decimal(text, start, end)
        }
    }
    state hexadecimal(text: &[u8], start: u64, end: u64) -> RadixParse {
        let parsed: RadixParse = BaseSystemConversions::parse_radix_window(text, start, end, 16);
        transition { _ -> (parsed) }
    }
    state decimal(text: &[u8], start: u64, end: u64) -> RadixParse {
        let parsed: RadixParse = BaseSystemConversions::parse_radix_window(text, start, end, 10);
        transition { _ -> (parsed) }
    }
}

// Upstream primitive_to_binary ({:b}).
pub machine Conversions::primitive_to_binary(value: u64, out: &mut [u8]) -> u64 {
    transition {
        _ -> emit(value, out)
    }
    state emit(value: u64, out: &mut [u8]) -> u64 {
        let written: u64 = BaseSystemConversions::emit_radix(value, 2, false, out, 0);
        transition { _ -> (written) }
    }
}

// Upstream primitive_to_binary_padded — bit_width is upstream's
// size_of::<T>() * 8 passed explicitly.
pub machine Conversions::primitive_to_binary_padded(value: u64, bit_width: u64, out: &mut [u8]) -> u64 {
    transition {
        _ -> emit(value, bit_width, out)
    }
    state emit(value: u64, bit_width: u64, out: &mut [u8]) -> u64 {
        let written: u64 = BaseSystemConversions::emit_fixed_radix(value, 2, bit_width, false, out, 0);
        transition { _ -> (written) }
    }
}

// Upstream primitive_to_hexadecimal ({:X}).
pub machine Conversions::primitive_to_hexadecimal(value: u64, out: &mut [u8]) -> u64 {
    transition {
        _ -> emit(value, out)
    }
    state emit(value: u64, out: &mut [u8]) -> u64 {
        let written: u64 = BaseSystemConversions::emit_radix(value, 16, true, out, 0);
        transition { _ -> (written) }
    }
}

// Upstream primitive_to_hexadecimal_padded — hex_width is upstream's
// size_of::<T>() * 2 passed explicitly.
pub machine Conversions::primitive_to_hexadecimal_padded(value: u64, hex_width: u64, out: &mut [u8]) -> u64 {
    transition {
        _ -> emit(value, hex_width, out)
    }
    state emit(value: u64, hex_width: u64, out: &mut [u8]) -> u64 {
        let written: u64 = BaseSystemConversions::emit_fixed_radix(value, 16, hex_width, true, out, 0);
        transition { _ -> (written) }
    }
}
