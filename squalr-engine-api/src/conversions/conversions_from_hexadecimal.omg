module src::conversions::conversions_from_hexadecimal;

use src::conversions::base_system_conversions::BaseSystemConversions;
use src::conversions::conversion_error::ConversionError;
use src::conversions::conversion_error::ConversionResult;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;

// Port of conversions/conversions_from_hexadecimal.rs: base-16 entry points into
// BaseSystemConversions. convert_to_format returns UnsupportedConversion for
// any target format upstream does not list (Bool/String/DataTypeRef).
pub data ConversionsFromHexadecimal {}

// Upstream convert_to_format.
pub machine ConversionsFromHexadecimal::convert_to_format(
    hex_string_to_convert: &[u8],
    start: u64,
    end: u64,
    to_anonymous_value_string_format: AnonymousValueStringFormat,
    out: &mut [u8]
) -> ConversionResult {
    transition to_anonymous_value_string_format {
        AnonymousValueStringFormat::Binary -> as_binary(hex_string_to_convert, start, end, out)
        AnonymousValueStringFormat::Decimal -> as_decimal(hex_string_to_convert, start, end, out)
        AnonymousValueStringFormat::Address -> as_address(hex_string_to_convert, start, end, out)
        _ -> (ConversionResult::Error { error: ConversionError::UnsupportedConversion })
    }
    state as_decimal(hex_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_base(hex_string_to_convert, start, end, 16, 10, out)
    }
    state as_binary(hex_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_base(hex_string_to_convert, start, end, 16, 2, out)
    }
    state as_address(hex_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_address(hex_string_to_convert, start, end, 16, out)
    }
}

// Upstream convert_to_binary.
pub machine ConversionsFromHexadecimal::convert_to_binary(
    hex_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(hex_string_to_convert, start, end, out)
    }
    state delegate(hex_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_base(hex_string_to_convert, start, end, 16, 2, out)
    }
}

// Upstream convert_to_decimal.
pub machine ConversionsFromHexadecimal::convert_to_decimal(
    hex_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(hex_string_to_convert, start, end, out)
    }
    state delegate(hex_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_base(hex_string_to_convert, start, end, 16, 10, out)
    }
}

// Upstream convert_to_address.
pub machine ConversionsFromHexadecimal::convert_to_address(
    hex_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(hex_string_to_convert, start, end, out)
    }
    state delegate(hex_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_address(hex_string_to_convert, start, end, 16, out)
    }
}

// Upstream hex_to_bytes: minimal big-endian byte representation.
pub machine ConversionsFromHexadecimal::hex_to_bytes(
    hex_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(hex_string_to_convert, start, end, out)
    }
    state delegate(hex_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_bytes(hex_string_to_convert, start, end, 16, out)
    }
}

// Upstream hex_to_primitive_aligned_bytes<T> — the generic width and
// bound arrive as explicit parameters (primitive_size, max_value); named
// deviation, see base_system_conversions.
pub machine ConversionsFromHexadecimal::hex_to_primitive_aligned_bytes(
    hex_string_to_convert: &[u8],
    start: u64,
    end: u64,
    is_big_endian: bool,
    primitive_size: u64,
    max_value: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(hex_string_to_convert, start, end, is_big_endian, primitive_size, max_value, out)
    }
    state delegate(
        hex_string_to_convert: &[u8],
        start: u64,
        end: u64,
        is_big_endian: bool,
        primitive_size: u64,
        max_value: u64,
        out: &mut [u8]
    ) -> ConversionResult {
        BaseSystemConversions::convert_to_primitive_aligned_bytes(
            hex_string_to_convert,
            start,
            end,
            16,
            is_big_endian,
            primitive_size,
            max_value,
            out
        )
    }
}
