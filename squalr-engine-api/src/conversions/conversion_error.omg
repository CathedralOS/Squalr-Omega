module src::conversions::conversion_error;

// Port of conversions/conversion_error.rs: the shared failure channel for
// the base-system conversion helpers. Upstream is a thiserror enum whose
// ParseError carries a formatted String; authored text has no owning String
// here, so the port keeps only the failure class — named deviation, matching
// the package's payloadless Refused convention (callers test the class, not
// the message).
//
// OutputFull is added by the port: upstream writes into a growable Vec or
// String and can never run out of room, while callers here supply the
// output buffer — a too-small buffer refuses rather than truncates.
pub data ConversionError [copy] {
    case ParseError;
    case UnsupportedConversion;
    case OutputFull;
}

// Shared carrier for what upstream returns as Result<String, ConversionError>
// or Result<Vec<u8>, ConversionError>: output bytes land in the caller's
// buffer and Ok reports the count written (the read_all convention). First
// case is the ZII zero = failure, the repo's result-enum convention.
pub data ConversionResult {
    case Error(error: ConversionError);
    case Ok(count: u64);
}
