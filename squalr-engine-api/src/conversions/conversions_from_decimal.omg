use src/conversions/base_system_conversions.omg;
use src/conversions/conversion_error.omg;
use src/structures/data_values/anonymous_value_string_format.omg;

// Port of conversions/conversions_from_decimal.rs: base-10 entry points into
// BaseSystemConversions. convert_to_format returns UnsupportedConversion for
// any target format upstream does not list (Bool/String/DataTypeRef).
public data ConversionsFromDecimal {}

// Upstream convert_to_format.
public machine ConversionsFromDecimal::convert_to_format(
    decimal_string_to_convert: &[u8],
    start: u64,
    end: u64,
    to_anonymous_value_string_format: &|anonymous_value_string_format|::AnonymousValueStringFormat,
    out: &mut [u8]
) -> |conversion_error|::ConversionResult {
    transition to_anonymous_value_string_format {
        |anonymous_value_string_format|::AnonymousValueStringFormat::Binary -> as_binary(decimal_string_to_convert, start, end, out)
        |anonymous_value_string_format|::AnonymousValueStringFormat::Hexadecimal -> as_hexadecimal(decimal_string_to_convert, start, end, out)
        |anonymous_value_string_format|::AnonymousValueStringFormat::Address -> as_address(decimal_string_to_convert, start, end, out)
        _ -> (|conversion_error|::ConversionResult::Error { error: |conversion_error|::ConversionError::UnsupportedConversion })
    }
    machine as_binary(decimal_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> |conversion_error|::ConversionResult {
        |base_system_conversions|::BaseSystemConversions::convert_to_base(decimal_string_to_convert, start, end, 10, 2, out)
    }
    machine as_hexadecimal(decimal_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> |conversion_error|::ConversionResult {
        |base_system_conversions|::BaseSystemConversions::convert_to_base(decimal_string_to_convert, start, end, 10, 16, out)
    }
    machine as_address(decimal_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> |conversion_error|::ConversionResult {
        |base_system_conversions|::BaseSystemConversions::convert_to_address(decimal_string_to_convert, start, end, 10, out)
    }
}

// Upstream convert_to_binary.
public machine ConversionsFromDecimal::convert_to_binary(
    decimal_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> |conversion_error|::ConversionResult {
    transition {
        _ -> delegate(decimal_string_to_convert, start, end, out)
    }
    machine delegate(decimal_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> |conversion_error|::ConversionResult {
        |base_system_conversions|::BaseSystemConversions::convert_to_base(decimal_string_to_convert, start, end, 10, 2, out)
    }
}

// Upstream convert_to_hexadecimal.
public machine ConversionsFromDecimal::convert_to_hexadecimal(
    decimal_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> |conversion_error|::ConversionResult {
    transition {
