        |base_system_conversions|::BaseSystemConversions::convert_to_address(decimal_string_to_convert, start, end, 10, out)
    }
}

// Upstream decimal_to_bytes: minimal big-endian byte representation.
public machine ConversionsFromDecimal::decimal_to_bytes(
    decimal_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> |conversion_error|::ConversionResult {
    transition {
        _ -> delegate(decimal_string_to_convert, start, end, out)
    }
    machine delegate(decimal_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> |conversion_error|::ConversionResult {
        |base_system_conversions|::BaseSystemConversions::convert_to_bytes(decimal_string_to_convert, start, end, 10, out)
    }
}

// Upstream decimal_to_primitive_aligned_bytes<T> — the generic width and
// bound arrive as explicit parameters (primitive_size, max_value); named
// deviation, see base_system_conversions.
public machine ConversionsFromDecimal::decimal_to_primitive_aligned_bytes(
    decimal_string_to_convert: &[u8],
    start: u64,
    end: u64,
    is_big_endian: bool,
    primitive_size: u64,
    max_value: u64,
    out: &mut [u8]
) -> |conversion_error|::ConversionResult {
    transition {
        _ -> delegate(decimal_string_to_convert, start, end, is_big_endian, primitive_size, max_value, out)
    }
    machine delegate(
        decimal_string_to_convert: &[u8],
        start: u64,
        end: u64,
        is_big_endian: bool,
        primitive_size: u64,
        max_value: u64,
        out: &mut [u8]
    ) -> |conversion_error|::ConversionResult {
        |base_system_conversions|::BaseSystemConversions::convert_to_primitive_aligned_bytes(
            decimal_string_to_convert,
            start,
            end,
            10,
            is_big_endian,
            primitive_size,
            max_value,
            out
        )
    }
}
