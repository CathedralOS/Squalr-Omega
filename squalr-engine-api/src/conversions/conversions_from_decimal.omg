module src::conversions::conversions_from_decimal;

use src::conversions::base_system_conversions::BaseSystemConversions;
use src::conversions::conversion_error::ConversionError;
use src::conversions::conversion_error::ConversionResult;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;

// Port of conversions/conversions_from_decimal.rs: base-10 entry points into
// BaseSystemConversions. convert_to_format returns UnsupportedConversion for
// any target format upstream does not list (Bool/String/DataTypeRef).
pub data ConversionsFromDecimal {}

// Upstream convert_to_format.
pub machine ConversionsFromDecimal::convert_to_format(
    decimal_string_to_convert: &[u8],
    start: u64,
    end: u64,
    to_anonymous_value_string_format: AnonymousValueStringFormat,
    out: &mut [u8]
) -> ConversionResult {
    transition to_anonymous_value_string_format {
        AnonymousValueStringFormat::Binary -> as_binary(decimal_string_to_convert, start, end, out)
        AnonymousValueStringFormat::Hexadecimal -> as_hexadecimal(decimal_string_to_convert, start, end, out)
        AnonymousValueStringFormat::Address -> as_address(decimal_string_to_convert, start, end, out)
        _ -> (ConversionResult::Error { error: ConversionError::UnsupportedConversion })
    }
    state as_binary(decimal_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_base(decimal_string_to_convert, start, end, 10, 2, out)
    }
    state as_hexadecimal(decimal_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_base(decimal_string_to_convert, start, end, 10, 16, out)
    }
    state as_address(decimal_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_address(decimal_string_to_convert, start, end, 10, out)
    }
}

// Upstream convert_to_binary.
pub machine ConversionsFromDecimal::convert_to_binary(
    decimal_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(decimal_string_to_convert, start, end, out)
    }
    state delegate(decimal_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_base(decimal_string_to_convert, start, end, 10, 2, out)
    }
}

// Upstream convert_to_hexadecimal.
pub machine ConversionsFromDecimal::convert_to_hexadecimal(
    decimal_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(decimal_string_to_convert, start, end, out)
    }
    state delegate(decimal_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_base(decimal_string_to_convert, start, end, 10, 16, out)
    }
}

// Upstream convert_to_address.
pub machine ConversionsFromDecimal::convert_to_address(
    decimal_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(decimal_string_to_convert, start, end, out)
    }
    state delegate(decimal_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_address(decimal_string_to_convert, start, end, 10, out)
    }
}

// Upstream decimal_to_bytes: minimal big-endian byte representation.
pub machine ConversionsFromDecimal::decimal_to_bytes(
    decimal_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(decimal_string_to_convert, start, end, out)
    }
    state delegate(decimal_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_bytes(decimal_string_to_convert, start, end, 10, out)
    }
}

// Upstream decimal_to_primitive_aligned_bytes<T> — the generic width and
// bound arrive as explicit parameters (primitive_size, max_value); named
// deviation, see base_system_conversions.
pub machine ConversionsFromDecimal::decimal_to_primitive_aligned_bytes(
    decimal_string_to_convert: &[u8],
    start: u64,
    end: u64,
    is_big_endian: bool,
    primitive_size: u64,
    max_value: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(decimal_string_to_convert, start, end, is_big_endian, primitive_size, max_value, out)
    }
    state delegate(
        decimal_string_to_convert: &[u8],
        start: u64,
        end: u64,
        is_big_endian: bool,
        primitive_size: u64,
        max_value: u64,
        out: &mut [u8]
    ) -> ConversionResult {
        BaseSystemConversions::convert_to_primitive_aligned_bytes(
            decimal_string_to_convert,
            start,
            end,
            10,
            is_big_endian,
            primitive_size,
            max_value,
            out
        )
    }
}
