module src::conversions::conversions_from_binary;

use src::conversions::base_system_conversions::BaseSystemConversions;
use src::conversions::conversion_error::ConversionError;
use src::conversions::conversion_error::ConversionResult;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;

// Port of conversions/conversions_from_binary.rs: base-2 entry points into
// BaseSystemConversions. convert_to_format returns UnsupportedConversion for
// any target format upstream does not list (Bool/String/DataTypeRef).
pub data ConversionsFromBinary {}

// Upstream convert_to_format.
pub machine ConversionsFromBinary::convert_to_format(
    binary_string_to_convert: &[u8],
    start: u64,
    end: u64,
    to_anonymous_value_string_format: AnonymousValueStringFormat,
    out: &mut [u8]
) -> ConversionResult {
    transition to_anonymous_value_string_format {
        AnonymousValueStringFormat::Decimal -> as_decimal(binary_string_to_convert, start, end, out)
        AnonymousValueStringFormat::Hexadecimal -> as_hexadecimal(binary_string_to_convert, start, end, out)
        AnonymousValueStringFormat::Address -> as_address(binary_string_to_convert, start, end, out)
        _ -> (ConversionResult::Error { error: ConversionError::UnsupportedConversion })
    }
    state as_decimal(binary_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_base(binary_string_to_convert, start, end, 2, 10, out)
    }
    state as_hexadecimal(binary_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_base(binary_string_to_convert, start, end, 2, 16, out)
    }
    state as_address(binary_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_address(binary_string_to_convert, start, end, 2, out)
    }
}

// Upstream convert_to_decimal.
pub machine ConversionsFromBinary::convert_to_decimal(
    binary_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(binary_string_to_convert, start, end, out)
    }
    state delegate(binary_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_base(binary_string_to_convert, start, end, 2, 10, out)
    }
}

// Upstream convert_to_hexadecimal.
pub machine ConversionsFromBinary::convert_to_hexadecimal(
    binary_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(binary_string_to_convert, start, end, out)
    }
    state delegate(binary_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_base(binary_string_to_convert, start, end, 2, 16, out)
    }
}

// Upstream convert_to_address.
pub machine ConversionsFromBinary::convert_to_address(
    binary_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(binary_string_to_convert, start, end, out)
    }
    state delegate(binary_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_address(binary_string_to_convert, start, end, 2, out)
    }
}

// Upstream binary_to_bytes: minimal big-endian byte representation.
pub machine ConversionsFromBinary::binary_to_bytes(
    binary_string_to_convert: &[u8],
    start: u64,
    end: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(binary_string_to_convert, start, end, out)
    }
    state delegate(binary_string_to_convert: &[u8], start: u64, end: u64, out: &mut [u8]) -> ConversionResult {
        BaseSystemConversions::convert_to_bytes(binary_string_to_convert, start, end, 2, out)
    }
}

// Upstream binary_to_primitive_aligned_bytes<T> — the generic width and
// bound arrive as explicit parameters (primitive_size, max_value); named
// deviation, see base_system_conversions.
pub machine ConversionsFromBinary::binary_to_primitive_aligned_bytes(
    binary_string_to_convert: &[u8],
    start: u64,
    end: u64,
    is_big_endian: bool,
    primitive_size: u64,
    max_value: u64,
    out: &mut [u8]
) -> ConversionResult {
    transition {
        _ -> delegate(binary_string_to_convert, start, end, is_big_endian, primitive_size, max_value, out)
    }
    state delegate(
        binary_string_to_convert: &[u8],
        start: u64,
        end: u64,
        is_big_endian: bool,
        primitive_size: u64,
        max_value: u64,
        out: &mut [u8]
    ) -> ConversionResult {
        BaseSystemConversions::convert_to_primitive_aligned_bytes(
            binary_string_to_convert,
            start,
            end,
            2,
            is_big_endian,
            primitive_size,
            max_value,
            out
        )
    }
}
