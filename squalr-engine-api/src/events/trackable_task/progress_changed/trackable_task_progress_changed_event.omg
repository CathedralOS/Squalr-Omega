module src::events::trackable_task::progress_changed::trackable_task_progress_changed_event;

use src::structures::bounded_slice::bounded_slice;

use src::events::engine_event::EngineEvent;
use src::events::trackable_task::trackable_task_event::TrackableTaskEvent;
use src::structures::bounded_byte_copy::BoundedByteCopy;

// Upstream TrackableTaskProgressChangedEvent — task id + 0.0..=1.0 progress.
pub data TrackableTaskProgressChangedEvent {
    task_id: [u8; 64];
    task_id_len: u64;
    progress: f32;
}

pub machine TrackableTaskProgressChangedEvent::default() -> TrackableTaskProgressChangedEvent {
    (TrackableTaskProgressChangedEvent {
        task_id_len: 0,
        progress: 0.0,
    })
}

pub machine TrackableTaskProgressChangedEvent::new(task_id: &[u8], progress: f32) -> TrackableTaskProgressChangedEvent {
    let mut created: TrackableTaskProgressChangedEvent = TrackableTaskProgressChangedEvent::default();
    created.set_task_id(task_id);
    created.progress = progress;
    (created)
}

pub machine TrackableTaskProgressChangedEvent::get_task_id(&self) -> &[u8] {
    bounded_slice(&self.task_id[0..64], self.task_id_len)
}

pub machine TrackableTaskProgressChangedEvent::set_task_id(&mut self, task_id: &[u8]) {
    self.task_id_len = BoundedByteCopy::copy(&mut self.task_id[0..64], task_id);
}

pub machine TrackableTaskProgressChangedEvent::get_progress(&self) -> f32 {
    self.progress
}

pub machine TrackableTaskProgressChangedEvent::clone(&self) -> TrackableTaskProgressChangedEvent {
    (TrackableTaskProgressChangedEvent::new(self.get_task_id(), self.progress))
}

pub machine TrackableTaskProgressChangedEvent::clone_from(&mut self, source: &TrackableTaskProgressChangedEvent) {
    self.set_task_id(source.get_task_id());
    self.progress = source.progress;
}

pub machine TrackableTaskProgressChangedEvent::to_engine_event(&self) -> EngineEvent {
    (EngineEvent::TrackableTask {
        event: TrackableTaskEvent::ProgressChanged {
            progress_changed_event: self.clone(),
        },
    })
}
