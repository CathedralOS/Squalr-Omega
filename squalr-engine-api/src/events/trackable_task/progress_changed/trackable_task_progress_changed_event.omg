module src::events::trackable_task::progress_changed::trackable_task_progress_changed_event;

use src::events::engine_event::EngineEvent;
use src::events::trackable_task::trackable_task_event::TrackableTaskEvent;

// Upstream TrackableTaskProgressChangedEvent — task id + 0.0..=1.0 progress.
pub data TrackableTaskProgressChangedEvent {
    task_id: [u8; 64];
    task_id_len: u64;
    progress: f32;
}

pub machine TrackableTaskProgressChangedEvent::default() -> TrackableTaskProgressChangedEvent {
    (TrackableTaskProgressChangedEvent {
        task_id_len: 0,
        progress: 0.0,
    })
}

pub machine TrackableTaskProgressChangedEvent::new(task_id: &[u8], progress: f32) -> TrackableTaskProgressChangedEvent {
    let mut created: TrackableTaskProgressChangedEvent = TrackableTaskProgressChangedEvent::default();
    TrackableTaskProgressChangedEvent::set_task_id(&mut created, task_id);
    created.progress = progress;
    (created)
}

pub machine TrackableTaskProgressChangedEvent::get_task_id(trackable_task_progress_changed_event: &TrackableTaskProgressChangedEvent) -> &[u8] {
    transition trackable_task_progress_changed_event.task_id_len <= 64 {
        true -> (&trackable_task_progress_changed_event.task_id[0..trackable_task_progress_changed_event.task_id_len])
        false -> (&trackable_task_progress_changed_event.task_id[0..64])
        _ -> (&trackable_task_progress_changed_event.task_id[0..64])
    }
}

pub machine TrackableTaskProgressChangedEvent::set_task_id(trackable_task_progress_changed_event: &mut TrackableTaskProgressChangedEvent, task_id: &[u8]) {
    trackable_task_progress_changed_event.task_id_len = 0;
    transition { _ -> copy(trackable_task_progress_changed_event, task_id, 0) }
    state copy(trackable_task_progress_changed_event: &mut TrackableTaskProgressChangedEvent, task_id: &[u8], position: u64) {
        transition position < task_id.len && position < 64 {
            true -> store(trackable_task_progress_changed_event, task_id, position)
            false -> finish(trackable_task_progress_changed_event, position)
        }
    }
    state store(trackable_task_progress_changed_event: &mut TrackableTaskProgressChangedEvent, task_id: &[u8], position: u64)
        requires position < 64;
    {
        trackable_task_progress_changed_event.task_id[position] = task_id[position];
        transition { _ -> copy(trackable_task_progress_changed_event, task_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(trackable_task_progress_changed_event: &mut TrackableTaskProgressChangedEvent, count: u64) {
        trackable_task_progress_changed_event.task_id_len = count;
    }
}

pub machine TrackableTaskProgressChangedEvent::get_progress(trackable_task_progress_changed_event: &TrackableTaskProgressChangedEvent) -> f32 {
    trackable_task_progress_changed_event.progress
}

pub machine TrackableTaskProgressChangedEvent::clone(trackable_task_progress_changed_event: &TrackableTaskProgressChangedEvent) -> TrackableTaskProgressChangedEvent {
    (TrackableTaskProgressChangedEvent::new(TrackableTaskProgressChangedEvent::get_task_id(trackable_task_progress_changed_event), trackable_task_progress_changed_event.progress))
}

pub machine TrackableTaskProgressChangedEvent::clone_from(trackable_task_progress_changed_event: &mut TrackableTaskProgressChangedEvent, source: &TrackableTaskProgressChangedEvent) {
    TrackableTaskProgressChangedEvent::set_task_id(trackable_task_progress_changed_event, TrackableTaskProgressChangedEvent::get_task_id(source));
    trackable_task_progress_changed_event.progress = source.progress;
}

pub machine TrackableTaskProgressChangedEvent::to_engine_event(trackable_task_progress_changed_event: &TrackableTaskProgressChangedEvent) -> EngineEvent {
    (EngineEvent::TrackableTask {
        event: TrackableTaskEvent::ProgressChanged {
            progress_changed_event: TrackableTaskProgressChangedEvent::clone(trackable_task_progress_changed_event),
        },
    })
}
