module src::events::trackable_task::progress_changed::trackable_task_progress_changed_event;

use src::events::engine_event::EngineEvent;
use src::events::trackable_task::trackable_task_event::TrackableTaskEvent;

// Upstream TrackableTaskProgressChangedEvent — task id + 0.0..=1.0 progress.
pub data TrackableTaskProgressChangedEvent {
    task_id: [u8; 64];
    task_id_len: u64;
    progress: f32;
}

pub machine TrackableTaskProgressChangedEvent::default() -> TrackableTaskProgressChangedEvent {
    (TrackableTaskProgressChangedEvent {
        task_id_len: 0,
        progress: 0.0,
    })
}

pub machine TrackableTaskProgressChangedEvent::new(task_id: &[u8], progress: f32) -> TrackableTaskProgressChangedEvent {
    let mut created: TrackableTaskProgressChangedEvent = TrackableTaskProgressChangedEvent::default();
    TrackableTaskProgressChangedEvent::set_task_id(&mut created, task_id);
    created.progress = progress;
    (created)
}

pub machine TrackableTaskProgressChangedEvent::get_task_id(this: &TrackableTaskProgressChangedEvent) -> &[u8] {
    transition this.task_id_len <= 64 {
        true -> (&this.task_id[0..this.task_id_len])
        false -> (&this.task_id[0..64])
        _ -> (&this.task_id[0..64])
    }
}

pub machine TrackableTaskProgressChangedEvent::set_task_id(this: &mut TrackableTaskProgressChangedEvent, task_id: &[u8]) {
    this.task_id_len = 0;
    transition { _ -> copy(this, task_id, 0) }
    state copy(this: &mut TrackableTaskProgressChangedEvent, task_id: &[u8], position: u64) {
        transition position < task_id.len && position < 64 {
            true -> store(this, task_id, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut TrackableTaskProgressChangedEvent, task_id: &[u8], position: u64)
        requires position < 64;
    {
        this.task_id[position] = task_id[position];
        transition { _ -> copy(this, task_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(this: &mut TrackableTaskProgressChangedEvent, count: u64) {
        this.task_id_len = count;
    }
}

pub machine TrackableTaskProgressChangedEvent::get_progress(this: &TrackableTaskProgressChangedEvent) -> f32 {
    this.progress
}

pub machine TrackableTaskProgressChangedEvent::clone(this: &TrackableTaskProgressChangedEvent) -> TrackableTaskProgressChangedEvent {
    (TrackableTaskProgressChangedEvent::new(TrackableTaskProgressChangedEvent::get_task_id(&this), this.progress))
}

pub machine TrackableTaskProgressChangedEvent::clone_from(this: &mut TrackableTaskProgressChangedEvent, source: &TrackableTaskProgressChangedEvent) {
    TrackableTaskProgressChangedEvent::set_task_id(&mut this, TrackableTaskProgressChangedEvent::get_task_id(source));
    this.progress = source.progress;
}

pub machine TrackableTaskProgressChangedEvent::to_engine_event(this: &TrackableTaskProgressChangedEvent) -> EngineEvent {
    let hoist1: TrackableTaskProgressChangedEvent = TrackableTaskProgressChangedEvent::clone(&this);
    (EngineEvent::TrackableTask {
        event: TrackableTaskEvent::ProgressChanged {
            progress_changed_event: hoist1,
        },
    })
}
