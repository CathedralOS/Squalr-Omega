module src::events::trackable_task::trackable_task_event;

use src::events::trackable_task::progress_changed::trackable_task_progress_changed_event::TrackableTaskProgressChangedEvent;
use src::events::engine_event::EngineEvent;

// Domain union for the trackable-task event surface — one leaf today.
pub data TrackableTaskEvent {
    case ProgressChanged(progress_changed_event: TrackableTaskProgressChangedEvent);
}

pub machine TrackableTaskEvent::default() -> TrackableTaskEvent {
    (TrackableTaskEvent::ProgressChanged { progress_changed_event: TrackableTaskProgressChangedEvent::default() })
}

pub machine TrackableTaskEvent::clone(&self) -> TrackableTaskEvent {
    transition self {
        TrackableTaskEvent::ProgressChanged { progress_changed_event } -> (TrackableTaskEvent::ProgressChanged {
            progress_changed_event: progress_changed_event.clone(),
        })
    }
}

pub machine TrackableTaskEvent::clone_from(&mut self, source: &TrackableTaskEvent) {
    self = source.clone();
}
