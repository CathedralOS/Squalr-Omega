module src::events::trackable_task::trackable_task_event;

use src::events::trackable_task::progress_changed::trackable_task_progress_changed_event::TrackableTaskProgressChangedEvent;
use src::events::engine_event::EngineEvent;

// Domain union for the trackable-task event surface — one leaf today.
pub data TrackableTaskEvent {
    case ProgressChanged(progress_changed_event: TrackableTaskProgressChangedEvent);
}

pub machine TrackableTaskEvent::default() -> TrackableTaskEvent {
    (TrackableTaskEvent::ProgressChanged { progress_changed_event: TrackableTaskProgressChangedEvent::default() })
}

pub machine TrackableTaskEvent::clone(this: &TrackableTaskEvent) -> TrackableTaskEvent {
    transition this {
        TrackableTaskEvent::ProgressChanged { progress_changed_event } -> at_changed(this, progress_changed_event)
    }
    state at_changed(this: &TrackableTaskEvent, progress_changed_event: TrackableTaskProgressChangedEvent) -> TrackableTaskEvent {
        let hoist1: TrackableTaskProgressChangedEvent = TrackableTaskProgressChangedEvent::clone(&progress_changed_event);
        (TrackableTaskEvent::ProgressChanged {
            progress_changed_event: hoist1,
        })
    }
}

pub machine TrackableTaskEvent::clone_from(this: &mut TrackableTaskEvent, source: &TrackableTaskEvent) {
    this = TrackableTaskEvent::clone(&source);
}
