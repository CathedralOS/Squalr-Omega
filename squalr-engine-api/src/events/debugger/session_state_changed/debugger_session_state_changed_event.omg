module src::events::debugger::session_state_changed::debugger_session_state_changed_event;

use src::events::debugger::debugger_event::DebuggerEvent;
use src::events::engine_event::EngineEvent;
use src::structures::debugger::debugger_session_state::DebuggerSessionState;

// Port of events/debugger/session_state_changed/debugger_session_state_changed_event.rs —
// {session_state, active_plugin_id: Option<String>} emitted on every
// session-state transition (attach/detach/pause/resume and trace-driven
// state changes).
pub data DebuggerSessionStateChangedEvent {
    session_state: DebuggerSessionState;
    has_active_plugin_id: bool;
    active_plugin_id: [u8; 64];
    active_plugin_id_len: u64;
}

pub machine DebuggerSessionStateChangedEvent::new(session_state: DebuggerSessionState) -> DebuggerSessionStateChangedEvent {
    DebuggerSessionStateChangedEvent {
        session_state: session_state,
        has_active_plugin_id: false,
        active_plugin_id_len: 0,
    }
}

pub machine DebuggerSessionStateChangedEvent::default() -> DebuggerSessionStateChangedEvent {
    DebuggerSessionStateChangedEvent::new(DebuggerSessionState::Detached)
}

pub machine DebuggerSessionStateChangedEvent::get_session_state(this: &DebuggerSessionStateChangedEvent) -> DebuggerSessionState {
    this.session_state
}

pub machine DebuggerSessionStateChangedEvent::has_active_plugin_id(this: &DebuggerSessionStateChangedEvent) -> bool {
    this.has_active_plugin_id
}

pub machine DebuggerSessionStateChangedEvent::get_active_plugin_id(this: &DebuggerSessionStateChangedEvent) -> &[u8] {
    transition this.has_active_plugin_id && this.active_plugin_id_len <= 64 {
        true -> (&this.active_plugin_id[0..this.active_plugin_id_len])
        _ -> (&this.active_plugin_id[0..0])
    }
}

pub machine DebuggerSessionStateChangedEvent::set_active_plugin_id(this: &mut DebuggerSessionStateChangedEvent, active_plugin_id: &[u8]) {
    transition 0 == 0 {
        _ -> copy_id(this, active_plugin_id, 0)
    }
    state copy_id(this: &mut DebuggerSessionStateChangedEvent, active_plugin_id: &[u8], position: u64) {
        transition position < active_plugin_id.len && position < 64 {
            true -> store_id(this, active_plugin_id, position)
            _ -> done_id(this, position)
        }
    }
    state store_id(this: &mut DebuggerSessionStateChangedEvent, active_plugin_id: &[u8], position: u64)
        requires position < active_plugin_id.len && position < 64 {
        this.active_plugin_id[position] = active_plugin_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(this, active_plugin_id, next)
        }
    }
    state done_id(this: &mut DebuggerSessionStateChangedEvent, position: u64) {
        this.active_plugin_id_len = position;
        this.has_active_plugin_id = true;
        transition 0 == 0 {
            _ -> (this)
        }
    }
}

pub machine DebuggerSessionStateChangedEvent::clear_active_plugin_id(this: &mut DebuggerSessionStateChangedEvent) {
    this.has_active_plugin_id = false;
    this.active_plugin_id_len = 0;
}

pub machine DebuggerSessionStateChangedEvent::clone(this: &DebuggerSessionStateChangedEvent) -> DebuggerSessionStateChangedEvent {
    let mut clone: DebuggerSessionStateChangedEvent = DebuggerSessionStateChangedEvent::new(this.session_state);
    DebuggerSessionStateChangedEvent::clone_from(&mut clone, this);
    (clone)
}

pub machine DebuggerSessionStateChangedEvent::clone_from(this: &mut DebuggerSessionStateChangedEvent, source: &DebuggerSessionStateChangedEvent) {
    this.session_state = source.session_state;
    this.has_active_plugin_id = source.has_active_plugin_id;
    this.active_plugin_id_len = source.active_plugin_id_len;
    transition 0 == 0 {
        _ -> copy_id(this, source, 0)
    }
    state copy_id(this: &mut DebuggerSessionStateChangedEvent, source: &DebuggerSessionStateChangedEvent, position: u64) {
        transition position < source.active_plugin_id_len && position < 64 {
            true -> store_id(this, source, position)
            _ -> (this)
        }
    }
    state store_id(this: &mut DebuggerSessionStateChangedEvent, source: &DebuggerSessionStateChangedEvent, position: u64)
        requires position < source.active_plugin_id_len && position < 64 {
        this.active_plugin_id[position] = source.active_plugin_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_id(this, source, next)
        }
    }
}

// Upstream `EngineEventRequest::to_engine_event` — two-level union wrap.
pub machine DebuggerSessionStateChangedEvent::to_engine_event(this: &DebuggerSessionStateChangedEvent) -> EngineEvent {
    let hoist1: DebuggerSessionStateChangedEvent = DebuggerSessionStateChangedEvent::clone(&this);
    (EngineEvent::Debugger {
        event: DebuggerEvent::SessionStateChanged {
            debugger_session_state_changed_event: hoist1,
        },
    })
}
