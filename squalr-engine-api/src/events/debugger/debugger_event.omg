module src::events::debugger::debugger_event;

use src::events::debugger::session_state_changed::debugger_session_state_changed_event::DebuggerSessionStateChangedEvent;
use src::events::debugger::trace_recorded::debugger_trace_recorded_event::DebuggerTraceRecordedEvent;
use src::events::debugger::trace_session_updated::debugger_trace_session_updated_event::DebuggerTraceSessionUpdatedEvent;

// Port of events/debugger/debugger_event.rs — the 3-case union the
// EngineEvent::Debugger arm carries.
pub data DebuggerEvent {
    case SessionStateChanged(debugger_session_state_changed_event: DebuggerSessionStateChangedEvent);
    case TraceRecorded(debugger_trace_recorded_event: DebuggerTraceRecordedEvent);
    case TraceSessionUpdated(debugger_trace_session_updated_event: DebuggerTraceSessionUpdatedEvent);
}

pub machine DebuggerEvent::clone(this: &DebuggerEvent) -> DebuggerEvent {
    transition this {
        DebuggerEvent::SessionStateChanged { debugger_session_state_changed_event } -> clone_session_state_changed(this, debugger_session_state_changed_event)
        DebuggerEvent::TraceRecorded { debugger_trace_recorded_event } -> clone_trace_recorded(this, debugger_trace_recorded_event)
        DebuggerEvent::TraceSessionUpdated { debugger_trace_session_updated_event } -> clone_updated(this, debugger_trace_session_updated_event)
        _ -> (DebuggerEvent::default())
    }
    state clone_session_state_changed(this: &DebuggerEvent, debugger_session_state_changed_event: DebuggerSessionStateChangedEvent) -> DebuggerEvent {
        let hoist1: DebuggerSessionStateChangedEvent = DebuggerSessionStateChangedEvent::clone(&debugger_session_state_changed_event);
        (DebuggerEvent::SessionStateChanged {
            debugger_session_state_changed_event: hoist1,
        })
    }
    state clone_trace_recorded(this: &DebuggerEvent, debugger_trace_recorded_event: DebuggerTraceRecordedEvent) -> DebuggerEvent {
        let hoist2: DebuggerTraceRecordedEvent = DebuggerTraceRecordedEvent::clone(&debugger_trace_recorded_event);
        (DebuggerEvent::TraceRecorded {
            debugger_trace_recorded_event: hoist2,
        })
    }
    state clone_updated(this: &DebuggerEvent, debugger_trace_session_updated_event: DebuggerTraceSessionUpdatedEvent) -> DebuggerEvent {
        let hoist3: DebuggerTraceSessionUpdatedEvent = DebuggerTraceSessionUpdatedEvent::clone(&debugger_trace_session_updated_event);
        (DebuggerEvent::TraceSessionUpdated {
            debugger_trace_session_updated_event: hoist3,
        })
    }
}

pub machine DebuggerEvent::clone_from(this: &mut DebuggerEvent, source: &DebuggerEvent) {
    let cloned: DebuggerEvent = DebuggerEvent::clone(&source);
    this = cloned;
}

pub machine DebuggerEvent::default() -> DebuggerEvent {
    (DebuggerEvent::SessionStateChanged {
        debugger_session_state_changed_event: DebuggerSessionStateChangedEvent::default(),
    })
}
