module src::events::debugger::debugger_event;

use src::events::debugger::session_state_changed::debugger_session_state_changed_event::DebuggerSessionStateChangedEvent;
use src::events::debugger::trace_recorded::debugger_trace_recorded_event::DebuggerTraceRecordedEvent;
use src::events::debugger::trace_session_updated::debugger_trace_session_updated_event::DebuggerTraceSessionUpdatedEvent;

// Port of events/debugger/debugger_event.rs — the 3-case union the
// EngineEvent::Debugger arm carries.
pub data DebuggerEvent {
    case SessionStateChanged(debugger_session_state_changed_event: DebuggerSessionStateChangedEvent);
    case TraceRecorded(debugger_trace_recorded_event: DebuggerTraceRecordedEvent);
    case TraceSessionUpdated(debugger_trace_session_updated_event: DebuggerTraceSessionUpdatedEvent);
}

pub machine DebuggerEvent::clone(debugger_event: &DebuggerEvent) -> DebuggerEvent {
    transition debugger_event {
        DebuggerEvent::SessionStateChanged { debugger_session_state_changed_event } -> clone_session_state_changed(debugger_event, debugger_session_state_changed_event)
        DebuggerEvent::TraceRecorded { debugger_trace_recorded_event } -> clone_trace_recorded(debugger_event, debugger_trace_recorded_event)
        DebuggerEvent::TraceSessionUpdated { debugger_trace_session_updated_event } -> clone_updated(debugger_event, debugger_trace_session_updated_event)
        _ -> (DebuggerEvent::default())
    }
    state clone_session_state_changed(debugger_event: &DebuggerEvent, debugger_session_state_changed_event: DebuggerSessionStateChangedEvent) -> DebuggerEvent {
        (DebuggerEvent::SessionStateChanged {
            debugger_session_state_changed_event: DebuggerSessionStateChangedEvent::clone(&debugger_session_state_changed_event),
        })
    }
    state clone_trace_recorded(debugger_event: &DebuggerEvent, debugger_trace_recorded_event: DebuggerTraceRecordedEvent) -> DebuggerEvent {
        (DebuggerEvent::TraceRecorded {
            debugger_trace_recorded_event: DebuggerTraceRecordedEvent::clone(&debugger_trace_recorded_event),
        })
    }
    state clone_updated(debugger_event: &DebuggerEvent, debugger_trace_session_updated_event: DebuggerTraceSessionUpdatedEvent) -> DebuggerEvent {
        (DebuggerEvent::TraceSessionUpdated {
            debugger_trace_session_updated_event: DebuggerTraceSessionUpdatedEvent::clone(&debugger_trace_session_updated_event),
        })
    }
}

pub machine DebuggerEvent::clone_from(debugger_event: &mut DebuggerEvent, source: &DebuggerEvent) {
    let cloned: DebuggerEvent = DebuggerEvent::clone(source);
    debugger_event = cloned;
}

pub machine DebuggerEvent::default() -> DebuggerEvent {
    (DebuggerEvent::SessionStateChanged {
        debugger_session_state_changed_event: DebuggerSessionStateChangedEvent::default(),
    })
}
