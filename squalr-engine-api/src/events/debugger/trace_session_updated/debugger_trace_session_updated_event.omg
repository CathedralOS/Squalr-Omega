module src::events::debugger::trace_session_updated::debugger_trace_session_updated_event;

use src::events::debugger::debugger_event::DebuggerEvent;
use src::events::engine_event::EngineEvent;
use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use src::structures::debugger::debugger_trace_instruction_record::DebuggerTraceInstructionRecord;
use src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;
use src::structures::bounded_append::append_debugger_trace_instruction_record;

// Port of events/debugger/trace_session_updated/debugger_trace_session_updated_event.rs —
// {trace_session, instruction_records} emitted when a trace session starts,
// stops, toggles collection, or records a hit. instruction_records carries a
// 16-entry bound (upstream Vec; a session update ships the session's own
// aggregation, still small).
pub data DebuggerTraceSessionUpdatedEvent {
    trace_session: DebuggerTraceSessionDescriptor;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

pub machine DebuggerTraceSessionUpdatedEvent::new(trace_session: DebuggerTraceSessionDescriptor) -> DebuggerTraceSessionUpdatedEvent {
    DebuggerTraceSessionUpdatedEvent {
        trace_session: trace_session,
        instruction_record_count: 0,
    }
}

pub machine DebuggerTraceSessionUpdatedEvent::default() -> DebuggerTraceSessionUpdatedEvent {
    DebuggerTraceSessionUpdatedEvent::new(DebuggerTraceSessionDescriptor::new(0, 0, DebuggerDataBreakpointAccess::Read, false))
}

pub machine DebuggerTraceSessionUpdatedEvent::get_trace_session(&self) -> &DebuggerTraceSessionDescriptor {
    (&self.trace_session)
}

pub machine DebuggerTraceSessionUpdatedEvent::get_instruction_record_count(&self) -> u64 {
    self.instruction_record_count
}

pub machine DebuggerTraceSessionUpdatedEvent::get_instruction_record(&self, position: u64) -> &DebuggerTraceInstructionRecord
    requires position < 16 {
    (&self.instruction_records[position])
}

pub machine DebuggerTraceSessionUpdatedEvent::add_instruction_record(&mut self, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
    append_debugger_trace_instruction_record(&mut self.instruction_records[0..16], &mut self.instruction_record_count, instruction_record)
}

pub machine DebuggerTraceSessionUpdatedEvent::clone(&self) -> DebuggerTraceSessionUpdatedEvent {
    let mut clone: DebuggerTraceSessionUpdatedEvent = DebuggerTraceSessionUpdatedEvent::new(self.trace_session.clone());
    clone.clone_from(self);
    (clone)
}

pub machine DebuggerTraceSessionUpdatedEvent::clone_from(&mut self, source: &DebuggerTraceSessionUpdatedEvent) {
    self.trace_session.clone_from(&source.trace_session);
    self.instruction_record_count = source.instruction_record_count;
    transition 0 == 0 {
        _ -> copy_records(source, 0)
    }
    state copy_records(&mut self, source: &DebuggerTraceSessionUpdatedEvent, position: u64) {
        transition position < source.instruction_record_count && position < 16 {
            true -> store(source, position)
            _ -> (self)
        }
    }
    state store(&mut self, source: &DebuggerTraceSessionUpdatedEvent, position: u64)
        requires position < source.instruction_record_count && position < 16 {
        self.instruction_records[position] = source.instruction_records[position].clone();
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_records(source, next)
        }
    }
}

// Upstream `EngineEventRequest::to_engine_event`.
pub machine DebuggerTraceSessionUpdatedEvent::to_engine_event(&self) -> EngineEvent {
    (EngineEvent::Debugger {
        event: DebuggerEvent::TraceSessionUpdated {
            debugger_trace_session_updated_event: self.clone(),
        },
    })
}
