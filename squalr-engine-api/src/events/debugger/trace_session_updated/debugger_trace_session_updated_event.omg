use src/events/debugger/debugger_event.omg;
use src/events/engine_event.omg;
use src/structures/debugger/debugger_data_breakpoint_access.omg;
use src/structures/debugger/debugger_trace_instruction_record.omg;
use src/structures/debugger/debugger_trace_session_descriptor.omg;

// Port of events/debugger/trace_session_updated/debugger_trace_session_updated_event.rs —
// {trace_session, instruction_records} emitted when a trace session starts,
// stops, toggles collection, or records a hit. instruction_records carries a
// 16-entry bound (upstream Vec; a session update ships the session's own
// aggregation, still small).
public data DebuggerTraceSessionUpdatedEvent {
    trace_session: |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor;
    instruction_records: [|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

public machine DebuggerTraceSessionUpdatedEvent::new(trace_session: |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor) -> DebuggerTraceSessionUpdatedEvent {
    DebuggerTraceSessionUpdatedEvent {
        trace_session: trace_session,
        instruction_record_count: 0,
    }
}

public machine DebuggerTraceSessionUpdatedEvent::default() -> DebuggerTraceSessionUpdatedEvent {
    DebuggerTraceSessionUpdatedEvent::new(|debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor::new(0, 0, |debugger_data_breakpoint_access|::DebuggerDataBreakpointAccess::Read, false))
}

public machine DebuggerTraceSessionUpdatedEvent::get_trace_session(this: &DebuggerTraceSessionUpdatedEvent) -> &|debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor {
    (&this.trace_session)
}

public machine DebuggerTraceSessionUpdatedEvent::get_instruction_record_count(this: &DebuggerTraceSessionUpdatedEvent) -> u64 {
    this.instruction_record_count
}

public machine DebuggerTraceSessionUpdatedEvent::get_instruction_record(this: &DebuggerTraceSessionUpdatedEvent, position: u64) -> &|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord
    requires position < 16 {
    (&this.instruction_records[position])
}

public machine DebuggerTraceSessionUpdatedEvent::add_instruction_record(this: &mut DebuggerTraceSessionUpdatedEvent, instruction_record: &|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord) -> bool {
    transition this.instruction_record_count < 16 {
        true -> store(this, instruction_record)
        false -> (false)
    }
    machine store(this: &mut DebuggerTraceSessionUpdatedEvent, instruction_record: &|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord) -> bool {
        |debugger_trace_instruction_record|::DebuggerTraceInstructionRecord::clone_from(&mut this.instruction_records[this.instruction_record_count], instruction_record);
        this.instruction_record_count = ((this.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

public machine DebuggerTraceSessionUpdatedEvent::clone(this: &DebuggerTraceSessionUpdatedEvent) -> DebuggerTraceSessionUpdatedEvent {
    let hoist1: |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor = |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor::clone(&this.trace_session);
    let mut clone: DebuggerTraceSessionUpdatedEvent = DebuggerTraceSessionUpdatedEvent::new(hoist1);
    DebuggerTraceSessionUpdatedEvent::clone_from(&mut clone, this);
    (clone)
}

public machine DebuggerTraceSessionUpdatedEvent::clone_from(this: &mut DebuggerTraceSessionUpdatedEvent, source: &DebuggerTraceSessionUpdatedEvent) {
    |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor::clone_from(&mut this.trace_session, &source.trace_session);
    this.instruction_record_count = source.instruction_record_count;
    transition 0 == 0 {
        _ -> copy_records(this, source, 0)
    }
    machine copy_records(this: &mut DebuggerTraceSessionUpdatedEvent, source: &DebuggerTraceSessionUpdatedEvent, position: u64) {
        transition position < source.instruction_record_count && position < 16 {
            true -> store(this, source, position)
            _ -> {}
        }
    }
    machine store(this: &mut DebuggerTraceSessionUpdatedEvent, source: &DebuggerTraceSessionUpdatedEvent, position: u64)
        requires position < source.instruction_record_count && position < 16 {
        this.instruction_records[position] = |debugger_trace_instruction_record|::DebuggerTraceInstructionRecord::clone(&source.instruction_records[position]);
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_records(this, source, next)
        }
    }
}

// Upstream `EngineEventRequest::to_engine_event`.
public machine DebuggerTraceSessionUpdatedEvent::to_engine_event(this: &DebuggerTraceSessionUpdatedEvent) -> |engine_event|::EngineEvent {
    let hoist2: DebuggerTraceSessionUpdatedEvent = DebuggerTraceSessionUpdatedEvent::clone(&this);
    (|engine_event|::EngineEvent::Debugger {
        event: |debugger_event|::DebuggerEvent::TraceSessionUpdated {
            debugger_trace_session_updated_event: hoist2,
        },
    })
}
