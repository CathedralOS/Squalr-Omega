module src::events::debugger::trace_session_updated::debugger_trace_session_updated_event;

use src::events::debugger::debugger_event::DebuggerEvent;
use src::events::engine_event::EngineEvent;
use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use src::structures::debugger::debugger_trace_instruction_record::DebuggerTraceInstructionRecord;
use src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;

// Port of events/debugger/trace_session_updated/debugger_trace_session_updated_event.rs —
// {trace_session, instruction_records} emitted when a trace session starts,
// stops, toggles collection, or records a hit. instruction_records carries a
// 16-entry bound (upstream Vec; a session update ships the session's own
// aggregation, still small).
pub data DebuggerTraceSessionUpdatedEvent {
    trace_session: DebuggerTraceSessionDescriptor;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

pub machine DebuggerTraceSessionUpdatedEvent::new(trace_session: DebuggerTraceSessionDescriptor) -> DebuggerTraceSessionUpdatedEvent {
    DebuggerTraceSessionUpdatedEvent {
        trace_session: trace_session,
        instruction_record_count: 0,
    }
}

pub machine DebuggerTraceSessionUpdatedEvent::default() -> DebuggerTraceSessionUpdatedEvent {
    DebuggerTraceSessionUpdatedEvent::new(DebuggerTraceSessionDescriptor::new(0, 0, DebuggerDataBreakpointAccess::Read, false))
}

pub machine DebuggerTraceSessionUpdatedEvent::get_trace_session(this: &DebuggerTraceSessionUpdatedEvent) -> &DebuggerTraceSessionDescriptor {
    (&this.trace_session)
}

pub machine DebuggerTraceSessionUpdatedEvent::get_instruction_record_count(this: &DebuggerTraceSessionUpdatedEvent) -> u64 {
    this.instruction_record_count
}

pub machine DebuggerTraceSessionUpdatedEvent::get_instruction_record(this: &DebuggerTraceSessionUpdatedEvent, position: u64) -> &DebuggerTraceInstructionRecord
    requires position < 16 {
    (&this.instruction_records[position])
}

pub machine DebuggerTraceSessionUpdatedEvent::add_instruction_record(this: &mut DebuggerTraceSessionUpdatedEvent, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
    transition this.instruction_record_count < 16 {
        true -> store(this, instruction_record)
        false -> (false)
    }
    state store(this: &mut DebuggerTraceSessionUpdatedEvent, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
        DebuggerTraceInstructionRecord::clone_from(&mut this.instruction_records[this.instruction_record_count], instruction_record);
        this.instruction_record_count = ((this.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

pub machine DebuggerTraceSessionUpdatedEvent::clone(this: &DebuggerTraceSessionUpdatedEvent) -> DebuggerTraceSessionUpdatedEvent {
    let hoist1: DebuggerTraceSessionDescriptor = DebuggerTraceSessionDescriptor::clone(&this.trace_session);
    let mut clone: DebuggerTraceSessionUpdatedEvent = DebuggerTraceSessionUpdatedEvent::new(hoist1);
    DebuggerTraceSessionUpdatedEvent::clone_from(&mut clone, this);
    (clone)
}

pub machine DebuggerTraceSessionUpdatedEvent::clone_from(this: &mut DebuggerTraceSessionUpdatedEvent, source: &DebuggerTraceSessionUpdatedEvent) {
    DebuggerTraceSessionDescriptor::clone_from(&mut this.trace_session, &source.trace_session);
    this.instruction_record_count = source.instruction_record_count;
    transition 0 == 0 {
        _ -> copy_records(this, source, 0)
    }
    state copy_records(this: &mut DebuggerTraceSessionUpdatedEvent, source: &DebuggerTraceSessionUpdatedEvent, position: u64) {
        transition position < source.instruction_record_count && position < 16 {
            true -> store(this, source, position)
            _ -> (this)
        }
    }
    state store(this: &mut DebuggerTraceSessionUpdatedEvent, source: &DebuggerTraceSessionUpdatedEvent, position: u64)
        requires position < source.instruction_record_count && position < 16 {
        this.instruction_records[position] = DebuggerTraceInstructionRecord::clone(&source.instruction_records[position]);
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy_records(this, source, next)
        }
    }
}

// Upstream `EngineEventRequest::to_engine_event`.
pub machine DebuggerTraceSessionUpdatedEvent::to_engine_event(this: &DebuggerTraceSessionUpdatedEvent) -> EngineEvent {
    let hoist2: DebuggerTraceSessionUpdatedEvent = DebuggerTraceSessionUpdatedEvent::clone(&this);
    (EngineEvent::Debugger {
        event: DebuggerEvent::TraceSessionUpdated {
            debugger_trace_session_updated_event: hoist2,
        },
    })
}
