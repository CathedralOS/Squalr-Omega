module src::events::debugger::trace_recorded::debugger_trace_recorded_event;

use src::events::debugger::debugger_event::DebuggerEvent;
use src::events::engine_event::EngineEvent;
use src::structures::debugger::debugger_trace_event::DebuggerTraceEvent;

// Port of events/debugger/trace_recorded/debugger_trace_recorded_event.rs —
// {trace_event} emitted for every trace event the active session's backend
// reports.
pub data DebuggerTraceRecordedEvent {
    trace_event: DebuggerTraceEvent;
}

pub machine DebuggerTraceRecordedEvent::new(trace_event: DebuggerTraceEvent) -> DebuggerTraceRecordedEvent {
    DebuggerTraceRecordedEvent {
        trace_event: trace_event,
    }
}

pub machine DebuggerTraceRecordedEvent::default() -> DebuggerTraceRecordedEvent {
    DebuggerTraceRecordedEvent::new(DebuggerTraceEvent::new())
}

pub machine DebuggerTraceRecordedEvent::get_trace_event(debugger_trace_recorded_event: &DebuggerTraceRecordedEvent) -> &DebuggerTraceEvent {
    (&debugger_trace_recorded_event.trace_event)
}

pub machine DebuggerTraceRecordedEvent::clone(debugger_trace_recorded_event: &DebuggerTraceRecordedEvent) -> DebuggerTraceRecordedEvent {
    DebuggerTraceRecordedEvent {
        trace_event: DebuggerTraceEvent::clone(&debugger_trace_recorded_event.trace_event),
    }
}

pub machine DebuggerTraceRecordedEvent::clone_from(debugger_trace_recorded_event: &mut DebuggerTraceRecordedEvent, source: &DebuggerTraceRecordedEvent) {
    DebuggerTraceEvent::clone_from(&mut debugger_trace_recorded_event.trace_event, &source.trace_event);
}

// Upstream `EngineEventRequest::to_engine_event`.
pub machine DebuggerTraceRecordedEvent::to_engine_event(debugger_trace_recorded_event: &DebuggerTraceRecordedEvent) -> EngineEvent {
    (EngineEvent::Debugger {
        event: DebuggerEvent::TraceRecorded {
            debugger_trace_recorded_event: DebuggerTraceRecordedEvent::clone(debugger_trace_recorded_event),
        },
    })
}
