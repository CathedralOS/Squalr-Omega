module src::events::process::process_event;

use src::events::process::changed::process_changed_event::ProcessChangedEvent;
use src::events::engine_event::EngineEvent;

// Domain union for the process event surface — one leaf today.
public data ProcessEvent {
    case ProcessChanged(process_changed_event: ProcessChangedEvent);
}

public machine ProcessEvent::default() -> ProcessEvent {
    (ProcessEvent::ProcessChanged { process_changed_event: ProcessChangedEvent::default() })
}

public machine ProcessEvent::clone(this: &ProcessEvent) -> ProcessEvent {
    transition this {
        ProcessEvent::ProcessChanged { process_changed_event } -> at_changed(this, process_changed_event)
    }
    state at_changed(this: &ProcessEvent, process_changed_event: ProcessChangedEvent) -> ProcessEvent {
        let hoist1: ProcessChangedEvent = ProcessChangedEvent::clone(&process_changed_event);
        (ProcessEvent::ProcessChanged {
            process_changed_event: hoist1,
        })
    }
}

public machine ProcessEvent::clone_from(this: &mut ProcessEvent, source: &ProcessEvent) {
    this = ProcessEvent::clone(&source);
}
