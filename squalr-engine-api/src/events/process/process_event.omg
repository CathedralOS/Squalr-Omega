module src::events::process::process_event;

use src::events::process::changed::process_changed_event::ProcessChangedEvent;
use src::events::engine_event::EngineEvent;

// Domain union for the process event surface — one leaf today.
pub data ProcessEvent {
    case ProcessChanged(process_changed_event: ProcessChangedEvent);
}

pub machine ProcessEvent::default() -> ProcessEvent {
    (ProcessEvent::ProcessChanged { process_changed_event: ProcessChangedEvent::default() })
}

pub machine ProcessEvent::clone(process_event: &ProcessEvent) -> ProcessEvent {
    transition process_event {
        ProcessEvent::ProcessChanged { process_changed_event } -> (ProcessEvent::ProcessChanged {
            process_changed_event: ProcessChangedEvent::clone(&process_changed_event),
        })
    }
}

pub machine ProcessEvent::clone_from(process_event: &mut ProcessEvent, source: &ProcessEvent) {
    process_event = ProcessEvent::clone(source);
}
