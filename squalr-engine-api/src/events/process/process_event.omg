use src/events/process/changed/process_changed_event.omg;
use src/events/engine_event.omg;

// Domain union for the process event surface — one leaf today.
public data ProcessEvent {
    case ProcessChanged(process_changed_event: |process_changed_event|::ProcessChangedEvent);
}

public machine ProcessEvent::default() -> ProcessEvent {
    (ProcessEvent::ProcessChanged { process_changed_event: |process_changed_event|::ProcessChangedEvent::default() })
}

public machine ProcessEvent::clone(this: &ProcessEvent) -> ProcessEvent {
    transition this {
        ProcessEvent::ProcessChanged { process_changed_event } -> at_changed(this, &process_changed_event)
    }
    machine at_changed(this: &ProcessEvent, process_changed_event: &|process_changed_event|::ProcessChangedEvent) -> ProcessEvent {
        let hoist1: |process_changed_event|::ProcessChangedEvent = |process_changed_event|::ProcessChangedEvent::clone(&process_changed_event);
        (ProcessEvent::ProcessChanged {
            process_changed_event: hoist1,
        })
    }
}

public machine ProcessEvent::clone_from(this: &mut ProcessEvent, source: &ProcessEvent) {
    this = ProcessEvent::clone(&source);
}
