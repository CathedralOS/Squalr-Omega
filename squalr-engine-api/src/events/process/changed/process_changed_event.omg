use src/structures/processes/opened_process_info.omg;
use src/structures/memory/bitness.omg;
use src/events/engine_event.omg;
use src/events/process/process_event.omg;

// Upstream ProcessChangedEvent — carries Option<OpenedProcessInfo>.
public data ProcessChangedEvent {
    has_process_info: bool;
    process_info: |opened_process_info|::OpenedProcessInfo;
}

public machine ProcessChangedEvent::default() -> ProcessChangedEvent {
    (ProcessChangedEvent {
        has_process_info: false,
        process_info: |opened_process_info|::OpenedProcessInfo::new(0, "", 0, 0, |bitness|::Bitness::Bit64),
    })
}

public machine ProcessChangedEvent::new(process_info: &|opened_process_info|::OpenedProcessInfo, has_process_info: bool) -> ProcessChangedEvent {
    let mut created: ProcessChangedEvent = ProcessChangedEvent::default();
    created.has_process_info = has_process_info;
    created.process_info = process_info;
    (created)
}

public machine ProcessChangedEvent::empty() -> ProcessChangedEvent {
    (ProcessChangedEvent::default())
}

public machine ProcessChangedEvent::get_has_process_info(this: &ProcessChangedEvent) -> bool {
    this.has_process_info
}

public machine ProcessChangedEvent::get_process_info(this: &ProcessChangedEvent) -> &|opened_process_info|::OpenedProcessInfo {
    (&this.process_info)
}

public machine ProcessChangedEvent::clone(this: &ProcessChangedEvent) -> ProcessChangedEvent {
    (ProcessChangedEvent {
        has_process_info: this.has_process_info,
        process_info: this.process_info,
    })
}

public machine ProcessChangedEvent::clone_from(this: &mut ProcessChangedEvent, source: &ProcessChangedEvent) {
    this = ProcessChangedEvent::clone(&source);
}

public machine ProcessChangedEvent::to_engine_event(this: &ProcessChangedEvent) -> |engine_event|::EngineEvent {
    let hoist1: ProcessChangedEvent = ProcessChangedEvent::clone(&this);
    (|engine_event|::EngineEvent::Process {
        event: |process_event|::ProcessEvent::ProcessChanged {
            process_changed_event: hoist1,
        },
    })
}
