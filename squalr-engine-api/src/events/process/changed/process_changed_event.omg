module src::events::process::changed::process_changed_event;

use src::structures::processes::opened_process_info::OpenedProcessInfo;
use src::structures::memory::bitness::Bitness;
use src::events::engine_event::EngineEvent;
use src::events::process::process_event::ProcessEvent;

// Upstream ProcessChangedEvent — carries Option<OpenedProcessInfo>.
pub data ProcessChangedEvent {
    has_process_info: bool;
    process_info: OpenedProcessInfo;
}

pub machine ProcessChangedEvent::default() -> ProcessChangedEvent {
    (ProcessChangedEvent {
        has_process_info: false,
        process_info: OpenedProcessInfo::new(0, "", 0, 0, Bitness::Bit64),
    })
}

pub machine ProcessChangedEvent::new(process_info: &OpenedProcessInfo, has_process_info: bool) -> ProcessChangedEvent {
    let mut created: ProcessChangedEvent = ProcessChangedEvent::default();
    created.has_process_info = has_process_info;
    created.process_info = process_info;
    (created)
}

pub machine ProcessChangedEvent::empty() -> ProcessChangedEvent {
    (ProcessChangedEvent::default())
}

pub machine ProcessChangedEvent::get_has_process_info(this: &ProcessChangedEvent) -> bool {
    this.has_process_info
}

pub machine ProcessChangedEvent::get_process_info(this: &ProcessChangedEvent) -> &OpenedProcessInfo {
    (&this.process_info)
}

pub machine ProcessChangedEvent::clone(this: &ProcessChangedEvent) -> ProcessChangedEvent {
    (ProcessChangedEvent {
        has_process_info: this.has_process_info,
        process_info: this.process_info,
    })
}

pub machine ProcessChangedEvent::clone_from(this: &mut ProcessChangedEvent, source: &ProcessChangedEvent) {
    this = ProcessChangedEvent::clone(&source);
}

pub machine ProcessChangedEvent::to_engine_event(this: &ProcessChangedEvent) -> EngineEvent {
    let hoist1: ProcessChangedEvent = ProcessChangedEvent::clone(&this);
    (EngineEvent::Process {
        event: ProcessEvent::ProcessChanged {
            process_changed_event: hoist1,
        },
    })
}
