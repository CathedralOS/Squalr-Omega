module src::events::engine_event;

use src::events::debugger::debugger_event::DebuggerEvent;
use src::events::logging::logging_event::LoggingEvent;
use src::events::plugins::plugins_event::PluginsEvent;
use src::events::process::process_event::ProcessEvent;
use src::events::project::project_event::ProjectEvent;
use src::events::project_items::project_items_event::ProjectItemsEvent;
use src::events::registry::registry_event::RegistryEvent;
use src::events::scan_results::scan_results_event::ScanResultsEvent;
use src::events::trackable_task::trackable_task_event::TrackableTaskEvent;

// Port of events/engine_event.rs — the top-level event union every engine
// dispatch wraps in. Upstream carries nine families (Debugger, Logging,
// Plugins, Process, Project, ProjectItems, Registry, TrackableTask,
// ScanResults); arms land with each family's own leg — ScanResults shipped
// with the scan path, Registry with the registry domain, Plugins with the
// plugins domain.
pub data EngineEvent {
    case ScanResults(event: ScanResultsEvent);
    case Registry(event: RegistryEvent);
    case Plugins(event: PluginsEvent);
    case Debugger(event: DebuggerEvent);
    case Logging(event: LoggingEvent);
    case Process(event: ProcessEvent);
    case Project(event: ProjectEvent);
    case ProjectItems(event: ProjectItemsEvent);
    case TrackableTask(event: TrackableTaskEvent);
}

// Upstream `Clone::clone` — the union rebuilds the active case by moving
// the cloned payload through a state (same shape as ScanResult::clone).
pub machine EngineEvent::clone(engine_event: &EngineEvent) -> EngineEvent {
    transition engine_event {
        EngineEvent::ScanResults { event } -> clone_scan_results(engine_event, event)
        EngineEvent::Registry { event } -> clone_registry(engine_event, event)
        EngineEvent::Plugins { event } -> clone_plugins(engine_event, event)
        EngineEvent::Debugger { event } -> clone_debugger(engine_event, event)
        EngineEvent::Logging { event } -> clone_logging(engine_event, event)
        EngineEvent::Process { event } -> clone_process(engine_event, event)
        EngineEvent::Project { event } -> clone_project(engine_event, event)
        EngineEvent::ProjectItems { event } -> clone_project_items(engine_event, event)
        EngineEvent::TrackableTask { event } -> clone_trackable_task(engine_event, event)
        _ -> (EngineEvent::default())
    }
    state clone_scan_results(engine_event: &EngineEvent, event: ScanResultsEvent) -> EngineEvent {
        EngineEvent::ScanResults {
            event: ScanResultsEvent::clone(&event)
        }
    }
    state clone_registry(engine_event: &EngineEvent, event: RegistryEvent) -> EngineEvent {
        EngineEvent::Registry {
            event: RegistryEvent::clone(&event)
        }
    }
    state clone_plugins(engine_event: &EngineEvent, event: PluginsEvent) -> EngineEvent {
        EngineEvent::Plugins {
            event: PluginsEvent::clone(&event)
        }
    }
    state clone_debugger(engine_event: &EngineEvent, event: DebuggerEvent) -> EngineEvent {
        EngineEvent::Debugger {
            event: DebuggerEvent::clone(&event)
        }
    }
    state clone_logging(engine_event: &EngineEvent, event: LoggingEvent) -> EngineEvent {
        EngineEvent::Logging {
            event: LoggingEvent::clone(&event)
        }
    }
    state clone_process(engine_event: &EngineEvent, event: ProcessEvent) -> EngineEvent {
        EngineEvent::Process {
            event: ProcessEvent::clone(&event)
        }
    }
    state clone_project(engine_event: &EngineEvent, event: ProjectEvent) -> EngineEvent {
        EngineEvent::Project {
            event: ProjectEvent::clone(&event)
        }
    }
    state clone_project_items(engine_event: &EngineEvent, event: ProjectItemsEvent) -> EngineEvent {
        EngineEvent::ProjectItems {
            event: ProjectItemsEvent::clone(&event)
        }
    }
    state clone_trackable_task(engine_event: &EngineEvent, event: TrackableTaskEvent) -> EngineEvent {
        EngineEvent::TrackableTask {
            event: TrackableTaskEvent::clone(&event)
        }
    }
}

pub machine EngineEvent::clone_from(engine_event: &mut EngineEvent, source: &EngineEvent) {
    let cloned: EngineEvent = EngineEvent::clone(source);
    engine_event = cloned;
}

pub machine EngineEvent::default() -> EngineEvent {
    EngineEvent::ScanResults { event: ScanResultsEvent::default() }
}
