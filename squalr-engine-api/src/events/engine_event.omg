use src/events/debugger/debugger_event.omg;
use src/events/logging/logging_event.omg;
use src/events/plugins/plugins_event.omg;
use src/events/process/process_event.omg;
use src/events/project/project_event.omg;
use src/events/project_items/project_items_event.omg;
use src/events/registry/registry_event.omg;
use src/events/scan_results/scan_results_event.omg;
use src/events/trackable_task/trackable_task_event.omg;

// Port of events/engine_event.rs — the top-level event union every engine
// dispatch wraps in. Upstream carries nine families (Debugger, Logging,
// Plugins, Process, Project, ProjectItems, Registry, TrackableTask,
// ScanResults); arms land with each family's own leg — ScanResults shipped
// with the scan path, Registry with the registry domain, Plugins with the
// plugins domain.
public data EngineEvent {
    case ScanResults(event: |scan_results_event|::ScanResultsEvent);
    case Registry(event: |registry_event|::RegistryEvent);
    case Plugins(event: |plugins_event|::PluginsEvent);
    case Debugger(event: |debugger_event|::DebuggerEvent);
    case Logging(event: |logging_event|::LoggingEvent);
    case Process(event: |process_event|::ProcessEvent);
    case Project(event: |project_event|::ProjectEvent);
    case ProjectItems(event: |project_items_event|::ProjectItemsEvent);
    case TrackableTask(event: |trackable_task_event|::TrackableTaskEvent);
}

// Upstream `Clone::clone` — the union rebuilds the active case by moving
// the cloned payload through a state (same shape as ScanResult::clone).
public machine EngineEvent::clone(this: &EngineEvent) -> EngineEvent {
    transition this {
        EngineEvent::ScanResults { event } -> clone_scan_results(this, &event)
        EngineEvent::Registry { event } -> clone_registry(this, &event)
        EngineEvent::Plugins { event } -> clone_plugins(this, &event)
        EngineEvent::Debugger { event } -> clone_debugger(this, &event)
        EngineEvent::Logging { event } -> clone_logging(this, &event)
        EngineEvent::Process { event } -> clone_process(this, &event)
        EngineEvent::Project { event } -> clone_project(this, &event)
        EngineEvent::ProjectItems { event } -> clone_project_items(this, &event)
        EngineEvent::TrackableTask { event } -> clone_trackable_task(this, &event)
        _ -> (EngineEvent::default())
    }
    machine clone_scan_results(this: &EngineEvent, event: &|scan_results_event|::ScanResultsEvent) -> EngineEvent {
        EngineEvent::ScanResults {
            event: |scan_results_event|::ScanResultsEvent::clone(&event)
        }
    }
    machine clone_registry(this: &EngineEvent, event: &|registry_event|::RegistryEvent) -> EngineEvent {
        EngineEvent::Registry {
            event: |registry_event|::RegistryEvent::clone(&event)
        }
    }
    machine clone_plugins(this: &EngineEvent, event: &|plugins_event|::PluginsEvent) -> EngineEvent {
        EngineEvent::Plugins {
            event: |plugins_event|::PluginsEvent::clone(&event)
        }
    }
    machine clone_debugger(this: &EngineEvent, event: &|debugger_event|::DebuggerEvent) -> EngineEvent {
        EngineEvent::Debugger {
            event: |debugger_event|::DebuggerEvent::clone(&event)
        }
    }
    machine clone_logging(this: &EngineEvent, event: &|logging_event|::LoggingEvent) -> EngineEvent {
        EngineEvent::Logging {
            event: |logging_event|::LoggingEvent::clone(&event)
        }
    }
    machine clone_process(this: &EngineEvent, event: &|process_event|::ProcessEvent) -> EngineEvent {
        EngineEvent::Process {
            event: |process_event|::ProcessEvent::clone(&event)
        }
    }
    machine clone_project(this: &EngineEvent, event: &|project_event|::ProjectEvent) -> EngineEvent {
        EngineEvent::Project {
            event: |project_event|::ProjectEvent::clone(&event)
        }
    }
    machine clone_project_items(this: &EngineEvent, event: &|project_items_event|::ProjectItemsEvent) -> EngineEvent {
        EngineEvent::ProjectItems {
            event: |project_items_event|::ProjectItemsEvent::clone(&event)
        }
    }
    machine clone_trackable_task(this: &EngineEvent, event: &|trackable_task_event|::TrackableTaskEvent) -> EngineEvent {
        EngineEvent::TrackableTask {
            event: |trackable_task_event|::TrackableTaskEvent::clone(&event)
        }
    }
}

public machine EngineEvent::clone_from(this: &mut EngineEvent, source: &EngineEvent) {
    let cloned: EngineEvent = EngineEvent::clone(&source);
    this = cloned;
}

public machine EngineEvent::default() -> EngineEvent {
    EngineEvent::ScanResults { event: |scan_results_event|::ScanResultsEvent::default() }
}
