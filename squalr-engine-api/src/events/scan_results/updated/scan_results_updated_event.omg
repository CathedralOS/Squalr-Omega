module src::events::scan_results::updated::scan_results_updated_event;

use src::events::engine_event::EngineEvent;
use src::events::scan_results::scan_results_event::ScanResultsEvent;

// Port of events/scan_results/updated/scan_results_updated_event.rs —
// emitted whenever the scan result set changes: a fresh scan seeded
// (`is_new_scan`), a successive scan ran, results were deleted, or the
// snapshot was reset. Subscribers use it to invalidate cached result pages.
pub data ScanResultsUpdatedEvent {
    is_new_scan: bool;
}

pub machine ScanResultsUpdatedEvent::new(is_new_scan: bool) -> ScanResultsUpdatedEvent {
    ScanResultsUpdatedEvent {
        is_new_scan: is_new_scan,
    }
}

pub machine ScanResultsUpdatedEvent::default() -> ScanResultsUpdatedEvent {
    ScanResultsUpdatedEvent {
        is_new_scan: false,
    }
}

pub machine ScanResultsUpdatedEvent::clone(scan_results_updated_event: &ScanResultsUpdatedEvent) -> ScanResultsUpdatedEvent {
    ScanResultsUpdatedEvent {
        is_new_scan: scan_results_updated_event.is_new_scan,
    }
}

pub machine ScanResultsUpdatedEvent::clone_from(scan_results_updated_event: &mut ScanResultsUpdatedEvent, source: &ScanResultsUpdatedEvent) {
    scan_results_updated_event.is_new_scan = source.is_new_scan;
}

// Upstream `EngineEventRequest::to_engine_event` — wraps the payload in
// the two-level union the dispatch seam carries.
pub machine ScanResultsUpdatedEvent::to_engine_event(scan_results_updated_event: &ScanResultsUpdatedEvent) -> EngineEvent {
    EngineEvent::ScanResults {
        event: ScanResultsEvent::ScanResultsUpdated {
            scan_results_updated_event: ScanResultsUpdatedEvent::clone(scan_results_updated_event),
        },
    }
}
