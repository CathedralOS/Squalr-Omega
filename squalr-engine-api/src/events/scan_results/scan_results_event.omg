module src::events::scan_results::scan_results_event;

use src::events::scan_results::updated::scan_results_updated_event::ScanResultsUpdatedEvent;

// Port of events/scan_results/scan_results_event.rs — 1:1 (the upstream
// union has exactly one variant).
pub data ScanResultsEvent {
    case ScanResultsUpdated(scan_results_updated_event: ScanResultsUpdatedEvent);
}

pub machine ScanResultsEvent::clone(scan_results_event: &ScanResultsEvent) -> ScanResultsEvent {
    transition scan_results_event {
        ScanResultsEvent::ScanResultsUpdated { scan_results_updated_event } -> clone_updated(scan_results_event, scan_results_updated_event)
        _ -> (ScanResultsEvent::default())
    }
    state clone_updated(scan_results_event: &ScanResultsEvent, scan_results_updated_event: ScanResultsUpdatedEvent) -> ScanResultsEvent {
        ScanResultsEvent::ScanResultsUpdated {
            scan_results_updated_event: ScanResultsUpdatedEvent::clone(&scan_results_updated_event)
        }
    }
}

pub machine ScanResultsEvent::clone_from(scan_results_event: &mut ScanResultsEvent, source: &ScanResultsEvent) {
    let cloned: ScanResultsEvent = ScanResultsEvent::clone(source);
    scan_results_event = cloned;
}

pub machine ScanResultsEvent::default() -> ScanResultsEvent {
    ScanResultsEvent::ScanResultsUpdated {
        scan_results_updated_event: ScanResultsUpdatedEvent::default()
    }
}
