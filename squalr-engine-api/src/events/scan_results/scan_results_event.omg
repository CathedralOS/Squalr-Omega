pub machine ScanResultsEvent::clone(this: &ScanResultsEvent) -> ScanResultsEvent {
    transition this {
        ScanResultsEvent::ScanResultsUpdated { scan_results_updated_event } -> clone_updated(this, scan_results_updated_event)
