module src::events::plugins::changed::plugins_changed_event;

use src::events::engine_event::EngineEvent;
use src::events::plugins::plugins_event::PluginsEvent;

// Port of events/plugins/changed/plugins_changed_event.rs — emitted when
// a plugin is enabled/disabled or the plugin order changes. Upstream
// payload is empty (`struct PluginsChangedEvent {}`).
pub data PluginsChangedEvent {
}

pub machine PluginsChangedEvent::new() -> PluginsChangedEvent {
    (PluginsChangedEvent {})
}

pub machine PluginsChangedEvent::default() -> PluginsChangedEvent {
    (PluginsChangedEvent {})
}

pub machine PluginsChangedEvent::clone(this: &PluginsChangedEvent) -> PluginsChangedEvent {
    (PluginsChangedEvent {})
}

pub machine PluginsChangedEvent::clone_from(this: &mut PluginsChangedEvent, source: &PluginsChangedEvent) {
}

// Upstream `EngineEventRequest::to_engine_event` — wraps the payload in
// the two-level union the dispatch seam carries.
pub machine PluginsChangedEvent::to_engine_event(this: &PluginsChangedEvent) -> EngineEvent {
    let hoist1: PluginsChangedEvent = PluginsChangedEvent::clone(&this);
    (EngineEvent::Plugins {
        event: PluginsEvent::PluginsChanged {
            plugins_changed_event: hoist1,
        },
    })
}
