use src/events/engine_event.omg;
use src/events/plugins/plugins_event.omg;

// Port of events/plugins/changed/plugins_changed_event.rs — emitted when
// a plugin is enabled/disabled or the plugin order changes. Upstream
// payload is empty (`struct PluginsChangedEvent {}`).
public data PluginsChangedEvent {
}

public machine PluginsChangedEvent::new() -> PluginsChangedEvent {
    (PluginsChangedEvent {})
}

public machine PluginsChangedEvent::default() -> PluginsChangedEvent {
    (PluginsChangedEvent {})
}

public machine PluginsChangedEvent::clone(this: &PluginsChangedEvent) -> PluginsChangedEvent {
    (PluginsChangedEvent {})
}

public machine PluginsChangedEvent::clone_from(this: &mut PluginsChangedEvent, source: &PluginsChangedEvent) {
}

// Upstream `EngineEventRequest::to_engine_event` — wraps the payload in
// the two-level union the dispatch seam carries.
public machine PluginsChangedEvent::to_engine_event(this: &PluginsChangedEvent) -> |engine_event|::EngineEvent {
    let hoist1: PluginsChangedEvent = PluginsChangedEvent::clone(&this);
    (|engine_event|::EngineEvent::Plugins {
        event: |plugins_event|::PluginsEvent::PluginsChanged {
            plugins_changed_event: hoist1,
        },
    })
}
