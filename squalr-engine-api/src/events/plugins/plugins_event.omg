// Port of events/plugins/plugins_event.rs — 1:1 (the upstream union has
// exactly one variant).
pub data PluginsEvent {
    case PluginsChanged(plugins_changed_event: PluginsChangedEvent);
}

pub machine PluginsEvent::clone(&self) -> PluginsEvent {
    transition self {
        PluginsEvent::PluginsChanged { plugins_changed_event } -> clone_changed(plugins_changed_event)
        _ -> (PluginsEvent::default())
    }
    state clone_changed(&self, plugins_changed_event: PluginsChangedEvent) -> PluginsEvent {
        (PluginsEvent::PluginsChanged {
            plugins_changed_event: PluginsChangedEvent::clone(&plugins_changed_event)
        })
    }
}

pub machine PluginsEvent::clone_from(&mut self, source: &PluginsEvent) {
    let cloned: PluginsEvent = source.clone();
    self = cloned;
}

pub machine PluginsEvent::default() -> PluginsEvent {
    (PluginsEvent::PluginsChanged {
        plugins_changed_event: PluginsChangedEvent::default()
    })
}
