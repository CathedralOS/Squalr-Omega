module src::events::plugins::plugins_event;

use src::events::plugins::changed::plugins_changed_event::PluginsChangedEvent;

// Port of events/plugins/plugins_event.rs — 1:1 (the upstream union has
// exactly one variant).
pub data PluginsEvent {
    case PluginsChanged(plugins_changed_event: PluginsChangedEvent);
}

pub machine PluginsEvent::clone(this: &PluginsEvent) -> PluginsEvent {
    transition this {
        PluginsEvent::PluginsChanged { plugins_changed_event } -> clone_changed(this, plugins_changed_event)
        _ -> (PluginsEvent::default())
    }
    state clone_changed(this: &PluginsEvent, plugins_changed_event: PluginsChangedEvent) -> PluginsEvent {
        (PluginsEvent::PluginsChanged {
            plugins_changed_event: PluginsChangedEvent::clone(&plugins_changed_event)
        })
    }
}

pub machine PluginsEvent::clone_from(this: &mut PluginsEvent, source: &PluginsEvent) {
    let cloned: PluginsEvent = PluginsEvent::clone(&source);
    this = cloned;
}

pub machine PluginsEvent::default() -> PluginsEvent {
    (PluginsEvent::PluginsChanged {
        plugins_changed_event: PluginsChangedEvent::default()
    })
}
