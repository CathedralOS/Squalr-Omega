use src/events/logging/log_recorded_event.omg;
use src/events/engine_event.omg;
use src/events/logging/log_level.omg;

// Domain union for the logging event surface — one leaf today.
public data LoggingEvent {
    case LogRecorded(log_recorded_event: |log_recorded_event|::LogRecordedEvent);
}

public machine LoggingEvent::default() -> LoggingEvent {
    (LoggingEvent::LogRecorded { log_recorded_event: |log_recorded_event|::LogRecordedEvent::default() })
}

public machine LoggingEvent::clone(this: &LoggingEvent) -> LoggingEvent {
    transition this {
        LoggingEvent::LogRecorded { log_recorded_event } -> at_logrecorded(this, &log_recorded_event)
    }
    machine at_logrecorded(this: &LoggingEvent, log_recorded_event: &|log_recorded_event|::LogRecordedEvent) -> LoggingEvent {
        let hoist1: |log_recorded_event|::LogRecordedEvent = |log_recorded_event|::LogRecordedEvent::clone(&log_recorded_event);
        (LoggingEvent::LogRecorded {
            log_recorded_event: hoist1,
        })
    }
}

public machine LoggingEvent::clone_from(this: &mut LoggingEvent, source: &LoggingEvent) {
    let cloned: LoggingEvent = LoggingEvent::clone(&source);
    this = cloned;
}

// Upstream `to_engine_event` — lifts the domain into the engine union.
public machine LoggingEvent::to_engine_event(this: &LoggingEvent) -> |engine_event|::EngineEvent {
    transition this {
        LoggingEvent::LogRecorded { log_recorded_event } -> at_engine(this, &log_recorded_event)
    }
    machine at_engine(this: &LoggingEvent, log_recorded_event: &|log_recorded_event|::LogRecordedEvent) -> |engine_event|::EngineEvent {
        let hoist2: |log_recorded_event|::LogRecordedEvent = |log_recorded_event|::LogRecordedEvent::clone(&log_recorded_event);
        (|engine_event|::EngineEvent::Logging {
            event: LoggingEvent::LogRecorded { log_recorded_event: hoist2 },
        })
    }
}
