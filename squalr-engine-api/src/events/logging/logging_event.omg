module src::events::logging::logging_event;

use src::events::logging::log_recorded_event::LogRecordedEvent;
use src::events::engine_event::EngineEvent;
use src::events::logging::log_level::LogLevel;

// Domain union for the logging event surface — one leaf today.
pub data LoggingEvent {
    case LogRecorded(log_recorded_event: LogRecordedEvent);
}

pub machine LoggingEvent::default() -> LoggingEvent {
    (LoggingEvent::LogRecorded { log_recorded_event: LogRecordedEvent::default() })
}

pub machine LoggingEvent::clone(&self) -> LoggingEvent {
    transition self {
        LoggingEvent::LogRecorded { log_recorded_event } -> (LoggingEvent::LogRecorded {
            log_recorded_event: log_recorded_event.clone(),
        })
    }
}

pub machine LoggingEvent::clone_from(&mut self, source: &LoggingEvent) {
    let cloned: LoggingEvent = source.clone();
    self = cloned;
}

// Upstream `to_engine_event` — lifts the domain into the engine union.
pub machine LoggingEvent::to_engine_event(&self) -> EngineEvent {
    transition self {
        LoggingEvent::LogRecorded { log_recorded_event } -> (EngineEvent::Logging {
            event: LoggingEvent::LogRecorded { log_recorded_event: log_recorded_event.clone() },
        })
    }
}
