module src::events::logging::logging_event;

use src::events::logging::log_recorded_event::LogRecordedEvent;
use src::events::engine_event::EngineEvent;
use src::events::logging::log_level::LogLevel;

// Domain union for the logging event surface — one leaf today.
pub data LoggingEvent {
    case LogRecorded(log_recorded_event: LogRecordedEvent);
}

pub machine LoggingEvent::default() -> LoggingEvent {
    (LoggingEvent::LogRecorded { log_recorded_event: LogRecordedEvent::default() })
}

pub machine LoggingEvent::clone(this: &LoggingEvent) -> LoggingEvent {
    transition this {
        LoggingEvent::LogRecorded { log_recorded_event } -> at_logrecorded(this, log_recorded_event)
    }
    state at_logrecorded(this: &LoggingEvent, log_recorded_event: LogRecordedEvent) -> LoggingEvent {
        let hoist1: LogRecordedEvent = LogRecordedEvent::clone(&log_recorded_event);
        (LoggingEvent::LogRecorded {
            log_recorded_event: hoist1,
        })
    }
}

pub machine LoggingEvent::clone_from(this: &mut LoggingEvent, source: &LoggingEvent) {
    let cloned: LoggingEvent = LoggingEvent::clone(&source);
    this = cloned;
}

// Upstream `to_engine_event` — lifts the domain into the engine union.
pub machine LoggingEvent::to_engine_event(this: &LoggingEvent) -> EngineEvent {
    transition this {
        LoggingEvent::LogRecorded { log_recorded_event } -> at_engine(this, log_recorded_event)
    }
    state at_engine(this: &LoggingEvent, log_recorded_event: LogRecordedEvent) -> EngineEvent {
        let hoist2: LogRecordedEvent = LogRecordedEvent::clone(&log_recorded_event);
        (EngineEvent::Logging {
            event: LoggingEvent::LogRecorded { log_recorded_event: hoist2 },
        })
    }
}
