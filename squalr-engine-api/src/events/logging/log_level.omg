module src::events::logging::log_level;

// Port of `log::Level` (as carried by LogRecordedEvent) — the five-level
// severity union.
pub data LogLevel [copy] {
    case Error;
    case Warn;
    case Info;
    case Debug;
    case Trace;
}

pub machine LogLevel::default() -> LogLevel {
    (LogLevel::Info {})
}

pub machine LogLevel::clone(&self) -> LogLevel {
    transition self {
        LogLevel::Error -> (LogLevel::Error {})
        LogLevel::Warn -> (LogLevel::Warn {})
        LogLevel::Info -> (LogLevel::Info {})
        LogLevel::Debug -> (LogLevel::Debug {})
        LogLevel::Trace -> (LogLevel::Trace {})
        _ -> (LogLevel::default())
    }
}
