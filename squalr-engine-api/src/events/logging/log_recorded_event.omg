module src::events::logging::log_recorded_event;

use src::events::engine_event::EngineEvent;
use src::events::logging::log_level::LogLevel;
use src::events::logging::logging_event::LoggingEvent;

// Port of events/logging/log_recorded_event.rs — one emitted log record:
// severity plus the logger `target` and message text, both bounded
// (256/512-byte carriers) per port convention.
pub data LogRecordedEvent {
    level: LogLevel;
    target: [u8; 256];
    target_len: u64;
    message: [u8; 512];
    message_len: u64;
}

pub machine LogRecordedEvent::new(level: LogLevel, target: &[u8], message: &[u8]) -> LogRecordedEvent {
    let mut event: LogRecordedEvent = LogRecordedEvent::default();
    event.level = level;
    event.set_target(target);
    event.set_message(message);
    (event)
}

pub machine LogRecordedEvent::default() -> LogRecordedEvent {
    (LogRecordedEvent {
        level: LogLevel::default(),
        target_len: 0,
        message_len: 0,
    })
}

pub machine LogRecordedEvent::get_level(&self) -> LogLevel {
    self.level
}

pub machine LogRecordedEvent::get_target(&self) -> &[u8] {
    transition self.target_len <= 256 {
        true -> (&self.target[0..self.target_len])
        false -> (&self.target[0..256])
    }
}

pub machine LogRecordedEvent::get_message(&self) -> &[u8] {
    transition self.message_len <= 512 {
        true -> (&self.message[0..self.message_len])
        false -> (&self.message[0..512])
    }
}

pub machine LogRecordedEvent::set_target(&mut self, target: &[u8]) {
    self.target_len = 0;
    transition { _ -> copy_target(target, 0) }
    state copy_target(&mut self, target: &[u8], position: u64) {
        transition position < target.len && position < 256 {
            true -> store_target(target, position)
            false -> finish_target(position)
        }
    }
    state store_target(&mut self, target: &[u8], position: u64) {
        self.target[position] = target[position];
        transition { _ -> copy_target(target, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_target(&mut self, count: u64) {
        self.target_len = count;
    }
}

pub machine LogRecordedEvent::set_message(&mut self, message: &[u8]) {
    self.message_len = 0;
    transition { _ -> copy_message(message, 0) }
    state copy_message(&mut self, message: &[u8], position: u64) {
        transition position < message.len && position < 512 {
            true -> store_message(message, position)
            false -> finish_message(position)
        }
    }
    state store_message(&mut self, message: &[u8], position: u64) {
        self.message[position] = message[position];
        transition { _ -> copy_message(message, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_message(&mut self, count: u64) {
        self.message_len = count;
    }
}

pub machine LogRecordedEvent::clone(&self) -> LogRecordedEvent {
    let mut event: LogRecordedEvent = LogRecordedEvent::default();
    event.clone_from(self);
    (event)
}

pub machine LogRecordedEvent::clone_from(&mut self, source: &LogRecordedEvent) {
    self.level = source.level;
    self.set_target(source.get_target());
    self.set_message(source.get_message());
}

// Upstream `EngineEventRequest::to_engine_event`.
pub machine LogRecordedEvent::to_engine_event(&self) -> EngineEvent {
    (EngineEvent::Logging {
        event: LoggingEvent::LogRecorded {
            log_recorded_event: self.clone(),
        },
    })
}
