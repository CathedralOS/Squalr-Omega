module src::events::logging::log_recorded_event;

use src::events::engine_event::EngineEvent;
use src::events::logging::log_level::LogLevel;
use src::events::logging::logging_event::LoggingEvent;

// Port of events/logging/log_recorded_event.rs — one emitted log record:
// severity plus the logger `target` and message text, both bounded
// (256/512-byte carriers) per port convention.
pub data LogRecordedEvent {
    level: LogLevel;
    target: [u8; 256];
    target_len: u64;
    message: [u8; 512];
    message_len: u64;
}

pub machine LogRecordedEvent::new(level: LogLevel, target: &[u8], message: &[u8]) -> LogRecordedEvent {
    let mut event: LogRecordedEvent = LogRecordedEvent::default();
    event.level = level;
    LogRecordedEvent::set_target(&mut event, target);
    LogRecordedEvent::set_message(&mut event, message);
    (event)
}

pub machine LogRecordedEvent::default() -> LogRecordedEvent {
    (LogRecordedEvent {
        level: LogLevel::default(),
        target_len: 0,
        message_len: 0,
    })
}

pub machine LogRecordedEvent::get_level(this: &LogRecordedEvent) -> LogLevel {
    this.level
}

pub machine LogRecordedEvent::get_target(this: &LogRecordedEvent) -> &[u8] {
    transition this.target_len <= 256 {
        true -> (&this.target[0..this.target_len])
        false -> (&this.target[0..256])
    }
}

pub machine LogRecordedEvent::get_message(this: &LogRecordedEvent) -> &[u8] {
    transition this.message_len <= 512 {
        true -> (&this.message[0..this.message_len])
        false -> (&this.message[0..512])
    }
}

pub machine LogRecordedEvent::set_target(this: &mut LogRecordedEvent, target: &[u8]) {
    this.target_len = 0;
    transition { _ -> copy_target(this, target, 0) }
    state copy_target(this: &mut LogRecordedEvent, target: &[u8], position: u64) {
        transition position < target.len && position < 256 {
            true -> store_target(this, target, position)
            false -> finish_target(this, position)
        }
    }
    state store_target(this: &mut LogRecordedEvent, target: &[u8], position: u64) {
        this.target[position] = target[position];
        transition { _ -> copy_target(this, target, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_target(this: &mut LogRecordedEvent, count: u64) {
        this.target_len = count;
    }
}

pub machine LogRecordedEvent::set_message(this: &mut LogRecordedEvent, message: &[u8]) {
    this.message_len = 0;
    transition { _ -> copy_message(this, message, 0) }
    state copy_message(this: &mut LogRecordedEvent, message: &[u8], position: u64) {
        transition position < message.len && position < 512 {
            true -> store_message(this, message, position)
            false -> finish_message(this, position)
        }
    }
    state store_message(this: &mut LogRecordedEvent, message: &[u8], position: u64) {
        this.message[position] = message[position];
        transition { _ -> copy_message(this, message, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish_message(this: &mut LogRecordedEvent, count: u64) {
        this.message_len = count;
    }
}

pub machine LogRecordedEvent::clone(this: &LogRecordedEvent) -> LogRecordedEvent {
    let mut event: LogRecordedEvent = LogRecordedEvent::default();
    LogRecordedEvent::clone_from(&mut event, this);
    (event)
}

pub machine LogRecordedEvent::clone_from(this: &mut LogRecordedEvent, source: &LogRecordedEvent) {
    this.level = source.level;
    LogRecordedEvent::set_target(&mut this, LogRecordedEvent::get_target(source));
    LogRecordedEvent::set_message(&mut this, LogRecordedEvent::get_message(source));
}

// Upstream `EngineEventRequest::to_engine_event`.
pub machine LogRecordedEvent::to_engine_event(this: &LogRecordedEvent) -> EngineEvent {
    let hoist1: LogRecordedEvent = LogRecordedEvent::clone(&this);
    (EngineEvent::Logging {
        event: LoggingEvent::LogRecorded {
            log_recorded_event: hoist1,
        },
    })
}
