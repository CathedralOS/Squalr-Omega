module src::events::project_items::changed::project_items_changed_event;

use src::structures::projects::project_path_list::ProjectPathList;
use src::events::engine_event::EngineEvent;
use src::events::project_items::project_items_event::ProjectItemsEvent;

// Upstream ProjectItemsChangedEvent — Vec<PathBuf> of changed items.
pub data ProjectItemsChangedEvent {
    changed_project_paths: ProjectPathList;
}

pub machine ProjectItemsChangedEvent::default() -> ProjectItemsChangedEvent {
    (ProjectItemsChangedEvent {
        changed_project_paths: ProjectPathList::empty(),
    })
}

pub machine ProjectItemsChangedEvent::new(changed_project_paths: &ProjectPathList) -> ProjectItemsChangedEvent {
    (ProjectItemsChangedEvent {
        changed_project_paths: ProjectPathList::clone(changed_project_paths),
    })
}

pub machine ProjectItemsChangedEvent::get_changed_project_paths(project_items_changed_event: &ProjectItemsChangedEvent) -> &ProjectPathList {
    (&project_items_changed_event.changed_project_paths)
}

pub machine ProjectItemsChangedEvent::clone(project_items_changed_event: &ProjectItemsChangedEvent) -> ProjectItemsChangedEvent {
    (ProjectItemsChangedEvent {
        changed_project_paths: ProjectPathList::clone(&project_items_changed_event.changed_project_paths),
    })
}

pub machine ProjectItemsChangedEvent::clone_from(project_items_changed_event: &mut ProjectItemsChangedEvent, source: &ProjectItemsChangedEvent) {
    ProjectPathList::clone_from(&mut project_items_changed_event.changed_project_paths, &source.changed_project_paths);
}

pub machine ProjectItemsChangedEvent::to_engine_event(project_items_changed_event: &ProjectItemsChangedEvent) -> EngineEvent {
    (EngineEvent::ProjectItems {
        event: ProjectItemsEvent::ProjectItemsChanged {
            project_items_changed_event: ProjectItemsChangedEvent::clone(project_items_changed_event),
        },
    })
}
