use src/structures/projects/project_path_list.omg;
use src/events/engine_event.omg;
use src/events/project_items/project_items_event.omg;

// Upstream ProjectItemsChangedEvent — Vec<PathBuf> of changed items.
public data ProjectItemsChangedEvent {
    changed_project_paths: |project_path_list|::ProjectPathList;
}

public machine ProjectItemsChangedEvent::default() -> ProjectItemsChangedEvent {
    (ProjectItemsChangedEvent {
        changed_project_paths: |project_path_list|::ProjectPathList::empty(),
    })
}

public machine ProjectItemsChangedEvent::new(changed_project_paths: &|project_path_list|::ProjectPathList) -> ProjectItemsChangedEvent {
    let hoist1: |project_path_list|::ProjectPathList = |project_path_list|::ProjectPathList::clone(&changed_project_paths);
    (ProjectItemsChangedEvent {
        changed_project_paths: hoist1,
    })
}

public machine ProjectItemsChangedEvent::get_changed_project_paths(this: &ProjectItemsChangedEvent) -> &|project_path_list|::ProjectPathList {
    (&this.changed_project_paths)
}

public machine ProjectItemsChangedEvent::clone(this: &ProjectItemsChangedEvent) -> ProjectItemsChangedEvent {
    let hoist2: |project_path_list|::ProjectPathList = |project_path_list|::ProjectPathList::clone(&this.changed_project_paths);
    (ProjectItemsChangedEvent {
        changed_project_paths: hoist2,
    })
}

public machine ProjectItemsChangedEvent::clone_from(this: &mut ProjectItemsChangedEvent, source: &ProjectItemsChangedEvent) {
    |project_path_list|::ProjectPathList::clone_from(&mut this.changed_project_paths, &source.changed_project_paths);
}

public machine ProjectItemsChangedEvent::to_engine_event(this: &ProjectItemsChangedEvent) -> |engine_event|::EngineEvent {
    let hoist3: ProjectItemsChangedEvent = ProjectItemsChangedEvent::clone(&this);
    (|engine_event|::EngineEvent::ProjectItems {
        event: |project_items_event|::ProjectItemsEvent::ProjectItemsChanged {
            project_items_changed_event: hoist3,
        },
    })
}
