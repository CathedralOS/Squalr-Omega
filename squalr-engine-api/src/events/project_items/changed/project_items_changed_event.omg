module src::events::project_items::changed::project_items_changed_event;

use src::structures::projects::project_path_list::ProjectPathList;
use src::events::engine_event::EngineEvent;
use src::events::project_items::project_items_event::ProjectItemsEvent;

// Upstream ProjectItemsChangedEvent — Vec<PathBuf> of changed items.
pub data ProjectItemsChangedEvent {
    changed_project_paths: ProjectPathList;
}

pub machine ProjectItemsChangedEvent::default() -> ProjectItemsChangedEvent {
    (ProjectItemsChangedEvent {
        changed_project_paths: ProjectPathList::empty(),
    })
}

pub machine ProjectItemsChangedEvent::new(changed_project_paths: &ProjectPathList) -> ProjectItemsChangedEvent {
    let hoist1: ProjectPathList = ProjectPathList::clone(&changed_project_paths);
    (ProjectItemsChangedEvent {
        changed_project_paths: hoist1,
    })
}

pub machine ProjectItemsChangedEvent::get_changed_project_paths(this: &ProjectItemsChangedEvent) -> &ProjectPathList {
    (&this.changed_project_paths)
}

pub machine ProjectItemsChangedEvent::clone(this: &ProjectItemsChangedEvent) -> ProjectItemsChangedEvent {
    let hoist2: ProjectPathList = ProjectPathList::clone(&this.changed_project_paths);
    (ProjectItemsChangedEvent {
        changed_project_paths: hoist2,
    })
}

pub machine ProjectItemsChangedEvent::clone_from(this: &mut ProjectItemsChangedEvent, source: &ProjectItemsChangedEvent) {
    ProjectPathList::clone_from(&mut this.changed_project_paths, &source.changed_project_paths);
}

pub machine ProjectItemsChangedEvent::to_engine_event(this: &ProjectItemsChangedEvent) -> EngineEvent {
    let hoist3: ProjectItemsChangedEvent = ProjectItemsChangedEvent::clone(&this);
    (EngineEvent::ProjectItems {
        event: ProjectItemsEvent::ProjectItemsChanged {
            project_items_changed_event: hoist3,
        },
    })
}
