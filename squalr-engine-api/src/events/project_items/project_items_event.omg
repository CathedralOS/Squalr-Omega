module src::events::project_items::project_items_event;

use src::events::project_items::changed::project_items_changed_event::ProjectItemsChangedEvent;
use src::events::engine_event::EngineEvent;

// Domain union for the project-items event surface — one leaf today.
pub data ProjectItemsEvent {
    case ProjectItemsChanged(project_items_changed_event: ProjectItemsChangedEvent);
}

pub machine ProjectItemsEvent::default() -> ProjectItemsEvent {
    (ProjectItemsEvent::ProjectItemsChanged { project_items_changed_event: ProjectItemsChangedEvent::default() })
}

pub machine ProjectItemsEvent::clone(this: &ProjectItemsEvent) -> ProjectItemsEvent {
    transition this {
        ProjectItemsEvent::ProjectItemsChanged { project_items_changed_event } -> at_changed(this, project_items_changed_event)
    }
    state at_changed(this: &ProjectItemsEvent, project_items_changed_event: ProjectItemsChangedEvent) -> ProjectItemsEvent {
        let hoist1: ProjectItemsChangedEvent = ProjectItemsChangedEvent::clone(&project_items_changed_event);
        (ProjectItemsEvent::ProjectItemsChanged {
            project_items_changed_event: hoist1,
        })
    }
}

pub machine ProjectItemsEvent::clone_from(this: &mut ProjectItemsEvent, source: &ProjectItemsEvent) {
    this = ProjectItemsEvent::clone(&source);
}
