module src::events::project_items::project_items_event;

use src::events::project_items::changed::project_items_changed_event::ProjectItemsChangedEvent;
use src::events::engine_event::EngineEvent;

// Domain union for the project-items event surface — one leaf today.
pub data ProjectItemsEvent {
    case ProjectItemsChanged(project_items_changed_event: ProjectItemsChangedEvent);
}

pub machine ProjectItemsEvent::default() -> ProjectItemsEvent {
    (ProjectItemsEvent::ProjectItemsChanged { project_items_changed_event: ProjectItemsChangedEvent::default() })
}

pub machine ProjectItemsEvent::clone(project_items_event: &ProjectItemsEvent) -> ProjectItemsEvent {
    transition project_items_event {
        ProjectItemsEvent::ProjectItemsChanged { project_items_changed_event } -> (ProjectItemsEvent::ProjectItemsChanged {
            project_items_changed_event: ProjectItemsChangedEvent::clone(&project_items_changed_event),
        })
    }
}

pub machine ProjectItemsEvent::clone_from(project_items_event: &mut ProjectItemsEvent, source: &ProjectItemsEvent) {
    project_items_event = ProjectItemsEvent::clone(source);
}
