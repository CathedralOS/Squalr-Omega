module src::events::project::created::project_created_event;

use src::structures::projects::project_info::ProjectInfo;
use src::events::engine_event::EngineEvent;
use src::events::project::project_event::ProjectEvent;

// Upstream ProjectCreatedEvent — carries the new project's info.
pub data ProjectCreatedEvent {
    project_info: ProjectInfo;
}

pub machine ProjectCreatedEvent::default() -> ProjectCreatedEvent {
    (ProjectCreatedEvent {
        project_info: ProjectInfo::default(),
    })
}

pub machine ProjectCreatedEvent::new(project_info: &ProjectInfo) -> ProjectCreatedEvent {
    (ProjectCreatedEvent {
        project_info: ProjectInfo::clone(project_info),
    })
}

pub machine ProjectCreatedEvent::get_project_info(project_created_event: &ProjectCreatedEvent) -> &ProjectInfo {
    (&project_created_event.project_info)
}

pub machine ProjectCreatedEvent::clone(project_created_event: &ProjectCreatedEvent) -> ProjectCreatedEvent {
    (ProjectCreatedEvent {
        project_info: ProjectInfo::clone(&project_created_event.project_info),
    })
}

pub machine ProjectCreatedEvent::clone_from(project_created_event: &mut ProjectCreatedEvent, source: &ProjectCreatedEvent) {
    ProjectInfo::clone_from(&mut project_created_event.project_info, &source.project_info);
}

pub machine ProjectCreatedEvent::to_engine_event(project_created_event: &ProjectCreatedEvent) -> EngineEvent {
    (EngineEvent::Project {
        event: ProjectEvent::ProjectCreated {
            project_created_event: ProjectCreatedEvent::clone(project_created_event),
        },
    })
}
