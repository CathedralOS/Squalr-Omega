use src/structures/projects/project_info.omg;
use src/events/engine_event.omg;
use src/events/project/project_event.omg;

// Upstream ProjectCreatedEvent — carries the new project's info.
public data ProjectCreatedEvent {
    project_info: |project_info|::ProjectInfo;
}

public machine ProjectCreatedEvent::default() -> ProjectCreatedEvent {
    (ProjectCreatedEvent {
        project_info: |project_info|::ProjectInfo::default(),
    })
}

public machine ProjectCreatedEvent::new(project_info: &|project_info|::ProjectInfo) -> ProjectCreatedEvent {
    (ProjectCreatedEvent {
        project_info: |project_info|::ProjectInfo::clone(project_info),
    })
}

public machine ProjectCreatedEvent::get_project_info(this: &ProjectCreatedEvent) -> &|project_info|::ProjectInfo {
    (&this.project_info)
}

public machine ProjectCreatedEvent::clone(this: &ProjectCreatedEvent) -> ProjectCreatedEvent {
    (ProjectCreatedEvent {
        project_info: |project_info|::ProjectInfo::clone(&this.project_info),
    })
}

public machine ProjectCreatedEvent::clone_from(this: &mut ProjectCreatedEvent, source: &ProjectCreatedEvent) {
    |project_info|::ProjectInfo::clone_from(&mut this.project_info, &source.project_info);
}

public machine ProjectCreatedEvent::to_engine_event(this: &ProjectCreatedEvent) -> |engine_event|::EngineEvent {
    let hoist1: ProjectCreatedEvent = ProjectCreatedEvent::clone(&this);
    (|engine_event|::EngineEvent::Project {
        event: |project_event|::ProjectEvent::ProjectCreated {
            project_created_event: hoist1,
        },
    })
}
