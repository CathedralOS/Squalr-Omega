module src::events::project::project_event;

use src::events::engine_event::EngineEvent;
use src::events::project::catalog_changed::project_catalog_changed_event::ProjectCatalogChangedEvent;
use src::events::project::closed::project_closed_event::ProjectClosedEvent;
use src::events::project::created::project_created_event::ProjectCreatedEvent;
use src::events::project::deleted::project_deleted_event::ProjectDeletedEvent;

// Domain union for the project lifecycle event surface.
pub data ProjectEvent {
    case ProjectCatalogChanged(project_catalog_changed_event: ProjectCatalogChangedEvent);
    case ProjectClosed(project_closed_event: ProjectClosedEvent);
    case ProjectCreated(project_created_event: ProjectCreatedEvent);
    case ProjectDeleted(project_deleted_event: ProjectDeletedEvent);
}

pub machine ProjectEvent::default() -> ProjectEvent {
    (ProjectEvent::ProjectClosed { project_closed_event: ProjectClosedEvent::default() })
}

pub machine ProjectEvent::clone(this: &ProjectEvent) -> ProjectEvent {
    transition this {
        ProjectEvent::ProjectCatalogChanged { project_catalog_changed_event } -> at_projectcatal(this, project_catalog_changed_event)
        ProjectEvent::ProjectClosed { project_closed_event } -> at_projectclosed(this, project_closed_event)
        ProjectEvent::ProjectCreated { project_created_event } -> at_projectcreated(this, project_created_event)
        ProjectEvent::ProjectDeleted { project_deleted_event } -> at_projectdeleted(this, project_deleted_event)
    }
    state at_projectcatal(this: &ProjectEvent, project_catalog_changed_event: ProjectCatalogChangedEvent) -> ProjectEvent {
        let hoist1: ProjectCatalogChangedEvent = ProjectCatalogChangedEvent::clone(&project_catalog_changed_event);
        (ProjectEvent::ProjectCatalogChanged {
            project_catalog_changed_event: hoist1,
        })
    }
    state at_projectclosed(this: &ProjectEvent, project_closed_event: ProjectClosedEvent) -> ProjectEvent {
        let hoist2: ProjectClosedEvent = ProjectClosedEvent::clone(&project_closed_event);
        (ProjectEvent::ProjectClosed {
            project_closed_event: hoist2,
        })
    }
    state at_projectcreated(this: &ProjectEvent, project_created_event: ProjectCreatedEvent) -> ProjectEvent {
        let hoist3: ProjectCreatedEvent = ProjectCreatedEvent::clone(&project_created_event);
        (ProjectEvent::ProjectCreated {
            project_created_event: hoist3,
        })
    }
    state at_projectdeleted(this: &ProjectEvent, project_deleted_event: ProjectDeletedEvent) -> ProjectEvent {
        let hoist4: ProjectDeletedEvent = ProjectDeletedEvent::clone(&project_deleted_event);
        (ProjectEvent::ProjectDeleted {
            project_deleted_event: hoist4,
        })
    }
}

pub machine ProjectEvent::clone_from(this: &mut ProjectEvent, source: &ProjectEvent) {
    this = ProjectEvent::clone(&source);
}
