module src::events::project::project_event;

use src::events::engine_event::EngineEvent;
use src::events::project::catalog_changed::project_catalog_changed_event::ProjectCatalogChangedEvent;
use src::events::project::closed::project_closed_event::ProjectClosedEvent;
use src::events::project::created::project_created_event::ProjectCreatedEvent;
use src::events::project::deleted::project_deleted_event::ProjectDeletedEvent;

// Domain union for the project lifecycle event surface.
pub data ProjectEvent {
    case ProjectCatalogChanged(project_catalog_changed_event: ProjectCatalogChangedEvent);
    case ProjectClosed(project_closed_event: ProjectClosedEvent);
    case ProjectCreated(project_created_event: ProjectCreatedEvent);
    case ProjectDeleted(project_deleted_event: ProjectDeletedEvent);
}

pub machine ProjectEvent::default() -> ProjectEvent {
    (ProjectEvent::ProjectClosed { project_closed_event: ProjectClosedEvent::default() })
}

pub machine ProjectEvent::clone(project_event: &ProjectEvent) -> ProjectEvent {
    transition project_event {
        ProjectEvent::ProjectCatalogChanged { project_catalog_changed_event } -> (ProjectEvent::ProjectCatalogChanged {
            project_catalog_changed_event: ProjectCatalogChangedEvent::clone(&project_catalog_changed_event),
        })
        ProjectEvent::ProjectClosed { project_closed_event } -> (ProjectEvent::ProjectClosed {
            project_closed_event: ProjectClosedEvent::clone(&project_closed_event),
        })
        ProjectEvent::ProjectCreated { project_created_event } -> (ProjectEvent::ProjectCreated {
            project_created_event: ProjectCreatedEvent::clone(&project_created_event),
        })
        ProjectEvent::ProjectDeleted { project_deleted_event } -> (ProjectEvent::ProjectDeleted {
            project_deleted_event: ProjectDeletedEvent::clone(&project_deleted_event),
        })
    }
}

pub machine ProjectEvent::clone_from(project_event: &mut ProjectEvent, source: &ProjectEvent) {
    project_event = ProjectEvent::clone(source);
}
