module src::events::project::closed::project_closed_event;

use src::events::engine_event::EngineEvent;
use src::events::project::project_event::ProjectEvent;

// Upstream ProjectClosedEvent — no payload.
pub data ProjectClosedEvent {
}

pub machine ProjectClosedEvent::default() -> ProjectClosedEvent {
    (ProjectClosedEvent {})
}

pub machine ProjectClosedEvent::clone(project_closed_event: &ProjectClosedEvent) -> ProjectClosedEvent {
    (ProjectClosedEvent {})
}

pub machine ProjectClosedEvent::clone_from(project_closed_event: &mut ProjectClosedEvent, source: &ProjectClosedEvent) {
}

pub machine ProjectClosedEvent::to_engine_event(project_closed_event: &ProjectClosedEvent) -> EngineEvent {
    (EngineEvent::Project {
        event: ProjectEvent::ProjectClosed {
            project_closed_event: ProjectClosedEvent {},
        },
    })
}
