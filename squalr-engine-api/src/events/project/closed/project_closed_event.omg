use src/events/engine_event.omg;
use src/events/project/project_event.omg;

// Upstream ProjectClosedEvent — no payload.
public data ProjectClosedEvent {
}

public machine ProjectClosedEvent::default() -> ProjectClosedEvent {
    (ProjectClosedEvent {})
}

public machine ProjectClosedEvent::clone(this: &ProjectClosedEvent) -> ProjectClosedEvent {
    (ProjectClosedEvent {})
}

public machine ProjectClosedEvent::clone_from(this: &mut ProjectClosedEvent, source: &ProjectClosedEvent) {
}

public machine ProjectClosedEvent::to_engine_event(this: &ProjectClosedEvent) -> |engine_event|::EngineEvent {
    (|engine_event|::EngineEvent::Project {
        event: |project_event|::ProjectEvent::ProjectClosed {
            project_closed_event: ProjectClosedEvent {},
        },
    })
}
