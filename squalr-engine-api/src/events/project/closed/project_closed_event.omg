module src::events::project::closed::project_closed_event;

use src::events::engine_event::EngineEvent;
use src::events::project::project_event::ProjectEvent;

// Upstream ProjectClosedEvent — no payload.
pub data ProjectClosedEvent {
}

pub machine ProjectClosedEvent::default() -> ProjectClosedEvent {
    (ProjectClosedEvent {})
}

pub machine ProjectClosedEvent::clone(&self) -> ProjectClosedEvent {
    (ProjectClosedEvent {})
}

pub machine ProjectClosedEvent::clone_from(&mut self, source: &ProjectClosedEvent) {
}

pub machine ProjectClosedEvent::to_engine_event(&self) -> EngineEvent {
    (EngineEvent::Project {
        event: ProjectEvent::ProjectClosed {
            project_closed_event: ProjectClosedEvent {},
        },
    })
}
