module src::events::project::catalog_changed::project_catalog_changed_event;

use src::structures::bounded_slice::bounded_slice;

use src::events::engine_event::EngineEvent;
use src::events::project::project_event::ProjectEvent;
use src::structures::bounded_byte_copy::BoundedByteCopy;

// Upstream ProjectCatalogChangedEvent — Option<PathBuf> carrying the
// changed project directory (None on project close).
pub data ProjectCatalogChangedEvent {
    has_changed_project_directory_path: bool;
    changed_project_directory_path: [u8; 512];
    changed_project_directory_path_len: u64;
}

pub machine ProjectCatalogChangedEvent::default() -> ProjectCatalogChangedEvent {
    (ProjectCatalogChangedEvent {
        has_changed_project_directory_path: false,
        changed_project_directory_path_len: 0,
    })
}

pub machine ProjectCatalogChangedEvent::closed() -> ProjectCatalogChangedEvent {
    (ProjectCatalogChangedEvent::default())
}

pub machine ProjectCatalogChangedEvent::get_has_changed_project_directory_path(&self) -> bool {
    self.has_changed_project_directory_path
}

pub machine ProjectCatalogChangedEvent::get_changed_project_directory_path(&self) -> &[u8] {
    bounded_slice(&self.changed_project_directory_path[0..512], self.changed_project_directory_path_len)
}

pub machine ProjectCatalogChangedEvent::set_changed_project_directory_path(&mut self, changed_project_directory_path: &[u8]) {
    self.has_changed_project_directory_path = true;
    self.changed_project_directory_path_len = BoundedByteCopy::copy(&mut self.changed_project_directory_path[0..512], changed_project_directory_path);
}

pub machine ProjectCatalogChangedEvent::clone(&self) -> ProjectCatalogChangedEvent {
    let mut cloned: ProjectCatalogChangedEvent = ProjectCatalogChangedEvent::default();
    cloned.has_changed_project_directory_path = self.has_changed_project_directory_path;
    cloned.set_changed_project_directory_path(self.get_changed_project_directory_path());
    (cloned)
}

pub machine ProjectCatalogChangedEvent::clone_from(&mut self, source: &ProjectCatalogChangedEvent) {
    self = source.clone();
}

pub machine ProjectCatalogChangedEvent::to_engine_event(&self) -> EngineEvent {
    (EngineEvent::Project {
        event: ProjectEvent::ProjectCatalogChanged {
            project_catalog_changed_event: self.clone(),
        },
    })
}
