module src::events::project::catalog_changed::project_catalog_changed_event;

use src::events::engine_event::EngineEvent;
use src::events::project::project_event::ProjectEvent;

// Upstream ProjectCatalogChangedEvent — Option<PathBuf> carrying the
// changed project directory (None on project close).
pub data ProjectCatalogChangedEvent {
    has_changed_project_directory_path: bool;
    changed_project_directory_path: [u8; 512];
    changed_project_directory_path_len: u64;
}

pub machine ProjectCatalogChangedEvent::default() -> ProjectCatalogChangedEvent {
    (ProjectCatalogChangedEvent {
        has_changed_project_directory_path: false,
        changed_project_directory_path_len: 0,
    })
}

pub machine ProjectCatalogChangedEvent::closed() -> ProjectCatalogChangedEvent {
    (ProjectCatalogChangedEvent::default())
}

pub machine ProjectCatalogChangedEvent::get_has_changed_project_directory_path(this: &ProjectCatalogChangedEvent) -> bool {
    this.has_changed_project_directory_path
}

pub machine ProjectCatalogChangedEvent::get_changed_project_directory_path(this: &ProjectCatalogChangedEvent) -> &[u8] {
    transition this.changed_project_directory_path_len <= 512 {
        true -> (&this.changed_project_directory_path[0..this.changed_project_directory_path_len])
        false -> (&this.changed_project_directory_path[0..512])
        _ -> (&this.changed_project_directory_path[0..512])
    }
}

pub machine ProjectCatalogChangedEvent::set_changed_project_directory_path(this: &mut ProjectCatalogChangedEvent, changed_project_directory_path: &[u8]) {
    this.has_changed_project_directory_path = true;
    this.changed_project_directory_path_len = 0;
    transition { _ -> copy(this, changed_project_directory_path, 0) }
    state copy(this: &mut ProjectCatalogChangedEvent, changed_project_directory_path: &[u8], position: u64) {
        transition position < changed_project_directory_path.len && position < 512 {
            true -> store(this, changed_project_directory_path, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ProjectCatalogChangedEvent, changed_project_directory_path: &[u8], position: u64)
        requires position < 512;
    {
        this.changed_project_directory_path[position] = changed_project_directory_path[position];
        transition { _ -> copy(this, changed_project_directory_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state finish(this: &mut ProjectCatalogChangedEvent, count: u64) {
        this.changed_project_directory_path_len = count;
    }
}

pub machine ProjectCatalogChangedEvent::clone(this: &ProjectCatalogChangedEvent) -> ProjectCatalogChangedEvent {
    let mut cloned: ProjectCatalogChangedEvent = ProjectCatalogChangedEvent::default();
    cloned.has_changed_project_directory_path = this.has_changed_project_directory_path;
    ProjectCatalogChangedEvent::set_changed_project_directory_path(&mut cloned, ProjectCatalogChangedEvent::get_changed_project_directory_path(this));
    (cloned)
}

pub machine ProjectCatalogChangedEvent::clone_from(this: &mut ProjectCatalogChangedEvent, source: &ProjectCatalogChangedEvent) {
    this = ProjectCatalogChangedEvent::clone(&source);
}

pub machine ProjectCatalogChangedEvent::to_engine_event(this: &ProjectCatalogChangedEvent) -> EngineEvent {
    let hoist1: ProjectCatalogChangedEvent = ProjectCatalogChangedEvent::clone(&this);
    (EngineEvent::Project {
        event: ProjectEvent::ProjectCatalogChanged {
            project_catalog_changed_event: hoist1,
        },
    })
}
