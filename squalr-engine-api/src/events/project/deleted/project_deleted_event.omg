module src::events::project::deleted::project_deleted_event;

use src::structures::projects::project_info::ProjectInfo;
use src::events::engine_event::EngineEvent;
use src::events::project::project_event::ProjectEvent;

// Upstream ProjectDeletedEvent — carries the removed project's info.
pub data ProjectDeletedEvent {
    project_info: ProjectInfo;
}

pub machine ProjectDeletedEvent::default() -> ProjectDeletedEvent {
    (ProjectDeletedEvent {
        project_info: ProjectInfo::default(),
    })
}

pub machine ProjectDeletedEvent::new(project_info: &ProjectInfo) -> ProjectDeletedEvent {
    (ProjectDeletedEvent {
        project_info: ProjectInfo::clone(project_info),
    })
}

pub machine ProjectDeletedEvent::get_project_info(&self) -> &ProjectInfo {
    (&self.project_info)
}

pub machine ProjectDeletedEvent::clone(&self) -> ProjectDeletedEvent {
    (ProjectDeletedEvent {
        project_info: ProjectInfo::clone(&self.project_info),
    })
}

pub machine ProjectDeletedEvent::clone_from(&mut self, source: &ProjectDeletedEvent) {
    self.project_info.clone_from(&source.project_info);
}

pub machine ProjectDeletedEvent::to_engine_event(&self) -> EngineEvent {
    (EngineEvent::Project {
        event: ProjectEvent::ProjectDeleted {
            project_deleted_event: self.clone(),
        },
    })
}
