module src::events::project::deleted::project_deleted_event;

use src::structures::projects::project_info::ProjectInfo;
use src::events::engine_event::EngineEvent;
use src::events::project::project_event::ProjectEvent;

// Upstream ProjectDeletedEvent — carries the removed project's info.
pub data ProjectDeletedEvent {
    project_info: ProjectInfo;
}

pub machine ProjectDeletedEvent::default() -> ProjectDeletedEvent {
    (ProjectDeletedEvent {
        project_info: ProjectInfo::default(),
    })
}

pub machine ProjectDeletedEvent::new(project_info: &ProjectInfo) -> ProjectDeletedEvent {
    (ProjectDeletedEvent {
        project_info: ProjectInfo::clone(project_info),
    })
}

pub machine ProjectDeletedEvent::get_project_info(project_deleted_event: &ProjectDeletedEvent) -> &ProjectInfo {
    (&project_deleted_event.project_info)
}

pub machine ProjectDeletedEvent::clone(project_deleted_event: &ProjectDeletedEvent) -> ProjectDeletedEvent {
    (ProjectDeletedEvent {
        project_info: ProjectInfo::clone(&project_deleted_event.project_info),
    })
}

pub machine ProjectDeletedEvent::clone_from(project_deleted_event: &mut ProjectDeletedEvent, source: &ProjectDeletedEvent) {
    ProjectInfo::clone_from(&mut project_deleted_event.project_info, &source.project_info);
}

pub machine ProjectDeletedEvent::to_engine_event(project_deleted_event: &ProjectDeletedEvent) -> EngineEvent {
    (EngineEvent::Project {
        event: ProjectEvent::ProjectDeleted {
            project_deleted_event: ProjectDeletedEvent::clone(project_deleted_event),
        },
    })
}
