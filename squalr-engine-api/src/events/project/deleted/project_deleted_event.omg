use src/structures/projects/project_info.omg;
use src/events/engine_event.omg;
use src/events/project/project_event.omg;

// Upstream ProjectDeletedEvent — carries the removed project's info.
public data ProjectDeletedEvent {
    project_info: |project_info|::ProjectInfo;
}

public machine ProjectDeletedEvent::default() -> ProjectDeletedEvent {
    (ProjectDeletedEvent {
        project_info: |project_info|::ProjectInfo::default(),
    })
}

public machine ProjectDeletedEvent::new(project_info: &|project_info|::ProjectInfo) -> ProjectDeletedEvent {
    (ProjectDeletedEvent {
        project_info: |project_info|::ProjectInfo::clone(project_info),
    })
}

public machine ProjectDeletedEvent::get_project_info(this: &ProjectDeletedEvent) -> &|project_info|::ProjectInfo {
    (&this.project_info)
}

public machine ProjectDeletedEvent::clone(this: &ProjectDeletedEvent) -> ProjectDeletedEvent {
    (ProjectDeletedEvent {
        project_info: |project_info|::ProjectInfo::clone(&this.project_info),
    })
}

public machine ProjectDeletedEvent::clone_from(this: &mut ProjectDeletedEvent, source: &ProjectDeletedEvent) {
    |project_info|::ProjectInfo::clone_from(&mut this.project_info, &source.project_info);
}

public machine ProjectDeletedEvent::to_engine_event(this: &ProjectDeletedEvent) -> |engine_event|::EngineEvent {
    let hoist1: ProjectDeletedEvent = ProjectDeletedEvent::clone(&this);
    (|engine_event|::EngineEvent::Project {
        event: |project_event|::ProjectEvent::ProjectDeleted {
            project_deleted_event: hoist1,
        },
    })
}
