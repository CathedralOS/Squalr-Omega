module src::events::registry::changed::registry_changed_event;

use src::events::engine_event::EngineEvent;
use src::events::registry::registry_event::RegistryEvent;

// Port of events/registry/changed/registry_changed_event.rs — the payload
// emitted when a registry mutation lands (`generation` is the post-bump
// registry generation).
public data RegistryChangedEvent {
    generation: u64;
}

public machine RegistryChangedEvent::new(generation: u64) -> RegistryChangedEvent {
    (RegistryChangedEvent {
        generation: generation,
    })
}

public machine RegistryChangedEvent::default() -> RegistryChangedEvent {
    (RegistryChangedEvent {
        generation: 0,
    })
}

public machine RegistryChangedEvent::get_generation(this: &RegistryChangedEvent) -> u64 {
    (this.generation)
}

public machine RegistryChangedEvent::clone(this: &RegistryChangedEvent) -> RegistryChangedEvent {
    (RegistryChangedEvent {
        generation: this.generation,
    })
}

public machine RegistryChangedEvent::clone_from(this: &mut RegistryChangedEvent, source: &RegistryChangedEvent) {
    this.generation = source.generation;
}

// Upstream `EngineEventRequest::to_engine_event` — wraps the payload in
// the two-level union the dispatch seam carries.
public machine RegistryChangedEvent::to_engine_event(this: &RegistryChangedEvent) -> EngineEvent {
    let hoist1: RegistryChangedEvent = RegistryChangedEvent::clone(&this);
    (EngineEvent::Registry {
        event: RegistryEvent::Changed {
            registry_changed_event: hoist1,
        },
    })
}
