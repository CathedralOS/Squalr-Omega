module src::events::registry::changed::registry_changed_event;

use src::events::engine_event::EngineEvent;
use src::events::registry::registry_event::RegistryEvent;

// Port of events/registry/changed/registry_changed_event.rs — the payload
// emitted when a registry mutation lands (`generation` is the post-bump
// registry generation).
pub data RegistryChangedEvent {
    generation: u64;
}

pub machine RegistryChangedEvent::new(generation: u64) -> RegistryChangedEvent {
    (RegistryChangedEvent {
        generation: generation,
    })
}

pub machine RegistryChangedEvent::default() -> RegistryChangedEvent {
    (RegistryChangedEvent {
        generation: 0,
    })
}

pub machine RegistryChangedEvent::get_generation(&self) -> u64 {
    (self.generation)
}

pub machine RegistryChangedEvent::clone(&self) -> RegistryChangedEvent {
    (RegistryChangedEvent {
        generation: self.generation,
    })
}

pub machine RegistryChangedEvent::clone_from(&mut self, source: &RegistryChangedEvent) {
    self.generation = source.generation;
}

// Upstream `EngineEventRequest::to_engine_event` — wraps the payload in
// the two-level union the dispatch seam carries.
pub machine RegistryChangedEvent::to_engine_event(&self) -> EngineEvent {
    (EngineEvent::Registry {
        event: RegistryEvent::Changed {
            registry_changed_event: self.clone(),
        },
    })
}
