module src::events::registry::registry_event;

use src::events::registry::changed::registry_changed_event::RegistryChangedEvent;

// Port of events/registry/registry_event.rs — 1:1 (the upstream union has
// exactly one variant).
pub data RegistryEvent {
    case Changed(registry_changed_event: RegistryChangedEvent);
}

pub machine RegistryEvent::clone(registry_event: &RegistryEvent) -> RegistryEvent {
    transition registry_event {
        RegistryEvent::Changed { registry_changed_event } -> clone_changed(registry_event, registry_changed_event)
        _ -> (RegistryEvent::default())
    }
    state clone_changed(registry_event: &RegistryEvent, registry_changed_event: &RegistryChangedEvent) -> RegistryEvent {
        (RegistryEvent::Changed {
            registry_changed_event: RegistryChangedEvent::clone(registry_changed_event)
        })
    }
}

pub machine RegistryEvent::clone_from(registry_event: &mut RegistryEvent, source: &RegistryEvent) {
    let cloned: RegistryEvent = RegistryEvent::clone(source);
    registry_event = cloned;
}

pub machine RegistryEvent::default() -> RegistryEvent {
    (RegistryEvent::Changed {
        registry_changed_event: RegistryChangedEvent::default()
    })
}
