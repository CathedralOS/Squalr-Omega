// Port of commands/privileged_command_request.rs. Upstream declares the
// `PrivilegedCommandRequest` trait (associated `ResponseType`,
// `to_engine_command`, and the callback `send`/`send_unprivileged` wires) and
// spreads each `to_engine_command` impl across its leaf file. Port deviations,
// documented once: (1) Omega's per-file modules would need leaf->root->leaf
// cycles to hold each impl beside its request, so the impls colocate here in
// the trait's upstream file; (2) `to_engine_command` consumes the request by
// value where upstream takes `&self` and clones — the synchronous dispatch
// wire owns the request end to end; (3) `send`/`send_unprivileged` collapse
// into `SqualrEngine::dispatch_command` — the FnOnce-callback thread hop has
// no headless consumer until engine_unprivileged_state lands.

pub machine ScanResetRequest::to_engine_command(
    request: ScanResetRequest
) -> PrivilegedCommand {
    (PrivilegedCommand::Scan { command: ScanCommand::Reset { request: request } })
}

pub machine ScanNewRequest::to_engine_command(
    request: ScanNewRequest
) -> PrivilegedCommand {
    (PrivilegedCommand::Scan { command: ScanCommand::New { request: request } })
}

