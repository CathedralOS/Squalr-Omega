// Upstream `StructScanRequest::to_engine_command` — StructScanCommand is
// a plain record upstream, so the literal keeps the 1:1 shape
// (`self.clone()` inside upstream's constructor is subsumed by the
// by-value request).
pub machine StructScanRequest::to_engine_command(
    request: StructScanRequest
) -> PrivilegedCommand {
    (PrivilegedCommand::StructScan { command: StructScanCommand {
        struct_scan_request: request
    } })
}
