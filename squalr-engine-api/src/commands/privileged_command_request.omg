// Upstream `StructScanRequest::to_engine_command` — StructScanCommand is
// a plain record upstream, so the literal keeps the 1:1 shape
// (`self.clone()` inside upstream's constructor is subsumed by the
// by-value request).
public machine StructScanRequest::to_engine_command(
    request: |struct_scan_request|::StructScanRequest
) -> |privileged_command|::PrivilegedCommand {
    (|privileged_command|::PrivilegedCommand::StructScan { command: |struct_scan_command|::StructScanCommand {
        struct_scan_request: request
    } })
}


