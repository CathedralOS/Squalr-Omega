module src::commands::scan_results::delete::scan_results_delete_response;

// Port of commands/scan_results/delete/scan_results_delete_response.rs:
// `requested_result_count` vs `deleted_result_count` — a shortfall means
// stale or out-of-range refs were ignored (upstream logs a warning).
pub data ScanResultsDeleteResponse {
    requested_result_count: u64;
    deleted_result_count: u64;
}

pub machine ScanResultsDeleteResponse::default() -> ScanResultsDeleteResponse {
    ScanResultsDeleteResponse { requested_result_count: 0, deleted_result_count: 0 }
}

pub machine ScanResultsDeleteResponse::of(requested_result_count: u64, deleted_result_count: u64) -> ScanResultsDeleteResponse {
    ScanResultsDeleteResponse {
        requested_result_count: requested_result_count,
        deleted_result_count: deleted_result_count,
    }
}

pub machine ScanResultsDeleteResponse::get_requested_result_count(&self) -> u64 {
    self.requested_result_count
}

pub machine ScanResultsDeleteResponse::get_deleted_result_count(&self) -> u64 {
    self.deleted_result_count
}
