module src::commands::scan_results::delete::scan_results_delete_request;

use src::structures::scan_results::scan_result_ref::ScanResultRef;

// Port of commands/scan_results/delete/scan_results_delete_request.rs:
// upstream `scan_result_refs: Vec<ScanResultRef>` — a bounded list per the
// port's collection convention (same 64-member bound as the tombstone set
// it feeds; a delete request naming more indices truncates, a named
// deviation).
pub data ScanResultRefList {
    scan_result_refs: [ScanResultRef; 64];
    count: u64;
}

pub machine ScanResultRefList::empty() -> ScanResultRefList {
    ScanResultRefList { count: 0 }
}

pub machine ScanResultRefList::get_count(&self) -> u64 {
    self.count
}

pub machine ScanResultRefList::push(&mut self, scan_result_ref: &ScanResultRef) -> bool {
    transition self.count < 64 {
        true -> store(scan_result_ref)
        false -> (false)
    }
    state store(&mut self, scan_result_ref: &ScanResultRef) -> bool {
        self.scan_result_refs[self.count].clone_from(scan_result_ref);
        self.count = self.count + 1;
        true
    }
}

pub machine ScanResultRefList::get(&self, position: u64) -> ScanResultRef {
    transition position < self.count && position < 64 {
        true -> clone_at(position)
        false -> (ScanResultRef::default())
    }
    state clone_at(&self, position: u64) -> ScanResultRef {
        ScanResultRef::clone(&self.scan_result_refs[position])
    }
}

pub data ScanResultsDeleteRequest {
    scan_result_refs: ScanResultRefList;
}
