module src::commands::scan_results::delete::scan_results_delete_request;

use src::structures::scan_results::scan_result_ref::ScanResultRef;

// Port of commands/scan_results/delete/scan_results_delete_request.rs:
// upstream `scan_result_refs: Vec<ScanResultRef>` — a bounded list per the
// port's collection convention (same 64-member bound as the tombstone set
// it feeds; a delete request naming more indices truncates, a named
// deviation).
pub data ScanResultRefList {
    scan_result_refs: [ScanResultRef; 64];
    count: u64;
}

pub machine ScanResultRefList::empty() -> ScanResultRefList {
    ScanResultRefList { count: 0 }
}

pub machine ScanResultRefList::get_count(scan_result_ref_list: &ScanResultRefList) -> u64 {
    scan_result_ref_list.count
}

pub machine ScanResultRefList::push(scan_result_ref_list: &mut ScanResultRefList, scan_result_ref: &ScanResultRef) -> bool {
    transition scan_result_ref_list.count < 64 {
        true -> store(scan_result_ref_list, scan_result_ref)
        false -> (false)
    }
    state store(scan_result_ref_list: &mut ScanResultRefList, scan_result_ref: &ScanResultRef) -> bool {
        ScanResultRef::clone_from(&mut scan_result_ref_list.scan_result_refs[scan_result_ref_list.count], scan_result_ref);
        scan_result_ref_list.count = scan_result_ref_list.count + 1;
        true
    }
}

// Upstream `scan_result_refs.clone()` — the set-property executor hands a
// copy to the internal freeze request it fires for "is_frozen".
pub machine ScanResultRefList::clone_from(scan_result_ref_list: &mut ScanResultRefList, source: &ScanResultRefList) {
    scan_result_ref_list.count = 0;
    transition { _ -> copy(scan_result_ref_list, source, 0) }
    state copy(scan_result_ref_list: &mut ScanResultRefList, source: &ScanResultRefList, position: u64) {
        transition position < source.count && position < 64 {
            true -> store(scan_result_ref_list, source, position)
            false -> done(scan_result_ref_list)
        }
    }
    state store(scan_result_ref_list: &mut ScanResultRefList, source: &ScanResultRefList, position: u64) {
        let pushed: bool = ScanResultRefList::push(scan_result_ref_list, &source.scan_result_refs[position]);
        transition { _ -> copy(scan_result_ref_list, source, position + 1) }
    }
    state done(scan_result_ref_list: &mut ScanResultRefList) {
    }
}

pub machine ScanResultRefList::get(scan_result_ref_list: &ScanResultRefList, position: u64) -> ScanResultRef {
    transition position < scan_result_ref_list.count && position < 64 {
        true -> clone_at(scan_result_ref_list, position)
        false -> (ScanResultRef::default())
    }
    state clone_at(scan_result_ref_list: &ScanResultRefList, position: u64) -> ScanResultRef {
        ScanResultRef::clone(&scan_result_ref_list.scan_result_refs[position])
    }
}

pub data ScanResultsDeleteRequest {
    scan_result_refs: ScanResultRefList;
}
