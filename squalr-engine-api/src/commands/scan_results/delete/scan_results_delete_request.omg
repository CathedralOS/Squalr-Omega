module src::commands::scan_results::delete::scan_results_delete_request;

use src::structures::scan_results::scan_result_ref::ScanResultRef;

// Port of commands/scan_results/delete/scan_results_delete_request.rs:
// upstream `scan_result_refs: Vec<ScanResultRef>` — a bounded list per the
// port's collection convention (same 64-member bound as the tombstone set
// it feeds; a delete request naming more indices truncates, a named
// deviation).
pub data ScanResultRefList {
    scan_result_refs: [ScanResultRef; 64];
    count: u64;
}

pub machine ScanResultRefList::empty() -> ScanResultRefList {
    ScanResultRefList { count: 0 }
}

pub machine ScanResultRefList::get_count(this: &ScanResultRefList) -> u64 {
    this.count
}

pub machine ScanResultRefList::push(this: &mut ScanResultRefList, scan_result_ref: &ScanResultRef) -> bool {
    transition this.count < 64 {
        true -> store(this, scan_result_ref)
        false -> (false)
    }
    state store(this: &mut ScanResultRefList, scan_result_ref: &ScanResultRef) -> bool {
        ScanResultRef::clone_from(&mut this.scan_result_refs[this.count], scan_result_ref);
        this.count = this.count + 1;
        true
    }
}

// Upstream `scan_result_refs.clone()` — the set-property executor hands a
// copy to the internal freeze request it fires for "is_frozen".
pub machine ScanResultRefList::clone_from(this: &mut ScanResultRefList, source: &ScanResultRefList) {
    this.count = 0;
    transition { _ -> copy(this, source, 0) }
    state copy(this: &mut ScanResultRefList, source: &ScanResultRefList, position: u64) {
        transition position < source.count && position < 64 {
            true -> store(this, source, position)
            false -> done(this)
        }
    }
    state store(this: &mut ScanResultRefList, source: &ScanResultRefList, position: u64) {
        let pushed: bool = ScanResultRefList::push(&mut this, &source.scan_result_refs[position]);
        transition { _ -> copy(this, source, position + 1) }
    }
    state done(this: &mut ScanResultRefList) {
    }
}

pub machine ScanResultRefList::get(this: &ScanResultRefList, position: u64) -> ScanResultRef {
    transition position < this.count && position < 64 {
        true -> clone_at(this, position)
        false -> (ScanResultRef::default())
    }
    state clone_at(this: &ScanResultRefList, position: u64) -> ScanResultRef {
        ScanResultRef::clone(&this.scan_result_refs[position])
    }
}

pub data ScanResultsDeleteRequest {
    scan_result_refs: ScanResultRefList;
}
