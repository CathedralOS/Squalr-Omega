module src::commands::scan_results::query::scan_results_query_response;

use src::commands::scan_results::list::scan_results_list_response::ScanResultPage;
use src::structures::results::snapshot_region_scan_results::DataTypeResultCounts;
use src::structures::scan_results::scan_result::ScanResult;

// Port of commands/scan_results/query/scan_results_query_response.rs.
// `page_index` is the resolved (clamped) index the snapshot actually
// served, matching upstream `effective_page_index`.
pub data ScanResultsQueryResponse {
    scan_results: ScanResultPage;
    data_type_result_counts: DataTypeResultCounts;
    page_index: u64;
    last_page_index: u64;
    page_size: u64;
    result_count: u64;
    total_size_in_bytes: u64;
}

pub machine ScanResultsQueryResponse::default() -> ScanResultsQueryResponse {
    ScanResultsQueryResponse {
        scan_results: ScanResultPage::empty(),
        data_type_result_counts: DataTypeResultCounts::empty(),
        page_index: 0,
        last_page_index: 0,
        page_size: 0,
        result_count: 0,
        total_size_in_bytes: 0,
    }
}

// Page projections for consumers whose unit kind lacks union-match
// terminators — same surface as ScanResultsListResponse.
pub machine ScanResultsQueryResponse::get_result_count(&self) -> u64 {
    self.scan_results.get_count()
}

pub machine ScanResultsQueryResponse::get_result_address(&self, position: u64) -> u64 {
    let scan_result: ScanResult = self.scan_results.get(position);
    scan_result.get_address()
}

pub machine ScanResultsQueryResponse::get_result_value(&self, position: u64) -> u64 {
    let scan_result: ScanResult = self.scan_results.get(position);
    scan_result.get_current_value()
}
