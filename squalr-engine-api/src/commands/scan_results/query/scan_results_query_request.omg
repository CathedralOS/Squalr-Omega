module src::commands::scan_results::query::scan_results_query_request;

use src::structures::snapshots::snapshot_region::DataTypeRefSet;

// Port of commands/scan_results/query/scan_results_query_request.rs: a page
// fetch without a value refresh (upstream pairs it with Refresh for live
// values). `Option<Vec<DataTypeRef>>` folds to `has_data_type_filters`
// beside the bounded set — an empty set selects every type.
pub data ScanResultsQueryRequest {
    page_index: u64;
    has_data_type_filters: bool;
    data_type_filters: DataTypeRefSet;
}
