module src::commands::scan_results::scan_results_response;

use src::commands::scan_results::delete::scan_results_delete_response::ScanResultsDeleteResponse;
use src::commands::scan_results::freeze::scan_results_freeze_response::ScanResultsFreezeResponse;
use src::commands::scan_results::list::scan_results_list_response::ScanResultsListResponse;
use src::commands::scan_results::query::scan_results_query_response::ScanResultsQueryResponse;
use src::commands::scan_results::refresh::scan_results_refresh_response::ScanResultsRefreshResponse;
use src::commands::scan_results::set_property::scan_results_set_property_response::ScanResultsSetPropertyResponse;

// Port of commands/scan_results/scan_results_response.rs.
pub data ScanResultsResponse {
    case List(response: ScanResultsListResponse);
    case Query(response: ScanResultsQueryResponse);
    case Refresh(response: ScanResultsRefreshResponse);
    case Freeze(response: ScanResultsFreezeResponse);
    case SetProperty(response: ScanResultsSetPropertyResponse);
    case Delete(response: ScanResultsDeleteResponse);
}

// Case queries keep callers in scalar guards where the unit kind lacks
// union-match terminators.
pub machine ScanResultsResponse::is_list(scan_results_response: &ScanResultsResponse) -> bool {
    transition scan_results_response {
        ScanResultsResponse::List { response } -> (true)
        _ -> (false)
    }
}

pub machine ScanResultsResponse::is_query(scan_results_response: &ScanResultsResponse) -> bool {
    transition scan_results_response {
        ScanResultsResponse::Query { response } -> (true)
        _ -> (false)
    }
}

pub machine ScanResultsResponse::is_refresh(scan_results_response: &ScanResultsResponse) -> bool {
    transition scan_results_response {
        ScanResultsResponse::Refresh { response } -> (true)
        _ -> (false)
    }
}

pub machine ScanResultsResponse::is_delete(scan_results_response: &ScanResultsResponse) -> bool {
    transition scan_results_response {
        ScanResultsResponse::Delete { response } -> (true)
        _ -> (false)
    }
}

pub machine ScanResultsResponse::is_freeze(scan_results_response: &ScanResultsResponse) -> bool {
    transition scan_results_response {
        ScanResultsResponse::Freeze { response } -> (true)
        _ -> (false)
    }
}

pub machine ScanResultsResponse::is_set_property(scan_results_response: &ScanResultsResponse) -> bool {
    transition scan_results_response {
        ScanResultsResponse::SetProperty { response } -> (true)
        _ -> (false)
    }
}

// Freeze projections: 0 / a default ref for cases that are not a freeze
// response.
pub machine ScanResultsResponse::get_failed_freeze_toggle_count(scan_results_response: &ScanResultsResponse) -> u64 {
    transition scan_results_response {
        ScanResultsResponse::Freeze { response } -> at(scan_results_response, response)
        _ -> (0)
    }
    state at(scan_results_response: &ScanResultsResponse, response: ScanResultsFreezeResponse) -> u64 {
        ScanResultsFreezeResponse::get_failed_count(&response)
    }
}

// Delete projections: 0 for cases that are not a delete response.
pub machine ScanResultsResponse::get_deleted_result_count(scan_results_response: &ScanResultsResponse) -> u64 {
    transition scan_results_response {
        ScanResultsResponse::Delete { response } -> at(scan_results_response, response)
        _ -> (0)
    }
    state at(scan_results_response: &ScanResultsResponse, response: ScanResultsDeleteResponse) -> u64 {
        ScanResultsDeleteResponse::get_deleted_result_count(&response)
    }
}

// Page projections for consumers whose unit kind lacks union-match
// terminators: 0 for cases that carry no result page.
pub machine ScanResultsResponse::get_result_count(scan_results_response: &ScanResultsResponse) -> u64 {
    transition scan_results_response {
        ScanResultsResponse::List { response } -> at(scan_results_response, response)
        ScanResultsResponse::Query { response } -> at_query(scan_results_response, response)
        ScanResultsResponse::Refresh { response } -> at_refresh(scan_results_response, response)
        _ -> (0)
    }
    state at(scan_results_response: &ScanResultsResponse, response: ScanResultsListResponse) -> u64 {
        ScanResultsListResponse::get_result_count(&response)
    }
    state at_query(scan_results_response: &ScanResultsResponse, response: ScanResultsQueryResponse) -> u64 {
        ScanResultsQueryResponse::get_result_count(&response)
    }
    state at_refresh(scan_results_response: &ScanResultsResponse, response: ScanResultsRefreshResponse) -> u64 {
        ScanResultsRefreshResponse::get_result_count(&response)
    }
}

pub machine ScanResultsResponse::get_result_address(scan_results_response: &ScanResultsResponse, position: u64) -> u64 {
    transition scan_results_response {
        ScanResultsResponse::List { response } -> at(scan_results_response, response, position)
        ScanResultsResponse::Query { response } -> at_query(scan_results_response, response, position)
        ScanResultsResponse::Refresh { response } -> at_refresh(scan_results_response, response, position)
        _ -> (0)
    }
    state at(scan_results_response: &ScanResultsResponse, response: ScanResultsListResponse, position: u64) -> u64 {
        ScanResultsListResponse::get_result_address(&response, position)
    }
    state at_query(scan_results_response: &ScanResultsResponse, response: ScanResultsQueryResponse, position: u64) -> u64 {
        ScanResultsQueryResponse::get_result_address(&response, position)
    }
    state at_refresh(scan_results_response: &ScanResultsResponse, response: ScanResultsRefreshResponse, position: u64) -> u64 {
        ScanResultsRefreshResponse::get_result_address(&response, position)
    }
}

pub machine ScanResultsResponse::get_result_value(scan_results_response: &ScanResultsResponse, position: u64) -> u64 {
    transition scan_results_response {
        ScanResultsResponse::List { response } -> at(scan_results_response, response, position)
        ScanResultsResponse::Query { response } -> at_query(scan_results_response, response, position)
        ScanResultsResponse::Refresh { response } -> at_refresh(scan_results_response, response, position)
        _ -> (0)
    }
    state at(scan_results_response: &ScanResultsResponse, response: ScanResultsListResponse, position: u64) -> u64 {
        ScanResultsListResponse::get_result_value(&response, position)
    }
    state at_query(scan_results_response: &ScanResultsResponse, response: ScanResultsQueryResponse, position: u64) -> u64 {
        ScanResultsQueryResponse::get_result_value(&response, position)
    }
    state at_refresh(scan_results_response: &ScanResultsResponse, response: ScanResultsRefreshResponse, position: u64) -> u64 {
        ScanResultsRefreshResponse::get_result_value(&response, position)
    }
}
