module src::commands::scan_results::scan_results_response;

use src::commands::scan_results::delete::scan_results_delete_response::ScanResultsDeleteResponse;
use src::commands::scan_results::list::scan_results_list_response::ScanResultsListResponse;

// Port of commands/scan_results/scan_results_response.rs.
pub data ScanResultsResponse {
    case List(response: ScanResultsListResponse);
    case Delete(response: ScanResultsDeleteResponse);
}

// Case queries keep callers in scalar guards where the unit kind lacks
// union-match terminators.
pub machine ScanResultsResponse::is_list(&self) -> bool {
    transition self {
        ScanResultsResponse::List { response } -> (true)
        _ -> (false)
    }
}

pub machine ScanResultsResponse::is_delete(&self) -> bool {
    transition self {
        ScanResultsResponse::Delete { response } -> (true)
        _ -> (false)
    }
}

// Delete projections: 0 for cases that are not a delete response.
pub machine ScanResultsResponse::get_deleted_result_count(&self) -> u64 {
    transition self {
        ScanResultsResponse::Delete { response } -> at(response)
        _ -> (0)
    }
    state at(&self, response: ScanResultsDeleteResponse) -> u64 {
        response.get_deleted_result_count()
    }
}

// Page projections for consumers whose unit kind lacks union-match
// terminators: 0 for cases that are not a result page.
pub machine ScanResultsResponse::get_result_count(&self) -> u64 {
    transition self {
        ScanResultsResponse::List { response } -> at(response)
        _ -> (0)
    }
    state at(&self, response: ScanResultsListResponse) -> u64 {
        response.get_result_count()
    }
}

pub machine ScanResultsResponse::get_result_address(&self, position: u64) -> u64 {
    transition self {
        ScanResultsResponse::List { response } -> at(response, position)
        _ -> (0)
    }
    state at(&self, response: ScanResultsListResponse, position: u64) -> u64 {
        response.get_result_address(position)
    }
}

pub machine ScanResultsResponse::get_result_value(&self, position: u64) -> u64 {
    transition self {
        ScanResultsResponse::List { response } -> at(response, position)
        _ -> (0)
    }
    state at(&self, response: ScanResultsListResponse, position: u64) -> u64 {
        response.get_result_value(position)
    }
}
