module src::commands::scan_results::scan_results_response;

use src::commands::scan_results::delete::scan_results_delete_response::ScanResultsDeleteResponse;
use src::commands::scan_results::freeze::scan_results_freeze_response::ScanResultsFreezeResponse;
use src::commands::scan_results::list::scan_results_list_response::ScanResultsListResponse;
use src::commands::scan_results::query::scan_results_query_response::ScanResultsQueryResponse;
use src::commands::scan_results::refresh::scan_results_refresh_response::ScanResultsRefreshResponse;
use src::commands::scan_results::set_property::scan_results_set_property_response::ScanResultsSetPropertyResponse;

// Port of commands/scan_results/scan_results_response.rs.
pub data ScanResultsResponse {
    case List(response: ScanResultsListResponse);
    case Query(response: ScanResultsQueryResponse);
    case Refresh(response: ScanResultsRefreshResponse);
    case Freeze(response: ScanResultsFreezeResponse);
    case SetProperty(response: ScanResultsSetPropertyResponse);
    case Delete(response: ScanResultsDeleteResponse);
}

// Case queries keep callers in scalar guards where the unit kind lacks
// union-match terminators.
pub machine ScanResultsResponse::is_list(&self) -> bool {
    transition self {
        ScanResultsResponse::List { response } -> (true)
        _ -> (false)
    }
}

pub machine ScanResultsResponse::is_query(&self) -> bool {
    transition self {
        ScanResultsResponse::Query { response } -> (true)
        _ -> (false)
    }
}

pub machine ScanResultsResponse::is_refresh(&self) -> bool {
    transition self {
        ScanResultsResponse::Refresh { response } -> (true)
        _ -> (false)
    }
}

pub machine ScanResultsResponse::is_delete(&self) -> bool {
    transition self {
        ScanResultsResponse::Delete { response } -> (true)
        _ -> (false)
    }
}

pub machine ScanResultsResponse::is_freeze(&self) -> bool {
    transition self {
        ScanResultsResponse::Freeze { response } -> (true)
        _ -> (false)
    }
}

pub machine ScanResultsResponse::is_set_property(&self) -> bool {
    transition self {
        ScanResultsResponse::SetProperty { response } -> (true)
        _ -> (false)
    }
}

// Freeze projections: 0 / a default ref for cases that are not a freeze
// response.
pub machine ScanResultsResponse::get_failed_freeze_toggle_count(&self) -> u64 {
    transition self {
        ScanResultsResponse::Freeze { response } -> at(response)
        _ -> (0)
    }
    state at(&self, response: ScanResultsFreezeResponse) -> u64 {
        response.get_failed_count()
    }
}

// Delete projections: 0 for cases that are not a delete response.
pub machine ScanResultsResponse::get_deleted_result_count(&self) -> u64 {
    transition self {
        ScanResultsResponse::Delete { response } -> at(response)
        _ -> (0)
    }
    state at(&self, response: ScanResultsDeleteResponse) -> u64 {
        response.get_deleted_result_count()
    }
}

// Page projections for consumers whose unit kind lacks union-match
// terminators: 0 for cases that carry no result page.
pub machine ScanResultsResponse::get_result_count(&self) -> u64 {
    transition self {
        ScanResultsResponse::List { response } -> at(response)
        ScanResultsResponse::Query { response } -> at_query(response)
        ScanResultsResponse::Refresh { response } -> at_refresh(response)
        _ -> (0)
    }
    state at(&self, response: ScanResultsListResponse) -> u64 {
        response.get_result_count()
    }
    state at_query(&self, response: ScanResultsQueryResponse) -> u64 {
        response.get_result_count()
    }
    state at_refresh(&self, response: ScanResultsRefreshResponse) -> u64 {
        response.get_result_count()
    }
}

pub machine ScanResultsResponse::get_result_address(&self, position: u64) -> u64 {
    transition self {
        ScanResultsResponse::List { response } -> at(response, position)
        ScanResultsResponse::Query { response } -> at_query(response, position)
        ScanResultsResponse::Refresh { response } -> at_refresh(response, position)
        _ -> (0)
    }
    state at(&self, response: ScanResultsListResponse, position: u64) -> u64 {
        response.get_result_address(position)
    }
    state at_query(&self, response: ScanResultsQueryResponse, position: u64) -> u64 {
        response.get_result_address(position)
    }
    state at_refresh(&self, response: ScanResultsRefreshResponse, position: u64) -> u64 {
        response.get_result_address(position)
    }
}

pub machine ScanResultsResponse::get_result_value(&self, position: u64) -> u64 {
    transition self {
        ScanResultsResponse::List { response } -> at(response, position)
        ScanResultsResponse::Query { response } -> at_query(response, position)
        ScanResultsResponse::Refresh { response } -> at_refresh(response, position)
        _ -> (0)
    }
    state at(&self, response: ScanResultsListResponse, position: u64) -> u64 {
        response.get_result_value(position)
    }
    state at_query(&self, response: ScanResultsQueryResponse, position: u64) -> u64 {
        response.get_result_value(position)
    }
    state at_refresh(&self, response: ScanResultsRefreshResponse, position: u64) -> u64 {
        response.get_result_value(position)
    }
}
