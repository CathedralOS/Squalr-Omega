module src::commands::scan_results::list::scan_results_list_request;

use src::structures::snapshots::snapshot_region::DataTypeRefSet;

// Port of commands/scan_results/list/scan_results_list_request.rs:
// `page_index` plus the optional data-type filter set. Upstream's
// `Option<Vec<DataTypeRef>>` folds to `has_data_type_filters` beside the
// bounded set — an empty set selects every type.
pub data ScanResultsListRequest {
    page_index: u64;
    has_data_type_filters: bool;
    data_type_filters: DataTypeRefSet;
}
