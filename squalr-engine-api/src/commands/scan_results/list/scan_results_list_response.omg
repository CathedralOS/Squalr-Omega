module src::commands::scan_results::list::scan_results_list_response;

use src::structures::results::snapshot_region_scan_results::DataTypeResultCounts;
use src::structures::scan_results::scan_result::ScanResult;

// The page's result list — upstream `Vec<ScanResult>` bounded at 64 (pages
// larger than the bound truncate, a named deviation; the default page size
// is 22).
pub data ScanResultPage {
    scan_results: [ScanResult; 64];
    count: u64;
}

pub machine ScanResultPage::empty() -> ScanResultPage {
    ScanResultPage { count: 0 }
}

pub machine ScanResultPage::get_count(scan_result_page: &ScanResultPage) -> u64 {
    scan_result_page.count
}

pub machine ScanResultPage::get(scan_result_page: &ScanResultPage, position: u64) -> ScanResult {
    transition position < scan_result_page.count && position < 64 {
        true -> clone_at(scan_result_page, position)
        false -> (ScanResult::default())
    }
    state clone_at(scan_result_page: &ScanResultPage, position: u64) -> ScanResult {
        ScanResult::clone(&scan_result_page.scan_results[position])
    }
}

pub machine ScanResultPage::push(scan_result_page: &mut ScanResultPage, scan_result: &ScanResult) -> bool {
    transition scan_result_page.count < 64 {
        true -> store(scan_result_page, scan_result)
        false -> (false)
    }
    state store(scan_result_page: &mut ScanResultPage, scan_result: &ScanResult) -> bool {
        ScanResult::clone_from(&mut scan_result_page.scan_results[scan_result_page.count], scan_result);
        scan_result_page.count = scan_result_page.count + 1;
        true
    }
}

// Element-wise page copy for `clone_from` on the response aggregate.
pub machine ScanResultPage::clone_from(scan_result_page: &mut ScanResultPage, source: &ScanResultPage) {
    scan_result_page.count = source.count;
    transition { _ -> each(scan_result_page, source, 0) }

    state each(scan_result_page: &mut ScanResultPage, source: &ScanResultPage, position: u64) {
        transition position < source.count && position < 64 {
            true -> one(scan_result_page, source, position)
            false -> done(scan_result_page)
            _ -> done(scan_result_page)
        }
    }

    state one(scan_result_page: &mut ScanResultPage, source: &ScanResultPage, position: u64)
        requires 0 <= position && position < 64
    {
        ScanResult::clone_from(&mut scan_result_page.scan_results[position], &source.scan_results[position]);
        transition { _ -> each(scan_result_page, source, position + 1) }
    }

    state done(scan_result_page: &mut ScanResultPage) {
        scan_result_page.count = scan_result_page.count;
    }
}

// Port of commands/scan_results/list/scan_results_list_response.rs.
pub data ScanResultsListResponse {
    scan_results: ScanResultPage;
    data_type_result_counts: DataTypeResultCounts;
    page_index: u64;
    page_size: u64;
    last_page_index: u64;
    result_count: u64;
    total_size_in_bytes: u64;
}

pub machine ScanResultsListResponse::default() -> ScanResultsListResponse {
    ScanResultsListResponse {
        scan_results: ScanResultPage::empty(),
        data_type_result_counts: DataTypeResultCounts::empty(),
        page_index: 0,
        page_size: 0,
        last_page_index: 0,
        result_count: 0,
        total_size_in_bytes: 0,
    }
}

// Page projections for consumers whose unit kind lacks union-match
// terminators.
pub machine ScanResultsListResponse::get_result_count(scan_results_list_response: &ScanResultsListResponse) -> u64 {
    ScanResultPage::get_count(&scan_results_list_response.scan_results)
}

pub machine ScanResultsListResponse::get_result(scan_results_list_response: &ScanResultsListResponse, position: u64) -> ScanResult {
    ScanResultPage::get(&scan_results_list_response.scan_results, position)
}

pub machine ScanResultsListResponse::get_result_address(scan_results_list_response: &ScanResultsListResponse, position: u64) -> u64 {
    let scan_result: ScanResult = ScanResultPage::get(&scan_results_list_response.scan_results, position);
    ScanResult::get_address(&scan_result)
}

pub machine ScanResultsListResponse::get_result_value(scan_results_list_response: &ScanResultsListResponse, position: u64) -> u64 {
    let scan_result: ScanResult = ScanResultPage::get(&scan_results_list_response.scan_results, position);
    ScanResult::get_current_value(&scan_result)
}

// Whole-response copy into a caller-owned slot — entry-machine receivers
// cannot assign a whole record field through the write-frame gate, so the
// store rides a mutating machine on the field itself.
pub machine ScanResultsListResponse::clone_from(scan_results_list_response: &mut ScanResultsListResponse, source: &ScanResultsListResponse) {
    ScanResultPage::clone_from(&mut scan_results_list_response.scan_results, &source.scan_results);
    DataTypeResultCounts::clone_from(&mut scan_results_list_response.data_type_result_counts, &source.data_type_result_counts);
    scan_results_list_response.page_index = source.page_index;
    scan_results_list_response.page_size = source.page_size;
    scan_results_list_response.last_page_index = source.last_page_index;
    scan_results_list_response.result_count = source.result_count;
    scan_results_list_response.total_size_in_bytes = source.total_size_in_bytes;
}
