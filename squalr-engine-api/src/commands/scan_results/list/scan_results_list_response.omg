module src::commands::scan_results::list::scan_results_list_response;

use src::structures::results::snapshot_region_scan_results::DataTypeResultCounts;
use src::structures::scan_results::scan_result::ScanResult;

// The page's result list — upstream `Vec<ScanResult>` bounded at 64 (pages
// larger than the bound truncate, a named deviation; the default page size
// is 22).
pub data ScanResultPage {
    scan_results: [ScanResult; 64];
    count: u64;
}

pub machine ScanResultPage::empty() -> ScanResultPage {
    ScanResultPage { count: 0 }
}

pub machine ScanResultPage::get_count(page: &ScanResultPage) -> u64 {
    page.count
}

pub machine ScanResultPage::get(page: &ScanResultPage, position: u64) -> ScanResult {
    transition position < page.count && position < 64 {
        true -> clone_at(page, position)
        false -> (ScanResult::default())
    }
    state clone_at(page: &ScanResultPage, position: u64) -> ScanResult {
        ScanResult::clone(&page.scan_results[position])
    }
}

pub machine ScanResultPage::push(page: &mut ScanResultPage, scan_result: &ScanResult) -> bool {
    transition page.count < 64 {
        true -> store(page, scan_result)
        false -> (false)
    }
    state store(page: &mut ScanResultPage, scan_result: &ScanResult) -> bool {
        ScanResult::clone_from(&mut page.scan_results[page.count], scan_result);
        page.count = page.count + 1;
        true
    }
}

// Element-wise page copy for `clone_from` on the response aggregate.
pub machine ScanResultPage::clone_from(page: &mut ScanResultPage, source: &ScanResultPage) {
    page.count = source.count;
    transition { _ -> each(page, source, 0) }

    state each(page: &mut ScanResultPage, source: &ScanResultPage, position: u64) {
        transition position < source.count && position < 64 {
            true -> one(page, source, position)
            false -> done(page)
            _ -> done(page)
        }
    }

    state one(page: &mut ScanResultPage, source: &ScanResultPage, position: u64)
        requires 0 <= position && position < 64
    {
        ScanResult::clone_from(&mut page.scan_results[position], &source.scan_results[position]);
        transition { _ -> each(page, source, position + 1) }
    }

    state done(page: &mut ScanResultPage) {
        page.count = page.count;
    }
}

// Port of commands/scan_results/list/scan_results_list_response.rs.
pub data ScanResultsListResponse {
    scan_results: ScanResultPage;
    data_type_result_counts: DataTypeResultCounts;
    page_index: u64;
    page_size: u64;
    last_page_index: u64;
    result_count: u64;
    total_size_in_bytes: u64;
}

pub machine ScanResultsListResponse::default() -> ScanResultsListResponse {
    ScanResultsListResponse {
        scan_results: ScanResultPage::empty(),
        data_type_result_counts: DataTypeResultCounts::empty(),
        page_index: 0,
        page_size: 0,
        last_page_index: 0,
        result_count: 0,
        total_size_in_bytes: 0,
    }
}

// Page projections for consumers whose unit kind lacks union-match
// terminators.
pub machine ScanResultsListResponse::get_result_count(response: &ScanResultsListResponse) -> u64 {
    ScanResultPage::get_count(&response.scan_results)
}

pub machine ScanResultsListResponse::get_result(response: &ScanResultsListResponse, position: u64) -> ScanResult {
    ScanResultPage::get(&response.scan_results, position)
}

pub machine ScanResultsListResponse::get_result_address(response: &ScanResultsListResponse, position: u64) -> u64 {
    let scan_result: ScanResult = ScanResultPage::get(&response.scan_results, position);
    ScanResult::get_address(&scan_result)
}

pub machine ScanResultsListResponse::get_result_value(response: &ScanResultsListResponse, position: u64) -> u64 {
    let scan_result: ScanResult = ScanResultPage::get(&response.scan_results, position);
    ScanResult::get_current_value(&scan_result)
}

// Whole-response copy into a caller-owned slot — entry-machine receivers
// cannot assign a whole record field through the write-frame gate, so the
// store rides a mutating machine on the field itself.
pub machine ScanResultsListResponse::clone_from(response: &mut ScanResultsListResponse, source: &ScanResultsListResponse) {
    ScanResultPage::clone_from(&mut response.scan_results, &source.scan_results);
    DataTypeResultCounts::clone_from(&mut response.data_type_result_counts, &source.data_type_result_counts);
    response.page_index = source.page_index;
    response.page_size = source.page_size;
    response.last_page_index = source.last_page_index;
    response.result_count = source.result_count;
    response.total_size_in_bytes = source.total_size_in_bytes;
}
