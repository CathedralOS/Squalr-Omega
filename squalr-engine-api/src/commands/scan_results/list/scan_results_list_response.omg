module src::commands::scan_results::list::scan_results_list_response;

use src::structures::results::snapshot_region_scan_results::DataTypeResultCounts;
use src::structures::scan_results::scan_result::ScanResult;

// The page's result list — upstream `Vec<ScanResult>` bounded at 64 (pages
// larger than the bound truncate, a named deviation; the default page size
// is 22).
pub data ScanResultPage {
    scan_results: [ScanResult; 64];
    count: u64;
}

pub machine ScanResultPage::empty() -> ScanResultPage {
    ScanResultPage { count: 0 }
}

pub machine ScanResultPage::get_count(&self) -> u64 {
    self.count
}

pub machine ScanResultPage::get(&self, position: u64) -> ScanResult {
    transition position < self.count && position < 64 {
        true -> clone_at(position)
        false -> (ScanResult::default())
    }
    state clone_at(&self, position: u64) -> ScanResult {
        ScanResult::clone(&self.scan_results[position])
    }
}

pub machine ScanResultPage::push(&mut self, scan_result: &ScanResult) -> bool {
    transition self.count < 64 {
        true -> store(scan_result)
        false -> (false)
    }
    state store(&mut self, scan_result: &ScanResult) -> bool {
        self.scan_results[self.count].clone_from(scan_result);
        self.count = self.count + 1;
        true
    }
}

// Element-wise page copy for `clone_from` on the response aggregate.
pub machine ScanResultPage::clone_from(&mut self, source: &ScanResultPage) {
    self.count = source.count;
    transition { _ -> each(source, 0) }

    state each(&mut self, source: &ScanResultPage, position: u64) {
        transition position < source.count && position < 64 {
            true -> one(source, position)
            false -> done()
            _ -> done()
        }
    }

    state one(&mut self, source: &ScanResultPage, position: u64 [0..64]) {
        self.scan_results[position].clone_from(&source.scan_results[position]);
        transition { _ -> each(source, position + 1) }
    }

    state done(&mut self) {
        self.count = self.count;
    }
}

// Port of commands/scan_results/list/scan_results_list_response.rs.
pub data ScanResultsListResponse {
    scan_results: ScanResultPage;
    data_type_result_counts: DataTypeResultCounts;
    page_index: u64;
    page_size: u64;
    last_page_index: u64;
    result_count: u64;
    total_size_in_bytes: u64;
}

pub machine ScanResultsListResponse::default() -> ScanResultsListResponse {
    ScanResultsListResponse {
        scan_results: ScanResultPage::empty(),
        data_type_result_counts: DataTypeResultCounts::empty(),
        page_index: 0,
        page_size: 0,
        last_page_index: 0,
        result_count: 0,
        total_size_in_bytes: 0,
    }
}

// Page projections for consumers whose unit kind lacks union-match
// terminators.
pub machine ScanResultsListResponse::get_result_count(&self) -> u64 {
    self.scan_results.get_count()
}

pub machine ScanResultsListResponse::get_result(&self, position: u64) -> ScanResult {
    self.scan_results.get(position)
}

pub machine ScanResultsListResponse::get_result_address(&self, position: u64) -> u64 {
    let scan_result: ScanResult = self.scan_results.get(position);
    scan_result.get_address()
}

pub machine ScanResultsListResponse::get_result_value(&self, position: u64) -> u64 {
    let scan_result: ScanResult = self.scan_results.get(position);
    scan_result.get_current_value()
}

// Whole-response copy into a caller-owned slot — entry-machine receivers
// cannot assign a whole record field through the write-frame gate, so the
// store rides a mutating machine on the field itself.
pub machine ScanResultsListResponse::clone_from(&mut self, source: &ScanResultsListResponse) {
    self.scan_results.clone_from(&source.scan_results);
    self.data_type_result_counts.clone_from(&source.data_type_result_counts);
    self.page_index = source.page_index;
    self.page_size = source.page_size;
    self.last_page_index = source.last_page_index;
    self.result_count = source.result_count;
    self.total_size_in_bytes = source.total_size_in_bytes;
}
