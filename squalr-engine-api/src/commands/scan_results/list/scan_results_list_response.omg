module src::commands::scan_results::list::scan_results_list_response;

use src::structures::results::snapshot_region_scan_results::DataTypeResultCounts;
use src::structures::scan_results::scan_result::ScanResult;

// The page's result list — upstream `Vec<ScanResult>` bounded at 64 (pages
// larger than the bound truncate, a named deviation; the default page size
// is 22).
pub data ScanResultPage {
    scan_results: [ScanResult; 64];
    count: u64;
}

pub machine ScanResultPage::empty() -> ScanResultPage {
    ScanResultPage { count: 0 }
}

pub machine ScanResultPage::get_count(this: &ScanResultPage) -> u64 {
    this.count
}

pub machine ScanResultPage::get(this: &ScanResultPage, position: u64) -> ScanResult {
    transition position < this.count && position < 64 {
        true -> clone_at(this, position)
        false -> (ScanResult::default())
    }
    state clone_at(this: &ScanResultPage, position: u64) -> ScanResult {
        let hoist1: ScanResult = ScanResult::clone(&this.scan_results[position]);
        (hoist1)
    }
}

pub machine ScanResultPage::push(this: &mut ScanResultPage, scan_result: &ScanResult) -> bool {
    transition this.count < 64 {
        true -> store(this, scan_result)
        false -> (false)
    }
    state store(this: &mut ScanResultPage, scan_result: &ScanResult) -> bool {
        ScanResult::clone_from(&mut this.scan_results[this.count], scan_result);
        this.count = this.count + 1;
        true
    }
}

// Element-wise page copy for `clone_from` on the response aggregate.
pub machine ScanResultPage::clone_from(this: &mut ScanResultPage, source: &ScanResultPage) {
    this.count = source.count;
    transition { _ -> each(this, source, 0) }

    state each(this: &mut ScanResultPage, source: &ScanResultPage, position: u64) {
        transition position < source.count && position < 64 {
            true -> one(this, source, position)
            false -> done(this)
            _ -> done(this)
        }
    }

    state one(this: &mut ScanResultPage, source: &ScanResultPage, position: u64)
        requires 0 <= position && position < 64
    {
        ScanResult::clone_from(&mut this.scan_results[position], &source.scan_results[position]);
        transition { _ -> each(this, source, position + 1) }
    }

    state done(this: &mut ScanResultPage) {
        this.count = this.count;
    }
}

// Port of commands/scan_results/list/scan_results_list_response.rs.
pub data ScanResultsListResponse {
    scan_results: ScanResultPage;
    data_type_result_counts: DataTypeResultCounts;
    page_index: u64;
    page_size: u64;
    last_page_index: u64;
    result_count: u64;
    total_size_in_bytes: u64;
}

pub machine ScanResultsListResponse::default() -> ScanResultsListResponse {
    ScanResultsListResponse {
        scan_results: ScanResultPage::empty(),
        data_type_result_counts: DataTypeResultCounts::empty(),
        page_index: 0,
        page_size: 0,
        last_page_index: 0,
        result_count: 0,
        total_size_in_bytes: 0,
    }
}

// Page projections for consumers whose unit kind lacks union-match
// terminators.
pub machine ScanResultsListResponse::get_result_count(this: &ScanResultsListResponse) -> u64 {
    let hoist2: u64 = ScanResultPage::get_count(&this.scan_results);
    (hoist2)
}

pub machine ScanResultsListResponse::get_result(this: &ScanResultsListResponse, position: u64) -> ScanResult {
    let hoist3: ScanResult = ScanResultPage::get(&this.scan_results, position);
    (hoist3)
}

pub machine ScanResultsListResponse::get_result_address(this: &ScanResultsListResponse, position: u64) -> u64 {
    let scan_result: ScanResult = ScanResultPage::get(&this.scan_results, position);
    let hoist4: u64 = ScanResult::get_address(&scan_result);
    (hoist4)
}

pub machine ScanResultsListResponse::get_result_value(this: &ScanResultsListResponse, position: u64) -> u64 {
    let scan_result: ScanResult = ScanResultPage::get(&this.scan_results, position);
    let hoist5: u64 = ScanResult::get_current_value(&scan_result);
    (hoist5)
}

// Whole-response copy into a caller-owned slot — entry-machine receivers
// cannot assign a whole record field through the write-frame gate, so the
// store rides a mutating machine on the field itself.
pub machine ScanResultsListResponse::clone_from(this: &mut ScanResultsListResponse, source: &ScanResultsListResponse) {
    ScanResultPage::clone_from(&mut this.scan_results, &source.scan_results);
    DataTypeResultCounts::clone_from(&mut this.data_type_result_counts, &source.data_type_result_counts);
    this.page_index = source.page_index;
    this.page_size = source.page_size;
    this.last_page_index = source.last_page_index;
    this.result_count = source.result_count;
    this.total_size_in_bytes = source.total_size_in_bytes;
}
