module src::commands::scan_results::freeze::scan_results_freeze_request;

use src::commands::scan_results::delete::scan_results_delete_request::ScanResultRefList;

// Port of commands/scan_results/freeze/scan_results_freeze_request.rs: the
// freeze-toggle request — `scan_result_refs` + `is_frozen`. The list is the
// same bounded 64-member `ScanResultRefList` the delete request carries.
pub data ScanResultsFreezeRequest {
    scan_result_refs: ScanResultRefList;
    is_frozen: bool;
}

// Upstream constructor used by `ScanResultsSetPropertyRequestExecutor` when
// firing the internal freeze request.
pub machine ScanResultsFreezeRequest::new(
    scan_result_refs: ScanResultRefList,
    is_frozen: bool
) -> ScanResultsFreezeRequest {
    ScanResultsFreezeRequest {
        scan_result_refs: scan_result_refs,
        is_frozen: is_frozen,
    }
}

pub machine ScanResultsFreezeRequest::get_scan_result_refs(&self) -> &ScanResultRefList {
    &self.scan_result_refs
}

pub machine ScanResultsFreezeRequest::get_is_frozen(&self) -> bool {
    self.is_frozen
}
