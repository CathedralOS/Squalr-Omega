module src::commands::scan_results::freeze::scan_results_freeze_response;

use src::commands::scan_results::delete::scan_results_delete_request::ScanResultRefList;
use src::structures::scan_results::scan_result_ref::ScanResultRef;

// Port of commands/scan_results/freeze/scan_results_freeze_response.rs: the
// refs whose freeze toggle failed to apply.
pub data ScanResultsFreezeResponse {
    failed_freeze_toggle_scan_result_refs: ScanResultRefList;
}

// Upstream `Default` — an empty failure list.
pub machine ScanResultsFreezeResponse::empty() -> ScanResultsFreezeResponse {
    ScanResultsFreezeResponse {
        failed_freeze_toggle_scan_result_refs: ScanResultRefList::empty(),
    }
}

pub machine ScanResultsFreezeResponse::push_failed(&mut self, scan_result_ref: &ScanResultRef) {
    let pushed: bool = self.failed_freeze_toggle_scan_result_refs.push(scan_result_ref);
}

pub machine ScanResultsFreezeResponse::get_failed_count(&self) -> u64 {
    self.failed_freeze_toggle_scan_result_refs.get_count()
}

pub machine ScanResultsFreezeResponse::get_failed(&self, position: u64) -> ScanResultRef {
    self.failed_freeze_toggle_scan_result_refs.get(position)
}
