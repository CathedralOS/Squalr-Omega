module src::commands::scan_results::freeze::scan_results_freeze_response;

use src::commands::scan_results::delete::scan_results_delete_request::ScanResultRefList;
use src::structures::scan_results::scan_result_ref::ScanResultRef;

// Port of commands/scan_results/freeze/scan_results_freeze_response.rs: the
// refs whose freeze toggle failed to apply.
public data ScanResultsFreezeResponse {
    failed_freeze_toggle_scan_result_refs: ScanResultRefList;
}

// Upstream `Default` — an empty failure list.
public machine ScanResultsFreezeResponse::empty() -> ScanResultsFreezeResponse {
    ScanResultsFreezeResponse {
        failed_freeze_toggle_scan_result_refs: ScanResultRefList::empty(),
    }
}

public machine ScanResultsFreezeResponse::push_failed(this: &mut ScanResultsFreezeResponse, scan_result_ref: &ScanResultRef) {
    let pushed: bool = ScanResultRefList::push(&mut this.failed_freeze_toggle_scan_result_refs, scan_result_ref);
}

public machine ScanResultsFreezeResponse::get_failed_count(this: &ScanResultsFreezeResponse) -> u64 {
    let hoist1: u64 = ScanResultRefList::get_count(&this.failed_freeze_toggle_scan_result_refs);
    (hoist1)
}

public machine ScanResultsFreezeResponse::get_failed(this: &ScanResultsFreezeResponse, position: u64) -> ScanResultRef {
    let hoist2: ScanResultRef = ScanResultRefList::get(&this.failed_freeze_toggle_scan_result_refs, position);
    (hoist2)
}
