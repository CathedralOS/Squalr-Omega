module src::commands::scan_results::freeze::scan_results_freeze_response;

use src::commands::scan_results::delete::scan_results_delete_request::ScanResultRefList;
use src::structures::scan_results::scan_result_ref::ScanResultRef;

// Port of commands/scan_results/freeze/scan_results_freeze_response.rs: the
// refs whose freeze toggle failed to apply.
pub data ScanResultsFreezeResponse {
    failed_freeze_toggle_scan_result_refs: ScanResultRefList;
}

// Upstream `Default` — an empty failure list.
pub machine ScanResultsFreezeResponse::empty() -> ScanResultsFreezeResponse {
    ScanResultsFreezeResponse {
        failed_freeze_toggle_scan_result_refs: ScanResultRefList::empty(),
    }
}

pub machine ScanResultsFreezeResponse::push_failed(scan_results_freeze_response: &mut ScanResultsFreezeResponse, scan_result_ref: &ScanResultRef) {
    let pushed: bool = ScanResultRefList::push(&mut scan_results_freeze_response.failed_freeze_toggle_scan_result_refs, scan_result_ref);
}

pub machine ScanResultsFreezeResponse::get_failed_count(scan_results_freeze_response: &ScanResultsFreezeResponse) -> u64 {
    ScanResultRefList::get_count(&scan_results_freeze_response.failed_freeze_toggle_scan_result_refs)
}

pub machine ScanResultsFreezeResponse::get_failed(scan_results_freeze_response: &ScanResultsFreezeResponse, position: u64) -> ScanResultRef {
    ScanResultRefList::get(&scan_results_freeze_response.failed_freeze_toggle_scan_result_refs, position)
}
