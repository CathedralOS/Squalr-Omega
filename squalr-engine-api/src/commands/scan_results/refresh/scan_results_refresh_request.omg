module src::commands::scan_results::refresh::scan_results_refresh_request;

use src::commands::scan_results::delete::scan_results_delete_request::ScanResultRefList;
use src::structures::scan_results::scan_result_ref::ScanResultRef;

// Port of commands/scan_results/refresh/scan_results_refresh_request.rs:
// the global scan-result indices to re-read, bounded to the same
// 64-member ScanResultRefList the delete request carries.
pub data ScanResultsRefreshRequest {
    scan_result_refs: ScanResultRefList;
}

pub machine ScanResultsRefreshRequest::new(scan_result_refs: &ScanResultRefList) -> ScanResultsRefreshRequest {
    let mut request: ScanResultsRefreshRequest = ScanResultsRefreshRequest {
        scan_result_refs: ScanResultRefList::empty(),
    };
    ScanResultRefList::clone_from(&mut request.scan_result_refs, scan_result_refs);
    request
}

// Upstream `get_scan_result_refs` — the page list view.
pub machine ScanResultsRefreshRequest::get_scan_result_ref_count(scan_results_refresh_request: &ScanResultsRefreshRequest) -> u64 {
    ScanResultRefList::get_count(&scan_results_refresh_request.scan_result_refs)
}

pub machine ScanResultsRefreshRequest::get_scan_result_ref(scan_results_refresh_request: &ScanResultsRefreshRequest, position: u64) -> ScanResultRef {
    ScanResultRefList::get(&scan_results_refresh_request.scan_result_refs, position)
}
