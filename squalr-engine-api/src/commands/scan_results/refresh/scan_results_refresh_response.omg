module src::commands::scan_results::refresh::scan_results_refresh_response;

use src::commands::scan_results::list::scan_results_list_response::ScanResultPage;
use src::structures::scan_results::scan_result::ScanResult;

// Port of commands/scan_results/refresh/scan_results_refresh_response.rs:
// the refreshed ScanResult list, one per resolvable ref.
pub data ScanResultsRefreshResponse {
    scan_results: ScanResultPage;
}

pub machine ScanResultsRefreshResponse::default() -> ScanResultsRefreshResponse {
    ScanResultsRefreshResponse {
        scan_results: ScanResultPage::empty(),
    }
}

pub machine ScanResultsRefreshResponse::get_result_count(scan_results_refresh_response: &ScanResultsRefreshResponse) -> u64 {
    ScanResultPage::get_count(&scan_results_refresh_response.scan_results)
}

pub machine ScanResultsRefreshResponse::get_result_address(scan_results_refresh_response: &ScanResultsRefreshResponse, position: u64) -> u64 {
    let scan_result: ScanResult = ScanResultPage::get(&scan_results_refresh_response.scan_results, position);
    ScanResult::get_address(&scan_result)
}

pub machine ScanResultsRefreshResponse::get_result_value(scan_results_refresh_response: &ScanResultsRefreshResponse, position: u64) -> u64 {
    let scan_result: ScanResult = ScanResultPage::get(&scan_results_refresh_response.scan_results, position);
    ScanResult::get_current_value(&scan_result)
}
