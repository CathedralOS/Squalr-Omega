use src/commands/scan_results/list/scan_results_list_response.omg;
use src/structures/scan_results/scan_result.omg;

// Port of commands/scan_results/refresh/scan_results_refresh_response.rs:
// the refreshed ScanResult list, one per resolvable ref.
public data ScanResultsRefreshResponse {
    scan_results: |scan_results_list_response|::ScanResultPage;
}

public machine ScanResultsRefreshResponse::default() -> ScanResultsRefreshResponse {
    ScanResultsRefreshResponse {
        scan_results: |scan_results_list_response|::ScanResultPage::empty(),
    }
}

public machine ScanResultsRefreshResponse::get_result_count(this: &ScanResultsRefreshResponse) -> u64 {
    let hoist1: u64 = |scan_results_list_response|::ScanResultPage::get_count(&this.scan_results);
    (hoist1)
}

public machine ScanResultsRefreshResponse::get_result_address(this: &ScanResultsRefreshResponse, position: u64) -> u64 {
    let scan_result: |scan_result|::ScanResult = |scan_results_list_response|::ScanResultPage::get(&this.scan_results, position);
    let hoist2: u64 = |scan_result|::ScanResult::get_address(&scan_result);
    (hoist2)
}

public machine ScanResultsRefreshResponse::get_result_value(this: &ScanResultsRefreshResponse, position: u64) -> u64 {
    let scan_result: |scan_result|::ScanResult = |scan_results_list_response|::ScanResultPage::get(&this.scan_results, position);
    let hoist3: u64 = |scan_result|::ScanResult::get_current_value(&scan_result);
    (hoist3)
}
