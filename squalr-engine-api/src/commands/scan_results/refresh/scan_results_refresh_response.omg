module src::commands::scan_results::refresh::scan_results_refresh_response;

use src::commands::scan_results::list::scan_results_list_response::ScanResultPage;
use src::structures::scan_results::scan_result::ScanResult;

// Port of commands/scan_results/refresh/scan_results_refresh_response.rs:
// the refreshed ScanResult list, one per resolvable ref.
pub data ScanResultsRefreshResponse {
    scan_results: ScanResultPage;
}

pub machine ScanResultsRefreshResponse::default() -> ScanResultsRefreshResponse {
    ScanResultsRefreshResponse {
        scan_results: ScanResultPage::empty(),
    }
}

pub machine ScanResultsRefreshResponse::get_result_count(this: &ScanResultsRefreshResponse) -> u64 {
    let hoist1: u64 = ScanResultPage::get_count(&this.scan_results);
    (hoist1)
}

pub machine ScanResultsRefreshResponse::get_result_address(this: &ScanResultsRefreshResponse, position: u64) -> u64 {
    let scan_result: ScanResult = ScanResultPage::get(&this.scan_results, position);
    let hoist2: u64 = ScanResult::get_address(&scan_result);
    (hoist2)
}

pub machine ScanResultsRefreshResponse::get_result_value(this: &ScanResultsRefreshResponse, position: u64) -> u64 {
    let scan_result: ScanResult = ScanResultPage::get(&this.scan_results, position);
    let hoist3: u64 = ScanResult::get_current_value(&scan_result);
    (hoist3)
}
