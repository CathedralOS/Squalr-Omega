module src::commands::scan_results::scan_results_command;

use src::commands::scan_results::delete::scan_results_delete_request::ScanResultsDeleteRequest;
use src::commands::scan_results::list::scan_results_list_request::ScanResultsListRequest;
use src::commands::scan_results::query::scan_results_query_request::ScanResultsQueryRequest;
use src::commands::scan_results::refresh::scan_results_refresh_request::ScanResultsRefreshRequest;

// Port of commands/scan_results/scan_results_command.rs: the results-domain
// command union, in upstream case order. `List`/`Query`/`Refresh`/`Delete`
// are wired; `Freeze`/`SetProperty` arrive with their own legs — the freeze
// registry and the property-write pipeline are deferred surfaces.
pub data ScanResultsCommand {
    case List(request: ScanResultsListRequest);
    case Query(request: ScanResultsQueryRequest);
    case Refresh(request: ScanResultsRefreshRequest);
    case Delete(request: ScanResultsDeleteRequest);
}
