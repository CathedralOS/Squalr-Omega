use src/commands/scan_results/delete/scan_results_delete_request.omg;
use src/commands/scan_results/freeze/scan_results_freeze_request.omg;
use src/commands/scan_results/list/scan_results_list_request.omg;
use src/commands/scan_results/query/scan_results_query_request.omg;
use src/commands/scan_results/refresh/scan_results_refresh_request.omg;
use src/commands/scan_results/set_property/scan_results_set_property_request.omg;

// Port of commands/scan_results/scan_results_command.rs: the results-domain
// command union, in upstream case order.
public data ScanResultsCommand {
    case List(request: |scan_results_list_request|::ScanResultsListRequest);
    case Query(request: |scan_results_query_request|::ScanResultsQueryRequest);
    case Refresh(request: |scan_results_refresh_request|::ScanResultsRefreshRequest);
    case Freeze(request: |scan_results_freeze_request|::ScanResultsFreezeRequest);
    case SetProperty(request: |scan_results_set_property_request|::ScanResultsSetPropertyRequest);
    case Delete(request: |scan_results_delete_request|::ScanResultsDeleteRequest);
}
