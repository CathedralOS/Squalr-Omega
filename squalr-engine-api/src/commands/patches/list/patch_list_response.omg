module src::commands::patches::list::patch_list_response;

use src::structures::patches::patch_command_status::PatchCommandStatus;
use src::structures::patches::patch_descriptor::PatchDescriptor;

// Port of commands/patches/list/patch_list_response.rs —
// {status: PatchCommandStatus, patches: Vec<PatchDescriptor>}. Vec carries
// the codebase's bounded-page convention: [PatchDescriptor; 64] + count,
// add_patch refusing past the bound (upstream's Vec is unbounded).
pub data PatchListResponse {
    status: PatchCommandStatus;
    patches: [PatchDescriptor; 64];
    patch_count: u64;
}

pub machine PatchListResponse::new(status: PatchCommandStatus) -> PatchListResponse {
    (PatchListResponse {
        status: status,
        patch_count: 0,
    })
}

pub machine PatchListResponse::get_status(patch_list_response: &PatchListResponse) -> &PatchCommandStatus {
    &patch_list_response.status
}

pub machine PatchListResponse::get_patch_count(patch_list_response: &PatchListResponse) -> u64 {
    patch_list_response.patch_count
}

pub machine PatchListResponse::get_patch(patch_list_response: &PatchListResponse, position: u64) -> &PatchDescriptor
    requires 0 <= position && position < 64
{
    &patch_list_response.patches[position]
}

// false past the 64-entry page bound.
pub machine PatchListResponse::add_patch(patch_list_response: &mut PatchListResponse, patch: &PatchDescriptor) -> bool {
    transition patch_list_response.patch_count < 64 {
        true -> store(patch_list_response, patch)
        false -> (false)
    }
    state store(patch_list_response: &mut PatchListResponse, patch: &PatchDescriptor) -> bool {
        PatchDescriptor::clone_from(&mut patch_list_response.patches[patch_list_response.patch_count], patch);
        patch_list_response.patch_count = ((patch_list_response.patch_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
