module src::commands::patches::list::patch_list_response;

use src::structures::patches::patch_command_status::PatchCommandStatus;
use src::structures::patches::patch_descriptor::PatchDescriptor;

// Port of commands/patches/list/patch_list_response.rs —
// {status: PatchCommandStatus, patches: Vec<PatchDescriptor>}. Vec carries
// the codebase's bounded-page convention: [PatchDescriptor; 64] + count,
// add_patch refusing past the bound (upstream's Vec is unbounded).
pub data PatchListResponse {
    status: PatchCommandStatus;
    patches: [PatchDescriptor; 64];
    patch_count: u64;
}

pub machine PatchListResponse::new(status: PatchCommandStatus) -> PatchListResponse {
    (PatchListResponse {
        status: status,
        patch_count: 0,
    })
}

pub machine PatchListResponse::get_status(this: &PatchListResponse) -> &PatchCommandStatus {
    &this.status
}

pub machine PatchListResponse::get_patch_count(this: &PatchListResponse) -> u64 {
    this.patch_count
}

pub machine PatchListResponse::get_patch(this: &PatchListResponse, position: u64) -> &PatchDescriptor
    requires 0 <= position && position < 64
{
    &this.patches[position]
}

// false past the 64-entry page bound.
pub machine PatchListResponse::add_patch(this: &mut PatchListResponse, patch: &PatchDescriptor) -> bool {
    transition this.patch_count < 64 {
        true -> store(this, patch)
        false -> (false)
    }
    state store(this: &mut PatchListResponse, patch: &PatchDescriptor) -> bool {
        PatchDescriptor::clone_from(&mut this.patches[this.patch_count], patch);
        this.patch_count = ((this.patch_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
