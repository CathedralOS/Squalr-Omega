use src/structures/patches/patch_command_status.omg;
use src/structures/patches/patch_descriptor.omg;

// Port of commands/patches/list/patch_list_response.rs —
// {status: PatchCommandStatus, patches: Vec<PatchDescriptor>}. Vec carries
// the codebase's bounded-page convention: [PatchDescriptor; 64] + count,
// add_patch refusing past the bound (upstream's Vec is unbounded).
public data PatchListResponse {
    status: |patch_command_status|::PatchCommandStatus;
    patches: [|patch_descriptor|::PatchDescriptor; 64];
    patch_count: u64;
}

public machine PatchListResponse::new(status: |patch_command_status|::PatchCommandStatus) -> PatchListResponse {
    (PatchListResponse {
        status: status,
        patch_count: 0,
    })
}

public machine PatchListResponse::get_status(this: &PatchListResponse) -> &|patch_command_status|::PatchCommandStatus {
    &this.status
}

public machine PatchListResponse::get_patch_count(this: &PatchListResponse) -> u64 {
    this.patch_count
}

public machine PatchListResponse::get_patch(this: &PatchListResponse, position: u64) -> &|patch_descriptor|::PatchDescriptor
    requires 0 <= position && position < 64
{
    &this.patches[position]
}

// false past the 64-entry page bound.
public machine PatchListResponse::add_patch(this: &mut PatchListResponse, patch: &|patch_descriptor|::PatchDescriptor) -> bool {
    transition this.patch_count < 64 {
        true -> store(this, patch)
        false -> (false)
    }
    machine store(this: &mut PatchListResponse, patch: &|patch_descriptor|::PatchDescriptor) -> bool {
        |patch_descriptor|::PatchDescriptor::clone_from(&mut this.patches[this.patch_count], patch);
        this.patch_count = ((this.patch_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
