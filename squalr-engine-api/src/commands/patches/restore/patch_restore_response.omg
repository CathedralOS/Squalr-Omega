use src/structures/patches/patch_command_status.omg;
use src/structures/patches/patch_descriptor.omg;

// Port of commands/patches/restore/patch_restore_response.rs —
// {status: PatchCommandStatus, patch: Option<PatchDescriptor>}. patch is
// has_patch + the descriptor record (set_patch copies through clone_from).
public data PatchRestoreResponse {
    status: |patch_command_status|::PatchCommandStatus;
    has_patch: bool;
    patch: |patch_descriptor|::PatchDescriptor;
}

public machine PatchRestoreResponse::new(status: |patch_command_status|::PatchCommandStatus) -> PatchRestoreResponse {
    (PatchRestoreResponse {
        status: status,
        has_patch: false,
    })
}

public machine PatchRestoreResponse::get_status(this: &PatchRestoreResponse) -> &|patch_command_status|::PatchCommandStatus {
    &this.status
}

public machine PatchRestoreResponse::has_patch(this: &PatchRestoreResponse) -> bool {
    this.has_patch
}

public machine PatchRestoreResponse::get_patch(this: &PatchRestoreResponse) -> &|patch_descriptor|::PatchDescriptor {
    &this.patch
}

public machine PatchRestoreResponse::set_patch(this: &mut PatchRestoreResponse, patch: &|patch_descriptor|::PatchDescriptor) {
    |patch_descriptor|::PatchDescriptor::clone_from(&mut this.patch, patch);
    this.has_patch = true;
}

public machine PatchRestoreResponse::clear_patch(this: &mut PatchRestoreResponse) {
    this.has_patch = false;
}
