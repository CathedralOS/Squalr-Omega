module src::commands::patches::restore::patch_restore_response;

use src::structures::patches::patch_command_status::PatchCommandStatus;
use src::structures::patches::patch_descriptor::PatchDescriptor;

// Port of commands/patches/restore/patch_restore_response.rs —
// {status: PatchCommandStatus, patch: Option<PatchDescriptor>}. patch is
// has_patch + the descriptor record (set_patch copies through clone_from).
pub data PatchRestoreResponse {
    status: PatchCommandStatus;
    has_patch: bool;
    patch: PatchDescriptor;
}

pub machine PatchRestoreResponse::new(status: PatchCommandStatus) -> PatchRestoreResponse {
    (PatchRestoreResponse {
        status: status,
        has_patch: false,
    })
}

pub machine PatchRestoreResponse::get_status(patch_restore_response: &PatchRestoreResponse) -> &PatchCommandStatus {
    &patch_restore_response.status
}

pub machine PatchRestoreResponse::has_patch(patch_restore_response: &PatchRestoreResponse) -> bool {
    patch_restore_response.has_patch
}

pub machine PatchRestoreResponse::get_patch(patch_restore_response: &PatchRestoreResponse) -> &PatchDescriptor {
    &patch_restore_response.patch
}

pub machine PatchRestoreResponse::set_patch(patch_restore_response: &mut PatchRestoreResponse, patch: &PatchDescriptor) {
    PatchDescriptor::clone_from(&mut patch_restore_response.patch, patch);
    patch_restore_response.has_patch = true;
}

pub machine PatchRestoreResponse::clear_patch(patch_restore_response: &mut PatchRestoreResponse) {
    patch_restore_response.has_patch = false;
}
