module src::commands::patches::restore::patch_restore_request;

use src::structures::bounded_slice::bounded_slice;

// Port of commands/patches/restore/patch_restore_request.rs —
// {patch_id: String} on the bounded span.
pub data PatchRestoreRequest {
    patch_id: [u8; 256];
    patch_id_len: u64;
}

pub machine PatchRestoreRequest::new() -> PatchRestoreRequest {
    PatchRestoreRequest {
        patch_id_len: 0,
    }
}

pub machine PatchRestoreRequest::get_patch_id(&self) -> &[u8] {
    bounded_slice(&self.patch_id[0..256], self.patch_id_len)
}

pub machine PatchRestoreRequest::set_patch_id(&mut self, patch_id: &[u8]) {
    self.patch_id_len = 0;
    transition { _ -> copy(patch_id, 0) }
    state copy(&mut self, patch_id: &[u8], position: u64) {
        transition position < patch_id.len && position < 256 {
            true -> store(patch_id, position)
            false -> finish(position)
        }
    }
    state store(&mut self, patch_id: &[u8], position: u64) {
        self.patch_id[position] = patch_id[position];
        transition {
            _ -> copy(patch_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.patch_id_len = count;
    }
}
