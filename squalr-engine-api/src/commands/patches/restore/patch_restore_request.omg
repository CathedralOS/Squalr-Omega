module src::commands::patches::restore::patch_restore_request;

// Port of commands/patches/restore/patch_restore_request.rs —
// {patch_id: String} on the bounded span.
pub data PatchRestoreRequest {
    patch_id: [u8; 256];
    patch_id_len: u64;
}

pub machine PatchRestoreRequest::new() -> PatchRestoreRequest {
    PatchRestoreRequest {
        patch_id_len: 0,
    }
}

pub machine PatchRestoreRequest::get_patch_id(patch_restore_request: &PatchRestoreRequest) -> &[u8] {
    transition patch_restore_request.patch_id_len <= 256 {
        true -> (&patch_restore_request.patch_id[0..patch_restore_request.patch_id_len])
        false -> (&patch_restore_request.patch_id[0..256])
        _ -> (&patch_restore_request.patch_id[0..256])
    }
}

pub machine PatchRestoreRequest::set_patch_id(patch_restore_request: &mut PatchRestoreRequest, patch_id: &[u8]) {
    patch_restore_request.patch_id_len = 0;
    transition { _ -> copy(patch_restore_request, patch_id, 0) }
    state copy(patch_restore_request: &mut PatchRestoreRequest, patch_id: &[u8], position: u64) {
        transition position < patch_id.len && position < 256 {
            true -> store(patch_restore_request, patch_id, position)
            false -> finish(patch_restore_request, position)
        }
    }
    state store(patch_restore_request: &mut PatchRestoreRequest, patch_id: &[u8], position: u64) {
        patch_restore_request.patch_id[position] = patch_id[position];
        transition {
            _ -> copy(patch_restore_request, patch_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(patch_restore_request: &mut PatchRestoreRequest, count: u64) {
        patch_restore_request.patch_id_len = count;
    }
}
