module src::commands::patches::no_operation::patch_no_operation_response;

use src::structures::patches::patch_command_status::PatchCommandStatus;
use src::structures::patches::patch_descriptor::PatchDescriptor;

// Port of commands/patches/no_operation/patch_no_operation_response.rs —
// {status: PatchCommandStatus, patch: Option<PatchDescriptor>}. patch is
// has_patch + the descriptor record (set_patch copies through clone_from).
pub data PatchNoOperationResponse {
    status: PatchCommandStatus;
    has_patch: bool;
    patch: PatchDescriptor;
}

pub machine PatchNoOperationResponse::new(status: PatchCommandStatus) -> PatchNoOperationResponse {
    (PatchNoOperationResponse {
        status: status,
        has_patch: false,
    })
}

pub machine PatchNoOperationResponse::get_status(patch_no_operation_response: &PatchNoOperationResponse) -> &PatchCommandStatus {
    &patch_no_operation_response.status
}

pub machine PatchNoOperationResponse::has_patch(patch_no_operation_response: &PatchNoOperationResponse) -> bool {
    patch_no_operation_response.has_patch
}

pub machine PatchNoOperationResponse::get_patch(patch_no_operation_response: &PatchNoOperationResponse) -> &PatchDescriptor {
    &patch_no_operation_response.patch
}

pub machine PatchNoOperationResponse::set_patch(patch_no_operation_response: &mut PatchNoOperationResponse, patch: &PatchDescriptor) {
    PatchDescriptor::clone_from(&mut patch_no_operation_response.patch, patch);
    patch_no_operation_response.has_patch = true;
}

pub machine PatchNoOperationResponse::clear_patch(patch_no_operation_response: &mut PatchNoOperationResponse) {
    patch_no_operation_response.has_patch = false;
}
