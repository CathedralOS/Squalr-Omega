module src::commands::patches::no_operation::patch_no_operation_request;

// Port of commands/patches/no_operation/patch_no_operation_request.rs —
// {address, module_name, label: Option}.
pub data PatchNoOperationRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
}

pub machine PatchNoOperationRequest::new(address: u64) -> PatchNoOperationRequest {
    PatchNoOperationRequest {
        address: address,
        module_name_len: 0,
        has_label: false,
        label_len: 0,
    }
}

pub machine PatchNoOperationRequest::get_address(this: &PatchNoOperationRequest) -> u64 {
    this.address
}

pub machine PatchNoOperationRequest::set_address(this: &mut PatchNoOperationRequest, address: u64) {
    this.address = address;
}

pub machine PatchNoOperationRequest::has_label(this: &PatchNoOperationRequest) -> bool {
    this.has_label
}

pub machine PatchNoOperationRequest::get_module_name(this: &PatchNoOperationRequest) -> &[u8] {
    transition this.module_name_len <= 256 {
        true -> (&this.module_name[0..this.module_name_len])
        false -> (&this.module_name[0..256])
        _ -> (&this.module_name[0..256])
    }
}

pub machine PatchNoOperationRequest::set_module_name(this: &mut PatchNoOperationRequest, module_name: &[u8]) {
    this.module_name_len = 0;
    transition { _ -> copy(this, module_name, 0) }
    state copy(this: &mut PatchNoOperationRequest, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(this, module_name, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut PatchNoOperationRequest, module_name: &[u8], position: u64) {
        this.module_name[position] = module_name[position];
        transition {
            _ -> copy(this, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut PatchNoOperationRequest, count: u64) {
        this.module_name_len = count;
    }
}

pub machine PatchNoOperationRequest::get_label(this: &PatchNoOperationRequest) -> &[u8] {
    transition this.label_len <= 256 {
        true -> (&this.label[0..this.label_len])
        false -> (&this.label[0..256])
        _ -> (&this.label[0..256])
    }
}

pub machine PatchNoOperationRequest::set_label(this: &mut PatchNoOperationRequest, label: &[u8]) {
    this.label_len = 0;
    transition { _ -> copy(this, label, 0) }
    state copy(this: &mut PatchNoOperationRequest, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store(this, label, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut PatchNoOperationRequest, label: &[u8], position: u64) {
        this.label[position] = label[position];
        transition {
            _ -> copy(this, label, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut PatchNoOperationRequest, count: u64) {
        this.label_len = count;
    }
}

pub machine PatchNoOperationRequest::clear_label(this: &mut PatchNoOperationRequest) {
    this.has_label = false;
    this.label_len = 0;
}
