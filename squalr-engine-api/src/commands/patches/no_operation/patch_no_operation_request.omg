module src::commands::patches::no_operation::patch_no_operation_request;

// Port of commands/patches/no_operation/patch_no_operation_request.rs —
// {address, module_name, label: Option}.
pub data PatchNoOperationRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
}

pub machine PatchNoOperationRequest::new(address: u64) -> PatchNoOperationRequest {
    PatchNoOperationRequest {
        address: address,
        module_name_len: 0,
        has_label: false,
        label_len: 0,
    }
}

pub machine PatchNoOperationRequest::get_address(patch_no_operation_request: &PatchNoOperationRequest) -> u64 {
    patch_no_operation_request.address
}

pub machine PatchNoOperationRequest::set_address(patch_no_operation_request: &mut PatchNoOperationRequest, address: u64) {
    patch_no_operation_request.address = address;
}

pub machine PatchNoOperationRequest::has_label(patch_no_operation_request: &PatchNoOperationRequest) -> bool {
    patch_no_operation_request.has_label
}

pub machine PatchNoOperationRequest::get_module_name(patch_no_operation_request: &PatchNoOperationRequest) -> &[u8] {
    transition patch_no_operation_request.module_name_len <= 256 {
        true -> (&patch_no_operation_request.module_name[0..patch_no_operation_request.module_name_len])
        false -> (&patch_no_operation_request.module_name[0..256])
        _ -> (&patch_no_operation_request.module_name[0..256])
    }
}

pub machine PatchNoOperationRequest::set_module_name(patch_no_operation_request: &mut PatchNoOperationRequest, module_name: &[u8]) {
    patch_no_operation_request.module_name_len = 0;
    transition { _ -> copy(patch_no_operation_request, module_name, 0) }
    state copy(patch_no_operation_request: &mut PatchNoOperationRequest, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(patch_no_operation_request, module_name, position)
            false -> finish(patch_no_operation_request, position)
        }
    }
    state store(patch_no_operation_request: &mut PatchNoOperationRequest, module_name: &[u8], position: u64) {
        patch_no_operation_request.module_name[position] = module_name[position];
        transition {
            _ -> copy(patch_no_operation_request, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(patch_no_operation_request: &mut PatchNoOperationRequest, count: u64) {
        patch_no_operation_request.module_name_len = count;
    }
}

pub machine PatchNoOperationRequest::get_label(patch_no_operation_request: &PatchNoOperationRequest) -> &[u8] {
    transition patch_no_operation_request.label_len <= 256 {
        true -> (&patch_no_operation_request.label[0..patch_no_operation_request.label_len])
        false -> (&patch_no_operation_request.label[0..256])
        _ -> (&patch_no_operation_request.label[0..256])
    }
}

pub machine PatchNoOperationRequest::set_label(patch_no_operation_request: &mut PatchNoOperationRequest, label: &[u8]) {
    patch_no_operation_request.label_len = 0;
    transition { _ -> copy(patch_no_operation_request, label, 0) }
    state copy(patch_no_operation_request: &mut PatchNoOperationRequest, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store(patch_no_operation_request, label, position)
            false -> finish(patch_no_operation_request, position)
        }
    }
    state store(patch_no_operation_request: &mut PatchNoOperationRequest, label: &[u8], position: u64) {
        patch_no_operation_request.label[position] = label[position];
        transition {
            _ -> copy(patch_no_operation_request, label, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(patch_no_operation_request: &mut PatchNoOperationRequest, count: u64) {
        patch_no_operation_request.label_len = count;
    }
}

pub machine PatchNoOperationRequest::clear_label(patch_no_operation_request: &mut PatchNoOperationRequest) {
    patch_no_operation_request.has_label = false;
    patch_no_operation_request.label_len = 0;
}
