module src::commands::patches::no_operation::patch_no_operation_request;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::bounded_slice::bounded_slice;

// Port of commands/patches/no_operation/patch_no_operation_request.rs —
// {address, module_name, label: Option}.
pub data PatchNoOperationRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
}

pub machine PatchNoOperationRequest::new(address: u64) -> PatchNoOperationRequest {
    PatchNoOperationRequest {
        address: address,
        module_name_len: 0,
        has_label: false,
        label_len: 0,
    }
}

pub machine PatchNoOperationRequest::get_address(&self) -> u64 {
    self.address
}

pub machine PatchNoOperationRequest::set_address(&mut self, address: u64) {
    self.address = address;
}

pub machine PatchNoOperationRequest::has_label(&self) -> bool {
    self.has_label
}

pub machine PatchNoOperationRequest::get_module_name(&self) -> &[u8] {
    bounded_slice(&self.module_name[0..256], self.module_name_len)
}

pub machine PatchNoOperationRequest::set_module_name(&mut self, module_name: &[u8]) {
    self.module_name_len = BoundedByteCopy::copy(&mut self.module_name[0..256], module_name);
}

pub machine PatchNoOperationRequest::get_label(&self) -> &[u8] {
    bounded_slice(&self.label[0..256], self.label_len)
}

pub machine PatchNoOperationRequest::set_label(&mut self, label: &[u8]) {
    self.label_len = BoundedByteCopy::copy(&mut self.label[0..256], label);
}

pub machine PatchNoOperationRequest::clear_label(&mut self) {
    self.has_label = false;
    self.label_len = 0;
}
