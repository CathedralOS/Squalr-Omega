module src::commands::patches::patches_command;

use src::commands::patches::apply::patch_apply_request::PatchApplyRequest;
use src::commands::patches::list::patch_list_request::PatchListRequest;
use src::commands::patches::no_operation::patch_no_operation_request::PatchNoOperationRequest;
use src::commands::patches::restore::patch_restore_request::PatchRestoreRequest;
use src::commands::patches::restore_address::patch_restore_address_request::PatchRestoreAddressRequest;

// Port of commands/patches/patches_command.rs — Apply, NoOperation,
// Restore, RestoreAddress, List in upstream declaration order.
pub data PatchesCommand {
    case Apply(request: PatchApplyRequest);
    case NoOperation(request: PatchNoOperationRequest);
    case Restore(request: PatchRestoreRequest);
    case RestoreAddress(request: PatchRestoreAddressRequest);
    case List(request: PatchListRequest);
}
