use src/commands/patches/apply/patch_apply_request.omg;
use src/commands/patches/list/patch_list_request.omg;
use src/commands/patches/no_operation/patch_no_operation_request.omg;
use src/commands/patches/restore/patch_restore_request.omg;
use src/commands/patches/restore_address/patch_restore_address_request.omg;

// Port of commands/patches/patches_command.rs — Apply, NoOperation,
// Restore, RestoreAddress, List in upstream declaration order.
public data PatchesCommand {
    case Apply(request: |patch_apply_request|::PatchApplyRequest);
    case NoOperation(request: |patch_no_operation_request|::PatchNoOperationRequest);
    case Restore(request: |patch_restore_request|::PatchRestoreRequest);
    case RestoreAddress(request: |patch_restore_address_request|::PatchRestoreAddressRequest);
    case List(request: |patch_list_request|::PatchListRequest);
}
