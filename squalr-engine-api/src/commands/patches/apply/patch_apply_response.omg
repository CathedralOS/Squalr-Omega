use src/structures/patches/patch_command_status.omg;
use src/structures/patches/patch_descriptor.omg;

// Port of commands/patches/apply/patch_apply_response.rs —
// {status: PatchCommandStatus, patch: Option<PatchDescriptor>}. patch is
// has_patch + the descriptor record (set_patch copies through clone_from).
public data PatchApplyResponse {
    status: |patch_command_status|::PatchCommandStatus;
    has_patch: bool;
    patch: |patch_descriptor|::PatchDescriptor;
}

public machine PatchApplyResponse::new(status: |patch_command_status|::PatchCommandStatus) -> PatchApplyResponse {
    (PatchApplyResponse {
        status: status,
        has_patch: false,
    })
}

public machine PatchApplyResponse::get_status(this: &PatchApplyResponse) -> &|patch_command_status|::PatchCommandStatus {
    &this.status
}

public machine PatchApplyResponse::has_patch(this: &PatchApplyResponse) -> bool {
    this.has_patch
}

public machine PatchApplyResponse::get_patch(this: &PatchApplyResponse) -> &|patch_descriptor|::PatchDescriptor {
    &this.patch
}

public machine PatchApplyResponse::set_patch(this: &mut PatchApplyResponse, patch: &|patch_descriptor|::PatchDescriptor) {
    |patch_descriptor|::PatchDescriptor::clone_from(&mut this.patch, patch);
    this.has_patch = true;
}

public machine PatchApplyResponse::clear_patch(this: &mut PatchApplyResponse) {
    this.has_patch = false;
}
