module src::commands::patches::apply::patch_apply_response;

use src::structures::patches::patch_command_status::PatchCommandStatus;
use src::structures::patches::patch_descriptor::PatchDescriptor;

// Port of commands/patches/apply/patch_apply_response.rs —
// {status: PatchCommandStatus, patch: Option<PatchDescriptor>}. patch is
// has_patch + the descriptor record (set_patch copies through clone_from).
pub data PatchApplyResponse {
    status: PatchCommandStatus;
    has_patch: bool;
    patch: PatchDescriptor;
}

pub machine PatchApplyResponse::new(status: PatchCommandStatus) -> PatchApplyResponse {
    (PatchApplyResponse {
        status: status,
        has_patch: false,
    })
}

pub machine PatchApplyResponse::get_status(patch_apply_response: &PatchApplyResponse) -> &PatchCommandStatus {
    &patch_apply_response.status
}

pub machine PatchApplyResponse::has_patch(patch_apply_response: &PatchApplyResponse) -> bool {
    patch_apply_response.has_patch
}

pub machine PatchApplyResponse::get_patch(patch_apply_response: &PatchApplyResponse) -> &PatchDescriptor {
    &patch_apply_response.patch
}

pub machine PatchApplyResponse::set_patch(patch_apply_response: &mut PatchApplyResponse, patch: &PatchDescriptor) {
    PatchDescriptor::clone_from(&mut patch_apply_response.patch, patch);
    patch_apply_response.has_patch = true;
}

pub machine PatchApplyResponse::clear_patch(patch_apply_response: &mut PatchApplyResponse) {
    patch_apply_response.has_patch = false;
}
