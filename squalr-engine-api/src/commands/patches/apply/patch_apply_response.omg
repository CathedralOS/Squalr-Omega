module src::commands::patches::apply::patch_apply_response;

use src::structures::patches::patch_command_status::PatchCommandStatus;
use src::structures::patches::patch_descriptor::PatchDescriptor;

// Port of commands/patches/apply/patch_apply_response.rs —
// {status: PatchCommandStatus, patch: Option<PatchDescriptor>}. patch is
// has_patch + the descriptor record (set_patch copies through clone_from).
pub data PatchApplyResponse {
    status: PatchCommandStatus;
    has_patch: bool;
    patch: PatchDescriptor;
}

pub machine PatchApplyResponse::new(status: PatchCommandStatus) -> PatchApplyResponse {
    (PatchApplyResponse {
        status: status,
        has_patch: false,
    })
}

pub machine PatchApplyResponse::get_status(&self) -> &PatchCommandStatus {
    &self.status
}

pub machine PatchApplyResponse::has_patch(&self) -> bool {
    self.has_patch
}

pub machine PatchApplyResponse::get_patch(&self) -> &PatchDescriptor {
    &self.patch
}

pub machine PatchApplyResponse::set_patch(&mut self, patch: &PatchDescriptor) {
    self.patch.clone_from(patch);
    self.has_patch = true;
}

pub machine PatchApplyResponse::clear_patch(&mut self) {
    self.has_patch = false;
}
