module src::commands::patches::apply::patch_apply_request;

use src::structures::patches::patch_kind::PatchKind;

// Port of commands/patches/apply/patch_apply_request.rs —
// {address, module_name, patched_bytes, kind, label: Option}. module_name
// rides the bounded span; patched_bytes carries a 256-byte bound with an
// honest refusal (no silent truncation of a patch payload); label is
// has_label + span.
pub data PatchApplyRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    patched_bytes: [u8; 256];
    patched_bytes_len: u64;
    kind: PatchKind;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
}

pub machine PatchApplyRequest::new(address: u64, kind: PatchKind) -> PatchApplyRequest {
    PatchApplyRequest {
        address: address,
        module_name_len: 0,
        patched_bytes_len: 0,
        kind: kind,
        has_label: false,
        label_len: 0,
    }
}

pub machine PatchApplyRequest::get_address(&self) -> u64 {
    self.address
}

pub machine PatchApplyRequest::set_address(&mut self, address: u64) {
    self.address = address;
}

pub machine PatchApplyRequest::get_kind(&self) -> PatchKind {
    self.kind
}

pub machine PatchApplyRequest::set_kind(&mut self, kind: PatchKind) {
    self.kind = kind;
}

pub machine PatchApplyRequest::get_module_name(&self) -> &[u8] {
    transition self.module_name_len <= 256 {
        true -> (&self.module_name[0..self.module_name_len])
        false -> (&self.module_name[0..256])
        _ -> (&self.module_name[0..256])
    }
}

pub machine PatchApplyRequest::set_module_name(&mut self, module_name: &[u8]) {
    self.module_name_len = 0;
    transition { _ -> copy(module_name, 0) }
    state copy(&mut self, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(module_name, position)
            false -> finish(position)
        }
    }
    state store(&mut self, module_name: &[u8], position: u64) {
        self.module_name[position] = module_name[position];
        transition {
            _ -> copy(module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.module_name_len = count;
    }
}

// false when the payload exceeds the 256-byte carrier.
pub machine PatchApplyRequest::set_patched_bytes(&mut self, patched_bytes: &[u8]) -> bool {
    transition patched_bytes.len <= 256 {
        true -> copy(patched_bytes)
        false -> (false)
    }
    state copy(&mut self, patched_bytes: &[u8]) -> bool {
        self.patched_bytes_len = patched_bytes.len;
        transition { _ -> store(patched_bytes, 0) }
    }
    state store(&mut self, patched_bytes: &[u8], position: u64) -> bool {
        transition position < patched_bytes.len && position < 256 {
            true -> store_at(patched_bytes, position)
            false -> (true)
        }
    }
    state store_at(&mut self, patched_bytes: &[u8], position: u64) -> bool {
        self.patched_bytes[position] = patched_bytes[position];
        transition {
            _ -> store(patched_bytes, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

pub machine PatchApplyRequest::get_patched_bytes(&self) -> &[u8] {
    transition self.patched_bytes_len <= 256 {
        true -> (&self.patched_bytes[0..self.patched_bytes_len])
        false -> (&self.patched_bytes[0..256])
        _ -> (&self.patched_bytes[0..256])
    }
}

pub machine PatchApplyRequest::has_label(&self) -> bool {
    self.has_label
}

pub machine PatchApplyRequest::get_label(&self) -> &[u8] {
    transition self.label_len <= 256 {
        true -> (&self.label[0..self.label_len])
        false -> (&self.label[0..256])
        _ -> (&self.label[0..256])
    }
}

pub machine PatchApplyRequest::set_label(&mut self, label: &[u8]) {
    self.label_len = 0;
    transition { _ -> copy(label, 0) }
    state copy(&mut self, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store(label, position)
            false -> finish(position)
        }
    }
    state store(&mut self, label: &[u8], position: u64) {
        self.label[position] = label[position];
        transition {
            _ -> copy(label, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.label_len = count;
    }
}

pub machine PatchApplyRequest::clear_label(&mut self) {
    self.has_label = false;
    self.label_len = 0;
}
