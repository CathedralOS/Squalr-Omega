module src::commands::patches::apply::patch_apply_request;

use src::structures::patches::patch_kind::PatchKind;

// Port of commands/patches/apply/patch_apply_request.rs —
// {address, module_name, patched_bytes, kind, label: Option}. module_name
// rides the bounded span; patched_bytes carries a 256-byte bound with an
// honest refusal (no silent truncation of a patch payload); label is
// has_label + span.
pub data PatchApplyRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    patched_bytes: [u8; 256];
    patched_bytes_len: u64;
    kind: PatchKind;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
}

pub machine PatchApplyRequest::new(address: u64, kind: PatchKind) -> PatchApplyRequest {
    PatchApplyRequest {
        address: address,
        module_name_len: 0,
        patched_bytes_len: 0,
        kind: kind,
        has_label: false,
        label_len: 0,
    }
}

pub machine PatchApplyRequest::get_address(patch_apply_request: &PatchApplyRequest) -> u64 {
    patch_apply_request.address
}

pub machine PatchApplyRequest::set_address(patch_apply_request: &mut PatchApplyRequest, address: u64) {
    patch_apply_request.address = address;
}

pub machine PatchApplyRequest::get_kind(patch_apply_request: &PatchApplyRequest) -> PatchKind {
    patch_apply_request.kind
}

pub machine PatchApplyRequest::set_kind(patch_apply_request: &mut PatchApplyRequest, kind: PatchKind) {
    patch_apply_request.kind = kind;
}

pub machine PatchApplyRequest::get_module_name(patch_apply_request: &PatchApplyRequest) -> &[u8] {
    transition patch_apply_request.module_name_len <= 256 {
        true -> (&patch_apply_request.module_name[0..patch_apply_request.module_name_len])
        false -> (&patch_apply_request.module_name[0..256])
        _ -> (&patch_apply_request.module_name[0..256])
    }
}

pub machine PatchApplyRequest::set_module_name(patch_apply_request: &mut PatchApplyRequest, module_name: &[u8]) {
    patch_apply_request.module_name_len = 0;
    transition { _ -> copy(patch_apply_request, module_name, 0) }
    state copy(patch_apply_request: &mut PatchApplyRequest, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(patch_apply_request, module_name, position)
            false -> finish(patch_apply_request, position)
        }
    }
    state store(patch_apply_request: &mut PatchApplyRequest, module_name: &[u8], position: u64) {
        patch_apply_request.module_name[position] = module_name[position];
        transition {
            _ -> copy(patch_apply_request, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(patch_apply_request: &mut PatchApplyRequest, count: u64) {
        patch_apply_request.module_name_len = count;
    }
}

// false when the payload exceeds the 256-byte carrier.
pub machine PatchApplyRequest::set_patched_bytes(patch_apply_request: &mut PatchApplyRequest, patched_bytes: &[u8]) -> bool {
    transition patched_bytes.len <= 256 {
        true -> copy(patch_apply_request, patched_bytes)
        false -> (false)
    }
    state copy(patch_apply_request: &mut PatchApplyRequest, patched_bytes: &[u8]) -> bool {
        patch_apply_request.patched_bytes_len = patched_bytes.len;
        transition { _ -> store(patch_apply_request, patched_bytes, 0) }
    }
    state store(patch_apply_request: &mut PatchApplyRequest, patched_bytes: &[u8], position: u64) -> bool {
        transition position < patched_bytes.len && position < 256 {
            true -> store_at(patch_apply_request, patched_bytes, position)
            false -> (true)
        }
    }
    state store_at(patch_apply_request: &mut PatchApplyRequest, patched_bytes: &[u8], position: u64) -> bool {
        patch_apply_request.patched_bytes[position] = patched_bytes[position];
        transition {
            _ -> store(patch_apply_request, patched_bytes, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
}

pub machine PatchApplyRequest::get_patched_bytes(patch_apply_request: &PatchApplyRequest) -> &[u8] {
    transition patch_apply_request.patched_bytes_len <= 256 {
        true -> (&patch_apply_request.patched_bytes[0..patch_apply_request.patched_bytes_len])
        false -> (&patch_apply_request.patched_bytes[0..256])
        _ -> (&patch_apply_request.patched_bytes[0..256])
    }
}

pub machine PatchApplyRequest::has_label(patch_apply_request: &PatchApplyRequest) -> bool {
    patch_apply_request.has_label
}

pub machine PatchApplyRequest::get_label(patch_apply_request: &PatchApplyRequest) -> &[u8] {
    transition patch_apply_request.label_len <= 256 {
        true -> (&patch_apply_request.label[0..patch_apply_request.label_len])
        false -> (&patch_apply_request.label[0..256])
        _ -> (&patch_apply_request.label[0..256])
    }
}

pub machine PatchApplyRequest::set_label(patch_apply_request: &mut PatchApplyRequest, label: &[u8]) {
    patch_apply_request.label_len = 0;
    transition { _ -> copy(patch_apply_request, label, 0) }
    state copy(patch_apply_request: &mut PatchApplyRequest, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store(patch_apply_request, label, position)
            false -> finish(patch_apply_request, position)
        }
    }
    state store(patch_apply_request: &mut PatchApplyRequest, label: &[u8], position: u64) {
        patch_apply_request.label[position] = label[position];
        transition {
            _ -> copy(patch_apply_request, label, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(patch_apply_request: &mut PatchApplyRequest, count: u64) {
        patch_apply_request.label_len = count;
    }
}

pub machine PatchApplyRequest::clear_label(patch_apply_request: &mut PatchApplyRequest) {
    patch_apply_request.has_label = false;
    patch_apply_request.label_len = 0;
}
