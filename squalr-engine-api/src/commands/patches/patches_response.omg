module src::commands::patches::patches_response;

use src::commands::patches::apply::patch_apply_response::PatchApplyResponse;
use src::commands::patches::list::patch_list_response::PatchListResponse;
use src::commands::patches::no_operation::patch_no_operation_response::PatchNoOperationResponse;
use src::commands::patches::restore::patch_restore_response::PatchRestoreResponse;
use src::commands::patches::restore_address::patch_restore_address_response::PatchRestoreAddressResponse;

// Port of commands/patches/patches_response.rs — Apply, NoOperation,
// Restore, RestoreAddress, List in upstream declaration order.
pub data PatchesResponse {
    case Apply(response: PatchApplyResponse);
    case NoOperation(response: PatchNoOperationResponse);
    case Restore(response: PatchRestoreResponse);
    case RestoreAddress(response: PatchRestoreAddressResponse);
    case List(response: PatchListResponse);
}
