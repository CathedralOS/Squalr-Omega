use src/commands/patches/apply/patch_apply_response.omg;
use src/commands/patches/list/patch_list_response.omg;
use src/commands/patches/no_operation/patch_no_operation_response.omg;
use src/commands/patches/restore/patch_restore_response.omg;
use src/commands/patches/restore_address/patch_restore_address_response.omg;

// Port of commands/patches/patches_response.rs — Apply, NoOperation,
// Restore, RestoreAddress, List in upstream declaration order.
public data PatchesResponse {
    case Apply(response: |patch_apply_response|::PatchApplyResponse);
    case NoOperation(response: |patch_no_operation_response|::PatchNoOperationResponse);
    case Restore(response: |patch_restore_response|::PatchRestoreResponse);
    case RestoreAddress(response: |patch_restore_address_response|::PatchRestoreAddressResponse);
    case List(response: |patch_list_response|::PatchListResponse);
}
