use src/structures/patches/patch_command_status.omg;
use src/structures/patches/patch_descriptor.omg;

// Port of commands/patches/restore_address/patch_restore_address_response.rs —
// {status: PatchCommandStatus, patch: Option<PatchDescriptor>}. patch is
// has_patch + the descriptor record (set_patch copies through clone_from).
public data PatchRestoreAddressResponse {
    status: |patch_command_status|::PatchCommandStatus;
    has_patch: bool;
    patch: |patch_descriptor|::PatchDescriptor;
}

public machine PatchRestoreAddressResponse::new(status: |patch_command_status|::PatchCommandStatus) -> PatchRestoreAddressResponse {
    (PatchRestoreAddressResponse {
        status: status,
        has_patch: false,
    })
}

public machine PatchRestoreAddressResponse::get_status(this: &PatchRestoreAddressResponse) -> &|patch_command_status|::PatchCommandStatus {
    &this.status
}

public machine PatchRestoreAddressResponse::has_patch(this: &PatchRestoreAddressResponse) -> bool {
    this.has_patch
}

public machine PatchRestoreAddressResponse::get_patch(this: &PatchRestoreAddressResponse) -> &|patch_descriptor|::PatchDescriptor {
    &this.patch
}

public machine PatchRestoreAddressResponse::set_patch(this: &mut PatchRestoreAddressResponse, patch: &|patch_descriptor|::PatchDescriptor) {
    |patch_descriptor|::PatchDescriptor::clone_from(&mut this.patch, patch);
    this.has_patch = true;
}

public machine PatchRestoreAddressResponse::clear_patch(this: &mut PatchRestoreAddressResponse) {
    this.has_patch = false;
}
