module src::commands::patches::restore_address::patch_restore_address_response;

use src::structures::patches::patch_command_status::PatchCommandStatus;
use src::structures::patches::patch_descriptor::PatchDescriptor;

// Port of commands/patches/restore_address/patch_restore_address_response.rs —
// {status: PatchCommandStatus, patch: Option<PatchDescriptor>}. patch is
// has_patch + the descriptor record (set_patch copies through clone_from).
pub data PatchRestoreAddressResponse {
    status: PatchCommandStatus;
    has_patch: bool;
    patch: PatchDescriptor;
}

pub machine PatchRestoreAddressResponse::new(status: PatchCommandStatus) -> PatchRestoreAddressResponse {
    (PatchRestoreAddressResponse {
        status: status,
        has_patch: false,
    })
}

pub machine PatchRestoreAddressResponse::get_status(patch_restore_address_response: &PatchRestoreAddressResponse) -> &PatchCommandStatus {
    &patch_restore_address_response.status
}

pub machine PatchRestoreAddressResponse::has_patch(patch_restore_address_response: &PatchRestoreAddressResponse) -> bool {
    patch_restore_address_response.has_patch
}

pub machine PatchRestoreAddressResponse::get_patch(patch_restore_address_response: &PatchRestoreAddressResponse) -> &PatchDescriptor {
    &patch_restore_address_response.patch
}

pub machine PatchRestoreAddressResponse::set_patch(patch_restore_address_response: &mut PatchRestoreAddressResponse, patch: &PatchDescriptor) {
    PatchDescriptor::clone_from(&mut patch_restore_address_response.patch, patch);
    patch_restore_address_response.has_patch = true;
}

pub machine PatchRestoreAddressResponse::clear_patch(patch_restore_address_response: &mut PatchRestoreAddressResponse) {
    patch_restore_address_response.has_patch = false;
}
