module src::commands::patches::restore_address::patch_restore_address_response;

use src::structures::patches::patch_command_status::PatchCommandStatus;
use src::structures::patches::patch_descriptor::PatchDescriptor;

// Port of commands/patches/restore_address/patch_restore_address_response.rs —
// {status: PatchCommandStatus, patch: Option<PatchDescriptor>}. patch is
// has_patch + the descriptor record (set_patch copies through clone_from).
pub data PatchRestoreAddressResponse {
    status: PatchCommandStatus;
    has_patch: bool;
    patch: PatchDescriptor;
}

pub machine PatchRestoreAddressResponse::new(status: PatchCommandStatus) -> PatchRestoreAddressResponse {
    (PatchRestoreAddressResponse {
        status: status,
        has_patch: false,
    })
}

pub machine PatchRestoreAddressResponse::get_status(this: &PatchRestoreAddressResponse) -> &PatchCommandStatus {
    &this.status
}

pub machine PatchRestoreAddressResponse::has_patch(this: &PatchRestoreAddressResponse) -> bool {
    this.has_patch
}

pub machine PatchRestoreAddressResponse::get_patch(this: &PatchRestoreAddressResponse) -> &PatchDescriptor {
    &this.patch
}

pub machine PatchRestoreAddressResponse::set_patch(this: &mut PatchRestoreAddressResponse, patch: &PatchDescriptor) {
    PatchDescriptor::clone_from(&mut this.patch, patch);
    this.has_patch = true;
}

pub machine PatchRestoreAddressResponse::clear_patch(this: &mut PatchRestoreAddressResponse) {
    this.has_patch = false;
}
