module src::commands::patches::restore_address::patch_restore_address_response;

use src::structures::patches::patch_command_status::PatchCommandStatus;
use src::structures::patches::patch_descriptor::PatchDescriptor;

// Port of commands/patches/restore_address/patch_restore_address_response.rs —
// {status: PatchCommandStatus, patch: Option<PatchDescriptor>}. patch is
// has_patch + the descriptor record (set_patch copies through clone_from).
pub data PatchRestoreAddressResponse {
    status: PatchCommandStatus;
    has_patch: bool;
    patch: PatchDescriptor;
}

pub machine PatchRestoreAddressResponse::new(status: PatchCommandStatus) -> PatchRestoreAddressResponse {
    (PatchRestoreAddressResponse {
        status: status,
        has_patch: false,
    })
}

pub machine PatchRestoreAddressResponse::get_status(&self) -> &PatchCommandStatus {
    &self.status
}

pub machine PatchRestoreAddressResponse::has_patch(&self) -> bool {
    self.has_patch
}

pub machine PatchRestoreAddressResponse::get_patch(&self) -> &PatchDescriptor {
    &self.patch
}

pub machine PatchRestoreAddressResponse::set_patch(&mut self, patch: &PatchDescriptor) {
    self.patch.clone_from(patch);
    self.has_patch = true;
}

pub machine PatchRestoreAddressResponse::clear_patch(&mut self) {
    self.has_patch = false;
}
