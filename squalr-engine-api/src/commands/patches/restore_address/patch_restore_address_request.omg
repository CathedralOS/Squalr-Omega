module src::commands::patches::restore_address::patch_restore_address_request;

use src::structures::patches::patch_kind::PatchKind;

// Port of commands/patches/restore_address/patch_restore_address_request.rs
// — {address, module_name, expected_kind: Option<PatchKind>}. expected_kind
// rides the has_ + value respell ([copy] enum stores whole).
pub data PatchRestoreAddressRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    has_expected_kind: bool;
    expected_kind: PatchKind;
}

pub machine PatchRestoreAddressRequest::new(address: u64) -> PatchRestoreAddressRequest {
    PatchRestoreAddressRequest {
        address: address,
        module_name_len: 0,
        has_expected_kind: false,
        expected_kind: PatchKind::default(),
    }
}

pub machine PatchRestoreAddressRequest::get_address(&self) -> u64 {
    self.address
}

pub machine PatchRestoreAddressRequest::set_address(&mut self, address: u64) {
    self.address = address;
}

pub machine PatchRestoreAddressRequest::has_expected_kind(&self) -> bool {
    self.has_expected_kind
}

pub machine PatchRestoreAddressRequest::get_expected_kind(&self) -> PatchKind {
    self.expected_kind
}

pub machine PatchRestoreAddressRequest::set_expected_kind(&mut self, expected_kind: PatchKind) {
    self.expected_kind = expected_kind;
    self.has_expected_kind = true;
}

pub machine PatchRestoreAddressRequest::clear_expected_kind(&mut self) {
    self.has_expected_kind = false;
}

pub machine PatchRestoreAddressRequest::get_module_name(&self) -> &[u8] {
    transition self.module_name_len <= 256 {
        true -> (&self.module_name[0..self.module_name_len])
        false -> (&self.module_name[0..256])
        _ -> (&self.module_name[0..256])
    }
}

pub machine PatchRestoreAddressRequest::set_module_name(&mut self, module_name: &[u8]) {
    self.module_name_len = 0;
    transition { _ -> copy(module_name, 0) }
    state copy(&mut self, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(module_name, position)
            false -> finish(position)
        }
    }
    state store(&mut self, module_name: &[u8], position: u64) {
        self.module_name[position] = module_name[position];
        transition {
            _ -> copy(module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.module_name_len = count;
    }
}
