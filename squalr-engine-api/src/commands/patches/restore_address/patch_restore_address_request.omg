module src::commands::patches::restore_address::patch_restore_address_request;

use src::structures::patches::patch_kind::PatchKind;

// Port of commands/patches/restore_address/patch_restore_address_request.rs
// — {address, module_name, expected_kind: Option<PatchKind>}. expected_kind
// rides the has_ + value respell ([copy] enum stores whole).
pub data PatchRestoreAddressRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    has_expected_kind: bool;
    expected_kind: PatchKind;
}

pub machine PatchRestoreAddressRequest::new(address: u64) -> PatchRestoreAddressRequest {
    PatchRestoreAddressRequest {
        address: address,
        module_name_len: 0,
        has_expected_kind: false,
        expected_kind: PatchKind::default(),
    }
}

pub machine PatchRestoreAddressRequest::get_address(patch_restore_address_request: &PatchRestoreAddressRequest) -> u64 {
    patch_restore_address_request.address
}

pub machine PatchRestoreAddressRequest::set_address(patch_restore_address_request: &mut PatchRestoreAddressRequest, address: u64) {
    patch_restore_address_request.address = address;
}

pub machine PatchRestoreAddressRequest::has_expected_kind(patch_restore_address_request: &PatchRestoreAddressRequest) -> bool {
    patch_restore_address_request.has_expected_kind
}

pub machine PatchRestoreAddressRequest::get_expected_kind(patch_restore_address_request: &PatchRestoreAddressRequest) -> PatchKind {
    patch_restore_address_request.expected_kind
}

pub machine PatchRestoreAddressRequest::set_expected_kind(patch_restore_address_request: &mut PatchRestoreAddressRequest, expected_kind: PatchKind) {
    patch_restore_address_request.expected_kind = expected_kind;
    patch_restore_address_request.has_expected_kind = true;
}

pub machine PatchRestoreAddressRequest::clear_expected_kind(patch_restore_address_request: &mut PatchRestoreAddressRequest) {
    patch_restore_address_request.has_expected_kind = false;
}

pub machine PatchRestoreAddressRequest::get_module_name(patch_restore_address_request: &PatchRestoreAddressRequest) -> &[u8] {
    transition patch_restore_address_request.module_name_len <= 256 {
        true -> (&patch_restore_address_request.module_name[0..patch_restore_address_request.module_name_len])
        false -> (&patch_restore_address_request.module_name[0..256])
        _ -> (&patch_restore_address_request.module_name[0..256])
    }
}

pub machine PatchRestoreAddressRequest::set_module_name(patch_restore_address_request: &mut PatchRestoreAddressRequest, module_name: &[u8]) {
    patch_restore_address_request.module_name_len = 0;
    transition { _ -> copy(patch_restore_address_request, module_name, 0) }
    state copy(patch_restore_address_request: &mut PatchRestoreAddressRequest, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(patch_restore_address_request, module_name, position)
            false -> finish(patch_restore_address_request, position)
        }
    }
    state store(patch_restore_address_request: &mut PatchRestoreAddressRequest, module_name: &[u8], position: u64) {
        patch_restore_address_request.module_name[position] = module_name[position];
        transition {
            _ -> copy(patch_restore_address_request, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(patch_restore_address_request: &mut PatchRestoreAddressRequest, count: u64) {
        patch_restore_address_request.module_name_len = count;
    }
}
