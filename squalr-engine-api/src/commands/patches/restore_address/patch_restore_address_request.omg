module src::commands::patches::restore_address::patch_restore_address_request;

use src::structures::patches::patch_kind::PatchKind;

// Port of commands/patches/restore_address/patch_restore_address_request.rs
// — {address, module_name, expected_kind: Option<PatchKind>}. expected_kind
// rides the has_ + value respell ([copy] enum stores whole).
pub data PatchRestoreAddressRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    has_expected_kind: bool;
    expected_kind: PatchKind;
}

pub machine PatchRestoreAddressRequest::new(address: u64) -> PatchRestoreAddressRequest {
    PatchRestoreAddressRequest {
        address: address,
        module_name_len: 0,
        has_expected_kind: false,
        expected_kind: PatchKind::default(),
    }
}

pub machine PatchRestoreAddressRequest::get_address(this: &PatchRestoreAddressRequest) -> u64 {
    this.address
}

pub machine PatchRestoreAddressRequest::set_address(this: &mut PatchRestoreAddressRequest, address: u64) {
    this.address = address;
}

pub machine PatchRestoreAddressRequest::has_expected_kind(this: &PatchRestoreAddressRequest) -> bool {
    this.has_expected_kind
}

pub machine PatchRestoreAddressRequest::get_expected_kind(this: &PatchRestoreAddressRequest) -> PatchKind {
    this.expected_kind
}

pub machine PatchRestoreAddressRequest::set_expected_kind(this: &mut PatchRestoreAddressRequest, expected_kind: PatchKind) {
    this.expected_kind = expected_kind;
    this.has_expected_kind = true;
}

pub machine PatchRestoreAddressRequest::clear_expected_kind(this: &mut PatchRestoreAddressRequest) {
    this.has_expected_kind = false;
}

pub machine PatchRestoreAddressRequest::get_module_name(this: &PatchRestoreAddressRequest) -> &[u8] {
    transition this.module_name_len <= 256 {
        true -> (&this.module_name[0..this.module_name_len])
        false -> (&this.module_name[0..256])
        _ -> (&this.module_name[0..256])
    }
}

pub machine PatchRestoreAddressRequest::set_module_name(this: &mut PatchRestoreAddressRequest, module_name: &[u8]) {
    this.module_name_len = 0;
    transition { _ -> copy(this, module_name, 0) }
    state copy(this: &mut PatchRestoreAddressRequest, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(this, module_name, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut PatchRestoreAddressRequest, module_name: &[u8], position: u64) {
        this.module_name[position] = module_name[position];
        transition {
            _ -> copy(this, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut PatchRestoreAddressRequest, count: u64) {
        this.module_name_len = count;
    }
}
