// Port of commands/unprivileged_command_request.rs. Upstream declares the
// `UnprivilegedCommandRequest` trait (associated `ResponseType`,
// `to_engine_command`, the `send` callback wire through
// `dispatch_unprivileged_command`) and spreads each `to_engine_command` impl
// across its leaf file; the impls colocate here under the trait's file for
// the same leaf->root cycle reason as privileged_command_request.omg.
// `to_engine_command` consumes the request by value where upstream borrows
// and clones; `send` collapses into the unprivileged dispatch path when
// engine_unprivileged_state lands.

pub machine ProjectCloseRequest::to_engine_command(
    request: ProjectCloseRequest
) -> UnprivilegedCommand {
    (UnprivilegedCommand::Project { command: ProjectCommand::Close { request: request } })
}

pub machine ProjectCreateRequest::to_engine_command(
    request: ProjectCreateRequest
) -> UnprivilegedCommand {
    (UnprivilegedCommand::Project { command: ProjectCommand::Create { request: request } })
}

