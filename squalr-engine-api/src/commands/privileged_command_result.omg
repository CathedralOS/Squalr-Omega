module src::commands::privileged_command_result;

use src::commands::privileged_command_response::PrivilegedCommandResponse;
use src::registries::symbols::privileged_registry_catalog::PrivilegedRegistryCatalog;

// Port of commands/privileged_command_result.rs — the bundle
// `StandaloneEngineApiUnprivilegedBindings::dispatch_privileged_command` hands
// back through its callback. Upstream `Option<PrivilegedRegistryCatalog>`
// maps to the has_/value pair per port convention; the flag is what
// `PrivilegedCommand::should_include_privileged_registry_catalog` answered.

pub data PrivilegedCommandResult {
    privileged_command_response: PrivilegedCommandResponse;
    has_privileged_registry_catalog: bool;
    privileged_registry_catalog: PrivilegedRegistryCatalog;
}

// Upstream `new(response, Option<catalog>)` — the flag plays the Option role.
pub machine PrivilegedCommandResult::new(
    privileged_command_response: PrivilegedCommandResponse,
    has_privileged_registry_catalog: bool,
    privileged_registry_catalog: PrivilegedRegistryCatalog
) -> PrivilegedCommandResult {
    PrivilegedCommandResult {
        privileged_command_response: privileged_command_response,
        has_privileged_registry_catalog: has_privileged_registry_catalog,
        privileged_registry_catalog: privileged_registry_catalog
    }
}

pub machine PrivilegedCommandResult::get_privileged_command_response(
    privileged_command_result: &PrivilegedCommandResult
) -> &PrivilegedCommandResponse {
    &privileged_command_result.privileged_command_response
}

pub machine PrivilegedCommandResult::has_privileged_registry_catalog(privileged_command_result: &PrivilegedCommandResult) -> bool {
    privileged_command_result.has_privileged_registry_catalog
}

pub machine PrivilegedCommandResult::get_privileged_registry_catalog(
    privileged_command_result: &PrivilegedCommandResult
) -> &PrivilegedRegistryCatalog {
    &privileged_command_result.privileged_registry_catalog
}

// Upstream `into_privileged_command_response(self)` — consuming getter.
pub machine PrivilegedCommandResult::into_privileged_command_response(
    result: PrivilegedCommandResult
) -> PrivilegedCommandResponse {
    transition result {
        _ -> (result.privileged_command_response)
    }
}
