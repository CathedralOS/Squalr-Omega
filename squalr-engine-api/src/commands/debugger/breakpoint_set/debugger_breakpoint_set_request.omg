module src::commands::debugger::breakpoint_set::debugger_breakpoint_set_request;

use src::structures::debugger::debugger_breakpoint_kind::DebuggerBreakpointKind;

// Port of commands/debugger/breakpoint_set/debugger_breakpoint_set_request.rs —
// {address, kind, label: Option<String>}.
public data DebuggerBreakpointSetRequest {
    address: u64;
    kind: DebuggerBreakpointKind;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
}

public machine DebuggerBreakpointSetRequest::new(address: u64, kind: DebuggerBreakpointKind) -> DebuggerBreakpointSetRequest {
    DebuggerBreakpointSetRequest {
        address: address,
        kind: kind,
        has_label: false,
        label_len: 0,
    }
}

public machine DebuggerBreakpointSetRequest::get_address(this: &DebuggerBreakpointSetRequest) -> u64 {
    this.address
}

public machine DebuggerBreakpointSetRequest::set_address(this: &mut DebuggerBreakpointSetRequest, address: u64) {
    this.address = address;
}

public machine DebuggerBreakpointSetRequest::get_kind(this: &DebuggerBreakpointSetRequest) -> DebuggerBreakpointKind {
    this.kind
}

public machine DebuggerBreakpointSetRequest::set_kind(this: &mut DebuggerBreakpointSetRequest, kind: DebuggerBreakpointKind) {
    this.kind = kind;
}

public machine DebuggerBreakpointSetRequest::has_label(this: &DebuggerBreakpointSetRequest) -> bool {
    this.has_label
}

public machine DebuggerBreakpointSetRequest::get_label(this: &DebuggerBreakpointSetRequest) -> &[u8] {
    transition this.has_label && this.label_len <= 256 {
        true -> (&this.label[0..this.label_len])
        _ -> (&this.label[0..0])
    }
}

public machine DebuggerBreakpointSetRequest::get_label_len(this: &DebuggerBreakpointSetRequest) -> u64 {
    this.label_len
}

public machine DebuggerBreakpointSetRequest::set_label(this: &mut DebuggerBreakpointSetRequest, label: &[u8]) {
    transition 0 == 0 {
        _ -> copy(this, label, 0)
    }
    machine copy(this: &mut DebuggerBreakpointSetRequest, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store(this, label, position)
            _ -> finish(this, position)
        }
    }
    machine store(this: &mut DebuggerBreakpointSetRequest, label: &[u8], position: u64)
        requires position < label.len && position < 256 {
        this.label[position] = label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(this, label, next)
        }
    }
    machine finish(this: &mut DebuggerBreakpointSetRequest, position: u64) {
        this.label_len = position;
        this.has_label = true;
        transition 0 == 0 {
            _ -> {}
        }
    }
}

public machine DebuggerBreakpointSetRequest::clear_label(this: &mut DebuggerBreakpointSetRequest) {
    this.has_label = false;
    this.label_len = 0;
}
