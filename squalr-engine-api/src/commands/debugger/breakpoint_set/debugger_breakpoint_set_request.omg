module src::commands::debugger::breakpoint_set::debugger_breakpoint_set_request;

use src::structures::debugger::debugger_breakpoint_kind::DebuggerBreakpointKind;

// Port of commands/debugger/breakpoint_set/debugger_breakpoint_set_request.rs —
// {address, kind, label: Option<String>}.
pub data DebuggerBreakpointSetRequest {
    address: u64;
    kind: DebuggerBreakpointKind;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
}

pub machine DebuggerBreakpointSetRequest::new(address: u64, kind: DebuggerBreakpointKind) -> DebuggerBreakpointSetRequest {
    DebuggerBreakpointSetRequest {
        address: address,
        kind: kind,
        has_label: false,
        label_len: 0,
    }
}

pub machine DebuggerBreakpointSetRequest::get_address(debugger_breakpoint_set_request: &DebuggerBreakpointSetRequest) -> u64 {
    debugger_breakpoint_set_request.address
}

pub machine DebuggerBreakpointSetRequest::set_address(debugger_breakpoint_set_request: &mut DebuggerBreakpointSetRequest, address: u64) {
    debugger_breakpoint_set_request.address = address;
}

pub machine DebuggerBreakpointSetRequest::get_kind(debugger_breakpoint_set_request: &DebuggerBreakpointSetRequest) -> DebuggerBreakpointKind {
    debugger_breakpoint_set_request.kind
}

pub machine DebuggerBreakpointSetRequest::set_kind(debugger_breakpoint_set_request: &mut DebuggerBreakpointSetRequest, kind: DebuggerBreakpointKind) {
    debugger_breakpoint_set_request.kind = kind;
}

pub machine DebuggerBreakpointSetRequest::has_label(debugger_breakpoint_set_request: &DebuggerBreakpointSetRequest) -> bool {
    debugger_breakpoint_set_request.has_label
}

pub machine DebuggerBreakpointSetRequest::get_label(debugger_breakpoint_set_request: &DebuggerBreakpointSetRequest) -> &[u8] {
    transition debugger_breakpoint_set_request.has_label && debugger_breakpoint_set_request.label_len <= 256 {
        true -> (&debugger_breakpoint_set_request.label[0..debugger_breakpoint_set_request.label_len])
        _ -> (&debugger_breakpoint_set_request.label[0..0])
    }
}

pub machine DebuggerBreakpointSetRequest::get_label_len(debugger_breakpoint_set_request: &DebuggerBreakpointSetRequest) -> u64 {
    debugger_breakpoint_set_request.label_len
}

pub machine DebuggerBreakpointSetRequest::set_label(debugger_breakpoint_set_request: &mut DebuggerBreakpointSetRequest, label: &[u8]) {
    transition 0 == 0 {
        _ -> copy(debugger_breakpoint_set_request, label, 0)
    }
    state copy(debugger_breakpoint_set_request: &mut DebuggerBreakpointSetRequest, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store(debugger_breakpoint_set_request, label, position)
            _ -> finish(debugger_breakpoint_set_request, position)
        }
    }
    state store(debugger_breakpoint_set_request: &mut DebuggerBreakpointSetRequest, label: &[u8], position: u64)
        requires position < label.len && position < 256 {
        debugger_breakpoint_set_request.label[position] = label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(debugger_breakpoint_set_request, label, next)
        }
    }
    state finish(debugger_breakpoint_set_request: &mut DebuggerBreakpointSetRequest, position: u64) {
        debugger_breakpoint_set_request.label_len = position;
        debugger_breakpoint_set_request.has_label = true;
        transition 0 == 0 {
            _ -> (debugger_breakpoint_set_request)
        }
    }
}

pub machine DebuggerBreakpointSetRequest::clear_label(debugger_breakpoint_set_request: &mut DebuggerBreakpointSetRequest) {
    debugger_breakpoint_set_request.has_label = false;
    debugger_breakpoint_set_request.label_len = 0;
}
