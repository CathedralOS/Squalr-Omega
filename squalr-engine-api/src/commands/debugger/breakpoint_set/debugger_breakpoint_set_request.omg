module src::commands::debugger::breakpoint_set::debugger_breakpoint_set_request;

use src::structures::debugger::debugger_breakpoint_kind::DebuggerBreakpointKind;

// Port of commands/debugger/breakpoint_set/debugger_breakpoint_set_request.rs —
// {address, kind, label: Option<String>}.
pub data DebuggerBreakpointSetRequest {
    address: u64;
    kind: DebuggerBreakpointKind;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
}

pub machine DebuggerBreakpointSetRequest::new(address: u64, kind: DebuggerBreakpointKind) -> DebuggerBreakpointSetRequest {
    DebuggerBreakpointSetRequest {
        address: address,
        kind: kind,
        has_label: false,
        label_len: 0,
    }
}

pub machine DebuggerBreakpointSetRequest::get_address(&self) -> u64 {
    self.address
}

pub machine DebuggerBreakpointSetRequest::set_address(&mut self, address: u64) {
    self.address = address;
}

pub machine DebuggerBreakpointSetRequest::get_kind(&self) -> DebuggerBreakpointKind {
    self.kind
}

pub machine DebuggerBreakpointSetRequest::set_kind(&mut self, kind: DebuggerBreakpointKind) {
    self.kind = kind;
}

pub machine DebuggerBreakpointSetRequest::has_label(&self) -> bool {
    self.has_label
}

pub machine DebuggerBreakpointSetRequest::get_label(&self) -> &[u8] {
    transition self.has_label && self.label_len <= 256 {
        true -> (&self.label[0..self.label_len])
        _ -> (&self.label[0..0])
    }
}

pub machine DebuggerBreakpointSetRequest::get_label_len(&self) -> u64 {
    self.label_len
}

pub machine DebuggerBreakpointSetRequest::set_label(&mut self, label: &[u8]) {
    transition 0 == 0 {
        _ -> copy(label, 0)
    }
    state copy(&mut self, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store(label, position)
            _ -> finish(position)
        }
    }
    state store(&mut self, label: &[u8], position: u64)
        requires position < label.len && position < 256 {
        self.label[position] = label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(label, next)
        }
    }
    state finish(&mut self, position: u64) {
        self.label_len = position;
        self.has_label = true;
        transition 0 == 0 {
            _ -> (self)
        }
    }
}

pub machine DebuggerBreakpointSetRequest::clear_label(&mut self) {
    self.has_label = false;
    self.label_len = 0;
}
