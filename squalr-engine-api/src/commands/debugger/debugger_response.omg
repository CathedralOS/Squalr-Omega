// Port of commands/debugger/debugger_response.rs — the 14-leaf union
// matching DebuggerCommand case-for-case.
public data DebuggerResponse {
    case Attach(response: |debugger_attach_response|::DebuggerAttachResponse);
    case Detach(response: |debugger_detach_response|::DebuggerDetachResponse);
    case Pause(response: |debugger_pause_response|::DebuggerPauseResponse);
    case Resume(response: |debugger_resume_response|::DebuggerResumeResponse);
    case BreakpointSet(response: |debugger_breakpoint_set_response|::DebuggerBreakpointSetResponse);
    case BreakpointRemove(response: |debugger_breakpoint_remove_response|::DebuggerBreakpointRemoveResponse);
    case BreakpointList(response: |debugger_breakpoint_list_response|::DebuggerBreakpointListResponse);
    case RegistersRead(response: |debugger_registers_read_response|::DebuggerRegistersReadResponse);
    case RegisterWrite(response: |debugger_register_write_response|::DebuggerRegisterWriteResponse);
    case TraceStart(response: |debugger_trace_start_response|::DebuggerTraceStartResponse);
    case TraceStop(response: |debugger_trace_stop_response|::DebuggerTraceStopResponse);
    case TracePause(response: |debugger_trace_pause_response|::DebuggerTracePauseResponse);
    case TraceResume(response: |debugger_trace_resume_response|::DebuggerTraceResumeResponse);
    case TraceList(response: |debugger_trace_list_response|::DebuggerTraceListResponse);
