use src/structures/debugger/debugger_command_status.omg;
use src/structures/debugger/debugger_session_state.omg;

// Port of commands/debugger/pause/debugger_pause_response.rs —
// {status, session_state}.
public data DebuggerPauseResponse {
    status: |debugger_command_status|::DebuggerCommandStatus;
    session_state: |debugger_session_state|::DebuggerSessionState;
}

public machine DebuggerPauseResponse::new() -> DebuggerPauseResponse {
    DebuggerPauseResponse {
        status: |debugger_command_status|::DebuggerCommandStatus::success(),
        session_state: |debugger_session_state|::DebuggerSessionState::Detached,
    }
}

public machine DebuggerPauseResponse::get_status(this: &DebuggerPauseResponse) -> &|debugger_command_status|::DebuggerCommandStatus {
    (&this.status)
}

public machine DebuggerPauseResponse::get_status_mut(this: &mut DebuggerPauseResponse) -> &mut |debugger_command_status|::DebuggerCommandStatus {
    (&mut this.status)
}

public machine DebuggerPauseResponse::set_status(this: &mut DebuggerPauseResponse, status: |debugger_command_status|::DebuggerCommandStatus) {
    this.status = status;
}

public machine DebuggerPauseResponse::get_session_state(this: &DebuggerPauseResponse) -> |debugger_session_state|::DebuggerSessionState {
    this.session_state
}

public machine DebuggerPauseResponse::set_session_state(this: &mut DebuggerPauseResponse, session_state: |debugger_session_state|::DebuggerSessionState) {
    this.session_state = session_state;
}
