// {status, session_state}.
pub data DebuggerPauseResponse {
    status: DebuggerCommandStatus;
    session_state: DebuggerSessionState;
}

pub machine DebuggerPauseResponse::new() -> DebuggerPauseResponse {
    DebuggerPauseResponse {
        status: DebuggerCommandStatus::success(),
        session_state: DebuggerSessionState::Detached,
    }
}

pub machine DebuggerPauseResponse::get_status(&self) -> &DebuggerCommandStatus {
    (&self.status)
}

pub machine DebuggerPauseResponse::get_status_mut(&mut self) -> &mut DebuggerCommandStatus {
    (&mut self.status)
}

pub machine DebuggerPauseResponse::set_status(&mut self, status: DebuggerCommandStatus) {
    self.status = status;
}

pub machine DebuggerPauseResponse::get_session_state(&self) -> DebuggerSessionState {
