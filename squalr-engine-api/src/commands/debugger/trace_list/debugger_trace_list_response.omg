module src::commands::debugger::trace_list::debugger_trace_list_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_trace_instruction_record::DebuggerTraceInstructionRecord;
use src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;

// Port of commands/debugger/trace_list/debugger_trace_list_response.rs —
// {status, trace_sessions: Vec<DebuggerTraceSessionDescriptor>,
// instruction_records: Vec<DebuggerTraceInstructionRecord>}. Both vectors
// carry a 16-entry bound.
pub data DebuggerTraceListResponse {
    status: DebuggerCommandStatus;
    trace_sessions: [DebuggerTraceSessionDescriptor; 16];
    trace_session_count: u64;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

pub machine DebuggerTraceListResponse::new() -> DebuggerTraceListResponse {
    DebuggerTraceListResponse {
        status: DebuggerCommandStatus::success(),
        trace_session_count: 0,
        instruction_record_count: 0,
    }
}

pub machine DebuggerTraceListResponse::get_status(this: &DebuggerTraceListResponse) -> &DebuggerCommandStatus {
    (&this.status)
}

pub machine DebuggerTraceListResponse::get_status_mut(this: &mut DebuggerTraceListResponse) -> &mut DebuggerCommandStatus {
    (&mut this.status)
}

pub machine DebuggerTraceListResponse::set_status(this: &mut DebuggerTraceListResponse, status: DebuggerCommandStatus) {
    this.status = status;
}

pub machine DebuggerTraceListResponse::get_trace_session_count(this: &DebuggerTraceListResponse) -> u64 {
    this.trace_session_count
}

pub machine DebuggerTraceListResponse::get_trace_session(this: &DebuggerTraceListResponse, position: u64) -> &DebuggerTraceSessionDescriptor
    requires position < 16 {
    (&this.trace_sessions[position])
}

pub machine DebuggerTraceListResponse::add_trace_session(this: &mut DebuggerTraceListResponse, trace_session: &DebuggerTraceSessionDescriptor) -> bool {
    transition this.trace_session_count < 16 {
        true -> store(this, trace_session)
        false -> (false)
    }
    state store(this: &mut DebuggerTraceListResponse, trace_session: &DebuggerTraceSessionDescriptor) -> bool {
        DebuggerTraceSessionDescriptor::clone_from(&mut this.trace_sessions[this.trace_session_count], trace_session);
        this.trace_session_count = ((this.trace_session_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

pub machine DebuggerTraceListResponse::get_instruction_record_count(this: &DebuggerTraceListResponse) -> u64 {
    this.instruction_record_count
}

pub machine DebuggerTraceListResponse::get_instruction_record(this: &DebuggerTraceListResponse, position: u64) -> &DebuggerTraceInstructionRecord
    requires position < 16 {
    (&this.instruction_records[position])
}

pub machine DebuggerTraceListResponse::add_instruction_record(this: &mut DebuggerTraceListResponse, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
    transition this.instruction_record_count < 16 {
        true -> store(this, instruction_record)
        false -> (false)
    }
    state store(this: &mut DebuggerTraceListResponse, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
        DebuggerTraceInstructionRecord::clone_from(&mut this.instruction_records[this.instruction_record_count], instruction_record);
        this.instruction_record_count = ((this.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
