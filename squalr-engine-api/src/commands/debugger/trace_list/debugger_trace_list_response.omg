use src/structures/debugger/debugger_command_status.omg;
use src/structures/debugger/debugger_trace_instruction_record.omg;
use src/structures/debugger/debugger_trace_session_descriptor.omg;

// Port of commands/debugger/trace_list/debugger_trace_list_response.rs —
// {status, trace_sessions: Vec<DebuggerTraceSessionDescriptor>,
// instruction_records: Vec<DebuggerTraceInstructionRecord>}. Both vectors
// carry a 16-entry bound.
public data DebuggerTraceListResponse {
    status: |debugger_command_status|::DebuggerCommandStatus;
    trace_sessions: [|debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor; 16];
    trace_session_count: u64;
    instruction_records: [|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

public machine DebuggerTraceListResponse::new() -> DebuggerTraceListResponse {
    DebuggerTraceListResponse {
        status: |debugger_command_status|::DebuggerCommandStatus::success(),
        trace_session_count: 0,
        instruction_record_count: 0,
    }
}

public machine DebuggerTraceListResponse::get_status(this: &DebuggerTraceListResponse) -> &|debugger_command_status|::DebuggerCommandStatus {
    (&this.status)
}

public machine DebuggerTraceListResponse::get_status_mut(this: &mut DebuggerTraceListResponse) -> &mut |debugger_command_status|::DebuggerCommandStatus {
    (&mut this.status)
}

public machine DebuggerTraceListResponse::set_status(this: &mut DebuggerTraceListResponse, status: |debugger_command_status|::DebuggerCommandStatus) {
    this.status = status;
}

public machine DebuggerTraceListResponse::get_trace_session_count(this: &DebuggerTraceListResponse) -> u64 {
    this.trace_session_count
}

public machine DebuggerTraceListResponse::get_trace_session(this: &DebuggerTraceListResponse, position: u64) -> &|debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor
    requires position < 16 {
    (&this.trace_sessions[position])
}

public machine DebuggerTraceListResponse::add_trace_session(this: &mut DebuggerTraceListResponse, trace_session: &|debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor) -> bool {
    transition this.trace_session_count < 16 {
        true -> store(this, trace_session)
        false -> (false)
    }
    machine store(this: &mut DebuggerTraceListResponse, trace_session: &|debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor) -> bool {
        |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor::clone_from(&mut this.trace_sessions[this.trace_session_count], trace_session);
        this.trace_session_count = ((this.trace_session_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

public machine DebuggerTraceListResponse::get_instruction_record_count(this: &DebuggerTraceListResponse) -> u64 {
    this.instruction_record_count
}

public machine DebuggerTraceListResponse::get_instruction_record(this: &DebuggerTraceListResponse, position: u64) -> &|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord
    requires position < 16 {
    (&this.instruction_records[position])
}

public machine DebuggerTraceListResponse::add_instruction_record(this: &mut DebuggerTraceListResponse, instruction_record: &|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord) -> bool {
    transition this.instruction_record_count < 16 {
        true -> store(this, instruction_record)
        false -> (false)
    }
    machine store(this: &mut DebuggerTraceListResponse, instruction_record: &|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord) -> bool {
        |debugger_trace_instruction_record|::DebuggerTraceInstructionRecord::clone_from(&mut this.instruction_records[this.instruction_record_count], instruction_record);
        this.instruction_record_count = ((this.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
