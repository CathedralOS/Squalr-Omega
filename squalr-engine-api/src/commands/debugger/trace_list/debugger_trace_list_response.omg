module src::commands::debugger::trace_list::debugger_trace_list_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_trace_instruction_record::DebuggerTraceInstructionRecord;
use src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;
use src::structures::bounded_append::append_debugger_trace_instruction_record;
use src::structures::bounded_append::append_debugger_trace_session_descriptor;

// Port of commands/debugger/trace_list/debugger_trace_list_response.rs —
// {status, trace_sessions: Vec<DebuggerTraceSessionDescriptor>,
// instruction_records: Vec<DebuggerTraceInstructionRecord>}. Both vectors
// carry a 16-entry bound.
pub data DebuggerTraceListResponse {
    status: DebuggerCommandStatus;
    trace_sessions: [DebuggerTraceSessionDescriptor; 16];
    trace_session_count: u64;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

pub machine DebuggerTraceListResponse::new() -> DebuggerTraceListResponse {
    DebuggerTraceListResponse {
        status: DebuggerCommandStatus::success(),
        trace_session_count: 0,
        instruction_record_count: 0,
    }
}

pub machine DebuggerTraceListResponse::get_status(&self) -> &DebuggerCommandStatus {
    (&self.status)
}

pub machine DebuggerTraceListResponse::get_status_mut(&mut self) -> &mut DebuggerCommandStatus {
    (&mut self.status)
}

pub machine DebuggerTraceListResponse::set_status(&mut self, status: DebuggerCommandStatus) {
    self.status = status;
}

pub machine DebuggerTraceListResponse::get_trace_session_count(&self) -> u64 {
    self.trace_session_count
}

pub machine DebuggerTraceListResponse::get_trace_session(&self, position: u64) -> &DebuggerTraceSessionDescriptor
    requires position < 16 {
    (&self.trace_sessions[position])
}

pub machine DebuggerTraceListResponse::add_trace_session(&mut self, trace_session: &DebuggerTraceSessionDescriptor) -> bool {
    append_debugger_trace_session_descriptor(&mut self.trace_sessions[0..16], &mut self.trace_session_count, trace_session)
}

pub machine DebuggerTraceListResponse::get_instruction_record_count(&self) -> u64 {
    self.instruction_record_count
}

pub machine DebuggerTraceListResponse::get_instruction_record(&self, position: u64) -> &DebuggerTraceInstructionRecord
    requires position < 16 {
    (&self.instruction_records[position])
}

pub machine DebuggerTraceListResponse::add_instruction_record(&mut self, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
    append_debugger_trace_instruction_record(&mut self.instruction_records[0..16], &mut self.instruction_record_count, instruction_record)
}
