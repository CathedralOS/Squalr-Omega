module src::commands::debugger::trace_list::debugger_trace_list_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_trace_instruction_record::DebuggerTraceInstructionRecord;
use src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;

// Port of commands/debugger/trace_list/debugger_trace_list_response.rs —
// {status, trace_sessions: Vec<DebuggerTraceSessionDescriptor>,
// instruction_records: Vec<DebuggerTraceInstructionRecord>}. Both vectors
// carry a 16-entry bound.
pub data DebuggerTraceListResponse {
    status: DebuggerCommandStatus;
    trace_sessions: [DebuggerTraceSessionDescriptor; 16];
    trace_session_count: u64;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

pub machine DebuggerTraceListResponse::new() -> DebuggerTraceListResponse {
    DebuggerTraceListResponse {
        status: DebuggerCommandStatus::success(),
        trace_session_count: 0,
        instruction_record_count: 0,
    }
}

pub machine DebuggerTraceListResponse::get_status(debugger_trace_list_response: &DebuggerTraceListResponse) -> &DebuggerCommandStatus {
    (&debugger_trace_list_response.status)
}

pub machine DebuggerTraceListResponse::get_status_mut(debugger_trace_list_response: &mut DebuggerTraceListResponse) -> &mut DebuggerCommandStatus {
    (&mut debugger_trace_list_response.status)
}

pub machine DebuggerTraceListResponse::set_status(debugger_trace_list_response: &mut DebuggerTraceListResponse, status: DebuggerCommandStatus) {
    debugger_trace_list_response.status = status;
}

pub machine DebuggerTraceListResponse::get_trace_session_count(debugger_trace_list_response: &DebuggerTraceListResponse) -> u64 {
    debugger_trace_list_response.trace_session_count
}

pub machine DebuggerTraceListResponse::get_trace_session(debugger_trace_list_response: &DebuggerTraceListResponse, position: u64) -> &DebuggerTraceSessionDescriptor
    requires position < 16 {
    (&debugger_trace_list_response.trace_sessions[position])
}

pub machine DebuggerTraceListResponse::add_trace_session(debugger_trace_list_response: &mut DebuggerTraceListResponse, trace_session: &DebuggerTraceSessionDescriptor) -> bool {
    transition debugger_trace_list_response.trace_session_count < 16 {
        true -> store(debugger_trace_list_response, trace_session)
        false -> (false)
    }
    state store(debugger_trace_list_response: &mut DebuggerTraceListResponse, trace_session: &DebuggerTraceSessionDescriptor) -> bool {
        DebuggerTraceSessionDescriptor::clone_from(&mut debugger_trace_list_response.trace_sessions[debugger_trace_list_response.trace_session_count], trace_session);
        debugger_trace_list_response.trace_session_count = ((debugger_trace_list_response.trace_session_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

pub machine DebuggerTraceListResponse::get_instruction_record_count(debugger_trace_list_response: &DebuggerTraceListResponse) -> u64 {
    debugger_trace_list_response.instruction_record_count
}

pub machine DebuggerTraceListResponse::get_instruction_record(debugger_trace_list_response: &DebuggerTraceListResponse, position: u64) -> &DebuggerTraceInstructionRecord
    requires position < 16 {
    (&debugger_trace_list_response.instruction_records[position])
}

pub machine DebuggerTraceListResponse::add_instruction_record(debugger_trace_list_response: &mut DebuggerTraceListResponse, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
    transition debugger_trace_list_response.instruction_record_count < 16 {
        true -> store(debugger_trace_list_response, instruction_record)
        false -> (false)
    }
    state store(debugger_trace_list_response: &mut DebuggerTraceListResponse, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
        DebuggerTraceInstructionRecord::clone_from(&mut debugger_trace_list_response.instruction_records[debugger_trace_list_response.instruction_record_count], instruction_record);
        debugger_trace_list_response.instruction_record_count = ((debugger_trace_list_response.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
