use src/commands/debugger/attach/debugger_attach_request.omg;
use src/commands/debugger/breakpoint_list/debugger_breakpoint_list_request.omg;
use src/commands/debugger/breakpoint_remove/debugger_breakpoint_remove_request.omg;
use src/commands/debugger/breakpoint_set/debugger_breakpoint_set_request.omg;
use src/commands/debugger/detach/debugger_detach_request.omg;
use src/commands/debugger/pause/debugger_pause_request.omg;
use src/commands/debugger/register_write/debugger_register_write_request.omg;
use src/commands/debugger/registers_read/debugger_registers_read_request.omg;
use src/commands/debugger/resume/debugger_resume_request.omg;
use src/commands/debugger/trace_list/debugger_trace_list_request.omg;
use src/commands/debugger/trace_pause/debugger_trace_pause_request.omg;
use src/commands/debugger/trace_resume/debugger_trace_resume_request.omg;
use src/commands/debugger/trace_start/debugger_trace_start_request.omg;
use src/commands/debugger/trace_stop/debugger_trace_stop_request.omg;

// Port of commands/debugger/debugger_command.rs — the 14-leaf union in
// upstream declaration order (Attach, Detach, Pause, Resume, BreakpointSet,
// BreakpointRemove, BreakpointList, RegistersRead, RegisterWrite,
// TraceStart, TraceStop, TracePause, TraceResume, TraceList).
public data DebuggerCommand {
    case Attach(request: |debugger_attach_request|::DebuggerAttachRequest);
    case Detach(request: |debugger_detach_request|::DebuggerDetachRequest);
    case Pause(request: |debugger_pause_request|::DebuggerPauseRequest);
    case Resume(request: |debugger_resume_request|::DebuggerResumeRequest);
    case BreakpointSet(request: |debugger_breakpoint_set_request|::DebuggerBreakpointSetRequest);
    case BreakpointRemove(request: |debugger_breakpoint_remove_request|::DebuggerBreakpointRemoveRequest);
    case BreakpointList(request: |debugger_breakpoint_list_request|::DebuggerBreakpointListRequest);
    case RegistersRead(request: |debugger_registers_read_request|::DebuggerRegistersReadRequest);
    case RegisterWrite(request: |debugger_register_write_request|::DebuggerRegisterWriteRequest);
    case TraceStart(request: |debugger_trace_start_request|::DebuggerTraceStartRequest);
    case TraceStop(request: |debugger_trace_stop_request|::DebuggerTraceStopRequest);
    case TracePause(request: |debugger_trace_pause_request|::DebuggerTracePauseRequest);
    case TraceResume(request: |debugger_trace_resume_request|::DebuggerTraceResumeRequest);
    case TraceList(request: |debugger_trace_list_request|::DebuggerTraceListRequest);
}
