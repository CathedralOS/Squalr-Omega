module src::commands::debugger::attach::debugger_attach_response;
use src::structures::bounded_slice::flagged_bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_session_state::DebuggerSessionState;

// Port of commands/debugger/attach/debugger_attach_response.rs —
// {status, session_state, active_plugin_id: Option<String>}.
pub data DebuggerAttachResponse {
    status: DebuggerCommandStatus;
    session_state: DebuggerSessionState;
    has_active_plugin_id: bool;
    active_plugin_id: [u8; 64];
    active_plugin_id_len: u64;
}

pub machine DebuggerAttachResponse::new() -> DebuggerAttachResponse {
    DebuggerAttachResponse {
        status: DebuggerCommandStatus::success(),
        session_state: DebuggerSessionState::Detached,
        has_active_plugin_id: false,
        active_plugin_id_len: 0,
    }
}

pub machine DebuggerAttachResponse::get_status(&self) -> &DebuggerCommandStatus {
    (&self.status)
}

pub machine DebuggerAttachResponse::get_status_mut(&mut self) -> &mut DebuggerCommandStatus {
    (&mut self.status)
}

pub machine DebuggerAttachResponse::set_status(&mut self, status: DebuggerCommandStatus) {
    self.status = status;
}

pub machine DebuggerAttachResponse::get_session_state(&self) -> DebuggerSessionState {
    self.session_state
}

pub machine DebuggerAttachResponse::set_session_state(&mut self, session_state: DebuggerSessionState) {
    self.session_state = session_state;
}

pub machine DebuggerAttachResponse::has_active_plugin_id(&self) -> bool {
    self.has_active_plugin_id
}

pub machine DebuggerAttachResponse::get_active_plugin_id(&self) -> &[u8] {
    (flagged_bounded_slice(&self.active_plugin_id[0..64], self.active_plugin_id_len, self.has_active_plugin_id && self.active_plugin_id_len <= 64))
}

pub machine DebuggerAttachResponse::set_active_plugin_id(&mut self, active_plugin_id: &[u8]) {
    self.active_plugin_id_len = BoundedByteCopy::copy(&mut self.active_plugin_id[0..64], active_plugin_id);
    self.has_active_plugin_id = true;
}

pub machine DebuggerAttachResponse::clear_active_plugin_id(&mut self) {
    self.has_active_plugin_id = false;
    self.active_plugin_id_len = 0;
}
