module src::commands::debugger::attach::debugger_attach_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_session_state::DebuggerSessionState;

// Port of commands/debugger/attach/debugger_attach_response.rs —
// {status, session_state, active_plugin_id: Option<String>}.
pub data DebuggerAttachResponse {
    status: DebuggerCommandStatus;
    session_state: DebuggerSessionState;
    has_active_plugin_id: bool;
    active_plugin_id: [u8; 64];
    active_plugin_id_len: u64;
}

pub machine DebuggerAttachResponse::new() -> DebuggerAttachResponse {
    DebuggerAttachResponse {
        status: DebuggerCommandStatus::success(),
        session_state: DebuggerSessionState::Detached,
        has_active_plugin_id: false,
        active_plugin_id_len: 0,
    }
}

pub machine DebuggerAttachResponse::get_status(debugger_attach_response: &DebuggerAttachResponse) -> &DebuggerCommandStatus {
    (&debugger_attach_response.status)
}

pub machine DebuggerAttachResponse::get_status_mut(debugger_attach_response: &mut DebuggerAttachResponse) -> &mut DebuggerCommandStatus {
    (&mut debugger_attach_response.status)
}

pub machine DebuggerAttachResponse::set_status(debugger_attach_response: &mut DebuggerAttachResponse, status: DebuggerCommandStatus) {
    debugger_attach_response.status = status;
}

pub machine DebuggerAttachResponse::get_session_state(debugger_attach_response: &DebuggerAttachResponse) -> DebuggerSessionState {
    debugger_attach_response.session_state
}

pub machine DebuggerAttachResponse::set_session_state(debugger_attach_response: &mut DebuggerAttachResponse, session_state: DebuggerSessionState) {
    debugger_attach_response.session_state = session_state;
}

pub machine DebuggerAttachResponse::has_active_plugin_id(debugger_attach_response: &DebuggerAttachResponse) -> bool {
    debugger_attach_response.has_active_plugin_id
}

pub machine DebuggerAttachResponse::get_active_plugin_id(debugger_attach_response: &DebuggerAttachResponse) -> &[u8] {
    transition debugger_attach_response.has_active_plugin_id && debugger_attach_response.active_plugin_id_len <= 64 {
        true -> (&debugger_attach_response.active_plugin_id[0..debugger_attach_response.active_plugin_id_len])
        _ -> (&debugger_attach_response.active_plugin_id[0..0])
    }
}

pub machine DebuggerAttachResponse::set_active_plugin_id(debugger_attach_response: &mut DebuggerAttachResponse, active_plugin_id: &[u8]) {
    transition 0 == 0 {
        _ -> copy(debugger_attach_response, active_plugin_id, 0)
    }
    state copy(debugger_attach_response: &mut DebuggerAttachResponse, active_plugin_id: &[u8], position: u64) {
        transition position < active_plugin_id.len && position < 64 {
            true -> store(debugger_attach_response, active_plugin_id, position)
            _ -> finish(debugger_attach_response, position)
        }
    }
    state store(debugger_attach_response: &mut DebuggerAttachResponse, active_plugin_id: &[u8], position: u64)
        requires position < active_plugin_id.len && position < 64 {
        debugger_attach_response.active_plugin_id[position] = active_plugin_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(debugger_attach_response, active_plugin_id, next)
        }
    }
    state finish(debugger_attach_response: &mut DebuggerAttachResponse, position: u64) {
        debugger_attach_response.active_plugin_id_len = position;
        debugger_attach_response.has_active_plugin_id = true;
        transition 0 == 0 {
            _ -> (debugger_attach_response)
        }
    }
}

pub machine DebuggerAttachResponse::clear_active_plugin_id(debugger_attach_response: &mut DebuggerAttachResponse) {
    debugger_attach_response.has_active_plugin_id = false;
    debugger_attach_response.active_plugin_id_len = 0;
}
