module src::commands::debugger::attach::debugger_attach_request;

// Port of commands/debugger/attach/debugger_attach_request.rs —
// {plugin_id: Option<String>} — the requested debugger plugin; empty means
// any enabled debugger plugin that can attach.
pub data DebuggerAttachRequest {
    has_plugin_id: bool;
    plugin_id: [u8; 64];
    plugin_id_len: u64;
}

pub machine DebuggerAttachRequest::new() -> DebuggerAttachRequest {
    DebuggerAttachRequest {
        has_plugin_id: false,
        plugin_id_len: 0,
    }
}

pub machine DebuggerAttachRequest::has_plugin_id(this: &DebuggerAttachRequest) -> bool {
    this.has_plugin_id
}

pub machine DebuggerAttachRequest::get_plugin_id(this: &DebuggerAttachRequest) -> &[u8] {
    transition this.has_plugin_id && this.plugin_id_len <= 64 {
        true -> (&this.plugin_id[0..this.plugin_id_len])
        _ -> (&this.plugin_id[0..0])
    }
}

pub machine DebuggerAttachRequest::get_plugin_id_len(this: &DebuggerAttachRequest) -> u64 {
    this.plugin_id_len
}

pub machine DebuggerAttachRequest::set_plugin_id(this: &mut DebuggerAttachRequest, plugin_id: &[u8]) {
    transition 0 == 0 {
        _ -> copy(this, plugin_id, 0)
    }
    state copy(this: &mut DebuggerAttachRequest, plugin_id: &[u8], position: u64) {
        transition position < plugin_id.len && position < 64 {
            true -> store(this, plugin_id, position)
            _ -> finish(this, position)
        }
    }
    state store(this: &mut DebuggerAttachRequest, plugin_id: &[u8], position: u64)
        requires position < plugin_id.len && position < 64 {
        this.plugin_id[position] = plugin_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(this, plugin_id, next)
        }
    }
    state finish(this: &mut DebuggerAttachRequest, position: u64) {
        this.plugin_id_len = position;
        this.has_plugin_id = true;
        transition 0 == 0 {
            _ -> (this)
        }
    }
}

pub machine DebuggerAttachRequest::clear_plugin_id(this: &mut DebuggerAttachRequest) {
    this.has_plugin_id = false;
    this.plugin_id_len = 0;
}
