module src::commands::debugger::attach::debugger_attach_request;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/debugger/attach/debugger_attach_request.rs —
// {plugin_id: Option<String>} — the requested debugger plugin; empty means
// any enabled debugger plugin that can attach.
pub data DebuggerAttachRequest {
    has_plugin_id: bool;
    plugin_id: [u8; 64];
    plugin_id_len: u64;
}

pub machine DebuggerAttachRequest::new() -> DebuggerAttachRequest {
    DebuggerAttachRequest {
        has_plugin_id: false,
        plugin_id_len: 0,
    }
}

pub machine DebuggerAttachRequest::has_plugin_id(&self) -> bool {
    self.has_plugin_id
}

pub machine DebuggerAttachRequest::get_plugin_id(&self) -> &[u8] {
    transition self.has_plugin_id && self.plugin_id_len <= 64 {
        true -> (&self.plugin_id[0..self.plugin_id_len])
        _ -> (&self.plugin_id[0..0])
    }
}

pub machine DebuggerAttachRequest::get_plugin_id_len(&self) -> u64 {
    self.plugin_id_len
}

pub machine DebuggerAttachRequest::set_plugin_id(&mut self, plugin_id: &[u8]) {
    self.plugin_id_len = BoundedByteCopy::copy(&mut self.plugin_id[0..64], plugin_id);
    self.has_plugin_id = true;
}

pub machine DebuggerAttachRequest::clear_plugin_id(&mut self) {
    self.has_plugin_id = false;
    self.plugin_id_len = 0;
}
