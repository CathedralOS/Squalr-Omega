use src/structures/debugger/debugger_breakpoint_descriptor.omg;
use src/structures/debugger/debugger_command_status.omg;

// Port of commands/debugger/breakpoint_list/debugger_breakpoint_list_response.rs —
// {status, breakpoints: Vec<DebuggerBreakpointDescriptor>}. The vector
// carries a 32-entry bound (service breakpoints + patch-service software
// breakpoints; upstream is unbounded).
public data DebuggerBreakpointListResponse {
    status: |debugger_command_status|::DebuggerCommandStatus;
    breakpoints: [|debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor; 32];
    breakpoint_count: u64;
}

public machine DebuggerBreakpointListResponse::new() -> DebuggerBreakpointListResponse {
    DebuggerBreakpointListResponse {
        status: |debugger_command_status|::DebuggerCommandStatus::success(),
        breakpoint_count: 0,
    }
}

public machine DebuggerBreakpointListResponse::get_status(this: &DebuggerBreakpointListResponse) -> &|debugger_command_status|::DebuggerCommandStatus {
    (&this.status)
}

public machine DebuggerBreakpointListResponse::get_status_mut(this: &mut DebuggerBreakpointListResponse) -> &mut |debugger_command_status|::DebuggerCommandStatus {
    (&mut this.status)
}

public machine DebuggerBreakpointListResponse::set_status(this: &mut DebuggerBreakpointListResponse, status: |debugger_command_status|::DebuggerCommandStatus) {
    this.status = status;
}

public machine DebuggerBreakpointListResponse::get_breakpoint_count(this: &DebuggerBreakpointListResponse) -> u64 {
    this.breakpoint_count
}

public machine DebuggerBreakpointListResponse::get_breakpoint(this: &DebuggerBreakpointListResponse, position: u64) -> &|debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor
    requires position < 32 {
    (&this.breakpoints[position])
}

public machine DebuggerBreakpointListResponse::add_breakpoint(this: &mut DebuggerBreakpointListResponse, breakpoint: &|debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor) -> bool {
    transition this.breakpoint_count < 32 {
        true -> store(this, breakpoint)
        false -> (false)
    }
    machine store(this: &mut DebuggerBreakpointListResponse, breakpoint: &|debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor) -> bool {
        |debugger_breakpoint_descriptor|::DebuggerBreakpointDescriptor::clone_from(&mut this.breakpoints[this.breakpoint_count], breakpoint);
        this.breakpoint_count = ((this.breakpoint_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
