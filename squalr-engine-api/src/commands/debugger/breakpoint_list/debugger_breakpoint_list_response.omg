module src::commands::debugger::breakpoint_list::debugger_breakpoint_list_response;

use src::structures::debugger::debugger_breakpoint_descriptor::DebuggerBreakpointDescriptor;
use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::bounded_append::append_debugger_breakpoint_descriptor;

// Port of commands/debugger/breakpoint_list/debugger_breakpoint_list_response.rs —
// {status, breakpoints: Vec<DebuggerBreakpointDescriptor>}. The vector
// carries a 32-entry bound (service breakpoints + patch-service software
// breakpoints; upstream is unbounded).
pub data DebuggerBreakpointListResponse {
    status: DebuggerCommandStatus;
    breakpoints: [DebuggerBreakpointDescriptor; 32];
    breakpoint_count: u64;
}

pub machine DebuggerBreakpointListResponse::new() -> DebuggerBreakpointListResponse {
    DebuggerBreakpointListResponse {
        status: DebuggerCommandStatus::success(),
        breakpoint_count: 0,
    }
}

pub machine DebuggerBreakpointListResponse::get_status(&self) -> &DebuggerCommandStatus {
    (&self.status)
}

pub machine DebuggerBreakpointListResponse::get_status_mut(&mut self) -> &mut DebuggerCommandStatus {
    (&mut self.status)
}

pub machine DebuggerBreakpointListResponse::set_status(&mut self, status: DebuggerCommandStatus) {
    self.status = status;
}

pub machine DebuggerBreakpointListResponse::get_breakpoint_count(&self) -> u64 {
    self.breakpoint_count
}

pub machine DebuggerBreakpointListResponse::get_breakpoint(&self, position: u64) -> &DebuggerBreakpointDescriptor
    requires position < 32 {
    (&self.breakpoints[position])
}

pub machine DebuggerBreakpointListResponse::add_breakpoint(&mut self, breakpoint: &DebuggerBreakpointDescriptor) -> bool {
    append_debugger_breakpoint_descriptor(&mut self.breakpoints[0..32], &mut self.breakpoint_count, breakpoint)
}
