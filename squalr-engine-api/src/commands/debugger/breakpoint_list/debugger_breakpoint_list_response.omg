module src::commands::debugger::breakpoint_list::debugger_breakpoint_list_response;

use src::structures::debugger::debugger_breakpoint_descriptor::DebuggerBreakpointDescriptor;
use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;

// Port of commands/debugger/breakpoint_list/debugger_breakpoint_list_response.rs —
// {status, breakpoints: Vec<DebuggerBreakpointDescriptor>}. The vector
// carries a 32-entry bound (service breakpoints + patch-service software
// breakpoints; upstream is unbounded).
pub data DebuggerBreakpointListResponse {
    status: DebuggerCommandStatus;
    breakpoints: [DebuggerBreakpointDescriptor; 32];
    breakpoint_count: u64;
}

pub machine DebuggerBreakpointListResponse::new() -> DebuggerBreakpointListResponse {
    DebuggerBreakpointListResponse {
        status: DebuggerCommandStatus::success(),
        breakpoint_count: 0,
    }
}

pub machine DebuggerBreakpointListResponse::get_status(this: &DebuggerBreakpointListResponse) -> &DebuggerCommandStatus {
    (&this.status)
}

pub machine DebuggerBreakpointListResponse::get_status_mut(this: &mut DebuggerBreakpointListResponse) -> &mut DebuggerCommandStatus {
    (&mut this.status)
}

pub machine DebuggerBreakpointListResponse::set_status(this: &mut DebuggerBreakpointListResponse, status: DebuggerCommandStatus) {
    this.status = status;
}

pub machine DebuggerBreakpointListResponse::get_breakpoint_count(this: &DebuggerBreakpointListResponse) -> u64 {
    this.breakpoint_count
}

pub machine DebuggerBreakpointListResponse::get_breakpoint(this: &DebuggerBreakpointListResponse, position: u64) -> &DebuggerBreakpointDescriptor
    requires position < 32 {
    (&this.breakpoints[position])
}

pub machine DebuggerBreakpointListResponse::add_breakpoint(this: &mut DebuggerBreakpointListResponse, breakpoint: &DebuggerBreakpointDescriptor) -> bool {
    transition this.breakpoint_count < 32 {
        true -> store(this, breakpoint)
        false -> (false)
    }
    state store(this: &mut DebuggerBreakpointListResponse, breakpoint: &DebuggerBreakpointDescriptor) -> bool {
        DebuggerBreakpointDescriptor::clone_from(&mut this.breakpoints[this.breakpoint_count], breakpoint);
        this.breakpoint_count = ((this.breakpoint_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
