module src::commands::debugger::breakpoint_list::debugger_breakpoint_list_response;

use src::structures::debugger::debugger_breakpoint_descriptor::DebuggerBreakpointDescriptor;
use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;

// Port of commands/debugger/breakpoint_list/debugger_breakpoint_list_response.rs —
// {status, breakpoints: Vec<DebuggerBreakpointDescriptor>}. The vector
// carries a 32-entry bound (service breakpoints + patch-service software
// breakpoints; upstream is unbounded).
pub data DebuggerBreakpointListResponse {
    status: DebuggerCommandStatus;
    breakpoints: [DebuggerBreakpointDescriptor; 32];
    breakpoint_count: u64;
}

pub machine DebuggerBreakpointListResponse::new() -> DebuggerBreakpointListResponse {
    DebuggerBreakpointListResponse {
        status: DebuggerCommandStatus::success(),
        breakpoint_count: 0,
    }
}

pub machine DebuggerBreakpointListResponse::get_status(debugger_breakpoint_list_response: &DebuggerBreakpointListResponse) -> &DebuggerCommandStatus {
    (&debugger_breakpoint_list_response.status)
}

pub machine DebuggerBreakpointListResponse::get_status_mut(debugger_breakpoint_list_response: &mut DebuggerBreakpointListResponse) -> &mut DebuggerCommandStatus {
    (&mut debugger_breakpoint_list_response.status)
}

pub machine DebuggerBreakpointListResponse::set_status(debugger_breakpoint_list_response: &mut DebuggerBreakpointListResponse, status: DebuggerCommandStatus) {
    debugger_breakpoint_list_response.status = status;
}

pub machine DebuggerBreakpointListResponse::get_breakpoint_count(debugger_breakpoint_list_response: &DebuggerBreakpointListResponse) -> u64 {
    debugger_breakpoint_list_response.breakpoint_count
}

pub machine DebuggerBreakpointListResponse::get_breakpoint(debugger_breakpoint_list_response: &DebuggerBreakpointListResponse, position: u64) -> &DebuggerBreakpointDescriptor
    requires position < 32 {
    (&debugger_breakpoint_list_response.breakpoints[position])
}

pub machine DebuggerBreakpointListResponse::add_breakpoint(debugger_breakpoint_list_response: &mut DebuggerBreakpointListResponse, breakpoint: &DebuggerBreakpointDescriptor) -> bool {
    transition debugger_breakpoint_list_response.breakpoint_count < 32 {
        true -> store(debugger_breakpoint_list_response, breakpoint)
        false -> (false)
    }
    state store(debugger_breakpoint_list_response: &mut DebuggerBreakpointListResponse, breakpoint: &DebuggerBreakpointDescriptor) -> bool {
        DebuggerBreakpointDescriptor::clone_from(&mut debugger_breakpoint_list_response.breakpoints[debugger_breakpoint_list_response.breakpoint_count], breakpoint);
        debugger_breakpoint_list_response.breakpoint_count = ((debugger_breakpoint_list_response.breakpoint_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
