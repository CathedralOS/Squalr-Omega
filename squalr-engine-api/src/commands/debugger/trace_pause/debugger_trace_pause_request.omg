module src::commands::debugger::trace_pause::debugger_trace_pause_request;
use src::structures::bounded_slice::flagged_bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/debugger/trace_pause/debugger_trace_pause_request.rs —
// {trace_session_id: String}.
pub data DebuggerTracePauseRequest {
    trace_session_id: [u8; 64];
    trace_session_id_len: u64;
}

pub machine DebuggerTracePauseRequest::new() -> DebuggerTracePauseRequest {
    DebuggerTracePauseRequest {
        trace_session_id_len: 0,
    }
}

pub machine DebuggerTracePauseRequest::get_trace_session_id(&self) -> &[u8] {
    (flagged_bounded_slice(&self.trace_session_id[0..64], self.trace_session_id_len, self.trace_session_id_len <= 64))
}

pub machine DebuggerTracePauseRequest::get_trace_session_id_len(&self) -> u64 {
    self.trace_session_id_len
}

pub machine DebuggerTracePauseRequest::set_trace_session_id(&mut self, trace_session_id: &[u8]) {
    self.trace_session_id_len = BoundedByteCopy::copy(&mut self.trace_session_id[0..64], trace_session_id);
}
