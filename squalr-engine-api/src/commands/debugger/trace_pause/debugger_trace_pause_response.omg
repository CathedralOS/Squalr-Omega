module src::commands::debugger::trace_pause::debugger_trace_pause_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use src::structures::debugger::debugger_trace_instruction_record::DebuggerTraceInstructionRecord;
use src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;

// Port of commands/debugger/trace_pause/debugger_trace_pause_response.rs — {status,
// trace_session: Option<DebuggerTraceSessionDescriptor>,
// instruction_records: Vec<DebuggerTraceInstructionRecord>}.
pub data DebuggerTracePauseResponse {
    status: DebuggerCommandStatus;
    has_trace_session: bool;
    trace_session: DebuggerTraceSessionDescriptor;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

pub machine DebuggerTracePauseResponse::new() -> DebuggerTracePauseResponse {
    DebuggerTracePauseResponse {
        status: DebuggerCommandStatus::success(),
        has_trace_session: false,
        trace_session: DebuggerTraceSessionDescriptor::new(0, 0, DebuggerDataBreakpointAccess::Read, false),
        instruction_record_count: 0,
    }
}

pub machine DebuggerTracePauseResponse::get_status(&self) -> &DebuggerCommandStatus {
    (&self.status)
}

pub machine DebuggerTracePauseResponse::get_status_mut(&mut self) -> &mut DebuggerCommandStatus {
    (&mut self.status)
}

pub machine DebuggerTracePauseResponse::set_status(&mut self, status: DebuggerCommandStatus) {
    self.status = status;
}

pub machine DebuggerTracePauseResponse::has_trace_session(&self) -> bool {
    self.has_trace_session
}

pub machine DebuggerTracePauseResponse::get_trace_session(&self) -> &DebuggerTraceSessionDescriptor {
    (&self.trace_session)
}

pub machine DebuggerTracePauseResponse::set_trace_session(&mut self, trace_session: DebuggerTraceSessionDescriptor) {
    self.trace_session = trace_session;
    self.has_trace_session = true;
}

pub machine DebuggerTracePauseResponse::clear_trace_session(&mut self) {
    self.has_trace_session = false;
}

pub machine DebuggerTracePauseResponse::get_instruction_record_count(&self) -> u64 {
    self.instruction_record_count
}

pub machine DebuggerTracePauseResponse::get_instruction_record(&self, position: u64) -> &DebuggerTraceInstructionRecord
    requires position < 16 {
    (&self.instruction_records[position])
}

pub machine DebuggerTracePauseResponse::add_instruction_record(&mut self, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
    transition self.instruction_record_count < 16 {
        true -> store(instruction_record)
        false -> (false)
    }
    state store(&mut self, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
        self.instruction_records[self.instruction_record_count].clone_from(instruction_record);
        self.instruction_record_count = ((self.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
