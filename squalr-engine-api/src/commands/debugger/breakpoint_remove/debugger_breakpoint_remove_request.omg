module src::commands::debugger::breakpoint_remove::debugger_breakpoint_remove_request;

// Port of commands/debugger/breakpoint_remove/debugger_breakpoint_remove_request.rs —
// {breakpoint_id: String}.
pub data DebuggerBreakpointRemoveRequest {
    breakpoint_id: [u8; 256];
    breakpoint_id_len: u64;
}

pub machine DebuggerBreakpointRemoveRequest::new() -> DebuggerBreakpointRemoveRequest {
    DebuggerBreakpointRemoveRequest {
        breakpoint_id_len: 0,
    }
}

pub machine DebuggerBreakpointRemoveRequest::get_breakpoint_id(&self) -> &[u8] {
    transition self.breakpoint_id_len <= 256 {
        true -> (&self.breakpoint_id[0..self.breakpoint_id_len])
        _ -> (&self.breakpoint_id[0..0])
    }
}

pub machine DebuggerBreakpointRemoveRequest::get_breakpoint_id_len(&self) -> u64 {
    self.breakpoint_id_len
}

pub machine DebuggerBreakpointRemoveRequest::set_breakpoint_id(&mut self, breakpoint_id: &[u8]) {
    transition 0 == 0 {
        _ -> copy(breakpoint_id, 0)
    }
    state copy(&mut self, breakpoint_id: &[u8], position: u64) {
        transition position < breakpoint_id.len && position < 256 {
            true -> store(breakpoint_id, position)
            _ -> finish(position)
        }
    }
    state store(&mut self, breakpoint_id: &[u8], position: u64)
        requires position < breakpoint_id.len && position < 256 {
        self.breakpoint_id[position] = breakpoint_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(breakpoint_id, next)
        }
    }
    state finish(&mut self, position: u64) {
        self.breakpoint_id_len = position;
        transition 0 == 0 {
            _ -> (self)
        }
    }
}
