module src::commands::debugger::breakpoint_remove::debugger_breakpoint_remove_request;

// Port of commands/debugger/breakpoint_remove/debugger_breakpoint_remove_request.rs —
// {breakpoint_id: String}.
pub data DebuggerBreakpointRemoveRequest {
    breakpoint_id: [u8; 256];
    breakpoint_id_len: u64;
}

pub machine DebuggerBreakpointRemoveRequest::new() -> DebuggerBreakpointRemoveRequest {
    DebuggerBreakpointRemoveRequest {
        breakpoint_id_len: 0,
    }
}

pub machine DebuggerBreakpointRemoveRequest::get_breakpoint_id(this: &DebuggerBreakpointRemoveRequest) -> &[u8] {
    transition this.breakpoint_id_len <= 256 {
        true -> (&this.breakpoint_id[0..this.breakpoint_id_len])
        _ -> (&this.breakpoint_id[0..0])
    }
}

pub machine DebuggerBreakpointRemoveRequest::get_breakpoint_id_len(this: &DebuggerBreakpointRemoveRequest) -> u64 {
    this.breakpoint_id_len
}

pub machine DebuggerBreakpointRemoveRequest::set_breakpoint_id(this: &mut DebuggerBreakpointRemoveRequest, breakpoint_id: &[u8]) {
    transition 0 == 0 {
        _ -> copy(this, breakpoint_id, 0)
    }
    state copy(this: &mut DebuggerBreakpointRemoveRequest, breakpoint_id: &[u8], position: u64) {
        transition position < breakpoint_id.len && position < 256 {
            true -> store(this, breakpoint_id, position)
            _ -> finish(this, position)
        }
    }
    state store(this: &mut DebuggerBreakpointRemoveRequest, breakpoint_id: &[u8], position: u64)
        requires position < breakpoint_id.len && position < 256 {
        this.breakpoint_id[position] = breakpoint_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(this, breakpoint_id, next)
        }
    }
    state finish(this: &mut DebuggerBreakpointRemoveRequest, position: u64) {
        this.breakpoint_id_len = position;
        transition 0 == 0 {
            _ -> (this)
        }
    }
}
