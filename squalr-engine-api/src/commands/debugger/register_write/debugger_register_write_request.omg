module src::commands::debugger::register_write::debugger_register_write_request;

// Port of commands/debugger/register_write/debugger_register_write_request.rs —
// {register_name: String, value: u64}.
pub data DebuggerRegisterWriteRequest {
    register_name: [u8; 64];
    register_name_len: u64;
    value: u64;
}

pub machine DebuggerRegisterWriteRequest::new(value: u64) -> DebuggerRegisterWriteRequest {
    DebuggerRegisterWriteRequest {
        register_name_len: 0,
        value: value,
    }
}

pub machine DebuggerRegisterWriteRequest::get_register_name(debugger_register_write_request: &DebuggerRegisterWriteRequest) -> &[u8] {
    transition debugger_register_write_request.register_name_len <= 64 {
        true -> (&debugger_register_write_request.register_name[0..debugger_register_write_request.register_name_len])
        _ -> (&debugger_register_write_request.register_name[0..0])
    }
}

pub machine DebuggerRegisterWriteRequest::get_register_name_len(debugger_register_write_request: &DebuggerRegisterWriteRequest) -> u64 {
    debugger_register_write_request.register_name_len
}

pub machine DebuggerRegisterWriteRequest::set_register_name(debugger_register_write_request: &mut DebuggerRegisterWriteRequest, register_name: &[u8]) {
    transition 0 == 0 {
        _ -> copy(debugger_register_write_request, register_name, 0)
    }
    state copy(debugger_register_write_request: &mut DebuggerRegisterWriteRequest, register_name: &[u8], position: u64) {
        transition position < register_name.len && position < 64 {
            true -> store(debugger_register_write_request, register_name, position)
            _ -> finish(debugger_register_write_request, position)
        }
    }
    state store(debugger_register_write_request: &mut DebuggerRegisterWriteRequest, register_name: &[u8], position: u64)
        requires position < register_name.len && position < 64 {
        debugger_register_write_request.register_name[position] = register_name[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(debugger_register_write_request, register_name, next)
        }
    }
    state finish(debugger_register_write_request: &mut DebuggerRegisterWriteRequest, position: u64) {
        debugger_register_write_request.register_name_len = position;
        transition 0 == 0 {
            _ -> (debugger_register_write_request)
        }
    }
}

pub machine DebuggerRegisterWriteRequest::get_value(debugger_register_write_request: &DebuggerRegisterWriteRequest) -> u64 {
    debugger_register_write_request.value
}

pub machine DebuggerRegisterWriteRequest::set_value(debugger_register_write_request: &mut DebuggerRegisterWriteRequest, value: u64) {
    debugger_register_write_request.value = value;
}
