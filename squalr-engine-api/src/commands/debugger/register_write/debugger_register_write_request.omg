module src::commands::debugger::register_write::debugger_register_write_request;

// Port of commands/debugger/register_write/debugger_register_write_request.rs —
// {register_name: String, value: u64}.
pub data DebuggerRegisterWriteRequest {
    register_name: [u8; 64];
    register_name_len: u64;
    value: u64;
}

pub machine DebuggerRegisterWriteRequest::new(value: u64) -> DebuggerRegisterWriteRequest {
    DebuggerRegisterWriteRequest {
        register_name_len: 0,
        value: value,
    }
}

pub machine DebuggerRegisterWriteRequest::get_register_name(&self) -> &[u8] {
    transition self.register_name_len <= 64 {
        true -> (&self.register_name[0..self.register_name_len])
        _ -> (&self.register_name[0..0])
    }
}

pub machine DebuggerRegisterWriteRequest::get_register_name_len(&self) -> u64 {
    self.register_name_len
}

pub machine DebuggerRegisterWriteRequest::set_register_name(&mut self, register_name: &[u8]) {
    transition 0 == 0 {
        _ -> copy(register_name, 0)
    }
    state copy(&mut self, register_name: &[u8], position: u64) {
        transition position < register_name.len && position < 64 {
            true -> store(register_name, position)
            _ -> finish(position)
        }
    }
    state store(&mut self, register_name: &[u8], position: u64)
        requires position < register_name.len && position < 64 {
        self.register_name[position] = register_name[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(register_name, next)
        }
    }
    state finish(&mut self, position: u64) {
        self.register_name_len = position;
        transition 0 == 0 {
            _ -> (self)
        }
    }
}

pub machine DebuggerRegisterWriteRequest::get_value(&self) -> u64 {
    self.value
}

pub machine DebuggerRegisterWriteRequest::set_value(&mut self, value: u64) {
    self.value = value;
}
