module src::commands::debugger::register_write::debugger_register_write_request;

// Port of commands/debugger/register_write/debugger_register_write_request.rs —
// {register_name: String, value: u64}.
pub data DebuggerRegisterWriteRequest {
    register_name: [u8; 64];
    register_name_len: u64;
    value: u64;
}

pub machine DebuggerRegisterWriteRequest::new(value: u64) -> DebuggerRegisterWriteRequest {
    DebuggerRegisterWriteRequest {
        register_name_len: 0,
        value: value,
    }
}

pub machine DebuggerRegisterWriteRequest::get_register_name(this: &DebuggerRegisterWriteRequest) -> &[u8] {
    transition this.register_name_len <= 64 {
        true -> (&this.register_name[0..this.register_name_len])
        _ -> (&this.register_name[0..0])
    }
}

pub machine DebuggerRegisterWriteRequest::get_register_name_len(this: &DebuggerRegisterWriteRequest) -> u64 {
    this.register_name_len
}

pub machine DebuggerRegisterWriteRequest::set_register_name(this: &mut DebuggerRegisterWriteRequest, register_name: &[u8]) {
    transition 0 == 0 {
        _ -> copy(this, register_name, 0)
    }
    state copy(this: &mut DebuggerRegisterWriteRequest, register_name: &[u8], position: u64) {
        transition position < register_name.len && position < 64 {
            true -> store(this, register_name, position)
            _ -> finish(this, position)
        }
    }
    state store(this: &mut DebuggerRegisterWriteRequest, register_name: &[u8], position: u64)
        requires position < register_name.len && position < 64 {
        this.register_name[position] = register_name[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(this, register_name, next)
        }
    }
    state finish(this: &mut DebuggerRegisterWriteRequest, position: u64) {
        this.register_name_len = position;
        transition 0 == 0 {
            _ -> (this)
        }
    }
}

pub machine DebuggerRegisterWriteRequest::get_value(this: &DebuggerRegisterWriteRequest) -> u64 {
    this.value
}

pub machine DebuggerRegisterWriteRequest::set_value(this: &mut DebuggerRegisterWriteRequest, value: u64) {
    this.value = value;
}
