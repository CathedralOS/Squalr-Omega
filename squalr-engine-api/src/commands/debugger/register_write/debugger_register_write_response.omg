// Port of commands/debugger/register_write/debugger_register_write_response.rs —
// {status, register_snapshot: Option<DebuggerRegisterSnapshot>}.
public data DebuggerRegisterWriteResponse {
    status: |debugger_command_status|::DebuggerCommandStatus;
    has_register_snapshot: bool;
    register_snapshot: |debugger_register_snapshot|::DebuggerRegisterSnapshot;
}

public machine DebuggerRegisterWriteResponse::new() -> DebuggerRegisterWriteResponse {
    DebuggerRegisterWriteResponse {
        status: |debugger_command_status|::DebuggerCommandStatus::success(),
        has_register_snapshot: false,
        register_snapshot: |debugger_register_snapshot|::DebuggerRegisterSnapshot::new(),
    }
}

public machine DebuggerRegisterWriteResponse::get_status(this: &DebuggerRegisterWriteResponse) -> &|debugger_command_status|::DebuggerCommandStatus {
    (&this.status)
}

public machine DebuggerRegisterWriteResponse::get_status_mut(this: &mut DebuggerRegisterWriteResponse) -> &mut |debugger_command_status|::DebuggerCommandStatus {
    (&mut this.status)
}

public machine DebuggerRegisterWriteResponse::set_status(this: &mut DebuggerRegisterWriteResponse, status: |debugger_command_status|::DebuggerCommandStatus) {
    this.status = status;
}

public machine DebuggerRegisterWriteResponse::has_register_snapshot(this: &DebuggerRegisterWriteResponse) -> bool {
    this.has_register_snapshot
}

public machine DebuggerRegisterWriteResponse::get_register_snapshot(this: &DebuggerRegisterWriteResponse) -> &|debugger_register_snapshot|::DebuggerRegisterSnapshot {
