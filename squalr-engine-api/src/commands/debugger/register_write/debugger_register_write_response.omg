// Port of commands/debugger/register_write/debugger_register_write_response.rs —
// {status, register_snapshot: Option<DebuggerRegisterSnapshot>}.
pub data DebuggerRegisterWriteResponse {
    status: DebuggerCommandStatus;
    has_register_snapshot: bool;
    register_snapshot: DebuggerRegisterSnapshot;
}

pub machine DebuggerRegisterWriteResponse::new() -> DebuggerRegisterWriteResponse {
    DebuggerRegisterWriteResponse {
        status: DebuggerCommandStatus::success(),
        has_register_snapshot: false,
        register_snapshot: DebuggerRegisterSnapshot::new(),
    }
}

pub machine DebuggerRegisterWriteResponse::get_status(this: &DebuggerRegisterWriteResponse) -> &DebuggerCommandStatus {
    (&this.status)
}

pub machine DebuggerRegisterWriteResponse::get_status_mut(this: &mut DebuggerRegisterWriteResponse) -> &mut DebuggerCommandStatus {
