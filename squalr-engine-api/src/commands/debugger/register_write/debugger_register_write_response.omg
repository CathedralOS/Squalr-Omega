public machine DebuggerRegisterWriteResponse::set_register_snapshot(this: &mut DebuggerRegisterWriteResponse, register_snapshot: |debugger_register_snapshot|::DebuggerRegisterSnapshot) {
    this.register_snapshot = register_snapshot;
