    this.status = status;
}

pub machine DebuggerRegisterWriteResponse::has_register_snapshot(this: &DebuggerRegisterWriteResponse) -> bool {
    this.has_register_snapshot
}

pub machine DebuggerRegisterWriteResponse::get_register_snapshot(this: &DebuggerRegisterWriteResponse) -> &DebuggerRegisterSnapshot {
    (&this.register_snapshot)
}

pub machine DebuggerRegisterWriteResponse::set_register_snapshot(this: &mut DebuggerRegisterWriteResponse, register_snapshot: DebuggerRegisterSnapshot) {
    this.register_snapshot = register_snapshot;
