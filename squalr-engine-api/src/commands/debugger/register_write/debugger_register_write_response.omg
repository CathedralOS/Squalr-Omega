module src::commands::debugger::register_write::debugger_register_write_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_register_snapshot::DebuggerRegisterSnapshot;

// Port of commands/debugger/register_write/debugger_register_write_response.rs —
// {status, register_snapshot: Option<DebuggerRegisterSnapshot>}.
pub data DebuggerRegisterWriteResponse {
    status: DebuggerCommandStatus;
    has_register_snapshot: bool;
    register_snapshot: DebuggerRegisterSnapshot;
}

pub machine DebuggerRegisterWriteResponse::new() -> DebuggerRegisterWriteResponse {
    DebuggerRegisterWriteResponse {
        status: DebuggerCommandStatus::success(),
        has_register_snapshot: false,
        register_snapshot: DebuggerRegisterSnapshot::new(),
    }
}

pub machine DebuggerRegisterWriteResponse::get_status(&self) -> &DebuggerCommandStatus {
    (&self.status)
}

pub machine DebuggerRegisterWriteResponse::get_status_mut(&mut self) -> &mut DebuggerCommandStatus {
    (&mut self.status)
}

pub machine DebuggerRegisterWriteResponse::set_status(&mut self, status: DebuggerCommandStatus) {
    self.status = status;
}

pub machine DebuggerRegisterWriteResponse::has_register_snapshot(&self) -> bool {
    self.has_register_snapshot
}

pub machine DebuggerRegisterWriteResponse::get_register_snapshot(&self) -> &DebuggerRegisterSnapshot {
    (&self.register_snapshot)
}

pub machine DebuggerRegisterWriteResponse::set_register_snapshot(&mut self, register_snapshot: DebuggerRegisterSnapshot) {
    self.register_snapshot = register_snapshot;
    self.has_register_snapshot = true;
}

pub machine DebuggerRegisterWriteResponse::clear_register_snapshot(&mut self) {
    self.has_register_snapshot = false;
}
