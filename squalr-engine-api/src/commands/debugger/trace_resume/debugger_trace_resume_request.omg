module src::commands::debugger::trace_resume::debugger_trace_resume_request;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/debugger/trace_resume/debugger_trace_resume_request.rs —
// {trace_session_id: String}.
pub data DebuggerTraceResumeRequest {
    trace_session_id: [u8; 64];
    trace_session_id_len: u64;
}

pub machine DebuggerTraceResumeRequest::new() -> DebuggerTraceResumeRequest {
    DebuggerTraceResumeRequest {
        trace_session_id_len: 0,
    }
}

pub machine DebuggerTraceResumeRequest::get_trace_session_id(&self) -> &[u8] {
    transition self.trace_session_id_len <= 64 {
        true -> (&self.trace_session_id[0..self.trace_session_id_len])
        _ -> (&self.trace_session_id[0..0])
    }
}

pub machine DebuggerTraceResumeRequest::get_trace_session_id_len(&self) -> u64 {
    self.trace_session_id_len
}

pub machine DebuggerTraceResumeRequest::set_trace_session_id(&mut self, trace_session_id: &[u8]) {
    self.trace_session_id_len = BoundedByteCopy::copy(&mut self.trace_session_id[0..64], trace_session_id);
}
