module src::commands::debugger::trace_resume::debugger_trace_resume_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use src::structures::debugger::debugger_trace_instruction_record::DebuggerTraceInstructionRecord;
use src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;

// Port of commands/debugger/trace_resume/debugger_trace_resume_response.rs — {status,
// trace_session: Option<DebuggerTraceSessionDescriptor>,
// instruction_records: Vec<DebuggerTraceInstructionRecord>}.
pub data DebuggerTraceResumeResponse {
    status: DebuggerCommandStatus;
    has_trace_session: bool;
    trace_session: DebuggerTraceSessionDescriptor;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

pub machine DebuggerTraceResumeResponse::new() -> DebuggerTraceResumeResponse {
    DebuggerTraceResumeResponse {
        status: DebuggerCommandStatus::success(),
        has_trace_session: false,
        trace_session: DebuggerTraceSessionDescriptor::new(0, 0, DebuggerDataBreakpointAccess::Read, false),
        instruction_record_count: 0,
    }
}

pub machine DebuggerTraceResumeResponse::get_status(debugger_trace_resume_response: &DebuggerTraceResumeResponse) -> &DebuggerCommandStatus {
    (&debugger_trace_resume_response.status)
}

pub machine DebuggerTraceResumeResponse::get_status_mut(debugger_trace_resume_response: &mut DebuggerTraceResumeResponse) -> &mut DebuggerCommandStatus {
    (&mut debugger_trace_resume_response.status)
}

pub machine DebuggerTraceResumeResponse::set_status(debugger_trace_resume_response: &mut DebuggerTraceResumeResponse, status: DebuggerCommandStatus) {
    debugger_trace_resume_response.status = status;
}

pub machine DebuggerTraceResumeResponse::has_trace_session(debugger_trace_resume_response: &DebuggerTraceResumeResponse) -> bool {
    debugger_trace_resume_response.has_trace_session
}

pub machine DebuggerTraceResumeResponse::get_trace_session(debugger_trace_resume_response: &DebuggerTraceResumeResponse) -> &DebuggerTraceSessionDescriptor {
    (&debugger_trace_resume_response.trace_session)
}

pub machine DebuggerTraceResumeResponse::set_trace_session(debugger_trace_resume_response: &mut DebuggerTraceResumeResponse, trace_session: DebuggerTraceSessionDescriptor) {
    debugger_trace_resume_response.trace_session = trace_session;
    debugger_trace_resume_response.has_trace_session = true;
}

pub machine DebuggerTraceResumeResponse::clear_trace_session(debugger_trace_resume_response: &mut DebuggerTraceResumeResponse) {
    debugger_trace_resume_response.has_trace_session = false;
}

pub machine DebuggerTraceResumeResponse::get_instruction_record_count(debugger_trace_resume_response: &DebuggerTraceResumeResponse) -> u64 {
    debugger_trace_resume_response.instruction_record_count
}

pub machine DebuggerTraceResumeResponse::get_instruction_record(debugger_trace_resume_response: &DebuggerTraceResumeResponse, position: u64) -> &DebuggerTraceInstructionRecord
    requires position < 16 {
    (&debugger_trace_resume_response.instruction_records[position])
}

pub machine DebuggerTraceResumeResponse::add_instruction_record(debugger_trace_resume_response: &mut DebuggerTraceResumeResponse, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
    transition debugger_trace_resume_response.instruction_record_count < 16 {
        true -> store(debugger_trace_resume_response, instruction_record)
        false -> (false)
    }
    state store(debugger_trace_resume_response: &mut DebuggerTraceResumeResponse, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
        DebuggerTraceInstructionRecord::clone_from(&mut debugger_trace_resume_response.instruction_records[debugger_trace_resume_response.instruction_record_count], instruction_record);
        debugger_trace_resume_response.instruction_record_count = ((debugger_trace_resume_response.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
