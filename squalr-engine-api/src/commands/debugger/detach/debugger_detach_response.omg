public data DebuggerDetachResponse {
    status: |debugger_command_status|::DebuggerCommandStatus;
    session_state: |debugger_session_state|::DebuggerSessionState;
}

public machine DebuggerDetachResponse::new() -> DebuggerDetachResponse {
    DebuggerDetachResponse {
        status: |debugger_command_status|::DebuggerCommandStatus::success(),
        session_state: |debugger_session_state|::DebuggerSessionState::Detached,
    }
}

public machine DebuggerDetachResponse::get_status(this: &DebuggerDetachResponse) -> &|debugger_command_status|::DebuggerCommandStatus {
    (&this.status)
}

public machine DebuggerDetachResponse::get_status_mut(this: &mut DebuggerDetachResponse) -> &mut |debugger_command_status|::DebuggerCommandStatus {
    (&mut this.status)
}

public machine DebuggerDetachResponse::set_status(this: &mut DebuggerDetachResponse, status: |debugger_command_status|::DebuggerCommandStatus) {
    this.status = status;
}

public machine DebuggerDetachResponse::get_session_state(this: &DebuggerDetachResponse) -> |debugger_session_state|::DebuggerSessionState {
    this.session_state
}

public machine DebuggerDetachResponse::set_session_state(this: &mut DebuggerDetachResponse, session_state: |debugger_session_state|::DebuggerSessionState) {
    this.session_state = session_state;
