module src::commands::debugger::detach::debugger_detach_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_session_state::DebuggerSessionState;

// Port of commands/debugger/detach/debugger_detach_response.rs —
// {status, session_state}.
pub data DebuggerDetachResponse {
    status: DebuggerCommandStatus;
    session_state: DebuggerSessionState;
}

pub machine DebuggerDetachResponse::new() -> DebuggerDetachResponse {
    DebuggerDetachResponse {
        status: DebuggerCommandStatus::success(),
        session_state: DebuggerSessionState::Detached,
    }
}

pub machine DebuggerDetachResponse::get_status(debugger_detach_response: &DebuggerDetachResponse) -> &DebuggerCommandStatus {
    (&debugger_detach_response.status)
}

pub machine DebuggerDetachResponse::get_status_mut(debugger_detach_response: &mut DebuggerDetachResponse) -> &mut DebuggerCommandStatus {
    (&mut debugger_detach_response.status)
}

pub machine DebuggerDetachResponse::set_status(debugger_detach_response: &mut DebuggerDetachResponse, status: DebuggerCommandStatus) {
    debugger_detach_response.status = status;
}

pub machine DebuggerDetachResponse::get_session_state(debugger_detach_response: &DebuggerDetachResponse) -> DebuggerSessionState {
    debugger_detach_response.session_state
}

pub machine DebuggerDetachResponse::set_session_state(debugger_detach_response: &mut DebuggerDetachResponse, session_state: DebuggerSessionState) {
    debugger_detach_response.session_state = session_state;
}
