module src::commands::debugger::trace_start::debugger_trace_start_request;

use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use src::structures::debugger::debugger_trace_target_kind::DebuggerTraceTargetKind;

// Port of commands/debugger/trace_start/debugger_trace_start_request.rs —
// {address, size_in_bytes, access, label: Option<String>, target_kind}.
// size_in_bytes is upstream u8 carried as u64 per the payload convention.
public data DebuggerTraceStartRequest {
    address: u64;
    size_in_bytes: u64;
    access: DebuggerDataBreakpointAccess;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
    target_kind: DebuggerTraceTargetKind;
}

public machine DebuggerTraceStartRequest::new(address: u64, size_in_bytes: u64, access: DebuggerDataBreakpointAccess, target_kind: DebuggerTraceTargetKind) -> DebuggerTraceStartRequest {
    DebuggerTraceStartRequest {
        address: address,
        size_in_bytes: size_in_bytes,
        access: access,
        has_label: false,
        label_len: 0,
        target_kind: target_kind,
    }
}

public machine DebuggerTraceStartRequest::get_address(this: &DebuggerTraceStartRequest) -> u64 {
    this.address
}

public machine DebuggerTraceStartRequest::get_size_in_bytes(this: &DebuggerTraceStartRequest) -> u64 {
    this.size_in_bytes
}

public machine DebuggerTraceStartRequest::get_access(this: &DebuggerTraceStartRequest) -> DebuggerDataBreakpointAccess {
    this.access
}

public machine DebuggerTraceStartRequest::get_target_kind(this: &DebuggerTraceStartRequest) -> DebuggerTraceTargetKind {
    this.target_kind
}

public machine DebuggerTraceStartRequest::has_label(this: &DebuggerTraceStartRequest) -> bool {
    this.has_label
}

public machine DebuggerTraceStartRequest::get_label(this: &DebuggerTraceStartRequest) -> &[u8] {
    transition this.has_label && this.label_len <= 256 {
        true -> (&this.label[0..this.label_len])
        _ -> (&this.label[0..0])
    }
}

public machine DebuggerTraceStartRequest::get_label_len(this: &DebuggerTraceStartRequest) -> u64 {
    this.label_len
}

public machine DebuggerTraceStartRequest::set_label(this: &mut DebuggerTraceStartRequest, label: &[u8]) {
    transition 0 == 0 {
        _ -> copy(this, label, 0)
    }
    machine copy(this: &mut DebuggerTraceStartRequest, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store(this, label, position)
            _ -> finish(this, position)
        }
    }
    machine store(this: &mut DebuggerTraceStartRequest, label: &[u8], position: u64)
        requires position < label.len && position < 256 {
        this.label[position] = label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(this, label, next)
        }
    }
    machine finish(this: &mut DebuggerTraceStartRequest, position: u64) {
        this.label_len = position;
        this.has_label = true;
        transition 0 == 0 {
            _ -> {}
        }
    }
}

public machine DebuggerTraceStartRequest::clear_label(this: &mut DebuggerTraceStartRequest) {
    this.has_label = false;
    this.label_len = 0;
}
