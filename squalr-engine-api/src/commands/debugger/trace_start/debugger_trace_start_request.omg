module src::commands::debugger::trace_start::debugger_trace_start_request;

use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use src::structures::debugger::debugger_trace_target_kind::DebuggerTraceTargetKind;

// Port of commands/debugger/trace_start/debugger_trace_start_request.rs —
// {address, size_in_bytes, access, label: Option<String>, target_kind}.
// size_in_bytes is upstream u8 carried as u64 per the payload convention.
pub data DebuggerTraceStartRequest {
    address: u64;
    size_in_bytes: u64;
    access: DebuggerDataBreakpointAccess;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
    target_kind: DebuggerTraceTargetKind;
}

pub machine DebuggerTraceStartRequest::new(address: u64, size_in_bytes: u64, access: DebuggerDataBreakpointAccess, target_kind: DebuggerTraceTargetKind) -> DebuggerTraceStartRequest {
    DebuggerTraceStartRequest {
        address: address,
        size_in_bytes: size_in_bytes,
        access: access,
        has_label: false,
        label_len: 0,
        target_kind: target_kind,
    }
}

pub machine DebuggerTraceStartRequest::get_address(&self) -> u64 {
    self.address
}

pub machine DebuggerTraceStartRequest::get_size_in_bytes(&self) -> u64 {
    self.size_in_bytes
}

pub machine DebuggerTraceStartRequest::get_access(&self) -> DebuggerDataBreakpointAccess {
    self.access
}

pub machine DebuggerTraceStartRequest::get_target_kind(&self) -> DebuggerTraceTargetKind {
    self.target_kind
}

pub machine DebuggerTraceStartRequest::has_label(&self) -> bool {
    self.has_label
}

pub machine DebuggerTraceStartRequest::get_label(&self) -> &[u8] {
    transition self.has_label && self.label_len <= 256 {
        true -> (&self.label[0..self.label_len])
        _ -> (&self.label[0..0])
    }
}

pub machine DebuggerTraceStartRequest::get_label_len(&self) -> u64 {
    self.label_len
}

pub machine DebuggerTraceStartRequest::set_label(&mut self, label: &[u8]) {
    transition 0 == 0 {
        _ -> copy(label, 0)
    }
    state copy(&mut self, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store(label, position)
            _ -> finish(position)
        }
    }
    state store(&mut self, label: &[u8], position: u64)
        requires position < label.len && position < 256 {
        self.label[position] = label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(label, next)
        }
    }
    state finish(&mut self, position: u64) {
        self.label_len = position;
        self.has_label = true;
        transition 0 == 0 {
            _ -> (self)
        }
    }
}

pub machine DebuggerTraceStartRequest::clear_label(&mut self) {
    self.has_label = false;
    self.label_len = 0;
}
