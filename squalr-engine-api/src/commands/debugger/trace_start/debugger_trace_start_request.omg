module src::commands::debugger::trace_start::debugger_trace_start_request;

use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use src::structures::debugger::debugger_trace_target_kind::DebuggerTraceTargetKind;

// Port of commands/debugger/trace_start/debugger_trace_start_request.rs —
// {address, size_in_bytes, access, label: Option<String>, target_kind}.
// size_in_bytes is upstream u8 carried as u64 per the payload convention.
pub data DebuggerTraceStartRequest {
    address: u64;
    size_in_bytes: u64;
    access: DebuggerDataBreakpointAccess;
    has_label: bool;
    label: [u8; 256];
    label_len: u64;
    target_kind: DebuggerTraceTargetKind;
}

pub machine DebuggerTraceStartRequest::new(address: u64, size_in_bytes: u64, access: DebuggerDataBreakpointAccess, target_kind: DebuggerTraceTargetKind) -> DebuggerTraceStartRequest {
    DebuggerTraceStartRequest {
        address: address,
        size_in_bytes: size_in_bytes,
        access: access,
        has_label: false,
        label_len: 0,
        target_kind: target_kind,
    }
}

pub machine DebuggerTraceStartRequest::get_address(debugger_trace_start_request: &DebuggerTraceStartRequest) -> u64 {
    debugger_trace_start_request.address
}

pub machine DebuggerTraceStartRequest::get_size_in_bytes(debugger_trace_start_request: &DebuggerTraceStartRequest) -> u64 {
    debugger_trace_start_request.size_in_bytes
}

pub machine DebuggerTraceStartRequest::get_access(debugger_trace_start_request: &DebuggerTraceStartRequest) -> DebuggerDataBreakpointAccess {
    debugger_trace_start_request.access
}

pub machine DebuggerTraceStartRequest::get_target_kind(debugger_trace_start_request: &DebuggerTraceStartRequest) -> DebuggerTraceTargetKind {
    debugger_trace_start_request.target_kind
}

pub machine DebuggerTraceStartRequest::has_label(debugger_trace_start_request: &DebuggerTraceStartRequest) -> bool {
    debugger_trace_start_request.has_label
}

pub machine DebuggerTraceStartRequest::get_label(debugger_trace_start_request: &DebuggerTraceStartRequest) -> &[u8] {
    transition debugger_trace_start_request.has_label && debugger_trace_start_request.label_len <= 256 {
        true -> (&debugger_trace_start_request.label[0..debugger_trace_start_request.label_len])
        _ -> (&debugger_trace_start_request.label[0..0])
    }
}

pub machine DebuggerTraceStartRequest::get_label_len(debugger_trace_start_request: &DebuggerTraceStartRequest) -> u64 {
    debugger_trace_start_request.label_len
}

pub machine DebuggerTraceStartRequest::set_label(debugger_trace_start_request: &mut DebuggerTraceStartRequest, label: &[u8]) {
    transition 0 == 0 {
        _ -> copy(debugger_trace_start_request, label, 0)
    }
    state copy(debugger_trace_start_request: &mut DebuggerTraceStartRequest, label: &[u8], position: u64) {
        transition position < label.len && position < 256 {
            true -> store(debugger_trace_start_request, label, position)
            _ -> finish(debugger_trace_start_request, position)
        }
    }
    state store(debugger_trace_start_request: &mut DebuggerTraceStartRequest, label: &[u8], position: u64)
        requires position < label.len && position < 256 {
        debugger_trace_start_request.label[position] = label[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(debugger_trace_start_request, label, next)
        }
    }
    state finish(debugger_trace_start_request: &mut DebuggerTraceStartRequest, position: u64) {
        debugger_trace_start_request.label_len = position;
        debugger_trace_start_request.has_label = true;
        transition 0 == 0 {
            _ -> (debugger_trace_start_request)
        }
    }
}

pub machine DebuggerTraceStartRequest::clear_label(debugger_trace_start_request: &mut DebuggerTraceStartRequest) {
    debugger_trace_start_request.has_label = false;
    debugger_trace_start_request.label_len = 0;
}
