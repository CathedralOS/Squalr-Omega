module src::commands::debugger::trace_start::debugger_trace_start_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use src::structures::debugger::debugger_trace_instruction_record::DebuggerTraceInstructionRecord;
use src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;

// Port of commands/debugger/trace_start/debugger_trace_start_response.rs —
// {status, trace_session: Option<DebuggerTraceSessionDescriptor>,
// instruction_records: Vec<DebuggerTraceInstructionRecord>}. The vector
// carries a 16-entry bound.
pub data DebuggerTraceStartResponse {
    status: DebuggerCommandStatus;
    has_trace_session: bool;
    trace_session: DebuggerTraceSessionDescriptor;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

pub machine DebuggerTraceStartResponse::new() -> DebuggerTraceStartResponse {
    DebuggerTraceStartResponse {
        status: DebuggerCommandStatus::success(),
        has_trace_session: false,
        trace_session: DebuggerTraceSessionDescriptor::new(0, 0, DebuggerDataBreakpointAccess::Read, false),
        instruction_record_count: 0,
    }
}

pub machine DebuggerTraceStartResponse::get_status(debugger_trace_start_response: &DebuggerTraceStartResponse) -> &DebuggerCommandStatus {
    (&debugger_trace_start_response.status)
}

pub machine DebuggerTraceStartResponse::get_status_mut(debugger_trace_start_response: &mut DebuggerTraceStartResponse) -> &mut DebuggerCommandStatus {
    (&mut debugger_trace_start_response.status)
}

pub machine DebuggerTraceStartResponse::set_status(debugger_trace_start_response: &mut DebuggerTraceStartResponse, status: DebuggerCommandStatus) {
    debugger_trace_start_response.status = status;
}

pub machine DebuggerTraceStartResponse::has_trace_session(debugger_trace_start_response: &DebuggerTraceStartResponse) -> bool {
    debugger_trace_start_response.has_trace_session
}

pub machine DebuggerTraceStartResponse::get_trace_session(debugger_trace_start_response: &DebuggerTraceStartResponse) -> &DebuggerTraceSessionDescriptor {
    (&debugger_trace_start_response.trace_session)
}

pub machine DebuggerTraceStartResponse::set_trace_session(debugger_trace_start_response: &mut DebuggerTraceStartResponse, trace_session: DebuggerTraceSessionDescriptor) {
    debugger_trace_start_response.trace_session = trace_session;
    debugger_trace_start_response.has_trace_session = true;
}

pub machine DebuggerTraceStartResponse::clear_trace_session(debugger_trace_start_response: &mut DebuggerTraceStartResponse) {
    debugger_trace_start_response.has_trace_session = false;
}

pub machine DebuggerTraceStartResponse::get_instruction_record_count(debugger_trace_start_response: &DebuggerTraceStartResponse) -> u64 {
    debugger_trace_start_response.instruction_record_count
}

pub machine DebuggerTraceStartResponse::get_instruction_record(debugger_trace_start_response: &DebuggerTraceStartResponse, position: u64) -> &DebuggerTraceInstructionRecord
    requires position < 16 {
    (&debugger_trace_start_response.instruction_records[position])
}

pub machine DebuggerTraceStartResponse::add_instruction_record(debugger_trace_start_response: &mut DebuggerTraceStartResponse, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
    transition debugger_trace_start_response.instruction_record_count < 16 {
        true -> store(debugger_trace_start_response, instruction_record)
        false -> (false)
    }
    state store(debugger_trace_start_response: &mut DebuggerTraceStartResponse, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
        DebuggerTraceInstructionRecord::clone_from(&mut debugger_trace_start_response.instruction_records[debugger_trace_start_response.instruction_record_count], instruction_record);
        debugger_trace_start_response.instruction_record_count = ((debugger_trace_start_response.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
