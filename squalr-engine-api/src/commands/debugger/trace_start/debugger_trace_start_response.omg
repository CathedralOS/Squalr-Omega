module src::commands::debugger::trace_start::debugger_trace_start_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use src::structures::debugger::debugger_trace_instruction_record::DebuggerTraceInstructionRecord;
use src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;
use src::structures::bounded_append::append_debugger_trace_instruction_record;

// Port of commands/debugger/trace_start/debugger_trace_start_response.rs —
// {status, trace_session: Option<DebuggerTraceSessionDescriptor>,
// instruction_records: Vec<DebuggerTraceInstructionRecord>}. The vector
// carries a 16-entry bound.
pub data DebuggerTraceStartResponse {
    status: DebuggerCommandStatus;
    has_trace_session: bool;
    trace_session: DebuggerTraceSessionDescriptor;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

pub machine DebuggerTraceStartResponse::new() -> DebuggerTraceStartResponse {
    DebuggerTraceStartResponse {
        status: DebuggerCommandStatus::success(),
        has_trace_session: false,
        trace_session: DebuggerTraceSessionDescriptor::new(0, 0, DebuggerDataBreakpointAccess::Read, false),
        instruction_record_count: 0,
    }
}

pub machine DebuggerTraceStartResponse::get_status(&self) -> &DebuggerCommandStatus {
    (&self.status)
}

pub machine DebuggerTraceStartResponse::get_status_mut(&mut self) -> &mut DebuggerCommandStatus {
    (&mut self.status)
}

pub machine DebuggerTraceStartResponse::set_status(&mut self, status: DebuggerCommandStatus) {
    self.status = status;
}

pub machine DebuggerTraceStartResponse::has_trace_session(&self) -> bool {
    self.has_trace_session
}

pub machine DebuggerTraceStartResponse::get_trace_session(&self) -> &DebuggerTraceSessionDescriptor {
    (&self.trace_session)
}

pub machine DebuggerTraceStartResponse::set_trace_session(&mut self, trace_session: DebuggerTraceSessionDescriptor) {
    self.trace_session = trace_session;
    self.has_trace_session = true;
}

pub machine DebuggerTraceStartResponse::clear_trace_session(&mut self) {
    self.has_trace_session = false;
}

pub machine DebuggerTraceStartResponse::get_instruction_record_count(&self) -> u64 {
    self.instruction_record_count
}

pub machine DebuggerTraceStartResponse::get_instruction_record(&self, position: u64) -> &DebuggerTraceInstructionRecord
    requires position < 16 {
    (&self.instruction_records[position])
}

pub machine DebuggerTraceStartResponse::add_instruction_record(&mut self, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
    append_debugger_trace_instruction_record(&mut self.instruction_records[0..16], &mut self.instruction_record_count, instruction_record)
}
