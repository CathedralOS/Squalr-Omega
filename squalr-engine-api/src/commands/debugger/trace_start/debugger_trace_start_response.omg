use src/structures/debugger/debugger_command_status.omg;
use src/structures/debugger/debugger_data_breakpoint_access.omg;
use src/structures/debugger/debugger_trace_instruction_record.omg;
use src/structures/debugger/debugger_trace_session_descriptor.omg;

// Port of commands/debugger/trace_start/debugger_trace_start_response.rs —
// {status, trace_session: Option<DebuggerTraceSessionDescriptor>,
// instruction_records: Vec<DebuggerTraceInstructionRecord>}. The vector
// carries a 16-entry bound.
public data DebuggerTraceStartResponse {
    status: |debugger_command_status|::DebuggerCommandStatus;
    has_trace_session: bool;
    trace_session: |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor;
    instruction_records: [|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

public machine DebuggerTraceStartResponse::new() -> DebuggerTraceStartResponse {
    DebuggerTraceStartResponse {
        status: |debugger_command_status|::DebuggerCommandStatus::success(),
        has_trace_session: false,
        trace_session: |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor::new(0, 0, |debugger_data_breakpoint_access|::DebuggerDataBreakpointAccess::Read, false),
        instruction_record_count: 0,
    }
}

public machine DebuggerTraceStartResponse::get_status(this: &DebuggerTraceStartResponse) -> &|debugger_command_status|::DebuggerCommandStatus {
    (&this.status)
}

public machine DebuggerTraceStartResponse::get_status_mut(this: &mut DebuggerTraceStartResponse) -> &mut |debugger_command_status|::DebuggerCommandStatus {
    (&mut this.status)
}

public machine DebuggerTraceStartResponse::set_status(this: &mut DebuggerTraceStartResponse, status: |debugger_command_status|::DebuggerCommandStatus) {
    this.status = status;
}

public machine DebuggerTraceStartResponse::has_trace_session(this: &DebuggerTraceStartResponse) -> bool {
    this.has_trace_session
}

public machine DebuggerTraceStartResponse::get_trace_session(this: &DebuggerTraceStartResponse) -> &|debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor {
    (&this.trace_session)
}

public machine DebuggerTraceStartResponse::set_trace_session(this: &mut DebuggerTraceStartResponse, trace_session: |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor) {
    this.trace_session = trace_session;
    this.has_trace_session = true;
}

public machine DebuggerTraceStartResponse::clear_trace_session(this: &mut DebuggerTraceStartResponse) {
    this.has_trace_session = false;
}

public machine DebuggerTraceStartResponse::get_instruction_record_count(this: &DebuggerTraceStartResponse) -> u64 {
    this.instruction_record_count
}

public machine DebuggerTraceStartResponse::get_instruction_record(this: &DebuggerTraceStartResponse, position: u64) -> &|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord
    requires position < 16 {
    (&this.instruction_records[position])
}

public machine DebuggerTraceStartResponse::add_instruction_record(this: &mut DebuggerTraceStartResponse, instruction_record: &|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord) -> bool {
    transition this.instruction_record_count < 16 {
        true -> store(this, instruction_record)
        false -> (false)
    }
    machine store(this: &mut DebuggerTraceStartResponse, instruction_record: &|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord) -> bool {
        |debugger_trace_instruction_record|::DebuggerTraceInstructionRecord::clone_from(&mut this.instruction_records[this.instruction_record_count], instruction_record);
        this.instruction_record_count = ((this.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
