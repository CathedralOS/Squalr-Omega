module src::commands::debugger::registers_read::debugger_registers_read_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_register_snapshot::DebuggerRegisterSnapshot;

// Port of commands/debugger/registers_read/debugger_registers_read_response.rs —
// {status, register_snapshot: Option<DebuggerRegisterSnapshot>}.
pub data DebuggerRegistersReadResponse {
    status: DebuggerCommandStatus;
    has_register_snapshot: bool;
    register_snapshot: DebuggerRegisterSnapshot;
}

pub machine DebuggerRegistersReadResponse::new() -> DebuggerRegistersReadResponse {
    DebuggerRegistersReadResponse {
        status: DebuggerCommandStatus::success(),
        has_register_snapshot: false,
        register_snapshot: DebuggerRegisterSnapshot::new(),
    }
}

pub machine DebuggerRegistersReadResponse::get_status(&self) -> &DebuggerCommandStatus {
    (&self.status)
}

pub machine DebuggerRegistersReadResponse::get_status_mut(&mut self) -> &mut DebuggerCommandStatus {
    (&mut self.status)
}

pub machine DebuggerRegistersReadResponse::set_status(&mut self, status: DebuggerCommandStatus) {
    self.status = status;
}

pub machine DebuggerRegistersReadResponse::has_register_snapshot(&self) -> bool {
    self.has_register_snapshot
}

pub machine DebuggerRegistersReadResponse::get_register_snapshot(&self) -> &DebuggerRegisterSnapshot {
    (&self.register_snapshot)
}

pub machine DebuggerRegistersReadResponse::set_register_snapshot(&mut self, register_snapshot: DebuggerRegisterSnapshot) {
    self.register_snapshot = register_snapshot;
    self.has_register_snapshot = true;
}

pub machine DebuggerRegistersReadResponse::clear_register_snapshot(&mut self) {
    self.has_register_snapshot = false;
}
