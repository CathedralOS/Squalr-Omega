module src::commands::debugger::registers_read::debugger_registers_read_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_register_snapshot::DebuggerRegisterSnapshot;

// Port of commands/debugger/registers_read/debugger_registers_read_response.rs —
// {status, register_snapshot: Option<DebuggerRegisterSnapshot>}.
pub data DebuggerRegistersReadResponse {
    status: DebuggerCommandStatus;
    has_register_snapshot: bool;
    register_snapshot: DebuggerRegisterSnapshot;
}

pub machine DebuggerRegistersReadResponse::new() -> DebuggerRegistersReadResponse {
    DebuggerRegistersReadResponse {
        status: DebuggerCommandStatus::success(),
        has_register_snapshot: false,
        register_snapshot: DebuggerRegisterSnapshot::new(),
    }
}

pub machine DebuggerRegistersReadResponse::get_status(debugger_registers_read_response: &DebuggerRegistersReadResponse) -> &DebuggerCommandStatus {
    (&debugger_registers_read_response.status)
}

pub machine DebuggerRegistersReadResponse::get_status_mut(debugger_registers_read_response: &mut DebuggerRegistersReadResponse) -> &mut DebuggerCommandStatus {
    (&mut debugger_registers_read_response.status)
}

pub machine DebuggerRegistersReadResponse::set_status(debugger_registers_read_response: &mut DebuggerRegistersReadResponse, status: DebuggerCommandStatus) {
    debugger_registers_read_response.status = status;
}

pub machine DebuggerRegistersReadResponse::has_register_snapshot(debugger_registers_read_response: &DebuggerRegistersReadResponse) -> bool {
    debugger_registers_read_response.has_register_snapshot
}

pub machine DebuggerRegistersReadResponse::get_register_snapshot(debugger_registers_read_response: &DebuggerRegistersReadResponse) -> &DebuggerRegisterSnapshot {
    (&debugger_registers_read_response.register_snapshot)
}

pub machine DebuggerRegistersReadResponse::set_register_snapshot(debugger_registers_read_response: &mut DebuggerRegistersReadResponse, register_snapshot: DebuggerRegisterSnapshot) {
    debugger_registers_read_response.register_snapshot = register_snapshot;
    debugger_registers_read_response.has_register_snapshot = true;
}

pub machine DebuggerRegistersReadResponse::clear_register_snapshot(debugger_registers_read_response: &mut DebuggerRegistersReadResponse) {
    debugger_registers_read_response.has_register_snapshot = false;
}
