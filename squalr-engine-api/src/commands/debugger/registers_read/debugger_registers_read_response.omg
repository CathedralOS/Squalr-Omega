use src/structures/debugger/debugger_command_status.omg;
use src/structures/debugger/debugger_register_snapshot.omg;

// Port of commands/debugger/registers_read/debugger_registers_read_response.rs —
// {status, register_snapshot: Option<DebuggerRegisterSnapshot>}.
public data DebuggerRegistersReadResponse {
    status: |debugger_command_status|::DebuggerCommandStatus;
    has_register_snapshot: bool;
    register_snapshot: |debugger_register_snapshot|::DebuggerRegisterSnapshot;
}

public machine DebuggerRegistersReadResponse::new() -> DebuggerRegistersReadResponse {
    DebuggerRegistersReadResponse {
        status: |debugger_command_status|::DebuggerCommandStatus::success(),
        has_register_snapshot: false,
        register_snapshot: |debugger_register_snapshot|::DebuggerRegisterSnapshot::new(),
    }
}

public machine DebuggerRegistersReadResponse::get_status(this: &DebuggerRegistersReadResponse) -> &|debugger_command_status|::DebuggerCommandStatus {
    (&this.status)
}

public machine DebuggerRegistersReadResponse::get_status_mut(this: &mut DebuggerRegistersReadResponse) -> &mut |debugger_command_status|::DebuggerCommandStatus {
    (&mut this.status)
}

public machine DebuggerRegistersReadResponse::set_status(this: &mut DebuggerRegistersReadResponse, status: |debugger_command_status|::DebuggerCommandStatus) {
    this.status = status;
}

public machine DebuggerRegistersReadResponse::has_register_snapshot(this: &DebuggerRegistersReadResponse) -> bool {
    this.has_register_snapshot
}

public machine DebuggerRegistersReadResponse::get_register_snapshot(this: &DebuggerRegistersReadResponse) -> &|debugger_register_snapshot|::DebuggerRegisterSnapshot {
