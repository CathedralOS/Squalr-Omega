public machine DebuggerRegistersReadResponse::set_register_snapshot(this: &mut DebuggerRegistersReadResponse, register_snapshot: |debugger_register_snapshot|::DebuggerRegisterSnapshot) {
    this.register_snapshot = register_snapshot;
    this.has_register_snapshot = true;
