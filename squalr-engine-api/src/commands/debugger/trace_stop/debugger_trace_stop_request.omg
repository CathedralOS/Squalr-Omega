module src::commands::debugger::trace_stop::debugger_trace_stop_request;

// Port of commands/debugger/trace_stop/debugger_trace_stop_request.rs —
// {trace_session_id: String}.
pub data DebuggerTraceStopRequest {
    trace_session_id: [u8; 64];
    trace_session_id_len: u64;
}

pub machine DebuggerTraceStopRequest::new() -> DebuggerTraceStopRequest {
    DebuggerTraceStopRequest {
        trace_session_id_len: 0,
    }
}

pub machine DebuggerTraceStopRequest::get_trace_session_id(&self) -> &[u8] {
    transition self.trace_session_id_len <= 64 {
        true -> (&self.trace_session_id[0..self.trace_session_id_len])
        _ -> (&self.trace_session_id[0..0])
    }
}

pub machine DebuggerTraceStopRequest::get_trace_session_id_len(&self) -> u64 {
    self.trace_session_id_len
}

pub machine DebuggerTraceStopRequest::set_trace_session_id(&mut self, trace_session_id: &[u8]) {
    transition 0 == 0 {
        _ -> copy(trace_session_id, 0)
    }
    state copy(&mut self, trace_session_id: &[u8], position: u64) {
        transition position < trace_session_id.len && position < 64 {
            true -> store(trace_session_id, position)
            _ -> finish(position)
        }
    }
    state store(&mut self, trace_session_id: &[u8], position: u64)
        requires position < trace_session_id.len && position < 64 {
        self.trace_session_id[position] = trace_session_id[position];
        let next: u64 = position + 1;
        transition 0 == 0 {
            _ -> copy(trace_session_id, next)
        }
    }
    state finish(&mut self, position: u64) {
        self.trace_session_id_len = position;
        transition 0 == 0 {
            _ -> (self)
        }
    }
}
