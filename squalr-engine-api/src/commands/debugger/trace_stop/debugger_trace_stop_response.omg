use src/structures/debugger/debugger_command_status.omg;
use src/structures/debugger/debugger_data_breakpoint_access.omg;
use src/structures/debugger/debugger_trace_instruction_record.omg;
use src/structures/debugger/debugger_trace_session_descriptor.omg;

// Port of commands/debugger/trace_stop/debugger_trace_stop_response.rs — {status,
// trace_session: Option<DebuggerTraceSessionDescriptor>,
// instruction_records: Vec<DebuggerTraceInstructionRecord>}.
public data DebuggerTraceStopResponse {
    status: |debugger_command_status|::DebuggerCommandStatus;
    has_trace_session: bool;
    trace_session: |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor;
    instruction_records: [|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

public machine DebuggerTraceStopResponse::new() -> DebuggerTraceStopResponse {
    DebuggerTraceStopResponse {
        status: |debugger_command_status|::DebuggerCommandStatus::success(),
        has_trace_session: false,
        trace_session: |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor::new(0, 0, |debugger_data_breakpoint_access|::DebuggerDataBreakpointAccess::Read, false),
        instruction_record_count: 0,
    }
}

public machine DebuggerTraceStopResponse::get_status(this: &DebuggerTraceStopResponse) -> &|debugger_command_status|::DebuggerCommandStatus {
    (&this.status)
}

public machine DebuggerTraceStopResponse::get_status_mut(this: &mut DebuggerTraceStopResponse) -> &mut |debugger_command_status|::DebuggerCommandStatus {
    (&mut this.status)
}

public machine DebuggerTraceStopResponse::set_status(this: &mut DebuggerTraceStopResponse, status: |debugger_command_status|::DebuggerCommandStatus) {
    this.status = status;
}

public machine DebuggerTraceStopResponse::has_trace_session(this: &DebuggerTraceStopResponse) -> bool {
    this.has_trace_session
}

public machine DebuggerTraceStopResponse::get_trace_session(this: &DebuggerTraceStopResponse) -> &|debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor {
    (&this.trace_session)
}

public machine DebuggerTraceStopResponse::set_trace_session(this: &mut DebuggerTraceStopResponse, trace_session: |debugger_trace_session_descriptor|::DebuggerTraceSessionDescriptor) {
    this.trace_session = trace_session;
    this.has_trace_session = true;
}

public machine DebuggerTraceStopResponse::clear_trace_session(this: &mut DebuggerTraceStopResponse) {
    this.has_trace_session = false;
}

public machine DebuggerTraceStopResponse::get_instruction_record_count(this: &DebuggerTraceStopResponse) -> u64 {
    this.instruction_record_count
}

public machine DebuggerTraceStopResponse::get_instruction_record(this: &DebuggerTraceStopResponse, position: u64) -> &|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord
    requires position < 16 {
    (&this.instruction_records[position])
}

public machine DebuggerTraceStopResponse::add_instruction_record(this: &mut DebuggerTraceStopResponse, instruction_record: &|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord) -> bool {
    transition this.instruction_record_count < 16 {
        true -> store(this, instruction_record)
        false -> (false)
    }
    machine store(this: &mut DebuggerTraceStopResponse, instruction_record: &|debugger_trace_instruction_record|::DebuggerTraceInstructionRecord) -> bool {
        |debugger_trace_instruction_record|::DebuggerTraceInstructionRecord::clone_from(&mut this.instruction_records[this.instruction_record_count], instruction_record);
        this.instruction_record_count = ((this.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
