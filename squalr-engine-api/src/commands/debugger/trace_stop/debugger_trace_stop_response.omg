module src::commands::debugger::trace_stop::debugger_trace_stop_response;

use src::structures::debugger::debugger_command_status::DebuggerCommandStatus;
use src::structures::debugger::debugger_data_breakpoint_access::DebuggerDataBreakpointAccess;
use src::structures::debugger::debugger_trace_instruction_record::DebuggerTraceInstructionRecord;
use src::structures::debugger::debugger_trace_session_descriptor::DebuggerTraceSessionDescriptor;

// Port of commands/debugger/trace_stop/debugger_trace_stop_response.rs — {status,
// trace_session: Option<DebuggerTraceSessionDescriptor>,
// instruction_records: Vec<DebuggerTraceInstructionRecord>}.
pub data DebuggerTraceStopResponse {
    status: DebuggerCommandStatus;
    has_trace_session: bool;
    trace_session: DebuggerTraceSessionDescriptor;
    instruction_records: [DebuggerTraceInstructionRecord; 16];
    instruction_record_count: u64;
}

pub machine DebuggerTraceStopResponse::new() -> DebuggerTraceStopResponse {
    DebuggerTraceStopResponse {
        status: DebuggerCommandStatus::success(),
        has_trace_session: false,
        trace_session: DebuggerTraceSessionDescriptor::new(0, 0, DebuggerDataBreakpointAccess::Read, false),
        instruction_record_count: 0,
    }
}

pub machine DebuggerTraceStopResponse::get_status(this: &DebuggerTraceStopResponse) -> &DebuggerCommandStatus {
    (&this.status)
}

pub machine DebuggerTraceStopResponse::get_status_mut(this: &mut DebuggerTraceStopResponse) -> &mut DebuggerCommandStatus {
    (&mut this.status)
}

pub machine DebuggerTraceStopResponse::set_status(this: &mut DebuggerTraceStopResponse, status: DebuggerCommandStatus) {
    this.status = status;
}

pub machine DebuggerTraceStopResponse::has_trace_session(this: &DebuggerTraceStopResponse) -> bool {
    this.has_trace_session
}

pub machine DebuggerTraceStopResponse::get_trace_session(this: &DebuggerTraceStopResponse) -> &DebuggerTraceSessionDescriptor {
    (&this.trace_session)
}

pub machine DebuggerTraceStopResponse::set_trace_session(this: &mut DebuggerTraceStopResponse, trace_session: DebuggerTraceSessionDescriptor) {
    this.trace_session = trace_session;
    this.has_trace_session = true;
}

pub machine DebuggerTraceStopResponse::clear_trace_session(this: &mut DebuggerTraceStopResponse) {
    this.has_trace_session = false;
}

pub machine DebuggerTraceStopResponse::get_instruction_record_count(this: &DebuggerTraceStopResponse) -> u64 {
    this.instruction_record_count
}

pub machine DebuggerTraceStopResponse::get_instruction_record(this: &DebuggerTraceStopResponse, position: u64) -> &DebuggerTraceInstructionRecord
    requires position < 16 {
    (&this.instruction_records[position])
}

pub machine DebuggerTraceStopResponse::add_instruction_record(this: &mut DebuggerTraceStopResponse, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
    transition this.instruction_record_count < 16 {
        true -> store(this, instruction_record)
        false -> (false)
    }
    state store(this: &mut DebuggerTraceStopResponse, instruction_record: &DebuggerTraceInstructionRecord) -> bool {
        DebuggerTraceInstructionRecord::clone_from(&mut this.instruction_records[this.instruction_record_count], instruction_record);
        this.instruction_record_count = ((this.instruction_record_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
