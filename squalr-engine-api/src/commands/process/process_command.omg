module src::commands::process::process_command;

use src::commands::process::close::process_close_request::ProcessCloseRequest;
use src::commands::process::icon::process_icon_request::ProcessIconRequest;
use src::commands::process::list::process_list_request::ProcessListRequest;
use src::commands::process::open::process_open_request::ProcessOpenRequest;

// Port of commands/process/process_command.rs — the process-domain command
// union, in upstream case order.
pub data ProcessCommand {
    case Open(request: ProcessOpenRequest);
    case List(request: ProcessListRequest);
    case Icon(request: ProcessIconRequest);
    case Close(request: ProcessCloseRequest);
}
