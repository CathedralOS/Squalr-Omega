use src/commands/process/close/process_close_request.omg;
use src/commands/process/icon/process_icon_request.omg;
use src/commands/process/list/process_list_request.omg;
use src/commands/process/open/process_open_request.omg;

// Port of commands/process/process_command.rs — the process-domain command
// union, in upstream case order.
public data ProcessCommand {
    case Open(request: |process_open_request|::ProcessOpenRequest);
    case List(request: |process_list_request|::ProcessListRequest);
    case Icon(request: |process_icon_request|::ProcessIconRequest);
    case Close(request: |process_close_request|::ProcessCloseRequest);
}
