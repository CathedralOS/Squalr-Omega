module src::commands::process::process_response;

use src::commands::process::close::process_close_response::ProcessCloseResponse;
use src::commands::process::icon::process_icon_response::ProcessIconResponse;
use src::commands::process::list::process_list_response::ProcessListResponse;
use src::commands::process::open::process_open_response::ProcessOpenResponse;

// Port of commands/process/process_response.rs — the process-domain response
// union, in upstream case order (List, Icon, Close, Open).
pub data ProcessResponse {
    case List(response: ProcessListResponse);
    case Icon(response: ProcessIconResponse);
    case Close(response: ProcessCloseResponse);
    case Open(response: ProcessOpenResponse);
}
