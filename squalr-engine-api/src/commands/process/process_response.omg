use src/commands/process/close/process_close_response.omg;
use src/commands/process/icon/process_icon_response.omg;
use src/commands/process/list/process_list_response.omg;
use src/commands/process/open/process_open_response.omg;

// Port of commands/process/process_response.rs — the process-domain response
// union, in upstream case order (List, Icon, Close, Open).
public data ProcessResponse {
    case List(response: |process_list_response|::ProcessListResponse);
    case Icon(response: |process_icon_response|::ProcessIconResponse);
    case Close(response: |process_close_response|::ProcessCloseResponse);
    case Open(response: |process_open_response|::ProcessOpenResponse);
}
