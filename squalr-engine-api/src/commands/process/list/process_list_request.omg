module src::commands::process::list::process_list_request;

use src::structures::bounded_slice::bounded_slice;

// Port of commands/process/list/process_list_request.rs.
// Upstream fields with their carriers:
//   require_windowed: bool; search_name: Option<String> -> has_ + bounded
//     span; match_case: bool; limit: Option<u64> -> has_limit + limit;
//   fetch_icons: bool.
pub data ProcessListRequest {
    require_windowed: bool;
    has_search_name: bool;
    search_name: [u8; 256];
    search_name_len: u64;
    match_case: bool;
    has_limit: bool;
    limit: u64;
    fetch_icons: bool;
}

// Upstream default construction: no name filter, no limit, all flags false.
pub machine ProcessListRequest::new() -> ProcessListRequest {
    ProcessListRequest {
        require_windowed: false,
        has_search_name: false,
        search_name_len: 0,
        match_case: false,
        has_limit: false,
        limit: 0,
        fetch_icons: false
    }
}

pub machine ProcessListRequest::get_require_windowed(&self) -> bool {
    self.require_windowed
}

pub machine ProcessListRequest::set_require_windowed(&mut self, require_windowed: bool) {
    self.require_windowed = require_windowed;
}

pub machine ProcessListRequest::has_search_name(&self) -> bool {
    self.has_search_name
}

pub machine ProcessListRequest::get_search_name(&self) -> &[u8] {
    bounded_slice(&self.search_name[0..256], self.search_name_len)
}

pub machine ProcessListRequest::set_search_name(&mut self, search_name: &[u8]) {
    self.search_name_len = 0;
    transition { _ -> copy(search_name, 0) }
    state copy(&mut self, search_name: &[u8], position: u64) {
        transition position < search_name.len && position < 256 {
            true -> store(search_name, position)
            false -> finish(position)
        }
    }
    state store(&mut self, search_name: &[u8], position: u64) {
        self.search_name[position] = search_name[position];
        transition {
            _ -> copy(search_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.search_name_len = count;
        self.has_search_name = true;
    }
}

pub machine ProcessListRequest::clear_search_name(&mut self) {
    self.has_search_name = false;
    self.search_name_len = 0;
}

pub machine ProcessListRequest::get_match_case(&self) -> bool {
    self.match_case
}

pub machine ProcessListRequest::set_match_case(&mut self, match_case: bool) {
    self.match_case = match_case;
}

pub machine ProcessListRequest::has_limit(&self) -> bool {
    self.has_limit
}

pub machine ProcessListRequest::get_limit(&self) -> u64 {
    self.limit
}

pub machine ProcessListRequest::set_limit(&mut self, limit: u64) {
    self.limit = limit;
    self.has_limit = true;
}

pub machine ProcessListRequest::clear_limit(&mut self) {
    self.has_limit = false;
}

pub machine ProcessListRequest::get_fetch_icons(&self) -> bool {
    self.fetch_icons
}

pub machine ProcessListRequest::set_fetch_icons(&mut self, fetch_icons: bool) {
    self.fetch_icons = fetch_icons;
}
