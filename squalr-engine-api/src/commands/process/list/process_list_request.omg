module src::commands::process::list::process_list_request;

// Port of commands/process/list/process_list_request.rs.
// Upstream fields with their carriers:
//   require_windowed: bool; search_name: Option<String> -> has_ + bounded
//     span; match_case: bool; limit: Option<u64> -> has_limit + limit;
//   fetch_icons: bool.
pub data ProcessListRequest {
    require_windowed: bool;
    has_search_name: bool;
    search_name: [u8; 256];
    search_name_len: u64;
    match_case: bool;
    has_limit: bool;
    limit: u64;
    fetch_icons: bool;
}

// Upstream default construction: no name filter, no limit, all flags false.
pub machine ProcessListRequest::new() -> ProcessListRequest {
    ProcessListRequest {
        require_windowed: false,
        has_search_name: false,
        search_name_len: 0,
        match_case: false,
        has_limit: false,
        limit: 0,
        fetch_icons: false
    }
}

pub machine ProcessListRequest::get_require_windowed(process_list_request: &ProcessListRequest) -> bool {
    process_list_request.require_windowed
}

pub machine ProcessListRequest::set_require_windowed(process_list_request: &mut ProcessListRequest, require_windowed: bool) {
    process_list_request.require_windowed = require_windowed;
}

pub machine ProcessListRequest::has_search_name(process_list_request: &ProcessListRequest) -> bool {
    process_list_request.has_search_name
}

pub machine ProcessListRequest::get_search_name(process_list_request: &ProcessListRequest) -> &[u8] {
    transition process_list_request.search_name_len <= 256 {
        true -> (&process_list_request.search_name[0..process_list_request.search_name_len])
        false -> (&process_list_request.search_name[0..256])
        _ -> (&process_list_request.search_name[0..256])
    }
}

pub machine ProcessListRequest::set_search_name(process_list_request: &mut ProcessListRequest, search_name: &[u8]) {
    process_list_request.search_name_len = 0;
    transition { _ -> copy(process_list_request, search_name, 0) }
    state copy(process_list_request: &mut ProcessListRequest, search_name: &[u8], position: u64) {
        transition position < search_name.len && position < 256 {
            true -> store(process_list_request, search_name, position)
            false -> finish(process_list_request, position)
        }
    }
    state store(process_list_request: &mut ProcessListRequest, search_name: &[u8], position: u64) {
        process_list_request.search_name[position] = search_name[position];
        transition {
            _ -> copy(process_list_request, search_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(process_list_request: &mut ProcessListRequest, count: u64) {
        process_list_request.search_name_len = count;
        process_list_request.has_search_name = true;
    }
}

pub machine ProcessListRequest::clear_search_name(process_list_request: &mut ProcessListRequest) {
    process_list_request.has_search_name = false;
    process_list_request.search_name_len = 0;
}

pub machine ProcessListRequest::get_match_case(process_list_request: &ProcessListRequest) -> bool {
    process_list_request.match_case
}

pub machine ProcessListRequest::set_match_case(process_list_request: &mut ProcessListRequest, match_case: bool) {
    process_list_request.match_case = match_case;
}

pub machine ProcessListRequest::has_limit(process_list_request: &ProcessListRequest) -> bool {
    process_list_request.has_limit
}

pub machine ProcessListRequest::get_limit(process_list_request: &ProcessListRequest) -> u64 {
    process_list_request.limit
}

pub machine ProcessListRequest::set_limit(process_list_request: &mut ProcessListRequest, limit: u64) {
    process_list_request.limit = limit;
    process_list_request.has_limit = true;
}

pub machine ProcessListRequest::clear_limit(process_list_request: &mut ProcessListRequest) {
    process_list_request.has_limit = false;
}

pub machine ProcessListRequest::get_fetch_icons(process_list_request: &ProcessListRequest) -> bool {
    process_list_request.fetch_icons
}

pub machine ProcessListRequest::set_fetch_icons(process_list_request: &mut ProcessListRequest, fetch_icons: bool) {
    process_list_request.fetch_icons = fetch_icons;
}
