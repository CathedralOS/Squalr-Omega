module src::commands::process::list::process_list_response;

use src::structures::processes::process_info::ProcessInfo;

// Port of commands/process/list/process_list_response.rs.
// `processes: Vec<ProcessInfo>` -> bounded [ProcessInfo; 256] + live count —
// the carrier-bound convention (supplied_modules[8], freeze entries[64]):
// upstream's Vec is unbounded, so `add_process` refuses past 256 rather than
// silently dropping. 256 covers the `limit` parameter's ordinary page sizes
// and real enumeration counts without being a result-shaping cap.
pub data ProcessListResponse {
    processes: [ProcessInfo; 256];
    process_count: u64;
}

pub machine ProcessListResponse::new() -> ProcessListResponse {
    ProcessListResponse {
        process_count: 0,
    }
}

pub machine ProcessListResponse::get_process_count(this: &ProcessListResponse) -> u64 {
    this.process_count
}

// Upstream `processes[index]` — guarded element access.
pub machine ProcessListResponse::get_process(this: &ProcessListResponse, index: u64) -> &ProcessInfo
    requires 0 <= index && index < 256
{
    &this.processes[index]
}

// Upstream Vec::push — appends a whole ProcessInfo (the same whole-record
// store the supplied-module carrier uses); refuses past the bound.
pub machine ProcessListResponse::add_process(this: &mut ProcessListResponse, process_info: ProcessInfo) -> bool {
    transition this.process_count < 256 {
        true -> store(this, process_info)
        false -> (false)
        _ -> (false)
    }
    state store(this: &mut ProcessListResponse, process_info: ProcessInfo) -> bool {
        let index: u64 = this.process_count;
        transition index < 256 {
            true -> fill(this, process_info, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill(this: &mut ProcessListResponse, process_info: ProcessInfo, index: u64) -> bool
        requires 0 <= index && index < 256
    {
        this.processes[index] = process_info;
        this.process_count = index + 1;
        (true)
    }
}
