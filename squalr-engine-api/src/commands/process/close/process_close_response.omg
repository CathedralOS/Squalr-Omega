module src::commands::process::close::process_close_response;

use src::structures::processes::opened_process_info::OpenedProcessInfo;

// Port of commands/process/close/process_close_response.rs.
// `process_info: Option<OpenedProcessInfo>` -> has_ + value pair — upstream
// echoes the process it closed, or None when nothing was open.
pub data ProcessCloseResponse {
    has_process_info: bool;
    process_info: OpenedProcessInfo;
}

pub machine ProcessCloseResponse::new() -> ProcessCloseResponse {
    ProcessCloseResponse {
        has_process_info: false,
    }
}

pub machine ProcessCloseResponse::has_process_info(process_close_response: &ProcessCloseResponse) -> bool {
    process_close_response.has_process_info
}

pub machine ProcessCloseResponse::get_process_info(process_close_response: &ProcessCloseResponse) -> &OpenedProcessInfo {
    &process_close_response.process_info
}

pub machine ProcessCloseResponse::set_process_info(process_close_response: &mut ProcessCloseResponse, process_info: OpenedProcessInfo) {
    process_close_response.process_info = process_info;
    process_close_response.has_process_info = true;
}
