use src/structures/processes/opened_process_info.omg;

// Port of commands/process/close/process_close_response.rs.
// `process_info: Option<OpenedProcessInfo>` -> has_ + value pair — upstream
// echoes the process it closed, or None when nothing was open.
public data ProcessCloseResponse {
    has_process_info: bool;
    process_info: |opened_process_info|::OpenedProcessInfo;
}

public machine ProcessCloseResponse::new() -> ProcessCloseResponse {
    ProcessCloseResponse {
        has_process_info: false,
    }
}

public machine ProcessCloseResponse::has_process_info(this: &ProcessCloseResponse) -> bool {
    this.has_process_info
}

public machine ProcessCloseResponse::get_process_info(this: &ProcessCloseResponse) -> &|opened_process_info|::OpenedProcessInfo {
    &this.process_info
}

public machine ProcessCloseResponse::set_process_info(this: &mut ProcessCloseResponse, process_info: |opened_process_info|::OpenedProcessInfo) {
    this.process_info = process_info;
    this.has_process_info = true;
}
