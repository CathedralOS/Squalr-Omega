module src::commands::process::open::process_open_response;

use src::structures::processes::opened_process_info::OpenedProcessInfo;

// Port of commands/process/open/process_open_response.rs.
// `opened_process_info: Option<OpenedProcessInfo>` -> has_ + value pair; the
// [copy] payload stores whole (upstream returns the opened process's info,
// or None when the open found no match).
pub data ProcessOpenResponse {
    has_opened_process_info: bool;
    opened_process_info: OpenedProcessInfo;
}

pub machine ProcessOpenResponse::new() -> ProcessOpenResponse {
    ProcessOpenResponse {
        has_opened_process_info: false,
    }
}

pub machine ProcessOpenResponse::has_opened_process_info(this: &ProcessOpenResponse) -> bool {
    this.has_opened_process_info
}

pub machine ProcessOpenResponse::get_opened_process_info(this: &ProcessOpenResponse) -> &OpenedProcessInfo {
    &this.opened_process_info
}

pub machine ProcessOpenResponse::set_opened_process_info(this: &mut ProcessOpenResponse, opened_process_info: OpenedProcessInfo) {
    this.opened_process_info = opened_process_info;
    this.has_opened_process_info = true;
}
