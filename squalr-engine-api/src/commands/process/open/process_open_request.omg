module src::commands::process::open::process_open_request;

// Port of commands/process/open/process_open_request.rs.
// Upstream fields with their carriers:
//   process_id: Option<u32> -> has_process_id + process_id (the flag pair is
//     the Option respell; the value leg is meaningful only under the flag).
//   search_name: Option<String> -> has_search_name + bounded [u8; 256] +
//     live length (bounded-name convention).
//   match_case: bool.
pub data ProcessOpenRequest {
    has_process_id: bool;
    process_id: u32;
    has_search_name: bool;
    search_name: [u8; 256];
    search_name_len: u64;
    match_case: bool;
}

// Upstream default construction: every Option leg absent, match_case false.
pub machine ProcessOpenRequest::new() -> ProcessOpenRequest {
    ProcessOpenRequest {
        has_process_id: false,
        process_id: 0,
        has_search_name: false,
        search_name_len: 0,
        match_case: false
    }
}

pub machine ProcessOpenRequest::has_process_id(process_open_request: &ProcessOpenRequest) -> bool {
    process_open_request.has_process_id
}

pub machine ProcessOpenRequest::get_process_id(process_open_request: &ProcessOpenRequest) -> u32 {
    process_open_request.process_id
}

pub machine ProcessOpenRequest::set_process_id(process_open_request: &mut ProcessOpenRequest, process_id: u32) {
    process_open_request.process_id = process_id;
    process_open_request.has_process_id = true;
}

pub machine ProcessOpenRequest::clear_process_id(process_open_request: &mut ProcessOpenRequest) {
    process_open_request.has_process_id = false;
}

pub machine ProcessOpenRequest::has_search_name(process_open_request: &ProcessOpenRequest) -> bool {
    process_open_request.has_search_name
}

// Upstream `search_name` as Some — the live identifier span.
pub machine ProcessOpenRequest::get_search_name(process_open_request: &ProcessOpenRequest) -> &[u8] {
    transition process_open_request.search_name_len <= 256 {
        true -> (&process_open_request.search_name[0..process_open_request.search_name_len])
        false -> (&process_open_request.search_name[0..256])
        _ -> (&process_open_request.search_name[0..256])
    }
}

pub machine ProcessOpenRequest::set_search_name(process_open_request: &mut ProcessOpenRequest, search_name: &[u8]) {
    process_open_request.search_name_len = 0;
    transition { _ -> copy(process_open_request, search_name, 0) }
    state copy(process_open_request: &mut ProcessOpenRequest, search_name: &[u8], position: u64) {
        transition position < search_name.len && position < 256 {
            true -> store(process_open_request, search_name, position)
            false -> finish(process_open_request, position)
        }
    }
    state store(process_open_request: &mut ProcessOpenRequest, search_name: &[u8], position: u64) {
        process_open_request.search_name[position] = search_name[position];
        transition {
            _ -> copy(process_open_request, search_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(process_open_request: &mut ProcessOpenRequest, count: u64) {
        process_open_request.search_name_len = count;
        process_open_request.has_search_name = true;
    }
}

pub machine ProcessOpenRequest::clear_search_name(process_open_request: &mut ProcessOpenRequest) {
    process_open_request.has_search_name = false;
    process_open_request.search_name_len = 0;
}

pub machine ProcessOpenRequest::get_match_case(process_open_request: &ProcessOpenRequest) -> bool {
    process_open_request.match_case
}

pub machine ProcessOpenRequest::set_match_case(process_open_request: &mut ProcessOpenRequest, match_case: bool) {
    process_open_request.match_case = match_case;
}
