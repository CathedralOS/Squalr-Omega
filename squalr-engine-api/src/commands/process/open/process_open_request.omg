module src::commands::process::open::process_open_request;

use src::structures::bounded_slice::bounded_slice;
use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/process/open/process_open_request.rs.
// Upstream fields with their carriers:
//   process_id: Option<u32> -> has_process_id + process_id (the flag pair is
//     the Option respell; the value leg is meaningful only under the flag).
//   search_name: Option<String> -> has_search_name + bounded [u8; 256] +
//     live length (bounded-name convention).
//   match_case: bool.
pub data ProcessOpenRequest {
    has_process_id: bool;
    process_id: u32;
    has_search_name: bool;
    search_name: [u8; 256];
    search_name_len: u64;
    match_case: bool;
}

// Upstream default construction: every Option leg absent, match_case false.
pub machine ProcessOpenRequest::new() -> ProcessOpenRequest {
    ProcessOpenRequest {
        has_process_id: false,
        process_id: 0,
        has_search_name: false,
        search_name_len: 0,
        match_case: false
    }
}

pub machine ProcessOpenRequest::has_process_id(&self) -> bool {
    self.has_process_id
}

pub machine ProcessOpenRequest::get_process_id(&self) -> u32 {
    self.process_id
}

pub machine ProcessOpenRequest::set_process_id(&mut self, process_id: u32) {
    self.process_id = process_id;
    self.has_process_id = true;
}

pub machine ProcessOpenRequest::clear_process_id(&mut self) {
    self.has_process_id = false;
}

pub machine ProcessOpenRequest::has_search_name(&self) -> bool {
    self.has_search_name
}

// Upstream `search_name` as Some — the live identifier span.
pub machine ProcessOpenRequest::get_search_name(&self) -> &[u8] {
    bounded_slice(&self.search_name[0..256], self.search_name_len)
}

pub machine ProcessOpenRequest::set_search_name(&mut self, search_name: &[u8]) {
    self.search_name_len = BoundedByteCopy::copy(&mut self.search_name[0..256], search_name);
    self.has_search_name = true;
}

pub machine ProcessOpenRequest::clear_search_name(&mut self) {
    self.has_search_name = false;
    self.search_name_len = 0;
}

pub machine ProcessOpenRequest::get_match_case(&self) -> bool {
    self.match_case
}

pub machine ProcessOpenRequest::set_match_case(&mut self, match_case: bool) {
    self.match_case = match_case;
}
