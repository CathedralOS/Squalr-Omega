module src::commands::process::icon::process_icon_response;

use src::structures::processes::process_icon::ProcessIcon;

// Port of commands/process/icon/process_icon_response.rs.
// `ProcessIconEntry { process_id, process_icon: Option<ProcessIcon> }` — the
// Option respell (has_ + value), then the list `Vec<ProcessIconEntry>` rides
// a bounded [ProcessIconEntry; 64] matching the request's 64-id batch bound.
pub data ProcessIconEntry {
    process_id: u32;
    has_process_icon: bool;
    process_icon: ProcessIcon;
}

pub data ProcessIconResponse {
    process_icons: [ProcessIconEntry; 64];
    process_icon_count: u64;
}

pub machine ProcessIconResponse::new() -> ProcessIconResponse {
    ProcessIconResponse {
        process_icon_count: 0,
    }
}

pub machine ProcessIconResponse::get_process_icon_count(&self) -> u64 {
    self.process_icon_count
}

pub machine ProcessIconResponse::get_process_icon_entry(&self, index: u64) -> &ProcessIconEntry
    requires 0 <= index && index < 64
{
    &self.process_icons[index]
}

// Upstream Vec::push of the {process_id, Option<ProcessIcon>} entry.
pub machine ProcessIconResponse::add_process_icon_entry(&mut self, process_icon_entry: ProcessIconEntry) -> bool {
    transition self.process_icon_count < 64 {
        true -> store(process_icon_entry)
        false -> (false)
        _ -> (false)
    }
    state store(&mut self, process_icon_entry: ProcessIconEntry) -> bool {
        let index: u64 = self.process_icon_count;
        transition index < 64 {
            true -> fill(process_icon_entry, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill(&mut self, process_icon_entry: ProcessIconEntry, index: u64) -> bool
        requires 0 <= index && index < 64
    {
        self.process_icons[index] = process_icon_entry;
        self.process_icon_count = index + 1;
        (true)
    }
}
