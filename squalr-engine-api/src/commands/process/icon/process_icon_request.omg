module src::commands::process::icon::process_icon_request;

// Port of commands/process/icon/process_icon_request.rs.
// `process_ids: Vec<u32>` -> bounded [u32; 64] + live count — icon batches are
// small by upstream's use (one row per visible process in the GUI list);
// add_process_id refuses past the bound.
pub data ProcessIconRequest {
    process_ids: [u32; 64];
    process_id_count: u64;
}

pub machine ProcessIconRequest::new() -> ProcessIconRequest {
    ProcessIconRequest {
        process_id_count: 0,
    }
}

pub machine ProcessIconRequest::get_process_id_count(this: &ProcessIconRequest) -> u64 {
    this.process_id_count
}

pub machine ProcessIconRequest::get_process_id(this: &ProcessIconRequest, index: u64) -> u32
    requires 0 <= index && index < 64
{
    this.process_ids[index]
}

pub machine ProcessIconRequest::add_process_id(this: &mut ProcessIconRequest, process_id: u32) -> bool {
    transition this.process_id_count < 64 {
        true -> store(this, process_id)
        false -> (false)
        _ -> (false)
    }
    state store(this: &mut ProcessIconRequest, process_id: u32) -> bool {
        let index: u64 = this.process_id_count;
        transition index < 64 {
            true -> fill(this, process_id, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill(this: &mut ProcessIconRequest, process_id: u32, index: u64) -> bool
        requires 0 <= index && index < 64
    {
        this.process_ids[index] = process_id;
        this.process_id_count = index + 1;
        (true)
    }
}
