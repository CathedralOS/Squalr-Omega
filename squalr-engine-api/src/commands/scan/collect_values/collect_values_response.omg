module src::commands::scan::collect_values::collect_values_response;

// Port of commands/scan/collect_values/collect_values_response.rs. Upstream
// returns `success` plus the task handle/ref pair — folded like the
// element-scan response (the synchronous executor completes the task before
// returning).
pub data CollectValuesResponse {
    success: bool;
}

pub machine CollectValuesResponse::default() -> CollectValuesResponse {
    CollectValuesResponse { success: false }
}
