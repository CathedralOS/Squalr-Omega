module src::commands::scan::collect_values::collect_values_response;

use src::structures::scan_results::scan_results_metadata::ScanResultsMetadata;

// Port of commands/scan/collect_values/collect_values_response.rs. Upstream
// returns `success` plus `scan_results_metadata` — the response-carried half
// of the scan statistics collected at response time. The task handle/ref
// pair is folded like the element-scan response (the synchronous executor
// completes the task before returning).
pub data CollectValuesResponse {
    success: bool;
    scan_results_metadata: ScanResultsMetadata;
}

pub machine CollectValuesResponse::default() -> CollectValuesResponse {
    CollectValuesResponse {
        success: false,
        scan_results_metadata: ScanResultsMetadata::default(),
    }
}
