use src/commands/scan/collect_values/collect_values_request.omg;
use src/commands/scan/element_scan/element_scan_request.omg;
use src/commands/scan/new/scan_new_request.omg;
use src/commands/scan/reset/scan_reset_request.omg;
use src/commands/scan/supplied_bytes/scan_supplied_bytes_request.omg;

// Port of commands/scan/scan_command.rs: the scan-domain command union —
// `Reset`, `New`, `CollectValues { data_type_refs }`,
// `ElementScan { scan_constraints, data_type_refs }`. `SuppliedBytes` is
// the port's api case for the captured-bytes milestone — the request carries
// the byte array + value type; upstream folds that scan into `ElementScan`
// over a live snapshot. Struct-scan and pointer-scan land with their own
// legs.
public data ScanCommand {
    case Reset(request: |scan_reset_request|::ScanResetRequest);
    case New(request: |scan_new_request|::ScanNewRequest);
    case CollectValues(request: |collect_values_request|::CollectValuesRequest);
    case ElementScan(request: |element_scan_request|::ElementScanRequest);
    case SuppliedBytes(request: |scan_supplied_bytes_request|::ScanSuppliedBytesRequest);
}
