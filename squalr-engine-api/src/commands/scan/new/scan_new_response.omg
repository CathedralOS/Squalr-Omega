module src::commands::scan::new::scan_new_response;

// Port of commands/scan/new/scan_new_response.rs: a bare success flag —
// upstream returns `ScanNewResponse { success }`, defaulting to false when
// there is no opened process.
public data ScanNewResponse {
    success: bool;
}

public machine ScanNewResponse::default() -> ScanNewResponse {
    ScanNewResponse { success: false }
}
