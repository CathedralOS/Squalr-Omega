module src::commands::scan::scan_response;

use src::commands::scan::collect_values::collect_values_response::CollectValuesResponse;
use src::commands::scan::element_scan::element_scan_response::ElementScanResponse;
use src::commands::scan::new::scan_new_response::ScanNewResponse;
use src::commands::scan::reset::scan_reset_response::ScanResetResponse;

// Port of commands/scan/scan_response.rs — one response case per command.
pub data ScanResponse {
    case Reset(response: ScanResetResponse);
    case New(response: ScanNewResponse);
    case CollectValues(response: CollectValuesResponse);
    case ElementScan(response: ElementScanResponse);
}

// Case queries keep callers in scalar guards where the unit kind lacks
// union-match terminators.
pub machine ScanResponse::is_new(&self) -> bool {
    transition self {
        ScanResponse::New { response } -> (true)
        _ -> (false)
    }
}

pub machine ScanResponse::is_element_scan(&self) -> bool {
    transition self {
        ScanResponse::ElementScan { response } -> (true)
        _ -> (false)
    }
}
