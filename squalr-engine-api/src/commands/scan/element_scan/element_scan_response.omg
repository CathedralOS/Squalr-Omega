module src::commands::scan::element_scan::element_scan_response;

use src::structures::scan_results::scan_results_metadata::ScanResultsMetadata;

// Port of commands/scan/element_scan/element_scan_response.rs. Upstream
// serializes `success`, the completed `trackable_task`, a weak
// `trackable_task_ref` for cancellation polling, and the result metadata.
// The port's scan runs synchronously inside the executor (the task is
// always complete at return), and the borrowed-substrate task record
// cannot cross the wire — the response therefore carries the observable
// success + metadata surface (translation note; the async task surface
// lands with the cancellation leg).
pub data ElementScanResponse {
    success: bool;
    scan_results_metadata: ScanResultsMetadata;
}

pub machine ElementScanResponse::default() -> ElementScanResponse {
    ElementScanResponse {
        success: false,
        scan_results_metadata: ScanResultsMetadata::default(),
    }
}
