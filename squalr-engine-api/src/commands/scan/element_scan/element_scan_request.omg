module src::commands::scan::element_scan::element_scan_request;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use src::structures::scanning::comparisons::scan_compare_type_relative::ScanCompareTypeRelative;
use src::structures::scanning::constraints::anonymous_scan_constraint::AnonymousScanConstraint;
use src::structures::snapshots::snapshot_region::DataTypeRefSet;

// The bounded constraint list the command carries — upstream's
// `Vec<AnonymousScanConstraint>` (MAX_CONSTRAINTS = 4, a named deviation).
pub data ScanConstraintSet {
    scan_constraints: [AnonymousScanConstraint; 4];
    count: u64;
}

pub machine ScanConstraintSet::empty() -> ScanConstraintSet {
    ScanConstraintSet { count: 0 }
}

pub machine ScanConstraintSet::get_count(scan_constraint_set: &ScanConstraintSet) -> u64 {
    scan_constraint_set.count
}

pub machine ScanConstraintSet::get(scan_constraint_set: &ScanConstraintSet, position: u64) -> AnonymousScanConstraint {
    transition position < scan_constraint_set.count && position < 4 {
        true -> clone_at(scan_constraint_set, position)
        false -> (AnonymousScanConstraint::new_no_value(
            ScanCompareType::Relative { compare_type: ScanCompareTypeRelative::Unchanged }))
    }
    state clone_at(scan_constraint_set: &ScanConstraintSet, position: u64) -> AnonymousScanConstraint {
        AnonymousScanConstraint::clone(&scan_constraint_set.scan_constraints[position])
    }
}

pub machine ScanConstraintSet::push(scan_constraint_set: &mut ScanConstraintSet, constraint: &AnonymousScanConstraint) -> bool {
    transition scan_constraint_set.count < 4 {
        true -> store(scan_constraint_set, constraint)
        false -> (false)
    }
    state store(scan_constraint_set: &mut ScanConstraintSet, constraint: &AnonymousScanConstraint) -> bool {
        AnonymousScanConstraint::clone_from(&mut scan_constraint_set.scan_constraints[scan_constraint_set.count], constraint);
        scan_constraint_set.count = scan_constraint_set.count + 1;
        true
    }
}

// Port of commands/scan/element_scan/element_scan_request.rs.
pub data ElementScanRequest {
    scan_constraints: ScanConstraintSet;
    data_type_refs: DataTypeRefSet;
}
