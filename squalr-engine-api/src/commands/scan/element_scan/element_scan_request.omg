module src::commands::scan::element_scan::element_scan_request;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use src::structures::scanning::comparisons::scan_compare_type_relative::ScanCompareTypeRelative;
use src::structures::scanning::constraints::anonymous_scan_constraint::AnonymousScanConstraint;
use src::structures::snapshots::snapshot_region::DataTypeRefSet;

// The bounded constraint list the command carries — upstream's
// `Vec<AnonymousScanConstraint>` (MAX_CONSTRAINTS = 4, a named deviation).
pub data ScanConstraintSet {
    scan_constraints: [AnonymousScanConstraint; 4];
    count: u64;
}

pub machine ScanConstraintSet::empty() -> ScanConstraintSet {
    ScanConstraintSet { count: 0 }
}

pub machine ScanConstraintSet::get_count(&self) -> u64 {
    self.count
}

pub machine ScanConstraintSet::get(&self, position: u64) -> AnonymousScanConstraint {
    transition position < self.count && position < 4 {
        true -> clone_at(position)
        false -> (AnonymousScanConstraint::new_no_value(
            ScanCompareType::Relative { compare_type: ScanCompareTypeRelative::Unchanged }))
    }
    state clone_at(&self, position: u64) -> AnonymousScanConstraint {
        AnonymousScanConstraint::clone(&self.scan_constraints[position])
    }
}

pub machine ScanConstraintSet::push(&mut self, constraint: &AnonymousScanConstraint) -> bool {
    transition self.count < 4 {
        true -> store(constraint)
        false -> (false)
    }
    state store(&mut self, constraint: &AnonymousScanConstraint) -> bool {
        self.scan_constraints[self.count].clone_from(constraint);
        self.count = self.count + 1;
        true
    }
}

// Port of commands/scan/element_scan/element_scan_request.rs.
pub data ElementScanRequest {
    scan_constraints: ScanConstraintSet;
    data_type_refs: DataTypeRefSet;
}
