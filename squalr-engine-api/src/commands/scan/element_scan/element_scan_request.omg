use src/structures/data_types/data_type_ref.omg;
use src/structures/scanning/comparisons/scan_compare_type.omg;
use src/structures/scanning/comparisons/scan_compare_type_relative.omg;
use src/structures/scanning/constraints/anonymous_scan_constraint.omg;
use src/structures/snapshots/snapshot_region.omg;

// The bounded constraint list the command carries — upstream's
// `Vec<AnonymousScanConstraint>` (MAX_CONSTRAINTS = 4, a named deviation).
public data ScanConstraintSet {
    scan_constraints: [|anonymous_scan_constraint|::AnonymousScanConstraint; 4];
    count: u64;
}

public machine ScanConstraintSet::empty() -> ScanConstraintSet {
    ScanConstraintSet { count: 0 }
}

public machine ScanConstraintSet::get_count(this: &ScanConstraintSet) -> u64 {
    this.count
}

public machine ScanConstraintSet::get(this: &ScanConstraintSet, position: u64) -> |anonymous_scan_constraint|::AnonymousScanConstraint {
    transition position < this.count && position < 4 {
        true -> clone_at(this, position)
        false -> (|anonymous_scan_constraint|::AnonymousScanConstraint::new_no_value(
            |scan_compare_type|::ScanCompareType::Relative { compare_type: |scan_compare_type_relative|::ScanCompareTypeRelative::Unchanged }))
    }
    machine clone_at(this: &ScanConstraintSet, position: u64) -> |anonymous_scan_constraint|::AnonymousScanConstraint {
        |anonymous_scan_constraint|::AnonymousScanConstraint::clone(&this.scan_constraints[position])
    }
}

public machine ScanConstraintSet::push(this: &mut ScanConstraintSet, constraint: &|anonymous_scan_constraint|::AnonymousScanConstraint) -> bool {
    transition this.count < 4 {
        true -> store(this, constraint)
        false -> (false)
    }
    machine store(this: &mut ScanConstraintSet, constraint: &|anonymous_scan_constraint|::AnonymousScanConstraint) -> bool {
        |anonymous_scan_constraint|::AnonymousScanConstraint::clone_from(&mut this.scan_constraints[this.count], constraint);
        this.count = this.count + 1;
        true
    }
}

// Port of commands/scan/element_scan/element_scan_request.rs.
public data ElementScanRequest {
    scan_constraints: ScanConstraintSet;
    data_type_refs: |snapshot_region|::DataTypeRefSet;
}
