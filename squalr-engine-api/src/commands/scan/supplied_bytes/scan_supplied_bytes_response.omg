module src::commands::scan::supplied_bytes::scan_supplied_bytes_response;

use src::structures::scan_results::scan_results_metadata::ScanResultsMetadata;

// Supplied-bytes scan response — mirrors the scan family's result shape
// (`ElementScanResponse`): the observable success flag plus the scan
// results metadata the executor fills at response time. Upstream's async
// task surface (`trackable_task`/`trackable_task_ref`) lands with the
// cancellation leg; the port's scan runs synchronously inside the executor.
pub data ScanSuppliedBytesResponse {
    success: bool;
    scan_results_metadata: ScanResultsMetadata;
}

pub machine ScanSuppliedBytesResponse::default() -> ScanSuppliedBytesResponse {
    ScanSuppliedBytesResponse {
        success: false,
        scan_results_metadata: ScanResultsMetadata::default(),
    }
}
