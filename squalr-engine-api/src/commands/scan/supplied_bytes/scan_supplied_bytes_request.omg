module src::commands::scan::supplied_bytes::scan_supplied_bytes_request;

use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;
use src::structures::scanning::comparisons::scan_compare_type_relative::ScanCompareTypeRelative;
use src::structures::scanning::constraints::anonymous_scan_constraint::AnonymousScanConstraint;

// Supplied-bytes scan request — a scan over caller-provided byte contents
// rather than live target memory (the captured-bytes milestone: PORTING.md's
// "use captured bytes before live I/O"). Upstream has no dedicated command —
// its byte-source scan flows through `ElementScan` over a live snapshot —
// so this request is the port's api surface for the supplied-memory adapter:
// the byte array to scan plus the value type the bytes are interpreted as.
//
// Upstream keeps growable `Vec<u8>` payloads; the byte domain keeps a
// bounded inline buffer plus a length — the same translation DataValue uses,
// bounded here at 4096 bytes (buffers beyond the bound refuse to store
// rather than truncate — named deviation). `anonymous_scan_constraint`
// carries the search operand (upstream routes the pattern through
// `AnonymousScanConstraint` -> `ScanConstraintBuilder`; a hex-pattern string
// sets `use_hex_pattern_matching`).
pub data ScanSuppliedBytesRequest {
    supplied_bytes: [u8; 4096];
    supplied_bytes_len: u64;
    data_type_ref: DataTypeRef;
    anonymous_scan_constraint: AnonymousScanConstraint;
}

pub machine ScanSuppliedBytesRequest::empty() -> ScanSuppliedBytesRequest {
    ScanSuppliedBytesRequest {
        supplied_bytes_len: 0,
        data_type_ref: DataTypeRef::default(),
        anonymous_scan_constraint: AnonymousScanConstraint::new_no_value(
            ScanCompareType::Relative {
                compare_type: ScanCompareTypeRelative::Unchanged
            }),
    }
}

// Stores the supplied bytes up to the bound; over-long input refuses
// (returns false) rather than truncate — the same contract as
// `DataValue::copy_from_bytes`, since silently dropping bytes would invent
// a shorter region than the caller supplied.
pub machine ScanSuppliedBytesRequest::set_supplied_bytes(&mut self, bytes: &[u8]) -> bool {
    transition bytes.len <= 4096 {
        true -> store(bytes)
        false -> (false)
    }
    state store(&mut self, bytes: &[u8]) -> bool {
        self.supplied_bytes_len = bytes.len;
        transition { _ -> copy(bytes, 0) }
    }
    state copy(&mut self, bytes: &[u8], position: u64) {
        transition position < bytes.len && position < 4096 {
            true -> one(bytes, position)
            false -> (true)
        }
    }
    state one(&mut self, bytes: &[u8], position: u64) -> bool
        requires 0 <= position && position < 4096
    {
        self.supplied_bytes[position] = bytes[position];
        transition { _ -> copy(bytes, position + 1) }
    }
}

pub machine ScanSuppliedBytesRequest::get_supplied_bytes_len(&self) -> u64 {
    self.supplied_bytes_len
}

pub machine ScanSuppliedBytesRequest::get_data_type_ref(&self) -> DataTypeRef {
    DataTypeRef::clone(&self.data_type_ref)
}

pub machine ScanSuppliedBytesRequest::set_data_type_ref(&mut self, data_type_ref: &DataTypeRef) {
    self.data_type_ref = DataTypeRef::clone(data_type_ref);
}

pub machine ScanSuppliedBytesRequest::get_anonymous_scan_constraint(&self) -> AnonymousScanConstraint {
    AnonymousScanConstraint::clone(&self.anonymous_scan_constraint)
}

pub machine ScanSuppliedBytesRequest::set_anonymous_scan_constraint(
    &mut self,
    anonymous_scan_constraint: &AnonymousScanConstraint
) {
    self.anonymous_scan_constraint.clone_from(anonymous_scan_constraint);
}
