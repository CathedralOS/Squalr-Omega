module src::commands::scan::supplied_bytes::scan_supplied_bytes_request;

use src::commands::scan::element_scan::element_scan_request::ScanConstraintSet;
use src::structures::data_types::data_type_ref::DataTypeRef;
use src::structures::scanning::constraints::anonymous_scan_constraint::AnonymousScanConstraint;
use src::structures::snapshots::snapshot_region::DataTypeRefSet;

// Supplied-bytes scan request — a scan over caller-provided byte contents
// rather than live target memory (the captured-bytes milestone: PORTING.md's
// "use captured bytes before live I/O"). Upstream has no dedicated command —
// its byte-source scan flows through `ElementScan` over a live snapshot —
// so this request mirrors upstream `ElementScanRequest` shape: a constraint
// list (`Vec<AnonymousScanConstraint>` upstream, `ScanConstraintSet` here)
// scanned across a data type list (`Vec<DataTypeRef>` -> `DataTypeRefSet`),
// plus the byte array to scan.
//
// Upstream keeps growable `Vec<u8>` payloads; the byte domain keeps a
// bounded inline buffer plus a length — the same translation DataValue uses,
// bounded here at 4096 bytes (buffers beyond the bound refuse to store
// rather than truncate — named deviation). Each anonymous constraint is
// deanonymized per data type upstream of the plan
// (`ScanConstraintBuilder::build`; a hex-pattern string sets
// `use_hex_pattern_matching` on the constraint).
pub data ScanSuppliedBytesRequest {
    supplied_bytes: [u8; 4096];
    supplied_bytes_len: u64;
    scan_constraints: ScanConstraintSet;
    data_type_refs: DataTypeRefSet;
}

pub machine ScanSuppliedBytesRequest::empty() -> ScanSuppliedBytesRequest {
    ScanSuppliedBytesRequest {
        supplied_bytes_len: 0,
        scan_constraints: ScanConstraintSet::empty(),
        data_type_refs: DataTypeRefSet::empty(),
    }
}

// Stores the supplied bytes up to the bound; over-long input refuses
// (returns false) rather than truncate — the same contract as
// `DataValue::copy_from_bytes`, since silently dropping bytes would invent
// a shorter region than the caller supplied.
pub machine ScanSuppliedBytesRequest::set_supplied_bytes(this: &mut ScanSuppliedBytesRequest, bytes: &[u8]) -> bool {
    transition bytes.len <= 4096 {
        true -> store(this, bytes)
        false -> (false)
    }
    state store(this: &mut ScanSuppliedBytesRequest, bytes: &[u8]) -> bool {
        this.supplied_bytes_len = bytes.len;
        transition { _ -> copy(this, bytes, 0) }
    }
    state copy(this: &mut ScanSuppliedBytesRequest, bytes: &[u8], position: u64) {
        transition position < bytes.len && position < 4096 {
            true -> one(this, bytes, position)
            false -> (true)
        }
    }
    state one(this: &mut ScanSuppliedBytesRequest, bytes: &[u8], position: u64) -> bool
        requires 0 <= position && position < 4096
    {
        this.supplied_bytes[position] = bytes[position];
        transition { _ -> copy(this, bytes, position + 1) }
    }
}

pub machine ScanSuppliedBytesRequest::get_supplied_bytes_len(this: &ScanSuppliedBytesRequest) -> u64 {
    this.supplied_bytes_len
}

// The supplied byte span for the executor's seed — guard-then-literal slice,
// the same idiom as the scan plan's pattern carriers.
pub machine ScanSuppliedBytesRequest::get_supplied_bytes(this: &ScanSuppliedBytesRequest) -> &[u8] {
    transition this.supplied_bytes_len <= 4096 {
        true -> (&this.supplied_bytes[0..this.supplied_bytes_len])
        false -> (&this.supplied_bytes[0..0])
        _ -> (&this.supplied_bytes[0..0])
    }
}

pub machine ScanSuppliedBytesRequest::get_scan_constraint_count(this: &ScanSuppliedBytesRequest) -> u64 {
    let hoist1: u64 = ScanConstraintSet::get_count(&this.scan_constraints);
    (hoist1)
}

pub machine ScanSuppliedBytesRequest::get_scan_constraint(
    this: &ScanSuppliedBytesRequest,
    position: u64
) -> AnonymousScanConstraint {
    let hoist2: AnonymousScanConstraint = ScanConstraintSet::get(&this.scan_constraints, position);
    (hoist2)
}

pub machine ScanSuppliedBytesRequest::push_scan_constraint(
    this: &mut ScanSuppliedBytesRequest,
    constraint: &AnonymousScanConstraint
) -> bool {
    let hoist3: bool = ScanConstraintSet::push(&mut this.scan_constraints, constraint);
    (hoist3)
}

pub machine ScanSuppliedBytesRequest::get_data_type_ref_count(this: &ScanSuppliedBytesRequest) -> u64 {
    let hoist4: u64 = DataTypeRefSet::get_count(&this.data_type_refs);
    (hoist4)
}

pub machine ScanSuppliedBytesRequest::get_data_type_ref(
    this: &ScanSuppliedBytesRequest,
    position: u64
) -> DataTypeRef {
    let hoist5: DataTypeRef = DataTypeRefSet::get(&this.data_type_refs, position);
    (hoist5)
}

pub machine ScanSuppliedBytesRequest::push_data_type_ref(
    this: &mut ScanSuppliedBytesRequest,
    data_type_ref: &DataTypeRef
) -> bool {
    let hoist6: bool = DataTypeRefSet::push(&mut this.data_type_refs, data_type_ref);
    (hoist6)
}
