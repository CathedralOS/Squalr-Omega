module src::commands::struct_scan::struct_scan_response;

use src::structures::scan_results::scan_results_metadata::ScanResultsMetadata;

// Port of commands/struct_scan/struct_scan_response.rs: the response
// carries the scan-results statistics pair collected at response time.
// Upstream derives Default — the port's `default` is that impl.
pub data StructScanResponse {
    scan_results_metadata: ScanResultsMetadata;
}

pub machine StructScanResponse::new(
    scan_results_metadata: ScanResultsMetadata
) -> StructScanResponse {
    StructScanResponse { scan_results_metadata: scan_results_metadata }
}

pub machine StructScanResponse::default() -> StructScanResponse {
    StructScanResponse {
        scan_results_metadata: ScanResultsMetadata::default()
    }
}

pub machine StructScanResponse::clone(
    source: &StructScanResponse
) -> StructScanResponse {
    StructScanResponse {
        scan_results_metadata: ScanResultsMetadata::clone(
            &source.scan_results_metadata)
    }
}

pub machine StructScanResponse::get_scan_results_metadata(
    this: &StructScanResponse) -> &ScanResultsMetadata {
    &this.scan_results_metadata
}
