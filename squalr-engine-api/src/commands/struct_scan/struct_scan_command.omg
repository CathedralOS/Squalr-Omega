module src::commands::struct_scan::struct_scan_command;

use src::commands::struct_scan::struct_scan_request::StructScanRequest;

// Port of commands/struct_scan/struct_scan_command.rs: a record wrapper —
// upstream is a struct (not a union), so no case machinery, just the
// carried request.
pub data StructScanCommand {
    struct_scan_request: StructScanRequest;
}

pub machine StructScanCommand::new(
    struct_scan_request: &StructScanRequest
) -> StructScanCommand {
    StructScanCommand {
        struct_scan_request: StructScanRequest::clone(struct_scan_request)
    }
}

pub machine StructScanCommand::get_struct_scan_request(
    struct_scan_command: &StructScanCommand
) -> &StructScanRequest {
    &struct_scan_command.struct_scan_request
}
