module src::commands::struct_scan::struct_scan_request;

use src::structures::data_values::anonymous_value_string::AnonymousValueString;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use src::structures::data_values::container_type::ContainerType;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;

// Port of commands/struct_scan/struct_scan_request.rs: the struct-scan
// request record — an optional anonymous value, the data type id list to
// scan for, and the comparison selector. Upstream `Option` respells to
// `has_scan_value` + a carried value (the package's Option respell);
// `Vec<String>` respells to a bounded list of bounded strings — 8 ids at
// 256 bytes each (named deviation: upstream is unbounded; ids beyond the
// bound are refused rather than truncated).
pub data StructScanDataTypeIdList {
    ids: [[u8; 256]; 8];
    id_lens: [u64; 8];
    count: u64;
}

pub data StructScanRequest {
    has_scan_value: bool;
    scan_value: AnonymousValueString;
    data_type_ids: StructScanDataTypeIdList;
    compare_type: ScanCompareType;
}

pub machine StructScanDataTypeIdList::empty() -> StructScanDataTypeIdList {
    StructScanDataTypeIdList { count: 0 }
}

pub machine StructScanDataTypeIdList::get_count(this: &StructScanDataTypeIdList) -> u64 {
    this.count
}

// Byte-domain read of one stored id; out-of-range reads fall back to the
// head entry (the guard-then-index idiom — callers gate on get_count).
pub machine StructScanDataTypeIdList::get_id(this: &StructScanDataTypeIdList, position: u64) -> &[u8] {
    let hoist2: &[u8] = StructScanDataTypeIdList::head(&this);
    let hoist1: &[u8] = StructScanDataTypeIdList::head(&this);
    transition position < this.count && position < 8 {
        true -> at(this, position)
        false -> (hoist1)
        _ -> (hoist2)
    }
    state at(this: &StructScanDataTypeIdList, position: u64) -> &[u8]
    requires 0 <= position && position < 8;
    {
        let len: u64 = this.id_lens[position];
        transition len <= 256 {
            true -> (&this.ids[position][0..len])
            false -> (&this.ids[position][0..256])
            _ -> (&this.ids[position][0..256])
        }
    }
}

machine StructScanDataTypeIdList::head(this: &StructScanDataTypeIdList) -> &[u8] {
    transition this.id_lens[0] <= 256 {
        true -> (&this.ids[0][0..this.id_lens[0]])
        false -> (&this.ids[0][0..256])
        _ -> (&this.ids[0][0..256])
    }
}

// Upstream `push` on the Vec<String> — copies the bytes, refuses when full
// or when the id exceeds the per-id bound.
pub machine StructScanDataTypeIdList::push(this: &mut StructScanDataTypeIdList, id: &[u8]) -> bool {
    transition this.count < 8 && id.len <= 256 {
        true -> store(this, id)
        false -> (false)
        _ -> (false)
    }
    state store(this: &mut StructScanDataTypeIdList, id: &[u8]) -> bool {
        transition { _ -> copy(this, this.count, id, 0) }
    }
    state copy(this: &mut StructScanDataTypeIdList, position: u64, id: &[u8], at: u64) -> bool
    requires 0 <= position && position < 8;
    {
        transition at < id.len && at < 256 {
            true -> byte(this, position, id, at)
            false -> finish(this, position, at)
            _ -> finish(this, position, at)
        }
    }
    state byte(this: &mut StructScanDataTypeIdList, position: u64, id: &[u8], at: u64) -> bool
    requires 0 <= position && position < 8;
    requires 0 <= at && at < 256;
    {
        this.ids[position][at] = id[at];
        transition { _ -> copy(this, position, id, at + 1) }
    }
    state finish(this: &mut StructScanDataTypeIdList, position: u64, len: u64) -> bool
    requires 0 <= position && position < 8;
    {
        this.id_lens[position] = len;
        this.count = position + 1;
        transition { _ -> (true) }
    }
}

// Upstream's field-init shape: callers construct with the optional value,
// the id list, and the compare type.
pub machine StructScanRequest::new(
    has_scan_value: bool,
    scan_value: &AnonymousValueString,
    data_type_ids: &StructScanDataTypeIdList,
    compare_type: ScanCompareType
) -> StructScanRequest {
    let mut request: StructScanRequest = StructScanRequest {
        has_scan_value: has_scan_value,
        scan_value: AnonymousValueString::new(
            &[], AnonymousValueStringFormat::default(), ContainerType::default()),
        data_type_ids: StructScanDataTypeIdList::empty(),
        compare_type: compare_type
    };
    AnonymousValueString::clone_from(&mut request.scan_value, scan_value);
    StructScanDataTypeIdList::clone_from(&mut request.data_type_ids, data_type_ids);
    request
}

pub machine StructScanDataTypeIdList::clone(
    source: &StructScanDataTypeIdList
) -> StructScanDataTypeIdList {
    let mut list: StructScanDataTypeIdList = StructScanDataTypeIdList::empty();
    StructScanDataTypeIdList::clone_from(&mut list, source);
    list
}

pub machine StructScanDataTypeIdList::clone_from(
    this: &mut StructScanDataTypeIdList,
    source: &StructScanDataTypeIdList
) {
    this.count = source.count;
    transition { _ -> each(this, source, 0) }
    state each(this: &mut StructScanDataTypeIdList, source: &StructScanDataTypeIdList, position: u64) {
        transition position < source.count && position < 8 {
            true -> copy(this, source, position)
            false -> done(this)
            _ -> done(this)
        }
    }
    state copy(this: &mut StructScanDataTypeIdList, source: &StructScanDataTypeIdList, position: u64)
    requires 0 <= position && position < 8;
    {
        this.id_lens[position] = source.id_lens[position];
        transition { _ -> bytes(this, source, position, 0) }
    }
    state bytes(this: &mut StructScanDataTypeIdList, source: &StructScanDataTypeIdList, position: u64, at: u64)
    requires 0 <= position && position < 8;
    {
        transition at < source.id_lens[position] && at < 256 {
            true -> byte(this, source, position, at)
            false -> next(this, source, position)
            _ -> next(this, source, position)
        }
    }
    state byte(this: &mut StructScanDataTypeIdList, source: &StructScanDataTypeIdList, position: u64, at: u64)
    requires 0 <= position && position < 8;
    requires 0 <= at && at < 256;
    {
        this.ids[position][at] = source.ids[position][at];
        transition { _ -> bytes(this, source, position, at + 1) }
    }
    state next(this: &mut StructScanDataTypeIdList, source: &StructScanDataTypeIdList, position: u64) {
        transition { _ -> each(this, source, position + 1) }
    }
    state done(this: &mut StructScanDataTypeIdList) {
    }
}

// Derived `Clone` parity.
pub machine StructScanRequest::clone(source: &StructScanRequest) -> StructScanRequest {
    let mut request: StructScanRequest = StructScanRequest::new(
        source.has_scan_value,
        &source.scan_value,
        &source.data_type_ids,
        source.compare_type);
    request
}

pub machine StructScanRequest::get_has_scan_value(this: &StructScanRequest) -> bool {
    this.has_scan_value
}

pub machine StructScanRequest::get_scan_value(this: &StructScanRequest) -> &AnonymousValueString {
    &this.scan_value
}

pub machine StructScanRequest::get_data_type_ids(this: &StructScanRequest) -> &StructScanDataTypeIdList {
    &this.data_type_ids
}

pub machine StructScanRequest::get_compare_type(this: &StructScanRequest) -> ScanCompareType {
    this.compare_type
}
