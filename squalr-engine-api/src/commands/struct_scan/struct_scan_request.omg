module src::commands::struct_scan::struct_scan_request;

use src::structures::data_values::anonymous_value_string::AnonymousValueString;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use src::structures::data_values::container_type::ContainerType;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;

// Port of commands/struct_scan/struct_scan_request.rs: the struct-scan
// request record — an optional anonymous value, the data type id list to
// scan for, and the comparison selector. Upstream `Option` respells to
// `has_scan_value` + a carried value (the package's Option respell);
// `Vec<String>` respells to a bounded list of bounded strings — 8 ids at
// 256 bytes each (named deviation: upstream is unbounded; ids beyond the
// bound are refused rather than truncated).
pub data StructScanDataTypeIdList {
    ids: [[u8; 256]; 8];
    id_lens: [u64; 8];
    count: u64;
}

pub data StructScanRequest {
    has_scan_value: bool;
    scan_value: AnonymousValueString;
    data_type_ids: StructScanDataTypeIdList;
    compare_type: ScanCompareType;
}

pub machine StructScanDataTypeIdList::empty() -> StructScanDataTypeIdList {
    StructScanDataTypeIdList { count: 0 }
}

pub machine StructScanDataTypeIdList::get_count(&self) -> u64 {
    self.count
}

// Byte-domain read of one stored id; out-of-range reads fall back to the
// head entry (the guard-then-index idiom — callers gate on get_count).
pub machine StructScanDataTypeIdList::get_id(&self, position: u64) -> &[u8] {
    transition position < self.count && position < 8 {
        true -> at(position)
        false -> (self.head())
        _ -> (self.head())
    }
    state at(&self, position: u64) -> &[u8]
    requires 0 <= position && position < 8;
    {
        let len: u64 = self.id_lens[position];
        transition len <= 256 {
            true -> (&self.ids[position][0..len])
            false -> (&self.ids[position][0..256])
            _ -> (&self.ids[position][0..256])
        }
    }
}

machine StructScanDataTypeIdList::head(&self) -> &[u8] {
    transition self.id_lens[0] <= 256 {
        true -> (&self.ids[0][0..self.id_lens[0]])
        false -> (&self.ids[0][0..256])
        _ -> (&self.ids[0][0..256])
    }
}

// Upstream `push` on the Vec<String> — copies the bytes, refuses when full
// or when the id exceeds the per-id bound.
pub machine StructScanDataTypeIdList::push(&mut self, id: &[u8]) -> bool {
    transition self.count < 8 && id.len <= 256 {
        true -> store(id)
        false -> (false)
        _ -> (false)
    }
    state store(&mut self, id: &[u8]) -> bool {
        transition { _ -> copy(self.count, id, 0) }
    }
    state copy(&mut self, position: u64, id: &[u8], at: u64) -> bool
    requires 0 <= position && position < 8;
    {
        transition at < id.len && at < 256 {
            true -> byte(position, id, at)
            false -> finish(position, at)
            _ -> finish(position, at)
        }
    }
    state byte(&mut self, position: u64, id: &[u8], at: u64) -> bool
    requires 0 <= position && position < 8;
    requires 0 <= at && at < 256;
    {
        self.ids[position][at] = id[at];
        transition { _ -> copy(position, id, at + 1) }
    }
    state finish(&mut self, position: u64, len: u64) -> bool
    requires 0 <= position && position < 8;
    {
        self.id_lens[position] = len;
        self.count = position + 1;
        transition { _ -> (true) }
    }
}

// Upstream's field-init shape: callers construct with the optional value,
// the id list, and the compare type.
pub machine StructScanRequest::new(
    has_scan_value: bool,
    scan_value: &AnonymousValueString,
    data_type_ids: &StructScanDataTypeIdList,
    compare_type: ScanCompareType
) -> StructScanRequest {
    let mut request: StructScanRequest = StructScanRequest {
        has_scan_value: has_scan_value,
        scan_value: AnonymousValueString::new(
            &[], AnonymousValueStringFormat::default(), ContainerType::default()),
        data_type_ids: StructScanDataTypeIdList::empty(),
        compare_type: compare_type
    };
    request.scan_value.clone_from(scan_value);
    request.data_type_ids.clone_from(data_type_ids);
    request
}

pub machine StructScanDataTypeIdList::clone(
    source: &StructScanDataTypeIdList
) -> StructScanDataTypeIdList {
    let mut list: StructScanDataTypeIdList = StructScanDataTypeIdList::empty();
    list.clone_from(source);
    list
}

pub machine StructScanDataTypeIdList::clone_from(
    &mut self,
    source: &StructScanDataTypeIdList
) {
    self.count = source.count;
    transition { _ -> each(source, 0) }
    state each(&mut self, source: &StructScanDataTypeIdList, position: u64) {
        transition position < source.count && position < 8 {
            true -> copy(source, position)
            false -> done()
            _ -> done()
        }
    }
    state copy(&mut self, source: &StructScanDataTypeIdList, position: u64)
    requires 0 <= position && position < 8;
    {
        self.id_lens[position] = source.id_lens[position];
        transition { _ -> bytes(source, position, 0) }
    }
    state bytes(&mut self, source: &StructScanDataTypeIdList, position: u64, at: u64)
    requires 0 <= position && position < 8;
    {
        transition at < source.id_lens[position] && at < 256 {
            true -> byte(source, position, at)
            false -> next(source, position)
            _ -> next(source, position)
        }
    }
    state byte(&mut self, source: &StructScanDataTypeIdList, position: u64, at: u64)
    requires 0 <= position && position < 8;
    requires 0 <= at && at < 256;
    {
        self.ids[position][at] = source.ids[position][at];
        transition { _ -> bytes(source, position, at + 1) }
    }
    state next(&mut self, source: &StructScanDataTypeIdList, position: u64) {
        transition { _ -> each(source, position + 1) }
    }
    state done(&mut self) {
    }
}

// Derived `Clone` parity.
pub machine StructScanRequest::clone(source: &StructScanRequest) -> StructScanRequest {
    let mut request: StructScanRequest = StructScanRequest::new(
        source.has_scan_value,
        &source.scan_value,
        &source.data_type_ids,
        source.compare_type);
    request
}

pub machine StructScanRequest::get_has_scan_value(&self) -> bool {
    self.has_scan_value
}

pub machine StructScanRequest::get_scan_value(&self) -> &AnonymousValueString {
    &self.scan_value
}

pub machine StructScanRequest::get_data_type_ids(&self) -> &StructScanDataTypeIdList {
    &self.data_type_ids
}

pub machine StructScanRequest::get_compare_type(&self) -> ScanCompareType {
    self.compare_type
}
