module src::commands::struct_scan::struct_scan_request;

use src::structures::data_values::anonymous_value_string::AnonymousValueString;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use src::structures::data_values::container_type::ContainerType;
use src::structures::scanning::comparisons::scan_compare_type::ScanCompareType;

// Port of commands/struct_scan/struct_scan_request.rs: the struct-scan
// request record — an optional anonymous value, the data type id list to
// scan for, and the comparison selector. Upstream `Option` respells to
// `has_scan_value` + a carried value (the package's Option respell);
// `Vec<String>` respells to a bounded list of bounded strings — 8 ids at
// 256 bytes each (named deviation: upstream is unbounded; ids beyond the
// bound are refused rather than truncated).
pub data StructScanDataTypeIdList {
    ids: [[u8; 256]; 8];
    id_lens: [u64; 8];
    count: u64;
}

pub data StructScanRequest {
    has_scan_value: bool;
    scan_value: AnonymousValueString;
    data_type_ids: StructScanDataTypeIdList;
    compare_type: ScanCompareType;
}

pub machine StructScanDataTypeIdList::empty() -> StructScanDataTypeIdList {
    StructScanDataTypeIdList { count: 0 }
}

pub machine StructScanDataTypeIdList::get_count(struct_scan_data_type_id_list: &StructScanDataTypeIdList) -> u64 {
    struct_scan_data_type_id_list.count
}

// Byte-domain read of one stored id; out-of-range reads fall back to the
// head entry (the guard-then-index idiom — callers gate on get_count).
pub machine StructScanDataTypeIdList::get_id(struct_scan_data_type_id_list: &StructScanDataTypeIdList, position: u64) -> &[u8] {
    transition position < struct_scan_data_type_id_list.count && position < 8 {
        true -> at(struct_scan_data_type_id_list, position)
        false -> (StructScanDataTypeIdList::head(struct_scan_data_type_id_list))
        _ -> (StructScanDataTypeIdList::head(struct_scan_data_type_id_list))
    }
    state at(struct_scan_data_type_id_list: &StructScanDataTypeIdList, position: u64) -> &[u8]
    requires 0 <= position && position < 8;
    {
        let len: u64 = struct_scan_data_type_id_list.id_lens[position];
        transition len <= 256 {
            true -> (&struct_scan_data_type_id_list.ids[position][0..len])
            false -> (&struct_scan_data_type_id_list.ids[position][0..256])
            _ -> (&struct_scan_data_type_id_list.ids[position][0..256])
        }
    }
}

machine StructScanDataTypeIdList::head(struct_scan_data_type_id_list: &StructScanDataTypeIdList) -> &[u8] {
    transition struct_scan_data_type_id_list.id_lens[0] <= 256 {
        true -> (&struct_scan_data_type_id_list.ids[0][0..struct_scan_data_type_id_list.id_lens[0]])
        false -> (&struct_scan_data_type_id_list.ids[0][0..256])
        _ -> (&struct_scan_data_type_id_list.ids[0][0..256])
    }
}

// Upstream `push` on the Vec<String> — copies the bytes, refuses when full
// or when the id exceeds the per-id bound.
pub machine StructScanDataTypeIdList::push(struct_scan_data_type_id_list: &mut StructScanDataTypeIdList, id: &[u8]) -> bool {
    transition struct_scan_data_type_id_list.count < 8 && id.len <= 256 {
        true -> store(struct_scan_data_type_id_list, id)
        false -> (false)
        _ -> (false)
    }
    state store(struct_scan_data_type_id_list: &mut StructScanDataTypeIdList, id: &[u8]) -> bool {
        transition { _ -> copy(struct_scan_data_type_id_list, struct_scan_data_type_id_list.count, id, 0) }
    }
    state copy(struct_scan_data_type_id_list: &mut StructScanDataTypeIdList, position: u64, id: &[u8], at: u64) -> bool
    requires 0 <= position && position < 8;
    {
        transition at < id.len && at < 256 {
            true -> byte(struct_scan_data_type_id_list, position, id, at)
            false -> finish(struct_scan_data_type_id_list, position, at)
            _ -> finish(struct_scan_data_type_id_list, position, at)
        }
    }
    state byte(struct_scan_data_type_id_list: &mut StructScanDataTypeIdList, position: u64, id: &[u8], at: u64) -> bool
    requires 0 <= position && position < 8;
    requires 0 <= at && at < 256;
    {
        struct_scan_data_type_id_list.ids[position][at] = id[at];
        transition { _ -> copy(struct_scan_data_type_id_list, position, id, at + 1) }
    }
    state finish(struct_scan_data_type_id_list: &mut StructScanDataTypeIdList, position: u64, len: u64) -> bool
    requires 0 <= position && position < 8;
    {
        struct_scan_data_type_id_list.id_lens[position] = len;
        struct_scan_data_type_id_list.count = position + 1;
        transition { _ -> (true) }
    }
}

// Upstream's field-init shape: callers construct with the optional value,
// the id list, and the compare type.
pub machine StructScanRequest::new(
    has_scan_value: bool,
    scan_value: &AnonymousValueString,
    data_type_ids: &StructScanDataTypeIdList,
    compare_type: ScanCompareType
) -> StructScanRequest {
    let mut request: StructScanRequest = StructScanRequest {
        has_scan_value: has_scan_value,
        scan_value: AnonymousValueString::new(
            &[], AnonymousValueStringFormat::default(), ContainerType::default()),
        data_type_ids: StructScanDataTypeIdList::empty(),
        compare_type: compare_type
    };
    AnonymousValueString::clone_from(&mut request.scan_value, scan_value);
    StructScanDataTypeIdList::clone_from(&mut request.data_type_ids, data_type_ids);
    request
}

pub machine StructScanDataTypeIdList::clone(
    source: &StructScanDataTypeIdList
) -> StructScanDataTypeIdList {
    let mut list: StructScanDataTypeIdList = StructScanDataTypeIdList::empty();
    StructScanDataTypeIdList::clone_from(&mut list, source);
    list
}

pub machine StructScanDataTypeIdList::clone_from(
    struct_scan_data_type_id_list: &mut StructScanDataTypeIdList,
    source: &StructScanDataTypeIdList
) {
    struct_scan_data_type_id_list.count = source.count;
    transition { _ -> each(struct_scan_data_type_id_list, source, 0) }
    state each(struct_scan_data_type_id_list: &mut StructScanDataTypeIdList, source: &StructScanDataTypeIdList, position: u64) {
        transition position < source.count && position < 8 {
            true -> copy(struct_scan_data_type_id_list, source, position)
            false -> done(struct_scan_data_type_id_list)
            _ -> done(struct_scan_data_type_id_list)
        }
    }
    state copy(struct_scan_data_type_id_list: &mut StructScanDataTypeIdList, source: &StructScanDataTypeIdList, position: u64)
    requires 0 <= position && position < 8;
    {
        struct_scan_data_type_id_list.id_lens[position] = source.id_lens[position];
        transition { _ -> bytes(struct_scan_data_type_id_list, source, position, 0) }
    }
    state bytes(struct_scan_data_type_id_list: &mut StructScanDataTypeIdList, source: &StructScanDataTypeIdList, position: u64, at: u64)
    requires 0 <= position && position < 8;
    {
        transition at < source.id_lens[position] && at < 256 {
            true -> byte(struct_scan_data_type_id_list, source, position, at)
            false -> next(struct_scan_data_type_id_list, source, position)
            _ -> next(struct_scan_data_type_id_list, source, position)
        }
    }
    state byte(struct_scan_data_type_id_list: &mut StructScanDataTypeIdList, source: &StructScanDataTypeIdList, position: u64, at: u64)
    requires 0 <= position && position < 8;
    requires 0 <= at && at < 256;
    {
        struct_scan_data_type_id_list.ids[position][at] = source.ids[position][at];
        transition { _ -> bytes(struct_scan_data_type_id_list, source, position, at + 1) }
    }
    state next(struct_scan_data_type_id_list: &mut StructScanDataTypeIdList, source: &StructScanDataTypeIdList, position: u64) {
        transition { _ -> each(struct_scan_data_type_id_list, source, position + 1) }
    }
    state done(struct_scan_data_type_id_list: &mut StructScanDataTypeIdList) {
    }
}

// Derived `Clone` parity.
pub machine StructScanRequest::clone(source: &StructScanRequest) -> StructScanRequest {
    let mut request: StructScanRequest = StructScanRequest::new(
        source.has_scan_value,
        &source.scan_value,
        &source.data_type_ids,
        source.compare_type);
    request
}

pub machine StructScanRequest::get_has_scan_value(struct_scan_request: &StructScanRequest) -> bool {
    struct_scan_request.has_scan_value
}

pub machine StructScanRequest::get_scan_value(struct_scan_request: &StructScanRequest) -> &AnonymousValueString {
    &struct_scan_request.scan_value
}

pub machine StructScanRequest::get_data_type_ids(struct_scan_request: &StructScanRequest) -> &StructScanDataTypeIdList {
    &struct_scan_request.data_type_ids
}

pub machine StructScanRequest::get_compare_type(struct_scan_request: &StructScanRequest) -> ScanCompareType {
    struct_scan_request.compare_type
}
