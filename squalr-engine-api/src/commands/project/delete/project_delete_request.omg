module src::commands::project::delete::project_delete_request;

// Port of commands/project/delete/project_delete_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectDeleteRequest {
    has_project_directory_path: bool;
    project_directory_path: [u8; 512];
    project_directory_path_len: u64;
    has_project_name: bool;
    project_name: [u8; 256];
    project_name_len: u64;
}

pub machine ProjectDeleteRequest::new() -> ProjectDeleteRequest {
    ProjectDeleteRequest {
        has_project_directory_path: false,
        project_directory_path_len: 0,
        has_project_name: false,
        project_name_len: 0,
    }
}

pub machine ProjectDeleteRequest::default() -> ProjectDeleteRequest {
    ProjectDeleteRequest::new()
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectDeleteRequest::has_project_directory_path(project_delete_request: &ProjectDeleteRequest) -> bool {
    project_delete_request.has_project_directory_path
}

pub machine ProjectDeleteRequest::get_project_directory_path(project_delete_request: &ProjectDeleteRequest) -> &[u8] {
    transition project_delete_request.project_directory_path_len <= 512 {
        true -> (&project_delete_request.project_directory_path[0..project_delete_request.project_directory_path_len])
        false -> (&project_delete_request.project_directory_path[0..512])
        _ -> (&project_delete_request.project_directory_path[0..512])
    }
}

pub machine ProjectDeleteRequest::set_project_directory_path(project_delete_request: &mut ProjectDeleteRequest, project_directory_path: &[u8]) {
    project_delete_request.has_project_directory_path = true;
    project_delete_request.project_directory_path_len = 0;
    transition {
        _ -> copy_project_directory_path(project_delete_request, project_directory_path, 0)
    }
    state copy_project_directory_path(project_delete_request: &mut ProjectDeleteRequest, project_directory_path: &[u8], position: u64) {
        transition position < project_directory_path.len && position < 512 {
            true -> store_project_directory_path(project_delete_request, project_directory_path, position)
            false -> finish_project_directory_path(project_delete_request, position)
        }
    }
    state store_project_directory_path(project_delete_request: &mut ProjectDeleteRequest, project_directory_path: &[u8], position: u64) {
        project_delete_request.project_directory_path[position] = project_directory_path[position];
        transition {
            _ -> copy_project_directory_path(project_delete_request, project_directory_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_directory_path(project_delete_request: &mut ProjectDeleteRequest, count: u64) {
        project_delete_request.project_directory_path_len = count;
    }
}

pub machine ProjectDeleteRequest::clear_project_directory_path(project_delete_request: &mut ProjectDeleteRequest) {
    project_delete_request.has_project_directory_path = false;
    project_delete_request.project_directory_path_len = 0;
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectDeleteRequest::has_project_name(project_delete_request: &ProjectDeleteRequest) -> bool {
    project_delete_request.has_project_name
}

pub machine ProjectDeleteRequest::get_project_name(project_delete_request: &ProjectDeleteRequest) -> &[u8] {
    transition project_delete_request.project_name_len <= 256 {
        true -> (&project_delete_request.project_name[0..project_delete_request.project_name_len])
        false -> (&project_delete_request.project_name[0..256])
        _ -> (&project_delete_request.project_name[0..256])
    }
}

pub machine ProjectDeleteRequest::set_project_name(project_delete_request: &mut ProjectDeleteRequest, project_name: &[u8]) {
    project_delete_request.has_project_name = true;
    project_delete_request.project_name_len = 0;
    transition {
        _ -> copy_project_name(project_delete_request, project_name, 0)
    }
    state copy_project_name(project_delete_request: &mut ProjectDeleteRequest, project_name: &[u8], position: u64) {
        transition position < project_name.len && position < 256 {
            true -> store_project_name(project_delete_request, project_name, position)
            false -> finish_project_name(project_delete_request, position)
        }
    }
    state store_project_name(project_delete_request: &mut ProjectDeleteRequest, project_name: &[u8], position: u64) {
        project_delete_request.project_name[position] = project_name[position];
        transition {
            _ -> copy_project_name(project_delete_request, project_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_name(project_delete_request: &mut ProjectDeleteRequest, count: u64) {
        project_delete_request.project_name_len = count;
    }
}

pub machine ProjectDeleteRequest::clear_project_name(project_delete_request: &mut ProjectDeleteRequest) {
    project_delete_request.has_project_name = false;
    project_delete_request.project_name_len = 0;
}
