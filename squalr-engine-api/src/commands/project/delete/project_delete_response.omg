module src::commands::project::delete::project_delete_response;

// Port of commands/project/delete/project_delete_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectDeleteResponse {
    success: bool;
}

pub machine ProjectDeleteResponse::new() -> ProjectDeleteResponse {
    ProjectDeleteResponse {
        success: false,
    }
}

pub machine ProjectDeleteResponse::default() -> ProjectDeleteResponse {
    ProjectDeleteResponse::new()
}

pub machine ProjectDeleteResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectDeleteResponse::set_success(&mut self, success: bool) {
    self.success = success;
}
