module src::commands::project::project_command;

use src::commands::project::close::project_close_request::ProjectCloseRequest;
use src::commands::project::create::project_create_request::ProjectCreateRequest;
use src::commands::project::delete::project_delete_request::ProjectDeleteRequest;
use src::commands::project::export::project_export_request::ProjectExportRequest;
use src::commands::project::list::project_list_request::ProjectListRequest;
use src::commands::project::open::project_open_request::ProjectOpenRequest;
use src::commands::project::rename::project_rename_request::ProjectRenameRequest;
use src::commands::project::save::project_save_request::ProjectSaveRequest;

// Port of commands/project/project_command.rs — the upstream leaf enum
// respelled as a cased union; payloads keep upstream's leaf field naming.
pub data ProjectCommand {
    case Close(request: ProjectCloseRequest);
    case Create(request: ProjectCreateRequest);
    case Delete(request: ProjectDeleteRequest);
    case Export(request: ProjectExportRequest);
    case List(request: ProjectListRequest);
    case Open(request: ProjectOpenRequest);
    case Rename(request: ProjectRenameRequest);
    case Save(request: ProjectSaveRequest);
}
