use src/commands/project/close/project_close_request.omg;
use src/commands/project/create/project_create_request.omg;
use src/commands/project/delete/project_delete_request.omg;
use src/commands/project/export/project_export_request.omg;
use src/commands/project/list/project_list_request.omg;
use src/commands/project/open/project_open_request.omg;
use src/commands/project/rename/project_rename_request.omg;
use src/commands/project/save/project_save_request.omg;

// Port of commands/project/project_command.rs — the upstream leaf enum
// respelled as a cased union; payloads keep upstream's leaf field naming.
public data ProjectCommand {
    case Close(request: |project_close_request|::ProjectCloseRequest);
    case Create(request: |project_create_request|::ProjectCreateRequest);
    case Delete(request: |project_delete_request|::ProjectDeleteRequest);
    case Export(request: |project_export_request|::ProjectExportRequest);
    case List(request: |project_list_request|::ProjectListRequest);
    case Open(request: |project_open_request|::ProjectOpenRequest);
    case Rename(request: |project_rename_request|::ProjectRenameRequest);
    case Save(request: |project_save_request|::ProjectSaveRequest);
}
