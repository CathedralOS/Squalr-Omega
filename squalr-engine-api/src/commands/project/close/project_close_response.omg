module src::commands::project::close::project_close_response;

// Port of commands/project/close/project_close_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectCloseResponse {
    success: bool;
}

pub machine ProjectCloseResponse::new() -> ProjectCloseResponse {
    ProjectCloseResponse {
        success: false,
    }
}

pub machine ProjectCloseResponse::default() -> ProjectCloseResponse {
    ProjectCloseResponse::new()
}

pub machine ProjectCloseResponse::get_success(project_close_response: &ProjectCloseResponse) -> bool {
    project_close_response.success
}

pub machine ProjectCloseResponse::set_success(project_close_response: &mut ProjectCloseResponse, success: bool) {
    project_close_response.success = success;
}
