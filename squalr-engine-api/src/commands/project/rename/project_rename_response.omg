module src::commands::project::rename::project_rename_response;

// Port of commands/project/rename/project_rename_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectRenameResponse {
    success: bool;
    new_project_path: [u8; 512];
    new_project_path_len: u64;
}

pub machine ProjectRenameResponse::new() -> ProjectRenameResponse {
    ProjectRenameResponse {
        success: false,
        new_project_path_len: 0,
    }
}

pub machine ProjectRenameResponse::default() -> ProjectRenameResponse {
    ProjectRenameResponse::new()
}

pub machine ProjectRenameResponse::get_success(this: &ProjectRenameResponse) -> bool {
    this.success
}

pub machine ProjectRenameResponse::set_success(this: &mut ProjectRenameResponse, success: bool) {
    this.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectRenameResponse::get_new_project_path(this: &ProjectRenameResponse) -> &[u8] {
    transition this.new_project_path_len <= 512 {
        true -> (&this.new_project_path[0..this.new_project_path_len])
        false -> (&this.new_project_path[0..512])
        _ -> (&this.new_project_path[0..512])
    }
}

pub machine ProjectRenameResponse::set_new_project_path(this: &mut ProjectRenameResponse, new_project_path: &[u8]) {
    this.new_project_path_len = 0;
    transition {
        _ -> copy_new_project_path(this, new_project_path, 0)
    }
    state copy_new_project_path(this: &mut ProjectRenameResponse, new_project_path: &[u8], position: u64) {
        transition position < new_project_path.len && position < 512 {
            true -> store_new_project_path(this, new_project_path, position)
            false -> finish_new_project_path(this, position)
        }
    }
    state store_new_project_path(this: &mut ProjectRenameResponse, new_project_path: &[u8], position: u64) {
        this.new_project_path[position] = new_project_path[position];
        transition {
            _ -> copy_new_project_path(this, new_project_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_new_project_path(this: &mut ProjectRenameResponse, count: u64) {
        this.new_project_path_len = count;
    }
}
