module src::commands::project::rename::project_rename_response;

use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project/rename/project_rename_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectRenameResponse {
    success: bool;
    new_project_path: [u8; 512];
    new_project_path_len: u64;
}

pub machine ProjectRenameResponse::new() -> ProjectRenameResponse {
    ProjectRenameResponse {
        success: false,
        new_project_path_len: 0,
    }
}

pub machine ProjectRenameResponse::default() -> ProjectRenameResponse {
    ProjectRenameResponse::new()
}

pub machine ProjectRenameResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectRenameResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectRenameResponse::get_new_project_path(&self) -> &[u8] {
    bounded_slice(&self.new_project_path[0..512], self.new_project_path_len)
}

pub machine ProjectRenameResponse::set_new_project_path(&mut self, new_project_path: &[u8]) {
    self.new_project_path_len = BoundedByteCopy::copy(&mut self.new_project_path[0..512], new_project_path);
}
