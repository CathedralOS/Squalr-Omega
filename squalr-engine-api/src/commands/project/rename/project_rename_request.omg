module src::commands::project::rename::project_rename_request;

// Port of commands/project/rename/project_rename_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectRenameRequest {
    project_directory_path: [u8; 512];
    project_directory_path_len: u64;
    new_project_name: [u8; 256];
    new_project_name_len: u64;
}

pub machine ProjectRenameRequest::new() -> ProjectRenameRequest {
    ProjectRenameRequest {
        project_directory_path_len: 0,
        new_project_name_len: 0,
    }
}

pub machine ProjectRenameRequest::default() -> ProjectRenameRequest {
    ProjectRenameRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectRenameRequest::get_project_directory_path(this: &ProjectRenameRequest) -> &[u8] {
    transition this.project_directory_path_len <= 512 {
        true -> (&this.project_directory_path[0..this.project_directory_path_len])
        false -> (&this.project_directory_path[0..512])
        _ -> (&this.project_directory_path[0..512])
    }
}

pub machine ProjectRenameRequest::set_project_directory_path(this: &mut ProjectRenameRequest, project_directory_path: &[u8]) {
    this.project_directory_path_len = 0;
    transition {
        _ -> copy_project_directory_path(this, project_directory_path, 0)
    }
    state copy_project_directory_path(this: &mut ProjectRenameRequest, project_directory_path: &[u8], position: u64) {
        transition position < project_directory_path.len && position < 512 {
            true -> store_project_directory_path(this, project_directory_path, position)
            false -> finish_project_directory_path(this, position)
        }
    }
    state store_project_directory_path(this: &mut ProjectRenameRequest, project_directory_path: &[u8], position: u64) {
        this.project_directory_path[position] = project_directory_path[position];
        transition {
            _ -> copy_project_directory_path(this, project_directory_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_directory_path(this: &mut ProjectRenameRequest, count: u64) {
        this.project_directory_path_len = count;
    }
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectRenameRequest::get_new_project_name(this: &ProjectRenameRequest) -> &[u8] {
    transition this.new_project_name_len <= 256 {
        true -> (&this.new_project_name[0..this.new_project_name_len])
        false -> (&this.new_project_name[0..256])
        _ -> (&this.new_project_name[0..256])
    }
}

pub machine ProjectRenameRequest::set_new_project_name(this: &mut ProjectRenameRequest, new_project_name: &[u8]) {
    this.new_project_name_len = 0;
    transition {
        _ -> copy_new_project_name(this, new_project_name, 0)
    }
    state copy_new_project_name(this: &mut ProjectRenameRequest, new_project_name: &[u8], position: u64) {
        transition position < new_project_name.len && position < 256 {
            true -> store_new_project_name(this, new_project_name, position)
            false -> finish_new_project_name(this, position)
        }
    }
    state store_new_project_name(this: &mut ProjectRenameRequest, new_project_name: &[u8], position: u64) {
        this.new_project_name[position] = new_project_name[position];
        transition {
            _ -> copy_new_project_name(this, new_project_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_new_project_name(this: &mut ProjectRenameRequest, count: u64) {
        this.new_project_name_len = count;
    }
}
