module src::commands::project::rename::project_rename_request;

use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project/rename/project_rename_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectRenameRequest {
    project_directory_path: [u8; 512];
    project_directory_path_len: u64;
    new_project_name: [u8; 256];
    new_project_name_len: u64;
}

pub machine ProjectRenameRequest::new() -> ProjectRenameRequest {
    ProjectRenameRequest {
        project_directory_path_len: 0,
        new_project_name_len: 0,
    }
}

pub machine ProjectRenameRequest::default() -> ProjectRenameRequest {
    ProjectRenameRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectRenameRequest::get_project_directory_path(&self) -> &[u8] {
    bounded_slice(&self.project_directory_path[0..512], self.project_directory_path_len)
}

pub machine ProjectRenameRequest::set_project_directory_path(&mut self, project_directory_path: &[u8]) {
    self.project_directory_path_len = BoundedByteCopy::copy(&mut self.project_directory_path[0..512], project_directory_path);
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectRenameRequest::get_new_project_name(&self) -> &[u8] {
    bounded_slice(&self.new_project_name[0..256], self.new_project_name_len)
}

pub machine ProjectRenameRequest::set_new_project_name(&mut self, new_project_name: &[u8]) {
    self.new_project_name_len = BoundedByteCopy::copy(&mut self.new_project_name[0..256], new_project_name);
}
