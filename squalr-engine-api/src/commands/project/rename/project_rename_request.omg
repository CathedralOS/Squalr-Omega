module src::commands::project::rename::project_rename_request;

// Port of commands/project/rename/project_rename_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectRenameRequest {
    project_directory_path: [u8; 512];
    project_directory_path_len: u64;
    new_project_name: [u8; 256];
    new_project_name_len: u64;
}

pub machine ProjectRenameRequest::new() -> ProjectRenameRequest {
    ProjectRenameRequest {
        project_directory_path_len: 0,
        new_project_name_len: 0,
    }
}

pub machine ProjectRenameRequest::default() -> ProjectRenameRequest {
    ProjectRenameRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectRenameRequest::get_project_directory_path(project_rename_request: &ProjectRenameRequest) -> &[u8] {
    transition project_rename_request.project_directory_path_len <= 512 {
        true -> (&project_rename_request.project_directory_path[0..project_rename_request.project_directory_path_len])
        false -> (&project_rename_request.project_directory_path[0..512])
        _ -> (&project_rename_request.project_directory_path[0..512])
    }
}

pub machine ProjectRenameRequest::set_project_directory_path(project_rename_request: &mut ProjectRenameRequest, project_directory_path: &[u8]) {
    project_rename_request.project_directory_path_len = 0;
    transition {
        _ -> copy_project_directory_path(project_rename_request, project_directory_path, 0)
    }
    state copy_project_directory_path(project_rename_request: &mut ProjectRenameRequest, project_directory_path: &[u8], position: u64) {
        transition position < project_directory_path.len && position < 512 {
            true -> store_project_directory_path(project_rename_request, project_directory_path, position)
            false -> finish_project_directory_path(project_rename_request, position)
        }
    }
    state store_project_directory_path(project_rename_request: &mut ProjectRenameRequest, project_directory_path: &[u8], position: u64) {
        project_rename_request.project_directory_path[position] = project_directory_path[position];
        transition {
            _ -> copy_project_directory_path(project_rename_request, project_directory_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_directory_path(project_rename_request: &mut ProjectRenameRequest, count: u64) {
        project_rename_request.project_directory_path_len = count;
    }
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectRenameRequest::get_new_project_name(project_rename_request: &ProjectRenameRequest) -> &[u8] {
    transition project_rename_request.new_project_name_len <= 256 {
        true -> (&project_rename_request.new_project_name[0..project_rename_request.new_project_name_len])
        false -> (&project_rename_request.new_project_name[0..256])
        _ -> (&project_rename_request.new_project_name[0..256])
    }
}

pub machine ProjectRenameRequest::set_new_project_name(project_rename_request: &mut ProjectRenameRequest, new_project_name: &[u8]) {
    project_rename_request.new_project_name_len = 0;
    transition {
        _ -> copy_new_project_name(project_rename_request, new_project_name, 0)
    }
    state copy_new_project_name(project_rename_request: &mut ProjectRenameRequest, new_project_name: &[u8], position: u64) {
        transition position < new_project_name.len && position < 256 {
            true -> store_new_project_name(project_rename_request, new_project_name, position)
            false -> finish_new_project_name(project_rename_request, position)
        }
    }
    state store_new_project_name(project_rename_request: &mut ProjectRenameRequest, new_project_name: &[u8], position: u64) {
        project_rename_request.new_project_name[position] = new_project_name[position];
        transition {
            _ -> copy_new_project_name(project_rename_request, new_project_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_new_project_name(project_rename_request: &mut ProjectRenameRequest, count: u64) {
        project_rename_request.new_project_name_len = count;
    }
}
