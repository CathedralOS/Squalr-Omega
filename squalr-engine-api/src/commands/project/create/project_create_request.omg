module src::commands::project::create::project_create_request;

// Port of commands/project/create/project_create_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectCreateRequest {
    has_project_directory_path: bool;
    project_directory_path: [u8; 512];
    project_directory_path_len: u64;
    has_project_name: bool;
    project_name: [u8; 256];
    project_name_len: u64;
}

pub machine ProjectCreateRequest::new() -> ProjectCreateRequest {
    ProjectCreateRequest {
        has_project_directory_path: false,
        project_directory_path_len: 0,
        has_project_name: false,
        project_name_len: 0,
    }
}

pub machine ProjectCreateRequest::default() -> ProjectCreateRequest {
    ProjectCreateRequest::new()
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectCreateRequest::has_project_directory_path(&self) -> bool {
    self.has_project_directory_path
}

pub machine ProjectCreateRequest::get_project_directory_path(&self) -> &[u8] {
    transition self.project_directory_path_len <= 512 {
        true -> (&self.project_directory_path[0..self.project_directory_path_len])
        false -> (&self.project_directory_path[0..512])
        _ -> (&self.project_directory_path[0..512])
    }
}

pub machine ProjectCreateRequest::set_project_directory_path(&mut self, project_directory_path: &[u8]) {
    self.has_project_directory_path = true;
    self.project_directory_path_len = 0;
    transition {
        _ -> copy_project_directory_path(project_directory_path, 0)
    }
    state copy_project_directory_path(&mut self, project_directory_path: &[u8], position: u64) {
        transition position < project_directory_path.len && position < 512 {
            true -> store_project_directory_path(project_directory_path, position)
            false -> finish_project_directory_path(position)
        }
    }
    state store_project_directory_path(&mut self, project_directory_path: &[u8], position: u64) {
        self.project_directory_path[position] = project_directory_path[position];
        transition {
            _ -> copy_project_directory_path(project_directory_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_directory_path(&mut self, count: u64) {
        self.project_directory_path_len = count;
    }
}

pub machine ProjectCreateRequest::clear_project_directory_path(&mut self) {
    self.has_project_directory_path = false;
    self.project_directory_path_len = 0;
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectCreateRequest::has_project_name(&self) -> bool {
    self.has_project_name
}

pub machine ProjectCreateRequest::get_project_name(&self) -> &[u8] {
    transition self.project_name_len <= 256 {
        true -> (&self.project_name[0..self.project_name_len])
        false -> (&self.project_name[0..256])
        _ -> (&self.project_name[0..256])
    }
}

pub machine ProjectCreateRequest::set_project_name(&mut self, project_name: &[u8]) {
    self.has_project_name = true;
    self.project_name_len = 0;
    transition {
        _ -> copy_project_name(project_name, 0)
    }
    state copy_project_name(&mut self, project_name: &[u8], position: u64) {
        transition position < project_name.len && position < 256 {
            true -> store_project_name(project_name, position)
            false -> finish_project_name(position)
        }
    }
    state store_project_name(&mut self, project_name: &[u8], position: u64) {
        self.project_name[position] = project_name[position];
        transition {
            _ -> copy_project_name(project_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_name(&mut self, count: u64) {
        self.project_name_len = count;
    }
}

pub machine ProjectCreateRequest::clear_project_name(&mut self) {
    self.has_project_name = false;
    self.project_name_len = 0;
}
