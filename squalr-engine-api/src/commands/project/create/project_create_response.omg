module src::commands::project::create::project_create_response;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project/create/project_create_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectCreateResponse {
    success: bool;
    new_project_path: [u8; 512];
    new_project_path_len: u64;
}

pub machine ProjectCreateResponse::new() -> ProjectCreateResponse {
    ProjectCreateResponse {
        success: false,
        new_project_path_len: 0,
    }
}

pub machine ProjectCreateResponse::default() -> ProjectCreateResponse {
    ProjectCreateResponse::new()
}

pub machine ProjectCreateResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectCreateResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectCreateResponse::get_new_project_path(&self) -> &[u8] {
    transition self.new_project_path_len <= 512 {
        true -> (&self.new_project_path[0..self.new_project_path_len])
        false -> (&self.new_project_path[0..512])
        _ -> (&self.new_project_path[0..512])
    }
}

pub machine ProjectCreateResponse::set_new_project_path(&mut self, new_project_path: &[u8]) {
    self.new_project_path_len = BoundedByteCopy::copy(&mut self.new_project_path[0..512], new_project_path);
}
