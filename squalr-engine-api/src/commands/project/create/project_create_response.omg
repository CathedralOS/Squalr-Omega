module src::commands::project::create::project_create_response;

// Port of commands/project/create/project_create_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
public data ProjectCreateResponse {
    success: bool;
    new_project_path: [u8; 512];
    new_project_path_len: u64;
}

public machine ProjectCreateResponse::new() -> ProjectCreateResponse {
    ProjectCreateResponse {
        success: false,
        new_project_path_len: 0,
    }
}

public machine ProjectCreateResponse::default() -> ProjectCreateResponse {
    ProjectCreateResponse::new()
}

public machine ProjectCreateResponse::get_success(this: &ProjectCreateResponse) -> bool {
    this.success
}

public machine ProjectCreateResponse::set_success(this: &mut ProjectCreateResponse, success: bool) {
    this.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
public machine ProjectCreateResponse::get_new_project_path(this: &ProjectCreateResponse) -> &[u8] {
    transition this.new_project_path_len <= 512 {
        true -> (&this.new_project_path[0..this.new_project_path_len])
        false -> (&this.new_project_path[0..512])
        _ -> (&this.new_project_path[0..512])
    }
}

public machine ProjectCreateResponse::set_new_project_path(this: &mut ProjectCreateResponse, new_project_path: &[u8]) {
    this.new_project_path_len = 0;
    transition {
        _ -> copy_new_project_path(this, new_project_path, 0)
    }
    machine copy_new_project_path(this: &mut ProjectCreateResponse, new_project_path: &[u8], position: u64) {
        transition position < new_project_path.len && position < 512 {
            true -> store_new_project_path(this, new_project_path, position)
            false -> finish_new_project_path(this, position)
        }
    }
    machine store_new_project_path(this: &mut ProjectCreateResponse, new_project_path: &[u8], position: u64) {
        this.new_project_path[position] = new_project_path[position];
        transition {
            _ -> copy_new_project_path(this, new_project_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    machine finish_new_project_path(this: &mut ProjectCreateResponse, count: u64) {
        this.new_project_path_len = count;
    }
}
