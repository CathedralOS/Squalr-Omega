module src::commands::project::export::project_export_request;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project/export/project_export_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectExportRequest {
    has_project_directory_path: bool;
    project_directory_path: [u8; 512];
    project_directory_path_len: u64;
    has_project_name: bool;
    project_name: [u8; 256];
    project_name_len: u64;
    open_export_folder: bool;
}

pub machine ProjectExportRequest::new() -> ProjectExportRequest {
    ProjectExportRequest {
        has_project_directory_path: false,
        project_directory_path_len: 0,
        has_project_name: false,
        project_name_len: 0,
        open_export_folder: false,
    }
}

pub machine ProjectExportRequest::default() -> ProjectExportRequest {
    ProjectExportRequest::new()
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectExportRequest::has_project_directory_path(&self) -> bool {
    self.has_project_directory_path
}

pub machine ProjectExportRequest::get_project_directory_path(&self) -> &[u8] {
    transition self.project_directory_path_len <= 512 {
        true -> (&self.project_directory_path[0..self.project_directory_path_len])
        false -> (&self.project_directory_path[0..512])
        _ -> (&self.project_directory_path[0..512])
    }
}

pub machine ProjectExportRequest::set_project_directory_path(&mut self, project_directory_path: &[u8]) {
    self.has_project_directory_path = true;
    self.project_directory_path_len = BoundedByteCopy::copy(&mut self.project_directory_path[0..512], project_directory_path);
}

pub machine ProjectExportRequest::clear_project_directory_path(&mut self) {
    self.has_project_directory_path = false;
    self.project_directory_path_len = 0;
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectExportRequest::has_project_name(&self) -> bool {
    self.has_project_name
}

pub machine ProjectExportRequest::get_project_name(&self) -> &[u8] {
    transition self.project_name_len <= 256 {
        true -> (&self.project_name[0..self.project_name_len])
        false -> (&self.project_name[0..256])
        _ -> (&self.project_name[0..256])
    }
}

pub machine ProjectExportRequest::set_project_name(&mut self, project_name: &[u8]) {
    self.has_project_name = true;
    self.project_name_len = BoundedByteCopy::copy(&mut self.project_name[0..256], project_name);
}

pub machine ProjectExportRequest::clear_project_name(&mut self) {
    self.has_project_name = false;
    self.project_name_len = 0;
}

pub machine ProjectExportRequest::get_open_export_folder(&self) -> bool {
    self.open_export_folder
}

pub machine ProjectExportRequest::set_open_export_folder(&mut self, open_export_folder: bool) {
    self.open_export_folder = open_export_folder;
}
