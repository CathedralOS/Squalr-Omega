module src::commands::project::export::project_export_request;

// Port of commands/project/export/project_export_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectExportRequest {
    has_project_directory_path: bool;
    project_directory_path: [u8; 512];
    project_directory_path_len: u64;
    has_project_name: bool;
    project_name: [u8; 256];
    project_name_len: u64;
    open_export_folder: bool;
}

pub machine ProjectExportRequest::new() -> ProjectExportRequest {
    ProjectExportRequest {
        has_project_directory_path: false,
        project_directory_path_len: 0,
        has_project_name: false,
        project_name_len: 0,
        open_export_folder: false,
    }
}

pub machine ProjectExportRequest::default() -> ProjectExportRequest {
    ProjectExportRequest::new()
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectExportRequest::has_project_directory_path(project_export_request: &ProjectExportRequest) -> bool {
    project_export_request.has_project_directory_path
}

pub machine ProjectExportRequest::get_project_directory_path(project_export_request: &ProjectExportRequest) -> &[u8] {
    transition project_export_request.project_directory_path_len <= 512 {
        true -> (&project_export_request.project_directory_path[0..project_export_request.project_directory_path_len])
        false -> (&project_export_request.project_directory_path[0..512])
        _ -> (&project_export_request.project_directory_path[0..512])
    }
}

pub machine ProjectExportRequest::set_project_directory_path(project_export_request: &mut ProjectExportRequest, project_directory_path: &[u8]) {
    project_export_request.has_project_directory_path = true;
    project_export_request.project_directory_path_len = 0;
    transition {
        _ -> copy_project_directory_path(project_export_request, project_directory_path, 0)
    }
    state copy_project_directory_path(project_export_request: &mut ProjectExportRequest, project_directory_path: &[u8], position: u64) {
        transition position < project_directory_path.len && position < 512 {
            true -> store_project_directory_path(project_export_request, project_directory_path, position)
            false -> finish_project_directory_path(project_export_request, position)
        }
    }
    state store_project_directory_path(project_export_request: &mut ProjectExportRequest, project_directory_path: &[u8], position: u64) {
        project_export_request.project_directory_path[position] = project_directory_path[position];
        transition {
            _ -> copy_project_directory_path(project_export_request, project_directory_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_directory_path(project_export_request: &mut ProjectExportRequest, count: u64) {
        project_export_request.project_directory_path_len = count;
    }
}

pub machine ProjectExportRequest::clear_project_directory_path(project_export_request: &mut ProjectExportRequest) {
    project_export_request.has_project_directory_path = false;
    project_export_request.project_directory_path_len = 0;
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectExportRequest::has_project_name(project_export_request: &ProjectExportRequest) -> bool {
    project_export_request.has_project_name
}

pub machine ProjectExportRequest::get_project_name(project_export_request: &ProjectExportRequest) -> &[u8] {
    transition project_export_request.project_name_len <= 256 {
        true -> (&project_export_request.project_name[0..project_export_request.project_name_len])
        false -> (&project_export_request.project_name[0..256])
        _ -> (&project_export_request.project_name[0..256])
    }
}

pub machine ProjectExportRequest::set_project_name(project_export_request: &mut ProjectExportRequest, project_name: &[u8]) {
    project_export_request.has_project_name = true;
    project_export_request.project_name_len = 0;
    transition {
        _ -> copy_project_name(project_export_request, project_name, 0)
    }
    state copy_project_name(project_export_request: &mut ProjectExportRequest, project_name: &[u8], position: u64) {
        transition position < project_name.len && position < 256 {
            true -> store_project_name(project_export_request, project_name, position)
            false -> finish_project_name(project_export_request, position)
        }
    }
    state store_project_name(project_export_request: &mut ProjectExportRequest, project_name: &[u8], position: u64) {
        project_export_request.project_name[position] = project_name[position];
        transition {
            _ -> copy_project_name(project_export_request, project_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_name(project_export_request: &mut ProjectExportRequest, count: u64) {
        project_export_request.project_name_len = count;
    }
}

pub machine ProjectExportRequest::clear_project_name(project_export_request: &mut ProjectExportRequest) {
    project_export_request.has_project_name = false;
    project_export_request.project_name_len = 0;
}

pub machine ProjectExportRequest::get_open_export_folder(project_export_request: &ProjectExportRequest) -> bool {
    project_export_request.open_export_folder
}

pub machine ProjectExportRequest::set_open_export_folder(project_export_request: &mut ProjectExportRequest, open_export_folder: bool) {
    project_export_request.open_export_folder = open_export_folder;
}
