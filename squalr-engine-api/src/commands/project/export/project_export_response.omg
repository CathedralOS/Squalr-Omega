module src::commands::project::export::project_export_response;

// Port of commands/project/export/project_export_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectExportResponse {
    success: bool;
}

pub machine ProjectExportResponse::new() -> ProjectExportResponse {
    ProjectExportResponse {
        success: false,
    }
}

pub machine ProjectExportResponse::default() -> ProjectExportResponse {
    ProjectExportResponse::new()
}

pub machine ProjectExportResponse::get_success(project_export_response: &ProjectExportResponse) -> bool {
    project_export_response.success
}

pub machine ProjectExportResponse::set_success(project_export_response: &mut ProjectExportResponse, success: bool) {
    project_export_response.success = success;
}
