use src/commands/project/close/project_close_response.omg;
use src/commands/project/create/project_create_response.omg;
use src/commands/project/delete/project_delete_response.omg;
use src/commands/project/export/project_export_response.omg;
use src/commands/project/list/project_list_response.omg;
use src/commands/project/open/project_open_response.omg;
use src/commands/project/rename/project_rename_response.omg;
use src/commands/project/save/project_save_response.omg;

// Port of commands/project/project_response.rs — the upstream leaf enum
// respelled as a cased union; payloads keep upstream's leaf field naming.
public data ProjectResponse {
    case Close(response: |project_close_response|::ProjectCloseResponse);
    case Create(response: |project_create_response|::ProjectCreateResponse);
    case Delete(response: |project_delete_response|::ProjectDeleteResponse);
    case Export(response: |project_export_response|::ProjectExportResponse);
    case List(response: |project_list_response|::ProjectListResponse);
    case Open(response: |project_open_response|::ProjectOpenResponse);
    case Rename(response: |project_rename_response|::ProjectRenameResponse);
    case Save(response: |project_save_response|::ProjectSaveResponse);
}
