module src::commands::project::project_response;

use src::commands::project::close::project_close_response::ProjectCloseResponse;
use src::commands::project::create::project_create_response::ProjectCreateResponse;
use src::commands::project::delete::project_delete_response::ProjectDeleteResponse;
use src::commands::project::export::project_export_response::ProjectExportResponse;
use src::commands::project::list::project_list_response::ProjectListResponse;
use src::commands::project::open::project_open_response::ProjectOpenResponse;
use src::commands::project::rename::project_rename_response::ProjectRenameResponse;
use src::commands::project::save::project_save_response::ProjectSaveResponse;

// Port of commands/project/project_response.rs — the upstream leaf enum
// respelled as a cased union; payloads keep upstream's leaf field naming.
pub data ProjectResponse {
    case Close(response: ProjectCloseResponse);
    case Create(response: ProjectCreateResponse);
    case Delete(response: ProjectDeleteResponse);
    case Export(response: ProjectExportResponse);
    case List(response: ProjectListResponse);
    case Open(response: ProjectOpenResponse);
    case Rename(response: ProjectRenameResponse);
    case Save(response: ProjectSaveResponse);
}
