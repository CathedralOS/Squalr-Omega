module src::commands::project::list::project_list_response;

use src::structures::projects::project_info::ProjectInfo;
// Port of commands/project/list/project_list_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectListResponse {
    projects_info: [ProjectInfo; 32];
    project_info_count: u64;
}

pub machine ProjectListResponse::new() -> ProjectListResponse {
    ProjectListResponse {
        project_info_count: 0,
    }
}

pub machine ProjectListResponse::default() -> ProjectListResponse {
    ProjectListResponse::new()
}

// Upstream `Vec<ProjectInfo>` -> bounded [ProjectInfo; 32] + live count; `add_project_info`
// refuses past the bound rather than truncating.
pub machine ProjectListResponse::get_project_info_count(project_list_response: &ProjectListResponse) -> u64 {
    project_list_response.project_info_count
}

// Guarded element access — callers gate on get_project_info_count.
pub machine ProjectListResponse::get_project_info(project_list_response: &ProjectListResponse, index: u64) -> &ProjectInfo
    requires 0 <= index && index < 32
{
    &project_list_response.projects_info[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectListResponse::add_project_info(project_list_response: &mut ProjectListResponse, project_info: ProjectInfo) -> bool {
    transition project_list_response.project_info_count < 32 {
        true -> store_project_info(project_list_response, project_info)
        false -> (false)
        _ -> (false)
    }
    state store_project_info(project_list_response: &mut ProjectListResponse, project_info: ProjectInfo) -> bool {
        let index: u64 = project_list_response.project_info_count;
        transition index < 32 {
            true -> fill_project_info(project_list_response, project_info, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_project_info(project_list_response: &mut ProjectListResponse, project_info: ProjectInfo, index: u64) -> bool
        requires 0 <= index && index < 32
    {
        project_list_response.projects_info[index] = project_info;
        project_list_response.project_info_count = index + 1;
        (true)
    }
}
