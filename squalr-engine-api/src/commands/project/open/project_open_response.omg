module src::commands::project::open::project_open_response;

// Port of commands/project/open/project_open_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectOpenResponse {
    success: bool;
}

pub machine ProjectOpenResponse::new() -> ProjectOpenResponse {
    ProjectOpenResponse {
        success: false,
    }
}

pub machine ProjectOpenResponse::default() -> ProjectOpenResponse {
    ProjectOpenResponse::new()
}

pub machine ProjectOpenResponse::get_success(project_open_response: &ProjectOpenResponse) -> bool {
    project_open_response.success
}

pub machine ProjectOpenResponse::set_success(project_open_response: &mut ProjectOpenResponse, success: bool) {
    project_open_response.success = success;
}
