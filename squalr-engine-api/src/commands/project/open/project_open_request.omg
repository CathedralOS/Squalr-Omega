module src::commands::project::open::project_open_request;

// Port of commands/project/open/project_open_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectOpenRequest {
    open_file_browser: bool;
    has_project_directory_path: bool;
    project_directory_path: [u8; 512];
    project_directory_path_len: u64;
    has_project_name: bool;
    project_name: [u8; 256];
    project_name_len: u64;
}

pub machine ProjectOpenRequest::new() -> ProjectOpenRequest {
    ProjectOpenRequest {
        open_file_browser: false,
        has_project_directory_path: false,
        project_directory_path_len: 0,
        has_project_name: false,
        project_name_len: 0,
    }
}

pub machine ProjectOpenRequest::default() -> ProjectOpenRequest {
    ProjectOpenRequest::new()
}

pub machine ProjectOpenRequest::get_open_file_browser(this: &ProjectOpenRequest) -> bool {
    this.open_file_browser
}

pub machine ProjectOpenRequest::set_open_file_browser(this: &mut ProjectOpenRequest, open_file_browser: bool) {
    this.open_file_browser = open_file_browser;
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectOpenRequest::has_project_directory_path(this: &ProjectOpenRequest) -> bool {
    this.has_project_directory_path
}

pub machine ProjectOpenRequest::get_project_directory_path(this: &ProjectOpenRequest) -> &[u8] {
    transition this.project_directory_path_len <= 512 {
        true -> (&this.project_directory_path[0..this.project_directory_path_len])
        false -> (&this.project_directory_path[0..512])
        _ -> (&this.project_directory_path[0..512])
    }
}

pub machine ProjectOpenRequest::set_project_directory_path(this: &mut ProjectOpenRequest, project_directory_path: &[u8]) {
    this.has_project_directory_path = true;
    this.project_directory_path_len = 0;
    transition {
        _ -> copy_project_directory_path(this, project_directory_path, 0)
    }
    state copy_project_directory_path(this: &mut ProjectOpenRequest, project_directory_path: &[u8], position: u64) {
        transition position < project_directory_path.len && position < 512 {
            true -> store_project_directory_path(this, project_directory_path, position)
            false -> finish_project_directory_path(this, position)
        }
    }
    state store_project_directory_path(this: &mut ProjectOpenRequest, project_directory_path: &[u8], position: u64) {
        this.project_directory_path[position] = project_directory_path[position];
        transition {
            _ -> copy_project_directory_path(this, project_directory_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_directory_path(this: &mut ProjectOpenRequest, count: u64) {
        this.project_directory_path_len = count;
    }
}

pub machine ProjectOpenRequest::clear_project_directory_path(this: &mut ProjectOpenRequest) {
    this.has_project_directory_path = false;
    this.project_directory_path_len = 0;
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectOpenRequest::has_project_name(this: &ProjectOpenRequest) -> bool {
    this.has_project_name
}

pub machine ProjectOpenRequest::get_project_name(this: &ProjectOpenRequest) -> &[u8] {
    transition this.project_name_len <= 256 {
        true -> (&this.project_name[0..this.project_name_len])
        false -> (&this.project_name[0..256])
        _ -> (&this.project_name[0..256])
    }
}

pub machine ProjectOpenRequest::set_project_name(this: &mut ProjectOpenRequest, project_name: &[u8]) {
    this.has_project_name = true;
    this.project_name_len = 0;
    transition {
        _ -> copy_project_name(this, project_name, 0)
    }
    state copy_project_name(this: &mut ProjectOpenRequest, project_name: &[u8], position: u64) {
        transition position < project_name.len && position < 256 {
            true -> store_project_name(this, project_name, position)
            false -> finish_project_name(this, position)
        }
    }
    state store_project_name(this: &mut ProjectOpenRequest, project_name: &[u8], position: u64) {
        this.project_name[position] = project_name[position];
        transition {
            _ -> copy_project_name(this, project_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_name(this: &mut ProjectOpenRequest, count: u64) {
        this.project_name_len = count;
    }
}

pub machine ProjectOpenRequest::clear_project_name(this: &mut ProjectOpenRequest) {
    this.has_project_name = false;
    this.project_name_len = 0;
}
