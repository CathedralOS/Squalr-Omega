module src::commands::project::save::project_save_response;

// Port of commands/project/save/project_save_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSaveResponse {
    success: bool;
}

pub machine ProjectSaveResponse::new() -> ProjectSaveResponse {
    ProjectSaveResponse {
        success: false,
    }
}

pub machine ProjectSaveResponse::default() -> ProjectSaveResponse {
    ProjectSaveResponse::new()
}

pub machine ProjectSaveResponse::get_success(project_save_response: &ProjectSaveResponse) -> bool {
    project_save_response.success
}

pub machine ProjectSaveResponse::set_success(project_save_response: &mut ProjectSaveResponse, success: bool) {
    project_save_response.success = success;
}
