use src/commands/debugger/debugger_command.omg;
use src/commands/memory/memory_command.omg;
use src/commands/process/process_command.omg;
use src/commands/pointer_scan/pointer_scan_command.omg;
use src/commands/patches/patches_command.omg;
use src/commands/plugins/plugins_command.omg;
use src/commands/registry/registry_command.omg;
use src/commands/scan/scan_command.omg;
use src/commands/scan_results/scan_results_command.omg;
use src/commands/settings/settings_command.omg;
use src/commands/struct_scan/struct_scan_command.omg;
use src/commands/trackable_tasks/trackable_tasks_command.omg;

// Port of commands/privileged_command.rs: the root command union the
// engine's unprivileged state dispatches. Scan, results, pointer-scan,
// memory, process, struct-scan, trackable-tasks, settings, registry,
// patches, plugins and debugger domains land so far — the privileged
// union is complete; only the Unprivileged families remain open.
public data PrivilegedCommand {
    case Scan(command: |scan_command|::ScanCommand);
    case ScanResults(command: |scan_results_command|::ScanResultsCommand);
    case PointerScan(command: |pointer_scan_command|::PointerScanCommand);
    case Memory(command: |memory_command|::MemoryCommand);
    case Process(command: |process_command|::ProcessCommand);
    case StructScan(command: |struct_scan_command|::StructScanCommand);
    case TrackableTasks(command: |trackable_tasks_command|::TrackableTasksCommand);
    case Settings(command: |settings_command|::SettingsCommand);
    case Registry(command: |registry_command|::RegistryCommand);
    case Patches(command: |patches_command|::PatchesCommand);
    case Plugins(command: |plugins_command|::PluginsCommand);
    case Debugger(command: |debugger_command|::DebuggerCommand);
}

// Upstream `PrivilegedCommand::should_include_privileged_registry_catalog` —
// `matches!(self, Self::Registry(_))`, verbatim now that the arm exists.
public machine PrivilegedCommand::should_include_privileged_registry_catalog(this: &PrivilegedCommand) -> bool {
    transition this {
        PrivilegedCommand::Registry { command } -> (true)
        _ -> (false)
    }
}
