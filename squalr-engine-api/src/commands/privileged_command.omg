module src::commands::privileged_command;

use src::commands::memory::memory_command::MemoryCommand;
use src::commands::process::process_command::ProcessCommand;
use src::commands::pointer_scan::pointer_scan_command::PointerScanCommand;
use src::commands::registry::registry_command::RegistryCommand;
use src::commands::scan::scan_command::ScanCommand;
use src::commands::scan_results::scan_results_command::ScanResultsCommand;
use src::commands::settings::settings_command::SettingsCommand;
use src::commands::struct_scan::struct_scan_command::StructScanCommand;
use src::commands::trackable_tasks::trackable_tasks_command::TrackableTasksCommand;

// Port of commands/privileged_command.rs: the root command union the
// engine's unprivileged state dispatches. Scan, results, pointer-scan,
// memory, process, struct-scan, trackable-tasks, settings and registry
// domains land so far (Debugger/Patches/Plugins arrive with their own
// legs).
pub data PrivilegedCommand {
    case Scan(command: ScanCommand);
    case ScanResults(command: ScanResultsCommand);
    case PointerScan(command: PointerScanCommand);
    case Memory(command: MemoryCommand);
    case Process(command: ProcessCommand);
    case StructScan(command: StructScanCommand);
    case TrackableTasks(command: TrackableTasksCommand);
    case Settings(command: SettingsCommand);
    case Registry(command: RegistryCommand);
}

// Upstream `PrivilegedCommand::should_include_privileged_registry_catalog` —
// `matches!(self, Self::Registry(_))`, verbatim now that the arm exists.
pub machine PrivilegedCommand::should_include_privileged_registry_catalog(&self) -> bool {
    transition self {
        PrivilegedCommand::Registry { command } -> (true)
        _ -> (false)
    }
}
