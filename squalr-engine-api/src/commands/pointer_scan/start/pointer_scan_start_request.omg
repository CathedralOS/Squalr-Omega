use src/structures/data_values/pointer_scan_pointer_size.omg;
use src/structures/pointer_scans/pointer_scan_address_space.omg;
use src/structures/pointer_scans/pointer_scan_target_request.omg;

// Port of commands/pointer_scan/start/pointer_scan_start_request.rs.
public data PointerScanStartRequest {
    target: |pointer_scan_target_request|::PointerScanTargetRequest;
    pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize;
    max_depth: u64;
    offset_radius: u64;
    address_space: |pointer_scan_address_space|::PointerScanAddressSpace;
}

public machine PointerScanStartRequest::new(
    target: |pointer_scan_target_request|::PointerScanTargetRequest,
    pointer_size: |pointer_scan_pointer_size|::PointerScanPointerSize,
    max_depth: u64,
    offset_radius: u64,
    address_space: |pointer_scan_address_space|::PointerScanAddressSpace
) -> PointerScanStartRequest {
    PointerScanStartRequest {
        target: target,
        pointer_size: pointer_size,
        max_depth: max_depth,
        offset_radius: offset_radius,
        address_space: address_space,
    }
}
