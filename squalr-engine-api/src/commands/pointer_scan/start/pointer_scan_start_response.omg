module src::commands::pointer_scan::start::pointer_scan_start_response;

use src::structures::pointer_scans::pointer_scan_summary::StoredPointerScanSummary;

// Port of commands/pointer_scan/start/pointer_scan_start_response.rs.
// `Option<PointerScanSummary>` folds to `has_pointer_scan_summary` beside the
// owned `StoredPointerScanSummary` (the borrowed `PointerScanSummary` cannot
// outlive its level-summaries extent, see pointer_scan_summary.omg).
public data PointerScanStartResponse {
    success: bool;
    has_pointer_scan_summary: bool;
    pointer_scan_summary: StoredPointerScanSummary;
}

// Upstream PointerScanStartResponse::default() — success: false, no summary.
public machine PointerScanStartResponse::default() -> PointerScanStartResponse {
    PointerScanStartResponse {
        success: false,
        has_pointer_scan_summary: false,
    }
}

public machine PointerScanStartResponse::of_summary(
    pointer_scan_summary: StoredPointerScanSummary
) -> PointerScanStartResponse {
    PointerScanStartResponse {
        success: true,
        has_pointer_scan_summary: true,
        pointer_scan_summary: pointer_scan_summary,
    }
}
