use src/commands/pointer_scan/expand/pointer_scan_expand_request.omg;
use src/commands/pointer_scan/reset/pointer_scan_reset_request.omg;
use src/commands/pointer_scan/start/pointer_scan_start_request.omg;
use src/commands/pointer_scan/summary/pointer_scan_summary_request.omg;
use src/commands/pointer_scan/validate/pointer_scan_validate_request.omg;

// Port of commands/pointer_scan/pointer_scan_command.rs — the pointer-scan
// command union, in upstream case order (Reset, Start, Summary, Expand,
// Validate).
public data PointerScanCommand {
    case Reset(request: |pointer_scan_reset_request|::PointerScanResetRequest);
    case Start(request: |pointer_scan_start_request|::PointerScanStartRequest);
    case Summary(request: |pointer_scan_summary_request|::PointerScanSummaryRequest);
    case Expand(request: |pointer_scan_expand_request|::PointerScanExpandRequest);
    case Validate(request: |pointer_scan_validate_request|::PointerScanValidateRequest);
}
