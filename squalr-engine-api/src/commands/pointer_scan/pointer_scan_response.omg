use src/commands/pointer_scan/expand/pointer_scan_expand_response.omg;
use src/commands/pointer_scan/reset/pointer_scan_reset_response.omg;
use src/commands/pointer_scan/start/pointer_scan_start_response.omg;
use src/commands/pointer_scan/summary/pointer_scan_summary_response.omg;
use src/commands/pointer_scan/validate/pointer_scan_validate_response.omg;

// Port of commands/pointer_scan/pointer_scan_response.rs — one response case
// per command, in upstream case order.
public data PointerScanResponse {
    case Reset(response: |pointer_scan_reset_response|::PointerScanResetResponse);
    case Start(response: |pointer_scan_start_response|::PointerScanStartResponse);
    case Summary(response: |pointer_scan_summary_response|::PointerScanSummaryResponse);
    case Expand(response: |pointer_scan_expand_response|::PointerScanExpandResponse);
    case Validate(response: |pointer_scan_validate_response|::PointerScanValidateResponse);
}
