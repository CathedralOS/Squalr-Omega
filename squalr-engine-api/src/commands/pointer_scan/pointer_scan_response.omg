module src::commands::pointer_scan::pointer_scan_response;

use src::commands::pointer_scan::expand::pointer_scan_expand_response::PointerScanExpandResponse;
use src::commands::pointer_scan::reset::pointer_scan_reset_response::PointerScanResetResponse;
use src::commands::pointer_scan::start::pointer_scan_start_response::PointerScanStartResponse;
use src::commands::pointer_scan::summary::pointer_scan_summary_response::PointerScanSummaryResponse;
use src::commands::pointer_scan::validate::pointer_scan_validate_response::PointerScanValidateResponse;

// Port of commands/pointer_scan/pointer_scan_response.rs — one response case
// per command, in upstream case order.
pub data PointerScanResponse {
    case Reset(response: PointerScanResetResponse);
    case Start(response: PointerScanStartResponse);
    case Summary(response: PointerScanSummaryResponse);
    case Expand(response: PointerScanExpandResponse);
    case Validate(response: PointerScanValidateResponse);
}
