module src::commands::pointer_scan::validate::pointer_scan_validate_response;
use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::pointer_scans::pointer_scan_summary::StoredPointerScanSummary;

// Port of commands/pointer_scan/validate/pointer_scan_validate_response.rs.
// `Option<u64>`/`Option<PointerScanSummary>` fold to `has_*` flags; the
// upstream `String` status message is a bounded byte field (256 bounds the
// longest upstream-formatted status; longer statuses truncate, a named
// deviation — upstream's own messages are <90 bytes).
pub data PointerScanValidateResponse {
    validation_performed: bool;
    has_validation_target_address: bool;
    validation_target_address: u64;
    pruned_node_count: u64;
    status_message: [u8; 256];
    status_message_len: u64;
    has_pointer_scan_summary: bool;
    pointer_scan_summary: StoredPointerScanSummary;
}

pub machine PointerScanValidateResponse::empty() -> PointerScanValidateResponse {
    PointerScanValidateResponse {
        validation_performed: false,
        has_validation_target_address: false,
        pruned_node_count: 0,
        status_message_len: 0,
        has_pointer_scan_summary: false,
    }
}

pub machine PointerScanValidateResponse::set_status_message(
    &mut self,
    status_message: &[u8]
) {
    self.status_message_len = BoundedByteCopy::copy(&mut self.status_message[0..256], status_message);
}

pub machine PointerScanValidateResponse::get_status_message_byte(&self, position: u64) -> u8 {
    transition position < self.status_message_len && position < 256 {
        true -> (self.status_message[position])
        false -> (0)
        _ -> (0)
    }
}
