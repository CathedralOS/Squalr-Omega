module src::commands::pointer_scan::summary::pointer_scan_summary_request;

// Port of commands/pointer_scan/summary/pointer_scan_summary_request.rs.
// `Option<u64>` folds to `has_session_id` — absent selects the active
// results regardless of session.
public data PointerScanSummaryRequest {
    has_session_id: bool;
    session_id: u64;
}

public machine PointerScanSummaryRequest::default() -> PointerScanSummaryRequest {
    PointerScanSummaryRequest { has_session_id: false }
}

public machine PointerScanSummaryRequest::of_session(
    session_id: u64
) -> PointerScanSummaryRequest {
    PointerScanSummaryRequest {
        has_session_id: true,
        session_id: session_id,
    }
}
