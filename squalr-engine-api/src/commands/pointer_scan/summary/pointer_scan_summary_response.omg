module src::commands::pointer_scan::summary::pointer_scan_summary_response;

use src::structures::pointer_scans::pointer_scan_summary::StoredPointerScanSummary;

// Port of commands/pointer_scan/summary/pointer_scan_summary_response.rs.
// `Option<PointerScanSummary>` folds to `has_pointer_scan_summary`.
pub data PointerScanSummaryResponse {
    has_pointer_scan_summary: bool;
    pointer_scan_summary: StoredPointerScanSummary;
}

pub machine PointerScanSummaryResponse::empty() -> PointerScanSummaryResponse {
    PointerScanSummaryResponse { has_pointer_scan_summary: false }
}

pub machine PointerScanSummaryResponse::of_summary(
    pointer_scan_summary: StoredPointerScanSummary
) -> PointerScanSummaryResponse {
    PointerScanSummaryResponse {
        has_pointer_scan_summary: true,
        pointer_scan_summary: pointer_scan_summary,
    }
}
