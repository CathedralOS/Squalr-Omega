module src::commands::pointer_scan::expand::pointer_scan_expand_request;

// Port of commands/pointer_scan/expand/pointer_scan_expand_request.rs.
// `Option<u64>` parent folds to `has_parent_node_id` — absent selects the
// root level.
pub data PointerScanExpandRequest {
    session_id: u64;
    has_parent_node_id: bool;
    parent_node_id: u64;
    page_index: u64;
    page_size: u64;
}

pub machine PointerScanExpandRequest::new(
    session_id: u64,
    has_parent_node_id: bool,
    parent_node_id: u64,
    page_index: u64,
    page_size: u64
) -> PointerScanExpandRequest {
    PointerScanExpandRequest {
        session_id: session_id,
        has_parent_node_id: has_parent_node_id,
        parent_node_id: parent_node_id,
        page_index: page_index,
        page_size: page_size,
    }
}
