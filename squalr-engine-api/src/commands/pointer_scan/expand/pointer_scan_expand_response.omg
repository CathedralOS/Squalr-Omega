module src::commands::pointer_scan::expand::pointer_scan_expand_response;

use src::structures::pointer_scans::pointer_scan_node::PointerScanNode;

// Port of commands/pointer_scan/expand/pointer_scan_expand_response.rs.
// `Option<u64>` parent folds to `has_parent_node_id`; upstream's
// `Vec<PointerScanNode>` is bounded at 64 (pages larger than the bound
// truncate — a named deviation; scan results pages bound at the same size).
pub data PointerScanExpandResponse {
    session_id: u64;
    has_parent_node_id: bool;
    parent_node_id: u64;
    page_index: u64;
    last_page_index: u64;
    total_node_count: u64;
    pointer_scan_nodes: [PointerScanNode; 64];
    pointer_scan_node_count: u64;
}

pub machine PointerScanExpandResponse::empty(
    session_id: u64,
    has_parent_node_id: bool,
    parent_node_id: u64
) -> PointerScanExpandResponse {
    PointerScanExpandResponse {
        session_id: session_id,
        has_parent_node_id: has_parent_node_id,
        parent_node_id: parent_node_id,
        page_index: 0,
        last_page_index: 0,
        total_node_count: 0,
        pointer_scan_node_count: 0,
    }
}

pub machine PointerScanExpandResponse::push_node(
    pointer_scan_expand_response: &mut PointerScanExpandResponse,
    pointer_scan_node: PointerScanNode
) -> bool {
    transition pointer_scan_expand_response.pointer_scan_node_count < 64 {
        true -> store(pointer_scan_expand_response, pointer_scan_node)
        false -> (false)
    }
    state store(pointer_scan_expand_response: &mut PointerScanExpandResponse, pointer_scan_node: PointerScanNode) -> bool {
        pointer_scan_expand_response.pointer_scan_nodes[pointer_scan_expand_response.pointer_scan_node_count] = pointer_scan_node;
        pointer_scan_expand_response.pointer_scan_node_count = pointer_scan_expand_response.pointer_scan_node_count + 1;
        true
    }
}

pub machine PointerScanExpandResponse::get_node_count(pointer_scan_expand_response: &PointerScanExpandResponse) -> u64 {
    pointer_scan_expand_response.pointer_scan_node_count
}

pub machine PointerScanExpandResponse::get_node(pointer_scan_expand_response: &PointerScanExpandResponse, position: u64) -> PointerScanNode {
    transition position < pointer_scan_expand_response.pointer_scan_node_count && position < 64 {
        true -> arm_result_56_0(pointer_scan_expand_response, position)
        _ -> (PointerScanNode::empty())
    }
    state arm_result_56_0(pointer_scan_expand_response: &PointerScanExpandResponse, position: u64) -> PointerScanNode
    
    requires position < pointer_scan_expand_response.pointer_scan_node_count && position < 64;
{
        (pointer_scan_expand_response.pointer_scan_nodes[position])
    }
}
