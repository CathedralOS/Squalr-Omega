pub machine PrivilegedCommandResponse::is_debugger(privileged_command_response: &PrivilegedCommandResponse) -> bool {
    transition privileged_command_response {
        PrivilegedCommandResponse::Debugger { response } -> (true)
        _ -> (false)
    }
