// Delete projections: true/0 when the response carries no delete outcome.
public machine PrivilegedCommandResponse::is_delete(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::ScanResults { response } -> at(this, &response)
        _ -> (false)
    }
    machine at(this: &PrivilegedCommandResponse, response: &|scan_results_response|::ScanResultsResponse) -> bool {
        let hoist1: bool = |scan_results_response|::ScanResultsResponse::is_delete(&response);
        (hoist1)
    }
}

public machine PrivilegedCommandResponse::get_deleted_result_count(this: &PrivilegedCommandResponse) -> u64 {
    transition this {
        PrivilegedCommandResponse::ScanResults { response } -> at(this, &response)
        _ -> (0)
    }
    machine at(this: &PrivilegedCommandResponse, response: &|scan_results_response|::ScanResultsResponse) -> u64 {
        let hoist2: u64 = |scan_results_response|::ScanResultsResponse::get_deleted_result_count(&response);
        (hoist2)
    }
}

// Page projections through the outer union — same unit-kind reason as the
// case queries; 0 when the response carries no result page.
public machine PrivilegedCommandResponse::get_result_count(this: &PrivilegedCommandResponse) -> u64 {
    transition this {
        PrivilegedCommandResponse::ScanResults { response } -> at(this, &response)
        _ -> (0)
    }
    machine at(this: &PrivilegedCommandResponse, response: &|scan_results_response|::ScanResultsResponse) -> u64 {
        let hoist3: u64 = |scan_results_response|::ScanResultsResponse::get_result_count(&response);
        (hoist3)
    }
}

public machine PrivilegedCommandResponse::get_result_address(this: &PrivilegedCommandResponse, position: u64) -> u64 {
    transition this {
        PrivilegedCommandResponse::ScanResults { response } -> at(this, &response, position)
        _ -> (0)
    }
    machine at(this: &PrivilegedCommandResponse, response: &|scan_results_response|::ScanResultsResponse, position: u64) -> u64 {
        let hoist4: u64 = |scan_results_response|::ScanResultsResponse::get_result_address(&response, position);
        (hoist4)
    }
}

public machine PrivilegedCommandResponse::get_result_value(this: &PrivilegedCommandResponse, position: u64) -> u64 {
    transition this {
        PrivilegedCommandResponse::ScanResults { response } -> at(this, &response, position)
        _ -> (0)
    }
    machine at(this: &PrivilegedCommandResponse, response: &|scan_results_response|::ScanResultsResponse, position: u64) -> u64 {
        let hoist5: u64 = |scan_results_response|::ScanResultsResponse::get_result_value(&response, position);
        (hoist5)
    }
}
