pub machine PrivilegedCommandResponse::is_trackable_tasks(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::TrackableTasks { response } -> (true)
        _ -> (false)
    }
}

// Delete projections: true/0 when the response carries no delete outcome.
pub machine PrivilegedCommandResponse::is_delete(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::ScanResults { response } -> at(this, response)
        _ -> (false)
    }
    state at(this: &PrivilegedCommandResponse, response: ScanResultsResponse) -> bool {
        let hoist1: bool = ScanResultsResponse::is_delete(&response);
        (hoist1)
    }
}

pub machine PrivilegedCommandResponse::get_deleted_result_count(this: &PrivilegedCommandResponse) -> u64 {
    transition this {
        PrivilegedCommandResponse::ScanResults { response } -> at(this, response)
        _ -> (0)
    }
    state at(this: &PrivilegedCommandResponse, response: ScanResultsResponse) -> u64 {
        let hoist2: u64 = ScanResultsResponse::get_deleted_result_count(&response);
        (hoist2)
    }
}

// Page projections through the outer union — same unit-kind reason as the
// case queries; 0 when the response carries no result page.
pub machine PrivilegedCommandResponse::get_result_count(this: &PrivilegedCommandResponse) -> u64 {
    transition this {
        PrivilegedCommandResponse::ScanResults { response } -> at(this, response)
        _ -> (0)
    }
    state at(this: &PrivilegedCommandResponse, response: ScanResultsResponse) -> u64 {
        let hoist3: u64 = ScanResultsResponse::get_result_count(&response);
        (hoist3)
    }
}

pub machine PrivilegedCommandResponse::get_result_address(this: &PrivilegedCommandResponse, position: u64) -> u64 {
    transition this {
        PrivilegedCommandResponse::ScanResults { response } -> at(this, response, position)
        _ -> (0)
    }
    state at(this: &PrivilegedCommandResponse, response: ScanResultsResponse, position: u64) -> u64 {
        let hoist4: u64 = ScanResultsResponse::get_result_address(&response, position);
        (hoist4)
    }
}

pub machine PrivilegedCommandResponse::get_result_value(this: &PrivilegedCommandResponse, position: u64) -> u64 {
    transition this {
        PrivilegedCommandResponse::ScanResults { response } -> at(this, response, position)
        _ -> (0)
    }
    state at(this: &PrivilegedCommandResponse, response: ScanResultsResponse, position: u64) -> u64 {
        let hoist5: u64 = ScanResultsResponse::get_result_value(&response, position);
        (hoist5)
    }
}
