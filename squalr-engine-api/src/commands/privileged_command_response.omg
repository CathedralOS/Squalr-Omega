        _ -> (false)
    }
}

// Delete projections: true/0 when the response carries no delete outcome.
pub machine PrivilegedCommandResponse::is_delete(privileged_command_response: &PrivilegedCommandResponse) -> bool {
    transition privileged_command_response {
        PrivilegedCommandResponse::ScanResults { response } -> (ScanResultsResponse::is_delete(&response))
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::get_deleted_result_count(privileged_command_response: &PrivilegedCommandResponse) -> u64 {
    transition privileged_command_response {
        PrivilegedCommandResponse::ScanResults { response } -> (ScanResultsResponse::get_deleted_result_count(&response))
        _ -> (0)
    }
}

// Page projections through the outer union — same unit-kind reason as the
// case queries; 0 when the response carries no result page.
pub machine PrivilegedCommandResponse::get_result_count(privileged_command_response: &PrivilegedCommandResponse) -> u64 {
    transition privileged_command_response {
        PrivilegedCommandResponse::ScanResults { response } -> (ScanResultsResponse::get_result_count(&response))
        _ -> (0)
    }
}

pub machine PrivilegedCommandResponse::get_result_address(privileged_command_response: &PrivilegedCommandResponse, position: u64) -> u64 {
    transition privileged_command_response {
        PrivilegedCommandResponse::ScanResults { response } -> (ScanResultsResponse::get_result_address(&response, position))
        _ -> (0)
    }
}

pub machine PrivilegedCommandResponse::get_result_value(privileged_command_response: &PrivilegedCommandResponse, position: u64) -> u64 {
    transition privileged_command_response {
        PrivilegedCommandResponse::ScanResults { response } -> (ScanResultsResponse::get_result_value(&response, position))
        _ -> (0)
    }
}
