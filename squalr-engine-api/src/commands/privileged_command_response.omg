module src::commands::privileged_command_response;

use src::commands::memory::memory_response::MemoryResponse;
use src::commands::process::process_response::ProcessResponse;
use src::commands::pointer_scan::pointer_scan_response::PointerScanResponse;
use src::commands::patches::patches_response::PatchesResponse;
use src::commands::debugger::debugger_response::DebuggerResponse;
use src::commands::plugins::plugins_response::PluginsResponse;
use src::commands::registry::registry_response::RegistryResponse;
use src::commands::scan::scan_response::ScanResponse;
use src::commands::scan_results::scan_results_response::ScanResultsResponse;
use src::commands::settings::settings_response::SettingsResponse;
use src::commands::struct_scan::struct_scan_response::StructScanResponse;
use src::commands::trackable_tasks::trackable_tasks_response::TrackableTasksResponse;

// Port of commands/privileged_command_response.rs — one case per domain.
pub data PrivilegedCommandResponse {
    case Scan(response: ScanResponse);
    case ScanResults(response: ScanResultsResponse);
    case PointerScan(response: PointerScanResponse);
    case Memory(response: MemoryResponse);
    case Process(response: ProcessResponse);
    case StructScan(response: StructScanResponse);
    case TrackableTasks(response: TrackableTasksResponse);
    // Upstream interleaves domains alphabetically; arms append in landing
    // order instead (comment kept with the first landed deviation).
    case Settings(response: SettingsResponse);
    case Registry(response: RegistryResponse);
    case Patches(response: PatchesResponse);
    case Plugins(response: PluginsResponse);
    case Debugger(response: DebuggerResponse);
}

// Case queries keep callers in scalar guards where the unit kind lacks
// union-match terminators.
pub machine PrivilegedCommandResponse::is_scan(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::Scan { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_scan_results(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::ScanResults { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_settings(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::Settings { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_patches(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::Patches { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_plugins(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::Plugins { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_debugger(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::Debugger { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_registry(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::Registry { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_pointer_scan(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::PointerScan { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_memory(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::Memory { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_process(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::Process { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_struct_scan(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::StructScan { response } -> (true)
        _ -> (false)
    }
