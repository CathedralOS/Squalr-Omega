use src/commands/memory/memory_response.omg;
use src/commands/process/process_response.omg;
use src/commands/pointer_scan/pointer_scan_response.omg;
use src/commands/patches/patches_response.omg;
use src/commands/debugger/debugger_response.omg;
use src/commands/plugins/plugins_response.omg;
use src/commands/registry/registry_response.omg;
use src/commands/scan/scan_response.omg;
use src/commands/scan_results/scan_results_response.omg;
use src/commands/settings/settings_response.omg;
use src/commands/struct_scan/struct_scan_response.omg;
use src/commands/trackable_tasks/trackable_tasks_response.omg;

// Port of commands/privileged_command_response.rs — one case per domain.
public data PrivilegedCommandResponse {
    case Scan(response: |scan_response|::ScanResponse);
    case ScanResults(response: |scan_results_response|::ScanResultsResponse);
    case PointerScan(response: |pointer_scan_response|::PointerScanResponse);
    case Memory(response: |memory_response|::MemoryResponse);
    case Process(response: |process_response|::ProcessResponse);
    case StructScan(response: |struct_scan_response|::StructScanResponse);
    case TrackableTasks(response: |trackable_tasks_response|::TrackableTasksResponse);
    // Upstream interleaves domains alphabetically; arms append in landing
    // order instead (comment kept with the first landed deviation).
    case Settings(response: |settings_response|::SettingsResponse);
    case Registry(response: |registry_response|::RegistryResponse);
    case Patches(response: |patches_response|::PatchesResponse);
    case Plugins(response: |plugins_response|::PluginsResponse);
    case Debugger(response: |debugger_response|::DebuggerResponse);
}

// Case queries keep callers in scalar guards where the unit kind lacks
// union-match terminators.
public machine PrivilegedCommandResponse::is_scan(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::Scan { response } -> (true)
        _ -> (false)
    }
}

public machine PrivilegedCommandResponse::is_scan_results(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::ScanResults { response } -> (true)
        _ -> (false)
    }
}

public machine PrivilegedCommandResponse::is_settings(this: &PrivilegedCommandResponse) -> bool {
    transition this {
        PrivilegedCommandResponse::Settings { response } -> (true)
        _ -> (false)
    }
}

