module src::commands::privileged_command_response;

use src::commands::memory::memory_response::MemoryResponse;
use src::commands::process::process_response::ProcessResponse;
use src::commands::pointer_scan::pointer_scan_response::PointerScanResponse;
use src::commands::registry::registry_response::RegistryResponse;
use src::commands::scan::scan_response::ScanResponse;
use src::commands::scan_results::scan_results_response::ScanResultsResponse;
use src::commands::settings::settings_response::SettingsResponse;
use src::commands::struct_scan::struct_scan_response::StructScanResponse;
use src::commands::trackable_tasks::trackable_tasks_response::TrackableTasksResponse;

// Port of commands/privileged_command_response.rs — one case per domain.
pub data PrivilegedCommandResponse {
    case Scan(response: ScanResponse);
    case ScanResults(response: ScanResultsResponse);
    case PointerScan(response: PointerScanResponse);
    case Memory(response: MemoryResponse);
    case Process(response: ProcessResponse);
    case StructScan(response: StructScanResponse);
    case TrackableTasks(response: TrackableTasksResponse);
    // Upstream interleaves domains alphabetically; arms append in landing
    // order instead (comment kept with the first landed deviation).
    case Settings(response: SettingsResponse);
    case Registry(response: RegistryResponse);
}

// Case queries keep callers in scalar guards where the unit kind lacks
// union-match terminators.
pub machine PrivilegedCommandResponse::is_scan(&self) -> bool {
    transition self {
        PrivilegedCommandResponse::Scan { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_scan_results(&self) -> bool {
    transition self {
        PrivilegedCommandResponse::ScanResults { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_settings(&self) -> bool {
    transition self {
        PrivilegedCommandResponse::Settings { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_registry(&self) -> bool {
    transition self {
        PrivilegedCommandResponse::Registry { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_pointer_scan(&self) -> bool {
    transition self {
        PrivilegedCommandResponse::PointerScan { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_memory(&self) -> bool {
    transition self {
        PrivilegedCommandResponse::Memory { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_process(&self) -> bool {
    transition self {
        PrivilegedCommandResponse::Process { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_struct_scan(&self) -> bool {
    transition self {
        PrivilegedCommandResponse::StructScan { response } -> (true)
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::is_trackable_tasks(&self) -> bool {
    transition self {
        PrivilegedCommandResponse::TrackableTasks { response } -> (true)
        _ -> (false)
    }
}

// Delete projections: true/0 when the response carries no delete outcome.
pub machine PrivilegedCommandResponse::is_delete(&self) -> bool {
    transition self {
        PrivilegedCommandResponse::ScanResults { response } -> (response.is_delete())
        _ -> (false)
    }
}

pub machine PrivilegedCommandResponse::get_deleted_result_count(&self) -> u64 {
    transition self {
        PrivilegedCommandResponse::ScanResults { response } -> (response.get_deleted_result_count())
        _ -> (0)
    }
}

// Page projections through the outer union — same unit-kind reason as the
// case queries; 0 when the response carries no result page.
pub machine PrivilegedCommandResponse::get_result_count(&self) -> u64 {
    transition self {
        PrivilegedCommandResponse::ScanResults { response } -> (response.get_result_count())
        _ -> (0)
    }
}

pub machine PrivilegedCommandResponse::get_result_address(&self, position: u64) -> u64 {
    transition self {
        PrivilegedCommandResponse::ScanResults { response } -> (response.get_result_address(position))
        _ -> (0)
    }
}

pub machine PrivilegedCommandResponse::get_result_value(&self, position: u64) -> u64 {
    transition self {
        PrivilegedCommandResponse::ScanResults { response } -> (response.get_result_value(position))
        _ -> (0)
    }
}
