module src::commands::memory::freeze::memory_freeze_request;

use src::commands::memory::freeze::memory_freeze_target::MemoryFreezeTarget;

// Bounded `Vec<MemoryFreezeTarget>` — same shape as the port's other
// request lists (`ScanResultRefList`).
pub data MemoryFreezeTargetList {
    targets: [MemoryFreezeTarget; 64];
    count: u64;
}

pub machine MemoryFreezeTargetList::empty() -> MemoryFreezeTargetList {
    MemoryFreezeTargetList { count: 0 }
}

pub machine MemoryFreezeTargetList::get_count(memory_freeze_target_list: &MemoryFreezeTargetList) -> u64 {
    memory_freeze_target_list.count
}

pub machine MemoryFreezeTargetList::get_target(memory_freeze_target_list: &MemoryFreezeTargetList, position: u64) -> &MemoryFreezeTarget {
    transition position < memory_freeze_target_list.count && position < 64 {
        true -> at(memory_freeze_target_list, position)
        false -> (MemoryFreezeTargetList::head(memory_freeze_target_list))
        _ -> (MemoryFreezeTargetList::head(memory_freeze_target_list))
    }
    state at(memory_freeze_target_list: &MemoryFreezeTargetList, position: u64) -> &MemoryFreezeTarget
    requires 0 <= position && position < 64;
    {
        &memory_freeze_target_list.targets[position]
    }
}

pub machine MemoryFreezeTargetList::push(memory_freeze_target_list: &mut MemoryFreezeTargetList, target: &MemoryFreezeTarget) -> bool {
    transition memory_freeze_target_list.count < 64 {
        true -> store(memory_freeze_target_list, target)
        false -> (false)
    }
    state store(memory_freeze_target_list: &mut MemoryFreezeTargetList, target: &MemoryFreezeTarget) -> bool {
        memory_freeze_target_list.targets[memory_freeze_target_list.count] = MemoryFreezeTarget::clone(target);
        memory_freeze_target_list.count = memory_freeze_target_list.count + 1;
        true
    }
}

// Port of commands/memory/freeze/memory_freeze_request.rs: the toggle list
// plus the freeze/unfreeze flag.
pub data MemoryFreezeRequest {
    freeze_targets: MemoryFreezeTargetList;
    is_frozen: bool;
}

machine MemoryFreezeTargetList::head(memory_freeze_target_list: &MemoryFreezeTargetList) -> &MemoryFreezeTarget {
    &memory_freeze_target_list.targets[0]
}

pub machine MemoryFreezeRequest::new(
    freeze_targets: MemoryFreezeTargetList,
    is_frozen: bool
) -> MemoryFreezeRequest {
    MemoryFreezeRequest {
        freeze_targets: freeze_targets,
        is_frozen: is_frozen,
    }
}

pub machine MemoryFreezeRequest::get_freeze_targets(memory_freeze_request: &MemoryFreezeRequest) -> &MemoryFreezeTargetList {
    &memory_freeze_request.freeze_targets
}

pub machine MemoryFreezeRequest::get_is_frozen(memory_freeze_request: &MemoryFreezeRequest) -> bool {
    memory_freeze_request.is_frozen
}
