module src::commands::memory::freeze::memory_freeze_request;

use src::commands::memory::freeze::memory_freeze_target::MemoryFreezeTarget;

// Bounded `Vec<MemoryFreezeTarget>` — same shape as the port's other
// request lists (`ScanResultRefList`).
public data MemoryFreezeTargetList {
    targets: [MemoryFreezeTarget; 64];
    count: u64;
}

public machine MemoryFreezeTargetList::empty() -> MemoryFreezeTargetList {
    MemoryFreezeTargetList { count: 0 }
}

public machine MemoryFreezeTargetList::get_count(this: &MemoryFreezeTargetList) -> u64 {
    this.count
}

public machine MemoryFreezeTargetList::get_target(this: &MemoryFreezeTargetList, position: u64) -> &MemoryFreezeTarget {
    let hoist2: &MemoryFreezeTarget = MemoryFreezeTargetList::head(&this);
    let hoist1: &MemoryFreezeTarget = MemoryFreezeTargetList::head(&this);
    transition position < this.count && position < 64 {
        true -> at(this, position)
        false -> (hoist1)
        _ -> (hoist2)
    }
    state at(this: &MemoryFreezeTargetList, position: u64) -> &MemoryFreezeTarget
    requires 0 <= position && position < 64;
    {
        &this.targets[position]
    }
}

public machine MemoryFreezeTargetList::push(this: &mut MemoryFreezeTargetList, target: &MemoryFreezeTarget) -> bool {
    transition this.count < 64 {
        true -> store(this, target)
        false -> (false)
    }
    state store(this: &mut MemoryFreezeTargetList, target: &MemoryFreezeTarget) -> bool {
        this.targets[this.count] = MemoryFreezeTarget::clone(target);
        this.count = this.count + 1;
        true
    }
}

// Port of commands/memory/freeze/memory_freeze_request.rs: the toggle list
// plus the freeze/unfreeze flag.
public data MemoryFreezeRequest {
    freeze_targets: MemoryFreezeTargetList;
    is_frozen: bool;
}

machine MemoryFreezeTargetList::head(this: &MemoryFreezeTargetList) -> &MemoryFreezeTarget {
    &this.targets[0]
}

public machine MemoryFreezeRequest::new(
    freeze_targets: MemoryFreezeTargetList,
    is_frozen: bool
) -> MemoryFreezeRequest {
    MemoryFreezeRequest {
        freeze_targets: freeze_targets,
        is_frozen: is_frozen,
    }
}

public machine MemoryFreezeRequest::get_freeze_targets(this: &MemoryFreezeRequest) -> &MemoryFreezeTargetList {
    &this.freeze_targets
}

public machine MemoryFreezeRequest::get_is_frozen(this: &MemoryFreezeRequest) -> bool {
    this.is_frozen
}
