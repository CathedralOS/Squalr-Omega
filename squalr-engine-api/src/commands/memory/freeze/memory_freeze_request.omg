module src::commands::memory::freeze::memory_freeze_request;

use src::commands::memory::freeze::memory_freeze_target::MemoryFreezeTarget;

// Bounded `Vec<MemoryFreezeTarget>` — same shape as the port's other
// request lists (`ScanResultRefList`).
pub data MemoryFreezeTargetList {
    targets: [MemoryFreezeTarget; 64];
    count: u64;
}

pub machine MemoryFreezeTargetList::empty() -> MemoryFreezeTargetList {
    MemoryFreezeTargetList { count: 0 }
}

pub machine MemoryFreezeTargetList::get_count(&self) -> u64 {
    self.count
}

pub machine MemoryFreezeTargetList::get_target(&self, position: u64) -> &MemoryFreezeTarget {
    transition position < self.count && position < 64 {
        true -> at(position)
        false -> (self.head())
        _ -> (self.head())
    }
    state at(&self, position: u64) -> &MemoryFreezeTarget
    requires 0 <= position && position < 64;
    {
        &self.targets[position]
    }
}

pub machine MemoryFreezeTargetList::push(&mut self, target: &MemoryFreezeTarget) -> bool {
    transition self.count < 64 {
        true -> store(target)
        false -> (false)
    }
    state store(&mut self, target: &MemoryFreezeTarget) -> bool {
        self.targets[self.count] = MemoryFreezeTarget::clone(target);
        self.count = self.count + 1;
        true
    }
}

// Port of commands/memory/freeze/memory_freeze_request.rs: the toggle list
// plus the freeze/unfreeze flag.
pub data MemoryFreezeRequest {
    freeze_targets: MemoryFreezeTargetList;
    is_frozen: bool;
}

machine MemoryFreezeTargetList::head(&self) -> &MemoryFreezeTarget {
    &self.targets[0]
}

pub machine MemoryFreezeRequest::new(
    freeze_targets: MemoryFreezeTargetList,
    is_frozen: bool
) -> MemoryFreezeRequest {
    MemoryFreezeRequest {
        freeze_targets: freeze_targets,
        is_frozen: is_frozen,
    }
}

pub machine MemoryFreezeRequest::get_freeze_targets(&self) -> &MemoryFreezeTargetList {
    &self.freeze_targets
}

pub machine MemoryFreezeRequest::get_is_frozen(&self) -> bool {
    self.is_frozen
}
