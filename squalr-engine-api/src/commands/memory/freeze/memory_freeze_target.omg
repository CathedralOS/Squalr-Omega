module src::commands::memory::freeze::memory_freeze_target;

use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;

// Port of commands/memory/freeze/memory_freeze_target.rs. Upstream
// `module_name`/`data_type_id` are Strings — [u8;256]+len per the port's
// name convention; `pointer_offsets: Vec<i64>` folds to a bounded chain.
pub data MemoryFreezeTarget {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    data_type_id: [u8; 256];
    data_type_id_len: u64;
    pointer_offsets: [i64; 32];
    pointer_offset_count: u64;
    pointer_size: PointerScanPointerSize;
}

pub machine MemoryFreezeTarget::new(
    address: u64,
    module_name: &[u8],
    data_type_id: &[u8],
    pointer_size: PointerScanPointerSize
) -> MemoryFreezeTarget {
    let mut target: MemoryFreezeTarget = MemoryFreezeTarget {
        address: address,
        module_name_len: 0,
        data_type_id_len: 0,
        pointer_offset_count: 0,
        pointer_size: pointer_size,
    };
    MemoryFreezeTarget::set_module_name(&mut target, module_name);
    MemoryFreezeTarget::set_data_type_id(&mut target, data_type_id);
    target
}

pub machine MemoryFreezeTarget::clone(source: &MemoryFreezeTarget) -> MemoryFreezeTarget {
    transition source.module_name_len <= 256 && source.data_type_id_len <= 256 {
        true -> clone_fit(source)
        false -> clone_clamped(source)
        _ -> clone_clamped(source)
    }
    state clone_fit(source: &MemoryFreezeTarget) -> MemoryFreezeTarget {
        let mut target: MemoryFreezeTarget = MemoryFreezeTarget::new(
            source.address,
            &source.module_name[0..source.module_name_len],
            &source.data_type_id[0..source.data_type_id_len],
            source.pointer_size);
        MemoryFreezeTarget::copy_offsets(&mut target, source, 0);
        target
    }
    state clone_clamped(source: &MemoryFreezeTarget) -> MemoryFreezeTarget {
        let mut target: MemoryFreezeTarget = MemoryFreezeTarget::new(
            source.address,
            &source.module_name[0..256],
            &source.data_type_id[0..256],
            source.pointer_size);
        MemoryFreezeTarget::copy_offsets(&mut target, source, 0);
        target
    }
}

machine MemoryFreezeTarget::copy_offsets(this: &mut MemoryFreezeTarget, source: &MemoryFreezeTarget, position: u64) {
    transition { _ -> each(this, source, position) }
    state each(this: &mut MemoryFreezeTarget, source: &MemoryFreezeTarget, position: u64) {
        transition position < source.pointer_offset_count && position < 32 {
            true -> store(this, source, position)
            false -> done(this)
            _ -> done(this)
        }
    }
    state store(this: &mut MemoryFreezeTarget, source: &MemoryFreezeTarget, position: u64)
    requires 0 <= position && position < 32;
    {
        this.pointer_offsets[position] = source.pointer_offsets[position];
        this.pointer_offset_count = position + 1;
        transition { _ -> each(this, source, position + 1) }
    }
    state done(this: &mut MemoryFreezeTarget) {
    }
}

pub machine MemoryFreezeTarget::get_address(this: &MemoryFreezeTarget) -> u64 {
    this.address
}

pub machine MemoryFreezeTarget::get_module_name(this: &MemoryFreezeTarget) -> &[u8] {
    transition this.module_name_len <= 256 {
        true -> (&this.module_name[0..this.module_name_len])
        false -> (&this.module_name[0..256])
        _ -> (&this.module_name[0..256])
    }
}

pub machine MemoryFreezeTarget::get_data_type_id(this: &MemoryFreezeTarget) -> &[u8] {
    transition this.data_type_id_len <= 256 {
        true -> (&this.data_type_id[0..this.data_type_id_len])
        false -> (&this.data_type_id[0..256])
        _ -> (&this.data_type_id[0..256])
    }
}

pub machine MemoryFreezeTarget::get_pointer_offset_count(this: &MemoryFreezeTarget) -> u64 {
    this.pointer_offset_count
}

pub machine MemoryFreezeTarget::get_pointer_offset(this: &MemoryFreezeTarget, position: u64) -> i64 {
    transition position < this.pointer_offset_count && position < 32 {
        true -> (this.pointer_offsets[position])
        false -> (0)
    }
}

pub machine MemoryFreezeTarget::get_pointer_size(this: &MemoryFreezeTarget) -> PointerScanPointerSize {
    this.pointer_size
}

pub machine MemoryFreezeTarget::push_pointer_offset(this: &mut MemoryFreezeTarget, offset: i64) -> bool {
    transition this.pointer_offset_count < 32 {
        true -> store(this, offset)
        false -> (false)
    }
    state store(this: &mut MemoryFreezeTarget, offset: i64) -> bool {
        this.pointer_offsets[this.pointer_offset_count] = offset;
        this.pointer_offset_count = this.pointer_offset_count + 1;
        true
    }
}

machine MemoryFreezeTarget::set_module_name(this: &mut MemoryFreezeTarget, name: &[u8]) {
    let mut position: u64 = 0;
    this.module_name_len = 0;
    transition { _ -> copy(this, position, name) }
    state copy(this: &mut MemoryFreezeTarget, position: u64, name: &[u8]) {
        transition position < name.len && position < 256 {
            true -> step(this, position, name)
            false -> done(this)
        }
    }
    state step(this: &mut MemoryFreezeTarget, position: u64, name: &[u8]) {
        this.module_name[position] = name[position];
        this.module_name_len = position + 1;
        transition { _ -> copy(this, position + 1, name) }
    }
    state done(this: &mut MemoryFreezeTarget) {
        this.module_name_len = this.module_name_len;
    }
}

machine MemoryFreezeTarget::set_data_type_id(this: &mut MemoryFreezeTarget, id: &[u8]) {
    let mut position: u64 = 0;
    this.data_type_id_len = 0;
    transition { _ -> copy(this, position, id) }
    state copy(this: &mut MemoryFreezeTarget, position: u64, id: &[u8]) {
        transition position < id.len && position < 256 {
            true -> step(this, position, id)
            false -> done(this)
        }
    }
    state step(this: &mut MemoryFreezeTarget, position: u64, id: &[u8]) {
        this.data_type_id[position] = id[position];
        this.data_type_id_len = position + 1;
        transition { _ -> copy(this, position + 1, id) }
    }
    state done(this: &mut MemoryFreezeTarget) {
        this.data_type_id_len = this.data_type_id_len;
    }
}
