module src::commands::memory::freeze::memory_freeze_target;

use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;

// Port of commands/memory/freeze/memory_freeze_target.rs. Upstream
// `module_name`/`data_type_id` are Strings — [u8;256]+len per the port's
// name convention; `pointer_offsets: Vec<i64>` folds to a bounded chain.
pub data MemoryFreezeTarget {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    data_type_id: [u8; 256];
    data_type_id_len: u64;
    pointer_offsets: [i64; 32];
    pointer_offset_count: u64;
    pointer_size: PointerScanPointerSize;
}

pub machine MemoryFreezeTarget::new(
    address: u64,
    module_name: &[u8],
    data_type_id: &[u8],
    pointer_size: PointerScanPointerSize
) -> MemoryFreezeTarget {
    let mut target: MemoryFreezeTarget = MemoryFreezeTarget {
        address: address,
        module_name_len: 0,
        data_type_id_len: 0,
        pointer_offset_count: 0,
        pointer_size: pointer_size,
    };
    MemoryFreezeTarget::set_module_name(&mut target, module_name);
    MemoryFreezeTarget::set_data_type_id(&mut target, data_type_id);
    target
}

pub machine MemoryFreezeTarget::clone(source: &MemoryFreezeTarget) -> MemoryFreezeTarget {
    transition source.module_name_len <= 256 && source.data_type_id_len <= 256 {
        true -> clone_fit(source)
        false -> clone_clamped(source)
        _ -> clone_clamped(source)
    }
    state clone_fit(source: &MemoryFreezeTarget) -> MemoryFreezeTarget {
        let mut target: MemoryFreezeTarget = MemoryFreezeTarget::new(
            source.address,
            &source.module_name[0..source.module_name_len],
            &source.data_type_id[0..source.data_type_id_len],
            source.pointer_size);
        MemoryFreezeTarget::copy_offsets(&mut target, source, 0);
        target
    }
    state clone_clamped(source: &MemoryFreezeTarget) -> MemoryFreezeTarget {
        let mut target: MemoryFreezeTarget = MemoryFreezeTarget::new(
            source.address,
            &source.module_name[0..256],
            &source.data_type_id[0..256],
            source.pointer_size);
        MemoryFreezeTarget::copy_offsets(&mut target, source, 0);
        target
    }
}

machine MemoryFreezeTarget::copy_offsets(memory_freeze_target: &mut MemoryFreezeTarget, source: &MemoryFreezeTarget, position: u64) {
    transition { _ -> each(memory_freeze_target, source, position) }
    state each(memory_freeze_target: &mut MemoryFreezeTarget, source: &MemoryFreezeTarget, position: u64) {
        transition position < source.pointer_offset_count && position < 32 {
            true -> store(memory_freeze_target, source, position)
            false -> done(memory_freeze_target)
            _ -> done(memory_freeze_target)
        }
    }
    state store(memory_freeze_target: &mut MemoryFreezeTarget, source: &MemoryFreezeTarget, position: u64)
    requires 0 <= position && position < 32;
    {
        memory_freeze_target.pointer_offsets[position] = source.pointer_offsets[position];
        memory_freeze_target.pointer_offset_count = position + 1;
        transition { _ -> each(memory_freeze_target, source, position + 1) }
    }
    state done(memory_freeze_target: &mut MemoryFreezeTarget) {
    }
}

pub machine MemoryFreezeTarget::get_address(memory_freeze_target: &MemoryFreezeTarget) -> u64 {
    memory_freeze_target.address
}

pub machine MemoryFreezeTarget::get_module_name(memory_freeze_target: &MemoryFreezeTarget) -> &[u8] {
    transition memory_freeze_target.module_name_len <= 256 {
        true -> (&memory_freeze_target.module_name[0..memory_freeze_target.module_name_len])
        false -> (&memory_freeze_target.module_name[0..256])
        _ -> (&memory_freeze_target.module_name[0..256])
    }
}

pub machine MemoryFreezeTarget::get_data_type_id(memory_freeze_target: &MemoryFreezeTarget) -> &[u8] {
    transition memory_freeze_target.data_type_id_len <= 256 {
        true -> (&memory_freeze_target.data_type_id[0..memory_freeze_target.data_type_id_len])
        false -> (&memory_freeze_target.data_type_id[0..256])
        _ -> (&memory_freeze_target.data_type_id[0..256])
    }
}

pub machine MemoryFreezeTarget::get_pointer_offset_count(memory_freeze_target: &MemoryFreezeTarget) -> u64 {
    memory_freeze_target.pointer_offset_count
}

pub machine MemoryFreezeTarget::get_pointer_offset(memory_freeze_target: &MemoryFreezeTarget, position: u64) -> i64 {
    transition position < memory_freeze_target.pointer_offset_count && position < 32 {
        true -> (memory_freeze_target.pointer_offsets[position])
        false -> (0)
    }
}

pub machine MemoryFreezeTarget::get_pointer_size(memory_freeze_target: &MemoryFreezeTarget) -> PointerScanPointerSize {
    memory_freeze_target.pointer_size
}

pub machine MemoryFreezeTarget::push_pointer_offset(memory_freeze_target: &mut MemoryFreezeTarget, offset: i64) -> bool {
    transition memory_freeze_target.pointer_offset_count < 32 {
        true -> store(memory_freeze_target, offset)
        false -> (false)
    }
    state store(memory_freeze_target: &mut MemoryFreezeTarget, offset: i64) -> bool {
        memory_freeze_target.pointer_offsets[memory_freeze_target.pointer_offset_count] = offset;
        memory_freeze_target.pointer_offset_count = memory_freeze_target.pointer_offset_count + 1;
        true
    }
}

machine MemoryFreezeTarget::set_module_name(memory_freeze_target: &mut MemoryFreezeTarget, name: &[u8]) {
    let mut position: u64 = 0;
    memory_freeze_target.module_name_len = 0;
    transition { _ -> copy(memory_freeze_target, position, name) }
    state copy(memory_freeze_target: &mut MemoryFreezeTarget, position: u64, name: &[u8]) {
        transition position < name.len && position < 256 {
            true -> step(memory_freeze_target, position, name)
            false -> done(memory_freeze_target)
        }
    }
    state step(memory_freeze_target: &mut MemoryFreezeTarget, position: u64, name: &[u8]) {
        memory_freeze_target.module_name[position] = name[position];
        memory_freeze_target.module_name_len = position + 1;
        transition { _ -> copy(memory_freeze_target, position + 1, name) }
    }
    state done(memory_freeze_target: &mut MemoryFreezeTarget) {
        memory_freeze_target.module_name_len = memory_freeze_target.module_name_len;
    }
}

machine MemoryFreezeTarget::set_data_type_id(memory_freeze_target: &mut MemoryFreezeTarget, id: &[u8]) {
    let mut position: u64 = 0;
    memory_freeze_target.data_type_id_len = 0;
    transition { _ -> copy(memory_freeze_target, position, id) }
    state copy(memory_freeze_target: &mut MemoryFreezeTarget, position: u64, id: &[u8]) {
        transition position < id.len && position < 256 {
            true -> step(memory_freeze_target, position, id)
            false -> done(memory_freeze_target)
        }
    }
    state step(memory_freeze_target: &mut MemoryFreezeTarget, position: u64, id: &[u8]) {
        memory_freeze_target.data_type_id[position] = id[position];
        memory_freeze_target.data_type_id_len = position + 1;
        transition { _ -> copy(memory_freeze_target, position + 1, id) }
    }
    state done(memory_freeze_target: &mut MemoryFreezeTarget) {
        memory_freeze_target.data_type_id_len = memory_freeze_target.data_type_id_len;
    }
}
