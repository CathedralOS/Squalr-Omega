module src::commands::memory::freeze::memory_freeze_target;

use src::structures::bounded_slice::bounded_slice;

use src::structures::data_values::pointer_scan_pointer_size::PointerScanPointerSize;
use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/memory/freeze/memory_freeze_target.rs. Upstream
// `module_name`/`data_type_id` are Strings — [u8;256]+len per the port's
// name convention; `pointer_offsets: Vec<i64>` folds to a bounded chain.
pub data MemoryFreezeTarget {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    data_type_id: [u8; 256];
    data_type_id_len: u64;
    pointer_offsets: [i64; 32];
    pointer_offset_count: u64;
    pointer_size: PointerScanPointerSize;
}

pub machine MemoryFreezeTarget::new(
    address: u64,
    module_name: &[u8],
    data_type_id: &[u8],
    pointer_size: PointerScanPointerSize
) -> MemoryFreezeTarget {
    let mut target: MemoryFreezeTarget = MemoryFreezeTarget {
        address: address,
        module_name_len: 0,
        data_type_id_len: 0,
        pointer_offset_count: 0,
        pointer_size: pointer_size,
    };
    target.set_module_name(module_name);
    target.set_data_type_id(data_type_id);
    target
}

pub machine MemoryFreezeTarget::clone(source: &MemoryFreezeTarget) -> MemoryFreezeTarget {
    transition source.module_name_len <= 256 && source.data_type_id_len <= 256 {
        true -> clone_fit(source)
        false -> clone_clamped(source)
        _ -> clone_clamped(source)
    }
    state clone_fit(source: &MemoryFreezeTarget) -> MemoryFreezeTarget {
        let mut target: MemoryFreezeTarget = MemoryFreezeTarget::new(
            source.address,
            &source.module_name[0..source.module_name_len],
            &source.data_type_id[0..source.data_type_id_len],
            source.pointer_size);
        target.copy_offsets(source, 0);
        target
    }
    state clone_clamped(source: &MemoryFreezeTarget) -> MemoryFreezeTarget {
        let mut target: MemoryFreezeTarget = MemoryFreezeTarget::new(
            source.address,
            &source.module_name[0..256],
            &source.data_type_id[0..256],
            source.pointer_size);
        target.copy_offsets(source, 0);
        target
    }
}

machine MemoryFreezeTarget::copy_offsets(&mut self, source: &MemoryFreezeTarget, position: u64) {
    transition { _ -> each(source, position) }
    state each(&mut self, source: &MemoryFreezeTarget, position: u64) {
        transition position < source.pointer_offset_count && position < 32 {
            true -> store(source, position)
            false -> done()
            _ -> done()
        }
    }
    state store(&mut self, source: &MemoryFreezeTarget, position: u64)
    requires 0 <= position && position < 32;
    {
        self.pointer_offsets[position] = source.pointer_offsets[position];
        self.pointer_offset_count = position + 1;
        transition { _ -> each(source, position + 1) }
    }
    state done(&mut self) {
    }
}

pub machine MemoryFreezeTarget::get_address(&self) -> u64 {
    self.address
}

pub machine MemoryFreezeTarget::get_module_name(&self) -> &[u8] {
    bounded_slice(&self.module_name[0..256], self.module_name_len)
}

pub machine MemoryFreezeTarget::get_data_type_id(&self) -> &[u8] {
    bounded_slice(&self.data_type_id[0..256], self.data_type_id_len)
}

pub machine MemoryFreezeTarget::get_pointer_offset_count(&self) -> u64 {
    self.pointer_offset_count
}

pub machine MemoryFreezeTarget::get_pointer_offset(&self, position: u64) -> i64 {
    transition position < self.pointer_offset_count && position < 32 {
        true -> (self.pointer_offsets[position])
        false -> (0)
    }
}

pub machine MemoryFreezeTarget::get_pointer_size(&self) -> PointerScanPointerSize {
    self.pointer_size
}

pub machine MemoryFreezeTarget::push_pointer_offset(&mut self, offset: i64) -> bool {
    transition self.pointer_offset_count < 32 {
        true -> store(offset)
        false -> (false)
    }
    state store(&mut self, offset: i64) -> bool {
        self.pointer_offsets[self.pointer_offset_count] = offset;
        self.pointer_offset_count = self.pointer_offset_count + 1;
        true
    }
}

machine MemoryFreezeTarget::set_module_name(&mut self, name: &[u8]) {
    self.module_name_len = BoundedByteCopy::copy(&mut self.module_name[0..256], name);
}

machine MemoryFreezeTarget::set_data_type_id(&mut self, id: &[u8]) {
    self.data_type_id_len = BoundedByteCopy::copy(&mut self.data_type_id[0..256], id);
}
