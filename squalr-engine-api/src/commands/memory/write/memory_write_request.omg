module src::commands::memory::write::memory_write_request;
use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::bounded_slice::bounded_slice;

// Port of commands/memory/write/memory_write_request.rs — Raw vs the
// checked-code path upstream dispatches through the settings table.
pub data MemoryWriteMode [copy] {
    case Raw;
    case CheckedCode;
}

pub machine MemoryWriteMode::default() -> MemoryWriteMode {
    MemoryWriteMode::Raw
}

// `value: Vec<u8>` folds to a bounded byte buffer + count per the port's
// collection convention.
pub data MemoryWriteRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    value: [u8; 4096];
    value_len: u64;
    write_mode: MemoryWriteMode;
}

pub machine MemoryWriteRequest::new(
    address: u64,
    module_name: &[u8],
    value: &[u8],
    write_mode: MemoryWriteMode
) -> MemoryWriteRequest {
    let mut request: MemoryWriteRequest = MemoryWriteRequest {
        address: address,
        module_name_len: 0,
        value_len: 0,
        write_mode: write_mode,
    };
    request.set_module_name(module_name);
    request.set_value(value);
    request
}

pub machine MemoryWriteRequest::get_address(&self) -> u64 {
    self.address
}

pub machine MemoryWriteRequest::get_module_name(&self) -> &[u8] {
    bounded_slice(&self.module_name[0..256], self.module_name_len)
}

pub machine MemoryWriteRequest::get_value(&self) -> &[u8] {
    bounded_slice(&self.value[0..4096], self.value_len)
}

pub machine MemoryWriteRequest::get_value_len(&self) -> u64 {
    self.value_len
}

pub machine MemoryWriteRequest::value_byte_at(&self, position: u64) -> u8 {
    transition position < self.value_len && position < 4096 {
        true -> at(position)
        false -> (0)
        _ -> (0)
    }
    state at(&self, position: u64) -> u8
    requires 0 <= position && position < 4096;
    {
        self.value[position]
    }
}

pub machine MemoryWriteRequest::get_write_mode(&self) -> MemoryWriteMode {
    self.write_mode
}

machine MemoryWriteRequest::set_module_name(&mut self, name: &[u8]) {
    self.module_name_len = BoundedByteCopy::copy(&mut self.module_name[0..256], name);
}

machine MemoryWriteRequest::set_value(&mut self, value: &[u8]) {
    self.value_len = BoundedByteCopy::copy(&mut self.value[0..4096], value);
}
