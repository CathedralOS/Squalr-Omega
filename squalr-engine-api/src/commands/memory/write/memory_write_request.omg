module src::commands::memory::write::memory_write_request;

// Port of commands/memory/write/memory_write_request.rs — Raw vs the
// checked-code path upstream dispatches through the settings table.
pub data MemoryWriteMode [copy] {
    case Raw;
    case CheckedCode;
}

pub machine MemoryWriteMode::default() -> MemoryWriteMode {
    MemoryWriteMode::Raw
}

// `value: Vec<u8>` folds to a bounded byte buffer + count per the port's
// collection convention.
pub data MemoryWriteRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    value: [u8; 4096];
    value_len: u64;
    write_mode: MemoryWriteMode;
}

pub machine MemoryWriteRequest::new(
    address: u64,
    module_name: &[u8],
    value: &[u8],
    write_mode: MemoryWriteMode
) -> MemoryWriteRequest {
    let mut request: MemoryWriteRequest = MemoryWriteRequest {
        address: address,
        module_name_len: 0,
        value_len: 0,
        write_mode: write_mode,
    };
    request.set_module_name(module_name);
    request.set_value(value);
    request
}

pub machine MemoryWriteRequest::get_address(&self) -> u64 {
    self.address
}

pub machine MemoryWriteRequest::get_module_name(&self) -> &[u8] {
    transition self.module_name_len <= 256 {
        true -> (&self.module_name[0..self.module_name_len])
        false -> (&self.module_name[0..256])
        _ -> (&self.module_name[0..256])
    }
}

pub machine MemoryWriteRequest::get_value(&self) -> &[u8] {
    transition self.value_len <= 4096 {
        true -> (&self.value[0..self.value_len])
        false -> (&self.value[0..4096])
        _ -> (&self.value[0..4096])
    }
}

pub machine MemoryWriteRequest::get_value_len(&self) -> u64 {
    self.value_len
}

pub machine MemoryWriteRequest::value_byte_at(&self, position: u64) -> u8 {
    transition position < self.value_len && position < 4096 {
        true -> at(position)
        false -> (0)
        _ -> (0)
    }
    state at(&self, position: u64) -> u8
    requires 0 <= position && position < 4096;
    {
        self.value[position]
    }
}

pub machine MemoryWriteRequest::get_write_mode(&self) -> MemoryWriteMode {
    self.write_mode
}

machine MemoryWriteRequest::set_module_name(&mut self, name: &[u8]) {
    let mut position: u64 = 0;
    transition { _ -> copy(position, name) }
    state copy(&mut self, position: u64, name: &[u8]) {
        transition position < name.len && position < 256 {
            true -> step(position, name)
            false -> done()
        }
    }
    state step(&mut self, position: u64, name: &[u8]) {
        self.module_name[position] = name[position];
        self.module_name_len = position + 1;
        transition { _ -> copy(position + 1, name) }
    }
    state done(&mut self) {
        self.module_name_len = self.module_name_len;
    }
}

machine MemoryWriteRequest::set_value(&mut self, value: &[u8]) {
    let mut position: u64 = 0;
    transition { _ -> copy(position, value) }
    state copy(&mut self, position: u64, value: &[u8]) {
        transition position < value.len && position < 4096 {
            true -> step(position, value)
            false -> done()
        }
    }
    state step(&mut self, position: u64, value: &[u8]) {
        self.value[position] = value[position];
        self.value_len = position + 1;
        transition { _ -> copy(position + 1, value) }
    }
    state done(&mut self) {
        self.value_len = self.value_len;
    }
}
