module src::commands::memory::write::memory_write_request;

// Port of commands/memory/write/memory_write_request.rs — Raw vs the
// checked-code path upstream dispatches through the settings table.
pub data MemoryWriteMode [copy] {
    case Raw;
    case CheckedCode;
}

pub machine MemoryWriteMode::default() -> MemoryWriteMode {
    MemoryWriteMode::Raw
}

// `value: Vec<u8>` folds to a bounded byte buffer + count per the port's
// collection convention.
pub data MemoryWriteRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    value: [u8; 4096];
    value_len: u64;
    write_mode: MemoryWriteMode;
}

pub machine MemoryWriteRequest::new(
    address: u64,
    module_name: &[u8],
    value: &[u8],
    write_mode: MemoryWriteMode
) -> MemoryWriteRequest {
    let mut request: MemoryWriteRequest = MemoryWriteRequest {
        address: address,
        module_name_len: 0,
        value_len: 0,
        write_mode: write_mode,
    };
    MemoryWriteRequest::set_module_name(&mut request, module_name);
    MemoryWriteRequest::set_value(&mut request, value);
    request
}

pub machine MemoryWriteRequest::get_address(memory_write_request: &MemoryWriteRequest) -> u64 {
    memory_write_request.address
}

pub machine MemoryWriteRequest::get_module_name(memory_write_request: &MemoryWriteRequest) -> &[u8] {
    transition memory_write_request.module_name_len <= 256 {
        true -> (&memory_write_request.module_name[0..memory_write_request.module_name_len])
        false -> (&memory_write_request.module_name[0..256])
        _ -> (&memory_write_request.module_name[0..256])
    }
}

pub machine MemoryWriteRequest::get_value(memory_write_request: &MemoryWriteRequest) -> &[u8] {
    transition memory_write_request.value_len <= 4096 {
        true -> (&memory_write_request.value[0..memory_write_request.value_len])
        false -> (&memory_write_request.value[0..4096])
        _ -> (&memory_write_request.value[0..4096])
    }
}

pub machine MemoryWriteRequest::get_value_len(memory_write_request: &MemoryWriteRequest) -> u64 {
    memory_write_request.value_len
}

pub machine MemoryWriteRequest::value_byte_at(memory_write_request: &MemoryWriteRequest, position: u64) -> u8 {
    transition position < memory_write_request.value_len && position < 4096 {
        true -> at(memory_write_request, position)
        false -> (0)
        _ -> (0)
    }
    state at(memory_write_request: &MemoryWriteRequest, position: u64) -> u8
    requires 0 <= position && position < 4096;
    {
        memory_write_request.value[position]
    }
}

pub machine MemoryWriteRequest::get_write_mode(memory_write_request: &MemoryWriteRequest) -> MemoryWriteMode {
    memory_write_request.write_mode
}

machine MemoryWriteRequest::set_module_name(memory_write_request: &mut MemoryWriteRequest, name: &[u8]) {
    let mut position: u64 = 0;
    transition { _ -> copy(memory_write_request, position, name) }
    state copy(memory_write_request: &mut MemoryWriteRequest, position: u64, name: &[u8]) {
        transition position < name.len && position < 256 {
            true -> step(memory_write_request, position, name)
            false -> done(memory_write_request)
        }
    }
    state step(memory_write_request: &mut MemoryWriteRequest, position: u64, name: &[u8]) {
        memory_write_request.module_name[position] = name[position];
        memory_write_request.module_name_len = position + 1;
        transition { _ -> copy(memory_write_request, position + 1, name) }
    }
    state done(memory_write_request: &mut MemoryWriteRequest) {
        memory_write_request.module_name_len = memory_write_request.module_name_len;
    }
}

machine MemoryWriteRequest::set_value(memory_write_request: &mut MemoryWriteRequest, value: &[u8]) {
    let mut position: u64 = 0;
    transition { _ -> copy(memory_write_request, position, value) }
    state copy(memory_write_request: &mut MemoryWriteRequest, position: u64, value: &[u8]) {
        transition position < value.len && position < 4096 {
            true -> step(memory_write_request, position, value)
            false -> done(memory_write_request)
        }
    }
    state step(memory_write_request: &mut MemoryWriteRequest, position: u64, value: &[u8]) {
        memory_write_request.value[position] = value[position];
        memory_write_request.value_len = position + 1;
        transition { _ -> copy(memory_write_request, position + 1, value) }
    }
    state done(memory_write_request: &mut MemoryWriteRequest) {
        memory_write_request.value_len = memory_write_request.value_len;
    }
}

pub machine MemoryWriteRequest::clone(memory_write_request: &MemoryWriteRequest) -> MemoryWriteRequest {
    transition { _ -> parts(memory_write_request) }
    state parts(memory_write_request: &MemoryWriteRequest) -> MemoryWriteRequest {
        let module_text: &[u8] = MemoryWriteRequest::get_module_name(memory_write_request);
        let value_text: &[u8] = MemoryWriteRequest::get_value(memory_write_request);
        (MemoryWriteRequest::new(
            memory_write_request.address,
            module_text,
            value_text,
            memory_write_request.write_mode))
    }
}
