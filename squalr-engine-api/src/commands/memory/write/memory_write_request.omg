module src::commands::memory::write::memory_write_request;

// Port of commands/memory/write/memory_write_request.rs — Raw vs the
// checked-code path upstream dispatches through the settings table.
pub data MemoryWriteMode [copy] {
    case Raw;
    case CheckedCode;
}

pub machine MemoryWriteMode::default() -> MemoryWriteMode {
    MemoryWriteMode::Raw
}

// `value: Vec<u8>` folds to a bounded byte buffer + count per the port's
// collection convention.
pub data MemoryWriteRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    value: [u8; 4096];
    value_len: u64;
    write_mode: MemoryWriteMode;
}

pub machine MemoryWriteRequest::new(
    address: u64,
    module_name: &[u8],
    value: &[u8],
    write_mode: MemoryWriteMode
) -> MemoryWriteRequest {
    let mut request: MemoryWriteRequest = MemoryWriteRequest {
        address: address,
        module_name_len: 0,
        value_len: 0,
        write_mode: write_mode,
    };
    MemoryWriteRequest::set_module_name(&mut request, module_name);
    MemoryWriteRequest::set_value(&mut request, value);
    request
}

pub machine MemoryWriteRequest::get_address(this: &MemoryWriteRequest) -> u64 {
    this.address
}

pub machine MemoryWriteRequest::get_module_name(this: &MemoryWriteRequest) -> &[u8] {
    transition this.module_name_len <= 256 {
        true -> (&this.module_name[0..this.module_name_len])
        false -> (&this.module_name[0..256])
        _ -> (&this.module_name[0..256])
    }
}

pub machine MemoryWriteRequest::get_value(this: &MemoryWriteRequest) -> &[u8] {
    transition this.value_len <= 4096 {
        true -> (&this.value[0..this.value_len])
        false -> (&this.value[0..4096])
        _ -> (&this.value[0..4096])
    }
}

pub machine MemoryWriteRequest::get_value_len(this: &MemoryWriteRequest) -> u64 {
    this.value_len
}

pub machine MemoryWriteRequest::value_byte_at(this: &MemoryWriteRequest, position: u64) -> u8 {
    transition position < this.value_len && position < 4096 {
        true -> at(this, position)
        false -> (0)
        _ -> (0)
    }
    state at(this: &MemoryWriteRequest, position: u64) -> u8
    requires 0 <= position && position < 4096;
    {
        this.value[position]
    }
}

pub machine MemoryWriteRequest::get_write_mode(this: &MemoryWriteRequest) -> MemoryWriteMode {
    this.write_mode
}

machine MemoryWriteRequest::set_module_name(this: &mut MemoryWriteRequest, name: &[u8]) {
    let mut position: u64 = 0;
    transition { _ -> copy(this, position, name) }
    state copy(this: &mut MemoryWriteRequest, position: u64, name: &[u8]) {
        transition position < name.len && position < 256 {
            true -> step(this, position, name)
            false -> done(this)
        }
    }
    state step(this: &mut MemoryWriteRequest, position: u64, name: &[u8]) {
        this.module_name[position] = name[position];
        this.module_name_len = position + 1;
        transition { _ -> copy(this, position + 1, name) }
    }
    state done(this: &mut MemoryWriteRequest) {
        this.module_name_len = this.module_name_len;
    }
}

machine MemoryWriteRequest::set_value(this: &mut MemoryWriteRequest, value: &[u8]) {
    let mut position: u64 = 0;
    transition { _ -> copy(this, position, value) }
    state copy(this: &mut MemoryWriteRequest, position: u64, value: &[u8]) {
        transition position < value.len && position < 4096 {
            true -> step(this, position, value)
            false -> done(this)
        }
    }
    state step(this: &mut MemoryWriteRequest, position: u64, value: &[u8]) {
        this.value[position] = value[position];
        this.value_len = position + 1;
        transition { _ -> copy(this, position + 1, value) }
    }
    state done(this: &mut MemoryWriteRequest) {
        this.value_len = this.value_len;
    }
}
