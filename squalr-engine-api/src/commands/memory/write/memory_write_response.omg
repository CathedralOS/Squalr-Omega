module src::commands::memory::write::memory_write_response;

// Port of commands/memory/write/memory_write_response.rs — `error:
// Option<String>` folds to `has_error` + a bounded message buffer.
pub data MemoryWriteResponse {
    success: bool;
    has_error: bool;
    error: [u8; 256];
    error_len: u64;
}

pub machine MemoryWriteResponse::new(success: bool, error: &[u8]) -> MemoryWriteResponse {
    let mut response: MemoryWriteResponse = MemoryWriteResponse {
        success: success,
        has_error: error.len > 0,
        error_len: 0,
    };
    MemoryWriteResponse::set_error(&mut response, error);
    response
}

pub machine MemoryWriteResponse::ok() -> MemoryWriteResponse {
    MemoryWriteResponse {
        success: true,
        has_error: false,
        error_len: 0,
    }
}

pub machine MemoryWriteResponse::get_success(this: &MemoryWriteResponse) -> bool {
    this.success
}

pub machine MemoryWriteResponse::get_has_error(this: &MemoryWriteResponse) -> bool {
    this.has_error
}

pub machine MemoryWriteResponse::get_error(this: &MemoryWriteResponse) -> &[u8] {
    transition this.error_len <= 256 {
        true -> (&this.error[0..this.error_len])
        false -> (&this.error[0..256])
        _ -> (&this.error[0..256])
    }
}

machine MemoryWriteResponse::set_error(this: &mut MemoryWriteResponse, error: &[u8]) {
    let mut position: u64 = 0;
    transition { _ -> copy(this, position, error) }
    state copy(this: &mut MemoryWriteResponse, position: u64, error: &[u8]) {
        transition position < error.len && position < 256 {
            true -> step(this, position, error)
            false -> done(this)
        }
    }
    state step(this: &mut MemoryWriteResponse, position: u64, error: &[u8]) {
        this.error[position] = error[position];
        this.error_len = position + 1;
        transition { _ -> copy(this, position + 1, error) }
    }
    state done(this: &mut MemoryWriteResponse) {
        this.error_len = this.error_len;
    }
}
