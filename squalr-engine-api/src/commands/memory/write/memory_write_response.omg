module src::commands::memory::write::memory_write_response;
use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::bounded_slice::bounded_slice;

// Port of commands/memory/write/memory_write_response.rs — `error:
// Option<String>` folds to `has_error` + a bounded message buffer.
pub data MemoryWriteResponse {
    success: bool;
    has_error: bool;
    error: [u8; 256];
    error_len: u64;
}

pub machine MemoryWriteResponse::new(success: bool, error: &[u8]) -> MemoryWriteResponse {
    let mut response: MemoryWriteResponse = MemoryWriteResponse {
        success: success,
        has_error: error.len > 0,
        error_len: 0,
    };
    response.set_error(error);
    response
}

pub machine MemoryWriteResponse::ok() -> MemoryWriteResponse {
    MemoryWriteResponse {
        success: true,
        has_error: false,
        error_len: 0,
    }
}

pub machine MemoryWriteResponse::get_success(&self) -> bool {
    self.success
}

pub machine MemoryWriteResponse::get_has_error(&self) -> bool {
    self.has_error
}

pub machine MemoryWriteResponse::get_error(&self) -> &[u8] {
    bounded_slice(&self.error[0..256], self.error_len)
}

machine MemoryWriteResponse::set_error(&mut self, error: &[u8]) {
    self.error_len = BoundedByteCopy::copy(&mut self.error[0..256], error);
}
