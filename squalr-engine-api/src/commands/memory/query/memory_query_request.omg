use src/plugins/memory_view/page_retrieval_mode.omg;

// Port of commands/memory/query/memory_query_request.rs — upstream Default
// selects FromUserMode.
public data MemoryQueryRequest {
    page_retrieval_mode: |page_retrieval_mode|::PageRetrievalMode;
}

public machine MemoryQueryRequest::new(
    page_retrieval_mode: |page_retrieval_mode|::PageRetrievalMode
) -> MemoryQueryRequest {
    MemoryQueryRequest {
        page_retrieval_mode: page_retrieval_mode,
    }
}

public machine MemoryQueryRequest::default() -> MemoryQueryRequest {
    MemoryQueryRequest {
        page_retrieval_mode: |page_retrieval_mode|::PageRetrievalMode::default(),
    }
}

public machine MemoryQueryRequest::get_page_retrieval_mode(this: &MemoryQueryRequest) -> |page_retrieval_mode|::PageRetrievalMode {
    this.page_retrieval_mode
}
