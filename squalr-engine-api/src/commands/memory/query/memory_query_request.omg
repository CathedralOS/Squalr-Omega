module src::commands::memory::query::memory_query_request;

use src::plugins::memory_view::page_retrieval_mode::PageRetrievalMode;

// Port of commands/memory/query/memory_query_request.rs — upstream Default
// selects FromUserMode.
pub data MemoryQueryRequest {
    page_retrieval_mode: PageRetrievalMode;
}

pub machine MemoryQueryRequest::new(
    page_retrieval_mode: PageRetrievalMode
) -> MemoryQueryRequest {
    MemoryQueryRequest {
        page_retrieval_mode: page_retrieval_mode,
    }
}

pub machine MemoryQueryRequest::default() -> MemoryQueryRequest {
    MemoryQueryRequest {
        page_retrieval_mode: PageRetrievalMode::default(),
    }
}

pub machine MemoryQueryRequest::get_page_retrieval_mode(memory_query_request: &MemoryQueryRequest) -> PageRetrievalMode {
    memory_query_request.page_retrieval_mode
}
