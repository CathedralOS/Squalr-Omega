module src::commands::memory::query::memory_query_response;

use src::structures::memory::normalized_module::NormalizedModule;
use src::structures::memory::normalized_region::NormalizedRegion;

// Port of commands/memory/query/memory_query_response.rs. Upstream
// `virtual_pages`/`modules` are Vecs — bounded lists with counts per the
// port's collection convention.
pub data MemoryQueryResponse {
    virtual_pages: [NormalizedRegion; 64];
    virtual_page_count: u64;
    modules: [NormalizedModule; 64];
    module_count: u64;
    success: bool;
}

pub machine MemoryQueryResponse::new(success: bool) -> MemoryQueryResponse {
    MemoryQueryResponse {
        virtual_page_count: 0,
        module_count: 0,
        success: success,
    }
}

pub machine MemoryQueryResponse::clone(source: &MemoryQueryResponse) -> MemoryQueryResponse {
    let mut copy: MemoryQueryResponse = MemoryQueryResponse {
        virtual_page_count: 0,
        module_count: 0,
        success: source.success,
    };
    MemoryQueryResponse::copy_pages(&mut copy, source, 0);
    MemoryQueryResponse::copy_modules(&mut copy, source, 0);
    copy
}

pub machine MemoryQueryResponse::get_virtual_page_count(memory_query_response: &MemoryQueryResponse) -> u64 {
    memory_query_response.virtual_page_count
}

pub machine MemoryQueryResponse::get_virtual_page(memory_query_response: &MemoryQueryResponse, position: u64) -> &NormalizedRegion {
    transition position < memory_query_response.virtual_page_count && position < 64 {
        true -> at(memory_query_response, position)
        false -> (MemoryQueryResponse::head_page(memory_query_response))
        _ -> (MemoryQueryResponse::head_page(memory_query_response))
    }
    state at(memory_query_response: &MemoryQueryResponse, position: u64) -> &NormalizedRegion
    requires 0 <= position && position < 64;
    {
        &memory_query_response.virtual_pages[position]
    }
}

machine MemoryQueryResponse::head_page(memory_query_response: &MemoryQueryResponse) -> &NormalizedRegion {
    &memory_query_response.virtual_pages[0]
}

pub machine MemoryQueryResponse::push_virtual_page(memory_query_response: &mut MemoryQueryResponse, region: &NormalizedRegion) -> bool {
    transition memory_query_response.virtual_page_count < 64 {
        true -> store(memory_query_response, region)
        false -> (false)
    }
    state store(memory_query_response: &mut MemoryQueryResponse, region: &NormalizedRegion) -> bool {
        memory_query_response.virtual_pages[memory_query_response.virtual_page_count] = NormalizedRegion::clone(region);
        memory_query_response.virtual_page_count = memory_query_response.virtual_page_count + 1;
        true
    }
}

pub machine MemoryQueryResponse::get_module_count(memory_query_response: &MemoryQueryResponse) -> u64 {
    memory_query_response.module_count
}

pub machine MemoryQueryResponse::get_module(memory_query_response: &MemoryQueryResponse, position: u64) -> &NormalizedModule {
    transition position < memory_query_response.module_count && position < 64 {
        true -> at(memory_query_response, position)
        false -> (MemoryQueryResponse::head_module(memory_query_response))
        _ -> (MemoryQueryResponse::head_module(memory_query_response))
    }
    state at(memory_query_response: &MemoryQueryResponse, position: u64) -> &NormalizedModule
    requires 0 <= position && position < 64;
    {
        &memory_query_response.modules[position]
    }
}

machine MemoryQueryResponse::head_module(memory_query_response: &MemoryQueryResponse) -> &NormalizedModule {
    &memory_query_response.modules[0]
}

pub machine MemoryQueryResponse::push_module(memory_query_response: &mut MemoryQueryResponse, module: &NormalizedModule) -> bool {
    transition memory_query_response.module_count < 64 {
        true -> store(memory_query_response, module)
        false -> (false)
    }
    state store(memory_query_response: &mut MemoryQueryResponse, module: &NormalizedModule) -> bool {
        NormalizedModule::clone_from(&mut memory_query_response.modules[memory_query_response.module_count], module);
        memory_query_response.module_count = memory_query_response.module_count + 1;
        true
    }
}

pub machine MemoryQueryResponse::get_success(memory_query_response: &MemoryQueryResponse) -> bool {
    memory_query_response.success
}

machine MemoryQueryResponse::copy_pages(
    memory_query_response: &mut MemoryQueryResponse,
    source: &MemoryQueryResponse,
    position: u64
) {
    transition { _ -> each(memory_query_response, source, position) }
    state each(memory_query_response: &mut MemoryQueryResponse, source: &MemoryQueryResponse, position: u64) {
        transition position < source.virtual_page_count && position < 64 {
            true -> store(memory_query_response, source, position)
            false -> done(memory_query_response)
            _ -> done(memory_query_response)
        }
    }
    state store(memory_query_response: &mut MemoryQueryResponse, source: &MemoryQueryResponse, position: u64)
    requires 0 <= position && position < 64;
    {
        memory_query_response.virtual_pages[position] = NormalizedRegion::clone(&source.virtual_pages[position]);
        memory_query_response.virtual_page_count = position + 1;
        transition { _ -> each(memory_query_response, source, position + 1) }
    }
    state done(memory_query_response: &mut MemoryQueryResponse) {
    }
}

machine MemoryQueryResponse::copy_modules(
    memory_query_response: &mut MemoryQueryResponse,
    source: &MemoryQueryResponse,
    position: u64
) {
    transition { _ -> each(memory_query_response, source, position) }
    state each(memory_query_response: &mut MemoryQueryResponse, source: &MemoryQueryResponse, position: u64) {
        transition position < source.module_count && position < 64 {
            true -> store(memory_query_response, source, position)
            false -> done(memory_query_response)
            _ -> done(memory_query_response)
        }
    }
    state store(memory_query_response: &mut MemoryQueryResponse, source: &MemoryQueryResponse, position: u64)
    requires 0 <= position && position < 64;
    {
        NormalizedModule::clone_from(&mut memory_query_response.modules[position], &source.modules[position]);
        memory_query_response.module_count = position + 1;
        transition { _ -> each(memory_query_response, source, position + 1) }
    }
    state done(memory_query_response: &mut MemoryQueryResponse) {
    }
}
