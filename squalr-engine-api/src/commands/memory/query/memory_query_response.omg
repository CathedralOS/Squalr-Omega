module src::commands::memory::query::memory_query_response;

use src::structures::memory::normalized_module::NormalizedModule;
use src::structures::memory::normalized_region::NormalizedRegion;

// Port of commands/memory/query/memory_query_response.rs. Upstream
// `virtual_pages`/`modules` are Vecs — bounded lists with counts per the
// port's collection convention.
pub data MemoryQueryResponse {
    virtual_pages: [NormalizedRegion; 64];
    virtual_page_count: u64;
    modules: [NormalizedModule; 64];
    module_count: u64;
    success: bool;
}

pub machine MemoryQueryResponse::new(success: bool) -> MemoryQueryResponse {
    MemoryQueryResponse {
        virtual_page_count: 0,
        module_count: 0,
        success: success,
    }
}

pub machine MemoryQueryResponse::clone(source: &MemoryQueryResponse) -> MemoryQueryResponse {
    let mut copy: MemoryQueryResponse = MemoryQueryResponse {
        virtual_page_count: 0,
        module_count: 0,
        success: source.success,
    };
    copy.copy_pages(source, 0);
    copy.copy_modules(source, 0);
    copy
}

pub machine MemoryQueryResponse::get_virtual_page_count(&self) -> u64 {
    self.virtual_page_count
}

pub machine MemoryQueryResponse::get_virtual_page(&self, position: u64) -> &NormalizedRegion {
    transition position < self.virtual_page_count && position < 64 {
        true -> at(position)
        false -> (self.head_page())
        _ -> (self.head_page())
    }
    state at(&self, position: u64) -> &NormalizedRegion
    requires 0 <= position && position < 64;
    {
        &self.virtual_pages[position]
    }
}

machine MemoryQueryResponse::head_page(&self) -> &NormalizedRegion {
    &self.virtual_pages[0]
}

pub machine MemoryQueryResponse::push_virtual_page(&mut self, region: &NormalizedRegion) -> bool {
    transition self.virtual_page_count < 64 {
        true -> store(region)
        false -> (false)
    }
    state store(&mut self, region: &NormalizedRegion) -> bool {
        self.virtual_pages[self.virtual_page_count] = NormalizedRegion::clone(region);
        self.virtual_page_count = self.virtual_page_count + 1;
        true
    }
}

pub machine MemoryQueryResponse::get_module_count(&self) -> u64 {
    self.module_count
}

pub machine MemoryQueryResponse::get_module(&self, position: u64) -> &NormalizedModule {
    transition position < self.module_count && position < 64 {
        true -> at(position)
        false -> (self.head_module())
        _ -> (self.head_module())
    }
    state at(&self, position: u64) -> &NormalizedModule
    requires 0 <= position && position < 64;
    {
        &self.modules[position]
    }
}

machine MemoryQueryResponse::head_module(&self) -> &NormalizedModule {
    &self.modules[0]
}

pub machine MemoryQueryResponse::push_module(&mut self, module: &NormalizedModule) -> bool {
    transition self.module_count < 64 {
        true -> store(module)
        false -> (false)
    }
    state store(&mut self, module: &NormalizedModule) -> bool {
        self.modules[self.module_count].clone_from(module);
        self.module_count = self.module_count + 1;
        true
    }
}

pub machine MemoryQueryResponse::get_success(&self) -> bool {
    self.success
}

machine MemoryQueryResponse::copy_pages(
    &mut self,
    source: &MemoryQueryResponse,
    position: u64
) {
    transition { _ -> each(source, position) }
    state each(&mut self, source: &MemoryQueryResponse, position: u64) {
        transition position < source.virtual_page_count && position < 64 {
            true -> store(source, position)
            false -> done()
            _ -> done()
        }
    }
    state store(&mut self, source: &MemoryQueryResponse, position: u64)
    requires 0 <= position && position < 64;
    {
        self.virtual_pages[position] = NormalizedRegion::clone(&source.virtual_pages[position]);
        self.virtual_page_count = position + 1;
        transition { _ -> each(source, position + 1) }
    }
    state done(&mut self) {
    }
}

machine MemoryQueryResponse::copy_modules(
    &mut self,
    source: &MemoryQueryResponse,
    position: u64
) {
    transition { _ -> each(source, position) }
    state each(&mut self, source: &MemoryQueryResponse, position: u64) {
        transition position < source.module_count && position < 64 {
            true -> store(source, position)
            false -> done()
            _ -> done()
        }
    }
    state store(&mut self, source: &MemoryQueryResponse, position: u64)
    requires 0 <= position && position < 64;
    {
        self.modules[position].clone_from(&source.modules[position]);
        self.module_count = position + 1;
        transition { _ -> each(source, position + 1) }
    }
    state done(&mut self) {
    }
}
