module src::commands::memory::query::memory_query_response;

use src::structures::memory::normalized_module::NormalizedModule;
use src::structures::memory::normalized_region::NormalizedRegion;

// Port of commands/memory/query/memory_query_response.rs. Upstream
// `virtual_pages`/`modules` are Vecs — bounded lists with counts per the
// port's collection convention.
pub data MemoryQueryResponse {
    virtual_pages: [NormalizedRegion; 64];
    virtual_page_count: u64;
    modules: [NormalizedModule; 64];
    module_count: u64;
    success: bool;
}

pub machine MemoryQueryResponse::new(success: bool) -> MemoryQueryResponse {
    MemoryQueryResponse {
        virtual_page_count: 0,
        module_count: 0,
        success: success,
    }
}

pub machine MemoryQueryResponse::clone(source: &MemoryQueryResponse) -> MemoryQueryResponse {
    let mut copy: MemoryQueryResponse = MemoryQueryResponse {
        virtual_page_count: 0,
        module_count: 0,
        success: source.success,
    };
    MemoryQueryResponse::copy_pages(&mut copy, source, 0);
    MemoryQueryResponse::copy_modules(&mut copy, source, 0);
    copy
}

pub machine MemoryQueryResponse::get_virtual_page_count(this: &MemoryQueryResponse) -> u64 {
    this.virtual_page_count
}

pub machine MemoryQueryResponse::get_virtual_page(this: &MemoryQueryResponse, position: u64) -> &NormalizedRegion {
    let hoist2: &NormalizedRegion = MemoryQueryResponse::head_page(&this);
    let hoist1: &NormalizedRegion = MemoryQueryResponse::head_page(&this);
    transition position < this.virtual_page_count && position < 64 {
        true -> at(this, position)
        false -> (hoist1)
        _ -> (hoist2)
    }
    state at(this: &MemoryQueryResponse, position: u64) -> &NormalizedRegion
    requires 0 <= position && position < 64;
    {
        &this.virtual_pages[position]
    }
}

machine MemoryQueryResponse::head_page(this: &MemoryQueryResponse) -> &NormalizedRegion {
    &this.virtual_pages[0]
}

pub machine MemoryQueryResponse::push_virtual_page(this: &mut MemoryQueryResponse, region: &NormalizedRegion) -> bool {
    transition this.virtual_page_count < 64 {
        true -> store(this, region)
        false -> (false)
    }
    state store(this: &mut MemoryQueryResponse, region: &NormalizedRegion) -> bool {
        this.virtual_pages[this.virtual_page_count] = NormalizedRegion::clone(region);
        this.virtual_page_count = this.virtual_page_count + 1;
        true
    }
}

pub machine MemoryQueryResponse::get_module_count(this: &MemoryQueryResponse) -> u64 {
    this.module_count
}

pub machine MemoryQueryResponse::get_module(this: &MemoryQueryResponse, position: u64) -> &NormalizedModule {
    let hoist4: &NormalizedModule = MemoryQueryResponse::head_module(&this);
    let hoist3: &NormalizedModule = MemoryQueryResponse::head_module(&this);
    transition position < this.module_count && position < 64 {
        true -> at(this, position)
        false -> (hoist3)
        _ -> (hoist4)
    }
    state at(this: &MemoryQueryResponse, position: u64) -> &NormalizedModule
    requires 0 <= position && position < 64;
    {
        &this.modules[position]
    }
}

machine MemoryQueryResponse::head_module(this: &MemoryQueryResponse) -> &NormalizedModule {
    &this.modules[0]
}

pub machine MemoryQueryResponse::push_module(this: &mut MemoryQueryResponse, module: &NormalizedModule) -> bool {
    transition this.module_count < 64 {
        true -> store(this, module)
        false -> (false)
    }
    state store(this: &mut MemoryQueryResponse, module: &NormalizedModule) -> bool {
        NormalizedModule::clone_from(&mut this.modules[this.module_count], module);
        this.module_count = this.module_count + 1;
        true
    }
}

pub machine MemoryQueryResponse::get_success(this: &MemoryQueryResponse) -> bool {
    this.success
}

machine MemoryQueryResponse::copy_pages(
    this: &mut MemoryQueryResponse,
    source: &MemoryQueryResponse,
    position: u64
) {
    transition { _ -> each(this, source, position) }
    state each(this: &mut MemoryQueryResponse, source: &MemoryQueryResponse, position: u64) {
        transition position < source.virtual_page_count && position < 64 {
            true -> store(this, source, position)
            false -> done(this)
            _ -> done(this)
        }
    }
    state store(this: &mut MemoryQueryResponse, source: &MemoryQueryResponse, position: u64)
    requires 0 <= position && position < 64;
    {
        this.virtual_pages[position] = NormalizedRegion::clone(&source.virtual_pages[position]);
        this.virtual_page_count = position + 1;
        transition { _ -> each(this, source, position + 1) }
    }
    state done(this: &mut MemoryQueryResponse) {
    }
}

machine MemoryQueryResponse::copy_modules(
    this: &mut MemoryQueryResponse,
    source: &MemoryQueryResponse,
    position: u64
) {
    transition { _ -> each(this, source, position) }
    state each(this: &mut MemoryQueryResponse, source: &MemoryQueryResponse, position: u64) {
        transition position < source.module_count && position < 64 {
            true -> store(this, source, position)
            false -> done(this)
            _ -> done(this)
        }
    }
    state store(this: &mut MemoryQueryResponse, source: &MemoryQueryResponse, position: u64)
    requires 0 <= position && position < 64;
    {
        NormalizedModule::clone_from(&mut this.modules[position], &source.modules[position]);
        this.module_count = position + 1;
        transition { _ -> each(this, source, position + 1) }
    }
    state done(this: &mut MemoryQueryResponse) {
    }
}
