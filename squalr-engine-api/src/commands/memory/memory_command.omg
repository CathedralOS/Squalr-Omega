use src/commands/memory/freeze/memory_freeze_request.omg;
use src/commands/memory/query/memory_query_request.omg;
use src/commands/memory/read/memory_read_request.omg;
use src/commands/memory/write/memory_write_request.omg;

// Port of commands/memory/memory_command.rs: the memory-domain command
// union, in upstream case order.
public data MemoryCommand {
    case Freeze(request: |memory_freeze_request|::MemoryFreezeRequest);
    case Query(request: |memory_query_request|::MemoryQueryRequest);
    case Read(request: |memory_read_request|::MemoryReadRequest);
    case Write(request: |memory_write_request|::MemoryWriteRequest);
}
