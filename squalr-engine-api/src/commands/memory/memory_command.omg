module src::commands::memory::memory_command;

use src::commands::memory::freeze::memory_freeze_request::MemoryFreezeRequest;
use src::commands::memory::query::memory_query_request::MemoryQueryRequest;
use src::commands::memory::read::memory_read_request::MemoryReadRequest;
use src::commands::memory::write::memory_write_request::MemoryWriteRequest;

// Port of commands/memory/memory_command.rs: the memory-domain command
// union, in upstream case order.
pub data MemoryCommand {
    case Freeze(request: MemoryFreezeRequest);
    case Query(request: MemoryQueryRequest);
    case Read(request: MemoryReadRequest);
    case Write(request: MemoryWriteRequest);
}
