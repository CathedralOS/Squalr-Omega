use src/commands/memory/freeze/memory_freeze_response.omg;
use src/commands/memory/query/memory_query_response.omg;
use src/commands/memory/read/memory_read_response.omg;
use src/commands/memory/write/memory_write_response.omg;

// Port of commands/memory/memory_response.rs, in upstream case order.
public data MemoryResponse {
    case Freeze(response: |memory_freeze_response|::MemoryFreezeResponse);
    case Query(response: |memory_query_response|::MemoryQueryResponse);
    case Read(response: |memory_read_response|::MemoryReadResponse);
    case Write(response: |memory_write_response|::MemoryWriteResponse);
}

// Case projections keep callers in scalar guards where the unit kind lacks
// union-match terminators; 0/false for cases that do not carry the field.
public machine MemoryResponse::is_freeze(this: &MemoryResponse) -> bool {
    transition this {
        MemoryResponse::Freeze { response } -> (true)
        _ -> (false)
    }
}

public machine MemoryResponse::is_query(this: &MemoryResponse) -> bool {
    transition this {
        MemoryResponse::Query { response } -> (true)
        _ -> (false)
    }
}

public machine MemoryResponse::is_read(this: &MemoryResponse) -> bool {
    transition this {
        MemoryResponse::Read { response } -> (true)
        _ -> (false)
    }
}

public machine MemoryResponse::is_write(this: &MemoryResponse) -> bool {
    transition this {
        MemoryResponse::Write { response } -> (true)
        _ -> (false)
    }
}

public machine MemoryResponse::get_failed_freeze_target_count(this: &MemoryResponse) -> u64 {
    transition this {
        MemoryResponse::Freeze { response } -> at(this, &response)
        _ -> (0)
    }
    machine at(this: &MemoryResponse, response: &|memory_freeze_response|::MemoryFreezeResponse) -> u64 {
        let hoist1: u64 = |memory_freeze_response|::MemoryFreezeResponse::get_failed_freeze_target_count(&response);
        (hoist1)
    }
}

public machine MemoryResponse::get_success(this: &MemoryResponse) -> bool {
    transition this {
        MemoryResponse::Query { response } -> at_query(this, &response)
        MemoryResponse::Read { response } -> at_read(this, &response)
        MemoryResponse::Write { response } -> at_write(this, &response)
        _ -> (false)
    }
    machine at_query(this: &MemoryResponse, response: &|memory_query_response|::MemoryQueryResponse) -> bool {
        let hoist2: bool = |memory_query_response|::MemoryQueryResponse::get_success(&response);
        (hoist2)
    }
    machine at_read(this: &MemoryResponse, response: &|memory_read_response|::MemoryReadResponse) -> bool {
        let hoist3: bool = |memory_read_response|::MemoryReadResponse::get_success(&response);
        (hoist3)
    }
    machine at_write(this: &MemoryResponse, response: &|memory_write_response|::MemoryWriteResponse) -> bool {
        let hoist4: bool = |memory_write_response|::MemoryWriteResponse::get_success(&response);
        (hoist4)
    }
}
