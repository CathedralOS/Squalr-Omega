module src::commands::memory::memory_response;

use src::commands::memory::freeze::memory_freeze_response::MemoryFreezeResponse;
use src::commands::memory::query::memory_query_response::MemoryQueryResponse;
use src::commands::memory::read::memory_read_response::MemoryReadResponse;
use src::commands::memory::write::memory_write_response::MemoryWriteResponse;

// Port of commands/memory/memory_response.rs, in upstream case order.
pub data MemoryResponse {
    case Freeze(response: MemoryFreezeResponse);
    case Query(response: MemoryQueryResponse);
    case Read(response: MemoryReadResponse);
    case Write(response: MemoryWriteResponse);
}

// Case projections keep callers in scalar guards where the unit kind lacks
// union-match terminators; 0/false for cases that do not carry the field.
pub machine MemoryResponse::is_freeze(&self) -> bool {
    transition self {
        MemoryResponse::Freeze { response } -> (true)
        _ -> (false)
    }
}

pub machine MemoryResponse::is_query(&self) -> bool {
    transition self {
        MemoryResponse::Query { response } -> (true)
        _ -> (false)
    }
}

pub machine MemoryResponse::is_read(&self) -> bool {
    transition self {
        MemoryResponse::Read { response } -> (true)
        _ -> (false)
    }
}

pub machine MemoryResponse::is_write(&self) -> bool {
    transition self {
        MemoryResponse::Write { response } -> (true)
        _ -> (false)
    }
}

pub machine MemoryResponse::get_failed_freeze_target_count(&self) -> u64 {
    transition self {
        MemoryResponse::Freeze { response } -> at(response)
        _ -> (0)
    }
    state at(&self, response: MemoryFreezeResponse) -> u64 {
        response.get_failed_freeze_target_count()
    }
}

pub machine MemoryResponse::get_success(&self) -> bool {
    transition self {
        MemoryResponse::Query { response } -> at_query(response)
        MemoryResponse::Read { response } -> at_read(response)
        MemoryResponse::Write { response } -> at_write(response)
        _ -> (false)
    }
    state at_query(&self, response: MemoryQueryResponse) -> bool {
        response.get_success()
    }
    state at_read(&self, response: MemoryReadResponse) -> bool {
        response.get_success()
    }
    state at_write(&self, response: MemoryWriteResponse) -> bool {
        response.get_success()
    }
}
