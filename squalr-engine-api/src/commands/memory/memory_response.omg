module src::commands::memory::memory_response;

use src::commands::memory::freeze::memory_freeze_response::MemoryFreezeResponse;
use src::commands::memory::query::memory_query_response::MemoryQueryResponse;
use src::commands::memory::read::memory_read_response::MemoryReadResponse;
use src::commands::memory::write::memory_write_response::MemoryWriteResponse;

// Port of commands/memory/memory_response.rs, in upstream case order.
pub data MemoryResponse {
    case Freeze(response: MemoryFreezeResponse);
    case Query(response: MemoryQueryResponse);
    case Read(response: MemoryReadResponse);
    case Write(response: MemoryWriteResponse);
}

// Case projections keep callers in scalar guards where the unit kind lacks
// union-match terminators; 0/false for cases that do not carry the field.
pub machine MemoryResponse::is_freeze(this: &MemoryResponse) -> bool {
    transition this {
        MemoryResponse::Freeze { response } -> (true)
        _ -> (false)
    }
}

pub machine MemoryResponse::is_query(this: &MemoryResponse) -> bool {
    transition this {
        MemoryResponse::Query { response } -> (true)
        _ -> (false)
    }
}

pub machine MemoryResponse::is_read(this: &MemoryResponse) -> bool {
    transition this {
        MemoryResponse::Read { response } -> (true)
        _ -> (false)
    }
}

pub machine MemoryResponse::is_write(this: &MemoryResponse) -> bool {
    transition this {
        MemoryResponse::Write { response } -> (true)
        _ -> (false)
    }
}

pub machine MemoryResponse::get_failed_freeze_target_count(this: &MemoryResponse) -> u64 {
    transition this {
        MemoryResponse::Freeze { response } -> at(this, response)
        _ -> (0)
    }
    state at(this: &MemoryResponse, response: MemoryFreezeResponse) -> u64 {
        let hoist1: u64 = MemoryFreezeResponse::get_failed_freeze_target_count(&response);
        (hoist1)
    }
}

pub machine MemoryResponse::get_success(this: &MemoryResponse) -> bool {
    transition this {
        MemoryResponse::Query { response } -> at_query(this, response)
        MemoryResponse::Read { response } -> at_read(this, response)
        MemoryResponse::Write { response } -> at_write(this, response)
        _ -> (false)
    }
    state at_query(this: &MemoryResponse, response: MemoryQueryResponse) -> bool {
        let hoist2: bool = MemoryQueryResponse::get_success(&response);
        (hoist2)
    }
    state at_read(this: &MemoryResponse, response: MemoryReadResponse) -> bool {
        let hoist3: bool = MemoryReadResponse::get_success(&response);
        (hoist3)
    }
    state at_write(this: &MemoryResponse, response: MemoryWriteResponse) -> bool {
        let hoist4: bool = MemoryWriteResponse::get_success(&response);
        (hoist4)
    }
}
