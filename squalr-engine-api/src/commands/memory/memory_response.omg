module src::commands::memory::memory_response;

use src::commands::memory::freeze::memory_freeze_response::MemoryFreezeResponse;
use src::commands::memory::query::memory_query_response::MemoryQueryResponse;
use src::commands::memory::read::memory_read_response::MemoryReadResponse;
use src::commands::memory::write::memory_write_response::MemoryWriteResponse;

// Port of commands/memory/memory_response.rs, in upstream case order.
pub data MemoryResponse {
    case Freeze(response: MemoryFreezeResponse);
    case Query(response: MemoryQueryResponse);
    case Read(response: MemoryReadResponse);
    case Write(response: MemoryWriteResponse);
}

// Case projections keep callers in scalar guards where the unit kind lacks
// union-match terminators; 0/false for cases that do not carry the field.
pub machine MemoryResponse::is_freeze(memory_response: &MemoryResponse) -> bool {
    transition memory_response {
        MemoryResponse::Freeze { response } -> (true)
        _ -> (false)
    }
}

pub machine MemoryResponse::is_query(memory_response: &MemoryResponse) -> bool {
    transition memory_response {
        MemoryResponse::Query { response } -> (true)
        _ -> (false)
    }
}

pub machine MemoryResponse::is_read(memory_response: &MemoryResponse) -> bool {
    transition memory_response {
        MemoryResponse::Read { response } -> (true)
        _ -> (false)
    }
}

pub machine MemoryResponse::is_write(memory_response: &MemoryResponse) -> bool {
    transition memory_response {
        MemoryResponse::Write { response } -> (true)
        _ -> (false)
    }
}

pub machine MemoryResponse::get_failed_freeze_target_count(memory_response: &MemoryResponse) -> u64 {
    transition memory_response {
        MemoryResponse::Freeze { response } -> at(memory_response, response)
        _ -> (0)
    }
    state at(memory_response: &MemoryResponse, response: MemoryFreezeResponse) -> u64 {
        MemoryFreezeResponse::get_failed_freeze_target_count(&response)
    }
}

pub machine MemoryResponse::get_success(memory_response: &MemoryResponse) -> bool {
    transition memory_response {
        MemoryResponse::Query { response } -> at_query(memory_response, response)
        MemoryResponse::Read { response } -> at_read(memory_response, response)
        MemoryResponse::Write { response } -> at_write(memory_response, response)
        _ -> (false)
    }
    state at_query(memory_response: &MemoryResponse, response: MemoryQueryResponse) -> bool {
        MemoryQueryResponse::get_success(&response)
    }
    state at_read(memory_response: &MemoryResponse, response: MemoryReadResponse) -> bool {
        MemoryReadResponse::get_success(&response)
    }
    state at_write(memory_response: &MemoryResponse, response: MemoryWriteResponse) -> bool {
        MemoryWriteResponse::get_success(&response)
    }
}
