module src::commands::memory::read::memory_read_request;

use src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;

// Port of commands/memory/read/memory_read_request.rs — read `address`
// (module-relative when `module_name` names one) through a symbolic struct
// layout into a ValuedStruct. `module_name` String folds to [u8;256]+len.
pub data MemoryReadRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    symbolic_struct_definition: SymbolicStructDefinition;
    suppress_logging: bool;
}

pub machine MemoryReadRequest::new(
    address: u64,
    module_name: &[u8],
    symbolic_struct_definition: SymbolicStructDefinition,
    suppress_logging: bool
) -> MemoryReadRequest {
    let mut request: MemoryReadRequest = MemoryReadRequest {
        address: address,
        module_name_len: 0,
        symbolic_struct_definition: symbolic_struct_definition,
        suppress_logging: suppress_logging,
    };
    MemoryReadRequest::set_module_name(&mut request, module_name);
    request
}

pub machine MemoryReadRequest::get_address(memory_read_request: &MemoryReadRequest) -> u64 {
    memory_read_request.address
}

pub machine MemoryReadRequest::get_module_name(memory_read_request: &MemoryReadRequest) -> &[u8] {
    transition memory_read_request.module_name_len <= 256 {
        true -> (&memory_read_request.module_name[0..memory_read_request.module_name_len])
        false -> (&memory_read_request.module_name[0..256])
        _ -> (&memory_read_request.module_name[0..256])
    }
}

pub machine MemoryReadRequest::get_symbolic_struct_definition(memory_read_request: &MemoryReadRequest) -> &SymbolicStructDefinition {
    &memory_read_request.symbolic_struct_definition
}

pub machine MemoryReadRequest::get_suppress_logging(memory_read_request: &MemoryReadRequest) -> bool {
    memory_read_request.suppress_logging
}

machine MemoryReadRequest::set_module_name(memory_read_request: &mut MemoryReadRequest, name: &[u8]) {
    let mut position: u64 = 0;
    transition { _ -> copy(memory_read_request, position, name) }
    state copy(memory_read_request: &mut MemoryReadRequest, position: u64, name: &[u8]) {
        transition position < name.len && position < 256 {
            true -> step(memory_read_request, position, name)
            false -> done(memory_read_request)
        }
    }
    state step(memory_read_request: &mut MemoryReadRequest, position: u64, name: &[u8]) {
        memory_read_request.module_name[position] = name[position];
        memory_read_request.module_name_len = position + 1;
        transition { _ -> copy(memory_read_request, position + 1, name) }
    }
    state done(memory_read_request: &mut MemoryReadRequest) {
        memory_read_request.module_name_len = memory_read_request.module_name_len;
    }
}

pub machine MemoryReadRequest::default() -> MemoryReadRequest {
    MemoryReadRequest {
        address: 0,
        module_name_len: 0,
        symbolic_struct_definition: SymbolicStructDefinition::empty(),
        suppress_logging: false,
    }
}

pub machine MemoryReadRequest::clone(memory_read_request: &MemoryReadRequest) -> MemoryReadRequest {
    let mut request: MemoryReadRequest = MemoryReadRequest::default();
    MemoryReadRequest::clone_from(&mut request, memory_read_request);
    request
}

pub machine MemoryReadRequest::clone_from(memory_read_request: &mut MemoryReadRequest, source: &MemoryReadRequest) {
    memory_read_request.address = source.address;
    memory_read_request.module_name_len = source.module_name_len;
    SymbolicStructDefinition::clone_from(&mut memory_read_request.symbolic_struct_definition, &source.symbolic_struct_definition);
    memory_read_request.suppress_logging = source.suppress_logging;
    transition { _ -> copy(memory_read_request, 0, source) }
    state copy(memory_read_request: &mut MemoryReadRequest, position: u64, source: &MemoryReadRequest)
        requires position <= source.module_name_len;
    {
        transition position < source.module_name_len && position < 256 {
            true -> step(memory_read_request, position, source)
            false -> done(memory_read_request)
        }
    }
    state step(memory_read_request: &mut MemoryReadRequest, position: u64, source: &MemoryReadRequest)
        requires position < source.module_name_len && position < 256;
    {
        memory_read_request.module_name[position] = source.module_name[position];
        let next_position: u64 = position + 1;
        transition next_position <= source.module_name_len {
            true -> copy(memory_read_request, next_position, source)
            _ -> done(memory_read_request)
        }
    }
    state done(memory_read_request: &mut MemoryReadRequest) {
    }
}
