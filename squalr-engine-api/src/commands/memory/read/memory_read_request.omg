module src::commands::memory::read::memory_read_request;

use src::structures::structs::symbolic_struct_definition::SymbolicStructDefinition;

// Port of commands/memory/read/memory_read_request.rs — read `address`
// (module-relative when `module_name` names one) through a symbolic struct
// layout into a ValuedStruct. `module_name` String folds to [u8;256]+len.
pub data MemoryReadRequest {
    address: u64;
    module_name: [u8; 256];
    module_name_len: u64;
    symbolic_struct_definition: SymbolicStructDefinition;
    suppress_logging: bool;
}

pub machine MemoryReadRequest::new(
    address: u64,
    module_name: &[u8],
    symbolic_struct_definition: SymbolicStructDefinition,
    suppress_logging: bool
) -> MemoryReadRequest {
    let mut request: MemoryReadRequest = MemoryReadRequest {
        address: address,
        module_name_len: 0,
        symbolic_struct_definition: symbolic_struct_definition,
        suppress_logging: suppress_logging,
    };
    request.set_module_name(module_name);
    request
}

pub machine MemoryReadRequest::get_address(&self) -> u64 {
    self.address
}

pub machine MemoryReadRequest::get_module_name(&self) -> &[u8] {
    transition self.module_name_len <= 256 {
        true -> (&self.module_name[0..self.module_name_len])
        false -> (&self.module_name[0..256])
        _ -> (&self.module_name[0..256])
    }
}

pub machine MemoryReadRequest::get_symbolic_struct_definition(&self) -> &SymbolicStructDefinition {
    &self.symbolic_struct_definition
}

pub machine MemoryReadRequest::get_suppress_logging(&self) -> bool {
    self.suppress_logging
}

machine MemoryReadRequest::set_module_name(&mut self, name: &[u8]) {
    let mut position: u64 = 0;
    transition { _ -> copy(position, name) }
    state copy(&mut self, position: u64, name: &[u8]) {
        transition position < name.len && position < 256 {
            true -> step(position, name)
            false -> done()
        }
    }
    state step(&mut self, position: u64, name: &[u8]) {
        self.module_name[position] = name[position];
        self.module_name_len = position + 1;
        transition { _ -> copy(position + 1, name) }
    }
    state done(&mut self) {
        self.module_name_len = self.module_name_len;
    }
}

pub machine MemoryReadRequest::default() -> MemoryReadRequest {
    MemoryReadRequest {
        address: 0,
        module_name_len: 0,
        symbolic_struct_definition: SymbolicStructDefinition::empty(),
        suppress_logging: false,
    }
}

pub machine MemoryReadRequest::clone(&self) -> MemoryReadRequest {
    let mut request: MemoryReadRequest = MemoryReadRequest::default();
    request.clone_from(self);
    request
}

pub machine MemoryReadRequest::clone_from(&mut self, source: &MemoryReadRequest) {
    self.address = source.address;
    self.module_name_len = source.module_name_len;
    self.symbolic_struct_definition.clone_from(&source.symbolic_struct_definition);
    self.suppress_logging = source.suppress_logging;
    transition { _ -> copy(0, source) }
    state copy(&mut self, position: u64, source: &MemoryReadRequest)
        requires position <= source.module_name_len;
    {
        transition position < source.module_name_len && position < 256 {
            true -> step(position, source)
            false -> done()
        }
    }
    state step(&mut self, position: u64, source: &MemoryReadRequest)
        requires position < source.module_name_len && position < 256;
    {
        self.module_name[position] = source.module_name[position];
        let next_position: u64 = position + 1;
        transition next_position <= source.module_name_len {
            true -> copy(next_position, source)
            _ -> done()
        }
    }
    state done(&mut self) {
    }
}
