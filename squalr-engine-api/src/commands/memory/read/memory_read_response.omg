module src::commands::memory::read::memory_read_response;

use src::structures::structs::valued_struct::ValuedStruct;

// Port of commands/memory/read/memory_read_response.rs.
pub data MemoryReadResponse {
    valued_struct: ValuedStruct;
    address: u64;
    success: bool;
}

pub machine MemoryReadResponse::new(
    valued_struct: ValuedStruct,
    address: u64,
    success: bool
) -> MemoryReadResponse {
    MemoryReadResponse {
        valued_struct: valued_struct,
        address: address,
        success: success,
    }
}

pub machine MemoryReadResponse::get_valued_struct(this: &MemoryReadResponse) -> &ValuedStruct {
    &this.valued_struct
}

pub machine MemoryReadResponse::get_address(this: &MemoryReadResponse) -> u64 {
    this.address
}

pub machine MemoryReadResponse::get_success(this: &MemoryReadResponse) -> bool {
    this.success
}

pub machine MemoryReadResponse::default() -> MemoryReadResponse {
    MemoryReadResponse {
        valued_struct: ValuedStruct::default(),
        address: 0,
        success: false,
    }
}

pub machine MemoryReadResponse::clone(this: &MemoryReadResponse) -> MemoryReadResponse {
    MemoryReadResponse {
        valued_struct: ValuedStruct::clone(&this.valued_struct),
        address: this.address,
        success: this.success,
    }
}

pub machine MemoryReadResponse::clone_from(this: &mut MemoryReadResponse, source: &MemoryReadResponse) {
    ValuedStruct::clone_from(&mut this.valued_struct, &source.valued_struct);
    this.address = source.address;
    this.success = source.success;
}
