module src::commands::memory::read::memory_read_response;

use src::structures::structs::valued_struct::ValuedStruct;

// Port of commands/memory/read/memory_read_response.rs.
pub data MemoryReadResponse {
    valued_struct: ValuedStruct;
    address: u64;
    success: bool;
}

pub machine MemoryReadResponse::new(
    valued_struct: ValuedStruct,
    address: u64,
    success: bool
) -> MemoryReadResponse {
    MemoryReadResponse {
        valued_struct: valued_struct,
        address: address,
        success: success,
    }
}

pub machine MemoryReadResponse::get_valued_struct(&self) -> &ValuedStruct {
    &self.valued_struct
}

pub machine MemoryReadResponse::get_address(&self) -> u64 {
    self.address
}

pub machine MemoryReadResponse::get_success(&self) -> bool {
    self.success
}

pub machine MemoryReadResponse::default() -> MemoryReadResponse {
    MemoryReadResponse {
        valued_struct: ValuedStruct::default(),
        address: 0,
        success: false,
    }
}

pub machine MemoryReadResponse::clone(&self) -> MemoryReadResponse {
    MemoryReadResponse {
        valued_struct: ValuedStruct::clone(&self.valued_struct),
        address: self.address,
        success: self.success,
    }
}

pub machine MemoryReadResponse::clone_from(&mut self, source: &MemoryReadResponse) {
    self.valued_struct.clone_from(&source.valued_struct);
    self.address = source.address;
    self.success = source.success;
}
