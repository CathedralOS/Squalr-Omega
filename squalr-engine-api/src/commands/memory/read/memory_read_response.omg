module src::commands::memory::read::memory_read_response;

use src::structures::structs::valued_struct::ValuedStruct;

// Port of commands/memory/read/memory_read_response.rs.
pub data MemoryReadResponse {
    valued_struct: ValuedStruct;
    address: u64;
    success: bool;
}

pub machine MemoryReadResponse::new(
    valued_struct: ValuedStruct,
    address: u64,
    success: bool
) -> MemoryReadResponse {
    MemoryReadResponse {
        valued_struct: valued_struct,
        address: address,
        success: success,
    }
}

pub machine MemoryReadResponse::get_valued_struct(memory_read_response: &MemoryReadResponse) -> &ValuedStruct {
    &memory_read_response.valued_struct
}

pub machine MemoryReadResponse::get_address(memory_read_response: &MemoryReadResponse) -> u64 {
    memory_read_response.address
}

pub machine MemoryReadResponse::get_success(memory_read_response: &MemoryReadResponse) -> bool {
    memory_read_response.success
}

pub machine MemoryReadResponse::default() -> MemoryReadResponse {
    MemoryReadResponse {
        valued_struct: ValuedStruct::default(),
        address: 0,
        success: false,
    }
}

pub machine MemoryReadResponse::clone(memory_read_response: &MemoryReadResponse) -> MemoryReadResponse {
    MemoryReadResponse {
        valued_struct: ValuedStruct::clone(&memory_read_response.valued_struct),
        address: memory_read_response.address,
        success: memory_read_response.success,
    }
}

pub machine MemoryReadResponse::clone_from(memory_read_response: &mut MemoryReadResponse, source: &MemoryReadResponse) {
    ValuedStruct::clone_from(&mut memory_read_response.valued_struct, &source.valued_struct);
    memory_read_response.address = source.address;
    memory_read_response.success = source.success;
}
