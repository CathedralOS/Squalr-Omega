// Port of the `TypedUnprivilegedCommandResponse` impls upstream spreads
// across its leaf files (declared in unprivileged_command_response.rs).
// Same colocation rule as typed_privileged_command_response.omg. Upstream's
// `Result<Self, UnprivilegedCommandResponse>` becomes a per-leaf
// `...Outcome` union — `Matched` is the typed extraction, `Unexpected`
// hands the unmatched union back exactly like `Err(response)`.

public data ProjectCloseResponseOutcome {
    case Matched(response: |project_close_response|::ProjectCloseResponse);
    case Unexpected(response: |unprivileged_command_response|::UnprivilegedCommandResponse);
}

public machine ProjectCloseResponse::to_engine_response(
    response: |project_close_response|::ProjectCloseResponse
) -> |unprivileged_command_response|::UnprivilegedCommandResponse {
    (|unprivileged_command_response|::UnprivilegedCommandResponse::Project { response: |project_response|::ProjectResponse::Close { response: response } })
}

public machine ProjectCloseResponse::from_engine_response(
    response: |unprivileged_command_response|::UnprivilegedCommandResponse
) -> ProjectCloseResponseOutcome {
    transition response {
        |unprivileged_command_response|::UnprivilegedCommandResponse::Project { response } -> domain(response)
        _ -> unexpected(response)
    }
    machine domain(response: |project_response|::ProjectResponse) -> ProjectCloseResponseOutcome {
        transition response {
            |project_response|::ProjectResponse::Close { response } -> (ProjectCloseResponseOutcome::Matched { response: response })
            _ -> rebuild(response)
        }
    }
    machine rebuild(response: |project_response|::ProjectResponse) -> ProjectCloseResponseOutcome {
        (ProjectCloseResponseOutcome::Unexpected { response: |unprivileged_command_response|::UnprivilegedCommandResponse::Project { response: response } })
    }
    machine unexpected(response: |unprivileged_command_response|::UnprivilegedCommandResponse) -> ProjectCloseResponseOutcome {
        (ProjectCloseResponseOutcome::Unexpected { response: response })
    }
}

