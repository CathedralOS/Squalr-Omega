// Port of the `TypedUnprivilegedCommandResponse` impls upstream spreads
// across its leaf files (declared in unprivileged_command_response.rs).
// Same colocation rule as typed_privileged_command_response.omg. Upstream's
// `Result<Self, UnprivilegedCommandResponse>` becomes a per-leaf
// `...Outcome` union — `Matched` is the typed extraction, `Unexpected`
// hands the unmatched union back exactly like `Err(response)`.

pub data ProjectCloseResponseOutcome {
    case Matched(response: ProjectCloseResponse);
    case Unexpected(response: UnprivilegedCommandResponse);
}

pub machine ProjectCloseResponse::to_engine_response(
    response: ProjectCloseResponse
) -> UnprivilegedCommandResponse {
    (UnprivilegedCommandResponse::Project { response: ProjectResponse::Close { response: response } })
}

pub machine ProjectCloseResponse::from_engine_response(
    response: UnprivilegedCommandResponse
) -> ProjectCloseResponseOutcome {
    transition response {
        UnprivilegedCommandResponse::Project { response } -> domain(response)
        _ -> unexpected(response)
    }
    state domain(response: ProjectResponse) -> ProjectCloseResponseOutcome {
        transition response {
            ProjectResponse::Close { response } -> (ProjectCloseResponseOutcome::Matched { response: response })
            _ -> rebuild(response)
        }
    }
    state rebuild(response: ProjectResponse) -> ProjectCloseResponseOutcome {
        (ProjectCloseResponseOutcome::Unexpected { response: UnprivilegedCommandResponse::Project { response: response } })
    }
    state unexpected(response: UnprivilegedCommandResponse) -> ProjectCloseResponseOutcome {
        (ProjectCloseResponseOutcome::Unexpected { response: response })
    }
}

