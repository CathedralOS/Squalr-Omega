use src/commands/registry/get_metadata/registry_get_metadata_request.omg;
use src/commands/registry/set_project_symbols/registry_set_project_symbols_request.omg;

// Port of commands/registry/registry_command.rs — the registry domain's
// command union (GetMetadata + SetProjectSymbols); payload field names are
// upstream's verbatim.
public data RegistryCommand {
    case GetMetadata(registry_get_metadata_request: |registry_get_metadata_request|::RegistryGetMetadataRequest);
    case SetProjectSymbols(registry_set_project_symbols_request: |registry_set_project_symbols_request|::RegistrySetProjectSymbolsRequest);
}
