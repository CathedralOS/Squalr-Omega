module src::commands::registry::get_metadata::registry_get_metadata_response;

use src::registries::symbols::privileged_registry_catalog::PrivilegedRegistryCatalog;

// Port of commands/registry/get_metadata/registry_get_metadata_response.rs —
// carries the privileged registry catalog snapshot (generation + sorted
// descriptor tables). Upstream's `to_engine_response`/`from_engine_response`
// impls live in the shared typed_privileged_command_response wire file.
pub data RegistryGetMetadataResponse {
    privileged_registry_catalog: PrivilegedRegistryCatalog;
}

pub machine RegistryGetMetadataResponse::new(privileged_registry_catalog: PrivilegedRegistryCatalog) -> RegistryGetMetadataResponse {
    (RegistryGetMetadataResponse {
        privileged_registry_catalog: privileged_registry_catalog,
    })
}

pub machine RegistryGetMetadataResponse::default() -> RegistryGetMetadataResponse {
    (RegistryGetMetadataResponse {
        privileged_registry_catalog: PrivilegedRegistryCatalog::default(),
    })
}

pub machine RegistryGetMetadataResponse::get_privileged_registry_catalog(this: &RegistryGetMetadataResponse) -> &PrivilegedRegistryCatalog {
    (&this.privileged_registry_catalog)
}
