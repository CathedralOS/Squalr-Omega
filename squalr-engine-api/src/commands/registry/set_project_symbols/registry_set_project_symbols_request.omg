module src::commands::registry::set_project_symbols::registry_set_project_symbols_request;

use src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;

// Port of commands/registry/set_project_symbols/registry_set_project_symbols_request.rs —
// carries the project-authored symbol catalog the session installs.
pub data RegistrySetProjectSymbolsRequest {
    project_symbol_catalog: ProjectSymbolCatalog;
}

pub machine RegistrySetProjectSymbolsRequest::new(project_symbol_catalog: ProjectSymbolCatalog) -> RegistrySetProjectSymbolsRequest {
    (RegistrySetProjectSymbolsRequest {
        project_symbol_catalog: project_symbol_catalog,
    })
}

pub machine RegistrySetProjectSymbolsRequest::default() -> RegistrySetProjectSymbolsRequest {
    (RegistrySetProjectSymbolsRequest {
        project_symbol_catalog: ProjectSymbolCatalog::new(),
    })
}

pub machine RegistrySetProjectSymbolsRequest::get_project_symbol_catalog(this: &RegistrySetProjectSymbolsRequest) -> &ProjectSymbolCatalog {
    (&this.project_symbol_catalog)
}
