module src::commands::unprivileged_command;

use src::commands::project::project_command::ProjectCommand;
use src::commands::project_items::project_items_command::ProjectItemsCommand;
use src::commands::project_symbols::project_symbols_command::ProjectSymbolsCommand;

// Port of commands/unprivileged_command.rs — the project-bound command
// surface (GUI/API-driven; the headless CLI parses only privileged commands).
pub data UnprivilegedCommand {
    case Project(command: ProjectCommand);
    case ProjectItems(command: ProjectItemsCommand);
    case ProjectSymbols(command: ProjectSymbolsCommand);
}
