use src/commands/project/project_command.omg;
use src/commands/project_items/project_items_command.omg;
use src/commands/project_symbols/project_symbols_command.omg;

// Port of commands/unprivileged_command.rs — the project-bound command
// surface (GUI/API-driven; the headless CLI parses only privileged commands).
public data UnprivilegedCommand {
    case Project(command: |project_command|::ProjectCommand);
    case ProjectItems(command: |project_items_command|::ProjectItemsCommand);
    case ProjectSymbols(command: |project_symbols_command|::ProjectSymbolsCommand);
}
