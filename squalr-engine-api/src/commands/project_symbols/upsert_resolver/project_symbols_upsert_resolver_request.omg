module src::commands::project_symbols::upsert_resolver::project_symbols_upsert_resolver_request;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project_symbols/upsert_resolver/project_symbols_upsert_resolver_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsUpsertResolverRequest {
    has_original_resolver_id: bool;
    original_resolver_id: [u8; 256];
    original_resolver_id_len: u64;
    resolver_id: [u8; 256];
    resolver_id_len: u64;
    resolver_definition_json: [u8; 2048];
    resolver_definition_json_len: u64;
}

pub machine ProjectSymbolsUpsertResolverRequest::new() -> ProjectSymbolsUpsertResolverRequest {
    ProjectSymbolsUpsertResolverRequest {
        has_original_resolver_id: false,
        original_resolver_id_len: 0,
        resolver_id_len: 0,
        resolver_definition_json_len: 0,
    }
}

pub machine ProjectSymbolsUpsertResolverRequest::default() -> ProjectSymbolsUpsertResolverRequest {
    ProjectSymbolsUpsertResolverRequest::new()
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectSymbolsUpsertResolverRequest::has_original_resolver_id(&self) -> bool {
    self.has_original_resolver_id
}

pub machine ProjectSymbolsUpsertResolverRequest::get_original_resolver_id(&self) -> &[u8] {
    transition self.original_resolver_id_len <= 256 {
        true -> (&self.original_resolver_id[0..self.original_resolver_id_len])
        false -> (&self.original_resolver_id[0..256])
        _ -> (&self.original_resolver_id[0..256])
    }
}

pub machine ProjectSymbolsUpsertResolverRequest::set_original_resolver_id(&mut self, original_resolver_id: &[u8]) {
    self.has_original_resolver_id = true;
    self.original_resolver_id_len = BoundedByteCopy::copy(&mut self.original_resolver_id[0..256], original_resolver_id);
}

pub machine ProjectSymbolsUpsertResolverRequest::clear_original_resolver_id(&mut self) {
    self.has_original_resolver_id = false;
    self.original_resolver_id_len = 0;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsUpsertResolverRequest::get_resolver_id(&self) -> &[u8] {
    transition self.resolver_id_len <= 256 {
        true -> (&self.resolver_id[0..self.resolver_id_len])
        false -> (&self.resolver_id[0..256])
        _ -> (&self.resolver_id[0..256])
    }
}

pub machine ProjectSymbolsUpsertResolverRequest::set_resolver_id(&mut self, resolver_id: &[u8]) {
    self.resolver_id_len = BoundedByteCopy::copy(&mut self.resolver_id[0..256], resolver_id);
}

// Bounded UTF-8 carrier for the upstream string field (2048 cap).
pub machine ProjectSymbolsUpsertResolverRequest::get_resolver_definition_json(&self) -> &[u8] {
    transition self.resolver_definition_json_len <= 2048 {
        true -> (&self.resolver_definition_json[0..self.resolver_definition_json_len])
        false -> (&self.resolver_definition_json[0..2048])
        _ -> (&self.resolver_definition_json[0..2048])
    }
}

pub machine ProjectSymbolsUpsertResolverRequest::set_resolver_definition_json(&mut self, resolver_definition_json: &[u8]) {
    self.resolver_definition_json_len = BoundedByteCopy::copy(&mut self.resolver_definition_json[0..2048], resolver_definition_json);
}
