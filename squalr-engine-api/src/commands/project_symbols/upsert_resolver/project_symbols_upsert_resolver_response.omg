module src::commands::project_symbols::upsert_resolver::project_symbols_upsert_resolver_response;

// Port of commands/project_symbols/upsert_resolver/project_symbols_upsert_resolver_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsUpsertResolverResponse {
    success: bool;
    resolver_id: [u8; 256];
    resolver_id_len: u64;
    has_error: bool;
    error: [u8; 512];
    error_len: u64;
}

pub machine ProjectSymbolsUpsertResolverResponse::new() -> ProjectSymbolsUpsertResolverResponse {
    ProjectSymbolsUpsertResolverResponse {
        success: false,
        resolver_id_len: 0,
        has_error: false,
        error_len: 0,
    }
}

pub machine ProjectSymbolsUpsertResolverResponse::default() -> ProjectSymbolsUpsertResolverResponse {
    ProjectSymbolsUpsertResolverResponse::new()
}

pub machine ProjectSymbolsUpsertResolverResponse::get_success(this: &ProjectSymbolsUpsertResolverResponse) -> bool {
    this.success
}

pub machine ProjectSymbolsUpsertResolverResponse::set_success(this: &mut ProjectSymbolsUpsertResolverResponse, success: bool) {
    this.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsUpsertResolverResponse::get_resolver_id(this: &ProjectSymbolsUpsertResolverResponse) -> &[u8] {
    transition this.resolver_id_len <= 256 {
        true -> (&this.resolver_id[0..this.resolver_id_len])
        false -> (&this.resolver_id[0..256])
        _ -> (&this.resolver_id[0..256])
    }
}

pub machine ProjectSymbolsUpsertResolverResponse::set_resolver_id(this: &mut ProjectSymbolsUpsertResolverResponse, resolver_id: &[u8]) {
    this.resolver_id_len = 0;
    transition {
        _ -> copy_resolver_id(this, resolver_id, 0)
    }
    state copy_resolver_id(this: &mut ProjectSymbolsUpsertResolverResponse, resolver_id: &[u8], position: u64) {
        transition position < resolver_id.len && position < 256 {
            true -> store_resolver_id(this, resolver_id, position)
            false -> finish_resolver_id(this, position)
        }
    }
    state store_resolver_id(this: &mut ProjectSymbolsUpsertResolverResponse, resolver_id: &[u8], position: u64) {
        this.resolver_id[position] = resolver_id[position];
        transition {
            _ -> copy_resolver_id(this, resolver_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_resolver_id(this: &mut ProjectSymbolsUpsertResolverResponse, count: u64) {
        this.resolver_id_len = count;
    }
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectSymbolsUpsertResolverResponse::has_error(this: &ProjectSymbolsUpsertResolverResponse) -> bool {
    this.has_error
}

pub machine ProjectSymbolsUpsertResolverResponse::get_error(this: &ProjectSymbolsUpsertResolverResponse) -> &[u8] {
    transition this.error_len <= 512 {
        true -> (&this.error[0..this.error_len])
        false -> (&this.error[0..512])
        _ -> (&this.error[0..512])
    }
}

pub machine ProjectSymbolsUpsertResolverResponse::set_error(this: &mut ProjectSymbolsUpsertResolverResponse, error: &[u8]) {
    this.has_error = true;
    this.error_len = 0;
    transition {
        _ -> copy_error(this, error, 0)
    }
    state copy_error(this: &mut ProjectSymbolsUpsertResolverResponse, error: &[u8], position: u64) {
        transition position < error.len && position < 512 {
            true -> store_error(this, error, position)
            false -> finish_error(this, position)
        }
    }
    state store_error(this: &mut ProjectSymbolsUpsertResolverResponse, error: &[u8], position: u64) {
        this.error[position] = error[position];
        transition {
            _ -> copy_error(this, error, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_error(this: &mut ProjectSymbolsUpsertResolverResponse, count: u64) {
        this.error_len = count;
    }
}

pub machine ProjectSymbolsUpsertResolverResponse::clear_error(this: &mut ProjectSymbolsUpsertResolverResponse) {
    this.has_error = false;
    this.error_len = 0;
}
