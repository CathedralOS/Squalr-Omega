module src::commands::project_symbols::upsert_resolver::project_symbols_upsert_resolver_response;

// Port of commands/project_symbols/upsert_resolver/project_symbols_upsert_resolver_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsUpsertResolverResponse {
    success: bool;
    resolver_id: [u8; 256];
    resolver_id_len: u64;
    has_error: bool;
    error: [u8; 512];
    error_len: u64;
}

pub machine ProjectSymbolsUpsertResolverResponse::new() -> ProjectSymbolsUpsertResolverResponse {
    ProjectSymbolsUpsertResolverResponse {
        success: false,
        resolver_id_len: 0,
        has_error: false,
        error_len: 0,
    }
}

pub machine ProjectSymbolsUpsertResolverResponse::default() -> ProjectSymbolsUpsertResolverResponse {
    ProjectSymbolsUpsertResolverResponse::new()
}

pub machine ProjectSymbolsUpsertResolverResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectSymbolsUpsertResolverResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsUpsertResolverResponse::get_resolver_id(&self) -> &[u8] {
    transition self.resolver_id_len <= 256 {
        true -> (&self.resolver_id[0..self.resolver_id_len])
        false -> (&self.resolver_id[0..256])
        _ -> (&self.resolver_id[0..256])
    }
}

pub machine ProjectSymbolsUpsertResolverResponse::set_resolver_id(&mut self, resolver_id: &[u8]) {
    self.resolver_id_len = 0;
    transition {
        _ -> copy_resolver_id(resolver_id, 0)
    }
    state copy_resolver_id(&mut self, resolver_id: &[u8], position: u64) {
        transition position < resolver_id.len && position < 256 {
            true -> store_resolver_id(resolver_id, position)
            false -> finish_resolver_id(position)
        }
    }
    state store_resolver_id(&mut self, resolver_id: &[u8], position: u64) {
        self.resolver_id[position] = resolver_id[position];
        transition {
            _ -> copy_resolver_id(resolver_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_resolver_id(&mut self, count: u64) {
        self.resolver_id_len = count;
    }
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectSymbolsUpsertResolverResponse::has_error(&self) -> bool {
    self.has_error
}

pub machine ProjectSymbolsUpsertResolverResponse::get_error(&self) -> &[u8] {
    transition self.error_len <= 512 {
        true -> (&self.error[0..self.error_len])
        false -> (&self.error[0..512])
        _ -> (&self.error[0..512])
    }
}

pub machine ProjectSymbolsUpsertResolverResponse::set_error(&mut self, error: &[u8]) {
    self.has_error = true;
    self.error_len = 0;
    transition {
        _ -> copy_error(error, 0)
    }
    state copy_error(&mut self, error: &[u8], position: u64) {
        transition position < error.len && position < 512 {
            true -> store_error(error, position)
            false -> finish_error(position)
        }
    }
    state store_error(&mut self, error: &[u8], position: u64) {
        self.error[position] = error[position];
        transition {
            _ -> copy_error(error, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_error(&mut self, count: u64) {
        self.error_len = count;
    }
}

pub machine ProjectSymbolsUpsertResolverResponse::clear_error(&mut self) {
    self.has_error = false;
    self.error_len = 0;
}
