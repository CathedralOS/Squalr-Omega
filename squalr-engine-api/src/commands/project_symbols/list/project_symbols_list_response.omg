module src::commands::project_symbols::list::project_symbols_list_response;

use src::structures::projects::project_info::ProjectInfo;
use src::structures::projects::project_symbol_catalog::ProjectSymbolCatalog;
// Port of commands/project_symbols/list/project_symbols_list_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsListResponse {
    has_opened_project_info: bool;
    opened_project_info: ProjectInfo;
    has_project_symbol_catalog: bool;
    project_symbol_catalog: ProjectSymbolCatalog;
}

pub machine ProjectSymbolsListResponse::new() -> ProjectSymbolsListResponse {
    ProjectSymbolsListResponse {
        has_opened_project_info: false,
        opened_project_info: ProjectInfo::default(),
        has_project_symbol_catalog: false,
        project_symbol_catalog: ProjectSymbolCatalog::default(),
    }
}

pub machine ProjectSymbolsListResponse::default() -> ProjectSymbolsListResponse {
    ProjectSymbolsListResponse::new()
}

// Upstream `Option<ProjectInfo>` — flag pair.
pub machine ProjectSymbolsListResponse::has_opened_project_info(project_symbols_list_response: &ProjectSymbolsListResponse) -> bool {
    project_symbols_list_response.has_opened_project_info
}

pub machine ProjectSymbolsListResponse::get_opened_project_info(project_symbols_list_response: &ProjectSymbolsListResponse) -> &ProjectInfo {
    &project_symbols_list_response.opened_project_info
}

pub machine ProjectSymbolsListResponse::set_opened_project_info(project_symbols_list_response: &mut ProjectSymbolsListResponse, opened_project_info: ProjectInfo) {
    project_symbols_list_response.opened_project_info = opened_project_info;
    project_symbols_list_response.has_opened_project_info = true;
}

pub machine ProjectSymbolsListResponse::clear_opened_project_info(project_symbols_list_response: &mut ProjectSymbolsListResponse) {
    project_symbols_list_response.has_opened_project_info = false;
}

// Upstream `Option<ProjectSymbolCatalog>` — flag pair.
pub machine ProjectSymbolsListResponse::has_project_symbol_catalog(project_symbols_list_response: &ProjectSymbolsListResponse) -> bool {
    project_symbols_list_response.has_project_symbol_catalog
}

pub machine ProjectSymbolsListResponse::get_project_symbol_catalog(project_symbols_list_response: &ProjectSymbolsListResponse) -> &ProjectSymbolCatalog {
    &project_symbols_list_response.project_symbol_catalog
}

pub machine ProjectSymbolsListResponse::set_project_symbol_catalog(project_symbols_list_response: &mut ProjectSymbolsListResponse, project_symbol_catalog: ProjectSymbolCatalog) {
    project_symbols_list_response.project_symbol_catalog = project_symbol_catalog;
    project_symbols_list_response.has_project_symbol_catalog = true;
}

pub machine ProjectSymbolsListResponse::clear_project_symbol_catalog(project_symbols_list_response: &mut ProjectSymbolsListResponse) {
    project_symbols_list_response.has_project_symbol_catalog = false;
}
