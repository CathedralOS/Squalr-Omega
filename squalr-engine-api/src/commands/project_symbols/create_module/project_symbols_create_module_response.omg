module src::commands::project_symbols::create_module::project_symbols_create_module_response;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project_symbols/create_module/project_symbols_create_module_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsCreateModuleResponse {
    success: bool;
    module_name: [u8; 256];
    module_name_len: u64;
}

pub machine ProjectSymbolsCreateModuleResponse::new() -> ProjectSymbolsCreateModuleResponse {
    ProjectSymbolsCreateModuleResponse {
        success: false,
        module_name_len: 0,
    }
}

pub machine ProjectSymbolsCreateModuleResponse::default() -> ProjectSymbolsCreateModuleResponse {
    ProjectSymbolsCreateModuleResponse::new()
}

pub machine ProjectSymbolsCreateModuleResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectSymbolsCreateModuleResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsCreateModuleResponse::get_module_name(&self) -> &[u8] {
    transition self.module_name_len <= 256 {
        true -> (&self.module_name[0..self.module_name_len])
        false -> (&self.module_name[0..256])
        _ -> (&self.module_name[0..256])
    }
}

pub machine ProjectSymbolsCreateModuleResponse::set_module_name(&mut self, module_name: &[u8]) {
    self.module_name_len = BoundedByteCopy::copy(&mut self.module_name[0..256], module_name);
}
