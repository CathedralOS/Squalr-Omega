module src::commands::project_symbols::create_module::project_symbols_create_module_response;

// Port of commands/project_symbols/create_module/project_symbols_create_module_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsCreateModuleResponse {
    success: bool;
    module_name: [u8; 256];
    module_name_len: u64;
}

pub machine ProjectSymbolsCreateModuleResponse::new() -> ProjectSymbolsCreateModuleResponse {
    ProjectSymbolsCreateModuleResponse {
        success: false,
        module_name_len: 0,
    }
}

pub machine ProjectSymbolsCreateModuleResponse::default() -> ProjectSymbolsCreateModuleResponse {
    ProjectSymbolsCreateModuleResponse::new()
}

pub machine ProjectSymbolsCreateModuleResponse::get_success(project_symbols_create_module_response: &ProjectSymbolsCreateModuleResponse) -> bool {
    project_symbols_create_module_response.success
}

pub machine ProjectSymbolsCreateModuleResponse::set_success(project_symbols_create_module_response: &mut ProjectSymbolsCreateModuleResponse, success: bool) {
    project_symbols_create_module_response.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsCreateModuleResponse::get_module_name(project_symbols_create_module_response: &ProjectSymbolsCreateModuleResponse) -> &[u8] {
    transition project_symbols_create_module_response.module_name_len <= 256 {
        true -> (&project_symbols_create_module_response.module_name[0..project_symbols_create_module_response.module_name_len])
        false -> (&project_symbols_create_module_response.module_name[0..256])
        _ -> (&project_symbols_create_module_response.module_name[0..256])
    }
}

pub machine ProjectSymbolsCreateModuleResponse::set_module_name(project_symbols_create_module_response: &mut ProjectSymbolsCreateModuleResponse, module_name: &[u8]) {
    project_symbols_create_module_response.module_name_len = 0;
    transition {
        _ -> copy_module_name(project_symbols_create_module_response, module_name, 0)
    }
    state copy_module_name(project_symbols_create_module_response: &mut ProjectSymbolsCreateModuleResponse, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store_module_name(project_symbols_create_module_response, module_name, position)
            false -> finish_module_name(project_symbols_create_module_response, position)
        }
    }
    state store_module_name(project_symbols_create_module_response: &mut ProjectSymbolsCreateModuleResponse, module_name: &[u8], position: u64) {
        project_symbols_create_module_response.module_name[position] = module_name[position];
        transition {
            _ -> copy_module_name(project_symbols_create_module_response, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_module_name(project_symbols_create_module_response: &mut ProjectSymbolsCreateModuleResponse, count: u64) {
        project_symbols_create_module_response.module_name_len = count;
    }
}
