module src::commands::project_symbols::create_module::project_symbols_create_module_request;

// Port of commands/project_symbols/create_module/project_symbols_create_module_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsCreateModuleRequest {
    module_name: [u8; 256];
    module_name_len: u64;
    size: u64;
}

pub machine ProjectSymbolsCreateModuleRequest::new() -> ProjectSymbolsCreateModuleRequest {
    ProjectSymbolsCreateModuleRequest {
        module_name_len: 0,
        size: 0,
    }
}

pub machine ProjectSymbolsCreateModuleRequest::default() -> ProjectSymbolsCreateModuleRequest {
    ProjectSymbolsCreateModuleRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsCreateModuleRequest::get_module_name(this: &ProjectSymbolsCreateModuleRequest) -> &[u8] {
    transition this.module_name_len <= 256 {
        true -> (&this.module_name[0..this.module_name_len])
        false -> (&this.module_name[0..256])
        _ -> (&this.module_name[0..256])
    }
}

pub machine ProjectSymbolsCreateModuleRequest::set_module_name(this: &mut ProjectSymbolsCreateModuleRequest, module_name: &[u8]) {
    this.module_name_len = 0;
    transition {
        _ -> copy_module_name(this, module_name, 0)
    }
    state copy_module_name(this: &mut ProjectSymbolsCreateModuleRequest, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store_module_name(this, module_name, position)
            false -> finish_module_name(this, position)
        }
    }
    state store_module_name(this: &mut ProjectSymbolsCreateModuleRequest, module_name: &[u8], position: u64) {
        this.module_name[position] = module_name[position];
        transition {
            _ -> copy_module_name(this, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_module_name(this: &mut ProjectSymbolsCreateModuleRequest, count: u64) {
        this.module_name_len = count;
    }
}

pub machine ProjectSymbolsCreateModuleRequest::get_size(this: &ProjectSymbolsCreateModuleRequest) -> u64 {
    this.size
}

pub machine ProjectSymbolsCreateModuleRequest::set_size(this: &mut ProjectSymbolsCreateModuleRequest, size: u64) {
    this.size = size;
}
