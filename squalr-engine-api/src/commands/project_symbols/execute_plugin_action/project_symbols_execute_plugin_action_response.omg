pub machine ProjectSymbolsExecutePluginActionResponse::set_error(this: &mut ProjectSymbolsExecutePluginActionResponse, error: &[u8]) {
    this.has_error = true;
    this.error_len = 0;
    transition {
        _ -> copy_error(this, error, 0)
