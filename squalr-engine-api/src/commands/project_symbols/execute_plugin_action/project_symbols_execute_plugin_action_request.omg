pub machine ProjectSymbolsExecutePluginActionRequest::set_action_id(this: &mut ProjectSymbolsExecutePluginActionRequest, action_id: &[u8]) {
    this.action_id_len = 0;
    transition {
        _ -> copy_action_id(this, action_id, 0)
    }
    state copy_action_id(this: &mut ProjectSymbolsExecutePluginActionRequest, action_id: &[u8], position: u64) {
        transition position < action_id.len && position < 256 {
            true -> store_action_id(this, action_id, position)
            false -> finish_action_id(this, position)
        }
    }
    state store_action_id(this: &mut ProjectSymbolsExecutePluginActionRequest, action_id: &[u8], position: u64) {
        this.action_id[position] = action_id[position];
        transition {
            _ -> copy_action_id(this, action_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_action_id(this: &mut ProjectSymbolsExecutePluginActionRequest, count: u64) {
        this.action_id_len = count;
