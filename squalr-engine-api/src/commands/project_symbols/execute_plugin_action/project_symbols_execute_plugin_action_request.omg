module src::commands::project_symbols::execute_plugin_action::project_symbols_execute_plugin_action_request;

use src::plugins::symbol_tree::symbol_tree_action::SymbolTreeActionContext;
// Port of commands/project_symbols/execute_plugin_action/project_symbols_execute_plugin_action_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsExecutePluginActionRequest {
    plugin_id: [u8; 256];
    plugin_id_len: u64;
    action_id: [u8; 256];
    action_id_len: u64;
    context: SymbolTreeActionContext;
}

pub machine ProjectSymbolsExecutePluginActionRequest::new() -> ProjectSymbolsExecutePluginActionRequest {
    ProjectSymbolsExecutePluginActionRequest {
        plugin_id_len: 0,
        action_id_len: 0,
        context: SymbolTreeActionContext::default(),
    }
}

pub machine ProjectSymbolsExecutePluginActionRequest::default() -> ProjectSymbolsExecutePluginActionRequest {
    ProjectSymbolsExecutePluginActionRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsExecutePluginActionRequest::get_plugin_id(this: &ProjectSymbolsExecutePluginActionRequest) -> &[u8] {
    transition this.plugin_id_len <= 256 {
        true -> (&this.plugin_id[0..this.plugin_id_len])
        false -> (&this.plugin_id[0..256])
        _ -> (&this.plugin_id[0..256])
    }
}

pub machine ProjectSymbolsExecutePluginActionRequest::set_plugin_id(this: &mut ProjectSymbolsExecutePluginActionRequest, plugin_id: &[u8]) {
    this.plugin_id_len = 0;
    transition {
        _ -> copy_plugin_id(this, plugin_id, 0)
    }
    state copy_plugin_id(this: &mut ProjectSymbolsExecutePluginActionRequest, plugin_id: &[u8], position: u64) {
        transition position < plugin_id.len && position < 256 {
            true -> store_plugin_id(this, plugin_id, position)
            false -> finish_plugin_id(this, position)
        }
    }
    state store_plugin_id(this: &mut ProjectSymbolsExecutePluginActionRequest, plugin_id: &[u8], position: u64) {
        this.plugin_id[position] = plugin_id[position];
        transition {
            _ -> copy_plugin_id(this, plugin_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_plugin_id(this: &mut ProjectSymbolsExecutePluginActionRequest, count: u64) {
        this.plugin_id_len = count;
    }
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsExecutePluginActionRequest::get_action_id(this: &ProjectSymbolsExecutePluginActionRequest) -> &[u8] {
    transition this.action_id_len <= 256 {
