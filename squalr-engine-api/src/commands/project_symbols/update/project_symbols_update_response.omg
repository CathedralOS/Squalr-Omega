module src::commands::project_symbols::update::project_symbols_update_response;

use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project_symbols/update/project_symbols_update_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsUpdateResponse {
    success: bool;
    symbol_locator_key: [u8; 256];
    symbol_locator_key_len: u64;
}

pub machine ProjectSymbolsUpdateResponse::new() -> ProjectSymbolsUpdateResponse {
    ProjectSymbolsUpdateResponse {
        success: false,
        symbol_locator_key_len: 0,
    }
}

pub machine ProjectSymbolsUpdateResponse::default() -> ProjectSymbolsUpdateResponse {
    ProjectSymbolsUpdateResponse::new()
}

pub machine ProjectSymbolsUpdateResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectSymbolsUpdateResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsUpdateResponse::get_symbol_locator_key(&self) -> &[u8] {
    bounded_slice(&self.symbol_locator_key[0..256], self.symbol_locator_key_len)
}

pub machine ProjectSymbolsUpdateResponse::set_symbol_locator_key(&mut self, symbol_locator_key: &[u8]) {
    self.symbol_locator_key_len = BoundedByteCopy::copy(&mut self.symbol_locator_key[0..256], symbol_locator_key);
}
