module src::commands::project_symbols::update::project_symbols_update_request;

use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project_symbols/update/project_symbols_update_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsUpdateRequest {
    symbol_locator_key: [u8; 256];
    symbol_locator_key_len: u64;
    has_display_name: bool;
    display_name: [u8; 256];
    display_name_len: u64;
    has_struct_layout_id: bool;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
}

pub machine ProjectSymbolsUpdateRequest::new() -> ProjectSymbolsUpdateRequest {
    ProjectSymbolsUpdateRequest {
        symbol_locator_key_len: 0,
        has_display_name: false,
        display_name_len: 0,
        has_struct_layout_id: false,
        struct_layout_id_len: 0,
    }
}

pub machine ProjectSymbolsUpdateRequest::default() -> ProjectSymbolsUpdateRequest {
    ProjectSymbolsUpdateRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsUpdateRequest::get_symbol_locator_key(&self) -> &[u8] {
    bounded_slice(&self.symbol_locator_key[0..256], self.symbol_locator_key_len)
}

pub machine ProjectSymbolsUpdateRequest::set_symbol_locator_key(&mut self, symbol_locator_key: &[u8]) {
    self.symbol_locator_key_len = BoundedByteCopy::copy(&mut self.symbol_locator_key[0..256], symbol_locator_key);
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectSymbolsUpdateRequest::has_display_name(&self) -> bool {
    self.has_display_name
}

pub machine ProjectSymbolsUpdateRequest::get_display_name(&self) -> &[u8] {
    bounded_slice(&self.display_name[0..256], self.display_name_len)
}

pub machine ProjectSymbolsUpdateRequest::set_display_name(&mut self, display_name: &[u8]) {
    self.has_display_name = true;
    self.display_name_len = BoundedByteCopy::copy(&mut self.display_name[0..256], display_name);
}

pub machine ProjectSymbolsUpdateRequest::clear_display_name(&mut self) {
    self.has_display_name = false;
    self.display_name_len = 0;
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectSymbolsUpdateRequest::has_struct_layout_id(&self) -> bool {
    self.has_struct_layout_id
}

pub machine ProjectSymbolsUpdateRequest::get_struct_layout_id(&self) -> &[u8] {
    bounded_slice(&self.struct_layout_id[0..256], self.struct_layout_id_len)
}

pub machine ProjectSymbolsUpdateRequest::set_struct_layout_id(&mut self, struct_layout_id: &[u8]) {
    self.has_struct_layout_id = true;
    self.struct_layout_id_len = BoundedByteCopy::copy(&mut self.struct_layout_id[0..256], struct_layout_id);
}

pub machine ProjectSymbolsUpdateRequest::clear_struct_layout_id(&mut self) {
    self.has_struct_layout_id = false;
    self.struct_layout_id_len = 0;
}
