module src::commands::project_symbols::update::project_symbols_update_request;

// Port of commands/project_symbols/update/project_symbols_update_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsUpdateRequest {
    symbol_locator_key: [u8; 256];
    symbol_locator_key_len: u64;
    has_display_name: bool;
    display_name: [u8; 256];
    display_name_len: u64;
    has_struct_layout_id: bool;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
}

pub machine ProjectSymbolsUpdateRequest::new() -> ProjectSymbolsUpdateRequest {
    ProjectSymbolsUpdateRequest {
        symbol_locator_key_len: 0,
        has_display_name: false,
        display_name_len: 0,
        has_struct_layout_id: false,
        struct_layout_id_len: 0,
    }
}

pub machine ProjectSymbolsUpdateRequest::default() -> ProjectSymbolsUpdateRequest {
    ProjectSymbolsUpdateRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsUpdateRequest::get_symbol_locator_key(project_symbols_update_request: &ProjectSymbolsUpdateRequest) -> &[u8] {
    transition project_symbols_update_request.symbol_locator_key_len <= 256 {
        true -> (&project_symbols_update_request.symbol_locator_key[0..project_symbols_update_request.symbol_locator_key_len])
        false -> (&project_symbols_update_request.symbol_locator_key[0..256])
        _ -> (&project_symbols_update_request.symbol_locator_key[0..256])
    }
}

pub machine ProjectSymbolsUpdateRequest::set_symbol_locator_key(project_symbols_update_request: &mut ProjectSymbolsUpdateRequest, symbol_locator_key: &[u8]) {
    project_symbols_update_request.symbol_locator_key_len = 0;
    transition {
        _ -> copy_symbol_locator_key(project_symbols_update_request, symbol_locator_key, 0)
    }
    state copy_symbol_locator_key(project_symbols_update_request: &mut ProjectSymbolsUpdateRequest, symbol_locator_key: &[u8], position: u64) {
        transition position < symbol_locator_key.len && position < 256 {
            true -> store_symbol_locator_key(project_symbols_update_request, symbol_locator_key, position)
            false -> finish_symbol_locator_key(project_symbols_update_request, position)
        }
    }
    state store_symbol_locator_key(project_symbols_update_request: &mut ProjectSymbolsUpdateRequest, symbol_locator_key: &[u8], position: u64) {
        project_symbols_update_request.symbol_locator_key[position] = symbol_locator_key[position];
        transition {
            _ -> copy_symbol_locator_key(project_symbols_update_request, symbol_locator_key, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_symbol_locator_key(project_symbols_update_request: &mut ProjectSymbolsUpdateRequest, count: u64) {
        project_symbols_update_request.symbol_locator_key_len = count;
    }
}

