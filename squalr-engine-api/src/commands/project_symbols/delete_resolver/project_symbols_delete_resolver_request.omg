module src::commands::project_symbols::delete_resolver::project_symbols_delete_resolver_request;

// Port of commands/project_symbols/delete_resolver/project_symbols_delete_resolver_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsDeleteResolverRequest {
    resolver_id: [u8; 256];
    resolver_id_len: u64;
}

pub machine ProjectSymbolsDeleteResolverRequest::new() -> ProjectSymbolsDeleteResolverRequest {
    ProjectSymbolsDeleteResolverRequest {
        resolver_id_len: 0,
    }
}

pub machine ProjectSymbolsDeleteResolverRequest::default() -> ProjectSymbolsDeleteResolverRequest {
    ProjectSymbolsDeleteResolverRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsDeleteResolverRequest::get_resolver_id(&self) -> &[u8] {
    transition self.resolver_id_len <= 256 {
        true -> (&self.resolver_id[0..self.resolver_id_len])
        false -> (&self.resolver_id[0..256])
        _ -> (&self.resolver_id[0..256])
    }
}

pub machine ProjectSymbolsDeleteResolverRequest::set_resolver_id(&mut self, resolver_id: &[u8]) {
    self.resolver_id_len = 0;
    transition {
        _ -> copy_resolver_id(resolver_id, 0)
    }
    state copy_resolver_id(&mut self, resolver_id: &[u8], position: u64) {
        transition position < resolver_id.len && position < 256 {
            true -> store_resolver_id(resolver_id, position)
            false -> finish_resolver_id(position)
        }
    }
    state store_resolver_id(&mut self, resolver_id: &[u8], position: u64) {
        self.resolver_id[position] = resolver_id[position];
        transition {
            _ -> copy_resolver_id(resolver_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_resolver_id(&mut self, count: u64) {
        self.resolver_id_len = count;
    }
}
