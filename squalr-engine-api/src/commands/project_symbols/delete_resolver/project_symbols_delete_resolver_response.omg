module src::commands::project_symbols::delete_resolver::project_symbols_delete_resolver_response;

use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project_symbols/delete_resolver/project_symbols_delete_resolver_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).

pub data ProjectSymbolsDeleteResolverResponse {
    success: bool;
    resolver_id: [u8; 256];
    resolver_id_len: u64;
    has_error: bool;
    error: [u8; 512];
    error_len: u64;
}

pub machine ProjectSymbolsDeleteResolverResponse::new() -> ProjectSymbolsDeleteResolverResponse {
    ProjectSymbolsDeleteResolverResponse {
        success: false,
        resolver_id_len: 0,
        has_error: false,
        error_len: 0,
    }
}

pub machine ProjectSymbolsDeleteResolverResponse::default() -> ProjectSymbolsDeleteResolverResponse {
    ProjectSymbolsDeleteResolverResponse::new()
}

pub machine ProjectSymbolsDeleteResolverResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectSymbolsDeleteResolverResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsDeleteResolverResponse::get_resolver_id(&self) -> &[u8] {
    bounded_slice(&self.resolver_id[0..256], self.resolver_id_len)
}

pub machine ProjectSymbolsDeleteResolverResponse::set_resolver_id(&mut self, resolver_id: &[u8]) {
    self.resolver_id_len = BoundedByteCopy::copy(&mut self.resolver_id[0..256], resolver_id);
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectSymbolsDeleteResolverResponse::has_error(&self) -> bool {
    self.has_error
}

pub machine ProjectSymbolsDeleteResolverResponse::get_error(&self) -> &[u8] {
    bounded_slice(&self.error[0..512], self.error_len)
}

pub machine ProjectSymbolsDeleteResolverResponse::set_error(&mut self, error: &[u8]) {
    self.has_error = true;
    self.error_len = BoundedByteCopy::copy(&mut self.error[0..512], error);
}

pub machine ProjectSymbolsDeleteResolverResponse::clear_error(&mut self) {
    self.has_error = false;
    self.error_len = 0;
}
