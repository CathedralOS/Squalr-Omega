module src::commands::project_symbols::rename_module::project_symbols_rename_module_request;

use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project_symbols/rename_module/project_symbols_rename_module_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsRenameModuleRequest {
    module_name: [u8; 256];
    module_name_len: u64;
    new_module_name: [u8; 256];
    new_module_name_len: u64;
}

pub machine ProjectSymbolsRenameModuleRequest::new() -> ProjectSymbolsRenameModuleRequest {
    ProjectSymbolsRenameModuleRequest {
        module_name_len: 0,
        new_module_name_len: 0,
    }
}

pub machine ProjectSymbolsRenameModuleRequest::default() -> ProjectSymbolsRenameModuleRequest {
    ProjectSymbolsRenameModuleRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsRenameModuleRequest::get_module_name(&self) -> &[u8] {
    bounded_slice(&self.module_name[0..256], self.module_name_len)
}

pub machine ProjectSymbolsRenameModuleRequest::set_module_name(&mut self, module_name: &[u8]) {
    self.module_name_len = BoundedByteCopy::copy(&mut self.module_name[0..256], module_name);
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsRenameModuleRequest::get_new_module_name(&self) -> &[u8] {
    bounded_slice(&self.new_module_name[0..256], self.new_module_name_len)
}

pub machine ProjectSymbolsRenameModuleRequest::set_new_module_name(&mut self, new_module_name: &[u8]) {
    self.new_module_name_len = BoundedByteCopy::copy(&mut self.new_module_name[0..256], new_module_name);
}
