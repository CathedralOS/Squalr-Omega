    machine store_new_module_name(this: &mut ProjectSymbolsRenameModuleRequest, new_module_name: &[u8], position: u64) {
        this.new_module_name[position] = new_module_name[position];
        transition {
            _ -> copy_new_module_name(this, new_module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    machine finish_new_module_name(this: &mut ProjectSymbolsRenameModuleRequest, count: u64) {
