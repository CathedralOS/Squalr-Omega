module src::commands::project_symbols::rename_module::project_symbols_rename_module_request;

// Port of commands/project_symbols/rename_module/project_symbols_rename_module_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
public data ProjectSymbolsRenameModuleRequest {
    module_name: [u8; 256];
    module_name_len: u64;
    new_module_name: [u8; 256];
    new_module_name_len: u64;
}

public machine ProjectSymbolsRenameModuleRequest::new() -> ProjectSymbolsRenameModuleRequest {
    ProjectSymbolsRenameModuleRequest {
        module_name_len: 0,
        new_module_name_len: 0,
    }
}

public machine ProjectSymbolsRenameModuleRequest::default() -> ProjectSymbolsRenameModuleRequest {
    ProjectSymbolsRenameModuleRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
public machine ProjectSymbolsRenameModuleRequest::get_module_name(this: &ProjectSymbolsRenameModuleRequest) -> &[u8] {
    transition this.module_name_len <= 256 {
        true -> (&this.module_name[0..this.module_name_len])
        false -> (&this.module_name[0..256])
        _ -> (&this.module_name[0..256])
    }
}

public machine ProjectSymbolsRenameModuleRequest::set_module_name(this: &mut ProjectSymbolsRenameModuleRequest, module_name: &[u8]) {
    this.module_name_len = 0;
    transition {
        _ -> copy_module_name(this, module_name, 0)
    }
    machine copy_module_name(this: &mut ProjectSymbolsRenameModuleRequest, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store_module_name(this, module_name, position)
            false -> finish_module_name(this, position)
        }
    }
    machine store_module_name(this: &mut ProjectSymbolsRenameModuleRequest, module_name: &[u8], position: u64) {
        this.module_name[position] = module_name[position];
        transition {
            _ -> copy_module_name(this, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    machine finish_module_name(this: &mut ProjectSymbolsRenameModuleRequest, count: u64) {
        this.module_name_len = count;
    }
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
public machine ProjectSymbolsRenameModuleRequest::get_new_module_name(this: &ProjectSymbolsRenameModuleRequest) -> &[u8] {
    transition this.new_module_name_len <= 256 {
