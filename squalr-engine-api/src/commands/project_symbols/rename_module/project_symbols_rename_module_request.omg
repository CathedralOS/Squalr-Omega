module src::commands::project_symbols::rename_module::project_symbols_rename_module_request;

// Port of commands/project_symbols/rename_module/project_symbols_rename_module_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsRenameModuleRequest {
    module_name: [u8; 256];
    module_name_len: u64;
    new_module_name: [u8; 256];
    new_module_name_len: u64;
}

pub machine ProjectSymbolsRenameModuleRequest::new() -> ProjectSymbolsRenameModuleRequest {
    ProjectSymbolsRenameModuleRequest {
        module_name_len: 0,
        new_module_name_len: 0,
    }
}

pub machine ProjectSymbolsRenameModuleRequest::default() -> ProjectSymbolsRenameModuleRequest {
    ProjectSymbolsRenameModuleRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsRenameModuleRequest::get_module_name(project_symbols_rename_module_request: &ProjectSymbolsRenameModuleRequest) -> &[u8] {
    transition project_symbols_rename_module_request.module_name_len <= 256 {
        true -> (&project_symbols_rename_module_request.module_name[0..project_symbols_rename_module_request.module_name_len])
        false -> (&project_symbols_rename_module_request.module_name[0..256])
        _ -> (&project_symbols_rename_module_request.module_name[0..256])
    }
}

pub machine ProjectSymbolsRenameModuleRequest::set_module_name(project_symbols_rename_module_request: &mut ProjectSymbolsRenameModuleRequest, module_name: &[u8]) {
    project_symbols_rename_module_request.module_name_len = 0;
    transition {
        _ -> copy_module_name(project_symbols_rename_module_request, module_name, 0)
    }
    state copy_module_name(project_symbols_rename_module_request: &mut ProjectSymbolsRenameModuleRequest, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store_module_name(project_symbols_rename_module_request, module_name, position)
            false -> finish_module_name(project_symbols_rename_module_request, position)
        }
    }
    state store_module_name(project_symbols_rename_module_request: &mut ProjectSymbolsRenameModuleRequest, module_name: &[u8], position: u64) {
        project_symbols_rename_module_request.module_name[position] = module_name[position];
        transition {
            _ -> copy_module_name(project_symbols_rename_module_request, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_module_name(project_symbols_rename_module_request: &mut ProjectSymbolsRenameModuleRequest, count: u64) {
        project_symbols_rename_module_request.module_name_len = count;
    }
}

