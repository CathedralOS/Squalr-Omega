public machine ProjectSymbolsRenameModuleRequest::set_new_module_name(this: &mut ProjectSymbolsRenameModuleRequest, new_module_name: &[u8]) {
    this.new_module_name_len = 0;
    transition {
        _ -> copy_new_module_name(this, new_module_name, 0)
