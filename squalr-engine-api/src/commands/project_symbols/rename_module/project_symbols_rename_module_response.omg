module src::commands::project_symbols::rename_module::project_symbols_rename_module_response;

// Port of commands/project_symbols/rename_module/project_symbols_rename_module_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsRenameModuleResponse {
    success: bool;
    module_name: [u8; 256];
    module_name_len: u64;
}

pub machine ProjectSymbolsRenameModuleResponse::new() -> ProjectSymbolsRenameModuleResponse {
    ProjectSymbolsRenameModuleResponse {
        success: false,
        module_name_len: 0,
    }
}

pub machine ProjectSymbolsRenameModuleResponse::default() -> ProjectSymbolsRenameModuleResponse {
    ProjectSymbolsRenameModuleResponse::new()
}

pub machine ProjectSymbolsRenameModuleResponse::get_success(this: &ProjectSymbolsRenameModuleResponse) -> bool {
    this.success
}

pub machine ProjectSymbolsRenameModuleResponse::set_success(this: &mut ProjectSymbolsRenameModuleResponse, success: bool) {
    this.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsRenameModuleResponse::get_module_name(this: &ProjectSymbolsRenameModuleResponse) -> &[u8] {
    transition this.module_name_len <= 256 {
        true -> (&this.module_name[0..this.module_name_len])
        false -> (&this.module_name[0..256])
        _ -> (&this.module_name[0..256])
    }
}

pub machine ProjectSymbolsRenameModuleResponse::set_module_name(this: &mut ProjectSymbolsRenameModuleResponse, module_name: &[u8]) {
    this.module_name_len = 0;
    transition {
        _ -> copy_module_name(this, module_name, 0)
    }
    state copy_module_name(this: &mut ProjectSymbolsRenameModuleResponse, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store_module_name(this, module_name, position)
            false -> finish_module_name(this, position)
        }
    }
    state store_module_name(this: &mut ProjectSymbolsRenameModuleResponse, module_name: &[u8], position: u64) {
        this.module_name[position] = module_name[position];
        transition {
            _ -> copy_module_name(this, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_module_name(this: &mut ProjectSymbolsRenameModuleResponse, count: u64) {
        this.module_name_len = count;
    }
}
