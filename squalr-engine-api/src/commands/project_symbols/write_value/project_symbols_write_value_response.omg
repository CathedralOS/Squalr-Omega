module src::commands::project_symbols::write_value::project_symbols_write_value_response;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project_symbols/write_value/project_symbols_write_value_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).

pub data ProjectSymbolsWriteValueResponse {
    success: bool;
    has_error: bool;
    error: [u8; 512];
    error_len: u64;
}

pub machine ProjectSymbolsWriteValueResponse::new() -> ProjectSymbolsWriteValueResponse {
    ProjectSymbolsWriteValueResponse {
        success: false,
        has_error: false,
        error_len: 0,
    }
}

pub machine ProjectSymbolsWriteValueResponse::default() -> ProjectSymbolsWriteValueResponse {
    ProjectSymbolsWriteValueResponse::new()
}

pub machine ProjectSymbolsWriteValueResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectSymbolsWriteValueResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectSymbolsWriteValueResponse::has_error(&self) -> bool {
    self.has_error
}

pub machine ProjectSymbolsWriteValueResponse::get_error(&self) -> &[u8] {
    transition self.error_len <= 512 {
        true -> (&self.error[0..self.error_len])
        false -> (&self.error[0..512])
        _ -> (&self.error[0..512])
    }
}

pub machine ProjectSymbolsWriteValueResponse::set_error(&mut self, error: &[u8]) {
    self.has_error = true;
    self.error_len = BoundedByteCopy::copy(&mut self.error[0..512], error);
}

pub machine ProjectSymbolsWriteValueResponse::clear_error(&mut self) {
    self.has_error = false;
    self.error_len = 0;
}
