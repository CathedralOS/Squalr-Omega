module src::commands::project_symbols::write_value::project_symbols_write_value_response;

// Port of commands/project_symbols/write_value/project_symbols_write_value_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsWriteValueResponse {
    success: bool;
    has_error: bool;
    error: [u8; 512];
    error_len: u64;
}

pub machine ProjectSymbolsWriteValueResponse::new() -> ProjectSymbolsWriteValueResponse {
    ProjectSymbolsWriteValueResponse {
        success: false,
        has_error: false,
        error_len: 0,
    }
}

pub machine ProjectSymbolsWriteValueResponse::default() -> ProjectSymbolsWriteValueResponse {
    ProjectSymbolsWriteValueResponse::new()
}

pub machine ProjectSymbolsWriteValueResponse::get_success(this: &ProjectSymbolsWriteValueResponse) -> bool {
    this.success
}

pub machine ProjectSymbolsWriteValueResponse::set_success(this: &mut ProjectSymbolsWriteValueResponse, success: bool) {
    this.success = success;
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectSymbolsWriteValueResponse::has_error(this: &ProjectSymbolsWriteValueResponse) -> bool {
    this.has_error
}

pub machine ProjectSymbolsWriteValueResponse::get_error(this: &ProjectSymbolsWriteValueResponse) -> &[u8] {
    transition this.error_len <= 512 {
        true -> (&this.error[0..this.error_len])
        false -> (&this.error[0..512])
        _ -> (&this.error[0..512])
    }
}

pub machine ProjectSymbolsWriteValueResponse::set_error(this: &mut ProjectSymbolsWriteValueResponse, error: &[u8]) {
    this.has_error = true;
    this.error_len = 0;
    transition {
        _ -> copy_error(this, error, 0)
    }
    state copy_error(this: &mut ProjectSymbolsWriteValueResponse, error: &[u8], position: u64) {
        transition position < error.len && position < 512 {
            true -> store_error(this, error, position)
            false -> finish_error(this, position)
        }
    }
    state store_error(this: &mut ProjectSymbolsWriteValueResponse, error: &[u8], position: u64) {
        this.error[position] = error[position];
        transition {
            _ -> copy_error(this, error, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_error(this: &mut ProjectSymbolsWriteValueResponse, count: u64) {
        this.error_len = count;
    }
}

pub machine ProjectSymbolsWriteValueResponse::clear_error(this: &mut ProjectSymbolsWriteValueResponse) {
    this.has_error = false;
    this.error_len = 0;
}
