module src::commands::project_symbols::delete::project_symbols_delete_request;

use src::structures::projects::project_string_list::ProjectStringList;
// Port of commands/project_symbols/delete/project_symbols_delete_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
// Upstream `ProjectSymbolsDeleteModuleRangeMode` — the delete-range policy
// (shift surviving fields left vs. blank the range).
pub data ProjectSymbolsDeleteModuleRangeMode [copy] {
    case ShiftLeft;
    case ReplaceWithUnassigned;
}

// Upstream `ProjectSymbolsDeleteModuleRange` — one bounded module range.
pub data ProjectSymbolsDeleteModuleRange {
    module_name: [u8; 256];
    module_name_len: u64;
    offset: u64;
    length: u64;
    mode: ProjectSymbolsDeleteModuleRangeMode;
}

pub machine ProjectSymbolsDeleteModuleRange::new(
    module_name: &[u8],
    offset: u64,
    length: u64,
    mode: ProjectSymbolsDeleteModuleRangeMode
) -> ProjectSymbolsDeleteModuleRange {
    let mut range: ProjectSymbolsDeleteModuleRange = ProjectSymbolsDeleteModuleRange {
        module_name_len: 0,
        offset: offset,
        length: length,
        mode: mode,
    };
    ProjectSymbolsDeleteModuleRange::set_module_name(&mut range, module_name);
    (range)
}

pub machine ProjectSymbolsDeleteModuleRange::default() -> ProjectSymbolsDeleteModuleRange {
    (ProjectSymbolsDeleteModuleRange {
        module_name_len: 0,
        offset: 0,
        length: 0,
        mode: ProjectSymbolsDeleteModuleRangeMode::ShiftLeft,
    })
}

pub machine ProjectSymbolsDeleteModuleRange::get_module_name(this: &ProjectSymbolsDeleteModuleRange) -> &[u8] {
    transition this.module_name_len <= 256 {
        true -> (&this.module_name[0..this.module_name_len])
        false -> (&this.module_name[0..256])
        _ -> (&this.module_name[0..256])
    }
}

pub machine ProjectSymbolsDeleteModuleRange::set_module_name(this: &mut ProjectSymbolsDeleteModuleRange, module_name: &[u8]) {
    this.module_name_len = 0;
    transition {
        _ -> copy(this, module_name, 0)
    }
    state copy(this: &mut ProjectSymbolsDeleteModuleRange, module_name: &[u8], position: u64) {
        transition position < module_name.len && position < 256 {
            true -> store(this, module_name, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut ProjectSymbolsDeleteModuleRange, module_name: &[u8], position: u64) {
        this.module_name[position] = module_name[position];
        transition {
            _ -> copy(this, module_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut ProjectSymbolsDeleteModuleRange, count: u64) {
        this.module_name_len = count;
    }
}

pub machine ProjectSymbolsDeleteModuleRange::get_offset(this: &ProjectSymbolsDeleteModuleRange) -> u64 {
    this.offset
}

pub machine ProjectSymbolsDeleteModuleRange::get_length(this: &ProjectSymbolsDeleteModuleRange) -> u64 {
    this.length
}

pub machine ProjectSymbolsDeleteModuleRange::get_mode(this: &ProjectSymbolsDeleteModuleRange) -> ProjectSymbolsDeleteModuleRangeMode {
    this.mode
}

pub data ProjectSymbolsDeleteRequest {
    symbol_locator_keys: ProjectStringList;
    module_names: ProjectStringList;
    module_ranges: [ProjectSymbolsDeleteModuleRange; 32];
    module_range_count: u64;
}

pub machine ProjectSymbolsDeleteRequest::new() -> ProjectSymbolsDeleteRequest {
    ProjectSymbolsDeleteRequest {
        symbol_locator_keys: ProjectStringList::empty(),
        module_names: ProjectStringList::empty(),
        module_range_count: 0,
    }
}

pub machine ProjectSymbolsDeleteRequest::default() -> ProjectSymbolsDeleteRequest {
    ProjectSymbolsDeleteRequest::new()
}

pub machine ProjectSymbolsDeleteRequest::get_symbol_locator_keys(this: &ProjectSymbolsDeleteRequest) -> &ProjectStringList {
    &this.symbol_locator_keys
}

pub machine ProjectSymbolsDeleteRequest::set_symbol_locator_keys(this: &mut ProjectSymbolsDeleteRequest, symbol_locator_keys: ProjectStringList) {
    this.symbol_locator_keys = symbol_locator_keys;
}

pub machine ProjectSymbolsDeleteRequest::get_module_names(this: &ProjectSymbolsDeleteRequest) -> &ProjectStringList {
    &this.module_names
}

pub machine ProjectSymbolsDeleteRequest::set_module_names(this: &mut ProjectSymbolsDeleteRequest, module_names: ProjectStringList) {
    this.module_names = module_names;
}

// Upstream `Vec<ProjectSymbolsDeleteModuleRange>` -> bounded [ProjectSymbolsDeleteModuleRange; 32] + live count; `add_module_range`
// refuses past the bound rather than truncating.
pub machine ProjectSymbolsDeleteRequest::get_module_range_count(this: &ProjectSymbolsDeleteRequest) -> u64 {
    this.module_range_count
}

// Guarded element access — callers gate on get_module_range_count.
pub machine ProjectSymbolsDeleteRequest::get_module_range(this: &ProjectSymbolsDeleteRequest, index: u64) -> &ProjectSymbolsDeleteModuleRange
    requires 0 <= index && index < 32
{
    &this.module_ranges[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectSymbolsDeleteRequest::add_module_range(this: &mut ProjectSymbolsDeleteRequest, module_range: ProjectSymbolsDeleteModuleRange) -> bool {
    transition this.module_range_count < 32 {
        true -> store_module_range(this, module_range)
        false -> (false)
        _ -> (false)
    }
    state store_module_range(this: &mut ProjectSymbolsDeleteRequest, module_range: ProjectSymbolsDeleteModuleRange) -> bool {
        let index: u64 = this.module_range_count;
        transition index < 32 {
            true -> fill_module_range(this, module_range, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_module_range(this: &mut ProjectSymbolsDeleteRequest, module_range: ProjectSymbolsDeleteModuleRange, index: u64) -> bool
        requires 0 <= index && index < 32
    {
        this.module_ranges[index] = module_range;
        this.module_range_count = index + 1;
        (true)
    }
}
