module src::commands::project_symbols::rename::project_symbols_rename_request;

use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project_symbols/rename/project_symbols_rename_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsRenameRequest {
    symbol_locator_key: [u8; 256];
    symbol_locator_key_len: u64;
    display_name: [u8; 256];
    display_name_len: u64;
}

pub machine ProjectSymbolsRenameRequest::new() -> ProjectSymbolsRenameRequest {
    ProjectSymbolsRenameRequest {
        symbol_locator_key_len: 0,
        display_name_len: 0,
    }
}

pub machine ProjectSymbolsRenameRequest::default() -> ProjectSymbolsRenameRequest {
    ProjectSymbolsRenameRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsRenameRequest::get_symbol_locator_key(&self) -> &[u8] {
    bounded_slice(&self.symbol_locator_key[0..256], self.symbol_locator_key_len)
}

pub machine ProjectSymbolsRenameRequest::set_symbol_locator_key(&mut self, symbol_locator_key: &[u8]) {
    self.symbol_locator_key_len = BoundedByteCopy::copy(&mut self.symbol_locator_key[0..256], symbol_locator_key);
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsRenameRequest::get_display_name(&self) -> &[u8] {
    bounded_slice(&self.display_name[0..256], self.display_name_len)
}

pub machine ProjectSymbolsRenameRequest::set_display_name(&mut self, display_name: &[u8]) {
    self.display_name_len = BoundedByteCopy::copy(&mut self.display_name[0..256], display_name);
}
