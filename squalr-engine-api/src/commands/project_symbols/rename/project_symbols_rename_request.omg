module src::commands::project_symbols::rename::project_symbols_rename_request;

// Port of commands/project_symbols/rename/project_symbols_rename_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsRenameRequest {
    symbol_locator_key: [u8; 256];
    symbol_locator_key_len: u64;
    display_name: [u8; 256];
    display_name_len: u64;
}

pub machine ProjectSymbolsRenameRequest::new() -> ProjectSymbolsRenameRequest {
    ProjectSymbolsRenameRequest {
        symbol_locator_key_len: 0,
        display_name_len: 0,
    }
}

pub machine ProjectSymbolsRenameRequest::default() -> ProjectSymbolsRenameRequest {
    ProjectSymbolsRenameRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsRenameRequest::get_symbol_locator_key(project_symbols_rename_request: &ProjectSymbolsRenameRequest) -> &[u8] {
    transition project_symbols_rename_request.symbol_locator_key_len <= 256 {
        true -> (&project_symbols_rename_request.symbol_locator_key[0..project_symbols_rename_request.symbol_locator_key_len])
        false -> (&project_symbols_rename_request.symbol_locator_key[0..256])
        _ -> (&project_symbols_rename_request.symbol_locator_key[0..256])
    }
}

pub machine ProjectSymbolsRenameRequest::set_symbol_locator_key(project_symbols_rename_request: &mut ProjectSymbolsRenameRequest, symbol_locator_key: &[u8]) {
    project_symbols_rename_request.symbol_locator_key_len = 0;
    transition {
        _ -> copy_symbol_locator_key(project_symbols_rename_request, symbol_locator_key, 0)
    }
    state copy_symbol_locator_key(project_symbols_rename_request: &mut ProjectSymbolsRenameRequest, symbol_locator_key: &[u8], position: u64) {
        transition position < symbol_locator_key.len && position < 256 {
            true -> store_symbol_locator_key(project_symbols_rename_request, symbol_locator_key, position)
            false -> finish_symbol_locator_key(project_symbols_rename_request, position)
        }
    }
    state store_symbol_locator_key(project_symbols_rename_request: &mut ProjectSymbolsRenameRequest, symbol_locator_key: &[u8], position: u64) {
        project_symbols_rename_request.symbol_locator_key[position] = symbol_locator_key[position];
        transition {
            _ -> copy_symbol_locator_key(project_symbols_rename_request, symbol_locator_key, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_symbol_locator_key(project_symbols_rename_request: &mut ProjectSymbolsRenameRequest, count: u64) {
        project_symbols_rename_request.symbol_locator_key_len = count;
    }
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsRenameRequest::get_display_name(project_symbols_rename_request: &ProjectSymbolsRenameRequest) -> &[u8] {
    transition project_symbols_rename_request.display_name_len <= 256 {
        true -> (&project_symbols_rename_request.display_name[0..project_symbols_rename_request.display_name_len])
        false -> (&project_symbols_rename_request.display_name[0..256])
        _ -> (&project_symbols_rename_request.display_name[0..256])
    }
}

pub machine ProjectSymbolsRenameRequest::set_display_name(project_symbols_rename_request: &mut ProjectSymbolsRenameRequest, display_name: &[u8]) {
    project_symbols_rename_request.display_name_len = 0;
    transition {
        _ -> copy_display_name(project_symbols_rename_request, display_name, 0)
    }
    state copy_display_name(project_symbols_rename_request: &mut ProjectSymbolsRenameRequest, display_name: &[u8], position: u64) {
        transition position < display_name.len && position < 256 {
            true -> store_display_name(project_symbols_rename_request, display_name, position)
            false -> finish_display_name(project_symbols_rename_request, position)
        }
    }
    state store_display_name(project_symbols_rename_request: &mut ProjectSymbolsRenameRequest, display_name: &[u8], position: u64) {
        project_symbols_rename_request.display_name[position] = display_name[position];
        transition {
            _ -> copy_display_name(project_symbols_rename_request, display_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_display_name(project_symbols_rename_request: &mut ProjectSymbolsRenameRequest, count: u64) {
        project_symbols_rename_request.display_name_len = count;
    }
}
