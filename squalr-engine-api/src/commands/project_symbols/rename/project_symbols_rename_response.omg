module src::commands::project_symbols::rename::project_symbols_rename_response;

// Port of commands/project_symbols/rename/project_symbols_rename_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsRenameResponse {
    success: bool;
    symbol_locator_key: [u8; 256];
    symbol_locator_key_len: u64;
}

pub machine ProjectSymbolsRenameResponse::new() -> ProjectSymbolsRenameResponse {
    ProjectSymbolsRenameResponse {
        success: false,
        symbol_locator_key_len: 0,
    }
}

pub machine ProjectSymbolsRenameResponse::default() -> ProjectSymbolsRenameResponse {
    ProjectSymbolsRenameResponse::new()
}

pub machine ProjectSymbolsRenameResponse::get_success(project_symbols_rename_response: &ProjectSymbolsRenameResponse) -> bool {
    project_symbols_rename_response.success
}

pub machine ProjectSymbolsRenameResponse::set_success(project_symbols_rename_response: &mut ProjectSymbolsRenameResponse, success: bool) {
    project_symbols_rename_response.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsRenameResponse::get_symbol_locator_key(project_symbols_rename_response: &ProjectSymbolsRenameResponse) -> &[u8] {
    transition project_symbols_rename_response.symbol_locator_key_len <= 256 {
        true -> (&project_symbols_rename_response.symbol_locator_key[0..project_symbols_rename_response.symbol_locator_key_len])
        false -> (&project_symbols_rename_response.symbol_locator_key[0..256])
        _ -> (&project_symbols_rename_response.symbol_locator_key[0..256])
    }
}

pub machine ProjectSymbolsRenameResponse::set_symbol_locator_key(project_symbols_rename_response: &mut ProjectSymbolsRenameResponse, symbol_locator_key: &[u8]) {
    project_symbols_rename_response.symbol_locator_key_len = 0;
    transition {
        _ -> copy_symbol_locator_key(project_symbols_rename_response, symbol_locator_key, 0)
    }
    state copy_symbol_locator_key(project_symbols_rename_response: &mut ProjectSymbolsRenameResponse, symbol_locator_key: &[u8], position: u64) {
        transition position < symbol_locator_key.len && position < 256 {
            true -> store_symbol_locator_key(project_symbols_rename_response, symbol_locator_key, position)
            false -> finish_symbol_locator_key(project_symbols_rename_response, position)
        }
    }
    state store_symbol_locator_key(project_symbols_rename_response: &mut ProjectSymbolsRenameResponse, symbol_locator_key: &[u8], position: u64) {
        project_symbols_rename_response.symbol_locator_key[position] = symbol_locator_key[position];
        transition {
            _ -> copy_symbol_locator_key(project_symbols_rename_response, symbol_locator_key, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_symbol_locator_key(project_symbols_rename_response: &mut ProjectSymbolsRenameResponse, count: u64) {
        project_symbols_rename_response.symbol_locator_key_len = count;
    }
}
