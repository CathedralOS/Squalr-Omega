module src::commands::project_symbols::rename::project_symbols_rename_response;

// Port of commands/project_symbols/rename/project_symbols_rename_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
public data ProjectSymbolsRenameResponse {
    success: bool;
    symbol_locator_key: [u8; 256];
    symbol_locator_key_len: u64;
}

public machine ProjectSymbolsRenameResponse::new() -> ProjectSymbolsRenameResponse {
    ProjectSymbolsRenameResponse {
        success: false,
        symbol_locator_key_len: 0,
    }
}

public machine ProjectSymbolsRenameResponse::default() -> ProjectSymbolsRenameResponse {
    ProjectSymbolsRenameResponse::new()
}

public machine ProjectSymbolsRenameResponse::get_success(this: &ProjectSymbolsRenameResponse) -> bool {
    this.success
}

public machine ProjectSymbolsRenameResponse::set_success(this: &mut ProjectSymbolsRenameResponse, success: bool) {
    this.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
public machine ProjectSymbolsRenameResponse::get_symbol_locator_key(this: &ProjectSymbolsRenameResponse) -> &[u8] {
    transition this.symbol_locator_key_len <= 256 {
        true -> (&this.symbol_locator_key[0..this.symbol_locator_key_len])
        false -> (&this.symbol_locator_key[0..256])
        _ -> (&this.symbol_locator_key[0..256])
    }
}

public machine ProjectSymbolsRenameResponse::set_symbol_locator_key(this: &mut ProjectSymbolsRenameResponse, symbol_locator_key: &[u8]) {
    this.symbol_locator_key_len = 0;
    transition {
        _ -> copy_symbol_locator_key(this, symbol_locator_key, 0)
    }
    machine copy_symbol_locator_key(this: &mut ProjectSymbolsRenameResponse, symbol_locator_key: &[u8], position: u64) {
        transition position < symbol_locator_key.len && position < 256 {
            true -> store_symbol_locator_key(this, symbol_locator_key, position)
            false -> finish_symbol_locator_key(this, position)
        }
    }
    machine store_symbol_locator_key(this: &mut ProjectSymbolsRenameResponse, symbol_locator_key: &[u8], position: u64) {
        this.symbol_locator_key[position] = symbol_locator_key[position];
        transition {
            _ -> copy_symbol_locator_key(this, symbol_locator_key, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    machine finish_symbol_locator_key(this: &mut ProjectSymbolsRenameResponse, count: u64) {
        this.symbol_locator_key_len = count;
    }
}
