pub machine ProjectSymbolsCreateRequest::get_metadata_entry(project_symbols_create_request: &ProjectSymbolsCreateRequest, index: u64) -> &ProjectSymbolClaimMetadataEntry
    requires 0 <= index && index < 32
{
