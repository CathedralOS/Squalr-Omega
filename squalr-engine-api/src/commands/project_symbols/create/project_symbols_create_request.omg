    state copy_display_name(project_symbols_create_request: &mut ProjectSymbolsCreateRequest, display_name: &[u8], position: u64) {
        transition position < display_name.len && position < 256 {
            true -> store_display_name(project_symbols_create_request, display_name, position)
            false -> finish_display_name(project_symbols_create_request, position)
        }
    }
    state store_display_name(project_symbols_create_request: &mut ProjectSymbolsCreateRequest, display_name: &[u8], position: u64) {
        project_symbols_create_request.display_name[position] = display_name[position];
        transition {
            _ -> copy_display_name(project_symbols_create_request, display_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_display_name(project_symbols_create_request: &mut ProjectSymbolsCreateRequest, count: u64) {
        project_symbols_create_request.display_name_len = count;
