}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectSymbolsCreateRequest::add_metadata_entry(project_symbols_create_request: &mut ProjectSymbolsCreateRequest, metadata_entry: ProjectSymbolClaimMetadataEntry) -> bool {
    transition project_symbols_create_request.metadata_entry_count < 32 {
        true -> store_metadata_entry(project_symbols_create_request, metadata_entry)
        false -> (false)
        _ -> (false)
    }
    state store_metadata_entry(project_symbols_create_request: &mut ProjectSymbolsCreateRequest, metadata_entry: ProjectSymbolClaimMetadataEntry) -> bool {
        let index: u64 = project_symbols_create_request.metadata_entry_count;
        transition index < 32 {
            true -> fill_metadata_entry(project_symbols_create_request, metadata_entry, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_metadata_entry(project_symbols_create_request: &mut ProjectSymbolsCreateRequest, metadata_entry: ProjectSymbolClaimMetadataEntry, index: u64) -> bool
        requires 0 <= index && index < 32
    {
        project_symbols_create_request.metadata[index] = metadata_entry;
        project_symbols_create_request.metadata_entry_count = index + 1;
        (true)
    }
}
