module src::commands::project_symbols::create::project_symbols_create_response;

// Port of commands/project_symbols/create/project_symbols_create_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsCreateResponse {
    success: bool;
    created_symbol_locator_key: [u8; 256];
    created_symbol_locator_key_len: u64;
}

pub machine ProjectSymbolsCreateResponse::new() -> ProjectSymbolsCreateResponse {
    ProjectSymbolsCreateResponse {
        success: false,
        created_symbol_locator_key_len: 0,
    }
}

pub machine ProjectSymbolsCreateResponse::default() -> ProjectSymbolsCreateResponse {
    ProjectSymbolsCreateResponse::new()
}

pub machine ProjectSymbolsCreateResponse::get_success(project_symbols_create_response: &ProjectSymbolsCreateResponse) -> bool {
    project_symbols_create_response.success
}

pub machine ProjectSymbolsCreateResponse::set_success(project_symbols_create_response: &mut ProjectSymbolsCreateResponse, success: bool) {
    project_symbols_create_response.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsCreateResponse::get_created_symbol_locator_key(project_symbols_create_response: &ProjectSymbolsCreateResponse) -> &[u8] {
    transition project_symbols_create_response.created_symbol_locator_key_len <= 256 {
        true -> (&project_symbols_create_response.created_symbol_locator_key[0..project_symbols_create_response.created_symbol_locator_key_len])
        false -> (&project_symbols_create_response.created_symbol_locator_key[0..256])
        _ -> (&project_symbols_create_response.created_symbol_locator_key[0..256])
    }
}

pub machine ProjectSymbolsCreateResponse::set_created_symbol_locator_key(project_symbols_create_response: &mut ProjectSymbolsCreateResponse, created_symbol_locator_key: &[u8]) {
    project_symbols_create_response.created_symbol_locator_key_len = 0;
    transition {
        _ -> copy_created_symbol_locator_key(project_symbols_create_response, created_symbol_locator_key, 0)
    }
    state copy_created_symbol_locator_key(project_symbols_create_response: &mut ProjectSymbolsCreateResponse, created_symbol_locator_key: &[u8], position: u64) {
        transition position < created_symbol_locator_key.len && position < 256 {
            true -> store_created_symbol_locator_key(project_symbols_create_response, created_symbol_locator_key, position)
            false -> finish_created_symbol_locator_key(project_symbols_create_response, position)
        }
    }
    state store_created_symbol_locator_key(project_symbols_create_response: &mut ProjectSymbolsCreateResponse, created_symbol_locator_key: &[u8], position: u64) {
        project_symbols_create_response.created_symbol_locator_key[position] = created_symbol_locator_key[position];
        transition {
            _ -> copy_created_symbol_locator_key(project_symbols_create_response, created_symbol_locator_key, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_created_symbol_locator_key(project_symbols_create_response: &mut ProjectSymbolsCreateResponse, count: u64) {
        project_symbols_create_response.created_symbol_locator_key_len = count;
    }
}
