module src::commands::project_symbols::create::project_symbols_create_response;

// Port of commands/project_symbols/create/project_symbols_create_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
public data ProjectSymbolsCreateResponse {
    success: bool;
    created_symbol_locator_key: [u8; 256];
    created_symbol_locator_key_len: u64;
}

public machine ProjectSymbolsCreateResponse::new() -> ProjectSymbolsCreateResponse {
    ProjectSymbolsCreateResponse {
        success: false,
        created_symbol_locator_key_len: 0,
    }
}

public machine ProjectSymbolsCreateResponse::default() -> ProjectSymbolsCreateResponse {
    ProjectSymbolsCreateResponse::new()
}

public machine ProjectSymbolsCreateResponse::get_success(this: &ProjectSymbolsCreateResponse) -> bool {
    this.success
}

public machine ProjectSymbolsCreateResponse::set_success(this: &mut ProjectSymbolsCreateResponse, success: bool) {
    this.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
public machine ProjectSymbolsCreateResponse::get_created_symbol_locator_key(this: &ProjectSymbolsCreateResponse) -> &[u8] {
    transition this.created_symbol_locator_key_len <= 256 {
        true -> (&this.created_symbol_locator_key[0..this.created_symbol_locator_key_len])
        false -> (&this.created_symbol_locator_key[0..256])
        _ -> (&this.created_symbol_locator_key[0..256])
    }
}

public machine ProjectSymbolsCreateResponse::set_created_symbol_locator_key(this: &mut ProjectSymbolsCreateResponse, created_symbol_locator_key: &[u8]) {
    this.created_symbol_locator_key_len = 0;
    transition {
        _ -> copy_created_symbol_locator_key(this, created_symbol_locator_key, 0)
    }
    machine copy_created_symbol_locator_key(this: &mut ProjectSymbolsCreateResponse, created_symbol_locator_key: &[u8], position: u64) {
        transition position < created_symbol_locator_key.len && position < 256 {
            true -> store_created_symbol_locator_key(this, created_symbol_locator_key, position)
            false -> finish_created_symbol_locator_key(this, position)
        }
    }
    machine store_created_symbol_locator_key(this: &mut ProjectSymbolsCreateResponse, created_symbol_locator_key: &[u8], position: u64) {
        this.created_symbol_locator_key[position] = created_symbol_locator_key[position];
        transition {
            _ -> copy_created_symbol_locator_key(this, created_symbol_locator_key, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    machine finish_created_symbol_locator_key(this: &mut ProjectSymbolsCreateResponse, count: u64) {
        this.created_symbol_locator_key_len = count;
    }
}
