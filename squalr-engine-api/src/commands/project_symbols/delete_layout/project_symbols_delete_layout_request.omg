    }
    state store_struct_layout_id(&mut self, struct_layout_id: &[u8], position: u64) {
        self.struct_layout_id[position] = struct_layout_id[position];
        transition {
            _ -> copy_struct_layout_id(struct_layout_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
