module src::commands::project_symbols::upsert_layout::project_symbols_upsert_layout_request;

use src::structures::projects::project_string_list::ProjectStringList;
// Port of commands/project_symbols/upsert_layout/project_symbols_upsert_layout_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsUpsertLayoutRequest {
    has_original_struct_layout_id: bool;
    original_struct_layout_id: [u8; 256];
    original_struct_layout_id_len: u64;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
    layout_kind: [u8; 256];
    layout_kind_len: u64;
    has_size_in_bytes: bool;
    size_in_bytes: u64;
    field_definitions: ProjectStringList;
}

pub machine ProjectSymbolsUpsertLayoutRequest::new() -> ProjectSymbolsUpsertLayoutRequest {
    ProjectSymbolsUpsertLayoutRequest {
        has_original_struct_layout_id: false,
        original_struct_layout_id_len: 0,
        struct_layout_id_len: 0,
        layout_kind_len: 0,
        has_size_in_bytes: false,
        size_in_bytes: 0,
        field_definitions: ProjectStringList::empty(),
    }
}

pub machine ProjectSymbolsUpsertLayoutRequest::default() -> ProjectSymbolsUpsertLayoutRequest {
    ProjectSymbolsUpsertLayoutRequest::new()
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectSymbolsUpsertLayoutRequest::has_original_struct_layout_id(this: &ProjectSymbolsUpsertLayoutRequest) -> bool {
    this.has_original_struct_layout_id
}

pub machine ProjectSymbolsUpsertLayoutRequest::get_original_struct_layout_id(this: &ProjectSymbolsUpsertLayoutRequest) -> &[u8] {
    transition this.original_struct_layout_id_len <= 256 {
        true -> (&this.original_struct_layout_id[0..this.original_struct_layout_id_len])
        false -> (&this.original_struct_layout_id[0..256])
        _ -> (&this.original_struct_layout_id[0..256])
    }
}

pub machine ProjectSymbolsUpsertLayoutRequest::set_original_struct_layout_id(this: &mut ProjectSymbolsUpsertLayoutRequest, original_struct_layout_id: &[u8]) {
    this.has_original_struct_layout_id = true;
    this.original_struct_layout_id_len = 0;
    transition {
        _ -> copy_original_struct_layout_id(this, original_struct_layout_id, 0)
    }
    state copy_original_struct_layout_id(this: &mut ProjectSymbolsUpsertLayoutRequest, original_struct_layout_id: &[u8], position: u64) {
        transition position < original_struct_layout_id.len && position < 256 {
            true -> store_original_struct_layout_id(this, original_struct_layout_id, position)
            false -> finish_original_struct_layout_id(this, position)
        }
    }
    state store_original_struct_layout_id(this: &mut ProjectSymbolsUpsertLayoutRequest, original_struct_layout_id: &[u8], position: u64) {
        this.original_struct_layout_id[position] = original_struct_layout_id[position];
        transition {
            _ -> copy_original_struct_layout_id(this, original_struct_layout_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_original_struct_layout_id(this: &mut ProjectSymbolsUpsertLayoutRequest, count: u64) {
        this.original_struct_layout_id_len = count;
    }
}

pub machine ProjectSymbolsUpsertLayoutRequest::clear_original_struct_layout_id(this: &mut ProjectSymbolsUpsertLayoutRequest) {
    this.has_original_struct_layout_id = false;
    this.original_struct_layout_id_len = 0;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsUpsertLayoutRequest::get_struct_layout_id(this: &ProjectSymbolsUpsertLayoutRequest) -> &[u8] {
    transition this.struct_layout_id_len <= 256 {
