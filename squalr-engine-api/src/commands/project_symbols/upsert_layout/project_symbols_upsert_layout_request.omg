module src::commands::project_symbols::upsert_layout::project_symbols_upsert_layout_request;

use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::projects::project_string_list::ProjectStringList;
// Port of commands/project_symbols/upsert_layout/project_symbols_upsert_layout_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsUpsertLayoutRequest {
    has_original_struct_layout_id: bool;
    original_struct_layout_id: [u8; 256];
    original_struct_layout_id_len: u64;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
    layout_kind: [u8; 256];
    layout_kind_len: u64;
    has_size_in_bytes: bool;
    size_in_bytes: u64;
    field_definitions: ProjectStringList;
}

pub machine ProjectSymbolsUpsertLayoutRequest::new() -> ProjectSymbolsUpsertLayoutRequest {
    ProjectSymbolsUpsertLayoutRequest {
        has_original_struct_layout_id: false,
        original_struct_layout_id_len: 0,
        struct_layout_id_len: 0,
        layout_kind_len: 0,
        has_size_in_bytes: false,
        size_in_bytes: 0,
        field_definitions: ProjectStringList::empty(),
    }
}

pub machine ProjectSymbolsUpsertLayoutRequest::default() -> ProjectSymbolsUpsertLayoutRequest {
    ProjectSymbolsUpsertLayoutRequest::new()
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectSymbolsUpsertLayoutRequest::has_original_struct_layout_id(&self) -> bool {
    self.has_original_struct_layout_id
}

pub machine ProjectSymbolsUpsertLayoutRequest::get_original_struct_layout_id(&self) -> &[u8] {
    bounded_slice(&self.original_struct_layout_id[0..256], self.original_struct_layout_id_len)
}

pub machine ProjectSymbolsUpsertLayoutRequest::set_original_struct_layout_id(&mut self, original_struct_layout_id: &[u8]) {
    self.has_original_struct_layout_id = true;
    self.original_struct_layout_id_len = BoundedByteCopy::copy(&mut self.original_struct_layout_id[0..256], original_struct_layout_id);
}

pub machine ProjectSymbolsUpsertLayoutRequest::clear_original_struct_layout_id(&mut self) {
    self.has_original_struct_layout_id = false;
    self.original_struct_layout_id_len = 0;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsUpsertLayoutRequest::get_struct_layout_id(&self) -> &[u8] {
    bounded_slice(&self.struct_layout_id[0..256], self.struct_layout_id_len)
}

pub machine ProjectSymbolsUpsertLayoutRequest::set_struct_layout_id(&mut self, struct_layout_id: &[u8]) {
    self.struct_layout_id_len = BoundedByteCopy::copy(&mut self.struct_layout_id[0..256], struct_layout_id);
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsUpsertLayoutRequest::get_layout_kind(&self) -> &[u8] {
    bounded_slice(&self.layout_kind[0..256], self.layout_kind_len)
}

pub machine ProjectSymbolsUpsertLayoutRequest::set_layout_kind(&mut self, layout_kind: &[u8]) {
    self.layout_kind_len = BoundedByteCopy::copy(&mut self.layout_kind[0..256], layout_kind);
}

pub machine ProjectSymbolsUpsertLayoutRequest::has_size_in_bytes(&self) -> bool {
    self.has_size_in_bytes
}

pub machine ProjectSymbolsUpsertLayoutRequest::get_size_in_bytes(&self) -> u64 {
    self.size_in_bytes
}

pub machine ProjectSymbolsUpsertLayoutRequest::set_size_in_bytes(&mut self, size_in_bytes: u64) {
    self.size_in_bytes = size_in_bytes;
    self.has_size_in_bytes = true;
}

pub machine ProjectSymbolsUpsertLayoutRequest::clear_size_in_bytes(&mut self) {
    self.has_size_in_bytes = false;
    self.size_in_bytes = 0;
}

pub machine ProjectSymbolsUpsertLayoutRequest::get_field_definitions(&self) -> &ProjectStringList {
    &self.field_definitions
}

pub machine ProjectSymbolsUpsertLayoutRequest::set_field_definitions(&mut self, field_definitions: ProjectStringList) {
    self.field_definitions = field_definitions;
}
