        has_error: false,
        error_len: 0,
    }
}

pub machine ProjectSymbolsUpsertLayoutResponse::default() -> ProjectSymbolsUpsertLayoutResponse {
    ProjectSymbolsUpsertLayoutResponse::new()
}

pub machine ProjectSymbolsUpsertLayoutResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectSymbolsUpsertLayoutResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsUpsertLayoutResponse::get_struct_layout_id(&self) -> &[u8] {
    bounded_slice(&self.struct_layout_id[0..256], self.struct_layout_id_len)
}

pub machine ProjectSymbolsUpsertLayoutResponse::set_struct_layout_id(&mut self, struct_layout_id: &[u8]) {
    self.struct_layout_id_len = BoundedByteCopy::copy(&mut self.struct_layout_id[0..256], struct_layout_id);
