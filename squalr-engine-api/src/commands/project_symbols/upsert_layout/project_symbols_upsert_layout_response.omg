module src::commands::project_symbols::upsert_layout::project_symbols_upsert_layout_response;

// Port of commands/project_symbols/upsert_layout/project_symbols_upsert_layout_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsUpsertLayoutResponse {
    success: bool;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
    has_error: bool;
    error: [u8; 512];
    error_len: u64;
}

pub machine ProjectSymbolsUpsertLayoutResponse::new() -> ProjectSymbolsUpsertLayoutResponse {
    ProjectSymbolsUpsertLayoutResponse {
        success: false,
        struct_layout_id_len: 0,
        has_error: false,
        error_len: 0,
    }
}

pub machine ProjectSymbolsUpsertLayoutResponse::default() -> ProjectSymbolsUpsertLayoutResponse {
    ProjectSymbolsUpsertLayoutResponse::new()
}

pub machine ProjectSymbolsUpsertLayoutResponse::get_success(this: &ProjectSymbolsUpsertLayoutResponse) -> bool {
    this.success
}

pub machine ProjectSymbolsUpsertLayoutResponse::set_success(this: &mut ProjectSymbolsUpsertLayoutResponse, success: bool) {
    this.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsUpsertLayoutResponse::get_struct_layout_id(this: &ProjectSymbolsUpsertLayoutResponse) -> &[u8] {
    transition this.struct_layout_id_len <= 256 {
        true -> (&this.struct_layout_id[0..this.struct_layout_id_len])
        false -> (&this.struct_layout_id[0..256])
        _ -> (&this.struct_layout_id[0..256])
    }
}

pub machine ProjectSymbolsUpsertLayoutResponse::set_struct_layout_id(this: &mut ProjectSymbolsUpsertLayoutResponse, struct_layout_id: &[u8]) {
    this.struct_layout_id_len = 0;
    transition {
        _ -> copy_struct_layout_id(this, struct_layout_id, 0)
    }
    state copy_struct_layout_id(this: &mut ProjectSymbolsUpsertLayoutResponse, struct_layout_id: &[u8], position: u64) {
        transition position < struct_layout_id.len && position < 256 {
            true -> store_struct_layout_id(this, struct_layout_id, position)
            false -> finish_struct_layout_id(this, position)
        }
    }
    state store_struct_layout_id(this: &mut ProjectSymbolsUpsertLayoutResponse, struct_layout_id: &[u8], position: u64) {
        this.struct_layout_id[position] = struct_layout_id[position];
        transition {
            _ -> copy_struct_layout_id(this, struct_layout_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_struct_layout_id(this: &mut ProjectSymbolsUpsertLayoutResponse, count: u64) {
        this.struct_layout_id_len = count;
    }
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectSymbolsUpsertLayoutResponse::has_error(this: &ProjectSymbolsUpsertLayoutResponse) -> bool {
    this.has_error
}

pub machine ProjectSymbolsUpsertLayoutResponse::get_error(this: &ProjectSymbolsUpsertLayoutResponse) -> &[u8] {
    transition this.error_len <= 512 {
        true -> (&this.error[0..this.error_len])
        false -> (&this.error[0..512])
        _ -> (&this.error[0..512])
    }
}

pub machine ProjectSymbolsUpsertLayoutResponse::set_error(this: &mut ProjectSymbolsUpsertLayoutResponse, error: &[u8]) {
    this.has_error = true;
    this.error_len = 0;
    transition {
        _ -> copy_error(this, error, 0)
    }
    state copy_error(this: &mut ProjectSymbolsUpsertLayoutResponse, error: &[u8], position: u64) {
        transition position < error.len && position < 512 {
            true -> store_error(this, error, position)
            false -> finish_error(this, position)
        }
    }
    state store_error(this: &mut ProjectSymbolsUpsertLayoutResponse, error: &[u8], position: u64) {
        this.error[position] = error[position];
        transition {
            _ -> copy_error(this, error, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_error(this: &mut ProjectSymbolsUpsertLayoutResponse, count: u64) {
        this.error_len = count;
    }
}

pub machine ProjectSymbolsUpsertLayoutResponse::clear_error(this: &mut ProjectSymbolsUpsertLayoutResponse) {
    this.has_error = false;
    this.error_len = 0;
}
