module src::commands::project_symbols::upsert_layout::project_symbols_upsert_layout_response;

// Port of commands/project_symbols/upsert_layout/project_symbols_upsert_layout_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectSymbolsUpsertLayoutResponse {
    success: bool;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
    has_error: bool;
    error: [u8; 512];
    error_len: u64;
}

pub machine ProjectSymbolsUpsertLayoutResponse::new() -> ProjectSymbolsUpsertLayoutResponse {
    ProjectSymbolsUpsertLayoutResponse {
        success: false,
        struct_layout_id_len: 0,
        has_error: false,
        error_len: 0,
    }
}

pub machine ProjectSymbolsUpsertLayoutResponse::default() -> ProjectSymbolsUpsertLayoutResponse {
    ProjectSymbolsUpsertLayoutResponse::new()
}

pub machine ProjectSymbolsUpsertLayoutResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectSymbolsUpsertLayoutResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectSymbolsUpsertLayoutResponse::get_struct_layout_id(&self) -> &[u8] {
    transition self.struct_layout_id_len <= 256 {
        true -> (&self.struct_layout_id[0..self.struct_layout_id_len])
        false -> (&self.struct_layout_id[0..256])
        _ -> (&self.struct_layout_id[0..256])
    }
}

pub machine ProjectSymbolsUpsertLayoutResponse::set_struct_layout_id(&mut self, struct_layout_id: &[u8]) {
    self.struct_layout_id_len = 0;
    transition {
        _ -> copy_struct_layout_id(struct_layout_id, 0)
    }
    state copy_struct_layout_id(&mut self, struct_layout_id: &[u8], position: u64) {
        transition position < struct_layout_id.len && position < 256 {
            true -> store_struct_layout_id(struct_layout_id, position)
            false -> finish_struct_layout_id(position)
        }
    }
    state store_struct_layout_id(&mut self, struct_layout_id: &[u8], position: u64) {
        self.struct_layout_id[position] = struct_layout_id[position];
        transition {
            _ -> copy_struct_layout_id(struct_layout_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_struct_layout_id(&mut self, count: u64) {
        self.struct_layout_id_len = count;
    }
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectSymbolsUpsertLayoutResponse::has_error(&self) -> bool {
    self.has_error
}

pub machine ProjectSymbolsUpsertLayoutResponse::get_error(&self) -> &[u8] {
    transition self.error_len <= 512 {
        true -> (&self.error[0..self.error_len])
        false -> (&self.error[0..512])
        _ -> (&self.error[0..512])
    }
}

pub machine ProjectSymbolsUpsertLayoutResponse::set_error(&mut self, error: &[u8]) {
    self.has_error = true;
    self.error_len = 0;
    transition {
        _ -> copy_error(error, 0)
    }
    state copy_error(&mut self, error: &[u8], position: u64) {
        transition position < error.len && position < 512 {
            true -> store_error(error, position)
            false -> finish_error(position)
        }
    }
    state store_error(&mut self, error: &[u8], position: u64) {
        self.error[position] = error[position];
        transition {
            _ -> copy_error(error, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_error(&mut self, count: u64) {
        self.error_len = count;
    }
}

pub machine ProjectSymbolsUpsertLayoutResponse::clear_error(&mut self) {
    self.has_error = false;
    self.error_len = 0;
}
