// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).

pub data ProjectSymbolsUpsertLayoutResponse {
    success: bool;
    struct_layout_id: [u8; 256];
    struct_layout_id_len: u64;
    has_error: bool;
    error: [u8; 512];
    error_len: u64;
}

pub machine ProjectSymbolsUpsertLayoutResponse::new() -> ProjectSymbolsUpsertLayoutResponse {
    ProjectSymbolsUpsertLayoutResponse {
        success: false,
