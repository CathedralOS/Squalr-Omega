module src::commands::command_invocation;

use src::commands::privileged_command::PrivilegedCommand;
use src::commands::privileged_command_response::PrivilegedCommandResponse;

// Port of commands/command_invocation.rs — the deferred-execution envelope
// the engine's unprivileged state hands to its dispatcher, plus the
// middleware decision unions. EngineCommand/EngineCommandResponse carry only
// the Privileged case until the unprivileged unions (Project, ProjectItems,
// ProjectSymbols) land with the engine-projects leg. String payloads map to
// bounded byte buffers per port convention (source names, decision reasons).

// Where an invocation originated.
public data CommandInvocationSource {
    case ApiRequest;
    case Gui;
    case Prompt;
    case Tui;
    case Cli;
    case Internal;
    case Unknown(name: [u8; 256], name_len: u64);
}

// Upstream `EngineCommand::{Privileged, Unprivileged}` — the Unprivileged arm
// lands with the UnprivilegedCommand union.
public data EngineCommand {
    case Privileged(command: PrivilegedCommand);
}

// Upstream `EngineCommandResponse::{Privileged, Unprivileged}` — same pairing.
public data EngineCommandResponse {
    case Privileged(response: PrivilegedCommandResponse);
}

public data CommandInvocation {
    invocation_id: u64;
    source: CommandInvocationSource;
    command: EngineCommand;
}

public machine CommandInvocation::new(
    invocation_id: u64,
    source: CommandInvocationSource,
    command: EngineCommand
) -> CommandInvocation {
    CommandInvocation {
        invocation_id: invocation_id,
        source: source,
        command: command
    }
}

public machine CommandInvocation::get_invocation_id(this: &CommandInvocation) -> u64 {
    this.invocation_id
}

public machine CommandInvocation::get_source(this: &CommandInvocation) -> &CommandInvocationSource {
    &this.source
}

public machine CommandInvocation::get_command(this: &CommandInvocation) -> &EngineCommand {
    &this.command
}

// Upstream `replace_command(mut self, command) -> Self` — a consuming
// builder; the port keeps the same by-value consumption shape.
public machine CommandInvocation::replace_command(
    mut invocation: CommandInvocation,
    command: EngineCommand
) -> CommandInvocation {
    invocation.command = command;
    (invocation)
}

public data CommandInvocationOutcome {
    invocation: CommandInvocation;
    response: EngineCommandResponse;
}

public machine CommandInvocationOutcome::new(
    invocation: CommandInvocation,
    response: EngineCommandResponse
) -> CommandInvocationOutcome {
    CommandInvocationOutcome { invocation: invocation, response: response }
}

public machine CommandInvocationOutcome::get_invocation(this: &CommandInvocationOutcome) -> &CommandInvocation {
    &this.invocation
}

public machine CommandInvocationOutcome::get_response(this: &CommandInvocationOutcome) -> &EngineCommandResponse {
    &this.response
}

// Middleware decision unions consumed by engine_unprivileged_state when that
// leg lands; they ride the wire ahead of it as data.
public data CommandInvocationDecision {
    case Continue;
    case ReplaceCommand(command: EngineCommand);
    case Reject(reason: [u8; 256], reason_len: u64);
    case Respond(response: EngineCommandResponse);
}

public data CommandResponseDecision {
    case Continue;
    case ReplaceResponse(response: EngineCommandResponse);
    case Suppress(reason: [u8; 256], reason_len: u64);
}
