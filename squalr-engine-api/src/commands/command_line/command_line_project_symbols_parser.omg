    state upsert_layout_apply(line: &[u8], mut request: ProjectSymbolsUpsertLayoutRequest, fields: ProjectStringList) -> CommandLineParse {
        ProjectSymbolsUpsertLayoutRequest::set_field_definitions(&mut request, fields);
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::ProjectSymbols { command:
                    ProjectSymbolsCommand::UpsertLayout { request: request } } } })
