            false -> upsert_layout_i_flag(line, start, end, request, fields, seen_id)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_o_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> upsert_layout_o_slice(line, value.start, value.end, request, fields, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_o_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> upsert_layout_o_set(line, start, end, request, fields, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_o_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsUpsertLayoutRequest::set_original_struct_layout_id(&mut request, &line[start..end]);
        transition { _ -> upsert_layout_loop(line, end, request, fields, seen_id) }
    }
    state upsert_layout_i_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        let is_i: bool = flag_is(line, start, end, "i");
        let is_id: bool = flag_is(line, start, end, "id");
        transition is_i || is_id {
            true -> upsert_layout_i_value(line, start, end, request, fields)
            false -> upsert_layout_k_flag(line, start, end, request, fields, seen_id)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_i_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> upsert_layout_i_slice(line, value.start, value.end, request, fields)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_i_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> upsert_layout_i_set(line, start, end, request, fields)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_i_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsUpsertLayoutRequest::set_struct_layout_id(&mut request, &line[start..end]);
        transition { _ -> upsert_layout_loop(line, end, request, fields, true) }
    }
    state upsert_layout_k_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        let is_k: bool = flag_is(line, start, end, "k");
        let is_kind: bool = flag_is(line, start, end, "kind");
        transition is_k || is_kind {
            true -> upsert_layout_k_value(line, start, end, request, fields, seen_id)
            false -> upsert_layout_s_flag(line, start, end, request, fields, seen_id)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_k_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> upsert_layout_k_slice(line, value.start, value.end, request, fields, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_k_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> upsert_layout_k_set(line, start, end, request, fields, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_k_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsUpsertLayoutRequest::set_layout_kind(&mut request, &line[start..end]);
        transition { _ -> upsert_layout_loop(line, end, request, fields, seen_id) }
    }
    state upsert_layout_s_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        let is_s: bool = flag_is(line, start, end, "s");
        let is_size: bool = flag_is(line, start, end, "size");
        transition is_s || is_size {
            true -> upsert_layout_s_value(line, start, end, request, fields, seen_id)
            false -> upsert_layout_f_flag(line, start, end, request, fields, seen_id)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_s_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> upsert_layout_s_u64(line, value.start, value.end, request, fields, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_s_u64(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        let parsed: U64Parse = parse_u64(line, start, end);
        transition parsed.ok {
            true -> upsert_layout_s_set(line, parsed.value, end, request, fields, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_s_set(line: &[u8], value: u64, position: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        ProjectSymbolsUpsertLayoutRequest::set_size_in_bytes(&mut request, value);
        transition { _ -> upsert_layout_loop(line, position, request, fields, seen_id) }
    }
    state upsert_layout_f_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        let is_f: bool = flag_is(line, start, end, "f");
        let is_field: bool = flag_is(line, start, end, "field");
        transition is_f || is_field {
            true -> upsert_layout_f_value(line, start, end, request, fields, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_f_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> upsert_layout_f_slice(line, value.start, value.end, request, fields, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_f_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> upsert_layout_f_add(line, start, end, request, fields, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_layout_f_add(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertLayoutRequest, mut fields: ProjectStringList, seen_id: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        let added: bool = ProjectStringList::add_string(&mut fields, &line[start..end]);
        transition added {
            true -> upsert_layout_loop(line, end, request, fields, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }

    // ---- `upsert-resolver`: --original-id <id>, -i/--id <id> (required),
    // -d/--definition-json <json> (required). ----
    state upsert_resolver_loop(line: &[u8], position: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_id: bool, seen_definition: bool) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> upsert_resolver_finish(line, request, seen_id, seen_definition)
            false -> upsert_resolver_flag(line, next.start, next.end, request, seen_id, seen_definition)
        }
    }
    state upsert_resolver_finish(line: &[u8], request: ProjectSymbolsUpsertResolverRequest, seen_id: bool, seen_definition: bool) -> CommandLineParse {
        transition seen_id && seen_definition {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::ProjectSymbols { command:
                        ProjectSymbolsCommand::UpsertResolver { request: request } } } })
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_resolver_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_id: bool, seen_definition: bool) -> CommandLineParse {
        let is_original: bool = flag_is(line, start, end, "original-id");
        transition is_original {
            true -> upsert_resolver_o_value(line, start, end, request, seen_id, seen_definition)
            false -> upsert_resolver_i_flag(line, start, end, request, seen_id, seen_definition)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_resolver_o_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_id: bool, seen_definition: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> upsert_resolver_o_slice(line, value.start, value.end, request, seen_id, seen_definition)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_resolver_o_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_id: bool, seen_definition: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> upsert_resolver_o_set(line, start, end, request, seen_id, seen_definition)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_resolver_o_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_id: bool, seen_definition: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsUpsertResolverRequest::set_original_resolver_id(&mut request, &line[start..end]);
        transition { _ -> upsert_resolver_loop(line, end, request, seen_id, seen_definition) }
    }
    state upsert_resolver_i_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_id: bool, seen_definition: bool) -> CommandLineParse {
        let is_i: bool = flag_is(line, start, end, "i");
        let is_id: bool = flag_is(line, start, end, "id");
        transition is_i || is_id {
            true -> upsert_resolver_i_value(line, start, end, request, seen_definition)
            false -> upsert_resolver_d_flag(line, start, end, request, seen_id, seen_definition)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_resolver_i_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_definition: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> upsert_resolver_i_slice(line, value.start, value.end, request, seen_definition)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_resolver_i_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_definition: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> upsert_resolver_i_set(line, start, end, request, seen_definition)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_resolver_i_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_definition: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsUpsertResolverRequest::set_resolver_id(&mut request, &line[start..end]);
        transition { _ -> upsert_resolver_loop(line, end, request, true, seen_definition) }
    }
    state upsert_resolver_d_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_id: bool, seen_definition: bool) -> CommandLineParse {
        let is_d: bool = flag_is(line, start, end, "d");
        let is_definition: bool = flag_is(line, start, end, "definition-json");
        transition is_d || is_definition {
            true -> upsert_resolver_d_value(line, start, end, request, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_resolver_d_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_id: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> upsert_resolver_d_slice(line, value.start, value.end, request, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_resolver_d_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_id: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> upsert_resolver_d_set(line, start, end, request, seen_id)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state upsert_resolver_d_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsUpsertResolverRequest, seen_id: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsUpsertResolverRequest::set_resolver_definition_json(&mut request, &line[start..end]);
        transition { _ -> upsert_resolver_loop(line, end, request, seen_id, true) }
    }

    // ---- `write-value`: --address <u64> (required), --module <name>
    // (default ""), --type <layout-id> (required), --container <container>
    // (default ""), --field <name> (required), -v/--value
    // <anonymous-value-string> (required). ----
    state write_loop(line: &[u8], position: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> write_finish(line, request, seen_address, seen_type, seen_field, seen_value)
            false -> write_flag(line, next.start, next.end, request, seen_address, seen_type, seen_field, seen_value)
        }
    }
    state write_finish(line: &[u8], request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        transition seen_address && seen_type && seen_field && seen_value {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::ProjectSymbols { command:
                        ProjectSymbolsCommand::WriteValue { request: request } } } })
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let is_address: bool = flag_is(line, start, end, "address");
        transition is_address {
            true -> write_a_value(line, start, end, request, seen_type, seen_field, seen_value)
            false -> write_m_flag(line, start, end, request, seen_address, seen_type, seen_field, seen_value)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_a_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> write_a_u64(line, value.start, value.end, request, seen_type, seen_field, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_a_u64(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let parsed: U64Parse = parse_u64(line, start, end);
        transition parsed.ok {
            true -> write_a_set(line, parsed.value, end, request, seen_type, seen_field, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_a_set(line: &[u8], value: u64, position: u64, mut request: ProjectSymbolsWriteValueRequest, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        ProjectSymbolsWriteValueRequest::set_address(&mut request, value);
        transition { _ -> write_loop(line, position, request, true, seen_type, seen_field, seen_value) }
    }
    state write_m_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let is_module: bool = flag_is(line, start, end, "module");
        transition is_module {
            true -> write_m_value(line, start, end, request, seen_address, seen_type, seen_field, seen_value)
            false -> write_t_flag(line, start, end, request, seen_address, seen_type, seen_field, seen_value)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_m_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> write_m_slice(line, value.start, value.end, request, seen_address, seen_type, seen_field, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_m_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> write_m_set(line, start, end, request, seen_address, seen_type, seen_field, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_m_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsWriteValueRequest::set_module_name(&mut request, &line[start..end]);
        transition { _ -> write_loop(line, end, request, seen_address, seen_type, seen_field, seen_value) }
    }
    state write_t_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let is_type: bool = flag_is(line, start, end, "type");
        transition is_type {
            true -> write_t_value(line, start, end, request, seen_address, seen_field, seen_value)
            false -> write_c_flag(line, start, end, request, seen_address, seen_type, seen_field, seen_value)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_t_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> write_t_slice(line, value.start, value.end, request, seen_address, seen_field, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_t_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> write_t_set(line, start, end, request, seen_address, seen_field, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_t_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_field: bool, seen_value: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsWriteValueRequest::set_symbol_type_id(&mut request, &line[start..end]);
        transition { _ -> write_loop(line, end, request, seen_address, true, seen_field, seen_value) }
    }
    state write_c_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let is_container: bool = flag_is(line, start, end, "container");
        transition is_container {
            true -> write_c_value(line, start, end, request, seen_address, seen_type, seen_field, seen_value)
            false -> write_f_flag(line, start, end, request, seen_address, seen_type, seen_field, seen_value)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_c_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> write_c_parse(line, value.start, value.end, request, seen_address, seen_type, seen_field, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_c_parse(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let parsed: ContainerTypeParse = ContainerType::from_str_window(line, start, end);
        transition parsed {
            ContainerTypeParse::Parsed { value } -> write_c_set(line, value, end, request, seen_address, seen_type, seen_field, seen_value)
            ContainerTypeParse::Refused -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_c_set(line: &[u8], value: ContainerType, position: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        ProjectSymbolsWriteValueRequest::set_container_type(&mut request, value);
        transition { _ -> write_loop(line, position, request, seen_address, seen_type, seen_field, seen_value) }
    }
    state write_f_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let is_field: bool = flag_is(line, start, end, "field");
        transition is_field {
            true -> write_f_value(line, start, end, request, seen_address, seen_type, seen_value)
            false -> write_v_flag(line, start, end, request, seen_address, seen_type, seen_field, seen_value)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_f_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_value: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> write_f_slice(line, value.start, value.end, request, seen_address, seen_type, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_f_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_value: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> write_f_set(line, start, end, request, seen_address, seen_type, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_f_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_value: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsWriteValueRequest::set_field_name(&mut request, &line[start..end]);
        transition { _ -> write_loop(line, end, request, seen_address, seen_type, true, seen_value) }
    }
    state write_v_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool, seen_value: bool) -> CommandLineParse {
        let is_v: bool = flag_is(line, start, end, "v");
        let is_value: bool = flag_is(line, start, end, "value");
        transition is_v || is_value {
            true -> write_v_value(line, start, end, request, seen_address, seen_type, seen_field)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_v_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> write_v_slice(line, value.start, value.end, request, seen_address, seen_type, seen_field)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_v_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> write_v_parse(line, start, end, request, seen_address, seen_type, seen_field)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_v_parse(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        let parsed: AnonymousValueStringParse = AnonymousValueString::parse(&line[start..end]);
        transition parsed {
            AnonymousValueStringParse::Parsed { value } -> write_v_set(line, value, end, request, seen_address, seen_type, seen_field)
            AnonymousValueStringParse::Refused -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_v_set(line: &[u8], value: AnonymousValueString, position: u64, mut request: ProjectSymbolsWriteValueRequest, seen_address: bool, seen_type: bool, seen_field: bool) -> CommandLineParse {
        ProjectSymbolsWriteValueRequest::set_anonymous_value_string(&mut request, value);
        transition { _ -> write_loop(line, position, request, seen_address, seen_type, seen_field, true) }
    }
}
