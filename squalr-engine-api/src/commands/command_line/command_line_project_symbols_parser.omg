module src::commands::command_line::command_line_project_symbols_parser;

use src::commands::command_line::command_line_command::CommandLineCommand;
use src::commands::command_line::command_line_parser::CommandLineParse;
use src::commands::command_line::command_line_parser::FlagValue;
use src::commands::command_line::command_line_parser::NextToken;
use src::commands::command_line::command_line_parser::U64Parse;
use src::commands::command_line::command_line_parser::flag_is;
use src::commands::command_line::command_line_parser::flag_value;
use src::commands::command_line::command_line_parser::next_token;
use src::commands::command_line::command_line_parser::parse_u64;
use src::commands::command_line::command_line_parser::token_is;
use src::commands::project_symbols::create::project_symbols_create_request::ProjectSymbolsCreateRequest;
use src::commands::project_symbols::create_module::project_symbols_create_module_request::ProjectSymbolsCreateModuleRequest;
use src::commands::project_symbols::delete::project_symbols_delete_request::ProjectSymbolsDeleteRequest;
use src::commands::project_symbols::delete_layout::project_symbols_delete_layout_request::ProjectSymbolsDeleteLayoutRequest;
use src::commands::project_symbols::delete_resolver::project_symbols_delete_resolver_request::ProjectSymbolsDeleteResolverRequest;
use src::commands::project_symbols::list::project_symbols_list_request::ProjectSymbolsListRequest;
use src::commands::project_symbols::project_symbols_command::ProjectSymbolsCommand;
use src::commands::project_symbols::rename::project_symbols_rename_request::ProjectSymbolsRenameRequest;
use src::commands::project_symbols::rename_module::project_symbols_rename_module_request::ProjectSymbolsRenameModuleRequest;
use src::commands::project_symbols::update::project_symbols_update_request::ProjectSymbolsUpdateRequest;
use src::commands::project_symbols::upsert_layout::project_symbols_upsert_layout_request::ProjectSymbolsUpsertLayoutRequest;
use src::commands::project_symbols::upsert_resolver::project_symbols_upsert_resolver_request::ProjectSymbolsUpsertResolverRequest;
use src::commands::project_symbols::write_value::project_symbols_write_value_request::ProjectSymbolsWriteValueRequest;
use src::commands::unprivileged_command::UnprivilegedCommand;
use src::structures::data_values::anonymous_value_string::AnonymousValueString;
use src::structures::data_values::anonymous_value_string::AnonymousValueStringParse;
use src::structures::data_values::container_type::ContainerType;
use src::structures::data_values::container_type::ContainerTypeParse;
use src::structures::projects::project_string_list::ProjectStringList;

// Port of commands/command_line/project_symbols.rs — the
// `project-symbols` subcommand tree (create | create-module | delete |
// delete-layout | delete-resolver | list | rename | rename-module |
// update | upsert-layout | upsert-resolver | write-value; upstream's
// execute-plugin-action arm is GUI-only and not in this tree). Flag
// spellings follow upstream structopt; required value flags refuse the
// line when absent like clap's missing-required error, Vec flags
// accumulate one value per occurrence, and upstream's defaulted flags
// (`--kind` "struct", `--replacement-type` "u8", `--module`/"--container"
// "", `--field`... ) keep their wire-record defaults when absent.
pub data CommandLineProjectSymbolsParser {}

pub machine CommandLineProjectSymbolsParser::parse(line: &[u8], position: u64) -> CommandLineParse {
    let next: NextToken = next_token(line, position);
    transition next.is_end {
        false -> sub(line, next.start, next.end)
        true -> (CommandLineParse::Refused)
        _ -> (CommandLineParse::Refused)
    }
    state sub(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "create-module");
        transition matched {
            true -> create_module_loop(line, end, ProjectSymbolsCreateModuleRequest::new(), false, false)
            false -> sub_create(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_create(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "create");
        transition matched {
            true -> create_loop(line, end, ProjectSymbolsCreateRequest::new(), false, false)
            false -> sub_delete(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_delete(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "delete-layout");
        transition matched {
            true -> delete_layout_loop(line, end, ProjectSymbolsDeleteLayoutRequest::new(), false)
            false -> sub_delete_resolver(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_delete_resolver(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "delete-resolver");
        transition matched {
            true -> delete_resolver_loop(line, end, ProjectSymbolsDeleteResolverRequest::new(), false)
            false -> sub_delete2(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_delete2(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "delete");
        transition matched {
            true -> delete_loop(line, end, ProjectSymbolsDeleteRequest::new(), ProjectStringList::empty(), ProjectStringList::empty())
            false -> sub_list(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_list(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "list");
        transition matched {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::ProjectSymbols { command:
                        ProjectSymbolsCommand::List { request: ProjectSymbolsListRequest::new() } } } })
            false -> sub_rename(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_rename(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "rename-module");
        transition matched {
            true -> rename_module_loop(line, end, ProjectSymbolsRenameModuleRequest::new(), false, false)
            false -> sub_rename2(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_rename2(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "rename");
        transition matched {
            true -> rename_loop(line, end, ProjectSymbolsRenameRequest::new(), false, false)
            false -> sub_update(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_update(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "update");
        transition matched {
            true -> update_loop(line, end, ProjectSymbolsUpdateRequest::new(), false)
            false -> sub_upsert_layout(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_upsert_layout(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "upsert-layout");
        transition matched {
            true -> upsert_layout_loop(line, end, ProjectSymbolsUpsertLayoutRequest::new(), ProjectStringList::empty(), false)
            false -> sub_upsert_resolver(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_upsert_resolver(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "upsert-resolver");
        transition matched {
            true -> upsert_resolver_loop(line, end, ProjectSymbolsUpsertResolverRequest::new(), false, false)
            false -> sub_write(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_write(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "write-value");
        transition matched {
            true -> write_loop(line, end, ProjectSymbolsWriteValueRequest::new(), false, false, false, false)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }

    // ---- `create`: -n/--name <name> (required), -t/--type <layout-id>
    // (required), -a/--address <u64>, -m/--module <name>,
    // -o/--offset <u64>. ----
    state create_loop(line: &[u8], position: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> create_finish(line, request, seen_name, seen_type)
            false -> create_flag(line, next.start, next.end, request, seen_name, seen_type)
        }
    }
    state create_finish(line: &[u8], request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        transition seen_name && seen_type {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::ProjectSymbols { command:
                        ProjectSymbolsCommand::Create { request: request } } } })
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        let is_n: bool = flag_is(line, start, end, "n");
        let is_name: bool = flag_is(line, start, end, "name");
        transition is_n || is_name {
            true -> create_n_value(line, start, end, request, seen_type)
            false -> create_t_flag(line, start, end, request, seen_name, seen_type)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_n_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_type: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> create_n_slice(line, value.start, value.end, request, seen_type)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_n_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_type: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> create_n_set(line, start, end, request, seen_type)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_n_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_type: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsCreateRequest::set_display_name(&mut request, &line[start..end]);
        transition { _ -> create_loop(line, end, request, true, seen_type) }
    }
    state create_t_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        let is_t: bool = flag_is(line, start, end, "t");
        let is_type: bool = flag_is(line, start, end, "type");
        transition is_t || is_type {
            true -> create_t_value(line, start, end, request, seen_name)
            false -> create_a_flag(line, start, end, request, seen_name, seen_type)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_t_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> create_t_slice(line, value.start, value.end, request, seen_name)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_t_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> create_t_set(line, start, end, request, seen_name)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_t_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsCreateRequest::set_struct_layout_id(&mut request, &line[start..end]);
        transition { _ -> create_loop(line, end, request, seen_name, true) }
    }
    state create_a_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        let is_a: bool = flag_is(line, start, end, "a");
        let is_address: bool = flag_is(line, start, end, "address");
        transition is_a || is_address {
            true -> create_a_value(line, start, end, request, seen_name, seen_type)
            false -> create_m_flag(line, start, end, request, seen_name, seen_type)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_a_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> create_a_u64(line, value.start, value.end, request, seen_name, seen_type)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_a_u64(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        let parsed: U64Parse = parse_u64(line, start, end);
        transition parsed.ok {
            true -> create_a_set(line, parsed.value, end, request, seen_name, seen_type)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_a_set(line: &[u8], value: u64, position: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        ProjectSymbolsCreateRequest::set_address(&mut request, value);
        transition { _ -> create_loop(line, position, request, seen_name, seen_type) }
    }
    state create_m_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        let is_m: bool = flag_is(line, start, end, "m");
        let is_module: bool = flag_is(line, start, end, "module");
        transition is_m || is_module {
            true -> create_m_value(line, start, end, request, seen_name, seen_type)
            false -> create_o_flag(line, start, end, request, seen_name, seen_type)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_m_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> create_m_slice(line, value.start, value.end, request, seen_name, seen_type)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_m_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> create_m_set(line, start, end, request, seen_name, seen_type)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_m_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsCreateRequest::set_module_name(&mut request, &line[start..end]);
        transition { _ -> create_loop(line, end, request, seen_name, seen_type) }
    }
    state create_o_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        let is_o: bool = flag_is(line, start, end, "o");
        let is_offset: bool = flag_is(line, start, end, "offset");
        transition is_o || is_offset {
            true -> create_o_value(line, start, end, request, seen_name, seen_type)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_o_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> create_o_u64(line, value.start, value.end, request, seen_name, seen_type)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_o_u64(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        let parsed: U64Parse = parse_u64(line, start, end);
        transition parsed.ok {
            true -> create_o_set(line, parsed.value, end, request, seen_name, seen_type)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_o_set(line: &[u8], value: u64, position: u64, mut request: ProjectSymbolsCreateRequest, seen_name: bool, seen_type: bool) -> CommandLineParse {
        ProjectSymbolsCreateRequest::set_offset(&mut request, value);
        transition { _ -> create_loop(line, position, request, seen_name, seen_type) }
    }

    // ---- `create-module`: -m/--module <name> (required),
    // -s/--size <u64> (required). ----
    state create_module_loop(line: &[u8], position: u64, mut request: ProjectSymbolsCreateModuleRequest, seen_module: bool, seen_size: bool) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> create_module_finish(line, request, seen_module, seen_size)
            false -> create_module_flag(line, next.start, next.end, request, seen_module, seen_size)
        }
    }
    state create_module_finish(line: &[u8], request: ProjectSymbolsCreateModuleRequest, seen_module: bool, seen_size: bool) -> CommandLineParse {
        transition seen_module && seen_size {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::ProjectSymbols { command:
                        ProjectSymbolsCommand::CreateModule { request: request } } } })
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_module_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateModuleRequest, seen_module: bool, seen_size: bool) -> CommandLineParse {
        let is_m: bool = flag_is(line, start, end, "m");
        let is_module: bool = flag_is(line, start, end, "module");
        transition is_m || is_module {
            true -> create_module_m_value(line, start, end, request, seen_size)
            false -> create_module_s_flag(line, start, end, request, seen_module, seen_size)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_module_m_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateModuleRequest, seen_size: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> create_module_m_slice(line, value.start, value.end, request, seen_size)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_module_m_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateModuleRequest, seen_size: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> create_module_m_set(line, start, end, request, seen_size)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_module_m_set(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateModuleRequest, seen_size: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectSymbolsCreateModuleRequest::set_module_name(&mut request, &line[start..end]);
        transition { _ -> create_module_loop(line, end, request, true, seen_size) }
    }
    state create_module_s_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateModuleRequest, seen_module: bool, seen_size: bool) -> CommandLineParse {
        let is_s: bool = flag_is(line, start, end, "s");
        let is_size: bool = flag_is(line, start, end, "size");
        transition is_s || is_size {
            true -> create_module_s_value(line, start, end, request, seen_module)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_module_s_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateModuleRequest, seen_module: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> create_module_s_u64(line, value.start, value.end, request, seen_module)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_module_s_u64(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsCreateModuleRequest, seen_module: bool) -> CommandLineParse {
        let parsed: U64Parse = parse_u64(line, start, end);
        transition parsed.ok {
            true -> create_module_s_set(line, parsed.value, end, request, seen_module)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_module_s_set(line: &[u8], value: u64, position: u64, mut request: ProjectSymbolsCreateModuleRequest, seen_module: bool) -> CommandLineParse {
        ProjectSymbolsCreateModuleRequest::set_size(&mut request, value);
        transition { _ -> create_module_loop(line, position, request, seen_module, true) }
    }

    // ---- `delete`: -k/--key <locator-key>*,
    // -m/--module <module-name>* (both String lists). ----
    state delete_loop(line: &[u8], position: u64, mut request: ProjectSymbolsDeleteRequest, mut keys: ProjectStringList, mut modules: ProjectStringList) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> delete_finish(line, request, keys, modules)
            false -> delete_flag(line, next.start, next.end, request, keys, modules)
        }
    }
    state delete_finish(line: &[u8], mut request: ProjectSymbolsDeleteRequest, keys: ProjectStringList, modules: ProjectStringList) -> CommandLineParse {
        ProjectSymbolsDeleteRequest::set_symbol_locator_keys(&mut request, keys);
        ProjectSymbolsDeleteRequest::set_module_names(&mut request, modules);
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::ProjectSymbols { command:
                    ProjectSymbolsCommand::Delete { request: request } } } })
    }
    state delete_flag(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsDeleteRequest, mut keys: ProjectStringList, mut modules: ProjectStringList) -> CommandLineParse {
        let is_k: bool = flag_is(line, start, end, "k");
        let is_key: bool = flag_is(line, start, end, "key");
        transition is_k || is_key {
            true -> delete_k_value(line, start, end, request, keys, modules)
            false -> delete_m_flag(line, start, end, request, keys, modules)
            _ -> (CommandLineParse::Refused)
        }
    }
    state delete_k_value(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsDeleteRequest, mut keys: ProjectStringList, mut modules: ProjectStringList) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> delete_k_slice(line, value.start, value.end, request, keys, modules)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state delete_k_slice(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsDeleteRequest, mut keys: ProjectStringList, mut modules: ProjectStringList) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> delete_k_add(line, start, end, request, keys, modules)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state delete_k_add(line: &[u8], start: u64, end: u64, mut request: ProjectSymbolsDeleteRequest, mut keys: ProjectStringList, mut modules: ProjectStringList) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        let added: bool = ProjectStringList::add_string(&mut keys, &line[start..end]);
        transition added {
            true -> delete_loop(line, end, request, keys, modules)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
