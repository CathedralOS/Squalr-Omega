    state reorder_p_add(line: &[u8], start: u64, end: u64, mut request: ProjectItemsReorderRequest, mut paths: ProjectPathList) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        let added: bool = ProjectPathList::add_path(&mut paths, &line[start..end]);
