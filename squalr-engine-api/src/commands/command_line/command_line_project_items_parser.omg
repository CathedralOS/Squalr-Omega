    // ---- `update-details`: -p/--project-item-path <path>*,
    // --property <name>, --address-target-property <name>,
    // -v/--value <anonymous-value-string>. ----
    state update_loop(line: &[u8], position: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> update_finish(line, request, paths)
            false -> update_flag(line, next.start, next.end, request, paths)
        }
    }
    state update_finish(line: &[u8], mut request: ProjectItemsUpdateDetailsRequest, paths: ProjectPathList) -> CommandLineParse {
        ProjectItemsUpdateDetailsRequest::set_project_item_paths(&mut request, paths);
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::ProjectItems { command:
                    ProjectItemsCommand::UpdateDetails { request: request } } } })
    }
    state update_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_path: bool = flag_is(line, start, end, "project-item-path");
        transition is_p || is_path {
            true -> update_p_value(line, start, end, request, paths)
            false -> update_property_flag(line, start, end, request, paths)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> update_p_slice(line, value.start, value.end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> update_p_add(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_p_add(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        let added: bool = ProjectPathList::add_path(&mut paths, &line[start..end]);
        transition added {
            true -> update_loop(line, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_property_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let is_property: bool = flag_is(line, start, end, "property");
        transition is_property {
            true -> update_property_value(line, start, end, request, paths)
            false -> update_target_flag(line, start, end, request, paths)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_property_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> update_property_slice(line, value.start, value.end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_property_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> update_property_set(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_property_set(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectItemsUpdateDetailsRequest::set_property_name(&mut request, &line[start..end]);
        transition { _ -> update_loop(line, end, request, paths) }
    }
    state update_target_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let is_target: bool = flag_is(line, start, end, "address-target-property");
        transition is_target {
            true -> update_target_value(line, start, end, request, paths)
            false -> update_v_flag(line, start, end, request, paths)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_target_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> update_target_slice(line, value.start, value.end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_target_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> update_target_set(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_target_set(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectItemsUpdateDetailsRequest::set_address_target_property_name(&mut request, &line[start..end]);
        transition { _ -> update_loop(line, end, request, paths) }
    }
    state update_v_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let is_v: bool = flag_is(line, start, end, "v");
        let is_value: bool = flag_is(line, start, end, "value");
        transition is_v || is_value {
            true -> update_v_value(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_v_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> update_v_slice(line, value.start, value.end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_v_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> update_v_parse(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_v_parse(line: &[u8], start: u64, end: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        let parsed: AnonymousValueStringParse = AnonymousValueString::parse(&line[start..end]);
        transition parsed {
            AnonymousValueStringParse::Parsed { value } -> update_v_set(line, value, end, request, paths)
            AnonymousValueStringParse::Refused -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state update_v_set(line: &[u8], value: AnonymousValueString, position: u64, mut request: ProjectItemsUpdateDetailsRequest, mut paths: ProjectPathList) -> CommandLineParse {
        ProjectItemsUpdateDetailsRequest::set_anonymous_value_string(&mut request, value);
        transition { _ -> update_loop(line, position, request, paths) }
    }

    // ---- `write-value`: -p/--project-item-path <path> (required),
    // --field <name> (default "value" upstream — left unset when absent),
    // -v/--value <anonymous-value-string> (required). ----
    state write_loop(line: &[u8], position: u64, mut request: ProjectItemsWriteValueRequest, seen_path: bool, seen_value: bool) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> write_finish(line, request, seen_path, seen_value)
            false -> write_flag(line, next.start, next.end, request, seen_path, seen_value)
        }
    }
    state write_finish(line: &[u8], request: ProjectItemsWriteValueRequest, seen_path: bool, seen_value: bool) -> CommandLineParse {
        transition seen_path && seen_value {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::ProjectItems { command:
                        ProjectItemsCommand::WriteValue { request: request } } } })
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsWriteValueRequest, seen_path: bool, seen_value: bool) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_path: bool = flag_is(line, start, end, "project-item-path");
        transition is_p || is_path {
            true -> write_p_value(line, start, end, request, seen_value)
            false -> write_f_flag(line, start, end, request, seen_path, seen_value)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsWriteValueRequest, seen_value: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> write_p_slice(line, value.start, value.end, request, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsWriteValueRequest, seen_value: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> write_p_set(line, start, end, request, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_p_set(line: &[u8], start: u64, end: u64, mut request: ProjectItemsWriteValueRequest, seen_value: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectItemsWriteValueRequest::set_project_item_path(&mut request, &line[start..end]);
        transition { _ -> write_loop(line, end, request, true, seen_value) }
    }
    state write_f_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsWriteValueRequest, seen_path: bool, seen_value: bool) -> CommandLineParse {
        let is_field: bool = flag_is(line, start, end, "field");
        transition is_field {
            true -> write_f_value(line, start, end, request, seen_path, seen_value)
            false -> write_v_flag(line, start, end, request, seen_path, seen_value)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_f_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsWriteValueRequest, seen_path: bool, seen_value: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> write_f_slice(line, value.start, value.end, request, seen_path, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_f_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsWriteValueRequest, seen_path: bool, seen_value: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> write_f_set(line, start, end, request, seen_path, seen_value)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_f_set(line: &[u8], start: u64, end: u64, mut request: ProjectItemsWriteValueRequest, seen_path: bool, seen_value: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectItemsWriteValueRequest::set_field_name(&mut request, &line[start..end]);
        transition { _ -> write_loop(line, end, request, seen_path, seen_value) }
    }
    state write_v_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsWriteValueRequest, seen_path: bool, seen_value: bool) -> CommandLineParse {
        let is_v: bool = flag_is(line, start, end, "v");
        let is_value: bool = flag_is(line, start, end, "value");
        transition is_v || is_value {
            true -> write_v_value(line, start, end, request, seen_path)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_v_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsWriteValueRequest, seen_path: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> write_v_slice(line, value.start, value.end, request, seen_path)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_v_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsWriteValueRequest, seen_path: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> write_v_parse(line, start, end, request, seen_path)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_v_parse(line: &[u8], start: u64, end: u64, mut request: ProjectItemsWriteValueRequest, seen_path: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        let parsed: AnonymousValueStringParse = AnonymousValueString::parse(&line[start..end]);
        transition parsed {
            AnonymousValueStringParse::Parsed { value } -> write_v_set(line, value, end, request, seen_path)
            AnonymousValueStringParse::Refused -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state write_v_set(line: &[u8], value: AnonymousValueString, position: u64, mut request: ProjectItemsWriteValueRequest, seen_path: bool) -> CommandLineParse {
        ProjectItemsWriteValueRequest::set_anonymous_value_string(&mut request, value);
        transition { _ -> write_loop(line, position, request, seen_path, true) }
    }
}
