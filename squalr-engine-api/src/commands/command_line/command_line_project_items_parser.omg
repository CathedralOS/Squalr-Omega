    state reorder_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsReorderRequest, mut paths: ProjectPathList) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> reorder_p_add(line, start, end, request, paths)
