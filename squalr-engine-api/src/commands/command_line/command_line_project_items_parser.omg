module src::commands::command_line::command_line_project_items_parser;

use src::commands::command_line::command_line_command::CommandLineCommand;
use src::commands::command_line::command_line_parser::CommandLineParse;
use src::commands::command_line::command_line_parser::FlagValue;
use src::commands::command_line::command_line_parser::NextToken;
use src::commands::command_line::command_line_parser::U64Parse;
use src::commands::command_line::command_line_parser::flag_is;
use src::commands::command_line::command_line_parser::flag_value;
use src::commands::command_line::command_line_parser::next_token;
use src::commands::command_line::command_line_parser::parse_u64;
use src::commands::command_line::command_line_parser::token_is;
use src::commands::project_items::activate::project_items_activate_request::ProjectItemsActivateRequest;
use src::commands::project_items::add::project_items_add_request::ProjectItemsAddRequest;
use src::commands::project_items::create::project_items_create_request::ProjectItemsCreateRequest;
use src::commands::project_items::delete::project_items_delete_request::ProjectItemsDeleteRequest;
use src::commands::project_items::duplicate::project_items_duplicate_request::ProjectItemsDuplicateRequest;
use src::commands::project_items::list::project_items_list_request::ProjectItemsListRequest;
use src::commands::project_items::move_item::project_items_move_item_request::ProjectItemsMoveItemRequest;
use src::commands::project_items::project_items_command::ProjectItemsCommand;
use src::commands::project_items::promote_symbol::project_items_promote_symbol_request::ProjectItemsPromoteSymbolRequest;
use src::commands::project_items::rename::project_items_rename_request::ProjectItemsRenameRequest;
use src::commands::project_items::reorder::project_items_reorder_request::ProjectItemsReorderRequest;
use src::commands::project_items::strip_symbol::project_items_strip_symbol_request::ProjectItemsStripSymbolRequest;
use src::commands::project_items::update_details::project_items_update_details_request::ProjectItemsUpdateDetailsRequest;
use src::commands::project_items::write_value::project_items_write_value_request::ProjectItemsWriteValueRequest;
use src::commands::unprivileged_command::UnprivilegedCommand;
use src::structures::data_values::anonymous_value_string::AnonymousValueString;
use src::structures::data_values::anonymous_value_string::AnonymousValueStringParse;
use src::structures::projects::project_path_list::ProjectPathList;
use src::structures::projects::project_string_list::ProjectStringList;
use src::structures::scan_results::scan_result_ref::ScanResultRef;

// Port of commands/command_line/project_items.rs — the `project-items`
// subcommand tree (add | activate | create | delete | duplicate | list |
// move | promote-symbol | rename | reorder | strip-symbol |
// update-details | write-value). Flag spellings follow upstream
// structopt (short + field-name long form); Vec fields accept one value
// per flag occurrence and accumulate onto the bounded list carriers —
// the required single-string/path fields (`create`'s -p/-n, `move` and
// `duplicate`'s -t, `rename`'s -p/-n, `write-value`'s -p/-v) refuse the
// line when absent, matching clap's missing-required error.
pub data CommandLineProjectItemsParser {}

pub machine CommandLineProjectItemsParser::parse(line: &[u8], position: u64) -> CommandLineParse {
    let next: NextToken = next_token(line, position);
    transition next.is_end {
        false -> sub(line, next.start, next.end)
        true -> (CommandLineParse::Refused)
        _ -> (CommandLineParse::Refused)
    }
    state sub(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "add");
        transition matched {
            true -> add_loop(line, end, ProjectItemsAddRequest::new())
            false -> sub_activate(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_activate(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "activate");
        transition matched {
            true -> activate_loop(line, end, ProjectItemsActivateRequest::new(), ProjectStringList::empty())
            false -> sub_create(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_create(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "create");
        transition matched {
            true -> create_loop(line, end, ProjectItemsCreateRequest::new(), false, false)
            false -> sub_delete(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_delete(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "delete");
        transition matched {
            true -> delete_loop(line, end, ProjectItemsDeleteRequest::new(), ProjectPathList::empty())
            false -> sub_duplicate(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_duplicate(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "duplicate");
        transition matched {
            true -> duplicate_loop(line, end, ProjectItemsDuplicateRequest::new(), ProjectPathList::empty(), false)
            false -> sub_list(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_list(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "list");
        transition matched {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::ProjectItems { command:
                        ProjectItemsCommand::List { request: ProjectItemsListRequest::new() } } } })
            false -> sub_move(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_move(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "move");
        transition matched {
            true -> move_loop(line, end, ProjectItemsMoveItemRequest::new(), ProjectPathList::empty(), false)
            false -> sub_promote(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_promote(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "promote-symbol");
        transition matched {
            true -> promote_loop(line, end, ProjectItemsPromoteSymbolRequest::new(), ProjectPathList::empty())
            false -> sub_rename(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_rename(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "rename");
        transition matched {
            true -> rename_loop(line, end, ProjectItemsRenameRequest::new(), false, false)
            false -> sub_reorder(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_reorder(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "reorder");
        transition matched {
            true -> reorder_loop(line, end, ProjectItemsReorderRequest::new(), ProjectPathList::empty())
            false -> sub_strip(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_strip(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "strip-symbol");
        transition matched {
            true -> strip_loop(line, end, ProjectItemsStripSymbolRequest::new(), ProjectPathList::empty())
            false -> sub_update(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_update(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "update-details");
        transition matched {
            true -> update_loop(line, end, ProjectItemsUpdateDetailsRequest::new(), ProjectPathList::empty())
            false -> sub_write(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_write(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched: bool = token_is(line, start, end, "write-value");
        transition matched {
            true -> write_loop(line, end, ProjectItemsWriteValueRequest::new(), false, false)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }

    // ---- `add`: -s/--scan-result-refs <index>* (each u64 -> ScanResultRef),
    // --target-directory-path <dir>. ----
    state add_loop(line: &[u8], position: u64, mut request: ProjectItemsAddRequest) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> add_finish(line, request)
            false -> add_flag(line, next.start, next.end, request)
        }
    }
    state add_finish(line: &[u8], request: ProjectItemsAddRequest) -> CommandLineParse {
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::ProjectItems { command:
                    ProjectItemsCommand::Add { request: request } } } })
    }
    state add_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsAddRequest) -> CommandLineParse {
        let is_s: bool = flag_is(line, start, end, "s");
        let is_refs: bool = flag_is(line, start, end, "scan-result-refs");
        transition is_s || is_refs {
            true -> add_s_value(line, start, end, request)
            false -> add_t_flag(line, start, end, request)
            _ -> (CommandLineParse::Refused)
        }
    }
    state add_s_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsAddRequest) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> add_s_u64(line, value.start, value.end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state add_s_u64(line: &[u8], start: u64, end: u64, mut request: ProjectItemsAddRequest) -> CommandLineParse {
        let parsed: U64Parse = parse_u64(line, start, end);
        transition parsed.ok {
            true -> add_s_push(line, parsed.value, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state add_s_push(line: &[u8], index: u64, position: u64, mut request: ProjectItemsAddRequest) -> CommandLineParse {
        let scan_result_ref: ScanResultRef = ScanResultRef::new(index, false);
        let added: bool = ProjectItemsAddRequest::add_scan_result_ref(&mut request, scan_result_ref);
        transition added {
            true -> add_loop(line, position, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state add_t_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsAddRequest) -> CommandLineParse {
        let is_target: bool = flag_is(line, start, end, "target-directory-path");
        transition is_target {
            true -> add_t_value(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state add_t_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsAddRequest) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> add_t_slice(line, value.start, value.end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state add_t_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsAddRequest) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> add_t_set(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state add_t_set(line: &[u8], start: u64, end: u64, mut request: ProjectItemsAddRequest) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectItemsAddRequest::set_target_directory_path(&mut request, &line[start..end]);
        transition { _ -> add_loop(line, end, request) }
    }

    // ---- `activate`: -p/--project-item-paths <path>* (String list),
    // -a/--is-activated (presence). ----
    state activate_loop(line: &[u8], position: u64, mut request: ProjectItemsActivateRequest, mut paths: ProjectStringList) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> activate_finish(line, request, paths)
            false -> activate_flag(line, next.start, next.end, request, paths)
        }
    }
    state activate_finish(line: &[u8], mut request: ProjectItemsActivateRequest, paths: ProjectStringList) -> CommandLineParse {
        ProjectItemsActivateRequest::set_project_item_paths(&mut request, paths);
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::ProjectItems { command:
                    ProjectItemsCommand::Activate { request: request } } } })
    }
    state activate_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsActivateRequest, mut paths: ProjectStringList) -> CommandLineParse {
        let is_a: bool = flag_is(line, start, end, "a");
        let is_activated: bool = flag_is(line, start, end, "is-activated");
        transition is_a || is_activated {
            true -> activate_a_set(line, end, request, paths)
            false -> activate_p_flag(line, start, end, request, paths)
            _ -> (CommandLineParse::Refused)
        }
    }
    state activate_a_set(line: &[u8], position: u64, mut request: ProjectItemsActivateRequest, mut paths: ProjectStringList) -> CommandLineParse {
        ProjectItemsActivateRequest::set_is_activated(&mut request, true);
        transition { _ -> activate_loop(line, position, request, paths) }
    }
    state activate_p_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsActivateRequest, mut paths: ProjectStringList) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_paths: bool = flag_is(line, start, end, "project-item-paths");
        transition is_p || is_paths {
            true -> activate_p_value(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state activate_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsActivateRequest, mut paths: ProjectStringList) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> activate_p_slice(line, value.start, value.end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state activate_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsActivateRequest, mut paths: ProjectStringList) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> activate_p_add(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state activate_p_add(line: &[u8], start: u64, end: u64, mut request: ProjectItemsActivateRequest, mut paths: ProjectStringList) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        let added: bool = ProjectStringList::add_string(&mut paths, &line[start..end]);
        transition added {
            true -> activate_loop(line, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }

    // ---- `create`: -p/--parent-directory-path <dir> (required),
    // -n/--project-item-name <name> (required), --is-directory (presence). ----
    state create_loop(line: &[u8], position: u64, mut request: ProjectItemsCreateRequest, seen_parent: bool, seen_name: bool) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> create_finish(line, request, seen_parent, seen_name)
            false -> create_flag(line, next.start, next.end, request, seen_parent, seen_name)
        }
    }
    state create_finish(line: &[u8], request: ProjectItemsCreateRequest, seen_parent: bool, seen_name: bool) -> CommandLineParse {
        transition seen_parent && seen_name {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::ProjectItems { command:
                        ProjectItemsCommand::Create { request: request } } } })
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsCreateRequest, seen_parent: bool, seen_name: bool) -> CommandLineParse {
        let is_dir: bool = flag_is(line, start, end, "is-directory");
        transition is_dir {
            true -> create_dir_set(line, end, request, seen_parent, seen_name)
            false -> create_p_flag(line, start, end, request, seen_parent, seen_name)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_dir_set(line: &[u8], position: u64, mut request: ProjectItemsCreateRequest, seen_parent: bool, seen_name: bool) -> CommandLineParse {
        ProjectItemsCreateRequest::set_is_directory(&mut request, true);
        transition { _ -> create_loop(line, position, request, seen_parent, seen_name) }
    }
    state create_p_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsCreateRequest, seen_parent: bool, seen_name: bool) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_parent: bool = flag_is(line, start, end, "parent-directory-path");
        transition is_p || is_parent {
            true -> create_p_value(line, start, end, request, seen_name)
            false -> create_n_flag(line, start, end, request, seen_parent, seen_name)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsCreateRequest, seen_name: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> create_p_slice(line, value.start, value.end, request, seen_name)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsCreateRequest, seen_name: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> create_p_set(line, start, end, request, seen_name)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_p_set(line: &[u8], start: u64, end: u64, mut request: ProjectItemsCreateRequest, seen_name: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectItemsCreateRequest::set_parent_directory_path(&mut request, &line[start..end]);
        transition { _ -> create_loop(line, end, request, true, seen_name) }
    }
    state create_n_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsCreateRequest, seen_parent: bool, seen_name: bool) -> CommandLineParse {
        let is_n: bool = flag_is(line, start, end, "n");
        let is_name: bool = flag_is(line, start, end, "project-item-name");
        transition is_n || is_name {
            true -> create_n_value(line, start, end, request, seen_parent)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_n_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsCreateRequest, seen_parent: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> create_n_slice(line, value.start, value.end, request, seen_parent)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_n_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsCreateRequest, seen_parent: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> create_n_set(line, start, end, request, seen_parent)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_n_set(line: &[u8], start: u64, end: u64, mut request: ProjectItemsCreateRequest, seen_parent: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectItemsCreateRequest::set_project_item_name(&mut request, &line[start..end]);
        transition { _ -> create_loop(line, end, request, seen_parent, true) }
    }

    // ---- `delete`: -p/--project-item-paths <path>* (PathBuf list). ----
    state delete_loop(line: &[u8], position: u64, mut request: ProjectItemsDeleteRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> delete_finish(line, request, paths)
            false -> delete_flag(line, next.start, next.end, request, paths)
        }
    }
    state delete_finish(line: &[u8], mut request: ProjectItemsDeleteRequest, paths: ProjectPathList) -> CommandLineParse {
        ProjectItemsDeleteRequest::set_project_item_paths(&mut request, paths);
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::ProjectItems { command:
                    ProjectItemsCommand::Delete { request: request } } } })
    }
    state delete_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsDeleteRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_paths: bool = flag_is(line, start, end, "project-item-paths");
        transition is_p || is_paths {
            true -> delete_p_value(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state delete_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsDeleteRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> delete_p_slice(line, value.start, value.end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state delete_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsDeleteRequest, mut paths: ProjectPathList) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> delete_p_add(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state delete_p_add(line: &[u8], start: u64, end: u64, mut request: ProjectItemsDeleteRequest, mut paths: ProjectPathList) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        let added: bool = ProjectPathList::add_path(&mut paths, &line[start..end]);
        transition added {
            true -> delete_loop(line, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }

    // ---- `duplicate`: -p/--project-item-paths <path>*,
    // -t/--target-directory-path <dir> (required). ----
    state duplicate_loop(line: &[u8], position: u64, mut request: ProjectItemsDuplicateRequest, mut paths: ProjectPathList, seen_target: bool) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> duplicate_finish(line, request, paths, seen_target)
            false -> duplicate_flag(line, next.start, next.end, request, paths, seen_target)
        }
    }
    state duplicate_finish(line: &[u8], mut request: ProjectItemsDuplicateRequest, paths: ProjectPathList, seen_target: bool) -> CommandLineParse {
        transition seen_target {
            true -> duplicate_apply(line, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state duplicate_apply(line: &[u8], mut request: ProjectItemsDuplicateRequest, paths: ProjectPathList) -> CommandLineParse {
        ProjectItemsDuplicateRequest::set_project_item_paths(&mut request, paths);
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::ProjectItems { command:
                    ProjectItemsCommand::Duplicate { request: request } } } })
    }
    state duplicate_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsDuplicateRequest, mut paths: ProjectPathList, seen_target: bool) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_paths: bool = flag_is(line, start, end, "project-item-paths");
        transition is_p || is_paths {
            true -> duplicate_p_value(line, start, end, request, paths, seen_target)
            false -> duplicate_t_flag(line, start, end, request, paths, seen_target)
            _ -> (CommandLineParse::Refused)
        }
    }
    state duplicate_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsDuplicateRequest, mut paths: ProjectPathList, seen_target: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> duplicate_p_slice(line, value.start, value.end, request, paths, seen_target)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state duplicate_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsDuplicateRequest, mut paths: ProjectPathList, seen_target: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> duplicate_p_add(line, start, end, request, paths, seen_target)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state duplicate_p_add(line: &[u8], start: u64, end: u64, mut request: ProjectItemsDuplicateRequest, mut paths: ProjectPathList, seen_target: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        let added: bool = ProjectPathList::add_path(&mut paths, &line[start..end]);
        transition added {
            true -> duplicate_loop(line, end, request, paths, seen_target)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state duplicate_t_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsDuplicateRequest, mut paths: ProjectPathList, seen_target: bool) -> CommandLineParse {
        let is_t: bool = flag_is(line, start, end, "t");
        let is_target: bool = flag_is(line, start, end, "target-directory-path");
        transition is_t || is_target {
            true -> duplicate_t_value(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state duplicate_t_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsDuplicateRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> duplicate_t_slice(line, value.start, value.end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state duplicate_t_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsDuplicateRequest, mut paths: ProjectPathList) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> duplicate_t_set(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state duplicate_t_set(line: &[u8], start: u64, end: u64, mut request: ProjectItemsDuplicateRequest, mut paths: ProjectPathList) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectItemsDuplicateRequest::set_target_directory_path(&mut request, &line[start..end]);
        transition { _ -> duplicate_loop(line, end, request, paths, true) }
    }

    // ---- `move`: -p/--project-item-paths <path>*,
    // -t/--target-directory-path <dir> (required). ----
    state move_loop(line: &[u8], position: u64, mut request: ProjectItemsMoveItemRequest, mut paths: ProjectPathList, seen_target: bool) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> move_finish(line, request, paths, seen_target)
            false -> move_flag(line, next.start, next.end, request, paths, seen_target)
        }
    }
    state move_finish(line: &[u8], mut request: ProjectItemsMoveItemRequest, paths: ProjectPathList, seen_target: bool) -> CommandLineParse {
        transition seen_target {
            true -> move_apply(line, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state move_apply(line: &[u8], mut request: ProjectItemsMoveItemRequest, paths: ProjectPathList) -> CommandLineParse {
        ProjectItemsMoveItemRequest::set_project_item_paths(&mut request, paths);
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::ProjectItems { command:
                    ProjectItemsCommand::MoveItem { request: request } } } })
    }
    state move_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsMoveItemRequest, mut paths: ProjectPathList, seen_target: bool) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_paths: bool = flag_is(line, start, end, "project-item-paths");
        transition is_p || is_paths {
            true -> move_p_value(line, start, end, request, paths, seen_target)
            false -> move_t_flag(line, start, end, request, paths, seen_target)
            _ -> (CommandLineParse::Refused)
        }
    }
    state move_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsMoveItemRequest, mut paths: ProjectPathList, seen_target: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> move_p_slice(line, value.start, value.end, request, paths, seen_target)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state move_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsMoveItemRequest, mut paths: ProjectPathList, seen_target: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> move_p_add(line, start, end, request, paths, seen_target)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state move_p_add(line: &[u8], start: u64, end: u64, mut request: ProjectItemsMoveItemRequest, mut paths: ProjectPathList, seen_target: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        let added: bool = ProjectPathList::add_path(&mut paths, &line[start..end]);
        transition added {
            true -> move_loop(line, end, request, paths, seen_target)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state move_t_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsMoveItemRequest, mut paths: ProjectPathList, seen_target: bool) -> CommandLineParse {
        let is_t: bool = flag_is(line, start, end, "t");
        let is_target: bool = flag_is(line, start, end, "target-directory-path");
        transition is_t || is_target {
            true -> move_t_value(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state move_t_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsMoveItemRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> move_t_slice(line, value.start, value.end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state move_t_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsMoveItemRequest, mut paths: ProjectPathList) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> move_t_set(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state move_t_set(line: &[u8], start: u64, end: u64, mut request: ProjectItemsMoveItemRequest, mut paths: ProjectPathList) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectItemsMoveItemRequest::set_target_directory_path(&mut request, &line[start..end]);
        transition { _ -> move_loop(line, end, request, paths, true) }
    }

    // ---- `promote-symbol`: -p/--project-item-path <path>*,
    // --overwrite-conflicting-symbols (presence). ----
    state promote_loop(line: &[u8], position: u64, mut request: ProjectItemsPromoteSymbolRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> promote_finish(line, request, paths)
            false -> promote_flag(line, next.start, next.end, request, paths)
        }
    }
    state promote_finish(line: &[u8], mut request: ProjectItemsPromoteSymbolRequest, paths: ProjectPathList) -> CommandLineParse {
        ProjectItemsPromoteSymbolRequest::set_project_item_paths(&mut request, paths);
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::ProjectItems { command:
                    ProjectItemsCommand::PromoteSymbol { request: request } } } })
    }
    state promote_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsPromoteSymbolRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let is_overwrite: bool = flag_is(line, start, end, "overwrite-conflicting-symbols");
        transition is_overwrite {
            true -> promote_overwrite_set(line, end, request, paths)
            false -> promote_p_flag(line, start, end, request, paths)
            _ -> (CommandLineParse::Refused)
        }
    }
    state promote_overwrite_set(line: &[u8], position: u64, mut request: ProjectItemsPromoteSymbolRequest, mut paths: ProjectPathList) -> CommandLineParse {
        ProjectItemsPromoteSymbolRequest::set_overwrite_conflicting_symbols(&mut request, true);
        transition { _ -> promote_loop(line, position, request, paths) }
    }
    state promote_p_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsPromoteSymbolRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_path: bool = flag_is(line, start, end, "project-item-path");
        transition is_p || is_path {
            true -> promote_p_value(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state promote_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsPromoteSymbolRequest, mut paths: ProjectPathList) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> promote_p_slice(line, value.start, value.end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state promote_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsPromoteSymbolRequest, mut paths: ProjectPathList) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> promote_p_add(line, start, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state promote_p_add(line: &[u8], start: u64, end: u64, mut request: ProjectItemsPromoteSymbolRequest, mut paths: ProjectPathList) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        let added: bool = ProjectPathList::add_path(&mut paths, &line[start..end]);
        transition added {
            true -> promote_loop(line, end, request, paths)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }

    // ---- `rename`: -p/--project-item-path <path> (required),
    // -n/--project-item-name <name> (required). ----
    state rename_loop(line: &[u8], position: u64, mut request: ProjectItemsRenameRequest, seen_path: bool, seen_name: bool) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> rename_finish(line, request, seen_path, seen_name)
            false -> rename_flag(line, next.start, next.end, request, seen_path, seen_name)
        }
    }
    state rename_finish(line: &[u8], request: ProjectItemsRenameRequest, seen_path: bool, seen_name: bool) -> CommandLineParse {
        transition seen_path && seen_name {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::ProjectItems { command:
                        ProjectItemsCommand::Rename { request: request } } } })
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsRenameRequest, seen_path: bool, seen_name: bool) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_path: bool = flag_is(line, start, end, "project-item-path");
        transition is_p || is_path {
            true -> rename_p_value(line, start, end, request, seen_name)
            false -> rename_n_flag(line, start, end, request, seen_path, seen_name)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsRenameRequest, seen_name: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> rename_p_slice(line, value.start, value.end, request, seen_name)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsRenameRequest, seen_name: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> rename_p_set(line, start, end, request, seen_name)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_p_set(line: &[u8], start: u64, end: u64, mut request: ProjectItemsRenameRequest, seen_name: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectItemsRenameRequest::set_project_item_path(&mut request, &line[start..end]);
        transition { _ -> rename_loop(line, end, request, true, seen_name) }
    }
    state rename_n_flag(line: &[u8], start: u64, end: u64, mut request: ProjectItemsRenameRequest, seen_path: bool, seen_name: bool) -> CommandLineParse {
        let is_n: bool = flag_is(line, start, end, "n");
        let is_name: bool = flag_is(line, start, end, "project-item-name");
        transition is_n || is_name {
            true -> rename_n_value(line, start, end, request, seen_path)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_n_value(line: &[u8], start: u64, end: u64, mut request: ProjectItemsRenameRequest, seen_path: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> rename_n_slice(line, value.start, value.end, request, seen_path)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_n_slice(line: &[u8], start: u64, end: u64, mut request: ProjectItemsRenameRequest, seen_path: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> rename_n_set(line, start, end, request, seen_path)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_n_set(line: &[u8], start: u64, end: u64, mut request: ProjectItemsRenameRequest, seen_path: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectItemsRenameRequest::set_project_item_name(&mut request, &line[start..end]);
        transition { _ -> rename_loop(line, end, request, seen_path, true) }
    }

    // ---- `reorder`: -p/--project-item-paths <path>*. ----
