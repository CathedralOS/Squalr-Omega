module src::commands::command_line::command_line_project_parser;

use src::commands::command_line::command_line_command::CommandLineCommand;
use src::commands::command_line::command_line_parser::CommandLineParse;
use src::commands::command_line::command_line_parser::FlagValue;
use src::commands::command_line::command_line_parser::NextToken;
use src::commands::command_line::command_line_parser::flag_is;
use src::commands::command_line::command_line_parser::flag_value;
use src::commands::command_line::command_line_parser::next_token;
use src::commands::command_line::command_line_parser::token_is;
use src::commands::project::close::project_close_request::ProjectCloseRequest;
use src::commands::project::create::project_create_request::ProjectCreateRequest;
use src::commands::project::delete::project_delete_request::ProjectDeleteRequest;
use src::commands::project::export::project_export_request::ProjectExportRequest;
use src::commands::project::list::project_list_request::ProjectListRequest;
use src::commands::project::open::project_open_request::ProjectOpenRequest;
use src::commands::project::project_command::ProjectCommand;
use src::commands::project::rename::project_rename_request::ProjectRenameRequest;
use src::commands::project::save::project_save_request::ProjectSaveRequest;
use src::commands::unprivileged_command::UnprivilegedCommand;

// Port of commands/command_line/project.rs — the `project` subcommand
// tree: list | open | close | create | delete | rename | save | export.
// Flag spellings follow upstream structopt (short + field-name long form);
// `rename`'s `-p`/`-n` are required (plain PathBuf/String upstream, no
// Option) and refuse the line when absent, same as clap's missing-arg
// error. Value flags accept both `--flag value` and `--flag=value` through
// the shared flag_value machinery; presence flags consume no value.
pub data CommandLineProjectParser {}

pub machine CommandLineProjectParser::parse(line: &[u8], position: u64) -> CommandLineParse {
    let next: NextToken = next_token(line, position);
    transition next.is_end {
        false -> sub(line, next.start, next.end)
        true -> (CommandLineParse::Refused)
        _ -> (CommandLineParse::Refused)
    }
    state sub(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched_list: bool = token_is(line, start, end, "list");
        transition matched_list {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::Project { command:
                        ProjectCommand::List { request: ProjectListRequest::new() } } } })
            false -> sub_open(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_open(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched_open: bool = token_is(line, start, end, "open");
        transition matched_open {
            true -> open_loop(line, end, ProjectOpenRequest::new())
            false -> sub_close(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_close(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched_close: bool = token_is(line, start, end, "close");
        transition matched_close {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::Project { command:
                        ProjectCommand::Close { request: ProjectCloseRequest::new() } } } })
            false -> sub_create(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_create(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched_create: bool = token_is(line, start, end, "create");
        transition matched_create {
            true -> create_loop(line, end, ProjectCreateRequest::new())
            false -> sub_delete(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_delete(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched_delete: bool = token_is(line, start, end, "delete");
        transition matched_delete {
            true -> delete_loop(line, end, ProjectDeleteRequest::new())
            false -> sub_rename(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_rename(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched_rename: bool = token_is(line, start, end, "rename");
        transition matched_rename {
            true -> rename_loop(line, end, ProjectRenameRequest::new(), false, false)
            false -> sub_save(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_save(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched_save: bool = token_is(line, start, end, "save");
        transition matched_save {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::Project { command:
                        ProjectCommand::Save { request: ProjectSaveRequest::new() } } } })
            false -> sub_export(line, start, end)
            _ -> (CommandLineParse::Refused)
        }
    }
    state sub_export(line: &[u8], start: u64, end: u64) -> CommandLineParse {
        let matched_export: bool = token_is(line, start, end, "export");
        transition matched_export {
            true -> export_loop(line, end, ProjectExportRequest::new())
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }

    // ---- `open` flags: -b/--open-file-browser (presence),
    // -p/--project-directory-path <dir>, -n/--project-name <name>. ----
    state open_loop(line: &[u8], position: u64, mut request: ProjectOpenRequest) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> open_finish(line, request)
            false -> open_flag(line, next.start, next.end, request)
        }
    }
    state open_finish(line: &[u8], request: ProjectOpenRequest) -> CommandLineParse {
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::Project { command:
                    ProjectCommand::Open { request: request } } } })
    }
    state open_flag(line: &[u8], start: u64, end: u64, mut request: ProjectOpenRequest) -> CommandLineParse {
        let is_b: bool = flag_is(line, start, end, "b");
        let is_browser: bool = flag_is(line, start, end, "open-file-browser");
        transition is_b || is_browser {
            true -> open_browser_set(line, end, request)
            false -> open_p_flag(line, start, end, request)
            _ -> (CommandLineParse::Refused)
        }
    }
    state open_browser_set(line: &[u8], position: u64, mut request: ProjectOpenRequest) -> CommandLineParse {
        ProjectOpenRequest::set_open_file_browser(&mut request, true);
        transition { _ -> open_loop(line, position, request) }
    }
    state open_p_flag(line: &[u8], start: u64, end: u64, mut request: ProjectOpenRequest) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_dir: bool = flag_is(line, start, end, "project-directory-path");
        transition is_p || is_dir {
            true -> open_p_value(line, start, end, request)
            false -> open_n_flag(line, start, end, request)
            _ -> (CommandLineParse::Refused)
        }
    }
    state open_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectOpenRequest) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> open_p_slice(line, value.start, value.end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state open_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectOpenRequest) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> open_p_set(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state open_p_set(line: &[u8], start: u64, end: u64, mut request: ProjectOpenRequest) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectOpenRequest::set_project_directory_path(&mut request, &line[start..end]);
        transition { _ -> open_loop(line, end, request) }
    }
    state open_n_flag(line: &[u8], start: u64, end: u64, mut request: ProjectOpenRequest) -> CommandLineParse {
        let is_n: bool = flag_is(line, start, end, "n");
        let is_name: bool = flag_is(line, start, end, "project-name");
        transition is_n || is_name {
            true -> open_n_value(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state open_n_value(line: &[u8], start: u64, end: u64, mut request: ProjectOpenRequest) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> open_n_slice(line, value.start, value.end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state open_n_slice(line: &[u8], start: u64, end: u64, mut request: ProjectOpenRequest) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> open_n_set(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state open_n_set(line: &[u8], start: u64, end: u64, mut request: ProjectOpenRequest) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectOpenRequest::set_project_name(&mut request, &line[start..end]);
        transition { _ -> open_loop(line, end, request) }
    }

    // ---- `create` flags: -p/--project-directory-path <dir>,
    // -n/--project-name <name>. ----
    state create_loop(line: &[u8], position: u64, mut request: ProjectCreateRequest) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> create_finish(line, request)
            false -> create_flag(line, next.start, next.end, request)
        }
    }
    state create_finish(line: &[u8], request: ProjectCreateRequest) -> CommandLineParse {
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::Project { command:
                    ProjectCommand::Create { request: request } } } })
    }
    state create_flag(line: &[u8], start: u64, end: u64, mut request: ProjectCreateRequest) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_dir: bool = flag_is(line, start, end, "project-directory-path");
        transition is_p || is_dir {
            true -> create_p_value(line, start, end, request)
            false -> create_n_flag(line, start, end, request)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectCreateRequest) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> create_p_slice(line, value.start, value.end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectCreateRequest) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> create_p_set(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_p_set(line: &[u8], start: u64, end: u64, mut request: ProjectCreateRequest) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectCreateRequest::set_project_directory_path(&mut request, &line[start..end]);
        transition { _ -> create_loop(line, end, request) }
    }
    state create_n_flag(line: &[u8], start: u64, end: u64, mut request: ProjectCreateRequest) -> CommandLineParse {
        let is_n: bool = flag_is(line, start, end, "n");
        let is_name: bool = flag_is(line, start, end, "project-name");
        transition is_n || is_name {
            true -> create_n_value(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_n_value(line: &[u8], start: u64, end: u64, mut request: ProjectCreateRequest) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> create_n_slice(line, value.start, value.end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_n_slice(line: &[u8], start: u64, end: u64, mut request: ProjectCreateRequest) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> create_n_set(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state create_n_set(line: &[u8], start: u64, end: u64, mut request: ProjectCreateRequest) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectCreateRequest::set_project_name(&mut request, &line[start..end]);
        transition { _ -> create_loop(line, end, request) }
    }

    // ---- `delete` flags: -p/--project-directory-path <dir>,
    // -n/--project-name <name>. ----
    state delete_loop(line: &[u8], position: u64, mut request: ProjectDeleteRequest) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> delete_finish(line, request)
            false -> delete_flag(line, next.start, next.end, request)
        }
    }
    state delete_finish(line: &[u8], request: ProjectDeleteRequest) -> CommandLineParse {
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::Project { command:
                    ProjectCommand::Delete { request: request } } } })
    }
    state delete_flag(line: &[u8], start: u64, end: u64, mut request: ProjectDeleteRequest) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_dir: bool = flag_is(line, start, end, "project-directory-path");
        transition is_p || is_dir {
            true -> delete_p_value(line, start, end, request)
            false -> delete_n_flag(line, start, end, request)
            _ -> (CommandLineParse::Refused)
        }
    }
    state delete_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectDeleteRequest) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> delete_p_slice(line, value.start, value.end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state delete_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectDeleteRequest) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> delete_p_set(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state delete_p_set(line: &[u8], start: u64, end: u64, mut request: ProjectDeleteRequest) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectDeleteRequest::set_project_directory_path(&mut request, &line[start..end]);
        transition { _ -> delete_loop(line, end, request) }
    }
    state delete_n_flag(line: &[u8], start: u64, end: u64, mut request: ProjectDeleteRequest) -> CommandLineParse {
        let is_n: bool = flag_is(line, start, end, "n");
        let is_name: bool = flag_is(line, start, end, "project-name");
        transition is_n || is_name {
            true -> delete_n_value(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state delete_n_value(line: &[u8], start: u64, end: u64, mut request: ProjectDeleteRequest) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> delete_n_slice(line, value.start, value.end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state delete_n_slice(line: &[u8], start: u64, end: u64, mut request: ProjectDeleteRequest) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> delete_n_set(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state delete_n_set(line: &[u8], start: u64, end: u64, mut request: ProjectDeleteRequest) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectDeleteRequest::set_project_name(&mut request, &line[start..end]);
        transition { _ -> delete_loop(line, end, request) }
    }

    // ---- `rename` flags: -p/--project-directory-path <dir> (required),
    // -n/--new-project-name <name> (required). The seen flags ride the
    // loop parameters — the request's required fields carry no has_ pair. ----
    state rename_loop(line: &[u8], position: u64, mut request: ProjectRenameRequest, seen_dir: bool, seen_name: bool) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> rename_finish(line, request, seen_dir, seen_name)
            false -> rename_flag(line, next.start, next.end, request, seen_dir, seen_name)
        }
    }
    state rename_finish(line: &[u8], request: ProjectRenameRequest, seen_dir: bool, seen_name: bool) -> CommandLineParse {
        transition seen_dir && seen_name {
            true -> (CommandLineParse::Parsed { command:
                CommandLineCommand::Unprivileged { command:
                    UnprivilegedCommand::Project { command:
                        ProjectCommand::Rename { request: request } } } })
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_flag(line: &[u8], start: u64, end: u64, mut request: ProjectRenameRequest, seen_dir: bool, seen_name: bool) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_dir: bool = flag_is(line, start, end, "project-directory-path");
        transition is_p || is_dir {
            true -> rename_p_value(line, start, end, request, seen_name)
            false -> rename_n_flag(line, start, end, request, seen_dir, seen_name)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectRenameRequest, seen_name: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> rename_p_slice(line, value.start, value.end, request, seen_name)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectRenameRequest, seen_name: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> rename_p_set(line, start, end, request, seen_name)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_p_set(line: &[u8], start: u64, end: u64, mut request: ProjectRenameRequest, seen_name: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectRenameRequest::set_project_directory_path(&mut request, &line[start..end]);
        transition { _ -> rename_loop(line, end, request, true, seen_name) }
    }
    state rename_n_flag(line: &[u8], start: u64, end: u64, mut request: ProjectRenameRequest, seen_dir: bool, seen_name: bool) -> CommandLineParse {
        let is_n: bool = flag_is(line, start, end, "n");
        let is_name: bool = flag_is(line, start, end, "new-project-name");
        transition is_n || is_name {
            true -> rename_n_value(line, start, end, request, seen_dir)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_n_value(line: &[u8], start: u64, end: u64, mut request: ProjectRenameRequest, seen_dir: bool) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> rename_n_slice(line, value.start, value.end, request, seen_dir)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_n_slice(line: &[u8], start: u64, end: u64, mut request: ProjectRenameRequest, seen_dir: bool) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> rename_n_set(line, start, end, request, seen_dir)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state rename_n_set(line: &[u8], start: u64, end: u64, mut request: ProjectRenameRequest, seen_dir: bool) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectRenameRequest::set_new_project_name(&mut request, &line[start..end]);
        transition { _ -> rename_loop(line, end, request, seen_dir, true) }
    }

    // ---- `export` flags: -p/--project-directory-path <dir>,
    // -n/--project-name <name>, -o/--open-export-folder (presence). ----
    state export_loop(line: &[u8], position: u64, mut request: ProjectExportRequest) -> CommandLineParse {
        let next: NextToken = next_token(line, position);
        transition next.is_end {
            true -> export_finish(line, request)
            false -> export_flag(line, next.start, next.end, request)
        }
    }
    state export_finish(line: &[u8], request: ProjectExportRequest) -> CommandLineParse {
        (CommandLineParse::Parsed { command:
            CommandLineCommand::Unprivileged { command:
                UnprivilegedCommand::Project { command:
                    ProjectCommand::Export { request: request } } } })
    }
    state export_flag(line: &[u8], start: u64, end: u64, mut request: ProjectExportRequest) -> CommandLineParse {
        let is_o: bool = flag_is(line, start, end, "o");
        let is_folder: bool = flag_is(line, start, end, "open-export-folder");
        transition is_o || is_folder {
            true -> export_folder_set(line, end, request)
            false -> export_p_flag(line, start, end, request)
            _ -> (CommandLineParse::Refused)
        }
    }
    state export_folder_set(line: &[u8], position: u64, mut request: ProjectExportRequest) -> CommandLineParse {
        ProjectExportRequest::set_open_export_folder(&mut request, true);
        transition { _ -> export_loop(line, position, request) }
    }
    state export_p_flag(line: &[u8], start: u64, end: u64, mut request: ProjectExportRequest) -> CommandLineParse {
        let is_p: bool = flag_is(line, start, end, "p");
        let is_dir: bool = flag_is(line, start, end, "project-directory-path");
        transition is_p || is_dir {
            true -> export_p_value(line, start, end, request)
            false -> export_n_flag(line, start, end, request)
            _ -> (CommandLineParse::Refused)
        }
    }
    state export_p_value(line: &[u8], start: u64, end: u64, mut request: ProjectExportRequest) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> export_p_slice(line, value.start, value.end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state export_p_slice(line: &[u8], start: u64, end: u64, mut request: ProjectExportRequest) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> export_p_set(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state export_p_set(line: &[u8], start: u64, end: u64, mut request: ProjectExportRequest) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectExportRequest::set_project_directory_path(&mut request, &line[start..end]);
        transition { _ -> export_loop(line, end, request) }
    }
    state export_n_flag(line: &[u8], start: u64, end: u64, mut request: ProjectExportRequest) -> CommandLineParse {
        let is_n: bool = flag_is(line, start, end, "n");
        let is_name: bool = flag_is(line, start, end, "project-name");
        transition is_n || is_name {
            true -> export_n_value(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state export_n_value(line: &[u8], start: u64, end: u64, mut request: ProjectExportRequest) -> CommandLineParse {
        let value: FlagValue = flag_value(line, start, end);
        transition value.has_value {
            true -> export_n_slice(line, value.start, value.end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state export_n_slice(line: &[u8], start: u64, end: u64, mut request: ProjectExportRequest) -> CommandLineParse {
        transition start <= end && end <= line.len {
            true -> export_n_set(line, start, end, request)
            false -> (CommandLineParse::Refused)
            _ -> (CommandLineParse::Refused)
        }
    }
    state export_n_set(line: &[u8], start: u64, end: u64, mut request: ProjectExportRequest) -> CommandLineParse
        requires start <= end && end <= line.len;
    {
        ProjectExportRequest::set_project_name(&mut request, &line[start..end]);
        transition { _ -> export_loop(line, end, request) }
    }
}
