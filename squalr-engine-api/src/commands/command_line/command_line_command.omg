module src::commands::command_line::command_line_command;

use src::commands::privileged_command::PrivilegedCommand;

// Port of commands/command_line/command.rs: what the CLI's input grammar
// can produce. Only the Privileged case lands — the Unprivileged project
// domains arrive with their own legs.
pub data CommandLineCommand {
    case Privileged(command: PrivilegedCommand);
}
