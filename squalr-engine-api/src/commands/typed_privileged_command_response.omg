// Port of the `TypedPrivilegedCommandResponse` impls upstream spreads across
// its leaf files (declared in privileged_command_response.rs). Same colocation
// rule as privileged_command_request.omg: per-file modules can't import the
// root union back without a cycle, so every leaf's `to_engine_response` /
// `from_engine_response` lands here in leaf order. Upstream's
// `Result<Self, PrivilegedCommandResponse>` becomes a per-leaf
// `...Outcome` union — `Matched` is the typed extraction, `Unexpected` hands
// the unmatched root union back exactly like `Err(response)`.

// Upstream `StructScanResponse` mappings — the domain payload is the leaf
// record directly (StructScanResponse has no union wrapper upstream).
pub data StructScanResponseOutcome {
    case Matched(response: StructScanResponse);
    case Unexpected(response: PrivilegedCommandResponse);
}

pub machine StructScanResponse::to_engine_response(
    response: StructScanResponse
) -> PrivilegedCommandResponse {
    (PrivilegedCommandResponse::StructScan { response: response })
}

pub machine StructScanResponse::from_engine_response(
    response: PrivilegedCommandResponse
) -> StructScanResponseOutcome {
    transition response {
        PrivilegedCommandResponse::StructScan { response } -> (StructScanResponseOutcome::Matched { response: response })
        _ -> (StructScanResponseOutcome::Unexpected { response: response })
    }
}

pub data ScanResetResponseOutcome {
    case Matched(response: ScanResetResponse);
    case Unexpected(response: PrivilegedCommandResponse);
}

pub machine ScanResetResponse::to_engine_response(
    response: ScanResetResponse
) -> PrivilegedCommandResponse {
    (PrivilegedCommandResponse::Scan { response: ScanResponse::Reset { response: response } })
}

pub machine ScanResetResponse::from_engine_response(
    response: PrivilegedCommandResponse
) -> ScanResetResponseOutcome {
    transition response {
        PrivilegedCommandResponse::Scan { response } -> domain(response)
        _ -> unexpected(response)
    }
    state domain(response: ScanResponse) -> ScanResetResponseOutcome {
        transition response {
            ScanResponse::Reset { response } -> (ScanResetResponseOutcome::Matched { response: response })
            _ -> rebuild(response)
        }
    }
    state rebuild(response: ScanResponse) -> ScanResetResponseOutcome {
        (ScanResetResponseOutcome::Unexpected { response: PrivilegedCommandResponse::Scan { response: response } })
    }
    state unexpected(response: PrivilegedCommandResponse) -> ScanResetResponseOutcome {
        (ScanResetResponseOutcome::Unexpected { response: response })
    }
}

