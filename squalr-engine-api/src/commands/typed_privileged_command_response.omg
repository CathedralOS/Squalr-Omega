// Port of the `TypedPrivilegedCommandResponse` impls upstream spreads across
// its leaf files (declared in privileged_command_response.rs). Same colocation
// rule as privileged_command_request.omg: per-file modules can't import the
// root union back without a cycle, so every leaf's `to_engine_response` /
// `from_engine_response` lands here in leaf order. Upstream's
// `Result<Self, PrivilegedCommandResponse>` becomes a per-leaf
// `...Outcome` union — `Matched` is the typed extraction, `Unexpected` hands
// the unmatched root union back exactly like `Err(response)`.

// Upstream `StructScanResponse` mappings — the domain payload is the leaf
// record directly (StructScanResponse has no union wrapper upstream).
public data StructScanResponseOutcome {
    case Matched(response: |struct_scan_response|::StructScanResponse);
    case Unexpected(response: |privileged_command_response|::PrivilegedCommandResponse);
}

public machine StructScanResponse::to_engine_response(
    response: |struct_scan_response|::StructScanResponse
) -> |privileged_command_response|::PrivilegedCommandResponse {
    (|privileged_command_response|::PrivilegedCommandResponse::StructScan { response: response })
}

public machine StructScanResponse::from_engine_response(
    response: |privileged_command_response|::PrivilegedCommandResponse
) -> StructScanResponseOutcome {
    transition response {
        |privileged_command_response|::PrivilegedCommandResponse::StructScan { response } -> (StructScanResponseOutcome::Matched { response: response })
        _ -> (StructScanResponseOutcome::Unexpected { response: response })
    }
}

public data ScanResetResponseOutcome {
    case Matched(response: |scan_reset_response|::ScanResetResponse);
    case Unexpected(response: |privileged_command_response|::PrivilegedCommandResponse);
}

public machine ScanResetResponse::to_engine_response(
    response: |scan_reset_response|::ScanResetResponse
) -> |privileged_command_response|::PrivilegedCommandResponse {
    (|privileged_command_response|::PrivilegedCommandResponse::Scan { response: |scan_response|::ScanResponse::Reset { response: response } })
}

public machine ScanResetResponse::from_engine_response(
    response: |privileged_command_response|::PrivilegedCommandResponse
) -> ScanResetResponseOutcome {
    transition response {
        |privileged_command_response|::PrivilegedCommandResponse::Scan { response } -> domain(response)
        _ -> unexpected(response)
    }
    machine domain(response: |scan_response|::ScanResponse) -> ScanResetResponseOutcome {
        transition response {
            |scan_response|::ScanResponse::Reset { response } -> (ScanResetResponseOutcome::Matched { response: response })
            _ -> rebuild(response)
        }
    }
    machine rebuild(response: |scan_response|::ScanResponse) -> ScanResetResponseOutcome {
        (ScanResetResponseOutcome::Unexpected { response: |privileged_command_response|::PrivilegedCommandResponse::Scan { response: response } })
    }
    machine unexpected(response: |privileged_command_response|::PrivilegedCommandResponse) -> ScanResetResponseOutcome {
        (ScanResetResponseOutcome::Unexpected { response: response })
    }
}

