use src/commands/trackable_tasks/cancel/trackable_tasks_cancel_response.omg;
use src/commands/trackable_tasks/list/trackable_tasks_list_response.omg;

// Port of commands/trackable_tasks/trackable_tasks_response.rs — the
// tasks-domain response union, in upstream case order.
public data TrackableTasksResponse {
    case List(response: |trackable_tasks_list_response|::TrackableTasksListResponse);
    case Cancel(response: |trackable_tasks_cancel_response|::TrackableTasksCancelResponse);
}
