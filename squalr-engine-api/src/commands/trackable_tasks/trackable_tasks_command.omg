use src/commands/trackable_tasks/cancel/trackable_tasks_cancel_request.omg;
use src/commands/trackable_tasks/list/trackable_tasks_list_request.omg;

// Port of commands/trackable_tasks/trackable_tasks_command.rs — the
// tasks-domain command union, in upstream case order.
public data TrackableTasksCommand {
    case List(request: |trackable_tasks_list_request|::TrackableTasksListRequest);
    case Cancel(request: |trackable_tasks_cancel_request|::TrackableTasksCancelRequest);
}
