module src::commands::trackable_tasks::cancel::trackable_tasks_cancel_request;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::bounded_slice::bounded_slice;

// Port of commands/trackable_tasks/cancel/trackable_tasks_cancel_request.rs —
// the identifier of the task to cancel. `task_id` uses the bounded [u8; 256]
// + live length convention (upstream String).
pub data TrackableTasksCancelRequest {
    task_id: [u8; 256];
    task_id_len: u64;
}

pub machine TrackableTasksCancelRequest::new(task_id: &[u8]) -> TrackableTasksCancelRequest {
    let mut request: TrackableTasksCancelRequest = TrackableTasksCancelRequest {
        task_id_len: 0,
    };
    request.set_task_id(task_id);
    (request)
}

// Upstream `task_id` — the live identifier span.
pub machine TrackableTasksCancelRequest::get_task_id(&self) -> &[u8] {
    bounded_slice(&self.task_id[0..256], self.task_id_len)
}

pub machine TrackableTasksCancelRequest::set_task_id(&mut self, task_id: &[u8]) {
    self.task_id_len = BoundedByteCopy::copy(&mut self.task_id[0..256], task_id);
}
