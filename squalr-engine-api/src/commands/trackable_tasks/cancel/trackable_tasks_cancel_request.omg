module src::commands::trackable_tasks::cancel::trackable_tasks_cancel_request;

// Port of commands/trackable_tasks/cancel/trackable_tasks_cancel_request.rs —
// the identifier of the task to cancel. `task_id` uses the bounded [u8; 256]
// + live length convention (upstream String).
pub data TrackableTasksCancelRequest {
    task_id: [u8; 256];
    task_id_len: u64;
}

pub machine TrackableTasksCancelRequest::new(task_id: &[u8]) -> TrackableTasksCancelRequest {
    let mut request: TrackableTasksCancelRequest = TrackableTasksCancelRequest {
        task_id_len: 0,
    };
    TrackableTasksCancelRequest::set_task_id(&mut request, task_id);
    (request)
}

// Upstream `task_id` — the live identifier span.
pub machine TrackableTasksCancelRequest::get_task_id(trackable_tasks_cancel_request: &TrackableTasksCancelRequest) -> &[u8] {
    transition trackable_tasks_cancel_request.task_id_len <= 256 {
        true -> (&trackable_tasks_cancel_request.task_id[0..trackable_tasks_cancel_request.task_id_len])
        false -> (&trackable_tasks_cancel_request.task_id[0..256])
        _ -> (&trackable_tasks_cancel_request.task_id[0..256])
    }
}

pub machine TrackableTasksCancelRequest::set_task_id(trackable_tasks_cancel_request: &mut TrackableTasksCancelRequest, task_id: &[u8]) {
    trackable_tasks_cancel_request.task_id_len = 0;
    transition { _ -> copy(trackable_tasks_cancel_request, task_id, 0) }
    state copy(trackable_tasks_cancel_request: &mut TrackableTasksCancelRequest, task_id: &[u8], position: u64) {
        transition position < task_id.len && position < 256 {
            true -> store(trackable_tasks_cancel_request, task_id, position)
            false -> finish(trackable_tasks_cancel_request, position)
        }
    }
    state store(trackable_tasks_cancel_request: &mut TrackableTasksCancelRequest, task_id: &[u8], position: u64) {
        trackable_tasks_cancel_request.task_id[position] = task_id[position];
        transition {
            _ -> copy(trackable_tasks_cancel_request, task_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(trackable_tasks_cancel_request: &mut TrackableTasksCancelRequest, count: u64) {
        trackable_tasks_cancel_request.task_id_len = count;
    }
}
