module src::commands::plugins::set_enabled::plugin_set_enabled_response;

use src::plugins::plugin_state::PluginState;
use src::plugins::plugin_id::PluginId;
use src::structures::processes::opened_process_info::OpenedProcessInfo;
use src::structures::bounded_append::append_plugin_id;
use src::structures::bounded_append::append_plugin_state;

// Port of commands/plugins/set_enabled/plugin_set_enabled_response.rs — {plugins: Vec<PluginState>,
// opened_process_info: Option<OpenedProcessInfo>, default_plugin_ids:
// Vec<String>, did_update: bool}. plugins carries a 64-entry bounded page;
// opened_process_info is has_ + the [copy] record whole; the id list is
// [PluginId; 64] + count — all refusal-bounded like upstream's Vecs
// (honest bounds, never truncation).
pub data PluginSetEnabledResponse {
    plugins: [PluginState; 64];
    plugin_count: u64;
    has_opened_process_info: bool;
    opened_process_info: OpenedProcessInfo;
    default_plugin_ids: [PluginId; 64];
    default_plugin_id_count: u64;
    did_update: bool;
}

pub machine PluginSetEnabledResponse::new() -> PluginSetEnabledResponse {
    (PluginSetEnabledResponse {
        plugin_count: 0,
        has_opened_process_info: false,
        default_plugin_id_count: 0,
        did_update: false,
    })
}

pub machine PluginSetEnabledResponse::get_plugin_count(&self) -> u64 {
    self.plugin_count
}

pub machine PluginSetEnabledResponse::get_plugin(&self, position: u64) -> &PluginState
    requires 0 <= position && position < 64
{
    &self.plugins[position]
}

// false past the 64-entry bound.
pub machine PluginSetEnabledResponse::add_plugin(&mut self, plugin: &PluginState) -> bool {
    append_plugin_state(&mut self.plugins[0..64], &mut self.plugin_count, plugin)
}

pub machine PluginSetEnabledResponse::has_opened_process_info(&self) -> bool {
    self.has_opened_process_info
}

pub machine PluginSetEnabledResponse::get_opened_process_info(&self) -> &OpenedProcessInfo {
    &self.opened_process_info
}

pub machine PluginSetEnabledResponse::set_opened_process_info(&mut self, opened_process_info: OpenedProcessInfo) {
    self.opened_process_info = opened_process_info;
    self.has_opened_process_info = true;
}

pub machine PluginSetEnabledResponse::clear_opened_process_info(&mut self) {
    self.has_opened_process_info = false;
}

pub machine PluginSetEnabledResponse::get_default_plugin_id_count(&self) -> u64 {
    self.default_plugin_id_count
}

pub machine PluginSetEnabledResponse::get_default_plugin_id(&self, position: u64) -> &PluginId
    requires 0 <= position && position < 64
{
    &self.default_plugin_ids[position]
}

pub machine PluginSetEnabledResponse::add_default_plugin_id(&mut self, plugin_id: &PluginId) -> bool {
    append_plugin_id(&mut self.default_plugin_ids[0..64], &mut self.default_plugin_id_count, plugin_id)
}
pub machine PluginSetEnabledResponse::get_did_update(&self) -> bool {
    self.did_update
}

pub machine PluginSetEnabledResponse::set_did_update(&mut self, did_update: bool) {
    self.did_update = did_update;
}
