module src::commands::plugins::set_enabled::plugin_set_enabled_response;

use src::plugins::plugin_state::PluginState;
use src::plugins::plugin_id::PluginId;
use src::structures::processes::opened_process_info::OpenedProcessInfo;

// Port of commands/plugins/set_enabled/plugin_set_enabled_response.rs — {plugins: Vec<PluginState>,
// opened_process_info: Option<OpenedProcessInfo>, default_plugin_ids:
// Vec<String>, did_update: bool}. plugins carries a 64-entry bounded page;
// opened_process_info is has_ + the [copy] record whole; the id list is
// [PluginId; 64] + count — all refusal-bounded like upstream's Vecs
// (honest bounds, never truncation).
pub data PluginSetEnabledResponse {
    plugins: [PluginState; 64];
    plugin_count: u64;
    has_opened_process_info: bool;
    opened_process_info: OpenedProcessInfo;
    default_plugin_ids: [PluginId; 64];
    default_plugin_id_count: u64;
    did_update: bool;
}

pub machine PluginSetEnabledResponse::new() -> PluginSetEnabledResponse {
    (PluginSetEnabledResponse {
        plugin_count: 0,
        has_opened_process_info: false,
        default_plugin_id_count: 0,
        did_update: false,
    })
}

pub machine PluginSetEnabledResponse::get_plugin_count(plugin_set_enabled_response: &PluginSetEnabledResponse) -> u64 {
    plugin_set_enabled_response.plugin_count
}

pub machine PluginSetEnabledResponse::get_plugin(plugin_set_enabled_response: &PluginSetEnabledResponse, position: u64) -> &PluginState
    requires 0 <= position && position < 64
{
    &plugin_set_enabled_response.plugins[position]
}

// false past the 64-entry bound.
pub machine PluginSetEnabledResponse::add_plugin(plugin_set_enabled_response: &mut PluginSetEnabledResponse, plugin: &PluginState) -> bool {
    transition plugin_set_enabled_response.plugin_count < 64 {
        true -> store(plugin_set_enabled_response, plugin)
        false -> (false)
    }
    state store(plugin_set_enabled_response: &mut PluginSetEnabledResponse, plugin: &PluginState) -> bool {
        PluginState::clone_from(&mut plugin_set_enabled_response.plugins[plugin_set_enabled_response.plugin_count], plugin);
        plugin_set_enabled_response.plugin_count = ((plugin_set_enabled_response.plugin_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

pub machine PluginSetEnabledResponse::has_opened_process_info(plugin_set_enabled_response: &PluginSetEnabledResponse) -> bool {
    plugin_set_enabled_response.has_opened_process_info
}

pub machine PluginSetEnabledResponse::get_opened_process_info(plugin_set_enabled_response: &PluginSetEnabledResponse) -> &OpenedProcessInfo {
    &plugin_set_enabled_response.opened_process_info
}

pub machine PluginSetEnabledResponse::set_opened_process_info(plugin_set_enabled_response: &mut PluginSetEnabledResponse, opened_process_info: OpenedProcessInfo) {
    plugin_set_enabled_response.opened_process_info = opened_process_info;
    plugin_set_enabled_response.has_opened_process_info = true;
}

pub machine PluginSetEnabledResponse::clear_opened_process_info(plugin_set_enabled_response: &mut PluginSetEnabledResponse) {
    plugin_set_enabled_response.has_opened_process_info = false;
}

pub machine PluginSetEnabledResponse::get_default_plugin_id_count(plugin_set_enabled_response: &PluginSetEnabledResponse) -> u64 {
    plugin_set_enabled_response.default_plugin_id_count
}

pub machine PluginSetEnabledResponse::get_default_plugin_id(plugin_set_enabled_response: &PluginSetEnabledResponse, position: u64) -> &PluginId
    requires 0 <= position && position < 64
{
    &plugin_set_enabled_response.default_plugin_ids[position]
}

pub machine PluginSetEnabledResponse::add_default_plugin_id(plugin_set_enabled_response: &mut PluginSetEnabledResponse, plugin_id: &PluginId) -> bool {
    transition plugin_set_enabled_response.default_plugin_id_count < 64 {
        true -> store(plugin_set_enabled_response, plugin_id)
        false -> (false)
    }
    state store(plugin_set_enabled_response: &mut PluginSetEnabledResponse, plugin_id: &PluginId) -> bool {
        PluginId::clone_from(&mut plugin_set_enabled_response.default_plugin_ids[plugin_set_enabled_response.default_plugin_id_count], plugin_id);
        plugin_set_enabled_response.default_plugin_id_count = ((plugin_set_enabled_response.default_plugin_id_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
pub machine PluginSetEnabledResponse::get_did_update(plugin_set_enabled_response: &PluginSetEnabledResponse) -> bool {
    plugin_set_enabled_response.did_update
}

pub machine PluginSetEnabledResponse::set_did_update(plugin_set_enabled_response: &mut PluginSetEnabledResponse, did_update: bool) {
    plugin_set_enabled_response.did_update = did_update;
}