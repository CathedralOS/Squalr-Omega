module src::commands::plugins::set_enabled::plugin_set_enabled_response;

use src::plugins::plugin_state::PluginState;
use src::plugins::plugin_id::PluginId;
use src::structures::processes::opened_process_info::OpenedProcessInfo;

// Port of commands/plugins/set_enabled/plugin_set_enabled_response.rs — {plugins: Vec<PluginState>,
// opened_process_info: Option<OpenedProcessInfo>, default_plugin_ids:
// Vec<String>, did_update: bool}. plugins carries a 64-entry bounded page;
// opened_process_info is has_ + the [copy] record whole; the id list is
// [PluginId; 64] + count — all refusal-bounded like upstream's Vecs
// (honest bounds, never truncation).
pub data PluginSetEnabledResponse {
    plugins: [PluginState; 64];
    plugin_count: u64;
    has_opened_process_info: bool;
    opened_process_info: OpenedProcessInfo;
    default_plugin_ids: [PluginId; 64];
    default_plugin_id_count: u64;
    did_update: bool;
}

pub machine PluginSetEnabledResponse::new() -> PluginSetEnabledResponse {
    (PluginSetEnabledResponse {
        plugin_count: 0,
        has_opened_process_info: false,
        default_plugin_id_count: 0,
        did_update: false,
    })
}

pub machine PluginSetEnabledResponse::get_plugin_count(this: &PluginSetEnabledResponse) -> u64 {
    this.plugin_count
}

pub machine PluginSetEnabledResponse::get_plugin(this: &PluginSetEnabledResponse, position: u64) -> &PluginState
    requires 0 <= position && position < 64
{
    &this.plugins[position]
}

// false past the 64-entry bound.
pub machine PluginSetEnabledResponse::add_plugin(this: &mut PluginSetEnabledResponse, plugin: &PluginState) -> bool {
    transition this.plugin_count < 64 {
        true -> store(this, plugin)
        false -> (false)
    }
    state store(this: &mut PluginSetEnabledResponse, plugin: &PluginState) -> bool {
        PluginState::clone_from(&mut this.plugins[this.plugin_count], plugin);
        this.plugin_count = ((this.plugin_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

pub machine PluginSetEnabledResponse::has_opened_process_info(this: &PluginSetEnabledResponse) -> bool {
    this.has_opened_process_info
}

pub machine PluginSetEnabledResponse::get_opened_process_info(this: &PluginSetEnabledResponse) -> &OpenedProcessInfo {
    &this.opened_process_info
}

pub machine PluginSetEnabledResponse::set_opened_process_info(this: &mut PluginSetEnabledResponse, opened_process_info: OpenedProcessInfo) {
    this.opened_process_info = opened_process_info;
    this.has_opened_process_info = true;
}

pub machine PluginSetEnabledResponse::clear_opened_process_info(this: &mut PluginSetEnabledResponse) {
    this.has_opened_process_info = false;
}

pub machine PluginSetEnabledResponse::get_default_plugin_id_count(this: &PluginSetEnabledResponse) -> u64 {
    this.default_plugin_id_count
}

pub machine PluginSetEnabledResponse::get_default_plugin_id(this: &PluginSetEnabledResponse, position: u64) -> &PluginId
    requires 0 <= position && position < 64
{
    &this.default_plugin_ids[position]
}

pub machine PluginSetEnabledResponse::add_default_plugin_id(this: &mut PluginSetEnabledResponse, plugin_id: &PluginId) -> bool {
    transition this.default_plugin_id_count < 64 {
        true -> store(this, plugin_id)
        false -> (false)
    }
    state store(this: &mut PluginSetEnabledResponse, plugin_id: &PluginId) -> bool {
        PluginId::clone_from(&mut this.default_plugin_ids[this.default_plugin_id_count], plugin_id);
        this.default_plugin_id_count = ((this.default_plugin_id_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
pub machine PluginSetEnabledResponse::get_did_update(this: &PluginSetEnabledResponse) -> bool {
    this.did_update
}

pub machine PluginSetEnabledResponse::set_did_update(this: &mut PluginSetEnabledResponse, did_update: bool) {
    this.did_update = did_update;
}