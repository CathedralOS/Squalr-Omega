module src::commands::plugins::set_enabled::plugin_set_enabled_request;

// Port of commands/plugins/set_enabled/plugin_set_enabled_request.rs —
// {plugin_id: String, is_enabled: bool}.
pub data PluginSetEnabledRequest {
    plugin_id: [u8; 256];
    plugin_id_len: u64;
    is_enabled: bool;
}

pub machine PluginSetEnabledRequest::new(is_enabled: bool) -> PluginSetEnabledRequest {
    PluginSetEnabledRequest {
        plugin_id_len: 0,
        is_enabled: is_enabled,
    }
}

pub machine PluginSetEnabledRequest::get_is_enabled(this: &PluginSetEnabledRequest) -> bool {
    this.is_enabled
}

pub machine PluginSetEnabledRequest::set_is_enabled(this: &mut PluginSetEnabledRequest, is_enabled: bool) {
    this.is_enabled = is_enabled;
}

pub machine PluginSetEnabledRequest::get_plugin_id(this: &PluginSetEnabledRequest) -> &[u8] {
    transition this.plugin_id_len <= 256 {
        true -> (&this.plugin_id[0..this.plugin_id_len])
        false -> (&this.plugin_id[0..256])
        _ -> (&this.plugin_id[0..256])
    }
}

pub machine PluginSetEnabledRequest::set_plugin_id(this: &mut PluginSetEnabledRequest, plugin_id: &[u8]) {
    this.plugin_id_len = 0;
    transition { _ -> copy(this, plugin_id, 0) }
    state copy(this: &mut PluginSetEnabledRequest, plugin_id: &[u8], position: u64) {
        transition position < plugin_id.len && position < 256 {
            true -> store(this, plugin_id, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut PluginSetEnabledRequest, plugin_id: &[u8], position: u64) {
        this.plugin_id[position] = plugin_id[position];
        transition {
            _ -> copy(this, plugin_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut PluginSetEnabledRequest, count: u64) {
        this.plugin_id_len = count;
    }
}
