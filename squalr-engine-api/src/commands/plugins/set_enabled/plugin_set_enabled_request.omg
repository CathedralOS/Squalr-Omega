module src::commands::plugins::set_enabled::plugin_set_enabled_request;

// Port of commands/plugins/set_enabled/plugin_set_enabled_request.rs —
// {plugin_id: String, is_enabled: bool}.
pub data PluginSetEnabledRequest {
    plugin_id: [u8; 256];
    plugin_id_len: u64;
    is_enabled: bool;
}

pub machine PluginSetEnabledRequest::new(is_enabled: bool) -> PluginSetEnabledRequest {
    PluginSetEnabledRequest {
        plugin_id_len: 0,
        is_enabled: is_enabled,
    }
}

pub machine PluginSetEnabledRequest::get_is_enabled(&self) -> bool {
    self.is_enabled
}

pub machine PluginSetEnabledRequest::set_is_enabled(&mut self, is_enabled: bool) {
    self.is_enabled = is_enabled;
}

pub machine PluginSetEnabledRequest::get_plugin_id(&self) -> &[u8] {
    transition self.plugin_id_len <= 256 {
        true -> (&self.plugin_id[0..self.plugin_id_len])
        false -> (&self.plugin_id[0..256])
        _ -> (&self.plugin_id[0..256])
    }
}

pub machine PluginSetEnabledRequest::set_plugin_id(&mut self, plugin_id: &[u8]) {
    self.plugin_id_len = 0;
    transition { _ -> copy(plugin_id, 0) }
    state copy(&mut self, plugin_id: &[u8], position: u64) {
        transition position < plugin_id.len && position < 256 {
            true -> store(plugin_id, position)
            false -> finish(position)
        }
    }
    state store(&mut self, plugin_id: &[u8], position: u64) {
        self.plugin_id[position] = plugin_id[position];
        transition {
            _ -> copy(plugin_id, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.plugin_id_len = count;
    }
}
