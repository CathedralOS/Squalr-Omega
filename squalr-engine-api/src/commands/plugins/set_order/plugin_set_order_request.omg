module src::commands::plugins::set_order::plugin_set_order_request;

use src::plugins::plugin_id::PluginId;

// Port of commands/plugins/set_order/plugin_set_order_request.rs —
// {plugin_ids: Vec<String>}: the ordered plugin id list. Vec carries the
// bounded page — [PluginId; 64] + count, add_plugin_id refusing past the
// bound.
pub data PluginSetOrderRequest {
    plugin_ids: [PluginId; 64];
    plugin_id_count: u64;
}

pub machine PluginSetOrderRequest::new() -> PluginSetOrderRequest {
    PluginSetOrderRequest {
        plugin_id_count: 0,
    }
}

pub machine PluginSetOrderRequest::get_plugin_id_count(plugin_set_order_request: &PluginSetOrderRequest) -> u64 {
    plugin_set_order_request.plugin_id_count
}

pub machine PluginSetOrderRequest::get_plugin_id(plugin_set_order_request: &PluginSetOrderRequest, position: u64) -> &PluginId
    requires 0 <= position && position < 64
{
    &plugin_set_order_request.plugin_ids[position]
}

pub machine PluginSetOrderRequest::add_plugin_id(plugin_set_order_request: &mut PluginSetOrderRequest, plugin_id: &PluginId) -> bool {
    transition plugin_set_order_request.plugin_id_count < 64 {
        true -> store(plugin_set_order_request, plugin_id)
        false -> (false)
    }
    state store(plugin_set_order_request: &mut PluginSetOrderRequest, plugin_id: &PluginId) -> bool {
        PluginId::clone_from(&mut plugin_set_order_request.plugin_ids[plugin_set_order_request.plugin_id_count], plugin_id);
        plugin_set_order_request.plugin_id_count = ((plugin_set_order_request.plugin_id_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
