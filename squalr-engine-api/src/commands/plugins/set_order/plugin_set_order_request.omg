module src::commands::plugins::set_order::plugin_set_order_request;

use src::plugins::plugin_id::PluginId;
use src::structures::bounded_append::append_plugin_id;

// Port of commands/plugins/set_order/plugin_set_order_request.rs —
// {plugin_ids: Vec<String>}: the ordered plugin id list. Vec carries the
// bounded page — [PluginId; 64] + count, add_plugin_id refusing past the
// bound.
pub data PluginSetOrderRequest {
    plugin_ids: [PluginId; 64];
    plugin_id_count: u64;
}

pub machine PluginSetOrderRequest::new() -> PluginSetOrderRequest {
    PluginSetOrderRequest {
        plugin_id_count: 0,
    }
}

pub machine PluginSetOrderRequest::get_plugin_id_count(&self) -> u64 {
    self.plugin_id_count
}

pub machine PluginSetOrderRequest::get_plugin_id(&self, position: u64) -> &PluginId
    requires 0 <= position && position < 64
{
    &self.plugin_ids[position]
}

pub machine PluginSetOrderRequest::add_plugin_id(&mut self, plugin_id: &PluginId) -> bool {
    append_plugin_id(&mut self.plugin_ids[0..64], &mut self.plugin_id_count, plugin_id)
}
