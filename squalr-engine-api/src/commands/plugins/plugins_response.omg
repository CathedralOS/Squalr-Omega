module src::commands::plugins::plugins_response;

use src::commands::plugins::list::plugin_list_response::PluginListResponse;
use src::commands::plugins::set_enabled::plugin_set_enabled_response::PluginSetEnabledResponse;
use src::commands::plugins::set_order::plugin_set_order_response::PluginSetOrderResponse;

// Port of commands/plugins/plugins_response.rs — List, SetEnabled,
// SetOrder in upstream declaration order.
pub data PluginsResponse {
    case List(response: PluginListResponse);
    case SetEnabled(response: PluginSetEnabledResponse);
    case SetOrder(response: PluginSetOrderResponse);
}
