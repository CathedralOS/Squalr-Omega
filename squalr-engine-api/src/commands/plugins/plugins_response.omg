use src/commands/plugins/list/plugin_list_response.omg;
use src/commands/plugins/set_enabled/plugin_set_enabled_response.omg;
use src/commands/plugins/set_order/plugin_set_order_response.omg;

// Port of commands/plugins/plugins_response.rs — List, SetEnabled,
// SetOrder in upstream declaration order.
public data PluginsResponse {
    case List(response: |plugin_list_response|::PluginListResponse);
    case SetEnabled(response: |plugin_set_enabled_response|::PluginSetEnabledResponse);
    case SetOrder(response: |plugin_set_order_response|::PluginSetOrderResponse);
}
