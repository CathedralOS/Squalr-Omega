module src::commands::plugins::plugins_command;

use src::commands::plugins::list::plugin_list_request::PluginListRequest;
use src::commands::plugins::set_enabled::plugin_set_enabled_request::PluginSetEnabledRequest;
use src::commands::plugins::set_order::plugin_set_order_request::PluginSetOrderRequest;

// Port of commands/plugins/plugins_command.rs — List, SetEnabled,
// SetOrder in upstream declaration order.
pub data PluginsCommand {
    case List(request: PluginListRequest);
    case SetEnabled(request: PluginSetEnabledRequest);
    case SetOrder(request: PluginSetOrderRequest);
}
