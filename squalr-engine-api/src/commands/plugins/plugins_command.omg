use src/commands/plugins/list/plugin_list_request.omg;
use src/commands/plugins/set_enabled/plugin_set_enabled_request.omg;
use src/commands/plugins/set_order/plugin_set_order_request.omg;

// Port of commands/plugins/plugins_command.rs — List, SetEnabled,
// SetOrder in upstream declaration order.
public data PluginsCommand {
    case List(request: |plugin_list_request|::PluginListRequest);
    case SetEnabled(request: |plugin_set_enabled_request|::PluginSetEnabledRequest);
    case SetOrder(request: |plugin_set_order_request|::PluginSetOrderRequest);
}
