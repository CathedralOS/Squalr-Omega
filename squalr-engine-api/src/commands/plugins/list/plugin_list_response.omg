module src::commands::plugins::list::plugin_list_response;

use src::plugins::plugin_state::PluginState;
use src::plugins::plugin_id::PluginId;
use src::structures::processes::opened_process_info::OpenedProcessInfo;

// Port of commands/plugins/list/plugin_list_response.rs — {plugins: Vec<PluginState>,
// opened_process_info: Option<OpenedProcessInfo>, default_plugin_ids:
// Vec<String>}. plugins carries a 64-entry bounded page;
// opened_process_info is has_ + the [copy] record whole; the id list is
// [PluginId; 64] + count — all refusal-bounded like upstream's Vecs
// (honest bounds, never truncation).
pub data PluginListResponse {
    plugins: [PluginState; 64];
    plugin_count: u64;
    has_opened_process_info: bool;
    opened_process_info: OpenedProcessInfo;
    default_plugin_ids: [PluginId; 64];
    default_plugin_id_count: u64;
    
}

pub machine PluginListResponse::new() -> PluginListResponse {
    (PluginListResponse {
        plugin_count: 0,
        has_opened_process_info: false,
        default_plugin_id_count: 0,
        
    })
}

pub machine PluginListResponse::get_plugin_count(plugin_list_response: &PluginListResponse) -> u64 {
    plugin_list_response.plugin_count
}

pub machine PluginListResponse::get_plugin(plugin_list_response: &PluginListResponse, position: u64) -> &PluginState
    requires 0 <= position && position < 64
{
    &plugin_list_response.plugins[position]
}

// false past the 64-entry bound.
pub machine PluginListResponse::add_plugin(plugin_list_response: &mut PluginListResponse, plugin: &PluginState) -> bool {
    transition plugin_list_response.plugin_count < 64 {
        true -> store(plugin_list_response, plugin)
        false -> (false)
    }
    state store(plugin_list_response: &mut PluginListResponse, plugin: &PluginState) -> bool {
        PluginState::clone_from(&mut plugin_list_response.plugins[plugin_list_response.plugin_count], plugin);
        plugin_list_response.plugin_count = ((plugin_list_response.plugin_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}

pub machine PluginListResponse::has_opened_process_info(plugin_list_response: &PluginListResponse) -> bool {
    plugin_list_response.has_opened_process_info
}

pub machine PluginListResponse::get_opened_process_info(plugin_list_response: &PluginListResponse) -> &OpenedProcessInfo {
    &plugin_list_response.opened_process_info
}

pub machine PluginListResponse::set_opened_process_info(plugin_list_response: &mut PluginListResponse, opened_process_info: OpenedProcessInfo) {
    plugin_list_response.opened_process_info = opened_process_info;
    plugin_list_response.has_opened_process_info = true;
}

pub machine PluginListResponse::clear_opened_process_info(plugin_list_response: &mut PluginListResponse) {
    plugin_list_response.has_opened_process_info = false;
}

pub machine PluginListResponse::get_default_plugin_id_count(plugin_list_response: &PluginListResponse) -> u64 {
    plugin_list_response.default_plugin_id_count
}

pub machine PluginListResponse::get_default_plugin_id(plugin_list_response: &PluginListResponse, position: u64) -> &PluginId
    requires 0 <= position && position < 64
{
    &plugin_list_response.default_plugin_ids[position]
}

pub machine PluginListResponse::add_default_plugin_id(plugin_list_response: &mut PluginListResponse, plugin_id: &PluginId) -> bool {
    transition plugin_list_response.default_plugin_id_count < 64 {
        true -> store(plugin_list_response, plugin_id)
        false -> (false)
    }
    state store(plugin_list_response: &mut PluginListResponse, plugin_id: &PluginId) -> bool {
        PluginId::clone_from(&mut plugin_list_response.default_plugin_ids[plugin_list_response.default_plugin_id_count], plugin_id);
        plugin_list_response.default_plugin_id_count = ((plugin_list_response.default_plugin_id_count as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> (true) }
    }
}
