module src::commands::unprivileged_command_response;

use src::commands::project::project_response::ProjectResponse;
use src::commands::project_items::project_items_response::ProjectItemsResponse;
use src::commands::project_symbols::project_symbols_response::ProjectSymbolsResponse;

// Port of commands/unprivileged_command_response.rs — the response union
// paired with UnprivilegedCommand.
pub data UnprivilegedCommandResponse {
    case Project(response: ProjectResponse);
    case ProjectItems(response: ProjectItemsResponse);
    case ProjectSymbols(response: ProjectSymbolsResponse);
}
