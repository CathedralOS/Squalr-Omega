use src/commands/project/project_response.omg;
use src/commands/project_items/project_items_response.omg;
use src/commands/project_symbols/project_symbols_response.omg;

// Port of commands/unprivileged_command_response.rs — the response union
// paired with UnprivilegedCommand.
public data UnprivilegedCommandResponse {
    case Project(response: |project_response|::ProjectResponse);
    case ProjectItems(response: |project_items_response|::ProjectItemsResponse);
    case ProjectSymbols(response: |project_symbols_response|::ProjectSymbolsResponse);
}
