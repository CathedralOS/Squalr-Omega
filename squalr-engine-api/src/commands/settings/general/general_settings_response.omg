use src/commands/settings/general/list/general_settings_list_response.omg;
use src/commands/settings/general/set/general_settings_set_response.omg;

// Port of commands/settings/general/general_settings_response.rs — upstream
// declares the response cases Set first, List second.
public data GeneralSettingsResponse {
    case Set(response: |general_settings_set_response|::GeneralSettingsSetResponse);
    case List(response: |general_settings_list_response|::GeneralSettingsListResponse);
}
