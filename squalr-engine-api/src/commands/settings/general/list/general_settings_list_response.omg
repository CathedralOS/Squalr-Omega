module src::commands::settings::general::list::general_settings_list_response;

use src::commands::settings::settings_error::SettingsError;
use src::structures::settings::general_settings::GeneralSettings;

// Port of commands/settings/general/list/general_settings_list_response.rs —
// `Result<GeneralSettings, SettingsError>` rides the two-payload-case union
// carrier (the same shape ScanResult::Valued uses; no shared Result type
// exists in the codebase).
pub data GeneralSettingsResult {
    case Ok(settings: GeneralSettings);
    case Err(error: SettingsError);
}

pub machine GeneralSettingsResult::new_ok(settings: GeneralSettings) -> GeneralSettingsResult {
    (GeneralSettingsResult::Ok { settings: settings })
}

pub machine GeneralSettingsResult::new_err(error: SettingsError) -> GeneralSettingsResult {
    (GeneralSettingsResult::Err { error: error })
}

pub machine GeneralSettingsResult::is_ok(&self) -> bool {
    transition self {
        GeneralSettingsResult::Ok { settings } -> (true)
        _ -> (false)
    }
}

pub machine GeneralSettingsResult::is_err(&self) -> bool {
    transition self {
        GeneralSettingsResult::Err { error } -> (true)
        _ -> (false)
    }
}

pub data GeneralSettingsListResponse {
    general_settings_result: GeneralSettingsResult;
}

pub machine GeneralSettingsListResponse::new(general_settings_result: GeneralSettingsResult) -> GeneralSettingsListResponse {
    (GeneralSettingsListResponse {
        general_settings_result: general_settings_result
    })
}

pub machine GeneralSettingsListResponse::get_general_settings_result(&self) -> &GeneralSettingsResult {
    &self.general_settings_result
}
