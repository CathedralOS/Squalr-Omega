use src/commands/settings/general/list/general_settings_list_request.omg;
use src/commands/settings/general/set/general_settings_set_request.omg;

// Port of commands/settings/general/general_settings_command.rs — List/Set
// in upstream case order.
public data GeneralSettingsCommand {
    case List(request: |general_settings_list_request|::GeneralSettingsListRequest);
    case Set(request: |general_settings_set_request|::GeneralSettingsSetRequest);
}
