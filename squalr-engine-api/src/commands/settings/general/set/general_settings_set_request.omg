module src::commands::settings::general::set::general_settings_set_request;


// Port of commands/settings/general/set/general_settings_set_request.rs — every
// field is Option upstream: absent leaves the stored knob alone, present
// writes it. The has_ + value pair is the Option respell (the same carrier
// the process requests use).
pub data GeneralSettingsSetRequest {
    has_engine_request_delay: bool;
    engine_request_delay: u64;
}

// Upstream default construction: every Option leg absent.
pub machine GeneralSettingsSetRequest::new() -> GeneralSettingsSetRequest {
    GeneralSettingsSetRequest {
        has_engine_request_delay: false,
    }
}

pub machine GeneralSettingsSetRequest::has_engine_request_delay(&self) -> bool {
    self.has_engine_request_delay
}

pub machine GeneralSettingsSetRequest::get_engine_request_delay(&self) -> u64 {
    self.engine_request_delay
}

pub machine GeneralSettingsSetRequest::set_engine_request_delay(&mut self, engine_request_delay: u64) {
    self.engine_request_delay = engine_request_delay;
    self.has_engine_request_delay = true;
}

pub machine GeneralSettingsSetRequest::clear_engine_request_delay(&mut self) {
    self.has_engine_request_delay = false;
}
