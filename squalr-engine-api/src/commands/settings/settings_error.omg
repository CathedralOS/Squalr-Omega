module src::commands::settings::settings_error;

// Port of commands/settings/settings_error.rs — upstream's enum has exactly
// one variant, `ReadFailure { settings_scope: String }`; the port is the
// variant's payload record directly (a one-variant union ceremony would add
// no state). `settings_scope` rides the bounded [u8; 256] + live length
// convention; `read_failure` is upstream's constructor.
pub data SettingsError {
    settings_scope: [u8; 256];
    settings_scope_len: u64;
}

pub machine SettingsError::read_failure(settings_scope: &[u8]) -> SettingsError {
    let mut error: SettingsError = SettingsError {
        settings_scope_len: 0,
    };
    error.set_settings_scope(settings_scope);
    (error)
}

pub machine SettingsError::default() -> SettingsError {
    SettingsError {
        settings_scope_len: 0,
    }
}

// The live scope span (upstream's `{settings_scope}` formatting reads this).
pub machine SettingsError::get_settings_scope(&self) -> &[u8] {
    transition self.settings_scope_len <= 256 {
        true -> (&self.settings_scope[0..self.settings_scope_len])
        false -> (&self.settings_scope[0..256])
        _ -> (&self.settings_scope[0..256])
    }
}

pub machine SettingsError::set_settings_scope(&mut self, settings_scope: &[u8]) {
    self.settings_scope_len = 0;
    transition { _ -> copy(settings_scope, 0) }
    state copy(&mut self, settings_scope: &[u8], position: u64) {
        transition position < settings_scope.len && position < 256 {
            true -> store(settings_scope, position)
            false -> finish(position)
        }
    }
    state store(&mut self, settings_scope: &[u8], position: u64) {
        self.settings_scope[position] = settings_scope[position];
        transition {
            _ -> copy(settings_scope, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(&mut self, count: u64) {
        self.settings_scope_len = count;
    }
}

pub machine SettingsError::clone(&self) -> SettingsError {
    let mut clone: SettingsError = SettingsError::default();
    clone.clone_from(self);
    (clone)
}

pub machine SettingsError::clone_from(&mut self, source: &SettingsError) {
    self.settings_scope_len = source.settings_scope_len;
    transition { _ -> copy(source, 0) }
    state copy(&mut self, source: &SettingsError, position: u64) {
        transition position < source.settings_scope_len && position < 256 {
            true -> store(source, position)
            false -> done()
        }
    }
    state store(&mut self, source: &SettingsError, position: u64) {
        self.settings_scope[position] = source.settings_scope[position];
        transition {
            _ -> copy(source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state done(&mut self) {
    }
}
