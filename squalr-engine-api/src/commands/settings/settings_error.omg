module src::commands::settings::settings_error;

// Port of commands/settings/settings_error.rs — upstream's enum has exactly
// one variant, `ReadFailure { settings_scope: String }`; the port is the
// variant's payload record directly (a one-variant union ceremony would add
// no state). `settings_scope` rides the bounded [u8; 256] + live length
// convention; `read_failure` is upstream's constructor.
pub data SettingsError {
    settings_scope: [u8; 256];
    settings_scope_len: u64;
}

pub machine SettingsError::read_failure(settings_scope: &[u8]) -> SettingsError {
    let mut error: SettingsError = SettingsError {
        settings_scope_len: 0,
    };
    SettingsError::set_settings_scope(&mut error, settings_scope);
    (error)
}

pub machine SettingsError::default() -> SettingsError {
    SettingsError {
        settings_scope_len: 0,
    }
}

// The live scope span (upstream's `{settings_scope}` formatting reads this).
pub machine SettingsError::get_settings_scope(this: &SettingsError) -> &[u8] {
    transition this.settings_scope_len <= 256 {
        true -> (&this.settings_scope[0..this.settings_scope_len])
        false -> (&this.settings_scope[0..256])
        _ -> (&this.settings_scope[0..256])
    }
}

pub machine SettingsError::set_settings_scope(this: &mut SettingsError, settings_scope: &[u8]) {
    this.settings_scope_len = 0;
    transition { _ -> copy(this, settings_scope, 0) }
    state copy(this: &mut SettingsError, settings_scope: &[u8], position: u64) {
        transition position < settings_scope.len && position < 256 {
            true -> store(this, settings_scope, position)
            false -> finish(this, position)
        }
    }
    state store(this: &mut SettingsError, settings_scope: &[u8], position: u64) {
        this.settings_scope[position] = settings_scope[position];
        transition {
            _ -> copy(this, settings_scope, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish(this: &mut SettingsError, count: u64) {
        this.settings_scope_len = count;
    }
}

pub machine SettingsError::clone(this: &SettingsError) -> SettingsError {
    let mut clone: SettingsError = SettingsError::default();
    SettingsError::clone_from(&mut clone, this);
    (clone)
}

pub machine SettingsError::clone_from(this: &mut SettingsError, source: &SettingsError) {
    this.settings_scope_len = source.settings_scope_len;
    transition { _ -> copy(this, source, 0) }
    state copy(this: &mut SettingsError, source: &SettingsError, position: u64) {
        transition position < source.settings_scope_len && position < 256 {
            true -> store(this, source, position)
            false -> done(this)
        }
    }
    state store(this: &mut SettingsError, source: &SettingsError, position: u64) {
        this.settings_scope[position] = source.settings_scope[position];
        transition {
            _ -> copy(this, source, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state done(this: &mut SettingsError) {
    }
}
