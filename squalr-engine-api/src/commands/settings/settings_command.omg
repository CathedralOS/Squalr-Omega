module src::commands::settings::settings_command;

use src::commands::settings::general::general_settings_command::GeneralSettingsCommand;
use src::commands::settings::memory::memory_settings_command::MemorySettingsCommand;
use src::commands::settings::scan::scan_settings_command::ScanSettingsCommand;

// Port of commands/settings/settings_command.rs — the settings-domain
// command union, in upstream case order.
pub data SettingsCommand {
    case General(command: GeneralSettingsCommand);
    case Memory(command: MemorySettingsCommand);
    case Scan(command: ScanSettingsCommand);
}
