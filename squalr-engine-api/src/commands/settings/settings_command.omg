use src/commands/settings/general/general_settings_command.omg;
use src/commands/settings/memory/memory_settings_command.omg;
use src/commands/settings/scan/scan_settings_command.omg;

// Port of commands/settings/settings_command.rs — the settings-domain
// command union, in upstream case order.
public data SettingsCommand {
    case General(command: |general_settings_command|::GeneralSettingsCommand);
    case Memory(command: |memory_settings_command|::MemorySettingsCommand);
    case Scan(command: |scan_settings_command|::ScanSettingsCommand);
}
