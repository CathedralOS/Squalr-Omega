use src/commands/settings/scan/list/scan_settings_list_request.omg;
use src/commands/settings/scan/set/scan_settings_set_request.omg;

// Port of commands/settings/scan/scan_settings_command.rs — List/Set
// in upstream case order.
public data ScanSettingsCommand {
    case List(request: |scan_settings_list_request|::ScanSettingsListRequest);
    case Set(request: |scan_settings_set_request|::ScanSettingsSetRequest);
}
