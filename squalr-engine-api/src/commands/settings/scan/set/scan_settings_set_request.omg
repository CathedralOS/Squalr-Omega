// Port of commands/settings/scan/set/scan_settings_set_request.rs — every
// field is Option upstream: absent leaves the stored knob alone, present
// writes it. The has_ + value pair is the Option respell (the same carrier
// the process requests use).
pub data ScanSettingsSetRequest {
    has_page_retrieval_mode: bool;
    page_retrieval_mode: PageRetrievalMode;
    has_results_page_size: bool;
    results_page_size: u64;
    has_results_read_interval_ms: bool;
    results_read_interval_ms: u64;
    has_project_read_interval_ms: bool;
    project_read_interval_ms: u64;
    has_project_file_system_watch_enabled: bool;
    project_file_system_watch_enabled: bool;
    has_freeze_interval_ms: bool;
    freeze_interval_ms: u64;
    has_memory_alignment: bool;
    memory_alignment: MemoryAlignment;
    has_memory_read_mode: bool;
    memory_read_mode: MemoryReadMode;
    has_floating_point_tolerance: bool;
    floating_point_tolerance: FloatingPointTolerance;
    has_is_single_threaded_scan: bool;
    is_single_threaded_scan: bool;
    has_debug_perform_validation_scan: bool;
    debug_perform_validation_scan: bool;
}

// Upstream default construction: every Option leg absent.
pub machine ScanSettingsSetRequest::new() -> ScanSettingsSetRequest {
    ScanSettingsSetRequest {
        has_page_retrieval_mode: false,
        has_results_page_size: false,
        has_results_read_interval_ms: false,
        has_project_read_interval_ms: false,
        has_project_file_system_watch_enabled: false,
        has_freeze_interval_ms: false,
        has_memory_alignment: false,
        has_memory_read_mode: false,
        has_floating_point_tolerance: false,
        has_is_single_threaded_scan: false,
        has_debug_perform_validation_scan: false,
    }
}

