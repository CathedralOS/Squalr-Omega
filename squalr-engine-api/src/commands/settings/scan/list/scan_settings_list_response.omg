module src::commands::settings::scan::list::scan_settings_list_response;

use src::commands::settings::settings_error::SettingsError;
use src::structures::settings::scan_settings::ScanSettings;

// Port of commands/settings/scan/list/scan_settings_list_response.rs —
// `Result<ScanSettings, SettingsError>` rides the two-payload-case union
// carrier (the same shape ScanResult::Valued uses; no shared Result type
// exists in the codebase).
public data ScanSettingsResult {
    case Ok(settings: ScanSettings);
    case Err(error: SettingsError);
}

public machine ScanSettingsResult::new_ok(settings: ScanSettings) -> ScanSettingsResult {
    (ScanSettingsResult::Ok { settings: settings })
}

public machine ScanSettingsResult::new_err(error: SettingsError) -> ScanSettingsResult {
    (ScanSettingsResult::Err { error: error })
}

public machine ScanSettingsResult::is_ok(this: &ScanSettingsResult) -> bool {
    transition this {
        ScanSettingsResult::Ok { settings } -> (true)
        _ -> (false)
    }
}

public machine ScanSettingsResult::is_err(this: &ScanSettingsResult) -> bool {
    transition this {
        ScanSettingsResult::Err { error } -> (true)
        _ -> (false)
    }
}

public data ScanSettingsListResponse {
    scan_settings_result: ScanSettingsResult;
}

public machine ScanSettingsListResponse::new(scan_settings_result: ScanSettingsResult) -> ScanSettingsListResponse {
    (ScanSettingsListResponse {
        scan_settings_result: scan_settings_result
    })
}

public machine ScanSettingsListResponse::get_scan_settings_result(this: &ScanSettingsListResponse) -> &ScanSettingsResult {
    &this.scan_settings_result
}
