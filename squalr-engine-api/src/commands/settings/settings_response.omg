module src::commands::settings::settings_response;

use src::commands::settings::general::general_settings_response::GeneralSettingsResponse;
use src::commands::settings::memory::memory_settings_response::MemorySettingsResponse;
use src::commands::settings::scan::scan_settings_response::ScanSettingsResponse;

// Port of commands/settings/settings_response.rs — the settings-domain
// response union, in upstream case order.
pub data SettingsResponse {
    case General(response: GeneralSettingsResponse);
    case Memory(response: MemorySettingsResponse);
    case Scan(response: ScanSettingsResponse);
}
