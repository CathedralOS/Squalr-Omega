use src/commands/settings/general/general_settings_response.omg;
use src/commands/settings/memory/memory_settings_response.omg;
use src/commands/settings/scan/scan_settings_response.omg;

// Port of commands/settings/settings_response.rs — the settings-domain
// response union, in upstream case order.
public data SettingsResponse {
    case General(response: |general_settings_response|::GeneralSettingsResponse);
    case Memory(response: |memory_settings_response|::MemorySettingsResponse);
    case Scan(response: |scan_settings_response|::ScanSettingsResponse);
}
