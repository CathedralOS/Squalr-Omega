module src::commands::settings::memory::list::memory_settings_list_response;

use src::commands::settings::settings_error::SettingsError;
use src::structures::settings::memory_settings::MemorySettings;

// Port of commands/settings/memory/list/memory_settings_list_response.rs —
// `Result<MemorySettings, SettingsError>` rides the two-payload-case union
// carrier (the same shape ScanResult::Valued uses; no shared Result type
// exists in the codebase).
public data MemorySettingsResult {
    case Ok(settings: MemorySettings);
    case Err(error: SettingsError);
}

public machine MemorySettingsResult::new_ok(settings: MemorySettings) -> MemorySettingsResult {
    (MemorySettingsResult::Ok { settings: settings })
}

public machine MemorySettingsResult::new_err(error: SettingsError) -> MemorySettingsResult {
    (MemorySettingsResult::Err { error: error })
}

public machine MemorySettingsResult::is_ok(this: &MemorySettingsResult) -> bool {
    transition this {
        MemorySettingsResult::Ok { settings } -> (true)
        _ -> (false)
    }
}

public machine MemorySettingsResult::is_err(this: &MemorySettingsResult) -> bool {
    transition this {
        MemorySettingsResult::Err { error } -> (true)
        _ -> (false)
    }
}

public data MemorySettingsListResponse {
    memory_settings_result: MemorySettingsResult;
}

public machine MemorySettingsListResponse::new(memory_settings_result: MemorySettingsResult) -> MemorySettingsListResponse {
    (MemorySettingsListResponse {
        memory_settings_result: memory_settings_result
    })
}

public machine MemorySettingsListResponse::get_memory_settings_result(this: &MemorySettingsListResponse) -> &MemorySettingsResult {
    &this.memory_settings_result
}
