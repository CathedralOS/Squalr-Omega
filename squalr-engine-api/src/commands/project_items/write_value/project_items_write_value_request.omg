module src::commands::project_items::write_value::project_items_write_value_request;

use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::data_values::anonymous_value_string::AnonymousValueString;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use src::structures::data_values::container_type::ContainerType;
// Port of commands/project_items/write_value/project_items_write_value_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsWriteValueRequest {
    project_item_path: [u8; 512];
    project_item_path_len: u64;
    field_name: [u8; 256];
    field_name_len: u64;
    anonymous_value_string: AnonymousValueString;
}

pub machine ProjectItemsWriteValueRequest::new() -> ProjectItemsWriteValueRequest {
    ProjectItemsWriteValueRequest {
        project_item_path_len: 0,
        field_name_len: 0,
        anonymous_value_string: AnonymousValueString::new(&[], AnonymousValueStringFormat::default(), ContainerType::default()),
    }
}

pub machine ProjectItemsWriteValueRequest::default() -> ProjectItemsWriteValueRequest {
    ProjectItemsWriteValueRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectItemsWriteValueRequest::get_project_item_path(&self) -> &[u8] {
    bounded_slice(&self.project_item_path[0..512], self.project_item_path_len)
}

pub machine ProjectItemsWriteValueRequest::set_project_item_path(&mut self, project_item_path: &[u8]) {
    self.project_item_path_len = BoundedByteCopy::copy(&mut self.project_item_path[0..512], project_item_path);
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectItemsWriteValueRequest::get_field_name(&self) -> &[u8] {
    bounded_slice(&self.field_name[0..256], self.field_name_len)
}

pub machine ProjectItemsWriteValueRequest::set_field_name(&mut self, field_name: &[u8]) {
    self.field_name_len = BoundedByteCopy::copy(&mut self.field_name[0..256], field_name);
}

pub machine ProjectItemsWriteValueRequest::get_anonymous_value_string(&self) -> &AnonymousValueString {
    &self.anonymous_value_string
}

pub machine ProjectItemsWriteValueRequest::set_anonymous_value_string(&mut self, anonymous_value_string: AnonymousValueString) {
    self.anonymous_value_string = anonymous_value_string;
}
