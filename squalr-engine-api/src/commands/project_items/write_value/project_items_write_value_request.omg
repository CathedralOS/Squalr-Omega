module src::commands::project_items::write_value::project_items_write_value_request;

use src::structures::data_values::anonymous_value_string::AnonymousValueString;
use src::structures::data_values::anonymous_value_string_format::AnonymousValueStringFormat;
use src::structures::data_values::container_type::ContainerType;
// Port of commands/project_items/write_value/project_items_write_value_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsWriteValueRequest {
    project_item_path: [u8; 512];
    project_item_path_len: u64;
    field_name: [u8; 256];
    field_name_len: u64;
    anonymous_value_string: AnonymousValueString;
}

pub machine ProjectItemsWriteValueRequest::new() -> ProjectItemsWriteValueRequest {
    ProjectItemsWriteValueRequest {
        project_item_path_len: 0,
        field_name_len: 0,
        anonymous_value_string: AnonymousValueString::new(&[], AnonymousValueStringFormat::default(), ContainerType::default()),
    }
}

pub machine ProjectItemsWriteValueRequest::default() -> ProjectItemsWriteValueRequest {
    ProjectItemsWriteValueRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectItemsWriteValueRequest::get_project_item_path(project_items_write_value_request: &ProjectItemsWriteValueRequest) -> &[u8] {
    transition project_items_write_value_request.project_item_path_len <= 512 {
        true -> (&project_items_write_value_request.project_item_path[0..project_items_write_value_request.project_item_path_len])
        false -> (&project_items_write_value_request.project_item_path[0..512])
        _ -> (&project_items_write_value_request.project_item_path[0..512])
    }
}

pub machine ProjectItemsWriteValueRequest::set_project_item_path(project_items_write_value_request: &mut ProjectItemsWriteValueRequest, project_item_path: &[u8]) {
    project_items_write_value_request.project_item_path_len = 0;
    transition {
        _ -> copy_project_item_path(project_items_write_value_request, project_item_path, 0)
    }
    state copy_project_item_path(project_items_write_value_request: &mut ProjectItemsWriteValueRequest, project_item_path: &[u8], position: u64) {
        transition position < project_item_path.len && position < 512 {
            true -> store_project_item_path(project_items_write_value_request, project_item_path, position)
            false -> finish_project_item_path(project_items_write_value_request, position)
        }
    }
    state store_project_item_path(project_items_write_value_request: &mut ProjectItemsWriteValueRequest, project_item_path: &[u8], position: u64) {
        project_items_write_value_request.project_item_path[position] = project_item_path[position];
        transition {
            _ -> copy_project_item_path(project_items_write_value_request, project_item_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_item_path(project_items_write_value_request: &mut ProjectItemsWriteValueRequest, count: u64) {
        project_items_write_value_request.project_item_path_len = count;
    }
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectItemsWriteValueRequest::get_field_name(project_items_write_value_request: &ProjectItemsWriteValueRequest) -> &[u8] {
    transition project_items_write_value_request.field_name_len <= 256 {
        true -> (&project_items_write_value_request.field_name[0..project_items_write_value_request.field_name_len])
        false -> (&project_items_write_value_request.field_name[0..256])
        _ -> (&project_items_write_value_request.field_name[0..256])
    }
}

pub machine ProjectItemsWriteValueRequest::set_field_name(project_items_write_value_request: &mut ProjectItemsWriteValueRequest, field_name: &[u8]) {
    project_items_write_value_request.field_name_len = 0;
    transition {
        _ -> copy_field_name(project_items_write_value_request, field_name, 0)
    }
    state copy_field_name(project_items_write_value_request: &mut ProjectItemsWriteValueRequest, field_name: &[u8], position: u64) {
        transition position < field_name.len && position < 256 {
            true -> store_field_name(project_items_write_value_request, field_name, position)
            false -> finish_field_name(project_items_write_value_request, position)
        }
    }
    state store_field_name(project_items_write_value_request: &mut ProjectItemsWriteValueRequest, field_name: &[u8], position: u64) {
        project_items_write_value_request.field_name[position] = field_name[position];
        transition {
            _ -> copy_field_name(project_items_write_value_request, field_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_field_name(project_items_write_value_request: &mut ProjectItemsWriteValueRequest, count: u64) {
        project_items_write_value_request.field_name_len = count;
    }
}

pub machine ProjectItemsWriteValueRequest::get_anonymous_value_string(project_items_write_value_request: &ProjectItemsWriteValueRequest) -> &AnonymousValueString {
    &project_items_write_value_request.anonymous_value_string
}

pub machine ProjectItemsWriteValueRequest::set_anonymous_value_string(project_items_write_value_request: &mut ProjectItemsWriteValueRequest, anonymous_value_string: AnonymousValueString) {
    project_items_write_value_request.anonymous_value_string = anonymous_value_string;
}
