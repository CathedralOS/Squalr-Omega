module src::commands::project_items::write_value::project_items_write_value_response;

// Port of commands/project_items/write_value/project_items_write_value_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsWriteValueResponse {
    success: bool;
    has_error: bool;
    error: [u8; 512];
    error_len: u64;
}

pub machine ProjectItemsWriteValueResponse::new() -> ProjectItemsWriteValueResponse {
    ProjectItemsWriteValueResponse {
        success: false,
        has_error: false,
        error_len: 0,
    }
}

pub machine ProjectItemsWriteValueResponse::default() -> ProjectItemsWriteValueResponse {
    ProjectItemsWriteValueResponse::new()
}

pub machine ProjectItemsWriteValueResponse::get_success(this: &ProjectItemsWriteValueResponse) -> bool {
    this.success
}

pub machine ProjectItemsWriteValueResponse::set_success(this: &mut ProjectItemsWriteValueResponse, success: bool) {
    this.success = success;
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectItemsWriteValueResponse::has_error(this: &ProjectItemsWriteValueResponse) -> bool {
    this.has_error
}

pub machine ProjectItemsWriteValueResponse::get_error(this: &ProjectItemsWriteValueResponse) -> &[u8] {
    transition this.error_len <= 512 {
        true -> (&this.error[0..this.error_len])
        false -> (&this.error[0..512])
        _ -> (&this.error[0..512])
    }
}

pub machine ProjectItemsWriteValueResponse::set_error(this: &mut ProjectItemsWriteValueResponse, error: &[u8]) {
    this.has_error = true;
    this.error_len = 0;
    transition {
        _ -> copy_error(this, error, 0)
    }
    state copy_error(this: &mut ProjectItemsWriteValueResponse, error: &[u8], position: u64) {
        transition position < error.len && position < 512 {
            true -> store_error(this, error, position)
            false -> finish_error(this, position)
        }
    }
    state store_error(this: &mut ProjectItemsWriteValueResponse, error: &[u8], position: u64) {
        this.error[position] = error[position];
        transition {
            _ -> copy_error(this, error, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_error(this: &mut ProjectItemsWriteValueResponse, count: u64) {
        this.error_len = count;
    }
}

pub machine ProjectItemsWriteValueResponse::clear_error(this: &mut ProjectItemsWriteValueResponse) {
    this.has_error = false;
    this.error_len = 0;
}
