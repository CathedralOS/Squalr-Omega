// Upstream `Vec<ProjectItemsUpdateDetailsPathChange>` -> bounded [ProjectItemsUpdateDetailsPathChange; 64] + live count; `add_path_change`
// refuses past the bound rather than truncating.
pub machine ProjectItemsUpdateDetailsResponse::get_path_change_count(&self) -> u64 {
    self.path_change_count
}

// Guarded element access — callers gate on get_path_change_count.
pub machine ProjectItemsUpdateDetailsResponse::get_path_change(&self, index: u64) -> &ProjectItemsUpdateDetailsPathChange
    requires 0 <= index && index < 64
{
    &self.path_changes[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectItemsUpdateDetailsResponse::add_path_change(&mut self, path_change: ProjectItemsUpdateDetailsPathChange) -> bool {
    transition self.path_change_count < 64 {
        true -> store_path_change(path_change)
        false -> (false)
        _ -> (false)
    }
    state store_path_change(&mut self, path_change: ProjectItemsUpdateDetailsPathChange) -> bool {
        let index: u64 = self.path_change_count;
        transition index < 64 {
            true -> fill_path_change(path_change, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_path_change(&mut self, path_change: ProjectItemsUpdateDetailsPathChange, index: u64) -> bool
        requires 0 <= index && index < 64
    {
        self.path_changes[index] = path_change;
        self.path_change_count = index + 1;
        (true)
    }
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectItemsUpdateDetailsResponse::has_error(&self) -> bool {
    self.has_error
}

pub machine ProjectItemsUpdateDetailsResponse::get_error(&self) -> &[u8] {
    transition self.error_len <= 512 {
        true -> (&self.error[0..self.error_len])
        false -> (&self.error[0..512])
        _ -> (&self.error[0..512])
    }
}

pub machine ProjectItemsUpdateDetailsResponse::set_error(&mut self, error: &[u8]) {
    self.has_error = true;
    self.error_len = BoundedByteCopy::copy(&mut self.error[0..512], error);
}

pub machine ProjectItemsUpdateDetailsResponse::clear_error(&mut self) {
    self.has_error = false;
    self.error_len = 0;
}
