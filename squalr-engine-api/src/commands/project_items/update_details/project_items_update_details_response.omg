module src::commands::project_items::update_details::project_items_update_details_response;

// Port of commands/project_items/update_details/project_items_update_details_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
// Upstream `ProjectItemsUpdateDetailsPathChange` — one renamed item path.
pub data ProjectItemsUpdateDetailsPathChange {
    previous_project_item_path: [u8; 512];
    previous_project_item_path_len: u64;
    updated_project_item_path: [u8; 512];
    updated_project_item_path_len: u64;
}

pub machine ProjectItemsUpdateDetailsPathChange::new() -> ProjectItemsUpdateDetailsPathChange {
    ProjectItemsUpdateDetailsPathChange {
        previous_project_item_path_len: 0,
        updated_project_item_path_len: 0,
    }
}

// Upstream aggregate construction — bounded copy of both path slices.
pub machine ProjectItemsUpdateDetailsPathChange::new_with(
    previous_project_item_path: &[u8],
    updated_project_item_path: &[u8]
) -> ProjectItemsUpdateDetailsPathChange {
    let mut path_change: ProjectItemsUpdateDetailsPathChange = ProjectItemsUpdateDetailsPathChange::new();
    let previous_len: u64 = fill_path(previous_project_item_path, &mut path_change.previous_project_item_path);
    path_change.previous_project_item_path_len = previous_len;
    let updated_len: u64 = fill_path(updated_project_item_path, &mut path_change.updated_project_item_path);
    path_change.updated_project_item_path_len = updated_len;
    path_change
}

machine fill_path(source: &[u8], out: &mut [u8; 512]) -> u64 {
    transition { _ -> entry_gate(source, out, source.len) }
    state entry_gate(source: &[u8], out: &mut [u8; 512], source_len: u64) -> u64 {
        transition source_len <= 512 {
            true -> copy(source, out, source_len, 0)
            _ -> (0)
        }
    }
    state copy(source: &[u8], out: &mut [u8; 512], source_len: u64, position: u64) -> u64
        requires source_len <= 512;
    {
        transition position < source_len && position < source.len {
            true -> put(source, out, source_len, position)
            _ -> (source_len)
        }
    }
    state put(source: &[u8], out: &mut [u8; 512], source_len: u64, position: u64) -> u64
        requires position < source.len && source_len <= 512;
    {
        out[position] = source[position];
        transition { _ -> copy(source, out, source_len, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

pub machine ProjectItemsUpdateDetailsPathChange::default() -> ProjectItemsUpdateDetailsPathChange {
    ProjectItemsUpdateDetailsPathChange::new()
}

pub machine ProjectItemsUpdateDetailsPathChange::get_previous_project_item_path(project_items_update_details_path_change: &ProjectItemsUpdateDetailsPathChange) -> &[u8] {
    transition project_items_update_details_path_change.previous_project_item_path_len <= 512 {
        true -> (&project_items_update_details_path_change.previous_project_item_path[0..project_items_update_details_path_change.previous_project_item_path_len])
        false -> (&project_items_update_details_path_change.previous_project_item_path[0..512])
        _ -> (&project_items_update_details_path_change.previous_project_item_path[0..512])
    }
}

pub machine ProjectItemsUpdateDetailsPathChange::get_updated_project_item_path(project_items_update_details_path_change: &ProjectItemsUpdateDetailsPathChange) -> &[u8] {
    transition project_items_update_details_path_change.updated_project_item_path_len <= 512 {
        true -> (&project_items_update_details_path_change.updated_project_item_path[0..project_items_update_details_path_change.updated_project_item_path_len])
        false -> (&project_items_update_details_path_change.updated_project_item_path[0..512])
        _ -> (&project_items_update_details_path_change.updated_project_item_path[0..512])
    }
}

pub data ProjectItemsUpdateDetailsResponse {
    success: bool;
    updated_project_item_count: u64;
    path_changes: [ProjectItemsUpdateDetailsPathChange; 64];
    path_change_count: u64;
    has_error: bool;
    error: [u8; 512];
    error_len: u64;
}

pub machine ProjectItemsUpdateDetailsResponse::new() -> ProjectItemsUpdateDetailsResponse {
    ProjectItemsUpdateDetailsResponse {
        success: false,
        updated_project_item_count: 0,
        path_change_count: 0,
        has_error: false,
        error_len: 0,
    }
}

pub machine ProjectItemsUpdateDetailsResponse::default() -> ProjectItemsUpdateDetailsResponse {
    ProjectItemsUpdateDetailsResponse::new()
}

pub machine ProjectItemsUpdateDetailsResponse::get_success(project_items_update_details_response: &ProjectItemsUpdateDetailsResponse) -> bool {
    project_items_update_details_response.success
}

pub machine ProjectItemsUpdateDetailsResponse::set_success(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse, success: bool) {
