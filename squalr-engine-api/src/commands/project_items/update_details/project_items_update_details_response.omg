pub machine ProjectItemsUpdateDetailsResponse::set_error(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse, error: &[u8]) {
    project_items_update_details_response.has_error = true;
    project_items_update_details_response.error_len = 0;
    transition {
        _ -> copy_error(project_items_update_details_response, error, 0)
    }
    state copy_error(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse, error: &[u8], position: u64) {
        transition position < error.len && position < 512 {
            true -> store_error(project_items_update_details_response, error, position)
            false -> finish_error(project_items_update_details_response, position)
        }
    }
    state store_error(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse, error: &[u8], position: u64) {
        project_items_update_details_response.error[position] = error[position];
        transition {
            _ -> copy_error(project_items_update_details_response, error, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_error(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse, count: u64) {
        project_items_update_details_response.error_len = count;
    }
}

pub machine ProjectItemsUpdateDetailsResponse::clear_error(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse) {
    project_items_update_details_response.has_error = false;
    project_items_update_details_response.error_len = 0;
}
