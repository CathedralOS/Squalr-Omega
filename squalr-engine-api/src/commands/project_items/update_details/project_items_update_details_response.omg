// Upstream `Vec<ProjectItemsUpdateDetailsPathChange>` -> bounded [ProjectItemsUpdateDetailsPathChange; 64] + live count; `add_path_change`
// refuses past the bound rather than truncating.
pub machine ProjectItemsUpdateDetailsResponse::get_path_change_count(project_items_update_details_response: &ProjectItemsUpdateDetailsResponse) -> u64 {
    project_items_update_details_response.path_change_count
}

// Guarded element access — callers gate on get_path_change_count.
pub machine ProjectItemsUpdateDetailsResponse::get_path_change(project_items_update_details_response: &ProjectItemsUpdateDetailsResponse, index: u64) -> &ProjectItemsUpdateDetailsPathChange
    requires 0 <= index && index < 64
{
    &project_items_update_details_response.path_changes[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectItemsUpdateDetailsResponse::add_path_change(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse, path_change: ProjectItemsUpdateDetailsPathChange) -> bool {
    transition project_items_update_details_response.path_change_count < 64 {
        true -> store_path_change(project_items_update_details_response, path_change)
        false -> (false)
        _ -> (false)
    }
    state store_path_change(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse, path_change: ProjectItemsUpdateDetailsPathChange) -> bool {
        let index: u64 = project_items_update_details_response.path_change_count;
        transition index < 64 {
            true -> fill_path_change(project_items_update_details_response, path_change, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_path_change(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse, path_change: ProjectItemsUpdateDetailsPathChange, index: u64) -> bool
        requires 0 <= index && index < 64
    {
        project_items_update_details_response.path_changes[index] = path_change;
        project_items_update_details_response.path_change_count = index + 1;
        (true)
    }
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectItemsUpdateDetailsResponse::has_error(project_items_update_details_response: &ProjectItemsUpdateDetailsResponse) -> bool {
    project_items_update_details_response.has_error
}

pub machine ProjectItemsUpdateDetailsResponse::get_error(project_items_update_details_response: &ProjectItemsUpdateDetailsResponse) -> &[u8] {
    transition project_items_update_details_response.error_len <= 512 {
        true -> (&project_items_update_details_response.error[0..project_items_update_details_response.error_len])
        false -> (&project_items_update_details_response.error[0..512])
        _ -> (&project_items_update_details_response.error[0..512])
    }
}

pub machine ProjectItemsUpdateDetailsResponse::set_error(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse, error: &[u8]) {
    project_items_update_details_response.has_error = true;
    project_items_update_details_response.error_len = 0;
    transition {
        _ -> copy_error(project_items_update_details_response, error, 0)
    }
    state copy_error(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse, error: &[u8], position: u64) {
        transition position < error.len && position < 512 {
            true -> store_error(project_items_update_details_response, error, position)
            false -> finish_error(project_items_update_details_response, position)
        }
    }
    state store_error(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse, error: &[u8], position: u64) {
        project_items_update_details_response.error[position] = error[position];
        transition {
            _ -> copy_error(project_items_update_details_response, error, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_error(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse, count: u64) {
        project_items_update_details_response.error_len = count;
    }
}

pub machine ProjectItemsUpdateDetailsResponse::clear_error(project_items_update_details_response: &mut ProjectItemsUpdateDetailsResponse) {
    project_items_update_details_response.has_error = false;
    project_items_update_details_response.error_len = 0;
}
