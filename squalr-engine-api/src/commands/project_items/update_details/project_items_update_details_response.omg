pub data ProjectItemsUpdateDetailsPathChange {
    previous_project_item_path: [u8; 512];
    previous_project_item_path_len: u64;
    updated_project_item_path: [u8; 512];
    updated_project_item_path_len: u64;
}

pub machine ProjectItemsUpdateDetailsPathChange::new() -> ProjectItemsUpdateDetailsPathChange {
    ProjectItemsUpdateDetailsPathChange {
        previous_project_item_path_len: 0,
        updated_project_item_path_len: 0,
    }
}

pub machine ProjectItemsUpdateDetailsPathChange::default() -> ProjectItemsUpdateDetailsPathChange {
    ProjectItemsUpdateDetailsPathChange::new()
}

pub machine ProjectItemsUpdateDetailsPathChange::get_previous_project_item_path(&self) -> &[u8] {
    transition self.previous_project_item_path_len <= 512 {
        true -> (&self.previous_project_item_path[0..self.previous_project_item_path_len])
        false -> (&self.previous_project_item_path[0..512])
        _ -> (&self.previous_project_item_path[0..512])
    }
}

pub machine ProjectItemsUpdateDetailsPathChange::get_updated_project_item_path(&self) -> &[u8] {
    transition self.updated_project_item_path_len <= 512 {
        true -> (&self.updated_project_item_path[0..self.updated_project_item_path_len])
        false -> (&self.updated_project_item_path[0..512])
        _ -> (&self.updated_project_item_path[0..512])
