use src/structures/projects/project_path_list.omg;
// Port of commands/project_items/delete/project_items_delete_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
public data ProjectItemsDeleteRequest {
    project_item_paths: |project_path_list|::ProjectPathList;
}

public machine ProjectItemsDeleteRequest::new() -> ProjectItemsDeleteRequest {
    ProjectItemsDeleteRequest {
        project_item_paths: |project_path_list|::ProjectPathList::empty(),
    }
}

public machine ProjectItemsDeleteRequest::default() -> ProjectItemsDeleteRequest {
    ProjectItemsDeleteRequest::new()
}

public machine ProjectItemsDeleteRequest::get_project_item_paths(this: &ProjectItemsDeleteRequest) -> &|project_path_list|::ProjectPathList {
    &this.project_item_paths
}

public machine ProjectItemsDeleteRequest::set_project_item_paths(this: &mut ProjectItemsDeleteRequest, project_item_paths: |project_path_list|::ProjectPathList) {
    this.project_item_paths = project_item_paths;
}
