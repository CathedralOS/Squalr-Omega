module src::commands::project_items::duplicate::project_items_duplicate_request;

use src::structures::projects::project_path_list::ProjectPathList;
// Port of commands/project_items/duplicate/project_items_duplicate_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsDuplicateRequest {
    project_item_paths: ProjectPathList;
    target_directory_path: [u8; 512];
    target_directory_path_len: u64;
}

pub machine ProjectItemsDuplicateRequest::new() -> ProjectItemsDuplicateRequest {
    ProjectItemsDuplicateRequest {
        project_item_paths: ProjectPathList::empty(),
        target_directory_path_len: 0,
    }
}

pub machine ProjectItemsDuplicateRequest::default() -> ProjectItemsDuplicateRequest {
    ProjectItemsDuplicateRequest::new()
}

pub machine ProjectItemsDuplicateRequest::get_project_item_paths(this: &ProjectItemsDuplicateRequest) -> &ProjectPathList {
    &this.project_item_paths
}

pub machine ProjectItemsDuplicateRequest::set_project_item_paths(this: &mut ProjectItemsDuplicateRequest, project_item_paths: ProjectPathList) {
    this.project_item_paths = project_item_paths;
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectItemsDuplicateRequest::get_target_directory_path(this: &ProjectItemsDuplicateRequest) -> &[u8] {
    transition this.target_directory_path_len <= 512 {
        true -> (&this.target_directory_path[0..this.target_directory_path_len])
        false -> (&this.target_directory_path[0..512])
        _ -> (&this.target_directory_path[0..512])
    }
}

pub machine ProjectItemsDuplicateRequest::set_target_directory_path(this: &mut ProjectItemsDuplicateRequest, target_directory_path: &[u8]) {
    this.target_directory_path_len = 0;
    transition {
        _ -> copy_target_directory_path(this, target_directory_path, 0)
    }
    state copy_target_directory_path(this: &mut ProjectItemsDuplicateRequest, target_directory_path: &[u8], position: u64) {
        transition position < target_directory_path.len && position < 512 {
            true -> store_target_directory_path(this, target_directory_path, position)
            false -> finish_target_directory_path(this, position)
        }
    }
    state store_target_directory_path(this: &mut ProjectItemsDuplicateRequest, target_directory_path: &[u8], position: u64) {
        this.target_directory_path[position] = target_directory_path[position];
        transition {
            _ -> copy_target_directory_path(this, target_directory_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_target_directory_path(this: &mut ProjectItemsDuplicateRequest, count: u64) {
        this.target_directory_path_len = count;
    }
}
