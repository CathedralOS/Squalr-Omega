    success: bool;
    status_message: [u8; 512];
    status_message_len: u64;
    promoted_symbol_count: u64;
    reused_symbol_count: u64;
    promoted_symbol_locator_keys: ProjectStringList;
    conflicts: [ProjectItemsPromoteSymbolConflict; 32];
    conflict_count: u64;
}

pub machine ProjectItemsPromoteSymbolResponse::new() -> ProjectItemsPromoteSymbolResponse {
    ProjectItemsPromoteSymbolResponse {
        success: false,
        status_message_len: 0,
        promoted_symbol_count: 0,
        reused_symbol_count: 0,
        promoted_symbol_locator_keys: ProjectStringList::empty(),
        conflict_count: 0,
    }
}

pub machine ProjectItemsPromoteSymbolResponse::default() -> ProjectItemsPromoteSymbolResponse {
    ProjectItemsPromoteSymbolResponse::new()
}

pub machine ProjectItemsPromoteSymbolResponse::get_success(project_items_promote_symbol_response: &ProjectItemsPromoteSymbolResponse) -> bool {
    project_items_promote_symbol_response.success
}

pub machine ProjectItemsPromoteSymbolResponse::set_success(project_items_promote_symbol_response: &mut ProjectItemsPromoteSymbolResponse, success: bool) {
    project_items_promote_symbol_response.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectItemsPromoteSymbolResponse::get_status_message(project_items_promote_symbol_response: &ProjectItemsPromoteSymbolResponse) -> &[u8] {
    transition project_items_promote_symbol_response.status_message_len <= 512 {
        true -> (&project_items_promote_symbol_response.status_message[0..project_items_promote_symbol_response.status_message_len])
        false -> (&project_items_promote_symbol_response.status_message[0..512])
        _ -> (&project_items_promote_symbol_response.status_message[0..512])
    }
}

pub machine ProjectItemsPromoteSymbolResponse::set_status_message(project_items_promote_symbol_response: &mut ProjectItemsPromoteSymbolResponse, status_message: &[u8]) {
    project_items_promote_symbol_response.status_message_len = 0;
    transition {
        _ -> copy_status_message(project_items_promote_symbol_response, status_message, 0)
    }
    state copy_status_message(project_items_promote_symbol_response: &mut ProjectItemsPromoteSymbolResponse, status_message: &[u8], position: u64) {
        transition position < status_message.len && position < 512 {
            true -> store_status_message(project_items_promote_symbol_response, status_message, position)
            false -> finish_status_message(project_items_promote_symbol_response, position)
        }
    }
    state store_status_message(project_items_promote_symbol_response: &mut ProjectItemsPromoteSymbolResponse, status_message: &[u8], position: u64) {
        project_items_promote_symbol_response.status_message[position] = status_message[position];
        transition {
            _ -> copy_status_message(project_items_promote_symbol_response, status_message, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_status_message(project_items_promote_symbol_response: &mut ProjectItemsPromoteSymbolResponse, count: u64) {
        project_items_promote_symbol_response.status_message_len = count;
    }
}

