module src::commands::project_items::promote_symbol::project_items_promote_symbol_response;

use src::structures::projects::project_string_list::ProjectStringList;
// Port of commands/project_items/promote_symbol/project_items_promote_symbol_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
// Upstream `ProjectItemsPromoteSymbolConflict` — one colliding item.
pub data ProjectItemsPromoteSymbolConflict {
    project_item_path: [u8; 512];
    project_item_path_len: u64;
    symbol_locator_key: [u8; 256];
    symbol_locator_key_len: u64;
    existing_display_name: [u8; 256];
    existing_display_name_len: u64;
    existing_locator_display: [u8; 256];
    existing_locator_display_len: u64;
    requested_display_name: [u8; 256];
    requested_display_name_len: u64;
}

pub machine ProjectItemsPromoteSymbolConflict::new() -> ProjectItemsPromoteSymbolConflict {
    ProjectItemsPromoteSymbolConflict {
        project_item_path_len: 0,
        symbol_locator_key_len: 0,
        existing_display_name_len: 0,
        existing_locator_display_len: 0,
        requested_display_name_len: 0,
    }
}

pub machine ProjectItemsPromoteSymbolConflict::default() -> ProjectItemsPromoteSymbolConflict {
    ProjectItemsPromoteSymbolConflict::new()
}

pub machine ProjectItemsPromoteSymbolConflict::get_project_item_path(&self) -> &[u8] {
    transition self.project_item_path_len <= 512 {
        true -> (&self.project_item_path[0..self.project_item_path_len])
        false -> (&self.project_item_path[0..512])
        _ -> (&self.project_item_path[0..512])
    }
}

pub machine ProjectItemsPromoteSymbolConflict::get_symbol_locator_key(&self) -> &[u8] {
    transition self.symbol_locator_key_len <= 256 {
        true -> (&self.symbol_locator_key[0..self.symbol_locator_key_len])
        false -> (&self.symbol_locator_key[0..256])
        _ -> (&self.symbol_locator_key[0..256])
    }
}

pub machine ProjectItemsPromoteSymbolConflict::get_existing_display_name(&self) -> &[u8] {
    transition self.existing_display_name_len <= 256 {
        true -> (&self.existing_display_name[0..self.existing_display_name_len])
        false -> (&self.existing_display_name[0..256])
        _ -> (&self.existing_display_name[0..256])
    }
}

pub machine ProjectItemsPromoteSymbolConflict::get_existing_locator_display(&self) -> &[u8] {
    transition self.existing_locator_display_len <= 256 {
        true -> (&self.existing_locator_display[0..self.existing_locator_display_len])
        false -> (&self.existing_locator_display[0..256])
        _ -> (&self.existing_locator_display[0..256])
    }
}

pub machine ProjectItemsPromoteSymbolConflict::get_requested_display_name(&self) -> &[u8] {
    transition self.requested_display_name_len <= 256 {
        true -> (&self.requested_display_name[0..self.requested_display_name_len])
        false -> (&self.requested_display_name[0..256])
        _ -> (&self.requested_display_name[0..256])
    }
}

pub data ProjectItemsPromoteSymbolResponse {
    success: bool;
    status_message: [u8; 512];
    status_message_len: u64;
    promoted_symbol_count: u64;
    reused_symbol_count: u64;
    promoted_symbol_locator_keys: ProjectStringList;
    conflicts: [ProjectItemsPromoteSymbolConflict; 32];
    conflict_count: u64;
}

pub machine ProjectItemsPromoteSymbolResponse::new() -> ProjectItemsPromoteSymbolResponse {
    ProjectItemsPromoteSymbolResponse {
        success: false,
        status_message_len: 0,
        promoted_symbol_count: 0,
        reused_symbol_count: 0,
        promoted_symbol_locator_keys: ProjectStringList::empty(),
        conflict_count: 0,
    }
}

pub machine ProjectItemsPromoteSymbolResponse::default() -> ProjectItemsPromoteSymbolResponse {
    ProjectItemsPromoteSymbolResponse::new()
}

pub machine ProjectItemsPromoteSymbolResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectItemsPromoteSymbolResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectItemsPromoteSymbolResponse::get_status_message(&self) -> &[u8] {
    transition self.status_message_len <= 512 {
        true -> (&self.status_message[0..self.status_message_len])
        false -> (&self.status_message[0..512])
        _ -> (&self.status_message[0..512])
    }
}

pub machine ProjectItemsPromoteSymbolResponse::set_status_message(&mut self, status_message: &[u8]) {
    self.status_message_len = 0;
    transition {
        _ -> copy_status_message(status_message, 0)
    }
    state copy_status_message(&mut self, status_message: &[u8], position: u64) {
        transition position < status_message.len && position < 512 {
            true -> store_status_message(status_message, position)
            false -> finish_status_message(position)
        }
    }
    state store_status_message(&mut self, status_message: &[u8], position: u64) {
        self.status_message[position] = status_message[position];
        transition {
            _ -> copy_status_message(status_message, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_status_message(&mut self, count: u64) {
        self.status_message_len = count;
    }
}

pub machine ProjectItemsPromoteSymbolResponse::get_promoted_symbol_count(&self) -> u64 {
    self.promoted_symbol_count
}

pub machine ProjectItemsPromoteSymbolResponse::set_promoted_symbol_count(&mut self, promoted_symbol_count: u64) {
    self.promoted_symbol_count = promoted_symbol_count;
}

pub machine ProjectItemsPromoteSymbolResponse::get_reused_symbol_count(&self) -> u64 {
