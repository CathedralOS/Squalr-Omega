module src::commands::project_items::promote_symbol::project_items_promote_symbol_response;

use src::structures::projects::project_string_list::ProjectStringList;
// Port of commands/project_items/promote_symbol/project_items_promote_symbol_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
// Upstream `ProjectItemsPromoteSymbolConflict` — one colliding item.
pub data ProjectItemsPromoteSymbolConflict {
    project_item_path: [u8; 512];
    project_item_path_len: u64;
    symbol_locator_key: [u8; 256];
    symbol_locator_key_len: u64;
    existing_display_name: [u8; 256];
    existing_display_name_len: u64;
    existing_locator_display: [u8; 256];
    existing_locator_display_len: u64;
    requested_display_name: [u8; 256];
    requested_display_name_len: u64;
}

pub machine ProjectItemsPromoteSymbolConflict::new() -> ProjectItemsPromoteSymbolConflict {
    ProjectItemsPromoteSymbolConflict {
        project_item_path_len: 0,
        symbol_locator_key_len: 0,
        existing_display_name_len: 0,
        existing_locator_display_len: 0,
        requested_display_name_len: 0,
    }
}

pub machine ProjectItemsPromoteSymbolConflict::default() -> ProjectItemsPromoteSymbolConflict {
    ProjectItemsPromoteSymbolConflict::new()
}

// Filled constructor — upstream's fields are pub, so callers build the
// record inline; the port keeps fields private and names the fill.
pub machine ProjectItemsPromoteSymbolConflict::new_with(
    project_item_path: &[u8],
    symbol_locator_key: &[u8],
    existing_display_name: &[u8],
    existing_locator_display: &[u8],
    requested_display_name: &[u8]
) -> ProjectItemsPromoteSymbolConflict {
    let mut conflict: ProjectItemsPromoteSymbolConflict = ProjectItemsPromoteSymbolConflict::new();
    conflict.project_item_path_len = copy_bounded_512(&mut conflict.project_item_path, project_item_path);
    conflict.symbol_locator_key_len = copy_bounded_256(&mut conflict.symbol_locator_key, symbol_locator_key);
    conflict.existing_display_name_len = copy_bounded_256(&mut conflict.existing_display_name, existing_display_name);
    conflict.existing_locator_display_len = copy_bounded_256(&mut conflict.existing_locator_display, existing_locator_display);
    conflict.requested_display_name_len = copy_bounded_256(&mut conflict.requested_display_name, requested_display_name);
    (conflict)
}

pub machine ProjectItemsPromoteSymbolConflict::clone(project_items_promote_symbol_conflict: &ProjectItemsPromoteSymbolConflict) -> ProjectItemsPromoteSymbolConflict {
    (ProjectItemsPromoteSymbolConflict::new_with(
        ProjectItemsPromoteSymbolConflict::get_project_item_path(project_items_promote_symbol_conflict),
        ProjectItemsPromoteSymbolConflict::get_symbol_locator_key(project_items_promote_symbol_conflict),
        ProjectItemsPromoteSymbolConflict::get_existing_display_name(project_items_promote_symbol_conflict),
        ProjectItemsPromoteSymbolConflict::get_existing_locator_display(project_items_promote_symbol_conflict),
        ProjectItemsPromoteSymbolConflict::get_requested_display_name(project_items_promote_symbol_conflict)))
}

// Truncate-copy a byte string into the fixed carrier; returns the stored
// length (source length clamped to the carrier bound — upstream's String
// copy cannot overflow, the bounded carrier documents the clamp).
machine copy_bounded_512(out: &mut [u8; 512], source: &[u8]) -> u64 {
    transition source.len <= 512 {
        true -> copy(out, source, source.len, 0)
        _ -> copy(out, source, 512, 0)
    }
    state copy(out: &mut [u8; 512], source: &[u8], stored_len: u64, position: u64) -> u64 {
        transition position < stored_len && position < 512 && position < source.len {
            true -> byte(out, source, stored_len, position)
            _ -> (stored_len)
        }
    }
    state byte(out: &mut [u8; 512], source: &[u8], stored_len: u64, position: u64) -> u64
        requires position < stored_len && position < 512 && position < source.len;
    {
        out[position] = source[position];
        transition { _ -> copy(out, source, stored_len, position + 1) }
    }
}

machine copy_bounded_256(out: &mut [u8; 256], source: &[u8]) -> u64 {
    transition source.len <= 256 {
        true -> copy(out, source, source.len, 0)
        _ -> copy(out, source, 256, 0)
    }
    state copy(out: &mut [u8; 256], source: &[u8], stored_len: u64, position: u64) -> u64 {
        transition position < stored_len && position < 256 && position < source.len {
            true -> byte(out, source, stored_len, position)
            _ -> (stored_len)
        }
    }
    state byte(out: &mut [u8; 256], source: &[u8], stored_len: u64, position: u64) -> u64
        requires position < stored_len && position < 256 && position < source.len;
    {
        out[position] = source[position];
        transition { _ -> copy(out, source, stored_len, position + 1) }
    }
}

pub machine ProjectItemsPromoteSymbolConflict::get_project_item_path(project_items_promote_symbol_conflict: &ProjectItemsPromoteSymbolConflict) -> &[u8] {
    transition project_items_promote_symbol_conflict.project_item_path_len <= 512 {
        true -> (&project_items_promote_symbol_conflict.project_item_path[0..project_items_promote_symbol_conflict.project_item_path_len])
        false -> (&project_items_promote_symbol_conflict.project_item_path[0..512])
        _ -> (&project_items_promote_symbol_conflict.project_item_path[0..512])
    }
}

