pub machine ProjectItemsPromoteSymbolResponse::get_success(this: &ProjectItemsPromoteSymbolResponse) -> bool {
    this.success
}

pub machine ProjectItemsPromoteSymbolResponse::set_success(this: &mut ProjectItemsPromoteSymbolResponse, success: bool) {
    this.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectItemsPromoteSymbolResponse::get_status_message(this: &ProjectItemsPromoteSymbolResponse) -> &[u8] {
    transition this.status_message_len <= 512 {
        true -> (&this.status_message[0..this.status_message_len])
        false -> (&this.status_message[0..512])
        _ -> (&this.status_message[0..512])
    }
}

pub machine ProjectItemsPromoteSymbolResponse::set_status_message(this: &mut ProjectItemsPromoteSymbolResponse, status_message: &[u8]) {
    this.status_message_len = 0;
    transition {
        _ -> copy_status_message(this, status_message, 0)
    }
    state copy_status_message(this: &mut ProjectItemsPromoteSymbolResponse, status_message: &[u8], position: u64) {
        transition position < status_message.len && position < 512 {
            true -> store_status_message(this, status_message, position)
            false -> finish_status_message(this, position)
        }
    }
    state store_status_message(this: &mut ProjectItemsPromoteSymbolResponse, status_message: &[u8], position: u64) {
        this.status_message[position] = status_message[position];
        transition {
            _ -> copy_status_message(this, status_message, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_status_message(this: &mut ProjectItemsPromoteSymbolResponse, count: u64) {
        this.status_message_len = count;
    }
}

