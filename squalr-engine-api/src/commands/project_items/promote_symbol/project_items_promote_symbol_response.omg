// Upstream `Vec<ProjectItemsPromoteSymbolConflict>` -> bounded [ProjectItemsPromoteSymbolConflict; 32] + live count; `add_conflict`
// refuses past the bound rather than truncating.
pub machine ProjectItemsPromoteSymbolResponse::get_conflict_count(project_items_promote_symbol_response: &ProjectItemsPromoteSymbolResponse) -> u64 {
    project_items_promote_symbol_response.conflict_count
}

// Guarded element access — callers gate on get_conflict_count.
pub machine ProjectItemsPromoteSymbolResponse::get_conflict(project_items_promote_symbol_response: &ProjectItemsPromoteSymbolResponse, index: u64) -> &ProjectItemsPromoteSymbolConflict
    requires 0 <= index && index < 32
{
    &project_items_promote_symbol_response.conflicts[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectItemsPromoteSymbolResponse::add_conflict(project_items_promote_symbol_response: &mut ProjectItemsPromoteSymbolResponse, conflict: ProjectItemsPromoteSymbolConflict) -> bool {
    transition project_items_promote_symbol_response.conflict_count < 32 {
        true -> store_conflict(project_items_promote_symbol_response, conflict)
        false -> (false)
        _ -> (false)
    }
    state store_conflict(project_items_promote_symbol_response: &mut ProjectItemsPromoteSymbolResponse, conflict: ProjectItemsPromoteSymbolConflict) -> bool {
        let index: u64 = project_items_promote_symbol_response.conflict_count;
        transition index < 32 {
            true -> fill_conflict(project_items_promote_symbol_response, conflict, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_conflict(project_items_promote_symbol_response: &mut ProjectItemsPromoteSymbolResponse, conflict: ProjectItemsPromoteSymbolConflict, index: u64) -> bool
        requires 0 <= index && index < 32
    {
        project_items_promote_symbol_response.conflicts[index] = conflict;
        project_items_promote_symbol_response.conflict_count = index + 1;
        (true)
    }
}
