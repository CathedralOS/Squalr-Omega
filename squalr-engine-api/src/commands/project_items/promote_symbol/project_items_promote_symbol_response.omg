}

pub machine ProjectItemsPromoteSymbolResponse::set_promoted_symbol_locator_keys(&mut self, promoted_symbol_locator_keys: ProjectStringList) {
    self.promoted_symbol_locator_keys = promoted_symbol_locator_keys;
}

// Upstream `Vec<ProjectItemsPromoteSymbolConflict>` -> bounded [ProjectItemsPromoteSymbolConflict; 32] + live count; `add_conflict`
// refuses past the bound rather than truncating.
pub machine ProjectItemsPromoteSymbolResponse::get_conflict_count(&self) -> u64 {
    self.conflict_count
}

// Guarded element access — callers gate on get_conflict_count.
pub machine ProjectItemsPromoteSymbolResponse::get_conflict(&self, index: u64) -> &ProjectItemsPromoteSymbolConflict
    requires 0 <= index && index < 32
{
    &self.conflicts[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectItemsPromoteSymbolResponse::add_conflict(&mut self, conflict: ProjectItemsPromoteSymbolConflict) -> bool {
    transition self.conflict_count < 32 {
        true -> store_conflict(conflict)
        false -> (false)
        _ -> (false)
    }
    state store_conflict(&mut self, conflict: ProjectItemsPromoteSymbolConflict) -> bool {
        let index: u64 = self.conflict_count;
        transition index < 32 {
            true -> fill_conflict(conflict, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_conflict(&mut self, conflict: ProjectItemsPromoteSymbolConflict, index: u64) -> bool
        requires 0 <= index && index < 32
    {
        self.conflicts[index] = conflict;
        self.conflict_count = index + 1;
        (true)
    }
}
