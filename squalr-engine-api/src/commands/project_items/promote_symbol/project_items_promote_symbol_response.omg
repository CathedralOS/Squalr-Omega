// Upstream `Vec<ProjectItemsPromoteSymbolConflict>` -> bounded [ProjectItemsPromoteSymbolConflict; 32] + live count; `add_conflict`
// refuses past the bound rather than truncating.
pub machine ProjectItemsPromoteSymbolResponse::get_conflict_count(this: &ProjectItemsPromoteSymbolResponse) -> u64 {
    this.conflict_count
}

// Guarded element access — callers gate on get_conflict_count.
pub machine ProjectItemsPromoteSymbolResponse::get_conflict(this: &ProjectItemsPromoteSymbolResponse, index: u64) -> &ProjectItemsPromoteSymbolConflict
    requires 0 <= index && index < 32
{
    &this.conflicts[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectItemsPromoteSymbolResponse::add_conflict(this: &mut ProjectItemsPromoteSymbolResponse, conflict: ProjectItemsPromoteSymbolConflict) -> bool {
    transition this.conflict_count < 32 {
        true -> store_conflict(this, conflict)
        false -> (false)
        _ -> (false)
    }
    state store_conflict(this: &mut ProjectItemsPromoteSymbolResponse, conflict: ProjectItemsPromoteSymbolConflict) -> bool {
        let index: u64 = this.conflict_count;
        transition index < 32 {
            true -> fill_conflict(this, conflict, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_conflict(this: &mut ProjectItemsPromoteSymbolResponse, conflict: ProjectItemsPromoteSymbolConflict, index: u64) -> bool
        requires 0 <= index && index < 32
    {
        this.conflicts[index] = conflict;
        this.conflict_count = index + 1;
        (true)
    }
}
