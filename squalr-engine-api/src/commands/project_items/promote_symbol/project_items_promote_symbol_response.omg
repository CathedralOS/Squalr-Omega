}

pub machine ProjectItemsPromoteSymbolResponse::set_reused_symbol_count(&mut self, reused_symbol_count: u64) {
    self.reused_symbol_count = reused_symbol_count;
}

pub machine ProjectItemsPromoteSymbolResponse::get_promoted_symbol_locator_keys(&self) -> &ProjectStringList {
