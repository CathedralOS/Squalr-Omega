// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsActivateRequest {
    project_item_paths: ProjectStringList;
    is_activated: bool;
}

pub machine ProjectItemsActivateRequest::new() -> ProjectItemsActivateRequest {
    ProjectItemsActivateRequest {
        project_item_paths: ProjectStringList::empty(),
        is_activated: false,
    }
}

pub machine ProjectItemsActivateRequest::default() -> ProjectItemsActivateRequest {
