use src/structures/projects/project_string_list.omg;
// Port of commands/project_items/activate/project_items_activate_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
public data ProjectItemsActivateRequest {
    project_item_paths: |project_string_list|::ProjectStringList;
    is_activated: bool;
}

public machine ProjectItemsActivateRequest::new() -> ProjectItemsActivateRequest {
    ProjectItemsActivateRequest {
        project_item_paths: |project_string_list|::ProjectStringList::empty(),
        is_activated: false,
    }
}

public machine ProjectItemsActivateRequest::default() -> ProjectItemsActivateRequest {
    ProjectItemsActivateRequest::new()
}

public machine ProjectItemsActivateRequest::get_project_item_paths(this: &ProjectItemsActivateRequest) -> &|project_string_list|::ProjectStringList {
    &this.project_item_paths
}

public machine ProjectItemsActivateRequest::set_project_item_paths(this: &mut ProjectItemsActivateRequest, project_item_paths: |project_string_list|::ProjectStringList) {
    this.project_item_paths = project_item_paths;
}

public machine ProjectItemsActivateRequest::get_is_activated(this: &ProjectItemsActivateRequest) -> bool {
    this.is_activated
}

public machine ProjectItemsActivateRequest::set_is_activated(this: &mut ProjectItemsActivateRequest, is_activated: bool) {
    this.is_activated = is_activated;
}
