// Guarded element access — callers gate on get_pointer_offset_count.
pub machine ProjectItemsCreateRequest::get_pointer_offset(project_items_create_request: &ProjectItemsCreateRequest, index: u64) -> &SymbolicPointerChainLink
    requires 0 <= index && index < 16
{
    &project_items_create_request.pointer_offsets[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectItemsCreateRequest::add_pointer_offset(project_items_create_request: &mut ProjectItemsCreateRequest, pointer_offset: SymbolicPointerChainLink) -> bool {
    transition project_items_create_request.pointer_offset_count < 16 {
        true -> store_pointer_offset(project_items_create_request, pointer_offset)
        false -> (false)
        _ -> (false)
    }
    state store_pointer_offset(project_items_create_request: &mut ProjectItemsCreateRequest, pointer_offset: SymbolicPointerChainLink) -> bool {
        let index: u64 = project_items_create_request.pointer_offset_count;
        transition index < 16 {
            true -> fill_pointer_offset(project_items_create_request, pointer_offset, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_pointer_offset(project_items_create_request: &mut ProjectItemsCreateRequest, pointer_offset: SymbolicPointerChainLink, index: u64) -> bool
        requires 0 <= index && index < 16
    {
        project_items_create_request.pointer_offsets[index] = pointer_offset;
        project_items_create_request.pointer_offset_count = index + 1;
        (true)
    }
}

