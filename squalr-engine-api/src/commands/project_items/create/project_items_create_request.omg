// Guarded element access — callers gate on get_pointer_offset_count.
pub machine ProjectItemsCreateRequest::get_pointer_offset(&self, index: u64) -> &SymbolicPointerChainLink
    requires 0 <= index && index < 16
{
    &self.pointer_offsets[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectItemsCreateRequest::add_pointer_offset(&mut self, pointer_offset: SymbolicPointerChainLink) -> bool {
    transition self.pointer_offset_count < 16 {
        true -> store_pointer_offset(pointer_offset)
        false -> (false)
        _ -> (false)
    }
    state store_pointer_offset(&mut self, pointer_offset: SymbolicPointerChainLink) -> bool {
        let index: u64 = self.pointer_offset_count;
        transition index < 16 {
            true -> fill_pointer_offset(pointer_offset, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_pointer_offset(&mut self, pointer_offset: SymbolicPointerChainLink, index: u64) -> bool
        requires 0 <= index && index < 16
    {
        self.pointer_offsets[index] = pointer_offset;
        self.pointer_offset_count = index + 1;
        (true)
    }
}

