}

pub machine ProjectItemsCreateRequest::set_parent_directory_path(&mut self, parent_directory_path: &[u8]) {
    self.parent_directory_path_len = 0;
    transition {
        _ -> copy_parent_directory_path(parent_directory_path, 0)
    }
    state copy_parent_directory_path(&mut self, parent_directory_path: &[u8], position: u64) {
        transition position < parent_directory_path.len && position < 512 {
            true -> store_parent_directory_path(parent_directory_path, position)
            false -> finish_parent_directory_path(position)
        }
    }
    state store_parent_directory_path(&mut self, parent_directory_path: &[u8], position: u64) {
        self.parent_directory_path[position] = parent_directory_path[position];
        transition {
            _ -> copy_parent_directory_path(parent_directory_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_parent_directory_path(&mut self, count: u64) {
        self.parent_directory_path_len = count;
    }
}

