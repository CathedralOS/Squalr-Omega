    state copy_parent_directory_path(project_items_create_request: &mut ProjectItemsCreateRequest, parent_directory_path: &[u8], position: u64) {
        transition position < parent_directory_path.len && position < 512 {
            true -> store_parent_directory_path(project_items_create_request, parent_directory_path, position)
            false -> finish_parent_directory_path(project_items_create_request, position)
        }
    }
    state store_parent_directory_path(project_items_create_request: &mut ProjectItemsCreateRequest, parent_directory_path: &[u8], position: u64) {
        project_items_create_request.parent_directory_path[position] = parent_directory_path[position];
        transition {
            _ -> copy_parent_directory_path(project_items_create_request, parent_directory_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_parent_directory_path(project_items_create_request: &mut ProjectItemsCreateRequest, count: u64) {
