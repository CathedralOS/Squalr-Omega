        _ -> (false)
    }
    state store_pointer_offset(this: &mut ProjectItemsCreateRequest, pointer_offset: SymbolicPointerChainLink) -> bool {
        let index: u64 = this.pointer_offset_count;
        transition index < 16 {
            true -> fill_pointer_offset(this, pointer_offset, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_pointer_offset(this: &mut ProjectItemsCreateRequest, pointer_offset: SymbolicPointerChainLink, index: u64) -> bool
        requires 0 <= index && index < 16
    {
        this.pointer_offsets[index] = pointer_offset;
        this.pointer_offset_count = index + 1;
        (true)
    }
}

