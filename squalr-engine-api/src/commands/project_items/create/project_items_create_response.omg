module src::commands::project_items::create::project_items_create_response;

// Port of commands/project_items/create/project_items_create_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsCreateResponse {
    success: bool;
    created_project_item_path: [u8; 512];
    created_project_item_path_len: u64;
}

pub machine ProjectItemsCreateResponse::new() -> ProjectItemsCreateResponse {
    ProjectItemsCreateResponse {
        success: false,
        created_project_item_path_len: 0,
    }
}

pub machine ProjectItemsCreateResponse::default() -> ProjectItemsCreateResponse {
    ProjectItemsCreateResponse::new()
}

pub machine ProjectItemsCreateResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectItemsCreateResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectItemsCreateResponse::get_created_project_item_path(&self) -> &[u8] {
    transition self.created_project_item_path_len <= 512 {
        true -> (&self.created_project_item_path[0..self.created_project_item_path_len])
        false -> (&self.created_project_item_path[0..512])
        _ -> (&self.created_project_item_path[0..512])
    }
}

pub machine ProjectItemsCreateResponse::set_created_project_item_path(&mut self, created_project_item_path: &[u8]) {
    self.created_project_item_path_len = 0;
    transition {
        _ -> copy_created_project_item_path(created_project_item_path, 0)
    }
    state copy_created_project_item_path(&mut self, created_project_item_path: &[u8], position: u64) {
        transition position < created_project_item_path.len && position < 512 {
            true -> store_created_project_item_path(created_project_item_path, position)
            false -> finish_created_project_item_path(position)
        }
    }
    state store_created_project_item_path(&mut self, created_project_item_path: &[u8], position: u64) {
        self.created_project_item_path[position] = created_project_item_path[position];
        transition {
            _ -> copy_created_project_item_path(created_project_item_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_created_project_item_path(&mut self, count: u64) {
        self.created_project_item_path_len = count;
    }
}
