module src::commands::project_items::rename::project_items_rename_response;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project_items/rename/project_items_rename_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsRenameResponse {
    success: bool;
    renamed_project_item_path: [u8; 512];
    renamed_project_item_path_len: u64;
}

pub machine ProjectItemsRenameResponse::new() -> ProjectItemsRenameResponse {
    ProjectItemsRenameResponse {
        success: false,
        renamed_project_item_path_len: 0,
    }
}

pub machine ProjectItemsRenameResponse::default() -> ProjectItemsRenameResponse {
    ProjectItemsRenameResponse::new()
}

pub machine ProjectItemsRenameResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectItemsRenameResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectItemsRenameResponse::get_renamed_project_item_path(&self) -> &[u8] {
    transition self.renamed_project_item_path_len <= 512 {
        true -> (&self.renamed_project_item_path[0..self.renamed_project_item_path_len])
        false -> (&self.renamed_project_item_path[0..512])
        _ -> (&self.renamed_project_item_path[0..512])
    }
}

pub machine ProjectItemsRenameResponse::set_renamed_project_item_path(&mut self, renamed_project_item_path: &[u8]) {
    self.renamed_project_item_path_len = BoundedByteCopy::copy(&mut self.renamed_project_item_path[0..512], renamed_project_item_path);
}
