module src::commands::project_items::rename::project_items_rename_request;

use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

// Port of commands/project_items/rename/project_items_rename_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsRenameRequest {
    project_item_path: [u8; 512];
    project_item_path_len: u64;
    project_item_name: [u8; 256];
    project_item_name_len: u64;
}

pub machine ProjectItemsRenameRequest::new() -> ProjectItemsRenameRequest {
    ProjectItemsRenameRequest {
        project_item_path_len: 0,
        project_item_name_len: 0,
    }
}

pub machine ProjectItemsRenameRequest::default() -> ProjectItemsRenameRequest {
    ProjectItemsRenameRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectItemsRenameRequest::get_project_item_path(&self) -> &[u8] {
    bounded_slice(&self.project_item_path[0..512], self.project_item_path_len)
}

pub machine ProjectItemsRenameRequest::set_project_item_path(&mut self, project_item_path: &[u8]) {
    self.project_item_path_len = BoundedByteCopy::copy(&mut self.project_item_path[0..512], project_item_path);
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectItemsRenameRequest::get_project_item_name(&self) -> &[u8] {
    bounded_slice(&self.project_item_name[0..256], self.project_item_name_len)
}

pub machine ProjectItemsRenameRequest::set_project_item_name(&mut self, project_item_name: &[u8]) {
    self.project_item_name_len = BoundedByteCopy::copy(&mut self.project_item_name[0..256], project_item_name);
}
