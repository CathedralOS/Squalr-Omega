module src::commands::project_items::rename::project_items_rename_request;

// Port of commands/project_items/rename/project_items_rename_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsRenameRequest {
    project_item_path: [u8; 512];
    project_item_path_len: u64;
    project_item_name: [u8; 256];
    project_item_name_len: u64;
}

pub machine ProjectItemsRenameRequest::new() -> ProjectItemsRenameRequest {
    ProjectItemsRenameRequest {
        project_item_path_len: 0,
        project_item_name_len: 0,
    }
}

pub machine ProjectItemsRenameRequest::default() -> ProjectItemsRenameRequest {
    ProjectItemsRenameRequest::new()
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectItemsRenameRequest::get_project_item_path(project_items_rename_request: &ProjectItemsRenameRequest) -> &[u8] {
    transition project_items_rename_request.project_item_path_len <= 512 {
        true -> (&project_items_rename_request.project_item_path[0..project_items_rename_request.project_item_path_len])
        false -> (&project_items_rename_request.project_item_path[0..512])
        _ -> (&project_items_rename_request.project_item_path[0..512])
    }
}

pub machine ProjectItemsRenameRequest::set_project_item_path(project_items_rename_request: &mut ProjectItemsRenameRequest, project_item_path: &[u8]) {
    project_items_rename_request.project_item_path_len = 0;
    transition {
        _ -> copy_project_item_path(project_items_rename_request, project_item_path, 0)
    }
    state copy_project_item_path(project_items_rename_request: &mut ProjectItemsRenameRequest, project_item_path: &[u8], position: u64) {
        transition position < project_item_path.len && position < 512 {
            true -> store_project_item_path(project_items_rename_request, project_item_path, position)
            false -> finish_project_item_path(project_items_rename_request, position)
        }
    }
    state store_project_item_path(project_items_rename_request: &mut ProjectItemsRenameRequest, project_item_path: &[u8], position: u64) {
        project_items_rename_request.project_item_path[position] = project_item_path[position];
        transition {
            _ -> copy_project_item_path(project_items_rename_request, project_item_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_item_path(project_items_rename_request: &mut ProjectItemsRenameRequest, count: u64) {
        project_items_rename_request.project_item_path_len = count;
    }
}

// Bounded UTF-8 carrier for the upstream string field (256 cap).
pub machine ProjectItemsRenameRequest::get_project_item_name(project_items_rename_request: &ProjectItemsRenameRequest) -> &[u8] {
    transition project_items_rename_request.project_item_name_len <= 256 {
        true -> (&project_items_rename_request.project_item_name[0..project_items_rename_request.project_item_name_len])
        false -> (&project_items_rename_request.project_item_name[0..256])
        _ -> (&project_items_rename_request.project_item_name[0..256])
    }
}

pub machine ProjectItemsRenameRequest::set_project_item_name(project_items_rename_request: &mut ProjectItemsRenameRequest, project_item_name: &[u8]) {
    project_items_rename_request.project_item_name_len = 0;
    transition {
        _ -> copy_project_item_name(project_items_rename_request, project_item_name, 0)
    }
    state copy_project_item_name(project_items_rename_request: &mut ProjectItemsRenameRequest, project_item_name: &[u8], position: u64) {
        transition position < project_item_name.len && position < 256 {
            true -> store_project_item_name(project_items_rename_request, project_item_name, position)
            false -> finish_project_item_name(project_items_rename_request, position)
        }
    }
    state store_project_item_name(project_items_rename_request: &mut ProjectItemsRenameRequest, project_item_name: &[u8], position: u64) {
        project_items_rename_request.project_item_name[position] = project_item_name[position];
        transition {
            _ -> copy_project_item_name(project_items_rename_request, project_item_name, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_project_item_name(project_items_rename_request: &mut ProjectItemsRenameRequest, count: u64) {
        project_items_rename_request.project_item_name_len = count;
    }
}
