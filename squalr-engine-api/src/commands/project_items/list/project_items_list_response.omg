module src::commands::project_items::list::project_items_list_response;

use src::structures::projects::project_info::ProjectInfo;
use src::structures::projects::project_items::project_item::ProjectItem;
use src::structures::projects::project_items::project_item_pair::ProjectItemPair;
// Port of commands/project_items/list/project_items_list_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsListResponse {
    has_opened_project_info: bool;
    opened_project_info: ProjectInfo;
    has_opened_project_root: bool;
    opened_project_root: ProjectItem;
    opened_project_items: [ProjectItemPair; 64];
    opened_project_item_count: u64;
}

pub machine ProjectItemsListResponse::new() -> ProjectItemsListResponse {
    ProjectItemsListResponse {
        has_opened_project_info: false,
        opened_project_info: ProjectInfo::default(),
        has_opened_project_root: false,
        opened_project_root: ProjectItem::default(),
        opened_project_item_count: 0,
    }
}

pub machine ProjectItemsListResponse::default() -> ProjectItemsListResponse {
    ProjectItemsListResponse::new()
}

// Upstream `Option<ProjectInfo>` — flag pair.
pub machine ProjectItemsListResponse::has_opened_project_info(this: &ProjectItemsListResponse) -> bool {
    this.has_opened_project_info
}

pub machine ProjectItemsListResponse::get_opened_project_info(this: &ProjectItemsListResponse) -> &ProjectInfo {
    &this.opened_project_info
}

pub machine ProjectItemsListResponse::set_opened_project_info(this: &mut ProjectItemsListResponse, opened_project_info: ProjectInfo) {
    this.opened_project_info = opened_project_info;
    this.has_opened_project_info = true;
}

pub machine ProjectItemsListResponse::clear_opened_project_info(this: &mut ProjectItemsListResponse) {
    this.has_opened_project_info = false;
}

// Upstream `Option<ProjectItem>` — flag pair.
pub machine ProjectItemsListResponse::has_opened_project_root(this: &ProjectItemsListResponse) -> bool {
    this.has_opened_project_root
}

pub machine ProjectItemsListResponse::get_opened_project_root(this: &ProjectItemsListResponse) -> &ProjectItem {
    &this.opened_project_root
}

pub machine ProjectItemsListResponse::set_opened_project_root(this: &mut ProjectItemsListResponse, opened_project_root: ProjectItem) {
    this.opened_project_root = opened_project_root;
    this.has_opened_project_root = true;
}

pub machine ProjectItemsListResponse::clear_opened_project_root(this: &mut ProjectItemsListResponse) {
    this.has_opened_project_root = false;
}

// Upstream `Vec<ProjectItemPair>` -> bounded [ProjectItemPair; 64] + live count; `add_opened_project_item`
// refuses past the bound rather than truncating.
pub machine ProjectItemsListResponse::get_opened_project_item_count(this: &ProjectItemsListResponse) -> u64 {
    this.opened_project_item_count
}

// Guarded element access — callers gate on get_opened_project_item_count.
pub machine ProjectItemsListResponse::get_opened_project_item(this: &ProjectItemsListResponse, index: u64) -> &ProjectItemPair
    requires 0 <= index && index < 64
{
    &this.opened_project_items[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectItemsListResponse::add_opened_project_item(this: &mut ProjectItemsListResponse, opened_project_item: ProjectItemPair) -> bool {
    transition this.opened_project_item_count < 64 {
        true -> store_opened_project_item(this, opened_project_item)
        false -> (false)
        _ -> (false)
    }
    state store_opened_project_item(this: &mut ProjectItemsListResponse, opened_project_item: ProjectItemPair) -> bool {
        let index: u64 = this.opened_project_item_count;
        transition index < 64 {
            true -> fill_opened_project_item(this, opened_project_item, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_opened_project_item(this: &mut ProjectItemsListResponse, opened_project_item: ProjectItemPair, index: u64) -> bool
        requires 0 <= index && index < 64
    {
        this.opened_project_items[index] = opened_project_item;
        this.opened_project_item_count = index + 1;
        (true)
    }
}
