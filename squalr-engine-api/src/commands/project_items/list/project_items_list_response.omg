use src/structures/projects/project_info.omg;
use src/structures/projects/project_items/project_item.omg;
use src/structures/projects/project_items/project_item_pair.omg;
// Port of commands/project_items/list/project_items_list_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
public data ProjectItemsListResponse {
    has_opened_project_info: bool;
    opened_project_info: |project_info|::ProjectInfo;
    has_opened_project_root: bool;
    opened_project_root: |project_item|::ProjectItem;
    opened_project_items: [|project_item_pair|::ProjectItemPair; 64];
    opened_project_item_count: u64;
}

public machine ProjectItemsListResponse::new() -> ProjectItemsListResponse {
    ProjectItemsListResponse {
        has_opened_project_info: false,
        opened_project_info: |project_info|::ProjectInfo::default(),
        has_opened_project_root: false,
        opened_project_root: |project_item|::ProjectItem::default(),
        opened_project_item_count: 0,
    }
}

public machine ProjectItemsListResponse::default() -> ProjectItemsListResponse {
    ProjectItemsListResponse::new()
}

// Upstream `Option<ProjectInfo>` — flag pair.
public machine ProjectItemsListResponse::has_opened_project_info(this: &ProjectItemsListResponse) -> bool {
    this.has_opened_project_info
}

public machine ProjectItemsListResponse::get_opened_project_info(this: &ProjectItemsListResponse) -> &|project_info|::ProjectInfo {
    &this.opened_project_info
}

public machine ProjectItemsListResponse::set_opened_project_info(this: &mut ProjectItemsListResponse, opened_project_info: |project_info|::ProjectInfo) {
    this.opened_project_info = opened_project_info;
    this.has_opened_project_info = true;
}

public machine ProjectItemsListResponse::clear_opened_project_info(this: &mut ProjectItemsListResponse) {
    this.has_opened_project_info = false;
}

// Upstream `Option<ProjectItem>` — flag pair.
public machine ProjectItemsListResponse::has_opened_project_root(this: &ProjectItemsListResponse) -> bool {
    this.has_opened_project_root
}

public machine ProjectItemsListResponse::get_opened_project_root(this: &ProjectItemsListResponse) -> &|project_item|::ProjectItem {
    &this.opened_project_root
}

public machine ProjectItemsListResponse::set_opened_project_root(this: &mut ProjectItemsListResponse, opened_project_root: |project_item|::ProjectItem) {
    this.opened_project_root = opened_project_root;
    this.has_opened_project_root = true;
}

public machine ProjectItemsListResponse::clear_opened_project_root(this: &mut ProjectItemsListResponse) {
    this.has_opened_project_root = false;
}

// Upstream `Vec<ProjectItemPair>` -> bounded [ProjectItemPair; 64] + live count; `add_opened_project_item`
// refuses past the bound rather than truncating.
public machine ProjectItemsListResponse::get_opened_project_item_count(this: &ProjectItemsListResponse) -> u64 {
    this.opened_project_item_count
}

// Guarded element access — callers gate on get_opened_project_item_count.
public machine ProjectItemsListResponse::get_opened_project_item(this: &ProjectItemsListResponse, index: u64) -> &|project_item_pair|::ProjectItemPair
    requires 0 <= index && index < 64
{
    &this.opened_project_items[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
public machine ProjectItemsListResponse::add_opened_project_item(this: &mut ProjectItemsListResponse, opened_project_item: |project_item_pair|::ProjectItemPair) -> bool {
    transition this.opened_project_item_count < 64 {
        true -> store_opened_project_item(this, opened_project_item)
        false -> (false)
        _ -> (false)
    }
    machine store_opened_project_item(this: &mut ProjectItemsListResponse, opened_project_item: |project_item_pair|::ProjectItemPair) -> bool {
        let index: u64 = this.opened_project_item_count;
        transition index < 64 {
            true -> fill_opened_project_item(this, opened_project_item, index)
            false -> (false)
            _ -> (false)
        }
    }
    machine fill_opened_project_item(this: &mut ProjectItemsListResponse, opened_project_item: |project_item_pair|::ProjectItemPair, index: u64) -> bool
        requires 0 <= index && index < 64
    {
        this.opened_project_items[index] = opened_project_item;
        this.opened_project_item_count = index + 1;
        (true)
    }
}
