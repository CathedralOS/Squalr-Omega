module src::commands::project_items::list::project_items_list_response;

use src::structures::projects::project_info::ProjectInfo;
use src::structures::projects::project_items::project_item::ProjectItem;
use src::structures::projects::project_items::project_item_pair::ProjectItemPair;
// Port of commands/project_items/list/project_items_list_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsListResponse {
    has_opened_project_info: bool;
    opened_project_info: ProjectInfo;
    has_opened_project_root: bool;
    opened_project_root: ProjectItem;
    opened_project_items: [ProjectItemPair; 64];
    opened_project_item_count: u64;
}

pub machine ProjectItemsListResponse::new() -> ProjectItemsListResponse {
    ProjectItemsListResponse {
        has_opened_project_info: false,
        opened_project_info: ProjectInfo::default(),
        has_opened_project_root: false,
        opened_project_root: ProjectItem::default(),
        opened_project_item_count: 0,
    }
}

pub machine ProjectItemsListResponse::default() -> ProjectItemsListResponse {
    ProjectItemsListResponse::new()
}

// Upstream `Option<ProjectInfo>` — flag pair.
pub machine ProjectItemsListResponse::has_opened_project_info(&self) -> bool {
    self.has_opened_project_info
}

pub machine ProjectItemsListResponse::get_opened_project_info(&self) -> &ProjectInfo {
    &self.opened_project_info
}

pub machine ProjectItemsListResponse::set_opened_project_info(&mut self, opened_project_info: ProjectInfo) {
    self.opened_project_info = opened_project_info;
    self.has_opened_project_info = true;
}

pub machine ProjectItemsListResponse::clear_opened_project_info(&mut self) {
    self.has_opened_project_info = false;
}

// Upstream `Option<ProjectItem>` — flag pair.
pub machine ProjectItemsListResponse::has_opened_project_root(&self) -> bool {
    self.has_opened_project_root
}

pub machine ProjectItemsListResponse::get_opened_project_root(&self) -> &ProjectItem {
    &self.opened_project_root
}

pub machine ProjectItemsListResponse::set_opened_project_root(&mut self, opened_project_root: ProjectItem) {
    self.opened_project_root = opened_project_root;
    self.has_opened_project_root = true;
}

pub machine ProjectItemsListResponse::clear_opened_project_root(&mut self) {
    self.has_opened_project_root = false;
}

// Upstream `Vec<ProjectItemPair>` -> bounded [ProjectItemPair; 64] + live count; `add_opened_project_item`
// refuses past the bound rather than truncating.
pub machine ProjectItemsListResponse::get_opened_project_item_count(&self) -> u64 {
    self.opened_project_item_count
}

// Guarded element access — callers gate on get_opened_project_item_count.
pub machine ProjectItemsListResponse::get_opened_project_item(&self, index: u64) -> &ProjectItemPair
    requires 0 <= index && index < 64
{
    &self.opened_project_items[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectItemsListResponse::add_opened_project_item(&mut self, opened_project_item: ProjectItemPair) -> bool {
    transition self.opened_project_item_count < 64 {
        true -> store_opened_project_item(opened_project_item)
        false -> (false)
        _ -> (false)
    }
    state store_opened_project_item(&mut self, opened_project_item: ProjectItemPair) -> bool {
        let index: u64 = self.opened_project_item_count;
        transition index < 64 {
            true -> fill_opened_project_item(opened_project_item, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_opened_project_item(&mut self, opened_project_item: ProjectItemPair, index: u64) -> bool
        requires 0 <= index && index < 64
    {
        self.opened_project_items[index] = opened_project_item;
        self.opened_project_item_count = index + 1;
        (true)
    }
}
