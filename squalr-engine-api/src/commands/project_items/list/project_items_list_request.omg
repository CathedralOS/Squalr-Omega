module src::commands::project_items::list::project_items_list_request;

use src::structures::projects::project_path_list::ProjectPathList;
// Port of commands/project_items/list/project_items_list_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsListRequest {
    has_preview_project_item_paths: bool;
    preview_project_item_paths: ProjectPathList;
}

pub machine ProjectItemsListRequest::new() -> ProjectItemsListRequest {
    ProjectItemsListRequest {
        has_preview_project_item_paths: false,
        preview_project_item_paths: ProjectPathList::default(),
    }
}

pub machine ProjectItemsListRequest::default() -> ProjectItemsListRequest {
    ProjectItemsListRequest::new()
}

// Upstream `Option<ProjectPathList>` — flag pair.
pub machine ProjectItemsListRequest::has_preview_project_item_paths(project_items_list_request: &ProjectItemsListRequest) -> bool {
    project_items_list_request.has_preview_project_item_paths
}

pub machine ProjectItemsListRequest::get_preview_project_item_paths(project_items_list_request: &ProjectItemsListRequest) -> &ProjectPathList {
    &project_items_list_request.preview_project_item_paths
}

pub machine ProjectItemsListRequest::set_preview_project_item_paths(project_items_list_request: &mut ProjectItemsListRequest, preview_project_item_paths: ProjectPathList) {
    project_items_list_request.preview_project_item_paths = preview_project_item_paths;
    project_items_list_request.has_preview_project_item_paths = true;
}

pub machine ProjectItemsListRequest::clear_preview_project_item_paths(project_items_list_request: &mut ProjectItemsListRequest) {
    project_items_list_request.has_preview_project_item_paths = false;
}
