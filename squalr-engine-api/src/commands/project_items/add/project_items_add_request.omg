module src::commands::project_items::add::project_items_add_request;

use src::structures::scan_results::scan_result_ref::ScanResultRef;
// Port of commands/project_items/add/project_items_add_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsAddRequest {
    scan_result_refs: [ScanResultRef; 64];
    scan_result_ref_count: u64;
    has_target_directory_path: bool;
    target_directory_path: [u8; 512];
    target_directory_path_len: u64;
}

pub machine ProjectItemsAddRequest::new() -> ProjectItemsAddRequest {
    ProjectItemsAddRequest {
        scan_result_ref_count: 0,
        has_target_directory_path: false,
        target_directory_path_len: 0,
    }
}

pub machine ProjectItemsAddRequest::default() -> ProjectItemsAddRequest {
    ProjectItemsAddRequest::new()
}

// Upstream `Vec<ScanResultRef>` -> bounded [ScanResultRef; 64] + live count; `add_scan_result_ref`
// refuses past the bound rather than truncating.
pub machine ProjectItemsAddRequest::get_scan_result_ref_count(this: &ProjectItemsAddRequest) -> u64 {
    this.scan_result_ref_count
}

// Guarded element access — callers gate on get_scan_result_ref_count.
pub machine ProjectItemsAddRequest::get_scan_result_ref(this: &ProjectItemsAddRequest, index: u64) -> &ScanResultRef
    requires 0 <= index && index < 64
{
    &this.scan_result_refs[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectItemsAddRequest::add_scan_result_ref(this: &mut ProjectItemsAddRequest, scan_result_ref: ScanResultRef) -> bool {
    transition this.scan_result_ref_count < 64 {
        true -> store_scan_result_ref(this, scan_result_ref)
        false -> (false)
        _ -> (false)
    }
    state store_scan_result_ref(this: &mut ProjectItemsAddRequest, scan_result_ref: ScanResultRef) -> bool {
        let index: u64 = this.scan_result_ref_count;
        transition index < 64 {
            true -> fill_scan_result_ref(this, scan_result_ref, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_scan_result_ref(this: &mut ProjectItemsAddRequest, scan_result_ref: ScanResultRef, index: u64) -> bool
        requires 0 <= index && index < 64
    {
        this.scan_result_refs[index] = scan_result_ref;
        this.scan_result_ref_count = index + 1;
        (true)
    }
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectItemsAddRequest::has_target_directory_path(this: &ProjectItemsAddRequest) -> bool {
    this.has_target_directory_path
}

pub machine ProjectItemsAddRequest::get_target_directory_path(this: &ProjectItemsAddRequest) -> &[u8] {
    transition this.target_directory_path_len <= 512 {
        true -> (&this.target_directory_path[0..this.target_directory_path_len])
        false -> (&this.target_directory_path[0..512])
        _ -> (&this.target_directory_path[0..512])
    }
}

pub machine ProjectItemsAddRequest::set_target_directory_path(this: &mut ProjectItemsAddRequest, target_directory_path: &[u8]) {
    this.has_target_directory_path = true;
    this.target_directory_path_len = 0;
    transition {
        _ -> copy_target_directory_path(this, target_directory_path, 0)
    }
    state copy_target_directory_path(this: &mut ProjectItemsAddRequest, target_directory_path: &[u8], position: u64) {
        transition position < target_directory_path.len && position < 512 {
            true -> store_target_directory_path(this, target_directory_path, position)
            false -> finish_target_directory_path(this, position)
        }
    }
    state store_target_directory_path(this: &mut ProjectItemsAddRequest, target_directory_path: &[u8], position: u64) {
        this.target_directory_path[position] = target_directory_path[position];
        transition {
            _ -> copy_target_directory_path(this, target_directory_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_target_directory_path(this: &mut ProjectItemsAddRequest, count: u64) {
        this.target_directory_path_len = count;
    }
}

pub machine ProjectItemsAddRequest::clear_target_directory_path(this: &mut ProjectItemsAddRequest) {
    this.has_target_directory_path = false;
    this.target_directory_path_len = 0;
}
