module src::commands::project_items::add::project_items_add_request;

use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::scan_results::scan_result_ref::ScanResultRef;
// Port of commands/project_items/add/project_items_add_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsAddRequest {
    scan_result_refs: [ScanResultRef; 64];
    scan_result_ref_count: u64;
    has_target_directory_path: bool;
    target_directory_path: [u8; 512];
    target_directory_path_len: u64;
}

pub machine ProjectItemsAddRequest::new() -> ProjectItemsAddRequest {
    ProjectItemsAddRequest {
        scan_result_ref_count: 0,
        has_target_directory_path: false,
        target_directory_path_len: 0,
    }
}

pub machine ProjectItemsAddRequest::default() -> ProjectItemsAddRequest {
    ProjectItemsAddRequest::new()
}

// Upstream `Vec<ScanResultRef>` -> bounded [ScanResultRef; 64] + live count; `add_scan_result_ref`
// refuses past the bound rather than truncating.
pub machine ProjectItemsAddRequest::get_scan_result_ref_count(&self) -> u64 {
    self.scan_result_ref_count
}

// Guarded element access — callers gate on get_scan_result_ref_count.
pub machine ProjectItemsAddRequest::get_scan_result_ref(&self, index: u64) -> &ScanResultRef
    requires 0 <= index && index < 64
{
    &self.scan_result_refs[index]
}

// Upstream Vec::push — whole-record store; refuses past the bound.
pub machine ProjectItemsAddRequest::add_scan_result_ref(&mut self, scan_result_ref: ScanResultRef) -> bool {
    transition self.scan_result_ref_count < 64 {
        true -> store_scan_result_ref(scan_result_ref)
        false -> (false)
        _ -> (false)
    }
    state store_scan_result_ref(&mut self, scan_result_ref: ScanResultRef) -> bool {
        let index: u64 = self.scan_result_ref_count;
        transition index < 64 {
            true -> fill_scan_result_ref(scan_result_ref, index)
            false -> (false)
            _ -> (false)
        }
    }
    state fill_scan_result_ref(&mut self, scan_result_ref: ScanResultRef, index: u64) -> bool
        requires 0 <= index && index < 64
    {
        self.scan_result_refs[index] = scan_result_ref;
        self.scan_result_ref_count = index + 1;
        (true)
    }
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectItemsAddRequest::has_target_directory_path(&self) -> bool {
    self.has_target_directory_path
}

pub machine ProjectItemsAddRequest::get_target_directory_path(&self) -> &[u8] {
    bounded_slice(&self.target_directory_path[0..512], self.target_directory_path_len)
}

pub machine ProjectItemsAddRequest::set_target_directory_path(&mut self, target_directory_path: &[u8]) {
    self.has_target_directory_path = true;
    self.target_directory_path_len = BoundedByteCopy::copy(&mut self.target_directory_path[0..512], target_directory_path);
}

pub machine ProjectItemsAddRequest::clear_target_directory_path(&mut self) {
    self.has_target_directory_path = false;
    self.target_directory_path_len = 0;
}
