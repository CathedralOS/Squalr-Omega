module src::commands::project_items::reorder::project_items_reorder_response;

// Port of commands/project_items/reorder/project_items_reorder_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsReorderResponse {
    success: bool;
    reordered_project_item_count: u64;
}

pub machine ProjectItemsReorderResponse::new() -> ProjectItemsReorderResponse {
    ProjectItemsReorderResponse {
        success: false,
        reordered_project_item_count: 0,
    }
}

pub machine ProjectItemsReorderResponse::default() -> ProjectItemsReorderResponse {
    ProjectItemsReorderResponse::new()
}

pub machine ProjectItemsReorderResponse::get_success(project_items_reorder_response: &ProjectItemsReorderResponse) -> bool {
    project_items_reorder_response.success
}

pub machine ProjectItemsReorderResponse::set_success(project_items_reorder_response: &mut ProjectItemsReorderResponse, success: bool) {
    project_items_reorder_response.success = success;
}

pub machine ProjectItemsReorderResponse::get_reordered_project_item_count(project_items_reorder_response: &ProjectItemsReorderResponse) -> u64 {
    project_items_reorder_response.reordered_project_item_count
}

pub machine ProjectItemsReorderResponse::set_reordered_project_item_count(project_items_reorder_response: &mut ProjectItemsReorderResponse, reordered_project_item_count: u64) {
    project_items_reorder_response.reordered_project_item_count = reordered_project_item_count;
}
