use src/structures/projects/project_path_list.omg;
// Port of commands/project_items/reorder/project_items_reorder_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
public data ProjectItemsReorderRequest {
    project_item_paths: |project_path_list|::ProjectPathList;
}

public machine ProjectItemsReorderRequest::new() -> ProjectItemsReorderRequest {
    ProjectItemsReorderRequest {
        project_item_paths: |project_path_list|::ProjectPathList::empty(),
    }
}

public machine ProjectItemsReorderRequest::default() -> ProjectItemsReorderRequest {
    ProjectItemsReorderRequest::new()
}

public machine ProjectItemsReorderRequest::get_project_item_paths(this: &ProjectItemsReorderRequest) -> &|project_path_list|::ProjectPathList {
    &this.project_item_paths
}

public machine ProjectItemsReorderRequest::set_project_item_paths(this: &mut ProjectItemsReorderRequest, project_item_paths: |project_path_list|::ProjectPathList) {
    this.project_item_paths = project_item_paths;
}
