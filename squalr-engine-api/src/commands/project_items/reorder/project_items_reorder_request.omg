module src::commands::project_items::reorder::project_items_reorder_request;

use src::structures::projects::project_path_list::ProjectPathList;
// Port of commands/project_items/reorder/project_items_reorder_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsReorderRequest {
    project_item_paths: ProjectPathList;
}

pub machine ProjectItemsReorderRequest::new() -> ProjectItemsReorderRequest {
    ProjectItemsReorderRequest {
        project_item_paths: ProjectPathList::empty(),
    }
}

pub machine ProjectItemsReorderRequest::default() -> ProjectItemsReorderRequest {
    ProjectItemsReorderRequest::new()
}

pub machine ProjectItemsReorderRequest::get_project_item_paths(&self) -> &ProjectPathList {
    &self.project_item_paths
}

pub machine ProjectItemsReorderRequest::set_project_item_paths(&mut self, project_item_paths: ProjectPathList) {
    self.project_item_paths = project_item_paths;
}
