module src::commands::project_items::strip_symbol::project_items_strip_symbol_response;

// Port of commands/project_items/strip_symbol/project_items_strip_symbol_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsStripSymbolResponse {
    success: bool;
    stripped_project_item_count: u64;
    has_error: bool;
    error: [u8; 512];
    error_len: u64;
}

pub machine ProjectItemsStripSymbolResponse::new() -> ProjectItemsStripSymbolResponse {
    ProjectItemsStripSymbolResponse {
        success: false,
        stripped_project_item_count: 0,
        has_error: false,
        error_len: 0,
    }
}

pub machine ProjectItemsStripSymbolResponse::default() -> ProjectItemsStripSymbolResponse {
    ProjectItemsStripSymbolResponse::new()
}

pub machine ProjectItemsStripSymbolResponse::get_success(project_items_strip_symbol_response: &ProjectItemsStripSymbolResponse) -> bool {
    project_items_strip_symbol_response.success
}

pub machine ProjectItemsStripSymbolResponse::set_success(project_items_strip_symbol_response: &mut ProjectItemsStripSymbolResponse, success: bool) {
    project_items_strip_symbol_response.success = success;
}

pub machine ProjectItemsStripSymbolResponse::get_stripped_project_item_count(project_items_strip_symbol_response: &ProjectItemsStripSymbolResponse) -> u64 {
    project_items_strip_symbol_response.stripped_project_item_count
}

pub machine ProjectItemsStripSymbolResponse::set_stripped_project_item_count(project_items_strip_symbol_response: &mut ProjectItemsStripSymbolResponse, stripped_project_item_count: u64) {
    project_items_strip_symbol_response.stripped_project_item_count = stripped_project_item_count;
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectItemsStripSymbolResponse::has_error(project_items_strip_symbol_response: &ProjectItemsStripSymbolResponse) -> bool {
    project_items_strip_symbol_response.has_error
}

pub machine ProjectItemsStripSymbolResponse::get_error(project_items_strip_symbol_response: &ProjectItemsStripSymbolResponse) -> &[u8] {
    transition project_items_strip_symbol_response.error_len <= 512 {
        true -> (&project_items_strip_symbol_response.error[0..project_items_strip_symbol_response.error_len])
        false -> (&project_items_strip_symbol_response.error[0..512])
        _ -> (&project_items_strip_symbol_response.error[0..512])
    }
}

pub machine ProjectItemsStripSymbolResponse::set_error(project_items_strip_symbol_response: &mut ProjectItemsStripSymbolResponse, error: &[u8]) {
    project_items_strip_symbol_response.has_error = true;
    project_items_strip_symbol_response.error_len = 0;
    transition {
        _ -> copy_error(project_items_strip_symbol_response, error, 0)
    }
    state copy_error(project_items_strip_symbol_response: &mut ProjectItemsStripSymbolResponse, error: &[u8], position: u64) {
        transition position < error.len && position < 512 {
            true -> store_error(project_items_strip_symbol_response, error, position)
            false -> finish_error(project_items_strip_symbol_response, position)
        }
    }
    state store_error(project_items_strip_symbol_response: &mut ProjectItemsStripSymbolResponse, error: &[u8], position: u64) {
        project_items_strip_symbol_response.error[position] = error[position];
        transition {
            _ -> copy_error(project_items_strip_symbol_response, error, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_error(project_items_strip_symbol_response: &mut ProjectItemsStripSymbolResponse, count: u64) {
        project_items_strip_symbol_response.error_len = count;
    }
}

pub machine ProjectItemsStripSymbolResponse::clear_error(project_items_strip_symbol_response: &mut ProjectItemsStripSymbolResponse) {
    project_items_strip_symbol_response.has_error = false;
    project_items_strip_symbol_response.error_len = 0;
}
