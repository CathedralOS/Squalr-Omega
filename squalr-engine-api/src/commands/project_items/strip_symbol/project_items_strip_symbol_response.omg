module src::commands::project_items::strip_symbol::project_items_strip_symbol_response;

// Port of commands/project_items/strip_symbol/project_items_strip_symbol_response.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsStripSymbolResponse {
    success: bool;
    stripped_project_item_count: u64;
    has_error: bool;
    error: [u8; 512];
    error_len: u64;
}

pub machine ProjectItemsStripSymbolResponse::new() -> ProjectItemsStripSymbolResponse {
    ProjectItemsStripSymbolResponse {
        success: false,
        stripped_project_item_count: 0,
        has_error: false,
        error_len: 0,
    }
}

pub machine ProjectItemsStripSymbolResponse::default() -> ProjectItemsStripSymbolResponse {
    ProjectItemsStripSymbolResponse::new()
}

pub machine ProjectItemsStripSymbolResponse::get_success(&self) -> bool {
    self.success
}

pub machine ProjectItemsStripSymbolResponse::set_success(&mut self, success: bool) {
    self.success = success;
}

pub machine ProjectItemsStripSymbolResponse::get_stripped_project_item_count(&self) -> u64 {
    self.stripped_project_item_count
}

pub machine ProjectItemsStripSymbolResponse::set_stripped_project_item_count(&mut self, stripped_project_item_count: u64) {
    self.stripped_project_item_count = stripped_project_item_count;
}

// Upstream `Option` — flag pair; bytes are meaningful only under the flag.
pub machine ProjectItemsStripSymbolResponse::has_error(&self) -> bool {
    self.has_error
}

pub machine ProjectItemsStripSymbolResponse::get_error(&self) -> &[u8] {
    transition self.error_len <= 512 {
        true -> (&self.error[0..self.error_len])
        false -> (&self.error[0..512])
        _ -> (&self.error[0..512])
    }
}

pub machine ProjectItemsStripSymbolResponse::set_error(&mut self, error: &[u8]) {
    self.has_error = true;
    self.error_len = 0;
    transition {
        _ -> copy_error(error, 0)
    }
    state copy_error(&mut self, error: &[u8], position: u64) {
        transition position < error.len && position < 512 {
            true -> store_error(error, position)
            false -> finish_error(position)
        }
    }
    state store_error(&mut self, error: &[u8], position: u64) {
        self.error[position] = error[position];
        transition {
            _ -> copy_error(error, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state finish_error(&mut self, count: u64) {
        self.error_len = count;
    }
}

pub machine ProjectItemsStripSymbolResponse::clear_error(&mut self) {
    self.has_error = false;
    self.error_len = 0;
}
