// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsMoveItemResponse {
    success: bool;
    moved_project_item_count: u64;
}

pub machine ProjectItemsMoveItemResponse::new() -> ProjectItemsMoveItemResponse {
    ProjectItemsMoveItemResponse {
        success: false,
