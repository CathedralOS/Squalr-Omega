module src::commands::project_items::move_item::project_items_move_item_request;

use src::structures::projects::project_path_list::ProjectPathList;
// Port of commands/project_items/move_item/project_items_move_item_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
public data ProjectItemsMoveItemRequest {
    project_item_paths: ProjectPathList;
    target_directory_path: [u8; 512];
    target_directory_path_len: u64;
}

public machine ProjectItemsMoveItemRequest::new() -> ProjectItemsMoveItemRequest {
    ProjectItemsMoveItemRequest {
        project_item_paths: ProjectPathList::empty(),
        target_directory_path_len: 0,
    }
}

public machine ProjectItemsMoveItemRequest::default() -> ProjectItemsMoveItemRequest {
    ProjectItemsMoveItemRequest::new()
}

public machine ProjectItemsMoveItemRequest::get_project_item_paths(this: &ProjectItemsMoveItemRequest) -> &ProjectPathList {
    &this.project_item_paths
}

public machine ProjectItemsMoveItemRequest::set_project_item_paths(this: &mut ProjectItemsMoveItemRequest, project_item_paths: ProjectPathList) {
    this.project_item_paths = project_item_paths;
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
public machine ProjectItemsMoveItemRequest::get_target_directory_path(this: &ProjectItemsMoveItemRequest) -> &[u8] {
    transition this.target_directory_path_len <= 512 {
        true -> (&this.target_directory_path[0..this.target_directory_path_len])
        false -> (&this.target_directory_path[0..512])
        _ -> (&this.target_directory_path[0..512])
    }
}

public machine ProjectItemsMoveItemRequest::set_target_directory_path(this: &mut ProjectItemsMoveItemRequest, target_directory_path: &[u8]) {
    this.target_directory_path_len = 0;
    transition {
        _ -> copy_target_directory_path(this, target_directory_path, 0)
    }
    machine copy_target_directory_path(this: &mut ProjectItemsMoveItemRequest, target_directory_path: &[u8], position: u64) {
        transition position < target_directory_path.len && position < 512 {
            true -> store_target_directory_path(this, target_directory_path, position)
            false -> finish_target_directory_path(this, position)
        }
    }
    machine store_target_directory_path(this: &mut ProjectItemsMoveItemRequest, target_directory_path: &[u8], position: u64) {
        this.target_directory_path[position] = target_directory_path[position];
        transition {
            _ -> copy_target_directory_path(this, target_directory_path, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    machine finish_target_directory_path(this: &mut ProjectItemsMoveItemRequest, count: u64) {
        this.target_directory_path_len = count;
    }
}
