module src::commands::project_items::move_item::project_items_move_item_request;

use src::structures::bounded_slice::bounded_slice;

use src::structures::bounded_byte_copy::BoundedByteCopy;

use src::structures::projects::project_path_list::ProjectPathList;
// Port of commands/project_items/move_item/project_items_move_item_request.rs. Carriers follow the package conventions:
// String/PathBuf -> [u8;N]+len, Option -> has_ flag pairs, Vec -> bounded
// arrays + counts (add_* refuses past the bound rather than truncating).
pub data ProjectItemsMoveItemRequest {
    project_item_paths: ProjectPathList;
    target_directory_path: [u8; 512];
    target_directory_path_len: u64;
}

pub machine ProjectItemsMoveItemRequest::new() -> ProjectItemsMoveItemRequest {
    ProjectItemsMoveItemRequest {
        project_item_paths: ProjectPathList::empty(),
        target_directory_path_len: 0,
    }
}

pub machine ProjectItemsMoveItemRequest::default() -> ProjectItemsMoveItemRequest {
    ProjectItemsMoveItemRequest::new()
}

pub machine ProjectItemsMoveItemRequest::get_project_item_paths(&self) -> &ProjectPathList {
    &self.project_item_paths
}

pub machine ProjectItemsMoveItemRequest::set_project_item_paths(&mut self, project_item_paths: ProjectPathList) {
    self.project_item_paths = project_item_paths;
}

// Bounded UTF-8 carrier for the upstream string field (512 cap).
pub machine ProjectItemsMoveItemRequest::get_target_directory_path(&self) -> &[u8] {
    bounded_slice(&self.target_directory_path[0..512], self.target_directory_path_len)
}

pub machine ProjectItemsMoveItemRequest::set_target_directory_path(&mut self, target_directory_path: &[u8]) {
    self.target_directory_path_len = BoundedByteCopy::copy(&mut self.target_directory_path[0..512], target_directory_path);
}
