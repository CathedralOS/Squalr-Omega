// Package boundary and internal edges mirror upstream squalr-engine-api/Cargo.toml.
machine build(builder: &mut Build) {
    Build::package(builder, "squalr_engine_api");
    // `invokes PosixFilesystemHost;`/`WaitWake` on the bindings trait requirement
    // names the boundary traits — they must resolve inside this package, so
    // the std edge mirrors the engine package's pin.
    Build::depend(builder, Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "b01cf9ec5f501d77a48f6aac6ba951746747bfae",
        selection: PackageSelection::Named { package: "omega_language_std" }
    });
}
