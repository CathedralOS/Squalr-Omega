// Workspace membership is not a merged application or dependency closure.
machine build(builder: &mut Build) {
    builder.member("plugins/squalr-plugin-builtins");
    builder.member("plugins/squalr-plugin-data-types-24bit");
    builder.member("plugins/squalr-plugin-instructions-arm");
    builder.member("plugins/squalr-plugin-instructions-powerpc");
    builder.member("plugins/squalr-plugin-instructions-x86");
    builder.member("plugins/squalr-plugin-debuggers-native");
    builder.member("plugins/squalr-plugin-memory-view-dolphin");
    builder.member("plugins/squalr-plugin-binary-symbols");
    builder.member("squalr-tests");
    builder.member("squalr-engine-api");
    builder.member("squalr-engine-targets");
    builder.member("squalr-engine-session");
    builder.member("squalr-engine-targets-native");
    builder.member("squalr-engine");
    builder.member("squalr-engine-projects");
    builder.member("squalr-engine-scanning");
    builder.member("squalr-cli");
}
