// Workspace membership is not a merged application or dependency closure.
machine build(builder: &mut Build) {
    member(builder, "plugins/squalr-plugin-builtins");
    member(builder, "plugins/squalr-plugin-data-types-24bit");
    member(builder, "plugins/squalr-plugin-instructions-arm");
    member(builder, "plugins/squalr-plugin-instructions-powerpc");
    member(builder, "plugins/squalr-plugin-instructions-x86");
    member(builder, "plugins/squalr-plugin-debuggers-native");
    member(builder, "plugins/squalr-plugin-memory-view-dolphin");
    member(builder, "plugins/squalr-plugin-binary-symbols");
    member(builder, "squalr-tests");
    member(builder, "squalr-engine-api");
    member(builder, "squalr-engine-targets");
    member(builder, "squalr-engine-session");
    member(builder, "squalr-engine-targets-native");
    member(builder, "squalr-engine");
    member(builder, "squalr-engine-projects");
    member(builder, "squalr-engine-scanning");
    member(builder, "squalr-cli");
}
