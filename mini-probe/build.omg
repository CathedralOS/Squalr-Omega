machine build(builder: &mut Build) {
    builder.application("mini_probe");
    builder.depend(Source::Path { location: "../squalr-engine-targets-native" });
    builder.depend(Source::Path { location: "../squalr-engine-targets" });
    builder.depend(Source::Path { location: "../squalr-engine-api" });
    builder.depend(Source::Path { location: "../squalr-engine-session" });
    builder.depend(Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "8a9485804ea8e5ae7f7bb5b2405a86a42a81188c",
        selection: PackageSelection::Named { package: "omega_language_std" }
    });
    builder.roots.bind(linux_x86_64::ProgramEntry, Mini::main);
}
