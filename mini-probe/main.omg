use omega::language::core::binding;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::memory::normalized_region::NormalizedRegion;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::processes::process_info::ProcessInfo;
use squalr_engine_session::src::os::engine_os_provider::EngineOsProviders;
use squalr_engine_targets::src::target_providers::AddressWritable;
use squalr_engine_targets::src::target_providers::ProcessAliveResult;
use squalr_engine_targets::src::target_providers::MemoryBoundsOpen;
use squalr_engine_targets::src::target_providers::MemoryBoundsStep;
use squalr_engine_targets::src::target_providers::MemoryReadResult;
use squalr_engine_targets::src::target_providers::MemoryWriteResult;
use squalr_engine_targets::src::target_providers::OpenedProcessResult;
use squalr_engine_targets::src::target_providers::ProcessQueryOutcome;
use squalr_engine_targets_native::src::memory_queryer::normalized_module::ModuleStreamStep;
use squalr_engine_targets_native::src::memory_queryer::normalized_module::NormalizedModule;
use squalr_engine_targets_native::src::memory_reader::linux::linux_memory_reader::LinuxMemoryReader;

pub data Mini {
    reader: LinuxMemoryReader;
    providers: EngineOsProviders;
    info: OpenedProcessInfo;
    proc_info: ProcessInfo;
    open_result: OpenedProcessResult;
    region: NormalizedRegion;
    module: NormalizedModule;
    buf: [u8; 4096];
}

pub linux_x86_64 machine Mini::main(mini: &mut Mini)
reaches FilesystemHost
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    state go(mini: &mut Mini) {
        let r: MemoryReadResult = LinuxMemoryReader::read_bytes(&mut mini.reader, &mini.info, 0, &mut mini.buf);
        mini.open_result = EngineOsProviders::open_process(&mut mini.providers, &mini.proc_info);
        let bounds: MemoryBoundsOpen = EngineOsProviders::open_page_bounds(&mut mini.providers, &mini.open_result.info, 0);
        let step: MemoryBoundsStep = EngineOsProviders::next_page_bounds_region(&mut mini.providers, &mut mini.region);
        let w: AddressWritable = EngineOsProviders::is_address_writable(&mut mini.providers, &mini.open_result.info, 0);
        let rr: MemoryReadResult = EngineOsProviders::read_bytes(&mut mini.providers, &mini.open_result.info, 0, &mut mini.buf);
        let wr: MemoryWriteResult = EngineOsProviders::write_bytes(&mut mini.providers, &mini.open_result.info, 0, &mini.buf);
        let mbounds: MemoryBoundsOpen = EngineOsProviders::open_modules(&mut mini.providers, &mini.open_result.info);
        let mstep: ModuleStreamStep = EngineOsProviders::next_module(&mut mini.providers, &mut mini.module);
        EngineOsProviders::close_page_bounds(&mut mini.providers);
        let h: u64 = OpenedProcessInfo::get_handle(&mini.open_result.info);
        let closed: ProcessQueryOutcome = EngineOsProviders::close_process(&mut mini.providers, h);
        let alive: ProcessAliveResult = EngineOsProviders::is_process_alive(&mut mini.providers, 0);
    }
}
