use omega::language::core::binding;
use omega_language_std::filesystem_host;
use squalr_engine_api::src::structures::memory::normalized_region::NormalizedRegion;
use squalr_engine_api::src::structures::processes::opened_process_info::OpenedProcessInfo;
use squalr_engine_api::src::structures::processes::process_info::ProcessInfo;
use squalr_engine_session::src::os::engine_os_provider::EngineOsProviders;
use squalr_engine_targets::src::target_providers::AddressWritable;
use squalr_engine_targets::src::target_providers::ProcessAliveResult;
use squalr_engine_targets::src::target_providers::MemoryBoundsOpen;
use squalr_engine_targets::src::target_providers::MemoryBoundsStep;
use squalr_engine_targets::src::target_providers::MemoryReadResult;
use squalr_engine_targets::src::target_providers::MemoryWriteResult;
use squalr_engine_targets::src::target_providers::OpenedProcessResult;
use squalr_engine_targets::src::target_providers::ProcessQueryOutcome;
use squalr_engine_targets_native::src::memory_queryer::normalized_module::ModuleStreamStep;
use squalr_engine_targets_native::src::memory_queryer::normalized_module::NormalizedModule;
use squalr_engine_targets_native::src::memory_reader::linux::linux_memory_reader::LinuxMemoryReader;

pub data Mini {
    reader: LinuxMemoryReader;
    providers: EngineOsProviders;
    info: OpenedProcessInfo;
    proc_info: ProcessInfo;
    open_result: OpenedProcessResult;
    region: NormalizedRegion;
    module: NormalizedModule;
    buf: [u8; 4096];
}

pub linux_x86_64 machine Mini::main(this: &mut Mini)
reaches FilesystemHost
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    state go(this: &mut Mini) {
        let r: MemoryReadResult = read_bytes(this.reader, &this.info, 0, &mut this.buf);
        this.open_result = open_process(this.providers, &this.proc_info);
        let bounds: MemoryBoundsOpen = open_page_bounds(this.providers, &this.open_result.info, 0);
        let step: MemoryBoundsStep = next_page_bounds_region(this.providers, &mut this.region);
        let w: AddressWritable = is_address_writable(this.providers, &this.open_result.info, 0);
        let rr: MemoryReadResult = read_bytes(this.providers, &this.open_result.info, 0, &mut this.buf);
        let wr: MemoryWriteResult = write_bytes(this.providers, &this.open_result.info, 0, &this.buf);
        let mbounds: MemoryBoundsOpen = open_modules(this.providers, &this.open_result.info);
        let mstep: ModuleStreamStep = next_module(this.providers, &mut this.module);
        close_page_bounds(this.providers);
        let h: u64 = get_handle(this.open_result.info);
        let closed: ProcessQueryOutcome = close_process(this.providers, h);
        let alive: ProcessAliveResult = is_process_alive(this.providers, 0);
    }
}
