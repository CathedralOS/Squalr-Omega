use {omega_language_std}/filesystem_host.omg;
use {omega}/language/core/filesystem_authority.omg;
use {omega_language_std}/posix_filesystem_host.omg;
use {squalr_engine_api}/src/structures/memory/normalized_region.omg;
use {squalr_engine_api}/src/structures/processes/opened_process_info.omg;
use {squalr_engine_api}/src/structures/processes/process_info.omg;
use {squalr_engine_session}/src/os/engine_os_provider.omg;
use {squalr_engine_targets}/src/target_providers.omg;
use {squalr_engine_targets_native}/src/memory_queryer/normalized_module.omg;
use {squalr_engine_targets_native}/src/memory_reader/linux/linux_memory_reader.omg;

public data Mini {
    reader: |linux_memory_reader|::LinuxMemoryReader;
    providers: |engine_os_provider|::EngineOsProviders;
    info: |opened_process_info|::OpenedProcessInfo;
    proc_info: |process_info|::ProcessInfo;
    open_result: |target_providers|::OpenedProcessResult;
    region: |normalized_region|::NormalizedRegion;
    module: |normalized_module|::NormalizedModule;
    buf: [u8; 4096];
}

public linux_x86_64 machine Mini::main(this: &mut Mini)
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
crashes Abort
crashes Trap
{
    machine go(this: &mut Mini) {
        let r: |target_providers|::MemoryReadResult = read_bytes(this.reader, &this.info, 0, &mut this.buf);
        this.open_result = open_process(this.providers, &this.proc_info);
        let bounds: |target_providers|::MemoryBoundsOpen = open_page_bounds(this.providers, &this.open_result.info, 0);
        let step: |target_providers|::MemoryBoundsStep = next_page_bounds_region(this.providers, &mut this.region);
        let w: |target_providers|::AddressWritable = is_address_writable(this.providers, &this.open_result.info, 0);
        let rr: |target_providers|::MemoryReadResult = read_bytes(this.providers, &this.open_result.info, 0, &mut this.buf);
        let wr: |target_providers|::MemoryWriteResult = write_bytes(this.providers, &this.open_result.info, 0, &this.buf);
        let mbounds: |target_providers|::MemoryBoundsOpen = open_modules(this.providers, &this.open_result.info);
        let mstep: |normalized_module|::ModuleStreamStep = next_module(this.providers, &mut this.module);
        close_page_bounds(this.providers);
        let h: u64 = get_handle(this.open_result.info);
        let closed: |target_providers|::ProcessQueryOutcome = close_process(this.providers, h);
        let alive: |target_providers|::ProcessAliveResult = is_process_alive(this.providers, 0);
    }
}
