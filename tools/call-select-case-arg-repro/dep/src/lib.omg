module src::lib;

public data ProbeResult {
    case X;
    case Y;
    case Z(count: u64);
    case Perr(e: SmallErr);
}

public data Mode [copy] {
    case A;
    case B;
}

public data Worker {
    seq: u64;
}

public data Rec {
    h: u64;
}

public machine Worker::multi(this: &mut Worker, info: &Rec, addr: u64) -> bool {
    addr > 3
}

public machine Worker::take_ref(this: &mut Worker, info: &Rec) -> bool {
    info.h > 3
}

public machine Worker::take_scalar(this: &mut Worker, addr: u64) -> bool {
    addr > 3
}

public machine Worker::multi3(this: &mut Worker, info: &Rec, a: u64, b: u64) -> bool {
    a > b
}

public machine Worker::probe(this: &mut Worker, mode: Mode) -> ProbeResult {
    ProbeResult::Z { count: 7 }
}

public machine Worker::outcome2(this: &Worker) -> ProbeResult {
    ProbeResult::Z { count: 7 }
}

public machine Worker::probe0(this: &mut Worker) -> ProbeResult {
    ProbeResult::Z { count: 9 }
}

public machine Worker::probe_u(this: &mut Worker, n: u64) -> ProbeResult {
    ProbeResult::Z { count: n }
}

public data Outer {
    info: Rec;
}

public machine Rec::get(this: &Rec) -> u64 {
    this.h
}

public data SmallErr [copy] {
    case E1;
    case E2;
}

public machine ProbeResult::succeeded(this: &ProbeResult) -> bool {
    this in ProbeResult::Z
}

public machine Worker::inner_mut(this: &mut Worker, r: &mut Rec) -> ProbeResult {
    r.h = ((r.h as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    ProbeResult::Z { count: r.h }
}

public machine Worker::forward_mut(this: &mut Worker, r: &mut Rec) -> ProbeResult {
    let hoist1: ProbeResult = inner_mut(this, &mut r);
    (hoist1)
}

public machine Worker::inner_ref(this: &mut Worker, r: &Rec) -> ProbeResult {
    ProbeResult::Z { count: r.h }
}

public machine Worker::forward_ref(this: &mut Worker, r: &Rec) -> ProbeResult {
    let hoist2: ProbeResult = inner_ref(this, r);
    (hoist2)
}

public machine Worker::succ_forward(this: &mut Worker, r: &mut Rec) -> ProbeResult {
    transition { _ -> step2(this, r) }
    state step2(this: &mut Worker, r: &mut Rec) -> ProbeResult {
        let hoist3: ProbeResult = inner_mut(this, &mut r);
        (hoist3)
    }
}
