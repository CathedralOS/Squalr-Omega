module src::lib;

pub data ProbeResult {
    case X;
    case Y;
    case Z(count: u64);
    case Perr(e: SmallErr);
}

pub data Mode [copy] {
    case A;
    case B;
}

pub data Worker {
    seq: u64;
}

pub data Rec {
    h: u64;
}

pub machine Worker::multi(&mut self, info: &Rec, addr: u64) -> bool {
    addr > 3
}

pub machine Worker::take_ref(&mut self, info: &Rec) -> bool {
    info.h > 3
}

pub machine Worker::take_scalar(&mut self, addr: u64) -> bool {
    addr > 3
}

pub machine Worker::multi3(&mut self, info: &Rec, a: u64, b: u64) -> bool {
    a > b
}

pub machine Worker::probe(&mut self, mode: Mode) -> ProbeResult {
    ProbeResult::Z { count: 7 }
}

pub machine Worker::outcome2(&self) -> ProbeResult {
    ProbeResult::Z { count: 7 }
}

pub machine Worker::probe0(&mut self) -> ProbeResult {
    ProbeResult::Z { count: 9 }
}

pub machine Worker::probe_u(&mut self, n: u64) -> ProbeResult {
    ProbeResult::Z { count: n }
}

pub data Outer {
    info: Rec;
}

pub machine Rec::get(&self) -> u64 {
    self.h
}

pub data SmallErr [copy] {
    case E1;
    case E2;
}

pub machine ProbeResult::succeeded(&self) -> bool {
    self in ProbeResult::Z
}

pub machine Worker::inner_mut(&mut self, r: &mut Rec) -> ProbeResult {
    r.h = ((r.h as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    ProbeResult::Z { count: r.h }
}

pub machine Worker::forward_mut(&mut self, r: &mut Rec) -> ProbeResult {
    self.inner_mut(&mut r)
}

pub machine Worker::inner_ref(&mut self, r: &Rec) -> ProbeResult {
    ProbeResult::Z { count: r.h }
}

pub machine Worker::forward_ref(&mut self, r: &Rec) -> ProbeResult {
    self.inner_ref(r)
}

pub machine Worker::succ_forward(&mut self, r: &mut Rec) -> ProbeResult {
    transition { _ -> step2(r) }
    state step2(&mut self, r: &mut Rec) -> ProbeResult {
        self.inner_mut(&mut r)
    }
}
