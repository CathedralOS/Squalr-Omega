module src::lib;

pub data ProbeResult {
    case X;
    case Y;
    case Z(count: u64);
    case Perr(e: SmallErr);
}

pub data Mode [copy] {
    case A;
    case B;
}

pub data Worker {
    seq: u64;
}

pub data Rec {
    h: u64;
}

pub machine Worker::multi(worker: &mut Worker, info: &Rec, addr: u64) -> bool {
    addr > 3
}

pub machine Worker::take_ref(worker: &mut Worker, info: &Rec) -> bool {
    info.h > 3
}

pub machine Worker::take_scalar(worker: &mut Worker, addr: u64) -> bool {
    addr > 3
}

pub machine Worker::multi3(worker: &mut Worker, info: &Rec, a: u64, b: u64) -> bool {
    a > b
}

pub machine Worker::probe(worker: &mut Worker, mode: Mode) -> ProbeResult {
    ProbeResult::Z { count: 7 }
}

pub machine Worker::outcome2(worker: &Worker) -> ProbeResult {
    ProbeResult::Z { count: 7 }
}

pub machine Worker::probe0(worker: &mut Worker) -> ProbeResult {
    ProbeResult::Z { count: 9 }
}

pub machine Worker::probe_u(worker: &mut Worker, n: u64) -> ProbeResult {
    ProbeResult::Z { count: n }
}

pub data Outer {
    info: Rec;
}

pub machine Rec::get(rec: &Rec) -> u64 {
    rec.h
}

pub data SmallErr [copy] {
    case E1;
    case E2;
}

pub machine ProbeResult::succeeded(probe_result: &ProbeResult) -> bool {
    probe_result in ProbeResult::Z
}

pub machine Worker::inner_mut(worker: &mut Worker, r: &mut Rec) -> ProbeResult {
    r.h = ((r.h as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
    ProbeResult::Z { count: r.h }
}

pub machine Worker::forward_mut(worker: &mut Worker, r: &mut Rec) -> ProbeResult {
    Worker::inner_mut(worker, &mut r)
}

pub machine Worker::inner_ref(worker: &mut Worker, r: &Rec) -> ProbeResult {
    ProbeResult::Z { count: r.h }
}

pub machine Worker::forward_ref(worker: &mut Worker, r: &Rec) -> ProbeResult {
    Worker::inner_ref(worker, r)
}

pub machine Worker::succ_forward(worker: &mut Worker, r: &mut Rec) -> ProbeResult {
    transition { _ -> step2(worker, r) }
    state step2(worker: &mut Worker, r: &mut Rec) -> ProbeResult {
        Worker::inner_mut(worker, &mut r)
    }
}
