machine build(builder: &mut Build) {
    Build::application(builder, "call_select_case_arg_repro");
    Build::depend(builder, Source::Path { location: "dep" });
    Build::depend(builder, Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "4a194ff149c404bb81f94a978de9de442d05a0df",
        selection: PackageSelection::Named { package: "omega_language_std" }
    });
    Build::bind(builder, linux_x86_64::ProgramEntry, App::main);
}
