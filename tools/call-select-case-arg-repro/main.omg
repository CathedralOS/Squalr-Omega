use omega_language_std::console;
use omega_language_std::filesystem_host;
use omega::language::core::binding;
use call_select_dep::src::lib::Rec;
use call_select_dep::src::lib::Outer;
use call_select_dep::src::lib::Worker;
use call_select_dep::src::lib::ProbeResult;

pub data App {
    console: Binding<Console>;
    worker: Worker;
    outer: Outer;
    control: [u8; 64];
    ctrl_src: [u8; 64];
    pos: u64;
    digit_len: u64;
    b8: u8;
    pt: Point;
    fsw: FsWorker;
}

pub data FsWorker {
    fs: Binding<FilesystemHost>;
    fmem_fd: i32;
    fproc_fd: i32;
    fcount: i64;
    fexpected: u64;
    fpos: u64;
    fscratch: i32;
    control: [u8; 64];
    name: NameBox;
    fds: [i32; 8];
}

pub data NameBox {
    bytes: [u8; 64];
    len: u64;
}

pub machine NameBox::for_process(process_id: u32) -> NameBox {
    NameBox { len: 3 }
}

pub linux_x86_64 machine App::main(app: &mut App)
reaches Console + FilesystemHost
invokes Console;
invokes FilesystemHost;
suspends; blocks;
crashes Abort
crashes Trap
{
    state s(app: &mut App) {
        app.outer.info = Rec { h: 7 };
        transition { _ -> u5(app) }
    }
    // u5: 2-seg receiver scalar call into let + affine-result call + ClosedSum
    state u5(app: &mut App) {
        let h: u64 = Rec::get(&app.outer.info);
        let p: ProbeResult = Worker::probe_u(&mut app.worker, h);
        let ok: bool = ProbeResult::succeeded(&p);
        transition ok {
            true -> hv(app)
            false -> bad(app)
        }
    }
    state em(app: &mut App) {
        App::emit(app, app.digit_len);
        transition { _ -> es(app) }
    }
    state es(app: &mut App) {
        App::emit_slice(app, app.digit_len);
        transition block App::mirror_read(app, &mut app.control, app.pos) {
            _ -> es2(app)
        }
    }
    state es2(app: &mut App) {
        App::plain_put(app, app.pos, 65);
        App::stmt_bare(app, &mut app.pt);
        App::fwd_bump_reborrow(app, &mut app.pt);
        App::bump_method(app, &mut app.pt);
        App::bump_field(app, &mut app.pt);
        App::reuse_arg(app);
        App::field_arg(app);
        transition block FsWorker::fs_read(&mut app.fsw, &mut app.control, app.pos) {
            _ -> es3(app)
        }
    }
    state es3(app: &mut App) {
        transition block app.console.read_line(&mut app.control) {
            _ -> good(app)
        }
    }

    state sf(app: &mut App) {
        let p: ProbeResult = Worker::succ_forward(&mut app.worker, &mut app.outer.info);
        let ok: bool = ProbeResult::succeeded(&p);
        transition ok {
            true -> sf(app)
            false -> bad(app)
        }
    }
    state fr(app: &mut App) {
        let p: ProbeResult = Worker::forward_ref(&mut app.worker, &app.outer.info);
        let ok: bool = ProbeResult::succeeded(&p);
        transition ok {
            true -> fr(app)
            false -> bad(app)
        }
    }
    state fm(app: &mut App) {
        let p: ProbeResult = Worker::forward_mut(&mut app.worker, &mut app.outer.info);
        let ok: bool = ProbeResult::succeeded(&p);
        transition ok {
            true -> hv_in(app)
            false -> bad(app)
        }
    }
    state hv_in(app: &mut App) {
        transition app.pos < 64 {
            true -> hv(app)
            false -> bad(app)
        }
    }
    state hv(app: &mut App) {
        let dv: u64 = hex_value(app.b8);
        app.digit_len = dv;
        transition app.digit_len < 16 {
            true -> slg(app)
            false -> bad(app)
        }
    }
    // mirror: std console read_line shape — selfless states, bare &mut forwards, 2 hops
    state slg(app: &mut App) {
        transition { _ -> em(app) }
    }
    // mirror: bound carrier on a self field (owned, non-borrowed)
    state fw(app: &mut App, fcount: u64)
    requires 0 <= fcount && fcount < 64;
    {
        app.control[fcount] = app.b8;
        transition { _ -> em(app) }
    }
    state good(app: &mut App) {
        app.console.exit_process(0);
    }
    state bad(app: &mut App) {
        app.console.exit_process(1);
    }
}

machine slice_chain(out: &mut [u8; 64], fcount: u64, byte: u8) -> u64 {
    transition { _ -> sc(out, fcount, byte) }
    state sc(out: &mut [u8; 64], fcount: u64, byte: u8) -> u64 {
        transition fcount < out.len {
            true -> mid(out, fcount, byte)
            false -> (1)
        }
    }
    state mid(out: &mut [u8; 64], fcount: u64, byte: u8) -> u64 {
        transition fcount < out.len {
            true -> wr(out, fcount, byte)
            false -> (1)
        }
    }
    state wr(out: &mut [u8; 64], fcount: u64, byte: u8) -> u64
    requires 0 <= fcount && fcount < out.len;
    {
        out[fcount] = byte;
        transition { _ -> (0) }
    }
}

// runtime &mut slice bound — does [0..out.len] discharge on a &mut [u8]?
// two-len-conjunct arm -> two bounded params + bool-var arm -> re-guard
machine two_len_gate(out: &mut [u8; 64], q: u64, j: u64, byte: u8) -> u64 {
    transition { _ -> g(out, q, j, byte) }
    state g(out: &mut [u8; 64], q: u64, j: u64, byte: u8) -> u64 {
        transition q < out.len && j < out.len {
            true -> acc(out, q, j, byte)
            false -> (1)
        }
    }
    state acc(out: &mut [u8; 64], q: u64, j: u64, byte: u8) -> u64
    requires 0 <= j && j < out.len;
    {
        let cur: u8 = out[j];
        transition cur < byte {
            true -> (0)
            false -> gq(out, q, byte)
        }
    }
    state gq(out: &mut [u8; 64], q: u64, byte: u8) -> u64 {
        transition q < out.len {
            true -> sgw(out, q, byte)
            false -> (1)
        }
    }
    state sgw(out: &mut [u8; 64], q: u64, byte: u8) -> u64 {
        transition q < out.len {
            true -> ssw(out, q, byte)
            false -> (1)
        }
    }
    state ssw(out: &mut [u8; 64], q: u64, byte: u8) -> u64
    requires 0 <= q && q < out.len;
    {
        out[q] = byte;
        transition { _ -> (0) }
    }
}

machine mut_slice_write(out: &mut [u8], idx: u64, byte: u8) -> u64 {
    transition { _ -> mswg(out, idx, byte) }
    state mswg(out: &mut [u8], idx: u64, byte: u8) -> u64 {
        transition idx < out.len {
            true -> msw(out, idx, byte)
            false -> (1)
        }
    }
    state msw(out: &mut [u8], idx: u64, byte: u8) -> u64
    requires 0 <= idx && idx < out.len;
    {
        out[idx] = byte;
        transition { _ -> (0) }
    }
}

// mirror: copy/store t[p]=s[p] — bound on the & view + literal arm-guard for &mut side
machine copy_loop(dst: &mut [u8; 64], src: &[u8]) -> u64 {
    transition { _ -> cp(dst, src, 0) }
    state cp(dst: &mut [u8; 64], src: &[u8], position: u64) -> u64 {
        transition position < src.len && position < 64 {
            true -> st(dst, src, position)
            false -> (position)
        }
    }
    state st(dst: &mut [u8; 64], src: &[u8], position: u64) -> u64
    requires 0 <= position && position < src.len;
    {
        dst[position] = src[position];
        transition { _ -> cp(dst, src, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

machine hex_value(byte: u8) -> u64 {
    transition byte >= 48 && byte <= 57 {
        true -> dec(byte)
        false -> alpha(byte)
    }
    state dec(byte: u8) -> u64 {
        (((byte as u64) as u64 in Wrapping) - (48 as u64 in Wrapping)) as u64
    }
    state alpha(byte: u8) -> u64 {
        transition byte >= 97 && byte <= 102 {
            true -> lower(byte)
            false -> upper(byte)
        }
    }
    state lower(byte: u8) -> u64 {
        (((byte as u64) as u64 in Wrapping) - (87 as u64 in Wrapping)) as u64
    }
    state upper(byte: u8) -> u64 {
        transition byte >= 65 && byte <= 70 {
            true -> up(byte)
            false -> invalid(byte)
        }
    }
    state up(byte: u8) -> u64 {
        (((byte as u64) as u64 in Wrapping) - (55 as u64 in Wrapping)) as u64
    }
    state invalid(byte: u8) -> u64 {
        16
    }
}

machine App::emit(app: &mut App, v: u64)
reaches Console
{
    transition { _ -> e1(app, v) }
    state e1(app: &mut App, v: u64) {
        app.console.write_line("x");
        transition { _ -> e2(app) }
    }
    state e2(app: &mut App) {
    }
}

machine App::emit_slice(app: &mut App, len: u64)
reaches Console
{
    transition { _ -> bound(app, len) }
    state bound(app: &mut App, len: u64) {
        transition len <= 64 {
            true -> at(app, 0, len)
            false -> e2(app)
        }
    }
    state at(app: &mut App, i: u64, len: u64)
    requires 0 <= len && len <= 64;
    {
        transition i < len {
            true -> pb(app, i, len)
            false -> nl(app)
        }
    }
    state pb(app: &mut App, i: u64, len: u64)
    requires 0 <= len && len <= 64;
    {
        transition i < 64 {
            true -> wb(app, i, len)
            false -> nl(app)
        }
    }
    state wb(app: &mut App, i: u64, len: u64)
    requires 0 <= i && i < 64 && 0 <= len && len <= 64;
    {
        let b: i32 = app.control[i] as i32;
        app.console.write_byte(b);
        transition { _ -> at(app, i + 1, len) }
    }
    state nl(app: &mut App) {
        app.console.write_byte(10);
        transition { _ -> e2(app) }
    }
    state e2(app: &mut App) {
    }
}

machine App::mirror_read(app: &mut App, values: &mut [u8; 64], address: u64) -> u64
reaches Console
suspends; blocks;
{
    transition { _ -> r(app, values, address) }
    state r(app: &mut App, values: &mut [u8; 64], address: u64) -> u64 {
        let want: u64 = app.digit_len;
        let offset: i64 = ((address as i64 in Wrapping) as i64);
        app.console.write(&app.control[0..64]);
        transition block app.console.read_line(&mut app.control) {
            _ -> e2(app)
        }
    }
    state e2(app: &mut App) -> u64 {
        0
    }
}

machine FsWorker::fs_read(fs_worker: &mut FsWorker, values: &mut [u8], address: u64) -> u64
reaches FilesystemHost
invokes FilesystemHost;
suspends; blocks;
{
    transition { _ -> nm(fs_worker, values, address) }
    state nm(fs_worker: &mut FsWorker, values: &mut [u8], address: u64) -> u64 {
        fs_worker.name = NameBox::for_process(7);
        transition fs_worker.name.len <= 48 {
            true -> op(fs_worker, values, address, fs_worker.name.len)
            false -> op(fs_worker, values, address, 48)
        }
    }
    state op(fs_worker: &mut FsWorker, values: &mut [u8], address: u64, name_len: u64) -> u64 {
        let pfd: i32 = fs_worker.fproc_fd;
        fs_worker.fmem_fd = fs_worker.fs.open_at(pfd, fs_worker.name.bytes[0..name_len], 0);
        transition { _ -> r(fs_worker, values, address, 0) }
    }
    state r(fs_worker: &mut FsWorker, values: &mut [u8], address: u64, i: u64) -> u64
    requires 0 <= i && i < 8;
    {
        let memfd: i32 = fs_worker.fmem_fd;
        let want: u64 = fs_worker.fexpected;
        let off: i64 = ((address as i64 in Wrapping) as i64);
        fs_worker.fcount = fs_worker.fs.read_at(memfd, values, want, off);
        let cf: i32 = fs_worker.fmem_fd;
        fs_worker.fscratch = fs_worker.fs.close(cf);
        fs_worker.fscratch = fs_worker.fs.close(fs_worker.fds[i]);
        fs_worker.fscratch = fs_worker.fs.close(fs_worker.fds[0]);
        transition fs_worker.fcount < 0 {
            true -> e2(fs_worker)
            false -> e2(fs_worker)
        }
    }
    state e2(fs_worker: &mut FsWorker) -> u64 {
        0
    }
}

machine App::plain_put(app: &mut App, position: u64, byte: u8) {
    transition position < 64 {
        true -> put(app, position, byte)
        false -> skip(app)
    }
    state put(app: &mut App, position: u64, byte: u8) { app.control[position] = byte; }
    state skip(app: &mut App) {
    }
}

pub data Point { x: u64; }

machine Point::set_x(point: &mut Point, v: u64) {
    point.x = v;
}

machine App::bump_method(app: &mut App, r: &mut Point) {
    transition { _ -> call(app, r) }
    state call(app: &mut App, r: &mut Point) {
        Point::set_x(r, 1);
    }
}

machine App::bump_field(app: &mut App, r: &mut Point) {
    transition { _ -> call(app, r) }
    state call(app: &mut App, r: &mut Point) {
        r.x = 2;
    }
}

machine App::fwd_bump_reborrow(app: &mut App, r: &mut Point) {
    App::bump_method(app, &mut r)
}

machine App::stmt_bare(app: &mut App, r: &mut Point) {
    transition { _ -> s(app, r) }
    state s(app: &mut App, r: &mut Point) {
        App::bump_method(app, &mut r);
    }
}

machine App::reuse_arg(app: &mut App)
reaches Console
{
    transition { _ -> s(app) }
    state s(app: &mut App) {
        let x: i32 = 65;
        app.console.write_byte(x);
        app.console.write_byte(x);
    }
}

machine App::field_arg(app: &mut App)
reaches Console
{
    transition { _ -> s(app) }
    state s(app: &mut App) {
        app.console.write_byte(app.b8 as i32);
    }
}
