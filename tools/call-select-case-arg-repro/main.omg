use omega_language_std::console;
use omega_language_std::filesystem_host;
use omega::language::core::binding;
use call_select_dep::src::lib::Rec;
use call_select_dep::src::lib::Outer;
use call_select_dep::src::lib::Worker;
use call_select_dep::src::lib::ProbeResult;

pub data App {
    console: Binding<Console>;
    worker: Worker;
    outer: Outer;
    control: [u8; 64];
    ctrl_src: [u8; 64];
    pos: u64;
    digit_len: u64;
    b8: u8;
    pt: Point;
    fsw: FsWorker;
}

pub data FsWorker {
    fs: Binding<FilesystemHost>;
    fmem_fd: i32;
    fproc_fd: i32;
    fcount: i64;
    fexpected: u64;
    fpos: u64;
    fscratch: i32;
    control: [u8; 64];
    name: NameBox;
    fds: [i32; 8];
}

pub data NameBox {
    bytes: [u8; 64];
    len: u64;
}

pub machine NameBox::for_process(process_id: u32) -> NameBox {
    NameBox { len: 3 }
}

pub linux_x86_64 machine App::main(this: &mut App)
reaches Console + FilesystemHost
invokes Console;
invokes FilesystemHost;
suspends; blocks;
crashes Abort
crashes Trap
{
    state s(this: &mut App) {
        this.outer.info = Rec { h: 7 };
        transition { _ -> u5(this) }
    }
    // u5: 2-seg receiver scalar call into let + affine-result call + ClosedSum
    state u5(this: &mut App) {
        let h: u64 = get(this.outer.info);
        let p: ProbeResult = probe_u(this.worker, h);
        let ok: bool = succeeded(p);
        transition ok {
            true -> hv(this)
            false -> bad(this)
        }
    }
    state em(this: &mut App) {
        emit(this, this.digit_len);
        transition { _ -> es(this) }
    }
    state es(this: &mut App) {
        emit_slice(this, this.digit_len);
        let hoist1: u64 = mirror_read(this, &mut this.control, this.pos);
        transition block hoist1 {
            _ -> es2(this)
        }
    }
    state es2(this: &mut App) {
        plain_put(this, this.pos, 65);
        stmt_bare(this, &mut this.pt);
        fwd_bump_reborrow(this, &mut this.pt);
        bump_method(this, &mut this.pt);
        bump_field(this, &mut this.pt);
        reuse_arg(this);
        field_arg(this);
        let hoist2: u64 = fs_read(this.fsw, &mut this.control, this.pos);
        transition block hoist2 {
            _ -> es3(this)
        }
    }
    state es3(this: &mut App) {
        transition block read_line(this.console, &mut this.control) {
            _ -> good(this)
        }
    }

    state sf(this: &mut App) {
        let p: ProbeResult = succ_forward(this.worker, &mut this.outer.info);
        let ok: bool = succeeded(p);
        transition ok {
            true -> sf(this)
            false -> bad(this)
        }
    }
    state fr(this: &mut App) {
        let p: ProbeResult = forward_ref(this.worker, &this.outer.info);
        let ok: bool = succeeded(p);
        transition ok {
            true -> fr(this)
            false -> bad(this)
        }
    }
    state fm(this: &mut App) {
        let p: ProbeResult = forward_mut(this.worker, &mut this.outer.info);
        let ok: bool = succeeded(p);
        transition ok {
            true -> hv_in(this)
            false -> bad(this)
        }
    }
    state hv_in(this: &mut App) {
        transition this.pos < 64 {
            true -> hv(this)
            false -> bad(this)
        }
    }
    state hv(this: &mut App) {
        let dv: u64 = hex_value(this.b8);
        this.digit_len = dv;
        transition this.digit_len < 16 {
            true -> slg(this)
            false -> bad(this)
        }
    }
    // mirror: std console read_line shape — selfless states, bare &mut forwards, 2 hops
    state slg(this: &mut App) {
        transition { _ -> em(this) }
    }
    // mirror: bound carrier on a this field (owned, non-borrowed)
    state fw(this: &mut App, fcount: u64)
    requires 0 <= fcount && fcount < 64;
    {
        this.control[fcount] = this.b8;
        transition { _ -> em(this) }
    }
    state good(this: &mut App) {
        exit_process(this.console, 0);
    }
    state bad(this: &mut App) {
        exit_process(this.console, 1);
    }
}

machine slice_chain(out: &mut [u8; 64], fcount: u64, byte: u8) -> u64 {
    transition { _ -> sc(out, fcount, byte) }
    state sc(out: &mut [u8; 64], fcount: u64, byte: u8) -> u64 {
        transition fcount < out.len {
            true -> mid(out, fcount, byte)
            false -> (1)
        }
    }
    state mid(out: &mut [u8; 64], fcount: u64, byte: u8) -> u64 {
        transition fcount < out.len {
            true -> wr(out, fcount, byte)
            false -> (1)
        }
    }
    state wr(out: &mut [u8; 64], fcount: u64, byte: u8) -> u64
    requires 0 <= fcount && fcount < out.len;
    {
        out[fcount] = byte;
        transition { _ -> (0) }
    }
}

// runtime &mut slice bound — does [0..out.len] discharge on a &mut [u8]?
// two-len-conjunct arm -> two bounded params + bool-var arm -> re-guard
machine two_len_gate(out: &mut [u8; 64], q: u64, j: u64, byte: u8) -> u64 {
    transition { _ -> g(out, q, j, byte) }
    state g(out: &mut [u8; 64], q: u64, j: u64, byte: u8) -> u64 {
        transition q < out.len && j < out.len {
            true -> acc(out, q, j, byte)
            false -> (1)
        }
    }
    state acc(out: &mut [u8; 64], q: u64, j: u64, byte: u8) -> u64
    requires 0 <= j && j < out.len;
    {
        let cur: u8 = out[j];
        transition cur < byte {
            true -> (0)
            false -> gq(out, q, byte)
        }
    }
    state gq(out: &mut [u8; 64], q: u64, byte: u8) -> u64 {
        transition q < out.len {
            true -> sgw(out, q, byte)
            false -> (1)
        }
    }
    state sgw(out: &mut [u8; 64], q: u64, byte: u8) -> u64 {
        transition q < out.len {
            true -> ssw(out, q, byte)
            false -> (1)
        }
    }
    state ssw(out: &mut [u8; 64], q: u64, byte: u8) -> u64
    requires 0 <= q && q < out.len;
    {
        out[q] = byte;
        transition { _ -> (0) }
    }
}

machine mut_slice_write(out: &mut [u8], idx: u64, byte: u8) -> u64 {
    transition { _ -> mswg(out, idx, byte) }
    state mswg(out: &mut [u8], idx: u64, byte: u8) -> u64 {
        transition idx < out.len {
            true -> msw(out, idx, byte)
            false -> (1)
        }
    }
    state msw(out: &mut [u8], idx: u64, byte: u8) -> u64
    requires 0 <= idx && idx < out.len;
    {
        out[idx] = byte;
        transition { _ -> (0) }
    }
}

// mirror: copy/store t[p]=s[p] — bound on the & view + literal arm-guard for &mut side
machine copy_loop(dst: &mut [u8; 64], src: &[u8]) -> u64 {
    transition { _ -> cp(dst, src, 0) }
    state cp(dst: &mut [u8; 64], src: &[u8], position: u64) -> u64 {
        transition position < src.len && position < 64 {
            true -> st(dst, src, position)
            false -> (position)
        }
    }
    state st(dst: &mut [u8; 64], src: &[u8], position: u64) -> u64
    requires 0 <= position && position < src.len;
    {
        dst[position] = src[position];
        transition { _ -> cp(dst, src, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
}

machine hex_value(byte: u8) -> u64 {
    transition byte >= 48 && byte <= 57 {
        true -> dec(byte)
        false -> alpha(byte)
    }
    state dec(byte: u8) -> u64 {
        (((byte as u64) as u64 in Wrapping) - (48 as u64 in Wrapping)) as u64
    }
    state alpha(byte: u8) -> u64 {
        transition byte >= 97 && byte <= 102 {
            true -> lower(byte)
            false -> upper(byte)
        }
    }
    state lower(byte: u8) -> u64 {
        (((byte as u64) as u64 in Wrapping) - (87 as u64 in Wrapping)) as u64
    }
    state upper(byte: u8) -> u64 {
        transition byte >= 65 && byte <= 70 {
            true -> up(byte)
            false -> invalid(byte)
        }
    }
    state up(byte: u8) -> u64 {
        (((byte as u64) as u64 in Wrapping) - (55 as u64 in Wrapping)) as u64
    }
    state invalid(byte: u8) -> u64 {
        16
    }
}

machine App::emit(this: &mut App, v: u64)
reaches Console
{
    transition { _ -> e1(this, v) }
    state e1(this: &mut App, v: u64) {
        write_line(this.console, "x");
        transition { _ -> e2(this) }
    }
    state e2(this: &mut App) {
    }
}

machine App::emit_slice(this: &mut App, len: u64)
reaches Console
{
    transition { _ -> bound(this, len) }
    state bound(this: &mut App, len: u64) {
        transition len <= 64 {
            true -> at(this, 0, len)
            false -> e2(this)
        }
    }
    state at(this: &mut App, i: u64, len: u64)
    requires 0 <= len && len <= 64;
    {
        transition i < len {
            true -> pb(this, i, len)
            false -> nl(this)
        }
    }
    state pb(this: &mut App, i: u64, len: u64)
    requires 0 <= len && len <= 64;
    {
        transition i < 64 {
            true -> wb(this, i, len)
            false -> nl(this)
        }
    }
    state wb(this: &mut App, i: u64, len: u64)
    requires 0 <= i && i < 64 && 0 <= len && len <= 64;
    {
        let b: i32 = this.control[i] as i32;
        write_byte(this.console, b);
        transition { _ -> at(this, i + 1, len) }
    }
    state nl(this: &mut App) {
        write_byte(this.console, 10);
        transition { _ -> e2(this) }
    }
    state e2(this: &mut App) {
    }
}

machine App::mirror_read(this: &mut App, values: &mut [u8; 64], address: u64) -> u64
reaches Console
suspends; blocks;
{
    transition { _ -> r(this, values, address) }
    state r(this: &mut App, values: &mut [u8; 64], address: u64) -> u64 {
        let want: u64 = this.digit_len;
        let offset: i64 = ((address as i64 in Wrapping) as i64);
        write(this.console, &this.control[0..64]);
        transition block read_line(this.console, &mut this.control) {
            _ -> e2(this)
        }
    }
    state e2(this: &mut App) -> u64 {
        0
    }
}

machine FsWorker::fs_read(this: &mut FsWorker, values: &mut [u8], address: u64) -> u64
reaches FilesystemHost
invokes FilesystemHost;
suspends; blocks;
{
    transition { _ -> nm(this, values, address) }
    state nm(this: &mut FsWorker, values: &mut [u8], address: u64) -> u64 {
        this.name = NameBox::for_process(7);
        transition this.name.len <= 48 {
            true -> op(this, values, address, this.name.len)
            false -> op(this, values, address, 48)
        }
    }
    state op(this: &mut FsWorker, values: &mut [u8], address: u64, name_len: u64) -> u64 {
        let pfd: i32 = this.fproc_fd;
        this.fmem_fd = open_at(this.fs, pfd, this.name.bytes[0..name_len], 0);
        transition { _ -> r(this, values, address, 0) }
    }
    state r(this: &mut FsWorker, values: &mut [u8], address: u64, i: u64) -> u64
    requires 0 <= i && i < 8;
    {
        let memfd: i32 = this.fmem_fd;
        let want: u64 = this.fexpected;
        let off: i64 = ((address as i64 in Wrapping) as i64);
        this.fcount = read_at(this.fs, memfd, values, want, off);
        let cf: i32 = this.fmem_fd;
        this.fscratch = close(this.fs, cf);
        this.fscratch = close(this.fs, this.fds[i]);
        this.fscratch = close(this.fs, this.fds[0]);
        transition this.fcount < 0 {
            true -> e2(this)
            false -> e2(this)
        }
    }
    state e2(this: &mut FsWorker) -> u64 {
        0
    }
}

machine App::plain_put(this: &mut App, position: u64, byte: u8) {
    transition position < 64 {
        true -> put(this, position, byte)
        false -> skip(this)
    }
    state put(this: &mut App, position: u64, byte: u8) { this.control[position] = byte; }
    state skip(this: &mut App) {
    }
}

pub data Point { x: u64; }

machine Point::set_x(this: &mut Point, v: u64) {
    this.x = v;
}

machine App::bump_method(this: &mut App, r: &mut Point) {
    transition { _ -> call(this, r) }
    state call(this: &mut App, r: &mut Point) {
        set_x(r, 1);
    }
}

machine App::bump_field(this: &mut App, r: &mut Point) {
    transition { _ -> call(this, r) }
    state call(this: &mut App, r: &mut Point) {
        r.x = 2;
    }
}

machine App::fwd_bump_reborrow(this: &mut App, r: &mut Point) {
    let hoist3: u64 = bump_method(this, &mut r);
    (hoist3)
}

machine App::stmt_bare(this: &mut App, r: &mut Point) {
    transition { _ -> s(this, r) }
    state s(this: &mut App, r: &mut Point) {
        bump_method(this, &mut r);
    }
}

machine App::reuse_arg(this: &mut App)
reaches Console
{
    transition { _ -> s(this) }
    state s(this: &mut App) {
        let x: i32 = 65;
        write_byte(this.console, x);
        write_byte(this.console, x);
    }
}

machine App::field_arg(this: &mut App)
reaches Console
{
    transition { _ -> s(this) }
    state s(this: &mut App) {
        write_byte(this.console, this.b8 as i32);
    }
}
