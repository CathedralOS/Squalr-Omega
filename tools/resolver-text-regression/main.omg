// Expected exit: 0. Parsed symbol names must retain the bytes actually copied.
use squalr_engine_api::src::structures::structs::symbolic_resolver_relative_symbol_path::SymbolicResolverRelativeSymbolPath;

machine main() crashes Trap {
    single_name();
    dotted_offset();
    empty_path();
}
machine single_name() crashes Trap {
    let path: SymbolicResolverRelativeSymbolPath = SymbolicResolverRelativeSymbolPath::from_dot_path("abc");
    let mut text: [u8; 256];
    let length: u64 = SymbolicResolverRelativeSymbolPath::display_text(&path, &mut text);
    transition length == 3u64 && text[0] == 97u8 && text[1] == 98u8 && text[2] == 99u8 && text[3] == 0u8 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
machine dotted_offset() crashes Trap {
    let path: SymbolicResolverRelativeSymbolPath = SymbolicResolverRelativeSymbolPath::from_dot_path("abc.def+0x10");
    let mut text: [u8; 256];
    text[12] = 213;
    let length: u64 = SymbolicResolverRelativeSymbolPath::display_text(&path, &mut text);
    transition length == 12 && text[0] == 97 && text[1] == 98 && text[2] == 99
        && text[3] == 46 && text[4] == 100 && text[5] == 101 && text[6] == 102
        && text[7] == 43 && text[8] == 48 && text[9] == 120
        && text[10] == 49 && text[11] == 48 && text[12] == 213 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
machine empty_path() crashes Trap {
    let path: SymbolicResolverRelativeSymbolPath = SymbolicResolverRelativeSymbolPath::from_dot_path("");
    let mut text: [u8; 256];
    text[0] = 197;
    let length: u64 = SymbolicResolverRelativeSymbolPath::display_text(&path, &mut text);
    transition length == 0 && text[0] == 197 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
