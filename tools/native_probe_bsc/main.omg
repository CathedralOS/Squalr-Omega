use omega_language_std::filesystem_host;
use omega::language::core::binding;

pub data Main {
    host: Binding<FilesystemHost>;
    fd: i32;
}

pub linux_x86_64 machine Main::main(&mut self)
reaches FilesystemHost
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    transition { _ -> go() }

    state go(&mut self) {
        let opened: i32 = self.host.open("/proc", 65536);
        self.fd = opened;
        transition opened >= 0 {
            true -> ok()
            false -> bad()
        }
    }

    state ok(&mut self) {
        let fd2: i32 = self.fd;
        let _c: i32 = self.host.close(fd2);
        transition { _ -> done() }
    }

    state bad(&mut self) {
        transition { _ -> done() }
    }

    state done(&mut self) {
    }
}
