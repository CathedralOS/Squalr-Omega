use omega_language_std::filesystem_host;
use omega::language::core::binding;

pub data Main {
    host: Binding<FilesystemHost>;
    fd: i32;
}

pub linux_x86_64 machine Main::main(main: &mut Main)
reaches FilesystemHost
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    transition { _ -> go(main) }

    state go(main: &mut Main) {
        let opened: i32 = main.host.open("/proc", 65536);
        main.fd = opened;
        transition opened >= 0 {
            true -> ok(main)
            false -> bad(main)
        }
    }

    state ok(main: &mut Main) {
        let fd2: i32 = main.fd;
        let _c: i32 = main.host.close(fd2);
        transition { _ -> done(main) }
    }

    state bad(main: &mut Main) {
        transition { _ -> done(main) }
    }

    state done(main: &mut Main) {
    }
}
