use omega_language_std::filesystem_host;
use omega::language::core::binding;

pub data Main {
    host: Binding<FilesystemHost>;
    fd: i32;
}

pub linux_x86_64 machine Main::main(this: &mut Main)
reaches FilesystemHost
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    transition { _ -> go(this) }

    state go(this: &mut Main) {
        let opened: i32 = open(this.host, "/proc", 65536);
        this.fd = opened;
        transition opened >= 0 {
            true -> ok(this)
            false -> bad(this)
        }
    }

    state ok(this: &mut Main) {
        let fd2: i32 = this.fd;
        let _c: i32 = close(this.host, fd2);
        transition { _ -> done(this) }
    }

    state bad(this: &mut Main) {
        transition { _ -> done(this) }
    }

    state done(this: &mut Main) {
    }
}
