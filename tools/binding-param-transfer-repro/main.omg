use omega::language::core::binding;
use omega_language_std::console;

pub data CommandLineParse { case Refused; case Parsed(command: CommandLineCommand); }
pub data CommandLineCommand { case Privileged(command: PrivilegedCommand); }
pub data PrivilegedCommand { case Scan(request: ScanRequest); case Other; }
pub data ScanRequest { n: u64; }
pub data PrivilegedCommandResponse { case ScanResults(response: ScanResultsResponse); case Other; }
pub data ScanResultsResponse { case List(response: ScanResultsListResponse); case Other; }
pub data ScanResultsListResponse { count: u64; }
pub data CommandLineParser {}

pub machine CommandLineParser::parse(line: &[u8]) -> CommandLineParse {
    (CommandLineParse::Refused)
}
pub machine ScanResultsListResponse::default() -> ScanResultsListResponse {
    (ScanResultsListResponse { count: 0 })
}

pub data Engine { pad: u64; scratch_command: CommandLineCommand; }

pub machine Engine::dispatch_command(engine: &mut Engine, pc: &PrivilegedCommand) -> PrivilegedCommandResponse
crashes Abort
{
    (PrivilegedCommandResponse::ScanResults { response: ScanResultsResponse::List { response: ScanResultsListResponse { count: 0 } } })
}

pub machine Engine::dispatch_list(engine: &mut Engine, privileged_command: &PrivilegedCommand) -> ScanResultsListResponse
crashes Abort
{
    let response: PrivilegedCommandResponse = Engine::dispatch_command(engine, privileged_command);
    transition response {
        PrivilegedCommandResponse::ScanResults { response } -> extract(response)
        _ -> (ScanResultsListResponse::default())
    }
    state extract(response: ScanResultsResponse) -> ScanResultsListResponse {
        transition response {
            ScanResultsResponse::List { response } -> (response)
            _ -> (ScanResultsListResponse::default())
        }
    }
}

pub machine Engine::unwrap_command(engine: &Engine, cmd: &CommandLineCommand) -> &PrivilegedCommand {
    transition cmd { CommandLineCommand::Privileged { command } -> (&command) }
}

pub machine Engine::unwrap_parsed(engine: &Engine, parsed: &CommandLineParse) -> &CommandLineCommand {
    transition parsed {
        CommandLineParse::Parsed { command } -> (&command)
        _ -> (&engine.scratch_command)
    }
}

pub machine Engine::dispatch_parsed_list(engine: &mut Engine, parsed: &CommandLineParse) -> ScanResultsListResponse
crashes Abort
{
    let cmd: &CommandLineCommand = Engine::unwrap_parsed(engine, parsed);
    let pc: &PrivilegedCommand = Engine::unwrap_command(engine, cmd);
    Engine::dispatch_list(engine, pc)
}

pub data Cli { engine: Engine; last_list: ScanResultsListResponse; line_buffer: [u8; 512]; console: Binding<Console>; }

pub machine Cli::parse_line(cli: &mut Cli, count: u64, end_after: bool) -> bool
crashes Abort
{
    let parse: CommandLineParse = CommandLineParser::parse(&cli.line_buffer);
    transition { _ -> dispatched(cli, parse, end_after) }
    state dispatched(cli: &mut Cli, parse: CommandLineParse, end_after: bool) {
        let list: ScanResultsListResponse = Engine::dispatch_parsed_list(&mut cli.engine, &parse);
        transition parse {
            CommandLineParse::Parsed { command } -> storing(cli, list, end_after)
            _ -> refuse(cli, end_after)
        }
    }
    state storing(cli: &mut Cli, list: ScanResultsListResponse, end_after: bool) {
        transition { _ -> donep(cli) }
    }
    state refuse(cli: &mut Cli, end_after: bool) {
        transition { _ -> donep(cli) }
    }
    state donep(cli: &mut Cli) -> bool {
        (true)
    }
}

pub data Entry { cli: Cli; }

pub linux_x86_64 machine Entry::main(entry: &mut Entry)
crashes Abort
{
    let b: bool = Cli::parse_line(&mut entry.cli, 0, false);
    transition { _ -> done(entry) }
    state done(entry: &mut Entry) {}
}
