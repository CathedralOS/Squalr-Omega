use omega_language_std::console;
use omega::language::core::binding;

// Minimal repro: calls carrying `&`/`&mut` arguments are unlowerable.
//
// `omega run main.omg` at Omega pins `bb092d497db` and `499211f463`
// (identical results at both; originally filed at
// `3a29bac97f7`/`f6c7c4e4fd`) — Fixture::run is omitted at local
// construction with `call operation: structural arguments: caller
// structural result`, and the entry machine's unit plan is then omitted
// at the unavailable callee. Field-place `&mut` arguments and forwarded
// `&mut` parameters are admitted at bb092 (verified natively); `&`-borrows
// of named locals still are not — see README.md for the reduced arm.
//
// Variant matrix (same package, one line changed each time):
//   - &local arg, structural result:   Small::make(&arr) -> Small — same
//     omission, in scalar callees, entry-state prefixes, and this command
//     callee (all three contexts identical).
//   - &field arg, structural ref type: Small::read(&self.arr) -> u64 —
//     admitted by local construction, then rejected by target lowering:
//     UnsupportedControlFlow at borrowed_calls.rs:296 (requires a
//     primitive-reference parameter).
//   - &field arg, primitive ref param: Small::read_scalar(&self.z) -> u64
//     where read_scalar(a: &u64) -> u64 { a } — the callee is omitted at
//     `signature`: a `&u64` formal does not plan at all.
//
// Only `&mut self` receivers on field places and scalar by-value
// arguments are admitted in the entry cone; every &-parameter to user
// data — whether borrowed from a local or a field place — is rejected,
// so machines like ElementScanner::scan_snapshot(&mut, &mut, &mut) and
// DataTypeRef::new(&id) can never be invoked natively.
pub data Small {
    v: u64;
}

pub machine Small::read(a: &[u64; 2]) -> u64 {
    a[0]
}

pub data Fixture {
    made: u64;
}

pub machine Fixture::run(&mut self) {
    let arr: [u64; 2] = [7, 8];
    let v: u64 = Small::read(&arr);
    self.made = v;
}

pub data Main {
    console: Binding<Console>;
    fixture: Fixture;
}

pub machine Main::main(&mut self)
reaches Console
invokes Console;
{
    self.fixture.run();
    let made: u64 = self.fixture.made;
    transition made == 7 {
        true -> done()
        false -> fail()
    }

    state done(&mut self) {
        self.console.write_line("structural-cap probe: PASS");
    }
    state fail(&mut self) {
        self.console.write_line("structural-cap probe: FAIL");
    }
}
