use omega::language::core::binding;
use omega_language_std::console;

pub data CommandLineParse { case Refused; case Parsed(command: CommandLineCommand); }
pub data CommandLineCommand { case Privileged(command: PrivilegedCommand); }
pub data PrivilegedCommand { case Scan(request: ScanRequest); case Other; }
pub data ScanRequest { n: u64; }
pub data PrivilegedCommandResponse { case ScanResults(response: ScanResultsResponse); case Other; }
pub data ScanResultsResponse { case List(response: ScanResultsListResponse); case Other; }
pub data ScanResultsListResponse { count: u64; }
pub data CommandLineParser {}

pub machine CommandLineParser::parse(line: &[u8]) -> CommandLineParse {
    (CommandLineParse::Refused)
}
pub machine ScanResultsListResponse::default() -> ScanResultsListResponse {
    (ScanResultsListResponse { count: 0 })
}

pub data Engine { pad: u64; scratch_command: CommandLineCommand; }

pub machine Engine::dispatch_command(&mut self, pc: &PrivilegedCommand) -> PrivilegedCommandResponse
crashes Abort
{
    (PrivilegedCommandResponse::ScanResults { response: ScanResultsResponse::List { response: ScanResultsListResponse { count: 0 } } })
}

pub machine Engine::dispatch_list(&mut self, privileged_command: &PrivilegedCommand) -> ScanResultsListResponse
crashes Abort
{
    let response: PrivilegedCommandResponse = self.dispatch_command(privileged_command);
    transition response {
        PrivilegedCommandResponse::ScanResults { response } -> extract(response)
        _ -> (ScanResultsListResponse::default())
    }
    state extract(response: ScanResultsResponse) -> ScanResultsListResponse {
        transition response {
            ScanResultsResponse::List { response } -> (response)
            _ -> (ScanResultsListResponse::default())
        }
    }
}

pub machine Engine::unwrap_command(&self, cmd: &CommandLineCommand) -> &PrivilegedCommand {
    transition cmd { CommandLineCommand::Privileged { command } -> (&command) }
}

pub machine Engine::unwrap_parsed(&self, parsed: &CommandLineParse) -> &CommandLineCommand {
    transition parsed {
        CommandLineParse::Parsed { command } -> (&command)
        _ -> (&self.scratch_command)
    }
}

pub machine Engine::dispatch_parsed_list(&mut self, parsed: &CommandLineParse) -> ScanResultsListResponse
crashes Abort
{
    let cmd: &CommandLineCommand = self.unwrap_parsed(parsed);
    let pc: &PrivilegedCommand = self.unwrap_command(cmd);
    self.dispatch_list(pc)
}

pub data Cli { engine: Engine; last_list: ScanResultsListResponse; line_buffer: [u8; 512]; }

pub machine Cli::parse_line(&mut self, count: u64, end_after: bool) -> bool
crashes Abort
invokes Console;
{
    let parse: CommandLineParse = CommandLineParser::parse(&self.line_buffer);
    transition { _ -> dispatched(parse, end_after) }
    state dispatched(&mut self, parse: CommandLineParse, end_after: bool) {
        transition parse {
            CommandLineParse::Parsed { command } -> running(command, end_after)
            _ -> refuse(end_after)
        }
    }
    state running(&mut self, command: CommandLineCommand, end_after: bool)
    {
        let pc: PrivilegedCommand = self.engine.unwrap_command(command);
        let list: ScanResultsListResponse = self.engine.dispatch_list(&pc);
        transition { _ -> storing(list, end_after) }
    }
    state storing(&mut self, list: ScanResultsListResponse, end_after: bool) {
        Console::write_line("stored");
        transition { _ -> donep() }
    }
    state refuse(&mut self, end_after: bool) {
        transition { _ -> donep() }
    }
    state donep(&mut self) -> bool {
        (true)
    }
}

pub data Entry { cli: Cli; }

pub linux_x86_64 machine Entry::main(&mut self)
crashes Abort
invokes Console;
{
    let b: bool = self.cli.parse_line(0, false);
    transition { _ -> done() }
    state done(&mut self) {}
}
