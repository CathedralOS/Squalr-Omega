use omega::language::core::binding;
use omega_language_std::console;

public data CommandLineParse { case Refused; case Parsed(command: CommandLineCommand); }
public data CommandLineCommand { case Privileged(command: PrivilegedCommand); }
public data PrivilegedCommand { case Scan(request: ScanRequest); case Other; }
public data ScanRequest { n: u64; }
public data PrivilegedCommandResponse { case ScanResults(response: ScanResultsResponse); case Other; }
public data ScanResultsResponse { case List(response: ScanResultsListResponse); case Other; }
public data ScanResultsListResponse { count: u64; }
public data CommandLineParser {}

public machine CommandLineParser::parse(line: &[u8]) -> CommandLineParse {
    (CommandLineParse::Refused)
}
public machine ScanResultsListResponse::default() -> ScanResultsListResponse {
    (ScanResultsListResponse { count: 0 })
}

public data Engine { pad: u64; scratch_command: CommandLineCommand; }

public machine Engine::dispatch_command(this: &mut Engine, pc: &PrivilegedCommand) -> PrivilegedCommandResponse
crashes Abort
{
    (PrivilegedCommandResponse::ScanResults { response: ScanResultsResponse::List { response: ScanResultsListResponse { count: 0 } } })
}

public machine Engine::dispatch_list(this: &mut Engine, privileged_command: &PrivilegedCommand) -> ScanResultsListResponse
crashes Abort
{
    let response: PrivilegedCommandResponse = dispatch_command(this, privileged_command);
    transition response {
        PrivilegedCommandResponse::ScanResults { response } -> extract(response)
        _ -> (ScanResultsListResponse::default())
    }
    machine extract(response: ScanResultsResponse) -> ScanResultsListResponse {
        transition response {
            ScanResultsResponse::List { response } -> (response)
            _ -> (ScanResultsListResponse::default())
        }
    }
}

public machine Engine::unwrap_command(this: &Engine, cmd: &CommandLineCommand) -> &PrivilegedCommand {
    transition cmd { CommandLineCommand::Privileged { command } -> (&command) }
}

public machine Engine::unwrap_parsed(this: &Engine, parsed: &CommandLineParse) -> &CommandLineCommand {
    transition parsed {
        CommandLineParse::Parsed { command } -> (&command)
        _ -> (&this.scratch_command)
    }
}

public machine Engine::dispatch_parsed_list(this: &mut Engine, parsed: &CommandLineParse) -> ScanResultsListResponse
crashes Abort
{
    let cmd: &CommandLineCommand = unwrap_parsed(this, parsed);
    let pc: &PrivilegedCommand = unwrap_command(this, cmd);
    let hoist1: ScanResultsListResponse = dispatch_list(this, pc);
    (hoist1)
}

public data Cli { engine: Engine; last_list: ScanResultsListResponse; line_buffer: [u8; 512]; }

public machine Cli::parse_line(this: &mut Cli, count: u64, end_after: bool) -> bool
crashes Abort
invokes Console;
{
    let parse: CommandLineParse = CommandLineParser::parse(&this.line_buffer);
    transition { _ -> dispatched(this, parse, end_after) }
    machine dispatched(this: &mut Cli, parse: CommandLineParse, end_after: bool) {
        transition parse {
            CommandLineParse::Parsed { command } -> running(this, command, end_after)
            _ -> refuse(this, end_after)
        }
    }
    machine running(this: &mut Cli, command: CommandLineCommand, end_after: bool)
    {
        let pc: PrivilegedCommand = unwrap_command(this.engine, command);
        let list: ScanResultsListResponse = dispatch_list(this.engine, &pc);
        transition { _ -> storing(this, list, end_after) }
    }
    machine storing(this: &mut Cli, list: ScanResultsListResponse, end_after: bool) {
        Console::write_line("stored");
        transition { _ -> donep(this) }
    }
    machine refuse(this: &mut Cli, end_after: bool) {
        transition { _ -> donep(this) }
    }
    machine donep(this: &mut Cli) -> bool {
        (true)
    }
}

public data Entry { cli: Cli; }

public linux_x86_64 machine Entry::main(this: &mut Entry)
crashes Abort
invokes Console;
{
    let b: bool = parse_line(this.cli, 0, false);
    transition { _ -> done(this) }
    machine done(this: &mut Entry) {}
}
