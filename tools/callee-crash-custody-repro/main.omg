use omega_language_std::console;
use omega::language::core::service;

pub data Main {
    console: Binding<Console>;
    driver: Driver;
}

pub data Driver {
    engine: Engine;
}

pub data Engine {
    n: u64;
}

machine Engine::open(&mut self, id: u32)
crashes Trap
{
    transition id == 0 {
        true -> violated()
        false -> ok(id)
    }
    state violated(&mut self) {
        crash Trap;
    }
    state ok(&mut self, id: u32) {
        self.n = id as u64;
    }
}

machine Driver::run(&mut self)
crashes Trap
{
    self.engine.open(1);
}

pub machine Main::main(&mut self)
reaches Console
invokes Console;
crashes Trap
{
    self.driver.run();
    self.console.write_line("hi");
}
