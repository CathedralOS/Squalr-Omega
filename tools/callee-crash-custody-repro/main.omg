use {omega_language_std}/console.omg;

public data Main {
    console: Binding<|console|::Console>;
    driver: Driver;
}

public data Driver {
    engine: Engine;
}

public data Engine {
    n: u64;
}

machine Engine::open(this: &mut Engine, id: u32)
crashes Trap
{
    transition id == 0 {
        true -> violated(this)
        false -> ok(this, id)
    }
    machine violated(this: &mut Engine) {
        crash Trap;
    }
    machine ok(this: &mut Engine, id: u32) {
        this.n = id as u64;
    }
}

machine Driver::run(this: &mut Driver)
crashes Trap
{
    open(this.engine, 1);
}

public machine Main::main(this: &mut Main)
reaches |console|::Console
invokes |console|::Console;
crashes Trap
{
    run(this.driver);
    write_line(this.console, "hi");
}
