use omega_language_std::console;
use omega::language::core::binding;

public data Main {
    console: Binding<Console>;
    driver: Driver;
}

public data Driver {
    engine: Engine;
}

public data Engine {
    n: u64;
}

machine Engine::open(this: &mut Engine, id: u32)
crashes Trap
{
    transition id == 0 {
        true -> violated(this)
        false -> ok(this, id)
    }
    machine violated(this: &mut Engine) {
        crash Trap;
    }
    machine ok(this: &mut Engine, id: u32) {
        this.n = id as u64;
    }
}

machine Driver::run(this: &mut Driver)
crashes Trap
{
    open(this.engine, 1);
}

public machine Main::main(this: &mut Main)
reaches Console
invokes Console;
crashes Trap
{
    run(this.driver);
    write_line(this.console, "hi");
}
