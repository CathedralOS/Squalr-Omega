use omega_language_std::console;
use omega::language::core::binding;

pub data Main {
    console: Binding<Console>;
    driver: Driver;
}

pub data Driver {
    engine: Engine;
}

pub data Engine {
    n: u64;
}

machine Engine::open(this: &mut Engine, id: u32)
crashes Trap
{
    transition id == 0 {
        true -> violated(this)
        false -> ok(this, id)
    }
    state violated(this: &mut Engine) {
        crash Trap;
    }
    state ok(this: &mut Engine, id: u32) {
        this.n = id as u64;
    }
}

machine Driver::run(this: &mut Driver)
crashes Trap
{
    open(this.engine, 1);
}

pub machine Main::main(this: &mut Main)
reaches Console
invokes Console;
crashes Trap
{
    run(this.driver);
    write_line(this.console, "hi");
}
