use omega_language_std::console;
use omega::language::core::binding;

pub data Main {
    console: Binding<Console>;
    driver: Driver;
}

pub data Driver {
    engine: Engine;
}

pub data Engine {
    n: u64;
}

machine Engine::open(engine: &mut Engine, id: u32)
crashes Trap
{
    transition id == 0 {
        true -> violated(engine)
        false -> ok(engine, id)
    }
    state violated(engine: &mut Engine) {
        crash Trap;
    }
    state ok(engine: &mut Engine, id: u32) {
        engine.n = id as u64;
    }
}

machine Driver::run(driver: &mut Driver)
crashes Trap
{
    Engine::open(&mut driver.engine, 1);
}

pub machine Main::main(main: &mut Main)
reaches Console
invokes Console;
crashes Trap
{
    Driver::run(&mut main.driver);
    main.console.write_line("hi");
}
