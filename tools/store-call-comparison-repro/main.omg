use omega_language_std::console;
use omega_language_std::filesystem_host;
use omega::language::core::binding;

pub data Main {
    console: Binding<Console>;
    raw_fs: Binding<FilesystemHost>;
    fd: i32;
    closed: bool;
}

pub linux_x86_64 machine Main::main(this: &mut Main)
reaches Console + FilesystemHost
invokes Console;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    this.fd = open(this.raw_fs, "/tmp/store-call-comparison-repro.control", 0);
    this.closed = close(this.raw_fs, this.fd) != 0;
    exit_process(this.console, 0);
}
