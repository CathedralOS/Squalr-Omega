use omega_language_std::console;
use omega_language_std::filesystem_host;
use omega::language::core::binding;

pub data Main {
    console: Binding<Console>;
    raw_fs: Binding<FilesystemHost>;
    fd: i32;
    closed: bool;
}

pub linux_x86_64 machine Main::main(main: &mut Main)
reaches Console + FilesystemHost
invokes Console;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    main.fd = main.raw_fs.open("/tmp/store-call-comparison-repro.control", 0);
    main.closed = main.raw_fs.close(main.fd) != 0;
    main.console.exit_process(0);
}
