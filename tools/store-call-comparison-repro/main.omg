use omega_language_std::console;
use omega_language_std::filesystem_host;
use omega::language::core::binding;

pub data Main {
    console: Binding<Console>;
    raw_fs: Binding<FilesystemHost>;
    fd: i32;
    closed: bool;
}

pub linux_x86_64 machine Main::main(&mut self)
reaches Console + FilesystemHost
invokes Console;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    self.fd = self.raw_fs.open("/tmp/store-call-comparison-repro.control", 0);
    self.closed = self.raw_fs.close(self.fd) != 0;
    self.console.exit_process(0);
}
