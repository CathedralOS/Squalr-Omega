use {omega_language_std}/console.omg;
use {omega_language_std}/filesystem_host.omg;

public data Main {
    console: Binding<|console|::Console>;
    raw_fs: Binding<FilesystemHost>;
    fd: i32;
    closed: bool;
}

public linux_x86_64 machine Main::main(this: &mut Main)
reaches |console|::Console + FilesystemHost
invokes |console|::Console;
invokes FilesystemHost;
crashes Abort
crashes Trap
{
    this.fd = open(this.raw_fs, "/tmp/store-call-comparison-repro.control", 0);
    this.closed = close(this.raw_fs, this.fd) != 0;
    exit_process(this.console, 0);
}
