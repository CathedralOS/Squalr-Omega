// Package boundary and internal edges mirror upstream plugins/squalr-plugin-memory-view-dolphin/Cargo.toml.
machine build(builder: &mut Build) {
    Build::package(builder, "squalr_plugin_memory_view_dolphin");
    Build::depend(builder, Source::Path { location: "../../squalr-engine-api" });
    Build::depend(builder, Source::Path { location: "../../squalr-engine-targets-native" });
}
