// Package boundary and internal edges mirror upstream plugins/squalr-plugin-memory-view-dolphin/Cargo.toml.
machine build(builder: &mut Build) {
    builder.package("squalr-plugin-memory-view-dolphin");
    builder.depend(Source::Path { location: "../../squalr-engine-api" });
    builder.depend(Source::Path { location: "../../squalr-engine-targets-native" });
}
