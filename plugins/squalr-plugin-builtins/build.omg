// Package boundary and internal edges mirror upstream plugins/squalr-plugin-builtins/Cargo.toml.
machine build(builder: &mut Build) {
    Build::package(builder, "squalr_plugin_builtins");
    Build::depend(builder, Source::Path { location: "../../squalr-engine-api" });
    Build::depend(builder, Source::Path { location: "../squalr-plugin-data-types-24bit" });
    Build::depend(builder, Source::Path { location: "../squalr-plugin-instructions-arm" });
    Build::depend(builder, Source::Path { location: "../squalr-plugin-instructions-powerpc" });
    Build::depend(builder, Source::Path { location: "../squalr-plugin-instructions-x86" });
    Build::depend(builder, Source::Path { location: "../squalr-plugin-memory-view-dolphin" });
    Build::depend(builder, Source::Path { location: "../squalr-plugin-binary-symbols" });
    Build::depend(builder, Source::Path { location: "../squalr-plugin-debuggers-native" });
}
