module src::settings::project_settings_config;

use squalr_engine_api::src::structures::settings::project_settings::ProjectSettings;

// Port of settings/project_settings_config.rs — the settings record plus
// its on-disk path, instance-carried. Upstream keeps one process-global
// `Arc<RwLock<ProjectSettingsConfig>>` behind a `OnceLock`; Omega carries
// the config in the caller's state instead — named deviation (no static
// mutable storage, and callers thread the instance explicitly).
//
// Deferrals, all downstream of the serde_json-equivalent project-file
// codec (TASKS.md PROJECT-SERIALIZATION): the config-file read + parse
// inside upstream `new`, and `save_config`'s pretty-JSON write — the
// warn-and-default arms that make a corrupt or unreadable file fall back
// are part of that leg and land with it.
//
// Host-facility deviations: upstream `default_projects_root` prefers
// `directories::UserDirs` documents/Squalr and `default_config_path`
// resolves `current_exe().parent()` — no documents-directory or
// current-executable provider exists in the boundary today, so the port
// stores upstream's own relative fallbacks ("./Squalr" and
// "./project_settings.json" — the non-Android arms' fallback spelling).
pub data ProjectSettingsConfig {
    config: ProjectSettings;
    config_file: [u8; 512];
    config_file_len: u64;
}

// Upstream `new` minus the file-load branch: defaults plus the resolved
// config path. The read+parse arm is the named codec blocker above.
pub machine ProjectSettingsConfig::new() -> ProjectSettingsConfig {
    let mut created: ProjectSettingsConfig = ProjectSettingsConfig {
        config: ProjectSettings::default(),
        config_file_len: 0,
    };
    created.set_config_file(ProjectSettingsConfig::default_config_path());
    (created)
}

// Upstream `default_config_path` — "./project_settings.json" (see the
// host-facility deviation in the module header).
pub machine ProjectSettingsConfig::default_config_path() -> &[u8] {
    ("./project_settings.json")
}

// Upstream `default_projects_root` — "./Squalr" (upstream's own
// non-Android fallback; see the host-facility deviation in the header).
pub machine ProjectSettingsConfig::default_projects_root() -> &[u8] {
    ("./Squalr")
}

// Upstream `default_project_settings` — projects_root carries the
// default root, the remaining fields are upstream `Default`.
pub machine ProjectSettingsConfig::default_project_settings() -> ProjectSettings {
    (ProjectSettings::default())
}

pub machine ProjectSettingsConfig::get_config_file(&self) -> &[u8] {
    transition self.config_file_len <= 512 {
        true -> (&self.config_file[0..self.config_file_len])
        false -> (&self.config_file[0..512])
        _ -> (&self.config_file[0..512])
    }
}

pub machine ProjectSettingsConfig::set_config_file(&mut self, config_file: &[u8]) {
    self.config_file_len = 0;
    transition {
        _ -> copy(config_file, 0)
    }
    state copy(&mut self, config_file: &[u8], position: u64) {
        transition position < config_file.len && position < 512 {
            true -> store(config_file, position)
            false -> done()
            _ -> done()
        }
    }
    state store(&mut self, config_file: &[u8], position: u64)
        requires position < 512;
    {
        self.config_file[position] = config_file[position];
        self.config_file_len = ((self.config_file_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition {
            _ -> copy(config_file, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state done(&mut self) {
    }
}

// Upstream `get_projects_root` — the lock-free read of the stored root.
pub machine ProjectSettingsConfig::get_projects_root(&self) -> &[u8] {
    (self.config.get_projects_root())
}

// Upstream `set_projects_root` — writes the root, then `save_config`;
// the save is the codec deferral in the header (the mutation itself
// preserves upstream semantics).
pub machine ProjectSettingsConfig::set_projects_root(&mut self, projects_root: &[u8]) {
    self.config.set_projects_root(projects_root);
}

// Upstream `get_project_update_interval`.
pub machine ProjectSettingsConfig::get_project_update_interval(&self) -> u64 {
    (self.config.get_project_update_interval_ms())
}

// Upstream `set_project_update_interval` — same save deferral as
// `set_projects_root`.
pub machine ProjectSettingsConfig::set_project_update_interval(&mut self, project_update_interval_ms: u64) {
    self.config.set_project_update_interval_ms(project_update_interval_ms);
}
