module src::settings::project_settings_config;

use squalr_engine_api::src::structures::settings::project_settings::ProjectSettings;
use src::project::serialization::project_file_codec::ProjectFileReader;
use src::project::serialization::project_file_codec::ProjectFileWriter;
use src::project::serialization::project_file_codec_types::decode_project_settings;
use src::project::serialization::project_file_codec_types::encode_project_settings;
use src::project::serialization::project_serialization::create_dir_all;
use omega_language_std::filesystem_host;

// Port of settings/project_settings_config.rs — the settings record plus
// its on-disk path, instance-carried. Upstream keeps one process-global
// `Arc<RwLock<ProjectSettingsConfig>>` behind a `OnceLock`; Omega carries
// the config in the caller's state instead — named deviation (no static
// mutable storage, and callers thread the instance explicitly).
//
// The config file persists through the project-file codec (the recorded
// serde_json deviation): `new` reads + parses when the file exists and
// falls back to defaults on any failure — upstream's warn-and-default
// arm, minus the warn (no logger in this package). `save_config` writes
// the encoded record on every setter, upstream's post-mutation flush.
//
// Host-facility deviations: upstream `default_projects_root` prefers
// `directories::UserDirs` documents/Squalr and `default_config_path`
// resolves `current_exe().parent()` — no documents-directory or
// current-executable provider exists in the boundary today, so the port
// stores upstream's own relative fallbacks ("./Squalr" and
// "./project_settings.json" — the non-Android arms' fallback spelling).
pub data ProjectSettingsConfig {
    config: ProjectSettings;
    config_file: [u8; 512];
    config_file_len: u64;
}

// Upstream `new` — resolve the config path, then read + parse it when it
// exists; unreadable or undecodable content falls back to defaults.
// Deviation: `new` takes the config path (`&[u8] in Path` — upstream's
// fixed `Self::config_file_path()`) rather than storing it first, so the
// callsite grants the Path domain — a stored field can't re-prove it
// (a literal like "./project_settings.json" satisfies it directly).
pub linux_x86_64 machine ProjectSettingsConfig::new(config_file: &[u8] in Path) -> ProjectSettingsConfig
reaches FilesystemHost
invokes FilesystemHost;
{
    let mut created: ProjectSettingsConfig = ProjectSettingsConfig {
        config: ProjectSettingsConfig::default_project_settings(),
        config_file_len: 0,
    };
    ProjectSettingsConfig::set_config_file(&mut created, config_file);
    transition { _ -> read_config(created, config_file) }
    state read_config(created: ProjectSettingsConfig, config_file: &[u8] in Path) -> ProjectSettingsConfig {
        let mut carried: ProjectSettingsConfig = created;
        transition { _ -> open(carried, config_file) }
    }
    state open(created: ProjectSettingsConfig, config_file: &[u8] in Path) -> ProjectSettingsConfig {
        let mut carried: ProjectSettingsConfig = created;
        let fd: i32 = FilesystemHost::open(config_file, 0);
        transition fd >= 0 {
            true -> fill(carried, fd)
            _ -> (carried)
        }
    }
    state fill(created: ProjectSettingsConfig, fd: i32) -> ProjectSettingsConfig {
        let mut carried: ProjectSettingsConfig = created;
        let mut reader: ProjectFileReader = ProjectFileReader::default();
        let got: i64 = ProjectFileReader::fill_from_fd(&mut reader, fd);
        let closed: i32 = FilesystemHost::close(fd);
        transition got > 0 {
            true -> decode(carried, reader)
            _ -> (carried)
        }
    }
    state decode(created: ProjectSettingsConfig, reader: ProjectFileReader) -> ProjectSettingsConfig {
        let mut carried: ProjectSettingsConfig = created;
        let mut carried_reader: ProjectFileReader = reader;
        let header_ok: bool = ProjectFileReader::check_header(&mut carried_reader);
        transition header_ok {
            true -> body(carried, carried_reader)
            _ -> (carried)
        }
    }
    state body(created: ProjectSettingsConfig, reader: ProjectFileReader) -> ProjectSettingsConfig {
        let mut carried: ProjectSettingsConfig = created;
        let mut carried_reader: ProjectFileReader = reader;
        let mut decoded: ProjectSettings = ProjectSettings::default();
        let body_ok: bool = decode_project_settings(&mut carried_reader, &mut decoded);
        transition body_ok {
            true -> accept(carried, decoded)
            _ -> (carried)
        }
    }
    state accept(created: ProjectSettingsConfig, decoded: ProjectSettings) -> ProjectSettingsConfig {
        let mut carried: ProjectSettingsConfig = created;
        carried.config = decoded;
        (carried)
    }
}

// Upstream `default_config_path` — "./project_settings.json" (see the
// host-facility deviation in the module header).
pub machine ProjectSettingsConfig::default_config_path() -> &[u8] {
    ("./project_settings.json")
}

// Upstream `default_projects_root` — "./Squalr" (upstream's own
// non-Android fallback; see the host-facility deviation in the header).
pub machine ProjectSettingsConfig::default_projects_root() -> &[u8] {
    ("./Squalr")
}

// Upstream `default_project_settings` — projects_root carries the
// default root, the remaining fields are upstream `Default`.
pub machine ProjectSettingsConfig::default_project_settings() -> ProjectSettings {
    (ProjectSettings::default())
}

pub machine ProjectSettingsConfig::get_config_file(this: &ProjectSettingsConfig) -> &[u8] {
    transition this.config_file_len <= 512 {
        true -> (&this.config_file[0..this.config_file_len])
        false -> (&this.config_file[0..512])
        _ -> (&this.config_file[0..512])
    }
}

// The path grant is callsite-owned: param carries the domain so callers
// supply only provable paths; the stored bytes are the plain copy.
pub machine ProjectSettingsConfig::set_config_file(this: &mut ProjectSettingsConfig, config_file: &[u8] in Path) {
    this.config_file_len = 0;
    transition {
        _ -> copy(this, config_file, 0)
    }
    state copy(this: &mut ProjectSettingsConfig, config_file: &[u8] in Path, position: u64) {
        transition position < config_file.len && position < 512 {
            true -> store(this, config_file, position)
            false -> done(this)
            _ -> done(this)
        }
    }
    state store(this: &mut ProjectSettingsConfig, config_file: &[u8] in Path, position: u64)
        requires position < 512 && position < config_file.len;
    {
        this.config_file[position] = config_file[position];
        this.config_file_len = ((this.config_file_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition {
            _ -> copy(this, config_file, ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state done(this: &mut ProjectSettingsConfig) {
    }
}

// Upstream `get_projects_root` — the lock-free read of the stored root.
pub machine ProjectSettingsConfig::get_projects_root(this: &ProjectSettingsConfig) -> &[u8] {
    let hoist1: &[u8] = ProjectSettings::get_projects_root(&this.config);
    (hoist1)
}

// Upstream `set_projects_root` — writes the root, then `save_config`
// (upstream flushes the whole config on every setter).
// Deviation: `config_file` re-supplied at the callsite (upstream reads
// the instance's stored path) so the flush's `create` sees a domained
// arg — stored bytes cannot re-prove `Path`.
pub linux_x86_64 machine ProjectSettingsConfig::set_projects_root(this: &mut ProjectSettingsConfig, projects_root: &[u8], config_file: &[u8] in Path)
reaches FilesystemHost
invokes FilesystemHost;
{
    ProjectSettings::set_projects_root(&mut this.config, projects_root);
    ProjectSettingsConfig::save_config(&mut this, config_file);
}

// Upstream `get_project_update_interval`.
pub machine ProjectSettingsConfig::get_project_update_interval(this: &ProjectSettingsConfig) -> u64 {
    let hoist2: u64 = ProjectSettings::get_project_update_interval_ms(&this.config);
    (hoist2)
}

// Upstream `set_project_update_interval` — same post-set `save_config`.
pub linux_x86_64 machine ProjectSettingsConfig::set_project_update_interval(this: &mut ProjectSettingsConfig, project_update_interval_ms: u64, config_file: &[u8] in Path)
reaches FilesystemHost
invokes FilesystemHost;
{
    ProjectSettings::set_project_update_interval_ms(&mut this.config, project_update_interval_ms);
    ProjectSettingsConfig::save_config(&mut this, config_file);
}

// Upstream `save_config` — `fs::create_dir_all` on the parent (the path
// up to the final separator, when one exists — "./project_settings.json"
// resolves "."), then the encoded record written over the file.
// Failures are silent like upstream's warn-then-return arms.
// The param carries the domain like `new` — `config_file[0..last_sep]`
// inherits it into `create_dir_all`, the leaf into `create`.
pub linux_x86_64 machine ProjectSettingsConfig::save_config(this: &mut ProjectSettingsConfig, config_file: &[u8] in Path)
reaches FilesystemHost
invokes FilesystemHost;
{
    transition { _ -> parent_dir(this, config_file, 0, 0) }
    // Find the last '/' in config_file.
    state parent_dir(this: &mut ProjectSettingsConfig, config_file: &[u8] in Path, index: u64, last_sep: u64) {
        transition index < config_file.len {
            true -> parent_at(this, config_file, index, last_sep)
            _ -> parent_make(this, config_file, last_sep)
        }
    }
    state parent_at(this: &mut ProjectSettingsConfig, config_file: &[u8] in Path, index: u64, last_sep: u64)
        requires index < config_file.len;
    {
        let next: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition config_file[index] == 47 {
            true -> parent_dir(this, config_file, next, index)
            _ -> parent_dir(this, config_file, next, last_sep)
        }
    }
    state parent_make(this: &mut ProjectSettingsConfig, config_file: &[u8] in Path, last_sep: u64) {
        transition last_sep > 0 && last_sep <= config_file.len {
            true -> parent_do(this, config_file, last_sep)
            _ -> write_file(this, config_file)
        }
    }
    state parent_do(this: &mut ProjectSettingsConfig, config_file: &[u8] in Path, last_sep: u64)
        requires last_sep <= config_file.len;
    {
        let made: bool = create_dir_all(&config_file[0..last_sep]);
        transition { _ -> write_file(this, config_file) }
    }
    state write_file(this: &mut ProjectSettingsConfig, config_file: &[u8] in Path) {
        let mut writer: ProjectFileWriter = ProjectFileWriter::new();
        let head_ok: bool = ProjectFileWriter::put_header(&mut writer);
        let body_ok: bool = encode_project_settings(&mut writer, &this.config);
        transition head_ok && body_ok {
            true -> open_file(this, config_file, writer)
            _ -> stop(this)
        }
    }
    state open_file(this: &mut ProjectSettingsConfig, config_file: &[u8] in Path, writer: ProjectFileWriter) {
        let fd: i32 = FilesystemHost::create(config_file, 438);
        transition fd >= 0 {
            true -> write(this, fd, writer)
            _ -> stop(this)
        }
    }
    state stop(this: &mut ProjectSettingsConfig) {
    }
    state write(this: &mut ProjectSettingsConfig, fd: i32, writer: ProjectFileWriter) {
        let mut carried: ProjectFileWriter = writer;
        let put: i64 = ProjectFileWriter::flush_to_fd(&mut carried, fd);
        let closed: i32 = FilesystemHost::close(fd);
    }
}
