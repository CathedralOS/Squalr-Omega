use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/filesystem_authority.omg;
use {squalr_engine_api}/src/structures/projects/project_items/project_item.omg;
use src/project/serialization/project_file_codec.omg;
use src/project/serialization/project_file_codec_item.omg;
use src/project/serialization/serializable_project_file.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;

// Port of project_item_serialization.rs — `SerializableProjectFile for
// ProjectItem`: the save arm creates the item's own directory when the
// path is absent (upstream `fs::create_dir` — directory-type items land
// on disk as folders), then serializes only when the path resolves to a
// regular file; the load arm refuses directories and missing paths, and
// clears `has_unsaved_changes` on success. The file bytes are the codec's
// deterministic positional encoding (recorded serde_json deviation).
//
// `project_item_path` carries the `Path` domain — upstream's `&Path`.
// Paths built at runtime (stored on a ProjectItemRef, read back off a
// directory walk) cannot re-prove the domain — the compiler only admits
// `in Path` params, literals, concats of those, and subslices of those —
// so the project walk reaches the same syscalls through the boundary's
// trusted-name seam: `open_at` (dirfd + relative name, the read_dir
// channel's own route) and `create_dir_name` (the plain-path create_dir
// twin). `save_at`/`fill_and_decode`/`read_mode` are that seam; they
// encode the identical upstream behavior against an open parent dirfd.
public data ProjectItemLoad {
    case Refused;
    case Loaded(project_item: |project_item|::ProjectItem);
}

// Shared stat decode — linux x86_64 `struct stat` carries `st_mode` u32
// at byte 24; `S_IFMT == 61440` masks the kind, `S_IFREG == 32768`,
// `S_IFDIR == 16384`. The buffer is the std Filesystem's 144-byte stat
// carrier.
public data ProjectItemPathProbe {
    stat_buf: [u8; 144];
    stat_rc: i32;
    mode: u32;
}

public linux_x86_64 machine ProjectItem::save_to_path(
    this: &mut |project_item|::ProjectItem,
    project_item_path: &[u8] in |filesystem_host|::Path,
    save_even_if_unchanged: bool
) -> |serializable_project_file|::ProjectFileSave
satisfies |serializable_project_file|::SerializableProjectFile<|project_item|::ProjectItem>::save_to_path
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    transition save_even_if_unchanged || this.has_unsaved_changes {
        true -> probe(this, project_item_path)
        _ -> (|serializable_project_file|::ProjectFileSave::Stored)
    }
    machine probe(this: &mut |project_item|::ProjectItem, project_item_path: &[u8] in |filesystem_host|::Path) -> |serializable_project_file|::ProjectFileSave {
        let mut probe: ProjectItemPathProbe = ProjectItemPathProbe {
            stat_rc: -1,
            mode: 0,
        };
        probe.stat_rc = |posix_filesystem_host|::PosixFilesystemHost::read_metadata(project_item_path, &mut probe.stat_buf);
        transition probe.stat_rc >= 0 {
            true -> kind(this, project_item_path, probe)
            _ -> make_dir(this, project_item_path)
        }
    }
    machine make_dir(this: &mut |project_item|::ProjectItem, project_item_path: &[u8] in |filesystem_host|::Path) -> |serializable_project_file|::ProjectFileSave {
        // Upstream `fs::create_dir(&project_item_path)?` — the item's own
        // path becomes a directory; the subsequent `is_file` reads false,
        // so a directory item completes with nothing serialized.
        let created: i32 = |posix_filesystem_host|::PosixFilesystemHost::create_dir(project_item_path, 493);
        transition created >= 0 {
            true -> (|serializable_project_file|::ProjectFileSave::Stored)
            _ -> (|serializable_project_file|::ProjectFileSave::Refused)
        }
    }
    machine kind(this: &mut |project_item|::ProjectItem, project_item_path: &[u8] in |filesystem_host|::Path, probe: ProjectItemPathProbe) -> |serializable_project_file|::ProjectFileSave {
        let mut carried: ProjectItemPathProbe = probe;
        carried.mode = ((carried.stat_buf[24] as u32 in Wrapping)
            | (((carried.stat_buf[25] as u32 in Wrapping)) << 8)
            | (((carried.stat_buf[26] as u32 in Wrapping)) << 16)
            | (((carried.stat_buf[27] as u32 in Wrapping)) << 24)) as u32;
        transition (carried.mode & 61440) == 32768 {
            true -> emit(this, project_item_path)
            _ -> (|serializable_project_file|::ProjectFileSave::Stored)
        }
    }
    machine emit(this: &mut |project_item|::ProjectItem, project_item_path: &[u8] in |filesystem_host|::Path) -> |serializable_project_file|::ProjectFileSave {
        let mut writer: |project_file_codec|::ProjectFileWriter = |project_file_codec|::ProjectFileWriter::new();
        let head_ok: bool = |project_file_codec|::ProjectFileWriter::put_header(&mut writer);
        let body_ok: bool = |project_file_codec_item|::encode_project_item(&mut writer, &this);
        transition head_ok && body_ok {
            true -> open(this, project_item_path, writer)
            _ -> (|serializable_project_file|::ProjectFileSave::Refused)
        }
    }
    machine open(this: &mut |project_item|::ProjectItem, project_item_path: &[u8] in |filesystem_host|::Path, writer: |project_file_codec|::ProjectFileWriter) -> |serializable_project_file|::ProjectFileSave {
        let fd: i32 = |posix_filesystem_host|::PosixFilesystemHost::create(project_item_path, 438);
        transition fd >= 0 {
            true -> write(this, fd, writer)
            _ -> (|serializable_project_file|::ProjectFileSave::Refused)
        }
    }
    machine write(this: &mut |project_item|::ProjectItem, fd: i32, writer: |project_file_codec|::ProjectFileWriter) -> |serializable_project_file|::ProjectFileSave {
        let mut carried: |project_file_codec|::ProjectFileWriter = writer;
        let put: i64 = |project_file_codec|::ProjectFileWriter::flush_to_fd(&mut carried, fd);
        let expected: i64 = |numeric_conversion|::narrow_u64_to_i64_wrapping(carried.written);
        let closed: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(fd);
        transition put == expected && put >= 0 {
            true -> clean(this)
            _ -> (|serializable_project_file|::ProjectFileSave::Refused)
        }
    }
    machine clean(this: &mut |project_item|::ProjectItem) -> |serializable_project_file|::ProjectFileSave {
        this.has_unsaved_changes = false;
        (|serializable_project_file|::ProjectFileSave::Stored)
    }
}

// The dirfd-relative save used by `Project::save_to_path` — identical
// upstream behavior, routed through `open_at`/`create_dir_name` because
// a stored item path cannot re-prove `Path`. `parent_fd` is the open
// project-items directory; `item_path` is the item's stored path bytes
// relative to that fd's directory (it may carry separators — `open_at`
// accepts a relative path, the openat semantics the boundary documents);
// `full_path` is the same path whole, for `create_dir_name` which runs
// mkdir on the path itself relative to the caller's cwd like upstream's
// own `fs::create_dir` call.
public linux_x86_64 machine ProjectItem::save_at(
    this: &mut |project_item|::ProjectItem,
    parent_fd: i32,
    item_path: &[u8],
    full_path: &[u8],
    save_even_if_unchanged: bool
) -> |serializable_project_file|::ProjectFileSave
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    transition save_even_if_unchanged || this.has_unsaved_changes {
        true -> probe(this, parent_fd, item_path, full_path)
        _ -> (|serializable_project_file|::ProjectFileSave::Stored)
    }
    machine probe(this: &mut |project_item|::ProjectItem, parent_fd: i32, item_path: &[u8], full_path: &[u8]) -> |serializable_project_file|::ProjectFileSave {
        let fd: i32 = |posix_filesystem_host|::PosixFilesystemHost::open_at(parent_fd, item_path, 0);
        transition fd >= 0 {
            true -> kind(this, parent_fd, fd, item_path, full_path)
            _ -> make_dir(this, full_path)
        }
    }
    machine make_dir(this: &mut |project_item|::ProjectItem, full_path: &[u8]) -> |serializable_project_file|::ProjectFileSave {
        // Upstream `fs::create_dir(&project_item_path)?` — full-path
        // mkdir, the boundary's plain-bytes twin of `create_dir`.
        let created: i32 = |posix_filesystem_host|::PosixFilesystemHost::create_dir_name(full_path, 493);
        transition created >= 0 {
            true -> (|serializable_project_file|::ProjectFileSave::Stored)
            _ -> (|serializable_project_file|::ProjectFileSave::Refused)
        }
    }
    machine kind(this: &mut |project_item|::ProjectItem, parent_fd: i32, fd: i32, item_path: &[u8], full_path: &[u8]) -> |serializable_project_file|::ProjectFileSave {
        let mut probe: ProjectItemPathProbe = ProjectItemPathProbe {
            stat_rc: -1,
            mode: 0,
        };
        probe.stat_rc = |posix_filesystem_host|::PosixFilesystemHost::read_file_metadata(fd, &mut probe.stat_buf);
        let closed: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(fd);
        transition probe.stat_rc >= 0 {
            true -> mode(this, parent_fd, item_path, probe)
            _ -> (|serializable_project_file|::ProjectFileSave::Refused)
        }
    }
    machine mode(this: &mut |project_item|::ProjectItem, parent_fd: i32, item_path: &[u8], probe: ProjectItemPathProbe) -> |serializable_project_file|::ProjectFileSave {
        let mut carried: ProjectItemPathProbe = probe;
        carried.mode = ((carried.stat_buf[24] as u32 in Wrapping)
            | (((carried.stat_buf[25] as u32 in Wrapping)) << 8)
            | (((carried.stat_buf[26] as u32 in Wrapping)) << 16)
            | (((carried.stat_buf[27] as u32 in Wrapping)) << 24)) as u32;
        transition (carried.mode & 61440) == 32768 {
            true -> emit(this, parent_fd, item_path)
            _ -> (|serializable_project_file|::ProjectFileSave::Stored)
        }
    }
    machine emit(this: &mut |project_item|::ProjectItem, parent_fd: i32, item_path: &[u8]) -> |serializable_project_file|::ProjectFileSave {
        let mut writer: |project_file_codec|::ProjectFileWriter = |project_file_codec|::ProjectFileWriter::new();
        let head_ok: bool = |project_file_codec|::ProjectFileWriter::put_header(&mut writer);
        let body_ok: bool = |project_file_codec_item|::encode_project_item(&mut writer, &this);
        transition head_ok && body_ok {
            true -> open(this, parent_fd, item_path, writer)
            _ -> (|serializable_project_file|::ProjectFileSave::Refused)
        }
    }
    machine open(this: &mut |project_item|::ProjectItem, parent_fd: i32, item_path: &[u8], writer: |project_file_codec|::ProjectFileWriter) -> |serializable_project_file|::ProjectFileSave {
        // O_WRONLY|O_CREAT|O_TRUNC (1|64|512) — upstream `File::create`.
        let fd: i32 = |posix_filesystem_host|::PosixFilesystemHost::open_at(parent_fd, item_path, 577);
        transition fd >= 0 {
            true -> write(this, fd, writer)
            _ -> (|serializable_project_file|::ProjectFileSave::Refused)
        }
    }
    machine write(this: &mut |project_item|::ProjectItem, fd: i32, writer: |project_file_codec|::ProjectFileWriter) -> |serializable_project_file|::ProjectFileSave {
        let mut carried: |project_file_codec|::ProjectFileWriter = writer;
        let put: i64 = |project_file_codec|::ProjectFileWriter::flush_to_fd(&mut carried, fd);
        let expected: i64 = |numeric_conversion|::narrow_u64_to_i64_wrapping(carried.written);
        let closed: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(fd);
        transition put == expected && put >= 0 {
            true -> clean(this)
            _ -> (|serializable_project_file|::ProjectFileSave::Refused)
        }
    }
    machine clean(this: &mut |project_item|::ProjectItem) -> |serializable_project_file|::ProjectFileSave {
        this.has_unsaved_changes = false;
        (|serializable_project_file|::ProjectFileSave::Stored)
    }
}

public linux_x86_64 machine ProjectItem::load_from_path(
    project_item_path: &[u8] in |filesystem_host|::Path
) -> ProjectItemLoad
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let fd: i32 = |posix_filesystem_host|::PosixFilesystemHost::open(project_item_path, 0);
    transition fd >= 0 {
        true -> fill(fd)
        _ -> (ProjectItemLoad::Refused)
    }
    machine fill(fd: i32) -> ProjectItemLoad {
        let mut project_item: |project_item|::ProjectItem = |project_item|::ProjectItem::default();
        let ok: bool = ProjectItem::fill_and_decode(&mut project_item, fd);
        let closed: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(fd);
        transition ok {
            true -> clean(project_item)
            _ -> (ProjectItemLoad::Refused)
        }
    }
    machine clean(project_item: |project_item|::ProjectItem) -> ProjectItemLoad {
        let mut carried: |project_item|::ProjectItem = project_item;
        |project_item|::ProjectItem::set_has_unsaved_changes(&mut carried, false);
        (ProjectItemLoad::Loaded { project_item: carried })
    }
}

// The read half shared by `load_from_path` and the project walk: fill
// the codec reader off an open fd, check the header, decode into self.
// Returns false on any transport/format failure (upstream's `?` arms).
public linux_x86_64 machine ProjectItem::fill_and_decode(this: &mut |project_item|::ProjectItem, fd: i32) -> bool
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let mut reader: |project_file_codec|::ProjectFileReader = |project_file_codec|::ProjectFileReader::default();
    let got: i64 = |project_file_codec|::ProjectFileReader::fill_from_fd(&mut reader, fd);
    transition got > 0 {
        true -> decode(this, reader)
        _ -> (false)
    }
    machine decode(this: &mut |project_item|::ProjectItem, reader: |project_file_codec|::ProjectFileReader) -> bool {
        let mut carried: |project_file_codec|::ProjectFileReader = reader;
        let header_ok: bool = |project_file_codec|::ProjectFileReader::check_header(&mut carried);
        transition header_ok {
            true -> body(this, carried)
            _ -> (false)
        }
    }
    machine body(this: &mut |project_item|::ProjectItem, reader: |project_file_codec|::ProjectFileReader) -> bool {
        let mut carried: |project_file_codec|::ProjectFileReader = reader;
        let body_ok: bool = |project_file_codec_item|::decode_project_item(&mut carried, &mut this);
        transition body_ok {
            true -> (true)
            _ -> (false)
        }
    }
}
