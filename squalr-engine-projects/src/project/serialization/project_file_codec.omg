module src::project::serialization::project_file_codec;

use omega_language_std::filesystem_host;

// Port frontier: the project-file codec. Upstream serializes the project
// tree through serde_json (pretty text, field-name keyed); no JSON reader
// or writer exists in the bundled library today (TASKS.md
// PROJECT-SERIALIZATION), so the port stores a deterministic positional
// binary encoding instead — every field in declared order, every union
// prefixed by its case tag, every length-carrying value length-prefixed.
// File names, locations and the save/load model stay 1:1 with upstream;
// only the byte format deviates (recorded deviation: no interop with
// upstream .json project files, none needed headless-first).
//
// Layout: 4-byte magic "SQPR" + u16 format version (1), then positional
// fields. u8/u16/u32/u64 store little-endian; i64 stores its u64 bit
// pattern; bool stores 0/1; slices and strings store a u64 length then
// raw bytes; unions store a u8 case tag then the case's fields in order;
// optional values store a u8 flag then the payload when present.
//
// Bound: files carry inside a 4 MiB buffer. The worst-case source graph
// (a fully populated 128-descriptor symbol catalog) is ~2.8 MB upstream;
// files past the bound refuse, matching the package's bounded-table
// convention everywhere else.
pub data ProjectFileWriter {
    bytes: [u8; 4194304];
    written: u64;
    failed: bool;
}

pub machine ProjectFileWriter::new() -> ProjectFileWriter {
    (ProjectFileWriter { written: 0, failed: false })
}

pub machine ProjectFileWriter::default() -> ProjectFileWriter {
    (ProjectFileWriter { written: 0, failed: false })
}

pub machine ProjectFileWriter::has_failed(this: &ProjectFileWriter) -> bool {
    (this.failed)
}

pub machine ProjectFileWriter::get_written(this: &ProjectFileWriter) -> u64 {
    (this.written)
}

// The encoded prefix — valid bytes are `bytes[0..written]`; callers pass
// the length along so the writer only reports the live window.
pub machine ProjectFileWriter::get_bytes(this: &ProjectFileWriter) -> &[u8] {
    transition this.written <= 4194304 {
        true -> (&this.bytes[0..this.written])
        _ -> (&this.bytes[0..0])
    }
}

// Upstream serializer append — refuses (and latches failed) on overflow
// instead of truncating, so a serialized file is always complete or an
// error, matching anyhow::Result.
pub machine ProjectFileWriter::put_byte(this: &mut ProjectFileWriter, value: u8) -> bool {
    transition this.written < 4194304 {
        true -> store(this, value)
        _ -> refuse(this, value)
    }
    state store(this: &mut ProjectFileWriter, value: u8) -> bool
        requires this.written < 4194304;
    {
        this.bytes[this.written] = value;
        let next_written: u64 = this.written + 1;
        this.written = next_written;
        (true)
    }
    state refuse(this: &mut ProjectFileWriter, value: u8) -> bool {
        this.failed = true;
        (false)
    }
}

// Little-endian scalar appends — byte walks share one shifted-copy shape.
pub machine ProjectFileWriter::put_u16(this: &mut ProjectFileWriter, value: u16) -> bool {
    transition {
        _ -> put(this, value, 0)
    }
    state put(this: &mut ProjectFileWriter, value: u16, index: u64) -> bool {
        transition index < 2 {
            true -> byte(this, value, index)
            _ -> (true)
        }
    }
    state byte(this: &mut ProjectFileWriter, value: u16, index: u64) -> bool
        requires index < 2;
    {
        let shift: u64 = index * 8;
        let byte: u64 = (((value as u64 in Wrapping) >> (shift as u64 in Wrapping)) % 256) as u64;
        let stored: bool = ProjectFileWriter::put_byte(&mut this, (byte as u8));
        transition stored {
            true -> put(this, value, index + 1)
            _ -> (false)
        }
    }
}

pub machine ProjectFileWriter::put_u32(this: &mut ProjectFileWriter, value: u32) -> bool {
    transition {
        _ -> put(this, value, 0)
    }
    state put(this: &mut ProjectFileWriter, value: u32, index: u64) -> bool {
        transition index < 4 {
            true -> byte(this, value, index)
            _ -> (true)
        }
    }
    state byte(this: &mut ProjectFileWriter, value: u32, index: u64) -> bool
        requires index < 4;
    {
        let shift: u64 = index * 8;
        let byte: u64 = (((value as u64 in Wrapping) >> (shift as u64 in Wrapping)) % 256) as u64;
        let stored: bool = ProjectFileWriter::put_byte(&mut this, (byte as u8));
        transition stored {
            true -> put(this, value, index + 1)
            _ -> (false)
        }
    }
}

pub machine ProjectFileWriter::put_u64(this: &mut ProjectFileWriter, value: u64) -> bool {
    transition {
        _ -> put(this, value, 0)
    }
    state put(this: &mut ProjectFileWriter, value: u64, index: u64) -> bool {
        transition index < 8 {
            true -> byte(this, value, index)
            _ -> (true)
        }
    }
    state byte(this: &mut ProjectFileWriter, value: u64, index: u64) -> bool
        requires index < 8;
    {
        let shift: u64 = index * 8;
        let byte: u64 = (((value as u64 in Wrapping) >> (shift as u64 in Wrapping)) % 256) as u64;
        let stored: bool = ProjectFileWriter::put_byte(&mut this, (byte as u8));
        transition stored {
            true -> put(this, value, index + 1)
            _ -> (false)
        }
    }
}

// i64 stores the u64 bit pattern verbatim (two's-complement is already
// little-endian-friendly); decode reproduces the same bit pattern.
pub machine ProjectFileWriter::put_i64(this: &mut ProjectFileWriter, value: i64) -> bool {
    let stored: bool = ProjectFileWriter::put_u64(&mut this, ((value as u64 in Wrapping) as u64));
    (stored)
}

pub machine ProjectFileWriter::put_bool(this: &mut ProjectFileWriter, value: bool) -> bool {
    transition value {
        true -> one(this, value)
        _ -> zero(this, value)
    }
    state one(this: &mut ProjectFileWriter, value: bool) -> bool {
        let stored: bool = ProjectFileWriter::put_byte(&mut this, 1);
        (stored)
    }
    state zero(this: &mut ProjectFileWriter, value: bool) -> bool {
        let stored: bool = ProjectFileWriter::put_byte(&mut this, 0);
        (stored)
    }
}

// Length-prefixed byte run — u64 length then the raw bytes.
pub machine ProjectFileWriter::put_bytes(this: &mut ProjectFileWriter, value: &[u8]) -> bool {
    let stored: bool = ProjectFileWriter::put_u64(&mut this, value.len);
    transition stored {
        true -> copy(this, value, 0)
        _ -> (false)
    }
    state copy(this: &mut ProjectFileWriter, value: &[u8], position: u64) -> bool {
        transition position < value.len {
            true -> byte(this, value, position)
            _ -> (true)
        }
    }
    state byte(this: &mut ProjectFileWriter, value: &[u8], position: u64) -> bool
        requires position < value.len;
    {
        let stored: bool = ProjectFileWriter::put_byte(&mut this, value[position]);
        transition stored {
            true -> copy(this, value, position + 1)
            _ -> (false)
        }
    }
}

// The file header: magic + version so corrupt or foreign files refuse
// predictably on decode.
pub machine ProjectFileWriter::put_header(this: &mut ProjectFileWriter) -> bool {
    let a: bool = ProjectFileWriter::put_byte(&mut this, 83);
    let b: bool = ProjectFileWriter::put_byte(&mut this, 81);
    let c: bool = ProjectFileWriter::put_byte(&mut this, 80);
    let d: bool = ProjectFileWriter::put_byte(&mut this, 82);
    let e: bool = ProjectFileWriter::put_u16(&mut this, 1);
    (a && b && c && d && e)
}

pub data ProjectFileReader {
    bytes: [u8; 4194304];
    len: u64;
    position: u64;
    failed: bool;
}

// Wrap a bounded byte window as a reader — callers hand the file bytes
// plus their real length (the decode surface never reads past `len`).
pub machine ProjectFileReader::default() -> ProjectFileReader {
    (ProjectFileReader { len: 0, position: 0, failed: false })
}

pub machine ProjectFileReader::wrap(contents: &[u8], content_len: u64) -> ProjectFileReader {
    let mut created: ProjectFileReader = ProjectFileReader { len: 0, position: 0, failed: false };
    let copied: bool = ProjectFileReader::copy_contents(&mut created, contents, content_len);
    (created)
}

machine ProjectFileReader::copy_contents(this: &mut ProjectFileReader, contents: &[u8], content_len: u64) -> bool {
    transition content_len <= 4194304 {
        true -> copy(this, contents, content_len, 0)
        _ -> refuse(this, contents, content_len)
    }
    state copy(this: &mut ProjectFileReader, contents: &[u8], content_len: u64, position: u64) -> bool
        requires content_len <= 4194304;
    {
        transition position < content_len && position < contents.len {
            true -> byte(this, contents, content_len, position)
            _ -> accept(this, contents, content_len)
        }
    }
    state byte(this: &mut ProjectFileReader, contents: &[u8], content_len: u64, position: u64) -> bool
        requires position < contents.len && content_len <= 4194304;
    {
        this.bytes[position] = contents[position];
        transition {
            _ -> copy(this, contents, content_len, position + 1)
        }
    }
    state accept(this: &mut ProjectFileReader, contents: &[u8], content_len: u64) -> bool {
        this.len = content_len;
        (true)
    }
    state refuse(this: &mut ProjectFileReader, contents: &[u8], content_len: u64) -> bool {
        this.failed = true;
        (false)
    }
}

pub machine ProjectFileReader::has_failed(this: &ProjectFileReader) -> bool {
    (this.failed)
}

pub machine ProjectFileReader::get_position(this: &ProjectFileReader) -> u64 {
    (this.position)
}

pub machine ProjectFileReader::get_len(this: &ProjectFileReader) -> u64 {
    (this.len)
}

pub machine ProjectFileReader::get_u8(this: &mut ProjectFileReader) -> u8 {
    transition this.position < this.len && this.position < 4194304 {
        true -> read(this)
        _ -> refuse(this)
    }
    state read(this: &mut ProjectFileReader) -> u8
        requires this.position < 4194304;
    {
        let byte: u8 = this.bytes[this.position];
        let next_position: u64 = this.position + 1;
        this.position = next_position;
        (byte)
    }
    state refuse(this: &mut ProjectFileReader) -> u8 {
        this.failed = true;
        (0)
    }
}

pub machine ProjectFileReader::get_u16(this: &mut ProjectFileReader) -> u16 {
    transition {
        _ -> read(this, 0, 0)
    }
    state read(this: &mut ProjectFileReader, index: u64, accumulated: u64) -> u16 {
        transition index < 2 {
            true -> byte(this, index, accumulated)
            _ -> (((accumulated as u16 in Wrapping) as u16))
        }
    }
    state byte(this: &mut ProjectFileReader, index: u64, accumulated: u64) -> u16
        requires index < 2;
    {
        let byte: u8 = ProjectFileReader::get_u8(&mut this);
        let shift: u64 = index * 8;
        let merged: u64 = ((accumulated as u64 in Wrapping) | (((byte as u64 in Wrapping) << (shift as u64 in Wrapping)))) as u64;
        transition {
            _ -> read(this, index + 1, merged)
        }
    }
}

pub machine ProjectFileReader::get_u32(this: &mut ProjectFileReader) -> u32 {
    transition {
        _ -> read(this, 0, 0)
    }
    state read(this: &mut ProjectFileReader, index: u64, accumulated: u64) -> u32 {
        transition index < 4 {
            true -> byte(this, index, accumulated)
            _ -> (((accumulated as u32 in Wrapping) as u32))
        }
    }
    state byte(this: &mut ProjectFileReader, index: u64, accumulated: u64) -> u32
        requires index < 4;
    {
        let byte: u8 = ProjectFileReader::get_u8(&mut this);
        let shift: u64 = index * 8;
        let merged: u64 = ((accumulated as u64 in Wrapping) | (((byte as u64 in Wrapping) << (shift as u64 in Wrapping)))) as u64;
        transition {
            _ -> read(this, index + 1, merged)
        }
    }
}

pub machine ProjectFileReader::get_u64(this: &mut ProjectFileReader) -> u64 {
    transition {
        _ -> read(this, 0, 0)
    }
    state read(this: &mut ProjectFileReader, index: u64, accumulated: u64) -> u64 {
        transition index < 8 {
            true -> byte(this, index, accumulated)
            _ -> (accumulated)
        }
    }
    state byte(this: &mut ProjectFileReader, index: u64, accumulated: u64) -> u64
        requires index < 8;
    {
        let byte: u8 = ProjectFileReader::get_u8(&mut this);
        let shift: u64 = index * 8;
        let merged: u64 = ((accumulated as u64 in Wrapping) | (((byte as u64 in Wrapping) << (shift as u64 in Wrapping)))) as u64;
        transition {
            _ -> read(this, index + 1, merged)
        }
    }
}

pub machine ProjectFileReader::get_i64(this: &mut ProjectFileReader) -> i64 {
    let raw: u64 = ProjectFileReader::get_u64(&mut this);
    (((raw as i64 in Wrapping) as i64))
}

pub machine ProjectFileReader::get_bool(this: &mut ProjectFileReader) -> bool {
    let byte: u8 = ProjectFileReader::get_u8(&mut this);
    (byte == 1)
}

// Length-prefixed byte run — copies into `out`; a declared length past
// the caller's capacity or past the file tail refuses (sets failed).
pub machine ProjectFileReader::get_bytes(this: &mut ProjectFileReader, out: &mut [u8; 512]) -> u64 {
    let count: u64 = ProjectFileReader::get_u64(&mut this);
    transition count <= 512 && count <= this.len && this.position <= this.len {
        true -> bounded(this, out, count)
        _ -> refuse(this, out)
    }
    state bounded(this: &mut ProjectFileReader, out: &mut [u8; 512], count: u64) -> u64
        requires count <= 512;
    {
        let remaining: u64 = this.len - this.position;
        transition count <= remaining {
            true -> copy(this, out, count, 0)
            _ -> refuse(this, out)
        }
    }
    state copy(this: &mut ProjectFileReader, out: &mut [u8; 512], count: u64, position: u64) -> u64
        requires count <= 512;
    {
        transition position < count && position < 512 {
            true -> byte(this, out, count, position)
            _ -> (count)
        }
    }
    state byte(this: &mut ProjectFileReader, out: &mut [u8; 512], count: u64, position: u64) -> u64
        requires position < 512 && count <= 512;
    {
        let byte: u8 = ProjectFileReader::get_u8(&mut this);
        out[position] = byte;
        transition {
            _ -> copy(this, out, count, position + 1)
        }
    }
    state refuse(this: &mut ProjectFileReader, out: &mut [u8; 512]) -> u64 {
        this.failed = true;
        (0)
    }
}

// Header check — magic "SQPR" + supported version (1). Fails the reader
// on mismatch like upstream's serde_json parse error path.
pub machine ProjectFileReader::check_header(this: &mut ProjectFileReader) -> bool {
    let a: u8 = ProjectFileReader::get_u8(&mut this);
    let b: u8 = ProjectFileReader::get_u8(&mut this);
    let c: u8 = ProjectFileReader::get_u8(&mut this);
    let d: u8 = ProjectFileReader::get_u8(&mut this);
    let version: u16 = ProjectFileReader::get_u16(&mut this);
    transition (a == 83 && b == 81 && c == 80 && d == 82 && version == 1 && !this.failed) {
        true -> (true)
        _ -> refuse(this)
    }
    state refuse(this: &mut ProjectFileReader) -> bool {
        this.failed = true;
        (false)
    }
}

// ============ file-descriptor transport ============

// The writer half of upstream `File::create` + `to_writer`: drain
// `bytes[0..written]` honoring short writes. Returns the flushed count;
// a host error mid-drain flags `failed` (upstream's `?` on write errors).
pub linux_x86_64 machine ProjectFileWriter::flush_to_fd(this: &mut ProjectFileWriter, fd: i32) -> i64
reaches FilesystemHost
invokes FilesystemHost;
{
    transition this.written <= 4194304 {
        true -> drain(this, fd, 0)
        _ -> fail(this)
    }
    state fail(this: &mut ProjectFileWriter) -> i64 {
        this.failed = true;
        (-1)
    }
    state drain(this: &mut ProjectFileWriter, fd: i32, position: u64) -> i64 {
        transition position < this.written {
            true -> bounded(this, fd, position)
            _ -> done(this, position)
        }
    }
    state bounded(this: &mut ProjectFileWriter, fd: i32, position: u64) -> i64 {
        transition position <= this.written && this.written <= 4194304 {
            true -> issue(this, fd, position)
            _ -> fail(this)
        }
    }
    state issue(this: &mut ProjectFileWriter, fd: i32, position: u64) -> i64
        requires position <= this.written && this.written <= 4194304;
    {
        let put: i64 = FilesystemHost::write(fd, &this.bytes[position..this.written]);
        transition put > 0 {
            true -> accumulate(this, fd, position, put)
            _ -> fail(this)
        }
    }
    state accumulate(this: &mut ProjectFileWriter, fd: i32, position: u64, put: i64) -> i64
        requires position <= this.written && this.written <= 4194304;
    {
        let added: u64 = ((put as u64 in Wrapping) as u64);
        let next: u64 = ((position as u64 in Wrapping) + (added as u64 in Wrapping)) as u64;
        transition { _ -> drain(this, fd, next) }
    }
    state done(this: &mut ProjectFileWriter, position: u64) -> i64 {
        (((position as i64 in Wrapping)) as i64)
    }
}

// The reader half of upstream `File::open` + `from_reader`: fill the
// bounded buffer to EOF (upstream serde reads through the file's end; a
// full 4 MiB buffer ends the drain with `len` at the bound — the same
// refusal surface as an oversized file). Returns the stored count.
pub linux_x86_64 machine ProjectFileReader::fill_from_fd(this: &mut ProjectFileReader, fd: i32) -> i64
reaches FilesystemHost
invokes FilesystemHost;
{
    this.len = 0;
    this.position = 0;
    this.failed = false;
    transition { _ -> drain(this, fd) }
    state drain(this: &mut ProjectFileReader, fd: i32) -> i64 {
        transition this.len <= 4194304 {
            true -> bounded(this, fd)
            _ -> done(this)
        }
    }
    state bounded(this: &mut ProjectFileReader, fd: i32) -> i64
        requires this.len <= 4194304;
    {
        let remaining: u64 = 4194304 - this.len;
        transition remaining > 0 {
            true -> issue(this, fd, remaining)
            _ -> done(this)
        }
    }
    state issue(this: &mut ProjectFileReader, fd: i32, remaining: u64) -> i64
        requires this.len <= 4194304;
    {
        let got: i64 = FilesystemHost::read(fd, &mut this.bytes[this.len..4194304], remaining);
        transition got > 0 {
            true -> accumulate(this, fd, got)
            _ -> done(this)
        }
    }
    state accumulate(this: &mut ProjectFileReader, fd: i32, got: i64) -> i64
        requires this.len <= 4194304;
    {
        let added: u64 = ((got as u64 in Wrapping) as u64);
        this.len = ((this.len as u64 in Wrapping) + (added as u64 in Wrapping)) as u64;
        transition { _ -> drain(this, fd) }
    }
    state done(this: &mut ProjectFileReader) -> i64 {
        (((this.len as i64 in Wrapping)) as i64)
    }
}
