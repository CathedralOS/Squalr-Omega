use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/filesystem_authority.omg;
use {squalr_engine_api}/src/plugins/plugin_configuration.omg;
use {squalr_engine_api}/src/structures/processes/process_icon.omg;
use {squalr_engine_api}/src/structures/projects/project_info.omg;
use {squalr_engine_api}/src/structures/projects/project_manifest.omg;
use {squalr_engine_api}/src/structures/projects/project_symbol_catalog.omg;
use src/project/serialization/project_file_codec.omg;
use src/project/serialization/project_file_codec_types.omg;
use src/project/serialization/project_serialization.omg;
use src/project/serialization/serializable_project_file.omg;
use {omega_language_std}/filesystem_host.omg;
use {omega_language_std}/posix_filesystem_host.omg;

// Port of project/serialization/project_info_serialization.rs —
// `ProjectInfoStub`, the condensed record that excludes everything a
// project-info file must not persist (name, path, unsaved-changes flag —
// `serde(skip)` is insufficient upstream because the fields still ride
// commands, hence the stub). The `SerializableProjectFile` impls land
// below — the stub is the serde-staging record upstream builds in
// `save_to_path` and rebuilds from in `load_from_path`.
public data ProjectInfoStub {
    has_project_icon_rgba: bool;
    project_icon_rgba: |process_icon|::ProcessIcon;
    project_manifest: |project_manifest|::ProjectManifest;
    project_symbol_catalog: |project_symbol_catalog|::ProjectSymbolCatalog;
    has_plugin_configuration: bool;
    plugin_configuration: |plugin_configuration|::PluginConfiguration;
}

// Upstream `ProjectInfoStub { project_icon_rgba, project_manifest,
// project_symbol_catalog, plugin_configuration }` built in save_to_path.
// Manifest/catalog/plugin move by value into the stub like upstream's
// `.clone()`/`.cloned()` — callers deserializing build them fresh from
// the decoded file; the save-side clone walks land with the codec leg.
public machine ProjectInfoStub::new(
    has_project_icon_rgba: bool,
    project_icon_rgba: |process_icon|::ProcessIcon,
    project_manifest: |project_manifest|::ProjectManifest,
    project_symbol_catalog: |project_symbol_catalog|::ProjectSymbolCatalog,
    has_plugin_configuration: bool,
    plugin_configuration: |plugin_configuration|::PluginConfiguration
) -> ProjectInfoStub {
    (ProjectInfoStub {
        has_project_icon_rgba: has_project_icon_rgba,
        project_icon_rgba: project_icon_rgba,
        project_manifest: project_manifest,
        project_symbol_catalog: project_symbol_catalog,
        has_plugin_configuration: has_plugin_configuration,
        plugin_configuration: plugin_configuration,
    })
}

// The deserializer's starting stub — the file's `has_` flags begin false,
// the payload records are defaults; decode overwrites what the file
// carries (upstream's `default` serde arms).
public machine ProjectInfoStub::default() -> ProjectInfoStub {
    (ProjectInfoStub {
        has_project_icon_rgba: false,
        project_icon_rgba: |process_icon|::ProcessIcon::default(),
        project_manifest: |project_manifest|::ProjectManifest::default(),
        project_symbol_catalog: |project_symbol_catalog|::ProjectSymbolCatalog::new(),
        has_plugin_configuration: false,
        plugin_configuration: |plugin_configuration|::PluginConfiguration::new(),
    })
}

// Upstream `anyhow::Result<ProjectInfo>` for the load half (the trait
// keeps load per-type like upstream's `where Self: Sized`): `Loaded`
// carries the rebuilt record, `Refused` covers open/parse failures.
public data ProjectInfoLoad {
    case Refused;
    case Loaded(project_info: |project_info|::ProjectInfo);
}

// Upstream `SerializableProjectFile for ProjectInfo::save_to_path` —
// honors the unchanged fast-path, then writes the stub through the
// codec (upstream's `to_writer`; the byte format is the recorded
// deviation) to `directory/project.json`, truncating any prior file.
public linux_x86_64 machine ProjectInfo::save_to_path(
    this: &mut |project_info|::ProjectInfo,
    directory: &[u8] in |filesystem_host|::Path,
    save_even_if_unchanged: bool
) -> |serializable_project_file|::ProjectFileSave
satisfies |serializable_project_file|::SerializableProjectFile<|project_info|::ProjectInfo>::save_to_path
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    transition save_even_if_unchanged || this.has_unsaved_changes {
        true -> store(this, directory)
        _ -> (|serializable_project_file|::ProjectFileSave::Stored)
    }
    machine store(this: &mut |project_info|::ProjectInfo, directory: &[u8] in |filesystem_host|::Path) -> |serializable_project_file|::ProjectFileSave {
        let mut stub: ProjectInfoStub = ProjectInfoStub::new(
            this.has_project_icon_rgba,
            |process_icon|::ProcessIcon::default(),
            |project_manifest|::ProjectManifest::clone(&this.project_manifest),
            |project_symbol_catalog|::ProjectSymbolCatalog::clone(&this.project_symbol_catalog),
            this.has_plugin_configuration,
            |plugin_configuration|::PluginConfiguration::clone(&this.plugin_configuration));
        |process_icon|::ProcessIcon::clone_from(&mut stub.project_icon_rgba, &this.project_icon_rgba);
        let mut writer: |project_file_codec|::ProjectFileWriter = |project_file_codec|::ProjectFileWriter::new();
        let head_ok: bool = |project_file_codec|::ProjectFileWriter::put_header(&mut writer);
        let body_ok: bool = |project_file_codec_types|::encode_info_stub(&mut writer, &stub);
        transition head_ok && body_ok {
            true -> emit(this, directory, writer)
            _ -> (|serializable_project_file|::ProjectFileSave::Refused)
        }
    }
    machine emit(this: &mut |project_info|::ProjectInfo, directory: &[u8] in |filesystem_host|::Path, writer: |project_file_codec|::ProjectFileWriter) -> |serializable_project_file|::ProjectFileSave {
        // Upstream `File::create(directory.join(PROJECT_FILE))` spelled
        // through the dirfd seam: open the project directory, then
        // `open_at` the literal leaf name O_WRONLY|O_CREAT|O_TRUNC.
        let dfd: i32 = |posix_filesystem_host|::PosixFilesystemHost::open(directory, 0);
        transition dfd >= 0 {
            true -> create(this, dfd, writer)
            _ -> (|serializable_project_file|::ProjectFileSave::Refused)
        }
    }
    machine create(this: &mut |project_info|::ProjectInfo, dfd: i32, writer: |project_file_codec|::ProjectFileWriter) -> |serializable_project_file|::ProjectFileSave {
        let fd: i32 = |posix_filesystem_host|::PosixFilesystemHost::open_at(dfd, "project.json", 577);
        transition fd >= 0 {
            true -> write(this, dfd, fd, writer)
            _ -> close_dir(this, dfd)
        }
    }
    machine close_dir(this: &mut |project_info|::ProjectInfo, dfd: i32) -> |serializable_project_file|::ProjectFileSave {
        let closed: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(dfd);
        (|serializable_project_file|::ProjectFileSave::Refused)
    }
    machine write(this: &mut |project_info|::ProjectInfo, dfd: i32, fd: i32, writer: |project_file_codec|::ProjectFileWriter) -> |serializable_project_file|::ProjectFileSave {
        let mut carried: |project_file_codec|::ProjectFileWriter = writer;
        let put: i64 = |project_file_codec|::ProjectFileWriter::flush_to_fd(&mut carried, fd);
        let expected: i64 = |numeric_conversion|::narrow_u64_to_i64_wrapping(carried.written);
        let closed: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(fd);
        let closed_dir: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(dfd);
        transition put == expected && put >= 0 {
            true -> clean(this)
            _ -> (|serializable_project_file|::ProjectFileSave::Refused)
        }
    }
    machine clean(this: &mut |project_info|::ProjectInfo) -> |serializable_project_file|::ProjectFileSave {
        this.has_unsaved_changes = false;
        (|serializable_project_file|::ProjectFileSave::Stored)
    }
}

// Upstream `ProjectInfo::load_from_path` — opens the project-info file,
// decodes the stub, and rebuilds through `new_with_symbol_catalog` with
// `has_unsaved_changes` cleared on success (upstream sets it post-load).
// Deviation: upstream takes the info FILE path (`directory.join(PROJECT_FILE)`
// spelled at its call site); the port takes the project directory and
// opens the leaf through the dirfd seam — stored-path bytes cannot
// re-prove `Path`, so callers pass the domained directory and the leaf
// name stays a literal. The record still stores the identical joined
// path bytes upstream's caller would have produced.
public linux_x86_64 machine ProjectInfo::load_from_path(
    project_directory_path: &[u8] in |filesystem_host|::Path
) -> ProjectInfoLoad
reaches |posix_filesystem_host|::PosixFilesystemHost + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::DirectoryEnumeration + |filesystem_authority|::FilesystemNamespaceMutation
invokes |posix_filesystem_host|::PosixFilesystemHost;
{
    let dfd: i32 = |posix_filesystem_host|::PosixFilesystemHost::open(project_directory_path, 0);
    transition dfd >= 0 {
        true -> open(dfd, project_directory_path)
        _ -> (ProjectInfoLoad::Refused)
    }
    machine open(dfd: i32, project_directory_path: &[u8] in |filesystem_host|::Path) -> ProjectInfoLoad {
        let fd: i32 = |posix_filesystem_host|::PosixFilesystemHost::open_at(dfd, "project.json", 0);
        transition fd >= 0 {
            true -> fill(dfd, fd, project_directory_path)
            _ -> close_dir(dfd)
        }
    }
    machine close_dir(dfd: i32) -> ProjectInfoLoad {
        let closed: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(dfd);
        (ProjectInfoLoad::Refused)
    }
    machine fill(dfd: i32, fd: i32, project_directory_path: &[u8]) -> ProjectInfoLoad {
        let mut reader: |project_file_codec|::ProjectFileReader = |project_file_codec|::ProjectFileReader::default();
        let got: i64 = |project_file_codec|::ProjectFileReader::fill_from_fd(&mut reader, fd);
        let closed: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(fd);
        let closed_dir: i32 = |posix_filesystem_host|::PosixFilesystemHost::close(dfd);
        transition got > 0 {
            true -> decode(reader, project_directory_path)
            _ -> (ProjectInfoLoad::Refused)
        }
    }
    machine decode(reader: |project_file_codec|::ProjectFileReader, project_directory_path: &[u8]) -> ProjectInfoLoad {
        let mut carried: |project_file_codec|::ProjectFileReader = reader;
        let header_ok: bool = |project_file_codec|::ProjectFileReader::check_header(&mut carried);
        transition header_ok {
            true -> stub(carried, project_directory_path)
            _ -> (ProjectInfoLoad::Refused)
        }
    }
    machine stub(reader: |project_file_codec|::ProjectFileReader, project_directory_path: &[u8]) -> ProjectInfoLoad {
        let mut carried: |project_file_codec|::ProjectFileReader = reader;
        let mut stub: ProjectInfoStub = ProjectInfoStub::default();
        let body_ok: bool = |project_file_codec_types|::decode_info_stub(&mut carried, &mut stub);
        transition body_ok {
            true -> build(stub, project_directory_path)
            _ -> (ProjectInfoLoad::Refused)
        }
    }
    machine build(stub: ProjectInfoStub, project_directory_path: &[u8]) -> ProjectInfoLoad {
        let mut info_path: [u8; 512];
        let info_len: u64 = |project_serialization|::resolve_project_info_file_path(project_directory_path, &mut info_path);
        transition info_len <= 512 {
            true -> build_info(stub, info_path, info_len)
            _ -> (ProjectInfoLoad::Refused)
        }
    }
    machine build_info(stub: ProjectInfoStub, info_path: [u8; 512], info_len: u64) -> ProjectInfoLoad
        requires info_len <= 512;
    {
        // The plugin members leave the stub before the manifest and catalog
        // move into the info; the stub is not read whole afterwards.
        let has_plugin_configuration: bool = stub.has_plugin_configuration;
        let plugin_configuration: |plugin_configuration|::PluginConfiguration = stub.plugin_configuration;
        let mut project_info: |project_info|::ProjectInfo = |project_info|::ProjectInfo::new_with_symbol_catalog(
            &info_path[0..info_len],
            stub.has_project_icon_rgba,
            &stub.project_icon_rgba,
            stub.project_manifest,
            stub.project_symbol_catalog);
        transition { _ -> plugin(project_info, has_plugin_configuration, plugin_configuration) }
    }
    machine plugin(project_info: |project_info|::ProjectInfo, has_plugin_configuration: bool, plugin_configuration: |plugin_configuration|::PluginConfiguration) -> ProjectInfoLoad {
        transition has_plugin_configuration {
            true -> with_plugin(project_info, plugin_configuration)
            _ -> finish(project_info)
        }
    }
    machine with_plugin(project_info: |project_info|::ProjectInfo, plugin_configuration: |plugin_configuration|::PluginConfiguration) -> ProjectInfoLoad {
        let mut carried: |project_info|::ProjectInfo = project_info;
        |project_info|::ProjectInfo::set_plugin_configuration(&mut carried, &plugin_configuration);
        transition { _ -> finish(carried) }
    }
    machine finish(project_info: |project_info|::ProjectInfo) -> ProjectInfoLoad {
        let mut carried: |project_info|::ProjectInfo = project_info;
        |project_info|::ProjectInfo::set_has_unsaved_changes(&mut carried, false);
        (ProjectInfoLoad::Loaded { project_info: carried })
    }
}
