module src::project::serialization::serializable_project_file;

use omega_language_std::filesystem_host;

// Port of project/serialization/serializable_project_file.rs — the save/
// load contract every project-tree node honors. Upstream's
// `anyhow::Result<()>` stores as the package's Stored/Refused convention
// (Err text is diagnostic payload upstream, not data the caller branches
// on).
pub data ProjectFileSave {
    case Refused;
    case Stored;
}

// Upstream `SerializableProjectFile::save_to_path` — the object-safe arm
// of the trait. `directory` carries the std `Path` domain (NUL-free
// bytes, the POSIX C-string invariant) — the upstream `&Path` analog;
// callers supply domained values (a `&[u8] in Path` source, a literal,
// or a concat of those) and impls derive further domained args as
// subslices and concats. `load_from_path` stays out of the trait upstream too
// (`where Self: Sized` makes it per-type, not dispatchable) — each
// project-file type declares its own load machine beside its save impl.
pub trait SerializableProjectFile {
    machine save_to_path(
        receiver: &mut Self,
        directory: &[u8] in Path,
        save_even_if_unchanged: bool
    ) -> ProjectFileSave
    invokes FilesystemHost;
}
