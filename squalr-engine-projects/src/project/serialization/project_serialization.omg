module src::project::serialization::project_serialization;

use squalr_engine_api::src::structures::projects::project::Project;
use squalr_engine_api::src::structures::projects::project_info::ProjectInfo;
use squalr_engine_api::src::structures::projects::project_items::built_in_types::project_item_type_directory::ProjectItemTypeDirectory;
use squalr_engine_api::src::structures::projects::project_items::project_item::ProjectItem;
use squalr_engine_api::src::structures::projects::project_items::project_item_pair::ProjectItemPair;
use squalr_engine_api::src::structures::projects::project_items::project_item_ref::ProjectItemRef;
use src::project::serialization::project_info_serialization::ProjectInfoLoad;
use src::project::serialization::project_item_serialization::ProjectItemLoad;
use src::project::serialization::serializable_project_file::ProjectFileSave;
use src::project::serialization::serializable_project_file::SerializableProjectFile;
use omega_language_std::filesystem_host;

// Port of project/serialization/project_serialization.rs — the free helper
// surface is fully portable; the `SerializableProjectFile for Project`
// impls are downstream of the serde_json-equivalent codec (TASKS.md
// PROJECT-SERIALIZATION): `save_to_path` writes pretty JSON per item and
// `load_from_path`'s directory walk ends in a JSON parse per item file —
// named blockers, not placeholder bodies.

// Upstream `resolve_project_root_directory_path` — directory joined with
// `Project::PROJECT_DIR` ("project_items"), bounded-carrier spelling.
pub machine resolve_project_root_directory_path(
    directory: &[u8],
    out_path: &mut [u8; 512]
) -> u64 {
    let component: &[u8] = Project::get_project_directory_name();
    (append_path_component(directory, component, out_path))
}

// The project-info file's path inside a project directory — upstream
// `directory.join(Project::PROJECT_FILE)` ("project.json").
pub machine resolve_project_info_file_path(
    directory: &[u8],
    out_path: &mut [u8; 512]
) -> u64 {
    let component: &[u8] = Project::get_project_file_name();
    (append_path_component(directory, component, out_path))
}

// `Path::join` on bounded carriers — copies `base`, one separator unless
// `base` already ends in one (upstream join semantics), then `component`;
// returns the stored byte count, truncating past the 512 bound as the
// package's path-carrier convention does elsewhere.
pub machine append_path_component(
    base: &[u8],
    component: &[u8],
    out_path: &mut [u8; 512]
) -> u64 {
    transition {
        _ -> copy_base(base, component, out_path, 0)
    }
    state copy_base(base: &[u8], component: &[u8], out_path: &mut [u8; 512], position: u64) -> u64 {
        transition position < base.len && position < 512 {
            true -> store_base(base, component, out_path, position)
            false -> bound_base(component, out_path, position)
            _ -> bound_base(component, out_path, position)
        }
    }
    // The copy loop's exit leaves `position` at min(base.len, 512) — the
    // guard mints the `<= 512` fact the separator phase contracts on.
    state bound_base(component: &[u8], out_path: &mut [u8; 512], position: u64) -> u64 {
        transition position <= 512 {
            true -> separator(component, out_path, position)
            false -> (position)
            _ -> (position)
        }
    }
    state store_base(base: &[u8], component: &[u8], out_path: &mut [u8; 512], position: u64) -> u64
        requires position < base.len && position < 512;
    {
        out_path[position] = base[position];
        transition {
            _ -> copy_base(base, component, out_path, position + 1)
        }
    }
    // separator — writes '/' at `position` unless the byte before it is
    // already a separator (`Path::join` does not double a trailing one).
    state separator(component: &[u8], out_path: &mut [u8; 512], position: u64) -> u64
        requires position <= 512;
    {
        transition position > 0 {
            true -> inspect(component, out_path, position)
            false -> write_separator(component, out_path, position)
            _ -> copy_component(component, out_path, position)
        }
    }
    state inspect(component: &[u8], out_path: &mut [u8; 512], position: u64) -> u64
        requires position <= 512 && 0 < position;
    {
        let index: u64 = position - 1;
        transition index < 512 {
            true -> decide(component, out_path, position, index)
            false -> copy_component(component, out_path, position)
            _ -> copy_component(component, out_path, position)
        }
    }
    state decide(component: &[u8], out_path: &mut [u8; 512], position: u64, index: u64) -> u64
        requires position <= 512 && index < 512;
    {
        let byte: u8 = out_path[index];
        transition byte == 47 || byte == 92 {
            true -> copy_component(component, out_path, position)
            false -> write_separator(component, out_path, position)
            _ -> write_separator(component, out_path, position)
        }
    }
    state write_separator(component: &[u8], out_path: &mut [u8; 512], position: u64) -> u64
        requires position <= 512;
    {
        transition position < 512 {
            true -> stamp(component, out_path, position)
            false -> copy_component(component, out_path, position)
            _ -> copy_component(component, out_path, position)
        }
    }
    state stamp(component: &[u8], out_path: &mut [u8; 512], position: u64) -> u64
        requires position < 512;
    {
        out_path[position] = 47;
        transition {
            _ -> copy_component(component, out_path, position + 1)
        }
    }
    state copy_component(component: &[u8], out_path: &mut [u8; 512], position: u64) -> u64
        requires position <= 512;
    {
        transition position < 512 {
            true -> stream_component(component, out_path, position, 0)
            false -> (position)
            _ -> (position)
        }
    }
    state stream_component(component: &[u8], out_path: &mut [u8; 512], position: u64, component_position: u64) -> u64
        requires position <= 512;
    {
        transition component_position < component.len && position < 512 {
            true -> store_component(component, out_path, position, component_position)
            false -> (position)
            _ -> (position)
        }
    }
    state store_component(component: &[u8], out_path: &mut [u8; 512], position: u64, component_position: u64) -> u64
        requires position < 512 && component_position < component.len;
    {
        out_path[position] = component[component_position];
        transition {
            _ -> stream_component(component, out_path, position + 1, component_position + 1)
        }
    }
}

// Upstream `is_project_item_file_path` — the file name's extension matches
// ".json" case-insensitively (`eq_ignore_ascii_case`). A file name whose
// only '.' is its first byte carries no extension upstream (hidden files).
pub machine is_project_item_file_path(project_item_path: &[u8]) -> bool {
    transition {
        _ -> scan(project_item_path, project_item_path.len)
    }
    // scan — walk back for the file name's last '.', stopping at a
    // separator (extensions do not span directories).
    state scan(project_item_path: &[u8], position: u64) -> bool {
        transition 0 < position && position <= project_item_path.len {
            true -> prior(project_item_path, position)
            false -> (false)
            _ -> (false)
        }
    }
    // `position - 1` as a call argument cannot carry the bound the callee
    // contracts on — bind it and guard it into the proof.
    state prior(project_item_path: &[u8], position: u64) -> bool
        requires 0 < position && position <= project_item_path.len;
    {
        let index: u64 = position - 1;
        transition index < project_item_path.len {
            true -> probe(project_item_path, index)
            false -> (false)
            _ -> (false)
        }
    }
    state probe(project_item_path: &[u8], index: u64) -> bool
        requires index < project_item_path.len;
    {
        let byte: u8 = project_item_path[index];
        transition byte == 46 {
            true -> match_dot(project_item_path, index)
            false -> check_separator(project_item_path, index)
            _ -> (false)
        }
    }
    state check_separator(project_item_path: &[u8], index: u64) -> bool
        requires index < project_item_path.len;
    {
        let byte: u8 = project_item_path[index];
        transition byte == 47 || byte == 92 {
            true -> (false)
            false -> scan(project_item_path, index)
            _ -> scan(project_item_path, index)
        }
    }
    // match_dot — '.' must not be the file name's first byte (hidden
    // files carry no extension upstream) and must tail exactly "json".
    state match_dot(project_item_path: &[u8], index: u64) -> bool
        requires index < project_item_path.len;
    {
        transition index > 0 {
            true -> first_byte(project_item_path, index)
            false -> (false)
            _ -> (false)
        }
    }
    state first_byte(project_item_path: &[u8], index: u64) -> bool
        requires 0 < index && index < project_item_path.len;
    {
        let previous_index: u64 = index - 1;
        transition previous_index < project_item_path.len {
            true -> peek(project_item_path, index, previous_index)
            false -> (false)
            _ -> (false)
        }
    }
    state peek(project_item_path: &[u8], index: u64, previous_index: u64) -> bool
        requires index < project_item_path.len && previous_index < project_item_path.len;
    {
        let previous: u8 = project_item_path[previous_index];
        transition previous == 47 || previous == 92 {
            true -> scan(project_item_path, index)
            false -> next(project_item_path, index)
            _ -> next(project_item_path, index)
        }
    }
    state next(project_item_path: &[u8], index: u64) -> bool
        requires index < project_item_path.len;
    {
        let next_index: u64 = index + 1;
        transition next_index <= project_item_path.len {
            true -> match_extension(project_item_path, next_index)
            false -> (false)
            _ -> (false)
        }
    }
    state match_extension(project_item_path: &[u8], start: u64) -> bool
        requires start <= project_item_path.len;
    {
        let extension_len: u64 = project_item_path.len - start;
        transition extension_len == 4 {
            true -> extension_view(project_item_path, start)
            false -> (false)
            _ -> (false)
        }
    }
    state extension_view(project_item_path: &[u8], start: u64) -> bool
        requires start <= project_item_path.len;
    {
        let tail: &[u8] = &project_item_path[start..project_item_path.len];
        transition 4 <= tail.len {
            true -> letters(tail)
            false -> (false)
            _ -> (false)
        }
    }
    state letters(tail: &[u8]) -> bool
        requires 4 <= tail.len;
    {
        let j: u8 = tail[0] | 32;
        let s: u8 = tail[1] | 32;
        let o: u8 = tail[2] | 32;
        let n: u8 = tail[3] | 32;
        transition j == 106 && s == 115 && o == 111 && n == 110 {
            true -> (true)
            false -> (false)
            _ -> (false)
        }
    }
}

// ============ SerializableProjectFile for Project ============
//
// Upstream `save_to_path` writes the project-info file, then every item
// whose ref path resolves to a regular file (per-item failures log and
// continue upstream — the port's log-free spelling continues without
// logging, same control flow). `load_from_path` reads the info file,
// creates `project_items/` when absent, then walks it depth-first —
// directories become ProjectItemTypeDirectory entries and recurse,
// `*.json` files load as items. Upstream's HashMap stores as the
// pair-table; recursion stores as the 64-deep pending stack (bounded
// deviation — a deeper or wider tree past the table's 256 entries
// refuses at the bound, matching the package's table convention).
//
// Path-domain routing (documented deviation): the `Path` domain only
// admits params/literals/concats/subslices, so runtime-carried item
// paths and dirent names ride the boundary's trusted seams instead —
// `open_at(dirfd, name)` for opening below an open directory (a
// relative path may span components), `read_file_metadata(fd)` for the
// `is_dir`/`is_file` probes upstream runs on `Path`, and
// `create_dir_name(path)` for the plain-path mkdir. The project-items
// root itself is opened by concat (`directory + "/project_items"`);
// stored item paths feed fs calls as the path bytes relative to that
// root fd (the prefix check keeps the join honest).
pub data ProjectLoad {
    case Refused;
    case Loaded(project: Project);
}

// The load walk's scratch — the pending-directory stack (bounded 64)
// carrying each open dirfd beside the path bytes that build child refs,
// the current directory's getdents buffer + cursor, the record being
// parsed, and the fstat scratch for child classification. linux x86_64
// dirent layout: d_reclen u16 at offset 16, d_type u8 at 18, name bytes
// from 19; struct stat st_mode u32 at byte 24 (S_IFMT 61440, S_IFDIR
// 16384, S_IFREG 32768).
pub data ProjectLoadContext {
    project: Project;
    pending_paths: [[u8; 512]; 64];
    pending_lens: [u64; 64];
    pending_fds: [i32; 64];
    pending_count: u64;
    dir_position: i64;
    dir_buf: [u8; 512];
    dir_total: i64;
    dir_off: u64;
    reclen: u64;
    entry_name: [u8; 256];
    entry_name_len: u64;
    pending_child: [u8; 512];
    stat_buf: [u8; 144];
    stat_rc: i32;
}

pub machine ProjectLoadContext::empty() -> ProjectLoadContext {
    (ProjectLoadContext {
        project: Project::default(),
        pending_count: 0,
        dir_position: 0,
        dir_total: 0,
        dir_off: 0,
        reclen: 0,
        entry_name_len: 0,
        stat_rc: -1,
    })
}

pub linux_x86_64 machine Project::save_to_path(
    project: &mut Project,
    directory: &[u8] in Path,
    save_even_if_unchanged: bool
) -> ProjectFileSave
satisfies SerializableProjectFile::save_to_path
reaches FilesystemHost
invokes FilesystemHost;
{
    let info_saved: ProjectFileSave = ProjectInfo::save_to_path(&mut project.project_info, directory, save_even_if_unchanged);
    transition info_saved {
        ProjectFileSave::Stored -> root_fd(project, directory, save_even_if_unchanged)
        _ -> (ProjectFileSave::Refused)
    }
    // Open the project-items root once; item file ops run dirfd-relative
    // off it (the trusted-name seam for stored path bytes — `open_at`
    // accepts a relative path, the openat semantics the boundary
    // documents). A missing root leaves every item's `is_file` probe
    // false upstream — the failed fd skips the same way. `items_root`
    // carries the join-spelled prefix bytes for the per-item rel split.
    state root_fd(project: &mut Project, directory: &[u8] in Path, save_even_if_unchanged: bool) -> ProjectFileSave {
        let mut items_root: [u8; 512];
        let root_len: u64 = resolve_project_root_directory_path(directory, &mut items_root);
        let dir_fd: i32 = FilesystemHost::open(directory, 0);
        transition dir_fd >= 0 {
            true -> items_open(project, dir_fd, items_root, root_len, save_even_if_unchanged, directory)
            _ -> (ProjectFileSave::Refused)
        }
    }
    state items_open(project: &mut Project, dir_fd: i32, items_root: [u8; 512], root_len: u64, save_even_if_unchanged: bool, directory: &[u8] in Path) -> ProjectFileSave {
        let items_fd: i32 = FilesystemHost::open_at(dir_fd, "project_items", 0);
        let closed_dir: i32 = FilesystemHost::close(dir_fd);
        transition root_len <= 512 {
            true -> items(project, items_root, root_len, items_fd, save_even_if_unchanged, 0, directory)
            _ -> drain(project, items_fd)
        }
    }
    state items(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512;
    {
        transition position < project.project_items_len && position < 256 {
            true -> copy_path(project, items_root, root_len, items_fd, save_even_if_unchanged, position, 0, directory)
            _ -> drain(project, items_fd)
        }
    }
    state drain(project: &mut Project, items_fd: i32) -> ProjectFileSave {
        let closed: i32 = FilesystemHost::close(items_fd);
        (ProjectFileSave::Stored)
    }
    // Copy the pair's ref path into scratch so the item's `&mut` borrow
    // does not alias the shared path borrow (save_even_if_unchanged
    // threads through, matching upstream's per-item flag).
    state copy_path(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, index: u64, directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512 && position < 256;
    {
        let mut path_buf: [u8; 512];
        transition { _ -> copy_at(project, items_root, root_len, items_fd, save_even_if_unchanged, position, path_buf, 0, directory) }
    }
    state copy_at(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, path_buf: [u8; 512], index: u64, directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512 && position < 256;
    {
        let source_len: u64 = project.project_items[position].project_item_ref.project_item_path_len;
        transition index < source_len && index < 512 {
            true -> copy_byte(project, items_root, root_len, items_fd, save_even_if_unchanged, position, path_buf, index, directory)
            _ -> path_bound(project, items_root, root_len, items_fd, save_even_if_unchanged, position, path_buf, index, directory)
        }
    }
    // The stored path's length must fit the 512 carrier — the dirfd
    // rel-arg is a subslice of it. Items with longer stored paths skip
    // (the carrier bound, not an upstream cap).
    state path_bound(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, path_buf: [u8; 512], path_len: u64, directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512 && position < 256;
    {
        transition path_len <= 512 {
            true -> prefix(project, items_root, root_len, items_fd, save_even_if_unchanged, position, path_buf, path_len, 0, directory)
            _ -> next(project, items_root, root_len, items_fd, save_even_if_unchanged, position, directory)
        }
    }
    state copy_byte(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, path_buf: [u8; 512], index: u64, directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512 && position < 256 && index < 512;
    {
        let mut carried: [u8; 512] = path_buf;
        carried[index] = project.project_items[position].project_item_ref.project_item_path[index];
        let next: u64 = ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> copy_at(project, items_root, root_len, items_fd, save_even_if_unchanged, position, carried, next, directory) }
    }
    // The stored item path must sit under `<directory>/project_items/` —
    // the dirfd seam only reaches there. An item outside the root skips
    // (named deviation vs upstream, whose absolute paths always resolve —
    // the boundary exposes no plain-bytes open/stat for them).
    state prefix(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, path_buf: [u8; 512], path_len: u64, index: u64, directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512 && position < 256 && path_len <= 512;
    {
        transition index < root_len && index < 512 {
            true -> prefix_byte(project, items_root, root_len, items_fd, save_even_if_unchanged, position, path_buf, path_len, index, directory)
            _ -> root_edge(project, items_root, root_len, items_fd, save_even_if_unchanged, position, path_buf, path_len, directory)
        }
    }
    state prefix_byte(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, path_buf: [u8; 512], path_len: u64, index: u64, directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512 && position < 256 && path_len <= 512 && index < 512;
    {
        transition index < path_len && path_buf[index] == items_root[index] {
            true -> prefix(project, items_root, root_len, items_fd, save_even_if_unchanged, position, path_buf, path_len, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64, directory)
            _ -> next(project, items_root, root_len, items_fd, save_even_if_unchanged, position, directory)
        }
    }
    // `index == root_len` consumed the prefix; the stored path's next
    // byte must be the separator — the rel arg is the tail past it.
    state root_edge(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, path_buf: [u8; 512], path_len: u64, directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512 && position < 256 && path_len <= 512;
    {
        let rel_start: u64 = ((root_len as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition rel_start <= path_len && root_len < path_len && path_buf[root_len] == 47 {
            true -> probe(project, items_root, root_len, items_fd, save_even_if_unchanged, position, path_buf, path_len, rel_start, directory)
            _ -> next(project, items_root, root_len, items_fd, save_even_if_unchanged, position, directory)
        }
    }
    // Upstream's `if project_item_path.is_file()` gate: probe the fd
    // then fstat it — only regular files reach the item's save arm.
    state probe(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, path_buf: [u8; 512], path_len: u64, rel_start: u64, directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512 && position < 256 && path_len <= 512 && rel_start <= path_len;
    {
        let fd: i32 = FilesystemHost::open_at(items_fd, &path_buf[rel_start..path_len], 0);
        transition fd >= 0 {
            true -> file_kind(project, items_root, root_len, items_fd, save_even_if_unchanged, position, path_buf, path_len, rel_start, fd, directory)
            _ -> next(project, items_root, root_len, items_fd, save_even_if_unchanged, position, directory)
        }
    }
    state file_kind(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, path_buf: [u8; 512], path_len: u64, rel_start: u64, fd: i32, directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512 && position < 256 && path_len <= 512 && rel_start <= path_len;
    {
        let mut stat_buf: [u8; 144];
        let rc: i32 = FilesystemHost::read_file_metadata(fd, &mut stat_buf);
        let closed: i32 = FilesystemHost::close(fd);
        transition rc >= 0 {
            true -> mode(project, items_root, root_len, items_fd, save_even_if_unchanged, position, path_buf, path_len, rel_start, stat_buf, directory)
            _ -> next(project, items_root, root_len, items_fd, save_even_if_unchanged, position, directory)
        }
    }
    state mode(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, path_buf: [u8; 512], path_len: u64, rel_start: u64, stat_buf: [u8; 144], directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512 && position < 256 && path_len <= 512 && rel_start <= path_len;
    {
        let mode: u32 = ((stat_buf[24] as u32 in Wrapping)
            | (((stat_buf[25] as u32 in Wrapping)) << 8)
            | (((stat_buf[26] as u32 in Wrapping)) << 16)
            | (((stat_buf[27] as u32 in Wrapping)) << 24)) as u32;
        transition (mode & 61440) == 32768 {
            true -> store(project, items_root, root_len, items_fd, save_even_if_unchanged, position, path_buf, path_len, rel_start, directory)
            _ -> next(project, items_root, root_len, items_fd, save_even_if_unchanged, position, directory)
        }
    }
    // Upstream `project_item.save_to_path(project_item_path, ...)`,
    // spelled `save_at` against the items-root fd; per-item failures
    // continue without logging (upstream's log::error arm).
    state store(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, path_buf: [u8; 512], path_len: u64, rel_start: u64, directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512 && position < 256 && path_len <= 512 && rel_start <= path_len;
    {
        let item_saved: ProjectFileSave = ProjectItem::save_at(&mut project.project_items[position].project_item, 
            items_fd,
            &path_buf[rel_start..path_len],
            &path_buf[0..path_len],
            save_even_if_unchanged);
        transition { _ -> next(project, items_root, root_len, items_fd, save_even_if_unchanged, position, directory) }
    }
    state next(project: &mut Project, items_root: [u8; 512], root_len: u64, items_fd: i32, save_even_if_unchanged: bool, position: u64, directory: &[u8] in Path) -> ProjectFileSave
        requires root_len <= 512 && position < 256;
    {
        let advanced: u64 = ((position as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition { _ -> items(project, items_root, root_len, items_fd, save_even_if_unchanged, advanced, directory) }
    }
}

pub linux_x86_64 machine Project::load_from_path(
    project_directory_path: &[u8] in Path
) -> ProjectLoad
reaches FilesystemHost
invokes FilesystemHost;
{
    // Upstream loads `directory/project.json` first — the impl opens the
    // leaf through the dirfd seam itself.
    let loaded: ProjectInfoLoad = ProjectInfo::load_from_path(project_directory_path);
    transition loaded {
        ProjectInfoLoad::Loaded { project_info } -> root(project_directory_path, project_info)
        _ -> (ProjectLoad::Refused)
    }
    // Root: `create_dir_all(<dir>/project_items)` when absent (upstream
    // checks then creates — the create is unconditional-modulo-EEXIST
    // either way), open it for the dirfd walk, seed the project with the
    // root directory item, and push the root onto the pending stack.
    // The dirfd seam carries the fs side: the project directory opens
    // once, and "project_items" joins as a literal leaf name.
    state root(project_directory_path: &[u8] in Path, project_info: ProjectInfo) -> ProjectLoad {
        let mut context: ProjectLoadContext = ProjectLoadContext::empty();
        let mut root_path: [u8; 512];
        let root_len: u64 = resolve_project_root_directory_path(project_directory_path, &mut root_path);
        let dir_fd: i32 = FilesystemHost::open(project_directory_path, 0);
        transition root_len <= 512 && dir_fd >= 0 {
            true -> root_make(dir_fd, root_path, root_len, project_info, context)
            _ -> (ProjectLoad::Refused)
        }
    }
    state root_make(dir_fd: i32, root_path: [u8; 512], root_len: u64, project_info: ProjectInfo, context: ProjectLoadContext) -> ProjectLoad
        requires root_len <= 512;
    {
        let root_fd: i32 = FilesystemHost::open_at(dir_fd, "project_items", 0);
        transition root_fd >= 0 {
            true -> root_insert(dir_fd, root_path, root_len, project_info, context, root_fd)
            _ -> root_create(dir_fd, root_path, root_len, project_info, context)
        }
    }
    // Upstream's absent-root arm: `create_dir_all` walks the root_path
    // buffer's prefixes (plain bytes — `create_dir_name` is the
    // boundary's plain-path mkdir, so the stored path is enough).
    state root_create(dir_fd: i32, root_path: [u8; 512], root_len: u64, project_info: ProjectInfo, context: ProjectLoadContext) -> ProjectLoad
        requires root_len <= 512;
    {
        let made: bool = create_dir_all(&root_path[0..root_len]);
        transition made {
            true -> root_reopen(dir_fd, root_path, root_len, project_info, context)
            _ -> close_dir(dir_fd)
        }
    }
    state root_reopen(dir_fd: i32, root_path: [u8; 512], root_len: u64, project_info: ProjectInfo, context: ProjectLoadContext) -> ProjectLoad
        requires root_len <= 512;
    {
        let root_fd: i32 = FilesystemHost::open_at(dir_fd, "project_items", 0);
        transition root_fd >= 0 {
            true -> root_insert(dir_fd, root_path, root_len, project_info, context, root_fd)
            _ -> close_dir(dir_fd)
        }
    }
    state close_dir(dir_fd: i32) -> ProjectLoad {
        let closed: i32 = FilesystemHost::close(dir_fd);
        (ProjectLoad::Refused)
    }
    state root_insert(dir_fd: i32, root_path: [u8; 512], root_len: u64, project_info: ProjectInfo, context: ProjectLoadContext, root_fd: i32) -> ProjectLoad
        requires root_len <= 512;
    {
        let mut carried: ProjectLoadContext = context;
        let pair_ref: ProjectItemRef = ProjectItemRef::new(&root_path[0..root_len]);
        let item: ProjectItem = ProjectItemTypeDirectory::new_project_item(&pair_ref);
        let pair: ProjectItemPair = ProjectItemPair::new(pair_ref, item);
        let root_ref: ProjectItemRef = ProjectItemRef::new(&root_path[0..root_len]);
        carried.project = Project::new(project_info, root_ref);
        let inserted: bool = Project::insert_project_item(&mut carried.project, pair);
        carried.pending_paths[0] = root_path;
        carried.pending_lens[0] = root_len;
        carried.pending_fds[0] = root_fd;
        carried.pending_count = 1;
        let closed_dir: i32 = FilesystemHost::close(dir_fd);
        transition { _ -> walk(carried) }
    }
    // The stack's top is the directory in progress — its fd is already
    // open (pushed that way); an empty stack finishes the load.
    state walk(context: ProjectLoadContext) -> ProjectLoad {
        let mut carried: ProjectLoadContext = context;
        transition carried.pending_count > 0 && carried.pending_count <= 64 {
            true -> enter(carried)
            _ -> finish(carried)
        }
    }
    state enter(context: ProjectLoadContext) -> ProjectLoad
        requires context.pending_count > 0 && context.pending_count <= 64;
    {
        let mut carried: ProjectLoadContext = context;
        let top: u64 = ((carried.pending_count as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        transition top < 64 {
            true -> fill(carried, top)
            _ -> (ProjectLoad::Refused)
        }
    }
    state fill(context: ProjectLoadContext, top: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64;
    {
        let mut carried: ProjectLoadContext = context;
        let total: i64 = FilesystemHost::read_dir(carried.pending_fds[top], &mut carried.dir_buf, 512, &mut carried.dir_position);
        carried.dir_total = total;
        carried.dir_off = 0;
        transition total > 0 {
            true -> record(carried, top)
            _ -> dir_done(carried, total)
        }
    }
    // End of entries (0) or an I/O error: close the dir's own fd and
    // pop. Upstream's `entry?`/`read_dir` errors refuse — a mid-walk
    // failure maps to Refused the same way.
    state dir_done(context: ProjectLoadContext, total: i64) -> ProjectLoad {
        let mut carried: ProjectLoadContext = context;
        transition carried.pending_count > 0 && carried.pending_count <= 64 && total >= 0 {
            true -> close_top(carried)
            _ -> (ProjectLoad::Refused)
        }
    }
    state close_top(context: ProjectLoadContext) -> ProjectLoad
        requires context.pending_count > 0 && context.pending_count <= 64;
    {
        let mut carried: ProjectLoadContext = context;
        let top: u64 = ((carried.pending_count as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        transition top < 64 {
            true -> close_do(carried, top)
            _ -> (ProjectLoad::Refused)
        }
    }
    state close_do(context: ProjectLoadContext, top: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64;
    {
        let mut carried: ProjectLoadContext = context;
        let closed: i32 = FilesystemHost::close(carried.pending_fds[top]);
        transition carried.pending_count > 0 {
            true -> pop(carried)
            _ -> (ProjectLoad::Refused)
        }
    }
    state pop(context: ProjectLoadContext) -> ProjectLoad
        requires context.pending_count > 0;
    {
        let mut carried: ProjectLoadContext = context;
        carried.pending_count = ((carried.pending_count as u64 in Wrapping) - (1 as u64 in Wrapping)) as u64;
        transition { _ -> walk(carried) }
    }
    // One dirent at dir_off: reclen (u16 at +16) frames the record;
    // malformed frames refuse like upstream's `entry?` propagation.
    state record(context: ProjectLoadContext, top: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64;
    {
        let mut carried: ProjectLoadContext = context;
        transition carried.dir_off < ((carried.dir_total as u64 in Wrapping) as u64) && carried.pending_count <= 64 {
            true -> bounded(carried, top)
            _ -> fill(carried, top)
        }
    }
    state bounded(context: ProjectLoadContext, top: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64;
    {
        let mut carried: ProjectLoadContext = context;
        let total_u: u64 = ((carried.dir_total as u64 in Wrapping) as u64);
        let head_end: u64 = ((carried.dir_off as u64 in Wrapping) + (19 as u64 in Wrapping)) as u64;
        transition carried.dir_off < total_u && head_end <= total_u && carried.dir_off < 493 {
            true -> header(carried, top)
            _ -> (ProjectLoad::Refused)
        }
    }
    state header(context: ProjectLoadContext, top: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && context.dir_off < 493;
    {
        let off_lo: u64 = context.dir_off + 16;
        let off_hi: u64 = context.dir_off + 17;
        transition off_lo < 512 && off_hi < 512 {
            true -> head_read(context, top, off_lo, off_hi)
            _ -> (ProjectLoad::Refused)
        }
    }
    state head_read(context: ProjectLoadContext, top: u64, off_lo: u64, off_hi: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && context.dir_off < 493 && off_lo < 512 && off_hi < 512;
    {
        let lo: u64 = ((context.dir_buf[off_lo] as u64 in Wrapping) as u64);
        let hi: u64 = ((context.dir_buf[off_hi] as u64 in Wrapping) as u64);
        let mut carried: ProjectLoadContext = context;
        carried.reclen = ((((hi as u64 in Wrapping) << 8) | (lo as u64 in Wrapping)) as u64);
        let end: u64 = ((carried.dir_off as u64 in Wrapping) + (carried.reclen as u64 in Wrapping)) as u64;
        let total_u: u64 = ((carried.dir_total as u64 in Wrapping) as u64);
        transition carried.reclen >= 19 && end <= total_u && carried.pending_count <= 64 && carried.dir_off < 493 {
            true -> extract(carried, top, 0)
            _ -> (ProjectLoad::Refused)
        }
    }
    // Copy the entry name: bytes from off+19 until NUL, the record end
    // (reclen), or the 255-byte name bound — upstream's `entry.file_name`.
    state extract(context: ProjectLoadContext, top: u64, j: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && context.dir_off < 493;
    {
        let mut carried: ProjectLoadContext = context;
        let name_base: u64 = ((carried.dir_off as u64 in Wrapping) + (19 as u64 in Wrapping)) as u64;
        let name_at: u64 = ((name_base as u64 in Wrapping) + (j as u64 in Wrapping)) as u64;
        let record_end: u64 = ((carried.dir_off as u64 in Wrapping) + (carried.reclen as u64 in Wrapping)) as u64;
        transition j < 255 && name_at < record_end && name_at < ((carried.dir_total as u64 in Wrapping) as u64) && name_at < 512 {
            true -> name_byte(carried, top, j, name_at)
            _ -> name_done(carried, top, j)
        }
    }
    state name_byte(context: ProjectLoadContext, top: u64, j: u64, name_at: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && j < 256 && name_at < 512;
    {
        let mut carried: ProjectLoadContext = context;
        let byte: u8 = carried.dir_buf[name_at];
        transition byte == 0 {
            true -> name_done(carried, top, j)
            _ -> store_name(carried, top, j, byte)
        }
    }
    state store_name(context: ProjectLoadContext, top: u64, j: u64, byte: u8) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && j < 256;
    {
        let mut carried: ProjectLoadContext = context;
        carried.entry_name[j] = byte;
        let next: u64 = ((j as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition carried.dir_off < 493 && carried.pending_count <= 64 {
            true -> extract(carried, top, next)
            _ -> (ProjectLoad::Refused)
        }
    }
    state name_done(context: ProjectLoadContext, top: u64, j: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64;
    {
        let mut carried: ProjectLoadContext = context;
        carried.entry_name_len = j;
        // "." and ".." skip by name — every getdents walk's required
        // filter (Rust's read_dir iterator excludes them before the
        // caller ever sees them upstream).
        let is_dot: bool = j == 1 && carried.entry_name[0] == 46;
        let is_dotdot: bool = j == 2 && carried.entry_name[0] == 46 && carried.entry_name[1] == 46;
        transition is_dot || is_dotdot {
            true -> dot_skip(carried, top)
            _ -> child_gate(carried, top, j)
        }
    }
    state dot_skip(context: ProjectLoadContext, top: u64) -> ProjectLoad {
        let mut carried: ProjectLoadContext = context;
        transition carried.pending_count <= 64 && top < 64 {
            true -> advance(carried, top)
            _ -> (ProjectLoad::Refused)
        }
    }
    state child_gate(context: ProjectLoadContext, top: u64, j: u64) -> ProjectLoad {
        let mut carried: ProjectLoadContext = context;
        transition carried.pending_count <= 64 && top < 64 && j <= 256 && carried.entry_name_len <= 256 {
            true -> child(carried, top)
            _ -> (ProjectLoad::Refused)
        }
    }
    // child = current dir's stored path + '/' + entry name — the ref's
    // identity bytes; the fs side rides the parent fd instead.
    state child(context: ProjectLoadContext, top: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && context.entry_name_len <= 256;
    {
        let mut carried: ProjectLoadContext = context;
        let dir_len: u64 = carried.pending_lens[top];
        transition dir_len <= 512 && carried.pending_count <= 64 && carried.entry_name_len <= 256 {
            true -> child_join(carried, top, dir_len)
            _ -> (ProjectLoad::Refused)
        }
    }
    state child_join(context: ProjectLoadContext, top: u64, dir_len: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && dir_len <= 512 && context.entry_name_len <= 256;
    {
        let mut carried: ProjectLoadContext = context;
        let dir_view: &[u8] = &carried.pending_paths[top][0..dir_len];
        let name_view: &[u8] = &carried.entry_name[0..carried.entry_name_len];
        let child_len: u64 = append_path_component(dir_view, name_view, &mut carried.pending_child);
        transition carried.pending_count <= 64 && carried.entry_name_len <= 256 {
            true -> child_open(carried, top, child_len)
            _ -> (ProjectLoad::Refused)
        }
    }
    // `open_at` on the parent dirfd — the designed seam for
    // read_dir-derived names; fstat on the child fd classifies (upstream
    // `entry_path.is_dir()` is also stat-backed, just path-spelled).
    state child_open(context: ProjectLoadContext, top: u64, child_len: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && context.entry_name_len <= 256;
    {
        let mut carried: ProjectLoadContext = context;
        let name_view: &[u8] = &carried.entry_name[0..carried.entry_name_len];
        let child_fd: i32 = FilesystemHost::open_at(carried.pending_fds[top], name_view, 0);
        transition child_fd >= 0 {
            true -> stat_gate(carried, top, child_len, child_fd)
            _ -> adv_gate(carried, top)
        }
    }
    state stat_gate(context: ProjectLoadContext, top: u64, child_len: u64, child_fd: i32) -> ProjectLoad {
        let mut carried: ProjectLoadContext = context;
        transition carried.pending_count <= 64 && top < 64 && child_len <= 512 && carried.entry_name_len <= 256 {
            true -> child_stat(carried, top, child_len, child_fd)
            _ -> (ProjectLoad::Refused)
        }
    }
    state adv_gate(context: ProjectLoadContext, top: u64) -> ProjectLoad {
        let mut carried: ProjectLoadContext = context;
        transition carried.pending_count <= 64 && top < 64 {
            true -> advance(carried, top)
            _ -> (ProjectLoad::Refused)
        }
    }
    state child_stat(context: ProjectLoadContext, top: u64, child_len: u64, child_fd: i32) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && child_len <= 512 && context.entry_name_len <= 256;
    {
        let mut carried: ProjectLoadContext = context;
        carried.stat_rc = FilesystemHost::read_file_metadata(child_fd, &mut carried.stat_buf);
        transition carried.stat_rc >= 0 && carried.pending_count <= 64 && carried.entry_name_len <= 256 {
            true -> classify(carried, top, child_len, child_fd)
            _ -> close_skip(carried, top, child_fd)
        }
    }
    state classify(context: ProjectLoadContext, top: u64, child_len: u64, child_fd: i32) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && child_len <= 512 && context.entry_name_len <= 256;
    {
        let mut carried: ProjectLoadContext = context;
        let mode: u32 = ((carried.stat_buf[24] as u32 in Wrapping)
            | (((carried.stat_buf[25] as u32 in Wrapping)) << 8)
            | (((carried.stat_buf[26] as u32 in Wrapping)) << 16)
            | (((carried.stat_buf[27] as u32 in Wrapping)) << 24)) as u32;
        transition (mode & 61440) == 16384 && carried.pending_count <= 64 && carried.entry_name_len <= 256 {
            true -> push_dir(carried, top, child_len, child_fd)
            _ -> file_kind(carried, top, child_len, mode, child_fd)
        }
    }
    state file_kind(context: ProjectLoadContext, top: u64, child_len: u64, mode: u32, child_fd: i32) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && child_len <= 512 && context.entry_name_len <= 256;
    {
        let mut carried: ProjectLoadContext = context;
        transition (mode & 61440) == 32768 && is_project_item_file_path(&carried.entry_name[0..carried.entry_name_len]) && carried.pending_count <= 64 {
            true -> load_item(carried, top, child_len, child_fd)
            _ -> close_skip(carried, top, child_fd)
        }
    }
    state close_skip(context: ProjectLoadContext, top: u64, child_fd: i32) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64;
    {
        let mut carried: ProjectLoadContext = context;
        let closed: i32 = FilesystemHost::close(child_fd);
        transition carried.pending_count <= 64 {
            true -> advance(carried, top)
            _ -> (ProjectLoad::Refused)
        }
    }
    // Directory child: register the directory item (upstream inserts
    // before recursing) and push the OPEN fd for the next iteration.
    state push_dir(context: ProjectLoadContext, top: u64, child_len: u64, child_fd: i32) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && child_len <= 512;
    {
        let mut carried: ProjectLoadContext = context;
        let child_view: &[u8] = &carried.pending_child[0..child_len];
        let child_ref: ProjectItemRef = ProjectItemRef::new(child_view);
        let child_item: ProjectItem = ProjectItemTypeDirectory::new_project_item(&child_ref);
        let pair: ProjectItemPair = ProjectItemPair::new(child_ref, child_item);
        let inserted: bool = Project::insert_project_item(&mut carried.project, pair);
        transition carried.pending_count < 64 {
            true -> push(carried, top, child_len, child_fd)
            _ -> skip_gate(carried, top, child_fd)
        }
    }
    state skip_gate(context: ProjectLoadContext, top: u64, child_fd: i32) -> ProjectLoad {
        let mut carried: ProjectLoadContext = context;
        transition carried.pending_count <= 64 && top < 64 {
            true -> close_skip(carried, top, child_fd)
            _ -> (ProjectLoad::Refused)
        }
    }
    state push(context: ProjectLoadContext, top: u64, child_len: u64, child_fd: i32) -> ProjectLoad
        requires context.pending_count < 64 && top < 64 && child_len <= 512;
    {
        let mut carried: ProjectLoadContext = context;
        let slot: u64 = carried.pending_count;
        carried.pending_paths[slot] = carried.pending_child;
        carried.pending_lens[slot] = child_len;
        carried.pending_fds[slot] = child_fd;
        carried.pending_count = ((slot as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64;
        transition carried.pending_count <= 64 {
            true -> advance(carried, top)
            _ -> (ProjectLoad::Refused)
        }
    }
    state load_item(context: ProjectLoadContext, top: u64, child_len: u64, child_fd: i32) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && child_len <= 512;
    {
        let mut carried: ProjectLoadContext = context;
        let mut project_item: ProjectItem = ProjectItem::default();
        let ok: bool = ProjectItem::fill_and_decode(&mut project_item, child_fd);
        let closed: i32 = FilesystemHost::close(child_fd);
        transition ok {
            true -> insert_item(carried, top, child_len, project_item)
            _ -> (ProjectLoad::Refused)
        }
    }
    state insert_item(context: ProjectLoadContext, top: u64, child_len: u64, project_item: ProjectItem) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64 && child_len <= 512;
    {
        let mut carried: ProjectLoadContext = context;
        let child_view: &[u8] = &carried.pending_child[0..child_len];
        let item_ref: ProjectItemRef = ProjectItemRef::new(child_view);
        let pair: ProjectItemPair = ProjectItemPair::new(item_ref, project_item);
        let inserted: bool = Project::insert_project_item(&mut carried.project, pair);
        transition carried.pending_count <= 64 {
            true -> advance(carried, top)
            _ -> (ProjectLoad::Refused)
        }
    }
    state advance(context: ProjectLoadContext, top: u64) -> ProjectLoad
        requires context.pending_count <= 64 && top < 64;
    {
        let mut carried: ProjectLoadContext = context;
        carried.dir_off = ((carried.dir_off as u64 in Wrapping) + (carried.reclen as u64 in Wrapping)) as u64;
        transition { _ -> record(carried, top) }
    }
    state finish(context: ProjectLoadContext) -> ProjectLoad {
        let mut carried: ProjectLoadContext = context;
        Project::set_has_unsaved_changes(&mut carried.project, false);
        (ProjectLoad::Loaded { project: carried.project })
    }
}

// Upstream `fs::create_dir_all` — each path component's prefix gets a
// best-effort `create_dir` (an already-present ancestor is fine, like
// upstream's Ok/absent split), then the leaf itself. EEXIST (-17 on the
// raw linux seam) counts as success. `path` is ordinary bytes —
// `create_dir_name` is the boundary's plain-path mkdir (its callers hand
// it stored/derived path buffers the Path domain cannot re-prove).
pub linux_x86_64 machine create_dir_all(path: &[u8]) -> bool
reaches FilesystemHost
invokes FilesystemHost;
{
    transition { _ -> walk(path, 0) }
    state walk(path: &[u8], index: u64) -> bool {
        transition index < path.len {
            true -> at(path, index)
            _ -> leaf(path)
        }
    }
    state at(path: &[u8], index: u64) -> bool
        requires index < path.len;
    {
        transition index < path.len && path[index] == 47 && index > 0 {
            true -> prefix_do(path, index)
            _ -> walk(path, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64)
        }
    }
    state prefix_do(path: &[u8], index: u64) -> bool
        requires index <= path.len;
    {
        let created: i32 = FilesystemHost::create_dir_name(&path[0..index], 493);
        transition { _ -> walk(path, ((index as u64 in Wrapping) + (1 as u64 in Wrapping)) as u64) }
    }
    state leaf(path: &[u8]) -> bool {
        let created: i32 = FilesystemHost::create_dir_name(path, 493);
        transition created >= 0 || created == -17 {
            true -> (true)
            _ -> (false)
        }
    }
}
