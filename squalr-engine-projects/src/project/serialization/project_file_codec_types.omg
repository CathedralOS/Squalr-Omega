// Port of the serde_json derives upstream puts on every serialized
// record — one encode/decode pair per type, fields in declared order.
// This file is the package-local schema table: the byte layout described
// in project_file_codec.omg is realized here and nowhere else.
//
// Fixed-capacity fields serialize as u64 length + the live bytes (never
// the whole padded array), so the encoding is stable under package bound
// changes; bounded tables serialize as u64 count + elements. Unions carry
// a u8 case tag numbered in declaration order. Optional members
// (has_* flags) encode the flag then the payload when present — upstream
// serde `skip`s on ProjectItem do not appear here either, so the item
// file stores item_type + properties and nothing else.
//
// The ValuedStructFieldData::NestedStruct walk lives in
// project_file_codec_item.omg — runtime recursion is tail-only, so the
// inline child tree rides an explicit pending-frame stack bounded by the
// pool arena, matching the StructCursor precedent in valued_struct.omg.

// ============ bounded-string codec (one per capacity) ============

pub machine encode_string256(writer: &mut ProjectFileWriter, content: &[u8; 256], len: u64) -> bool {
    transition len <= 256 {
        true -> emit(writer, content, len)
        _ -> (false)
    }
    state emit(writer: &mut ProjectFileWriter, content: &[u8; 256], len: u64) -> bool
        requires len <= 256;
    {
        let stored: bool = writer.put_bytes(&content[0..len]);
        (stored)
    }
}

pub machine decode_string256(reader: &mut ProjectFileReader, out: &mut [u8; 256], out_len: &mut u64) -> bool {
    let count: u64 = reader.get_u64();
    transition reader.get_position() <= reader.get_len() {
        true -> bounded(reader, out, out_len, count)
        _ -> refuse(reader, out, out_len)
    }
    state bounded(reader: &mut ProjectFileReader, out: &mut [u8; 256], out_len: &mut u64, count: u64) -> bool {
        let remaining: u64 = reader.get_len() - reader.get_position();
        transition count <= 256 && count <= remaining {
            true -> copy(reader, out, out_len, count, 0)
            _ -> refuse(reader, out, out_len)
        }
    }
    state copy(reader: &mut ProjectFileReader, out: &mut [u8; 256], out_len: &mut u64, count: u64, position: u64) -> bool
        requires count <= 256;
    {
        transition position < count && position < 256 {
            true -> byte(reader, out, out_len, count, position)
            _ -> accept(reader, out, out_len, count)
        }
    }
    state byte(reader: &mut ProjectFileReader, out: &mut [u8; 256], out_len: &mut u64, count: u64, position: u64) -> bool
        requires position < 256 && count <= 256;
    {
        let byte: u8 = reader.get_u8();
        out[position] = byte;
        transition {
            _ -> copy(reader, out, out_len, count, position + 1)
        }
    }
    state accept(reader: &mut ProjectFileReader, out: &mut [u8; 256], out_len: &mut u64, count: u64) -> bool {
        out_len = count;
        (true)
    }
    state refuse(reader: &mut ProjectFileReader, out: &mut [u8; 256], out_len: &mut u64) -> bool {
        (false)
    }
}

