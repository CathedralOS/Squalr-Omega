// ============ leaf + small-union codecs ============

pub machine encode_layout_kind(writer: &mut ProjectFileWriter, value: &SymbolicLayoutKind) -> bool {
    transition value {
        SymbolicLayoutKind::Struct -> struct_kind(writer, value)
        SymbolicLayoutKind::Union -> union_kind(writer, value)
    }
    state struct_kind(writer: &mut ProjectFileWriter, value: &SymbolicLayoutKind) -> bool {
        let stored: bool = writer.put_byte(0);
        (stored)
    }
    state union_kind(writer: &mut ProjectFileWriter, value: &SymbolicLayoutKind) -> bool {
        let stored: bool = writer.put_byte(1);
        (stored)
    }
}

pub machine decode_layout_kind(reader: &mut ProjectFileReader, value: &mut SymbolicLayoutKind) -> bool {
    let tag: u8 = reader.get_u8();
    transition tag {
        0 -> struct_kind(reader, value)
        1 -> union_kind(reader, value)
        _ -> (false)
    }
    state struct_kind(reader: &mut ProjectFileReader, value: &mut SymbolicLayoutKind) -> bool {
        value[0] = SymbolicLayoutKind::Struct;
        (true)
    }
    state union_kind(reader: &mut ProjectFileReader, value: &mut SymbolicLayoutKind) -> bool {
        value[0] = SymbolicLayoutKind::Union;
        (true)
    }
}

pub machine encode_pointer_size(writer: &mut ProjectFileWriter, value: &PointerScanPointerSize) -> bool {
    transition value {
        PointerScanPointerSize::Pointer24be -> pick(writer, value, 0)
        PointerScanPointerSize::Pointer24 -> pick(writer, value, 1)
        PointerScanPointerSize::Pointer32be -> pick(writer, value, 2)
        PointerScanPointerSize::Pointer32 -> pick(writer, value, 3)
        PointerScanPointerSize::Pointer64be -> pick(writer, value, 4)
        PointerScanPointerSize::Pointer64 -> pick(writer, value, 5)
    }
    state pick(writer: &mut ProjectFileWriter, value: &PointerScanPointerSize, tag: u8) -> bool {
        let stored: bool = writer.put_byte(tag);
        (stored)
    }
}

pub machine decode_pointer_size(reader: &mut ProjectFileReader, value: &mut PointerScanPointerSize) -> bool {
    let tag: u8 = reader.get_u8();
    transition tag {
        0 -> pick(reader, value, PointerScanPointerSize::Pointer24be)
        1 -> pick(reader, value, PointerScanPointerSize::Pointer24)
        2 -> pick(reader, value, PointerScanPointerSize::Pointer32be)
        3 -> pick(reader, value, PointerScanPointerSize::Pointer32)
        4 -> pick(reader, value, PointerScanPointerSize::Pointer64be)
        5 -> pick(reader, value, PointerScanPointerSize::Pointer64)
        _ -> (false)
    }
    state pick(reader: &mut ProjectFileReader, value: &mut PointerScanPointerSize, chosen: PointerScanPointerSize) -> bool {
        value[0] = chosen;
        (true)
    }
}

pub machine encode_value_format(writer: &mut ProjectFileWriter, value: &AnonymousValueStringFormat) -> bool {
    transition value {
        AnonymousValueStringFormat::Bool -> pick(writer, value, 0)
        AnonymousValueStringFormat::String -> pick(writer, value, 1)
        AnonymousValueStringFormat::Binary -> pick(writer, value, 2)
        AnonymousValueStringFormat::Decimal -> pick(writer, value, 3)
        AnonymousValueStringFormat::Hexadecimal -> pick(writer, value, 4)
        AnonymousValueStringFormat::Address -> pick(writer, value, 5)
        AnonymousValueStringFormat::DataTypeRef -> pick(writer, value, 6)
        AnonymousValueStringFormat::Enumeration -> pick(writer, value, 7)
    }
    state pick(writer: &mut ProjectFileWriter, value: &AnonymousValueStringFormat, tag: u8) -> bool {
        let stored: bool = writer.put_byte(tag);
        (stored)
    }
}

pub machine decode_value_format(reader: &mut ProjectFileReader, value: &mut AnonymousValueStringFormat) -> bool {
    let tag: u8 = reader.get_u8();
    transition tag {
        0 -> pick(reader, value, AnonymousValueStringFormat::Bool)
        1 -> pick(reader, value, AnonymousValueStringFormat::String)
        2 -> pick(reader, value, AnonymousValueStringFormat::Binary)
        3 -> pick(reader, value, AnonymousValueStringFormat::Decimal)
        4 -> pick(reader, value, AnonymousValueStringFormat::Hexadecimal)
        5 -> pick(reader, value, AnonymousValueStringFormat::Address)
        6 -> pick(reader, value, AnonymousValueStringFormat::DataTypeRef)
        7 -> pick(reader, value, AnonymousValueStringFormat::Enumeration)
        _ -> (false)
    }
    state pick(reader: &mut ProjectFileReader, value: &mut AnonymousValueStringFormat, chosen: AnonymousValueStringFormat) -> bool {
        value[0] = chosen;
        (true)
    }
}

pub machine encode_binary_operator(writer: &mut ProjectFileWriter, value: &SymbolicResolverBinaryOperator) -> bool {
    transition value {
        SymbolicResolverBinaryOperator::Add -> pick(writer, value, 0)
        SymbolicResolverBinaryOperator::Subtract -> pick(writer, value, 1)
        SymbolicResolverBinaryOperator::Multiply -> pick(writer, value, 2)
        SymbolicResolverBinaryOperator::Divide -> pick(writer, value, 3)
        SymbolicResolverBinaryOperator::Modulo -> pick(writer, value, 4)
        SymbolicResolverBinaryOperator::BitwiseAnd -> pick(writer, value, 5)
        SymbolicResolverBinaryOperator::BitwiseOr -> pick(writer, value, 6)
        SymbolicResolverBinaryOperator::BitwiseXor -> pick(writer, value, 7)
        SymbolicResolverBinaryOperator::ShiftLeft -> pick(writer, value, 8)
        SymbolicResolverBinaryOperator::ShiftRight -> pick(writer, value, 9)
        SymbolicResolverBinaryOperator::Minimum -> pick(writer, value, 10)
        SymbolicResolverBinaryOperator::Maximum -> pick(writer, value, 11)
        SymbolicResolverBinaryOperator::Equal -> pick(writer, value, 12)
        SymbolicResolverBinaryOperator::NotEqual -> pick(writer, value, 13)
        SymbolicResolverBinaryOperator::LessThan -> pick(writer, value, 14)
        SymbolicResolverBinaryOperator::LessThanOrEqual -> pick(writer, value, 15)
        SymbolicResolverBinaryOperator::GreaterThan -> pick(writer, value, 16)
        SymbolicResolverBinaryOperator::GreaterThanOrEqual -> pick(writer, value, 17)
    }
    state pick(writer: &mut ProjectFileWriter, value: &SymbolicResolverBinaryOperator, tag: u8) -> bool {
        let stored: bool = writer.put_byte(tag);
        (stored)
    }
}

pub machine decode_binary_operator(reader: &mut ProjectFileReader, value: &mut SymbolicResolverBinaryOperator) -> bool {
    let tag: u8 = reader.get_u8();
    transition tag {
        0 -> pick(reader, value, SymbolicResolverBinaryOperator::Add)
        1 -> pick(reader, value, SymbolicResolverBinaryOperator::Subtract)
        2 -> pick(reader, value, SymbolicResolverBinaryOperator::Multiply)
        3 -> pick(reader, value, SymbolicResolverBinaryOperator::Divide)
        4 -> pick(reader, value, SymbolicResolverBinaryOperator::Modulo)
        5 -> pick(reader, value, SymbolicResolverBinaryOperator::BitwiseAnd)
        6 -> pick(reader, value, SymbolicResolverBinaryOperator::BitwiseOr)
        7 -> pick(reader, value, SymbolicResolverBinaryOperator::BitwiseXor)
        8 -> pick(reader, value, SymbolicResolverBinaryOperator::ShiftLeft)
        9 -> pick(reader, value, SymbolicResolverBinaryOperator::ShiftRight)
        10 -> pick(reader, value, SymbolicResolverBinaryOperator::Minimum)
        11 -> pick(reader, value, SymbolicResolverBinaryOperator::Maximum)
        12 -> pick(reader, value, SymbolicResolverBinaryOperator::Equal)
        13 -> pick(reader, value, SymbolicResolverBinaryOperator::NotEqual)
        14 -> pick(reader, value, SymbolicResolverBinaryOperator::LessThan)
        15 -> pick(reader, value, SymbolicResolverBinaryOperator::LessThanOrEqual)
        16 -> pick(reader, value, SymbolicResolverBinaryOperator::GreaterThan)
        17 -> pick(reader, value, SymbolicResolverBinaryOperator::GreaterThanOrEqual)
        _ -> (false)
    }
    state pick(reader: &mut ProjectFileReader, value: &mut SymbolicResolverBinaryOperator, chosen: SymbolicResolverBinaryOperator) -> bool {
        value[0] = chosen;
        (true)
    }
}

pub machine encode_data_type_ref(writer: &mut ProjectFileWriter, value: &DataTypeRef) -> bool {
    let stored: bool = encode_string32(writer, &value.data_type_id, value.data_type_id_len);
    (stored)
}

pub machine decode_data_type_ref(reader: &mut ProjectFileReader, value: &mut DataTypeRef) -> bool {
    let mut len: u64 = 0;
    let stored: bool = decode_string32(reader, &mut value.data_type_id, &mut len);
    value.data_type_id_len = len;
    (stored)
}

pub machine encode_resolver_ref(writer: &mut ProjectFileWriter, value: &SymbolicResolverRef) -> bool {
    let stored: bool = encode_string256(writer, &value.resolver_id, value.resolver_id_len);
    (stored)
}

pub machine decode_resolver_ref(reader: &mut ProjectFileReader, value: &mut SymbolicResolverRef) -> bool {
    let mut len: u64 = 0;
    let stored: bool = decode_string256(reader, &mut value.resolver_id, &mut len);
    value.resolver_id_len = len;
    (stored)
}

pub machine encode_count_resolution(writer: &mut ProjectFileWriter, value: &SymbolicFieldCountResolution) -> bool {
    transition value {
        SymbolicFieldCountResolution::Inferred -> inferred(writer, value)
        SymbolicFieldCountResolution::Resolver { resolver_id, resolver_id_len } -> resolver(writer, value, resolver_id, resolver_id_len)
    }
    state inferred(writer: &mut ProjectFileWriter, value: &SymbolicFieldCountResolution) -> bool {
        let stored: bool = writer.put_byte(0);
        (stored)
    }
    state resolver(writer: &mut ProjectFileWriter, value: &SymbolicFieldCountResolution, resolver_id: &[u8; 256], resolver_id_len: u64) -> bool {
        let a: bool = writer.put_byte(1);
        let b: bool = encode_string256(writer, resolver_id, resolver_id_len);
        (a && b)
    }
}

pub machine decode_count_resolution(reader: &mut ProjectFileReader, value: &mut SymbolicFieldCountResolution) -> bool {
    let tag: u8 = reader.get_u8();
    transition tag {
        0 -> inferred(reader, value)
        1 -> resolver(reader, value)
        _ -> (false)
    }
    state inferred(reader: &mut ProjectFileReader, value: &mut SymbolicFieldCountResolution) -> bool {
        value[0] = SymbolicFieldCountResolution::Inferred;
        (true)
    }
    state resolver(reader: &mut ProjectFileReader, value: &mut SymbolicFieldCountResolution) -> bool {
        let mut resolver_id: [u8; 256];
        let mut resolver_id_len: u64 = 0;
        let stored: bool = decode_string256(reader, &mut resolver_id, &mut resolver_id_len);
        transition stored {
            true -> assign(reader, value, resolver_id, resolver_id_len)
            _ -> (false)
        }
    }
    state assign(reader: &mut ProjectFileReader, value: &mut SymbolicFieldCountResolution, resolver_id: [u8; 256], resolver_id_len: u64) -> bool {
        value[0] = SymbolicFieldCountResolution::Resolver { resolver_id: resolver_id, resolver_id_len: resolver_id_len };
        (true)
    }
}

pub machine encode_offset_resolution(writer: &mut ProjectFileWriter, value: &SymbolicFieldOffsetResolution) -> bool {
    transition value {
        SymbolicFieldOffsetResolution::Sequential -> sequential(writer, value)
        SymbolicFieldOffsetResolution::Static { offset_in_bytes } -> fixed(writer, value, offset_in_bytes)
        SymbolicFieldOffsetResolution::Resolver { resolver_id, resolver_id_len } -> resolver(writer, value, resolver_id, resolver_id_len)
    }
    state sequential(writer: &mut ProjectFileWriter, value: &SymbolicFieldOffsetResolution) -> bool {
        let stored: bool = writer.put_byte(0);
        (stored)
    }
    state fixed(writer: &mut ProjectFileWriter, value: &SymbolicFieldOffsetResolution, offset_in_bytes: u64) -> bool {
        let a: bool = writer.put_byte(1);
        let b: bool = writer.put_u64(offset_in_bytes);
        (a && b)
    }
    state resolver(writer: &mut ProjectFileWriter, value: &SymbolicFieldOffsetResolution, resolver_id: &[u8; 256], resolver_id_len: u64) -> bool {
        let a: bool = writer.put_byte(2);
        let b: bool = encode_string256(writer, resolver_id, resolver_id_len);
        (a && b)
    }
}

pub machine decode_offset_resolution(reader: &mut ProjectFileReader, value: &mut SymbolicFieldOffsetResolution) -> bool {
    let tag: u8 = reader.get_u8();
    transition tag {
        0 -> sequential(reader, value)
        1 -> fixed(reader, value)
        2 -> resolver(reader, value)
        _ -> (false)
    }
    state sequential(reader: &mut ProjectFileReader, value: &mut SymbolicFieldOffsetResolution) -> bool {
        value[0] = SymbolicFieldOffsetResolution::Sequential;
        (true)
    }
    state fixed(reader: &mut ProjectFileReader, value: &mut SymbolicFieldOffsetResolution) -> bool {
        let offset_in_bytes: u64 = reader.get_u64();
        value[0] = SymbolicFieldOffsetResolution::Static { offset_in_bytes: offset_in_bytes };
        (true)
    }
    state resolver(reader: &mut ProjectFileReader, value: &mut SymbolicFieldOffsetResolution) -> bool {
        let mut resolver_id: [u8; 256];
        let mut resolver_id_len: u64 = 0;
        let stored: bool = decode_string256(reader, &mut resolver_id, &mut resolver_id_len);
        transition stored {
            true -> assign(reader, value, resolver_id, resolver_id_len)
            _ -> (false)
        }
    }
    state assign(reader: &mut ProjectFileReader, value: &mut SymbolicFieldOffsetResolution, resolver_id: [u8; 256], resolver_id_len: u64) -> bool {
        value[0] = SymbolicFieldOffsetResolution::Resolver { resolver_id: resolver_id, resolver_id_len: resolver_id_len };
        (true)
    }
}

pub machine encode_container_type(writer: &mut ProjectFileWriter, value: &ContainerType) -> bool {
    transition value {
        ContainerType::None -> none_type(writer, value)
        ContainerType::Array -> array_type(writer, value)
        ContainerType::ArrayFixed { length } -> fixed(writer, value, length)
        ContainerType::Pointer { pointer_size } -> ptr(writer, value, pointer_size)
        ContainerType::PointerArray { pointer_size } -> ptr_array(writer, value, pointer_size)
        ContainerType::PointerArrayFixed { pointer_size, length } -> ptr_array_fixed(writer, value, pointer_size, length)
    }
    state none_type(writer: &mut ProjectFileWriter, value: &ContainerType) -> bool {
        let stored: bool = writer.put_byte(0);
        (stored)
    }
    state array_type(writer: &mut ProjectFileWriter, value: &ContainerType) -> bool {
        let stored: bool = writer.put_byte(1);
        (stored)
    }
    state fixed(writer: &mut ProjectFileWriter, value: &ContainerType, length: u64) -> bool {
        let a: bool = writer.put_byte(2);
        let b: bool = writer.put_u64(length);
        (a && b)
    }
    state ptr(writer: &mut ProjectFileWriter, value: &ContainerType, pointer_size: &PointerScanPointerSize) -> bool {
        let a: bool = writer.put_byte(3);
        let b: bool = encode_pointer_size(writer, pointer_size);
        (a && b)
    }
    state ptr_array(writer: &mut ProjectFileWriter, value: &ContainerType, pointer_size: &PointerScanPointerSize) -> bool {
        let a: bool = writer.put_byte(4);
        let b: bool = encode_pointer_size(writer, pointer_size);
        (a && b)
    }
    state ptr_array_fixed(writer: &mut ProjectFileWriter, value: &ContainerType, pointer_size: &PointerScanPointerSize, length: u64) -> bool {
        let a: bool = writer.put_byte(5);
        let b: bool = encode_pointer_size(writer, pointer_size);
        let c: bool = writer.put_u64(length);
        (a && b && c)
    }
}

pub machine decode_container_type(reader: &mut ProjectFileReader, value: &mut ContainerType) -> bool {
    let tag: u8 = reader.get_u8();
    transition tag {
        0 -> none_type(reader, value)
        1 -> array_type(reader, value)
        2 -> fixed(reader, value)
        3 -> pointer(reader, value)
        4 -> pointer_array(reader, value)
        5 -> pointer_array_fixed(reader, value)
        _ -> (false)
    }
    state none_type(reader: &mut ProjectFileReader, value: &mut ContainerType) -> bool {
        value[0] = ContainerType::None;
        (true)
    }
    state array_type(reader: &mut ProjectFileReader, value: &mut ContainerType) -> bool {
        value[0] = ContainerType::Array;
        (true)
    }
    state fixed(reader: &mut ProjectFileReader, value: &mut ContainerType) -> bool {
        let length: u64 = reader.get_u64();
        value[0] = ContainerType::ArrayFixed { length: length };
        (true)
    }
    state pointer(reader: &mut ProjectFileReader, value: &mut ContainerType) -> bool {
        let mut size: PointerScanPointerSize = PointerScanPointerSize::Pointer64;
        let stored: bool = decode_pointer_size(reader, &mut size);
        transition stored {
            true -> assign_pointer(reader, value, size)
            _ -> (false)
        }
    }
    state assign_pointer(reader: &mut ProjectFileReader, value: &mut ContainerType, size: PointerScanPointerSize) -> bool {
        value[0] = ContainerType::Pointer { pointer_size: size };
        (true)
    }
    state pointer_array(reader: &mut ProjectFileReader, value: &mut ContainerType) -> bool {
        let mut size: PointerScanPointerSize = PointerScanPointerSize::Pointer64;
        let stored: bool = decode_pointer_size(reader, &mut size);
        transition stored {
            true -> assign_pointer_array(reader, value, size)
            _ -> (false)
        }
    }
    state assign_pointer_array(reader: &mut ProjectFileReader, value: &mut ContainerType, size: PointerScanPointerSize) -> bool {
        value[0] = ContainerType::PointerArray { pointer_size: size };
        (true)
    }
    state pointer_array_fixed(reader: &mut ProjectFileReader, value: &mut ContainerType) -> bool {
        let mut size: PointerScanPointerSize = PointerScanPointerSize::Pointer64;
        let stored: bool = decode_pointer_size(reader, &mut size);
        let length: u64 = reader.get_u64();
        transition stored {
            true -> assign_pointer_array_fixed(reader, value, size, length)
            _ -> (false)
        }
    }
    state assign_pointer_array_fixed(reader: &mut ProjectFileReader, value: &mut ContainerType, size: PointerScanPointerSize, length: u64) -> bool {
        value[0] = ContainerType::PointerArrayFixed { pointer_size: size, length: length };
        (true)
    }
}

// ============ resolver graph ============

pub machine encode_chain_symbol(writer: &mut ProjectFileWriter, value: &PointerChainSymbol) -> bool {
    let stored: bool = encode_string256(writer, &value.symbol_name, value.symbol_name_len);
    (stored)
}

pub machine decode_chain_symbol(reader: &mut ProjectFileReader, value: &mut PointerChainSymbol) -> bool {
    let mut len: u64 = 0;
    let stored: bool = decode_string256(reader, &mut value.symbol_name, &mut len);
    value.symbol_name_len = len;
    (stored)
}

pub machine encode_chain_link(writer: &mut ProjectFileWriter, value: &SymbolicPointerChainLink) -> bool {
    transition value {
        SymbolicPointerChainLink::Offset { offset } -> offset_arm(writer, value, offset)
        SymbolicPointerChainLink::Symbol { symbol } -> symbol_arm(writer, value, symbol)
    }
    state offset_arm(writer: &mut ProjectFileWriter, value: &SymbolicPointerChainLink, offset: i64) -> bool {
        let a: bool = writer.put_byte(0);
        let b: bool = writer.put_i64(offset);
        (a && b)
    }
    state symbol_arm(writer: &mut ProjectFileWriter, value: &SymbolicPointerChainLink, symbol: &PointerChainSymbol) -> bool {
        let a: bool = writer.put_byte(1);
        let b: bool = encode_chain_symbol(writer, symbol);
        (a && b)
    }
}

pub machine decode_chain_link(reader: &mut ProjectFileReader, value: &mut SymbolicPointerChainLink) -> bool {
    let tag: u8 = reader.get_u8();
    transition tag {
        0 -> offset_arm(reader, value)
        1 -> symbol_arm(reader, value)
        _ -> (false)
    }
    state offset_arm(reader: &mut ProjectFileReader, value: &mut SymbolicPointerChainLink) -> bool {
        let offset: i64 = reader.get_i64();
        value[0] = SymbolicPointerChainLink::Offset { offset: offset };
        (true)
    }
    state symbol_arm(reader: &mut ProjectFileReader, value: &mut SymbolicPointerChainLink) -> bool {
        let mut symbol: PointerChainSymbol = PointerChainSymbol { symbol_name_len: 0 };
        let stored: bool = decode_chain_symbol(reader, &mut symbol);
        transition stored {
            true -> assign(reader, value, symbol)
            _ -> (false)
        }
    }
    state assign(reader: &mut ProjectFileReader, value: &mut SymbolicPointerChainLink, symbol: PointerChainSymbol) -> bool {
        value[0] = SymbolicPointerChainLink::Symbol { symbol: symbol };
        (true)
    }
}

pub machine encode_owned_chain(writer: &mut ProjectFileWriter, value: &OwnedSymbolicPointerChain) -> bool {
    let a: bool = encode_string256(writer, &value.module_name, value.module_name_len);
    let b: bool = writer.put_u64(value.link_count);
    let c: bool = encode_pointer_size(writer, &value.pointer_size);
    transition a && b && c {
        true -> links(writer, value, 0)
        _ -> (false)
    }
    state links(writer: &mut ProjectFileWriter, value: &OwnedSymbolicPointerChain, position: u64) -> bool {
        transition position < value.link_count && position < 64 {
            true -> link(writer, value, position)
            _ -> (position >= value.link_count)
        }
    }
    state link(writer: &mut ProjectFileWriter, value: &OwnedSymbolicPointerChain, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = encode_chain_link(writer, &value.links[position]);
        transition stored {
            true -> links(writer, value, position + 1)
            _ -> (false)
        }
    }
}

pub machine decode_owned_chain(reader: &mut ProjectFileReader, value: &mut OwnedSymbolicPointerChain) -> bool {
    let mut name_len: u64 = 0;
    let name_ok: bool = decode_string256(reader, &mut value.module_name, &mut name_len);
    value.module_name_len = name_len;
    let count: u64 = reader.get_u64();
    let mut size: PointerScanPointerSize = PointerScanPointerSize::Pointer64;
    let size_ok: bool = decode_pointer_size(reader, &mut size);
    value.pointer_size = size;
    transition name_ok && size_ok && count <= 64 {
        true -> links(reader, value, count, 0)
        _ -> refuse(reader, value)
    }
    state links(reader: &mut ProjectFileReader, value: &mut OwnedSymbolicPointerChain, count: u64, position: u64) -> bool {
        transition position < count && position < 64 {
            true -> link(reader, value, count, position)
            _ -> accept(reader, value, count)
        }
    }
    state link(reader: &mut ProjectFileReader, value: &mut OwnedSymbolicPointerChain, count: u64, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = decode_chain_link(reader, &mut value.links[position]);
        transition stored {
            true -> links(reader, value, count, position + 1)
            _ -> (false)
        }
    }
    state accept(reader: &mut ProjectFileReader, value: &mut OwnedSymbolicPointerChain, count: u64) -> bool {
        value.link_count = count;
        (true)
    }
    state refuse(reader: &mut ProjectFileReader, value: &mut OwnedSymbolicPointerChain) -> bool {
        (false)
    }
}

pub machine encode_relative_symbol_path(writer: &mut ProjectFileWriter, value: &SymbolicResolverRelativeSymbolPath) -> bool {
    let stored: bool = encode_owned_chain(writer, &value.pointer_chain);
    (stored)
}

pub machine decode_relative_symbol_path(reader: &mut ProjectFileReader, value: &mut SymbolicResolverRelativeSymbolPath) -> bool {
    let stored: bool = decode_owned_chain(reader, &mut value.pointer_chain);
    (stored)
}

pub machine encode_resolver_node(writer: &mut ProjectFileWriter, value: &SymbolicResolverNode) -> bool {
    transition value {
        SymbolicResolverNode::Literal { literal_lo, literal_hi } -> literal_arm(writer, value, literal_lo, literal_hi)
        SymbolicResolverNode::LocalField { field_name, field_name_len } -> local_field_arm(writer, value, field_name, field_name_len)
        SymbolicResolverNode::RelativeSymbolField { symbol_path } -> relative_symbol_arm(writer, value, symbol_path)
        SymbolicResolverNode::GlobalSymbolField { module_name, module_name_len, symbol_path } -> global_symbol_arm(writer, value, module_name, module_name_len, symbol_path)
        SymbolicResolverNode::RelativePointerChain { pointer_chain } -> relative_chain_arm(writer, value, pointer_chain)
        SymbolicResolverNode::GlobalPointerChain { pointer_chain } -> global_chain_arm(writer, value, pointer_chain)
        SymbolicResolverNode::TypeSize { data_type_ref } -> type_size_arm(writer, value, data_type_ref)
        SymbolicResolverNode::Binary { operator, left_node_index, right_node_index } -> binary_arm(writer, value, operator, left_node_index, right_node_index)
        SymbolicResolverNode::Conditional { condition_node_index, true_node_index, false_node_index } -> conditional_arm(writer, value, condition_node_index, true_node_index, false_node_index)
    }
    state literal_arm(writer: &mut ProjectFileWriter, value: &SymbolicResolverNode, literal_lo: u64, literal_hi: u64) -> bool {
        let a: bool = writer.put_byte(0);
        let b: bool = writer.put_u64(literal_lo);
        let c: bool = writer.put_u64(literal_hi);
        (a && b && c)
    }
    state local_field_arm(writer: &mut ProjectFileWriter, value: &SymbolicResolverNode, field_name: &[u8; 256], field_name_len: u64) -> bool {
        let a: bool = writer.put_byte(1);
        let b: bool = encode_string256(writer, field_name, field_name_len);
        (a && b)
    }
    state relative_symbol_arm(writer: &mut ProjectFileWriter, value: &SymbolicResolverNode, symbol_path: &SymbolicResolverRelativeSymbolPath) -> bool {
        let a: bool = writer.put_byte(2);
        let b: bool = encode_relative_symbol_path(writer, symbol_path);
        (a && b)
    }
    state global_symbol_arm(writer: &mut ProjectFileWriter, value: &SymbolicResolverNode, module_name: &[u8; 256], module_name_len: u64, symbol_path: &SymbolicResolverRelativeSymbolPath) -> bool {
        let a: bool = writer.put_byte(3);
        let b: bool = encode_string256(writer, module_name, module_name_len);
        let c: bool = encode_relative_symbol_path(writer, symbol_path);
        (a && b && c)
    }
    state relative_chain_arm(writer: &mut ProjectFileWriter, value: &SymbolicResolverNode, pointer_chain: &OwnedSymbolicPointerChain) -> bool {
        let a: bool = writer.put_byte(4);
        let b: bool = encode_owned_chain(writer, pointer_chain);
        (a && b)
    }
    state global_chain_arm(writer: &mut ProjectFileWriter, value: &SymbolicResolverNode, pointer_chain: &OwnedSymbolicPointerChain) -> bool {
        let a: bool = writer.put_byte(5);
        let b: bool = encode_owned_chain(writer, pointer_chain);
        (a && b)
    }
    state type_size_arm(writer: &mut ProjectFileWriter, value: &SymbolicResolverNode, data_type_ref: &DataTypeRef) -> bool {
        let a: bool = writer.put_byte(6);
        let b: bool = encode_data_type_ref(writer, data_type_ref);
        (a && b)
    }
    state binary_arm(writer: &mut ProjectFileWriter, value: &SymbolicResolverNode, operator: &SymbolicResolverBinaryOperator, left_node_index: u64, right_node_index: u64) -> bool {
        let a: bool = writer.put_byte(7);
        let b: bool = encode_binary_operator(writer, operator);
        let c: bool = writer.put_u64(left_node_index);
        let d: bool = writer.put_u64(right_node_index);
        (a && b && c && d)
    }
    state conditional_arm(writer: &mut ProjectFileWriter, value: &SymbolicResolverNode, condition_node_index: u64, true_node_index: u64, false_node_index: u64) -> bool {
        let a: bool = writer.put_byte(8);
        let b: bool = writer.put_u64(condition_node_index);
        let c: bool = writer.put_u64(true_node_index);
        let d: bool = writer.put_u64(false_node_index);
        (a && b && c && d)
    }
}

pub machine decode_resolver_node(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode) -> bool {
    let tag: u8 = reader.get_u8();
    transition tag {
        0 -> literal_arm(reader, value)
        1 -> local_field_arm(reader, value)
        2 -> relative_symbol_arm(reader, value)
        3 -> global_symbol_arm(reader, value)
        4 -> relative_chain_arm(reader, value)
        5 -> global_chain_arm(reader, value)
        6 -> type_size_arm(reader, value)
        7 -> binary_arm(reader, value)
        8 -> conditional_arm(reader, value)
        _ -> (false)
    }
    state literal_arm(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode) -> bool {
        let literal_lo: u64 = reader.get_u64();
        let literal_hi: u64 = reader.get_u64();
        value[0] = SymbolicResolverNode::Literal { literal_lo: literal_lo, literal_hi: literal_hi };
        (true)
    }
    state local_field_arm(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode) -> bool {
        let mut field_name: [u8; 256];
        let mut field_name_len: u64 = 0;
        let stored: bool = decode_string256(reader, &mut field_name, &mut field_name_len);
        transition stored {
            true -> assign_local(reader, value, field_name, field_name_len)
            _ -> (false)
        }
    }
    state assign_local(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode, field_name: [u8; 256], field_name_len: u64) -> bool {
        value[0] = SymbolicResolverNode::LocalField { field_name: field_name, field_name_len: field_name_len };
        (true)
    }
    state relative_symbol_arm(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode) -> bool {
        let mut symbol_path: SymbolicResolverRelativeSymbolPath = SymbolicResolverRelativeSymbolPath::default();
        let stored: bool = decode_relative_symbol_path(reader, &mut symbol_path);
        transition stored {
            true -> assign_relative_symbol(reader, value, symbol_path)
            _ -> (false)
        }
    }
    state assign_relative_symbol(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode, symbol_path: SymbolicResolverRelativeSymbolPath) -> bool {
        value[0] = SymbolicResolverNode::RelativeSymbolField { symbol_path: symbol_path };
        (true)
    }
    state global_symbol_arm(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode) -> bool {
        let mut module_name: [u8; 256];
        let mut module_name_len: u64 = 0;
        let name_ok: bool = decode_string256(reader, &mut module_name, &mut module_name_len);
        let mut symbol_path: SymbolicResolverRelativeSymbolPath = SymbolicResolverRelativeSymbolPath::default();
        let path_ok: bool = decode_relative_symbol_path(reader, &mut symbol_path);
        transition name_ok && path_ok {
            true -> assign_global_symbol(reader, value, module_name, module_name_len, symbol_path)
            _ -> (false)
        }
    }
    state assign_global_symbol(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode, module_name: [u8; 256], module_name_len: u64, symbol_path: SymbolicResolverRelativeSymbolPath) -> bool {
        value[0] = SymbolicResolverNode::GlobalSymbolField { module_name: module_name, module_name_len: module_name_len, symbol_path: symbol_path };
        (true)
    }
    state relative_chain_arm(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode) -> bool {
        let mut pointer_chain: OwnedSymbolicPointerChain = OwnedSymbolicPointerChain::default();
        let stored: bool = decode_owned_chain(reader, &mut pointer_chain);
        transition stored {
            true -> assign_relative_chain(reader, value, pointer_chain)
            _ -> (false)
        }
    }
    state assign_relative_chain(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode, pointer_chain: OwnedSymbolicPointerChain) -> bool {
        value[0] = SymbolicResolverNode::RelativePointerChain { pointer_chain: pointer_chain };
        (true)
    }
    state global_chain_arm(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode) -> bool {
        let mut pointer_chain: OwnedSymbolicPointerChain = OwnedSymbolicPointerChain::default();
        let stored: bool = decode_owned_chain(reader, &mut pointer_chain);
        transition stored {
            true -> assign_global_chain(reader, value, pointer_chain)
            _ -> (false)
        }
    }
    state assign_global_chain(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode, pointer_chain: OwnedSymbolicPointerChain) -> bool {
        value[0] = SymbolicResolverNode::GlobalPointerChain { pointer_chain: pointer_chain };
        (true)
    }
    state type_size_arm(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode) -> bool {
        let mut data_type_ref: DataTypeRef = DataTypeRef::default();
        let stored: bool = decode_data_type_ref(reader, &mut data_type_ref);
        transition stored {
            true -> assign_type_size(reader, value, data_type_ref)
            _ -> (false)
        }
    }
    state assign_type_size(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode, data_type_ref: DataTypeRef) -> bool {
        value[0] = SymbolicResolverNode::TypeSize { data_type_ref: data_type_ref };
        (true)
    }
    state binary_arm(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode) -> bool {
        let mut operator: SymbolicResolverBinaryOperator = SymbolicResolverBinaryOperator::Add;
        let op_ok: bool = decode_binary_operator(reader, &mut operator);
        let left_node_index: u64 = reader.get_u64();
        let right_node_index: u64 = reader.get_u64();
        transition op_ok {
            true -> assign_binary(reader, value, operator, left_node_index, right_node_index)
            _ -> (false)
        }
    }
    state assign_binary(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode, operator: SymbolicResolverBinaryOperator, left_node_index: u64, right_node_index: u64) -> bool {
        value[0] = SymbolicResolverNode::Binary { operator: operator, left_node_index: left_node_index, right_node_index: right_node_index };
        (true)
    }
    state conditional_arm(reader: &mut ProjectFileReader, value: &mut SymbolicResolverNode) -> bool {
        let condition_node_index: u64 = reader.get_u64();
        let true_node_index: u64 = reader.get_u64();
        let false_node_index: u64 = reader.get_u64();
        value[0] = SymbolicResolverNode::Conditional { condition_node_index: condition_node_index, true_node_index: true_node_index, false_node_index: false_node_index };
        (true)
    }
}

pub machine encode_resolver_definition(writer: &mut ProjectFileWriter, value: &SymbolicResolverDefinition) -> bool {
    let a: bool = writer.put_u64(value.node_count);
    let b: bool = writer.put_u64(value.root_node_index);
    transition a && b {
        true -> nodes(writer, value, 0)
        _ -> (false)
    }
    state nodes(writer: &mut ProjectFileWriter, value: &SymbolicResolverDefinition, position: u64) -> bool {
        transition position < value.node_count && position < 128 {
            true -> node(writer, value, position)
            _ -> (position >= value.node_count)
        }
    }
    state node(writer: &mut ProjectFileWriter, value: &SymbolicResolverDefinition, position: u64) -> bool
        requires position < 128;
    {
        let stored: bool = encode_resolver_node(writer, &value.nodes[position]);
        transition stored {
            true -> nodes(writer, value, position + 1)
            _ -> (false)
        }
    }
}

pub machine decode_resolver_definition(reader: &mut ProjectFileReader, value: &mut SymbolicResolverDefinition) -> bool {
    let count: u64 = reader.get_u64();
    let root_node_index: u64 = reader.get_u64();
    transition count <= 128 {
        true -> nodes(reader, value, count, root_node_index, 0)
        _ -> (false)
    }
    state nodes(reader: &mut ProjectFileReader, value: &mut SymbolicResolverDefinition, count: u64, root_node_index: u64, position: u64) -> bool {
        transition position < count && position < 128 {
            true -> node(reader, value, count, root_node_index, position)
            _ -> accept(reader, value, count, root_node_index)
        }
    }
    state node(reader: &mut ProjectFileReader, value: &mut SymbolicResolverDefinition, count: u64, root_node_index: u64, position: u64) -> bool
        requires position < 128;
    {
        let stored: bool = decode_resolver_node(reader, &mut value.nodes[position]);
        transition stored {
            true -> nodes(reader, value, count, root_node_index, position + 1)
            _ -> (false)
        }
    }
    state accept(reader: &mut ProjectFileReader, value: &mut SymbolicResolverDefinition, count: u64, root_node_index: u64) -> bool {
        value.node_count = count;
        value.root_node_index = root_node_index;
        (true)
    }
}

pub machine encode_resolver_descriptor(writer: &mut ProjectFileWriter, value: &SymbolicResolverDescriptor) -> bool {
    let a: bool = encode_string256(writer, &value.resolver_id, value.resolver_id_len);
    let b: bool = encode_resolver_definition(writer, &value.resolver_definition);
    (a && b)
}

pub machine decode_resolver_descriptor(reader: &mut ProjectFileReader, value: &mut SymbolicResolverDescriptor) -> bool {
    let mut len: u64 = 0;
    let id_ok: bool = decode_string256(reader, &mut value.resolver_id, &mut len);
    value.resolver_id_len = len;
    let def_ok: bool = decode_resolver_definition(reader, &mut value.resolver_definition);
    (id_ok && def_ok)
}

// ============ defined field + field definition ============

pub machine encode_defined_field(writer: &mut ProjectFileWriter, value: &SymbolicDefinedField) -> bool {
    let a: bool = encode_string256(writer, &value.field_name, value.field_name_len);
    let b: bool = encode_data_type_ref(writer, &value.data_type_ref);
    let c: bool = encode_container_type(writer, &value.container_type);
    let d: bool = encode_count_resolution(writer, &value.count_resolution);
    let e: bool = encode_count_resolution(writer, &value.display_count_resolution);
    let f: bool = encode_offset_resolution(writer, &value.offset_resolution);
    let g: bool = writer.put_bool(value.has_active_when_resolver);
    let h: bool = writer.put_bool(value.has_display_format);
    transition a && b && c && d && e && f && g && h {
        true -> optional_members(writer, value)
        _ -> (false)
    }
    state optional_members(writer: &mut ProjectFileWriter, value: &SymbolicDefinedField) -> bool {
        transition value.has_active_when_resolver {
            true -> active_when(writer, value)
            _ -> display_format(writer, value)
        }
    }
    state active_when(writer: &mut ProjectFileWriter, value: &SymbolicDefinedField) -> bool {
        let stored: bool = encode_resolver_ref(writer, &value.active_when_resolver);
        transition stored {
            true -> display_format(writer, value)
            _ -> (false)
        }
    }
    state display_format(writer: &mut ProjectFileWriter, value: &SymbolicDefinedField) -> bool {
        transition value.has_display_format {
            true -> emit_format(writer, value)
            _ -> (true)
        }
    }
    state emit_format(writer: &mut ProjectFileWriter, value: &SymbolicDefinedField) -> bool {
        let stored: bool = encode_value_format(writer, &value.display_format);
        (stored)
    }
}

pub machine decode_defined_field(reader: &mut ProjectFileReader, value: &mut SymbolicDefinedField) -> bool {
    let mut name_len: u64 = 0;
    let name_ok: bool = decode_string256(reader, &mut value.field_name, &mut name_len);
    value.field_name_len = name_len;
    let type_ok: bool = decode_data_type_ref(reader, &mut value.data_type_ref);
    let container_ok: bool = decode_container_type(reader, &mut value.container_type);
    let count_ok: bool = decode_count_resolution(reader, &mut value.count_resolution);
    let display_count_ok: bool = decode_count_resolution(reader, &mut value.display_count_resolution);
    let offset_ok: bool = decode_offset_resolution(reader, &mut value.offset_resolution);
    let has_active: bool = reader.get_bool();
    value.has_active_when_resolver = has_active;
    let has_format: bool = reader.get_bool();
    value.has_display_format = has_format;
    transition name_ok && type_ok && container_ok && count_ok && display_count_ok && offset_ok {
        true -> optional_members(reader, value, has_active, has_format)
        _ -> (false)
    }
    state optional_members(reader: &mut ProjectFileReader, value: &mut SymbolicDefinedField, has_active: bool, has_format: bool) -> bool {
        transition has_active {
            true -> active_when(reader, value, has_format)
            _ -> display_format(reader, value, has_format)
        }
    }
    state active_when(reader: &mut ProjectFileReader, value: &mut SymbolicDefinedField, has_format: bool) -> bool {
        let stored: bool = decode_resolver_ref(reader, &mut value.active_when_resolver);
        transition stored {
            true -> display_format(reader, value, has_format)
            _ -> (false)
        }
    }
    state display_format(reader: &mut ProjectFileReader, value: &mut SymbolicDefinedField, has_format: bool) -> bool {
        transition has_format {
            true -> read_format(reader, value)
            _ -> (true)
        }
    }
    state read_format(reader: &mut ProjectFileReader, value: &mut SymbolicDefinedField) -> bool {
        let stored: bool = decode_value_format(reader, &mut value.display_format);
        (stored)
    }
}

pub machine encode_field_definition(writer: &mut ProjectFileWriter, value: &SymbolicFieldDefinition) -> bool {
    transition value {
        SymbolicFieldDefinition::Field { field } -> field_arm(writer, value, field)
        SymbolicFieldDefinition::Unassigned { size_in_bytes } -> unassigned_arm(writer, value, size_in_bytes)
    }
    state field_arm(writer: &mut ProjectFileWriter, value: &SymbolicFieldDefinition, field: &SymbolicDefinedField) -> bool {
        let a: bool = writer.put_byte(0);
        let b: bool = encode_defined_field(writer, field);
        (a && b)
    }
    state unassigned_arm(writer: &mut ProjectFileWriter, value: &SymbolicFieldDefinition, size_in_bytes: u64) -> bool {
        let a: bool = writer.put_byte(1);
        let b: bool = writer.put_u64(size_in_bytes);
        (a && b)
    }
}

pub machine decode_field_definition(reader: &mut ProjectFileReader, value: &mut SymbolicFieldDefinition) -> bool {
    let tag: u8 = reader.get_u8();
    transition tag {
        0 -> field_arm(reader, value)
        1 -> unassigned_arm(reader, value)
        _ -> (false)
    }
    state field_arm(reader: &mut ProjectFileReader, value: &mut SymbolicFieldDefinition) -> bool {
        let mut defined_field: SymbolicDefinedField = SymbolicDefinedField {
            field_name_len: 0,
            data_type_ref: DataTypeRef::default(),
            container_type: ContainerType::None,
            count_resolution: SymbolicFieldCountResolution::Inferred,
            display_count_resolution: SymbolicFieldCountResolution::Inferred,
            offset_resolution: SymbolicFieldOffsetResolution::Sequential,
            has_active_when_resolver: false,
            active_when_resolver: (SymbolicResolverRef { resolver_id_len: 0 }),
            has_display_format: false,
            display_format: AnonymousValueStringFormat::Hexadecimal,
        };
        let stored: bool = decode_defined_field(reader, &mut defined_field);
        transition stored {
            true -> assign_field(reader, value, defined_field)
            _ -> (false)
        }
    }
    state assign_field(reader: &mut ProjectFileReader, value: &mut SymbolicFieldDefinition, defined_field: SymbolicDefinedField) -> bool {
        value[0] = SymbolicFieldDefinition::Field { field: defined_field };
        (true)
    }
    state unassigned_arm(reader: &mut ProjectFileReader, value: &mut SymbolicFieldDefinition) -> bool {
        let size_in_bytes: u64 = reader.get_u64();
        value[0] = SymbolicFieldDefinition::Unassigned { size_in_bytes: size_in_bytes };
        (true)
    }
}

pub machine encode_struct_definition(writer: &mut ProjectFileWriter, value: &SymbolicStructDefinition) -> bool {
    let a: bool = encode_string256(writer, &value.symbol_namespace, value.symbol_namespace_len);
    let b: bool = encode_layout_kind(writer, &value.layout_kind);
    let c: bool = writer.put_bool(value.has_declared_size);
    let d: bool = writer.put_u64(value.field_count);
    transition a && b && c && d {
        true -> optional_size(writer, value)
        _ -> (false)
    }
    state optional_size(writer: &mut ProjectFileWriter, value: &SymbolicStructDefinition) -> bool {
        transition value.has_declared_size {
            true -> size(writer, value)
            _ -> fields(writer, value, 0)
        }
    }
    state size(writer: &mut ProjectFileWriter, value: &SymbolicStructDefinition) -> bool {
        let stored: bool = writer.put_u64(value.declared_size_in_bytes);
        transition stored {
            true -> fields(writer, value, 0)
            _ -> (false)
        }
    }
    state fields(writer: &mut ProjectFileWriter, value: &SymbolicStructDefinition, position: u64) -> bool {
        transition position < value.field_count && position < 64 {
            true -> field(writer, value, position)
            _ -> (position >= value.field_count)
        }
    }
    state field(writer: &mut ProjectFileWriter, value: &SymbolicStructDefinition, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = encode_field_definition(writer, &value.fields[position]);
        transition stored {
            true -> fields(writer, value, position + 1)
            _ -> (false)
        }
    }
}

pub machine decode_struct_definition(reader: &mut ProjectFileReader, value: &mut SymbolicStructDefinition) -> bool {
    let mut namespace_len: u64 = 0;
    let namespace_ok: bool = decode_string256(reader, &mut value.symbol_namespace, &mut namespace_len);
    value.symbol_namespace_len = namespace_len;
    let kind_ok: bool = decode_layout_kind(reader, &mut value.layout_kind);
    let has_size: bool = reader.get_bool();
    value.has_declared_size = has_size;
    let count: u64 = reader.get_u64();
    transition namespace_ok && kind_ok && count <= 64 {
        true -> optional_size(reader, value, has_size, count)
        _ -> (false)
    }
    state optional_size(reader: &mut ProjectFileReader, value: &mut SymbolicStructDefinition, has_size: bool, count: u64) -> bool {
        transition has_size {
            true -> size(reader, value, count)
            _ -> fields(reader, value, count, 0)
        }
    }
    state size(reader: &mut ProjectFileReader, value: &mut SymbolicStructDefinition, count: u64) -> bool {
        let declared_size_in_bytes: u64 = reader.get_u64();
        value.declared_size_in_bytes = declared_size_in_bytes;
        transition {
            _ -> fields(reader, value, count, 0)
        }
    }
    state fields(reader: &mut ProjectFileReader, value: &mut SymbolicStructDefinition, count: u64, position: u64) -> bool {
        transition position < count && position < 64 {
            true -> field(reader, value, count, position)
            _ -> accept(reader, value, count)
        }
    }
    state field(reader: &mut ProjectFileReader, value: &mut SymbolicStructDefinition, count: u64, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = decode_field_definition(reader, &mut value.fields[position]);
        transition stored {
            true -> fields(reader, value, count, position + 1)
            _ -> (false)
        }
    }
    state accept(reader: &mut ProjectFileReader, value: &mut SymbolicStructDefinition, count: u64) -> bool {
        value.field_count = count;
        (true)
    }
}

pub machine encode_layout_descriptor(writer: &mut ProjectFileWriter, value: &StructLayoutDescriptor) -> bool {
    let a: bool = encode_string256(writer, &value.struct_layout_id, value.struct_layout_id_len);
    let b: bool = encode_struct_definition(writer, &value.struct_layout_definition);
    (a && b)
}

pub machine decode_layout_descriptor(reader: &mut ProjectFileReader, value: &mut StructLayoutDescriptor) -> bool {
    let mut len: u64 = 0;
    let id_ok: bool = decode_string256(reader, &mut value.struct_layout_id, &mut len);
    value.struct_layout_id_len = len;
    let def_ok: bool = decode_struct_definition(reader, &mut value.struct_layout_definition);
    (id_ok && def_ok)
}

// ============ symbol-catalog tables ============

pub machine encode_module_field(writer: &mut ProjectFileWriter, value: &ProjectSymbolModuleField) -> bool {
    let a: bool = encode_string256(writer, &value.display_name, value.display_name_len);
    let b: bool = writer.put_u64(value.offset);
    let c: bool = encode_string256(writer, &value.struct_layout_id, value.struct_layout_id_len);
    (a && b && c)
}

pub machine decode_module_field(reader: &mut ProjectFileReader, value: &mut ProjectSymbolModuleField) -> bool {
    let mut name_len: u64 = 0;
    let name_ok: bool = decode_string256(reader, &mut value.display_name, &mut name_len);
    value.display_name_len = name_len;
    let offset: u64 = reader.get_u64();
    value.offset = offset;
    let mut id_len: u64 = 0;
    let id_ok: bool = decode_string256(reader, &mut value.struct_layout_id, &mut id_len);
    value.struct_layout_id_len = id_len;
    (name_ok && id_ok)
}

pub machine encode_symbol_module(writer: &mut ProjectFileWriter, value: &ProjectSymbolModule) -> bool {
    let a: bool = encode_string256(writer, &value.module_name, value.module_name_len);
    let b: bool = writer.put_u64(value.size);
    let c: bool = writer.put_u64(value.field_count);
    transition a && b && c {
        true -> fields(writer, value, 0)
        _ -> (false)
    }
    state fields(writer: &mut ProjectFileWriter, value: &ProjectSymbolModule, position: u64) -> bool {
        transition position < value.field_count && position < 64 {
            true -> field(writer, value, position)
            _ -> (position >= value.field_count)
        }
    }
    state field(writer: &mut ProjectFileWriter, value: &ProjectSymbolModule, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = encode_module_field(writer, &value.fields[position]);
        transition stored {
            true -> fields(writer, value, position + 1)
            _ -> (false)
        }
    }
}

pub machine decode_symbol_module(reader: &mut ProjectFileReader, value: &mut ProjectSymbolModule) -> bool {
    let mut name_len: u64 = 0;
    let name_ok: bool = decode_string256(reader, &mut value.module_name, &mut name_len);
    value.module_name_len = name_len;
    let size: u64 = reader.get_u64();
    value.size = size;
    let count: u64 = reader.get_u64();
    transition name_ok && count <= 64 {
        true -> fields(reader, value, count, 0)
        _ -> (false)
    }
    state fields(reader: &mut ProjectFileReader, value: &mut ProjectSymbolModule, count: u64, position: u64) -> bool {
        transition position < count && position < 64 {
            true -> field(reader, value, count, position)
            _ -> accept(reader, value, count)
        }
    }
    state field(reader: &mut ProjectFileReader, value: &mut ProjectSymbolModule, count: u64, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = decode_module_field(reader, &mut value.fields[position]);
        transition stored {
            true -> fields(reader, value, count, position + 1)
            _ -> (false)
        }
    }
    state accept(reader: &mut ProjectFileReader, value: &mut ProjectSymbolModule, count: u64) -> bool {
        value.field_count = count;
        (true)
    }
}

pub machine encode_symbol_locator(writer: &mut ProjectFileWriter, value: &ProjectSymbolLocator) -> bool {
    transition value {
        ProjectSymbolLocator::AbsoluteAddress { address, module_name, module_name_len } -> absolute_arm(writer, value, address, module_name, module_name_len)
        ProjectSymbolLocator::ModuleOffset { module_name, module_name_len, offset } -> offset_arm(writer, value, module_name, module_name_len, offset)
    }
    state absolute_arm(writer: &mut ProjectFileWriter, value: &ProjectSymbolLocator, address: u64, module_name: &[u8; 256], module_name_len: u64) -> bool {
        let a: bool = writer.put_byte(0);
        let b: bool = writer.put_u64(address);
        let c: bool = encode_string256(writer, module_name, module_name_len);
        (a && b && c)
    }
    state offset_arm(writer: &mut ProjectFileWriter, value: &ProjectSymbolLocator, module_name: &[u8; 256], module_name_len: u64, offset: u64) -> bool {
        let a: bool = writer.put_byte(1);
        let b: bool = encode_string256(writer, module_name, module_name_len);
        let c: bool = writer.put_u64(offset);
        (a && b && c)
    }
}

pub machine decode_symbol_locator(reader: &mut ProjectFileReader, value: &mut ProjectSymbolLocator) -> bool {
    let tag: u8 = reader.get_u8();
    transition tag {
        0 -> absolute_arm(reader, value)
        1 -> offset_arm(reader, value)
        _ -> (false)
    }
    state absolute_arm(reader: &mut ProjectFileReader, value: &mut ProjectSymbolLocator) -> bool {
        let address: u64 = reader.get_u64();
        let mut module_name: [u8; 256];
        let mut module_name_len: u64 = 0;
        let stored: bool = decode_string256(reader, &mut module_name, &mut module_name_len);
        transition stored {
            true -> assign_absolute(reader, value, address, module_name, module_name_len)
            _ -> (false)
        }
    }
    state assign_absolute(reader: &mut ProjectFileReader, value: &mut ProjectSymbolLocator, address: u64, module_name: [u8; 256], module_name_len: u64) -> bool {
        value[0] = ProjectSymbolLocator::AbsoluteAddress { address: address, module_name: module_name, module_name_len: module_name_len };
        (true)
    }
    state offset_arm(reader: &mut ProjectFileReader, value: &mut ProjectSymbolLocator) -> bool {
        let mut module_name: [u8; 256];
        let mut module_name_len: u64 = 0;
        let name_ok: bool = decode_string256(reader, &mut module_name, &mut module_name_len);
        let offset: u64 = reader.get_u64();
        transition name_ok {
            true -> assign_offset(reader, value, module_name, module_name_len, offset)
            _ -> (false)
        }
    }
    state assign_offset(reader: &mut ProjectFileReader, value: &mut ProjectSymbolLocator, module_name: [u8; 256], module_name_len: u64, offset: u64) -> bool {
        value[0] = ProjectSymbolLocator::ModuleOffset { module_name: module_name, module_name_len: module_name_len, offset: offset };
        (true)
    }
}

pub machine encode_metadata_entry(writer: &mut ProjectFileWriter, value: &ProjectSymbolClaimMetadataEntry) -> bool {
    let a: bool = encode_string256(writer, &value.key, value.key_len);
    let b: bool = encode_string256(writer, &value.value, value.value_len);
    (a && b)
}

pub machine decode_metadata_entry(reader: &mut ProjectFileReader, value: &mut ProjectSymbolClaimMetadataEntry) -> bool {
    let mut key_len: u64 = 0;
    let key_ok: bool = decode_string256(reader, &mut value.key, &mut key_len);
    value.key_len = key_len;
    let mut value_len: u64 = 0;
    let value_ok: bool = decode_string256(reader, &mut value.value, &mut value_len);
    value.value_len = value_len;
    (key_ok && value_ok)
}

pub machine encode_symbol_claim(writer: &mut ProjectFileWriter, value: &ProjectSymbolClaim) -> bool {
    let a: bool = encode_string256(writer, &value.display_name, value.display_name_len);
    let b: bool = encode_symbol_locator(writer, &value.locator);
    let c: bool = encode_string256(writer, &value.struct_layout_id, value.struct_layout_id_len);
    let d: bool = writer.put_u64(value.metadata_count);
    transition a && b && c && d {
        true -> metadata(writer, value, 0)
        _ -> (false)
    }
    state metadata(writer: &mut ProjectFileWriter, value: &ProjectSymbolClaim, position: u64) -> bool {
        transition position < value.metadata_count && position < 64 {
            true -> entry_at(writer, value, position)
            _ -> (position >= value.metadata_count)
        }
    }
    state entry_at(writer: &mut ProjectFileWriter, value: &ProjectSymbolClaim, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = encode_metadata_entry(writer, &value.metadata[position]);
        transition stored {
            true -> metadata(writer, value, position + 1)
            _ -> (false)
        }
    }
}

pub machine decode_symbol_claim(reader: &mut ProjectFileReader, value: &mut ProjectSymbolClaim) -> bool {
    let mut name_len: u64 = 0;
    let name_ok: bool = decode_string256(reader, &mut value.display_name, &mut name_len);
    value.display_name_len = name_len;
    let locator_ok: bool = decode_symbol_locator(reader, &mut value.locator);
    let mut id_len: u64 = 0;
    let id_ok: bool = decode_string256(reader, &mut value.struct_layout_id, &mut id_len);
    value.struct_layout_id_len = id_len;
    let count: u64 = reader.get_u64();
    transition name_ok && locator_ok && id_ok && count <= 64 {
        true -> metadata(reader, value, count, 0)
        _ -> (false)
    }
    state metadata(reader: &mut ProjectFileReader, value: &mut ProjectSymbolClaim, count: u64, position: u64) -> bool {
        transition position < count && position < 64 {
            true -> entry_at(reader, value, count, position)
            _ -> accept(reader, value, count)
        }
    }
    state entry_at(reader: &mut ProjectFileReader, value: &mut ProjectSymbolClaim, count: u64, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = decode_metadata_entry(reader, &mut value.metadata[position]);
        transition stored {
            true -> metadata(reader, value, count, position + 1)
            _ -> (false)
        }
    }
    state accept(reader: &mut ProjectFileReader, value: &mut ProjectSymbolClaim, count: u64) -> bool {
        value.metadata_count = count;
        (true)
    }
}

pub machine encode_symbol_catalog(writer: &mut ProjectFileWriter, value: &ProjectSymbolCatalog) -> bool {
    let a: bool = writer.put_u64(value.symbol_module_count);
    let b: bool = writer.put_u64(value.struct_layout_descriptor_count);
    let c: bool = writer.put_u64(value.symbolic_resolver_descriptor_count);
    let d: bool = writer.put_u64(value.symbol_claim_count);
    transition a && b && c && d {
        true -> modules(writer, value, 0)
        _ -> (false)
    }
    state modules(writer: &mut ProjectFileWriter, value: &ProjectSymbolCatalog, position: u64) -> bool {
        transition position < value.symbol_module_count && position < 64 {
            true -> module_entry(writer, value, position)
            _ -> descriptors(writer, value, 0)
        }
    }
    state module_entry(writer: &mut ProjectFileWriter, value: &ProjectSymbolCatalog, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = encode_symbol_module(writer, &value.symbol_modules[position]);
        transition stored {
            true -> modules(writer, value, position + 1)
            _ -> (false)
        }
    }
    state descriptors(writer: &mut ProjectFileWriter, value: &ProjectSymbolCatalog, position: u64) -> bool {
        transition position < value.struct_layout_descriptor_count && position < 128 {
            true -> descriptor(writer, value, position)
            _ -> resolvers(writer, value, 0)
        }
    }
    state descriptor(writer: &mut ProjectFileWriter, value: &ProjectSymbolCatalog, position: u64) -> bool
        requires position < 128;
    {
        let stored: bool = encode_layout_descriptor(writer, &value.struct_layout_descriptors[position]);
        transition stored {
            true -> descriptors(writer, value, position + 1)
            _ -> (false)
        }
    }
    state resolvers(writer: &mut ProjectFileWriter, value: &ProjectSymbolCatalog, position: u64) -> bool {
        transition position < value.symbolic_resolver_descriptor_count && position < 64 {
            true -> resolver(writer, value, position)
            _ -> claims(writer, value, 0)
        }
    }
    state resolver(writer: &mut ProjectFileWriter, value: &ProjectSymbolCatalog, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = encode_resolver_descriptor(writer, &value.symbolic_resolver_descriptors[position]);
        transition stored {
            true -> resolvers(writer, value, position + 1)
            _ -> (false)
        }
    }
    state claims(writer: &mut ProjectFileWriter, value: &ProjectSymbolCatalog, position: u64) -> bool {
        transition position < value.symbol_claim_count && position < 128 {
            true -> claim(writer, value, position)
            _ -> (position >= value.symbol_claim_count)
        }
    }
    state claim(writer: &mut ProjectFileWriter, value: &ProjectSymbolCatalog, position: u64) -> bool
        requires position < 128;
    {
        let stored: bool = encode_symbol_claim(writer, &value.symbol_claims[position]);
        transition stored {
            true -> claims(writer, value, position + 1)
            _ -> (false)
        }
    }
}

pub machine decode_symbol_catalog(reader: &mut ProjectFileReader, value: &mut ProjectSymbolCatalog) -> bool {
    let modules: u64 = reader.get_u64();
    let descriptors: u64 = reader.get_u64();
    let resolvers: u64 = reader.get_u64();
    let claims: u64 = reader.get_u64();
    transition modules <= 64 && descriptors <= 128 && resolvers <= 64 && claims <= 128 {
        true -> module_loop(reader, value, modules, descriptors, resolvers, claims, 0)
        _ -> (false)
    }
    state module_loop(reader: &mut ProjectFileReader, value: &mut ProjectSymbolCatalog, modules: u64, descriptors: u64, resolvers: u64, claims: u64, position: u64) -> bool {
        transition position < modules && position < 64 {
            true -> module_entry(reader, value, modules, descriptors, resolvers, claims, position)
            _ -> descriptor_loop(reader, value, modules, descriptors, resolvers, claims, 0)
        }
    }
    state module_entry(reader: &mut ProjectFileReader, value: &mut ProjectSymbolCatalog, modules: u64, descriptors: u64, resolvers: u64, claims: u64, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = decode_symbol_module(reader, &mut value.symbol_modules[position]);
        transition stored {
            true -> module_loop(reader, value, modules, descriptors, resolvers, claims, position + 1)
            _ -> (false)
        }
    }
    state descriptor_loop(reader: &mut ProjectFileReader, value: &mut ProjectSymbolCatalog, modules: u64, descriptors: u64, resolvers: u64, claims: u64, position: u64) -> bool {
        transition position < descriptors && position < 128 {
            true -> descriptor_entry(reader, value, modules, descriptors, resolvers, claims, position)
            _ -> resolver_loop(reader, value, modules, descriptors, resolvers, claims, 0)
        }
    }
    state descriptor_entry(reader: &mut ProjectFileReader, value: &mut ProjectSymbolCatalog, modules: u64, descriptors: u64, resolvers: u64, claims: u64, position: u64) -> bool
        requires position < 128;
    {
        let stored: bool = decode_layout_descriptor(reader, &mut value.struct_layout_descriptors[position]);
        transition stored {
            true -> descriptor_loop(reader, value, modules, descriptors, resolvers, claims, position + 1)
            _ -> (false)
        }
    }
    state resolver_loop(reader: &mut ProjectFileReader, value: &mut ProjectSymbolCatalog, modules: u64, descriptors: u64, resolvers: u64, claims: u64, position: u64) -> bool {
        transition position < resolvers && position < 64 {
            true -> resolver_entry(reader, value, modules, descriptors, resolvers, claims, position)
            _ -> claim_loop(reader, value, modules, descriptors, resolvers, claims, 0)
        }
    }
    state resolver_entry(reader: &mut ProjectFileReader, value: &mut ProjectSymbolCatalog, modules: u64, descriptors: u64, resolvers: u64, claims: u64, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = decode_resolver_descriptor(reader, &mut value.symbolic_resolver_descriptors[position]);
        transition stored {
            true -> resolver_loop(reader, value, modules, descriptors, resolvers, claims, position + 1)
            _ -> (false)
        }
    }
    state claim_loop(reader: &mut ProjectFileReader, value: &mut ProjectSymbolCatalog, modules: u64, descriptors: u64, resolvers: u64, claims: u64, position: u64) -> bool {
        transition position < claims && position < 128 {
            true -> claim_entry(reader, value, modules, descriptors, resolvers, claims, position)
            _ -> accept(reader, value, modules, descriptors, resolvers, claims)
        }
    }
    state claim_entry(reader: &mut ProjectFileReader, value: &mut ProjectSymbolCatalog, modules: u64, descriptors: u64, resolvers: u64, claims: u64, position: u64) -> bool
        requires position < 128;
    {
        let stored: bool = decode_symbol_claim(reader, &mut value.symbol_claims[position]);
        transition stored {
            true -> claim_loop(reader, value, modules, descriptors, resolvers, claims, position + 1)
            _ -> (false)
        }
    }
    state accept(reader: &mut ProjectFileReader, value: &mut ProjectSymbolCatalog, modules: u64, descriptors: u64, resolvers: u64, claims: u64) -> bool {
        value.symbol_module_count = modules;
        value.struct_layout_descriptor_count = descriptors;
        value.symbolic_resolver_descriptor_count = resolvers;
        value.symbol_claim_count = claims;
        (true)
    }
}

// ============ manifest / settings / misc records ============

pub machine encode_path_list(writer: &mut ProjectFileWriter, value: &ProjectPathList) -> bool {
    let stored: bool = writer.put_u64(value.path_count);
    transition stored {
        true -> paths(writer, value, 0)
        _ -> (false)
    }
    state paths(writer: &mut ProjectFileWriter, value: &ProjectPathList, position: u64) -> bool {
        transition position < value.path_count && position < 64 {
            true -> path(writer, value, position)
            _ -> (position >= value.path_count)
        }
    }
    state path(writer: &mut ProjectFileWriter, value: &ProjectPathList, position: u64) -> bool
        requires position < 64;
    {
        let stored: bool = encode_string512(writer, &value.paths[position], value.path_lens[position]);
        transition stored {
            true -> paths(writer, value, position + 1)
            _ -> (false)
        }
    }
}

pub machine decode_path_list(reader: &mut ProjectFileReader, value: &mut ProjectPathList) -> bool {
    let count: u64 = reader.get_u64();
    transition count <= 64 {
        true -> paths(reader, value, count, 0)
        _ -> (false)
    }
    state paths(reader: &mut ProjectFileReader, value: &mut ProjectPathList, count: u64, position: u64) -> bool {
        transition position < count && position < 64 {
            true -> path(reader, value, count, position)
            _ -> accept(reader, value, count)
        }
    }
    state path(reader: &mut ProjectFileReader, value: &mut ProjectPathList, count: u64, position: u64) -> bool
        requires position < 64;
    {
        let mut len: u64 = 0;
        let stored: bool = decode_string512(reader, &mut value.paths[position], &mut len);
        value.path_lens[position] = len;
        transition stored {
            true -> paths(reader, value, count, position + 1)
            _ -> (false)
        }
    }
    state accept(reader: &mut ProjectFileReader, value: &mut ProjectPathList, count: u64) -> bool {
        value.path_count = count;
        (true)
    }
}

pub machine encode_manifest(writer: &mut ProjectFileWriter, value: &ProjectManifest) -> bool {
    let stored: bool = encode_path_list(writer, &value.project_item_sort_order);
    (stored)
}

pub machine decode_manifest(reader: &mut ProjectFileReader, value: &mut ProjectManifest) -> bool {
    let stored: bool = decode_path_list(reader, &mut value.project_item_sort_order);
    (stored)
}

pub machine encode_plugin_id(writer: &mut ProjectFileWriter, value: &PluginId) -> bool {
    let stored: bool = encode_string256(writer, &value.plugin_id, value.plugin_id_len);
    (stored)
}

pub machine decode_plugin_id(reader: &mut ProjectFileReader, value: &mut PluginId) -> bool {
    let mut len: u64 = 0;
    let stored: bool = decode_string256(reader, &mut value.plugin_id, &mut len);
    value.plugin_id_len = len;
    (stored)
}

pub machine encode_plugin_configuration(writer: &mut ProjectFileWriter, value: &PluginConfiguration) -> bool {
    let a: bool = writer.put_u64(value.enabled_plugin_id_count);
    let b: bool = writer.put_u64(value.disabled_plugin_id_count);
    let c: bool = writer.put_u64(value.priority_plugin_id_count);
    transition a && b && c {
        true -> enabled(writer, value, 0)
        _ -> (false)
    }
    state enabled(writer: &mut ProjectFileWriter, value: &PluginConfiguration, position: u64) -> bool {
        transition position < value.enabled_plugin_id_count && position < 32 {
            true -> enabled_entry(writer, value, position)
            _ -> disabled(writer, value, 0)
        }
    }
    state enabled_entry(writer: &mut ProjectFileWriter, value: &PluginConfiguration, position: u64) -> bool
        requires position < 32;
    {
        let stored: bool = encode_plugin_id(writer, &value.enabled_plugin_ids[position]);
        transition stored {
            true -> enabled(writer, value, position + 1)
            _ -> (false)
        }
    }
    state disabled(writer: &mut ProjectFileWriter, value: &PluginConfiguration, position: u64) -> bool {
        transition position < value.disabled_plugin_id_count && position < 32 {
            true -> disabled_entry(writer, value, position)
            _ -> priority(writer, value, 0)
        }
    }
    state disabled_entry(writer: &mut ProjectFileWriter, value: &PluginConfiguration, position: u64) -> bool
        requires position < 32;
    {
        let stored: bool = encode_plugin_id(writer, &value.disabled_plugin_ids[position]);
        transition stored {
            true -> disabled(writer, value, position + 1)
            _ -> (false)
        }
    }
    state priority(writer: &mut ProjectFileWriter, value: &PluginConfiguration, position: u64) -> bool {
        transition position < value.priority_plugin_id_count && position < 32 {
            true -> priority_entry(writer, value, position)
            _ -> (position >= value.priority_plugin_id_count)
        }
    }
    state priority_entry(writer: &mut ProjectFileWriter, value: &PluginConfiguration, position: u64) -> bool
        requires position < 32;
    {
        let stored: bool = encode_plugin_id(writer, &value.priority_plugin_ids[position]);
        transition stored {
            true -> priority(writer, value, position + 1)
            _ -> (false)
        }
    }
}

pub machine decode_plugin_configuration(reader: &mut ProjectFileReader, value: &mut PluginConfiguration) -> bool {
    let enabled: u64 = reader.get_u64();
    let disabled: u64 = reader.get_u64();
    let priority: u64 = reader.get_u64();
    transition enabled <= 32 && disabled <= 32 && priority <= 32 {
        true -> enabled_loop(reader, value, enabled, disabled, priority, 0)
        _ -> (false)
    }
    state enabled_loop(reader: &mut ProjectFileReader, value: &mut PluginConfiguration, enabled: u64, disabled: u64, priority: u64, position: u64) -> bool {
        transition position < enabled && position < 32 {
            true -> enabled_entry(reader, value, enabled, disabled, priority, position)
            _ -> disabled_loop(reader, value, enabled, disabled, priority, 0)
        }
    }
    state enabled_entry(reader: &mut ProjectFileReader, value: &mut PluginConfiguration, enabled: u64, disabled: u64, priority: u64, position: u64) -> bool
        requires position < 32;
    {
        let stored: bool = decode_plugin_id(reader, &mut value.enabled_plugin_ids[position]);
        transition stored {
            true -> enabled_loop(reader, value, enabled, disabled, priority, position + 1)
            _ -> (false)
        }
    }
    state disabled_loop(reader: &mut ProjectFileReader, value: &mut PluginConfiguration, enabled: u64, disabled: u64, priority: u64, position: u64) -> bool {
        transition position < disabled && position < 32 {
            true -> disabled_entry(reader, value, enabled, disabled, priority, position)
            _ -> priority_loop(reader, value, enabled, disabled, priority, 0)
        }
    }
    state disabled_entry(reader: &mut ProjectFileReader, value: &mut PluginConfiguration, enabled: u64, disabled: u64, priority: u64, position: u64) -> bool
        requires position < 32;
    {
        let stored: bool = decode_plugin_id(reader, &mut value.disabled_plugin_ids[position]);
        transition stored {
            true -> disabled_loop(reader, value, enabled, disabled, priority, position + 1)
            _ -> (false)
        }
    }
    state priority_loop(reader: &mut ProjectFileReader, value: &mut PluginConfiguration, enabled: u64, disabled: u64, priority: u64, position: u64) -> bool {
        transition position < priority && position < 32 {
            true -> priority_entry(reader, value, enabled, disabled, priority, position)
            _ -> accept(reader, value, enabled, disabled, priority)
        }
    }
    state priority_entry(reader: &mut ProjectFileReader, value: &mut PluginConfiguration, enabled: u64, disabled: u64, priority: u64, position: u64) -> bool
        requires position < 32;
    {
        let stored: bool = decode_plugin_id(reader, &mut value.priority_plugin_ids[position]);
        transition stored {
            true -> priority_loop(reader, value, enabled, disabled, priority, position + 1)
            _ -> (false)
        }
    }
    state accept(reader: &mut ProjectFileReader, value: &mut PluginConfiguration, enabled: u64, disabled: u64, priority: u64) -> bool {
        value.enabled_plugin_id_count = enabled;
        value.disabled_plugin_id_count = disabled;
        value.priority_plugin_id_count = priority;
        (true)
    }
}

pub machine encode_process_icon(writer: &mut ProjectFileWriter, value: &ProcessIcon) -> bool {
    let a: bool = encode_bytes16384(writer, &value.bytes_rgba, value.bytes_rgba_len);
    let b: bool = writer.put_u32(value.width);
    let c: bool = writer.put_u32(value.height);
    (a && b && c)
}

pub machine decode_process_icon(reader: &mut ProjectFileReader, value: &mut ProcessIcon) -> bool {
    let mut len: u64 = 0;
    let bytes_ok: bool = decode_bytes16384(reader, &mut value.bytes_rgba, &mut len);
    value.bytes_rgba_len = len;
    let width: u32 = reader.get_u32();
    value.width = width;
    let height: u32 = reader.get_u32();
    value.height = height;
    (bytes_ok)
}

pub machine encode_project_settings(writer: &mut ProjectFileWriter, value: &ProjectSettings) -> bool {
    let a: bool = encode_string512(writer, &value.projects_root, value.projects_root_len);
    let b: bool = writer.put_u64(value.project_update_interval_ms);
    (a && b)
}

pub machine decode_project_settings(reader: &mut ProjectFileReader, value: &mut ProjectSettings) -> bool {
    let mut len: u64 = 0;
    let root_ok: bool = decode_string512(reader, &mut value.projects_root, &mut len);
    value.projects_root_len = len;
    let interval: u64 = reader.get_u64();
    value.project_update_interval_ms = interval;
    (root_ok)
}

pub machine encode_item_type_ref(writer: &mut ProjectFileWriter, value: &ProjectItemTypeRef) -> bool {
    let stored: bool = encode_string64(writer, &value.project_item_type_id, value.project_item_type_id_len);
    (stored)
}

pub machine decode_item_type_ref(reader: &mut ProjectFileReader, value: &mut ProjectItemTypeRef) -> bool {
    let mut len: u64 = 0;
    let stored: bool = decode_string64(reader, &mut value.project_item_type_id, &mut len);
    value.project_item_type_id_len = len;
    (stored)
}

pub machine encode_data_value(writer: &mut ProjectFileWriter, value: &DataValue) -> bool {
    let a: bool = encode_data_type_ref(writer, &value.data_type_ref);
    let b: bool = encode_bytes4096(writer, &value.value_bytes, value.value_bytes_len);
    (a && b)
}

pub machine decode_data_value(reader: &mut ProjectFileReader, value: &mut DataValue) -> bool {
    let type_ok: bool = decode_data_type_ref(reader, &mut value.data_type_ref);
    let mut len: u64 = 0;
    let bytes_ok: bool = decode_bytes4096(reader, &mut value.value_bytes, &mut len);
    value.value_bytes_len = len;
    (type_ok && bytes_ok)
}

// ============ project-info stub ============

// Upstream `ProjectInfo` serializes four members; the stub carries the
// same four (icon flag + payload, manifest, symbol catalog, plugin
// configuration flag + payload).
pub machine encode_info_stub(writer: &mut ProjectFileWriter, value: &ProjectInfoStub) -> bool {
    let a: bool = writer.put_bool(value.has_project_icon_rgba);
    let b: bool = encode_manifest(writer, &value.project_manifest);
    let c: bool = encode_symbol_catalog(writer, &value.project_symbol_catalog);
    let d: bool = writer.put_bool(value.has_plugin_configuration);
    transition a && b && c && d {
        true -> icon(writer, value)
        _ -> (false)
    }
    state icon(writer: &mut ProjectFileWriter, value: &ProjectInfoStub) -> bool {
        transition value.has_project_icon_rgba {
            true -> emit_icon(writer, value)
            _ -> plugin_config(writer, value)
        }
    }
    state emit_icon(writer: &mut ProjectFileWriter, value: &ProjectInfoStub) -> bool {
        let stored: bool = encode_process_icon(writer, &value.project_icon_rgba);
        transition stored {
            true -> plugin_config(writer, value)
            _ -> (false)
        }
    }
    state plugin_config(writer: &mut ProjectFileWriter, value: &ProjectInfoStub) -> bool {
        transition value.has_plugin_configuration {
            true -> emit_plugin(writer, value)
            _ -> (true)
        }
    }
    state emit_plugin(writer: &mut ProjectFileWriter, value: &ProjectInfoStub) -> bool {
        let stored: bool = encode_plugin_configuration(writer, &value.plugin_configuration);
        (stored)
    }
}

pub machine decode_info_stub(reader: &mut ProjectFileReader, value: &mut ProjectInfoStub) -> bool {
    let has_icon: bool = reader.get_bool();
    value.has_project_icon_rgba = has_icon;
    let manifest_ok: bool = decode_manifest(reader, &mut value.project_manifest);
    let catalog_ok: bool = decode_symbol_catalog(reader, &mut value.project_symbol_catalog);
    let has_plugin: bool = reader.get_bool();
    value.has_plugin_configuration = has_plugin;
    transition manifest_ok && catalog_ok {
        true -> icon(reader, value, has_icon, has_plugin)
        _ -> (false)
    }
    state icon(reader: &mut ProjectFileReader, value: &mut ProjectInfoStub, has_icon: bool, has_plugin: bool) -> bool {
        transition has_icon {
            true -> read_icon(reader, value, has_plugin)
            _ -> plugin_config(reader, value, has_plugin)
        }
    }
    state read_icon(reader: &mut ProjectFileReader, value: &mut ProjectInfoStub, has_plugin: bool) -> bool {
        let stored: bool = decode_process_icon(reader, &mut value.project_icon_rgba);
        transition stored {
            true -> plugin_config(reader, value, has_plugin)
            _ -> (false)
        }
    }
    state plugin_config(reader: &mut ProjectFileReader, value: &mut ProjectInfoStub, has_plugin: bool) -> bool {
        transition has_plugin {
            true -> read_plugin(reader, value)
            _ -> (true)
        }
    }
    state read_plugin(reader: &mut ProjectFileReader, value: &mut ProjectInfoStub) -> bool {
        let stored: bool = decode_plugin_configuration(reader, &mut value.plugin_configuration);
        (stored)
    }
}
