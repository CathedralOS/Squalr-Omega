// Package boundary and internal edges mirror upstream squalr-engine-projects/Cargo.toml.
machine build(builder: &mut Build) {
    Build::package(builder, "squalr_engine_projects");
    Build::depend(builder, Source::Path { location: "../squalr-engine-api" });

    // The serialization impls call FilesystemHost machines directly — the
    // std edge names the boundary traits, mirroring the api/engine pin.
    Build::depend(builder, Source::Git {
        repository: "https://github.com/CathedralOS/Omega.git",
        revision: "438173f7da3e27c24bf4ac710714039937367cee",
        selection: PackageSelection::Named { package: "omega_language_std" }
    });
}
